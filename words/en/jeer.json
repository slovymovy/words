{
    "word_family": [
        "jeerer",
        "jeeringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bca2c8bc-4ad9-3b1c-9ce9-c437e01f48a5",
                    "sense_definition": "To shout insulting or mocking comments at someone to show lack of respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry crowd began to <w>jeer</w> at the referee after he made a controversial decision.",
                            "target_lang_translations": {
                                "ru": "Разгневанная толпа начала <w>насмехаться</w> над судьей после того, как он принял спорное решение."
                            }
                        },
                        {
                            "text": "It is unkind to <w>jeer</w> at the performers just because they made a small mistake on stage.",
                            "target_lang_translations": {
                                "ru": "Некрасиво <w>глумиться</w> над артистами только из-за того, что они совершили небольшую ошибку на сцене."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoff",
                        "sneer",
                        "gibe",
                        "mock",
                        "taunt"
                    ],
                    "antonyms": [
                        "cheer",
                        "applaud",
                        "praise"
                    ],
                    "common_phrases": [
                        "jeer at the referee",
                        "jeer from the sidelines"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выкрикивать оскорбительные или насмешливые комментарии в чей-то адрес, чтобы выразить неуважение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насмехаться",
                                "target_lang_sense_clarification": "издевательски шутить"
                            },
                            {
                                "target_lang_word": "глумиться",
                                "target_lang_sense_clarification": "злобно издеваться"
                            },
                            {
                                "target_lang_word": "освистывать",
                                "target_lang_sense_clarification": "выражать неодобрение криками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a990884f-adb9-36ab-af12-7cb9c5b9fbc8",
                    "sense_definition": "To treat someone with mockery or to taunt them directly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bullies would often <w>jeer</w> him in the hallway between classes.",
                            "target_lang_translations": {
                                "ru": "Задиры часто <w>высмеивали</w> его в коридоре между уроками."
                            }
                        },
                        {
                            "text": "They continued to <w>jeer</w> the opposing team throughout the entire match.",
                            "target_lang_translations": {
                                "ru": "Они продолжали <w>издеваться</w> над командой противника на протяжении всего матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "deride",
                        "mock",
                        "ridicule"
                    ],
                    "antonyms": [
                        "honor",
                        "respect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относиться к кому-либо с насмешкой или открыто издеваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высмеивать",
                                "target_lang_sense_clarification": "представлять в смешном виде"
                            },
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "подвергать нападкам"
                            },
                            {
                                "target_lang_word": "издеваться",
                                "target_lang_sense_clarification": "злая насмешка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84e23316-eb45-3721-b417-fd0fd27ce0d6",
                    "sense_definition": "A rude and mocking remark intended to insult or show derision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician ignored the <w>jeer</w> from the back of the room and continued his speech.",
                            "target_lang_translations": {
                                "ru": "Политик проигнорировал <w>насмешку</w> из глубины зала и продолжил свою речь."
                            }
                        },
                        {
                            "text": "He responded to every <w>jeer</w> with a calm smile, refusing to be intimidated.",
                            "target_lang_translations": {
                                "ru": "На каждую <w>издёвку</w> он отвечал спокойной улыбкой, не давая себя запугать."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoff",
                        "taunt",
                        "jibe",
                        "mockery"
                    ],
                    "antonyms": [
                        "compliment",
                        "tribute"
                    ],
                    "common_phrases": [
                        "a loud jeer",
                        "respond to a jeer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубое и насмешливое замечание, предназначенное для оскорбления или выражения презрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насмешка",
                                "target_lang_sense_clarification": "обидная шутка"
                            },
                            {
                                "target_lang_word": "глумление",
                                "target_lang_sense_clarification": "издевательство"
                            },
                            {
                                "target_lang_word": "издёвка",
                                "target_lang_sense_clarification": "язвительное замечание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b3f156c-b877-36b2-8ad6-fb41aff35426",
                    "sense_definition": "A system of ropes and pulleys used on a ship for hoisting or lowering the yards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors worked together to adjust the <w>jeer</w> before the storm arrived.",
                            "target_lang_translations": {
                                "ru": "Матросы вместе работали над настройкой <w>гарделя</w> до начала шторма."
                            }
                        },
                        {
                            "text": "In the nineteenth century, the <w>jeer</w> was a critical component of a ship's rigging.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке <w>гардель</w> был важнейшим компонентом корабельного такелажа."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Система тросов и блоков на корабле, используемая для подъема или опускания реев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гардель",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
