                                                "example_id": "535fd225-a9ee-4e5f-b028-893bfd10c743",
                                                "sense_id": "c7d760fc-723e-3697-91b7-9e2b844b9dc8",
                                                "text": "„Das waren Kurs- und Strömungsberechnungen, Azimute von Gestirnen sowie Küstenbilder und die entsprechenden Seekarten.“"
                                            }
                                        ],
