                "senses": [
                    {
                        "sense_id": "ebaaafe1-f30e-3b60-90e2-7c642bc7dc1c",
                        "entry_id": "f5d6e9d7-7bde-3980-86bc-7e73a17b87e2",
                        "glosses": [
                            "krapfenähnliches, aus Brandmasse bestehendes Gebäck, das mit einem Spritzbeutel oder dergleichen in eine Kringelform gebracht und in Fett schwimmend gebacken (sowie in der Regel mit einer Zuckerglasur überzogen) wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ac0762-8eff-4b11-b190-d5c566707088",
                                "sense_id": "ebaaafe1-f30e-3b60-90e2-7c642bc7dc1c",
                                "text": "„Der Duft von frischen warmen Pfannkuchen, Spritzkuchen, Apfelkuchen und Brötchen liegt in der Luft.“"
                            },
                            {
                                "example_id": "0dc249dc-c376-4876-80ef-e494662a9849",
                                "sense_id": "ebaaafe1-f30e-3b60-90e2-7c642bc7dc1c",
                                "text": "„Er sitzt zur Kaffeepause im verglasten Dach des Wehrturms, mampft Spritzkuchen und führt mit Gattin Alla ein Rededuell.“"
                            },
                            {
                                "example_id": "201a5e4e-6fa5-4c0f-9eaf-4f77e3fc2e7a",
                                "sense_id": "ebaaafe1-f30e-3b60-90e2-7c642bc7dc1c",
                                "text": "„Bäuerinnen boten leckere Spritzkuchen an, und an den zahlreichen Verkaufsständen gab es vom Gesteck bis hin zur hausgemachten Marmelade alles, was Herz und Gaumen erfreut.“"
                            },
                            {
                                "example_id": "650d6e04-eb79-4a8c-914d-cf0168288bea",
                                "sense_id": "ebaaafe1-f30e-3b60-90e2-7c642bc7dc1c",
                                "text": "„Dann wurde Karussell gefahren, Eis, gebrannte Mandeln und Spritzkuchen gegessen und wieder Karussell gefahren, schlecht wurde ihnen dabei nie.“"
                            },
                            {
                                "example_id": "2f4b1d4d-cff6-45c0-99c5-e0a386ea8659",
                                "sense_id": "ebaaafe1-f30e-3b60-90e2-7c642bc7dc1c",
                                "text": "„Spritzkuchen sind aus Brandteig, in Kringel gespritzt und schwimmend in Fett ausgebacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
