{
    "word_family": [
        "trashy",
        "detrash"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e62ba31-51a8-3a1a-b794-71842a7a0c20",
                    "sense_definition": "Useless physical things to be discarded; rubbish; refuse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waste_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take out the <w>trash</w> before the truck arrives.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вынеси <w>мусор</w> до приезда мусоровоза.",
                                "zh": "请在垃圾车到达之前把<w>垃圾</w>倒掉。"
                            }
                        },
                        {
                            "text": "The park was full of <w>trash</w> left behind by the crowd.",
                            "target_lang_translations": {
                                "ru": "Парк был полон <w>мусора</w>, оставленного толпой.",
                                "zh": "公园里到处都是人群留下的<w>垃圾</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "garbage",
                        "rubbish",
                        "waste",
                        "refuse",
                        "junk",
                        "litter"
                    ],
                    "antonyms": [
                        "treasure",
                        "valuables"
                    ],
                    "common_phrases": [
                        "take out the trash",
                        "pick up trash",
                        "pile of trash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесполезные физические предметы, подлежащие выбрасыванию; отходы, сор.",
                        "zh": "不再需要的废弃物品；垃圾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "бытовые отходы, сор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾",
                                "target_lang_sense_clarification": "泛指废弃物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3774a4d-fad5-3750-8eac-cefdbc7175c6",
                    "sense_definition": "A container into which things are discarded.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "waste_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Just throw that wrapper in the <w>trash</w>.",
                            "target_lang_translations": {
                                "ru": "Просто выкинь эту обёртку в <w>мусорное ведро</w>.",
                                "zh": "把那个包装纸扔进<w>垃圾桶</w>里就行了。"
                            }
                        },
                        {
                            "text": "The <w>trash</w> under my desk is full and needs emptying.",
                            "target_lang_translations": {
                                "ru": "<w>Мусорное ведро</w> под моим столом переполнено, и его нужно вынести.",
                                "zh": "我桌子底下的<w>垃圾桶</w>满了，需要清理一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trash can",
                        "garbage can",
                        "bin",
                        "trash bin"
                    ],
                    "common_phrases": [
                        "in the trash",
                        "throw in the trash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер, в который выбрасывают ненужные вещи.",
                        "zh": "用来盛放废弃物的容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусорное ведро",
                                "target_lang_sense_clarification": "домашняя ёмкость для мусора"
                            },
                            {
                                "target_lang_word": "урна",
                                "target_lang_sense_clarification": "уличная или офисная корзина"
                            },
                            {
                                "target_lang_word": "помойка",
                                "target_lang_sense_clarification": "разг. место сбора мусора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾桶",
                                "target_lang_sense_clarification": "盛放垃圾的容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45c0463e-6e3b-34e5-a055-fefc980b19f6",
                    "sense_definition": "Temporary storage on disk for files that the user has deleted, allowing them to be recovered if necessary.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally deleted the file, but I found it in the <w>trash</w>.",
                            "target_lang_translations": {
                                "ru": "Я случайно удалил файл, но нашёл его в <w>корзине</w>.",
                                "zh": "我不小心删除了那个文件，但我在<w>回收站</w>里找到了它。"
                            }
                        },
                        {
                            "text": "Don't forget to empty the <w>trash</w> to free up disk space.",
                            "target_lang_translations": {
                                "ru": "Не забудь очистить <w>корзину</w>, чтобы освободить место на диске.",
                                "zh": "别忘了清空<w>回收站</w>以释放磁盘空间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recycle bin",
                        "bin"
                    ],
                    "common_phrases": [
                        "empty the trash",
                        "move to trash"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Временное хранилище на диске для удаленных файлов, позволяющее восстановить их при необходимости.",
                        "zh": "计算机中用于临时存放已删除文件，以便必要时恢复的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корзина",
                                "target_lang_sense_clarification": "комп. папка для удалённых файлов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回收站",
                                "target_lang_sense_clarification": "计算机中存放已删除文件的文件夹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68132207-d7dd-389a-9fa8-407df3ed532e",
                    "sense_definition": "Something worthless or of poor quality.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "worthless_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That movie was absolute <w>trash</w> and a waste of time.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был полной <w>дрянью</w> и пустой тратой времени.",
                                "zh": "那部电影简直就是<w>垃圾</w>，纯属浪费时间。"
                            }
                        },
                        {
                            "text": "Don't spend your money on this cheap <w>trash</w>.",
                            "target_lang_translations": {
                                "ru": "Не трать деньги на этот дешёвый <w>хлам</w>.",
                                "zh": "别把钱花在这种廉价的<w>废品</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "junk",
                        "rubbish",
                        "garbage",
                        "crap"
                    ],
                    "common_phrases": [
                        "piece of trash",
                        "absolute trash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то бесполезное или низкого качества.",
                        "zh": "毫无价值或质量极差的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрянь",
                                "target_lang_sense_clarification": "о вещах плохого качества"
                            },
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "старые или ненужные вещи"
                            },
                            {
                                "target_lang_word": "халтура",
                                "target_lang_sense_clarification": "небрежная работа"
                            },
                            {
                                "target_lang_word": "ерунда",
                                "target_lang_sense_clarification": "чепуха, вздор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾",
                                "target_lang_sense_clarification": "比喻质量极差"
                            },
                            {
                                "target_lang_word": "废品",
                                "target_lang_sense_clarification": "质量不合格或无用的东西"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01d52259-6483-382a-b789-146ce7c3bc59",
                    "sense_definition": "People of low social status or class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people_derogatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looks down on his neighbors and treats them like <w>trash</w>.",
                            "target_lang_translations": {
                                "ru": "Он смотрит на соседей свысока и относится к ним как к <w>мусору</w>.",
                                "zh": "他看不起邻居，把他们当<w>人渣</w>一样对待。"
                            }
                        },
                        {
                            "text": "Using the word <w>trash</w> to describe people is extremely offensive.",
                            "target_lang_translations": {
                                "ru": "Называть людей <w>отребьем</w> чрезвычайно оскорбительно.",
                                "zh": "用“<w>垃圾</w>”这个词来形容人是非常冒犯的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "white trash"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди низкого социального статуса или класса.",
                        "zh": "指社会地位低下或被轻视的人（贬义）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отребье",
                                "target_lang_sense_clarification": "деклассированные элементы"
                            },
                            {
                                "target_lang_word": "шваль",
                                "target_lang_sense_clarification": "груб. ничтожные люди"
                            },
                            {
                                "target_lang_word": "сброд",
                                "target_lang_sense_clarification": "люди низкого пошиба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人渣",
                                "target_lang_sense_clarification": "对品行恶劣者的蔑称"
                            },
                            {
                                "target_lang_word": "社会底层",
                                "target_lang_sense_clarification": "指代社会地位低下的人群"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9185b8c-58b2-38cc-9f9f-66aaaf13e99b",
                    "sense_definition": "To damage something severely or make it into a mess.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "destroy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rock band <w>trashed</w> the hotel room after the concert.",
                            "target_lang_translations": {
                                "ru": "Рок-группа <w>разгромила</w> гостиничный номер после концерта.",
                                "zh": "演唱会结束后，那支摇滚乐队把酒店房间<w>砸烂</w>了。"
                            }
                        },
                        {
                            "text": "Someone broke in and <w>trashed</w> the entire house.",
                            "target_lang_translations": {
                                "ru": "Кто-то вломился и <w>разнёс</w> весь дом.",
                                "zh": "有人闯入并把整个房子<w>破坏</w>得一团糟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wreck",
                        "ruin",
                        "vandalize",
                        "destroy"
                    ],
                    "antonyms": [
                        "fix",
                        "repair",
                        "clean"
                    ],
                    "common_phrases": [
                        "trash the place",
                        "trash the room"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно повредить что-то или устроить беспорядок.",
                        "zh": "严重损坏某物或弄得一团糟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "привести в беспорядок, сломать"
                            },
                            {
                                "target_lang_word": "разнести",
                                "target_lang_sense_clarification": "разг. сильно повредить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "毁坏物品"
                            },
                            {
                                "target_lang_word": "砸烂",
                                "target_lang_sense_clarification": "将某处弄得一片狼藉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d00b25d9-0ba6-365a-aabc-183f7810898a",
                    "sense_definition": "To criticize someone or something very harshly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "criticize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>trashed</w> the new movie in their reviews.",
                            "target_lang_translations": {
                                "ru": "Критики <w>раскритиковали</w> новый фильм в своих рецензиях.",
                                "zh": "评论家们在影评中对这部新电影进行了猛烈的<w>抨击</w>。"
                            }
                        },
                        {
                            "text": "He is always <w>trashing</w> his competitors to make himself look better.",
                            "target_lang_translations": {
                                "ru": "Он вечно <w>поливает грязью</w> своих конкурентов, чтобы выглядеть лучше.",
                                "zh": "他总是通过<w>诋毁</w>竞争对手来抬高自己。"
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "disparage",
                        "condemn",
                        "slam"
                    ],
                    "antonyms": [
                        "praise",
                        "acclaim"
                    ],
                    "common_phrases": [
                        "trash talk",
                        "trash a reputation"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень резко критиковать кого-то или что-то.",
                        "zh": "对某人或某事进行严厉的批评。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскритиковать",
                                "target_lang_sense_clarification": "дать резкую негативную оценку"
                            },
                            {
                                "target_lang_word": "смешать с грязью",
                                "target_lang_sense_clarification": "унизить критикой"
                            },
                            {
                                "target_lang_word": "поливать грязью",
                                "target_lang_sense_clarification": "оскорблять, клеветать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抨击",
                                "target_lang_sense_clarification": "严厉批评"
                            },
                            {
                                "target_lang_word": "痛斥",
                                "target_lang_sense_clarification": "严厉地指责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2a67bec-0127-3606-9fae-680024af3a7f",
                    "sense_definition": "To discard or throw away.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "discard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>trash</w> the old draft and start over from scratch.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>выкинуть</w> старый черновик и начать всё с нуля.",
                                "zh": "我们不得不把旧草稿<w>丢弃</w>，然后从头开始。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>trash</w> any important documents.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы не <w>выбросить</w> важные документы.",
                                "zh": "小心别把重要的文件<w>扔掉</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discard",
                        "dump",
                        "scrap"
                    ],
                    "antonyms": [
                        "keep",
                        "save"
                    ],
                    "common_phrases": [
                        "trash the idea",
                        "trash the files"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбросить или избавиться от чего-то.",
                        "zh": "丢弃或扔掉某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбросить",
                                "target_lang_sense_clarification": "избавиться от ненужного"
                            },
                            {
                                "target_lang_word": "выкинуть",
                                "target_lang_sense_clarification": "разг. выбросить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丢弃",
                                "target_lang_sense_clarification": "扔掉不再需要的东西"
                            },
                            {
                                "target_lang_word": "扔掉",
                                "target_lang_sense_clarification": "口语中表示抛弃"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}