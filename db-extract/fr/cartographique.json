                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1cdbcf0a-ae2e-4694-93f4-dee3bb186312",
                        "entry_id": "63405e7b-d8a3-3464-9065-dd439aa8b9af",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "cartographiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a946ade-f576-3bdd-88c3-5fd9b7723148",
                        "entry_id": "63405e7b-d8a3-3464-9065-dd439aa8b9af",
                        "glosses": [
                            "Relatif aux cartes de géographie, à la cartographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9ecc074-0fd6-4078-b58c-df156c66e7eb",
                                "sense_id": "8a946ade-f576-3bdd-88c3-5fd9b7723148",
                                "text": "Ceci, je viens de l’apprendre en consultant l’indicateur-horaire que j’ai acheté à la gare. Il est accompagné d’une longue bande cartographique, pliée et repliée sur elle-même, qui donne le complet développement du railway entre la mer Caspienne et les côtes orientales de la Chine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a7d96a6-3236-40b8-99ce-3677348a1c10",
                        "source_entry_id": "63405e7b-d8a3-3464-9065-dd439aa8b9af",
                        "source_sense_id": "8a946ade-f576-3bdd-88c3-5fd9b7723148",
                        "target_lang_word": "kartographisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kartographisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee80e172-2dae-3977-abfe-611165ce8912",
                                        "entry_id": "44f686b2-f4a1-3966-9562-b4fd5bbccad2",
                                        "glosses": [
                                            "die Kartographie betreffend, zu ihr gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09586973-9c7c-4c64-ace1-7ec742009e0b",
                                                "sense_id": "ee80e172-2dae-3977-abfe-611165ce8912",
                                                "text": "„Die kartographische Terminologie hat sich zusammen mit der kartographischen Wissenschaft und Praxis entwickelt, was anfangs zumeist wenig systemhaft erfolgte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f00bb927-4310-4bbd-a28c-15be6e602c6c",
                        "source_entry_id": "63405e7b-d8a3-3464-9065-dd439aa8b9af",
                        "source_sense_id": "8a946ade-f576-3bdd-88c3-5fd9b7723148",
                        "target_lang_word": "kartografisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kartografisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96705029-4996-3b7f-b22b-7e3430d036ea",
                                        "entry_id": "5210ca57-4a5c-3511-ab56-9a462b8cf53e",
                                        "glosses": [
                                            "die Kartografie betreffend, zur Kartografie gehörend, mit den Mitteln der Kartografie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03961c3c-de84-4199-9e3d-e566ddb69286",
                                                "sense_id": "96705029-4996-3b7f-b22b-7e3430d036ea",
                                                "text": "Grundsätzlich sollte sich die Kartografie neben den technischen Modellierungskonzepten auch wieder vermehrt der grafischen Gestaltung von kartografischen Produkten zuwenden."
                                            },
                                            {
                                                "example_id": "ae7b55a4-cd41-4aeb-b8e6-d5aeb8330908",
                                                "sense_id": "96705029-4996-3b7f-b22b-7e3430d036ea",
                                                "text": "Für kartografische Produkte können dabei topografische sowie weitere thematische Informationen zu ganzen virtuellen Landschaften kombiniert werden."
                                            },
                                            {
                                                "example_id": "ec1c3183-95e7-40f2-add1-fd3fd28cfc7c",
                                                "sense_id": "96705029-4996-3b7f-b22b-7e3430d036ea",
                                                "text": "Neben der Navigationssoftware enthält der schicke Personal Travel Agent Tipps zu 30000 Reisezielen, von der Merian- und der Feinschmecker- Redaktion aufbereitet, zudem kartografische Darstellungen, bewegte Bilder und Hörstücke."
                                            },
                                            {
                                                "example_id": "32b44bee-bc21-4626-98c5-35118b35afce",
                                                "sense_id": "96705029-4996-3b7f-b22b-7e3430d036ea",
                                                "text": "Die kartografische Darstellung der Gesundheitsversorgung einer Stadt oder einer Region nennen die Amerikaner health mapping."
                                            },
                                            {
                                                "example_id": "fc03b7b8-ae61-4711-a060-9b43af25126a",
                                                "sense_id": "96705029-4996-3b7f-b22b-7e3430d036ea",
                                                "text": "„Es handelt sich um eine kartografische und statistische Dokumentation des naturräumlichen, wirtschaftlichen und gesellschaftlichen Zustandes der Habsburgermonarchie in der ersten Hälfte des 19. Jahrhunderts“, heißt es auf der Homepage des Forschungsprojektes (www.franziszeischerkataster.at)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bd7b545-414d-4539-9d88-a0f1fd04d563",
                        "source_entry_id": "63405e7b-d8a3-3464-9065-dd439aa8b9af",
                        "source_sense_id": "8a946ade-f576-3bdd-88c3-5fd9b7723148",
                        "target_lang_word": "cartographic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cartographic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02e1895f-7a1c-36e0-a9dc-74bcaca0abe6",
                                        "entry_id": "228610a3-4e12-3a41-b769-4b70719ab7ab",
                                        "glosses": [
                                            "Of or pertaining to the making of maps."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e2b7d7-ad06-491a-8925-a9fc1a893048",
                                                "sense_id": "02e1895f-7a1c-36e0-a9dc-74bcaca0abe6",
                                                "text": "This is important to the ends of tangible geography, as well in the construction and arrangement of tables, as in every description of cartographic composition."
                                            },
                                            {
                                                "example_id": "76460ef6-bb74-4a87-960b-c0033b993748",
                                                "sense_id": "02e1895f-7a1c-36e0-a9dc-74bcaca0abe6",
                                                "text": "However, both of these examples assume that no three dimensional data is available in the initial digital cartographic data or other data sets that precede the immediate operation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
