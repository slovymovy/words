        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5b7aaf43-466d-3218-b016-8e782d65f49f",
                    "sense_definition": "A country and archipelago of East Asia. Capital and largest city: Tokyo.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "I want to travel to <w>Japan</w> next year to see the cherry blossoms.",
                            "target_lang_translations": {
                                "ru": "Я хочу поехать в <w>Японию</w> в следующем году, чтобы увидеть цветение сакуры.",
                                "zh": "我明年想去<w>日本</w>看樱花。"
                            }
                        },
                        {
                            "text": "Many famous electronic brands are made in <w>Japan</w>.",
                            "target_lang_translations": {
                                "ru": "Многие известные бренды электроники производятся в <w>Японии</w>.",
                                "zh": "许多著名的电子品牌都是在<w>日本</w>制造的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Nippon",
                        "Land of the Rising Sun",
                        "State of Japan"
                    ],
                    "common_phrases": [
                        "made in Japan",
                        "Sea of Japan",
                        "visit Japan",
                        "Japan time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страна и архипелаг в Восточной Азии. Столица и крупнейший город: Токио.",
                        "zh": "位于东亚的岛国。首都和最大城市是东京。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Япония",
                                "target_lang_sense_clarification": "страна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日本",
                                "target_lang_sense_clarification": "国家"
                            }
                        ]
                    }
                }
            ]
        },
        {
