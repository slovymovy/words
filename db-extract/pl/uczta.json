                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e68e0099-ce41-3ba3-b04e-3839a3aa15bc",
                        "entry_id": "e9e0cb8e-f229-3ddd-9270-c03003b764c2",
                        "glosses": [
                            "ciekawe wydarzenie, zazwyczaj o charakterze kulturalnym; bardzo przyjemne przeżycie estetyczne, duchowe"
                        ],
