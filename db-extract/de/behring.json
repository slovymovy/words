                ],
                "senses": [
                    {
                        "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                        "entry_id": "1d00ad1f-4e47-3a3e-9bfe-1889d8e15b72",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b8d5cc-b49e-4d1a-8c1a-39e2857e31b9",
                                "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                                "text": "Frau Behring ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "87b7749f-3b3c-47b2-9780-24f66bd881df",
                                "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                                "text": "Herr Behring wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c768f425-5962-4b06-aeb9-f114dac1bd3a",
                                "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                                "text": "Die Behrings fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "47ee9a9d-6536-440a-88a3-7fed67ad02c7",
                                "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                                "text": "Der Behring trägt nie die Pullover, die die Behring ihm strickt."
                            },
                            {
                                "example_id": "8d8a4e9c-d652-4f4e-b7d2-e436cb1f3723",
                                "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Behring kommt, geht der Herr Behring.“"
                            },
                            {
                                "example_id": "0fd40041-9154-40c9-89b0-d64bc7dbcb56",
                                "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                                "text": "Behring kommt und geht."
                            },
                            {
                                "example_id": "7d49eeb1-f2aa-4cea-8af9-260b066d7afa",
                                "sense_id": "a7f77236-2495-3aa1-bb2d-8c5fb4ca894b",
                                "text": "Behrings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
