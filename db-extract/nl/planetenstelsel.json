                                "target_senses": [
                                    {
                                        "sense_id": "dcb56f20-ae7f-32fc-831d-29b64aacad85",
                                        "entry_id": "62938150-6bc4-38bb-903d-e269e9fe26a7",
                                        "glosses": [
                                            "die Gesamtheit von Körpern, die sich durch die Gravitationskraft gebunden meist um einen Einzelstern bewegen; Die größten dieser Körper werden als Planeten bezeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92690fb4-7810-47bb-85e9-b6c06961fbc2",
                                                "sense_id": "dcb56f20-ae7f-32fc-831d-29b64aacad85",
                                                "text": "Die Erde ist ein Teil unseres Planetensystems."
                                            },
                                            {
                                                "example_id": "ce15b4b3-592c-477a-acd8-6ce82e6d05e6",
                                                "sense_id": "dcb56f20-ae7f-32fc-831d-29b64aacad85",
                                                "text": "„Kopernikus stellte die Sonne in den Mittelpunkt des Planetensystems und ließ die Erde sich um die Sonne bewegen.“"
                                            },
                                            {
                                                "example_id": "a601b778-bc4e-45b1-9879-b68d8062ceda",
                                                "sense_id": "dcb56f20-ae7f-32fc-831d-29b64aacad85",
                                                "text": "„Seine Gefühle, seine Gedanken kreisten wie ein wohlgeordnetes Planetensystem um einen festen Mittelpunkt.“"
                                            },
                                            {
                                                "example_id": "a7acc700-654d-4313-b7ef-154dcae652bf",
                                                "sense_id": "dcb56f20-ae7f-32fc-831d-29b64aacad85",
                                                "text": "„Damit war ein neues Rätsel im Planetensystem aufgetaucht, das der Lösung durch die Astronomen harrte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
