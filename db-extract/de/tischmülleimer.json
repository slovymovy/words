                ],
                "senses": [
                    {
                        "sense_id": "38eb2874-d82d-3616-b431-a8f50a70b6c8",
                        "entry_id": "346c4761-f820-3279-b800-9fe3d8527879",
                        "glosses": [
                            "kleiner Behälter für den Abfall, der bei Tisch anfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64a3c90-c93c-4073-a662-2fea5caba2ec",
                                "sense_id": "38eb2874-d82d-3616-b431-a8f50a70b6c8",
                                "text": "„Der Tischmülleimer macht aus dem Schlachtfeld Esstisch einen klinisch sauberen Ort.“"
                            },
                            {
                                "example_id": "987be774-d00a-4795-ba5f-a4c7ab590ae8",
                                "sense_id": "38eb2874-d82d-3616-b431-a8f50a70b6c8",
                                "text": "„Diese Tischmülleimer gibt es als rustikale Keramiktöpfe bis hin zum aufwändigen Stilporzellan für die gehobene Gastronomie.“"
                            },
                            {
                                "example_id": "907de9f0-ab01-46b6-ac1f-2461a644b3e9",
                                "sense_id": "38eb2874-d82d-3616-b431-a8f50a70b6c8",
                                "text": "„Der Tischmülleimer ist ein weißer, sehr schöner Keramikbecher, der von außen mit einem roten Filzflor beflockt ist.“"
                            },
                            {
                                "example_id": "04bab269-6c75-4cfe-a30d-d603574ec1a1",
                                "sense_id": "38eb2874-d82d-3616-b431-a8f50a70b6c8",
                                "text": "„Wenn wir zum nächsten Wein übergehen, kippe ich den letzten Schluck in den Spucknapf, so einen Kübel aus Metall, der mich an die Tischmülleimer erinnert, die sie in Hotels manchmal haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
