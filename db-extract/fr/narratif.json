                    {
                        "translation_id": "0ff2b8bc-c481-4db5-b546-ddf49c044051",
                        "source_entry_id": "9079f780-ddee-3165-88fd-c0bd07a1faed",
                        "target_lang_word": "narrative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narrative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6a8814-3c0a-365f-8c88-00e02894862e",
                                        "entry_id": "8e969ba6-ccba-3c25-a850-129803d11162",
                                        "glosses": [
                                            "Telling a story."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abf29dfb-e2df-3be8-8134-0338aa8311e8",
                                        "entry_id": "8e969ba6-ccba-3c25-a850-129803d11162",
                                        "glosses": [
                                            "Overly talkative; garrulous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3b0442-2560-4909-b002-fd2c6b35a111",
                                                "sense_id": "abf29dfb-e2df-3be8-8134-0338aa8311e8",
                                                "text": "But wise through time, and narrative with age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9617d39-c892-38ef-bf5a-80207b237471",
                                        "entry_id": "8e969ba6-ccba-3c25-a850-129803d11162",
                                        "glosses": [
                                            "Of or relating to narration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92333510-3cf8-409d-a1c8-885bb831602f",
                                                "sense_id": "e9617d39-c892-38ef-bf5a-80207b237471",
                                                "text": "the narrative thrust of a film"
                                            },
                                            {
                                                "example_id": "d18ba8b8-75c7-43f4-8f85-4c77d47462dc",
                                                "sense_id": "e9617d39-c892-38ef-bf5a-80207b237471",
                                                "text": "There is a deep divide in our species. On one side, the narrators: those who are indeed intensely narrative, self-storying, Homeric, in their sense of life and self, whether they look to the past or the future."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "narrative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "333a554f-4d81-375c-a322-b2d7ffa1601f",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "The systematic recitation of an event or series of events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41d0467a-55df-3912-bde8-e6eb50f3ec7c",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "That which is narrated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "A representation of an event or story in a way to promote a certain point of view."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0fe70a3-e8aa-4921-a641-5d6f2d60d8eb",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "changing, controlling the narrative"
                                            },
                                            {
                                                "example_id": "49471677-8a6b-4958-b870-94ccfa580ccc",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "Yes, there were instances of grandstanding and obsessive behaviour, but many were concealed at the time to help protect an aggressively peddled narrative of [Oscar] Pistorius the paragon, the emblem, the trailblazer."
                                            },
                                            {
                                                "example_id": "b1a2d8f1-0ae0-4aed-9c2b-78810711ce1d",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "[Alexandra] Bell challenges the dominant coverage of Brown’s killing with the aim of introducing “a perspective and a narrative which is probably how a lot of people from these communities saw it go down”."
                                            },
                                            {
                                                "example_id": "7bf5206c-aac5-4970-b93b-b16763831926",
                                                "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                                                "text": "The posters quickly became embroiled in the interminable battle over narrative in the Israel-Palestine conflict."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cf90033-b548-3c50-a22c-3a75bc4fb94a",
                                        "entry_id": "fe8a2db6-f39f-3f71-a088-ae41fc9692e4",
                                        "glosses": [
                                            "A manner of conveying a story, fictional or otherwise, in a body of work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a884eb-0f29-4067-8c01-8b91a2227490",
                                                "sense_id": "4cf90033-b548-3c50-a22c-3a75bc4fb94a",
                                                "text": "The plot is full of holes, but the narrative is extremely compelling."
                                            },
                                            {
                                                "example_id": "e0765b27-76c5-4f1b-a39c-4fd60ffbc702",
                                                "sense_id": "4cf90033-b548-3c50-a22c-3a75bc4fb94a",
                                                "text": "The player is free to create their own narrative within a much larger set of possible designed narrative options, or, given the geographic and dialogical openness of Morrowind, to refuse the creation of any narrative but their own and wander aimlessly through the game."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
