                "senses": [
                    {
                        "sense_id": "b7f38a52-6332-3f3c-811b-f7dbd19c53e5",
                        "entry_id": "0cbd5bd6-3f71-3f83-ba43-aa25d2f8d62d",
                        "glosses": [
                            "kleines gerundetes Teilchen (Tropfen), das aus Spucke (Speichel) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c0535a-947d-4906-b749-89881be524b8",
                                "sense_id": "b7f38a52-6332-3f3c-811b-f7dbd19c53e5",
                                "text": "„Der Kerl griff nach Nowaks Kragen und schrie ihn an – Speicheltröpfchen sprühten Nowak entgegen: »Scheißbulle! Da fehlt mindestens die Hälfte!«“"
                            },
                            {
                                "example_id": "dc02a8d8-fcc2-422b-8604-fa9ee0f5f3ae",
                                "sense_id": "b7f38a52-6332-3f3c-811b-f7dbd19c53e5",
                                "text": "„Die Speicheltröpfchen können von anderen Menschen eingeatmet werden und die Erreger infizieren einen neuen Wirt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
