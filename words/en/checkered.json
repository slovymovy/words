{
    "word_family": [
        "checker",
        "checkers"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7dc58ad5-15d1-3a94-9f57-35e1f7951a66",
                    "sense_definition": "Divided into a grid of squares of alternating colours or shades.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The picnic table was covered with a red and white <w>checkered</w> tablecloth.",
                            "target_lang_translations": {
                                "cs": "Piknikový stůl byl pokryt červenobílým <w>kostkovaným</w> ubrusem."
                            }
                        },
                        {
                            "text": "She wore a <w>checkered</w> shirt that matched her blue jeans perfectly.",
                            "target_lang_translations": {
                                "cs": "Měla na sobě <w>kostkovanou</w> košili, která se perfektně hodila k jejím modrým džínám."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaid",
                        "checked"
                    ],
                    "common_phrases": [
                        "checkered pattern",
                        "checkered flag"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vzor rozdělený na čtverce střídajících se barev nebo odstínů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kostkovaný",
                                "target_lang_sense_clarification": "nejběžnější výraz pro vzor se čtverci"
                            },
                            {
                                "target_lang_word": "kárový",
                                "target_lang_sense_clarification": "často používané pro vzor připomínající káry na hracích kartách"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbe1c527-3797-357a-9d89-92b6cd95a912",
                    "sense_definition": "Marked by a history of both successes and failures or inconsistent periods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician had a <w>checkered</w> past that made voters feel very uncertain.",
                            "target_lang_translations": {
                                "cs": "Politik měl <w>pohnutou</w> minulost, kvůli které si voliči nebyli jistí."
                            }
                        },
                        {
                            "text": "Despite a <w>checkered</w> career, he eventually became a highly respected leader.",
                            "target_lang_translations": {
                                "cs": "Navzdory <w>pohnuté</w> kariéře se nakonec stal vysoce uznávaným vůdcem."
                            }
                        }
                    ],
                    "synonyms": [
                        "inconsistent",
                        "varied",
                        "turbulent"
                    ],
                    "antonyms": [
                        "consistent"
                    ],
                    "common_phrases": [
                        "checkered past",
                        "checkered career"
                    ],
                    "target_lang_definitions": {
                        "cs": "Poznamenaný historií střídajících se úspěchů a neúspěchů nebo nekonzistentních období."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pohnutý",
                                "target_lang_sense_clarification": "v kontextu minulosti nebo kariéry plné zvratů"
                            },
                            {
                                "target_lang_word": "kontroverzní",
                                "target_lang_sense_clarification": "v kontextu minulosti, která vyvolává pochybnosti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48c97b2b-70a8-3ee4-9262-202407c4df69",
                    "sense_definition": "Simple past and past participle of <w>checker</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>checkered</w> the entire canvas with small blue and yellow squares.",
                            "target_lang_translations": {
                                "cs": "Umělec <w>vykostkoval</w> celé plátno malými modrými a žlutými čtverci."
                            }
                        },
                        {
                            "text": "The floor had been <w>checkered</w> with tiles of two different shades of grey.",
                            "target_lang_translations": {
                                "cs": "Podlaha byla <w>vykostkována</w> dlaždicemi dvou různých odstínů šedé."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb checker."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvořit vzor ze čtverců nebo rozdělit na čtverce."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vykostkovat",
                                "target_lang_sense_clarification": "vytvořit kostkovaný vzor"
                            },
                            {
                                "target_lang_word": "rozdělit na čtverce",
                                "target_lang_sense_clarification": "popisný překlad činnosti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}