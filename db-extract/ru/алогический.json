                "translations": [
                    {
                        "translation_id": "1f04819e-a400-418a-b173-9a5d396cdb7e",
                        "source_entry_id": "fe7cbccc-52b4-3a7f-a68e-2f0ed7e1b196",
                        "source_sense_id": "dd1254e6-9f82-3672-9ee7-81217523ff0f",
                        "target_lang_word": "inconsequent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsequent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0bfd60-127d-3f9f-a5f2-5464081db665",
                                        "entry_id": "fa455d8e-ee6c-3e59-ae12-b8758c113cb4",
                                        "glosses": [
                                            "Alternative form of inconsequential."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0c541d-e950-4ff9-ac98-ad86a8ee2a27",
                                                "sense_id": "6a0bfd60-127d-3f9f-a5f2-5464081db665",
                                                "text": "—Don’t mope over it all day, he said. I’m inconsequent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                        "entry_id": "fa455d8e-ee6c-3e59-ae12-b8758c113cb4",
                                        "glosses": [
                                            "illogical; not following from the premises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debb26c1-49a4-481b-81d4-4b4146619abb",
                                                "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                                "text": "She looked at him a minute, and it came to him as he met it an inconsequent sense that her eyes, when one got their full clearness, were still as beautiful as they had been in youth, only beautiful with a strange, cold light - a light that somehow was a part of the effect, if it wasn't rather a part of the cause, of the pale, hard sweetness of the season and the hour."
                                            },
                                            {
                                                "example_id": "bc8d613d-4293-4e9d-9e9e-96c1523653b6",
                                                "sense_id": "264ecbb4-0b74-3217-9723-29a76acee454",
                                                "text": "That possibility was now ever so much further from sight than on the eve of his arrival, and he perfectly felt that, should it come at all, it would have to be at best inconsequent and violent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c40ebe43-b158-493c-b724-76123b376acb",
                        "source_entry_id": "fe7cbccc-52b4-3a7f-a68e-2f0ed7e1b196",
                        "source_sense_id": "dd1254e6-9f82-3672-9ee7-81217523ff0f",
                        "target_lang_word": "alogical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alogical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbefcd55-41a7-3e91-b556-0af5967d315b",
                                        "entry_id": "7a5ef35c-882e-3a35-aebc-2ca39cecce6c",
                                        "glosses": [
                                            "Not based upon logic or reasoned argument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "653bf391-6d14-3e17-9192-dcf793fea968",
                                        "entry_id": "7a5ef35c-882e-3a35-aebc-2ca39cecce6c",
                                        "glosses": [
                                            "Opposed to logic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3172b488-11a0-4734-b0ce-ce26df8878ca",
                        "source_entry_id": "fe7cbccc-52b4-3a7f-a68e-2f0ed7e1b196",
                        "source_sense_id": "dd1254e6-9f82-3672-9ee7-81217523ff0f",
                        "target_lang_word": "illogical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illogical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5857ca-8105-3dec-84ee-6f2ff1008b51",
                                        "entry_id": "8be548dc-aa15-373a-a6fc-eb194e5f7ba6",
                                        "glosses": [
                                            "Contrary to logic; lacking sense or sound reasoning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffdabe8f-3abb-4ef9-84d7-a32b924864e1",
                                                "sense_id": "9f5857ca-8105-3dec-84ee-6f2ff1008b51",
                                                "text": "I received an illogical reply and that left me standing there feeling confused."
                                            },
                                            {
                                                "example_id": "d0bc1a27-a7af-4d04-b919-d6965bc6e992",
                                                "sense_id": "9f5857ca-8105-3dec-84ee-6f2ff1008b51",
                                                "text": "Your highly emotional reaction is most illogical."
                                            },
                                            {
                                                "example_id": "bc73b786-cb8d-438c-8594-447f0b31b659",
                                                "sense_id": "9f5857ca-8105-3dec-84ee-6f2ff1008b51",
                                                "text": "'Cause I was feeling so illogical, d-d-d-igital"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
