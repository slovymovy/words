                    {
                        "sense_id": "61f1170f-9ec8-3309-b6e3-b6f97cece593",
                        "entry_id": "2bfbd6b6-96e3-3e4c-845f-64d1e04851fc",
                        "glosses": [
                            "Bereitstellung sämtlicher notwendiger Güter zur Bedürfnisbefriedigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99504f99-d9d6-4cab-a632-c0056c4dbd20",
                                "sense_id": "61f1170f-9ec8-3309-b6e3-b6f97cece593",
                                "text": "„Nach einer Reiseanalyse der Forschungsgemeinschaft Urlaub und Reisen in Kiel interessieren sich immer mehr Menschen für diese Ferienart mit Rundumversorgung.“"
                            },
                            {
                                "example_id": "3025ba13-4d46-418c-88a6-232b01c71f88",
                                "sense_id": "61f1170f-9ec8-3309-b6e3-b6f97cece593",
                                "text": "„Wir haben es uns zur Aufgabe gemacht, den Kunden aus Dachau und dem Landkreis eine Rundumversorgung für die Gesundheit anzubieten.“"
                            },
                            {
                                "example_id": "d6e0c018-7ec1-41a2-980f-04d2ad7c93b0",
                                "sense_id": "61f1170f-9ec8-3309-b6e3-b6f97cece593",
                                "text": "„Orthopädie, Neurochirurgie, Allgemeinchirurgie, Radiologie (MRT, CT und digitales Röntgen) sowie das Rehazentrum bieten eine Rundumversorgung, ohne das Gebäude verlassen zu müssen.“"
                            }
                        ],
