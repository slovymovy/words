                            "plural"
                        ],
                        "form": "sie sind langmächtig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "199f5a03-23a4-36cf-8bb3-9d6793caf4c9",
                        "entry_id": "e2f61e1a-73ab-311a-a60c-ba85206fb943",
                        "glosses": [
                            "sehr lang, übermäßig lang"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9e5906ac-f4c8-4178-83ec-7c5c79db333c",
                                "sense_id": "199f5a03-23a4-36cf-8bb3-9d6793caf4c9",
                                "text": "Du brauchst keine langmächtigen Ausreden erfinden, denn jeder hier weiß Bescheid: Du hast einfach verschlafen."
                            },
                            {
                                "example_id": "637fdcfb-827f-4b08-a4b1-05cb6cddc0f6",
                                "sense_id": "199f5a03-23a4-36cf-8bb3-9d6793caf4c9",
                                "text": "„Aber er ist nicht recht bei der Sache; erst reißt er mitten durch den größten steinigen Scherhaufen durch, danach schneidet er in die Hollerstauden, daß er langmächtig wetzen und schärfen muß, um die Endsscharten wieder auszuschleifen, – und zuletzt steht er da, vergißt auf die Arbeit und stiert grad vor sich ins Weite.“"
                            },
                            {
                                "example_id": "87bb0634-a9f0-40e7-8c42-2e39fabfcff6",
                                "sense_id": "199f5a03-23a4-36cf-8bb3-9d6793caf4c9",
                                "text": "Mein Großvater war ein langmächtiger Kerl."
                            },
                            {
                                "example_id": "8221e2a7-0273-4956-9555-7350e676bca4",
                                "sense_id": "199f5a03-23a4-36cf-8bb3-9d6793caf4c9",
                                "text": "„So wächst auf einmal in mir die Vorstellung auf, einmal vor undenklichen Zeiten ein Baum gewesen zu sein, eine starke, langmächtige Eiche, die alle anderen Bäume überragte, mit ihrem Wipfel immerfort in Sonne und Sterne gucken durfte und alles Ferne und Niedere erschauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
