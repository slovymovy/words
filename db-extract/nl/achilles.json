                    {
                        "translation_id": "383b3093-dcb3-4913-b69c-516ec995a65c",
                        "source_entry_id": "71a8fd0e-0036-35c6-8862-868a570efc5a",
                        "source_sense_id": "cb741678-2981-3800-b458-88df3f1e3fbe",
