                            {
                                "example_id": "51efb55c-85ab-4b80-9df9-2205f4abbd66",
                                "sense_id": "ea7b5610-7f76-3c18-ae3d-14a23f524c16",
                                "text": "Juffrouw Catharina logeert buiten bij de jonge freule van Gronsveld; Bergsma leidt op last van de Prins de herstelwerken te Bergen op Zoom."
                            }
                        ]
                    },
                    {
                        "sense_id": "07162f6a-b82a-385a-888b-7bf242e23ab8",
