                "senses": [
                    {
                        "sense_id": "05001902-6968-3bc3-9fd1-cd938911c159",
                        "entry_id": "8b1a439a-d1a3-3430-bc95-8273fc7edcdf",
                        "glosses": [
                            "Neutraliser la chaux avec un acide afin de l’inactiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fdba156-b7d9-4d98-85e7-74cc7f738fd0",
                                "sense_id": "05001902-6968-3bc3-9fd1-cd938911c159",
                                "text": "L’ouverture e sert pour le nettoyage de l'appareil à déchauler, notamment pour enlever le carbonate de calcium séparé."
                            },
                            {
                                "example_id": "74d6cb2f-2b8f-467c-aeda-bb31f8907f14",
                                "sense_id": "05001902-6968-3bc3-9fd1-cd938911c159",
                                "text": "Le déchaulage doit se faire avec de l’acide lactique ou sulfurique pour le tannage au chrome, mais il n’est pas nécessaire qu’il soit complet pour le tannage végétal. Dès lors une trempe soignée suffit pour déchauler."
                            }
                        ]
                    }
