                "senses": [
                    {
                        "sense_id": "ef9ebcdf-fc21-3067-a059-2bba94c155fc",
                        "entry_id": "6871000b-3760-389e-872e-6765692524aa",
                        "glosses": [
                            "книжн. направленность мыслей, ума, совокупность интересов в какой-либо области интеллектуальной деятельности"
                        ],
                        "tags": [],
