            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fed9a0c6-7823-3ecd-a994-add259961418",
                    "sense_definition": "Passer par un lieu ou un intermédiaire sans s'y établir, en cours de déplacement ou d'acheminement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "passage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour aller au Japon, notre vol va <w>transiter</w> par la ville de Francfort."
                        },
                        {
                            "text": "Toutes les données doivent <w>transiter</w> par ce serveur sécurisé avant d'être traitées."
                        }
                    ],
                    "synonyms": [
                        "passer"
                    ],
                    "antonyms": [
                        "séjourner"
                    ],
                    "common_phrases": [
                        "transiter par un pays",
                        "transiter par un aéroport"
                    ]
                },
                {
                    "sense_id": "27ef3a8a-2771-3ab4-88c3-1eb8673d6272",
                    "sense_definition": "Faire passer des marchandises ou des cargaisons par un territoire soumis au régime de transit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette société de logistique peut <w>transiter</w> les marchandises d'un continent à l'autre."
                        },
                        {
                            "text": "Les douaniers ont autorisé l'entreprise à <w>transiter</w> des conteneurs scellés sans taxe supplémentaire."
                        }
                    ],
                    "synonyms": [
                        "acheminer",
                        "transporter"
                    ],
                    "common_phrases": [
