                "senses": [
                    {
                        "sense_id": "01700b3c-6ee4-32b6-95e3-5dfd45149d90",
                        "entry_id": "b258f36a-d0ff-344e-bb24-922dab539009",
                        "glosses": [
                            "met name van kritiek: met de bedoeling iets of iemand ermee te verbeteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2f49417-9849-4ebf-97ee-54ed426bfe9b",
                                "sense_id": "01700b3c-6ee4-32b6-95e3-5dfd45149d90",
                                "text": "Op sociale media werd lovend over de zangeres gesproken; vooral haar behulpzaamheid en opbouwende kritiek werden gewaardeerd."
                            },
                            {
                                "example_id": "dc671ab1-81c2-4c57-9051-419bf47a2529",
                                "sense_id": "01700b3c-6ee4-32b6-95e3-5dfd45149d90",
                                "text": ",,Ik kreeg toen veel kritiek\", blikte Wijnaldum terug. ,,Maar geen opbouwende. Willem schreef een column over mij die me raakte.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "13e0dc03-8779-3b94-aa7c-baf6085600f6",
                        "entry_id": "b258f36a-d0ff-344e-bb24-922dab539009",
                        "glosses": [
                            "van iets of iemand dat hij betrokken is bij de start van een proces"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c45515-db62-48ea-bb03-5d67ef105bb1",
                                "sense_id": "13e0dc03-8779-3b94-aa7c-baf6085600f6",
                                "text": "Ajax speelde zonder Frenkie de Jong die met lichte knieklachten de wedstrijd in Limburg moest laten schieten. Op zijn positie koos Erik ten Hag opnieuw voor Carel Eiting boven Donny van de Beek in wie de trainer geen controlerende/opbouwende middenvelder ziet."
                            }
                        ]
                    }
