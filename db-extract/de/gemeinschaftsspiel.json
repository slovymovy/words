                "senses": [
                    {
                        "sense_id": "29f5b8a4-5cdd-3d6a-908a-47a73bcb6706",
                        "entry_id": "72ae4782-c629-3c4a-a1b1-262b958eefcf",
                        "glosses": [
                            "von mehreren Personen miteinander praktiziertes oder praktizierbares Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0734cf2-676b-4808-b475-7d3ca0c17341",
                                "sense_id": "29f5b8a4-5cdd-3d6a-908a-47a73bcb6706",
                                "text": "„Vor allem sind es die eigentlichen Gemeinschaftsspiele, die im Schulalter zu voller Blüte gelangen.“"
                            },
                            {
                                "example_id": "84bbb84d-3c4d-465a-a58c-5ecd9f044e4c",
                                "sense_id": "29f5b8a4-5cdd-3d6a-908a-47a73bcb6706",
                                "text": "„Das Spiel kann als ein Gemeinschaftsspiel ausgetragen werden, bei dem sich alle Spieler miteinander bemühen, den Ball möglichst oft zu spielen und dabei nicht auf den Boden fallen zu lassen.“"
                            },
                            {
                                "example_id": "225935b4-04b5-49f3-8703-9ff09444899b",
                                "sense_id": "29f5b8a4-5cdd-3d6a-908a-47a73bcb6706",
                                "text": "„Glücklicherweise wurden mein Bruder und ich bei einem Kammermusikexperten wie Sandor Végh oder dem Düsseldorfer Schäffer-Quartett auf das differenzierte Gemeinschaftsspiel optimal vorbereitet.“"
                            },
                            {
                                "example_id": "ead0f2a3-c0b4-4a9c-b539-bac98ec71552",
                                "sense_id": "29f5b8a4-5cdd-3d6a-908a-47a73bcb6706",
                                "text": "„Der Geist, der dieses Gemeinschaftsspiel beseelt, wäre ein gutes Heilmittel für manche Bühne der hohen Diplomatie: Herz, Humor und gütige Ironie über die allmächtige Torheit, die ohne Ansehen der Nation zeitlos herrscht.M. Z.“"
                            },
                            {
                                "example_id": "a97af1a5-b026-4071-a261-cebbf1d2ecaa",
                                "sense_id": "29f5b8a4-5cdd-3d6a-908a-47a73bcb6706",
                                "text": "„Könnte man sagen, die Kindfrau Persephone bevorzugt das Gemeinschaftsspiel, während die Vatertochter, Pallas Athene, im Tennis-Court regiert? frage ich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
