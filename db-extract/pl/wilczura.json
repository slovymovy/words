                "senses": [
                    {
                        "sense_id": "8968b4cd-45bf-39cf-98c3-cf4cad84dec8",
                        "entry_id": "480a4be7-d62f-3515-81a4-ba7736df67d7",
                        "glosses": [
                            "bearbeiteter Pelz eines Wolfes; Wolfsfell, Wolfspelz"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "bd271b73-5576-489e-a9ca-c44e2179d5fc",
                                "sense_id": "8968b4cd-45bf-39cf-98c3-cf4cad84dec8",
                                "text": "„Przespawszy się pod ciepłą wilczurą, doczekał Rzędzian ranka […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b5c7ea59-da68-3c2a-a8e1-0f661f86c5a9",
                        "entry_id": "480a4be7-d62f-3515-81a4-ba7736df67d7",
                        "glosses": [
                            "Pelzmantel aus Wolsfellen; Wolfspelz"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "940f7719-d5de-46f6-9982-3268c038bf3a",
                                "sense_id": "b5c7ea59-da68-3c2a-a8e1-0f661f86c5a9",
                                "text": "„Szedł podróżny w wilczurze, zaszedł mu wilk drogę.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5ab38eec-5ae8-3fb2-b374-21115d1815a8",
                        "entry_id": "480a4be7-d62f-3515-81a4-ba7736df67d7",
                        "glosses": [
                            "weiblicher Wolf; Wölfin"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f462542-bb7b-40f3-971f-1aa876884cdc",
                        "source_entry_id": "480a4be7-d62f-3515-81a4-ba7736df67d7",
                        "source_sense_id": "8968b4cd-45bf-39cf-98c3-cf4cad84dec8",
                        "source_sense_description": "veraltet: bearbeiteter Pelz eines Wolfes; Wolfsfell, Wolfspelz",
                        "target_lang_word": "Wolfsfell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wolfsfell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f57c6cde-4616-3918-b794-146916bb40bb",
                                        "entry_id": "44d0ddd0-9cf2-3332-aedf-ec79b6908256",
                                        "glosses": [
                                            "(abgezogenes) Fell eines Wolfs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62cfc87-6421-4d7f-8589-b7bffa684e08",
                                                "sense_id": "f57c6cde-4616-3918-b794-146916bb40bb",
                                                "text": "„Wer an der Wand seines Hauses ein Wolfsfell hängen hatte, galt als mutiger Mann, und Mut war in diesem Dorf eine Seltenheit, die daher von den Männern gerne zur Schau gestellt wurde.“"
                                            },
                                            {
                                                "example_id": "d49b8f27-71f8-4bc6-a39b-db9071bf9dc0",
                                                "sense_id": "f57c6cde-4616-3918-b794-146916bb40bb",
                                                "text": "„In der Fabel ‚Der Löwe, der Wolf und der Fuchs‘ schwärzt der Wolf, ‚des Königs Dank sich zu gewinnen‘, den abwesenden Nebenbuhler, den Fuchs, an. Dieser — vorgeführt — stimmt in listiger Rede Seine Majestät um: Die Wärme des Wolfsfells preist er als unfehlbares Heilmittel dem siechen, verlebten, vom Alter geplagten König an, der den Wolf töten läßt.“"
                                            },
                                            {
                                                "example_id": "b38b7045-b0e5-46fb-88d5-e43e7e27e462",
                                                "sense_id": "f57c6cde-4616-3918-b794-146916bb40bb",
                                                "text": "„Vier Wolfsfelle hatte ich auf dem Fußboden meines Hauses liegen. Sie waren schon ganz abgenutzt von dem vielen Drauftreten, aber es waren Wolfsfelle.“"
                                            },
                                            {
                                                "example_id": "ab8fffc7-113f-4e5e-8ab6-aec2a680033f",
                                                "sense_id": "f57c6cde-4616-3918-b794-146916bb40bb",
                                                "text": "„Den Reitern war es ein Leichtes, von oben Schläge auszuführen, die gut trafen; von beiden Seiten aus dem Walde kamen immer neue Scharen der wilden Krieger in Wolfsfellen, mit raubtierartigen Gelüsten nach Rache und Blut lechzend, hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
