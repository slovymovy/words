                        "glosses": [
                            "samen met andere zeilboten in dezelfde richting zeilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c172511d-e69d-40fa-a85f-a21b0a0b31f7",
                                "sense_id": "74a04dba-2495-36ea-a020-9f9ebfbcf674",
                                "text": "Er wordt getracht om mensen die aan het werkervaringsproject Stad Amsterdam hebben gewerkt, door te plaatsen naar de bouw van het zusterschip. Bij de bouw is enige haast geboden. Het moet in het voorjaar van 2000 meezeilen in een race van Lissabon naar Rio de Janeiro ter opluistering van de herdenking dat de Portugezen 500 jaar geleden Brazilië ontdekten. De bouw van het schip moet over ongeveer een maand beginnen. Damen bouwde eerder al de Eendracht."
                            }
                        ]
