                        "sense_id": "34f21f9e-85d0-36b6-aba9-b5b3b11fe303",
                        "entry_id": "7b15425b-6f30-37e2-af4c-0ea65cc6e850",
                        "glosses": [
                            "een tussenpersoon die actief is op de assurantiebeurs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3814d099-76b3-4def-875d-4d54efc8b833",
                                "sense_id": "34f21f9e-85d0-36b6-aba9-b5b3b11fe303",
                                "text": "In Nederland zijn nog nauwelijks schadeclaims ingediend na de cyberaanval van dinsdag: Dat meldt BNR na een rondgang langs een aantal grote verzekeringsmakelaars."
                            },
                            {
                                "example_id": "064940f1-8b91-4748-b6da-237fad967cd2",
                                "sense_id": "34f21f9e-85d0-36b6-aba9-b5b3b11fe303",
                                "text": "FIOD en OM onderzoeken minstens acht concerns die mogelijk steekpenningen toestopten aan ex-topman Gerhard M. van verzekeraar HDI. Onder hen zijn bekende ondernemingen als verzekeringsmakelaar AON en kantoorinrichter Ahrend, bericht het FD woensdag."
                            },
                            {
                                "example_id": "065874c5-448d-4c26-b42c-ae60664fd1b5",
                                "sense_id": "34f21f9e-85d0-36b6-aba9-b5b3b11fe303",
                                "text": "Bedrijven lopen wereldwijd meer risico's door terreur en politiek geweld. Dat blijkt uit de zogeheten Terrorism & Political Violence Map van risico-adviseur en verzekeringsmakelaar Aon die woensdag naar buiten kwam."
                            }
                        ]
                    }
