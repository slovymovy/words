                        "examples": [
                            {
                                "example_id": "a4f7a8e0-7f4b-451e-82cf-b9d65db735dd",
                                "sense_id": "44f19696-2b06-3254-9830-7bb3b116ed05",
                                "text": "„Das Landei sah sich nach einem Fluchtweg um, aber der Mann war stehen geblieben und bückte sich mit seinem langgeschnäbelten Ölkännchen über ein rostiges Gleis.“"
                            },
                            {
                                "example_id": "b51461f7-bb9d-4d1c-951b-80f72e7fc831",
                                "sense_id": "44f19696-2b06-3254-9830-7bb3b116ed05",
                                "text": "„Er hob die Hand zum Gruß, schaltete die Drehbank bedachtsam aus, stellte das Ölkännchen weg und wischte sich die Hände an einem Lappen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
