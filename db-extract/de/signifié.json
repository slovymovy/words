                "senses": [
                    {
                        "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                        "entry_id": "c5a203ba-a2e7-3b45-85f4-10f8ad383254",
                        "glosses": [
                            "Bedeutung des sprachlichen Zeichens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94dc6808-20b8-43ad-8f00-5b59e70e943a",
                                "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                                "text": ": Sprachliche Zeichen (signes) haben zwei Seiten und bestehen aus Signifié (Bedeutung) und Signifiant (Laut- oder Buchstabenfolge). Signifié ist in dieser französischen Form ein gängiger Begriff in der Linguistik und wird meistens klein geschrieben verwendet."
                            },
                            {
                                "example_id": "7c3e0f99-ccda-47e7-acbb-5374045d4f7a",
                                "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                                "text": "„Saussure zeichnet ein anderes Modell, in dem deutlicher wird, daß das Zeichen (signe) aus dem Zeichenkörper (signifiant: Bezeichnendes) und der Bedeutung (signifié: Bezeichnetes) besteht und daß der Sachverhalt (chose) das Nichtsprachliche ist.“"
                            },
                            {
                                "example_id": "28576d1a-adb2-4a07-b878-66bbd73a3907",
                                "sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                                "text": "„Saussure suchte seine Terminologie zu verbessern, und da er das ganze Zeichen als signe linguistique, also als sprachliches Zeichen, gefaßt hatte, schien ihm nun ein vom Verbum signifier abgeleitetes Begriffspaar, und zwar signifiant für die Lautung und signifié für den geistigen Inhalt, angemessener.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ba7ecac-2262-49a7-b840-9a488b45dd48",
                        "source_entry_id": "c5a203ba-a2e7-3b45-85f4-10f8ad383254",
                        "source_sense_id": "f0c276b2-179d-3373-9c96-9db216fc11b0",
                        "source_sense_description": "Linguistik: Bedeutung des sprachlichen Zeichens",
                        "target_lang_word": "concept",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concept",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08b24b01-f8e6-3a69-b4dd-7ed667abdd8d",
                                        "entry_id": "7e8343c2-88c7-30bc-8ed5-501939b2c666",
                                        "glosses": [
                                            "Idée abstraite et générale ; abstraction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c575dff3-b9d1-4951-b4f6-5cf43dbb8704",
                                                "sense_id": "08b24b01-f8e6-3a69-b4dd-7ed667abdd8d",
                                                "text": "En tant que concept politique, l’État-nation se caractérise par une autorité à base territoriale, et non par des conceptions universalistes, extra-territoriales."
                                            },
                                            {
                                                "example_id": "553d7a7b-91fd-440b-a145-ff50944d2ef3",
                                                "sense_id": "08b24b01-f8e6-3a69-b4dd-7ed667abdd8d",
                                                "text": "Le drame ivoirien mêle inextricablement ces deux dimensions et a abouti à partir de la tentative d’instauration du concept d’« ivoirité » à une coupure du pays en deux et à une situation de guerre civile."
                                            },
                                            {
                                                "example_id": "ac041489-2e8b-47a2-b856-a38c2ef1a3f2",
                                                "sense_id": "08b24b01-f8e6-3a69-b4dd-7ed667abdd8d",
                                                "text": "Le concept de remplacement des gens que l'on fréquente et qui nous sont proches par des humanoïdes est évidemment puissant et traumatisant car il suscite le doute et la paranoïa aiguë."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f5c1d7-c848-3f3f-be9e-e78077f91ad1",
                                        "entry_id": "7e8343c2-88c7-30bc-8ed5-501939b2c666",
                                        "glosses": [
                                            "Idée générale de quelque chose"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff24752b-c458-4b47-955d-a09ff33cc576",
                                                "sense_id": "78f5c1d7-c848-3f3f-be9e-e78077f91ad1",
                                                "text": "Un concept produit"
                                            },
                                            {
                                                "example_id": "8e09bce1-0200-488f-a389-6666cdcdb660",
                                                "sense_id": "78f5c1d7-c848-3f3f-be9e-e78077f91ad1",
                                                "text": "L'innovation de Redbull, c'est le produit, la taurine, et le concept, les sports extrêmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea3a212-cfa3-3cfe-acf4-bc4d697e558b",
                                        "entry_id": "7e8343c2-88c7-30bc-8ed5-501939b2c666",
                                        "glosses": [
                                            "Vue de l’esprit, idée qu’on se fait d’une chose en la détachant de son objet réel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0336a94-98c2-45ee-b943-af29e32aea67",
                                                "sense_id": "dea3a212-cfa3-3cfe-acf4-bc4d697e558b",
                                                "text": "La Scolastique […] a accrédité une mentalité qui n’a pas prise sur le réel, qui tient pour légitimes certaines illusions structurales de notre esprit : notre tendance à réaliser nos concepts et à réifier toutes choses."
                                            },
                                            {
                                                "example_id": "02c86ccc-a939-4e2e-83cb-24cf12b011b2",
                                                "sense_id": "dea3a212-cfa3-3cfe-acf4-bc4d697e558b",
                                                "text": "Que sont-elles donc et que signifie ce problème : concevoir les idées transcendentales comme représentant des réalités ? Les idées ne sont ni des concepts ni des intuitions. Donc elles ne représentent rien de réel."
                                            },
                                            {
                                                "example_id": "bfcd77cc-f5b2-49f0-9c8e-9254b13610ac",
                                                "sense_id": "dea3a212-cfa3-3cfe-acf4-bc4d697e558b",
                                                "text": "Et elle repose, selon le père Émile Shoufani, grec catholique, sur un concept erroné ou tout au moins obsolète : les chrétiens de Terre sainte. Un mythe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5710a69-47c4-3d6d-8754-047e7fc85ad8",
                                        "entry_id": "7e8343c2-88c7-30bc-8ed5-501939b2c666",
                                        "glosses": [
                                            "Personne étrange, sortant du lot."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73765907-4269-4319-ad87-4f271fdd15bf",
                                                "sense_id": "d5710a69-47c4-3d6d-8754-047e7fc85ad8",
                                                "text": "Jean-Pierre – C’est ma belle-mère… C’est un concept."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
