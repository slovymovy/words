                    {
                        "sense_id": "80012b4a-12a9-30f6-ae01-6b3d1b4ba62c",
                        "entry_id": "22108df3-1206-320e-beae-c8f24afef293",
                        "glosses": [
                            "Féminin singulier de blondinet."
                        ],
                        "tags": [
