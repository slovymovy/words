{
    "word_family": [
        "tamely",
        "tameness",
        "tamer",
        "untamed",
        "tamable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86906e3d-3218-3ee2-a8bf-1dd2ad14c709",
                    "sense_definition": "Accustomed to human contact and not wild or dangerous.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion was quite <w>tame</w> and allowed the keepers to pet it.",
                            "target_lang_translations": {
                                "ru": "Лев был довольно <w>ручным</w> и позволял смотрителям гладить себя."
                            }
                        },
                        {
                            "text": "After years of living near the village, the <w>tame</w> deer would eat right from your hand.",
                            "target_lang_translations": {
                                "ru": "После многих лет жизни рядом с деревней <w>приручённый</w> олень ел прямо из рук."
                            }
                        }
                    ],
                    "antonyms": [
                        "wild"
                    ],
                    "common_phrases": [
                        "tame animal",
                        "perfectly tame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привыкший к контакту с человеком, не дикий и не опасный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручной",
                                "target_lang_sense_clarification": "о животном"
                            },
                            {
                                "target_lang_word": "приручённый",
                                "target_lang_sense_clarification": "ставший домашним"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e22e6f24-0796-3ec2-bf7d-31c4e8a551bf",
                    "sense_definition": "Lacking excitement, spirit, or interest; dull.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "excitement_level",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This party is too <w>tame</w> for me, so I think I will go home early.",
                            "target_lang_translations": {
                                "ru": "Эта вечеринка слишком <w>скучная</w> для меня, так что, думаю, я пойду домой пораньше."
                            }
                        },
                        {
                            "text": "For a thriller, that film was really <w>tame</w> and lacked any real suspense.",
                            "target_lang_translations": {
                                "ru": "Для триллера этот фильм был очень <w>пресным</w>, в нём не хватало настоящего напряжения."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "flat",
                        "insipid",
                        "unexciting"
                    ],
                    "antonyms": [
                        "exciting"
                    ],
                    "common_phrases": [
                        "a bit tame",
                        "rather tame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный азарта, духа или интереса; скучный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скучный",
                                "target_lang_sense_clarification": "неинтересный"
                            },
                            {
                                "target_lang_word": "пресный",
                                "target_lang_sense_clarification": "без изюминки"
                            },
                            {
                                "target_lang_word": "вялый",
                                "target_lang_sense_clarification": "невыразительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b53520f9-5b54-3b2c-a115-b101d8f20278",
                    "sense_definition": "Of a person, well-behaved or submissive; not radical or extreme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company preferred a <w>tame</w> employee who would never challenge the management's decisions.",
                            "target_lang_translations": {
                                "ru": "Компания предпочитала <w>покорного</w> сотрудника, который никогда бы не оспаривал решения руководства."
                            }
                        },
                        {
                            "text": "He was a <w>tame</w> scientist who only published results that the office approved of.",
                            "target_lang_translations": {
                                "ru": "Он был <w>ручным</w> учёным, который публиковал только те результаты, которые одобряло начальство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tame version"
                    ],
                    "target_lang_definitions": {
                        "ru": "О человеке: послушный, покорный; не радикальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покорный",
                                "target_lang_sense_clarification": "послушный"
                            },
                            {
                                "target_lang_word": "ручной",
                                "target_lang_sense_clarification": "подконтрольный"
                            },
                            {
                                "target_lang_word": "смирный",
                                "target_lang_sense_clarification": "тихий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d0d1457-067d-39e5-bb3e-f313449937a9",
                    "sense_definition": "Crushed, subdued, or lacking in spirit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defeated soldiers looked <w>tame</w> and broken as they marched back to camp.",
                            "target_lang_translations": {
                                "ru": "Побежденные солдаты выглядели <w>подавленными</w> и сломленными, когда маршировали обратно в лагерь."
                            }
                        },
                        {
                            "text": "Years of hardship had left him with a <w>tame</w> and spiritless outlook on life.",
                            "target_lang_translations": {
                                "ru": "Годы лишений оставили его со <w>смиренным</w> и безжизненным взглядом на жизнь."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавленный, сломленный или лишенный воли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавленный",
                                "target_lang_sense_clarification": "лишенный духа"
                            },
                            {
                                "target_lang_word": "смиренный",
                                "target_lang_sense_clarification": "кроткий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8322414d-85a7-3423-8a5f-730753042e95",
                    "sense_definition": "Capable of being represented as a finite closed polygonal chain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In knot theory, we distinguish between a <w>tame</w> knot and a wild one.",
                            "target_lang_translations": {
                                "ru": "В теории узлов мы различаем <w>ручной</w> узел и дикий."
                            }
                        },
                        {
                            "text": "The mathematical proof assumes that the curve is <w>tame</w> for the sake of simplicity.",
                            "target_lang_translations": {
                                "ru": "Математическое доказательство предполагает для простоты, что кривая является <w>ручной</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "wild"
                    ],
                    "common_phrases": [
                        "tame knot"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный быть представленным в виде конечной замкнутой ломаной линии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ручной",
                                "target_lang_sense_clarification": "в топологии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64cf839d-025e-3fed-9201-f714f649e01d",
                    "sense_definition": "To make a wild animal <w>tame</w>; to domesticate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>tamed</w> the wild horse until it was gentle enough for a child to ride.",
                            "target_lang_translations": {
                                "ru": "Он <w>укрощал</w> дикую лошадь до тех пор, пока она не стала достаточно смирной, чтобы на ней мог ездить ребенок."
                            }
                        },
                        {
                            "text": "It takes a lot of patience to <w>tame</w> a wild animal found in the woods.",
                            "target_lang_translations": {
                                "ru": "Требуется много терпения, чтобы <w>приручить</w> дикое животное, найденное в лесу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tame a horse",
                        "tame a beast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать дикое животное ручным; одомашнить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приручать",
                                "target_lang_sense_clarification": "делать ручным"
                            },
                            {
                                "target_lang_word": "укрощать",
                                "target_lang_sense_clarification": "подчинять волю"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97ae5c48-3016-349c-a79b-039670bddebc",
                    "sense_definition": "To take control of something that is unruly or powerful.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had to <w>tame</w> the riots before they spread to the rest of the city.",
                            "target_lang_translations": {
                                "ru": "Полиции пришлось <w>обуздать</w> беспорядки, прежде чем они распространились на остальную часть города."
                            }
                        },
                        {
                            "text": "She used a strong gel to <w>tame</w> her frizzy hair before the interview.",
                            "target_lang_translations": {
                                "ru": "Она использовала сильный гель, чтобы <w>уложить</w> свои вьющиеся волосы перед собеседованием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tame the wild",
                        "tame the fire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взять под контроль что-то неуправляемое или мощное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обуздать",
                                "target_lang_sense_clarification": "взять под контроль"
                            },
                            {
                                "target_lang_word": "усмирить",
                                "target_lang_sense_clarification": "успокоить"
                            },
                            {
                                "target_lang_word": "уложить",
                                "target_lang_sense_clarification": "о волосах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7239bd2e-01a9-360f-ada7-016ad0172da2",
                    "sense_definition": "To make someone gentle, meek, or submissive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior_modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh prison sentence finally <w>tamed</w> his rebellious spirit.",
                            "target_lang_translations": {
                                "ru": "Суровый тюремный приговор наконец <w>усмирил</w> его бунтарский дух."
                            }
                        },
                        {
                            "text": "Guard dogs need to be <w>tamed</w> so that they know who not to attack.",
                            "target_lang_translations": {
                                "ru": "Сторожевых собак нужно <w>дрессировать</w>, чтобы они знали, на кого не следует нападать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tame one's spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо кротким, тихим или покорным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усмирить",
                                "target_lang_sense_clarification": "сделать покорным"
                            },
                            {
                                "target_lang_word": "подавить",
                                "target_lang_sense_clarification": "сломить волю"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bf48400-4fc6-33b0-9fd3-03eef3ba5d05",
                    "sense_definition": "To become <w>tame</w> or domesticated over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some species of birds are very shy and do not <w>tame</w> easily even with food.",
                            "target_lang_translations": {
                                "ru": "Некоторые виды птиц очень пугливы и нелегко <w>приручаются</w> даже едой."
                            }
                        },
                        {
                            "text": "The stray cat began to <w>tame</w> after we fed it every morning for a month.",
                            "target_lang_translations": {
                                "ru": "Бродячая кошка начала <w>привыкать к людям</w> после того, как мы кормили её каждое утро в течение месяца."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться ручным или домашним со временем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приручаться",
                                "target_lang_sense_clarification": "становиться ручным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab31476-8e3c-355b-99b6-95593f4b002e",
                    "sense_definition": "To broach or open up a container; to taste or distribute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the time of famine, he <w>tameth</w> his stacks of corn to feed the poor.",
                            "target_lang_translations": {
                                "ru": "Во время голода он <w>распечатывает</w> свои запасы зерна, чтобы накормить бедных."
                            }
                        },
                        {
                            "text": "The host decided to <w>tame</w> the new cask of wine for his guests.",
                            "target_lang_translations": {
                                "ru": "Хозяин решил <w>откупорить</w> новую бочку вина для своих гостей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распечатать или открыть емкость; отведать или распределить содержимое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распечатывать",
                                "target_lang_sense_clarification": "открывать бочку/запасы"
                            },
                            {
                                "target_lang_word": "початый",
                                "target_lang_sense_clarification": "начать использовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2acb08a8-3339-3948-bd9b-dc0176fbd66f",
                    "sense_definition": "A river in England, flowing through the West Midlands and joining the Trent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rivers",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Tame</w> flows through the heart of the industrial West Midlands.",
                            "target_lang_translations": {
                                "ru": "Река <w>Тейм</w> протекает через самое сердце промышленного Уэст-Мидлендса."
                            }
                        },
                        {
                            "text": "We took a long walk along the banks of the <w>Tame</w> last Sunday.",
                            "target_lang_translations": {
                                "ru": "В прошлое воскресенье мы долго гуляли по берегам <w>Тейма</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "River Tame"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Англии, протекающая через Уэст-Мидлендс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тейм",
                                "target_lang_sense_clarification": "название реки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a77c4b02-bb86-3a07-8f0c-47cb92334c73",
                    "sense_definition": "An English surname derived from a nickname.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history book mentions a prominent family named <w>Tame</w>.",
                            "target_lang_translations": {
                                "ru": "В книге по местной истории упоминается известная семья по фамилии <w>Тейм</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Tame</w> was appointed as the new headmaster of the school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Тейм</w> был назначен новым директором школы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от прозвища."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тейм",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}