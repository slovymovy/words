                "senses": [
                    {
                        "sense_id": "b9f26078-8b21-3d97-b786-570dc0355228",
                        "entry_id": "2b7381f5-515f-3515-ac49-8690cbf93f07",
                        "glosses": [
                            "Ustensile de ménage, récipient dans lequel on sert des sauces sur la table."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca71ada3-99ca-4c59-9484-bb4f8d4b73b6",
                                "sense_id": "b9f26078-8b21-3d97-b786-570dc0355228",
                                "text": "Tout au plus, pourrait-on servir à part une saucière de sauce Hollandaise."
                            },
                            {
                                "example_id": "d3a68e94-6c4d-49ff-b403-5ce796242d74",
                                "sense_id": "b9f26078-8b21-3d97-b786-570dc0355228",
                                "text": "Saucière d’argent, de porcelaine."
                            },
                            {
                                "example_id": "74cf6399-6f85-4ee3-80b7-d84399ac27fb",
                                "sense_id": "b9f26078-8b21-3d97-b786-570dc0355228",
                                "text": "Verser le jus dans une saucière."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b7998fe-551b-3b9f-874c-eb8254bf8c56",
                        "entry_id": "2b7381f5-515f-3515-ac49-8690cbf93f07",
                        "glosses": [
                            "Cuisinière qui, dans un restaurant, est chargée de faire les sauces."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "0c7ba210-6493-4a11-82ee-877dd361d0bf",
                                "sense_id": "7b7998fe-551b-3b9f-874c-eb8254bf8c56",
                                "text": "Saucière de formation, son jeune et brillant parcours lui a permis d’être aux fourneaux de grands chefs français (Éric Fréchon, Yannick Alléno, Alain Ducasse, Gilles Goujon)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84918660-7901-4e46-b482-09aa1584c7ff",
                        "source_entry_id": "2b7381f5-515f-3515-ac49-8690cbf93f07",
                        "source_sense_id": "b9f26078-8b21-3d97-b786-570dc0355228",
                        "source_sense_description": "Ustensile",
                        "target_lang_word": "Soßenschüssel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soßenschüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b47845d-e7ed-377a-821a-422ab11f733a",
                                        "entry_id": "fc11af22-dfc0-348f-b0b4-3c987d4c244c",
                                        "glosses": [
                                            "bestimmte Schüssel, die zum Servieren von Soße verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "801f451d-baa2-4d2f-b80f-653e52cf1606",
                                                "sense_id": "0b47845d-e7ed-377a-821a-422ab11f733a",
                                                "text": "Meine letzte Soßenschüssel, ein Erbstück meiner Tante, habe ich schon vor Jahren verkauft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60dc2390-0744-4a61-a4df-e99fff36a823",
                        "source_entry_id": "2b7381f5-515f-3515-ac49-8690cbf93f07",
                        "source_sense_id": "b9f26078-8b21-3d97-b786-570dc0355228",
                        "source_sense_description": "Ustensile",
                        "target_lang_word": "Sauciere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sauciere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a260c97-90a7-36e4-9e42-3b9e61627d37",
                                        "entry_id": "eee471fb-9742-3b52-8f7e-a2efdc956242",
                                        "glosses": [
                                            "Gefäß mit Henkel und Tülle, in dem Soßen serviert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254d718f-3b34-4573-b5de-bd68e42a7cc4",
                                                "sense_id": "5a260c97-90a7-36e4-9e42-3b9e61627d37",
                                                "text": "Bei diesem Service ist leider die Sauciere schon kaputt."
                                            },
                                            {
                                                "example_id": "822a9bb9-948b-42f7-a0be-69736bb477f7",
                                                "sense_id": "5a260c97-90a7-36e4-9e42-3b9e61627d37",
                                                "text": "„Minutenlang wirbelte der Herbert jetzt zwischen Küche und Gastraum, um Saucieren und Assietten nachzufüllen.“"
                                            },
                                            {
                                                "example_id": "40c21537-c12f-48f8-b104-b86cd4510816",
                                                "sense_id": "5a260c97-90a7-36e4-9e42-3b9e61627d37",
                                                "text": "„Er füllte zwei Gläser, stellte sie vor Diantha und Ida ab, nahm sich, noch immer stehend, ein Stück Fleisch und tunkte es in die Sauciere.“"
                                            },
                                            {
                                                "example_id": "1867874a-f8c1-4cad-afbb-ae8f25ca8bcd",
                                                "sense_id": "5a260c97-90a7-36e4-9e42-3b9e61627d37",
                                                "text": "„Der Braten wurde auf einer Platte serviert, die Kartoffeln in einer Schüssel, die Soße in einer Sauciere, zwei Runden, dazwischen eine Pause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a071b28f-e26c-4e08-8b6d-3726a0e4849a",
                        "source_entry_id": "2b7381f5-515f-3515-ac49-8690cbf93f07",
                        "source_sense_id": "b9f26078-8b21-3d97-b786-570dc0355228",
                        "source_sense_description": "Ustensile",
                        "target_lang_word": "gravy boat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravy boat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9fa4be2-f8ce-3ab7-90d4-426f4f96ae5b",
                                        "entry_id": "18aa97a4-2aaa-37e3-8fe8-b595279a84ff",
                                        "glosses": [
                                            "A dish with a handle and spout, used to serve gravy or other sauces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c16821f0-c8b4-3755-b215-d7273bfc1480",
                                        "entry_id": "18aa97a4-2aaa-37e3-8fe8-b595279a84ff",
                                        "glosses": [
                                            "A source of easily obtained money or benefits."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71ac100-06ad-44e2-9481-fdd0e2276044",
                                                "sense_id": "c16821f0-c8b4-3755-b215-d7273bfc1480",
                                                "text": "Not only have suggestions for their elimination evoked a great hue and cry of protest, but other pressure groups are plugging diligently in an effort to get aboard the \"gravy boat.\""
                                            },
                                            {
                                                "example_id": "c5e3cef1-72bd-4b26-bfa3-26e1c4ca8c5e",
                                                "sense_id": "c16821f0-c8b4-3755-b215-d7273bfc1480",
                                                "text": "Everybody had climbed aboard the \"gravy boat”—except the landlord; and he wanted to get in, too."
                                            },
                                            {
                                                "example_id": "533faedc-8f4e-4eea-93e7-8d56bea292e2",
                                                "sense_id": "c16821f0-c8b4-3755-b215-d7273bfc1480",
                                                "text": "Through drawing attention to that, many organisations which had never previously put in an application for assistance had tried to get on the gravy boat."
                                            },
                                            {
                                                "example_id": "f857643d-4a16-46b8-ae08-605bb62a072f",
                                                "sense_id": "c16821f0-c8b4-3755-b215-d7273bfc1480",
                                                "text": "This herd behavior in not wanting to miss the gravy boat led to a collective lowering of standards that ended with the 2008 financial implosion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20ef98c6-a55d-4662-addd-4d8c6951126b",
                        "source_entry_id": "2b7381f5-515f-3515-ac49-8690cbf93f07",
