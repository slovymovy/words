                        "entry_id": "74103ab6-df63-3213-bd7e-1768299fb673",
                        "glosses": [
                            "Marmota knaagdier dat vooral in het hooggebergte leeft maar ook veel als huisdier wordt gehouden"
                        ],
                        "tags": [
                            "knaagdieren"
                        ],
                        "examples": [
                            {
                                "example_id": "d86eb7f1-6dc2-4615-91b9-690a60f9eb4e",
                                "sense_id": "86a2ed85-f932-37f8-ad2e-162b6fddf0f5",
                                "text": "Ik hoopte stiekem een beer te kunnen zien baden in de rivier, maar was ook wel tevreden met alle herten, eekhoorns, marmotten, vogels en de Amerikaanse adelaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67a8194b-7773-4096-ab7b-c3df70b0ba0c",
                        "source_entry_id": "74103ab6-df63-3213-bd7e-1768299fb673",
                        "source_sense_id": "86a2ed85-f932-37f8-ad2e-162b6fddf0f5",
                        "source_sense_description": "knaagdier dat vooral in het hooggebergte leeft maar ook veel als huisdier wordt gehouden",
                        "target_lang_word": "Murmeltier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Murmeltier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af118797-0a30-3ca8-ba11-c0437cc48803",
                                        "entry_id": "91724da8-ef65-3d02-b871-79d95dd4e94d",
                                        "glosses": [
                                            "großes, winterschlafendes Nagetier der Alpen und Karpaten; Art der gleichnamigen Gattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9ddb47-0f94-4b91-9d22-f9367293a29c",
                                                "sense_id": "af118797-0a30-3ca8-ba11-c0437cc48803",
                                                "text": "Da ertönte der Pfiff eines Murmeltieres."
                                            },
                                            {
                                                "example_id": "3c72dc3d-4af9-407e-b94b-48bfa7959912",
                                                "sense_id": "af118797-0a30-3ca8-ba11-c0437cc48803",
                                                "text": "„Die Einwanderer glaubten, dass ein aus dem Winterschlaf erwachendes Murmeltier an Mariä Lichtmess, genau 40 Tage nach Weihnachten, das Wetter vorhersage.“"
                                            },
                                            {
                                                "example_id": "bcdccd47-d188-4f9d-a828-78f08eec0cd8",
                                                "sense_id": "af118797-0a30-3ca8-ba11-c0437cc48803",
                                                "text": "„Cyrus Smith und seine Kameraden schliefen wie Murmeltiere in dieser Höhle und waren bei Sonnenaufgang auf den Beinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "617e3455-87e3-35d1-a728-9300224dbe6a",
                                        "entry_id": "91724da8-ef65-3d02-b871-79d95dd4e94d",
                                        "glosses": [
                                            "die Gattung Marmota, zu der [1] gehört"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48982287-73cd-446c-847c-8cea54509e27",
                                                "sense_id": "617e3455-87e3-35d1-a728-9300224dbe6a",
                                                "text": "Murmeltiere kommen in Eurasien und Nordamerika vor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "080c431e-4934-30e7-a80a-0b154d015889",
                                        "entry_id": "91724da8-ef65-3d02-b871-79d95dd4e94d",
                                        "glosses": [
                                            "ein verschlafener Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43607c94-8f9e-4c0c-8bf9-b46d0f17c453",
                                                "sense_id": "080c431e-4934-30e7-a80a-0b154d015889",
                                                "text": "„Steh auf, du faules Murmeltier / Bevor ich die Geduld verlier’“ (Schlager)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ea56b38-337e-4d49-94bb-1aaffe9fd472",
