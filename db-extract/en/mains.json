            {
                "entry_id": "80199385-f5d1-34b5-99d2-1b9ec5324182",
                "word": "mains",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dd5eac9a-245b-3e35-a5c4-68ad424068cd",
                        "entry_id": "80199385-f5d1-34b5-99d2-1b9ec5324182",
                        "glosses": [
                            "The domestic electrical power supply, especially as connected to a network or grid."
                        ],
                        "tags": [
                            "British",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70c4820f-5c63-4e7a-b496-b7d9fc98461d",
                                "sense_id": "dd5eac9a-245b-3e35-a5c4-68ad424068cd",
                                "text": "I plugged it into the mains and it blew up!"
                            },
                            {
                                "example_id": "e4204488-4b84-40b2-9c16-edcfb661c48b",
                                "sense_id": "dd5eac9a-245b-3e35-a5c4-68ad424068cd",
                                "text": "We don't have mains power out here, only a generator."
                            },
                            {
                                "example_id": "c38a3535-43e1-485d-874c-2e76d46eac3d",
                                "sense_id": "dd5eac9a-245b-3e35-a5c4-68ad424068cd",
                                "text": "mains electricity, mains voltage"
                            }
                        ]
                    },
                    {
                        "sense_id": "857c6d0d-6dbb-3211-bbb9-bea77ffac9a1",
                        "entry_id": "80199385-f5d1-34b5-99d2-1b9ec5324182",
                        "glosses": [
                            "A large-scale network or grid supplying any of various other services, such as water, gas or sewerage, to properties."
                        ],
                        "tags": [
                            "British",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7831818e-42f9-4d13-b52f-410160a38517",
                                "sense_id": "857c6d0d-6dbb-3211-bbb9-bea77ffac9a1",
                                "text": "We have gas heating, but it's bottled gas, not mains gas."
                            },
                            {
                                "example_id": "b1719a3a-de29-4b66-b6ca-f006cd968255",
                                "sense_id": "857c6d0d-6dbb-3211-bbb9-bea77ffac9a1",
                                "text": "The properties formerly relied on a well, but are now connected to the mains water supply."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7fc42dc-37e6-359f-a90f-80508bde326a",
                        "entry_id": "80199385-f5d1-34b5-99d2-1b9ec5324182",
                        "glosses": [
                            "The main course of a meal."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7cf6120-a06c-41ff-b4db-87f8a4da80ee",
                        "source_entry_id": "80199385-f5d1-34b5-99d2-1b9ec5324182",
                        "source_sense_description": "domestic electrical supply",
                        "target_lang_word": "Stromnetz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stromnetz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44270f6f-269d-38ef-9cae-1d87e605c39f",
                                        "entry_id": "e0578403-ead2-3a5e-b1ae-4354a76142bc",
                                        "glosses": [
                                            "technische Anlage aus Kraftwerken und Leitungen zur Versorgung der Verbraucher mit Strom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad590490-7232-4f6a-ba65-33b311401b80",
                                                "sense_id": "44270f6f-269d-38ef-9cae-1d87e605c39f",
                                                "text": "„Sichtlich erleichtert sprangen beide wieder hinab, um Platz für einen riesigen Samowar zu machen, den ein Fünftklässler stolz auf die Bühne verfrachtete und ans Stromnetz anschloss.“"
                                            },
                                            {
                                                "example_id": "a3d095b9-4b7b-422c-95ad-2a20e500866f",
                                                "sense_id": "44270f6f-269d-38ef-9cae-1d87e605c39f",
                                                "text": "„12,3 Cent pro Kilowattstunde bekommen Privatleute mit haushaltsüblichen Anlagen heute vom Netzbetreiber für die Einspeisung ihres Stroms ins öffentliche Stromnetz.“"
                                            },
                                            {
                                                "example_id": "9fdc5aa2-f026-4898-9cfd-adf3dcd29b5b",
                                                "sense_id": "44270f6f-269d-38ef-9cae-1d87e605c39f",
                                                "text": "„Wir fahren von einer Straßenbaustelle zur nächsten, die Investitionen in die Infrastruktur sind gewaltig, Dörfer, die vor drei Jahren noch im Dunkeln lagen, sind mittlerweile an das Stromnetz angeschlossen.“"
                                            },
                                            {
                                                "example_id": "b1040ddc-d394-4830-b32d-09a6c9ed6487",
                                                "sense_id": "44270f6f-269d-38ef-9cae-1d87e605c39f",
                                                "text": "[Batterien und Akkus] „ermöglichen es, viele Geräte mobil und unabhängig vom Stromnetz zu nutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f8b1921-446e-474c-9158-29c732ea2ca0",
                        "source_entry_id": "80199385-f5d1-34b5-99d2-1b9ec5324182",
                        "source_sense_description": "domestic electrical supply",
