                        "source_sense_id": "7af4ed62-7ad2-39dc-a840-69719ebf9584",
                        "source_sense_description": "een taal die in de Veneto-regio gesproken wordt",
                        "target_lang_word": "Venezianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venezianisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b639854-17dc-33a7-b338-684964652b2b",
                                        "entry_id": "cf54fdb5-0f3a-3638-8def-b3eee38233c4",
                                        "glosses": [
                                            "Dialekt/Sprache (je nach Auslegung und Quelle), die im Nordosten Italiens gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e629a164-9c7f-44b8-abec-cbf6c0bfcab3",
                                                "sense_id": "7b639854-17dc-33a7-b338-684964652b2b",
                                                "text": "Über drei Millionen Menschen sprechen Venezianisch."
                                            },
                                            {
                                                "example_id": "e0e81ceb-26d1-4185-8eed-e9079bff2b04",
                                                "sense_id": "7b639854-17dc-33a7-b338-684964652b2b",
                                                "text": "„Starken Einfluss nahm das Venezianische auch als Lingua franca auf die Handelssprache im Mittelmeerraum in der Frühen Neuzeit.“"
                                            },
                                            {
                                                "example_id": "e2fbe792-643c-4301-adca-9a86ff7ab6fd",
                                                "sense_id": "7b639854-17dc-33a7-b338-684964652b2b",
                                                "text": "„Man spricht unter sich Venezianisch, das ist gewiß, und vielleicht eine Variante des Venezianischen, aus deren besonderer Tönung eingesessene Kenner einen fortlebenden Beitrag der meridionalen Zuwanderer heraushören können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
