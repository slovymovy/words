                "senses": [
                    {
                        "sense_id": "48af6668-8235-32e8-bd89-574cd15ef249",
                        "entry_id": "d6fba35f-fef8-304a-a59a-8105bd46b6da",
                        "glosses": [
                            "Verein/Unternehmen (Organisation) Organisation ohne das Streben nach Gewinnmaximierung und mit dem Ziel, Bedürftige zu unterstützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9142262c-29a9-46dd-bb90-f5d1109767cd",
                                "sense_id": "48af6668-8235-32e8-bd89-574cd15ef249",
                                "text": "„Hausmüll ist den öffentlich-rechtlichen Entsorgungsträgern zu überlassen, in der Regel den Landkreisen und kreisfreien Städten, es sei denn, die Abfälle werden selbst verwertet (z. B. Kompostierung) oder Dritten zur ordnungsgemäßen Verwertung übergeben (z. B. Altpapier- oder Altkleidersammlung einer Wohlfahrtsorganisation, Container-Sammelstellen).“"
                            },
                            {
                                "example_id": "8248f899-b601-40e8-8689-916837315272",
                                "sense_id": "48af6668-8235-32e8-bd89-574cd15ef249",
                                "text": "„Sie fielen den Wohlfahrtsorganisationen zur Last und mußten dort betteln oder wurden privat unterstützt.“"
                            },
                            {
                                "example_id": "23d549ad-ff20-41dd-9c91-9a8031a3fe4f",
                                "sense_id": "48af6668-8235-32e8-bd89-574cd15ef249",
                                "text": "„Mukhtar Mai entschied sich für ein Weiterleben in ihrem Dorf. Hier leitet sie seit einigen Jahren zwei Schulen und eine unter ihrem Namen gegründete Wohlfahrtsorganisation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16a63ccf-4407-4202-ba8f-f107572582cd",
                        "source_entry_id": "d6fba35f-fef8-304a-a59a-8105bd46b6da",
                        "source_sense_id": "48af6668-8235-32e8-bd89-574cd15ef249",
