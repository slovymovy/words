                                "target_senses": [
                                    {
                                        "sense_id": "5a909d0c-c2bb-3e20-8e2f-116e229f2065",
                                        "entry_id": "2a8c903b-e111-3045-b621-41dda4339620",
                                        "glosses": [
                                            "yourself (as the object of a verb or preposition or as an intensifier); reflexive case of thou"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74df4f60-2628-4825-9298-556e8bcb9914",
                                                "sense_id": "5a909d0c-c2bb-3e20-8e2f-116e229f2065",
                                                "text": "Thou hast only thyself to blame."
                                            },
                                            {
                                                "example_id": "80bd014e-1a96-4b0d-b705-f76f2c967bd5",
                                                "sense_id": "5a909d0c-c2bb-3e20-8e2f-116e229f2065",
                                                "text": "Thou thyself art to blame."
                                            },
                                            {
                                                "example_id": "853ab6a7-6591-414e-8f17-fd6a4511ffad",
                                                "sense_id": "5a909d0c-c2bb-3e20-8e2f-116e229f2065",
                                                "text": "Physician, heal thyself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee860efa-0f4a-4147-b7a1-e0c4c0e73f0d",
