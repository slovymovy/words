                    {
                        "sense_id": "059f5abb-2ca3-361d-8a7a-56500fcdef8e",
                        "entry_id": "3ee55719-2675-3f57-80fe-a786300322fd",
                        "glosses": [
                            "Relatif à la fenêtre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "475653d0-1378-432d-ad73-e060ec10fb2c",
                                "sense_id": "059f5abb-2ca3-361d-8a7a-56500fcdef8e",
                                "text": "Quand madame d'Aiglemont […] fut assise devant un grand feu, abritée des bises fenestrales par un paravent chinois, sa tristesse ne put guère se dissiper."
                            },
                            {
                                "example_id": "bcf4b1fd-343a-436b-88bf-939592515a24",
                                "sense_id": "059f5abb-2ca3-361d-8a7a-56500fcdef8e",
                                "text": "M. Birotteau, ni sa femme, ni madame Matifat ne troublèrent la douce conversation que les deux enfans enflammés par l’amour, tinrent à voix basse dans une embrasure de croisée où le froid déployait ses bises fenestrales."
                            },
                            {
                                "example_id": "9797af6f-e267-4c45-be3c-781d60b17e8f",
                                "sense_id": "059f5abb-2ca3-361d-8a7a-56500fcdef8e",
                                "text": "La directrice s'est empressée de venir me l'annoncer alors que j'étais dans la salle du conseil, étendue sur la banquette fenestrale."
                            }
                        ]
                    }
