                        "examples": [
                            {
                                "example_id": "f0c5cd7a-8a6f-4ec9-bcad-5d2e092141f0",
                                "sense_id": "04bf4e4d-a62f-3935-a825-d77360475618",
                                "text": "Doivent être considérés comme urgents et faire l’objet d’un « avurnav » transmis par moyens radio-électriques les événements imprévus qui intéressent la sécurité à la mer."
                            },
                            {
                                "example_id": "0883c57d-8eaa-452e-aabc-c1c4afe4f84d",
                                "sense_id": "04bf4e4d-a62f-3935-a825-d77360475618",
                                "text": "La durée de la diffusion par radio est fixée par l’autorité rédactrice et devra obligatoirement figurer dans les indications de service à l’usage du poste d’émission accompagnant le texte de l’avurnav."
                            },
                            {
                                "example_id": "91fe6759-e5b0-4880-ab5e-781309e9165b",
                                "sense_id": "04bf4e4d-a62f-3935-a825-d77360475618",
                                "text": "La zone dangereuse définie par l’avurnav de 1974 ne s’étendait à l’est que jusqu’à 200 milles (370 kilomètres) au lieu de 500 milles (925 kilomètres) pour l’année précédente."
                            }
