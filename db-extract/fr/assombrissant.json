                    {
                        "sense_id": "7f14b969-495c-31db-9198-aa5e0cb59321",
                        "entry_id": "b4868bc5-a18d-3795-b3bb-f670ad7b757d",
                        "glosses": [
                            "Qui assombrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c95af9b-3c86-451f-b7e4-b2d9e2aef941",
                                "sense_id": "7f14b969-495c-31db-9198-aa5e0cb59321",
                                "text": "La politique s’y est faite tellement envahissante et assombrissante, que les faiseurs de revues ne savent à quelles drôleries se vouer."
                            },
                            {
                                "example_id": "a0ae80ba-4f6f-4945-9d38-4176d62bccbb",
                                "sense_id": "7f14b969-495c-31db-9198-aa5e0cb59321",
                                "text": "Il resterait seul, seul avec sa décrépitude prochaine, les maladies du corps, les humeurs de l’esprit ! Seul devant la mort, son assombrissante voisine !"
                            },
                            {
                                "example_id": "245ea184-e49f-46de-a0b3-8378f478849b",
                                "sense_id": "7f14b969-495c-31db-9198-aa5e0cb59321",
                                "text": "C’est graisser la rose des vents, pour que la roue tourne plus vite, et amène des nuages assombrissants sur la tête des adversaires."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
