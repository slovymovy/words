{
    "word_family": [
        "immerse",
        "immersion",
        "immersible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e610ee1c-90d6-30c3-a93c-7413668a3fe5",
                    "sense_definition": "Deeply involved or absorbed in an activity or interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so <w>immersed</w> in her book that she did not hear the phone ring.",
                            "target_lang_translations": {
                                "nl": "Ze was zo <w>verdiept</w> in haar boek dat ze de telefoon niet hoorde overgaan.",
                                "de": "Sie war so in ihr Buch <w>vertieft</w>, dass sie das Telefon nicht klingeln hörte."
                            }
                        },
                        {
                            "text": "The students became fully <w>immersed</w> in the local culture during their study abroad program.",
                            "target_lang_translations": {
                                "nl": "De studenten raakten tijdens hun studie in het buitenland volledig <w>ondergedompeld</w> in de lokale cultuur.",
                                "de": "Die Studenten sind während ihres Auslandsstudiums vollkommen in die einheimische Kultur <w>eingetaucht</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "absorbed",
                        "engrossed",
                        "engulfed"
                    ],
                    "common_phrases": [
                        "fully immersed",
                        "deeply immersed"
                    ],
                    "target_lang_definitions": {
                        "nl": "Helemaal opgaan in een activiteit of interesse.",
                        "de": "Vollständig in eine Aktivität oder ein Interesse vertieft sein."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verdiept",
                                "target_lang_sense_clarification": "geconcentreerd op een activiteit of onderwerp"
                            },
                            {
                                "target_lang_word": "opgegaan",
                                "target_lang_sense_clarification": "volledig geabsorbeerd door iets"
                            },
                            {
                                "target_lang_word": "ondergedompeld",
                                "target_lang_sense_clarification": "figuurlijk: volledig opgenomen in een omgeving, cultuur of bezigheid"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vertieft",
                                "target_lang_sense_clarification": "hochgradig konzentriert auf eine Tätigkeit oder ein Buch"
                            },
                            {
                                "target_lang_word": "eingetaucht",
                                "target_lang_sense_clarification": "figürlich: völlig in eine Umgebung, Kultur oder Thematik eingebunden"
                            },
                            {
                                "target_lang_word": "versunken",
                                "target_lang_sense_clarification": "gedanklich völlig absorbiert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77847cec-5e8a-323a-82ec-96b90bf92f6e",
                    "sense_definition": "Covered completely by a liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fabric should be <w>immersed</w> in the dye for at least ten minutes.",
                            "target_lang_translations": {
                                "nl": "De stof moet minstens tien minuten in de verf worden <w>ondergedompeld</w>.",
                                "de": "Der Stoff sollte für mindestens zehn Minuten in die Farbe <w>eingetaucht</w> werden."
                            }
                        },
                        {
                            "text": "Keep the roots <w>immersed</w> in water until you are ready to plant them.",
                            "target_lang_translations": {
                                "nl": "Houd de wortels <w>ondergedompeld</w> in water totdat je klaar bent om ze te planten.",
                                "de": "Halten Sie die Wurzeln im Wasser <w>untergetaucht</w>, bis Sie bereit sind, sie einzupflanzen."
                            }
                        }
                    ],
                    "synonyms": [
                        "submerged",
                        "dunked"
                    ],
                    "common_phrases": [
                        "immersed in water"
                    ],
                    "target_lang_definitions": {
                        "nl": "Volledig bedekt door een vloeistof.",
                        "de": "Vollständig von einer Flüssigkeit bedeckt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ondergedompeld",
                                "target_lang_sense_clarification": "in een vloeistof gestoken"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "untergetaucht",
                                "target_lang_sense_clarification": "vollständig unter die Flüssigkeitsoberfläche gebracht"
                            },
                            {
                                "target_lang_word": "eingetaucht",
                                "target_lang_sense_clarification": "in eine Flüssigkeit getaucht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "408378ab-894a-3272-8c42-7b879927d63e",
                    "sense_definition": "Positioned below or set into a surrounding surface or structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small stones were <w>immersed</w> in the concrete floor during construction.",
                            "target_lang_translations": {
                                "nl": "De kleine steentjes waren tijdens de bouw <w>ingebed</w> in de betonnen vloer.",
                                "de": "Die kleinen Steine wurden während des Baus in den Betonboden <w>eingebettet</w>."
                            }
                        },
                        {
                            "text": "The sensor is <w>immersed</w> within the device casing to protect it from damage.",
                            "target_lang_translations": {
                                "nl": "De sensor is <w>ingebed</w> in de behuizing van het apparaat om hem tegen schade te beschermen.",
                                "de": "Der Sensor ist in das Gerätegehäuse <w>eingelassen</w>, um ihn vor Schäden zu schützen."
                            }
                        }
                    ],
                    "synonyms": [
                        "embedded",
                        "sunken"
                    ],
                    "antonyms": [
                        "protruding"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geplaatst onder of ingebed in een omringend oppervlak of structuur.",
                        "de": "In eine umgebende Oberfläche oder Struktur eingelassen oder eingefügt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ingebed",
                                "target_lang_sense_clarification": "vastgezet in een ander materiaal"
                            },
                            {
                                "target_lang_word": "verzonken",
                                "target_lang_sense_clarification": "lager gelegen dan het oppervlak"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "eingebettet",
                                "target_lang_sense_clarification": "fest in ein umgebendes Material oder eine Struktur eingefügt"
                            },
                            {
                                "target_lang_word": "versenkt",
                                "target_lang_sense_clarification": "unterhalb der sichtbaren Oberfläche liegend"
                            },
                            {
                                "target_lang_word": "eingelassen",
                                "target_lang_sense_clarification": "bündig in eine Oberfläche eingearbeitet"
                            }
                        ]
                    }
                }
            ]
        },
        {
