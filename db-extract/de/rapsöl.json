                                        "entry_id": "0b8aeb01-1e70-3e58-a2ac-5e96072ddb11",
                                        "glosses": [
                                            "Synonym of rapeseed oil."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f80c67-d5da-43b1-a708-a0f4cb01da2e",
                                                "sense_id": "69439990-6eed-31e9-8c2c-603a122a2a98",
                                                "text": "Rape oyle that is used in Lampes and therefore called Lampe Oyle."
                                            },
                                            {
                                                "example_id": "cf9b4147-53be-4aeb-b9a2-ae3fcaeb7427",
                                                "sense_id": "69439990-6eed-31e9-8c2c-603a122a2a98",
                                                "text": "Rape-Oil is sweet, and on the contrary the Linseed bitter."
                                            },
                                            {
                                                "example_id": "b3ba0042-289d-4d08-89e5-292dd1745c2e",
                                                "sense_id": "69439990-6eed-31e9-8c2c-603a122a2a98",
                                                "text": "The number of seconds taken by the oil to flow up to the 50 c.c. mark on the flask is noted, and the results brought into comparison with the viscosity of rape oil, that being the oil with which the apparatus is standardised."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
