                                "sense_id": "8f3ead50-3906-3226-b31d-77d5c6784cf8",
                                "text": "… dans les domaines de la production, de la postproduction, de la distribution, de la commercialisation, de l'archivage et du multimédia."
                            },
                            {
                                "example_id": "3818752a-a160-4971-9c75-8906a0f904e2",
                                "sense_id": "8f3ead50-3906-3226-b31d-77d5c6784cf8",
                                "text": "Presque deux ans après la triomphe d'Avatar, Hollywood a inondé le marché avec une pluie de titres convertis en 3D à la postproduction."
                            },
                            {
                                "example_id": "72018463-0f35-4b66-bf5f-2b83041c83d4",
                                "sense_id": "8f3ead50-3906-3226-b31d-77d5c6784cf8",
                                "text": "Tout a ensuite été traité en postproduction par Valentine Pedoussat, sa collaboratrice."
                            }
                        ]
                    }
