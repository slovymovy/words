            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a864894c-6e56-3fcc-9166-998b16271a69",
                    "sense_definition": "Indique un nombre indéfini mais assez petit d'êtres ou de choses, supérieur à un et le plus souvent à deux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantité indéfinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai invité <w>plusieurs</w> amis à mon anniversaire samedi prochain."
                        },
                        {
                            "text": "Il a visité <w>plusieurs</w> pays d'Europe pendant ses vacances."
                        },
                        {
                            "text": "Depuis lundi, le thermomètre est descendu <w>plusieurs</w> fois à zéro la nuit."
                        },
                        {
                            "text": "Elle a lu <w>plusieurs</w> livres sur ce sujet avant de se décider."
                        }
                    ],
                    "synonyms": [
                        "différents",
                        "maints",
                        "quelques"
                    ],
                    "common_phrases": [
                        "plusieurs fois",
                        "plusieurs jours",
                        "plusieurs personnes",
                        "plusieurs années"
                    ]
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "53ee2d3b-270b-31fc-947d-7602859c087a",
                    "sense_definition": "Désigne un nombre indéfini, plus ou moins important, d'êtres ou de choses déjà mentionnés et faisant partie d'un ensemble plus grand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantité indéfinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parmi tous ces invités, il y en a <w>plusieurs</w> que je ne connais pas."
                        },
                        {
                            "text": "Il avait acheté beaucoup de pommes, mais il en est tombé <w>plusieurs</w> en chemin."
                        },
                        {
                            "text": "<w>Plusieurs</w> d'entre eux ont refusé de signer le document."
                        }
                    ],
                    "synonyms": [
                        "certains",
                        "quelques-uns"
                    ],
                    "common_phrases": [
                        "plusieurs d'entre eux",
                        "il y en a plusieurs"
                    ]
                },
                {
                    "sense_id": "1d1b3a95-3c26-34cf-bb9a-8f3adec95f68",
                    "sense_definition": "Désigne un certain nombre de personnes non précisées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quantité indéfinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas que <w>plusieurs</w> souffrent à cause d'un seul."
                        },
                        {
                            "text": "<w>Plusieurs</w> ont cru autrefois que la Terre était plate."
                        },
                        {
                            "text": "Dans cette affaire, <w>plusieurs</w> prétendent avoir tout vu, mais personne ne dit la vérité."
                        }
                    ],
                    "synonyms": [
                        "d'aucuns",
                        "certains",
                        "quelques-uns"
                    ],
                    "traits": [
