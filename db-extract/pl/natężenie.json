                ],
                "senses": [
                    {
                        "sense_id": "2475b9ce-cb84-366c-99c6-f9ab8ed99da4",
                        "entry_id": "51b1f2f9-7688-3f9b-a577-f023f2a10da3",
                        "glosses": [
                            "nasilenie danej cechy w odniesieniu do określonej normy lub skali"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c80b8d8-64fd-4140-a87d-d2c6e65e54db",
                                "sense_id": "2475b9ce-cb84-366c-99c6-f9ab8ed99da4",
                                "text": "Bel to bardzo duża jednostka, odpowiadająca bardzo dużym zmianom w natężeniu dźwięku, dlatego w praktyce używa się mniejszej jednostki – dziesiątej części bela, czyli decybela."
                            },
                            {
                                "example_id": "570c5782-d5b6-454d-becd-eb565b604fed",
                                "sense_id": "2475b9ce-cb84-366c-99c6-f9ab8ed99da4",
                                "text": "Był dzień następny, wszędzie panowała szarość, niewiarygodna szarość w różnych natężeniach, czerwony był szarawy, i zielony, i żółty, wszystko szarobure."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57acb715-0777-4954-9015-cf2276b1aebf",
                        "source_entry_id": "51b1f2f9-7688-3f9b-a577-f023f2a10da3",
                        "source_sense_id": "2475b9ce-cb84-366c-99c6-f9ab8ed99da4",
                        "target_lang_word": "intensity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intensity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e097d511-5155-3eb1-b73a-2462c6552897",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "The quality of being intense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86ef0b4c-c073-3147-9414-261076d5c6c6",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "The degree of strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13aec7c2-015f-4fd3-88da-69f86b583568",
                                                "sense_id": "86ef0b4c-c073-3147-9414-261076d5c6c6",
                                                "text": "The painting’s dislocated, unformed features are the very opposite of the hard, painted dolls of the other portrait, and, where they are dead and ready to topple, this unknown man’s eyes are full of intensity and life."
                                            },
                                            {
                                                "example_id": "1d57223b-d307-4e11-9239-c32ed2bed263",
                                                "sense_id": "86ef0b4c-c073-3147-9414-261076d5c6c6",
                                                "text": "Fagus sylvatica (European beech) and Acer saccharum (sugar maple, from North America) are very tolerant of deep shade, while Betula spp. (birches) and Populus spp. (poplars) grow best under high light intensities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a48922e-cfc0-3622-9d30-9cee38d5e227",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "Time-averaged energy flux (the ratio of average power to the area through which the power \\\"flows\\\"); irradiance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b0e0e0a-7435-31e6-ab3a-3511d5c5d2a3",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "Can mean any of radiant intensity, luminous intensity or irradiance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b164af60-d79c-3e0b-bd92-a349c629d964",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "Synonym of radiance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03803508-596b-39a1-8605-998dad9fe2e4",
                                        "entry_id": "20e6694f-e994-313d-a037-61272adda493",
                                        "glosses": [
                                            "The severity of an earthquake in terms of its effects on the earth's surface, and buildings. The value depends on the distance from the epicentre, and is not to be confused with the magnitude."
                                        ],
