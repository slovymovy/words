    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2c40502b-a713-321d-8ef9-fc0635470aec",
                    "sense_definition": "Functioning without an external wired connection, usually using radio signals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a new pair of <w>wireless</w> headphones for my morning run.",
                            "target_lang_translations": {
                                "ru": "Я купил новую пару <w>беспроводных</w> наушников для утренней пробежки.",
                                "zh": "我买了一副新的<w>无线</w>耳机，准备晨跑时用。"
                            }
                        },
                        {
                            "text": "The hotel offers free <w>wireless</w> internet access to all its guests.",
                            "target_lang_translations": {
                                "ru": "Отель предлагает всем своим гостям бесплатный <w>беспроводной</w> доступ в интернет.",
                                "zh": "酒店为所有住客提供免费的<w>无线</w>网络接入。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cordless"
                    ],
                    "antonyms": [
                        "wired"
                    ],
                    "common_phrases": [
                        "wireless connection",
                        "wireless network",
                        "wireless technology",
                        "wireless charging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работающий без проводного соединения, обычно с использованием радиосигналов.",
                        "zh": "指无需物理连接线，通常利用无线电信号进行工作的设备或技术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспроводной",
                                "target_lang_sense_clarification": "не требующий проводов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无线",
                                "target_lang_sense_clarification": "指不通过导线连接的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cce5012e-b7e8-35f0-9f58-a1c1ac500700",
                    "sense_definition": "Wireless connectivity to a computer network; Wi-Fi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wireless</w> is down, so I cannot check my email right now.",
                            "target_lang_translations": {
                                "ru": "<w>Wi-Fi</w> не работает, поэтому я сейчас не могу проверить почту.",
                                "zh": "<w>无线网络</w>断了，所以我现在没法查邮件。"
                            }
                        },
                        {
                            "text": "You will need a password to connect to the secure <w>wireless</w> in this building.",
                            "target_lang_translations": {
                                "ru": "Вам понадобится пароль, чтобы подключиться к защищенной <w>беспроводной сети</w> в этом здании.",
                                "zh": "你需要密码才能连接这栋楼里的加密<w>无线网络</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "connect to wireless",
                        "wireless signal",
                        "free wireless"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспроводное подключение к компьютерной сети; вай-фай.",
                        "zh": "指无线网络连接，即Wi-Fi。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Wi-Fi",
                                "target_lang_sense_clarification": "технология связи"
                            },
                            {
                                "target_lang_word": "беспроводная сеть",
                                "target_lang_sense_clarification": "подключение к интернету"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无线网络",
                                "target_lang_sense_clarification": "指无线互联网连接"
                            },
                            {
                                "target_lang_word": "Wi-Fi",
                                "target_lang_sense_clarification": "指无线局域网技术"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dddf6caf-2c51-3fab-94c1-454c4ffa426d",
                    "sense_definition": "A radio receiving set.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather used to listen to the news on the <w>wireless</w> every evening.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка каждый вечер слушал новости по <w>радио</w>.",
                                "zh": "我祖父过去每天晚上都用<w>收音机</w>听新闻。"
                            }
                        },
                        {
                            "text": "They gathered around the old <w>wireless</w> to hear the broadcast.",
                            "target_lang_translations": {
                                "ru": "Они собрались вокруг старого <w>радиоприемника</w>, чтобы послушать передачу.",
                                "zh": "他们围在旧<w>收音机</w>旁收听广播。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the wireless",
                        "switch on the wireless"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mainly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Радиоприемник.",
                        "zh": "指无线电接收设备，即收音机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радио",
                                "target_lang_sense_clarification": "система вещания"
                            },
                            {
                                "target_lang_word": "радиоприемник",
                                "target_lang_sense_clarification": "устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收音机",
                                "target_lang_sense_clarification": "指无线电接收装置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "723308a7-0575-3042-be99-e1946289e6c2",
                    "sense_definition": "To send a message by radio.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain <w>wirelessed</w> a distress signal to the nearest coastguard station.",
                            "target_lang_translations": {
                                "ru": "Капитан <w>передал по радио</w> сигнал бедствия на ближайшую станцию береговой охраны.",
                                "zh": "船长向最近的海岸警卫站<w>拍发</w>了求救信号。"
                            }
                        },
                        {
                            "text": "He <w>wirelessed</w> the headquarters immediately to report his position.",
                            "target_lang_translations": {
                                "ru": "Он немедленно <w>радировал</w> в штаб, чтобы сообщить о своей позиции.",
                                "zh": "他立即<w>用无线电</w>向总部报告了他的位置。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправлять сообщение по радио.",
                        "zh": "指通过无线电发送信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радировать",
                                "target_lang_sense_clarification": "передавать по радио"
                            },
                            {
                                "target_lang_word": "передавать по радио",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用无线电发送",
                                "target_lang_sense_clarification": "指通过无线电通讯方式传递信息"
                            },
                            {
                                "target_lang_word": "拍发",
                                "target_lang_sense_clarification": "指通过无线电报发送"
                            }
                        ]
                    }
                }
            ]
        }
