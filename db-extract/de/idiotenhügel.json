                ],
                "senses": [
                    {
                        "sense_id": "002c9106-515c-3d0e-8a3f-01e4694ec307",
                        "entry_id": "fd92a229-2061-364f-9d8c-d8cd5c9b0a7f",
                        "glosses": [
                            "flacher Hügel, auf dem Anfänger das Skifahren üben können"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "beaa121b-8fd5-4bb1-b31c-a19b3158269e",
                                "sense_id": "002c9106-515c-3d0e-8a3f-01e4694ec307",
                                "text": "„Den ganzen Urlaub muss das Probieren auf dem \"Idiotenhügel\" aber nicht in Anspruch nehmen: \"Unter idealen Bedingungen können Sie sich nach zwei bis drei Tagen schon relativ sicher durch das Skigebiet bewegen\", sagt Stefan Wiedeck, der beim Deutschen Skiverband in Planegg bei München die Abteilung Ausbildung leitet.“"
                            },
                            {
                                "example_id": "183f3ddf-b7a4-4812-bcaa-4f5941f7ac1d",
                                "sense_id": "002c9106-515c-3d0e-8a3f-01e4694ec307",
                                "text": "„Man fotografiert sich und die Familie vor den Schanzen – und die Kinder rutschen über einen kleinen Idiotenhügel.“"
                            },
                            {
                                "example_id": "846d9870-daf4-4787-acbc-f2d8be33c5c9",
                                "sense_id": "002c9106-515c-3d0e-8a3f-01e4694ec307",
                                "text": "„Wir fahren also an der Talstation des Sessellifts vorbei und kommen zu einem kleinen Schlepplift. Daneben ein Hang mit sehr flacher Neigung - Idiotenhügel nannte man so etwas früher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
