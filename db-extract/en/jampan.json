                        "entry_id": "f124c26b-b391-33bb-ab33-c413539a9f2d",
                        "glosses": [
                            "Synonym of dandy or tonjon, a kind of open sedan chair, particularly one with its main pole suspended from smaller poles borne on the shoulders of two pairs of porters."
                        ],
                        "tags": [
                            "India",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "000c39b2-b98f-4910-9fb0-6744c7b2b50c",
                                "sense_id": "bb2afedc-bccd-385b-ba64-d46d9cf12528",
                                "text": "At a hill-station ladies are carried in jampans, which are open doolies."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4b91e2d-0eb9-329e-b6cc-3b62992609f7",
                        "entry_id": "f124c26b-b391-33bb-ab33-c413539a9f2d",
                        "glosses": [
                            "Synonym of mihaffa, a kind of enclosed litter, principally for women."
                        ],
                        "tags": [
                            "Malaysia",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "67876301-8ac4-44c1-934e-44cbf30dfdfe",
                                "sense_id": "a4b91e2d-0eb9-329e-b6cc-3b62992609f7",
                                "text": "... we find in Crawfurd's Malay Dict. \"Jampana... a kind of litter\"... It may have been originally in India, as it is now in the Straits, a closed litter for ladies of rank, and the word may have become appropriated to the open conveyance in which European ladies are carried."
                            }
                        ]
                    }
