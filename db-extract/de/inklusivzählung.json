                ],
                "senses": [
                    {
                        "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                        "entry_id": "8d4c8b7c-a8ce-33f9-a603-54e5157affaf",
                        "glosses": [
                            "eine Zählung von Distanzen und Zeiträumen, bei der sowohl Start- als auch das End-Element mitgezählt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5207de-834f-4a27-b541-20c98754ef5b",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Von diesem Datum mittels der Inklusivzählung zurückgerechnet, kommt man für das 83. Jahr vor der Eroberung zum Jahre 510/09, als sich Athen mit Plataiai verbündete.“"
                            },
                            {
                                "example_id": "d1236877-6290-41f5-9f3b-8f57e9a585d3",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Auf Jahre bezogen bedeutet dies, daß die Olympiade, die alle vier Jahre stattfand, als »fünfjährig« (penteeterisch) bezeichnet werden kann. Diese Art der antiken Zählung wird auch als Inklusivzählung bezeichnet.“"
                            },
                            {
                                "example_id": "40854a40-b5a3-4178-942b-484972958948",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Daß aber die ideale Lustrum-Periode ausgerechnet vier Jahre währte (nach der antiken Inklusivzählung gesprochen: fünf) war natürlich kein Zufall, spielte doch dieser Zeitraum — unserem Schaltjahr vergleichbar — eine wichtige Rolle in den antiken Kalendersystemen.“"
                            },
                            {
                                "example_id": "1f57a7ac-18c0-40f0-902c-dfa675cad5ee",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Zählt man ab 1. März 317, enden die vollen sechs Jahre nach der römischen Inklusivzählung mit dem 28. Februar 322.“"
                            },
                            {
                                "example_id": "58b256a3-815f-4753-a187-9ca8cd782507",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Hier rechnen wir also von den Fischen (Sonne) bis zur Waage (Mond) acht Zeichen (Inklusivzählung).“"
                            },
                            {
                                "example_id": "5697da6f-aed9-4ce3-bcb6-514de1b52251",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Die von Gallius abgezählten 26 Konsulate umfassen freilich nur 25 Lebensjahre Ciceros. […] Die Angabe von ›sex et viginti anni‹ erklärt sich aus der Inklusivzählung.“"
                            },
                            {
                                "example_id": "1aad9f48-6a0b-4e85-a5f8-8507ab0877ad",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Mit Inklusivzählung füllen die sieben Tierkreiszeichen vom Krebs bis zum Steinbock gerade jenen Halbkreis, in dem die Sonne von Norden nach Süden absteigt.“"
                            },
                            {
                                "example_id": "ce199c68-c3fe-4ad2-a8d1-dc2bac937263",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Diese alte Inklusivzählung findet sich noch immer in einigen Redewendungen. So ist es durchaus üblich zu sagen „in acht Tagen“, wenn man eine Woche meint, die ja nur sieben Tage hat.“"
                            },
                            {
                                "example_id": "a463f8c0-49ae-4240-bc4c-a15a60bd33ce",
                                "sense_id": "3592570d-b4b7-378e-b3ae-21da83bc718c",
                                "text": "„Dass die Inklusivzählung dennoch sinnvoll sein kann, sieht man daran, dass beim Ausdruck einer Prime ein Ton beteiligt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
