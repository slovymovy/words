{
    "word_family": [
        "beater",
        "beatable",
        "upbeat",
        "offbeat",
        "downbeat",
        "heartbeat",
        "drumbeat",
        "browbeat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d6678146-f799-3e55-bc05-54f3005b1dc1",
                    "sense_definition": "To win against or do better than someone in a contest, game, or conflict.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team needs to <w>beat</w> the champions to win the trophy.",
                            "target_lang_translations": {
                                "ru": "Нашей команде нужно <w>победить</w> чемпионов, чтобы выиграть трофей.",
                                "pl": "Nasza drużyna musi <w>pokonać</w> mistrzów, aby zdobyć trofeum.",
                                "zh": "我们的队伍需要<w>击败</w>冠军才能赢得奖杯。"
                            }
                        },
                        {
                            "text": "I think I can <w>beat</w> my brother at chess if I concentrate.",
                            "target_lang_translations": {
                                "ru": "Думаю, я смогу <w>обыграть</w> брата в шахматы, если сосредоточусь.",
                                "pl": "Myślę, że mogę <w>ograć</w> brata w szachy, jeśli się skoncentruję.",
                                "zh": "如果我专心的话，我想我能在象棋上<w>赢</w>我哥哥。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defeat",
                        "overcome",
                        "outdo",
                        "win against"
                    ],
                    "antonyms": [
                        "lose"
                    ],
                    "common_phrases": [
                        "beat a record",
                        "beat the competition",
                        "beat the odds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одержать победу над кем-либо или превзойти кого-либо в соревновании, игре или конфликте.",
                        "pl": "Wygrać z kimś lub być lepszym od kogoś w zawodach, grze lub konflikcie.",
                        "zh": "在比赛、游戏或冲突中胜过某人或表现得比某人更好。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "победить",
                                "target_lang_sense_clarification": "одержать победу"
                            },
                            {
                                "target_lang_word": "обыграть",
                                "target_lang_sense_clarification": "в игре или спорте"
                            },
                            {
                                "target_lang_word": "побить",
                                "target_lang_sense_clarification": "рекорд или соперника (разг.)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pokonać",
                                "target_lang_sense_clarification": "zwyciężyć kogoś"
                            },
                            {
                                "target_lang_word": "pobić",
                                "target_lang_sense_clarification": "np. rekord lub przeciwnika"
                            },
                            {
                                "target_lang_word": "ograć",
                                "target_lang_sense_clarification": "wygrać w grze"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "击败",
                                "target_lang_sense_clarification": "在比赛或竞争中获胜"
                            },
                            {
                                "target_lang_word": "打败",
                                "target_lang_sense_clarification": "战胜对手"
                            },
                            {
                                "target_lang_word": "赢",
                                "target_lang_sense_clarification": "在游戏中胜出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14c32dd2-ba6f-32d0-b6ee-d045786b9938",
                    "sense_definition": "To hit repeatedly, often to cause pain, damage, or to make a sound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a stick to <w>beat</w> the dust out of the old rug.",
                            "target_lang_translations": {
                                "ru": "Он использовал палку, чтобы <w>выбить</w> пыль из старого ковра.",
                                "pl": "Użył kija, aby <w>wytrzepać</w> kurz ze starego dywanu.",
                                "zh": "他用一根棍子<w>敲打</w>旧地毯以除尘。"
                            }
                        },
                        {
                            "text": "The rain began to <w>beat</w> heavily against the windowpane.",
                            "target_lang_translations": {
                                "ru": "Дождь начал сильно <w>бить</w> в оконное стекло.",
                                "pl": "Deszcz zaczął mocno <w>bębnić</w> o szybę.",
                                "zh": "雨开始猛烈地<w>敲打</w>着窗玻璃。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hit",
                        "strike",
                        "pound",
                        "batter",
                        "thrash",
                        "hammer",
                        "bang"
                    ],
                    "common_phrases": [
                        "beat a drum",
                        "beat to death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Многократно наносить удары, часто с целью причинить боль, повредить или извлечь звук.",
                        "pl": "Wielokrotnie uderzać, często w celu zadania bólu, uszkodzenia czegoś lub wydobycia dźwięku.",
                        "zh": "反复击打，通常是为了造成疼痛、损坏或发出声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "наносить удары"
                            },
                            {
                                "target_lang_word": "колотить",
                                "target_lang_sense_clarification": "сильно ударять"
                            },
                            {
                                "target_lang_word": "выбивать",
                                "target_lang_sense_clarification": "удалять ударами (напр. пыль)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bić",
                                "target_lang_sense_clarification": "zadawać ciosy"
                            },
                            {
                                "target_lang_word": "uderzać",
                                "target_lang_sense_clarification": "stukać w coś"
                            },
                            {
                                "target_lang_word": "walić",
                                "target_lang_sense_clarification": "mocno uderzać"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打",
                                "target_lang_sense_clarification": "击打"
                            },
                            {
                                "target_lang_word": "敲打",
                                "target_lang_sense_clarification": "连续击打物体"
                            },
                            {
                                "target_lang_word": "拍打",
                                "target_lang_sense_clarification": "轻快地击打"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef7d0e2e-8d53-3eea-8f3c-cf2101fa6be6",
                    "sense_definition": "To move or sound with a regular rhythm, like a heart or a drum.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rhythm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My heart began to <w>beat</w> faster when I heard the scary noise.",
                            "target_lang_translations": {
                                "ru": "Моё сердце начало <w>биться</w> быстрее, когда я услышал пугающий шум.",
                                "pl": "Moje serce zaczęło <w>bić</w> szybciej, gdy usłyszałem przerażający hałas.",
                                "zh": "当我听到那个可怕的声音时，我的心开始<w>跳动</w>得更快了。"
                            }
                        },
                        {
                            "text": "The doctor checked to see if the patient's heart was still <w>beating</w>.",
                            "target_lang_translations": {
                                "ru": "Врач проверил, <w>бьётся</w> ли ещё сердце пациента.",
                                "pl": "Lekarz sprawdził, czy serce pacjenta wciąż <w>bije</w>.",
                                "zh": "医生检查病人的心脏是否还在<w>跳动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throb",
                        "pulsate",
                        "pound",
                        "thump",
                        "palpitate"
                    ],
                    "common_phrases": [
                        "heart beat",
                        "beat fast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или звучать в ровном ритме, подобно сердцу или барабану.",
                        "pl": "Poruszać się lub wydawać dźwięk w regularnym rytmie, jak serce lub bęben.",
                        "zh": "以规律的节奏移动或发出声音，如心脏或鼓。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "о сердце"
                            },
                            {
                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "издавать ритмичный звук"
                            },
                            {
                                "target_lang_word": "пульсировать",
                                "target_lang_sense_clarification": "ритмично двигаться"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bić",
                                "target_lang_sense_clarification": "o sercu lub zegarze"
                            },
                            {
                                "target_lang_word": "tętnić",
                                "target_lang_sense_clarification": "pulsować"
                            },
                            {
                                "target_lang_word": "stukać",
                                "target_lang_sense_clarification": "wydawać rytmiczny odgłos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳动",
                                "target_lang_sense_clarification": "指心脏的规律运动"
                            },
                            {
                                "target_lang_word": "敲击",
                                "target_lang_sense_clarification": "发出有节奏的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827d2243-ceb6-3fcf-969e-09c6f8dbf368",
                    "sense_definition": "To mix food ingredients vigorously using a fork, spoon, or machine to make them smooth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>beat</w> the eggs and sugar together until the mixture is fluffy.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>взбить</w> яйца с сахаром, пока смесь не станет воздушной.",
                                "pl": "Powinieneś <w>ubić</w> jajka z cukrem, aż masa stanie się puszysta.",
                                "zh": "你应该把鸡蛋和糖放在一起<w>搅打</w>，直到混合物变得蓬松。"
                            }
                        },
                        {
                            "text": "Use a whisk to <w>beat</w> the cream until it becomes thick.",
                            "target_lang_translations": {
                                "ru": "Используйте венчик, чтобы <w>взбить</w> сливки, пока они не загустеют.",
                                "pl": "Użyj trzepaczki, aby <w>ubić</w> śmietanę, aż zgęstnieje.",
                                "zh": "用打蛋器<w>打发</w>奶油，直到它变稠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whisk",
                        "whip",
                        "mix",
                        "blend",
                        "stir"
                    ],
                    "common_phrases": [
                        "beat eggs",
                        "beat the butter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергично смешивать ингредиенты вилкой, ложкой или миксером до однородности.",
                        "pl": "Energicznie mieszać składniki jedzenia za pomocą widelca, łyżki lub miksera, aby uzyskać gładką masę.",
                        "zh": "用叉子、勺子或机器用力搅拌食物成分，使其变得顺滑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбивать",
                                "target_lang_sense_clarification": "кулинарн."
                            },
                            {
                                "target_lang_word": "смешивать",
                                "target_lang_sense_clarification": "соединять ингредиенты"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ubijać",
                                "target_lang_sense_clarification": "np. pianę z białek"
                            },
                            {
                                "target_lang_word": "roztrzepać",
                                "target_lang_sense_clarification": "wymieszać jajka"
                            },
                            {
                                "target_lang_word": "bić",
                                "target_lang_sense_clarification": "np. śmietanę"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搅打",
                                "target_lang_sense_clarification": "烹饪中用力搅拌"
                            },
                            {
                                "target_lang_word": "打发",
                                "target_lang_sense_clarification": "将液体搅打至蓬松"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b08f672c-1352-3ba7-be52-5e45e26314ee",
                    "sense_definition": "To arrive, finish, or achieve something before a specific time or before others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to leave early in the morning to <w>beat</w> the traffic.",
                            "target_lang_translations": {
                                "ru": "Мы решили выехать рано утром, чтобы <w>проскочить</w> до пробок.",
                                "pl": "Zdecydowaliśmy się wyjechać wcześnie rano, aby <w>ominąć</w> korki.",
                                "zh": "我们决定清晨早点出发，以<w>避开</w>交通高峰。"
                            }
                        },
                        {
                            "text": "He ran as fast as he could to <w>beat</w> the others to the finish line.",
                            "target_lang_translations": {
                                "ru": "Он бежал изо всех сил, чтобы <w>опередить</w> остальных на финише.",
                                "pl": "Biegł tak szybko, jak mógł, aby <w>uprzedzić</w> innych na linii mety.",
                                "zh": "他尽可能快地跑，以便<w>抢先</w>到达终点线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "beat the clock",
                        "beat the traffic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибыть, закончить или достичь чего-либо раньше определенного времени или раньше других.",
                        "pl": "Przybyć, skończyć lub osiągnąć coś przed określonym czasem lub przed innymi.",
                        "zh": "在特定时间之前或在他人之前到达、完成或实现某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опередить",
                                "target_lang_sense_clarification": "сделать раньше других"
                            },
                            {
                                "target_lang_word": "проскочить",
                                "target_lang_sense_clarification": "успеть до (разг., напр. пробки)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uprzedzić",
                                "target_lang_sense_clarification": "być przed kimś"
                            },
                            {
                                "target_lang_word": "ominąć",
                                "target_lang_sense_clarification": "np. korki"
                            },
                            {
                                "target_lang_word": "pobić",
                                "target_lang_sense_clarification": "np. czas lub rekord"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赶在……之前",
                                "target_lang_sense_clarification": "抢在时间点前完成"
                            },
                            {
                                "target_lang_word": "抢先",
                                "target_lang_sense_clarification": "比别人先做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "573c77e7-a0aa-3c79-90a5-b599f95a8a55",
                    "sense_definition": "To be too difficult for someone to understand or solve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>beats</w> me why she decided to quit her job so suddenly.",
                            "target_lang_translations": {
                                "ru": "Мне совершенно <w>непонятно</w>, почему она решила так внезапно уволиться.",
                                "pl": "To mnie <w>przerasta</w>, dlaczego zdecydowała się tak nagle rzucić pracę.",
                                "zh": "我真<w>搞不懂</w>她为什么决定这么突然地辞职。"
                            }
                        },
                        {
                            "text": "The solution to this puzzle completely <w>beats</w> me.",
                            "target_lang_translations": {
                                "ru": "Решение этой головоломки меня совершенно <w>ставит в тупик</w>.",
                                "pl": "Rozwiązanie tej zagadki całkowicie mnie <w>przerasta</w>.",
                                "zh": "这个谜题的答案完全把我<w>难倒</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "baffle",
                        "perplex",
                        "confuse"
                    ],
                    "common_phrases": [
                        "beats me"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'it beats me'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть слишком сложным для чьего-либо понимания или решения.",
                        "pl": "Być zbyt trudnym dla kogoś do zrozumienia lub rozwiązania.",
                        "zh": "太难而无法理解或解决。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить в тупик",
                                "target_lang_sense_clarification": "озадачивать"
                            },
                            {
                                "target_lang_word": "быть непонятным",
                                "target_lang_sense_clarification": "не поддаваться пониманию"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przerastać",
                                "target_lang_sense_clarification": "być zbyt trudnym"
                            },
                            {
                                "target_lang_word": "zbić z tropu",
                                "target_lang_sense_clarification": "wprawić w zakłopotanie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难倒",
                                "target_lang_sense_clarification": "使人无法解决"
                            },
                            {
                                "target_lang_word": "搞不懂",
                                "target_lang_sense_clarification": "无法理解"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe821d71-ae1d-3dca-9a7d-279f7d58ec09",
                    "sense_definition": "The main rhythm or unit of time in a piece of music.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This song has a very catchy <w>beat</w> that makes you want to dance.",
                            "target_lang_translations": {
                                "ru": "У этой песни очень запоминающийся <w>ритм</w>, под который хочется танцевать.",
                                "pl": "Ta piosenka ma bardzo wpadający w ucho <w>rytm</w>, który sprawia, że chce się tańczyć.",
                                "zh": "这首歌有一种非常抓耳的<w>节奏</w>，让人想跳舞。"
                            }
                        },
                        {
                            "text": "Can you clap your hands to the <w>beat</w> of the music?",
                            "target_lang_translations": {
                                "ru": "Ты можешь хлопать в ладоши в <w>такт</w> музыке?",
                                "pl": "Czy możesz klaskać w <w>takt</w> muzyki?",
                                "zh": "你能跟着音乐的<w>拍子</w>拍手吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "rhythm",
                        "pulse"
                    ],
                    "common_phrases": [
                        "on the beat",
                        "drum beat",
                        "miss a beat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной ритм или единица времени в музыкальном произведении.",
                        "pl": "Główny rytm lub jednostka czasu w utworze muzycznym.",
                        "zh": "音乐作品中的主要节奏或时间单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "музыкальный"
                            },
                            {
                                "target_lang_word": "такт",
                                "target_lang_sense_clarification": "единица ритма"
                            },
                            {
                                "target_lang_word": "бит",
                                "target_lang_sense_clarification": "ударный ритм (совр.)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rytm",
                                "target_lang_sense_clarification": "muzyczny"
                            },
                            {
                                "target_lang_word": "takt",
                                "target_lang_sense_clarification": "jednostka miary"
                            },
                            {
                                "target_lang_word": "bit",
                                "target_lang_sense_clarification": "podkład rytmiczny"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节奏",
                                "target_lang_sense_clarification": "音乐的律动"
                            },
