                        ],
                        "examples": [
                            {
                                "example_id": "405823a2-de83-41c5-bb93-8ad145482516",
                                "sense_id": "a70e426b-777e-3baa-bb98-0c302fc23b66",
                                "text": "Qu'importe qu'elle [celle que tu aimes] soit tordue / Bien roulée ou locdue"
                            },
                            {
                                "example_id": "c229384b-67b2-44b2-abc5-5cd6a1e14afc",
                                "sense_id": "a70e426b-777e-3baa-bb98-0c302fc23b66",
                                "text": "On marchait de plus en plus vite. N’importe, il suivait. Larme à l’œil, presque. Tout mélancolo. Navré. Locdu de fond en comble dans son habit de carnaval."
                            },
                            {
                                "example_id": "52a20d42-7a0d-42d6-9bf0-7030e18cf7ae",
                                "sense_id": "a70e426b-777e-3baa-bb98-0c302fc23b66",
                                "text": "Pour arriver à en fabriquer d’aussi locdus, ça doit exiger du temps, des soins, tout un boulot terrible."
                            }
                        ]
                    }
                ],
