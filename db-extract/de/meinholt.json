                "senses": [
                    {
                        "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                        "entry_id": "6418339f-ce6e-375d-bd8f-3f42dd14d432",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aa546f0-1f4f-4950-8e3e-777e8cec9837",
                                "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                                "text": "Frau Meinholt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "af81981f-bb0d-4737-9f88-8b5d0704af00",
                                "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                                "text": "Herr Meinholt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f90730ea-2da5-4543-97b8-c280db6d580b",
                                "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                                "text": "Die Meinholts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2adbb62d-595c-4697-af35-5a004618fd8d",
                                "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                                "text": "Der Meinholt trägt nie die Schals, die die Meinholt ihm strickt."
                            },
                            {
                                "example_id": "ba52cc4a-b6e6-42f4-81d5-96afad21eb0c",
                                "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meinholt kommt, geht der Herr Meinholt.“"
                            },
                            {
                                "example_id": "b71ea830-2417-449b-b9b5-5fa81e2129fb",
                                "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                                "text": "Meinholt kommt und geht."
                            },
                            {
                                "example_id": "e46afc07-43fc-4aa3-903b-01287a38c47b",
                                "sense_id": "e5410968-5d60-38d2-86f5-c37549ebb35b",
                                "text": "Meinholts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
