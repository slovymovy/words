                            }
                        ]
                    },
                    {
                        "translation_id": "ded5babd-3ddb-4ffb-b101-4507c25c2c0a",
                        "source_entry_id": "19c2556d-f29d-3b23-9ff9-d1c30c316cc8",
                        "source_sense_id": "dec7ef02-6200-391e-88cf-7de170b025f3",
                        "target_lang_word": "dreiwertig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreiwertig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "153580fc-48dc-3d23-8a8f-ffb1110229ae",
                                        "entry_id": "e4e06156-6ca3-318d-86dc-a7d0ae34bed8",
                                        "glosses": [
                                            "fähig, sich mit drei einwertigen Wasserstoffatomen zu verbinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "267c0028-e7a2-4bdc-afc5-7f449a3aa3fb",
                                                "sense_id": "153580fc-48dc-3d23-8a8f-ffb1110229ae",
                                                "text": "„Das dreiwertige Chrom in Chromelektrolyten lässt sich sehr gut, und zwar mit angenähert 100%iger Stromausbeute, zu Chromsäure oxidieren.“"
                                            },
                                            {
                                                "example_id": "d5d4099c-b3ed-40b8-a3b7-b267f20885d2",
                                                "sense_id": "153580fc-48dc-3d23-8a8f-ffb1110229ae",
                                                "text": "„Das toxische dreiwertige Oxid (As2O) wird durch Lunge und Darm absorbiert.“"
                                            },
                                            {
                                                "example_id": "d3bf77d8-7eac-45ce-bdac-a9f4057f705f",
                                                "sense_id": "153580fc-48dc-3d23-8a8f-ffb1110229ae",
                                                "text": "„Zur Entgiftung werden beim Menschen dreiwertige Arsenverbindungen zu fünfwertigen oxidiert und anschließend zu methylierten Arsensäuren umgesetzt.“"
                                            },
                                            {
                                                "example_id": "0fe3611d-dbc0-4070-bc4c-7740f62aa203",
                                                "sense_id": "153580fc-48dc-3d23-8a8f-ffb1110229ae",
                                                "text": "„Glycerin ist ein Zuckeralkohol und der einfachste dreiwertige Alkohol, ein Triol."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3deb49b9-2b7a-30d4-ad62-b2ea769156ff",
                                        "entry_id": "e4e06156-6ca3-318d-86dc-a7d0ae34bed8",
                                        "glosses": [
                                            "drei obligatorische Aktanten fordernd"
                                        ],
                                        "tags": [
                                            "bei einem Verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07f2c7f3-ff6d-497e-a947-929880d0bae4",
                                                "sense_id": "3deb49b9-2b7a-30d4-ad62-b2ea769156ff",
                                                "text": "„Die Valenz der AcI-Verben ist nicht klar, sie können als zwei- oder dreiwertig gesehen werden, oder Verbalkomplex-bildend mit dem infiniten Verb.“"
                                            },
                                            {
                                                "example_id": "03cbfd06-4da2-4180-b819-cd4890d8dbd1",
                                                "sense_id": "3deb49b9-2b7a-30d4-ad62-b2ea769156ff",
                                                "text": "„Dreiwertige (trivalente) Verben fordern neben dem Subjekt zwei Objekte, meist im Akkusativ und Dativ: […]“"
                                            },
                                            {
                                                "example_id": "a747b4e6-4e76-4fd1-8cac-3c2e64f2b910",
                                                "sense_id": "3deb49b9-2b7a-30d4-ad62-b2ea769156ff",
                                                "text": "„Dreiwertige Gefühlsverben sind in der Literatur bisher kaum berücksichtigt worden.“"
                                            },
                                            {
                                                "example_id": "734f06d6-9b02-4b1b-8ff4-e867b4788c70",
                                                "sense_id": "3deb49b9-2b7a-30d4-ad62-b2ea769156ff",
                                                "text": "„Infinitivkonstruktionen als Komplemente zu dreiwertigen Verben sind unter den Stichwörtern „Kontrolle“, „Kontrollbeziehung“, „Kontrollverben“ ein vieldiskutierter Gegenstand der grammatischen Literatur.“"
                                            },
                                            {
                                                "example_id": "fe99830b-d4c6-412a-a392-562a49724aed",
                                                "sense_id": "3deb49b9-2b7a-30d4-ad62-b2ea769156ff",
                                                "text": "„Wichtig ist die Unterteilung in zwei- und dreiwertige Verben: Bei zweiwertigen Verben tritt neben dem Subjekt nur ein Objekt auf (z.B. jemandes gedenken), bei dreiwertigen Verben kommen dagegen neben dem Subjekt zwei Objekte vor (z.B. jemanden einer Sache bezichtigten).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b9c3317c-02ec-3795-bdfe-e6b82f8d2c46",
                                        "entry_id": "e4e06156-6ca3-318d-86dc-a7d0ae34bed8",
                                        "glosses": [
                                            "gleichzeitig gegen drei unterschiedliche Erreger immunisierend"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e498bab-b1a7-4375-86f2-6d12d418c581",
                                                "sense_id": "b9c3317c-02ec-3795-bdfe-e6b82f8d2c46",
                                                "text": "„Es gibt dreiwertige Impfstoffe (Diphtherie, Tetanus und Polio oder Keuchhusten), vierwertige Impfstoffe (alle vier, zur Wiederholungsimpfung im Alter von fünf Jahren) und fünfwertige Impfstoffe (alle fünf oder andere Kombinationen).“"
                                            },
                                            {
                                                "example_id": "4264d38e-0ade-4d08-a7e4-e86bee2faf61",
                                                "sense_id": "b9c3317c-02ec-3795-bdfe-e6b82f8d2c46",
                                                "text": "„Eine im Handel erhältliche dreiwertige Vakzine ergab unter Laboratoriumsverhältnissen bei 20 Rindern eine Trächtigkeit von 100 % mit einem Rind, das einmal nachrinderte, von 24 Kontrollen wurden 69,5 % trächtig mit 8 Konzeptionen erst beim zweiten Östrus.“"
                                            },
                                            {
                                                "example_id": "c38e5509-6d5e-4062-b42d-62a4323c9113",
                                                "sense_id": "b9c3317c-02ec-3795-bdfe-e6b82f8d2c46",
                                                "text": "„Es gelingt beim Pferd zweiwertige und dreiwertige Antisera zu erhalten durch Einspritzung von Anatoxinmischungen […].“"
                                            },
                                            {
                                                "example_id": "78f62fcb-99dc-42c1-8166-66425ef2c58e",
                                                "sense_id": "b9c3317c-02ec-3795-bdfe-e6b82f8d2c46",
                                                "text": "„In einer 5. Mitteilung seiner Studien, betreffend das neurotrope Virus der Pferdesterbe, berichtet R. A. Alexander über die antigene Reaktion von Pferden auf die simultane dreiwertige Immunisierung.“"
                                            },
                                            {
                                                "example_id": "9cfe6846-1dca-4351-a2af-a27ec967a667",
                                                "sense_id": "b9c3317c-02ec-3795-bdfe-e6b82f8d2c46",
                                                "text": "„Das Gesundheitsministerium geht aber davon aus, dass die 4er Impfung ebenso effektiv ist wie der bisherige dreiwertige Impfstoff. Den verschiedenen Altersgruppen wird man die neue Impfung aber nicht ausdrücklich empfehlen. Für Nicht-Risikogruppen ist der neue Impfstoff allerdings teurer als der dreiwertige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
