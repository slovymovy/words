                    },
                    {
                        "form_id": "1c5d0211-d094-4afe-b89e-d99e13846a22",
                        "entry_id": "c44cbd20-6bfc-323e-977d-e30469f6b8d9",
                        "tags": [
                            "plaquage",
                            "orthographe parfois utilisée dans ce sens, mais moins fréquemment que , et souvent considérée comme une faute"
                        ],
                        "form": "placage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fa85171-459f-3b85-8bb9-832e879e9107",
                        "entry_id": "c44cbd20-6bfc-323e-977d-e30469f6b8d9",
                        "glosses": [
                            "Action de plaquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7839579d-3c94-4d68-a70b-629c3e4a6eb3",
                                "sense_id": "6fa85171-459f-3b85-8bb9-832e879e9107",
                                "text": "Une usine de plaquage des bois s'est installée dans l'arrondissement de Montbéliard, à Saint-Maurice."
                            },
                            {
                                "example_id": "6b3e92db-2a45-468a-8793-7d928e218bea",
                                "sense_id": "6fa85171-459f-3b85-8bb9-832e879e9107",
                                "text": "En Chine, l'effondrement d'une usine de plaquage de métaux a fait plus de cent morts dans la province de Zhejiang."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e420e81-9e02-33c7-abd7-7acd31cf7e56",
                        "entry_id": "c44cbd20-6bfc-323e-977d-e30469f6b8d9",
                        "glosses": [
                            "Application d’une mince couche régulière d’un métal généralement précieux ou d'un alliage."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "13018852-6057-4236-ae51-d4c4d22a8527",
                                "sense_id": "8e420e81-9e02-33c7-abd7-7acd31cf7e56",
                                "text": "Un plaquage en or."
                            }
                        ]
                    },
                    {
                        "sense_id": "a68c4c59-59e7-3695-b106-c563184c91b9",
                        "entry_id": "c44cbd20-6bfc-323e-977d-e30469f6b8d9",
                        "glosses": [
                            "Résultat de cette action, la couche de métal, de bois, etc. en elle même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af599f5d-2940-46d2-8932-05301e18e9ef",
                                "sense_id": "a68c4c59-59e7-3695-b106-c563184c91b9",
                                "text": "Le plaquage d'ébène de ce cabinet se décolle."
                            },
                            {
                                "example_id": "b6c983b1-d9b6-4ad3-9f0f-6aa49688f023",
                                "sense_id": "a68c4c59-59e7-3695-b106-c563184c91b9",
                                "text": "Le plaquage or est encore tiède de sa chaleur. Je fais tourner l'objet tapageur entre mes doigts."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fa2d2db-b45e-30f3-ba99-644b79bacf40",
                        "entry_id": "c44cbd20-6bfc-323e-977d-e30469f6b8d9",
                        "glosses": [
                            "Action de faire tomber le porteur du ballon. Le joueur plaqué est ainsi tenu au sol."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "2c514e63-82ff-44ed-ba2a-b4bb436a9221",
                                "sense_id": "0fa2d2db-b45e-30f3-ba99-644b79bacf40",
                                "text": "Un plaquage peut avoir lieu partout dans le champ de jeu. Les actions des joueurs impliqués dans le plaquage doivent assurer une lutte équitable et permettre au ballon d’être immédiatement disponible pour être joué."
                            },
                            {
                                "example_id": "9014f309-bb39-4aca-9b53-deb3ca656923",
                                "sense_id": "0fa2d2db-b45e-30f3-ba99-644b79bacf40",
                                "text": "Le troisième ligne des espoirs du Stade Français a succombé à une fracture d’une vertèbre cervicale contractée sur un double plaquage, lors d’un match contre Bègles, en Gironde."
                            },
                            {
                                "example_id": "5ac1c0f3-38ff-4d7d-aef5-6ef28774335d",
                                "sense_id": "0fa2d2db-b45e-30f3-ba99-644b79bacf40",
                                "text": "C’est pourquoi « ce match a une saveur particulière », a affirmé, jeudi en conférence de presse, le sélectionneur Thomas Darracq, qui a demandé à ses joueuses de « maintenir » l’intensité défensive démontrée contre les Red Roses (214 plaquages)."
                            }
                        ]
                    }
                ],
