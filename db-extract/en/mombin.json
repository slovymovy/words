                                        "entry_id": "d518e7dd-56ae-35cb-83fd-dcc407a88a6d",
                                        "glosses": [
                                            "Nom vernaculaire du Spondias mombin."
                                        ],
                                        "tags": [
                                            "Haïti"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a2293b-9ddc-4be4-b2e5-472976159c47",
                                                "sense_id": "a45cecc3-2f58-3e79-8814-2be56bc66c88",
                                                "text": "C’est une ravine fraîche à cause d’une falaise escarpée et des branchages de mombins qui l’ombragent."
                                            },
                                            {
                                                "example_id": "f083dc3c-830d-43e3-b21e-d7616b53af7e",
                                                "sense_id": "a45cecc3-2f58-3e79-8814-2be56bc66c88",
                                                "text": "Les mombins sont originaires d’Amérique ; on les croit également indigènes en Afrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de973abf-ab13-3e9b-874b-37339d92ecbf",
                                        "entry_id": "d518e7dd-56ae-35cb-83fd-dcc407a88a6d",
                                        "glosses": [
                                            "Fruit de cet arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a690f3ff-13a4-4e11-b560-d48e9aa72460",
                                                "sense_id": "de973abf-ab13-3e9b-874b-37339d92ecbf",
                                                "text": "La mangue n’est pas du même genre ni de la même famille que les précédents (c’est une anacardiacée, famille à laquelle appartiennent la noix de cajou, le mombin et la pistache)."
                                            },
                                            {
                                                "example_id": "0133caca-6587-4c5d-907e-98633c63c462",
                                                "sense_id": "de973abf-ab13-3e9b-874b-37339d92ecbf",
                                                "text": "J’ai un rhum aux mombins…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e63d8c-6709-32c9-ad2e-f990af0ad972",
                                        "entry_id": "d518e7dd-56ae-35cb-83fd-dcc407a88a6d",
                                        "glosses": [
                                            "Autre nom du poisson-soldat à bande noire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046be042-5a99-4c10-b9b9-fdcc3e25ba92",
                                                "sense_id": "77e63d8c-6709-32c9-ad2e-f990af0ad972",
                                                "text": "Le mombin est présent dans l’Atlantique tropical Ouest, de la Caroline du Nord et des Bahamas au Brésil."
                                            },
                                            {
                                                "example_id": "f37569dc-4922-4bd8-9e1b-9802de910ec8",
                                                "sense_id": "77e63d8c-6709-32c9-ad2e-f990af0ad972",
                                                "text": "Le mombin vit en groupe. Sa taille peut atteindre une vingtaine de centimètres."
                                            }
                                        ]
                                    }
