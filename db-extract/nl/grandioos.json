                                                "example_id": "3754d09e-219e-4593-8bb2-a73163493570",
                                                "sense_id": "41c8b370-cc53-3651-b7d0-b05fa56e253c",
                                                "text": "The hundredodd pages of photographs provide superb iconography of artistic collaboration and its rewards."
                                            }
                                        ]
