{
    "word_family": [
        "master",
        "mastery",
        "masterful",
        "masterly",
        "masterpiece",
        "mastermind"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a394c628-aeed-32a9-9308-ac15cf578718",
                    "sense_definition": "Plural of <w>master</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plural_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servants were expected to obey their <masters> without question.",
                            "target_lang_translations": {
                                "ru": "Слуги должны были беспрекословно подчиняться своим <хозяевам>.",
                                "tr": "Hizmetkarların <efendilerine> sorgusuz sualsiz itaat etmeleri beklenirdi."
                            }
                        },
                        {
                            "text": "We visited the museum to see paintings by the old <masters>.",
                            "target_lang_translations": {
                                "ru": "Мы посетили музей, чтобы увидеть картины старых <мастеров>.",
                                "tr": "Eski <ustaların> tablolarını görmek için müzeyi ziyaret ettik."
                            }
                        }
                    ],
                    "synonyms": [
                        "experts",
                        "rulers",
                        "owners"
                    ],
                    "antonyms": [
                        "apprentices",
                        "servants",
                        "novices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова master (хозяин, мастер).",
                        "tr": "Master kelimesinin çoğul hali; sahipler, efendiler veya uzmanlar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяева",
                                "target_lang_sense_clarification": "владельцы или правители"
                            },
                            {
                                "target_lang_word": "мастера",
                                "target_lang_sense_clarification": "великие художники или специалисты"
                            },
                            {
                                "target_lang_word": "господа",
                                "target_lang_sense_clarification": "обращение к людям высокого статуса (устар.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "efendiler",
                                "target_lang_sense_clarification": "hizmet edilen kişiler veya sahipler"
                            },
                            {
                                "target_lang_word": "ustalar",
                                "target_lang_sense_clarification": "bir alanda uzmanlaşmış kişiler veya sanatçılar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14e1e9f0-ee36-3458-8ec6-19af652aafa3",
                    "sense_definition": "An advanced academic degree granted to a student who has successfully completed a course of study at a postgraduate level.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is planning to study for a <masters> in engineering next year.",
                            "target_lang_translations": {
                                "ru": "В следующем году она планирует поступить в <магистратуру> по инженерному делу.",
                                "tr": "Gelecek yıl mühendislik alanında <yüksek lisans> yapmayı planlıyor."
                            }
                        },
                        {
                            "text": "Having a <masters> degree can open up more career opportunities.",
                            "target_lang_translations": {
                                "ru": "Наличие <степени магистра> может открыть больше карьерных возможностей.",
                                "tr": "<Yüksek lisans> derecesine sahip olmak daha fazla kariyer fırsatı açabilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "master's degree",
                        "MA",
                        "MSc"
                    ],
                    "common_phrases": [
                        "masters degree",
                        "do a masters",
                        "get a masters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ученая степень, следующая за бакалавриатом; магистратура.",
                        "tr": "Lisansüstü düzeyde tamamlanan akademik bir eğitim derecesi; yüksek lisans."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магистратура",
                                "target_lang_sense_clarification": "курс обучения"
                            },
                            {
                                "target_lang_word": "степень магистра",
                                "target_lang_sense_clarification": "академическая квалификация"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüksek lisans",
                                "target_lang_sense_clarification": "lisansüstü eğitim programı"
                            },
                            {
                                "target_lang_word": "yüksek lisans derecesi",
                                "target_lang_sense_clarification": "akademik unvan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3638ebae-b4fd-3af7-ad4b-892e2baaed0a",
                    "sense_definition": "Third-person singular simple present indicative form of <w>master</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He quickly <masters> every new video game he plays.",
                            "target_lang_translations": {
                                "ru": "Он быстро <осваивает> каждую новую видеоигру, в которую играет.",
                                "tr": "Oynadığı her yeni video oyununda hızla <ustalaşıyor>."
                            }
                        },
                        {
                            "text": "Practice is the only way a musician <masters> a difficult piece.",
                            "target_lang_translations": {
                                "ru": "Практика — единственный способ, которым музыкант <овладевает> сложным произведением.",
                                "tr": "Pratik yapmak, bir müzisyenin zor bir esere <hakim olmasının> tek yoludur."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasps",
                        "learns",
                        "conquers"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола master в 3-м лице ед. числа (осваивает, овладевает).",
                        "tr": "Master fiilinin üçüncü tekil şahıs geniş zaman hali; bir şeyi tam olarak öğrenmek veya hakim olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осваивает",
                                "target_lang_sense_clarification": "изучает что-то новое"
                            },
                            {
                                "target_lang_word": "овладевает",
                                "target_lang_sense_clarification": "достигает мастерства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ustalaşır",
                                "target_lang_sense_clarification": "bir konuda uzmanlık kazanır"
                            },
                            {
                                "target_lang_word": "öğrenir",
                                "target_lang_sense_clarification": "bir beceriyi tam olarak kavrar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eba6f4cd-c59f-3abc-b29a-80b0f28c34ae",
                    "sense_definition": "Relating to a sports league or competition limited to players above a certain age or level of experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_category",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local swimming club is hosting a <masters> meet this weekend.",
                            "target_lang_translations": {
                                "ru": "Местный плавательный клуб проводит соревнования категории <Мастерс> в эти выходные.",
                                "tr": "Yerel yüzme kulübü bu hafta sonu bir <veteranlar> müsabakasına ev sahipliği yapıyor."
                            }
                        },
                        {
                            "text": "He still competes professionally in the <masters> division for tennis.",
                            "target_lang_translations": {
                                "ru": "Он все еще профессионально соревнуется в дивизионе <Мастерс> по теннису.",
                                "tr": "Hala teniste <veteranlar> liginde profesyonel olarak yarışıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "veteran"
                    ],
                    "antonyms": [
                        "junior"
                    ],
                    "common_phrases": [
                        "masters tournament",
                        "masters division"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к спортивным соревнованиям для ветеранов или опытных спортсменов.",
                        "tr": "Belirli bir yaşın üzerindeki veya deneyimli sporculara yönelik spor müsabakaları kategorisi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мастерс",
                                "target_lang_sense_clarification": "название категории соревнований"
                            },
                            {
                                "target_lang_word": "ветеранский",
                                "target_lang_sense_clarification": "относящийся к ветеранам спорта"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "veteran",
                                "target_lang_sense_clarification": "deneyimli sporcular için kullanılan kategori"
                            },
                            {
                                "target_lang_word": "ustalar",
                                "target_lang_sense_clarification": "spor müsabakalarında ileri seviye kategori"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2ce84d3a-6136-3823-bf71-c9a4366d1d10",
                    "sense_definition": "A surname originating as an occupation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I have an appointment with Dr. <Masters> at three o'clock.",
                            "target_lang_translations": {
                                "ru": "У меня назначена встреча с доктором <Мастерсом> на три часа.",
                                "tr": "Saat üçte Dr. <Masters> ile randevum var."
                            }
                        },
                        {
                            "text": "Mr. <Masters> has lived in this neighborhood for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <Мастерс> живет в этом районе уже двадцать лет.",
                                "tr": "Bay <Masters> yirmi yıldır bu mahallede yaşıyor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "originating as an occupation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия профессии.",
                        "tr": "Meslek adından türemiş bir soyadı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мастерс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Masters",
                                "target_lang_sense_clarification": "özel isim (soyadı)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}