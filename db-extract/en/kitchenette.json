                                "target_senses": [
                                    {
                                        "sense_id": "6fdbf7e7-ef78-373f-9de7-4229574196ab",
                                        "entry_id": "aa606cd0-0ee3-39d7-8b62-2f6fd4e91b97",
                                        "glosses": [
                                            "Petite cuisine."
                                        ],
                                        "tags": [
                                            "Bâtiment"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f04ef81-b5fe-4f4c-9a42-1738d627fbbf",
                                                "sense_id": "6fdbf7e7-ef78-373f-9de7-4229574196ab",
                                                "text": "Par logement vacant, on entend tout logement habitable, comprenant une cuisine ou une cuisinette, mais inoccupé lors du recensement, et qui était à louer ou à vendre."
                                            },
                                            {
                                                "example_id": "445b64ad-0728-4972-9f6b-3e724d15dec4",
                                                "sense_id": "6fdbf7e7-ef78-373f-9de7-4229574196ab",
                                                "text": "Françoise jouissait d’une chambre bien ordonnée – « j’ai le goût du ménage », disait-elle – avec pour appendicules une claire cuisinette, une douche, un petit rangement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a49f89e7-4350-4736-b0c0-f6b1d518361f",
                        "source_entry_id": "6a2f30cb-a3a4-3740-904e-c38fd5b1a5ee",
                        "source_sense_id": "a476eaf3-99dd-3418-801b-33479fa7e7e6",
                        "source_sense_description": "small kitchen",
                        "target_lang_word": "Kochnische",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kochnische",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dfa0a18-82fb-365b-9b7f-1129cbaa6e02",
                                        "entry_id": "b853c08b-1027-3d04-8087-45ecf5478f02",
                                        "glosses": [
                                            "etwas abgetrennter Bereich eines Raums, der mit den nötigsten Elementen einer Küche (etwa Herd, Kühlschrank, Spüle) ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af2e1da-5a88-4855-954b-14116524454d",
                                                "sense_id": "6dfa0a18-82fb-365b-9b7f-1129cbaa6e02",
                                                "text": "„Sie sitzen auf den Betten und dem Aufklappsofa, sie drücken sich an den Schrank, hinter dem sich die Kochnische verbirgt, sie kauern auf den viel zu kleinen Plastikstühlen […].“"
                                            },
                                            {
                                                "example_id": "36d993b3-d9dd-4c64-b41b-b0075e9e8b36",
                                                "sense_id": "6dfa0a18-82fb-365b-9b7f-1129cbaa6e02",
                                                "text": "„Hinter einem Vorhang befand sich eine Kochnische, gleich neben dem Notausgang, der in den Hinterhof führte, wo übrigens ein Klosett war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
