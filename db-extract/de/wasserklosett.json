                                    },
                                    {
                                        "sense_id": "c05572b3-238c-301d-9bfb-157c44057d50",
                                        "entry_id": "e72aaff2-1867-337c-8b48-97a03efe0171",
                                        "glosses": [
                                            "Deuxième personne du singulier du subjonctif présent du verbe toiletter."
                                        ],
