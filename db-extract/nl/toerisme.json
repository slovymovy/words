                    {
                        "sense_id": "1b04a3f7-5fc1-3825-a1a8-bb08861197a4",
                        "entry_id": "b851e407-b608-37b5-aab0-128f1d71158e",
                        "glosses": [
                            "reizen (soms voor ontspanning, soms om zakelijke of medische redenen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6999c245-bc17-499c-b7e6-4382dee8da05",
                                "sense_id": "1b04a3f7-5fc1-3825-a1a8-bb08861197a4",
                                "text": "Hij werkt bij een bedrijf dat gespecialiseerd is in toerisme."
                            },
                            {
                                "example_id": "1e6db689-27ef-4d81-a53e-dfbeb2a340f8",
                                "sense_id": "1b04a3f7-5fc1-3825-a1a8-bb08861197a4",
                                "text": "Sedert lang bezitten de boekerijen van alle landen talrijke werken, waarin de wetenschap de uitkomsten van hare nasporingen over de verschillende landstreken van Europa heeft nedergelegd, waarin het tourisme de herinnering aan zijne indrukken, opmerkingen en soms wel luchtige trekken, heeft gelaten."
                            },
                            {
                                "example_id": "d0a0cfea-7b6d-4467-a04c-74e51a710681",
                                "sense_id": "1b04a3f7-5fc1-3825-a1a8-bb08861197a4",
                                "text": "Koraalriffen zijn van levensbelang voor het leven in de oceanen en daardoor ook voor de mensheid. 25 procent van het zeeleven leeft in en rond koraalriffen. Ze zijn van belang voor de visserij, toerisme en bescherming van kustlijnen tegen erosie en stormen. Het is nog onduidelijk of en wanneer het huidige proces van verbleking stopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8b867d2-8d5f-4cb9-8f61-9c49912936f9",
                        "source_entry_id": "b851e407-b608-37b5-aab0-128f1d71158e",
                        "source_sense_id": "1b04a3f7-5fc1-3825-a1a8-bb08861197a4",
                        "source_sense_description": "het reizen voor ontspanning",
                        "target_lang_word": "Tourismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tourismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                        "entry_id": "c1e45e54-ef1d-3181-8a6f-534db44fe964",
                                        "glosses": [
                                            "Gesamtheit des Fremdenverkehrs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1640b0ae-6999-4df5-91f8-562743020c39",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„Auch im Tourismus wird dieses vage historische Gefühl kultiviert und genutzt.“"
                                            },
                                            {
                                                "example_id": "c1ee9acb-ccd3-437f-8ef0-cf1ca8c76b92",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„Der Tourismus stellt in Koblenz einen bedeutenden ökologischen und ökonomischen Einflussfaktor dar.“"
                                            },
                                            {
                                                "example_id": "b95bda8a-3c05-45f2-95f7-a12bfe5fb100",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "[…] „Der Tourismus verursacht bereits neun Prozent der globalen CO₂-Emissionen, haben Forscher berechnet – und fordern Gegenmaßnahmen.“"
                                            },
                                            {
                                                "example_id": "9e41b150-d6c9-4ba4-a28a-350af3091f31",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„An manchen Ecken sieht Berlin nachts trotz des Tourismus gespenstisch, gar ausgestorben aus.“"
                                            },
                                            {
                                                "example_id": "28fb76fd-0c4c-45be-b892-e6d459f237e4",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„Beim Tourismus galt seit jeher, schon seit der Kavalierstour, dass Hunger und Elend nie weit von den Fünfsternehotels entfernt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
