                ],
                "senses": [
                    {
                        "sense_id": "19719d85-5964-3ba6-a687-f0ddce9a378a",
                        "entry_id": "0fbd8ebe-9f91-3efb-a6f2-c5dd96d188ec",
                        "glosses": [
                            "книжн. переходный возраст между детством и юностью; период жизни в таком возрасте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5bd5396-4acd-4d50-a756-332f3a242a67",
                                "sense_id": "19719d85-5964-3ba6-a687-f0ddce9a378a",
                                "text": "Отрочество и юность его большею частью протекли в Новгороде."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1aaa5211-19aa-4e4f-96a1-172523095171",
                        "source_entry_id": "0fbd8ebe-9f91-3efb-a6f2-c5dd96d188ec",
                        "source_sense_id": "19719d85-5964-3ba6-a687-f0ddce9a378a",
                        "target_lang_word": "boyhood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boyhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3a2549-b1d4-3972-b2fb-1742ab6985d6",
                                        "entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                                        "glosses": [
                                            "The state or condition of being a boy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7c226d3-6f55-4baa-a460-1d475015f43e",
                                                "sense_id": "4a3a2549-b1d4-3972-b2fb-1742ab6985d6",
                                                "text": "And boyhood is a summer sun\nWhose waning is the dreariest one —\nFor all we live to know is known\nAnd all we seek to keep hath flown — […]"
                                            },
                                            {
                                                "example_id": "0477bb1b-5754-41cf-af3e-467375aec00d",
                                                "sense_id": "4a3a2549-b1d4-3972-b2fb-1742ab6985d6",
                                                "text": "It is certainly my personal favourite, for it was by way of Hardwick's great Doric arch that I first sampled the roar and clatter of London streets, the trip being a boyhood reward for achieving (unexpected) success in a school examination!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcfdb79-5675-31fe-b9f1-ba936798c888",
                                        "entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                                        "glosses": [
                                            "The childhood of a boy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1767c8-7e56-4567-96c9-ce1c3e95b2e4",
                        "source_entry_id": "0fbd8ebe-9f91-3efb-a6f2-c5dd96d188ec",
                        "source_sense_id": "19719d85-5964-3ba6-a687-f0ddce9a378a",
                        "target_lang_word": "adolescence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adolescence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17e59775-b6c5-3b13-84c1-125b351fe70c",
                                        "entry_id": "c6cf78b3-d252-3f5a-9186-9dc47f3ab371",
                                        "glosses": [
                                            "Période de la vie comprise entre le moment où l’être humain entre dans la puberté et le moment où il atteint la majorité civile, où il sera alors considéré comme un adulte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2c2ccb9-86da-4479-aee9-4e28853f5cc0",
                                                "sense_id": "17e59775-b6c5-3b13-84c1-125b351fe70c",
                                                "text": "Il y a six degrés d’âges ; savoir : l’enfance proprement dite, infantia ; la seconde enfance, pueritia ; l’adolescence, la virilité, la vieillesse et la décrépitude."
                                            },
                                            {
                                                "example_id": "53924f37-2181-4ae1-8ce2-6725be8e72c0",
                                                "sense_id": "17e59775-b6c5-3b13-84c1-125b351fe70c",
                                                "text": "Cependant Emma avait treize ans et Albert dix-huit ; leur cœur, comme une rose en bouton, allait s’ouvrir au premier souffle de l’adolescence."
                                            },
                                            {
                                                "example_id": "a29b675a-f0f6-44b2-bd29-4068257d8ec0",
                                                "sense_id": "17e59775-b6c5-3b13-84c1-125b351fe70c",
                                                "text": "Ce n’était en somme que le vide de son cœur à peine sorti des limbes enchantés de l’adolescence."
                                            },
                                            {
                                                "example_id": "f168c83b-fb93-42c4-a616-10eed5086727",
                                                "sense_id": "17e59775-b6c5-3b13-84c1-125b351fe70c",
                                                "text": "L’adolescence ne laisse un bon souvenir qu’aux adultes ayant mauvaise mémoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ee9dfd-8ab6-3937-98e3-e10446498634",
                                        "entry_id": "c6cf78b3-d252-3f5a-9186-9dc47f3ab371",
                                        "glosses": [
                                            "Les premiers temps."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff9169b2-401e-429f-bd4d-f776fa2ee02e",
                                                "sense_id": "a6ee9dfd-8ab6-3937-98e3-e10446498634",
                                                "text": "L’adolescence de l’art est élégante, sa virilité pompeuse, et sa vieillesse riche, mais surchargée d’ornements qui en dissimulent le dépérissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
