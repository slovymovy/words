                                "example_id": "635b029e-f662-4f2a-9c0d-23c8b92b7f15",
                                "sense_id": "68daed0b-e3eb-3bf6-b888-b9b1b110c5f0",
                                "text": "„Aber was mich an diesem Festivaltag an Lemmy, an seinen weißen Lackstiefeln im Matsch, so bewegte, war viel einfacher und toller als all das — es war seine Würde.“"
                            },
                            {
                                "example_id": "1c98eabe-ef98-45d6-bdb0-57179d4945d0",
                                "sense_id": "68daed0b-e3eb-3bf6-b888-b9b1b110c5f0",
                                "text": "„Niemals hatten solche Lackstiefel im Hausflur geknarrt.“"
                            }
