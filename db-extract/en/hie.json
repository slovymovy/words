                "senses": [
                    {
                        "sense_id": "44532726-119f-39b4-a7dc-7f7b2f3c7640",
                        "entry_id": "6127b832-7239-373c-ad6b-a57544d0ce2c",
                        "glosses": [
                            "To hasten; to go quickly, to hurry."
                        ],
                        "tags": [
                            "intransitive",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "0ead5c7e-1408-475e-bab7-514992cddf4e",
                                "sense_id": "44532726-119f-39b4-a7dc-7f7b2f3c7640",
                                "text": "But after her lover Amyntas hied."
                            },
                            {
                                "example_id": "12956741-8200-4c02-94d1-7f476aab1e47",
                                "sense_id": "44532726-119f-39b4-a7dc-7f7b2f3c7640",
                                "text": "Hath pleased you, and eased you, and sweet slumber seized you. And now to bed I hie."
                            },
                            {
                                "example_id": "bfdd981d-05fd-40eb-ac08-1b7217a75254",
                                "sense_id": "44532726-119f-39b4-a7dc-7f7b2f3c7640",
                                "text": "The youth, returning to his mistress, hies."
                            }
                        ]
                    },
                    {
                        "sense_id": "f08efe07-5680-3406-ad54-daef9568a61f",
                        "entry_id": "6127b832-7239-373c-ad6b-a57544d0ce2c",
                        "glosses": [
                            "To hurry (oneself)."
                        ],
                        "tags": [
                            "poetic",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "dc3df91e-3c4c-4c91-80fa-0deb7263f3e7",
                                "sense_id": "f08efe07-5680-3406-ad54-daef9568a61f",
                                "text": "My husband hies him home."
                            },
                            {
                                "example_id": "bf98f76d-f775-4e49-a9f4-d6a6adb20b51",
                                "sense_id": "f08efe07-5680-3406-ad54-daef9568a61f",
                                "text": "Some have conjectured hastily that all Southerners in town hie themselves to cafés at nightfall."
                            }
                        ]
                    },
                    {
                        "sense_id": "a045bbb4-21ac-32c3-9543-e43ef5d312f3",
                        "entry_id": "6127b832-7239-373c-ad6b-a57544d0ce2c",
                        "glosses": [
                            "To urge (a horse) to the left with a cry of \\\"hie\\\"."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
