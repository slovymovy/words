                    "target_lang_definitions": {
                        "ru": "В бейсболе: попытка принести очко игроку с третьей базы с помощью короткого удара (банта).",
                        "zh": "在棒球中，通过短打使三垒跑垒员得分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сквиз-плей",
                                "target_lang_sense_clarification": "бейсбольный термин"
                            },
                            {
                                "target_lang_word": "выжимать",
                                "target_lang_sense_clarification": "очко в бейсболе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强迫取分",
                                "target_lang_sense_clarification": "棒球术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
