                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capillaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d762af-670a-3e1d-bec9-a608215b409d",
                                        "entry_id": "cf786c57-23a9-3f27-9de4-60b7169816d7",
                                        "glosses": [
                                            "Relatif aux cheveux."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee79ad76-e5ed-445d-9dd8-87fb30aa76fa",
                                                "sense_id": "a0d762af-670a-3e1d-bec9-a608215b409d",
                                                "text": "Si vous aviez passé vos mains dans la chevelure abondante et parfumée d`une Javanaise, vous auriez le plus profond mépris pour ces petits taillis capillaires que les Européennes cachent si facilement sous un bonnet."
                                            },
                                            {
                                                "example_id": "93136fe3-88a8-4176-87a2-1a9c51443c7c",
                                                "sense_id": "a0d762af-670a-3e1d-bec9-a608215b409d",
                                                "text": "Mais lui, il se contentait de vendre des produits capillaires aux salons de France et de Navarre. Et donc, également, dans les DROM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021c1f8b-3a4c-381f-b40a-67281bb8fd53",
                                        "entry_id": "cf786c57-23a9-3f27-9de4-60b7169816d7",
                                        "glosses": [
                                            "Fin comme un cheveu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55bc059-a24f-42ed-b34a-5b030471655c",
                                                "sense_id": "021c1f8b-3a4c-381f-b40a-67281bb8fd53",
                                                "text": "On fabrique actuellement des tubes capillaires en verre excessivement fins. Ceux-ci, étirés par des ouvriers spéciaux, ont d’ordinaire une ouverture de deux dixièmes de millimètre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "135fbced-0f3f-3ff9-b86e-4b61a97cff88",
                                        "entry_id": "cf786c57-23a9-3f27-9de4-60b7169816d7",
                                        "glosses": [
                                            "Relatif aux vaisseaux sanguins capillaires."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1150f573-0870-32d4-81ad-2b83860ffed2",
                                        "entry_id": "cf786c57-23a9-3f27-9de4-60b7169816d7",
                                        "glosses": [
                                            "Se dit des propriétés des sols ou des tubes dans lesquels les liquides ont tendance à monter sous l’effet de la capillarité."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d77ab08-b636-3f30-8f12-c8762d83e354",
                                        "entry_id": "cf786c57-23a9-3f27-9de4-60b7169816d7",
                                        "glosses": [
                                            "Relatif à certains organes très fins des plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba799aa3-f1bd-461b-8211-2551d9072138",
                                                "sense_id": "7d77ab08-b636-3f30-8f12-c8762d83e354",
                                                "text": "Racines capillaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d9be809-0b1d-3549-8299-c6dd4ebc9202",
                                        "entry_id": "cf786c57-23a9-3f27-9de4-60b7169816d7",
                                        "glosses": [
                                            "Relatif aux lignes ferroviaires à faible trafic réservées au fret ou à des trains touristiques."
                                        ],
                                        "tags": [
                                            "Transport terrestre"
                                        ],
                                        "examples": []
