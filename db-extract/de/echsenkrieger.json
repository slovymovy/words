                "senses": [
                    {
                        "sense_id": "2454b7fd-cb84-3485-bd9e-3a3ba0dc97e4",
                        "entry_id": "71264158-b497-335a-b9de-f84a0f609267",
                        "glosses": [
                            "Krieger in Echsengestalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6746d1c-ba3f-4143-b0e9-c226aca5324a",
                                "sense_id": "2454b7fd-cb84-3485-bd9e-3a3ba0dc97e4",
                                "text": "„Echsenkrieger, schrie eine Stimme in dem jungen Krieger, während er spürte, wie ihm eine Gänsehaut über den Rücken strich. Bei allen Göttern – es sind wirklich Echsenkrieger!“"
                            },
                            {
                                "example_id": "af9d80fb-d898-4d7b-b3ca-d84ef58d9e77",
                                "sense_id": "2454b7fd-cb84-3485-bd9e-3a3ba0dc97e4",
                                "text": "„Der Echsenkrieger hielt einen Moment inne und mit einem kräftigen Schwung köpfte er den Magier gezielt.“"
                            },
                            {
                                "example_id": "d43687c3-6076-4814-b6fe-095ff61af490",
                                "sense_id": "2454b7fd-cb84-3485-bd9e-3a3ba0dc97e4",
                                "text": "„Der Echsenkrieger, ein besonders scheußlich anzusehendes Exemplar, aus dessen langem Maul klebriger Geifer troff, kauerte am Rand der Öffnung und starrte der Zauberin hasserfüllt entgegen.“"
                            },
                            {
                                "example_id": "7eead4db-9625-4a7b-8a44-034cb442cdc3",
                                "sense_id": "2454b7fd-cb84-3485-bd9e-3a3ba0dc97e4",
                                "text": "„Rall war von dem durch viele Verletzungen gezeichneten Echsenkrieger nicht beeindruckt.“"
                            },
                            {
                                "example_id": "6af1cacd-66f0-4d14-9100-6e7b95da139d",
                                "sense_id": "2454b7fd-cb84-3485-bd9e-3a3ba0dc97e4",
                                "text": "„Weil Jeriba kein Geschlecht hat, kann er sich vom finster grollenden Echsenkrieger zum spirituellen Lehrer und schließlich zum aufopferungsvollen Muttertier entwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
