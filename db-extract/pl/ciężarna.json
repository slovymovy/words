                        ]
                    },
                    {
                        "translation_id": "bc0dc7d9-40c1-4ba6-b18b-1e5505c9ffff",
                        "source_entry_id": "98746eba-ced1-3d65-b2a5-3f8741cfaaf9",
                        "source_sense_id": "59b190f7-c656-3e77-bdc1-2db2e960da63",
                        "target_lang_word": "Schwangere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwangere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                        "entry_id": "c8b40846-f906-3507-b4cd-20658fa24775",
                                        "glosses": [
                                            "Frau, die schwanger ist, also ein Kind erwartet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a1cb71-d1f1-4955-97e4-0c3ee54f44da",
                                                "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                                "text": "Heute habe ich eine Schwangere im Bus gesehen."
                                            },
                                            {
                                                "example_id": "eaeed96a-184a-4771-ab2a-9a6573e75766",
                                                "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                                "text": "Im Jahr 2008 lautete eine Schlagzeile: „Frau raubt Schwangerer Baby aus dem Bauch“."
                                            },
                                            {
                                                "example_id": "db1a5e99-8650-4743-9d85-c5492f4291e5",
                                                "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                                "text": "„Laut Mutterschaftsrichtlinien soll die Schwangere nicht nur in ausreichendem Maße ärztlich untersucht, sondern auch beraten werden.“"
                                            },
                                            {
                                                "example_id": "47009975-92be-44d2-a8d7-cc5e277743dd",
                                                "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                                "text": "„In der Geburtsvorbereitung soll den Schwangeren über Verhaltensmuster ihre körperlichen Voraussetzungen zum Gebärenkönnen erfahrbar gemacht werden.“"
                                            },
                                            {
                                                "example_id": "fe6938fa-e282-47c8-b40a-066838e60f1f",
                                                "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                                "text": "„Schwangere bekamen hin und wieder mehrere Monate vor ihrer Niederkunft einen abwechselnd stärkern oder schwächern Wasserabgang, der jedoch keinen nachtheiligen Einfluß auf jene äußerte.“"
                                            },
                                            {
                                                "example_id": "ca251877-6351-470a-a2a8-380757009f32",
                                                "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                                "text": "„Eine Schwangere, welche ihre Frucht vorsätzlich abtreibt oder im Mutterleibe tödtet, wird mit Zuchthaus bis zu fünf Jahren bestraft.“"
                                            },
                                            {
                                                "example_id": "404f67e3-6f5f-4375-b7bd-fd41e016319f",
                                                "sense_id": "d9ddaa85-bde0-3182-b684-af02233a4ac6",
                                                "text": "Karl Kraus nannte eines seiner Gedichte „Beim Anblick einer Schwangeren“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
