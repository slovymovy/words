                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "76f17268-3af5-4f46-984e-0913c367692c",
                                "sense_id": "1a34df31-1bde-3e19-abdb-4f64289b44e2",
                                "text": "Désolée, je vais \"défollower\" tout le monde, puis \"refollower\" au fur et à mesure car je m’y perds."
                            },
                            {
                                "example_id": "6de5342b-cdd4-4750-aa55-593d72e1922a",
                                "sense_id": "1a34df31-1bde-3e19-abdb-4f64289b44e2",
                                "text": "Monsieur s’amuse à unfollower et refollower les gens ?"
                            },
                            {
                                "example_id": "21d0771e-c2a4-4ffe-8c58-bbba3ee75fcf",
                                "sense_id": "1a34df31-1bde-3e19-abdb-4f64289b44e2",
                                "text": "Après m’avoir unfollowé, refollowé, re-unfollowé, re-refollowé, re-re-unfollowé… le Zemmour du Patrimoine m’a bloqué"
                            }
                        ]
                    }
