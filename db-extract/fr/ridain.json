                                    {
                                        "sense_id": "a2688e28-30ac-3d8e-a1af-452893e90538",
                                        "entry_id": "1bea9e14-b864-3c59-bc4c-68bb304dcad8",
                                        "glosses": [
                                            "To take a hit, dose or shot of a drug (such as marijuana) or alcohol."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c668019f-fba0-4767-9e82-a26311f3e939",
                                                "sense_id": "a2688e28-30ac-3d8e-a1af-452893e90538",
                                                "text": "He spent the day ripping shots at the bar and ripping blunts at home."
                                            },
                                            {
                                                "example_id": "73657e4e-93a0-4ea1-8ea7-4196d809a63a",
                                                "sense_id": "a2688e28-30ac-3d8e-a1af-452893e90538",
                                                "text": "... ripping shots of cheap liquor is the easiest way to reach intoxication. It is cheaper and less time-consuming than sharing a craft beer with a friend."
                                            },
                                            {
                                                "example_id": "2dfa4933-835d-475b-8306-be21d6aa3a15",
                                                "sense_id": "a2688e28-30ac-3d8e-a1af-452893e90538",
                                                "text": "\"... ripping shots of Jack Daniel's and vomiting in the bathroom.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e2f213-33f8-3437-811d-2a510ff6e884",
