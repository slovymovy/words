                    {
                        "translation_id": "050358e3-4be3-47a4-afcf-f5c5b2329876",
                        "source_entry_id": "fc09b76c-c2b8-3549-aeea-d1b0a76cf467",
                        "source_sense_description": "moving in two directions (usually opposite)",
                        "target_lang_word": "bidirektional",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bidirektional",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4a3df2-cdb3-31dd-9ec2-95fe4dd3ffc8",
                                        "entry_id": "b0193716-03d8-3327-b7d8-15a2a2a1e441",
                                        "glosses": [
                                            "zur Signalübertragung in beiden Richtungen geeignet"
                                        ],
                                        "tags": [
                                            "Telekommunikation",
                                            "von Datenübertragungsleitungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93bdcc23-df59-450a-97af-4c4d39ebc9ac",
                                                "sense_id": "3e4a3df2-cdb3-31dd-9ec2-95fe4dd3ffc8",
                                                "text": "In einem bidirektionalen Ring, der mehrere Netzknoten verbindet, wird der Datenverkehr im Regelfall so gerichtet, dass beide Richtungen einer bidirektionalen Verbindung dieselben Netzknoten entgegengesetzt durchqueren."
                                            },
                                            {
                                                "example_id": "6479fcf5-14b0-4ca1-a395-759a1c71cafe",
                                                "sense_id": "3e4a3df2-cdb3-31dd-9ec2-95fe4dd3ffc8",
                                                "text": "Voraussetzung für die automatische Erkennung eines Druckers an einer Parallelschnittstelle ist eine bidirektionale Datenübertragung zum Drucker."
                                            },
                                            {
                                                "example_id": "ef138a53-9689-4957-b852-49ddf9e28852",
                                                "sense_id": "3e4a3df2-cdb3-31dd-9ec2-95fe4dd3ffc8",
                                                "text": "Der Kanal für Fernsprechen bzw. ISDN ist im Basisband bidirektional mit gleichen Geschwindigkeiten ausgelegt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a1d99d6-eabd-3ca4-9b80-2805bb3a6245",
                                        "entry_id": "b0193716-03d8-3327-b7d8-15a2a2a1e441",
                                        "glosses": [
                                            "in zwei Richtungen (meist wechselseitig) wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0732339-bf52-411e-a5b9-643b6a95b62f",
                                                "sense_id": "6a1d99d6-eabd-3ca4-9b80-2805bb3a6245",
                                                "text": "Bei einer bidirektionalen Assoziation können die entsprechenden Objektbeziehungen in beiden Richtungen durchlaufen werden."
                                            },
                                            {
                                                "example_id": "fde88314-28e2-447b-82da-3e2c3ac85298",
                                                "sense_id": "6a1d99d6-eabd-3ca4-9b80-2805bb3a6245",
                                                "text": "Wie die Reißverschlussschieber beim Koffer arbeiten die Helikasen in die entgegengesetzte Richtung (bidirektionale Replikation des Bakterienchromosoms), um dann an einem definierten Punkt aufeinander zu treffen (Terminationspunkt)."
                                            },
                                            {
                                                "example_id": "86e74ff7-5d91-438d-a7cc-871939ecc85c",
                                                "sense_id": "6a1d99d6-eabd-3ca4-9b80-2805bb3a6245",
                                                "text": "Das bidirektionale Prinzip ist das am häufigsten vertretene Prinzip in der Natur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
