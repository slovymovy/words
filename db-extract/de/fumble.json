                        "cross_references": [
                            {
                                "target_word": "fumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52dba394-29b9-3ef8-9b91-6ce158d3809d",
                                        "entry_id": "a54168c7-d0a3-3486-a36a-940fcf06c34e",
                                        "glosses": [
                                            "To handle nervously or awkwardly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e815c73-552c-4649-a5ce-da04069cdde5",
                                                "sense_id": "52dba394-29b9-3ef8-9b91-6ce158d3809d",
                                                "text": "Waiting for the interview, he fumbled with his tie."
                                            },
                                            {
                                                "example_id": "5f7df2b2-54cf-4ebe-9fd7-c483afc8b90b",
                                                "sense_id": "52dba394-29b9-3ef8-9b91-6ce158d3809d",
                                                "text": "He fumbled the key into the lock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34408413-4d89-35d7-bf52-429982673952",
                                        "entry_id": "a54168c7-d0a3-3486-a36a-940fcf06c34e",
                                        "glosses": [
                                            "To grope awkwardly in trying to find something"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b31fcd6-2fc7-4c4c-bc57-980bc296647e",
                                                "sense_id": "34408413-4d89-35d7-bf52-429982673952",
                                                "text": "He fumbled for his keys."
                                            },
                                            {
                                                "example_id": "ab5b0c87-8380-4ae9-8aeb-885e7822ed0e",
                                                "sense_id": "34408413-4d89-35d7-bf52-429982673952",
                                                "text": "He fumbled his way to the light-switch."
                                            },
                                            {
                                                "example_id": "4d69b7f9-5654-4668-979b-76c3bbef974a",
                                                "sense_id": "34408413-4d89-35d7-bf52-429982673952",
                                                "text": "Adams novv began to fumble in his Pockets, and ſoon cried out, O la! I have it [a sermon] not about me— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98bf9e3a-bbd5-3a90-9f0f-96a7a7e3648a",
                                        "entry_id": "a54168c7-d0a3-3486-a36a-940fcf06c34e",
                                        "glosses": [
                                            "To blunder uncertainly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4c24bc1-f953-492f-ab18-91d33c2695f6",
                                                "sense_id": "98bf9e3a-bbd5-3a90-9f0f-96a7a7e3648a",
                                                "text": "He fumbled through his prepared speech."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea6ac6d-37f6-3e14-b104-972bb6431c8a",
                                        "entry_id": "a54168c7-d0a3-3486-a36a-940fcf06c34e",
                                        "glosses": [
                                            "To grope about in perplexity; to seek awkwardly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09b3f5cb-805b-4f22-88d8-26cb84fb74b6",
                                                "sense_id": "dea6ac6d-37f6-3e14-b104-972bb6431c8a",
                                                "text": "to fumble for an excuse"
                                            },
                                            {
                                                "example_id": "8e98f4dc-7250-4865-9dee-80965b85ddde",
                                                "sense_id": "dea6ac6d-37f6-3e14-b104-972bb6431c8a",
                                                "text": "My understanding stutters, and my memory fumbles."
                                            },
                                            {
                                                "example_id": "86149a39-e187-4580-bd7a-61cd559b8231",
                                                "sense_id": "dea6ac6d-37f6-3e14-b104-972bb6431c8a",
                                                "text": "Alas! how he fumbles about the domains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d8ec5e-ad90-3a35-961a-146cf6c9d760",
                                        "entry_id": "a54168c7-d0a3-3486-a36a-940fcf06c34e",
                                        "glosses": [
                                            "To drop a ball or a baton etc. by accident."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798185a5-cb9a-48ec-9db7-599cbd0e9e95",
                                                "sense_id": "90d8ec5e-ad90-3a35-961a-146cf6c9d760",
                                                "text": "Henderson's best strike on goal saw goalkeeper Kingson uncomfortably fumble his measured shot around the post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a395a09-368a-32e3-b841-739d7b0dd380",
                                        "entry_id": "a54168c7-d0a3-3486-a36a-940fcf06c34e",
                                        "glosses": [
                                            "To handle much; to play childishly; to turn over and over."
                                        ],
