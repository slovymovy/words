                        "examples": [
                            {
                                "example_id": "c643d344-0007-46d2-8d36-edb995accc27",
                                "sense_id": "76cdb7bd-43b0-32e9-ad98-c090f33d46fb",
                                "text": "1976 April 26, Sally Beauman, Henry Reconsidered—Royal and Shakespearean in New York (magazine),\nBut how will American audiences respond to the play? Will they find it too jingoistically English, too warmongering, or will they find it as complex and perturbing a work as the company believes it to be?"
                            },
                            {
                                "example_id": "b121fa03-2159-494a-82b6-b5aeb3050280",
                                "sense_id": "76cdb7bd-43b0-32e9-ad98-c090f33d46fb",
                                "text": "Vienna's other important liberal daily, Die Zeit, also supported the invasion of Serbia, although less jingoistically and in a more restrained tone than either the Neue Freie Presse or the Neues Wiener Tagblatt."
                            },
                            {
                                "example_id": "692ccf94-6cc3-48b1-8bcb-170cae9aa425",
                                "sense_id": "76cdb7bd-43b0-32e9-ad98-c090f33d46fb",
                                "text": "Published in 1919, this anthology was jingoistically titled The Great Tradition: Selections from English and American Prose and Poetry."
                            }
                        ]
                    }
