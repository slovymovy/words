                ],
                "senses": [
                    {
                        "sense_id": "e159e122-bb65-3c24-909f-727909ffa67f",
                        "entry_id": "2a674e98-faff-307a-9771-64b4411d9529",
                        "glosses": [
                            "Schriftsteller, der Stücke für das Theater verfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a479febd-755d-4f70-ba90-b6a57264f816",
                                "sense_id": "e159e122-bb65-3c24-909f-727909ffa67f",
                                "text": "„Am 20. Januar 1772 wurde de Sades erstes Schauspiel hier aufgeführt, und wenn es auch noch geraume Zeit dauern sollte, bevor die Comédie-Française ein Stück von ihm herausbrachte, hielt er sich seit 1772 für einen großen Bühnenautor und hat sich auch die erdenklichste Mühe gegeben, als solcher Anerkennung bei seinen Zeitgenossen zu finden.“"
                            },
                            {
                                "example_id": "51d98ffd-7a37-4bab-a92e-353325786ad2",
                                "sense_id": "e159e122-bb65-3c24-909f-727909ffa67f",
                                "text": "„Denn abgesehen von einer Handvoll Unterschriften haben wir an substanziellen Urschriften Shakespeares lediglich drei verschmierte Seiten eines Theaterstücks, das er gemeinsam mit fünf weiteren Bühnenautoren verfasst hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
