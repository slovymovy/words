                    {
                        "sense_id": "9a7cbb8d-83dd-3787-8a26-f4f1c02e6370",
                        "entry_id": "58c0cf49-6d83-3e47-b4f0-9f376fa5ef19",
                        "glosses": [
                            "Having the same spatial limits or boundaries; sharing the same area."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8f5e7e63-9406-47c7-a3d1-04b3f218f415",
                                "sense_id": "9a7cbb8d-83dd-3787-8a26-f4f1c02e6370",
                                "text": "The city and county of San Francisco are coextensive."
                            },
                            {
                                "example_id": "54aef08f-df6f-4188-b590-655b1d1e3974",
                                "sense_id": "9a7cbb8d-83dd-3787-8a26-f4f1c02e6370",
                                "text": "And then there are the catch-all provisions: rules that allow police to stop drivers for conduct that complies with all the rules on the books, but that officers consider \"imprudent\" or \"unreasonable\" under the circumstances, or that describe the offense in language so broad as to make a vioation virtually coextensive with the officer's unreviewable personal judgment."
                            }
                        ]
                    },
                    {
                        "sense_id": "0afd2074-278f-35a0-a915-2dc2db6ce265",
                        "entry_id": "58c0cf49-6d83-3e47-b4f0-9f376fa5ef19",
                        "glosses": [
                            "Occurring over the same period of time; contemporaneous."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2792d478-530a-4aa0-bce3-c35330f6abad",
                                "sense_id": "0afd2074-278f-35a0-a915-2dc2db6ce265",
                                "text": "His life is almost co-extensive with one of the most disastrous periods in Roman history."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aeef53c-5057-3ffb-9aa2-99b6c5d5b948",
                        "entry_id": "58c0cf49-6d83-3e47-b4f0-9f376fa5ef19",
                        "glosses": [
                            "Having the same extension—the object or set of objects to which a term refers."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "05b73d4c-5567-4f37-aca3-3d6df3c09001",
                                "sense_id": "7aeef53c-5057-3ffb-9aa2-99b6c5d5b948",
                                "text": "Coextensive expressions with different intensions cannot in general be substituted for one another within an expression e while preserving the extension of e (assuming that the extension of a declarative sentence is its truth value)."
                            }
                        ]
                    }
