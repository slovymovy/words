                "senses": [
                    {
                        "sense_id": "4ae441fc-5ea8-3572-8576-882581d47f91",
                        "entry_id": "22d34f58-6532-3140-9f56-8698838b2d00",
                        "glosses": [
                            "biały o odcieniu zielonym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b858c8-cb4a-48a7-a5f7-acfa12d27d7e",
                                "sense_id": "4ae441fc-5ea8-3572-8576-882581d47f91",
                                "text": "Jest basen i firmowe parasole zielonobiałe, trawniki gładko wystrzyżone, pieczołowicie nawadniane"
                            },
                            {
                                "example_id": "d91548c6-77de-4395-8088-6a6b25251733",
                                "sense_id": "4ae441fc-5ea8-3572-8576-882581d47f91",
                                "text": "Miąższ jest zielonobiały lub żółtobiały i ma przyjemny, delikatny, lekko słodki smak, podobny do orzechów włoskich"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
