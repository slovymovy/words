        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9ca78f45-8c72-3292-ae26-a2d4ebabbd4d",
                    "sense_definition": "drückt eine energische oder abwehrende Verneinung einer vorausgehenden Äußerung aus",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Glaubst du wirklich, dass sie böse auf mich ist? Ach <w>wo</w>, das bildest du dir nur ein!"
                        },
                        {
                            "text": "Hast du etwa Angst vor dieser schweren Prüfung? I <w>wo</w>, ich bin bestens vorbereitet."
                        }
                    ],
                    "synonyms": [
