{
    "word_family": [
        "beastly",
        "beastliness",
        "beastlike",
        "beastmaster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "157165e5-0a5c-31d9-9bda-126967131e55",
                    "sense_definition": "A large or dangerous animal, especially a land vertebrate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters tracked the <w>beast</w> through the thick forest for several days.",
                            "target_lang_translations": {
                                "ru": "Охотники выслеживали <w>зверя</w> в густом лесу в течение нескольких дней."
                            }
                        },
                        {
                            "text": "In the story, a wild <w>beast</w> guarded the entrance to the dark cave.",
                            "target_lang_translations": {
                                "ru": "В сказке дикий <w>зверь</w> охранял вход в темную пещеру."
                            }
                        }
                    ],
                    "synonyms": [
                        "monster"
                    ],
                    "common_phrases": [
                        "wild beast",
                        "savage beast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное или опасное животное, особенно наземное позвоночное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "дикое животное"
                            },
                            {
                                "target_lang_word": "животное",
                                "target_lang_sense_clarification": "общее обозначение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f31a3ff-b094-39fc-a0c9-c81e92871cef",
                    "sense_definition": "All non-human animals considered as a group, often in contrast to humans.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers often discuss the qualities that distinguish man from <w>beast</w>.",
                            "target_lang_translations": {
                                "ru": "Философы часто обсуждают качества, которые отличают человека от <w>животного</w>."
                            }
                        },
                        {
                            "text": "The law of the jungle applies to every <w>beast</w> in the wild.",
                            "target_lang_translations": {
                                "ru": "Закон джунглей распространяется на каждого <w>зверя</w> в дикой природе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "man and beast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Все животные как группа, часто в противопоставлении человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "в противопоставлении человеку"
                            },
                            {
                                "target_lang_word": "животное",
                                "target_lang_sense_clarification": "представитель фауны"
                            },
                            {
                                "target_lang_word": "тварь",
                                "target_lang_sense_clarification": "живое существо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81026c55-772d-3a88-a6df-5a6ca21f8b61",
                    "sense_definition": "A person who acts in a cruel, violent, or uncivilized way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator was described as a <w>beast</w> for his treatment of the prisoners.",
                            "target_lang_translations": {
                                "ru": "Диктатора называли <w>чудовищем</w> за его обращение с заключенными."
                            }
                        },
                        {
                            "text": "How could anyone be such a <w>beast</w> to an innocent child?",
                            "target_lang_translations": {
                                "ru": "Как можно быть таким <w>зверем</w> по отношению к невинному ребенку?"
                            }
                        }
                    ],
                    "synonyms": [
                        "monster"
                    ],
                    "common_phrases": [
                        "absolute beast",
                        "cruel beast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя жестоко, агрессивно или нецивилизованно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "жестокий человек"
                            },
                            {
                                "target_lang_word": "чудовище",
                                "target_lang_sense_clarification": "моральный урод"
                            },
                            {
                                "target_lang_word": "монстр",
                                "target_lang_sense_clarification": "крайне жестокий человек"
                            },
                            {
                                "target_lang_word": "скотина",
                                "target_lang_sense_clarification": "грубый, подлый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1cff358-d058-3b18-a6df-423214743f4d",
                    "sense_definition": "Something that is exceptionally large, powerful, or impressive of its kind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "thing_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new truck is a <w>beast</w> of a machine with incredible towing capacity.",
                            "target_lang_translations": {
                                "ru": "Этот новый грузовик — просто <w>зверь</w>, а не машина, с невероятной тяговой мощностью."
                            }
                        },
                        {
                            "text": "The stadium is a <w>beast</w> of a building that dominates the city skyline.",
                            "target_lang_translations": {
                                "ru": "Стадион — это огромная <w>махина</w>, возвышающаяся над горизонтом города."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beast of a"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize size or power"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то исключительно большое, мощное или впечатляющее в своем роде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "о мощной технике"
                            },
                            {
                                "target_lang_word": "монстр",
                                "target_lang_sense_clarification": "о чем-то огромном"
                            },
                            {
                                "target_lang_word": "махина",
                                "target_lang_sense_clarification": "о крупном объекте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d742f96c-e6f4-3f1e-8ddf-8e7e195cdd0c",
                    "sense_definition": "A thing or matter that is difficult, unruly, or distinct in nature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thing_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Managing a global corporation is an entirely different <w>beast</w> compared to a small shop.",
                            "target_lang_translations": {
                                "ru": "Управление глобальной корпорацией — это совсем другая <w>штука</w> по сравнению с маленьким магазином."
                            }
                        },
                        {
                            "text": "The new tax law is a strange <w>beast</w> that few experts fully understand.",
                            "target_lang_translations": {
                                "ru": "Новый налоговый закон — странная <w>материя</w>, которую мало кто из экспертов понимает до конца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "different beast",
                        "strange beast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещь или вопрос, который является сложным, неуправляемым или имеет иную природу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штука",
                                "target_lang_sense_clarification": "нечто иного рода"
                            },
                            {
                                "target_lang_word": "материя",
                                "target_lang_sense_clarification": "сложный вопрос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1f82993-b27d-3c3d-b367-4c5a528d3869",
                    "sense_definition": "Something that is very unpleasant or difficult to deal with.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thing_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final exam was a <w>beast</w> of a problem that took three hours.",
                            "target_lang_translations": {
                                "ru": "Финальный экзамен был <w>кошмарной</w> задачей, на которую ушло три часа."
                            }
                        },
                        {
                            "text": "I woke up this morning with a <w>beast</w> of a headache.",
                            "target_lang_translations": {
                                "ru": "Я проснулся сегодня утром с <w>жуткой</w> головной болью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beast of a problem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used for difficult tasks or sensations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то очень неприятное или трудное, с чем приходится иметь дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошмар",
                                "target_lang_sense_clarification": "очень трудная задача"
                            },
                            {
                                "target_lang_word": "жуть",
                                "target_lang_sense_clarification": "неприятное ощущение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a546446c-68d7-3fcc-b5a8-9589016c5f23",
                    "sense_definition": "A figure in the Book of Revelation, often identified with Satan or the Antichrist.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_figure",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "The preacher spoke about the mark of the <w>Beast</w> mentioned in the scriptures.",
                            "target_lang_translations": {
                                "ru": "Проповедник говорил о начертании <w>Зверя</w>, упомянутом в Писании."
                            }
                        },
                        {
                            "text": "In many interpretations, the <w>Beast</w> represents the ultimate force of evil.",
                            "target_lang_translations": {
                                "ru": "Во многих толкованиях <w>Зверь</w> олицетворяет высшую силу зла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mark of the beast",
                        "number of the beast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фигура из Книги Откровения, часто отождествляемая с Сатаной или Антихристом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Зверь",
                                "target_lang_sense_clarification": "библейский персонаж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ced1ae72-930f-3764-affa-ca94392910dd",
                    "sense_definition": "The basic training program for new cadets at the West Point military academy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_training",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "New students must survive the <w>Beast</w> before they can begin their regular classes.",
                            "target_lang_translations": {
                                "ru": "Новые студенты должны пережить <w>«Зверя»</w>, прежде чем смогут приступить к обычным занятиям."
                            }
                        },
                        {
                            "text": "He felt much more confident after completing the rigorous weeks of the <w>Beast</w>.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя гораздо увереннее после завершения суровых недель <w>«Зверя»</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beast barracks"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US military context"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "military academy jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Программа базовой подготовки новых кадетов в военной академии Вест-Пойнт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«Зверь»",
                                "target_lang_sense_clarification": "курс молодого бойца"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d3768658-3e71-3a20-a1bc-43c93b55839c",
                    "sense_definition": "Excellent, powerful, or very impressive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine in that sports car is totally <w>beast</w>.",
                            "target_lang_translations": {
                                "ru": "Двигатель в этой спортивной машине просто <w>зверский</w>."
                            }
                        },
                        {
                            "text": "His performance during the championship game was <w>beast</w>.",
                            "target_lang_translations": {
                                "ru": "Его игра во время чемпионата была просто <w>мощной</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "totally beast"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used by younger speakers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходный, мощный или очень впечатляющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверский",
                                "target_lang_sense_clarification": "очень мощный"
                            },
                            {
                                "target_lang_word": "мощный",
                                "target_lang_sense_clarification": "впечатляющий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84304d12-b100-3b2f-a3c4-2a6a9a8becbd",
                    "sense_definition": "To force someone to perform very difficult physical exercises as training or punishment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drill sergeant would <w>beast</w> the recruits until they could barely stand.",
                            "target_lang_translations": {
                                "ru": "Сержант по строевой подготовке <w>гонял</w> новобранцев до тех пор, пока они едва могли стоять."
                            }
                        },
                        {
                            "text": "They were <w>beasted</w> for an hour because one person forgot their gear.",
                            "target_lang_translations": {
                                "ru": "Их <w>муштровали</w> целый час из-за того, что один человек забыл свое снаряжение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British military origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо выполнять очень сложные физические упражнения в качестве тренировки или наказания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гонять",
                                "target_lang_sense_clarification": "изнурять упражнениями"
                            },
                            {
                                "target_lang_word": "муштровать",
                                "target_lang_sense_clarification": "жестко тренировать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}