                "senses": [
                    {
                        "sense_id": "74d82e88-7823-3d64-8dbe-003aa986566b",
                        "entry_id": "3b47ff4d-4f94-3a11-be57-1ce1825bb8cf",
                        "glosses": [
                            "A person in Suriname thought to be a clairvoyant or a sorcerer."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b574a57a-4a35-46bb-89d8-9006e0a39634",
                                "sense_id": "74d82e88-7823-3d64-8dbe-003aa986566b",
                                "text": "Locomen, prophets who claim clairvoyance, tossed animal bones from magical gourds, reading the scattered patterns to gain a glimpse into tomorrow."
                            },
                            {
                                "example_id": "c1783f2f-e358-4615-803d-085d811aa7bb",
                                "sense_id": "74d82e88-7823-3d64-8dbe-003aa986566b",
                                "text": "John Gabriel Stedman described Quacy as a locoman, diviner, and sorcerer (rather than an obeah man) who made and sold 'oias or amulets' that made their wearers 'invulnerable'."
                            }
                        ]
                    }
