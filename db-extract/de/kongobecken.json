                ],
                "senses": [
                    {
                        "sense_id": "7dc30d4f-359f-30cd-ba41-5a0e5925ad05",
                        "entry_id": "d30811d7-b813-337e-9f43-83cac28823d7",
                        "glosses": [
                            "Großlandschaft in Zentralafrika, die das Einzugsgebiet des Kongo-Flusses umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7832b0b4-0c64-46c5-9707-5a84bdbb6ae1",
                                "sense_id": "7dc30d4f-359f-30cd-ba41-5a0e5925ad05",
                                "text": "„Als Stanley und seine Offiziere fertig waren, flatterte die blaue Fahne mit dem goldenen Stern, wenn man Stanley glauben darf, über den Dörfern und Territorien von mehr als 450 Häuptlingen im Kongobecken.“"
                            },
                            {
                                "example_id": "d302a80b-5a1b-4f90-81ab-a1e7357bbfa9",
                                "sense_id": "7dc30d4f-359f-30cd-ba41-5a0e5925ad05",
                                "text": "„Das Kongobecken ist ein gewaltiges Territorium, weitaus größer als Spanien, Frankreich und Deutschland zusammen.“"
                            },
                            {
                                "example_id": "4a097d37-1891-4e5d-96dd-4ca090bb664b",
                                "sense_id": "7dc30d4f-359f-30cd-ba41-5a0e5925ad05",
                                "text": "„Seine Frau, so schloß er, die passioniert für Nilquellen und Kongobecken sei, freue sich ungemein, einen so weitgereisten Herrn kennenzulernen, und wenn es Afrika nicht sein könne, so werde sie sich auch mit Persien und Indien zufriedengeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
