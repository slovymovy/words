    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ba659a8-23aa-3605-90bc-7e085347b501",
                    "sense_definition": "present participle and gerund of <w>insist</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She kept <w>insisting</w> that we should leave early for the airport.",
                            "target_lang_translations": {
                                "nl": "Ze bleef er maar op <w>aandringen</w> dat we vroeg naar het vliegveld zouden vertrekken."
                            }
                        },
                        {
                            "text": "He is <w>insisting</w> on paying for everyone's dinner tonight.",
                            "target_lang_translations": {
                                "nl": "Hij <w>dringt erop aan</w> om vanavond voor ieders diner te betalen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep insisting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het volharden bij een standpunt of verzoek, of het dwingend eisen van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aandringen",
                                "target_lang_sense_clarification": "het herhaaldelijk of krachtig verzoeken om iets"
                            },
                            {
                                "target_lang_word": "volharden",
                                "target_lang_sense_clarification": "vasthouden aan een standpunt of mening"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "446df2e3-6e7e-31f9-9c8d-2e3085fb3b62",
                    "sense_definition": "demanding something firmly and refusing to accept refusal",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>insisting</w> customer demanded to speak with the store manager immediately.",
                            "target_lang_translations": {
                                "nl": "De <w>aandringende</w> klant eiste om direct met de winkelmanager te spreken."
                            }
                        },
                        {
                            "text": "Her <w>insisting</w> tone made it clear that she would not change her mind.",
                            "target_lang_translations": {
                                "nl": "Haar <w>dwingende</w> toon maakte duidelijk dat ze niet van gedachten zou veranderen."
                            }
                        }
                    ],
                    "synonyms": [
                        "insistant"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die vastberaden is en geen nee accepteert bij het eisen van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dwingend",
                                "target_lang_sense_clarification": "een toon of houding die geen tegenspraak duldt"
                            },
                            {
                                "target_lang_word": "aandringend",
                                "target_lang_sense_clarification": "iemand die niet opgeeft bij het vragen om iets"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}