                        ],
                        "form": "eufemismetjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc0198e4-55f4-397c-bff3-9b902780e42b",
                        "entry_id": "a75a976e-f1d0-33f6-ab74-21013195e746",
                        "glosses": [
                            "het gebruik van een alternatief woord of alternatieve uitdrukking voor iets in de taboesfeer om een sterkere variant, die te grof of vulgair zou overkomen, te vervangen door een minder confronterende bewoording voor hetzelfde"
                        ],
                        "tags": [
                            "stijlfiguur"
                        ],
                        "examples": [
                            {
                                "example_id": "d7aa1faf-1a77-42fb-a3cb-143433e506c1",
                                "sense_id": "bc0198e4-55f4-397c-bff3-9b902780e42b",
                                "text": "'Heengaan' is een eufemisme voor sterven."
                            },
                            {
                                "example_id": "45a23719-b3d5-4739-9004-e484f817bb59",
                                "sense_id": "bc0198e4-55f4-397c-bff3-9b902780e42b",
                                "text": "En ze had alles contant betaald omdat een deftige familie geen schulden maakte en iets op afbetaling kopen was een eufemisme voor precies hetzelfde."
                            }
                        ]
                    },
                    {
                        "sense_id": "663e9aa7-22c3-3983-9cf4-1d2c9b65e2b2",
                        "entry_id": "a75a976e-f1d0-33f6-ab74-21013195e746",
                        "glosses": [
                            "het woord of de uitdrukking die op de bij [1] beschreven manier gebezigd wordt"
                        ],
                        "tags": [
                            "stijlfiguur"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef9c10e6-ec3b-4754-982b-e2b942b43b7d",
                        "source_entry_id": "a75a976e-f1d0-33f6-ab74-21013195e746",
                        "source_sense_description": "1-2.",
                        "target_lang_word": "Euphemismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euphemismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5dd88452-ff82-38b7-903e-f8731c6767cd",
                                        "entry_id": "14d5b542-d534-38f1-ac44-c593a21e838c",
                                        "glosses": [
                                            "sprachlicher Ausdruck, der einen Sachverhalt beschönigend, mildernd oder in verschleiernder Absicht darstellt bzw. benennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739e4e21-4fd1-4a49-88a1-b2c65fecd434",
                                                "sense_id": "5dd88452-ff82-38b7-903e-f8731c6767cd",
                                                "text": "Euphemismen sind z.B. „Kollateralschaden“ für \"unbeabsichtigte Zivilopfer einer Kriegshandlung\" und „freisetzen“ für \"entlassen\"."
                                            },
                                            {
                                                "example_id": "676cf4c4-303c-4d7f-b5df-b115c0158c81",
                                                "sense_id": "5dd88452-ff82-38b7-903e-f8731c6767cd",
                                                "text": "„Euphemismen sind Wörter, die unliebsame Sachverhalte mit angenehmen Assoziationen versehen.“"
                                            },
                                            {
                                                "example_id": "9477ebb7-86cf-4b96-b371-912663bb8ca2",
                                                "sense_id": "5dd88452-ff82-38b7-903e-f8731c6767cd",
                                                "text": "„Die Beispiele aus dem Tierreich führen uns in das Themenfeld jeder sprachlichen Erscheinungen, die unseren Alltag in vielfältiger Weise bestimmen: der sprachlichen ‚Tabus‘ und Euphemismen.“"
                                            },
                                            {
                                                "example_id": "3783f7cd-cc86-4d48-930e-e696bae6ff4d",
                                                "sense_id": "5dd88452-ff82-38b7-903e-f8731c6767cd",
                                                "text": "„Im Mittelalter zeugen Euphemismen, Hüllwörter, davon, daß man sich scheute, Dinge beim Namen zu nennen, um nicht von ihnen gestraft zu werden.“"
                                            },
                                            {
                                                "example_id": "6ae54327-cd8f-43a3-b3d5-cffdadc007e1",
                                                "sense_id": "5dd88452-ff82-38b7-903e-f8731c6767cd",
                                                "text": "„Zunächst ist eine Bedeutungsverschlechterung (…) vom neutralen (fachsprachlichen) Gebrauch zu einem abgelehnten, aber dennoch als Euphemismus verwendeten Ausdruck feststellbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb8027ae-c80e-4ad0-8e07-ccb0681fa98e",
                        "source_entry_id": "a75a976e-f1d0-33f6-ab74-21013195e746",
                        "source_sense_description": "1-2.",
                        "target_lang_word": "euphemism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphemism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df200307-86e1-3fd5-9175-dcdbe39ca59f",
                                        "entry_id": "7f6dcf53-fb6f-3c37-a063-4051392879d7",
                                        "glosses": [
                                            "The use of a word or phrase to replace another one that is more offensive, blunt or vulgar."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d879e0-18e3-4940-a41d-58c416748926",
                                                "sense_id": "df200307-86e1-3fd5-9175-dcdbe39ca59f",
                                                "text": "Akin to it [litotes] is euphemism, which may be applied to the same purpose."
                                            },
                                            {
                                                "example_id": "cb56c004-6a0f-43ec-93a1-fc3346409322",
                                                "sense_id": "df200307-86e1-3fd5-9175-dcdbe39ca59f",
                                                "text": "In 1946, George Orwell addressed the relationship of language to reality and suggested that euphemism, not imperfect analogy, was the real danger. If we don’t use shocking language to describe a shocking circumstance, can we truly recognize what is happening?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "232ff7fa-7d58-380a-ab0c-1e43d994eb67",
                                        "entry_id": "7f6dcf53-fb6f-3c37-a063-4051392879d7",
                                        "glosses": [
                                            "A word or phrase that replaces another in this way."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a26bb98-8af9-4061-a803-300cbb4127b3",
                                                "sense_id": "232ff7fa-7d58-380a-ab0c-1e43d994eb67",
                                                "text": "When it is said of the martyr St. Stephen, that “he fell asleep,” instead of—he died, the euphemism partakes of the nature of metaphor, intimating a resemblance between sleep and the death of such a person."
                                            },
                                            {
                                                "example_id": "f155cf03-9b55-4deb-8345-7a5242028868",
                                                "sense_id": "232ff7fa-7d58-380a-ab0c-1e43d994eb67",
                                                "text": "Euphemistic language turns up in many areas of American life in a variety of situations. Not all euphemisms are alike, but they have one thing in common: They obscure meaning rather than enhance it; they shade the truth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddaf8949-84da-438b-95e6-e1ed8fc481e8",
                        "source_entry_id": "a75a976e-f1d0-33f6-ab74-21013195e746",
                        "source_sense_description": "1-2.",
                        "target_lang_word": "euphémisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphémisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                        "entry_id": "4acb9c2a-3fd0-3172-9e8a-7d90f89516f3",
                                        "glosses": [
                                            "Formulation plus douce d'une réalité désagréable ou choquante dans le but de l'atténuer."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31ebc5b6-1761-4595-85f5-7d3490b47ca1",
                                                "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                                "text": "‘S veschtami po gorodou !… »\nJ’avais appris au cours de mon dîner avec l’hôtelier, le sens de cette phrase fatidique : « Vos affaires pour aller en ville ! » C’est l’horrible euphémisme qu’on adresse aux condamnés qui vont être exécutés."
                                            },
                                            {
                                                "example_id": "1553fe2b-c6ba-4fd0-8055-11eb75febe4b",
                                                "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                                "text": "Très à son aise, en bras de chemise, Peloteux flirtait avec une jeune bergère dont le troupeau paissait non loin de là, inconscient des turpitudes de sa maîtresse.\nQuand je dis que Peloteux flirtait, je prie le lecteur de ne voir dans ce terme qu’un euphémisme dû à mon extrême réserve, car si le prince de Galles flirtait de la sorte avec lady Namitt dans les salons de Windsor, je vois d’ici la tête de l’impératrice des Indes."
                                            },
                                            {
                                                "example_id": "d876c301-9adb-4a13-acb6-5a02ef7d3fab",
                                                "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                                "text": "Au qualificatif un peu cru de « trav », ils cherchent à substituer un euphémisme qui leur paraisse plus aimable et parlent d’éonisme. À cause du chevalier d’Éon."
                                            },
                                            {
                                                "example_id": "51e1bc8f-e2d1-4157-966d-8731e497176d",
                                                "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                                "text": "Ils avaient d'ailleurs le don de jeter un voile pudique sur les réalités qui les gênaient. La tuberculose, cette maladie de pauvres, n'était qu'une mauvaise pleurésie (mais en est-il de bonnes?); un avortement, une petite intervention chirurgicale; la fugue d'une jeune fille, quelques jours de repos à la campagne, une faillite, de mauvaises affaires; une maladie mentale, une légère dépression due au surmenage. Un moribond allait tout doucement ou, pis encore, tout doucettement… Mais tu m'avais de bonne heure appris à traduire en clair ces hypocrites euphémismes."
                                            },
                                            {
                                                "example_id": "28276a2e-c83b-4283-b27a-381cbec77b2d",
                                                "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                                "text": "Son quotidien n'est pas facile, c'est un euphémisme. « J'ai les genoux en compote, je marche avec un déambulateur. En plus, j'ai de l'arthrose. »"
                                            },
                                            {
                                                "example_id": "c7cc95cf-1646-45bb-85ed-d0d5bcc50ce3",
                                                "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                                "text": "L'euphémisme sans doute le plus connu est celui de « solution finale » pour désigner une extermination de masse."
                                            },
                                            {
                                                "example_id": "337a7d10-d444-4472-875f-6b865ecbc4ab",
                                                "sense_id": "9892e6a9-39cf-3be1-8cba-4d6b832933d5",
                                                "text": "Quant à moi (la petite Eléna), ma mère m’avait envoyée vivre chez les Chèvreloup, à partir de Noël 1994, le temps que les « ennuis » de mon père prennent fin (c’était l’euphémisme pour « mise en examen »)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04521cdd-e3ad-4647-8a2a-424c70bc0219",
                        "source_entry_id": "a75a976e-f1d0-33f6-ab74-21013195e746",
