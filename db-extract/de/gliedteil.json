                    {
                        "sense_id": "4961e018-f1f0-3079-9cbd-11ea099a40fc",
                        "entry_id": "0f2fa2e2-4792-351d-83c7-eb8938712b02",
                        "glosses": [
                            "ein weglassbarer Teil eines Satzgliedes"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "7fb62f13-1ee5-41cb-b584-242e9a7a4ee6",
                                "sense_id": "4961e018-f1f0-3079-9cbd-11ea099a40fc",
                                "text": "In dem Satzglied: \"Das Haus meines Vaters\" ist \"meines Vaters\" ein Gliedteil. \"Das Haus meines Vaters\" ist insgesamt ein Satzglied (ein nominales Satzglied) und \"meines Vaters\" das Genitiv-Attribut dazu."
                            },
                            {
                                "example_id": "ae33c69a-3507-4a21-be37-a44f09fe4878",
                                "sense_id": "4961e018-f1f0-3079-9cbd-11ea099a40fc",
                                "text": "Gliedteile in nominalen Satzgliedern haben die grammatische Funktion Attribut oder Apposition."
                            },
                            {
                                "example_id": "62b46e2f-5cb3-4541-997e-10ba8f6b545c",
                                "sense_id": "4961e018-f1f0-3079-9cbd-11ea099a40fc",
                                "text": "„Gliedteile sind Konstituenten von Satzgliedern, und zwar mit syntaktischen Funktionen von Wortgruppen, auch wenn diese Funktionen durch einzelne Wörter wahrgenommen werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
