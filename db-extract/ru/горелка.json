                    },
                    {
                        "form_id": "50438b79-37fd-4aa3-a625-6949b83c7f48",
                        "entry_id": "f2d5215b-b355-330c-a192-1aa6c14f139b",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "горе́лках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63117601-e833-3502-9ddd-ea0b4c2d3db4",
                        "entry_id": "f2d5215b-b355-330c-a192-1aa6c14f139b",
                        "glosses": [
                            "приспособление для горения жидкости или газа в осветительных или отопительных приборах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738f01ef-9a20-43cf-bd49-235d16ae689c",
                                "sense_id": "63117601-e833-3502-9ddd-ea0b4c2d3db4",
                                "text": "Котёл отапливался бензиновыми горелками."
                            },
                            {
                                "example_id": "b75a4189-9703-42c2-af42-0a96064d57a6",
                                "sense_id": "63117601-e833-3502-9ddd-ea0b4c2d3db4",
                                "text": "В печке кричал сверчок и едва слышно гудела горелка в лампе."
                            },
                            {
                                "example_id": "6310a57f-2b2b-498c-aedb-b91545bdd7aa",
                                "sense_id": "63117601-e833-3502-9ddd-ea0b4c2d3db4",
                                "text": "Такой фонарь имеет четыре горелки перед металлическими щитками, но свет даёт лишь на очень близком расстоянии вокруг себя."
                            },
                            {
                                "example_id": "ee07d7b5-f8f2-44ba-b8b9-dac7a3cef81f",
                                "sense_id": "63117601-e833-3502-9ddd-ea0b4c2d3db4",
                                "text": "Я ломал спички и долго тыкал в горелку, пока она не зажглась синеватым огоньком."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ee418cb-d680-3658-a0cb-41470bda8c96",
                        "entry_id": "f2d5215b-b355-330c-a192-1aa6c14f139b",
                        "glosses": [
                            "спец. устройство для распыления и сжигания топлива при сварочных и иных работах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbbfaf52-47a6-4d4f-8e11-68b59acfa5b2",
                                "sense_id": "2ee418cb-d680-3658-a0cb-41470bda8c96",
                                "text": "Над ним в полную силу работала газовая горелка."
                            },
                            {
                                "example_id": "40ff7344-36ea-4c91-9ebe-615c1276ea7f",
                                "sense_id": "2ee418cb-d680-3658-a0cb-41470bda8c96",
                                "text": "Газовая горелка представляет собой устройство, в котором смешивается воздух с топливом с целью подачи воздушно-газовой смеси к выходному отверстию горелки и сжигания последней с образованием устойчивого факела."
                            }
                        ]
                    },
                    {
                        "sense_id": "74828bd4-520e-3971-929b-1c57e41d9b73",
                        "entry_id": "f2d5215b-b355-330c-a192-1aa6c14f139b",
                        "glosses": [
                            "рег. водка, горилка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b85cd34f-d91e-4f70-aa80-838394c28ce8",
                                "sense_id": "74828bd4-520e-3971-929b-1c57e41d9b73",
                                "text": "— И горелки не купишь небось? — Что горелка, не видали мы разве горелки; не будь она, проклятая, хмельна, и в рот бы не взял…"
                            },
                            {
                                "example_id": "2df84e44-d9a8-4e28-b4a4-f4cee0360789",
                                "sense_id": "74828bd4-520e-3971-929b-1c57e41d9b73",
                                "text": "Хотел Романа напоить своею горелкой допьяна, а ещё такой и горелки не бывало, чтобы Романа свалила."
                            }
                        ]
                    }
                ],
