                "senses": [
                    {
                        "sense_id": "df32d793-ddf0-3ab9-b708-0cf6d102cf3a",
                        "entry_id": "6c5229ba-c122-3b84-ac96-97313f009f72",
                        "glosses": [
                            "Scabiosa L., roślina z rodziny przewiertnicowatych o koszyczkowatych kwiatach występujących w różnych kolorach w zależności od gatunku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d72985-b872-4231-b65c-8ce2792c1e49",
                                "sense_id": "df32d793-ddf0-3ab9-b708-0cf6d102cf3a",
                                "text": "Przedłużenie kwitnienia driakwi i nachyłka można uzyskać poprzez regularne usuwanie przekwitłych kwiatostanów […]."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "832f1e81-f30f-3661-9b1c-968eae09ced6",
                        "entry_id": "6c5229ba-c122-3b84-ac96-97313f009f72",
                        "glosses": [
                            "stosowany w starożytności i średniowieczu lek sporządzany z wielu różnych składników, uważany za leczący wszelkie choroby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "955adf43-064b-4dbd-ae5d-1a4fa9dbd45c",
                                "sense_id": "832f1e81-f30f-3661-9b1c-968eae09ced6",
                                "text": ", Macierz Polska, Lwów 1937.."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "58ebede4-0ebf-393d-91f1-e7b5f14f157d",
                        "entry_id": "6c5229ba-c122-3b84-ac96-97313f009f72",
                        "glosses": [
                            "jakiekolwiek lekarstwo mające leczyć rozmaite dolegliwości"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "df5804ee-c95f-481a-91b1-c1377a46f034",
                                "sense_id": "58ebede4-0ebf-393d-91f1-e7b5f14f157d",
                                "text": "Oni zaś wypytywali go o odjazd i o zdrowie Maćka, radząc, jako ludzie doświadczeni, choć młodzi, rozmaite maście i driakwie cudownie rany gojące."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
