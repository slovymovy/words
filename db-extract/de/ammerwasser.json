                ],
                "senses": [
                    {
                        "sense_id": "a6fa0771-f506-3ed7-83c7-76a8daa418e0",
                        "entry_id": "4ff9a0d3-1e7e-3760-9805-5b8ca1ddd774",
                        "glosses": [
                            "flüssige Phase in einem Ammer benannten Toponym der Erdoberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b5ef71-bb9f-4416-be7f-8509503c9a61",
                                "sense_id": "a6fa0771-f506-3ed7-83c7-76a8daa418e0",
                                "text": "„Nun ist die letzte Möglichkeit, die Füße in kühles Ammerwasser zu tauchen, da wir anschließend das Flussbett verlassen.“"
                            },
                            {
                                "example_id": "af5fff74-94d0-45c5-90fe-74fc6869652e",
                                "sense_id": "a6fa0771-f506-3ed7-83c7-76a8daa418e0",
                                "text": "„Von ihm geht wieder ein anderer Kanal aus, welcher den obengenannten Sattel durchschneidet und am Fuß des östlich von der Stadt gelegenen Oesterberges hin das Ammerwasser dem Neckar zuleitet.“"
                            },
                            {
                                "example_id": "a4ad1bb2-d4f5-4cf1-9288-989cadbf02c8",
                                "sense_id": "a6fa0771-f506-3ed7-83c7-76a8daa418e0",
                                "text": "„Im Hirschbad oder im Neuen Bad wurden seit dem Mittelalter heiße Bäder mit Ammerwasser angeboten.“"
                            },
                            {
                                "example_id": "d7c5c441-fbbd-4cf3-88f9-6195b76148af",
                                "sense_id": "a6fa0771-f506-3ed7-83c7-76a8daa418e0",
                                "text": "„Da aber die Alte Ammer mit ihrem stark gewundenen Verlauf, ihrer reichen Ufervegetation und dem großen Totholzangebot einen idealen Lebensraum besonders für Fische darstellt, wurde sie 2002 durch das Wasserwirtschaftsamt Weilheim reaktiviert, indem mittels eines Durchstiches durch den Ammerdamm eine ständige Zuleitung von Ammerwasser sichergestellt wurde.“"
                            },
                            {
                                "example_id": "147fcd8c-4edc-4881-8c66-d521fd70b4b9",
                                "sense_id": "a6fa0771-f506-3ed7-83c7-76a8daa418e0",
                                "text": "„Das Ammerwasser wurde zwei Kilometer vor Tübingen aus dem Bach ausgeleitet und direkt zum Neckar geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
