                                    {
                                        "sense_id": "967a3253-2af9-3438-ba4d-364b9f201a52",
                                        "entry_id": "4f080808-aebf-3a86-ac62-5ac270231842",
                                        "glosses": [
                                            "Person, die jemanden oder etwas behütet"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b0ef63-ff86-4035-9b97-625fe1a80370",
                                                "sense_id": "967a3253-2af9-3438-ba4d-364b9f201a52",
                                                "text": "Der Staatspräsident wird bei seinen öffentlichen Auftritten stets von seinen Aufpassern begleitet."
                                            },
                                            {
                                                "example_id": "2c13ab6e-c7a9-4654-9835-778e6559bb11",
                                                "sense_id": "967a3253-2af9-3438-ba4d-364b9f201a52",
                                                "text": "Nach dem Fußballspiel stehen vor dem Stadion viele Aufpasser."
                                            },
                                            {
                                                "example_id": "8f1b0323-4aeb-4c58-ae5b-be224e3df18b",
                                                "sense_id": "967a3253-2af9-3438-ba4d-364b9f201a52",
                                                "text": "„Als Aufpasser fungierten zwei Dutzend SS-Männer sowie mehr als 120 Angehörige der »Organisation Todt«, die überwiegend aus Osteuropäern und Belgiern bestand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
