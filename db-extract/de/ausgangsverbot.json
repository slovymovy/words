                    {
                        "sense_id": "0bbfec8e-b10d-37be-9c2e-9c972961839a",
                        "entry_id": "b1a28a75-19ae-35f8-8bb3-6502aa2fb207",
                        "glosses": [
                            "offizielles, das heißt politisch, polizeilich oder militärisch verordnetes Verbot, zu einem ausgegebenen Zeitpunkt die Wohnung, das Haus beziehungsweise die Kaserne zu verlassen und öffentliche Plätze aufzusuchen"
                        ],
                        "tags": [
                            "besonders militärisch"
                        ],
                        "examples": [
                            {
                                "example_id": "f00d255a-6b62-49e9-af04-0a58657c68fb",
                                "sense_id": "0bbfec8e-b10d-37be-9c2e-9c972961839a",
                                "text": "„Ein striktes nächtliches Ausgangsverbot sperrte die Menschen anfangs an Werktagen von fünf Uhr abends bis sieben Uhr morgens in ihre Häuser, sonntags von halb sechs bis fünf Uhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
