                ],
                "senses": [
                    {
                        "sense_id": "2bdf0f8f-bcee-31f6-a80e-cf7b91a8d464",
                        "entry_id": "449a55c9-3c9c-3da0-b820-3ce0dce9911e",
                        "glosses": [
                            "растение семейства аралиевых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae8ae23-d3f4-45b5-a43a-f6275c7bf5c9",
                                "sense_id": "2bdf0f8f-bcee-31f6-a80e-cf7b91a8d464",
                                "text": "❬…❭ Среди них бросаются в глаза колючий элеутерококк (Eleutherococcus senticosus Maxim.) ❬…❭"
                            },
                            {
                                "example_id": "b58eb6cd-d3b2-4c83-bbc9-16b26dfe577b",
                                "sense_id": "2bdf0f8f-bcee-31f6-a80e-cf7b91a8d464",
                                "text": "❬…❭ Я высаживаю также пряные и лекарственные растения: аралию, элеутерококк и многое другое. ❬…❭"
                            }
                        ]
                    },
                    {
                        "sense_id": "52bf9230-929e-3a2d-b867-f12f7f4dc2a4",
                        "entry_id": "449a55c9-3c9c-3da0-b820-3ce0dce9911e",
                        "glosses": [
                            "общетонизирующее средство из корня элеутерококка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6ba050-c4b4-4817-9cff-f1945127c129",
                                "sense_id": "52bf9230-929e-3a2d-b867-f12f7f4dc2a4",
                                "text": "❬…❭ Элеутерококк — по 20–30 капель два раза в день, утром и в обед, за 30 минут до еды. ❬…❭"
                            }
                        ]
                    }
