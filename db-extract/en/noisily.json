                ],
                "senses": [
                    {
                        "sense_id": "1e8455b6-bc45-3ea7-a9b0-0fdc4c65848e",
                        "entry_id": "76c0a7ec-a5e6-390e-ba72-1965e0f116e1",
                        "glosses": [
                            "in a noisy manner; in such a way as to create a great deal of noise or sound"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0979fb78-e39f-4d89-864d-579dd57ab912",
                                "sense_id": "1e8455b6-bc45-3ea7-a9b0-0fdc4c65848e",
                                "text": "They talked noisily and long into the night."
                            },
                            {
                                "example_id": "fd6cd7e4-f6d3-47c0-8627-cec83594f6ae",
                                "sense_id": "1e8455b6-bc45-3ea7-a9b0-0fdc4c65848e",
                                "text": "Wembley was noisily registering its unrest with Capello and England when Johan Djourou's foul on Jack Wilshere gave Frank Lampard the opportunity to pull a goal back from the spot before the interval and provide the foundations for a second-half recovery."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dac7b9c-4537-4897-9043-b3bbd4bcb6bb",
                        "source_entry_id": "76c0a7ec-a5e6-390e-ba72-1965e0f116e1",
                        "source_sense_id": "1e8455b6-bc45-3ea7-a9b0-0fdc4c65848e",
                        "source_sense_description": "in a noisy manner",
                        "target_lang_word": "bruyamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruyamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08dc7bb6-37aa-3382-ad23-0715ff4fbf93",
                                        "entry_id": "da12ca23-98e5-32a8-9fa2-019f9255fa05",
                                        "glosses": [
                                            "Avec grand bruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d78d585-87f6-4968-99db-ae0bc4e18a86",
                                                "sense_id": "08dc7bb6-37aa-3382-ad23-0715ff4fbf93",
                                                "text": "Louis, voici le temps de respirer les roses\nEt d’ouvrir bruyamment les vitres longtemps closes."
                                            },
                                            {
                                                "example_id": "4c19e039-def2-4019-95f5-0e16d4d8162f",
                                                "sense_id": "08dc7bb6-37aa-3382-ad23-0715ff4fbf93",
                                                "text": "Il sollicita le garçon d’un timbre retentissant, en cognant bruyamment ses vastes pattes."
                                            },
                                            {
                                                "example_id": "7436beb0-289e-42b6-b7e6-26bfaece2af3",
                                                "sense_id": "08dc7bb6-37aa-3382-ad23-0715ff4fbf93",
                                                "text": "Il mangea sa soupe. Il en était à la moitié de son assiette quand il s’aperçut qu’il mangeait bruyamment, en penchant la tête, en aspirant, comme les enfants mal élevés et les paysans."
                                            },
                                            {
                                                "example_id": "effd4e3a-bb1b-4b58-b46b-3d688f5bc510",
                                                "sense_id": "08dc7bb6-37aa-3382-ad23-0715ff4fbf93",
                                                "text": "J’aime le théâtre pour les mots, se dit Grégoire en expirant bruyamment, mais pas seulement."
                                            },
                                            {
                                                "example_id": "eb061582-30b4-4956-8407-711f8320209d",
                                                "sense_id": "08dc7bb6-37aa-3382-ad23-0715ff4fbf93",
                                                "text": "Les rares consommateurs entraient en coup de vent, buvaient un canon sur le pouce, filaient ventre à terre. Un groupe de déménageurs vint bruyamment siffler quelques pots puis disparut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf13936b-5945-4e4b-931a-bc0798ddb0b0",
                        "source_entry_id": "76c0a7ec-a5e6-390e-ba72-1965e0f116e1",
                        "source_sense_id": "1e8455b6-bc45-3ea7-a9b0-0fdc4c65848e",
                        "source_sense_description": "in a noisy manner",
                        "target_lang_word": "geräuschvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geräuschvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16f25f6c-d6d0-3a94-bd30-1c5e405fd2f9",
                                        "entry_id": "6225f04c-0d58-314f-8fd5-fced4ab24964",
                                        "glosses": [
                                            "unter der Abgabe von Tönen/Krach/Lärm (Geräusch); voller Geräusche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29bccddd-4ae7-4e66-bcea-655246b64dd1",
                                                "sense_id": "16f25f6c-d6d0-3a94-bd30-1c5e405fd2f9",
                                                "text": "„Sein geräuschvoller Abgang ist kaum verklungen, da stürmt Prue auch schon mit ausgestrecktem Finger vorwurfsvoll auf mich zeigend quer durch den Raum auf mich zu.“"
                                            },
                                            {
                                                "example_id": "5dad6e87-88b6-476d-819a-87a245d3c130",
                                                "sense_id": "16f25f6c-d6d0-3a94-bd30-1c5e405fd2f9",
                                                "text": "„Durch die geräuschvolle Kulisse erkannte ich die Stimme nicht sofort, aber dann erinnerte ich mich wieder an den Abend im Louvre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89aba0f3-b4f8-4c49-860b-86229601785c",
                        "source_entry_id": "76c0a7ec-a5e6-390e-ba72-1965e0f116e1",
