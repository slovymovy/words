                    "sense_definition": "iemand die deel uitmaakt van de bemanning van een schip",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elke <w>schipper</w> aan boord moest helpen bij het hijsen van de zeilen.",
                            "target_lang_translations": {
                                "en": "Every <w>crew member</w> on board had to help hoist the sails."
                            }
                        },
                        {
                            "text": "De <w>schipper</w> controleerde de touwen voordat de reis begon.",
                            "target_lang_translations": {
                                "en": "The <w>sailor</w> checked the ropes before the journey began."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemanningslid",
                        "matroos"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is part of a ship's crew."
                    },
                    "translations": {
