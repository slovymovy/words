                    "sense_id": "2943f42f-92e6-35e3-a0ef-8e6c050a69a9",
                    "sense_definition": "logiczny, konsekwentny i tworzący harmonijną całość pod względem treści",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "logika_i_struktura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor przedstawił bardzo <w>spójną</w> argumentację, która przekonała większość członków komisji.",
                            "target_lang_translations": {
                                "ru": "Автор представил очень <w>связную</w> аргументацию, которая убедила большинство членов комиссии."
                            }
                        },
                        {
                            "text": "Ten artykuł jest logiczny i tworzy wyjątkowo <w>spójny</w> tekst.",
                            "target_lang_translations": {
                                "ru": "Эта статья логична и образует исключительно <w>связный</w> текст."
                            }
                        }
                    ],
                    "synonyms": [
                        "koherentny",
                        "konsekwentny",
                        "logiczny"
                    ],
                    "antonyms": [
                        "niespójny"
                    ],
                    "common_phrases": [
                        "spójny tekst",
                        "spójna wizja",
                        "spójna argumentacja"
                    ],
                    "target_lang_definitions": {
                        "ru": "логичный, последовательный и образующий гармоничное целое по содержанию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связный",
                                "target_lang_sense_clarification": "о тексте, мысли или речи"
                            },
                            {
                                "target_lang_word": "последовательный",
                                "target_lang_sense_clarification": "логичный, непротиворечивый"
                            },
                            {
                                "target_lang_word": "согласованный",
                                "target_lang_sense_clarification": "гармонично сочетающийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dab1dcb3-cabe-32fb-9fa1-e08d43334a8c",
                    "sense_definition": "tworzący ściśle połączoną całość pod względem budowy; jednolity i zwarty",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "struktura_materialna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowo wybudowane osiedle tworzy wyjątkowo <w>spójny</w> układ urbanistyczny z resztą dzielnicy.",
                            "target_lang_translations": {
                                "ru": "Недавно построенный жилой комплекс образует исключительно <w>целостную</w> градостроительную композицию с остальной частью района."
                            }
                        },
                        {
                            "text": "Wszystkie elementy maszyny muszą tworzyć <w>spójną</w> całość, aby mechanizm działał poprawnie.",
                            "target_lang_translations": {
                                "ru": "Все элементы машины должны образовывать <w>единое</w> целое, чтобы механизм работал исправно."
                            }
                        }
                    ],
                    "synonyms": [
                        "jednolity",
                        "spoisty",
                        "zwarty"
                    ],
                    "common_phrases": [
                        "spójna całość",
                        "spójna struktura"
                    ],
                    "target_lang_definitions": {
                        "ru": "образующий тесно связанное целое по структуре; единый и монолитный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целостный",
