                        "sense_id": "ffa95c27-898d-3e81-a0ed-12a350c81ec6",
                        "entry_id": "45eee29c-dc0d-3586-b727-abe5f47646e2",
                        "glosses": [
                            "Beförderung des Postguts mit von Katapulten gestarteten Flugzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29d54ff3-3e61-4ee5-a9a6-1d12af8c99d4",
                                "sense_id": "ffa95c27-898d-3e81-a0ed-12a350c81ec6",
                                "text": "„Damit schlug die Geburtsstunde der »Katapultpost« im Deutschen Reich, die ab 1931 »Deutsche Schleuderflugpost« genannt wurde.“"
                            },
                            {
                                "example_id": "5f89f56b-1241-43ea-ba4c-ce6e583a2aed",
                                "sense_id": "ffa95c27-898d-3e81-a0ed-12a350c81ec6",
                                "text": "„Katapultpost, später amtlich Schleuderflugpost genannt, erfreut sich bis heute wegen der schönen Frankaturen und vor allem wegen der Vielzahl der attraktiven werbewirksamen Flugbestätigungsstempel bei Sammlern großer Beliebtheit.“"
                            }
                        ],
