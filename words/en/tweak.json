{
    "word_family": [
        "tweaker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30e89ee3-17f0-3ec5-a321-be4ad65d9f64",
                    "sense_definition": "To make small adjustments or slight modifications to something in order to improve it; to fine-tune.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If we <w>tweak</w> the settings slightly, the software will run much faster.",
                            "target_lang_translations": {
                                "ru": "Если мы немного <w>подправим</w> настройки, программа будет работать намного быстрее."
                            }
                        },
                        {
                            "text": "The designer decided to <w>tweak</w> the colors to make the website more appealing.",
                            "target_lang_translations": {
                                "ru": "Дизайнер решил <w>скорректировать</w> цвета, чтобы сделать сайт более привлекательным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tweak the settings",
                        "tweak the design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить незначительные изменения или мелкие поправки для улучшения чего-либо; подгонять, настраивать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подправлять",
                                "target_lang_sense_clarification": "вносить мелкие изменения"
                            },
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "параметры, систему или инструмент"
                            },
                            {
                                "target_lang_word": "корректировать",
                                "target_lang_sense_clarification": "вносить уточнения или исправления"
                            },
                            {
                                "target_lang_word": "отлаживать",
                                "target_lang_sense_clarification": "доводить до нужного состояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66c61021-8d8f-3115-a34e-fbde9f5f0c90",
                    "sense_definition": "To pinch and pull something with a sudden, sharp twist or jerk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_pinch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He reached out playfully to <w>tweak</w> his younger brother's cheek.",
                            "target_lang_translations": {
                                "ru": "Он игриво потянулся, чтобы <w>ущипнуть</w> младшего брата за щеку."
                            }
                        },
                        {
                            "text": "The playful puppy tried to <w>tweak</w> my shoelaces while I was walking.",
                            "target_lang_translations": {
                                "ru": "Игривый щенок пытался <w>дёргать</w> меня за шнурки, пока я шёл."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tweak someone cheek",
                        "tweak someone nose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ущипнуть или дернуть с резким выкручиванием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щипать",
                                "target_lang_sense_clarification": "сжимать и тянуть пальцами"
                            },
                            {
                                "target_lang_word": "ущипнуть",
                                "target_lang_sense_clarification": "однократно сжать пальцами"
                            },
                            {
                                "target_lang_word": "дернуть",
                                "target_lang_sense_clarification": "резко потянуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dead127-8938-3e96-8121-3e7a5a55f707",
                    "sense_definition": "To tease or deliberately provoke someone to get a reaction out of them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loved to <w>tweak</w> his colleagues by making provocative remarks during meetings.",
                            "target_lang_translations": {
                                "ru": "Он любил <w>подкалывать</w> коллег, делая провокационные замечания во время совещаний."
                            }
                        },
                        {
                            "text": "She knew how to <w>tweak</w> him just enough to get his full attention.",
                            "target_lang_translations": {
                                "ru": "Она знала, как <w>задеть</w> его ровно настолько, чтобы привлечь всё его внимание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tweak people"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe teasing or annoying someone"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дразнить, поддевать или намеренно провоцировать кого-либо с целью вызвать реакцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддразнивать",
                                "target_lang_sense_clarification": "задевать шутками или репликами"
                            },
                            {
                                "target_lang_word": "подкалывать",
                                "target_lang_sense_clarification": "язвить, дразнить"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "вызывать эмоциональный отклик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a8af20-7268-3d41-bd08-ce5acdf19dc4",
                    "sense_definition": "To act erratically, lose touch with reality, or be utterly confused.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "drug_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Am I <w>tweaking</w> or did the power just go out for two seconds?",
                            "target_lang_translations": {
                                "ru": "У меня <w>глюки</w>, или свет только что вырубился на пару секунд?"
                            }
                        },
                        {
                            "text": "You are completely <w>tweaking</w> if you think that decision makes any sense.",
                            "target_lang_translations": {
                                "ru": "Ты совсем <w>спятил</w>, если думаешь, что в этом решении есть хоть какой-то смысл."
                            }
                        }
                    ],
                    "synonyms": [
                        "trip"
                    ],
                    "common_phrases": [
                        "actually tweaking"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used especially among young speakers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя неадекватно, бредить, терять связь с реальностью или сильно тупить (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнать",
                                "target_lang_sense_clarification": "говорить или делать глупости, бредить"
                            },
                            {
                                "target_lang_word": "глючить",
                                "target_lang_sense_clarification": "испытывать помутнение, путаться"
                            },
                            {
                                "target_lang_word": "чудить",
                                "target_lang_sense_clarification": "вести себя странно или неадекватно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91fe1a9b-f2a4-311c-b47e-805b219b57ca",
                    "sense_definition": "To abuse or be high on methamphetamine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drug_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer suspected that the agitated driver had been <w>tweaking</w> all night.",
                            "target_lang_translations": {
                                "ru": "Офицер заподозрил, что взвинченный водитель всю ночь <w>торчал</w> под метом."
                            }
                        },
                        {
                            "text": "He spent the entire weekend <w>tweaking</w> in a deserted apartment.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные, <w>марафоня</w> в заброшенной квартире."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Употреблять метамфетамин или находиться под его воздействием (наркосленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торчать",
                                "target_lang_sense_clarification": "находиться под действием стимуляторов"
                            },
                            {
                                "target_lang_word": "марафонить",
                                "target_lang_sense_clarification": "употреблять стимуляторы непрерывно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fb0bc18-7808-3234-9082-ec25e1656cfe",
                    "sense_definition": "To exhibit nervous, erratic, or compulsive movements resembling the symptoms of stimulant abuse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drug_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was visibly <w>tweaking</w> while being questioned by security guards.",
                            "target_lang_translations": {
                                "ru": "Он заметно <w>дёргался</w>, пока его допрашивали охранники."
                            }
                        },
                        {
                            "text": "The suspect started <w>tweaking</w> and paced nervously around the small room.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый занервничал, стал <w>дёргаться</w> и беспокойно расхаживать по маленькой комнате."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "describing erratic or agitated physical behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дёргаться, суетиться или совершать нервные, судорожные движения (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дёргаться",
                                "target_lang_sense_clarification": "совершать резкие непроизвольные движения"
                            },
                            {
                                "target_lang_word": "колбаситься",
                                "target_lang_sense_clarification": "находиться в состоянии нервного перевозбуждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af8d664c-8a6b-3e08-a21f-0d00f84129b2",
                    "sense_definition": "To strike a target with a missile launched from a catapult.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient engine managed to <w>tweak</w> the tower wall from a great distance.",
                            "target_lang_translations": {
                                "ru": "Древнему орудию удалось <w>поразить</w> стену башни с огромного расстояния."
                            }
                        },
                        {
                            "text": "Soldiers trained extensively so that their artillery could <w>tweak</w> enemy fortifications reliably.",
                            "target_lang_translations": {
                                "ru": "Солдаты упорно тренировались, чтобы их метательные орудия могли надежно <w>поражать</w> укрепления противника."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical artillery usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поражать цель снарядом, выпущенным из катапульты или метательного орудия (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "снарядом из метательного орудия"
                            },
                            {
                                "target_lang_word": "попадать",
                                "target_lang_sense_clarification": "в цель из орудия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14a5dd8d-7489-35fa-8ada-0a0f15e2b59a",
                    "sense_definition": "A slight change or fine adjustment made to improve something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine runs smoothly now after just one small <w>tweak</w>.",
                            "target_lang_translations": {
                                "ru": "Теперь двигатель работает ровно после всего одной небольшой <w>регулировки</w>."
                            }
                        },
                        {
                            "text": "We need a minor <w>tweak</w> in the wording of this contract.",
                            "target_lang_translations": {
                                "ru": "Нам нужна небольшая <w>правка</w> в формулировке этого договора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "minor tweak",
                        "simple tweak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое изменение, доработка или точная настройка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корректировка",
                                "target_lang_sense_clarification": "небольшое исправление или изменение"
                            },
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "мелкое уточнение"
                            },
                            {
                                "target_lang_word": "доработка",
                                "target_lang_sense_clarification": "улучшение деталей"
                            },
                            {
                                "target_lang_word": "настройка",
                                "target_lang_sense_clarification": "регулировка параметров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "149de7fe-e29f-375a-8162-ec27ef9c6f77",
                    "sense_definition": "A sharp, sudden pull or twist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_pinch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With an affectionate <w>tweak</w> of my ear, my grandfather greeted me warmly.",
                            "target_lang_translations": {
                                "ru": "С ласковым <w>щипком</w> за ухо дедушка тепло поприветствовал меня."
                            }
                        },
                        {
                            "text": "He gave the lever a sharp <w>tweak</w> to free the stuck mechanism.",
                            "target_lang_translations": {
                                "ru": "Он резко <w>дернул</w> рычаг, чтобы освободить заклинивший механизм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tweak of the ear",
                        "tweak of the nose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий щипок или внезапный рывок с выкручиванием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щипок",
                                "target_lang_sense_clarification": "действие по сжатию пальцами"
                            },
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a64f5fe6-804b-3122-bbed-fd49c3cad062",
                    "sense_definition": "Methamphetamine, especially in illicit trade or slang usage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drug_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police recovered several small bags of <w>tweak</w> from the glove compartment.",
                            "target_lang_translations": {
                                "ru": "Полиция изъяла из бардачка несколько пакетиков с <w>метом</w>."
                            }
                        },
                        {
                            "text": "He spent all his money trying to buy more <w>tweak</w>.",
                            "target_lang_translations": {
                                "ru": "Он потратил все свои деньги, пытаясь купить еще <w>мета</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "substance slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метамфетамин (наркосленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мет",
                                "target_lang_sense_clarification": "метамфетамин на сленге"
                            },
                            {
                                "target_lang_word": "винт",
                                "target_lang_sense_clarification": "кустарный метамфетамин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09acf473-a616-3fb4-a6ff-6c6c200201d5",
                    "sense_definition": "An auxiliary input used alongside the key in a block cipher to alter the permutation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cryptographic algorithm uses an explicit <w>tweak</w> to differentiate encryption contexts.",
                            "target_lang_translations": {
                                "ru": "Криптографический алгоритм использует явный <w>твик</w> для разграничения контекстов шифрования."
                            }
                        },
                        {
                            "text": "Changing the cipher <w>tweak</w> provides variability without requiring a brand new key.",
                            "target_lang_translations": {
                                "ru": "Изменение <w>твика</w> шифра обеспечивает вариативность без необходимости создания совершенно нового ключа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cipher tweak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вспомогательный входной параметр блочного шифра (твик), изменяющий перестановку без смены ключа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твик",
                                "target_lang_sense_clarification": "настроечный параметр в криптографии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30c2d8f3-2e6b-3ada-af92-2ebe176f33d6",
                    "sense_definition": "A single dose or inhalation of cocaine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drug_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stepped into the restroom to take another quick <w>tweak</w>.",
                            "target_lang_translations": {
                                "ru": "Он зашел в уборную, чтобы быстро принять очередную <w>дозу</w>."
                            }
                        },
                        {
                            "text": "The partygoers offered him a <w>tweak</w> before heading out to the club.",
                            "target_lang_translations": {
                                "ru": "Тусовщики предложили ему <w>дорожку</w> перед походом в клуб."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разовая доза или дорожка кокаина (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доза",
                                "target_lang_sense_clarification": "разовая порция наркотика"
                            },
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "порция порошка для вдыхания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7bfe5e3-37f4-340a-9cc5-be6a9d361aea",
                    "sense_definition": "A state of distress, trouble, or anxiety.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loss of his savings left him in a terrible <w>tweak</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапная потеря сбережений повергла его в ужасную <w>панику</w>."
                            }
                        },
                        {
                            "text": "She was in quite a <w>tweak</w> over the missing documents.",
                            "target_lang_translations": {
                                "ru": "Она пребывала в сильном <w>смятении</w> из-за пропавших документов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "obsolete usage for distress"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильного беспокойства, смятения или тревоги (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "тревожное состояние"
                            },
                            {
                                "target_lang_word": "паника",
                                "target_lang_sense_clarification": "состояние сильного волнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e409a324-da32-3d47-bd26-56555c21acf5",
                    "sense_definition": "A prostitute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler hurried past the dark alley when a <w>tweak</w> approached him.",
                            "target_lang_translations": {
                                "ru": "Путник ускорил шаг мимо темного переулка, когда к нему подошла <w>проститутка</w>."
                            }
                        },
                        {
