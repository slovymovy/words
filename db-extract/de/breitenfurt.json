                "senses": [
                    {
                        "sense_id": "0fb38273-432f-35d8-b3bb-053d12ba3e9d",
                        "entry_id": "648bf8d2-fd28-3c3b-8aab-e8953647e223",
                        "glosses": [
                            "Marktgemeinde Breitenfurt bei Wien"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3860499f-4cb1-4f50-9bb2-ab8abfeefb23",
                                "sense_id": "0fb38273-432f-35d8-b3bb-053d12ba3e9d",
                                "text": "Direkt an der Grenze zur Bundeshauptstadt Wien, im Landschaftsschutzgebiet Wienerwald im Tal der Reichen Liesing, liegt die knapp 6000 Einwohner zählende Marktgemeinde Breitenfurt."
                            },
                            {
                                "example_id": "7c9672d2-d6c4-45cc-a194-86d0ff33b5ce",
                                "sense_id": "0fb38273-432f-35d8-b3bb-053d12ba3e9d",
                                "text": "Die Zukunft Breitenfurts betrifft alle Bürgerinnen und Bürger und wird deshalb von der Gemeinde parteiübergreifend umgesetzt."
                            },
                            {
                                "example_id": "9e02fab3-f818-462d-be3c-dd4edf38a149",
                                "sense_id": "0fb38273-432f-35d8-b3bb-053d12ba3e9d",
                                "text": "Im Oktober 1931 erwarb Anna gemeinsam mit Dorothy Burlingham, die für die Kosten weitgehend allein aufkam, einen Bauernhof in der Nähe Breitenfurts, westlich von Wien."
                            },
                            {
                                "example_id": "22217384-4bac-4f0b-8875-8b9a3407e000",
                                "sense_id": "0fb38273-432f-35d8-b3bb-053d12ba3e9d",
                                "text": "„[…] Das kann ich als Privatperson einfach nicht unterschreiben, deshalb mussten wir die Verhandlungen abbrechen“, sagt Hofbauer, der in Breitenfurt (Bezirk Mödling) einen Reitstall betreibt."
                            },
                            {
                                "example_id": "367486a1-2b35-40dd-bb15-37cca2af2df6",
                                "sense_id": "0fb38273-432f-35d8-b3bb-053d12ba3e9d",
                                "text": "Vermutlich durch ein Bremsmanöver löste sich während der Fahrt auf der Hauptstraße in Breitenfurt am Mittwochnachmittag die Lenkerkabine eines Klein-Lkw und kippte nach vorne."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
