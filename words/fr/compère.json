            "senses": [
                {
                    "sense_id": "c45d0abb-10aa-39ed-be77-8d427fbf2113",
                    "sense_definition": "Ami fidèle avec qui l'on passe du temps ou s'associe ; camarade inséparable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "camarade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux <w>compères</w> se retrouvent tous les samedis pour aller pêcher au bord de la rivière."
                        },
                        {
                            "text": "Il est toujours accompagné de son fidèle <w>compère</w> lors des réunions de quartier."
                        }
                    ],
                    "synonyms": [
                        "camarade",
                        "compagnon",
                        "complice"
                    ],
                    "common_phrases": [
                        "joyeux compères",
                        "vieux compères"
                    ]
                },
                {
                    "sense_id": "7d5e533b-7aed-34d6-b888-98414a9516d7",
                    "sense_definition": "Personne secrètement de mèche avec quelqu'un pour l'aider dans un tour d'illusion, une farce ou une supercherie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le magicien a fait monter un spectateur sur scène, mais c'était en réalité son <w>compère</w>."
                        },
                        {
                            "text": "L'escroc a réussi son arnaque grâce à l'aide précieuse de plusieurs <w>compères</w> dissimulés dans la foule."
                        }
                    ],
                    "synonyms": [
                        "complice"
                    ],
                    "common_phrases": [
                        "servir de compère",
                        "jouer le compère"
                    ]
                },
                {
                    "sense_id": "37a04ce6-dfa3-3acf-b229-7e8cc76a6d1f",
                    "sense_definition": "Homme adroit, habile ou rusé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Méfie-toi de cet artisan, c'est un rusé <w>compère</w> qui sait toujours négocier à son avantage."
                        },
                        {
                            "text": "Le vieux marchand était un habile <w>compère</w> capable de vendre n'importe quel objet."
                        }
                    ],
                    "synonyms": [
                        "roublard"
                    ],
                    "antonyms": [
                        "naïf"
                    ],
                    "common_phrases": [
