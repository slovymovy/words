                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170f8da4-6388-4a91-adee-cc5ac67fd670",
                                                "sense_id": "a4795ac5-a4fb-31f6-b38a-e3bdde686e4f",
                                                "text": "Der Krankenpfleger begleitete den Patienten zur Röntgenabteilung."
                                            },
                                            {
                                                "example_id": "a54e1e2d-1ced-440e-94bb-12e50192058a",
                                                "sense_id": "a4795ac5-a4fb-31f6-b38a-e3bdde686e4f",
                                                "text": "„Ich machte mich schwer und die Krankenpfleger ächzten und sortierten mir die Arme auf den Bauch.“"
                                            },
                                            {
                                                "example_id": "146f954c-30b8-4767-a120-6203d559c90b",
                                                "sense_id": "a4795ac5-a4fb-31f6-b38a-e3bdde686e4f",
                                                "text": "„Geschoben von einem stämmigen Krankenpfleger, hatte Weich es geschafft, Roth im Oktober 2012 in seiner Wohnung zu besuchen.“"
                                            },
                                            {
                                                "example_id": "359348e8-0d0d-4600-8727-09df78abe88d",
                                                "sense_id": "a4795ac5-a4fb-31f6-b38a-e3bdde686e4f",
                                                "text": "„Sie schrieben an den König, man solle im Calvados eine Schule für Krankenpfleger einrichten, deren Lehrer sie selbst sein wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
