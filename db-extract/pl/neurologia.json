                    {
                        "translation_id": "68a35d91-1e7b-4a58-a508-fde618f5a134",
                        "source_entry_id": "4e03c9da-03cb-3353-91dd-4159b6dd147d",
                        "source_sense_id": "f3f88444-3397-367e-bd7b-c8442ee137bd",
                        "target_lang_word": "Neurologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neurologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adeee562-bbbe-3f65-a4ac-f1a06c2c46d7",
                                        "entry_id": "b9025e12-a645-3948-b044-907813d013f2",
                                        "glosses": [
                                            "Teilgebiet der Medizin, das sich mit dem Aufbau, Physiologie und den Erkrankungen des Nervensystems beschäftigt und diese behandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc2dcf0-a1cf-4e9d-9206-b7cabbac22c0",
                                                "sense_id": "adeee562-bbbe-3f65-a4ac-f1a06c2c46d7",
                                                "text": "Die Suche nach diesem Konnektom - analog zum Genom als der Gesamtheit aller Gene eines Organismus - ist ein neuer Trend der Neurologie."
                                            },
                                            {
                                                "example_id": "f2a3c679-0b7d-44e2-bbd0-e8a65d2654bf",
                                                "sense_id": "adeee562-bbbe-3f65-a4ac-f1a06c2c46d7",
                                                "text": "„Die Neurologie entstand wie alle medizinischen Fachgebiete aus der inneren Medizin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51bd4a57-512e-3812-8bce-173c5705870c",
                                        "entry_id": "b9025e12-a645-3948-b044-907813d013f2",
                                        "glosses": [
                                            "Abteilung eines Krankenhauses/einer Klinik mit Arbeitsgebiet [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e34d8ea-5c87-46f6-a9d7-5afc54016c36",
                                                "sense_id": "51bd4a57-512e-3812-8bce-173c5705870c",
                                                "text": "„Kaum waren wir zurück in der Neurologie, kam mir die Ärztin entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08fee5c9-12a7-4c54-9998-4a2f0884ec83",
                        "source_entry_id": "4e03c9da-03cb-3353-91dd-4159b6dd147d",
                        "source_sense_id": "f3f88444-3397-367e-bd7b-c8442ee137bd",
                        "target_lang_word": "неврология",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неврология",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "618b1557-55c0-344d-a86f-715e73583e10",
                                        "entry_id": "4b456096-f24b-3788-8371-701c0f07bef8",
                                        "glosses": [
                                            "научн., мед., биол. совокупность разделов медико-биологических наук, изучающих нервную систему и её заболевания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41932261-4c39-41a1-9c9f-b0d2ffbac17f",
                                                "sense_id": "618b1557-55c0-344d-a86f-715e73583e10",
                                                "text": "Очень много давший для психиатрии Вернике по своим основным точкам зрения ещё в большей мере был анатомом, к тому же хорошо ориентировавшимся в вопросах неврологии."
                                            },
                                            {
                                                "example_id": "a9798b47-6d2c-454a-8757-5291f818ca2a",
                                                "sense_id": "618b1557-55c0-344d-a86f-715e73583e10",
                                                "text": "В том же году перешёл к нам от нейрохирургов Анатолий Иванович Трещинский, уже кандидат наук, притом с отличной подготовкой по неврологии."
                                            },
                                            {
                                                "example_id": "91db2e4a-1761-4783-8038-9400d5297bbd",
                                                "sense_id": "618b1557-55c0-344d-a86f-715e73583e10",
                                                "text": ".. если профилактика и терапия кардиологических заболеваний более-менее развиты, включая санаторно-курортное лечение для постинфарктных состояний, то в области неврологии — огромный пробел: ни у врачей, ни у пациентов нет настороженности к нервным симптомам заболевания, нет системы ранней диагностики и этапности лечения, не говоря о новых хирургических технологиях, дающих полное выздоровление .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
