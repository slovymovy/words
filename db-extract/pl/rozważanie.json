                                "target_senses": [
                                    {
                                        "sense_id": "adce2b78-b1b1-3b72-aabf-de2c18a8ca9b",
                                        "entry_id": "13a4ffee-5717-39ca-a3ac-dbdfbb7b1116",
                                        "glosses": [
                                            "das Anschauen, Betrachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e84958-759e-4084-b775-dbdaf868b374",
                                                "sense_id": "adce2b78-b1b1-3b72-aabf-de2c18a8ca9b",
                                                "text": "„Wir können da nichts ändern, selbst wenn wir es wollten. Besser als durch beider Betrachtungen über das, was zugänglich und was verschlossen ist, was man ändern und nicht ändern kann, läßt sich die Differenz der Raumbegriffe und Raumerfahrungen von Ost- und Westdeutschen kaum ausdrücken. In Eisenhüttenstadt, wo jegliches kommerzielles Privateigentum verschwunden war, kam das ostdeutsche Raumverständnis unverkürzt zum Tragen.“"
                                            },
                                            {
                                                "example_id": "91ccd86d-a521-46ea-93fa-059fde74f2df",
                                                "sense_id": "adce2b78-b1b1-3b72-aabf-de2c18a8ca9b",
                                                "text": "„In solchen Betrachtungen erging sich der Türke, und wir verbrachten damit vier Stunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6561de7-da3f-399c-8504-f928e4ca15b7",
                                        "entry_id": "13a4ffee-5717-39ca-a3ac-dbdfbb7b1116",
                                        "glosses": [
                                            "die ästhetische Beurteilung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39033cc2-2c83-4b56-8916-5bdc5009e4c4",
                                                "sense_id": "d6561de7-da3f-399c-8504-f928e4ca15b7",
                                                "text": "„Die Ruchlosigkeit der Hausmeier empörte sie keineswegs – und sie legten Anquetil beiseite, von der Albernheit seiner Betrachtungen abgestoßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
