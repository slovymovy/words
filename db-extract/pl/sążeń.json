                "senses": [
                    {
                        "sense_id": "f49db809-79e1-3752-86e6-b120967f97b0",
                        "entry_id": "a7a85181-0314-3d3d-8776-bc6769819c23",
                        "glosses": [
                            "jednostka długości, używana do pocz. XX w., równa odległości między dłońmi rozpostartych ramion mężczyzny, czyli około 1,7 m"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d9613a-48fc-40a5-9223-4deba7b8885b",
                                "sense_id": "f49db809-79e1-3752-86e6-b120967f97b0",
                                "text": "Oddalili się tak owym chodnikiem o trzydzieści sążni od skarp fortu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43e651ff-1a96-4824-a615-b4ea27a54e77",
                        "source_entry_id": "a7a85181-0314-3d3d-8776-bc6769819c23",
                        "source_sense_id": "f49db809-79e1-3752-86e6-b120967f97b0",
                        "target_lang_word": "fathom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fathom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17112d5f-322f-33e1-a04c-f7e34285f488",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "A man's armspan, generally reckoned to be six feet (about 1.8 metres). Later used to measure the depth of water, but now generally replaced by the metre outside American usage."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9df9d3-774b-4d3b-ab44-5f429348ccb9",
                                                "sense_id": "17112d5f-322f-33e1-a04c-f7e34285f488",
                                                "text": "[T]he ſhipmen deemed that they drew neere to ſome countrey: And ſounded, and found it twentie fathoms: and when they had gone a little further, they ſounded againe, and found it fifteene fathoms."
                                            },
                                            {
                                                "example_id": "430b2eda-e305-419d-9d5e-e5f090465b1d",
                                                "sense_id": "17112d5f-322f-33e1-a04c-f7e34285f488",
                                                "text": "Full fadom fiue thy Father lies,\nOf his bones are Corrall made:\nThose are pearles that were his eies,\nNothing of him that doth fade,\nBut doth suffer a Sea-change\nInto someting rich, & strange"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d73d2a81-5499-371e-baf7-f6243da3968c",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "A man's armspan, generally reckoned to be six feet (about 1.8 metres). Later used to measure the depth of water, but now generally replaced by the metre outside American usage.",
                                            "An internationally standardized version of this unit, the international fathom (= 1.8288 metres = 6 feet)."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac4db4f0-4c21-38e6-b289-5f42b378d689",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "A measure of distance to shore: the nearest point to shore at which the water depth is the value quoted."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687b204d-fbcb-49fb-87b5-7922a4404d86",
                                                "sense_id": "ac4db4f0-4c21-38e6-b289-5f42b378d689",
                                                "text": "After we'd rowed for an hour, we found ourselves stranded ten fathoms from shore."
                                            },
                                            {
                                                "example_id": "669f45e7-a6f8-4e84-aa82-b00b8985859f",
                                                "sense_id": "ac4db4f0-4c21-38e6-b289-5f42b378d689",
                                                "text": "At fifty fathoms, the waters of the Southern Ocean are dark blue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad16b577-e065-34d7-9e50-1e2de97b3f87",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "An unspecified depth."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34c163be-ec51-3542-875e-0e81c8cc0ffe",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "Depth of insight; mental reach or scope."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794f4176-1132-4563-8e82-dbab89ef39e4",
                                                "sense_id": "34c163be-ec51-3542-875e-0e81c8cc0ffe",
                                                "text": "Another of his fathome they haue not / To leade their buſineſſe, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa1d7bda-d016-37ad-82ca-559c5b2a55aa",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "The act of stretching out one's arms away from the sides of the torso so that they make a straight line perpendicular to the body."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29d32b35-5291-3084-a646-7a0f36da9265",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "Someone or something that is embraced."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa845c89-ecaa-4244-8a0c-21fdda819c91",
                                                "sense_id": "29d32b35-5291-3084-a646-7a0f36da9265",
                                                "text": "Thy Bride, thy choice, thy vvife, / She that is novv thy fadom, […] Kneele at thy feete, obay in euerie thing, / So euerie Father is a priuate King."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79063620-e565-30ad-ae63-8f3cbac5436b",
                                        "entry_id": "0e3cccc9-52a5-30ab-80fa-d7be3bca9e02",
                                        "glosses": [
                                            "Control, grasp."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b85be133-f09a-470b-98a8-15d78ad21cd2",
                                                "sense_id": "79063620-e565-30ad-ae63-8f3cbac5436b",
                                                "text": "So; novv knovv I vvhere I am, me thinkes already / I graſpe beſt part of the Autumnian bleſſing / In my contentious fadome, […]"
                                            },
                                            {
                                                "example_id": "d59f3ec7-60f0-4635-8987-f160ea1f816e",
                                                "sense_id": "79063620-e565-30ad-ae63-8f3cbac5436b",
                                                "text": "Yes: / you have blovvne his ſvvolne pride to that vaſtnes, / as he beleeves the earth is in his fadom, / this makes him qute forget his humble Being: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
