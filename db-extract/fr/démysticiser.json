                        "glosses": [
                            "Faire perdre son caractère mystique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba3c7de7-0013-4410-97b2-f352d0cf7522",
                                "sense_id": "342716f0-0bb9-3449-8e34-4cf91452a57e",
                                "text": "L'auteur, on le sait, pousse la thèse jusqu'aux extrêmes, mettant en un vif relief l'influence de Nicole qui, plus que personne, a contribué à précipiter la « retraite » de nos mystiques, à « démysticiser la seconde moitié du XVIIème siècle »;"
                            }
                        ]
                    },
                    {
                        "sense_id": "a850d754-56d3-3daa-b559-dcea4545b5f6",
                        "entry_id": "dfceea0f-53ba-392b-96ea-a501e4a74b58",
                        "glosses": [
                            "Perdre son caractère mystique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "ca043e1a-efdb-4524-bd88-40c649f0a8af",
                                "sense_id": "a850d754-56d3-3daa-b559-dcea4545b5f6",
                                "text": "Eh ! bien, en devenant si ardemment sportive notre société se démysticise elle aussi."
                            }
