                                    },
                                    {
                                        "sense_id": "b45d152b-3740-3751-b0dc-4aa43903a4cd",
                                        "entry_id": "ddb42be4-7c9e-3dc9-957a-27c309e67ed3",
                                        "glosses": [
                                            "Reliability or uniformity; the quality of being consistent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f72bc4-ce41-43d8-b2ee-a7208f728580",
                                                "sense_id": "b45d152b-3740-3751-b0dc-4aa43903a4cd",
                                                "text": "They want to achieve a high degree of consistency in their process and their product."
                                            },
                                            {
                                                "example_id": "06b0a8d4-332f-4aa2-8d99-93d534a6d597",
                                                "sense_id": "b45d152b-3740-3751-b0dc-4aa43903a4cd",
                                                "text": "That consistency of behaviour whereby he inflexibly pursues those measures which appear the most just."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29445415-33f0-3a1d-8700-3daee5b1d167",
                                        "entry_id": "ddb42be4-7c9e-3dc9-957a-27c309e67ed3",
                                        "glosses": [
                                            "The degree of viscosity of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36bcce5c-3a70-41c6-8f9f-d6cfdbe5012d",
                                                "sense_id": "29445415-33f0-3a1d-8700-3daee5b1d167",
                                                "text": "Mix it until it has the consistency of a thick paste."
                                            },
                                            {
                                                "example_id": "b7fbd820-8ee3-4a52-bcac-dfe42323e053",
                                                "sense_id": "29445415-33f0-3a1d-8700-3daee5b1d167",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca74df64-f285-3d98-8ede-1ff3e72a2cfc",
                                        "entry_id": "ddb42be4-7c9e-3dc9-957a-27c309e67ed3",
                                        "glosses": [
                                            "Freedom from contradiction; the state of a system of axioms such that none of the propositions deduced from them are mutually contradictory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95a6b33c-b244-3370-bdde-d3d1c6ed8c3a",
                                        "entry_id": "ddb42be4-7c9e-3dc9-957a-27c309e67ed3",
                                        "glosses": [
                                            "Firmness of constitution or character; substantiality; durability; persistency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fbe441-7c57-47e5-a492-68dfd299ce54",
                                                "sense_id": "95a6b33c-b244-3370-bdde-d3d1c6ed8c3a",
                                                "text": "His friendship is of a noble make and a lasting consistency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca19a097-4249-4482-b3fa-9b0bfadd9ba4",
