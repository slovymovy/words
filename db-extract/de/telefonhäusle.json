                "senses": [
                    {
                        "sense_id": "50137d52-751d-30ea-bad3-1d63b4854849",
                        "entry_id": "be24740f-d261-3165-a27a-be815fba740b",
                        "glosses": [
                            "mit einem Telefon ausgestattete Kabine im öffentlichen Raum"
                        ],
                        "tags": [
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "715677dc-4825-41ba-b550-7e7fa07b2499",
                                "sense_id": "50137d52-751d-30ea-bad3-1d63b4854849",
                                "text": "„Alte Telefonhäusle, auch ehemalige Litfaßsäulen oder traditionell Schränke fungieren vielerorts als Büchercontainer, die für Passanten zugänglich sind.“"
                            },
                            {
                                "example_id": "d220daa3-87d9-49a1-ab5f-b5732ecd5dc4",
                                "sense_id": "50137d52-751d-30ea-bad3-1d63b4854849",
                                "text": "„Wenn er mal ungestört telefonieren wollte, sagt er grinsend, nahm er die fünf Kilometer lange Strecke zum Telefonhäusle an der Eyachmühle auf sich.“"
                            },
                            {
                                "example_id": "11b74b4f-9261-4295-84fc-a29466b2c2c8",
                                "sense_id": "50137d52-751d-30ea-bad3-1d63b4854849",
                                "text": "„Von wegen Smartphone, die 50er stehen auch für Telefonhäusle.“"
                            },
                            {
                                "example_id": "b6aa85b4-8b82-45de-8ea1-b2f31f5308f4",
                                "sense_id": "50137d52-751d-30ea-bad3-1d63b4854849",
                                "text": "„Das Telefonhäusle wurde zunächst einmal von Berlin zum Nürtinger Bauhof gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
