                                        ]
                                    },
                                    {
                                        "sense_id": "ffe10be7-a36c-3c88-bf7a-e3568b7def23",
                                        "entry_id": "67cc39b0-ae2d-3c8e-975c-63ec6392bc99",
                                        "glosses": [
                                            "Lacking social skills, or uncomfortable with social interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e68a1f-8950-419c-9d7e-3b46e422223c",
                                                "sense_id": "ffe10be7-a36c-3c88-bf7a-e3568b7def23",
                                                "text": "I'm very awkward at parties."
