                                "target_lang_sense_clarification": "法律上的授权或指示"
                            },
                            {
                                "target_lang_word": "指示",
                                "target_lang_sense_clarification": "客户对律师的要求"
                            }
                        ]
                    }
                }
            ]
        }
    ]
