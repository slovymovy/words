                    {
                        "translation_id": "4001d012-809d-46af-ba6a-a4cb6ce4404f",
                        "source_entry_id": "7d2ba1d3-6020-324e-b39b-1caf6f083a69",
                        "source_sense_id": "74dee56d-8006-329b-9104-37da12817de8",
                        "source_sense_description": "blood clot formed in blood vessels that leads to thrombosis",
                        "target_lang_word": "Blutgerinnsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutgerinnsel",
                                "target_lang_code": "de",
