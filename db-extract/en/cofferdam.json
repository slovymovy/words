                                "target_senses": [
                                    {
                                        "sense_id": "321f35f2-9a02-30d6-996f-8fceba664e46",
                                        "entry_id": "c46adbd1-9093-3b2f-a95d-fe894bbb741f",
                                        "glosses": [
                                            "Espèce de digue faite le plus souvent d’un double rang de pieux et d’ais, entre lesquels on entasse de la terre, construite au milieu du courant d’une rivière ou d’un canal, soit pour détourner les eaux, soit pour les contenir pendant les travaux qu’on est obligé d’y faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad0719a-c1f1-4c9b-841c-e26b633e318d",
                                                "sense_id": "321f35f2-9a02-30d6-996f-8fceba664e46",
                                                "text": "Parallèlement à la rivière, afin de régulariser le cours de l'eau, les paysans ont d'abord creusé puis cimenté un canal de dérivation équipé de batardeaux, ouvrages permettant de régler le débit de l'eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380ce7fd-d038-36cd-b5a7-528c94f7f550",
                                        "entry_id": "c46adbd1-9093-3b2f-a95d-fe894bbb741f",
                                        "glosses": [
                                            "Cloison étanche appliquée à la carène d’un navire pour isoler une voie d’eau que l’on veut réparer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59ebb77e-8afb-358b-b9bf-13f741df97bf",
                                        "entry_id": "c46adbd1-9093-3b2f-a95d-fe894bbb741f",
                                        "glosses": [
                                            "Construction formant une retenue d’eau, afin d’assécher un terrain où on doit effectuer des travaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
