                                        "entry_id": "5eebc1e4-94ff-350b-80dd-c41cb42fb0d0",
                                        "glosses": [
                                            "kleine Aussparung an der Zielvorrichtung einer Schusswaffe, über die beim Zielen geblickt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0763cd-376c-4e21-8e7a-7529c203b479",
                                                "sense_id": "1ebfe495-f9b6-343f-90b4-b819eba8cb7e",
                                                "text": "„Bei Sportwaffen sind die Kimme und gelegentlich auch das Korn einstellbar.“"
                                            },
                                            {
                                                "example_id": "1fea088d-c1b3-4de4-8e9c-a1e95418e189",
                                                "sense_id": "1ebfe495-f9b6-343f-90b4-b819eba8cb7e",
                                                "text": "„Die Ziele drüben saßen über Korn und Kimme wie kaum auf dem Exerzierplatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a132475f-e9b0-34c9-8e35-608bc4670687",
                                        "entry_id": "5eebc1e4-94ff-350b-80dd-c41cb42fb0d0",
                                        "glosses": [
                                            "eine keilförmige Vertiefung"
                                        ],
                                        "tags": [],
