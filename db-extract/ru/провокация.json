                                "target_senses": [
                                    {
                                        "sense_id": "f2a5b692-7f08-38a5-8157-1085724e4d41",
                                        "entry_id": "f31a2bf8-cbf0-33b3-b022-1ed1302f185c",
                                        "glosses": [
                                            "The act of provoking, inciting or annoying someone into doing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
