                        "entry_id": "63e033db-f687-3679-80ff-f94a719154fb",
                        "glosses": [
                            "A device for punching a duplicate perforated paper tape of incoming messages for later retransmission."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0860b4f6-4e95-4f16-bb1d-0cd19a7c84ed",
                                "sense_id": "0c2cdda2-2828-3956-b990-2eda82cb427d",
                                "text": "If an error is indicated the reperforator deletes the errored line from the tape and signals the transmitter to repeat the line of data."
                            },
                            {
                                "example_id": "bfec19e5-6db0-481a-81b1-faed0d36093a",
                                "sense_id": "0c2cdda2-2828-3956-b990-2eda82cb427d",
                                "text": "The reperforator punches the routing indicator, along with the message body, into a tape"
                            },
                            {
                                "example_id": "c79fc416-8aa5-4417-847e-66f6eb170a25",
                                "sense_id": "0c2cdda2-2828-3956-b990-2eda82cb427d",
                                "text": "Creed's, earlier a world leader in teletype and reperforator equipment, could not or would not manage the transition to manufacture the tape punches"
                            }
                        ]
                    }
