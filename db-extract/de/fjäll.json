                        "translation_id": "fa376aa0-fe4d-4a90-b20d-69c33afe465a",
                        "source_entry_id": "b2dab521-38d9-3922-a1ff-be31a7142eb7",
                        "source_sense_id": "faabf83e-7fcd-32ab-b2c9-4b3033f20abe",
                        "source_sense_description": "hoch gelegene Landschaft, in der Sträucher, Moose, Gräser und Flechten, aber fast keine Bäume wachsen",
                        "target_lang_word": "fell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3713fbe-6add-3673-9ff3-d55d7ff8949d",
                                        "entry_id": "a5a8ca3c-6c82-368b-ae90-084c075a4ac0",
