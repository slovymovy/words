                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7011b95-8cea-44da-b69e-1788e7a1e089",
                        "source_entry_id": "964437f5-4823-3d18-85e3-ec51f118136e",
                        "source_sense_id": "42f2157a-e3e7-3d60-beaf-481b6a27a0d4",
                        "target_lang_word": "fandango",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fandango",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b13da22-9fdb-39ef-90e6-8559c621f1de",
                                        "entry_id": "44ad01e0-8559-3124-8f5a-3e535f2441be",
                                        "glosses": [
                                            "A form of lively flamenco music and dance that has many regional variations (e.g. fandango de Huelva), some of which have their own names (e.g. malagueña, granadina)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ab5397-a9f8-4277-af7c-a0ccad708db0",
                                                "sense_id": "0b13da22-9fdb-39ef-90e6-8559c621f1de",
                                                "text": "The soldiers were oftener gambling and dancing beneath the walls than keeping watch upon the battlements, and nothing was heard from morning till night but the noisy contests of cards and dice, mingled with the sound of the bolero or fandango, the drowsy strumming of the guitar, and the rattling of the castanets, while often the whole was interrupted by the loud brawl and fierce and bloody contest."
                                            },
                                            {
                                                "example_id": "bb3f8830-ebdd-4030-92e5-de6877b23105",
                                                "sense_id": "0b13da22-9fdb-39ef-90e6-8559c621f1de",
                                                "text": "[…] sweet to us it is to behold delightful dancing, be it the stately splendour of the Pavane which progresseth as large clouds at sun-down that pass by in splendour; or the graceful Allemande; or the Fandango, which goeth by degrees from languorous beauty to the swiftness and passion of Bacchanals dancing on the high lawns under a summer moon that hangeth in the pine trees; or the joyous maze of the Galliard; or the Gigue, dear to the Foliots."
                                            },
                                            {
                                                "example_id": "853cb3fc-889b-4308-ace9-3e2668e8d662",
                                                "sense_id": "0b13da22-9fdb-39ef-90e6-8559c621f1de",
                                                "text": "We skipped the light fandango / Turned cartwheels 'cross the floor"
                                            },
                                            {
                                                "example_id": "93c12239-2ef1-411f-bf00-56e5fc8c603d",
                                                "sense_id": "0b13da22-9fdb-39ef-90e6-8559c621f1de",
                                                "text": "I see a little silhouetto of a man / Scaramouche, Scaramouche, will you do the fandango?"
                                            },
                                            {
                                                "example_id": "5c0b3ca3-9651-44fe-b108-88684fd3e14d",
                                                "sense_id": "0b13da22-9fdb-39ef-90e6-8559c621f1de",
                                                "text": "I'm wearing a Spanish skirt so what's wrong with dancing a fandango."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f334f91d-8e41-3721-b7b3-c4c3f5ce9b1a",
                                        "entry_id": "44ad01e0-8559-3124-8f5a-3e535f2441be",
                                        "glosses": [
                                            "A gathering for dancing; a ball."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aa3fe4b-884c-45a9-aab7-910627c3526b",
                                                "sense_id": "f334f91d-8e41-3721-b7b3-c4c3f5ce9b1a",
                                                "text": "When Auguste Fretéllière and the painter Theodore Gentilz attended a fandango in the 1840s, the festivities took place near Military Plaza."
                                            },
                                            {
                                                "example_id": "6e28090d-b9c0-4dfc-af1c-6572d6eb23f2",
                                                "sense_id": "f334f91d-8e41-3721-b7b3-c4c3f5ce9b1a",
                                                "text": "Fortunately, in the nineteenth century Iosé Maria Esteva wrote a poetic and detailed account of 'La guanabana' being danced by a group of women at a fandango."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad502991-a435-3c3f-942e-dac639365f7e",
                                        "entry_id": "44ad01e0-8559-3124-8f5a-3e535f2441be",
                                        "glosses": [
                                            "An unknown entity or contraption."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b517221-a616-45a7-831b-e703e2fedd16",
                                                "sense_id": "ad502991-a435-3c3f-942e-dac639365f7e",
                                                "text": "What’s that fandango you’re using?"
                                            },
                                            {
                                                "example_id": "b5cc5a83-6b1d-4b55-a201-f937bb5dbd7a",
                                                "sense_id": "ad502991-a435-3c3f-942e-dac639365f7e",
                                                "text": "She had on a new silk dress, flounced clear up to her knees, and some kind of a fandango of a thing on her shoulders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb59f491-4090-3255-a9e9-7f2c34e8987c",
                                        "entry_id": "44ad01e0-8559-3124-8f5a-3e535f2441be",
                                        "glosses": [
                                            "A confusion; a chaotic collection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5eec02b-4fdd-4875-8a63-f59e3dffabdd",
                                                "sense_id": "eb59f491-4090-3255-a9e9-7f2c34e8987c",
                                                "text": "To my infinite amusement it did take, and I had the satisfaction of seeing it on the boards and also hearing the audience roar with laughter; in fact, I laughed myself, not at my own jokes, but at the people who could be amused at such a fandango of nonsense."
                                            },
                                            {
                                                "example_id": "c008ddcb-ee9e-4029-9732-413b187ac591",
                                                "sense_id": "eb59f491-4090-3255-a9e9-7f2c34e8987c",
                                                "text": "A splotch of colour on a wall charmed his eye, a fandango of shadows, the nonchalant pose of some labourer."
                                            },
                                            {
                                                "example_id": "0304acbb-e71d-4b64-b45b-6484aaeef681",
                                                "sense_id": "eb59f491-4090-3255-a9e9-7f2c34e8987c",
                                                "text": "Such a fandango of wicked lies Mrs. Love had never heard tell in all her born days."
                                            },
                                            {
                                                "example_id": "af030575-ece7-4424-a049-0c424fcbe43b",
                                                "sense_id": "eb59f491-4090-3255-a9e9-7f2c34e8987c",
                                                "text": "So it must have been appalling, a veritable stab in the belly, when these undreamed-of smells infiltrated the familiar ranks, assailing her nostrils with a gypsy effrontery, a fandango of exotic spice."
                                            },
                                            {
                                                "example_id": "396d99dd-bc1b-4c4f-a3c0-bf2a6cbef9b7",
                                                "sense_id": "eb59f491-4090-3255-a9e9-7f2c34e8987c",
                                                "text": "\"She was latin, and she was satin” a commotion by moonlight a conundrum by candlelight a fandango of respite and tailbones in an invertebratology of polyclads, skates, chitons, and vestigial gills"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c7a6073-6514-3171-a7e4-85457dda9e83",
                                        "entry_id": "44ad01e0-8559-3124-8f5a-3e535f2441be",
                                        "glosses": [
                                            "An extravaganza; an instance of lavish and fantastical events or behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "117adcdb-38cd-4cb2-abe7-2a4bdb762d80",
                                                "sense_id": "3c7a6073-6514-3171-a7e4-85457dda9e83",
                                                "text": "I am preparing to set out in a fortnight, or little more, and jogging on comfortably through Bavaria, Suabia, and France (with a fandango of eight days at Paris), I shall get to Calais in the first week of May."
                                            },
                                            {
                                                "example_id": "ad5ac589-d601-41de-b5cc-d4632009b8c7",
                                                "sense_id": "3c7a6073-6514-3171-a7e4-85457dda9e83",
                                                "text": "Venice whirled towards her fall, in the reign of the 120th Doge, in a fandango of high living and enjoyment, until at last Napoleon, brusquely deposing her ineffective Government, ended the Republic and handed the Serenissima contemptuously to the Austrians."
                                            },
                                            {
                                                "example_id": "43338411-9c78-429c-aaa7-ab1ff3a992df",
                                                "sense_id": "3c7a6073-6514-3171-a7e4-85457dda9e83",
                                                "text": "Scaramouche, what a fandango of a life."
                                            },
                                            {
                                                "example_id": "080861bb-543c-4e56-a0d6-67778346294d",
                                                "sense_id": "3c7a6073-6514-3171-a7e4-85457dda9e83",
                                                "text": "Highlights of the recent high society swirl include jewellery and watch collection debuts, champagne celebrations, boutique store openings, hi-tech art and product launches and fashion fandangos aplenty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cd34234-9066-383a-9f34-74833fbfb0c7",
                                        "entry_id": "44ad01e0-8559-3124-8f5a-3e535f2441be",
                                        "glosses": [
                                            "A shade of red-violet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c6a3d01-07c1-3c72-92d4-cf51ff01f7ee",
                                        "entry_id": "44ad01e0-8559-3124-8f5a-3e535f2441be",
                                        "glosses": [
                                            "Vagina."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69d2f9fe-6987-48dd-a9ed-c93fc2e60e94",
                                                "sense_id": "8c6a3d01-07c1-3c72-92d4-cf51ff01f7ee",
                                                "text": "So, what? She strangled her and stuck a broken bottle up her... fandango?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fandango",
                                "target_lang_code": "en",
                                "target_senses": [
