                        "glosses": [
                            "Arzt, der in einer Klinik (einem Krankenhaus) tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ba812f-929b-4909-b336-06ff62d9505d",
                                "sense_id": "1755ebba-40de-31ab-ac9d-cec4613ddac2",
                                "text": "„Ein mit dem Coronavirus infizierter Klinikarzt hatte an seinem Arbeitsplatz in Mönchengladbach nach seiner Ansteckung Kontakt zu zwölf Patienten.“"
                            },
                            {
                                "example_id": "304a2180-331a-480a-9c46-957bf6edd2e5",
                                "sense_id": "1755ebba-40de-31ab-ac9d-cec4613ddac2",
                                "text": "„Da verweigert der deutschnationale und reiche jüdische Emigrant Oppenheim dem um Unterstützung bittenden Ludwig Kern jede Hilfe, und der Klinikarzt Beer wird für ihn und seine Geliebte zum uneigennützigen Lebensretter.“"
                            }
                        ],
