                "senses": [
                    {
                        "sense_id": "9a191adb-a95e-3da5-b7d8-247ca01ff8e7",
                        "entry_id": "18460d80-3470-3384-8805-bf1a1deb7e21",
                        "glosses": [
                            "een extraatje, meestal als beloning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd822d5-a7b9-4c2a-b09e-ba018e6a58e5",
                                "sense_id": "9a191adb-a95e-3da5-b7d8-247ca01ff8e7",
                                "text": "Managers krijgen vaak een bonus (heeft echter weinig te maken met 'goed') maar nooit een malus (hoewel daar nu juist vaak een reden voor is)!"
                            },
                            {
                                "example_id": "bf0f9af1-336a-4ec1-93cb-09c6e81add5c",
                                "sense_id": "9a191adb-a95e-3da5-b7d8-247ca01ff8e7",
                                "text": "de tijdgeest: iedere 'topman' van een kauwgomballenfabriek geeft zichzelf ieder jaar een bonus van minstens 3 miljoen euro"
                            },
                            {
                                "example_id": "7879b550-5162-4b34-9658-aa025c98a859",
                                "sense_id": "9a191adb-a95e-3da5-b7d8-247ca01ff8e7",
                                "text": "Er is geen duidelijke relatie tussen de prestaties van een beursgenoteerd bedrijf en het toekennen aan bonussen aan bestuursleden."
                            },
                            {
                                "example_id": "4c6736f7-bf09-4079-9203-678ed965899b",
                                "sense_id": "9a191adb-a95e-3da5-b7d8-247ca01ff8e7",
                                "text": "Het woord 'bonus' hadden ze uit hun gedachtewereld verbannen. Dat was thuis weer aan de orde."
                            }
                        ]
                    }
                ],
