                    },
                    {
                        "translation_id": "e76489d1-a7c9-4495-aafc-6b7acc95e1d0",
                        "source_entry_id": "1533b3ce-5d71-3b05-95d7-a0ba5ea8cbf6",
                        "source_sense_id": "dd88f719-80ec-3769-b87e-282aad00cf5b",
                        "target_lang_word": "lazurite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazurite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb85001-baee-3819-89e6-dedfa5ed333c",
                                        "entry_id": "a7fdaf1c-d6b9-3fb1-a4e0-13d2625d49d2",
                                        "glosses": [
                                            "A mineral of metamorphosed limestones. Lazurite forms the gemstone lapis lazuli, and crushed lazurite provided the ultramarine color in artists' paint of the Old Masters. Sodalite and lazurite form the sodalite group of silicate minerals. Chemical composition: Sodium aluminum silicate with sulphur, Na₄₋₅Al₃Si₃O₁₂S."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "460a632d-6056-47eb-a8bb-156587a95b7c",
                                                "sense_id": "bcb85001-baee-3819-89e6-dedfa5ed333c",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23aa5da4-3eba-4ed2-be3a-541523000c87",
                        "source_entry_id": "1533b3ce-5d71-3b05-95d7-a0ba5ea8cbf6",
                        "source_sense_id": "dd88f719-80ec-3769-b87e-282aad00cf5b",
                        "target_lang_word": "lapis lazuli",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapis lazuli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c525de89-ec74-3917-9a86-ed1122d5d34d",
                                        "entry_id": "7dc004b5-8bf6-38f6-8ac2-78883a2a94f0",
                                        "glosses": [
                                            "A deep blue stone, used in making jewelry, and traditionally used to make the pigment ultramarine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2d3752a-797a-42a3-b90f-c9003f73ee7f",
                                                "sense_id": "c525de89-ec74-3917-9a86-ed1122d5d34d",
                                                "text": "He saw the amber silk curtains wave to and fro: the middle window was open; in it stood a pillar of lapis lazuli, which supported an alabaster figure, Canova's Dansatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eba62064-7b07-3b94-a95b-1029fa013a23",
                                        "entry_id": "7dc004b5-8bf6-38f6-8ac2-78883a2a94f0",
                                        "glosses": [
                                            "A deep, bright blue, like that of the stone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lapis lazuli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f767bce-2077-376f-ae58-7de74598d062",
                                        "entry_id": "f21cbcb1-666e-3fc6-9c0b-2c3691c7e497",
                                        "glosses": [
                                            "Of a deep, bright blue, like that of the stone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63618a59-8871-4710-8d99-58e5d8ccc25e",
                                                "sense_id": "1f767bce-2077-376f-ae58-7de74598d062",
                                                "text": "I cannot convey to you the sheer and surreal scale of everything: the towering ship, the ropes, the ties, the anchor, the pier, the vast lapis lazuli dome of the sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69d0b70f-cb4a-4053-9939-64fcaef47706",
                        "source_entry_id": "1533b3ce-5d71-3b05-95d7-a0ba5ea8cbf6",
                        "source_sense_id": "dd88f719-80ec-3769-b87e-282aad00cf5b",
                        "target_lang_word": "lapis-lazuli",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapis-lazuli",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                        "entry_id": "54f4262d-0574-36f0-8f0d-516c0c788b93",
                                        "glosses": [
                                            "Roche métamorphique, contenant des silicates du groupe des feldspathoïdes, utilisée comme pierre ornementale ou pour la confection de bijoux, qui est dure et raye le verre, opaque, de couleur bleue, entre l’azur et l’outremer et ordinairement parsemée de petites veines de pyrite semblables à de l’or."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefac0a3-dc14-4342-993c-e8689972b630",
                                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                                "text": "Sur sa tête, une coiffe aux larges plis retombant sur les épaules, le némès, est d’or incrusté de lapis-lazuli."
                                            },
                                            {
                                                "example_id": "3cddad17-6e36-4b4e-a388-6860ef87b236",
                                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                                "text": "[…] ; le médaillon de lapis-lazuli, attaché par une chaînette d’or à son poignet, de temps à autre sonnait contre son assiette."
                                            },
                                            {
                                                "example_id": "61e7ecf2-2565-4be9-9a23-c62a45f13967",
                                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                                "text": "Le lac, maintenant, semblait en lapis-lazuli."
                                            },
                                            {
                                                "example_id": "2567dc53-e93e-4c8c-9253-4b4e5f5a73bd",
                                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                                "text": "Seul son regard de lapis-lazuli (j’ai eu un bijoutier dans mes relations) anime sa figure émouvante."
                                            },
                                            {
                                                "example_id": "af4bd48f-0436-4bf9-ad58-b4f31dd713c2",
                                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                                "text": "L’outremer naturel, qu’on obtient à partir du lapis-lazuli, et la laque, dont les qualités les plus recherchées proviennent de la cochenille ou du kermès, étaient en effet les pigments les plus précieux de la palette des peintres de l’époque, en raison de leur intensité et des effets qu’ils permettaient d’obtenir, notamment dans les glacis."
                                            },
                                            {
                                                "example_id": "9c65debd-0a69-4380-a9a0-e805587ca038",
                                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                                "text": "Quant au bleu à droite de la tête du Christ (10460), les analyses MEB/EDS révèlent de fortes proportions de sodium, aluminium, silicium et soufre qui sont quatre éléments composant la lazurite (Na₈₋₁₀Al₆O₂₄S₂₋₈), un des constituants du lapis-lazuli (Plesters, 1966)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lapis-lazuli",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75070b04-6d8f-357d-8b7e-05a4396ee23e",
                                        "entry_id": "669f5b74-1314-3bcc-9811-b99eef3c6afc",
                                        "glosses": [
                                            "De la couleur bleu azur profond de la pierre du même nom. #26619C"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3667576f-5a94-4d3c-91ca-f6710e89e9eb",
                                                "sense_id": "75070b04-6d8f-357d-8b7e-05a4396ee23e",
                                                "text": "D’un ample mouvement du bras, il désigna l’interminable plage de sable fin et l’Océan dont la surface lapis-lazuli se confondait à l’horizon avec l’azur du ciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
