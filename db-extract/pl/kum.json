                                    {
                                        "sense_id": "d0aa289b-4915-3fa4-8a4d-026e64aebf73",
                                        "entry_id": "98764230-7b2b-3018-80e1-7e07063ad838",
                                        "glosses": [
                                            "The vocal sound made by a frog or toad."
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bddd29c9-192c-40b0-884e-1603765707bc",
                                                "sense_id": "d0aa289b-4915-3fa4-8a4d-026e64aebf73",
                                                "text": "Widow Toad: Looks kinds puny to me. Looks like a breeze could carry her off. Ribbit, ribbit. Maybe she could cook and clean my house."
                                            },
                                            {
                                                "example_id": "8e7a41ab-412c-4406-83f3-b6255252baae",
                                                "sense_id": "d0aa289b-4915-3fa4-8a4d-026e64aebf73",
                                                "text": "Frogs croaking ribbit, ribbit\nTrees rustling sssshh, ssshh\nWater rushing over rapids splash, clash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c59fed7e-26ce-3ab0-998b-334dd1f6b2ee",
                                        "entry_id": "98764230-7b2b-3018-80e1-7e07063ad838",
                                        "glosses": [
                                            "Used to anonymously and disrespectfully break silence, as in educational or ceremonial settings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a21c1019-d065-4ca6-9726-3bd8c0697891",
                                                "sense_id": "c59fed7e-26ce-3ab0-998b-334dd1f6b2ee",
                                                "text": "The students fell momentarily silent while he finished writing on the board. Then, \"Ribbit!\""
                                            }
                                        ]
                                    }
                                ]
