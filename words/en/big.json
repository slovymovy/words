                            {
                                "target_lang_word": "старший",
                                "target_lang_sense_clarification": "о брате или сестре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "766f9446-5ca5-3126-914d-4fca2312af90",
                    "sense_definition": "Important, significant, or serious.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tomorrow is a <w>big</w> day because I have my final exam.",
                            "target_lang_translations": {
                                "ru": "Завтра <w>важный</w> день, потому что у меня выпускной экзамен."
                            }
                        },
                        {
                            "text": "Winning the championship was a <w>big</w> deal for the whole team.",
                            "target_lang_translations": {
                                "ru": "Победа в чемпионате была <w>большим</w> событием для всей команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "important",
                        "significant",
                        "major",
                        "critical",
                        "pivotal"
                    ],
                    "common_phrases": [
                        "big day",
                        "big deal",
                        "big decision",
                        "big news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важный, значительный или серьезный."
