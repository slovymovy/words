                    "sense_id": "580b1e86-f107-3be0-a9bb-ac2026d1fbd1",
                    "sense_definition": "A surname from Cantonese or Hakka.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Fung</w> delivered an insightful lecture on Chinese history yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера профессор <w>Фун</w> прочитал содержательную лекцию по истории Китая."
                            }
                        },
                        {
                            "text": "I received an email from Mr. <w>Fung</w> regarding the schedule for tomorrow.",
                            "target_lang_translations": {
                                "ru": "Я получил письмо от господина <w>Фуна</w> по поводу завтрашнего расписания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Cantonese or Hakka origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия кантонского или хакка происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фун",
                                "target_lang_sense_clarification": "китайская фамилия"
                            },
                            {
                                "target_lang_word": "Фунг",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9bf3922-b596-3c3f-b5e1-78bd7ce9973e",
                    "sense_definition": "Fungus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The damp wood was covered in a strange kind of <w>fung</w>.",
                            "target_lang_translations": {
                                "ru": "Влажная древесина была покрыта странным <w>грибком</w>."
                            }
                        },
                        {
                            "text": "He tried to clean the garden bench to remove the creeping <w>fung</w>.",
                            "target_lang_translations": {
                                "ru": "Он попытался очистить садовую скамейку, чтобы удалить разросшуюся <w>плесень</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "shortening of fungus"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение от fungus: грибок, плесень."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грибок",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            },
                            {
                                "target_lang_word": "плесень",
                                "target_lang_sense_clarification": "налёт грибка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46d498b8-7315-3a61-be91-81b9466cd85c",
                    "sense_definition": "Alternative form of <w>fum</w> (“fabulous Chinese bird”).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tapestry featured an embroidery depicting a mythical <w>fung</w>.",
                            "target_lang_translations": {
                                "ru": "На старинном гобелене была вышивка с изображением мифической птицы <w>фэнхуан</w>."
                            }
                        },
                        {
                            "text": "Stories often pair the dragon with the fabulous <w>fung</w> as symbols of harmony.",
                            "target_lang_translations": {
                                "ru": "В преданиях дракон часто предстает в паре со сказочной птицей <w>фэнхуан</w> как символ гармонии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative form of fum"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова fum (мифическая китайская птица фэнхуан)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фэнхуан",
                                "target_lang_sense_clarification": "китайский феникс"
                            },
                            {
                                "target_lang_word": "птица фун",
                                "target_lang_sense_clarification": "мифическая птица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7729152d-394f-3810-b690-f0cdde7a07bb",
                    "sense_definition": "A member of the Fungor, a Sudanese ethnic group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The anthropologist interviewed a local <w>Fung</w> to learn about their traditions.",
                            "target_lang_translations": {
                                "ru": "Антрополог взял интервью у местного представителя народа <w>фундж</w>, чтобы узнать об их традициях."
                            }
                        },
                        {
                            "text": "Scholars studied the cultural heritage of the <w>Fung</w> community in Sudan.",
                            "target_lang_translations": {
                                "ru": "Учёные исследовали культурное наследие общины <w>фундж</w> в Судане."
                            }
                        }
                    ],
                    "synonyms": [
                        "Fungor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель фундж (фунгор), суданской этнической группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фундж",
                                "target_lang_sense_clarification": "представитель народа Судана"
                            }
                        ]
                    }
                }
            ]
        }
