                                "target_senses": [
                                    {
                                        "sense_id": "ddc26f7a-3a1d-36e1-b59a-d652a638e895",
                                        "entry_id": "77882a49-89c1-3ba8-92e2-4e23b4e9e26a",
                                        "glosses": [
                                            "The process by which new distinct species evolve."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8548025-6784-4e4f-8328-872c454f0443",
                                                "sense_id": "ddc26f7a-3a1d-36e1-b59a-d652a638e895",
                                                "text": "In both groups, however, we find copious and intricate speciation so that, often, species limits are narrow and ill defined."
                                            },
                                            {
                                                "example_id": "6998cd6c-bb57-4a20-b1de-bf4007c2a2f0",
                                                "sense_id": "ddc26f7a-3a1d-36e1-b59a-d652a638e895",
                                                "text": "No one had ever seen a new species produced, nor, according to Darwin, should they expect to. Speciation was so drawn out as to be, for all intents and purposes unobservable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62d02e0d-a62c-384d-9959-da250ac0c544",
                                        "entry_id": "77882a49-89c1-3ba8-92e2-4e23b4e9e26a",
                                        "glosses": [
                                            "The formation of different (inorganic) species (especially of ions) as the environment changes."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "951cbb9f-aff1-3393-a058-5444fada210c",
                                        "entry_id": "77882a49-89c1-3ba8-92e2-4e23b4e9e26a",
                                        "glosses": [
                                            "The determination of which species are present in a fluid or tissue specimen, bacterial culture, or viral culture."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64d9932c-e57e-4a7b-8fe6-14f899c6deb7",
                                                "sense_id": "951cbb9f-aff1-3393-a058-5444fada210c",
                                                "text": "requirements specifying speciation and serotyping in addition to reporting of presence or absence"
                                            }
                                        ]
                                    }
                                ]
