                "senses": [
                    {
                        "sense_id": "a86397ab-48a6-3af8-a35d-e5522f8c4126",
                        "entry_id": "87a6c3d5-0a71-3c38-af32-10147db9fd90",
                        "glosses": [
                            "To stud or adorn with stars or other brilliants; to star."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d227a4-4774-407e-a4eb-943c910d3235",
                                "sense_id": "a86397ab-48a6-3af8-a35d-e5522f8c4126",
                                "text": "Yet mark with shining steps the humbler way;\nAnd, as angelic feet instar the sky,\nDrop the bright sparks along the wilderness."
                            },
                            {
                                "example_id": "2302a325-39df-4876-9f5e-d78a44031b77",
                                "sense_id": "a86397ab-48a6-3af8-a35d-e5522f8c4126",
                                "text": "Espey could distinguish through the clear darkness the fringed branches of a pine-tree clinging to the heights above and waving against the instarred sky, and below a vague moving whiteness […]"
                            },
                            {
                                "example_id": "fbef26bb-2ac4-4244-9fcf-e9eb275789f4",
                                "sense_id": "a86397ab-48a6-3af8-a35d-e5522f8c4126",
                                "text": "He was dreaming, surely; or were those deep, instarred eyes really fixed upon him with that wistful gaze which he had seen only twice before?"
                            }
                        ]
                    },
                    {
                        "sense_id": "1880bca1-8192-31ba-bb20-8ad4e243c4c4",
                        "entry_id": "87a6c3d5-0a71-3c38-af32-10147db9fd90",
                        "glosses": [
                            "To make a star of; set as a star."
                        ],
                        "tags": [
                            "transitive"
                        ],
