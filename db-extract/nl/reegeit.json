                        "examples": [
                            {
                                "example_id": "b3372929-acf2-4d42-b4d7-3a64af604eac",
                                "sense_id": "00e76e03-3450-3966-913b-ec90a3d0da80",
                                "text": "Jack Amels en Johan Steenbergen van de Dierenambulance zijn vrijdagmorgen om tien voor half negen bij een dode reegeit geroepen. Het driejarige dier dat drachtig was, lag dood in een weiland op de Oldenzaalse stuwwal, 500 meter van de Schapendijk in Zuid-Berghuizen."
                            },
                            {
                                "example_id": "5e99a970-1e56-4b00-814c-026cfd91d737",
                                "sense_id": "00e76e03-3450-3966-913b-ec90a3d0da80",
                                "text": "Loslopende honden teisteren het wild in de Gelderse bossen. Dat meldt De Gelderlander vandaag. In de buurt van Nijmegen werd deze week een voldrachtige reegeit door honden dusdanig verwond dat het dier moest worden afgemaakt. Haar drie geitjes overleefden het ook niet."
                            }
                        ]
                    }
