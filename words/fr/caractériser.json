                {
                    "sense_id": "2193a316-509c-313f-83e6-70c6197f5e0b",
                    "sense_definition": "Constituer le caractère propre, essentiel ou distinctif d'une personne ou d'une chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une grande curiosité d'esprit <w>caractérise</w> ce jeune chercheur passionné par la science."
                        },
                        {
                            "text": "La recherche constante d'harmonie <w>caractérise</w> l'ensemble de ses peintures."
                        }
                    ],
                    "synonyms": [
                        "distinguer",
                        "particulariser"
                    ]
                },
                {
                    "sense_id": "9b9bbe6a-0fb5-377b-8a24-5ca38abba993",
                    "sense_definition": "Avoir pour signe distinctif ou se distinguer par une propriété particulière.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "propriete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette région se <w>caractérise</w> par un climat particulièrement doux en hiver."
                        },
                        {
                            "text": "Les arbres résineux se <w>caractérisent</w> par leurs aiguilles persistantes."
                        }
                    ],
                    "common_phrases": [
                        "se caractériser par"
                    ]
                },
                {
                    "sense_id": "c4d6cde6-e042-34d3-98a5-7f36e0fe1f42",
                    "sense_definition": "Définir ou décrire une personne ou une chose par ses traits distinctifs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "definition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a pris le temps de <w>caractériser</w> les symptômes observés chez son patient."
                        },
                        {
                            "text": "Cette étude scientifique cherche à <w>caractériser</w> précisément les effets de la pollution."
                        }
                    ],
                    "common_phrases": [
