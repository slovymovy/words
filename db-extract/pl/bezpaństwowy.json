                                                "example_id": "1411490a-1bd3-481f-930e-88b0026f643b",
                                                "sense_id": "8d915b52-4ca5-31f1-8d51-47bf6ced96d6",
                                                "text": "Nach dem Krieg waren sie staatenlos."
                                            },
