                        {
                            "text": "Dat <w>vreselijke</w> ongeval veroorzaakte verslagenheid alom.",
                            "target_lang_translations": {
                                "en": "That <w>terrible</w> accident caused widespread dismay.",
                                "ru": "Эта <w>ужасная</w> авария вызвала всеобщее смятение.",
                                "de": "Dieser <w>schreckliche</w> Unfall verursachte überall Bestürzung.",
                                "it": "Quel <w>terribile</w> incidente ha causato sgomento ovunque.",
                                "pl": "Ten <w>straszny</w> wypadek wywołał powszechne przygnębienie.",
                                "fr": "Ce <w>terrible</w> accident a causé une consternation générale.",
                                "cs": "Ta <w>hrozná</w> nehoda způsobila všeobecné zděšení.",
                                "tr": "O <w>korkunç</w> kaza her yerde üzüntüye neden oldu.",
                                "es": "Aquel <w>terrible</w> accidente causó consternación por todas partes.",
                                "zh": "那场<w>可怕的</w>事故引起了普遍的沮丧。"
                            }
                        },
                        {
                            "text": "Ik vind het een <w>vreselijk</w> idee dat we daar alleen moeten blijven.",
                            "target_lang_translations": {
                                "en": "I think it's a <w>horrible</w> idea that we have to stay there alone.",
                                "ru": "Мне кажется <w>ужасной</w> мысль о том, что нам придется остаться там одним.",
                                "de": "Ich finde es eine <w>furchtbare</w> Vorstellung, dass wir dort alleine bleiben müssen.",
                                "it": "Trovo che sia un'idea <w>orribile</w> dover restare lì da soli.",
                                "pl": "Uważam za <w>okropny</w> pomysł, że musimy tam zostać sami.",
                                "fr": "Je trouve que c'est une <w>horrible</w> idée de devoir rester là-bas tout seuls.",
                                "cs": "Přijde mi jako <w>hrozná</w> představa, že tam musíme zůstat sami.",
                                "tr": "Orada yalnız kalmamız gerektiği fikrini <w>berbat</w> buluyorum.",
                                "es": "Me parece una idea <w>horrible</w> que tengamos que quedarnos allí solos.",
                                "zh": "我觉得我们必须独自留在那里的想法真是<w>糟糕透顶</w>。"
                            }
