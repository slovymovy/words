                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2401faf-7aa7-4e72-826e-75a2b89cd79d",
                                                "sense_id": "6bec02bd-cb22-3fd1-9cdb-6a3c831a7c93",
                                                "text": "The idea is to reach the 21st level of an enormous network of interlocking screens, each of which is covered with blocks that you bounce along on."
                                            },
                                            {
                                                "example_id": "cdc636fa-66ce-4a61-b58f-09f78364a30c",
                                                "sense_id": "6bec02bd-cb22-3fd1-9cdb-6a3c831a7c93",
                                                "text": "Bub and Bob, the brontosaur buddies, must battle bullies by bursting their bubbles. One or two players can move through 100 screens of arcade-style graphics."
                                            }
                                        ]
                                    },
                                    {
