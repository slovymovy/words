                        "entry_id": "6db1688b-20d6-3c51-8f2d-8ffc87b018f9",
                        "glosses": [
                            "alles wat betrekking heeft op de (financiële) administratie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c702f70-a905-4088-87eb-04b4a9ff99fb",
                                "sense_id": "6e824047-24d4-3195-88f3-d85a00bf4cbf",
                                "text": "Een goede boekhouding is van groot belang voor ieder bedrijf."
                            }
                        ]
                    },
                    {
                        "sense_id": "bacfbd20-21a1-3818-a17e-c48fa1bc88cd",
                        "entry_id": "6db1688b-20d6-3c51-8f2d-8ffc87b018f9",
