                ],
                "senses": [
                    {
                        "sense_id": "9cb2525c-b50b-3b2c-91a2-fecbda293a0e",
                        "entry_id": "57863987-fdec-376f-b55c-275d27ae6455",
                        "glosses": [
                            "Unité de mesure d’énergie, équivalant à une puissance d’un mégawatt agissant pendant une heure, soit 3,6 gigajoules, et dont le symbole est MWh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743b9fc9-3b03-4ba5-b093-b5f1fcdb1152",
                                "sense_id": "9cb2525c-b50b-3b2c-91a2-fecbda293a0e",
                                "text": "Cette taxe s’élevait auparavant à près de 26 € le mégawattheure."
                            },
                            {
                                "example_id": "5922036d-bf3b-406e-a97e-4d53543ea6c7",
                                "sense_id": "9cb2525c-b50b-3b2c-91a2-fecbda293a0e",
                                "text": "Le coût moyen à long terme (hors transport) est d’environ 25 euros par mégawattheure pour le nucléaire, 30 pour le charbon, 40 pour le gaz, 50 pour l’éolien terrestre et plus de 250 pour le solaire."
                            },
                            {
                                "example_id": "7d20ddce-4f5a-4057-9496-59bacb0c854b",
                                "sense_id": "9cb2525c-b50b-3b2c-91a2-fecbda293a0e",
                                "text": "Il a assuré que les fournisseurs des TPE ne feraient pas payer plus de 280 € le mégawattheure en moyenne cette année."
                            }
                        ]
                    }
                ],
