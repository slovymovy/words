                                        "entry_id": "d193e615-df88-3f00-81c5-6b95227e8b07",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 77, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e50e43-9e6d-4d59-9ee0-60592af46c8a",
                                                "sense_id": "fe83eaf8-7d89-3cea-8e0b-9c362c1cf7ea",
                                                "text": "Iridium hat eine extrem hohe Dichte."
                                            },
                                            {
                                                "example_id": "27996a63-8273-43d1-bc75-f8f03584f115",
                                                "sense_id": "fe83eaf8-7d89-3cea-8e0b-9c362c1cf7ea",
                                                "text": "„Iridium ist oft Bestandteil von Legierungen, denen es Härte und/oder Sprödigkeit verleiht.“"
                                            },
                                            {
                                                "example_id": "a9177301-cc3e-4823-9606-089125851796",
                                                "sense_id": "fe83eaf8-7d89-3cea-8e0b-9c362c1cf7ea",
                                                "text": "„Platin beschleunigt Prozesse in Brennstoffzellen, Iridium in Elektrolyseuren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ea67a53-0902-49aa-ba51-e99065150fa8",
