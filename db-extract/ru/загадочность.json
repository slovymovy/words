                "senses": [
                    {
                        "sense_id": "8b14e290-b2b7-3c6c-9e7e-e7e09e21a30c",
                        "entry_id": "a4937823-7afd-3ecb-b0d9-62e9eaa4e112",
                        "glosses": [
                            "свойство по значению прилагательного загадочный"
                        ],
                        "tags": [],
