                    {
                        "translation_id": "0fffe7c7-7197-401c-b02f-a7506994284b",
                        "source_entry_id": "47d5ba0e-5723-3867-b3eb-6989668599b6",
                        "source_sense_id": "fc15aeb1-57b6-3902-afce-37af6c9df526",
                        "source_sense_description": "Physik: Temperatur, bei der ein gasförmiger Stoff in den flüssigen Aggregatzustand übergeht",
                        "target_lang_word": "point de rosée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point de rosée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf540b84-8105-34f4-a5a9-528c646fd3ab",
                                        "entry_id": "f7a5bdab-41a7-3d32-9687-fedd778f4026",
                                        "glosses": [
                                            "Température en dessous de laquelle l’eau apparaît en phase liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdd5880-5a9f-4d84-a279-0c811de78168",
                                                "sense_id": "cf540b84-8105-34f4-a5a9-528c646fd3ab",
                                                "text": "C’est par condensation que la brume, les nuages et la rosée se forment quand le point de rosée est atteint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53df009-e8ce-3a4a-a6a8-c4feee161a0d",
                                        "entry_id": "f7a5bdab-41a7-3d32-9687-fedd778f4026",
                                        "glosses": [
                                            "Température en dessous de laquelle toute vapeur (dont l’eau) se condense en phase liquide."
                                        ],
                                        "tags": [
                                            "generically",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "234ab198-688a-4752-a3aa-40bfc678a0ab",
                                                "sense_id": "c53df009-e8ce-3a4a-a6a8-c4feee161a0d",
                                                "text": "Le Condumax II est conçu pour la mesure continue automatique du point de rosée des hydrocarbures et du point de rosée de l’eau du gaz naturel traité. Il est le résultat de plus de 30 ans d’expérience dans la fourniture d’analyseurs aux industries pétrochimiques, gazières et pétrolières du monde entier. Le système consiste en une cellule avec capteur pour la mesure du point de rosée des hydrocarbures et de commandes électroniques logées dans un boîtier Exd (résistant aux explosions). En option, un capteur pour la mesure du point de rosée de l’eau peut être installé au moment de la fabrication ou après en option complémentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
