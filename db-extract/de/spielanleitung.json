                ],
                "senses": [
                    {
                        "sense_id": "0cafa3f4-8c1b-3591-ade2-f0cde40aeef1",
                        "entry_id": "6d4d0d25-aff3-3d2e-a74f-1467a4db0c14",
                        "glosses": [
                            "detaillierte Beschreibung oder praktische Hilfe zur Durchführung eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6431712a-6975-4f1b-b98b-0b7f105ec79e",
                                "sense_id": "0cafa3f4-8c1b-3591-ade2-f0cde40aeef1",
                                "text": "„Während im didaktischen Spiel die Bildungsaufgabe und der Inhalt den Kindern gegeben wird, nutzt die Erzieherin im schöpferischen Spiel den von den Kindern in das Spiel hineingetragenen Inhalt für bildende und erzieherische Wirkungen durch eine geschickte Spielanleitung aus.“"
                            },
                            {
                                "example_id": "51c6358b-d6b2-431d-a162-aacecb3436b4",
                                "sense_id": "0cafa3f4-8c1b-3591-ade2-f0cde40aeef1",
                                "text": "„Um ein drohendes Verfahren vor der Bundesprüfstelle für jugendgefährdende Schriften zu vermeiden, entschloß sich der Herausgeber, den aggressiven Ton in der Spielbeschreibung und Spielanleitung zu ändern.“"
                            },
                            {
                                "example_id": "789ca4f1-2ffb-4267-9307-5e3cf210eb1b",
                                "sense_id": "0cafa3f4-8c1b-3591-ade2-f0cde40aeef1",
                                "text": "„Es ist heute amüsant, wie einst die Hersteller ihre Kunden in der Spielanleitung schuriegelten.“"
                            },
                            {
                                "example_id": "b6982850-31ba-431c-85dd-d5fe7482f0a7",
                                "sense_id": "0cafa3f4-8c1b-3591-ade2-f0cde40aeef1",
                                "text": "„Die immer wiederkehrenden Hinweise Spielen und Experimentiere sind zwar eindeutig Spielanleitungen für Kinder, die mit dieser Hilfe zum Beispiel einen Insektenstaubsauger basteln lernen.“"
                            },
                            {
                                "example_id": "3ab738a2-f405-4e2f-9181-8506fc7c02ba",
                                "sense_id": "0cafa3f4-8c1b-3591-ade2-f0cde40aeef1",
                                "text": "„Die Fraunhofer-Entwicklung aus Thüringen wandelt das Lieblingslied in Noten samt Spielanleitung um und überwacht, dass der Schüler den Song korrekt nachspielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
