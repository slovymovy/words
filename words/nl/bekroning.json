            "senses": [
                {
                    "sense_id": "7b22bda6-5eb5-3f79-b25e-e40177414f54",
                    "sense_definition": "toekenning van een prijs of onderscheiding als eerbetoon",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
