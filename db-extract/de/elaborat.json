                                        "sense_id": "06281bb8-d439-3418-a031-c992fb7211b4",
                                        "entry_id": "bfa76e99-98c4-3b7f-af45-031730c1d107",
                                        "glosses": [
                                            "The preparing of a medicine, food or other substance out of many ingredients."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a231a96-aefd-4826-8acb-351f0a443863",
                                                "sense_id": "06281bb8-d439-3418-a031-c992fb7211b4",
                                                "text": "Salt is a very favoured ingredient of spell-binding concoctions."
                                            },
                                            {
                                                "example_id": "0a124fbc-a587-4a2d-b2da-2a7fd258ee96",
                                                "sense_id": "06281bb8-d439-3418-a031-c992fb7211b4",
                                                "text": "Deer Sperm: In ancient times, this was used as an ingredient on aphrodisiac concoctions. An example of organotherapy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aab89f2-eec5-389f-ac88-3824787c4dbc",
                                        "entry_id": "bfa76e99-98c4-3b7f-af45-031730c1d107",
                                        "glosses": [
                                            "A mixture prepared in such a way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73ded701-c05d-3cc8-8137-49c314f0af77",
                                        "entry_id": "bfa76e99-98c4-3b7f-af45-031730c1d107",
                                        "glosses": [
                                            "Something made up, an invention."
                                        ],
                                        "tags": [
