                    {
                        "sense_id": "207d090d-400b-3974-a690-6edafc3d9146",
                        "entry_id": "b0576a0c-58ff-3c6e-a614-32302be13903",
                        "glosses": [
                            "höherer militärischer Rang des Obersten/Träger dieses Rangs"
