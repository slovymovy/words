                                                "example_id": "4a45c37d-1ed4-4391-a4c7-76775b1f484e",
                                                "sense_id": "4b7b1f29-d440-33bf-90c9-3e363097368e",
                                                "text": "„Die Landwirtschaft ist nach wie vor der dominierende Wirtschaftszweig der Elfenbeinküste.“"
                                            },
