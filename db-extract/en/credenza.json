                "senses": [
                    {
                        "sense_id": "69ece79a-bb7e-3dcc-a9f6-77f6d3c5bd0d",
                        "entry_id": "852897c5-7a83-3f25-b366-2da6cdf4f2ed",
                        "glosses": [
                            "A sideboard or buffet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8301ec34-9e3e-49f2-a45d-402fa9d48eb2",
                                "sense_id": "69ece79a-bb7e-3dcc-a9f6-77f6d3c5bd0d",
                                "text": "Two credenze dating about the middle of the century, shown in Figures 135 and 136, illustrate the stage of excessive ornamentation of furniture reached about this time."
                            },
                            {
                                "example_id": "7fba55e6-a074-4bbd-8250-e4f25b12b498",
                                "sense_id": "69ece79a-bb7e-3dcc-a9f6-77f6d3c5bd0d",
                                "text": "The furniture consists of many fine small and large cabinets, credenze and tables, all especially alluring and of unusual types not very frequently found today; […]"
                            },
                            {
                                "example_id": "b6665282-50ef-48fc-90e4-3cae040ea0e9",
                                "sense_id": "69ece79a-bb7e-3dcc-a9f6-77f6d3c5bd0d",
                                "text": "A recessed top story containing a cupboard was added to many credenze in the 16th cent. and this was usual in subsequent periods."
                            },
                            {
                                "example_id": "2e293328-39ef-4977-a305-ab49379222b0",
                                "sense_id": "69ece79a-bb7e-3dcc-a9f6-77f6d3c5bd0d",
                                "text": "It was as if Belonging lay in some ivory-inlaid credenza in the^([sic]) Hague, waiting to be opened before expiration date."
                            }
                        ]
                    },
                    {
                        "sense_id": "46ca18b4-3d37-312c-98d5-04464da764eb",
                        "entry_id": "852897c5-7a83-3f25-b366-2da6cdf4f2ed",
                        "glosses": [
                            "A horizontal filing cabinet, typically placed behind a desk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd12806-937a-4fe8-bf7d-9d73248890ef",
                                "sense_id": "46ca18b4-3d37-312c-98d5-04464da764eb",
                                "text": "I wandered over to his record collection, past his mantel displaying mid-century lighters, past his closet filled with trench coats and shoehorns, past his credenza stacked with pamphlets."
                            }
                        ]
                    }
