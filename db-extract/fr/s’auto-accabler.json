                "senses": [
                    {
                        "sense_id": "ad84440e-2cd0-3bc8-8674-bdda819b92cf",
                        "entry_id": "064a0842-451a-3acf-8679-bdf4e4ae1ce8",
                        "glosses": [
                            "S’accabler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a807f29-fe76-4fb3-a66d-7e7f8c4fd834",
                                "sense_id": "ad84440e-2cd0-3bc8-8674-bdda819b92cf",
                                "text": "S'auto-accabler (se culpabiliser et s'isoler soi-même)."
                            },
                            {
                                "example_id": "b8088f90-90da-4e31-a3c1-18f16a629a38",
                                "sense_id": "ad84440e-2cd0-3bc8-8674-bdda819b92cf",
                                "text": "A force, c'est encore plus pénible de m'entendre demander si j'ai eu tort, si je suis allée trop loin, et de m'auto-accabler de reproches."
                            },
                            {
                                "example_id": "04eb0b56-9666-48da-8592-3d544cfa4800",
                                "sense_id": "ad84440e-2cd0-3bc8-8674-bdda819b92cf",
                                "text": "Très français de s'auto-accabler, voir des lâches et des traitres partout."
                            }
                        ]
                    }
