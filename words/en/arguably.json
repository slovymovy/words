    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "41c15524-fd01-3404-9f0d-5cba1352e3ac",
                    "sense_definition": "Used when stating an opinion that can be supported by evidence or logic, even if it is not certain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is <w>arguably</w> the best performance the actor has ever given in his career.",
                            "target_lang_translations": {
                                "ru": "Это, <w>пожалуй</w>, лучшая роль в карьере этого актера.",
                                "es": "Esta es, <w>posiblemente</w>, la mejor actuación que el actor ha ofrecido en su carrera."
                            }
                        },
                        {
                            "text": "The new policy is <w>arguably</w> the most important reform of the last decade.",
                            "target_lang_translations": {
                                "ru": "Новая политика — <w>пожалуй</w>, самая важная реформа за последнее десятилетие.",
                                "es": "La nueva política es <w>probablemente</w> la reforma más importante de la última década."
                            }
                        }
                    ],
                    "synonyms": [
                        "possibly",
                        "defensibly",
                        "disputably"
                    ],
                    "antonyms": [
                        "unarguably",
                        "indisputably",
                        "certainly"
                    ],
                    "common_phrases": [
                        "arguably a better name",
                        "arguably the most important",
                        "arguably the best"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется при высказывании мнения, которое может быть подтверждено фактами или логикой, даже если оно не является бесспорным.",
                        "es": "Se usa al expresar una opinión que puede respaldarse con argumentos o pruebas, aunque no sea totalmente indiscutible."
                    },
