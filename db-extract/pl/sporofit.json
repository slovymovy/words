                            {
                                "example_id": "27bae8f5-167e-4fa2-a06f-69c43f1b8df2",
                                "sense_id": "a881e976-29be-3723-8ea2-54c270ac1ad7",
                                "text": "U roślin naczyniowych sporofit jest znacznie większy niż gametofit, jest też stadium zdolnym do samodzielnego istnienia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
