                        "source_entry_id": "62f9b76e-9510-3dfc-b2c7-e5ec06c62d9c",
                        "source_sense_id": "43233e0f-2fc2-3dc9-aded-97544a55896f",
                        "source_sense_description": "kurz für Strafvollzugsanstalt; (staatliche) Einrichtung zum Strafvollzug, zur Strafverbüßung",
                        "target_lang_word": "prison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01d5a20d-d653-39d6-9b9c-9d06da1a7400",
                                        "entry_id": "caa2b888-c061-3d67-8a37-d9c137e821e6",
                                        "glosses": [
                                            "Endroit clos où sont enfermées les personnes condamnées à une peine de privation de liberté ou les prévenus en attente de jugement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce88d814-007e-41fa-bd5f-6bdde92a9941",
                                                "sense_id": "01d5a20d-d653-39d6-9b9c-9d06da1a7400",
                                                "text": "Une insulte faite au baylon (syndic) est punie d’une amende de dix écus, et même de la prison, à la diligence du viguier ; le délinquant ne sortait de prison que sur l’intervention du syndic."
                                            },
                                            {
                                                "example_id": "f6714b86-43d2-4eca-868d-7b6d2e126f57",
                                                "sense_id": "01d5a20d-d653-39d6-9b9c-9d06da1a7400",
                                                "text": "Nos terroristes du quinzième et du seizième siècle ont été des moines. Les prisons monastiques furent toujours les plus cruelles."
                                            },
                                            {
                                                "example_id": "a8128044-b352-4ab1-a9d7-94c4f238ebc5",
                                                "sense_id": "01d5a20d-d653-39d6-9b9c-9d06da1a7400",
                                                "text": "Tout s’est modernisé, et il y a de tout, sauf des gendarmes et des prisons, car le crime est encore inconnu."
                                            },
                                            {
                                                "example_id": "74847480-1f1a-464a-abee-b426b4a033f7",
                                                "sense_id": "01d5a20d-d653-39d6-9b9c-9d06da1a7400",
                                                "text": "La plupart de ces messieurs que tu vois là, autour de nous, s’enorgueillissent de casiers judiciaires confortables… Ils sortent de prison ou vont y entrer. Ce sont les risques du métier, Mais le métier a du bon."
                                            },
                                            {
                                                "example_id": "4864ace8-a7a5-4720-bdfa-af65ac786765",
                                                "sense_id": "01d5a20d-d653-39d6-9b9c-9d06da1a7400",
                                                "text": "Il entre en prison pour vol de voiture et en sort pour bonne conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d5eca4-1edd-3fef-b7bb-965aefeceb1e",
                                        "entry_id": "caa2b888-c061-3d67-8a37-d9c137e821e6",
                                        "glosses": [
                                            "Peine afflictive subie dans un tel lieu ; emprisonnement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd95cfb-c662-413c-b205-461891c0e79b",
                                                "sense_id": "42d5eca4-1edd-3fef-b7bb-965aefeceb1e",
                                                "text": "Ces gens-là savent bien qu’ils sont exposés à des dommages-intérêts et même à la prison ; mais que leur importe ? ils ont changé d’habit, donné un faux nom et une fausse adresse et par-dessus tout ils sont insolvables."
                                            },
                                            {
                                                "example_id": "686802e8-b4b5-4fdc-a9b0-5111e80b7b70",
                                                "sense_id": "42d5eca4-1edd-3fef-b7bb-965aefeceb1e",
                                                "text": "Un travail conduit démocratiquement serait réglementé par des arrêtés, surveillé par une police et soumis à la sanction de tribunaux distribuant des amendes ou de la prison."
                                            },
                                            {
                                                "example_id": "129283da-c5a9-4655-affd-4101eacfb723",
                                                "sense_id": "42d5eca4-1edd-3fef-b7bb-965aefeceb1e",
                                                "text": "Un jour, il « chroniqua » si fort que le Parquet lui réclama des comptes. Traduit en justice pour avoir injurié les « armées de terre et de mer » et prêché la guerre civile, il s’en tira avec deux mois de prison et quelques francs d’amende."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "217b5842-f4cd-3978-a8d5-7a9783c602a4",
                                        "entry_id": "caa2b888-c061-3d67-8a37-d9c137e821e6",
                                        "glosses": [
                                            "Ce qui tient enfermé quelqu’un ou quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f89682b-257e-4a40-9474-c334483d01aa",
                                                "sense_id": "217b5842-f4cd-3978-a8d5-7a9783c602a4",
                                                "text": "La chrysalide est sortie de sa prison pour se transformer en papillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f6ef1e9-5032-3ac2-810f-f2707fcf8c02",
                                        "entry_id": "caa2b888-c061-3d67-8a37-d9c137e821e6",
                                        "glosses": [
                                            "Lieu sombre et triste."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230b4057-dcfd-4a3a-b3a4-dd1d581c05ef",
                                                "sense_id": "5f6ef1e9-5032-3ac2-810f-f2707fcf8c02",
                                                "text": "Mon arrivée au palais Pitti ? Mes premières impressions ? Quelle demeure sévère ! Quelle bâtisse sans charme ! Pour des enfants, grandir dans cette prison !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
