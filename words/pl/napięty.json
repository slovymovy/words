                        {
                            "text": "Płótno malarskie zostało starannie przygotowane i <w>napięte</w> na drewniane krosno.",
                            "target_lang_translations": {
                                "fr": "La toile à peindre a été soigneusement préparée et <w>tendue</w> sur un châssis en bois."
                            }
