                        "glosses": [
                            "Of or pertaining to society or social groups, or to their activities, customs, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f933f37-7e73-4904-b4af-79c727b5e60c",
                                "sense_id": "c3d19349-7adc-3726-a3bb-b0c8bee1f84e",
                                "text": "While H5N1 flu is obviously lethal, some milder flus pose a greater societal threat, Professor Mathews says."
                            },
                            {
                                "example_id": "7593b245-c498-4717-b40f-2bc3838425cf",
                                "sense_id": "c3d19349-7adc-3726-a3bb-b0c8bee1f84e",
                                "text": "\"It would also bring huge societal and economic benefits to all the regions of Britain, not just to London - helping the Government with its 'levelling up' agenda.\""
                            }
                        ]
