                    {
                        "sense_id": "0af8b319-dcbd-3545-ad6f-f5239ffd198a",
                        "entry_id": "584cf5f1-804d-3413-8aec-b1352ce7f074",
                        "glosses": [
                            "künstlerischer Berater bei Theater, Funk und Fernsehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2098479-3344-45d8-be18-9db92f1d51e1",
                                "sense_id": "0af8b319-dcbd-3545-ad6f-f5239ffd198a",
                                "text": "„Ich selbst war Anfang der Sechzigerjahre Dramaturg bei den Württembergischen Staatstheatern, formal »Chefdramaturg«, also für die drei Sparten des Theaters zuständig, Oper, Schauspiel und Ballett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63495edd-e0f8-4706-b0a9-353868fe6e3b",
                        "source_entry_id": "584cf5f1-804d-3413-8aec-b1352ce7f074",
                        "source_sense_id": "0af8b319-dcbd-3545-ad6f-f5239ffd198a",
                        "source_sense_description": "künstlerischer Berater bei Theater, Funk und Fernsehen",
                        "target_lang_word": "dramaturge",
