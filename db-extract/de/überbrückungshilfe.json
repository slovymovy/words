                ],
                "senses": [
                    {
                        "sense_id": "9375bd1a-fe29-3e22-b03a-fd5353185749",
                        "entry_id": "7243ea44-35ca-3445-94d0-f931d8bd3a12",
                        "glosses": [
                            "finanzielle Unterstützung für einen begrenzten Zeitraum (zum Beispiel bis ein Zustand eintritt, bei dem keine Hilfe mehr nötig ist oder aber die Anspruchsberechtigung nicht mehr vorliegt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d63726c8-ee7b-492f-9d14-48acc6131a91",
                                "sense_id": "9375bd1a-fe29-3e22-b03a-fd5353185749",
                                "text": "Die Überbrückungshilfe ist eine Barleistung der gesetzlichen Unfallversicherung."
                            },
                            {
                                "example_id": "b89e5298-6713-4e48-bfcb-28e11282d4bc",
                                "sense_id": "9375bd1a-fe29-3e22-b03a-fd5353185749",
                                "text": "„Der Nationalrat hat am Donnerstag die letzte Differenz bei der Überbrückungshilfe bereinigt. Mit dieser soll verhindert werden, dass die Betroffenen in die Sozialhilfe abrutschen.“"
                            },
                            {
                                "example_id": "9ea5255a-55fe-4a01-befd-6321d4fde575",
                                "sense_id": "9375bd1a-fe29-3e22-b03a-fd5353185749",
                                "text": "„Ebenfalls wurde vom Deutschen Bundestag beschlossen, die Überbrückungshilfen für kleine und mittelständische Unternehmen sowie Solo-Selbständige, die besonders von der Corona-Pandemie betroffen sind, fortzuführen.“"
                            },
                            {
                                "example_id": "b059ad92-acf2-448b-8094-fed3f0d30378",
                                "sense_id": "9375bd1a-fe29-3e22-b03a-fd5353185749",
                                "text": "„Kosten des privaten Lebensunterhalts wie die Miete oder Zinszahlungen für die Privatwohnung (mit Ausnahme von (anteiligen) Kosten für ein Arbeitszimmer, falls dieses 2019 bereits steuerlich geltend gemacht wurde), Krankenversicherungsbeiträge sowie Beiträge zur privaten Altersvorsorge werden nicht durch die Überbrückungshilfe abgedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
