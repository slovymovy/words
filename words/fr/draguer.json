                    ]
                },
                {
                    "sense_id": "de25441f-991e-3ded-8fa8-ea92d1a7dd53",
                    "sense_definition": "Creuser, nettoyer ou approfondir le lit d'un cours d'eau, d'un étang ou d'un port à l'aide d'une drague.",
