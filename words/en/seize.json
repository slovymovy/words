{
    "word_family": [
        "seizure",
        "seizable",
        "seizer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4d23dfe-e23c-3602-97c2-fd56d3eef932",
                    "sense_definition": "To take hold of something suddenly, firmly, and forcibly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer managed to <w>seize</w> the weapon from the suspect's hand.",
                            "target_lang_translations": {
                                "ru": "Полицейскому удалось <w>выхватить</w> оружие из руки подозреваемого.",
                                "zh": "警察设法从嫌疑人手中<w>夺取</w>了武器。"
                            }
                        },
                        {
                            "text": "She tried to <w>seize</w> his arm to stop him from falling off the edge.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>схватить</w> его за руку, чтобы он не упал с края.",
                                "zh": "她试图<w>抓住</w>他的手臂，以防他从边缘掉下去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grab",
                        "grasp",
                        "clutch",
                        "grip",
                        "clasp",
                        "snatch"
                    ],
                    "antonyms": [
                        "release",
                        "let go"
                    ],
                    "common_phrases": [
                        "seize the weapon",
                        "seize by the arm",
                        "seize hold of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схватить или взять что-то резко, крепко и с силой.",
                        "zh": "突然、用力地抓住某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "резко взять руками"
                            },
                            {
                                "target_lang_word": "захватить",
                                "target_lang_sense_clarification": "взять силой или крепко держать"
                            },
                            {
                                "target_lang_word": "выхватить",
                                "target_lang_sense_clarification": "резко отобрать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓住",
                                "target_lang_sense_clarification": "用手紧紧握住"
                            },
                            {
                                "target_lang_word": "夺取",
                                "target_lang_sense_clarification": "强行从某人手中拿走"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d44643bc-19b1-31e2-a7b7-4bc1096aa86a",
                    "sense_definition": "To take eager advantage of an opportunity or situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>seize</w> the opportunity to travel the world while you are still young.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>воспользоваться</w> возможностью путешествовать по миру, пока ты молод.",
                                "zh": "你应该趁年轻<w>把握</w>机会去环游世界。"
                            }
                        },
                        {
                            "text": "He decided to <w>seize</w> the chance to prove his worth to the new manager.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>ухватиться</w> за шанс доказать свою ценность новому управляющему.",
                                "zh": "他决定<w>利用</w>这个机会向新经理证明自己的价值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jump on"
                    ],
                    "antonyms": [
                        "miss",
                        "waste"
                    ],
                    "common_phrases": [
                        "seize the day",
                        "seize the opportunity",
                        "seize the chance",
                        "seize the moment"
                    ],
                    "target_lang_definitions": {
                        "ru": "С готовностью воспользоваться возможностью или ситуацией.",
                        "zh": "积极利用机会或局势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспользоваться",
                                "target_lang_sense_clarification": "возможностью или случаем"
                            },
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "перен. не упустить шанс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "把握",
                                "target_lang_sense_clarification": "抓住机会"
                            },
                            {
                                "target_lang_word": "利用",
                                "target_lang_sense_clarification": "使用某种情况来达到目的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52708e2d-48be-3a6a-a278-a5ebb482aa96",
                    "sense_definition": "To take possession of something using official authority, force, or legal right.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels attempted to <w>seize</w> power during the violent coup last night.",
                            "target_lang_translations": {
                                "ru": "Повстанцы попытались <w>захватить</w> власть во время жестокого переворота прошлой ночью.",
                                "zh": "叛军试图在昨晚的暴力政变中<w>夺取</w>政权。"
                            }
                        },
                        {
                            "text": "Customs officials have the authority to <w>seize</w> any illegal goods found in your luggage.",
                            "target_lang_translations": {
                                "ru": "Таможенники имеют полномочия <w>конфисковать</w> любые незаконные товары, найденные в вашем багаже.",
                                "zh": "海关官员有权<w>没收</w>在你行李中发现的任何非法物品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confiscate",
                        "commandeer",
                        "capture",
                        "arrogate",
                        "take"
                    ],
                    "antonyms": [
                        "surrender",
                        "relinquish"
                    ],
                    "common_phrases": [
                        "seize power",
                        "seize control",
                        "seize assets",
                        "seize property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завладеть чем-либо, используя официальную власть, силу или законное право.",
                        "zh": "利用官方权力、武力或法律权利占有某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватить",
                                "target_lang_sense_clarification": "власть, территорию или контроль"
                            },
                            {
                                "target_lang_word": "конфисковать",
                                "target_lang_sense_clarification": "имущество или товары по закону"
                            },
                            {
                                "target_lang_word": "изъять",
                                "target_lang_sense_clarification": "официально забрать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夺取",
                                "target_lang_sense_clarification": "强行获取权力或控制权"
                            },
                            {
                                "target_lang_word": "没收",
                                "target_lang_sense_clarification": "依法强行收缴物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9374beb-5991-3a3e-a02c-05f5c12b356c",
                    "sense_definition": "To affect someone suddenly and overwhelmingly, usually regarding an emotion or physical sensation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden panic <w>seized</w> the crowd when the fire alarm began to ring loudly.",
                            "target_lang_translations": {
                                "ru": "Внезапная паника <w>охватила</w> толпу, когда громко зазвенела пожарная сигнализация.",
                                "zh": "当火警警报大作时，一阵恐慌<w>笼罩</w>了人群。"
                            }
                        },
                        {
                            "text": "An overwhelming feeling of dread <w>seized</w> him as he walked into the abandoned house.",
                            "target_lang_translations": {
                                "ru": "Непреодолимое чувство страха <w>овладело</w> им, когда он вошел в заброшенный дом.",
                                "zh": "当他走进那座废弃的房子时，一种强烈的恐惧感<w>袭上</w>心头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overcome",
                        "overwhelm"
                    ],
                    "common_phrases": [
                        "panic seized",
                        "fear seized",
                        "terror seized"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно и сильно воздействовать на кого-либо (обычно об эмоциях или физических ощущениях).",
                        "zh": "突然且强烈地影响某人，通常指情绪或身体感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охватить",
                                "target_lang_sense_clarification": "о панике, страхе или волнении"
                            },
                            {
                                "target_lang_word": "овладеть",
                                "target_lang_sense_clarification": "полностью подчинить (о чувстве)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "指情绪像阴影一样覆盖某人"
                            },
                            {
                                "target_lang_word": "袭上",
                                "target_lang_sense_clarification": "指感觉突然涌现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "332a7196-c328-312d-add5-6379d72a7db1",
                    "sense_definition": "To become stuck, jammed, or immovable due to friction, heat, or rust (often used with 'up').",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old engine will <w>seize</w> up completely if you do not add enough oil.",
                            "target_lang_translations": {
                                "ru": "Старый двигатель полностью <w>заклинит</w>, если вы не добавите достаточно масла.",
                                "zh": "如果你不加足够的机油，旧引擎会彻底<w>卡死</w>。"
                            }
                        },
                        {
                            "text": "After years of neglect, the rusty gears finally <w>seized</w> and the machine stopped working.",
                            "target_lang_translations": {
                                "ru": "После многих лет бездействия ржавые шестерни наконец <w>заело</w>, и машина перестала работать.",
                                "zh": "经过多年的荒废，生锈的齿轮最终<w>抱死</w>，机器停止了运转。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jam",
                        "stick"
                    ],
                    "antonyms": [
                        "loosen"
                    ],
                    "common_phrases": [
                        "seize up",
                        "engine seized"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mechanical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Застрять, заклинить или стать неподвижным из-за трения, перегрева или ржавчины.",
                        "zh": "因摩擦、过热或生锈而卡住、无法移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заклинить",
                                "target_lang_sense_clarification": "о механизме или двигателе"
                            },
                            {
                                "target_lang_word": "заесть",
                                "target_lang_sense_clarification": "перестать двигаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡死",
                                "target_lang_sense_clarification": "机械部件无法转动"
                            },
                            {
                                "target_lang_word": "抱死",
                                "target_lang_sense_clarification": "指引擎或轴承因过热卡住"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}