                                    {
                                        "sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                                        "entry_id": "9b102c41-151c-359c-9334-2b65ca9abdca",
                                        "glosses": [
                                            "materia, która składa się z antycząstek, a w kontakcie ze zwykłą materią ulega anihilacji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebec968-4039-4a05-b7bc-0615613a428e",
                                                "sense_id": "8160a5b2-206d-3e17-bd37-36bdc3e8b057",
                                                "text": "Naukowcom z genewskiego CERN udało się uwięzić antymaterię."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
