{
    "word_family": [
        "kras",
        "krasser",
        "gekrast",
        "krabbelen",
        "inkrassen",
        "doorkrassen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfc63ab1-4e02-3e60-88ec-8b57cdeda409",
                    "sense_definition": "met een scherp voorwerp strepen of inkervingen maken in een oppervlak",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschadigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleuter <w>kraste</w> met haar potlood in het schrift en de ouders dachten dat het mooie figuren waren.",
                            "target_lang_translations": {
                                "en": "The toddler <w>scrawled</w> with her pencil in the notebook and the parents thought they were beautiful figures."
                            }
                        },
                        {
                            "text": "De jongen deed zijn koplamp aan waardoor de in de muur <w>gekraste</w> namen zichtbaar werden.",
                            "target_lang_translations": {
                                "en": "The boy turned on his headlamp, making the names <w>scratched</w> into the wall visible."
                            }
                        }
                    ],
                    "synonyms": [
                        "krabben",
                        "inkrassen"
                    ],
                    "common_phrases": [
                        "op de muur krassen",
                        "met een pen krassen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make lines or notches in a surface with a sharp object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to scratch",
                                "target_lang_sense_clarification": "making marks on a surface"
                            },
                            {
                                "target_lang_word": "to scrawl",
                                "target_lang_sense_clarification": "writing or drawing messily"
                            },
                            {
                                "target_lang_word": "to etch",
                                "target_lang_sense_clarification": "carving into a hard surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10c7557c-d61b-3977-af9b-9637787f9625",
                    "sense_definition": "een scherp, raspend of onaangenaam geluid maken, zoals een vogel of een stem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kraai <w>krast</w> luid in de boom, je kunt dat geluid echt geen zingen noemen.",
                            "target_lang_translations": {
                                "en": "The crow <w>caws</w> loudly in the tree; you really can't call that sound singing."
                            }
                        },
                        {
                            "text": "De oude man <w>kraste</w> met een schorre stem een paar onverstaanbare woorden.",
                            "target_lang_translations": {
                                "en": "The old man <w>croaked</w> a few unintelligible words in a hoarse voice."
                            }
                        }
                    ],
                    "synonyms": [
                        "krijsen",
                        "krassen",
                        "kraaien"
                    ],
                    "common_phrases": [
                        "een krassende stem",
                        "vogels die krassen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a sharp, rasping, or unpleasant sound, such as a bird or a voice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to croak",
                                "target_lang_sense_clarification": "a deep, hoarse sound"
                            },
                            {
                                "target_lang_word": "to caw",
                                "target_lang_sense_clarification": "the sound of a crow"
                            },
                            {
                                "target_lang_word": "to rasp",
                                "target_lang_sense_clarification": "a harsh, grating sound"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b10da05-181f-3814-b534-1cee7a3b4f91",
                    "sense_definition": "meervoud van <w>kras</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zitten diepe <w>krassen</w> op de lak van mijn nieuwe auto.",
                            "target_lang_translations": {
                                "en": "There are deep <w>scratches</w> on the paint of my new car."
                            }
                        },
                        {
                            "text": "Door de vele <w>krassen</w> op de cd kan de speler de muziek niet meer goed lezen.",
                            "target_lang_translations": {
                                "en": "Because of the many <w>scratches</w> on the CD, the player can no longer read the music properly."
                            }
                        }
                    ],
                    "synonyms": [
                        "schrammen",
                        "inkervingen"
                    ],
                    "common_phrases": [
                        "diepe krassen",
                        "krassen op de lak"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'kras'; marks or lines caused by scratching"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratches",
                                "target_lang_sense_clarification": "marks on a surface"
                            },
                            {
                                "target_lang_word": "scuffs",
                                "target_lang_sense_clarification": "minor surface marks"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}