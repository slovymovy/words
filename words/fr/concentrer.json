{
    "word_family": [
        "concentration",
        "concentré",
        "déconcentrer",
        "reconcentrer",
        "concentrique"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f17b73d-c1b3-3c9b-8410-6874596a029d",
                    "sense_definition": "Fixer son esprit, son attention ou ses efforts sur un objet ou une activité précise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est difficile de se <w>concentrer</w> avec tout ce bruit dans la bibliothèque."
                        },
                        {
                            "text": "Tu dois <w>concentrer</w> ton attention sur les consignes données par le professeur."
                        }
                    ],
                    "synonyms": [
                        "focaliser"
                    ],
                    "antonyms": [
                        "déconcentrer"
                    ],
                    "common_phrases": [
                        "se concentrer sur",
                        "concentrer son attention",
                        "concentrer ses efforts"
                    ]
                },
                {
                    "sense_id": "e01ab463-b838-3e11-aece-63a90cfbde11",
                    "sense_definition": "Réunir ou rassembler en un même lieu, ou autour d'un centre unique, des personnes ou des ressources.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rassemblement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général a décidé de <w>concentrer</w> ses troupes près de la frontière."
                        },
                        {
                            "text": "Cette grande entreprise souhaite <w>concentrer</w> tous ses services dans la capitale."
                        }
                    ],
                    "synonyms": [
                        "centraliser",
                        "rassembler",
                        "regrouper"
                    ],
                    "antonyms": [
                        "décentrer"
                    ],
                    "common_phrases": [
                        "concentrer les pouvoirs",
                        "concentrer les troupes"
                    ]
                },
                {
                    "sense_id": "65f3ab57-a558-3838-8f0d-eb627a138d58",
                    "sense_definition": "Augmenter la proportion d'un corps dissous dans un liquide en réduisant la quantité d'eau ou de solvant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chimiste chauffe la préparation pour <w>concentrer</w> la solution sans altérer les molécules."
                        },
                        {
                            "text": "Il faut faire bouillir le sirop pour en <w>concentrer</w> les arômes."
                        }
                    ],
                    "synonyms": [
                        "condenser",
                        "épaissir"
                    ],
                    "common_phrases": [
                        "concentrer une solution",
                        "concentrer un liquide"
                    ]
                },
                {
                    "sense_id": "21a93b56-ab15-3a6b-bcf4-918744d3f40b",
                    "sense_definition": "Contenir, refouler ou intérioriser un sentiment intense sans le manifester extérieurement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les provocations répétées, il parvenait à <w>concentrer</w> sa colère dans un silence pesant."
                        },
                        {
                            "text": "Elle s'efforçait de <w>concentrer</w> son chagrin pour rassurer les membres de sa famille."
                        }
                    ],
                    "synonyms": [
                        "dissimuler",
                        "intérioriser",
                        "refouler"
                    ],
                    "common_phrases": [
                        "concentrer sa colère",
                        "concentrer sa haine"
                    ]
                }
            ]
        }
    ]
}