            "senses": [
                {
                    "sense_id": "a4f3901b-f9f5-3873-93c5-b9860186c288",
                    "sense_definition": "De façon parfaite ou entièrement satisfaisante ; très bien.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout fonctionne <w>impeccable</w> depuis la dernière mise à jour."
                        },
                        {
                            "text": "Le repas s'est déroulé <w>impeccable</w> du début à la fin."
