                                "target_lang_sense_clarification": "надлежащий"
                            },
                            {
                                "target_lang_word": "досто́йный",
                                "target_lang_sense_clarification": "уважительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "得体",
                                "target_lang_sense_clarification": "恰当，符合礼节"
                            },
                            {
                                "target_lang_word": "体面",
                                "target_lang_sense_clarification": "合乎社会规范"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deb79135-e886-30b6-a800-7be3b4f2832f",
                    "sense_definition": "Attractive or well-formed (referring to the body).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described her <w>decent</w> form in his verses.",
                            "target_lang_translations": {
                                "ru": "Поэт описал ее <w>изя́щный</w> стан в своих стихах.",
                                "zh": "诗人在诗句中描述了她<w>匀称</w>的身材。"
                            }
                        },
                        {
                            "text": "He wore a heavy cloak over his <w>decent</w> shoulders.",
                            "target_lang_translations": {
                                "ru": "Он носил тяжелый плащ на своих <w>ста́тных</w> плечах.",
                                "zh": "他披着一件厚重的斗篷，遮住了他<w>匀称</w>的肩膀。"
                            }
                        }
                    ],
