{
    "word_family": [
        "clang",
        "clangorous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed97b140-6171-3361-977d-ce876874067b",
                    "sense_definition": "A loud, resonant, metallic sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clangor</w> of the church bells echoed through the quiet valley.",
                            "target_lang_translations": {
                                "de": "Das <w>Geklirr</w> der Kirchenglocken hallte durch das stille Tal."
                            }
                        },
                        {
                            "text": "We were awakened by the sudden <w>clangor</w> of metal hitting the floor.",
                            "target_lang_translations": {
                                "de": "Wir wurden durch das plötzliche <w>Geklirr</w> von Metall, das auf den Boden schlug, geweckt."
                            }
                        }
                    ],
                    "synonyms": [
                        "din",
                        "clatter",
                        "clang"
                    ],
                    "common_phrases": [
                        "metallic clangor",
                        "sudden clangor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Standard spelling in Canada and the United States."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein lauter, hallender, metallischer Klang."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Geklirr",
                                "target_lang_sense_clarification": "Bezeichnet ein helles, metallisches Geräusch."
                            },
                            {
                                "target_lang_word": "Lärm",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für laute, oft unangenehme Geräusche."
                            },
                            {
                                "target_lang_word": "Dröhnen",
                                "target_lang_sense_clarification": "Ein tiefes, anhaltendes, lautes Geräusch."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9eeef1e9-d0ba-369c-969f-419b1f453ff4",
                    "sense_definition": "To make a loud, resonant, metallic sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy iron gates began to <w>clangor</w> in the strong wind.",
                            "target_lang_translations": {
                                "de": "Die schweren Eisentore begannen im starken Wind zu <w>klirren</w>."
                            }
                        },
                        {
                            "text": "The old pipes <w>clangor</w> whenever the heating system turns on.",
                            "target_lang_translations": {
                                "de": "Die alten Rohre <w>dröhnen</w>, wann immer die Heizung angeht."
                            }
                        }
                    ],
                    "synonyms": [
                        "clang",
                        "clatter"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Standard spelling in Canada and the United States."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein lautes, hallendes, metallisches Geräusch von sich geben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "klirren",
                                "target_lang_sense_clarification": "Ein helles, metallisches Geräusch verursachen."
                            },
                            {
                                "target_lang_word": "dröhnen",
                                "target_lang_sense_clarification": "Ein lautes, dumpfes Geräusch erzeugen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}