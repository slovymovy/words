                        "glosses": [
                            "die Kardinalzahl zwischen 14999 und 15001; einhundertfünfzig mal hundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "439d25a3-3ee8-4752-9017-80efae491af0",
                                "sense_id": "99c9192d-c923-3092-b285-3d7e3fc4d128",
                                "text": "„Diese Befunde widersprechen früheren Auffassungen über die Besiedlungsmuster Europas der letzten zehn- bis fünfzehntausend Jahre – also seit der letzten Eiszeit (deren letzter Höhepunkt vor 20000 Jahren war).“"
                            },
                            {
                                "example_id": "9feea4eb-616e-49f1-9774-5f3c3dbcd350",
                                "sense_id": "99c9192d-c923-3092-b285-3d7e3fc4d128",
                                "text": "„Vor zehn- bis fünfzehntausend Jahren muss im Sternbild Kepheus, nicht weit vom Himmelsnordpol entfernt, für einige Monate ein prächtiger neuer Stern geleuchtet haben: eine Supernova, die mit der doppelten Helligkeit des Planeten Venus strahlte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
