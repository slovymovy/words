                    },
                    {
                        "translation_id": "3d874305-a62a-4de6-8bb5-d05dbe3271e3",
                        "source_entry_id": "2c615421-e1ef-3a3c-8359-5536910ea56f",
                        "source_sense_id": "facad3a0-90bd-3abe-9c8f-7354e413630e",
                        "target_lang_word": "Zingulum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zingulum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                        "entry_id": "e49b1884-8b9d-355d-9cd0-7177666ce565",
                                        "glosses": [
                                            "Gürtel am Gewand eines Klerikers oder Mitglieds einer Ordensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3aea0d2-ac7b-4559-aca9-25bcb6399882",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„In unserem Kirchenjahr gibt es verschiedene Feste und Feiern. Dabei ist immer eins zu beobachten: Die Farben der Messgewänder und die Zingulen (Kordeln) der Minis ändern ihre Farben.“"
                                            },
                                            {
                                                "example_id": "2bd8b359-34c0-4ba1-9374-47c132a5add2",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„In den ersten Jahrzehnten der Protokolle finden wir auch Mitteilungen, daß der Weihbischof Kelche und Patenen, Ziborien und Monstranzen, Lunulen und Kustodien, Pallen, Korporalien und Altartücher, Kaseln und Dalmatike mit Stolen und Manipeln, Alben, Schultertücher und Zingulen geweiht hat.“"
                                            },
                                            {
                                                "example_id": "feb90e5a-e498-4bb6-a510-c2b5a103e552",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„Hinzu kommen vereinzelt Bruderschaftsutensilien wie einige Zingulen, Rosenkränze und Skapuliere (jeweils mit Kupferstich) oder etliche Bruderschaftszettel.“"
                                            },
                                            {
                                                "example_id": "7ea49910-084c-4add-95b1-f61bebabc1cc",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„Bemerkenswert ist die aufwendig ausgestattete Kapelle im Erdgeschoß, in der sich außer einem gotischen Altar ein Betstuhl, ein Lesepult, ein Meßbuch, 4 Meßgewänder, zwei Alben und drei Zingulen befanden.“"
                                            },
                                            {
                                                "example_id": "7f721427-5863-4d59-a1ae-5e2e257f6ff2",
                                                "sense_id": "74401a58-7ea4-39bd-9b93-691b18d7ddbb",
                                                "text": "„Dazu kommen 3 Bursen und ebenso viele erstklassige Pallae mit Zingulen und Schultertüchern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f9b06be-0213-4b71-9308-c9d9ff112ec8",
                        "source_entry_id": "2c615421-e1ef-3a3c-8359-5536910ea56f",
                        "source_sense_id": "facad3a0-90bd-3abe-9c8f-7354e413630e",
                        "target_lang_word": "Cingulum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cingulum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a22234e-50f7-3d4c-8e8f-3d52bbba67ed",
                                        "entry_id": "fdde7d99-4bce-3156-9e5e-860fa106fc64",
                                        "glosses": [
                                            "mit Metall beschlagener Gürtel römischer Soldaten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cca22742-c81a-46a1-b1cc-79e40cc5f69c",
                                                "sense_id": "1a22234e-50f7-3d4c-8e8f-3d52bbba67ed",
                                                "text": "Im Cingulum verwahrte der Römer auch seine Münzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90895265-9e57-3bed-b729-c188505f42d4",
                                        "entry_id": "fdde7d99-4bce-3156-9e5e-860fa106fc64",
                                        "glosses": [
                                            "Gürtel am Gewand eines Klerikers oder Mitglieds einer Ordensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df1797f2-5786-43d0-b488-962c0f4aba69",
                                                "sense_id": "90895265-9e57-3bed-b729-c188505f42d4",
                                                "text": "„Er bestand aus der Kukulle, einem mantelähnlichen Obergewand, dem Skapulier, einem Überwurf über Brust und Rücken sowie dem Cingulum, einem Gürtel, der um die Hüften gebunden wird.“"
                                            },
                                            {
                                                "example_id": "fba4fad8-d4c6-47ec-bd56-7bf36cefce5b",
                                                "sense_id": "90895265-9e57-3bed-b729-c188505f42d4",
                                                "text": "„Für die drei Andern, welche die Passion singen, sollen ebenfalls drei andere Schultertücher, drei Alben, drei Cingulen, drei Diakonalstolen und abenso viele schwarze Manipeln hergerichtet werden.“"
                                            },
                                            {
                                                "example_id": "9e36c959-e985-4f12-bc84-50c75e7a31c1",
                                                "sense_id": "90895265-9e57-3bed-b729-c188505f42d4",
                                                "text": "„Bei der priesterlichen Kultgewandung treten sie jedoch auch als Schmuckborten an Cingulen, Manipeln, Stolen und Mitren auf.“"
                                            },
                                            {
                                                "example_id": "d374ed2d-f526-48ed-add9-9f77b95f77d1",
                                                "sense_id": "90895265-9e57-3bed-b729-c188505f42d4",
                                                "text": "„[…], so ist es erklärlich, dass von der Aehnlichkeit der abgezogenen Goldhaut der obengedachten Viperschlange noch bis zum VIII. Jahrhundert die reichen bischöflichen und priesterlichen Cingulen murenae genannt wurden.“"
                                            },
                                            {
                                                "example_id": "80b22819-b4f7-4edf-a8eb-19cc6c0c5886",
                                                "sense_id": "90895265-9e57-3bed-b729-c188505f42d4",
                                                "text": "„Dem hochwürdigen Metropolitankapitel dahier bestimme ich als kleines Andenken meine zwei schönsten Alben mit zwei Humeralien und einigen Cingulen, und mein schönes kunstvoll gebundenes Missale aus der Kunstanstalt des Reiß in Wien.“"
                                            },
                                            {
                                                "example_id": "27a997ac-8215-41b1-acfa-3a08af0b822c",
                                                "sense_id": "90895265-9e57-3bed-b729-c188505f42d4",
                                                "text": "„Bestehend aus einem Chormantel, einer Kasel und zwei Dalmatiken bzw. Dalmatika und Tunicella, den Humeralia und weiterem Zubehör, gemeint sind vor allem die Alben, Cingulen und Stolen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "11024131-6f28-3ee1-9c08-a474541aefad",
                                        "entry_id": "fdde7d99-4bce-3156-9e5e-860fa106fc64",
                                        "glosses": [
                                            "gürtelförmige Anordnung der Knochen (zum Beispiel der Schultergürtel Cingulum membri thoracici) oder gürtelförmige Struktur im Gehirn"
                                        ],
                                        "tags": [
                                            "Nomenklatur",
                                            "Wortbestandteil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b13b7657-a9b7-41b9-8766-bc1a7ef0569b",
                                                "sense_id": "11024131-6f28-3ee1-9c08-a474541aefad",
                                                "text": "Diese Knochen bilden den Teil des Skeletts, den man in Homologie zum Schultergürtel als Beckengürtel, Cingulum membri inferioris, bezeichnet."
                                            },
                                            {
                                                "example_id": "b08d1aad-b078-4a8c-9206-9e27e251478b",
                                                "sense_id": "11024131-6f28-3ee1-9c08-a474541aefad",
                                                "text": "„Das Aufleuchten des Rabattschildes reichte aus, um die Versuchsteilnehmer zum Kauf des überteuerten Produkts zu bewegen. Der Grund dafür liegt in einer Hirnregion mit dem Namen anteriores Cingulum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
