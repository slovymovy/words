                        "sense_id": "9e5a7e44-41e2-3ee1-b189-243fc8e0d967",
                        "entry_id": "eb7dcfa3-87f4-374f-afaa-bb1c5e091e0a",
                        "glosses": [
                            "Äbtissin"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
