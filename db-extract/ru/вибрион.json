                                        "glosses": [
                                            "Any of several bacteria, of the genus Vibrio, shaped like a curved rod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0124cabd-557c-47f7-948c-30a2fa26fa04",
                                                "sense_id": "71a4a402-1070-3d1b-b5da-ed1b74f80dac",
                                                "text": "\"He dips it into the poison and they are gone. Our Gardener is, in my opinion, about to dip the solar system, and the human bacillus, the little mortal vibrio which twisted and wriggled upon the outer rind of the earth, will in an instant be sterilized out of existence.\""
                                            }
                                        ]
                                    }
