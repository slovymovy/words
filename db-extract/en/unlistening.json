                        "glosses": [
                            "Not listening."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d35a6b80-fbfb-41dd-8bed-2bddfcb13f27",
                                "sense_id": "ce908efd-63ee-3fab-98a4-e7012b904a3e",
                                "text": "The voices of his mother and sisters, raised at times in eagerness or expectation of the future, fell upon his unlistening ears."
                            },
                            {
                                "example_id": "28fba720-ba84-415b-b171-161f22f034a4",
                                "sense_id": "ce908efd-63ee-3fab-98a4-e7012b904a3e",
                                "text": "\"Did you know, beloved, at the last, in that intolerable heat, in that moment of supreme anguish, that he is unlistening, unhelpful as the stars, that you cried not to him?\""
                            },
                            {
                                "example_id": "1cfc8cd3-5513-4eca-9e74-9bd9c8942e7d",
                                "sense_id": "ce908efd-63ee-3fab-98a4-e7012b904a3e",
                                "text": "Both have something important to say, but are hyperconscious of an unlistening world. They are disappointed, incredulous at humanity’s deafness."
                            }
                        ]
                    }
                ],
