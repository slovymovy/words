                        "examples": [
                            {
                                "example_id": "3b7b5e70-9b34-4914-8cab-317cb25561bc",
                                "sense_id": "0b12ae87-0119-3b11-86a8-5bcb703d4d86",
                                "text": "Mikrotransakcje zaczynają pojawiać się wszak w coraz większej liczbie produkcji growych i przynoszą twórcom krocie."
