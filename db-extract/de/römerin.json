                "senses": [
                    {
                        "sense_id": "06d1876a-957d-3284-a785-eec70d9d2a64",
                        "entry_id": "d439938e-c5c3-3e94-b66d-9aae92b2a074",
                        "glosses": [
                            "in Rom geborene oder dort auf Dauer lebende weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063b4519-2036-48d9-a9bb-248e22bf9490",
                                "sense_id": "06d1876a-957d-3284-a785-eec70d9d2a64",
                                "text": "„Die 53-jährige Römerin ist damit die engste Mitarbeiterin von Direktor Antonio Paolucci, der seit 2007 den Vatikanischen Museen vorsteht.“"
                            },
                            {
                                "example_id": "44e12358-300b-4667-be1a-3853ce578fc2",
                                "sense_id": "06d1876a-957d-3284-a785-eec70d9d2a64",
                                "text": "„Sie sagte mir gerade heraus, sie sei sehr froh, mit mir sprechen zu können, denn sie sei Römerin, habe Zelmi erzogen und ihr Singen und Harfespielen beigebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
