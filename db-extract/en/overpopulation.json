                                        "entry_id": "eb4d6f3b-4c4a-3e22-8d4d-c007c4552583",
                                        "glosses": [
                                            "Peuplement excessif par rapport aux ressources ou aux conditions d'hygiène, de densité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ebc1f98-5b85-4471-9c03-5c2c80835a65",
                                                "sense_id": "57c4398e-87f8-3b19-82e7-f33acdde0c7b",
                                                "text": "Le bidonville est un amalgame de conditions de logement sordides, de surpeuplement, de maladie et de pauvreté."
                                            },
                                            {
                                                "example_id": "20e1ba6a-c529-4f35-bbe8-e8a52a2fa5e2",
                                                "sense_id": "57c4398e-87f8-3b19-82e7-f33acdde0c7b",
