                "senses": [
                    {
                        "sense_id": "eb8dcd10-2f33-3ae0-80d2-b6b426ff2dbd",
                        "entry_id": "44df1b10-0395-3500-bb0d-92825f6efa84",
                        "glosses": [
                            "von der Firma Harley-Davidson hergestelltes Motorrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7fbe370-9025-4792-91c0-5a833bf4b6bd",
                                "sense_id": "eb8dcd10-2f33-3ae0-80d2-b6b426ff2dbd",
                                "text": "„Ihn reizten vielmehr die Burschen, die auf Harleys oder mit aufgemotzten Pick-ups anrauschten.“"
                            },
                            {
                                "example_id": "5cd5c9eb-2b16-448e-ad53-f0c2e272187a",
                                "sense_id": "eb8dcd10-2f33-3ae0-80d2-b6b426ff2dbd",
                                "text": "„Man sollte nicht glauben, dass sich ein so großer Mann auf ein Motorrad zwängen kann, selbst eine gewaltige, tuckernde Harley wie diese.“"
                            },
                            {
                                "example_id": "1e10a2c5-d4fb-4298-8fb6-febd386ab003",
                                "sense_id": "eb8dcd10-2f33-3ae0-80d2-b6b426ff2dbd",
                                "text": "„Am Bordstein lehnten zwei Harleys und eine Moto Guzzi.“"
                            },
                            {
                                "example_id": "d09daa95-f332-4539-9be3-8957c1eadb1b",
                                "sense_id": "eb8dcd10-2f33-3ae0-80d2-b6b426ff2dbd",
                                "text": "„Ja, welches Modell? -Eine Harley.“"
                            },
                            {
                                "example_id": "8ebc6fd9-697f-429b-9956-46b1b1ad4645",
                                "sense_id": "eb8dcd10-2f33-3ae0-80d2-b6b426ff2dbd",
                                "text": "„Ich steh auf Harleys.“"
                            },
                            {
                                "example_id": "ae184202-ee94-4ae6-bd34-cc2d60531313",
                                "sense_id": "eb8dcd10-2f33-3ae0-80d2-b6b426ff2dbd",
                                "text": "„Und ich werde dich so gut wie mein Leder behandeln und... so oft wie meine Harley reiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
