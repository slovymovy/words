                                        "examples": [
                                            {
                                                "example_id": "d07d70a1-41cb-4eaf-bc22-c836de306a5e",
                                                "sense_id": "f9b01c26-eb4b-37a3-9441-6485090c7947",
                                                "text": "Compare the two twi-headed serpents which Loeg, in the Serglige Conculaind, sees on the plain of Mag Denna."
                                            },
                                            {
                                                "example_id": "4e43dbed-f6f1-4981-8cbc-95c25a25231a",
                                                "sense_id": "f9b01c26-eb4b-37a3-9441-6485090c7947",
                                                "text": "They watched in silent anxious adoration as their twi-headed god was led forward and seated in the centre of the circular enclosure on a massive throne of carved dark wood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
