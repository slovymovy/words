                        "examples": [
                            {
                                "example_id": "6448d7c2-8b32-467e-b510-1ffbec7978dc",
                                "sense_id": "64802a78-1484-3ad7-99e5-7d89703f3acb",
                                "text": "Brysbaert en Keuleers hebben wel meer zotte discussies over woorden die niet lijken wat ze zijn, zoals ringstaart, stoppenkast en hartoor."
                            },
                            {
                                "example_id": "89b7937a-6b4e-4213-9b11-79f4a340301f",
                                "sense_id": "64802a78-1484-3ad7-99e5-7d89703f3acb",
                                "text": "In een uitstulping van de boezems, het zogeheten hartoor, kunnen dan stolsels ontstaan. Een bloedpropje vanuit de linkerharthelft kan bijvoorbeeld in de kleine vaten van de hersenen terechtkomen en daar een infarct veroorzaken."
                            },
                            {
                                "example_id": "d7ad5aab-7c88-48c1-b01d-0bf5a66c614e",
                                "sense_id": "64802a78-1484-3ad7-99e5-7d89703f3acb",
                                "text": "Cardiologen van het Sint Antonius Ziekenhuis in Nieuwegein gaan vandaag voor het eerst een hartoor afsluiten."
                            }
                        ]
                    }
