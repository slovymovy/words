                    {
                        "translation_id": "78c307c1-9b97-4f60-aad6-8aa1cc8b1726",
                        "source_entry_id": "b4ef7009-a99c-3a4d-9be8-ff011bc95457",
                        "source_sense_id": "dc8a3cfb-0866-3c59-9832-edff986805a3",
                        "source_sense_description": "freie Fläche auf dem Dach, die als Terrasse genutzt wird",
                        "target_lang_word": "dakterras",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dakterras",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "21b34572-83ed-3257-a63a-b14a4c75912b",
                                        "entry_id": "6f43173d-ebc4-3237-ac05-4292b3f5f7c7",
                                        "glosses": [
                                            "deel van het dak waarop je kunt verblijven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb315ace-71f3-4961-8e2a-7028d1dad33e",
                                                "sense_id": "21b34572-83ed-3257-a63a-b14a4c75912b",
                                                "text": "Een royaal huis met tuin, veranda of dakterras doet ook mij watertanden. Maar als ik me vervolgens voorstel dat ik er echt woon lijkt het me minder leuk. Elkaar ontlopen is niet altijd een voordeel, een huis inrichten, opruimen en schoonhouden best moeilijk. Daar kun je mensen voor in dienst nemen, maar een ingehuurde kracht brengt geen ziel in huis. Dat doen de mensen die er wonen. Een groot huis vraagt veel ziel."
                                            },
                                            {
                                                "example_id": "b31ecba5-6253-4ec2-84c5-0ff311305ce2",
                                                "sense_id": "21b34572-83ed-3257-a63a-b14a4c75912b",
                                                "text": "Er was een deur naar een klein dakterras. Vandaar had je zicht op daken links en rechts beneden en op huizen aan de overkant van het steegje achter het oude huis."
                                            },
                                            {
                                                "example_id": "b5abe608-4cab-41fc-9b94-4d175d7b0d10",
                                                "sense_id": "21b34572-83ed-3257-a63a-b14a4c75912b",
                                                "text": "Zo wordt potentiële kopers of andere geïnteresseerden een blik gegund op haar riante woonkamer, slaapkamer, strakke badkamer, ruime garderobekast, babykamer voor Monte, dakterras zonder veel privacy, intieme binnenplaats en de inpandige garage: in het centrum van de hoofdstad een zeldzame bijzonderheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
