            {
                "entry_id": "d3a623ec-4ba6-3ceb-bb3e-4b3846b6a1e8",
                "word": "identitarisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "732b6c11-341b-40e8-a6fa-cfe7f1257c75",
                        "entry_id": "d3a623ec-4ba6-3ceb-bb3e-4b3846b6a1e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "identitarismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c9877d4-0314-3a22-9e3f-d7823051549a",
                        "entry_id": "d3a623ec-4ba6-3ceb-bb3e-4b3846b6a1e8",
                        "glosses": [
                            "Idéologie liée aux notions d’identité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace8c458-4f55-4c51-a683-517da9f4110d",
                                "sense_id": "5c9877d4-0314-3a22-9e3f-d7823051549a",
                                "text": "L’identitarisme est une idéologie revendiquant pour les peuples une identité censée leur garantir une permanence à travers les siècles."
                            },
                            {
                                "example_id": "0e6e48ad-ac22-4540-88ae-0c400ca56453",
                                "sense_id": "5c9877d4-0314-3a22-9e3f-d7823051549a",
                                "text": "L’identitarisme est une tendance à fixer les individus et les collectivités humaines sur une identité principale, homogène et fermée. […] Critiquer les identitarismes, ce n’est pas récuser toute place aux identités individuelles et collectives en politique. […] Le passage de revendications identitaires justifiées à des logiques identitaristes périlleuses s’effectue quand les identités ainsi soutenues sont considérées comme closes, à travers les bricolages idéologiques produits par des entrepreneurs identitaires, par exemple face aux migrations appréhendées comme menaçantes, et que la diversité des alluvions constitutives d’identités en mouvement n’est pas reconnue."
                            },
                            {
                                "example_id": "50f64577-2b9a-4554-b422-fdfcdb5fea19",
                                "sense_id": "5c9877d4-0314-3a22-9e3f-d7823051549a",
                                "text": "L’identitarisme est la maladie du XXIᵉ siècle."
                            },
                            {
                                "example_id": "b16b70a0-5c2f-46ab-867a-e13c2c776816",
                                "sense_id": "5c9877d4-0314-3a22-9e3f-d7823051549a",
                                "text": "L’identitarisme est l'essentialisation d'un trait identitaire"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80f6d415-c96e-488e-b405-2308fb43cfde",
                        "source_entry_id": "d3a623ec-4ba6-3ceb-bb3e-4b3846b6a1e8",
                        "source_sense_id": "5c9877d4-0314-3a22-9e3f-d7823051549a",
                        "target_lang_word": "identitarianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identitarianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f756701-c441-3054-9a59-4775703f683c",
                                        "entry_id": "51f518ab-4553-3e43-aee3-e95057ff088d",
                                        "glosses": [
                                            "Politics based on social identity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbc54c99-aa43-4705-9923-43e65a6d0b29",
                                                "sense_id": "6f756701-c441-3054-9a59-4775703f683c",
                                                "text": "\"The radical feminists always wanted in their frantic identitarianism to eliminate the difference between the sexes\" (p. 96)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "261680a0-0acd-3b20-9426-97ed31926bf7",
                                        "entry_id": "51f518ab-4553-3e43-aee3-e95057ff088d",
                                        "glosses": [
                                            "Politics based on social identity.",
                                            "A far-right political movement and philosophy that seeks to preserve European ethnic and cultural identity against the perceived threats of immigration, Islam, and globalization."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fa64519-db79-4087-b558-9922eef2b0ca",
                                                "sense_id": "261680a0-0acd-3b20-9426-97ed31926bf7",
                                                "text": "Needless to add, this augurs badly for the future of the GRECE’s identitarianism, for it now tacitly acknowledges the right of non-Europeans to occupy and partition European lands."
                                            },
                                            {
                                                "example_id": "3e2303dd-3599-433b-9085-7ba5630b9e3f",
                                                "sense_id": "261680a0-0acd-3b20-9426-97ed31926bf7",
                                                "text": "Identitarianism is probably the most well-known of these ‘new’ ideologies, despite its fairly recent emergence on the political scene. Employing the lambda symbol, identitarianism has gained increasing purchase amongst youth across western Europe, and France in particular, growing out of the (European) New Right (Nouvelle Droite), which dates to the 1970s and GRECE (Research and Study Group on European Civilization)."
                                            },
                                            {
                                                "example_id": "eae76616-3051-46d3-b3c1-004f6534ab8a",
                                                "sense_id": "261680a0-0acd-3b20-9426-97ed31926bf7",
                                                "text": "While the concept of remigration has long existed in academia, its hijacking by the far right on social media appears to have begun about a decade ago when French adherents to identitarianism, an ethno-nationalist movement, organised what they described as the inaugural meeting in Paris on remigration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1f9fabe-3db5-31dc-a281-fff9437afd33",
                                        "entry_id": "51f518ab-4553-3e43-aee3-e95057ff088d",
                                        "glosses": [
                                            "The set of ideas arising from an ontology of identity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
