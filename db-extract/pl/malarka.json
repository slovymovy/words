                    {
                        "translation_id": "cee2db6e-889c-465a-83d4-3fd742ef3d33",
                        "source_entry_id": "13396e94-8f02-39ca-a355-f1b91218af17",
                        "source_sense_id": "02b8b35d-0dde-3411-972e-bf3122749c59",
                        "target_lang_word": "Malerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Malerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1805dde5-5a6c-3326-9bc6-5bde96f4afa3",
                                        "entry_id": "c8e677f9-9db3-388e-b8ee-cb50feb218ba",
                                        "glosses": [
                                            "Künstlerin, die Bilder malt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e33de05b-5b2d-48ab-96f2-aef88a6d4d53",
                                                "sense_id": "1805dde5-5a6c-3326-9bc6-5bde96f4afa3",
                                                "text": "„Auf einem Pastell zeigt die Malerin Rosalba Carriera in schwelgerischem Duktus Venus und ihre Knaben […].“"
                                            },
                                            {
                                                "example_id": "e294c59e-251d-40d7-b683-a8536f8cf40d",
                                                "sense_id": "1805dde5-5a6c-3326-9bc6-5bde96f4afa3",
                                                "text": "„Im Viertel aber sprach man weiterhin über Elisabeth, die großartige Malerin, und über diesen seltsamen Lehrer, der sich in sie verliebte.“"
                                            },
                                            {
                                                "example_id": "5bc29f77-dbf4-4ce2-a807-a636b75ea47f",
                                                "sense_id": "1805dde5-5a6c-3326-9bc6-5bde96f4afa3",
                                                "text": "„Cristina ist Malerin, oder genauer gesagt, wäre Malerin geworden, wenn ihr die erste Ehe nicht in die Quere gekommen wäre.“"
                                            },
                                            {
                                                "example_id": "7aee31e1-f5d3-431d-94b3-cd2919b32b38",
                                                "sense_id": "1805dde5-5a6c-3326-9bc6-5bde96f4afa3",
                                                "text": "„St. Arnaud applaudierte der Malerin, und selbst Cécile, die beim Beginn des Wortgefechtes ein leises Unbehagen nicht unterdrücken konnte, hatte sich, als ihr das harmlos Unbeabsichtigte dieser kleinen Pikanterien zur Gewißheit geworden war, ihrer allerbesten Laune rückhaltlos hingegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e3e3707-c8ad-34eb-a82a-bb4222542882",
                                        "entry_id": "c8e677f9-9db3-388e-b8ee-cb50feb218ba",
                                        "glosses": [
                                            "Handwerkerin, die beispielsweise Wände streicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b21f5b-7859-46f3-9904-63f8dc6cb39e",
                                                "sense_id": "1e3e3707-c8ad-34eb-a82a-bb4222542882",
                                                "text": "Die Ausbildung zur Malerin / Lackiererin dauert 3 Jahre."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
