                        "target_lang_word": "décompiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décompiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8617eab7-19aa-3224-85c8-a6ddbe747866",
                                        "entry_id": "b2fe381c-3b95-3229-8f2b-8fc0cf29fe4c",
                                        "glosses": [
                                            "Effectuer l’opération inverse de la compilation, c’est-à-dire essayer de recréer un programme source à partir d’un programme binaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2dcf3a9-76a0-433f-8ed7-cbe9bc7c9c16",
                                                "sense_id": "8617eab7-19aa-3224-85c8-a6ddbe747866",
                                                "text": "Par conséquent, il faut obtenir l’autorisation préalable de l’ayant droit pour pouvoir charger, afficher, transmettre, stocker, adapter, traduire, compiler, décompiler, louer, prêter, communiquer au public le programme."
                                            },
                                            {
                                                "example_id": "6d0416be-b89f-4129-bcbb-f1bb6d0d83ed",
                                                "sense_id": "8617eab7-19aa-3224-85c8-a6ddbe747866",
                                                "text": "En premier lieu, il est interdit à l’utilisateur de décompiler un logiciel dans le but de créer un logiciel directement concurrent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb327271-3589-4242-b71c-122b1980df7d",
                        "source_entry_id": "2a7a3f23-84d6-3bc3-bdca-cfc70834b55c",
                        "source_sense_id": "e449c70b-6b47-389a-8b08-a0cb3ad8a685",
                        "source_sense_description": "to recreate the original source code",
                        "target_lang_word": "dekompilieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dekompilieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47ded32b-91b9-3766-8284-e3363e279e93",
                                        "entry_id": "54c001cb-2ea7-3f21-8306-ec8baf94af50",
                                        "glosses": [
                                            "ein ausführbares Programm von Maschinensprache wieder in lesbaren Quellcode umwandeln"
                                        ],
                                        "tags": [
                                            "Softwareentwicklung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8762f08-020f-49f0-b5f1-19d23fd40230",
                                                "sense_id": "47ded32b-91b9-3766-8284-e3363e279e93",
                                                "text": "Ich versuche die Anwendung zu dekompilieren, um ihre Arbeitsweise zu verstehen."
                                            },
                                            {
                                                "example_id": "d6c0eb55-3c45-4d4c-b702-98f86737267f",
                                                "sense_id": "47ded32b-91b9-3766-8284-e3363e279e93",
                                                "text": "„Der Käufer ist nicht berechtigt die Software zu übersetzen, zu bearbeiten, zu dekompilieren, zu reverse-engineeren oder zu dissassemblieren, es sei denn gesetzliche Regelungen sehen dies vor.“"
                                            },
                                            {
                                                "example_id": "c3585a15-def5-4117-99df-6f72bcd291c4",
                                                "sense_id": "47ded32b-91b9-3766-8284-e3363e279e93",
                                                "text": "„Bytecode-basierte Java-Klassen sind deutlich einfacher zu dekompilieren als native Binaries, weil ihre Bytecode-Anweisungen umfangreiche Kontextinformationen enthalten, zum Beispiel zu Vererbung und Datentypen.“"
                                            },
                                            {
                                                "example_id": "95f37ac0-5203-440f-a7dd-41f01ae97339",
                                                "sense_id": "47ded32b-91b9-3766-8284-e3363e279e93",
                                                "text": "„Sie können die DLL-Datei unter Umständen auch lesbar machen, indem Sie sie dekompilieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
