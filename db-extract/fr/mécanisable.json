                "senses": [
                    {
                        "sense_id": "07696f54-40cf-3876-970d-834491dfd7a9",
                        "entry_id": "dbac7a0c-958b-35f6-b319-1ba7590abe5a",
                        "glosses": [
                            "Que l'on peut mécaniser."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d92d7ad5-acf0-3c5d-a748-69fb013f9e1a",
                        "entry_id": "dbac7a0c-958b-35f6-b319-1ba7590abe5a",
                        "glosses": [
                            "Dont on peut mécaniser l'usage ou l'exploitation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9d2fcfcf-5a3a-4a04-876f-ed7d6448ee92",
                                "sense_id": "d92d7ad5-acf0-3c5d-a748-69fb013f9e1a",
                                "text": "En 1951, en l'absence d'une céréale mécanisable, nous avons adopté la rotation : engrais vert, arachide, arachide. Mais notre objectif était de réaliser un assolement quadriennal : engrais vert, arachide, céréale, arachide."
                            },
                            {
                                "example_id": "e514cdcd-6f0a-468e-b5e8-f20c95831ad1",
                                "sense_id": "d92d7ad5-acf0-3c5d-a748-69fb013f9e1a",
                                "text": "Le pâturage fut clos à l'automne 1974 et divisé en 4 parcs englobant chacun une part de la zone herbacée, du secteur débroussaillable mécaniquement et de la friche non mécanisable."
                            },
                            {
                                "example_id": "92c98e63-f663-4679-a57f-a78ffd085abf",
                                "sense_id": "d92d7ad5-acf0-3c5d-a748-69fb013f9e1a",
                                "text": "Il s'agit d'évaluer d'une part les volumes de courrier mécanisable et de courrier non mécanisable, et d'autre part du courrier s'adressant aux particuliers et de celui destiné aux entreprises."
                            }
                        ]
                    },
                    {
                        "sense_id": "95810c77-3a5a-3e15-b826-c8c20f78c22a",
                        "entry_id": "dbac7a0c-958b-35f6-b319-1ba7590abe5a",
                        "glosses": [
                            "Qui peut devenir mécanique, en parlant de l'énergie."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "ad4d15e2-a1b1-4592-af80-415a2ff881a6",
                                "sense_id": "95810c77-3a5a-3e15-b826-c8c20f78c22a",
                                "text": "Il n'y a concordance que dans les transformations réversibles, lorsque l'énergie mécanisable est entièrement libérée et recueillie extérieurement."
                            }
                        ]
                    }
                ],
