                "senses": [
                    {
                        "sense_id": "d7de2468-3857-389e-884b-4685e0738b72",
                        "entry_id": "82d9e968-2a90-3b29-908b-066195af8520",
                        "glosses": [
                            "рег. последний или поздний ребёнок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d27d0725-a289-4c9e-855f-656558f8b6b0",
                                "sense_id": "d7de2468-3857-389e-884b-4685e0738b72",
                                "text": "Валерия смеялась тихо, стеклянно-звенящим смехом и завистливо смотрела на сестёр: ей бы хотелось такого же веселья, но было почему-то невесело: она думала, что она — последняя, поскрёбыш, а потому слабая и несчастливая."
                            },
                            {
                                "example_id": "517b7f96-ce98-45d7-9ac5-622844e8fb21",
                                "sense_id": "d7de2468-3857-389e-884b-4685e0738b72",
                                "text": "Маша в семье была шестая, поскрёбыш."
                            }
                        ]
                    }
                ],
