                                        "sense_id": "8774bf05-27ab-3324-b4b4-3565dcbe85b4",
                                        "entry_id": "9b239827-5bf6-3514-8361-c32070845eb6",
                                        "glosses": [
                                            "The act of recriminating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f651f21-5feb-3ca5-8fac-4e44ccc4f020",
                                        "entry_id": "9b239827-5bf6-3514-8361-c32070845eb6",
                                        "glosses": [
                                            "A counter or mutual accusation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea8bc7e-85d9-4fa4-bab0-fe1193e3e8e0",
                                                "sense_id": "3f651f21-5feb-3ca5-8fac-4e44ccc4f020",
                                                "text": "Will's figures, if correct, serve to underscore the extent of apolitical and anti-political sentiment in our community. Rather than indulge in recriminations over who \"lost\" the gay vote, it might be better to ask how we can redouble our efforts or re-direct our efforts to get gays and lesbians not only registered but voting as well."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "448022f9-0261-4c6b-9ee1-e74401575748",
                        "source_entry_id": "9cf2452d-2ead-33ce-8f46-41c8d6eae94d",
                        "source_sense_description": "Accusation qui tend à en repousser une autre",
                        "target_lang_word": "recriminazione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3c646033-e6b7-4745-ba2e-b18b234d4c44",
                        "source_entry_id": "9cf2452d-2ead-33ce-8f46-41c8d6eae94d",
                        "source_sense_description": "Critique amère",
                        "target_lang_word": "Protest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd014e6-70b1-398d-90d7-5b9d03814db0",
                                        "entry_id": "201bf1fa-73fc-378b-9cb1-d34aae4cb424",
                                        "glosses": [
                                            "Worte, Handlungen oder Ähnliches, die deutlich zum Ausdruck bringen, dass man mit etwas nicht einverstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c25617-2377-4443-ad14-7ba63f1a7747",
                                                "sense_id": "bfd014e6-70b1-398d-90d7-5b9d03814db0",
                                                "text": "Ihr Protest fand kein Gehör."
                                            },
                                            {
                                                "example_id": "505a59ec-b39e-4c8b-9da7-79a240498eae",
                                                "sense_id": "bfd014e6-70b1-398d-90d7-5b9d03814db0",
                                                "text": "„Doch ihr Protest, den sie auch an den damaligen Ministerpräsidenten Roland Koch richteten, war der Beginn ihres beruflichen Abstiegs.“"
                                            },
                                            {
                                                "example_id": "51473cf9-07d8-4524-a5f5-e3a4de9414b5",
                                                "sense_id": "bfd014e6-70b1-398d-90d7-5b9d03814db0",
                                                "text": "„Von Halder fuhr sich zum Zeichen des Protests energisch durch die Mähne, dann hob er die Hand.“"
                                            },
                                            {
                                                "example_id": "06599f99-bc2a-42cb-a987-904e4e71a95e",
                                                "sense_id": "bfd014e6-70b1-398d-90d7-5b9d03814db0",
                                                "text": "„Im März 1971 kam es in Dortmund zu einem mehrwöchigen Protest gegen eine dreißigprozentige Erhöhung der Fahrpreise im Nahverkehr.“"
                                            },
                                            {
                                                "example_id": "abdaf80a-e158-47f1-8981-10174c9d23f6",
                                                "sense_id": "bfd014e6-70b1-398d-90d7-5b9d03814db0",
                                                "text": "„Protest gehörte nun zum guten Ton, bis hinein ins sogenannte Establishment, Opern- und Theaterpublikum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fde4cb6b-af30-34e1-8e62-6c8f012753bb",
                                        "entry_id": "201bf1fa-73fc-378b-9cb1-d34aae4cb424",
