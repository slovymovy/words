                    ]
                },
                {
                    "sense_id": "8181678d-e940-36b4-91c3-aedd83c70c55",
                    "sense_definition": "Onbestendig zijn, waarbij vorst en dooi elkaar afwisselen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het weer <w>kwakkelt</w> al dagen, waardoor de sneeuw telkens smelt en weer bevriest."
                        },
                        {
                            "text": "De winter <w>kwakkelde</w> voort zonder dat we echt op natuurijs konden schaatsen."
