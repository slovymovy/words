                "senses": [
                    {
                        "sense_id": "480cfc32-1e5e-335e-9c7e-a000e5f503f5",
                        "entry_id": "bc1bbef4-bdc8-33d7-ba9f-a4f7c72bf603",
                        "glosses": [
                            "aus geologischen Schichten von Lava und Asche aufgebauter kegelförmiger Vulkan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0154706a-76e3-46e5-991b-689fb0af3460",
                                "sense_id": "480cfc32-1e5e-335e-9c7e-a000e5f503f5",
                                "text": "Typisch für den Aufbau eines Stratovulkans ist daher eine wechselnde Abfolge von Aschen- und Lavaschichten."
                            },
                            {
                                "example_id": "dc4508c6-34f9-4953-aac9-dc647201817a",
                                "sense_id": "480cfc32-1e5e-335e-9c7e-a000e5f503f5",
                                "text": "Stratovulkane sind typisch für Vulkane entlang von Subduktionszonen, die ein intermediäres-saures Magma produzieren."
                            },
                            {
                                "example_id": "baac0886-0e1e-43d1-bd59-37d85f5ef8b0",
                                "sense_id": "480cfc32-1e5e-335e-9c7e-a000e5f503f5",
                                "text": "Typischerweise verfügen Stratovulkane über einen Gipfelkrater, aus dem die meisten Eruptionen erfolgen."
                            },
                            {
                                "example_id": "6e785b84-cff3-4d76-9f33-023305a5efed",
                                "sense_id": "480cfc32-1e5e-335e-9c7e-a000e5f503f5",
                                "text": "Der Cerro Solo oder El Solo ist ein 6190 m, nach anderen Quellen 6205 m hoher Stratovulkan in den Anden am Rande der Atacamawüste in der Grenzregion der argentinischen Provinz Catamarca und der chilenischen Región de Atacama."
                            },
                            {
                                "example_id": "8e075d89-6d9c-401f-b48c-92ae4045320a",
                                "sense_id": "480cfc32-1e5e-335e-9c7e-a000e5f503f5",
                                "text": "Der fast 3.500 Meter hohe Stratovulkan Nyiragongo gehört zu den acht aktiven Virunga-Vulkanen im Grenzgebiet von Ruanda, Uganda und dem Kongo."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
