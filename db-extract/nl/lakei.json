                "senses": [
                    {
                        "sense_id": "859cb994-17af-3729-9178-8f3493ac9d4a",
                        "entry_id": "f574cccd-0ac2-3da0-991d-56464e8f53f8",
                        "glosses": [
                            "Een lakei of dienaar is een bediende werkend aan een koninklijk hof."
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "d781feec-1437-4860-9c23-7b44ada7d31f",
                                "sense_id": "859cb994-17af-3729-9178-8f3493ac9d4a",
                                "text": "In gewone huishoudens staat de lakei vaak bekend onder de Engelse naam butler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4aac88d-049c-4a77-b26e-5ece3375e962",
                        "source_entry_id": "f574cccd-0ac2-3da0-991d-56464e8f53f8",
                        "source_sense_id": "859cb994-17af-3729-9178-8f3493ac9d4a",
                        "source_sense_description": "(beroep) Een lakei of dienaar is een bediende werkend aan een koninklijk hof",
                        "target_lang_word": "Lakai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lakai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                        "entry_id": "0beb8530-9b5d-34b1-a177-1887b1d71213",
                                        "glosses": [
                                            "livrierter Diener"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed62cbd1-6f73-4e63-a5f6-206d61e40ba6",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "In vornehmen Hotels gibt es Lakaien."
                                            },
                                            {
                                                "example_id": "72bf5603-02a9-45e1-adab-746fd8312f7d",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Die Julirevolution machte die Lakaien stellungslos, auch ihn, der seiner Wesensart nach alles eher war denn ein Lakai.“"
                                            },
                                            {
                                                "example_id": "ff1b3a56-4efb-4094-9812-bb461cc36b8c",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Ein Lakai und ein Kirchendiener mit einem Räucherfass kamen ihnen auf den Zehenspitzen entgegen, ohne sie aber zu beachten.“"
                                            },
                                            {
                                                "example_id": "744cf7bc-cf3b-44c8-9496-853aa3270703",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Ich ließ mein Gepäck heraufbringen; mein Lakai kam und machte mir einen anständigen Eindruck.“"
                                            },
                                            {
                                                "example_id": "b96be1bb-03f2-4a17-acb0-c88c2ccbd19b",
                                                "sense_id": "b14d03f3-d73a-309c-a311-9d127b92d781",
                                                "text": "„Der Lakai auf dem Kutschbock versucht mit verklammten Fingern das Halstuch um die frostroten Ohren zu knüpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                        "entry_id": "0beb8530-9b5d-34b1-a177-1887b1d71213",
                                        "glosses": [
                                            "Ja-Sager, Heuchler, der etwas unterstützt, beziehungsweise nicht dagegen vorgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b6afba8-dc90-43ee-8086-96bd4f6154fa",
                                                "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                                "text": "Der Herr Apotheker hatten den Mitgliedern des Stadtrates gegenüber den Lakaien gemacht."
                                            },
                                            {
                                                "example_id": "1bd26007-bf20-4ccd-adbf-42a8564aee02",
                                                "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                                "text": "Die Ölindustrie und ihre Lakaien müssen zur Verantwortung gezogen werden!"
                                            },
                                            {
                                                "example_id": "2346f20c-cf74-4dcc-af59-49fa14063a30",
                                                "sense_id": "0d945d1e-d526-3653-bf4a-9d91c543d5cc",
                                                "text": "„Es war Hugo Machowski mit drei seiner Lakaien, allesamt bemüht, ihn aufzurichten, abzuklopfen und in eine Decke zu hüllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
