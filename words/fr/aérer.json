                        "aérer la pièce"
                    ]
                },
                {
                    "sense_id": "c35264a8-5eb1-342c-9654-1999341ad7d3",
                    "sense_definition": "Prendre l'air frais ou respirer au dehors pour se reposer et se détendre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "detente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de travail, il aime marcher pour s'<w>aérer</w> l'esprit."
                        },
                        {
                            "text": "Nous sortons un instant dans le jardin pour nous <w>aérer</w> un peu."
                        }
                    ],
                    "common_phrases": [
