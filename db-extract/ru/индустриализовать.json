                    {
                        "translation_id": "228c5569-d310-494c-a28b-1e9380d175bd",
                        "source_entry_id": "ccfe1c78-a3ed-39ef-8bc9-a6e86ce39d4d",
                        "source_sense_id": "3607252f-dd96-3734-a496-9c1b8e70919f",
                        "target_lang_word": "industrialisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "industrialisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8464ecd7-0320-319a-8f8c-24a16d7b9895",
                                        "entry_id": "67e71e8f-500d-33fe-a493-1236353d52dc",
                                        "glosses": [
                                            "in einem Gebiet Industrie aufbauen und entwickeln"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46f15a9e-c967-443b-957a-bf69113d8e66",
                                                "sense_id": "8464ecd7-0320-319a-8f8c-24a16d7b9895",
                                                "text": "Auch hierin liegt ein bedeutender Unterschied im Vergleich zu Frankreich, das sich früher zu industrialisieren begann, aber durch „ein Wachstum ohne besondere Beschleunigung, einen sich seit Ende des 18. Jahrhunderts über einen sehr langen Zeitraum erstreckenden Industrialisierungprozeß“ gekennzeichnet ist."
                                            },
                                            {
                                                "example_id": "60e6364e-58b0-4850-93eb-51347285ff35",
                                                "sense_id": "8464ecd7-0320-319a-8f8c-24a16d7b9895",
                                                "text": "Das traditionelle Agrarland, in dem Land- und Forstwirtschaft auch heute noch einen bedeutenden Platz einnehmen, wurde industrialisiert."
                                            },
                                            {
                                                "example_id": "50160f1e-4356-4068-a4ce-bd54cb8fd11c",
                                                "sense_id": "8464ecd7-0320-319a-8f8c-24a16d7b9895",
                                                "text": "Aber trotz langer handwerklicher Tradition ist unser Land erst nach dem Zweiten Weltkrieg so richtig industrialisiert worden."
                                            },
                                            {
                                                "example_id": "baac5f2c-bada-4d5a-862f-f962123b220b",
                                                "sense_id": "8464ecd7-0320-319a-8f8c-24a16d7b9895",
                                                "text": "Danach folgte innert kürzester Zeit ein radikaler Wechsel: Dietikon wurde industrialisiert und erreichte 1953 die Grösse einer Stadt."
                                            },
                                            {
                                                "example_id": "18453db3-cb87-4cd9-aa44-0490ee12753e",
                                                "sense_id": "8464ecd7-0320-319a-8f8c-24a16d7b9895",
                                                "text": "Mit der Gründung der UdSSR im Dezember 1922 und besonders mit dem Beginn der Fünfjahrespläne im Jahr 1928 wurde der Staat wieder aufgebaut, er wurde industrialisiert, der Analphabetismus beseitigt, wissenschaftliche Forschungszentren geschaffen und der Weltraum erobert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e61e4ceb-2003-3d94-ad40-8052473a24ff",
                                        "entry_id": "67e71e8f-500d-33fe-a493-1236353d52dc",
                                        "glosses": [
                                            "standardisierte und automatisierte Arbeitsprozesse einführen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8622e3a-6f0a-4ced-a9b0-fe1c608ed9fe",
                                                "sense_id": "e61e4ceb-2003-3d94-ad40-8052473a24ff",
                                                "text": "Die Landwirtschaft wurde industrialisiert und mechanisiert: Topmoderne Maschinen, spezielle Kunstdünger und wirksame Pestizide steigerten die Erträge um ein Vielfaches."
                                            },
                                            {
                                                "example_id": "5faaced7-400b-4484-9138-f9195f8068dd",
                                                "sense_id": "e61e4ceb-2003-3d94-ad40-8052473a24ff",
                                                "text": "So thematisierte der Kongress unter dem Titel „Krankenhäuser lassen sich nicht „industrialisieren“ in wie weit das eben doch – sogar zum Wohle des Patienten geht."
                                            },
                                            {
                                                "example_id": "3993bfb2-d0fc-40fc-9278-e657f3d394b5",
                                                "sense_id": "e61e4ceb-2003-3d94-ad40-8052473a24ff",
                                                "text": "Die Frachtcontainer haben das Transportwesen industrialisiert und wurden zur Grundlage der globalisierten Wirtschaft."
                                            },
                                            {
                                                "example_id": "e93df455-fe99-4b7b-bdc1-8349d4c85aec",
                                                "sense_id": "e61e4ceb-2003-3d94-ad40-8052473a24ff",
                                                "text": "Dann lassen sich die kundenfernen Bereiche konsequent industrialisieren und in denjenigen Bereichen, in denen der unmittelbare Kundenkontakt besteht, ebenso konsequent eine möglichst hohe Qualität der Dienstleistung anstreben."
                                            },
                                            {
                                                "example_id": "e23ed5d7-c35a-4822-ae8e-13582da6ed52",
                                                "sense_id": "e61e4ceb-2003-3d94-ad40-8052473a24ff",
                                                "text": "Die Diamantenförderung wurde industrialisiert und in gewaltigen Fabrikanlagen wurde der diamanthaltige Kies ausgesiebt und gewaschen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
