                                "target_senses": [
                                    {
                                        "sense_id": "555fb30e-2cfa-3a18-8586-4a26acd3a460",
                                        "entry_id": "9b2f80a0-1118-3a35-a092-7b6c96e61900",
                                        "glosses": [
                                            "Sibirien betreffend, zu Sibirien gehörend, aus Sibirien stammend"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6feca71f-874f-4730-9056-f8fac7c49cab",
                                                "sense_id": "555fb30e-2cfa-3a18-8586-4a26acd3a460",
                                                "text": "„Im sibirischen Kosmodrom gibt es bislang nur eine normale Sojus-Plattform für Satellitenstarts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f739b532-7e38-340f-b35e-c64ef67d535a",
                                        "entry_id": "9b2f80a0-1118-3a35-a092-7b6c96e61900",
                                        "glosses": [
                                            "sehr kalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ed4b66-5456-4041-8256-9714040a8199",
                                                "sense_id": "f739b532-7e38-340f-b35e-c64ef67d535a",
                                                "text": "„In der kalten Jahreszeit sind solche Szenen nicht selten. Man versteht das, wenn sibirische Winde über vereiste Landschaften fegen oder ein Blizzard die Schneeflocken fast horizontal vor sich hertreibt.“"
                                            },
                                            {
                                                "example_id": "8c3ad674-e2bc-44e6-b11a-c245c4d52cf9",
                                                "sense_id": "f739b532-7e38-340f-b35e-c64ef67d535a",
                                                "text": "„Sibirische Kaltluft hatte die Temperaturen im Nordosten Deutschlands auf zweistellige Minuswerte sinken lassen, während es im Südwesten deutlich milder war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
