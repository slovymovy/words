                                                "sense_id": "399bd6fb-d1bf-35fc-807b-3eea232ceac4",
                                                "text": "A adolescência é a fase da vida entre a infância e a idade adulta, dos 10 aos 19 anos"
                                            },
                                            {
                                                "example_id": "c9ff7639-79d7-4f1c-83a9-c78e546ece9f",
                                                "sense_id": "399bd6fb-d1bf-35fc-807b-3eea232ceac4",
                                                "text": "As questões relacionadas com a adolescência interessam a pais e professores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7e6c414-4ae4-4730-9a30-b581cbaea754",
                        "source_entry_id": "65c4e7ff-67c0-31c8-9b31-27ebf25cc21e",
                        "target_lang_word": "puberta",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puberta",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "dcbde6c1-4005-321b-85dd-b4646fbb5c1b",
                                        "entry_id": "2022ae90-5b8a-3ab8-9e56-aa4b731ff433",
                                        "glosses": [
                                            "období v životě provázené změnou chování, kdy se dětské tělo stává dospělým, schopným rozmnožování"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20152412-fd97-430e-85be-bfe0b23bb3e5",
                                                "sense_id": "dcbde6c1-4005-321b-85dd-b4646fbb5c1b",
                                                "text": "Jako dítě zpíval hezky, ale v pubertě se mu změnil hlas a teď už to není ono."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
