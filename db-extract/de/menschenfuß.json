                                "example_id": "d16677ce-369b-450f-b464-618556505ba4",
                                "sense_id": "6cddf96a-ffd2-36f7-b0f6-76e4e3161c5f",
                                "text": "Bin ich denn auf dem Felsen im Rockenthal, wo seit Erschaffung der Welt noch kein Menschenfuß hinaufgekommen ist?"
                            },
                            {
                                "example_id": "d304e68b-3814-43e0-b400-9f5daae4cf69",
                                "sense_id": "6cddf96a-ffd2-36f7-b0f6-76e4e3161c5f",
                                "text": "Da sind Pfade, die keine Wege sind, weil sie nicht so sind, wie Menschenfüße sie austreten."
                            }
                        ]
                    }
