                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24d33ade-ede3-4e23-a6d6-80cefbc2480e",
                        "source_entry_id": "15a211b6-948c-3382-8b5a-847f9abb35ec",
                        "target_lang_word": "schikanieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schikanieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63e549dd-c28d-39ff-84ff-5cb4c40ee16e",
                                        "entry_id": "2c6586d5-5621-3640-b910-eee9a7913078",
                                        "glosses": [
                                            "eine Person (in der Öffentlichkeit) terrorisieren, gegen sie intrigieren oder sie mobben; mit unnötigen Aufgaben (Schikanen) quälen"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d21b27-8e40-49b4-972c-03eedd7b89d5",
                                                "sense_id": "63e549dd-c28d-39ff-84ff-5cb4c40ee16e",
                                                "text": "Elisabeth wird von ihrem kleinen Bruder ständig schikaniert."
                                            },
                                            {
                                                "example_id": "caee66ca-0db3-4056-9f2f-c5235721dc5d",
                                                "sense_id": "63e549dd-c28d-39ff-84ff-5cb4c40ee16e",
                                                "text": "Der Ausbilder liebte es, die neuen Wehrpflichtigen mit Gewaltmärschen zu schikanieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a7183de-0aa9-4077-9d39-6891611ff7a1",
                        "source_entry_id": "15a211b6-948c-3382-8b5a-847f9abb35ec",
                        "target_lang_word": "malträtieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malträtieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20e2e6c0-8af2-3aaf-be24-04c2aee6160d",
                                        "entry_id": "cdaa2404-21d8-38ff-b347-2380d621b971",
                                        "glosses": [
                                            "jemanden (oder etwas) peinigen, misshandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1cdc9dc-d0ae-4d21-b415-fa92e19be8db",
                                                "sense_id": "20e2e6c0-8af2-3aaf-be24-04c2aee6160d",
                                                "text": "Wenn er seine Freunde weiterhin so malträtiert, wird er bald alleine dastehen."
                                            },
                                            {
                                                "example_id": "6540e4f9-0bd1-4bcd-85b2-5763ff91b16a",
                                                "sense_id": "20e2e6c0-8af2-3aaf-be24-04c2aee6160d",
                                                "text": "Die kleine Katze, die uns zulief, sah nicht nur furchtbar abgemagert aus, sondern war den Verletzungen nach gewiss auch malträtiert worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "360fb19f-afa2-39aa-bd06-c7aa0845dcb1",
                                        "entry_id": "cdaa2404-21d8-38ff-b347-2380d621b971",
                                        "glosses": [
                                            "etwas so schlecht behandeln, dass es daran Schaden nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b189c1a1-75e7-4654-9160-b82c6207465a",
                                                "sense_id": "360fb19f-afa2-39aa-bd06-c7aa0845dcb1",
                                                "text": "Jetzt malträtier die arme Gitarre nicht so brutal!"
                                            }
                                        ],
