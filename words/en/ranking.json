                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis player improved her <w>ranking</w> significantly after winning the major tournament.",
                            "target_lang_translations": {
                                "ru": "Теннисистка значительно улучшила свой <w>рейтинг</w> после победы в крупном турнире.",
                                "de": "Die Tennisspielerin verbesserte ihre <w>Platzierung</w> nach dem Sieg beim Grand-Slam-Turnier erheblich.",
                                "pl": "Tenisistka znacznie poprawiła swój <w>ranking</w> po wygraniu ważnego turnieju.",
                                "tr": "Tenisçi, büyük turnuvayı kazandıktan sonra <w>sıralamasını</w> önemli ölçüde yükseltti."
                            }
                        },
                        {
                            "text": "The university dropped several places in the national <w>rankings</w> this year.",
