{
    "word_family": [
        "absent",
        "absentee",
        "absenteeism",
        "absently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78b93bd8-9566-3848-9f4e-ed6f44966c22",
                    "sense_definition": "The state or fact of not being present at a place where one is expected to be.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_being_away",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>absence</w> from the meeting was noticed by everyone.",
                            "target_lang_translations": {
                                "ru": "Все заметили её <w>отсутствие</w> на собрании.",
                                "zh": "大家注意到了她会议上的<w>缺席</w>。"
                            }
                        },
                        {
                            "text": "Please inform the teacher if you need to take a leave of <w>absence</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сообщите учителю, если вам потребуется разрешённое <w>отсутствие</w> на занятиях.",
                                "zh": "如果你需要<w>请假</w>，请告知老师。"
                            }
                        }
                    ],
                    "synonyms": [
                        "non-attendance",
                        "being away"
                    ],
                    "antonyms": [
                        "presence"
                    ],
                    "common_phrases": [
                        "leave of absence",
                        "conspicuous absence",
                        "sickness absence",
                        "unexplained absence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или факт отсутствия в месте, где ожидается чье-то присутствие",
                        "zh": "指某人未出现在其应当在的地方的状态或事实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсутствие",
                                "target_lang_sense_clarification": "состояние, когда кого-то нет на месте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺席",
                                "target_lang_sense_clarification": "指未出席会议、活动等"
                            },
                            {
                                "target_lang_word": "不在场",
                                "target_lang_sense_clarification": "指某人不在某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75fc6859-7d0e-361d-bc30-4df996614aa8",
                    "sense_definition": "A period of time during which someone or something is away.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_being_away",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During Jane's <w>absence</w>, Mark will be taking charge of the project.",
                            "target_lang_translations": {
                                "ru": "Во время <w>отсутствия</w> Джейн руководить проектом будет Марк.",
                                "zh": "在简<w>不在场</w>期间，马克将负责该项目。"
                            }
                        },
                        {
                            "text": "He returned to his hometown after an <w>absence</w> of ten years.",
                            "target_lang_translations": {
                                "ru": "Он вернулся в родной город после десятилетнего <w>отсутствия</w>.",
                                "zh": "他<w>离开</w>十年后回到了家乡。"
                            }
                        }
                    ],
                    "antonyms": [
                        "presence"
                    ],
                    "common_phrases": [
                        "during someone's absence",
                        "after a long absence",
                        "prolonged absence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, в течение которого кто-то или что-то находится в другом месте",
                        "zh": "指某人或某物离开的一段时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсутствие",
                                "target_lang_sense_clarification": "период времени"
                            },
                            {
                                "target_lang_word": "отлучка",
                                "target_lang_sense_clarification": "временный уход или отъезд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺席期间",
                                "target_lang_sense_clarification": "指某人离开的时间段"
                            },
                            {
                                "target_lang_word": "离开",
                                "target_lang_sense_clarification": "指离开某地的一段时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f5a68cf-8e75-31a7-8ff9-09013e43fe55",
                    "sense_definition": "The non-existence or lack of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "lack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plants died due to a complete <w>absence</w> of rain.",
                            "target_lang_translations": {
                                "ru": "Растения погибли из-за полного <w>отсутствия</w> дождя.",
                                "zh": "由于完全<w>缺乏</w>降雨，植物枯死了。"
                            }
                        },
                        {
                            "text": "In the <w>absence</w> of clear instructions, we did what we thought was best.",
                            "target_lang_translations": {
                                "ru": "При <w>отсутствии</w> чётких инструкций мы действовали так, как считали лучшим.",
                                "zh": "在<w>缺乏</w>明确指示的情况下，我们做了自认为最好的决定。"
                            }
                        }
                    ],
                    "antonyms": [
                        "existence",
                        "presence",
                        "sufficiency"
                    ],
                    "common_phrases": [
                        "in the absence of",
                        "total absence",
                        "absence of evidence",
                        "conspicuous by absence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несуществование или нехватка чего-либо",
                        "zh": "指某事物的缺失或不存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсутствие",
                                "target_lang_sense_clarification": "полное отсутствие чего-либо"
                            },
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "недостаточное количество"
                            },
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "дефицит"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺乏",
                                "target_lang_sense_clarification": "指缺少某物"
                            },
                            {
                                "target_lang_word": "不存在",
                                "target_lang_sense_clarification": "指某事物完全没有"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "590b3b3b-f2d6-3583-b69f-da40495fb8b2",
                    "sense_definition": "A sudden, temporary loss of consciousness or awareness, often associated with epilepsy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that the child's staring spells were actually a type of <w>absence</w>.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что моменты, когда ребёнок смотрит в одну точку, на самом деле являются разновидностью <w>абсанса</w>.",
                                "zh": "医生解释说，孩子发呆的情况实际上是一种<w>失神</w>发作。"
                            }
                        },
                        {
                            "text": "Medication can help reduce the frequency of an epileptic <w>absence</w>.",
                            "target_lang_translations": {
                                "ru": "Лекарства могут помочь снизить частоту эпилептических <w>абсансов</w>.",
                                "zh": "药物可以帮助减少癫痫<w>失神</w>发作的频率。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная кратковременная потеря сознания, часто связанная с эпилепсией",
                        "zh": "一种突发的、短暂的意识丧失，常与癫痫有关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсанс",
                                "target_lang_sense_clarification": "медицинский термин, вид эпилептического припадка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失神",
                                "target_lang_sense_clarification": "医学术语，指失神性癫痫发作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}