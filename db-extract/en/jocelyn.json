                                    }
                                ]
                            },
                            {
                                "target_word": "Josselin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91a12c1d-e39b-35bd-bd61-2af10b3b4747",
                                        "entry_id": "29510c7f-9615-3618-9f79-98a6fafa2408",
                                        "glosses": [
                                            "Commune française, située dans le département du Morbihan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80bd37c6-7369-46c0-a74e-5808362e73de",
                                                "sense_id": "91a12c1d-e39b-35bd-bd61-2af10b3b4747",
                                                "text": "Je venais d’éprouver quelque chose d’analogue en touchant l’épée du grand Clisson, au château de Josselin près de Ploërmel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00cc32ab-8ea8-4269-b945-9d035e989b5e",
                        "source_entry_id": "5a3a6540-3cd9-3b28-a169-a56987252b45",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Jocelyne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jocelyne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80e12b50-754d-379e-8cdc-2bf8c4fc6a19",
                                        "entry_id": "df5b08c4-e04b-348a-ba35-d12e2140436f",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ec168f-d300-4f47-b1b7-23fac331cf50",
                                                "sense_id": "80e12b50-754d-379e-8cdc-2bf8c4fc6a19",
                                                "text": "En 2021, Jocelyne Larocque faisait partie de l’équipe canadienne qui a remporté la médaille d’or au championnat mondial."
                                            },
                                            {
                                                "example_id": "3de3c7b1-d97d-49cd-8c0d-e9c1925f7268",
                                                "sense_id": "80e12b50-754d-379e-8cdc-2bf8c4fc6a19",
                                                "text": "Et si, comme Jocelyne, vous trouvez « rageant de payer pour tout le monde », DoDeDo propose une alternative."
                                            },
                                            {
                                                "example_id": "ee732a0b-4e2c-4e73-bf05-3924b574c0a7",
                                                "sense_id": "80e12b50-754d-379e-8cdc-2bf8c4fc6a19",
                                                "text": "Mariage. À l’église ce samedi 17 juin à 17h30, d’Éric Tomaszewski et Jocelyne Kerbrat, du Puy-Leix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
