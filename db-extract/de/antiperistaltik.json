                "senses": [
                    {
                        "sense_id": "9f60c188-7788-3a20-aeee-cb4382d77ba5",
                        "entry_id": "f925d61d-245e-3baa-8b5e-d1d5881e7b76",
                        "glosses": [
                            "Umkehrung der normalen physiologischen Bewegung des Verdauungstraktes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb1b331a-be45-463f-94dc-2c998db38882",
                                "sense_id": "9f60c188-7788-3a20-aeee-cb4382d77ba5",
                                "text": "Eine Antiperistaltik kommt z. B. bei einem Darmverschluss vor, die Bewegung verläuft dann im umgekehrter Richtung."
                            },
                            {
                                "example_id": "4064f110-f400-4592-b348-7d2210cba26c",
                                "sense_id": "9f60c188-7788-3a20-aeee-cb4382d77ba5",
                                "text": "Innerhalb des Dünndarms wird der Darminhalt durch sogenannte Antiperistaltik hin- und hergeschaukelt."
                            },
                            {
                                "example_id": "34e26b10-5796-41bb-bff8-06ba48ea2757",
                                "sense_id": "9f60c188-7788-3a20-aeee-cb4382d77ba5",
                                "text": "Antiperistaltik spielt beim Erbrechen eine wichtige Rolle, um unverträgliche oder giftige Nahrung aus dem Gastrointestinaltrakt zu entfernen."
                            },
                            {
                                "example_id": "36ae2560-4eec-4edb-a5d3-50241251850f",
                                "sense_id": "9f60c188-7788-3a20-aeee-cb4382d77ba5",
                                "text": "Antiperistaltik findet sich relativ häufig bei Ulcus duedeni (…)."
                            },
                            {
                                "example_id": "6dd5c37a-b6be-4e01-bef6-83c2958075ba",
                                "sense_id": "9f60c188-7788-3a20-aeee-cb4382d77ba5",
                                "text": "Im Quercolon tritt gelegentlich eine Antiperistaltik auf, die den Stuhl zurück in den Blinddarm treibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
