                            {
                                "example_id": "167933f6-4a7c-4f1f-895f-0f22a41056c0",
                                "sense_id": "dea60afc-727a-3830-8aad-23ccc89d2cbc",
                                "text": "Ich lasse mich gern von einer Apothekerin beraten."
                            },
                            {
                                "example_id": "404491e7-7a98-4174-97e2-53c42aae4adf",
                                "sense_id": "dea60afc-727a-3830-8aad-23ccc89d2cbc",
                                "text": "„Die Apothekerin öffnet den Anar und hält mir eine Kammer hin.“"
                            },
                            {
                                "example_id": "5a3096e9-2676-4fc9-a12a-d7d33ac4bc81",
                                "sense_id": "dea60afc-727a-3830-8aad-23ccc89d2cbc",
                                "text": "„Die ungeheure Sammlung führt zugleich durch alle weiblichen Berufe, von der Blumenverkäuferin bis zur Juwelierin und Apothekerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
