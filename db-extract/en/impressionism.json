                                        "entry_id": "039d09ce-9d05-3f6e-a0a3-ad39a5027da9",
                                        "glosses": [
                                            "im 19. Jahrhundert entstandene Stilrichtung in der Malerei, in dessen Darstellung der Sinneseindruck einer Szenerie im Vordergrund steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2471d238-66aa-4f58-9e27-95b6cfbd2ddb",
                                                "sense_id": "b278816b-4958-34c5-86aa-123b01cd0966",
                                                "text": "Von Einfluss auf den Impressionismus waren japanische Farbholzschnitte, die ab 1850 in großer Stückzahl nach Europa kamen und durch die sich die Impressionisten in ihren eigenen Theorien über Farbe und Form bestätigt fühlten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
