                                "target_senses": [
                                    {
                                        "sense_id": "d617281e-69e5-3243-9ee9-ed67f2d09ded",
                                        "entry_id": "45651329-ce5d-3a71-bac4-131622d4160b",
                                        "glosses": [
                                            "Staatsbürgerin der Mongolei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3222a0-c3ea-481a-8ff3-63f99f09efe1",
                                                "sense_id": "d617281e-69e5-3243-9ee9-ed67f2d09ded",
                                                "text": "Er hat eine Mongolin geheiratet und lebt jetzt in Ulan-Bator."
                                            }
                                        ],
