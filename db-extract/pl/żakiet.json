                "senses": [
                    {
                        "sense_id": "62200afe-7cda-353c-90ab-338d8a84bf3e",
                        "entry_id": "a99259f1-b90d-3ea0-a8cf-3aff5e967081",
                        "glosses": [
                            "męskie eleganckie odzienie dzienne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6470cf53-08fb-4466-adbe-b4759e6c0995",
                                "sense_id": "62200afe-7cda-353c-90ab-338d8a84bf3e",
                                "text": "Wit nosił przy żakiecie pąsową różę."
                            },
                            {
                                "example_id": "a3acd083-af30-4d4d-90dd-3fd85074fb9a",
                                "sense_id": "62200afe-7cda-353c-90ab-338d8a84bf3e",
                                "text": "W kieszeni babcinego żakietu znalazłem sto marek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ca615f78-cad7-3056-9529-9686266886f7",
                        "entry_id": "a99259f1-b90d-3ea0-a8cf-3aff5e967081",
