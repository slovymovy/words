                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63e9321d-e687-367e-a52d-97a005f10035",
                                        "entry_id": "39c7f59d-3544-3912-86fa-8f1448d38158",
                                        "glosses": [
                                            "Épreuve éliminatoire d’une compétition dont le vainqueur sera amené à disputer les demi-finales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da35c10-b9a7-41b1-a573-11271e1e970f",
                                                "sense_id": "63e9321d-e687-367e-a52d-97a005f10035",
                                                "text": "Comme N’Golo Kanté, Adil Rami, averti ce dimanche contre l’Irlande, serait suspendu en cas d’éventuel quart de finale de l’Euro pour l’équipe de France."
                                            },
                                            {
                                                "example_id": "a5aeb200-ca4f-43f6-a494-7daf167edf4f",
                                                "sense_id": "63e9321d-e687-367e-a52d-97a005f10035",
                                                "text": "Le Pays de Galles s’est qualifié pour les quarts de finale de l’Euro grâce à sa victoire contre l’Irlande du Nord (1-0)."
                                            },
                                            {
                                                "example_id": "d3009956-398f-449a-b8f8-b435ea70eaad",
                                                "sense_id": "63e9321d-e687-367e-a52d-97a005f10035",
                                                "text": "Chez les hommes, un autre membre du pôle rochelais, Laszlo Godde, s’est qualifié hier avec la France, face à la Colombie (2-1) pour les quarts de finale par équipes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
