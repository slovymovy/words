                        "sense_id": "9e13735d-9032-3d91-a4c8-1776b31c52a0",
                        "entry_id": "3ce79dca-d7fa-3e66-b9f7-bcf8d051b293",
                        "glosses": [
                            "Élément minéral pur nécessaire à la vie d'un organisme, en grandes quantités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4122fc-c7a4-44f6-8c05-dc1a94747bca",
                                "sense_id": "9e13735d-9032-3d91-a4c8-1776b31c52a0",
                                "text": "Cette observation suggère que le bore est un macroélément essentiel."
                            },
                            {
                                "example_id": "00f87c91-d3a9-4270-a209-ca5a0ad93b7b",
                                "sense_id": "9e13735d-9032-3d91-a4c8-1776b31c52a0",
                                "text": "Certains minéraux sont abondants dans l'organisme. Ce sont les macroéléments tels le calcium, le phosphore, le potassium, le magnésium, le sodium, le chlore... Le calcium, le phosphore et le sodium sont les minéraux à considérer en priorité… Des carences entraînent des chutes de production et une pathologie plus ou moins spécifique."
                            }
                        ]
                    }
