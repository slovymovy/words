                ],
                "senses": [
                    {
                        "sense_id": "501d9960-6d0d-3b6c-8546-eb39c11151f5",
                        "entry_id": "355149c1-b9d0-3f8d-b547-c238e23fb7f2",
                        "glosses": [
                            "deutsches, belgisches und luxemburgisches Mittelgebirge begrenzt im Osten durch den Rhein und im Süden durch die Mosel, Teil des Rheinischen Schiefergebirges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0e4718-5430-4fa9-bc43-b1efb2e01be9",
                                "sense_id": "501d9960-6d0d-3b6c-8546-eb39c11151f5",
                                "text": "„Die höchste Erhebung der Eifel ist die Hohe Acht (747 m).“"
                            },
                            {
                                "example_id": "e6ad9083-c286-4887-bf8b-405998ee42ab",
                                "sense_id": "501d9960-6d0d-3b6c-8546-eb39c11151f5",
                                "text": "Die Eifel ist ein sehr dünn besiedeltes Gebiet."
                            },
                            {
                                "example_id": "06d7557e-38b8-4d37-b754-41b556153be1",
                                "sense_id": "501d9960-6d0d-3b6c-8546-eb39c11151f5",
                                "text": "„Selbst der Steinbruch in der Eifel ist bekannt, aus dem der Mühlstein stammt, mit dem Legionäre in Hedemünden ihr Getreide mahlten.“"
                            },
                            {
                                "example_id": "db072c3d-e8f3-45d9-811a-7ffb6bd9fcff",
                                "sense_id": "501d9960-6d0d-3b6c-8546-eb39c11151f5",
                                "text": "„Aus einer versauten Welt voller Probleme ragt die Eifel wie eine Insel der Glückseligen.“"
                            },
                            {
                                "example_id": "e71eaa84-16a3-4ba0-ac75-06c6bad86e7e",
                                "sense_id": "501d9960-6d0d-3b6c-8546-eb39c11151f5",
                                "text": "„Als mich mein Großonkel in den späten 1970er Jahren manchmal auf seine Jolle auf dem Laacher See in der Eifel mitnahm, erzählte er mir vor allem vom Eissegeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
