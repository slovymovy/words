                "senses": [
                    {
                        "sense_id": "94444c14-a949-3713-8a24-6d57f5da8ef4",
                        "entry_id": "7e390ad0-209a-3f05-9b4a-60288e18ea00",
                        "glosses": [
                            "met veel aangeboren vaardigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28bcf3f9-47a7-43bc-bfba-0d0f3553c600",
                                "sense_id": "94444c14-a949-3713-8a24-6d57f5da8ef4",
                                "text": "De talentrijke middenvelder zou niet de juiste stem hebben."
                            },
                            {
                                "example_id": "c1d37c96-00c9-412d-8e49-819a6bdf8f3d",
                                "sense_id": "94444c14-a949-3713-8a24-6d57f5da8ef4",
                                "text": "De tijdritten lijken ook een kolfje naar de hand van het kwartet talentrijke Franse ronderenners. Zowel Jean-Christophe Péraud (zesde in 2011), Thomas Voeckler (twee ritzeges in 2011 en vierde in de Tour), Chavanel als Jérôme Coppel (negende in 2010) zijn sterk in geaccidenteerde tijdritten."
                            },
                            {
                                "example_id": "0c594093-428c-4353-8e18-4230f4db38e7",
                                "sense_id": "94444c14-a949-3713-8a24-6d57f5da8ef4",
                                "text": "\"Bij de elite schreeuwen ze om nieuwe talentrijke niet-Belgische renners\", verwees hij naar het WK bij de profs, waar de Belgen de eerste zeven plaatsen bezetten."
                            }
                        ]
                    }
