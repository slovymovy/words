    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f3e305e-2028-3ab8-bea7-dbf89308b0fd",
                    "sense_definition": "Een groot herkauwend zoogdier dat vaak gehouden wordt voor melk, vlees of als werkkier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer heeft dertig <w>runderen</w> in de wei staan voor de melkproductie.",
                            "target_lang_translations": {
                                "ru": "У фермера на пастбище стоят тридцать <w>коров</w> для производства молока."
                            }
                        },
                        {
                            "text": "In de supermarkt kun je vers <w>rund</w> kopen voor het avondeten.",
                            "target_lang_translations": {
                                "ru": "В супермаркете можно купить свежую <w>говядину</w> на ужин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vlees van het rund"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное жвачное млекопитающее, которое часто содержат ради молока, мяса или в качестве рабочего животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корова",
                                "target_lang_sense_clarification": "самка или общее название животного"
                            },
                            {
                                "target_lang_word": "бык",
                                "target_lang_sense_clarification": "самец"
                            },
                            {
                                "target_lang_word": "крупный рогатый скот",
                                "target_lang_sense_clarification": "собирательное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d591181-36d8-3d3b-a70c-8222282bf5f0",
                    "sense_definition": "Een persoon die zich dom, onhandig of onverstandig gedraagt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "belediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je bent een <w>rund</w> als je met vuurwerk stunt.",
                            "target_lang_translations": {
                                "ru": "Ты настоящий <w>болван</w>, если балуешься с фейерверками."
                            }
                        },
                        {
                            "text": "Wat ben jij toch een <w>rund</w> dat je je sleutels weer bent vergeten.",
                            "target_lang_translations": {
                                "ru": "Ну и <w>бестолочь</w> же ты, раз снова забыл свои ключи."
                            }
                        }
                    ],
                    "synonyms": [
                        "domoor",
                        "ezel",
                        "idioot",
                        "oen",
                        "stommeling",
                        "sukkel"
                    ],
                    "common_phrases": [
                        "een groot rund"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik als belediging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя глупо, неуклюже или неразумно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "осел",
                                "target_lang_sense_clarification": "упрямый или глупый человек"
                            },
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "общий термин для глупого человека"
                            },
                            {
                                "target_lang_word": "бестолочь",
                                "target_lang_sense_clarification": "несообразительный человек"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}