                    },
                    {
                        "translation_id": "53a492e5-be86-4689-b44c-50ea5762ea6f",
                        "source_entry_id": "c85e722b-0308-3237-838c-7f2a1e291ec5",
                        "source_sense_id": "b7545dfe-6d34-3a8c-9854-fbf046d9ebfa",
                        "target_lang_word": "Ichthyolog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d6387c2a-cc27-4fac-8490-6209e10cd344",
                        "source_entry_id": "c85e722b-0308-3237-838c-7f2a1e291ec5",
                        "source_sense_id": "b7545dfe-6d34-3a8c-9854-fbf046d9ebfa",
                        "target_lang_word": "ichtyologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ichtyologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                        "entry_id": "38d97e85-03a8-3631-b158-870ce1432086",
                                        "glosses": [
                                            "Spécialiste de l’étude des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa3d805-5193-4d15-a43f-3282c9662b1e",
                                                "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                                "text": "Il se plonge dans la lecture du manuscrit et découvre alors que ce Risso fut ce qu’on appelle maintenant un ichtyologue, expert en poissons de la Méditerranée."
                                            },
                                            {
                                                "example_id": "a527a77c-f6e8-4411-aae2-3919d91dcb1c",
                                                "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                                "text": "Sur 200 mètres d’un ruisseau guyanais, des ichtyologues ont recensé 70 espèces de poissons, à comparer aux 81 espèces de l’Hexagone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7beea222-52d7-4455-af8e-7e4859aa2565",
                        "source_entry_id": "c85e722b-0308-3237-838c-7f2a1e291ec5",
                        "source_sense_id": "b7545dfe-6d34-3a8c-9854-fbf046d9ebfa",
                        "target_lang_word": "ichtyologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ichtyologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdfb558-7a99-3bd4-84ba-86d59ef6df32",
                                        "entry_id": "b6ab3874-8f81-3111-b4d4-d27655c15a75",
                                        "glosses": [
                                            "Personne qui est spécialiste de l’ichtyologie, l’étude des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946144f6-67d1-4e32-bf50-8e81b7b793a8",
                                                "sense_id": "ecdfb558-7a99-3bd4-84ba-86d59ef6df32",
                                                "text": "C’est celle de l’ichtyologiste qui explore, avec un filet, le fond des océans."
                                            },
                                            {
                                                "example_id": "be8f2946-9a3c-4dfc-a49c-226c9f8d3dcc",
                                                "sense_id": "ecdfb558-7a99-3bd4-84ba-86d59ef6df32",
                                                "text": "À prendre la moyenne des observations faites à diverses reprises, […] on pouvait affirmer, cependant, que cet être phénoménal dépassait de beaucoup toutes les dimensions admises jusqu’à ce jour par les ichthyologistes, — s’il existait toutefois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
