                                    {
                                        "sense_id": "a1be5794-aab5-3b42-a223-f859d51fca27",
                                        "entry_id": "0df05148-0d68-3371-89ae-b6157dd701a2",
                                        "glosses": [
                                            "Escaparate o armario con la puerta de cristal para que se pueda ver lo que hay en su interior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b347a43-6120-4056-92ce-4c7ba502c917",
                                                "sense_id": "a1be5794-aab5-3b42-a223-f859d51fca27",
                                                "text": "«Nada faltaba: desde los juguetes en la vitrina del saloncito a los jabones, perfumes y demás fornimento del cuarto del baño»."
                                            },
                                            {
                                                "example_id": "1baa8acb-e487-4418-afd1-b666127951b6",
                                                "sense_id": "a1be5794-aab5-3b42-a223-f859d51fca27",
                                                "text": "«Fijose un instante en la vitrina donde se exponían, en reluciente variedad, todos los tipos de lavativas y clisteles (…)»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
