        "fr-extract.jsonl": [
            {
                "entry_id": "6a0ddd8d-778f-3c5a-8b2e-719f570c4f36",
                "word": "conjonctivite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32ccf424-9582-401a-87fc-972619bf91fd",
                        "entry_id": "6a0ddd8d-778f-3c5a-8b2e-719f570c4f36",
                        "tags": [
                            "plural"
                        ],
                        "form": "conjonctivites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "461ad087-61cd-3b1d-9cd2-9a869786ebd1",
                        "entry_id": "6a0ddd8d-778f-3c5a-8b2e-719f570c4f36",
                        "glosses": [
                            "Inflammation de la conjonctive, qui peut être d'origine virale, bactérienne ou allergique ou être causée par une irritation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd45b9f-b8db-4b10-9b76-753ed5d0f0bc",
                                "sense_id": "461ad087-61cd-3b1d-9cd2-9a869786ebd1",
                                "text": "— La note signalerait en manière de post-scriptum une épidémie de conjonctivite granuleuse dans les campagnes circonvoisines, et une épizootie de morve transmissible à l’homme."
                            },
                            {
                                "example_id": "7191a7de-6072-4495-a7d3-746de012e12b",
                                "sense_id": "461ad087-61cd-3b1d-9cd2-9a869786ebd1",
                                "text": "Dans le kiosque à côté près du métro, la marchande elle, s’en fout de l’avenir, elle se gratte sa vieille conjonctivite et se la purulente lentement avec les ongles."
                            },
                            {
                                "example_id": "b2637515-ccb1-4817-95ea-b0620da6d862",
                                "sense_id": "461ad087-61cd-3b1d-9cd2-9a869786ebd1",
                                "text": "La conjonctivite est une inflammation de la conjonctive, une membrane muqueuse qui recouvre la partie apparente du globe oculaire, en dehors de la cornée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "425d24bc-73dc-4cfe-acb6-88150229f187",
                        "source_entry_id": "6a0ddd8d-778f-3c5a-8b2e-719f570c4f36",
                        "source_sense_id": "461ad087-61cd-3b1d-9cd2-9a869786ebd1",
                        "target_lang_word": "Konjunktivitis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konjunktivitis",
