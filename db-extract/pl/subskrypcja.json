                                "target_senses": [
                                    {
                                        "sense_id": "b89e4175-6feb-3982-bd26-3c7b4a22b38f",
                                        "entry_id": "a2bb3e37-789d-3973-b0d0-66b251240542",
                                        "glosses": [
                                            "Vorbestellung und Verpflichtung zur Abnahme bei Neuerscheinung, zum Beispiel bei größeren, in mehreren Bänden erscheinenden Werken der Literatur"
                                        ],
                                        "tags": [
                                            "Buchwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ad8f8f-fc27-4433-b7ab-bd5c1af63b5b",
                                                "sense_id": "b89e4175-6feb-3982-bd26-3c7b4a22b38f",
                                                "text": "Große Lexika werden oft lange vor Erscheinen zur Subskription ausgeschrieben."
                                            },
                                            {
                                                "example_id": "8907cf0c-c93a-4a02-b472-ea185f55b883",
                                                "sense_id": "b89e4175-6feb-3982-bd26-3c7b4a22b38f",
                                                "text": "„Sie begann mit ihrer Druckerei, der von Maurice Darantiere in Dijon, und der Berechnung der zu druckenden Exemplare, dann schilderte sie, wie der Gewinn kalkuliert wurde, wie sie interessierte Kunden für eine Subskription gewann und wie die Einnahmen aufgeteilt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cc49a1db-4144-3d78-9360-13c369cf3767",
                                        "entry_id": "a2bb3e37-789d-3973-b0d0-66b251240542",
                                        "glosses": [
                                            "Zeichnung von Anleihen oder Aktien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b516af-2740-4ccf-b1e4-3b443d951cc1",
                                                "sense_id": "cc49a1db-4144-3d78-9360-13c369cf3767",
                                                "text": "Die Subskription gliedert sich in die Aufforderung zur Zeichnung, die Zeichnung und die Zuteilung an den Zeichner."
                                            },
                                            {
                                                "example_id": "fdb4e491-ead7-467d-b0bc-f2ee18f59a01",
                                                "sense_id": "cc49a1db-4144-3d78-9360-13c369cf3767",
                                                "text": "„Die Generaladjutanten brachten die Kosten im Wege der Subskription auf, und eine Dame, von der man glaubte, sie würde dem Kaiser zusagen, wurde aufgefordert, die Honneurs des Balles zu machen.“"
                                            },
                                            {
                                                "example_id": "6f1e8ad9-3bf8-4132-a490-1b14d5506878",
                                                "sense_id": "cc49a1db-4144-3d78-9360-13c369cf3767",
                                                "text": "„Die Begeisterung nimmt ab; denn ein 1827 in Cherbourg durch Subskription arrangierter Ball kommt nicht zustande.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c6bed8c-82f4-4686-ab7c-15f22166f668",
                        "source_entry_id": "34a8ff8a-8664-34ae-bdca-c55d7e317276",
