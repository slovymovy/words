                    {
                        "sense_id": "2ad329b8-e991-32b5-9c82-c111add02545",
                        "entry_id": "a0f7045f-cc7a-31ce-933d-7b0d10809f22",
                        "glosses": [
                            "Muse der epischen Dichtung"
