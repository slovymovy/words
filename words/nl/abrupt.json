                    "sense_definition": "op een onverwachte en zeer snelle manier gebeurend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plotseling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was een <w>abrupte</w> verandering in de temperatuur toen de zon onderging.",
                            "target_lang_translations": {
                                "en": "There was an <w>abrupt</w> change in the temperature when the sun went down."
                            }
                        },
                        {
                            "text": "De vergadering kwam tot een <w>abrupt</w> einde door het brandalarm.",
                            "target_lang_translations": {
                                "en": "The meeting came to an <w>abrupt</w> end because of the fire alarm."
                            }
                        }
                    ],
