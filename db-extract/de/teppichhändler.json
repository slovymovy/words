                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6252f6dd-0d6f-4439-bfd6-78e13d245b61",
                                "sense_id": "f2389391-3463-3abe-87bf-6c97270d3062",
                                "text": "„In Paris verkauften die wandernden Teppichhändler Pistazienkerne an den Cafétischen.“"
