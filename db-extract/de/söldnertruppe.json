                "senses": [
                    {
                        "sense_id": "89f25919-98cd-33e2-8206-c88abedb5df6",
                        "entry_id": "2897383d-55d1-34c9-b5e8-4cd55b64984f",
                        "glosses": [
                            "Truppe, die aus Söldnern besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db7c6e50-3d3b-4a1c-b8dc-3045e464ddfb",
                                "sense_id": "89f25919-98cd-33e2-8206-c88abedb5df6",
                                "text": "„Die Rezepte, durch die man eine Söldnertruppe in Ordnung hält, sind uralt; das ist eins der Gebiete, auf denen der Mensch die größte praktische Erfahrung besitzt.“"
                            },
                            {
                                "example_id": "0e081186-3bb5-46e6-aeca-ba421f9ce930",
                                "sense_id": "89f25919-98cd-33e2-8206-c88abedb5df6",
                                "text": "„Immer wieder kämpfen Freischärler und Söldnertruppen gegen Regierungssoldaten – und auch untereinander.“"
                            },
                            {
                                "example_id": "4566bd7a-2ea0-42ee-8bda-fa52b8b22beb",
                                "sense_id": "89f25919-98cd-33e2-8206-c88abedb5df6",
                                "text": "„Die Söldnertruppen der Ostindiengesellschaft waren ständig gewachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
