                        "sense_id": "11942f8a-ccc1-329c-819b-40c2aa9e9e8b",
                        "entry_id": "b80a281c-ce88-3d5c-bca4-c52a7c3b3385",
                        "glosses": [
                            "Variante de bessemériser."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "53afe14a-d0f8-4248-b7f4-28453e7675ea",
                                "sense_id": "11942f8a-ccc1-329c-819b-40c2aa9e9e8b",
                                "text": "La méthode consiste dans la désintégration électrolytique de la « matte » produite en fondant et en « bessemerisant » les minerais de cuivre-nickel;"
                            },
                            {
                                "example_id": "f81a53f9-29ba-440b-bcf3-f7c179f497d7",
                                "sense_id": "11942f8a-ccc1-329c-819b-40c2aa9e9e8b",
                                "text": "Les mettes renfermant du cuivre et du nickel sont bessemerisées, le produit est oxydé et le mélange d’oxydes réduit de façon à obtenir directement un alliage de cuivre-nickel sans séparation préalable des métaux."
                            }
                        ]
                    }
