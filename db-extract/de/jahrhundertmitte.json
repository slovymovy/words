                ],
                "senses": [
                    {
                        "sense_id": "ed688041-be70-377b-85fb-e88bf88601d3",
                        "entry_id": "444dc1eb-bbf9-3637-a1fe-1185a939efef",
                        "glosses": [
                            "Mitte eines Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf33a42-3fbb-41a0-83f3-e62a22ba2317",
                                "sense_id": "ed688041-be70-377b-85fb-e88bf88601d3",
                                "text": "In wenigen Jahren begrüßen wir schon wieder eine Jahrhundertmitte."
                            },
                            {
                                "example_id": "e52b6fdd-216c-4e39-80e5-fd7f16b3d24a",
                                "sense_id": "ed688041-be70-377b-85fb-e88bf88601d3",
                                "text": "„Ab der Jahrhundertmitte wurden die Juden in den osteuropäischen Ländern zunehmend Gegenstand von Reformen, die die Regierungen im Zuge verschiedener Zentralisierungs- und Modernisierungsbestrebungen in die Wege leiteten.“"
                            },
                            {
                                "example_id": "9f1033e3-b92e-4431-b22c-d6b3ab379f6d",
                                "sense_id": "ed688041-be70-377b-85fb-e88bf88601d3",
                                "text": "„Kurios im Grunde: Wieland sieht die deutsche Literatur noch so, wie alle Welt und ganz Deutschland sie um, sagen wir, 1750 sah, und nun sieht alle Welt und ganz Deutschland sie dort, wo die Dichter der Jahrhundertmitte sie sehen wollten, nämlich in Niveau, Differenziertheit, poetischer Intelligenz dort, wo Frankreich, Italien, England längst waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
