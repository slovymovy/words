                    },
                    {
                        "translation_id": "a9c8ad96-934b-424c-afd5-e6747fa14789",
                        "source_entry_id": "e013ca6e-622d-383f-9505-9da237d6fbff",
                        "source_sense_description": "movement in the arts",
                        "target_lang_word": "expressionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expressionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7807149-b462-34e1-8315-49779314b14f",
                                        "entry_id": "48f652e8-17c9-3d80-8aad-8bdb5cd8fa2b",
                                        "glosses": [
                                            "Mouvement artistique qui promeut l’expression du ressenti de l’artiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f887c37-9d34-4acb-8e7c-4530ee0d1dae",
                                                "sense_id": "a7807149-b462-34e1-8315-49779314b14f",
                                                "text": "L’expressionnisme, art de l’expression, se détourne des impressions perçues par les sens pour exprimer des sentiments et des idées."
                                            },
                                            {
                                                "example_id": "9d61628a-7bc5-473e-af0c-e0d520dffb3c",
                                                "sense_id": "a7807149-b462-34e1-8315-49779314b14f",
                                                "text": "L’expressionnisme allemand des années 20."
                                            },
                                            {
                                                "example_id": "932302f4-0097-415a-99d1-9f8661841819",
                                                "sense_id": "a7807149-b462-34e1-8315-49779314b14f",
                                                "text": "Alors que l’impressionnisme est encore à décrire la réalité physique, l’expressionnisme lui ne s’attache plus à cette réalité et la soumet aux états d’âme de l’artiste."
                                            },
                                            {
                                                "example_id": "d284d416-eae8-4f00-a524-2df1df4d3ba2",
                                                "sense_id": "a7807149-b462-34e1-8315-49779314b14f",
                                                "text": "L’expressionnisme est une révolte qui vise à libérer la masse qui souffre de la réalité du désespoir du monde dans lequel elle vit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bff6e7d-57e2-47d3-b363-a07c1fd57955",
                        "source_entry_id": "e013ca6e-622d-383f-9505-9da237d6fbff",
                        "source_sense_description": "movement in the arts",
                        "target_lang_word": "Expressionismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Expressionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4adb8760-2a3e-3b87-8e4e-f05ea44e827a",
                                        "entry_id": "e04b7c58-0f98-3b34-8474-66c0dda901a4",
                                        "glosses": [
                                            "eine im zwanzigsten Jahrhundert entstandene Kunstrichtung"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cd2907-8fe6-4404-8535-0d5912c5fee2",
                                                "sense_id": "4adb8760-2a3e-3b87-8e4e-f05ea44e827a",
                                                "text": "„Insbesondere junge Literaten des Expressionismus machten ihrem Verdruß über die verknöcherte Gesellschaft durch Herbeirufen der Apokalypse Luft.“"
                                            },
                                            {
                                                "example_id": "34be2723-c384-4173-a26d-cb2d80d0891a",
                                                "sense_id": "4adb8760-2a3e-3b87-8e4e-f05ea44e827a",
                                                "text": "„Matisse habe die Begriffe Kubismus und Expressionismus erfunden, berichtet Däubler.“"
                                            },
                                            {
                                                "example_id": "686fd24b-953c-49a9-b8bf-9d0d23962779",
                                                "sense_id": "4adb8760-2a3e-3b87-8e4e-f05ea44e827a",
                                                "text": "„Die meisten deutschschreibenden Autoren in Prag sind, was ihren Stil betrifft, dem Expressionismus zuzurechnen.“"
                                            },
                                            {
                                                "example_id": "c0c63d42-c40c-44de-bcb6-39daad720611",
                                                "sense_id": "4adb8760-2a3e-3b87-8e4e-f05ea44e827a",
                                                "text": "„Er muss meinem Vater viel über den Expressionismus erzählt haben, der zu dieser Zeit ja längst aus allen Gallerien und Museen verbannt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
