                "senses": [
                    {
                        "sense_id": "bb62bf6b-7dc9-356b-8888-14379d175623",
                        "entry_id": "e4aa9e7a-b3a0-34e4-910e-7a96047d6451",
                        "glosses": [
                            "истор. самоуправляющееся, а впоследствии — независимое государство, входившее в состав Британской империи, а затем (после 1947 года) — в возглавляемое Великобританией Содружество наций, и признававшее своим главой британского монарха, представленного генерал-губернатором"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85a7e21e-409c-401d-aec4-b225700fcd54",
                        "source_entry_id": "e4aa9e7a-b3a0-34e4-910e-7a96047d6451",
                        "source_sense_id": "bb62bf6b-7dc9-356b-8888-14379d175623",
                        "target_lang_word": "dominion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dominion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b7d85c8-f36a-3783-a8d4-bcd94d24f8b8",
                                        "entry_id": "9527a538-ffd2-3d07-ab73-487d61752c0c",
                                        "glosses": [
                                            "Power or the use of power; sovereignty over something; stewardship, supremacy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0405e353-db02-4ff8-b9b3-df788f5e9592",
                                                "sense_id": "1b7d85c8-f36a-3783-a8d4-bcd94d24f8b8",
                                                "text": "And at the end of the dayes, I Nebuchad-nezzar lift vp mine eyes vnto heauen, and mine vnderſtanding returned vnto me, and I bleſſed the moſt high, and I praiſed, and honoured him that liueth for euer, whoſe dominion is an euerlaſting dominion, and his kingdome is from generation to generation."
                                            },
                                            {
                                                "example_id": "04c3c35c-a529-4dbc-9d41-78cd6e3f83f9",
                                                "sense_id": "1b7d85c8-f36a-3783-a8d4-bcd94d24f8b8",
                                                "text": "To choose between dominion or slavery."
                                            },
                                            {
                                                "example_id": "88726c64-c49d-4e4d-ab01-2deb5ce55564",
                                                "sense_id": "1b7d85c8-f36a-3783-a8d4-bcd94d24f8b8",
                                                "text": "'Behold! once more I kiss thee, and by that kiss I give to thee dominion over sea and earth, over the peasant in his hovel, over the monarch in his palace halls, and cities crowned with towers, and those who breathe therein.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb3253d-4fae-38ca-bc8b-c7160d3cdd7d",
                                        "entry_id": "9527a538-ffd2-3d07-ab73-487d61752c0c",
                                        "glosses": [
                                            "Predominance; ascendancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "400a7c51-995d-4099-ba72-294983d46a6f",
                                                "sense_id": "2fb3253d-4fae-38ca-bc8b-c7160d3cdd7d",
                                                "text": "Objects placed foremost ought […] have dominion over things which are confus'd and transient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b633f650-45ff-3a78-bb16-9f1622ae5b0d",
                                        "entry_id": "9527a538-ffd2-3d07-ab73-487d61752c0c",
                                        "glosses": [
                                            "A kingdom, nation, or other sphere of influence; governed territory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af698090-959b-44ed-884e-eab47e0d904f",
                                                "sense_id": "b633f650-45ff-3a78-bb16-9f1622ae5b0d",
                                                "text": "the dominions of a king  the dominion of the passions"
                                            },
                                            {
                                                "example_id": "daca66cb-aa51-4282-b99b-2035dacdeda4",
                                                "sense_id": "b633f650-45ff-3a78-bb16-9f1622ae5b0d",
                                                "text": "Oh cold, cold, rigid, dreadful Death, set up thine altar here, and dress it with such terrors as thou hast at thy command: for this is thy dominion!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c39bea-baae-363b-90d9-6f10ab2b215d",
                                        "entry_id": "9527a538-ffd2-3d07-ab73-487d61752c0c",
                                        "glosses": [
                                            "kingdom"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a068deda-d7aa-3781-b713-09e430df5eba",
                                        "entry_id": "9527a538-ffd2-3d07-ab73-487d61752c0c",
                                        "glosses": [
                                            "An order of angel in Christian angelology, ranked above virtues and below thrones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3537f5dc-f311-4eaf-ad6f-579600d6cc2a",
                                                "sense_id": "a068deda-d7aa-3781-b713-09e430df5eba",
                                                "text": "For by him were all things created[…], whether they be thrones, or dominions, or principalities, or powers: all things were created by him, and for him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
