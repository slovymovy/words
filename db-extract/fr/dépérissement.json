                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e71a6278-59b9-425c-9a19-ba2230f62d2f",
                        "entry_id": "5ee3fb25-9c90-3dd1-9c90-8fcf5266cf37",
                        "tags": [
                            "plural"
                        ],
                        "form": "dépérissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f580712-d87b-3efc-9ac0-a22f8440ac54",
                        "entry_id": "5ee3fb25-9c90-3dd1-9c90-8fcf5266cf37",
                        "glosses": [
                            "État de ce qui dépérit ou est dépéri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d3ae74-0920-4832-bd41-2b8c1995ef27",
                                "sense_id": "4f580712-d87b-3efc-9ac0-a22f8440ac54",
                                "text": "Les divers états de prospérité ou de dépérissement d’une Nation agricole, offrent une multitude d’autres données, dont chacune est le fondement d’un calcul particulier qui lui est propre en toute rigueur."
                            },
                            {
                                "example_id": "7859e741-f277-4a79-9f56-88ef12688103",
                                "sense_id": "4f580712-d87b-3efc-9ac0-a22f8440ac54",
                                "text": "La situation est devenue si préoccupante que le ministère de l’Agriculture, l’Inra et la filière viticole ont lancé, en 2016, un plan national contre le dépérissement du vignoble. — (« Vin : Un coup de moût dans le vignoble », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 85)"
                            }
                        ]
                    },
                    {
                        "sense_id": "530581ab-c55e-370e-9446-37ea95f10020",
                        "entry_id": "5ee3fb25-9c90-3dd1-9c90-8fcf5266cf37",
                        "glosses": [
                            "Altération ou diminution d’un droit, ou d’une preuve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a677130-f9c8-463a-b150-f0d666a88f75",
                                "sense_id": "530581ab-c55e-370e-9446-37ea95f10020",
                                "text": "Le dépérissement des effets de cette succession."
                            },
                            {
                                "example_id": "d2a38faf-96ba-43a8-94d7-59f6dcdd6a11",
                                "sense_id": "530581ab-c55e-370e-9446-37ea95f10020",
                                "text": "Le dépérissement des preuves contre un accusé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f877b433-8c8c-4265-9d19-6794bf18ea56",
                        "source_entry_id": "5ee3fb25-9c90-3dd1-9c90-8fcf5266cf37",
                        "target_lang_word": "Verfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "allmähliche Zerstörung von Gebäuden oder Gegenständen (aufgrund des Alters, mangelnder Pflege, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "477fca4c-26d4-4640-be73-3fcd9d1bc648",
                                                "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                                "text": "Das Endstadium des Verfalls ist beim Reetdach erreicht, wenn man mit den Händen leicht hineingreifen kann und die Halme sich dabei anfühlen wie ein tropfnasses Papierhandtuch."
                                            },
                                            {
                                                "example_id": "9321cb94-bab7-4b61-953d-7d274584df8a",
                                                "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                                "text": "Russlands Parlament will Kulturdenkmäler vor Verfall schützen."
                                            },
                                            {
                                                "example_id": "23bc976c-4056-46df-8f31-77cf151a33d4",
                                                "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                                "text": "„Der Verfall war fast unheimlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Wertminderung oder Verlust des Wertes einer Sache (zum Beispiel Währung, Gutschein, Patent, Preise, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80dca254-de57-45bc-a7da-27878d1f5a3a",
                                                "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                                "text": "Mit dem eskalierenden Verfall des US-Dollar stehen die Pläne fuer eine arabische Einheitswährung wieder auf der Tagesordnung."
                                            },
                                            {
                                                "example_id": "8b0aaf4b-9eb6-4682-ac2f-ad03cd4a9961",
                                                "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                                "text": "In Indien und China gibt es fast schon eine Flut an gut ausgebildeten Forschern und dieses Überangebot sorgt für einen weiteren Verfall der Löhne und macht Forschung dadurch billiger."
                                            },
                                            {
                                                "example_id": "60e0f4e9-a00a-41e5-9a5d-511a6887b189",
                                                "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                                "text": "Der Europäische Gerichtshof prüft in einem aktuellen Verfahren, ob der Verfall von Urlaubstagen nach Ablauf der gesetzlich festgelegten Fristen zulässig ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Verlust von Einfluss und Geltung (von Staaten, politischen Systemen, Kultur, Sitten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0096dc6a-b805-42a8-addb-8309635d7bdd",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Sein dänischer Verleger sagt, Hultberg habe sich an das alte Manuskript erinnert, als er einen neuen Roman über den Verfall nicht der Menschheit allgemein oder einer ganzen Stadt, sondern einer Familie schreiben wollte."
                                            },
                                            {
                                                "example_id": "2912c06e-2925-4bcb-b25d-6d8d340550f2",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Und deshalb bedeutet das Ende der Milchwirtschaft auch den Verfall der schönen Urlaubslandschaft, wenn die Bauern sie einmal nicht mehr pflegen."
                                            },
                                            {
                                                "example_id": "fa157bbf-468d-4f12-a747-eb85aa325b92",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Auch im Provinzstädtchen Leninsk, wo sich der Verfall der UdSSR als Panorama einer von innen verrotteten Gesellschaft spiegelt."
                                            },
                                            {
                                                "example_id": "439d6345-6158-4965-8276-6a49a0dc3258",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Um einem Verfall der Sitten vorzubeugen und die öffentliche Moral zu schützen, müsse, so die Polizei, das Liebespärchen angemessen bestraft werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Verlust von körperlicher, geistiger oder seelischer Kraft (eines Menschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "151d3ba0-2bb4-4a73-868f-fe9db6449891",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "Die Wissenschaftler vermuten daher, dass der geistige Verfall des weiblichen Gehirns schneller abläuft und Männer sich länger in einer Vorstufe zur Demenz befinden."
                                            },
                                            {
                                                "example_id": "e3ee772f-d629-432f-a124-fbd4a4cff4a1",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "In Zeiten, in denen viele den Verfall der Sprach- und Lesefähigkeit von Kindern und Jugendlichen beklagen, setzt ´Tatort Bodensee´ gerade auf die Entwicklung und Förderung dieser Fähigkeiten[…]"
                                            },
                                            {
                                                "example_id": "cf9f5d71-3129-44de-bc04-35ef72bfbd3a",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "Der körperliche und psychische Verfall des Vaters löst bei den Geschwistern unterschiedliche Gefühle aus, von Unbehagen über Aggression bis hin zu Schuldgefühlen und Scham."
                                            },
                                            {
                                                "example_id": "4d4cbe77-654b-45f6-a498-5f7d01fa016d",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "„Philip war über Sandys Verfall entsetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1c6bc532-4029-3098-a18d-84ddd61dc105",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Einzug von Vermögenswerten als Folge einer strafbaren Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066af85c-bb64-4580-a4a1-c9bec6280339",
                                                "sense_id": "1c6bc532-4029-3098-a18d-84ddd61dc105",
                                                "text": "„Zweck des Verfalls ist es, einen Vermögenszuwachs der durch die Begehung einer strafbaren Handlung erlangt wurde, zu beseitigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac855e71-0428-402c-90ed-331f8a9d9d36",
                        "source_entry_id": "5ee3fb25-9c90-3dd1-9c90-8fcf5266cf37",
