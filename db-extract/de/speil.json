                            },
                            {
                                "target_word": "splinter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6262a918-cb4d-34c1-b403-e542f85750c0",
                                        "entry_id": "15bac283-5e89-326a-93f4-95d0b6f65dad",
                                        "glosses": [
                                            "To come apart into long sharp fragments."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d250d68-cf49-4e90-89d9-29b70dc35aee",
                                                "sense_id": "6262a918-cb4d-34c1-b403-e542f85750c0",
                                                "text": "The tall tree splintered during the storm."
                                            },
                                            {
                                                "example_id": "a9a41611-ef9c-489b-b4c8-0706f75946e4",
                                                "sense_id": "6262a918-cb4d-34c1-b403-e542f85750c0",
                                                "text": "It was all coming at her now: the fatigue and the fever; pieces of her lung splintering and mixing with her throwup; the calcifications on her bones, where the disease had already spread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eead2cc3-b498-3a14-8a5f-dbe9ede9d809",
                                        "entry_id": "15bac283-5e89-326a-93f4-95d0b6f65dad",
                                        "glosses": [
                                            "To cause to break apart into long sharp fragments."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcbbeadd-a668-4e82-91a2-c95e218ede2f",
                                                "sense_id": "eead2cc3-b498-3a14-8a5f-dbe9ede9d809",
                                                "text": "His third kick splintered the door."
                                            },
                                            {
                                                "example_id": "da9a7bb6-a26d-4a4a-9633-84376e739b54",
                                                "sense_id": "eead2cc3-b498-3a14-8a5f-dbe9ede9d809",
                                                "text": "After splintering their lances, they wheeled about, and […] abandoned the field to the enemy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030c26d5-ed5f-398f-9387-9e053158887b",
                                        "entry_id": "15bac283-5e89-326a-93f4-95d0b6f65dad",
                                        "glosses": [
                                            "To break, or cause to break, into factions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f06dd3a-a202-4c20-9fea-288fc8f559b8",
                                                "sense_id": "030c26d5-ed5f-398f-9387-9e053158887b",
                                                "text": "The government splintered when the coalition members could not agree."
                                            },
                                            {
                                                "example_id": "21381263-75bc-425d-a91d-b45a8fc01d6d",
                                                "sense_id": "030c26d5-ed5f-398f-9387-9e053158887b",
                                                "text": "The unpopular new policies splintered the company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eeef85e-7828-3017-b879-f0541fa15ae1",
                                        "entry_id": "15bac283-5e89-326a-93f4-95d0b6f65dad",
                                        "glosses": [
                                            "To fasten or confine with splinters, or splints, as a broken limb."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1a9a57a-613d-4ca3-aa7a-78499ff25f0a",
                                                "sense_id": "2eeef85e-7828-3017-b879-f0541fa15ae1",
                                                "text": "it will be very hard for Me to Splinter up the broken confuséd Pieces of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
