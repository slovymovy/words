                ],
                "senses": [
                    {
                        "sense_id": "0725737a-3206-3e78-a7a2-b64910e23f25",
                        "entry_id": "e12a1bf5-63b9-3e9f-a9cf-e3893d11f238",
                        "glosses": [
                            "Utiliser le putois sur une porcelaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1682c8c5-0768-4f87-977e-b305d9979982",
                                "sense_id": "0725737a-3206-3e78-a7a2-b64910e23f25",
                                "text": "On cuit cette esquisse afin qu'elle demeure fixe et permette de putoiser les fonds et de travailler tous les détails de la peinture pour un deuxième feu."
                            },
                            {
                                "example_id": "a01c95b7-4d5a-4799-9ef9-d560cee068d5",
                                "sense_id": "0725737a-3206-3e78-a7a2-b64910e23f25",
                                "text": "Quand il en a mis partout, rapidement, sur le bord ou marli de l'assiette, en tirant à lui; quand il a rejoint, en tournant l'assiette sur sa main, le point de départ, et mêlé comme il faut, par des coups d'allée et de venue, la teinte sous laquelle doit disparaître la jonction, le poseur de fonds saisit un putois sec, et il commence à putoiser sa première couche, pour la fondre et l'unir."
                            }
                        ]
                    }
                ],
