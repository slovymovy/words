                    {
                        "sense_id": "8e1d4212-0903-3b98-ae98-36a5a49a2da6",
                        "entry_id": "6b1bc6e4-3a95-37de-b569-573989ce9489",
                        "glosses": [
                            "Consonne longue répartie entre la fin d’une syllabe et le début de la syllabe suivante. En français, on trouve rarement la géminée \\\\ʁʁ\\\\ comme dans courrai \\\\kuʁ.ʁe\\\\. Très commune en italien, en japonais, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5161c5-5577-48c3-ba4e-05ca1fdac080",
                                "sense_id": "8e1d4212-0903-3b98-ae98-36a5a49a2da6",
                                "text": "C’est ce noble souci qui, par hypercorrection, nous pousserait à faire entendre des géminées là où l’on ne devrait pas et même à en rajouter là où il n’y en pas : une cor-rél-lation."
                            }
                        ]
                    }
