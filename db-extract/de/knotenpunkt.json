                "senses": [
                    {
                        "sense_id": "489eb0ab-e1a8-3c52-ad57-6d2b5fe6effb",
                        "entry_id": "2ebbf193-a0ad-3a62-86f6-0b96d007f967",
                        "glosses": [
                            "sich schneidende Verkehrswege"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "ff589909-a16f-4527-bd06-10b65acbc4c3",
                                "sense_id": "489eb0ab-e1a8-3c52-ad57-6d2b5fe6effb",
                                "text": "Das etwas heruntergekommene Viertel in Ostlondon und der als Knotenpunkt fungierende Vorort Stratford sollen eine komplett neue Infrastruktur bekommen."
                            },
                            {
                                "example_id": "31370f5a-05d5-468d-9255-911829e3725c",
                                "sense_id": "489eb0ab-e1a8-3c52-ad57-6d2b5fe6effb",
                                "text": "„Das Dorf ist sowohl von den Russen wie auch von den deutschen Verteidigern als strategisch wichtiger Knotenpunkt von Bahn- und Straßenverbindungen ausgemacht.“"
                            },
                            {
                                "example_id": "d72f5ebd-87f8-4cd8-b7d4-9e1b53eed882",
                                "sense_id": "489eb0ab-e1a8-3c52-ad57-6d2b5fe6effb",
                                "text": "„Obenwalde war ein Knotenpunkt der großen Eisenbahnlinie, die den Westen Deutschlands - Köln, Düsseldorf, das Ruhrgebiet - über Hannover mit der Hauptstadt Berlin verband.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
