                    "frequency": "Low",
                    "semantic_group_id": "irritable_mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bunch of <w>grumpies</w> were always scowling and muttering in the corner.",
                            "target_lang_translations": {
