                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "792c8dac-3bf7-402a-8c1a-b457d508bba8",
                        "source_entry_id": "f125baa1-5dae-3028-afdb-d0a231ddbb13",
                        "source_sense_id": "1ee17da4-3a08-30ee-b785-293e6e888ee1",
                        "source_sense_description": "iemand die niet vies is van een beetje avontuur, een avonturier",
                        "target_lang_word": "Abenteurer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abenteurer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                        "entry_id": "5603c5a8-a338-3515-a95f-7419a9a3e5c6",
                                        "glosses": [
                                            "Person, die gefährliche Herausforderungen sucht/erlebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76a8aac-4a99-4164-9682-62c224fdb265",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Skrupellose Abenteurer und Geschäftemacher ringen um die Ressourcen des Staates.“"
                                            },
                                            {
                                                "example_id": "db5f7b3f-310c-4c96-826e-6f0c6016bedf",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Er ging nach Lissabon, wo zahlreiche Genuesen lebten, denn diese Hauptstadt war damals die Weltbörse für Seefahrer und Abenteurer.“"
                                            },
                                            {
                                                "example_id": "1be208db-2da3-472b-af18-0ecb22e8e7f9",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Als müsste man mehr als nur Grenzgänger sein, nämlich auch Glücksritter und Idealist, Falschmünzer und Abenteurer.“<"
                                            },
                                            {
                                                "example_id": "c7ebe3c3-6e2e-42af-95f9-61ee8210c460",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.\""
                                            },
                                            {
                                                "example_id": "407a6f3f-6dfb-43ea-b14e-42e4dd49a073",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Mit Bergen kennt sich der 51jährige Abenteurer und Extremkletterer aus wie kein Zweiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
