                        "entry_id": "63eab309-2cd9-3c7f-8436-07c1c2fd3044",
                        "glosses": [
                            "der Kindergarten, die Kindertagesstätte, die Kita (Einrichtung, in der 4- bis 5-jährige Kinder betreut werden)"
                        ],
                        "tags": [
                            "in Flandern",
                            "sonst veraltet"
                        ],
                        "examples": [
                            {
                                "example_id": "9bbafdbd-e6f6-4c29-b5e5-2ff889a4d18f",
                                "sense_id": "25b09b04-99e1-3831-b64a-75551cd9a815",
                                "text": "Welkom op de website van onze kleuterscholen.",
                                "translation": "Willkommen auf der Webseite von unseren Kindergärten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86b18e26-41c2-4d3f-9061-48f8a9f5031d",
                        "source_entry_id": "63eab309-2cd9-3c7f-8436-07c1c2fd3044",
                        "source_sense_id": "25b09b04-99e1-3831-b64a-75551cd9a815",
                        "target_lang_word": "Kindergarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindergarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                        "entry_id": "8e2412f9-eb9f-36e0-b6a1-60bcbbf53f15",
                                        "glosses": [
                                            "Ort, an dem Kinder vor dem schulpflichtigen Alter betreut und gefördert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85591be5-de22-4985-8e8a-1980a00f9f08",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "Lena geht noch in den Kindergarten."
                                            },
                                            {
                                                "example_id": "07b013e3-6bb0-4f9d-aa8f-ee884ff71c8c",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Vietnamesisch war zwar meine Muttersprache, aber im Kindergarten habe ich viel davon verlernt.“"
                                            },
                                            {
                                                "example_id": "f36dd43d-eee2-42c6-a853-5bea8c300ac6",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Unser Kindergarten und die dazugehörige Abenteuerveranda waren ebenfalls mit einem hohen Metallgitter umgeben.“"
                                            },
                                            {
                                                "example_id": "f686b4b7-c97a-407e-a45c-91bd86208368",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Wenn ich um kurz nach achtzehn Uhr nach Hause komme, sind alle Kinder vom Kindergarten abgeholt und einer der beiden Ärztefreunde hat etwas zu essen vorbereitet.“"
                                            },
                                            {
                                                "example_id": "a2be02ce-659e-44f5-a996-dee5fdee996a",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Nun hat sie im Kindergarten mitbekommen, dass in dem Land, in dem ihre Großeltern, Tanten, Cousinen und Cousins leben, Menschen auf die Straße gehen, um für Gerechtigkeit zu kämpfen.“"
                                            },
                                            {
                                                "example_id": "02be19e5-bb8b-4852-9076-94f687a6c284",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Männer fehlen in Kindergärten, aber auch in Grundschulen, wo zu mehr als 85 Prozent Frauen unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3183e3c1-15af-4136-841b-c909eecece4b",
                        "source_entry_id": "63eab309-2cd9-3c7f-8436-07c1c2fd3044",
                        "source_sense_id": "25b09b04-99e1-3831-b64a-75551cd9a815",
