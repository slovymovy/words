                        ]
                    },
                    {
                        "translation_id": "d426a2cf-c16d-43ba-a960-7dbc5056bc96",
                        "source_entry_id": "c69df57c-324a-30dc-a8ff-5f9c82c9b2db",
                        "source_sense_id": "b67a4561-7bc5-3c96-bdec-ef2399ddb620",
                        "source_sense_description": "politisches oder soziales Engagement für bestimmte Ziele",
                        "target_lang_word": "activisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cc92772-c7e7-32c8-abc3-05e3bda51fc2",
                                        "entry_id": "753c9c97-11c8-3bd0-ab43-7f935fe36e24",
                                        "glosses": [
                                            "Engagement privilégiant l’action directe, pouvant aller jusqu’à braver la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad795093-c605-41dc-a939-bba4d6da1364",
                                                "sense_id": "1cc92772-c7e7-32c8-abc3-05e3bda51fc2",
                                                "text": "L’action directe associée à la protection des animaux n’est pas une nouveauté pour les Canadiens. […] Toutefois, le recours à l’activisme pour défendre les animaux est une tendance qui est devenue de plus en plus manifeste ces dernières années, davantage d’ailleurs en Grande-Bretagne et aux États-Unis qu’au Canada."
                                            },
                                            {
                                                "example_id": "5f1bfba9-26e7-4320-b24a-2ad5432d1f2f",
                                                "sense_id": "1cc92772-c7e7-32c8-abc3-05e3bda51fc2",
                                                "text": "L’activisme de Camélinat lui vaut quelques démêlés avec la justice."
                                            },
                                            {
                                                "example_id": "8c81bce7-89dd-441f-98bd-450f91122f78",
                                                "sense_id": "1cc92772-c7e7-32c8-abc3-05e3bda51fc2",
                                                "text": "Chez les actionnaires, certains se sont saisis du sujet. Notamment Ecofi, société de gestion qui mène une stratégie d’« activisme actionnarial »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea580e9-adab-3771-8e9c-b79c83f955ab",
                                        "entry_id": "753c9c97-11c8-3bd0-ab43-7f935fe36e24",
                                        "glosses": [
                                            "Activité élevée, voire frénétique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df9cc50-8e7c-4511-acfe-34d05be0f79e",
                                                "sense_id": "0ea580e9-adab-3771-8e9c-b79c83f955ab",
                                                "text": "En attendant, le besoin de meilleurs débits et l'activisme des petits opérateurs déjà présents permettent aux réseaux publics d'afficher un chiffre encourageant : 5,3 ventes d'abonnement par mois pour 1 000 lignes déployées sur ces réseaux, contre 3,9 pour les privés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
