                    {
                        "sense_id": "8eea2677-2c2d-3a4e-890c-94097c266b72",
                        "entry_id": "5a06259b-7735-38a0-aded-fb1bfd8e586e",
                        "glosses": [
                            "nielegalnie pędzony napój alkoholowy o wysokiej zawartości alkoholu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
