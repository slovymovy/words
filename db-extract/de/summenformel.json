                "senses": [
                    {
                        "sense_id": "91849aa0-9ea0-3676-ace5-188758b4b916",
                        "entry_id": "32af4f60-0f0f-3b1a-95b4-61958c156ae4",
                        "glosses": [
                            "Angabe der Anzahl der gleichartigen Atome eines Moleküls oder der Formeleinheit eines Salzes, die auch das Teilchenzahlenverhältnis beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5a14fc-2947-4332-a98f-8202407e03ff",
                                "sense_id": "91849aa0-9ea0-3676-ace5-188758b4b916",
                                "text": "„Die Summenformel für Ethanol nach dem Hill-System ist C₂H₆O, die häufig verwendete Schreibweise C₂H₅OH ist keine Summen-, sondern eine Halbstrukturformel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "648ed1da-2d8e-3471-9048-ee12e3f12ddb",
                        "entry_id": "32af4f60-0f0f-3b1a-95b4-61958c156ae4",
                        "glosses": [
                            "Rechenvorschrift zur einfachen Addition nach einer Regel gebildeter Zahlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a357b8-fc2a-4a25-a834-799a461fcd8b",
                                "sense_id": "648ed1da-2d8e-3471-9048-ee12e3f12ddb",
                                "text": "„Das asymptotische Verhalten von Reihen lässt sich darauf oft mit Hilfe der eulerschen Summenformel zurückführen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
