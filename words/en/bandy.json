                    ],
                    "common_phrases": [
                        "bandy about",
                        "bandy around"
                    ],
                    "target_lang_definitions": {
                        "nl": "Losjes of achteloos ter sprake brengen, verspreiden of rondstrooien.",
                        "ru": "Беспечно упоминать, обсуждать или распространять (имена, слухи и т. п.)."
                    },
                    "translations": {
                        "nl": [
