    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f096d9c2-2414-391e-a83a-fac1ea7cdf8d",
                    "sense_definition": "Prendre un engagement régulier ou souscrire un accès payant ou gratuit à une publication, un service ou un contenu numérique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "abonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup d'étudiants préfèrent s'<w>abonner</w> à une revue scientifique pour leurs recherches."
                        },
                        {
                            "text": "Chaque matin, je lis les nouvelles après m'être <w>abonné</w> à ce quotidien en ligne."
                        }
                    ],
                    "synonyms": [
                        "souscrire"
                    ],
                    "common_phrases": [
                        "s'abonner à un journal",
                        "s'abonner à une chaîne",
                        "s'abonner à un service"
                    ]
                },
                {
                    "sense_id": "7ecef8b8-6042-304d-be92-92271a9add63",
                    "sense_definition": "Faire souscrire un abonnement à quelqu'un d'autre pour lui faire bénéficier d'une publication ou d'un service.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour son anniversaire, mes parents veulent <w>abonner</w> mon frère à un magazine de sport."
                        },
                        {
                            "text": "Elle a décidé d'<w>abonner</w> toute sa famille à cette nouvelle plateforme de musique."
                        }
                    ],
                    "antonyms": [
                        "désabonner"
                    ],
                    "common_phrases": [
                        "abonner un proche",
                        "abonner un ami"
                    ]
                },
                {
                    "sense_id": "0d5aa65a-5274-38b1-b9d0-b435d87aaeae",
                    "sense_definition": "Devenir un habitué ou adopter de manière répétée un comportement particulier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis plusieurs mois, ce critique semble s'être <w>abonné</w> aux mêmes représentations théâtrales."
                        },
                        {
                            "text": "Il s'est <w>abonné</w> aux retards matinaux malgré les avertissements répétés de son directeur."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi figuré pour souligner une habitude récurrente"
                        }
                    ]
                },
                {
                    "sense_id": "5e0f1af4-7cbf-38b3-9e54-b8e000f91201",
                    "sense_definition": "Fixer par convention une somme forfaitaire pour s'acquitter d'une taxe ou d'une redevance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'Ancien Régime, la corporation pouvait <w>abonner</w> ses membres pour régler les taxes locales."
                        },
                        {
                            "text": "Les négociants préféraient <w>abonner</w> leurs droits de péage pour éviter les contrôles fréquents."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Usage fiscal ancien"
                        }
                    ]
                },
                {
                    "sense_id": "5f3aa496-e102-32be-9b5c-1e398e232939",
                    "sense_definition": "Fixer les bornes et délimiter les contours d'un terrain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arpenteur est venu spécialement pour <w>abonner</w> les terres agricoles après le partage successoral."
                        },
                        {
                            "text": "Le propriétaire terrien souhaitait <w>abonner</w> son champ afin de prévenir tout conflit avec le voisinage."
                        }
                    ],
                    "synonyms": [
                        "aborner",
                        "borner",
                        "délimiter"
                    ],
                    "traits": [
