                        "source_entry_id": "4f3f9bff-4e7d-3b5d-9c64-9b3cc78ecea1",
                        "source_sense_id": "0b724ff2-a123-39a9-b7fa-fc3f21b4bad2",
                        "source_sense_description": "Vogel, der am, im oder auf dem Meer lebt",
                        "target_lang_word": "oiseau de mer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oiseau de mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                        "entry_id": "fed65cd1-3e17-3c66-a21a-4dddec138b50",
                                        "glosses": [
                                            "Groupe d’environ 275 espèces d’oiseau appartenant à huit familles, entretenant avec le milieu marin des relations de dépendance plus ou moins stricte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8ef68a-2bd5-4e1c-a3cd-75c7649d0b29",
                                                "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                                "text": "On n’entend que des cris d’oiseaux de mer, goélands et macreuses, qui s’abandonnent aux caprices du vent."
                                            },
                                            {
                                                "example_id": "97b4dcc0-7910-4e7b-a833-b8360fab3303",
                                                "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                                "text": "Ce ne sont que des rochers à pic contre lesquels la mer se brise avec fureur : les vents et les vagues les ont façonnés en pyramides, en tours, en cavernes, en arcades; d'innombrables oiseaux de mer animent le paysage."
                                            },
                                            {
                                                "example_id": "77b98bf8-116e-4006-a25a-be960832eda1",
                                                "sense_id": "4dbc7fae-b54d-3b8e-a760-052d5776daeb",
                                                "text": "À de grandes altitudes planaient les frégates et les phaétons, qui tombaient souvent avec une rapidité vertigineuse pour arracher en l’air leur proie aux oiseaux de mer plongeurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7ff8315-acd5-48f1-83cd-f7f7d3a1a79e",
                        "source_entry_id": "4f3f9bff-4e7d-3b5d-9c64-9b3cc78ecea1",
