    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9944f65d-f46a-3f4b-bddc-870a377c6670",
                    "sense_definition": "uit een voertuig stappen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voertuig_verlaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet bij de volgende halte <w>uitstappen</w>.",
                            "target_lang_translations": {
                                "en": "I have to <w>get off</w> at the next stop."
                            }
                        },
                        {
                            "text": "De reizigers moesten snel <w>uitstappen</w> toen de trein op het station aankwam.",
                            "target_lang_translations": {
                                "en": "The passengers had to <w>get off</w> quickly when the train arrived at the station."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstappen"
                    ],
                    "antonyms": [
                        "instappen"
                    ],
                    "common_phrases": [
                        "bij de volgende halte uitstappen",
                        "uit de bus uitstappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To get out of a vehicle, such as a bus, train, or car."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get off",
                                "target_lang_sense_clarification": "from a bus, train, or bicycle"
                            },
                            {
                                "target_lang_word": "get out",
                                "target_lang_sense_clarification": "of a car or taxi"
                            },
                            {
                                "target_lang_word": "alight",
                                "target_lang_sense_clarification": "formal, from a train or bus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3013df2f-fa24-3fe7-9726-3fd376bf092f",
                    "sense_definition": "zich uit een verband of project terugtrekken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "terugtrekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij besloot na drie jaar uit het project te <w>stappen</w>.",
                            "target_lang_translations": {
                                "en": "He decided to <w>pull out</w> of the project after three years."
                            }
                        },
                        {
                            "text": "Als de voorwaarden veranderen, kunnen we altijd nog uit de samenwerking <w>uitstappen</w>.",
                            "target_lang_translations": {
                                "en": "If the conditions change, we can always still <w>withdraw</w> from the collaboration."
                            }
                        }
                    ],
                    "synonyms": [
                        "uittreden",
                        "terugtrekken"
                    ],
                    "common_phrases": [
                        "uit een project stappen",
                        "uit de samenwerking stappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To withdraw or pull out from a project, partnership, or organization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull out",
                                "target_lang_sense_clarification": "of a project or agreement"
                            },
                            {
                                "target_lang_word": "drop out",
                                "target_lang_sense_clarification": "of a group or activity"
                            },
                            {
                                "target_lang_word": "withdraw",
                                "target_lang_sense_clarification": "from a partnership or venture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c41fcd0-18e2-3490-9879-5502a3a92230",
                    "sense_definition": "eufemistisch voor sterven",
