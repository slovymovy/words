                "senses": [
                    {
                        "sense_id": "7144dc0f-64cc-32e6-aaf7-d200f54955bb",
                        "entry_id": "e60b28f7-8548-36b1-9e73-943b076528a7",
                        "glosses": [
                            "Amateurbiologin, die wissenschaftliche Methoden der modernen Biologie wie zum Beispiel Gentechnik und Molekularbiologie abseits der akademischen Forschung anwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bccee841-01a0-4cb3-b147-5954b9cc592d",
                                "sense_id": "7144dc0f-64cc-32e6-aaf7-d200f54955bb",
                                "text": "„In ihrem Buch Fett beschreibt die Biohackerin und Buchautorin Anja Leitz, dass nicht nur die viel gepriesene Ölsäure für die gesundheitlichen Vorteile des Olivenöls verantwortlich ist, sondern vor allem die phenolischen Stoffe und Squalen, ein Triterpen und Zwischenprodukt der Cholesterinsynthese: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7a529ac-4063-4681-91a0-2345fb503ec9",
                        "source_entry_id": "e60b28f7-8548-36b1-9e73-943b076528a7",
                        "source_sense_id": "7144dc0f-64cc-32e6-aaf7-d200f54955bb",
                        "source_sense_description": "Amateurbiologin",
