                        "translation_id": "01b979f0-cd63-4468-9e5a-befa295b4079",
                        "source_entry_id": "b688fe30-1bb9-3e4e-9488-d0ccc8822b11",
                        "source_sense_description": "to interpret by forming a concept",
                        "target_lang_word": "conceptualiseren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conceptualiseren",
