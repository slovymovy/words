                                        "sense_id": "58708579-7e7e-3c36-82e4-8c7e2466c40a",
                                        "entry_id": "94e4727b-84d5-377c-8f33-b6a4035a8f30",
                                        "glosses": [
                                            "To assume or take responsibility for a debt or other obligation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f327ddab-aa83-3970-bfe6-e3b234b293a9",
                                        "entry_id": "94e4727b-84d5-377c-8f33-b6a4035a8f30",
                                        "glosses": [
                                            "To make something certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f9d343b-1cf8-42de-ab04-edf7f43672f5",
                                                "sense_id": "f327ddab-aa83-3970-bfe6-e3b234b293a9",
                                                "text": "The long sunny days guarantee a good crop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22fdb4a3-5318-4092-a7c4-7fadadb89986",
                        "source_entry_id": "18f80f3b-9dbe-3fae-a44b-ef7990fd4d23",
                        "source_sense_id": "aa673b62-5bef-3897-a98b-a264aeab2cc3",
                        "source_sense_description": "verklaring waarin men verklaart voor bepaalde gevolgen in te staan",
                        "target_lang_word": "garantie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garantie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c060e1d6-ed65-39f6-a3d1-338f1087b649",
                                        "entry_id": "4f9bdcde-2098-3a21-bc45-8fa77718c2b5",
                                        "glosses": [
                                            "Engagement par lequel on garantit. Il se dit surtout en matière de procédure et de négociations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9735815-1697-47ac-b45f-211f3316ae56",
                                                "sense_id": "c060e1d6-ed65-39f6-a3d1-338f1087b649",
                                                "text": "Il m’a vendu cette montre avec garantie pour un an."
                                            },
                                            {
                                                "example_id": "f9bbe3d2-7cc2-4de1-a6be-665fcb7834b8",
                                                "sense_id": "c060e1d6-ed65-39f6-a3d1-338f1087b649",
                                                "text": "La garantie que le vendeur doit à l’acquéreur."
                                            },
                                            {
                                                "example_id": "e097a04a-9aae-4456-b3e9-30bbeee653a8",
                                                "sense_id": "c060e1d6-ed65-39f6-a3d1-338f1087b649",
                                                "text": "Ce traité fut conclu sans la garantie de telle puissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ceaf065-6e38-3e53-a2c2-4aefc3536d2b",
                                        "entry_id": "4f9bdcde-2098-3a21-bc45-8fa77718c2b5",
                                        "glosses": [
                                            "Obligation qu’a le constructeur d’un bien de le remplacer en cas de vice de fabrication."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c1df35-9b75-4dbb-b696-810c6d8e0fac",
                                                "sense_id": "9ceaf065-6e38-3e53-a2c2-4aefc3536d2b",
                                                "text": "En Belgique, la durée de la garantie légale est de 12 mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b54ad08e-de7a-3b6a-9e0f-5af7cf45d30a",
                                        "entry_id": "4f9bdcde-2098-3a21-bc45-8fa77718c2b5",
                                        "glosses": [
                                            "Dédommagement auquel on s’oblige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a1f8b9-82ae-4008-878e-98bfe542d7df",
                                                "sense_id": "b54ad08e-de7a-3b6a-9e0f-5af7cf45d30a",
                                                "text": "Le coulage consiste à faire faire des travaux qui ne sont pas urgents ou nécessaires, à dégalonner et regalonner les troupes, à commander des vaisseaux sans s’inquiéter s’il y a du bois et de payer alors le bois trop cher, à se préparer à la guerre sans la faire, à payer les dettes d’un État sans lui en demander le remboursement ou des garanties, etc."
                                            },
                                            {
                                                "example_id": "fb51b112-9608-45af-9c8a-1acbb5ed7209",
                                                "sense_id": "b54ad08e-de7a-3b6a-9e0f-5af7cf45d30a",
                                                "text": "Être tenu à garantie, à la garantie."
                                            },
                                            {
                                                "example_id": "f27311c8-6427-4616-81c6-38a25356fbdd",
                                                "sense_id": "b54ad08e-de7a-3b6a-9e0f-5af7cf45d30a",
                                                "text": "N’être soumis à aucune garantie."
                                            },
                                            {
                                                "example_id": "9ecabc71-3e98-4094-8962-aa8784d286e5",
                                                "sense_id": "b54ad08e-de7a-3b6a-9e0f-5af7cf45d30a",
                                                "text": "Appeler quelqu’un en garantie."
                                            },
                                            {
                                                "example_id": "cab67eb5-a297-40c2-bf80-16a36080b2d6",
                                                "sense_id": "b54ad08e-de7a-3b6a-9e0f-5af7cf45d30a",
                                                "text": "Il n’y a pas lieu à garantie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e39262-c5bf-3f71-8dbd-342589d09086",
                                        "entry_id": "4f9bdcde-2098-3a21-bc45-8fa77718c2b5",
                                        "glosses": [
                                            "Sûreté ; ce qui garantit une chose, ce qui la rend sûre, indubitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00fc52e0-5a8f-4f80-af32-3ce625a2afaf",
                                                "sense_id": "d7e39262-c5bf-3f71-8dbd-342589d09086",
                                                "text": "Quelle garantie qu'il viendra?"
                                            },
                                            {
                                                "example_id": "ed7d22c6-d1d8-4d66-bd9f-3dbbb09a5cad",
                                                "sense_id": "d7e39262-c5bf-3f71-8dbd-342589d09086",
                                                "text": "Le voleur ne met pas en question dans les livres sophistiques la propriété, l’hérédité, les garanties sociales ; il les supprime net."
                                            },
                                            {
                                                "example_id": "1056719f-6daa-43cf-aaad-79b4a62b6df5",
                                                "sense_id": "d7e39262-c5bf-3f71-8dbd-342589d09086",
                                                "text": "Même un contrat en bonne et due forme, ratifié et tamponné par votre partenaire chinois, n'est pas la garantie que les choses se passeront comme prévu. Mais ce document vous permettra tout au moins d'avoir une arme de renégociation…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garantie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cfc8933-76f7-3631-b088-223f6599b224",
                                        "entry_id": "8be46848-b5a4-341d-a6f6-15e3c4879326",
                                        "glosses": [
                                            "Féminin singulier de garanti."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "137147bd-3a43-4489-8e76-542bb05abb86",
                                                "sense_id": "0cfc8933-76f7-3631-b088-223f6599b224",
                                                "text": "Ceux-ci, en effet, écœurés par la baisse de leurs cens, se tournent vers la propriété de la terre, dont la valeur est garantie contre l’inflation parce que indexée, surindexée même par rapport au mouvement des prix."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garantie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "147d37a3-5fa9-37eb-9b72-f1eeff879562",
                                        "entry_id": "0db970ba-ecd3-3471-973a-eef7a119c63a",
                                        "glosses": [
                                            "Participe passé féminin singulier de garantir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0deda5ef-a971-4f8a-af5b-0417e42175b6",
                                                "sense_id": "147d37a3-5fa9-37eb-9b72-f1eeff879562",
                                                "text": "Outre qu’un individu peut toujours se faire une niche à part dans une médiasphère (et même choisir de « décommuniquer »), le sens d’une technique de pointe n’est jamais donné à l’origine, ni son efficacité garantie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
