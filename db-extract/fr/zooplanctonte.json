                        "glosses": [
                            "Organisme appartenant au zooplancton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0c0047a-13e9-4563-b03b-8bfc7386184e",
                                "sense_id": "cdcb4cf0-a1c6-32d2-8c7b-eab31fe4cc0c",
                                "text": "Le zooplanctonte Acanthocyclops robustus joue un rôle déterminant dans le réseau trophique du réservoir Allal El Fassi."
                            },
                            {
                                "example_id": "6bc3efca-fc24-40be-8ecd-54778948f977",
                                "sense_id": "cdcb4cf0-a1c6-32d2-8c7b-eab31fe4cc0c",
                                "text": "Les poissons ont affiché une plus grande tolérance à l’arsenic que les invertébrés et les plantes aquatiques. Les poissons les plus sensibles étudiés … ont montré une sensibilité inférieure d’un ordre de grandeur à celle des invertébrés les plus sensibles étudiés, le crabe dormeur (Cancer magister), le zooplanctonte Eurythemora affinis, l’huître creuse du Pacifique (Crassostrea edulis) et l’oursin (Paracentrotus lividus). Les plantes aquatiques … ont semblé être de quatre à huit fois plus sensibles que les invertébrés."
                            }
                        ]
                    }
