                        "entry_id": "9b526815-22e2-387c-b669-c8ab1e8f3633",
                        "glosses": [
                            "To undo or overthrow (something) by preaching; to revoke (something preached before)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "00a00545-0832-40b8-b86a-562e9b7ce59e",
                                "sense_id": "d96d3057-5939-3cd5-8f3f-467960b66979",
                                "text": "The clergy their own principles denied: Unpreach'd their non-resisting cant, and pray'd / Their liberty and property's so dear"
                            },
                            {
                                "example_id": "417a12f2-a17c-42c1-9de6-8eed572fb93f",
                                "sense_id": "d96d3057-5939-3cd5-8f3f-467960b66979",
                                "text": "[Y]et for a priest of the Church of England, […] to show the white feather in the hour of need, is to unpreach in one minute all that he had been preaching his life-long."
                            }
                        ]
                    }
