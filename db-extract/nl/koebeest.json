                        "examples": [
                            {
                                "example_id": "a5e5efb7-0d43-4d85-88fa-7024e386713f",
                                "sense_id": "d5921c19-2554-338e-bb02-b07c71834910",
                                "text": "Ik hijs ze in een oranje overall en groene laarzen en stuur ze de weide in om met onze koebeesten Clara, Bertha en Matilda op de foto te gaan."
                            },
                            {
                                "example_id": "bc8db1db-8b28-454d-883a-61c86d5ebdae",
                                "sense_id": "d5921c19-2554-338e-bb02-b07c71834910",
                                "text": "Daarna moest hij twaalf jaar geduld hebben voor hij vrijdagavond eindelijk toch zo’n glimmend koebeest [Gouden Kalf] mee naar huis mocht nemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
