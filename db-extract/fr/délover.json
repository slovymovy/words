                        "glosses": [
                            "Dérouler un câble qui était lové ou plié en cercle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c12461b-5ad7-413e-8dc5-bde0bf013d68",
                                "sense_id": "dc33005e-6bb4-319b-80c9-d1be02669514",
                                "text": "Raccorder, lover, délover, « connectoriser » les fibres en immeuble, selon les normes et règles en vigueur chez l'opérateur"
                            }
                        ]
                    },
                    {
                        "sense_id": "f4480a91-56aa-33b0-b658-0419417be284",
