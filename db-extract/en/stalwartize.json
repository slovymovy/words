                "senses": [
                    {
                        "sense_id": "bf645685-2794-3f27-ab04-6da9d5388e5b",
                        "entry_id": "45c191b6-ffd4-3cf4-b692-cd93bc6f06e0",
                        "glosses": [
                            "To make stalwart."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "addb65cf-8848-4f39-9a1a-e0e9af552ad0",
                                "sense_id": "bf645685-2794-3f27-ab04-6da9d5388e5b",
                                "text": "The Administration has been goaded by the charges made in and out of Congress that it has been trying to “stalwartize\" the party by removals in the civil service, into publishing a sort of schedule of the President's doings in that field."
                            },
                            {
                                "example_id": "72268f40-e10a-4e52-be6f-b2ecba341d40",
                                "sense_id": "bf645685-2794-3f27-ab04-6da9d5388e5b",
                                "text": "In a word, the Executive and those from whom he takes advice have undertaken the peculiar task of stalwartizing the Republican party, and that too when the very name of stalwart has become a reproach."
                            },
                            {
                                "example_id": "07c98db8-a435-44c1-ae37-b4694e6e6480",
                                "sense_id": "bf645685-2794-3f27-ab04-6da9d5388e5b",
                                "text": "He represented the chief hope of \"stalwartizing\" the state."
                            }
                        ]
                    }
                ],
