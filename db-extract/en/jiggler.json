                        "glosses": [
                            "A key, now especially a car key, that has been partially ground down so that it will open many locks."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "06c9bd31-bc90-4c25-a908-ea35577937fc",
                                "sense_id": "d0b1a5a4-4863-3a36-af48-b3da8ae2ba62",
                                "text": "This may be accomplished by means of jiggler keys used for opening door locks. Such keys are of two types: those for opening locks having two sets of tumblers, and those for opening locks having only one set."
                            },
                            {
                                "example_id": "36ea14c4-98e6-4c16-a276-0a4795c0917a",
                                "sense_id": "d0b1a5a4-4863-3a36-af48-b3da8ae2ba62",
                                "text": "I knew about the whole key “jigglers.” Basically, random car keys are shaved down with a file, rounding out sharp edges."
                            }
                        ]
                    }
