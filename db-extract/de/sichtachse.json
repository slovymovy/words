                                        "sense_id": "75861625-f138-3e97-ae34-f72a069a31a5",
                                        "entry_id": "fa0c1b5a-a555-3844-b734-8401bda43cc0",
                                        "glosses": [
                                            "A distant view or prospect, especially one seen through some opening, avenue or passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee44f802-7706-4ded-a310-4811a74f1d12",
                                                "sense_id": "75861625-f138-3e97-ae34-f72a069a31a5",
                                                "text": "The sun soon broke forth from that one dark cloud, gradually melting into light; and the sunbeams and the glittering rain went driving together through the forest glades—those long vistas, of which the slender deer seemed the sole habitants."
                                            },
                                            {
                                                "example_id": "f6b4a989-6418-4a55-9f25-315b878fee30",
                                                "sense_id": "75861625-f138-3e97-ae34-f72a069a31a5",
                                                "text": "We had our reward for our high camp and early start, for the sky was still clear, the view magnificent, with fresh vistas to the north of mountains in Tibet, of Gurla Mandhata, massive, majestic to the northeast, and further to the north, a distant pyramid, Kailash, most holy of all mountains in both Hindu and Buddhist mythology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4af9812-1a2c-3ef0-b445-cb8ddb105825",
                                        "entry_id": "fa0c1b5a-a555-3844-b734-8401bda43cc0",
                                        "glosses": [
                                            "A site offering such a view."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb36bc86-f37d-398b-9521-1d4b8d85c067",
                                        "entry_id": "fa0c1b5a-a555-3844-b734-8401bda43cc0",
                                        "glosses": [
                                            "A vision; a view presented to the mind in prospect or in retrospect by the imagination."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aee341c-5135-4451-aa0e-07696e0907fd",
                                                "sense_id": "eb36bc86-f37d-398b-9521-1d4b8d85c067",
                                                "text": "a vista of pleasure to come"
                                            },
                                            {
                                                "example_id": "c0c458b8-19ad-4367-aa97-c217ce4c8722",
                                                "sense_id": "eb36bc86-f37d-398b-9521-1d4b8d85c067",
                                                "text": "dim vistas of the past"
                                            },
                                            {
                                                "example_id": "b98e664d-1588-4996-9e82-d61cd24f13b9",
                                                "sense_id": "eb36bc86-f37d-398b-9521-1d4b8d85c067",
                                                "text": "And while our discourse might be a disaster area, the imaginative vistas of the Internet are far more vast than the modest plot of our feeds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vista",
