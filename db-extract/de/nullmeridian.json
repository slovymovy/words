                "senses": [
                    {
                        "sense_id": "3d7aa660-defc-30ee-8756-5d744e7608e7",
                        "entry_id": "66e7b9df-4945-3f86-a80a-c468ecad261d",
                        "glosses": [
                            "Meridian, von dem aus die geografische Länge nach Osten und Westen gezählt wird"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "f4931a04-4640-49dd-8cba-d2e9edcba0b3",
                                "sense_id": "3d7aa660-defc-30ee-8756-5d744e7608e7",
                                "text": "Der derzeit gültige Nullmeridian wurde auf der Meridiankonferenz im Jahr 1884 festgelegt."
                            },
                            {
                                "example_id": "7d1dac3c-df86-4b67-8492-3157d72ddecc",
                                "sense_id": "3d7aa660-defc-30ee-8756-5d744e7608e7",
                                "text": "„Da die Erde keine Scheibe ist, kann keine Nation behaupten, sie sei der Mittelpunkt der Welt. Mit dem Nullmeridian gab es jedoch im Zeitalter des Imperialismus einen valablen Ersatz, den sich Grossbritannien 1884 ergattern konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7710c3d7-95cb-4474-95ee-d789ac504b2a",
                        "source_entry_id": "66e7b9df-4945-3f86-a80a-c468ecad261d",
                        "source_sense_id": "3d7aa660-defc-30ee-8756-5d744e7608e7",
                        "source_sense_description": "Geografie: Meridian, von dem aus die geografische Länge nach Osten und Westen gezählt wird",
                        "target_lang_word": "prime meridian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prime meridian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d886f7ea-6cbd-3a3d-9a9f-a3b71f9ea973",
                                        "entry_id": "89f371d0-acaa-3f11-bc45-f93327f702b6",
                                        "glosses": [
                                            "The reference line at 0° longitude, passing through Greenwich, England, from which longitude east and west is measured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b66f6a4a-3d03-402c-bf0f-52ed7a4b499d",
                                                "sense_id": "d886f7ea-6cbd-3a3d-9a9f-a3b71f9ea973",
                                                "text": "Other prime meridians were presented as candidates for the world's baseline: Jerusalem; Ferro; Kamchatka; the mid-Atlantic; the Bering Strait; and Greenwich's antimeridian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
