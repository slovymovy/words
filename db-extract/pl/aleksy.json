                                "target_senses": [
                                    {
                                        "sense_id": "cdb8d2a0-01ec-34e2-9c30-69ab14613446",
                                        "entry_id": "39e3a2ff-17fc-3626-ab86-424b894c666f",
                                        "glosses": [
                                            "мужское имя, церковнославянская форма имени Алексей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed6c095-c4af-46a0-8b37-30fd45d4bd13",
                                                "sense_id": "cdb8d2a0-01ec-34e2-9c30-69ab14613446",
                                                "text": "Моего друга зовут Алексий."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "419a51e6-cb2b-41ca-ba86-cbbee0a8832a",
                        "source_entry_id": "bf047999-96d2-3dcf-9480-56107cc97aa6",
                        "source_sense_id": "58f53fb1-140b-3b15-8797-12e1b87b8db8",
