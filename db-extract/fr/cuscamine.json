                        "sense_id": "b26faae8-230f-3a13-9f00-c98b1ad03545",
                        "entry_id": "b250e713-ee5c-3f23-9204-c71595e6c095",
                        "glosses": [
                            "Alcaloïde extrait de l’écorce du quinquina rouge (Cinchona pubescens, autrefois Cinchona pelletieriana)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a9a051-0a44-4e7c-9c1a-c9de65734bcb",
                                "sense_id": "b26faae8-230f-3a13-9f00-c98b1ad03545",
                                "text": "L’auteur a trouvé dans les quinquinas, analogues à l’écorce de Cusco, deux alcaloïdes : la cuscamine cristallisable et la cuscamidine amorphe."
                            },
                            {
                                "example_id": "12dc3e37-dbbe-44ac-a9fd-ad02d01026ad",
                                "sense_id": "b26faae8-230f-3a13-9f00-c98b1ad03545",
                                "text": "CUSCAMINE\nCe nom a été donné par Hesse à un alcaloïde retiré d’une écorce de quinquina ressemblant au quinquina de Cusco et attribuée au Cinchona pelletieriana. Dans cette écorce la cuscamine est accompagnée d'un autre alcaloïde …."
                            },
                            {
                                "example_id": "50e65961-c9ea-469c-8e9d-fa29a7af74fd",
                                "sense_id": "b26faae8-230f-3a13-9f00-c98b1ad03545",
                                "text": "La découverte de la cuscamine appartient à Hesse."
                            }
                        ]
                    }
                ],
