                "senses": [
                    {
                        "sense_id": "65eff319-7100-32fe-a059-b04bc2fb6ff0",
                        "entry_id": "35a1f17f-06ec-3e95-a2c2-1b7e64f1b61c",
                        "glosses": [
                            "mit einem Blumenmuster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a82ce78-6ffb-4694-8ac2-68c082b18075",
                                "sense_id": "65eff319-7100-32fe-a059-b04bc2fb6ff0",
                                "text": "„Ich finde diese geblümten Tapeten jetzt scheußlich. Am Wochenende wird renoviert!“"
                            },
                            {
                                "example_id": "f214be56-67d7-473b-af52-eeafa7a2e6ba",
                                "sense_id": "65eff319-7100-32fe-a059-b04bc2fb6ff0",
                                "text": "„Wir haben nur Hellblau oder Rosa“, sagt die Verkäuferin. „Geblümt ist ausverkauft.“"
                            },
                            {
                                "example_id": "e2589ecc-a88e-4238-ae9d-abcc11e2e2e9",
                                "sense_id": "65eff319-7100-32fe-a059-b04bc2fb6ff0",
                                "text": "Der Vorhang war beige geblümt, der Stoff eher grob."
                            },
                            {
                                "example_id": "d6fcda4a-630b-4ad5-81ae-3d25c245c62d",
                                "sense_id": "65eff319-7100-32fe-a059-b04bc2fb6ff0",
                                "text": "[Fatimas] neues Kleid, grün geblümt, ist blutgetränkt."
                            },
                            {
                                "example_id": "3aa32fd7-f775-45a5-bc51-c5fc58801211",
                                "sense_id": "65eff319-7100-32fe-a059-b04bc2fb6ff0",
                                "text": "Leicht geblümt ist ihre helle Bluse, weiß der kurze Rock."
                            },
                            {
                                "example_id": "44f1b26d-8163-4a57-8434-64b898685ae9",
                                "sense_id": "65eff319-7100-32fe-a059-b04bc2fb6ff0",
                                "text": "Elke Koska […] tritt in außergewöhnlichen, eigenartigen, ja eigenwilligen Kostümen auf – farbenfroh, geblümt, schrill, durchaus mit einem Hut auf dem Kopf, den eine Blume ziert."
                            }
                        ],
