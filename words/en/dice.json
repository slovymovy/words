{
    "word_family": [
        "dicer",
        "dicing",
        "undiced"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fd5cdac-9303-333d-b9eb-a2ef61bc6d39",
                    "sense_definition": "A small cube with each side having a different number of spots on it, ranging from one to six, used in games of chance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gaming_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rolled the <w>dice</w> and got a six, which meant he could start the game.",
                            "target_lang_translations": {
                                "ru": "Он бросил <w>кости</w> и выбросил шестерку, что означало, что он может начать игру."
                            }
                        },
                        {
                            "text": "The board game comes with two red <w>dice</w> and several colorful tokens.",
                            "target_lang_translations": {
                                "ru": "В комплект настольной игры входят две красные <w>игральные кости</w> и несколько разноцветных фишек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roll the dice",
                        "pair of dice",
                        "shake the dice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький кубик, на каждой грани которого нанесено разное количество точек (от одной до шести), используемый в азартных и настольных играх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игральная кость",
                                "target_lang_sense_clarification": "предмет для игры"
                            },
                            {
                                "target_lang_word": "кубик",
                                "target_lang_sense_clarification": "разговорное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f401fd57-38b4-3095-baf5-5927ff2acf95",
                    "sense_definition": "The plural form of <w>die</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In most modern board games, players use two <w>dice</w> to determine how many spaces to move.",
                            "target_lang_translations": {
                                "ru": "В большинстве современных настольных игр игроки используют две <w>кости</w>, чтобы определить, на сколько клеток нужно передвинуться."
                            }
                        },
                        {
                            "text": "The <w>dice</w> are made of plastic and have rounded corners for better rolling.",
                            "target_lang_translations": {
                                "ru": "Эти <w>кубики</w> сделаны из пластика и имеют закругленные углы для лучшего вращения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of die"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа слова «die» (игральная кость)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игральные кости",
                                "target_lang_sense_clarification": "множественное число"
                            },
                            {
                                "target_lang_word": "кости",
                                "target_lang_sense_clarification": "краткая форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8f695bb-295c-3a74-abd5-9d79df4d8833",
                    "sense_definition": "The activity or game of playing with one or more dice, typically for gambling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers spent their evenings playing <w>dice</w> in the barracks to pass the time.",
                            "target_lang_translations": {
                                "ru": "Солдаты проводили вечера, играя в <w>кости</w> в казармах, чтобы скоротать время."
                            }
                        },
                        {
                            "text": "He lost a significant amount of money during a game of <w>dice</w> at the tavern.",
                            "target_lang_translations": {
                                "ru": "Он проиграл значительную сумму денег во время игры в <w>кости</w> в таверне."
                            }
                        }
                    ],
                    "synonyms": [
                        "astragals"
                    ],
                    "common_phrases": [
                        "game of dice",
                        "play at dice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занятие или игра с использованием одной или нескольких игральных костей, обычно на деньги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игра в кости",
                                "target_lang_sense_clarification": "азартная игра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "378c8fbf-c0d0-3644-aded-d57347e39566",
                    "sense_definition": "Food that has been cut into small, uniform cubes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add the onion <w>dice</w> to the pan and sauté until they are translucent.",
                            "target_lang_translations": {
                                "ru": "Добавьте <w>кубики</w> лука в сковороду и обжаривайте, пока они не станут прозрачными."
                            }
                        },
                        {
                            "text": "The recipe calls for a small <w>dice</w> of carrots and celery for the soup base.",
                            "target_lang_translations": {
                                "ru": "По рецепту для основы супа требуется мелкая <w>нарезка кубиками</w> моркови и сельдерея."
                            }
                        }
                    ],
                    "common_phrases": [
                        "small dice",
                        "medium dice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пища, нарезанная маленькими ровными кубиками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кубики",
                                "target_lang_sense_clarification": "форма нарезки продуктов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09134f4a-d50f-3ff1-abea-b728dc230b72",
                    "sense_definition": "To cut food into small, uniform cubes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooking_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>dice</w> the carrots finely before adding them to the boiling water.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, мелко <w>нарежьте кубиками</w> морковь, прежде чем добавлять её в кипящую воду."
                            }
                        },
                        {
                            "text": "You should <w>dice</w> vegetables into equal sizes so they cook at the same rate.",
                            "target_lang_translations": {
                                "ru": "Овощи следует <w>нарезать кубиками</w> одинакового размера, чтобы они готовились одновременно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dice the vegetables",
                        "finely dice",
                        "dice into cubes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарезать продукты маленькими ровными кубиками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарезать кубиками",
                                "target_lang_sense_clarification": "способ измельчения"
                            },
                            {
                                "target_lang_word": "порезать кубиками",
                                "target_lang_sense_clarification": "кулинарное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d092bd3-d7fe-3c13-ac6c-459681f8e203",
                    "sense_definition": "To play games of chance using dice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They would sit in the corner and <w>dice</w> for hours, wagering small coins.",
                            "target_lang_translations": {
                                "ru": "Они часами сидели в углу и <w>играли в кости</w>, ставя на кон мелкие монеты."
                            }
                        },
                        {
                            "text": "The king was known to <w>dice</w> with his courtiers late into the night.",
                            "target_lang_translations": {
                                "ru": "Король был известен тем, что до поздней ночи <w>играл в кости</w> со своими придворными."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carding and dicing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть в азартные игры, используя кости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть в кости",
                                "target_lang_sense_clarification": "процесс игры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45d16971-1546-3a12-a908-a88676c1b633",
                    "sense_definition": "To decorate or ornament a surface with a pattern of squares or cubes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan chose to <w>dice</w> the border of the shield with silver and gold squares.",
                            "target_lang_translations": {
                                "ru": "Мастер решил <w>украсить</w> край щита узором из серебряных и золотых квадратов."
                            }
                        },
                        {
                            "text": "The floor was beautifully <w>diced</w> with alternating marble tiles.",
                            "target_lang_translations": {
                                "ru": "Пол был красиво <w>выложен</w> чередующимися мраморными плитками в шахматном порядке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать поверхность узором из квадратов или кубов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать шахматным узором",
                                "target_lang_sense_clarification": "декорирование"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "91610a07-e19f-3acd-9a8b-c11933bf7cce",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Dice</w> was appointed as the new head of the local historical society.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Дайс</w> был назначен новым главой местного исторического общества."
                            }
                        },
                        {
                            "text": "The archives contain several records pertaining to the <w>Dice</w> family in this region.",
                            "target_lang_translations": {
                                "ru": "В архивах сохранилось несколько записей, относящихся к семье <w>Дайс</w> в этом регионе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дайс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}