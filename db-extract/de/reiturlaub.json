                "senses": [
                    {
                        "sense_id": "82e6fa88-7af8-3285-9ff5-1d4a2b57c8e2",
                        "entry_id": "4379da12-52f1-3344-95bb-71743dd812e3",
                        "glosses": [
                            "Urlaub, dessen Hauptzweck die Möglichkeit zum Reiten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff7e79a7-b582-4beb-bbb4-473c83877e4a",
                                "sense_id": "82e6fa88-7af8-3285-9ff5-1d4a2b57c8e2",
                                "text": "„Für einen längeren Reiturlaub gibt es sehr abwechslungsreiche Strecken für Geübte und Anfänger sowie hohe Pferderücken und Ponys für die Kleinen.“"
                            },
                            {
                                "example_id": "94c105c0-b3bb-4391-8745-c6494bf139d2",
                                "sense_id": "82e6fa88-7af8-3285-9ff5-1d4a2b57c8e2",
                                "text": "„Wie der Landtag auf Antrag der Regierungsparteien SPD und CDU beschloss, soll der Reiturlaub stärker in die Tourismusstrategie des Landes integriert werden.“"
                            }
                        ],
