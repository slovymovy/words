                "senses": [
                    {
                        "sense_id": "42b03e4b-c4f0-3511-8f69-5eb9269fc3fe",
                        "entry_id": "360fc670-6dff-35e0-a0d9-2b35b0ca0c53",
                        "glosses": [
                            "to revolt, to rebel, to incite a revolt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3063daf6-0836-4ba5-b918-f1c926cb3465",
                                "sense_id": "42b03e4b-c4f0-3511-8f69-5eb9269fc3fe",
                                "text": "— Вы смутья́нить пришли́! — закрича́л он. — Шали́т Анто́ша? Вы врёте, ничего́ он не шали́т.[...]",
                                "translation": "\" So you've come to raise a riot here ! \" he cried. \" You say Antosha's mischievous ? You're a liar. He's not mischievous.…\"",
                                "english": "\" So you've come to raise a riot here ! \" he cried. \" You say Antosha's mischievous ? You're a liar. He's not mischievous.…\""
                            }
                        ]
                    }
                ],
