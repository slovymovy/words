                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "videohra",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "68f100b2-3309-3488-9317-21805ab9a95c",
                                        "entry_id": "f769e895-22b6-3fa8-b08c-fa3078f149b6",
                                        "glosses": [
                                            "hra na elektronickém zařízení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e97c20-db84-474f-ab1e-bb869431630f",
                                                "sense_id": "68f100b2-3309-3488-9317-21805ab9a95c",
                                                "text": "Samorost 2 navázal na první díl a stal se také hitem. Amanita Design se díky tomu začala drápat mezi úspěšná tuzemská herní studia. Dřevěného a malého trpaslíka ale nahradil robot a videohra Machinarium, která byla kompletně ručně kreslená."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
