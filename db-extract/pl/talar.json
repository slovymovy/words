                                            {
                                                "example_id": "3d2ea6f7-0bd9-4d1c-9688-e2de0f19cff8",
                                                "sense_id": "1434d2be-5284-3735-9f71-43515bf22a28",
                                                "text": "Op de markt is uw gulden een daalder waard."
