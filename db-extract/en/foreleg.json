                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "799087c4-d05d-45c3-aa5a-aafc2d085684",
                        "entry_id": "a7cff1c6-f8f4-31e9-8e81-7d81b16832aa",
