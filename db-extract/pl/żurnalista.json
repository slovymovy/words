                    }
                ],
                "translations": [
                    {
                        "translation_id": "38dfd650-5742-4cf5-adf8-526a01217eeb",
                        "source_entry_id": "8f14fbcd-428c-3750-b9c7-f1bebf4190ef",
                        "source_sense_id": "54300bff-131a-3b55-a251-ba678e631105",
                        "source_sense_description": "Medien: Journalist",
                        "target_lang_word": "Journalist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Journalist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d63de05f-62ef-3a34-bee8-9836b640807f",
                                        "entry_id": "7fad0b1b-80bd-329c-aa55-df7dc9a1dac7",
                                        "glosses": [
                                            "jemand, der beruflich für Zeitungen/Zeitschriften, Radio/Fernsehen oder andere Massenmedien arbeitet und Informationen beschafft und verbreitet"
                                        ],
                                        "tags": [
                                            "Journalismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b83864f-b1bb-4868-8326-dd7e0cf15508",
                                                "sense_id": "d63de05f-62ef-3a34-bee8-9836b640807f",
                                                "text": "Der Minister empfing die Journalisten zu einer Presseerklärung."
                                            },
                                            {
                                                "example_id": "072b88fc-a5ed-4e86-9e38-c0ed8c9ef380",
                                                "sense_id": "d63de05f-62ef-3a34-bee8-9836b640807f",
                                                "text": "„Journalisten kritisierten in Journalen wortreich die Journaille…“"
                                            },
                                            {
                                                "example_id": "7e62c12c-d31f-4688-92a8-a22e3e6ea506",
                                                "sense_id": "d63de05f-62ef-3a34-bee8-9836b640807f",
                                                "text": "„Als Journalist hätte ich natürlich eine Reportage, zumindest einen Kurzbericht schreiben können.“"
                                            },
                                            {
                                                "example_id": "e45bd579-7990-4eca-af50-f1ee07549655",
                                                "sense_id": "d63de05f-62ef-3a34-bee8-9836b640807f",
                                                "text": "„Da der Journalismus häufig als »vierte Gewalt« in Deutschland angesehen würde, sollten die Journalisten ihr Werkzeug Sprache in einer vorbildlichen Weise beherrschen.“"
                                            },
                                            {
                                                "example_id": "85753e7e-200d-4659-856e-4370b2f91435",
                                                "sense_id": "d63de05f-62ef-3a34-bee8-9836b640807f",
                                                "text": "„Und was der Journalist nicht verdreht, verdreht sein Redakteur, weil er Sensationen braucht oder etwas nicht versteht, weil es auf seiner Journalistenschule nicht vorkam oder er es nicht kennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
