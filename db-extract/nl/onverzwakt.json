                                "target_senses": [
                                    {
                                        "sense_id": "2283b51a-1068-3275-bb83-240c19b53360",
                                        "entry_id": "a1ca6e00-fb3b-3c01-bc10-091df554e37d",
                                        "glosses": [
                                            "Not spoiled or touched; pure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6fa662e-1dd2-430b-9e82-458fe3daa2fa",
                                                "sense_id": "2283b51a-1068-3275-bb83-240c19b53360",
                                                "text": "Architecturally the stations of the Tonbridge-Hastings line are of great interest. Wadhurst, Robertsbridge and Stonegate are of simple Italinate^([sic]) style, unspoiled by that necessary evil of a platform awning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5aa99a81-c12b-4b35-935b-77c1021a4c2a",
                        "source_entry_id": "84353708-90d9-37a8-aca4-88ae1af8358e",
                        "source_sense_id": "11038fc0-2bab-3c59-8c22-6cbdc42772b6",
