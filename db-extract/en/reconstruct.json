                                "target_senses": [
                                    {
                                        "sense_id": "519bc066-4f7e-3da7-ad24-046343607648",
                                        "entry_id": "03179442-fe11-3e3a-84b3-3b9bffda3257",
                                        "glosses": [
                                            "etwas Zerstörtes oder nicht mehr Vorhandenes (aus den Überresten oder mit Hilfe indirekter Zeugnisse) möglichst originalgetreu wiederaufbauen und/oder nachbilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bac7f48-ce7c-4db6-988b-33e158ee23d7",
                                                "sense_id": "519bc066-4f7e-3da7-ad24-046343607648",
                                                "text": "Zwar werden die Barockfassaden des Berliner Schlosses rekonstruiert, in seinem Inneren werden sich aber moderne Ausstellungsräume präsentieren."
                                            },
                                            {
                                                "example_id": "edf0da00-68fa-474f-a3ce-94d1699448b0",
                                                "sense_id": "519bc066-4f7e-3da7-ad24-046343607648",
                                                "text": "Durch archäologische Grabungen haben Wissenschaftler jenen Tempel rekonstruiert, an dessen Stelle sich heute die Kirche erhebt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc8776f1-c90c-3018-9d17-af6b129f6448",
                                        "entry_id": "03179442-fe11-3e3a-84b3-3b9bffda3257",
                                        "glosses": [
                                            "einen Vorgang oder Ablauf mithilfe von Anhaltspunkten in seinen Einzelheiten erschließen und genau wiedergeben, darstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd2196d5-e984-4fc0-9458-eed3303f7c8e",
                                                "sense_id": "fc8776f1-c90c-3018-9d17-af6b129f6448",
                                                "text": "Nach Zeugenaussagen rekonstruieren die Kriminalbeamten den Hergang eines Einbruches."
                                            },
                                            {
                                                "example_id": "f3445a80-4bf2-4668-b023-6d574ef2acfd",
                                                "sense_id": "fc8776f1-c90c-3018-9d17-af6b129f6448",
                                                "text": "Anhand von Quelltexten rekonstruierten Historiker die Vorgänge und machten viele neue Entdeckungen."
                                            },
                                            {
                                                "example_id": "d69678fe-f339-4dfd-b6c2-a08f3d79657b",
                                                "sense_id": "fc8776f1-c90c-3018-9d17-af6b129f6448",
                                                "text": "„Obwohl nur Knochen- und Zahnfragmente der Urmenschen erhalten geblieben sind, bieten sich Möglichkeiten, ihre Lebensweise zu interpretieren und zu rekonstruieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "07ea4e7d-552a-3b62-ba26-ea58cd424a42",
                                        "entry_id": "03179442-fe11-3e3a-84b3-3b9bffda3257",
                                        "glosses": [
                                            "etwas zu größerem wirtschaftlichen und ökonomischen Nutzen nach dem modernsten Stand von Wissenschaft und Technik umgestalten/ausbauen/modernisieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19be40c9-9b41-45f9-8547-e21ce587dfa7",
                                                "sense_id": "07ea4e7d-552a-3b62-ba26-ea58cd424a42",
                                                "text": "Der seit langem stillgelegte Tagebau wurde vor kurzem völlig rekonstruiert."
                                            },
                                            {
                                                "example_id": "79e1c8eb-5dd6-490b-8763-83d55e80e6b2",
                                                "sense_id": "07ea4e7d-552a-3b62-ba26-ea58cd424a42",
                                                "text": "Politiker stehen vor der schweren Aufgabe, in der heruntergekommenen Gegend die Arbeitsplätze und die Infrastruktur zu rekonstruieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
