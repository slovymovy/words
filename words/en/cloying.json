{
    "word_family": [
        "cloy",
        "cloyingly",
        "cloyingness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53b478d8-d85b-3782-a8fe-a369fe3b6552",
                    "sense_definition": "Disgustingly or sickeningly sweet in taste or smell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sweetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cheap perfume had a <w>cloying</w> scent of synthetic vanilla.",
                            "target_lang_translations": {
                                "fr": "Le parfum bon marché avait une odeur <w>écœurante</w> de vanille synthétique."
                            }
                        },
                        {
                            "text": "I could only eat a few bites of the dessert because the icing was far too <w>cloying</w>.",
                            "target_lang_translations": {
                                "fr": "Je n'ai pu manger que quelques bouchées du dessert car le glaçage était bien trop <w>écœurant</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "oversweet",
                        "syrupy",
                        "treacly"
                    ],
                    "common_phrases": [
                        "cloying sweetness",
                        "cloying scent"
                    ],
                    "target_lang_definitions": {
                        "fr": "D'une douceur ou d'un goût sucré excessif, au point d'en devenir écœurant ou nauséeux."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "écœurant",
                                "target_lang_sense_clarification": "d'une douceur excessive au goût ou à l'odeur"
                            },
                            {
                                "target_lang_word": "doucereux",
                                "target_lang_sense_clarification": "d'une fadeur sucrée désagréable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "071e1e9b-534d-3998-b7be-c47451d37a14",
                    "sense_definition": "Unpleasantly excessive, sentimental, or flattering to the point of causing disgust.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "excessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was ruined by its <w>cloying</w> sentimentality and predictable ending.",
                            "target_lang_translations": {
                                "fr": "Le film a été gâché par sa sentimentalité <w>sirupeuse</w> et sa fin prévisible."
                            }
                        },
                        {
                            "text": "Her <w>cloying</w> compliments made everyone in the room feel rather uncomfortable.",
                            "target_lang_translations": {
                                "fr": "Ses compliments <w>mielleux</w> ont mis mal à l'aise tout le monde dans la pièce."
                            }
                        }
                    ],
                    "synonyms": [
                        "saccharine",
                        "treacly"
                    ],
                    "common_phrases": [
                        "cloying sentimentality"
                    ],
                    "target_lang_definitions": {
                        "fr": "Excessivement sentimental, mielleux ou flatteur, au point de susciter le dégoût ou la gêne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "mielleux",
                                "target_lang_sense_clarification": "hypocrite ou doucereux dans l'attitude ou les paroles"
                            },
                            {
                                "target_lang_word": "sirupeux",
                                "target_lang_sense_clarification": "sentimentalisme lourd ou excessif"
                            },
                            {
                                "target_lang_word": "écœurant",
                                "target_lang_sense_clarification": "exagérément sentimental ou flatteur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "910b1171-a0a3-3872-9b2e-da7f2dcb0ae3",
                    "sense_definition": "present participle and gerund of <w>cloy</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant stream of praise was quickly <w>cloying</w> the young author.",
                            "target_lang_translations": {
                                "fr": "Ce flot ininterrompu d'éloges était rapidement en train d'<w>écœurer</w> le jeune auteur."
                            }
                        },
                        {
                            "text": "Rich sauces risk <w>cloying</w> the palate before the main course arrives.",
                            "target_lang_translations": {
                                "fr": "Les sauces riches risquent de <w>saturer</w> le palais avant même l'arrivée du plat principal."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent ou gérondif du verbe « cloy » : dégoûter, lasser par excès de douceur ou de richesse."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "écœurant",
                                "target_lang_sense_clarification": "participe présent du verbe écœurer"
                            },
                            {
                                "target_lang_word": "rassasiant à l'excès",
                                "target_lang_sense_clarification": "provoquant le dégoût par satiété excessive"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}