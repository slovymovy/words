                "word": "dichtklappen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9f8246f-14b2-32a0-8690-897f790a614e",
                        "entry_id": "c3b0abf4-d7da-3d7a-88c2-e2bcd467b0a0",
                        "glosses": [
                            "met een klap sluiten van iets"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bf62f25f-18d1-4e56-8d33-eb2076cad936",
                                "sense_id": "f9f8246f-14b2-32a0-8690-897f790a614e",
                                "text": "„Zullen we een alarm maken voor onder de deurmat?”, stelt Hut voor. „Als hij papa en mama zo hoort aankomen, kan hij snel de laptop dichtklappen en in bed gaan liggen.”"
                            },
                            {
                                "example_id": "98c8f7c8-f330-4c9e-b9b1-7a6d5146aa53",
                                "sense_id": "f9f8246f-14b2-32a0-8690-897f790a614e",
                                "text": "In een schrikreactie liet hij het touwtje los, waardoor de luxaflex hard dichtklapte en de inhoud van de kamer weer door het duister werd opgeslokt. Met wild op- en neergaande borstkas zaten ze naast elkaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "3557aef5-96af-329e-82e7-dd3aa6edcd22",
                        "entry_id": "c3b0abf4-d7da-3d7a-88c2-e2bcd467b0a0",
                        "glosses": [
                            "het door emotionele spanning niet meer kunnen praten"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c70bbfdd-6564-434c-8aef-3691e1644037",
                                "sense_id": "3557aef5-96af-329e-82e7-dd3aa6edcd22",
                                "text": "„Sommige verdachten kampen met schaamtegevoelens en zullen dichtklappen."
                            }
                        ]
                    }
                ],
