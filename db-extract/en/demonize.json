                                        "entry_id": "c172e35b-5463-3db3-836e-8cba392a6372",
                                        "glosses": [
                                            "so beschreiben und behandeln, als ob etwas oder jemand etwas Schreckliches (ein Dämon) wäre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
