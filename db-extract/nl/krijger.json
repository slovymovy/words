                "senses": [
                    {
                        "sense_id": "4ac355eb-53e7-3c98-82a8-166d4adc2250",
                        "entry_id": "4291c0ea-58d9-3cba-a21a-d67b6ec91e72",
                        "glosses": [
                            "iemand die zich toelegt op het voeren van oorlog, met name tussen stammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b27d06-119e-451a-badc-a6b43dd9084b",
                                "sense_id": "4ac355eb-53e7-3c98-82a8-166d4adc2250",
                                "text": "De krijgers van de Lakota, Cheyenne en Arapho brachten Custer een gevoelige nederlaag toe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fcd1d5c-faed-4144-bd44-e48aec400c6d",
                        "source_entry_id": "4291c0ea-58d9-3cba-a21a-d67b6ec91e72",
                        "source_sense_id": "4ac355eb-53e7-3c98-82a8-166d4adc2250",
                        "source_sense_description": "iemand die zich toelegt op het voeren van oorlog, met name tussen stammen",
                        "target_lang_word": "Krieger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krieger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                        "entry_id": "daa7f63e-0bc9-3ac0-8c40-e6f22c28c946",
                                        "glosses": [
                                            "Person, die im Krieg kämpft"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50df60d-1649-4b34-9291-ce166345692e",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "Das Kämpfen ist die Aufgabe der Krieger."
                                            },
                                            {
                                                "example_id": "98eed2e3-dfe0-4318-aeca-f40834a9d233",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Die berittenen Krieger der Kelten wurden jeweils von zwei Dienern in den Kampf begleitet.“"
                                            },
                                            {
                                                "example_id": "731f80a5-c03a-403b-bdd5-d0a6cf8c9aa8",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Aber nicht nur die Knochen geopferter Krieger liegen hier, sondern auch über 15000 Teile ihrer Waffen, Schilde und persönliche Gegenstände.“"
                                            },
                                            {
                                                "example_id": "29ed2137-60ae-4476-a6bd-c79965f016a5",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Dort tauchen die Wikingerschiffe unerwartet auf und laufen bis an den Strand, von wo aus die Krieger oft nur noch wenige Schritte zurücklegen müssen.“"
                                            },
                                            {
                                                "example_id": "4d83c48e-e215-4629-a84e-ebdecefa9656",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Neben den Soldaten zu Fuß und der Reiterei spielten die Krieger auf den Streitwagen in der Schlacht eine wichtige Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Krieger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                        "entry_id": "98f21846-0e3c-3f41-970c-3b78df74c556",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c85013c-4649-4928-9d59-83f955a09990",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Frau Krieger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f9e0f942-b935-4361-b3d4-0c985787bc96",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Herr Krieger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "b441d681-03c9-4860-afc1-f676893e2293",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Die Kriegers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "04003066-194b-4c41-b363-fd660547d290",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Der Krieger trägt nie die Schals, die die Krieger ihm strickt."
                                            },
                                            {
                                                "example_id": "bc184ae2-05ff-4d6d-bcec-11341c94a475",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Krieger kommt, geht der Herr Krieger.“"
                                            },
                                            {
                                                "example_id": "ef769a81-a3ed-46ce-aa13-047c2c6910a3",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Krieger kommt und geht."
                                            },
                                            {
                                                "example_id": "6a0f8b13-432d-4e8a-85db-6450f8452e50",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Kriegers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edf43505-55f7-41c0-bc81-947c4aa969fc",
                        "source_entry_id": "4291c0ea-58d9-3cba-a21a-d67b6ec91e72",
                        "source_sense_id": "4ac355eb-53e7-3c98-82a8-166d4adc2250",
                        "source_sense_description": "iemand die zich toelegt op het voeren van oorlog, met name tussen stammen",
                        "target_lang_word": "warrior",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warrior",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63cca0dd-1a30-3318-884e-9a86be96f547",
                                        "entry_id": "08a41d82-fbf5-30d7-b99d-dccffd9e3700",
                                        "glosses": [
                                            "A person who is actively engaged in battle, conflict or warfare; a soldier or combatant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1d032e-5c09-43e9-85a9-7ecbb6d6148c",
                                                "sense_id": "63cca0dd-1a30-3318-884e-9a86be96f547",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            },
                                            {
                                                "example_id": "7ba8db62-6ad4-45b6-9b1c-f8a010b926b9",
                                                "sense_id": "63cca0dd-1a30-3318-884e-9a86be96f547",
                                                "text": "[Link:] Gee, it sure is boring around here.\n [King Harkinian:] My boy, this peace is what all true warriors strive for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "434aba44-e3e8-341b-99d0-8ffeb7a152d9",
                                        "entry_id": "08a41d82-fbf5-30d7-b99d-dccffd9e3700",
                                        "glosses": [
                                            "A person who is aggressively, courageously, or energetically involved in an activity, such as athletics."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9023ca2-d77f-45f1-a363-1bf37b7ce3a0",
                        "source_entry_id": "4291c0ea-58d9-3cba-a21a-d67b6ec91e72",
                        "source_sense_id": "4ac355eb-53e7-3c98-82a8-166d4adc2250",
                        "source_sense_description": "iemand die zich toelegt op het voeren van oorlog, met name tussen stammen",
                        "target_lang_word": "guerrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guerrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cdfae64-a124-371a-bb14-2c9b157ad6f0",
                                        "entry_id": "512b841a-a614-3fcc-b129-6b0a65b1e0b4",
                                        "glosses": [
                                            "Qui a rapport à la guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926c06d3-ede6-4836-a9eb-d36dc9ebe7fd",
                                                "sense_id": "3cdfae64-a124-371a-bb14-2c9b157ad6f0",
                                                "text": "Tu ne te souviens sans doute pas de moi, m'écrivait-il, mais il est impossible que tu aies complètement oublié nos petites aventures guerrières de l'été 1914, l'entrée en Belgique par Trélon, la rentrée en France, dare-dare, par Solre-le-Château, et cette sinistre nuit de Zorées, et cette traversée du bois du Nouvion, […]."
                                            },
                                            {
                                                "example_id": "4c4e57d4-11d9-4035-b4d1-e7899976a72b",
                                                "sense_id": "3cdfae64-a124-371a-bb14-2c9b157ad6f0",
                                                "text": "Ce héros, la lance brandie en avant, l’oriflamme sacrée flottant au-dessus de sa tête, entra d’un élan fougueux dans la masse guerrière qui lui prêtait le flanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e32fde-8ea5-3b5e-827a-c6df623c132c",
                                        "entry_id": "512b841a-a614-3fcc-b129-6b0a65b1e0b4",
                                        "glosses": [
                                            "Qui est porté à la guerre ; qui est propre à la guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb801983-5bf4-4a1e-a18a-a289e9802a89",
                                                "sense_id": "64e32fde-8ea5-3b5e-827a-c6df623c132c",
                                                "text": "Le cabo­tinage était poussé par Murat jusqu’au grotesque, et les historiens n’ont pas assez remarqué quelle responsabilité incombe à Napoléon dans cette dégénérescence du véritable esprit guerrier."
                                            },
                                            {
                                                "example_id": "6072f660-6dc4-4bf0-b660-77c46d8bcc35",
                                                "sense_id": "64e32fde-8ea5-3b5e-827a-c6df623c132c",
                                                "text": "C’est très violent et très “testostéroné”, cette manière d’opposer sans cesse les acteurs les uns aux autres. Laurent Wauquiez a un modèle de société très guerrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e892cba-8b73-35e4-adac-b22b3c22fc1f",
                                        "entry_id": "512b841a-a614-3fcc-b129-6b0a65b1e0b4",
                                        "glosses": [
                                            "Qui a l’allure, l’apparence d’un homme de guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb628b6-6329-4a56-92a5-5576baef64da",
                                                "sense_id": "1e892cba-8b73-35e4-adac-b22b3c22fc1f",
                                                "text": "Avoir l’air guerrier, la mine guerrière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guerrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                        "entry_id": "0e50f9ee-5d3f-37cc-be44-c1ab0f962307",
                                        "glosses": [
                                            "Celui qui fait la guerre et qui s’y plaît."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc1f810-480a-49c8-b803-4112439c55ce",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "Mais, l’ayant vu une fois déployer sa force dans la bataille, il me semble que je le reconnaîtrais entre mille guerriers."
                                            },
                                            {
                                                "example_id": "eec68310-682c-4083-8ba7-98288373b668",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "Hilperik entra à Paris sans aucune opposition, et logea ses guerriers dans les tours qui défendaient les ponts de la ville, alors environnée par la Seine."
                                            },
                                            {
                                                "example_id": "26e1221f-13b3-4631-b522-1438a23c43cb",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "[…]; les utopies sociales furent faites en vue de maintenir un noyau de guerriers homériques dans les cités, etc."
                                            },
                                            {
                                                "example_id": "8ffc1bb0-ac51-4774-bf7f-c0ef4532057d",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "N’avait-on pas vu, parfois des pachas turcs épouser leurs esclaves et de riches guerriers préférer leur servante à d’autre épouses plus magnifiquement parées ?"
                                            },
                                            {
                                                "example_id": "942ccae2-97e5-4f50-a2e0-3d37b7c985ed",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "Le garçon était assis, le dos à la porte, concentré sur l’écran de son ordinateur, sur lequel on voyait une sorte de guerrier bigorexique anéantissant des squelettes avec une épée disproportionnée. Il ne nous accorda même pas un regard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dec4576d-f9a7-38ba-94b4-d7427aaa4a7c",
                                        "entry_id": "0e50f9ee-5d3f-37cc-be44-c1ab0f962307",
                                        "glosses": [
                                            "Soldat."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81faaf8a-17be-46bf-850a-0110389743eb",
                                                "sense_id": "dec4576d-f9a7-38ba-94b4-d7427aaa4a7c",
                                                "text": "C’est notre première bataille, mais nous ébauchons instinctivement tous les gestes et les pensées que nous aurons une fois guerriers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
