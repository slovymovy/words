            "senses": [
                {
                    "sense_id": "831b77b6-42f3-3759-b41a-145316f37b82",
                    "sense_definition": "A person or machine that bores holes, especially in earth, rock, or other materials.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drilling_operator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>driller</w> prepared the specialized tools to bore through solid granite.",
                            "target_lang_translations": {
                                "ru": "<w>Бурильщик</w> подготовил специальные инструменты для бурения твёрдого гранита."
                            }
                        },
                        {
                            "text": "Before installing the fence, the <w>driller</w> bored deep holes for the wooden posts.",
                            "target_lang_translations": {
                                "ru": "Перед установкой забора <w>бурильщик</w> пробурил глубокие ямы для деревянных столбов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или механизм, который бурит отверстия, особенно в земле, скальной породе или других материалах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурильщик",
                                "target_lang_sense_clarification": "рабочий, выполняющий бурение"
                            },
                            {
                                "target_lang_word": "сверловщик",
                                "target_lang_sense_clarification": "рабочий, сверлящий отверстия"
                            },
                            {
                                "target_lang_word": "буровая машина",
                                "target_lang_sense_clarification": "механизм для бурения"
                            },
                            {
                                "target_lang_word": "бур",
                                "target_lang_sense_clarification": "инструмент или устройство для бурения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4759d36-bdaa-3ae2-ba85-bdd9210c5e62",
                    "sense_definition": "A person who operates or oversees a drilling rig, especially in the oil or gas industry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drilling_operator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced <w>driller</w> supervised the crew working on the offshore oil platform.",
                            "target_lang_translations": {
                                "ru": "Опытный <w>бурильщик</w> руководил бригадой, работавшей на морской нефтяной платформе."
                            }
                        },
                        {
                            "text": "Safety regulations require every <w>driller</w> to inspect the rig machinery each morning.",
                            "target_lang_translations": {
                                "ru": "Правила техники безопасности требуют, чтобы каждый <w>бурильщик</w> осматривал оборудование вышки каждое утро."
                            }
                        }
                    ],
                    "common_phrases": [
