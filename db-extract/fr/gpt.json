                "entry_id": "4dd26ca7-6750-3b58-88c7-e7debcb76b72",
                "word": "GPT",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "13027af6-9ea4-3dff-80ad-cdc57c39a9fa",
                        "entry_id": "4dd26ca7-6750-3b58-88c7-e7debcb76b72",
                        "glosses": [
                            "Modèle de langage, de type transformeur, capable d’autogénérer du texte."
                        ],
                        "tags": [
                            "Intelligence artificielle"
                        ],
                        "examples": [
                            {
                                "example_id": "4f103716-b13a-49ab-b4c7-2b9f841f6a8a",
                                "sense_id": "13027af6-9ea4-3dff-80ad-cdc57c39a9fa",
                                "text": "Nous employons les modèles GPT pour générer les textes artificiels."
                            },
                            {
                                "example_id": "7d863cf3-2860-4c85-ae25-afb07bf4fe48",
                                "sense_id": "13027af6-9ea4-3dff-80ad-cdc57c39a9fa",
                                "text": "Pour simplifier, ChatGPT est composé de deux parties : la partie GPT, qui est la partie de génération de texte qui existait déjà avant, et la partie chat, pour la simulation de dialogue, qui est nouvelle."
                            },
                            {
                                "example_id": "b6882763-2da6-4e15-8f89-970b3bcba0bf",
                                "sense_id": "13027af6-9ea4-3dff-80ad-cdc57c39a9fa",
                                "text": "Les modèles de langage comme GPT sont eux aussi de plus en plus larges, et pourraient être combinés avec les Text-to-Image pour créer un immense modèle multimodal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5819c9fd-283a-4d3d-9954-2ab33b594eb1",
                        "source_entry_id": "4dd26ca7-6750-3b58-88c7-e7debcb76b72",
                        "source_sense_id": "13027af6-9ea4-3dff-80ad-cdc57c39a9fa",
