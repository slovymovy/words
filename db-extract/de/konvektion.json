                                "target_senses": [
                                    {
                                        "sense_id": "de85c5b4-b7fa-3ba3-94b8-8fd0b5caa181",
                                        "entry_id": "04df6a6c-e599-3793-941f-8371a272cef6",
                                        "glosses": [
                                            "The process of conveying something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bdfc4dc-5642-3b9c-b485-833c475c4c4f",
                                        "entry_id": "04df6a6c-e599-3793-941f-8371a272cef6",
                                        "glosses": [
                                            "The transmission of heat in a fluid by the circulation of currents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "062b2152-0123-4e20-8503-daf3f08e56c1",
                                                "sense_id": "0bdfc4dc-5642-3b9c-b485-833c475c4c4f",
                                                "text": "The mantle is important to our discussion in that its viscous nature can conduct convection currents that have effects on the crust upon which we live."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6caf033-1fc9-3278-abef-200235161cc6",
                                        "entry_id": "04df6a6c-e599-3793-941f-8371a272cef6",
                                        "glosses": [
                                            "The vertical movement of heat and moisture, especially by updrafts and downdrafts in an unstable air mass. The terms convection and thunderstorm are often used interchangeably, although thunderstorms are only one form of convection. Towering cumulus clouds are visible forms of convection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8300b74f-48f4-484e-a682-d075c86760a0",
                        "source_entry_id": "f7d55366-67db-3edd-b16f-001968a57546",
                        "source_sense_id": "902d0744-461e-363c-a877-960a0bf00f77",
                        "target_lang_word": "convection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ba9ef31-f6fd-31ef-8203-6fb2a5c4e567",
                                        "entry_id": "70565c24-36e0-395c-974c-25a4cf0d4324",
                                        "glosses": [
                                            "Mode de transfert des propriétés d'un fluide (température et chaleur ; composition chimique) par mouvement des particules de celui-ci, c'est-à-dire par déplacement global de matière (impliquant aussi, au niveau des surfaces d'échange, la diffusion)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d2b57c-5cd4-49f2-a964-5f2c310bdf51",
                                                "sense_id": "3ba9ef31-f6fd-31ef-8203-6fb2a5c4e567",
                                                "text": "En milieu naturel la convection correspond au cas général des transferts entre les surfaces (sol nu, végétation, surfaces d’eau...) et l’atmosphère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185f7030-489a-30c0-badf-ac5be0b39e9d",
                                        "entry_id": "70565c24-36e0-395c-974c-25a4cf0d4324",
                                        "glosses": [
                                            "Convection thermique, transfert thermique via ce mécanisme, par opposition aux deux autres modes que sont la conduction thermique et le rayonnement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19808886-b87e-4899-9387-99070e7c5ecc",
                                                "sense_id": "185f7030-489a-30c0-badf-ac5be0b39e9d",
                                                "text": "En provoquant des courants d’air, j’abaisse la température par convection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
