                "senses": [
                    {
                        "sense_id": "02dfee1f-18b2-307c-b23c-772032abdb98",
                        "entry_id": "48c31342-f30f-3274-bb1f-08419b739b29",
                        "glosses": [
                            "Verlaniser à nouveau, créer le verlan d’un mot déjà en verlan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab39c82a-5487-4f30-9807-b0e211ad3d49",
                                "sense_id": "02dfee1f-18b2-307c-b23c-772032abdb98",
                                "text": "Et pour simplifier le tout, on peut aussi reverlaniser un mot."
                            },
                            {
                                "example_id": "8311d3cb-10a0-4b96-9e47-4c246d32a7ea",
                                "sense_id": "02dfee1f-18b2-307c-b23c-772032abdb98",
                                "text": "Lorsqu’un mot en verlan devient communément utilisé et perd son aura de rebelle, on peut le “reverlaniser”."
                            },
                            {
                                "example_id": "40a47e4c-3339-46fd-bc8a-f74e7e93b1b8",
                                "sense_id": "02dfee1f-18b2-307c-b23c-772032abdb98",
                                "text": "Il faut donc le ré-encoder, le «reverlaniser» pour être le plus méconnaissable que possible des «bourgeois» ou de la police."
                            }
                        ]
                    }
                ],
