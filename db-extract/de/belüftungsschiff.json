                "senses": [
                    {
                        "sense_id": "c72ab400-0889-3aab-9678-f605441eee49",
                        "entry_id": "55694230-9d33-3b6f-93c1-e96b178a8e55",
                        "glosses": [
                            "spezielles Wasserfahrzeug, das dem jeweiligen Gewässer durch Belüftung Sauerstoff zuführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5316a23-0d9e-46cc-9dce-dd2175419000",
                                "sense_id": "c72ab400-0889-3aab-9678-f605441eee49",
                                "text": "„Das Belüftungsschiff ist eines von zahlreichen und unabdingbar notwendigen Instrumenten zur Schadensabwendung bei den aquatischen Ökosystemen der Berliner Gewässer 1. Ordnung.“"
                            },
                            {
                                "example_id": "886d40c5-aed3-47ab-bfc4-954d1ace5b45",
                                "sense_id": "c72ab400-0889-3aab-9678-f605441eee49",
                                "text": "„Das Belüftungsschiff patrouilliert von Anfang Mai bis Ende September hauptsächlich auf Landwehr- und Neuköllner Schifffahrtskanal.“"
                            },
                            {
                                "example_id": "c53e3c45-dcf0-4d4f-943f-a99a72e98002",
                                "sense_id": "c72ab400-0889-3aab-9678-f605441eee49",
                                "text": "„Wie oft und aus welchen Gründen kam es in 2012 und bis dato in 2013 zum Einsatz des Belüftungsschiffes „Rudolf Kloos“?“"
                            },
                            {
                                "example_id": "f77b8e42-9a31-4931-a158-ce32f10d9e17",
                                "sense_id": "c72ab400-0889-3aab-9678-f605441eee49",
                                "text": "„Zur Interpretation von Sauerstoffmesswerten müssen alle Informationen über Sauerstoffstützungsmaßnahmen (z.B. Belüftung durch Wehrüberfälle oder Belüftungsschiffe) berücksichtigt werden.“"
                            },
                            {
                                "example_id": "668135a2-199f-4f2c-92ff-38e12a582449",
                                "sense_id": "c72ab400-0889-3aab-9678-f605441eee49",
                                "text": "„Diese sind, sofort über die bei der Messfahrt angetroffenen Verhältnisse im Bilde und können so z.B. zeitnah über den Einsatz des Belüftungsschiffes entscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
