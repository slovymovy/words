                "senses": [
                    {
                        "sense_id": "6ed66e60-621c-37fc-9300-fd3758cd907a",
                        "entry_id": "fc346cb7-9027-3f38-842c-c4b77d706106",
                        "glosses": [
                            "der Nachmittag eines Montages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f39352b-9e6d-47ab-befe-4983fcf6285d",
                                "sense_id": "6ed66e60-621c-37fc-9300-fd3758cd907a",
                                "text": "Diese Woche haben wir den Montagnachmittag dazu genutzt, endlich mal die Schränke in unserem Büro auszumisten."
                            },
                            {
                                "example_id": "eda55ce4-e96d-4a39-944c-cf01e1f9e3dd",
                                "sense_id": "6ed66e60-621c-37fc-9300-fd3758cd907a",
                                "text": "Die Besprechung an den Montagnachmittagen entwickelt sich mehr und mehr zu einem nutzlosen Ritual."
                            },
                            {
                                "example_id": "67693d22-84ab-4c35-add1-742f23fa2611",
                                "sense_id": "6ed66e60-621c-37fc-9300-fd3758cd907a",
                                "text": "Am späten Montagnachmittag soll das Wetter allmählich freundlicher werden."
                            },
                            {
                                "example_id": "d795c5fa-f699-405e-ae8e-a00597ba3626",
                                "sense_id": "6ed66e60-621c-37fc-9300-fd3758cd907a",
                                "text": "„Eine französische Mörsergranate aus dem Zweiten Weltkrieg hat am Montagnachmittag, Polizei und Feuerwehr in Atem gehalten.“"
                            },
                            {
                                "example_id": "916341f7-c8e5-4dae-96f5-45beb415387f",
                                "sense_id": "6ed66e60-621c-37fc-9300-fd3758cd907a",
                                "text": "„Der Ölpreis hat am frühen Montagnachmittag etwas schwächer gegenüber dem Vortag tendiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
