                "senses": [
                    {
                        "sense_id": "033f39dd-3c54-38ea-ad4b-dc2a1433f232",
                        "entry_id": "beab4020-3794-3e56-948e-64951de9b7b2",
                        "glosses": [
                            "Donner un caractère ventriloque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f23cb0f-34a5-4660-b990-b37189d4b5a5",
                                "sense_id": "033f39dd-3c54-38ea-ad4b-dc2a1433f232",
                                "text": "La voix du courlieu, douce et triste, semble une note sortie d’une flûte; la grande bécassine ventriloquise son chant en volant d’une façon désordonnée au-dessus de son nid."
                            },
                            {
                                "example_id": "3e220041-7ccf-48f7-aeee-b13b09e1a8e3",
                                "sense_id": "033f39dd-3c54-38ea-ad4b-dc2a1433f232",
                                "text": "Si dans son analyse le critique en disséquant pose alors une leçon d’anatomie, nous aimerions d’autant plus volontiers la dépeindre ici dans sa version heideggerianisante, que celle-ci ventriloquise les textes de Trakl afin d’y lire des textes dont la teneur idéologique est pour le moins suspecte."
                            }
                        ]
                    }
                ],
