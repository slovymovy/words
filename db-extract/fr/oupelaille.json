                                    }
                                ]
                            },
                            {
                                "target_word": "ooh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b69de8b-23f1-340b-aa3e-77fb45ad6a75",
                                        "entry_id": "c8a9f81c-9c4c-33da-9d35-9dbacbbf445b",
                                        "glosses": [
                                            "An exclamation of ooh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ef8bda-d610-4211-a9e4-ee8332e25fb9",
                                                "sense_id": "1b69de8b-23f1-340b-aa3e-77fb45ad6a75",
                                                "text": "The most underrated component in building a custom gun is the metalsmithing. Stock work immediately attracts attention. Fancy checkering patterns, meticulously executed, are sure to elicit oohs and ahhs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
