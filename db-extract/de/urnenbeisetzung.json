                "senses": [
                    {
                        "sense_id": "9f41809d-8f49-35cf-bb9d-6a66bc7c7351",
                        "entry_id": "cf92680f-74c3-304d-b6e7-3da12fe6e1c5",
                        "glosses": [
                            "an die Feuerbestattung anschließende Zeremonie, bei der die mit den eingeäscherten Überresten der/des Verstorbenen befüllten Urne in einem Grab oder einem Kolumbarium (Urnenhalle) beigesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "609dad0d-5e14-4026-8557-fa70865ea065",
                                "sense_id": "9f41809d-8f49-35cf-bb9d-6a66bc7c7351",
                                "text": "„Er verhandelt mit Irmgard, mit der Behörde, mit dem Pfarrer und erreicht, daß die Urnenbeisetzung bis in den April verschoben wird.“"
                            },
                            {
                                "example_id": "78a1d4cb-1661-49a1-87e3-8cff42cb4fbb",
                                "sense_id": "9f41809d-8f49-35cf-bb9d-6a66bc7c7351",
                                "text": "„So werden z.B. mit so genannten ‚Urnenkirchen‘ oder ‚Grabeskirchen‘ einzelne Kirchen, die nicht mehr als Gottesdienstorte aufrecht erhalten werden können, alternativ zur Urnenbeisetzung genutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
