    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85597589-d7a3-3f31-ae26-8853be4eb0f5",
                    "sense_definition": "Ne pas tenir compte de quelqu'un ou de quelque chose ; faire comme si cela n'existait pas.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>ignoré</w> tous mes messages depuis lundi."
                        },
                        {
                            "text": "Le gouvernement <w>ignore</w> les demandes des habitants du quartier."
                        },
                        {
                            "text": "Elle <w>ignorait</w> les critiques et continuait tranquillement son travail."
                        }
                    ],
                    "synonyms": [
                        "négliger",
                        "dédaigner"
                    ],
                    "common_phrases": [
                        "ignorer les avertissements",
                        "ignorer une demande",
                        "ignorer complètement quelqu'un"
                    ]
                },
                {
                    "sense_id": "ec80e2b0-2c7a-332d-9c1c-b841ddb13b01",
                    "sense_definition": "Ne pas savoir, ne pas connaître quelque chose ; être sans information à ce sujet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "méconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>ignore</w> pourquoi il est parti si tôt ce matin."
                        },
                        {
                            "text": "Beaucoup de gens <w>ignorent</w> les règles de ce jeu."
                        },
                        {
                            "text": "Elle <w>ignorait</w> que son frère était déjà arrivé à la gare."
                        }
                    ],
                    "antonyms": [
                        "savoir",
                        "connaître"
                    ],
                    "common_phrases": [
                        "ignorer la réponse",
                        "ignorer l'existence de",
                        "ignorer les règles"
                    ]
                },
                {
                    "sense_id": "cf8885ac-d87d-36e9-a913-ed4b8772b2cb",
                    "sense_definition": "Au pronominal : ne pas avoir une juste idée de soi-même, de ses forces ou de ses qualités.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "méconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune pianiste s'<w>ignore</w> encore et n'ose pas jouer en public."
                        },
                        {
                            "text": "Elle s'<w>ignorait</w> complètement et sous-estimait son propre talent."
                        }
                    ],
                    "common_phrases": [
                        "un talent qui s'ignore",
                        "un génie qui s'ignore"
                    ]
                },
                {
                    "sense_id": "c4b70b22-58ee-3f87-b209-c5e81e1fdbdf",
                    "sense_definition": "Ne pas pratiquer une chose, ne pas en avoir l'habitude ou le goût.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>ignore</w> l'art de la flatterie et dit toujours ce qu'il pense."
                        },
                        {
                            "text": "Cet homme sincère <w>ignore</w> les ruses de la politique, par principe."
                        }
                    ],
                    "common_phrases": [
                        "ignorer l'art de"
                    ]
                }
            ]
        }
