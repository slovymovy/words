                "senses": [
                    {
                        "sense_id": "0f406d8d-5b7c-30c8-8bb3-a20ae2ae6031",
                        "entry_id": "20cfc2df-dbdf-3cbf-a16e-99f18468cadb",
                        "glosses": [
                            "Anstalt, in die Straffällige und gefährdete Jugendliche eingeliefert werden, die sich bessern sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8f09bf-b593-40e5-a43c-edd3accd5dc2",
                                "sense_id": "0f406d8d-5b7c-30c8-8bb3-a20ae2ae6031",
                                "text": "In seiner Jugend wurde er in eine Besserungsanstalt eingewiesen, weil er mehrmals beim Klauen erwischt wurde."
                            },
                            {
                                "example_id": "24cc81ab-dcfc-474e-935d-1a8b6d4c6e99",
                                "sense_id": "0f406d8d-5b7c-30c8-8bb3-a20ae2ae6031",
                                "text": "„Auf Cockatoo Island gab es eine Sträflingskolonie, ein Gefängnis, eine Besserungsanstalt, Handwerks- und Religionsschule für Mädchen und die zwei größten Schiffswerften Australiens.“"
                            },
                            {
                                "example_id": "9bd2f43f-8828-4bc6-86cf-6ffdd37caa1b",
                                "sense_id": "0f406d8d-5b7c-30c8-8bb3-a20ae2ae6031",
                                "text": "„Ein Zuchthaus wurde ursprünglich nicht als Strafanstalt sondern als Erziehungs- und Besserungsanstalt gesehen.“"
                            },
                            {
                                "example_id": "d0eab1ea-374f-4ba6-b599-2bc2baf6b4fc",
                                "sense_id": "0f406d8d-5b7c-30c8-8bb3-a20ae2ae6031",
                                "text": "„Am nächsten Tag brachte man sie nach Aachen, in die städtische Besserungsanstalt für Mädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
