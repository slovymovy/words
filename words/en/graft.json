    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54271265-a50d-3f3e-b752-b4cd7640d9ff",
                    "sense_definition": "hard work or labor requiring significant effort",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to put in a lot of hard <w>graft</w> to get the job done before the deadline.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось приложить немало <w>усилий</w>, чтобы закончить работу к сроку."
                            }
                        },
                        {
                            "text": "Success in this industry is rarely about luck; it is mostly about years of consistent <w>graft</w>.",
                            "target_lang_translations": {
                                "ru": "Успех в этой индустрии редко зависит от удачи; в основном это годы постоянного <w>упорного труда</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hard graft"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тяжелая работа или труд, требующий значительных усилий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пахота",
                                "target_lang_sense_clarification": "тяжелый, изнурительный труд"
                            },
                            {
                                "target_lang_word": "вкалывание",
                                "target_lang_sense_clarification": "усердная работа"
                            },
                            {
                                "target_lang_word": "упорный труд",
                                "target_lang_sense_clarification": "интенсивная деятельность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a61c2b09-c298-3d1b-b24d-f83c0b0d3f85",
                    "sense_definition": "the use of political or official power for personal or illicit financial gain",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation uncovered widespread <w>graft</w> and bribery within the city council.",
                            "target_lang_translations": {
                                "ru": "Расследование выявило повсеместное <w>взяточничество</w> и коррупцию в городском совете."
                            }
                        },
                        {
                            "text": "He was accused of using political <w>graft</w> to secure lucrative government contracts for his friends.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в использовании политической <w>коррупции</w> для получения выгодных государственных контрактов для своих друзей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political graft"
                    ],
                    "target_lang_definitions": {
                        "ru": "использование политической или официальной власти для личной или незаконной финансовой выгоды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взяточничество",
                                "target_lang_sense_clarification": "получение взяток должностным лицом"
                            },
                            {
                                "target_lang_word": "коррупция",
                                "target_lang_sense_clarification": "злоупотребление служебным положением"
                            },
                            {
                                "target_lang_word": "подкуп",
                                "target_lang_sense_clarification": "склонение к нарушению долга за вознаграждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba27484f-bf4b-3b7e-be06-ffa627fae18c",
                    "sense_definition": "a living shoot or scion of a plant joined to another plant to grow together",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener carefully prepared the <w>graft</w> to ensure it would bond with the apple tree.",
                            "target_lang_translations": {
                                "ru": "Садовник тщательно подготовил <w>привой</w>, чтобы он прижился на яблоне."
                            }
                        },
                        {
                            "text": "If the <w>graft</w> is successful, the tree will produce a different variety of fruit.",
                            "target_lang_translations": {
                                "ru": "Если <w>прививка</w> пройдет успешно, дерево будет давать плоды другого сорта."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "живой побег или черенок растения, соединенный с другим растением для совместного роста"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привой",
                                "target_lang_sense_clarification": "часть растения, которую прививают"
                            },
                            {
                                "target_lang_word": "черенок",
                                "target_lang_sense_clarification": "часть стебля для размножения или прививки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56dc2288-2a54-309d-a02e-2044317bc35f",
                    "sense_definition": "a piece of living tissue that is transplanted surgically to replace or repair damaged tissue",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon performed a skin <w>graft</w> to treat the severe burns on the patient's arm.",
                            "target_lang_translations": {
                                "ru": "Хирург провел <w>пересадку</w> кожи для лечения тяжелых ожогов на руке пациента."
                            }
                        },
                        {
                            "text": "Doctors are monitoring the patient closely to ensure the body does not reject the <w>graft</w>.",
                            "target_lang_translations": {
                                "ru": "Врачи внимательно наблюдают за пациентом, чтобы убедиться, что организм не отторгнет <w>трансплантат</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skin graft",
                        "bone graft"
                    ],
                    "target_lang_definitions": {
                        "ru": "кусок живой ткани, который пересаживается хирургическим путем для замены или восстановления поврежденной ткани"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трансплантат",
                                "target_lang_sense_clarification": "участок ткани или орган для пересадки"
                            },
                            {
                                "target_lang_word": "лоскут",
                                "target_lang_sense_clarification": "часть кожи или ткани для пластики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b2d16a0-ee4f-39e6-8873-8599bafbd306",
                    "sense_definition": "the depth of the blade of a digging tool, used as a measure of depth",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They dug down one <w>graft</w> into the soil before hitting the rocky layer.",
                            "target_lang_translations": {
                                "ru": "Они прокопали вглубь на один <w>штык лопаты</w>, прежде чем наткнулись на каменистый слой."
                            }
                        },
                        {
                            "text": "The trench needs to be at least a spade's <w>graft</w> deep for the drainage pipe.",
                            "target_lang_translations": {
                                "ru": "Траншея для дренажной трубы должна быть глубиной как минимум в один <w>штык</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spade's graft"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used in regional digging contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "глубина лезвия копательного инструмента, используемая как мера глубины"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штык лопаты",
                                "target_lang_sense_clarification": "глубина погружения лопаты в землю"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
