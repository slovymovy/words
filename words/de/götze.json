    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7aa48ce6-204d-386c-b27b-68801beb1574",
                    "sense_definition": "Heidnischer oder falscher Gott aus Sicht monotheistischer Religionen; im übertragenen Sinne auch eine Person oder Sache, die blind verehrt wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religioes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den alten Schriften wurde das Volk gewarnt, fremde <w>Götzen</w> anzubeten."
                        },
                        {
                            "text": "Für viele Menschen ist das Geld heutzutage zu einem mächtigen <w>Götzen</w> geworden."
                        }
                    ],
                    "synonyms": [
                        "Abgott",
                        "Idol"
                    ],
                    "antonyms": [
                        "Gott",
                        "Herr"
                    ],
                    "common_phrases": [
                        "fremde Götzen anbeten",
                        "dem Götzen dienen"
                    ]
                },
                {
                    "sense_id": "64a06779-2533-3897-a61a-d0f7a75eba79",
                    "sense_definition": "Körperliche Darstellung, Standbild oder Gegenstand, der als heidnische Gottheit verehrt wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religioes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Eroberer zerstörten jeden hölzernen <w>Götzen</w>, den sie im Heiligtum vorfanden."
                        },
                        {
                            "text": "Vor dem uralten <w>Götzen</w> aus Stein wurden damals reiche Opfergaben niedergelegt."
                        }
                    ],
                    "synonyms": [
                        "Götterbild",
                        "Fetisch",
                        "Totem"
                    ],
                    "common_phrases": [
                        "einen Götzen stürzen"
                    ]
                },
                {
                    "sense_id": "6d225363-ea8b-3ca4-ac6a-3cf84fb014c4",
                    "sense_definition": "Maske, Schreckgestalt oder fratzenhaftes Scheinbild.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abwertend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hinter den bunten Masken verbargen sich die furchterregenden <w>Götzen</w> der Fastnacht."
                        },
                        {
                            "text": "Der Prediger wetterte gegen die finsteren <w>Götzen</w> und Larven der Heuchler."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historische Wortbedeutung"
                        }
                    ]
                },
                {
                    "sense_id": "d45cad20-0c9b-33ee-87a9-4f713ef7e270",
                    "sense_definition": "Törichter, einfältiger Mensch oder Narr.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abwertend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "„Du alter <w>Götze</w>!“, schimpfte der Bauer, als der Knecht den Karren umwarf."
                        },
                        {
                            "text": "Der alte Dichter beschimpfte den unbelehrbaren Gecken als albernen <w>Götzen</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "heute nicht mehr gebräuchlich"
                        }
                    ]
                }
            ]
        },
