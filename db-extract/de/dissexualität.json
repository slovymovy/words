                "senses": [
                    {
                        "sense_id": "a4e507a9-d07d-3dd2-87ad-476c1bec5797",
                        "entry_id": "d73e930e-05b7-3ba5-a987-9cbf3f91d4f3",
                        "glosses": [
                            "sozial dysfunktionales Sexualverhalten, das zur Beeinträchtigung Dritter durch nicht konsensuelle Übergriffe führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2684a394-7e23-4e0d-a882-989d807e8a0d",
                                "sense_id": "a4e507a9-d07d-3dd2-87ad-476c1bec5797",
                                "text": "Exhibitionisten, die sich vor nicht eingeweihten Personen entblößen erfüllen die Kriterien von Dissexualität."
                            },
                            {
                                "example_id": "dbfdb67a-9ea6-4f1a-bd7c-ebc055fc4687",
                                "sense_id": "a4e507a9-d07d-3dd2-87ad-476c1bec5797",
                                "text": "„Ihre Dissexualität ist somit Teil einer Dissozialität. Es finden sich bei diesen Personen auch Eigentums- und andere, nicht-sexuelle Aggressionsdelikte.“"
                            },
                            {
                                "example_id": "f3a49a1f-b083-477b-aadd-dd9c21f61e22",
                                "sense_id": "a4e507a9-d07d-3dd2-87ad-476c1bec5797",
                                "text": "„Dissexualität inkludiert alle Handlungen des sexuellen Übergriffes, bei dem die Integrität und Individualität eines anderen Menschen direkt verletzt wird, oder darüber hinaus, keine Zustimmung vom Opfer erwartet werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
