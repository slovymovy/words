                "senses": [
                    {
                        "sense_id": "7ce83cf6-b3af-362f-a977-d4e661d8a0f7",
                        "entry_id": "b3c816b7-76e8-3578-89da-92198b011365",
                        "glosses": [
                            "Gesamtheit der Güter, die in der französischen Revolution aus Kirchenbesitz in öffentlichen Besitz überführt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb69f49-4ba1-41e9-910c-e4a144e2f682",
                                "sense_id": "7ce83cf6-b3af-362f-a977-d4e661d8a0f7",
                                "text": "„Der gesamte Kirchenbesitz wurde kurzerhand zu französischem Nationalgut erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "766823ec-a8ba-33b3-be76-c9124669752a",
                        "entry_id": "b3c816b7-76e8-3578-89da-92198b011365",
                        "glosses": [
                            "ideeller oder tatsächlicher öffentlicher Besitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018d73d5-692e-4b74-9efd-bb9e78261204",
                                "sense_id": "766823ec-a8ba-33b3-be76-c9124669752a",
                                "text": "„[…] ja ein im Jahre 1498 zu Frankfurt gegebenes Passionsspiel hat nicht weniger als zweihundertfünfundsechzig Personen. Wie volksmäßig aber diese Stücke geworden, bezeugt schon der Umstand, daß sie, gleich dem alten Epos, nicht aufgeschrieben wurden, sondern als Nationalgut traditionell von Geschlecht zu Geschlecht sich forterbten.“"
                            },
                            {
                                "example_id": "3a427682-536d-4a64-a3b1-41c8b600fa0c",
                                "sense_id": "766823ec-a8ba-33b3-be76-c9124669752a",
                                "text": "„An einer genauen Klärung der Eigentumsrechte der riesigen Nationalgüter war unter den politischen und wirtschaftlichen Wirren kaum zu denken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
