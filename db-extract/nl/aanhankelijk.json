                                        "sense_id": "19376608-33ec-3fc9-a454-0e292267aabc",
                                        "entry_id": "973dd8fc-701d-30ac-b63e-15a303750de8",
                                        "glosses": [
                                            "Having affection or warm regard; loving; fond."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85bc0d14-f297-479b-8655-aeee89dd6daa",
                                                "sense_id": "19376608-33ec-3fc9-a454-0e292267aabc",
                                                "text": "She eulogised her always warm and affectionate brother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c7b67e-18d2-3bb0-a8c2-ed5f017d64a8",
                                        "entry_id": "973dd8fc-701d-30ac-b63e-15a303750de8",
                                        "glosses": [
                                            "Characterised by or proceeding from affection; indicating love; tender."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397c15c5-5cf5-407e-a15f-472944e0f152",
                                                "sense_id": "52c7b67e-18d2-3bb0-a8c2-ed5f017d64a8",
                                                "text": "the affectionate care of a parent; an affectionate countenance; an affectionate message; affectionate language"
                                            },
                                            {
                                                "example_id": "58d4a9b1-718d-4d55-bf10-ed1c22eccd6b",
                                                "sense_id": "52c7b67e-18d2-3bb0-a8c2-ed5f017d64a8",
                                                "text": "Warwick left the undertaker's shop and retraced his steps until he had passed the lawyer's office, toward which he threw an affectionate glance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c32035-dde0-3f7c-a2c6-4fea90628ad1",
                                        "entry_id": "973dd8fc-701d-30ac-b63e-15a303750de8",
                                        "glosses": [
                                            "Eager; passionate; strongly inclined toward something."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "affectionate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d602706d-ed0f-3408-a3cc-0a61f11fe3db",
                                        "entry_id": "480d01ae-941f-3645-8a99-2417a215396a",
                                        "glosses": [
                                            "To show affection to; to have affection for."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3baba70-df2a-30d0-a3f2-1ec970b6858f",
                                        "entry_id": "480d01ae-941f-3645-8a99-2417a215396a",
                                        "glosses": [
                                            "To emotionally attach (oneself) to."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92b14de-8e3d-4c9e-8ec9-e95948938ceb",
                                                "sense_id": "c3baba70-df2a-30d0-a3f2-1ec970b6858f",
                                                "text": "Plutarch saith fitly of those who affectionate themselves to Monkies and little Dogges, that […]."
                                            },
                                            {
                                                "example_id": "39668f92-d103-4738-bcff-8ed98ad74c78",
                                                "sense_id": "c3baba70-df2a-30d0-a3f2-1ec970b6858f",
                                                "text": "And firſt, his Majeſty would have you to underſtand, That there was never any King more loving to his People, or better affectionated to the right uſe of Parliaments, than his Majeſty hath approved himſelf to be,[…]."
                                            },
                                            {
                                                "example_id": "86a2c2f9-a5e3-415c-a701-c3a7e69ce0d8",
                                                "sense_id": "c3baba70-df2a-30d0-a3f2-1ec970b6858f",
                                                "text": "1838 February 1, Charles Dickens, To Catherine Dickens, 2012, Jenny Hartley (editor), The Selected Letters of Charles Dickens, page 41,\nEver my dear Kate your affectionated husband\nCHARLES DICKENS"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
