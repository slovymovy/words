                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982b5cba-9be4-47d9-b7ce-7dd5cf9859d7",
                                "sense_id": "f804475e-0ae5-3fa4-9d84-fb32221cb38c",
                                "text": ", 30 sierpnia 2022, wyborcza.pl.."
