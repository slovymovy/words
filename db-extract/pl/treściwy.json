                    },
                    {
                        "sense_id": "f5c2cba1-c644-3ff3-b71c-754c1ea62731",
                        "entry_id": "ddd42a15-c1d5-3426-8ed9-88b0651ddea5",
                        "glosses": [
                            "wysławiający się zwięźle"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "30eb1fee-4d36-3de1-9bbc-1a6a40a469f0",
                        "entry_id": "ddd42a15-c1d5-3426-8ed9-88b0651ddea5",
                        "glosses": [
                            "dostarczający niezbędnych składników odżywczych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a29c4a-2785-4eee-ae86-17a9e5c52e60",
                                "sense_id": "30eb1fee-4d36-3de1-9bbc-1a6a40a469f0",
                                "text": "Ziarno zbóż służy jako produkt konsumpcyjny dla człowieka i jako znakomita pasza treściwa w chowie zwierząt gospodarskich"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bba9e84-e5aa-4b26-bf99-c7bea89c6917",
                        "source_entry_id": "ddd42a15-c1d5-3426-8ed9-88b0651ddea5",
                        "source_sense_id": "f499a496-33d3-33e3-9168-63a4ae05a71b",
                        "target_lang_word": "contentful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contentful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20e70c53-e203-3172-864e-08d2a00f5054",
                                        "entry_id": "6bce0582-4c44-38db-8fde-9fbbbe809e28",
                                        "glosses": [
                                            "Having content."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fcea759-b628-49cf-9726-5b8e9997010a",
                                                "sense_id": "20e70c53-e203-3172-864e-08d2a00f5054",
                                                "text": "In answer to this question I want to propose that to is in fact always contentful—that it is never mere Case marking, strictly speaking—but that in certain contexts (namely, in V's headed by Dative-Shifting verbs) its grammatical contribution effectively \"reduces\" to Case marking and therefore can be suppressed under Passive."
                                            },
                                            {
                                                "example_id": "74576c31-004d-45d0-8a6f-c5f82edddfe3",
                                                "sense_id": "20e70c53-e203-3172-864e-08d2a00f5054",
                                                "text": "Indeed, it seems to me that the special character of non-conceptually contentful perceptual states entails that all perceptual states contain non-conceptual content in this essentially distinct sense[…]."
                                            },
                                            {
                                                "example_id": "d4622e25-f3b9-46da-bc85-84251cd7ebe8",
                                                "sense_id": "20e70c53-e203-3172-864e-08d2a00f5054",
                                                "text": "Can one have contentful but non-conceptual thought? My guess is that we can and I take it that my guess is buttressed by our ordinary practice of talking about the behaviour of animals and pre-linguistic children."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contentful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98b3c97b-f662-369b-9266-b12df075b444",
                                        "entry_id": "5fd4087e-ff90-3bfc-9f2a-2ee9c85d4a73",
                                        "glosses": [
                                            "Full of contentment."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4310e0b6-5605-47be-b69b-931294e587fb",
                                                "sense_id": "98b3c97b-f662-369b-9266-b12df075b444",
                                                "text": "How contentful the whole life is of him, that neither deviseth mischief against others, nor suspects any to be contrived against himself."
                                            },
                                            {
                                                "example_id": "6733102c-7eec-4f30-afbe-21c0c7269a65",
                                                "sense_id": "98b3c97b-f662-369b-9266-b12df075b444",
                                                "text": "With the setting sun sending long shadows loping ahead of them over the smooth hillocks of the downs, they came up with the lagoon; a contentful return home, with appetite brisked up by a ten-mile walk, and plenty of food to satisfy it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
