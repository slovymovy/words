                        ],
                        "examples": [
                            {
                                "example_id": "6f8f01de-bd7e-4889-be0e-b97e0db083d9",
                                "sense_id": "ae5f757d-b04e-3234-86e8-72ca549d7dde",
                                "text": "La Sainte Vierge avec des mots tout blancs priée,\nDes mots d'une blancheur transparente de gemmes, —\nLa fleur céleste si neigeusement candide,\nLe lys nimbé de rayons stellaires."
                            },
                            {
                                "example_id": "812a3f0f-e2a1-453c-8175-2fdcfb71bda5",
                                "sense_id": "ae5f757d-b04e-3234-86e8-72ca549d7dde",
                                "text": "C'est Miss Campton qui exulte, parce qu'on vient de lui accrocher sur la poitrine un ruban rouge et une médaille, témoignage du Prix d'honneur que vient de remporter son Sealyhan, un terrier aussi neigeusement blanc que sa maîtresse est idéalement blonde."
                            }
                        ]
                    }
