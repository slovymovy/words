                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a44ca8a-3c81-3e3a-85f3-059f0978d8a1",
                        "entry_id": "4facbf05-7988-373c-953f-d19e3e497fb4",
                        "glosses": [
                            "uit model, slordig, kreukelig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c3bb398-a68f-4dbe-a954-faba299a4edc",
                                "sense_id": "2a44ca8a-3c81-3e3a-85f3-059f0978d8a1",
                                "text": "Ik breng de nacht door in de woonwagen van Bruyninckx, die wat verderop logeert bij een vriendin. Als ik om half acht ’s ochtends mijn verfomfaaide kop buiten steek, komt hij net terug van de bakker. Met zijn zwarte snor, dito krullen en rood-witte pet ziet hij eruit als Super Mario."
                            },
                            {
                                "example_id": "8c589c65-dd7b-4e38-a395-415bfce204fb",
                                "sense_id": "2a44ca8a-3c81-3e3a-85f3-059f0978d8a1",
                                "text": "De acteur werd begin januari dit jaar in Londen gespot door paparazzi-fotografen en hij zag er volgens de Britse tabloid DailyMail uit als een verfomfaaide zwerver. Recent dook hij op in de talk[s]how van Graham Norton. Daar maakte hij volgens kijkers een verfomfaaide en verwarde indruk. \"Het lijkt wel of hij een beroerte gehad heeft\", twitterde iemand tijde[ns] de uitzending."
                            }
                        ]
                    }
