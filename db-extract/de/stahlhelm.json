                    },
                    {
                        "form_id": "8f927529-f3d3-4b1e-950c-5aef3a4ae0ec",
                        "entry_id": "c6b8d298-424f-33cc-9222-4429c4bceb20",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Stahlhelm"
                    },
                    {
                        "form_id": "25adebb7-c7f9-488f-8a80-b8488c1cbe3f",
                        "entry_id": "c6b8d298-424f-33cc-9222-4429c4bceb20",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Stahlhelme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc6bf1dd-c72b-3423-887e-24add4960918",
                        "entry_id": "c6b8d298-424f-33cc-9222-4429c4bceb20",
                        "glosses": [
                            "aus Stahl hergestellter Schutzhelm für Soldaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c36253-8bcd-41e8-90a2-e1d17104b19a",
                                "sense_id": "fc6bf1dd-c72b-3423-887e-24add4960918",
                                "text": "„Gallagher hörte Hennesseys Stahlhelm in den Sand rollen.“"
                            },
                            {
                                "example_id": "98755874-bc31-40af-b70b-64300defde22",
                                "sense_id": "fc6bf1dd-c72b-3423-887e-24add4960918",
                                "text": "Vor dem Verlassen des Unterstands setzte der Soldat seinen Stahlhelm auf."
                            },
                            {
                                "example_id": "c73189f6-f285-42a7-9343-a168d4a2191b",
                                "sense_id": "fc6bf1dd-c72b-3423-887e-24add4960918",
                                "text": "„Die stoppeligen Gesichter unter den Stahlhelmen sind schmal und ausgehöhlt von Hunger und Not, ausgemergelt und zusammengeschmolzen zu den Linien, die Grauen, Tapferkeit und Tod zeichnen.“"
                            },
                            {
                                "example_id": "0da09707-e648-4082-9050-ba69d2f5880d",
                                "sense_id": "fc6bf1dd-c72b-3423-887e-24add4960918",
                                "text": "„Da klappte er zusammen wie ein Taschenmesser, der Stahlhelm kollerte noch ein Stück vor ihm hin.“"
                            },
                            {
                                "example_id": "ddbcc384-62a7-4c15-8b65-432401d029db",
                                "sense_id": "fc6bf1dd-c72b-3423-887e-24add4960918",
                                "text": "„Fabian kam im Stahlhelm und war ganz dick von Mänteln, Ledertaschen, Seitengewehr, Dolch, Pistole und Gasmaske.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf0c445a-e901-3e67-b8a8-2d12b64933f4",
                        "entry_id": "c6b8d298-424f-33cc-9222-4429c4bceb20",
                        "glosses": [
                            "Wehrverband zur Zeit der Weimarer Republik"
                        ],
                        "tags": [
                            "historical",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0d76a344-3d64-4567-919b-53597902afc6",
                                "sense_id": "bf0c445a-e901-3e67-b8a8-2d12b64933f4",
                                "text": "„Politisch agierte der Stahlhelm für eine Entmachtung des Parlaments und eine Stärkung von Reichspräsident Hindenburg mit diktatorischen Vollmachten, wodurch die Monarchie wieder etabliert werden sollte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
