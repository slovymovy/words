                                "target_senses": [
                                    {
                                        "sense_id": "a20321f7-bdda-3353-940f-82d777705366",
                                        "entry_id": "75899da6-550c-3b0d-9067-8f22f1af5097",
                                        "glosses": [
                                            "die Zahl 10¹⁵, also eine Eins mit 15 Nullen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810fa9c5-cf99-4dfd-8f10-8946db873f6b",
                                                "sense_id": "a20321f7-bdda-3353-940f-82d777705366",
                                                "text": "Eine Billiarde sind tausend Billionen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96fc533f-72a3-47a2-8e25-597ef0f8b506",
                        "source_entry_id": "5ea9539e-d1e6-3f7f-b237-1e57718331d8",
                        "source_sense_id": "29225e7a-0e91-3510-942f-f9667f949d9f",
                        "target_lang_word": "quadrillion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96f2c73f-12da-3cb9-8bf1-d0559dc90626",
                                        "entry_id": "9d5ff98d-a1a9-3395-b37b-843465ef36f9",
                                        "glosses": [
                                            "A thousand trillion (logic: 1,000 × 1,000⁴): 1 followed by fifteen zeros, 10¹⁵."
                                        ],
                                        "tags": [
                                            "Australian",
                                            "British",
                                            "US",
                                            "modern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d0462d2-3779-4bcf-a1be-2542e141bbf3",
                                                "sense_id": "96f2c73f-12da-3cb9-8bf1-d0559dc90626",
                                                "text": "A man named Chris Reynolds was credited $92 quadrillion USD on his paypal account, \"This unexpected influx of wealth elevated him to the status of the richest person on the planet and the only quadrillionaire to have ever existed\". Following this, after the man reported this error and it was fixed, \"PayPal owned up to their mistake and thanked the richest man of all time for understanding the situation, saying: 'This is obviously an error and we appreciate that Mr. Reynolds understood this was the case'\"."
                                            },
                                            {
                                                "example_id": "1e353b19-7240-4dbe-9e3d-1ffceadce5e5",
                                                "sense_id": "96f2c73f-12da-3cb9-8bf1-d0559dc90626",
                                                "text": "“I’m not sure I understand why we have to send a quadrillion-credit mission to another galaxy.”\nHe looked fleetingly amused. “Quintillion... and we don’t have a choice, Harper. Any of us, really, but humanity especially.”"
                                            },
                                            {
                                                "example_id": "f25f877f-75a1-4bc3-8aa3-3baffc0ec4b0",
                                                "sense_id": "96f2c73f-12da-3cb9-8bf1-d0559dc90626",
                                                "text": "Integrating data from all continents and major biomes, we conservatively estimate 20 × 10¹⁵ (20 quadrillion) ants on Earth, with a total biomass of 12 megatons of dry carbon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d833798c-ecd2-31f8-9e1f-db88549aa4f9",
                                        "entry_id": "9d5ff98d-a1a9-3395-b37b-843465ef36f9",
                                        "glosses": [
                                            "A million trillion (logic: 1,000,000⁴): 1 followed by twenty-four zeros, 10²⁴."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1da9c66-df04-3654-9758-9d58ca63ed46",
                                        "entry_id": "bde9aae8-89ee-3645-9bd3-2750b5f3496e",
                                        "glosses": [
                                            "Any very large number, exceeding normal description."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84e87296-1cc8-4080-8b33-3fe825f03707",
                                                "sense_id": "e1da9c66-df04-3654-9758-9d58ca63ed46",
                                                "text": "They'd never understand — not in a quadrillion years."
                                            },
                                            {
                                                "example_id": "9707cd39-6c05-446f-a192-be2800488ee4",
                                                "sense_id": "e1da9c66-df04-3654-9758-9d58ca63ed46",
                                                "text": "Me, I never refuse a meal, and believe me I seen some heavy weather. I musta flown a quadrillion miles and I never did have a problem."
                                            },
                                            {
                                                "example_id": "33c4f97a-d7fd-4aa8-8317-7986ddc847a8",
                                                "sense_id": "e1da9c66-df04-3654-9758-9d58ca63ed46",
                                                "text": "The sky is so absolutely clear with a quadrillion stars."
                                            },
                                            {
                                                "example_id": "8080aa60-6855-47d3-93a7-11fd53a235ca",
                                                "sense_id": "e1da9c66-df04-3654-9758-9d58ca63ed46",
                                                "text": "She's named after this famous singer from a quadrillion years ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c1685fd-7761-4c7e-96e5-0ee369fdb788",
                        "source_entry_id": "5ea9539e-d1e6-3f7f-b237-1e57718331d8",
