                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2515744-14cb-30bd-8f12-a7ed755d1330",
                        "entry_id": "f5ae102b-0409-3015-8037-b49078f8d6d8",
                        "glosses": [
                            "Raum, in dem das aktive häusliche Leben stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe8e2ee-ed6e-4947-b032-eeeab6fe0ec5",
                                "sense_id": "a2515744-14cb-30bd-8f12-a7ed755d1330",
                                "text": "„Lachen und Liebe erfüllten die Wohnstube meiner Kindheit.“"
                            },
                            {
                                "example_id": "e94d46f9-5aaf-4a73-ab64-0bea0dc4c8ad",
                                "sense_id": "a2515744-14cb-30bd-8f12-a7ed755d1330",
                                "text": "„Die Wände waren trocken, weil der Backofen in der Wohnstube die Zimmer mitheizte.“"
                            },
                            {
                                "example_id": "ec695d2b-5c71-467a-adf4-2d5fde92eb77",
                                "sense_id": "a2515744-14cb-30bd-8f12-a7ed755d1330",
                                "text": "„Sie hängte das Bild über die kleine Anrichte in der Wohnstube und hoffte das Beste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1290a0f8-1d5c-442e-aeac-0f2eb7435593",
                        "source_entry_id": "f5ae102b-0409-3015-8037-b49078f8d6d8",
                        "source_sense_id": "a2515744-14cb-30bd-8f12-a7ed755d1330",
                        "source_sense_description": "Raum, in dem das aktive häusliche Leben stattfindet",
                        "target_lang_word": "salon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9ba483-254e-3df2-8e91-e37255e55e1b",
                                        "entry_id": "d17c80cf-b189-38cc-86a9-10264f974918",
                                        "glosses": [
                                            "Pièce, dans un appartement, dans une maison, qui est ordinairement plus grande et plus ornée que les autres, et qui sert à recevoir les visites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fefe412a-8bd0-4e3d-a13a-ed028abbb08e",
                                                "sense_id": "fd9ba483-254e-3df2-8e91-e37255e55e1b",
                                                "text": "Quelle diversité dans mes journées ! La classe de Louis-le-Grand, les palabres de l’œuf à la coque, ma cellule communiste du quai de Javel, le tennis d’Auteuil, le salon de Tante Reine, la bibliothèque de l’Oncle…"
                                            },
                                            {
                                                "example_id": "71a555a0-a428-41fd-9386-cdaa45697f32",
                                                "sense_id": "fd9ba483-254e-3df2-8e91-e37255e55e1b",
                                                "text": "De jour, le corridor était dans la pénombre et c'est presque à tâtons qu'on trouvait la clinche du salon d'attente."
                                            },
                                            {
                                                "example_id": "c3e77e30-b0ff-40fe-baed-2ceae3c324ae",
                                                "sense_id": "fd9ba483-254e-3df2-8e91-e37255e55e1b",
                                                "text": "Salon de musique."
                                            },
                                            {
                                                "example_id": "639ee942-c9c6-407c-9e44-f40d1b113fa8",
                                                "sense_id": "fd9ba483-254e-3df2-8e91-e37255e55e1b",
                                                "text": "J’imagine que cette pièce avait l’aspect mi-chapelle, mi-chambre d’amour qu’eurent si souvent les salons de musique de l’époque, avec leurs vitraux et leurs divans couverts de tapis turcs. Peut-être même y brûlait-on l’encens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0703a3bc-30f9-34ef-8449-127622f6bbf3",
                                        "entry_id": "d17c80cf-b189-38cc-86a9-10264f974918",
                                        "glosses": [
                                            "La bonne compagnie ; les gens du monde."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cfdda83-5d8d-46a9-b318-3b398945e030",
                                                "sense_id": "0703a3bc-30f9-34ef-8449-127622f6bbf3",
                                                "text": "Depuis le mois de janvier, en effet, la bonne société de Lausanne se pressait dans les salons du poëte, qu'elle encourageait et récompensait par ses bravos, […]."
                                            },
                                            {
                                                "example_id": "23823fe8-590a-4a9f-a335-c321448c2656",
                                                "sense_id": "0703a3bc-30f9-34ef-8449-127622f6bbf3",
                                                "text": "Une presse complaisante jusqu’à la servilité répandait dans le public, depuis les salons jusqu’aux mansardes, les idées les plus fausses et les plus dangereuses."
                                            },
                                            {
                                                "example_id": "1790f8e8-352d-4ad0-9e6a-ca89bb738846",
                                                "sense_id": "0703a3bc-30f9-34ef-8449-127622f6bbf3",
                                                "text": "[…] ; le jour où ils ont suffisamment pénétré dans les sanctuaires de l’État, dans les salons, dans les lieux de plaisir, ils cessent généralement d’être révolutionnaires et parlent savamment de l’évolution."
                                            },
                                            {
                                                "example_id": "b11c88a9-2ae9-4629-9a81-21893e11d965",
                                                "sense_id": "0703a3bc-30f9-34ef-8449-127622f6bbf3",
                                                "text": "Je ne sais si vous avez à *** d'aussi bons catholiques que nous en avons à Paris. Le fait est que les salons ne sont plus tenables. Non-seulement les anciens dévots sont devenus aigres comme verjus, mais tous les ex-voltairiens de l'opposition politique se sont faits papistes."
                                            },
                                            {
                                                "example_id": "2de1960b-37d9-4974-82cb-54d17f086a79",
                                                "sense_id": "0703a3bc-30f9-34ef-8449-127622f6bbf3",
                                                "text": "Le mot même de salon a quelque chose qui me déprime et m’assombrit."
                                            },
                                            {
                                                "example_id": "466b9fa8-8ad5-4037-84b9-56c91df0992c",
                                                "sense_id": "0703a3bc-30f9-34ef-8449-127622f6bbf3",
                                                "text": "Ainsi la télévision publique est-elle un thème de débat, une posture obligée, une rhétorique de salon qui mériterait de figurer dans les mythologies des couches cultivées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c4e1b1c-f63f-3338-8cb5-d0af37fe0ef3",
                                        "entry_id": "d17c80cf-b189-38cc-86a9-10264f974918",
                                        "glosses": [
                                            "Lieu où se fait l’exposition annuelle des ouvrages de peinture, sculpture, gravure, etc., des artistes vivants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e0048cc-f218-4f7d-8efe-f58c7af1a906",
                                                "sense_id": "0c4e1b1c-f63f-3338-8cb5-d0af37fe0ef3",
                                                "text": "Il a exposé ce tableau au dernier salon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5afde2cb-86cc-3af5-b47f-67bc3372d6ca",
                                        "entry_id": "d17c80cf-b189-38cc-86a9-10264f974918",
                                        "glosses": [
                                            "Cette exposition elle-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "645f61f7-3426-46b4-bf1a-3e664b62c519",
                                                "sense_id": "5afde2cb-86cc-3af5-b47f-67bc3372d6ca",
                                                "text": "L’ouverture, la clôture du salon."
                                            },
                                            {
                                                "example_id": "f260db61-3321-4a62-973c-8070f11da6a7",
                                                "sense_id": "5afde2cb-86cc-3af5-b47f-67bc3372d6ca",
                                                "text": "Il a exposé ce tableau au dernier salon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e04fd9-283f-3a9c-abc5-5d98087d8905",
                                        "entry_id": "d17c80cf-b189-38cc-86a9-10264f974918",
                                        "glosses": [
                                            "Les comptes-rendus de l’exposition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9022b968-d8a1-4c68-a16a-7f7e451aee94",
                                                "sense_id": "d2e04fd9-283f-3a9c-abc5-5d98087d8905",
                                                "text": "Les salons de Diderot."
                                            },
                                            {
                                                "example_id": "9322aa0d-ce95-4391-8ce7-9fd878b41a33",
                                                "sense_id": "d2e04fd9-283f-3a9c-abc5-5d98087d8905",
                                                "text": "Ce critique fait le salon dans tel journal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4053d683-3af3-398d-8e45-82a6a8b9dbb7",
                                        "entry_id": "d17c80cf-b189-38cc-86a9-10264f974918",
                                        "glosses": [
                                            "Toutes sortes d’expositions périodiques, ordinairement annuelles."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e74149f-7489-4d2b-aab1-8b18108836e3",
                                                "sense_id": "4053d683-3af3-398d-8e45-82a6a8b9dbb7",
                                                "text": "Les grands festivals annuels en Bretagne constituent les vitrines de promotion de toute cette culture populaire : le FIL de Lorient, la Cornouaille de Quimper, la Lune de Landerneau, les Étonnants voyageurs de Saint-Malo, les (nouvelles) Vieilles charrues de Carhaix et son salon du livre breton, également en plein développement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7763d6f6-1eeb-36a9-b64c-a8fd5b943078",
                                        "entry_id": "d17c80cf-b189-38cc-86a9-10264f974918",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d630459-f3b7-49c4-af6f-f2ee82184465",
                                                "sense_id": "7763d6f6-1eeb-36a9-b64c-a8fd5b943078",
                                                "text": "Il y a dans les promenades aux environs du Mont-Dore des endroits qu’on appelle des salons, ce sont des groupes d’arbres, des quinconces sous l’ombrage desquels les baigneurs vont passer quelques heures en plein air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "598ef364-0091-4a72-a096-7cd086bddfda",
                        "source_entry_id": "f5ae102b-0409-3015-8037-b49078f8d6d8",
                        "source_sense_id": "a2515744-14cb-30bd-8f12-a7ed755d1330",
                        "source_sense_description": "Raum, in dem das aktive häusliche Leben stattfindet",
                        "target_lang_word": "salle de séjour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salle de séjour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ffc8def-3858-3505-99f7-ed62a61f7615",
                                        "entry_id": "817dd21a-dd70-3c02-bdf7-634cd02c9c41",
                                        "glosses": [
                                            "Pièce d’une habitation, consacrée généralement aux loisirs (télévision, lecture…) et aux relations sociales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05992a71-424c-4ead-8e10-5bd7e1f812b8",
                                                "sense_id": "3ffc8def-3858-3505-99f7-ed62a61f7615",
                                                "text": "Je t’assure, Suzanne, ils feront très bien dans ta salle de séjour, ces fauteuils et ce canapé, bon il est un peu cra-cra, mais tu le recouvres d’un drap fleuri et te voilà vraiment chez toi !"
                                            },
                                            {
                                                "example_id": "a7063a3f-9125-4773-b92e-02bfc645ff13",
                                                "sense_id": "3ffc8def-3858-3505-99f7-ed62a61f7615",
                                                "text": "Mollement enfoncé dans un fauteuil relaxe de la salle de séjour de son appartement privé, un verre de whisky à portée de la main, Jacques Dubois-Rimbert laissait paresseusement errer son regard sur les toiles de maîtres qui ornaient les murs aux teintes beige rosé de la pièce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
