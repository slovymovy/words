                ],
                "translations": [
                    {
                        "translation_id": "437e4ffe-c75c-4a9f-844f-d006be4d5562",
                        "source_entry_id": "0db44324-37e7-3de8-8b5d-4e1a8426c4a8",
                        "source_sense_id": "1c5b9e02-7435-3048-a3bb-358a796be4a7",
                        "source_sense_description": "een glas bier van welk formaat ook",
                        "target_lang_word": "Krug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                        "entry_id": "786c9497-2d79-34ff-8c62-04d8b81436f1",
                                        "glosses": [
                                            "zylindrisches Gefäß für Getränke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f31e798-72b5-4919-ad15-31a87689bbc1",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "Er holt einen Krug Most aus dem Keller."
                                            },
                                            {
                                                "example_id": "2cf4b080-b1de-41de-aec6-09fc844f8af6",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„Ein sympathisch wirkender Mann begrüßte sie in verständlichem Deutsch und reichte ihnen einen Krug mit Quellwasser.“"
                                            },
                                            {
                                                "example_id": "96ed7d59-24a9-427d-ba40-9aa14ab565d8",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„In Room 33 häuften sich Schüsseln und Krüge, Türkis- und Muschelperlen, Papageien, Flöten und Zeremionialstäbe.“"
                                            },
                                            {
                                                "example_id": "380bb1a4-1254-4650-9fe4-116116bea596",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„Darob hatte der Branntweinschmuggler Erbarmen mit dem Manne, er gab seinem Herzen einen Ruck, lud ihn in eine Scheune, woselbst er ihm einen Krug mit Branntwein bot und mit seinem Sackmesser ein Stück Haifischfleisch abschnitt.“"
                                            },
                                            {
                                                "example_id": "fd92e747-fb34-4d2b-aca6-5b7f9a840bce",
                                                "sense_id": "dc46bc70-433a-34dc-972e-2dd38512f7cf",
                                                "text": "„Ein kleines Mädchen, das barfuß in Holzpantinen lief und dessen Körper man durch das zerlumpte Kleidchen hindurch sehen konnte, brachte den Frauen zu trinken und goß ihnen Apfelmost aus einem Krug ein, den es gegen die Hüfte stützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                        "entry_id": "786c9497-2d79-34ff-8c62-04d8b81436f1",
                                        "glosses": [
                                            "ländliche Gaststätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce39d21-e3a9-478f-9ae8-9b9318b3d24e",
                                                "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                                "text": "Sie saßen die ganze Nacht im Krug."
                                            },
                                            {
                                                "example_id": "0025bca6-46c5-4dcb-9362-c207c1596497",
                                                "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                                "text": "„Eine Stunde später fuhr der Gendarm aus Krusenhagen an dem neuen Kruge vorüber, und bald darauf hörte Lemke, daß der Gendarm in Begleitung des Försters bei Kordes Haussuchung gehalten und den Bock beschlagnahmt hätte.“"
                                            },
                                            {
                                                "example_id": "d3d5e542-9b01-46dd-b84b-2787263811d3",
                                                "sense_id": "9bc093d2-e267-3052-97bf-5c820725846f",
                                                "text": "„An eben dieser Stelle findet sich denn auch die ganze Herrlichkeit von Dorf Stechlin zusammen; das Pfarrhaus, die Schule, das Schulzenamt, der Krug, dieser letztere zugleich ein Eck- und Kramladen mit einem kleinen Mohren und einer Guirlande von Schwefelfäden in seinem Schaufenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
