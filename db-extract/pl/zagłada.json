                        "cross_references": []
                    },
                    {
                        "translation_id": "257db9f9-dbe9-4d39-923f-d3d27f573872",
                        "source_entry_id": "9b300f95-9c6f-36c7-9e3f-8ecafab7b70c",
                        "source_sense_id": "9341f4de-8982-3bf9-9080-ed740c3f7a4e",
                        "target_lang_word": "гибель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гибель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2d334ae9-4048-3df5-842c-3b8f21f928d1",
                                        "entry_id": "037161ed-158c-3568-8566-b46b622cbfca",
                                        "glosses": [
                                            "прекращение существования (жизни) из-за неблагоприятных или трагических обстоятельств, преждевременная или насильственная смерть от какой-нибудь катастрофы, стихийного бедствия, насилия, несчастного случая и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94dbb9c-37e7-4a5d-8e12-b961af6fab2f",
                                                "sense_id": "2d334ae9-4048-3df5-842c-3b8f21f928d1",
                                                "text": "А царь тем ядом напитал // Свои послушливые стрелы // И с ними гибель разослал // К соседям в чуждые пределы."
                                            },
                                            {
                                                "example_id": "8eb01d2b-a1fe-4e86-9602-3e6bbe94e833",
                                                "sense_id": "2d334ae9-4048-3df5-842c-3b8f21f928d1",
                                                "text": "Я был глубоко потрясён трагической гибелью Пушкина, дорогой Павел, хотя эта новость была сообщена мне очаровательной женщиной."
                                            },
                                            {
                                                "example_id": "c1ccc5d9-91b4-4eca-a93a-c350d4d8dc2d",
                                                "sense_id": "2d334ae9-4048-3df5-842c-3b8f21f928d1",
                                                "text": "Зови, как хочешь, смерть — уничтожением, гибелью, покоем, тлением, сном — она всё равно поглотит свои жертвы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48d8c372-6c3e-37d5-9d52-1defe7c8ddf4",
                                        "entry_id": "037161ed-158c-3568-8566-b46b622cbfca",
                                        "glosses": [
                                            "перен. разг. полная неудача"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962a5334-65f9-4156-a611-098c59f68dfd",
                                                "sense_id": "48d8c372-6c3e-37d5-9d52-1defe7c8ddf4",
                                                "text": "В високосный год существует один лишний день, называемый в народе Касьяновым днём, и в этот день Касьян куда ни посмотрит — там будет гибель."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f8af0fd-7a94-36d1-bb71-d7ed8a996c45",
                                        "entry_id": "037161ed-158c-3568-8566-b46b622cbfca",
                                        "glosses": [
                                            "устар., прост. большое количество"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e428cc8-7149-4e5f-8622-2811e2d93516",
                                                "sense_id": "3f8af0fd-7a94-36d1-bb71-d7ed8a996c45",
                                                "text": "На что бы, казалось, нужна была Плюшкину такая гибель подобных изделий? во всю жизнь не пришлось бы их употребить даже на два таких имения, какие были у него, — но ему и этого казалось мало."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
