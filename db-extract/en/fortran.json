                        ],
                        "examples": [
                            {
                                "example_id": "a688cbc1-733b-42ea-9a6a-530fe4119880",
                                "sense_id": "f94b5736-deaf-38a2-9dfd-6c15ff21a26c",
                                "text": "The brothers wrote the machine’s application software in FORTRAN, a programming language that is “a dinosaur from the late fifties,” Gregory said, adding, “There is always new life in this dinosaur.”"
                            }
