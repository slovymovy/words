                        "ru": "Стильно или броско одеться (обычно с 'up').",
                        "zh": "打扮得时髦或华丽（通常后接 up）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырядиться",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "принарядиться",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
