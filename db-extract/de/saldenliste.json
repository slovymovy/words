                                        "sense_id": "baad9ecc-d5ce-3b07-ac3f-bbdb89e98e44",
                                        "entry_id": "1d99375d-fb2a-337d-be24-a066e2434c9a",
                                        "glosses": [
                                            "To contract, as a sail, into a narrower compass."
                                        ],
                                        "tags": [],
                                        "examples": [
