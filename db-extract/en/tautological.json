                    {
                        "translation_id": "321b5468-1176-4b9c-84b3-ac875dba5ceb",
                        "source_entry_id": "e0039b9e-6dd0-37fa-adf7-6bbf67f86ef4",
                        "source_sense_description": "of, relating to, or using tautology",
                        "target_lang_word": "redundant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redundant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c471d54c-7e1e-35af-a315-705c9f36e7b2",
                                        "entry_id": "b2a91816-b823-39fc-bdb0-450a14eed810",
                                        "glosses": [
                                            "mehrfach vorhanden, wiederholt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb37ecc9-d23b-4678-97e3-df6af8aef643",
                                                "sense_id": "c471d54c-7e1e-35af-a315-705c9f36e7b2",
                                                "text": "In jeder sprachlichen Äußerung gibt es redundante Erscheinungen, die zur Sicherung der Kommunikation wichtig sind. In der Linguistik gelten redundante Informationen nicht als überflüssig."
                                            },
                                            {
                                                "example_id": "ffb95ece-3ae2-4837-b41a-0eb38a607d6f",
                                                "sense_id": "c471d54c-7e1e-35af-a315-705c9f36e7b2",
                                                "text": "„Was ihm an diesen Orten des Schreckens widerfährt, wird in siebenundvierzig Kapiteln bis ins redundanteste Detail protokolliert, und zwar mit einem Realismus, der so konsequent an der Oberfläche bleibt, wie man es von Jugendbüchern der unbedarfteren Sorte kennt.“"
                                            },
                                            {
                                                "example_id": "4ffe5dbf-a2d3-460b-8565-901cfc5be4aa",
                                                "sense_id": "c471d54c-7e1e-35af-a315-705c9f36e7b2",
                                                "text": "„Geschriebene Sprache kann einerseits weniger redundant sein, weil ein schriftlich festgehaltener Satz beliebig oft betrachtet werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2428dc9b-4347-3fe5-b779-342817f6edbb",
                                        "entry_id": "b2a91816-b823-39fc-bdb0-450a14eed810",
                                        "glosses": [
                                            "die Eigenschaft des genetischen Codes, dass bei der Translation dieselbe Aminosäure durch mehr als nur eine Basentriplettkombination hergestellt werden kann, besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753b79e1-614a-42e0-9984-828d91f23c00",
                                                "sense_id": "2428dc9b-4347-3fe5-b779-342817f6edbb",
                                                "text": "Die Aminosäure Cystein kann sowohl durch das Basentriplett UGU, als auch durch das Codon UGC translatiert werden. Daher heißt der genetische Code redundant."
                                            },
                                            {
                                                "example_id": "b5876ada-5c73-40be-a5d6-643a93c19bb6",
                                                "sense_id": "2428dc9b-4347-3fe5-b779-342817f6edbb",
                                                "text": "„Wie in Kapitel 2 erläutert, ist der genetische Code insofern redundant, als mehrere Codons die gleiche Aminosäure codieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
