                "senses": [
                    {
                        "sense_id": "06f7d6ff-b702-3895-87c9-6242652a2844",
                        "entry_id": "423f95e5-a9d7-3d87-a231-662c36cb3747",
                        "glosses": [
                            "Resultat, Beschreibung zu einem Geruchsstoff; Effekt auf den Geruchssinn und die Reaktion darauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c9d8b2-7555-4347-a575-1bdc7893c010",
                                "sense_id": "06f7d6ff-b702-3895-87c9-6242652a2844",
                                "text": "„Die hedonische Geruchswirkung ist nicht mit der Geruchsqualität zu verwechseln.“"
                            },
                            {
                                "example_id": "2fd2e35c-c373-4184-967d-071e4f218581",
                                "sense_id": "06f7d6ff-b702-3895-87c9-6242652a2844",
                                "text": "„Die Richtlinie \"Bestimmung der hedonischen Geruchswirkung - Polaritätenprofile\" ist ab Oktober 2008 beim Beuth Verlag in Berlin erhältlich.“"
                            },
                            {
                                "example_id": "984e3c9d-a32a-42ee-b634-cab57157067d",
                                "sense_id": "06f7d6ff-b702-3895-87c9-6242652a2844",
                                "text": "„Letztere fangen die Fäkalien im Wasser auf und reduzieren die Geruchswirkung – jedermanns Sache sind sie aber nicht.“"
                            },
                            {
                                "example_id": "b8e637f4-c7f6-4718-8381-347871210b44",
                                "sense_id": "06f7d6ff-b702-3895-87c9-6242652a2844",
                                "text": "„Außerdem können sich die Komponenten überlagern oder gegenseitig beeinflussen, so dass die Geruchswirkung unter Umständen aufgehoben oder verstärkt wird.“"
                            },
                            {
                                "example_id": "0532333e-9980-454a-994b-4abeef7a2bc8",
                                "sense_id": "06f7d6ff-b702-3895-87c9-6242652a2844",
                                "text": "„Die Besonderheit der Geruchswirkung besteht darin, dass sie für gewöhnlich durch ein Gemisch von gasförmigen Substanzen hervorgerufen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
