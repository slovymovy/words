                            {
                                "example_id": "e2dc21f0-186a-41e1-b40a-ec53571c7425",
                                "sense_id": "e0a9b5ce-2ae9-3fcf-aefe-a1d12d48dc31",
                                "text": "„Der Oberbefehl über die rote Garde wird dem Kommunisten Eglhofer übertragen.“"
                            },
                            {
                                "example_id": "5335693e-0b61-43a0-b92c-52c9bad578ad",
                                "sense_id": "e0a9b5ce-2ae9-3fcf-aefe-a1d12d48dc31",
                                "text": "„In Petersburg traf Fürst Andrej seinen alten, ihm immer noh wohlgeneigten Vorgesetzen Kutusow, und Kutusow schlug ihm vor, mit ihm zusammen zur Moldauarmee zu gehen, deren Oberbefehl dem alten General übertragen worden war.“"
                            }
                        ],
