                "senses": [
                    {
                        "sense_id": "161eea0c-2d92-3b55-b105-00630f5c1cab",
                        "entry_id": "6209414e-fc87-3997-90fe-8050ddbe9a71",
                        "glosses": [
                            "ruhig fließen"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "10191fc6-e204-4587-8f63-0f13a39691f1",
                                "sense_id": "161eea0c-2d92-3b55-b105-00630f5c1cab",
                                "text": "Es ist beruhigen zuzuschauen, wenn der Bach so friedlich dahinplätschert."
                            },
                            {
                                "example_id": "e52acb98-a9cd-4636-b47b-3a81726e8481",
                                "sense_id": "161eea0c-2d92-3b55-b105-00630f5c1cab",
                                "text": "Die gesättigte Hochzeitsgesellschaft zog sich in den Schatten zurück, wo einige dösten und andere lauschten, wie ein leise geführtes Gespräch dahinplätscherte."
                            },
                            {
                                "example_id": "2a6ce176-531f-45e5-99b0-d30d58eeb838",
                                "sense_id": "161eea0c-2d92-3b55-b105-00630f5c1cab",
                                "text": "Die Ehe plätscherte nach einigen Jahren nur noch so dahin."
                            }
                        ],
                        "sense_index_json": "\"1\""
