                        "glosses": [
                            "Gesundheitsstörung, die durch Änderungen des Umgebungsdrucks und dessen Auswirkungen auf luft- oder gasgefüllte Hohlräume und deren Hüllen bei Lebewesen einschließlich des Menschen verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e75893a-1505-4e2c-9757-ca7f417db399",
                                "sense_id": "0824aea8-674b-30ba-b9ff-9b3e933600b6",
                                "text": "„Das Barotrauma ist wahrscheinlich die häufigste Verletzungsursache im Tauchsport.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
