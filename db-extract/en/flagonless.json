                        "glosses": [
                            "Without a flagon or, by extension, anything alcoholic to drink."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f102f8-52ee-4ec9-a05b-30f5e4428fdc",
                                "sense_id": "2d0ad7cf-de04-3246-bfd8-9cc788fb2773",
                                "text": "Wifeless, friendless, flagonless, alone, Not quite bookless, though, unless I choose ; Left with naught to do, except to groan, Not a soul to woo, except the Muse."
                            },
                            {
                                "example_id": "d7626887-02f6-4919-b310-b872ad37b86c",
                                "sense_id": "2d0ad7cf-de04-3246-bfd8-9cc788fb2773",
                                "text": "The cellar flagonless. The cupboard was only crusts."
                            },
                            {
                                "example_id": "b9d6be9b-3641-4909-bdda-a19b83a43c1f",
                                "sense_id": "2d0ad7cf-de04-3246-bfd8-9cc788fb2773",
                                "text": "She was looking longingly out of the window where Pedro the Penniless had joined Ignatius and his guitar at the flagonless table."
                            }
                        ]
                    }
