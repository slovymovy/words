                    "sense_id": "1909da51-7284-3945-aa9e-f56b01229e58",
                    "sense_definition": "Kleiner Geldbetrag, der freiwillig als Anerkennung für eine Dienstleistung zusätzlich zum regulären Preis bezahlt wird.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "Dienstleistung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der freundliche Kellner erhielt am Ende des Abends ein großzügiges <w>Trinkgeld</w>."
                        },
                        {
                            "text": "In vielen Ländern ist es üblich, dem Taxifahrer etwas <w>Trinkgeld</w> zu geben."
                        }
                    ],
                    "synonyms": [
                        "Bakschisch"
                    ],
                    "common_phrases": [
