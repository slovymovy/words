                "senses": [
                    {
                        "sense_id": "5ce88956-b9d9-3187-9fc0-a51497523a2d",
                        "entry_id": "8ea1ea38-044a-38cc-9171-0df562882f1f",
                        "glosses": [
                            "apparaat dat rekenkundige berekeningen kan uitvoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81bd35e2-6e58-4b06-a7fd-e6ee418be798",
                                "sense_id": "5ce88956-b9d9-3187-9fc0-a51497523a2d",
                                "text": "De batterijen van mijn rekenmachine zijn leeg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e306297e-af5a-4ef3-83ed-abe6fb570342",
                        "source_entry_id": "8ea1ea38-044a-38cc-9171-0df562882f1f",
                        "source_sense_id": "5ce88956-b9d9-3187-9fc0-a51497523a2d",
                        "source_sense_description": "apparaat dat rekenkundige berekeningen kan uitvoeren",
                        "target_lang_word": "Rechenmaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechenmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4f6daa0-14de-3e19-9a0e-0b92cbee1f4f",
                                        "entry_id": "07074bcd-a058-38cd-adc9-8909786853ef",
                                        "glosses": [
                                            "technisches Gerät zur Lösung von Rechenaufgaben; ursprünglich auf mechanischer oder elektromechanischer Basis, später ohne bewegliche Teile durch den Einsatz von Elektronik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7d4278-8515-4c6e-b505-73f9a24be563",
                                                "sense_id": "e4f6daa0-14de-3e19-9a0e-0b92cbee1f4f",
                                                "text": "„Durch die Verfügbarkeit von Rechenmaschinen entwickelte sich langsam auch ein Markt für numerische Berechnungen.“"
                                            },
                                            {
                                                "example_id": "8a0c3232-47b9-4184-9ed5-25db464dbb23",
                                                "sense_id": "e4f6daa0-14de-3e19-9a0e-0b92cbee1f4f",
                                                "text": "„Verstärker der beschrieben Art werden in vielfältigen Abwandlungen für datenverarbeitende Anlagen, insbesondere für Rechenmaschinen verwendet.“"
                                            },
                                            {
                                                "example_id": "4326d36e-0cdc-4fd2-b61d-2fe737f36d07",
                                                "sense_id": "e4f6daa0-14de-3e19-9a0e-0b92cbee1f4f",
                                                "text": "„In der Tüte lag ein langer dünner Gehaltsstreifen, auf den eine Rechenmaschine den Betrag und die einbehaltenen Steuern gedruckt hatte.“"
                                            },
                                            {
                                                "example_id": "f8b3454d-437b-437f-a825-1d845c538ee5",
                                                "sense_id": "e4f6daa0-14de-3e19-9a0e-0b92cbee1f4f",
                                                "text": "„Es ist zum Lachen, wenn Rechenmaschinen sich menschlich verhalten, wenn sie sich irren, wenn sie gar nicht rechnen können, wenn sie Zornesausbrüche und Flüche ausdrucken, weinen, wenn sie einfache Dinge ungeheuer komplizieren, wenn sie dämonisch werden oder sich gar verlieben, wenn das Übermenschliche allzumenschlich wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bef022cc-dfd0-4488-a5dc-5293d03567cf",
                        "source_entry_id": "8ea1ea38-044a-38cc-9171-0df562882f1f",
                        "source_sense_id": "5ce88956-b9d9-3187-9fc0-a51497523a2d",
                        "source_sense_description": "apparaat dat rekenkundige berekeningen kan uitvoeren",
                        "target_lang_word": "calculator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calculator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A mechanical or electronic device that performs mathematical calculations; sometimes, an electronic one specifically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a546999f-941c-49fa-83d4-5522f5c5a4f5",
                                                "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                                "text": "electronic calculator;   pocket calculator"
                                            },
                                            {
                                                "example_id": "25ce6f2e-3f51-4429-b8c5-cd40da3a451b",
                                                "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                                "text": "The calculator on a bookkeeper's desk in the 1950s was an adding machine with mechanical guts."
                                            },
                                            {
                                                "example_id": "527c5a98-f2d5-4944-8456-5e238d626b53",
                                                "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                                "text": "I told him to hand me a calculator and he jokingly placed an adding machine at my side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236d6694-1edd-39d6-8cdb-157de5894894",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A person who performs mathematical calculation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c983c95d-40b3-4af0-ad5a-7fade303e24a",
                                                "sense_id": "236d6694-1edd-39d6-8cdb-157de5894894",
                                                "text": "During the war, his grandmother had worked at the Bletchley Park decoding station as a calculator."
                                            },
                                            {
                                                "example_id": "03bb80d9-6947-426f-b1f8-601fdf4b8df6",
                                                "sense_id": "236d6694-1edd-39d6-8cdb-157de5894894",
                                                "text": "First, many real-world investors bear little resemblance to the cool calculators of efficient-market theory: they're all too subject to herd behavior, to bouts of irrational exuberance and unwarranted panic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A person who calculates (in the sense of scheming)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871b81b5-a2b4-4e58-8c1b-5f31d901ab23",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "Near-synonyms: schemer, plotter; manipulator"
                                            },
                                            {
                                                "example_id": "b43291fd-07fd-4dc3-8d60-169ca081edd5",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "He revealed himself to be a cold-blooded calculator out to sabotage his colleagues."
                                            },
                                            {
                                                "example_id": "4ca7a3be-05b4-4e33-9885-f846e54fa476",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "Talk not thus, I implore you, Evelyn: do not imagine me the worldly calculator that my enemies deem me."
                                            },
                                            {
                                                "example_id": "088e02c3-185e-418d-b63a-482e6c2c5da8",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "You have in the merchant the shrewd calculator of probable contingencies; we shall see that we have in the prophet the absolute proclaimer of necessary and inevitable facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d1bfed-3381-3bd0-91c4-794e00968229",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A set of mathematical tables."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2fbd73e-2ae6-4fa0-9827-6802838cbb00",
                        "source_entry_id": "8ea1ea38-044a-38cc-9171-0df562882f1f",
                        "source_sense_id": "5ce88956-b9d9-3187-9fc0-a51497523a2d",
                        "source_sense_description": "apparaat dat rekenkundige berekeningen kan uitvoeren",
                        "target_lang_word": "calculateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calculateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0074a408-455a-383e-b451-8d9029761acb",
                                        "entry_id": "b122dfe7-c398-3f28-b9fd-a16a89ee667f",
                                        "glosses": [
                                            "Qui calcule ; qui a pour habitude de prévoir et d’anticiper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de72bcd-82a2-415b-bd7a-6b15ae62108c",
                                                "sense_id": "0074a408-455a-383e-b451-8d9029761acb",
                                                "text": "Mais faites-moi l’honneur de croire que je suis assez calculateur pour toujours me donner la conscience nécessaire à mon état."
                                            },
                                            {
                                                "example_id": "0ee9d4b2-1b94-4990-967c-b713d1239ef0",
                                                "sense_id": "0074a408-455a-383e-b451-8d9029761acb",
                                                "text": "Il est clair que les gens de Meyreuil devenaient de plus en plus calculateurs et commençaient à élaborer des stratégies, ce qui était une triste nouveauté dans le village."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calculateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03834277-7b2d-348d-933f-b7b099e7d531",
                                        "entry_id": "00ef9929-76f0-35ad-8c5a-ada364e0d19f",
                                        "glosses": [
                                            "Homme qui s’occupe de calcul."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c31786b6-a8bf-417d-91a2-b3f608581b75",
                                                "sense_id": "03834277-7b2d-348d-933f-b7b099e7d531",
                                                "text": "Sous l’appellation unique de mécanographes, l’I.N.S.E.E. englobe dans sa nomenclature les diverses tâches qui relèvent de la technique mécanographique : calculateur, mécanographe, mécanographe sur cartes perforées, opérateur mécanographe, etc. C’est ce poste unique que nous avons dû conserver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e1af94e-ca78-3e97-9916-160774644f51",
                                        "entry_id": "00ef9929-76f0-35ad-8c5a-ada364e0d19f",
                                        "glosses": [
                                            "Homme qui calcule beaucoup pour arriver à ses fins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6a2448-e6e8-49b2-985f-c2e2810b9802",
                                                "sense_id": "5e1af94e-ca78-3e97-9916-160774644f51",
                                                "text": "Un paysan qui commence à sentir la nécessité de l’instruction, devient le plus souvent un calculateur féroce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70b55cf8-30ca-3c6f-915d-a23be1641835",
                                        "entry_id": "00ef9929-76f0-35ad-8c5a-ada364e0d19f",
                                        "glosses": [
                                            "Appareil électronique capable d’exécuter divers calculs sur commande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ef8098-5fa7-47c6-b988-38939252eb41",
                                                "sense_id": "70b55cf8-30ca-3c6f-915d-a23be1641835",
                                                "text": "La météo utilise des calculateurs pour calculer le temps à venir, à partir d’observation constatées."
                                            },
                                            {
                                                "example_id": "9127480b-1b85-4cc4-8a40-ef0cc3fa894e",
                                                "sense_id": "70b55cf8-30ca-3c6f-915d-a23be1641835",
                                                "text": "L’injection est contrôlée par un calculateur."
                                            },
                                            {
                                                "example_id": "b2dabf89-4d6e-428f-af83-5b85edbae80a",
                                                "sense_id": "70b55cf8-30ca-3c6f-915d-a23be1641835",
                                                "text": "Pourtant Concorde n’a pas de calculateurs numériques: de simples calculateurs analogiques, qui répliquent le fonctionnement que l’appareil aurait eu avec une timonerie de commandes « classique », mais dans tous les domaines de vol, car le comportement de Concorde n’était pas du tout le même en subsonique que en supersonique, étant naturellement instable sur ses 3 axes. Le maintien de la stabilité dans le domaine transonique était particulièrement important, à la fois pour le confort et la sécurité de l’avion tout court. (…) Pour l’A320, Airbus prend une décision risquée et très lourde de conséquences : l’avion sera piloté par des calculateurs, et ce sans aucun secours mécanique (contrairement à Concorde) … il n’y a donc plus droit à l’erreur !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
