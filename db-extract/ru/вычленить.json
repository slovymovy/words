                "translations": [
                    {
                        "translation_id": "f36cd547-f676-4185-8f36-3ec5928cff3d",
                        "source_entry_id": "eb78a88c-21c3-3a12-b058-88225b01fc85",
                        "source_sense_id": "aeea7f06-eb1e-325c-a72e-111f5e2478ab",
                        "target_lang_word": "isolate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isolate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55d7baf0-2113-3d34-af3d-220fed9d224f",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To set apart or cut off from others."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee280417-8acb-4b86-bd9f-3e954313b051",
                                                "sense_id": "55d7baf0-2113-3d34-af3d-220fed9d224f",
                                                "text": "By isolating these two main types of relation, hyponymy and incompatibility, we can characterize the relations between a large web of items."
                                            },
                                            {
                                                "example_id": "2e512b98-bab9-4cf7-8ab4-d53383287384",
                                                "sense_id": "55d7baf0-2113-3d34-af3d-220fed9d224f",
                                                "text": "Iran could not be happier. The more Israel sinks into the West Bank, the more it is delegitimized and isolated, the more the world focuses on Israel’s colonialism rather than Iran’s nuclear enrichment, the more people call for a single democratic state in all of historic Palestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937856de-da4f-3f8f-a69e-b5194b23490e",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To place in quarantine or isolation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b7e355f-d01f-3db6-ae29-bc928f79475e",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To separate a substance in pure form from a mixture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da086573-b832-4248-9a7b-9f4a14af1d63",
                                                "sense_id": "3b7e355f-d01f-3db6-ae29-bc928f79475e",
                                                "text": "To isolate the petroline the condensed oil is distilled again until fifty per cent. of oil has been obtained, and what is left in the still is petroline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb82f66e-49c0-3cfb-9a96-a8abc0521b89",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To insulate, or make free of external influence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b0e7920-79d8-4df8-ba99-f06b45419b82",
                                                "sense_id": "bb82f66e-49c0-3cfb-9a96-a8abc0521b89",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377109d9-16e4-3883-a8db-5b7c31cfd5e0",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To separate a pure strain of bacteria etc. from a mixed culture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56e263c7-2cae-3ad1-8725-df460975bc22",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To insulate an electrical component from a source of electricity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9e62b04-83a1-353a-b034-027120a370ed",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To self-isolate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "isolate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b767010-016d-357a-be48-bac6c36d0cb1",
                                        "entry_id": "7b02dbfd-e323-37e7-aed8-31f248ff763e",
                                        "glosses": [
                                            "Something that has been isolated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "524427b7-3d93-4209-a24b-92c4f3d90ae1",
                                                "sense_id": "3b767010-016d-357a-be48-bac6c36d0cb1",
                                                "text": "We used electropherotypes in order to differentiate the original parental strains or isolates from the finally tumor cell-adapted isolates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isolate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6cbfb0e-8cf0-3f7a-8bc7-73d566953c5c",
                                        "entry_id": "1a0baca9-7c55-31c8-9bf8-d69756306861",
                                        "glosses": [
                                            "isolated."
                                        ],
                                        "tags": [
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3056c37-62eb-4e20-9e53-e2861ff84202",
                                                "sense_id": "c6cbfb0e-8cf0-3f7a-8bc7-73d566953c5c",
                                                "text": "He said in his heart, the day his beard was shaven he was beaten, lost. He identified it with his isolate manhood."
                                            },
                                            {
                                                "example_id": "cf3e345e-3644-4ce5-ad5f-2e1b8eba0d6e",
                                                "sense_id": "c6cbfb0e-8cf0-3f7a-8bc7-73d566953c5c",
                                                "text": "Its snaky acid kiss.\nIt petrifies the will. These are the isolate, slow faults\nThat kill, that kill, that kill."
                                            },
                                            {
                                                "example_id": "ea75ef78-00bf-43a5-b588-ee43578076a2",
                                                "sense_id": "c6cbfb0e-8cf0-3f7a-8bc7-73d566953c5c",
                                                "text": "Narrow Yung-ch'ung streets quiet, / temple gardens all isolate mystery, / no one visits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00cfbe5f-5f33-4400-a19c-e879a7214da5",
