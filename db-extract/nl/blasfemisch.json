                ],
                "senses": [
                    {
                        "sense_id": "03d78d8e-0b30-38e6-ac35-00058722ed03",
                        "entry_id": "2b275cdb-a503-3bab-9dd4-75f9fbf7d704",
                        "glosses": [
                            "beledigend naar god of godsdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0826d8-d8d5-4d75-ac4c-b31099664640",
                                "sense_id": "03d78d8e-0b30-38e6-ac35-00058722ed03",
                                "text": "Ted Neeley auditeerde eigenlijk voor de Judas-rol. Als jongeman uit het diepgelovige Texas leek hem de titelrol in Jesus Christ Superstar nogal riskant. Blasfemisch, misschien zelfs. En omdat menigeen nu eenmaal zijn eigen Jezus-beeld koestert, zou de kritiek niet van de lucht zijn. Judas leek hem minder omstreden: „Want over hem heeft geen mens een scherpomlijnd idee, terwijl hij in de musical ook nog eens de beste nummers heeft.” Maar het ging anders. Neeley’s auditie verliep weliswaar goed, maar na afloop zei de regisseur tegen hem: „Ik wil je graag morgen terugzien. En dan wil ik dat je the other guy doet.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "38bca871-f6f8-3124-8c85-c0de6b8d765a",
                        "entry_id": "2b275cdb-a503-3bab-9dd4-75f9fbf7d704",
                        "glosses": [
                            "beledigend naar iets dat als heilig wordt beschouwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b825be9-82c1-4639-8f0f-f471f1f38752",
                                "sense_id": "38bca871-f6f8-3124-8c85-c0de6b8d765a",
                                "text": "De opstand in Boedapest in 1956 was een contrarevolutie. De blasfemische gedachte of het een terechte contrarevolutie was, was tegenwoordig een zuiver academische vraag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e092f48b-eba9-4239-ac12-aaa0317469e2",
                        "source_entry_id": "2b275cdb-a503-3bab-9dd4-75f9fbf7d704",
                        "source_sense_id": "03d78d8e-0b30-38e6-ac35-00058722ed03",
                        "source_sense_description": "beledigend naar god of godsdienst",
                        "target_lang_word": "blasphemous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blasphemous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3cdde23-8ff0-37f8-82e1-58f2ccccb318",
                                        "entry_id": "6968a234-12ad-337a-9d6e-e90817b6c949",
                                        "glosses": [
                                            "Lacking piety or respect for the sacred; resembling blasphemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "844aa070-0f9c-46cd-9603-5cb22a22abf1",
                                                "sense_id": "d3cdde23-8ff0-37f8-82e1-58f2ccccb318",
                                                "text": "His taking the name of God in vain was considered blasphemous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
