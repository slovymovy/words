                                "example_id": "954c1e9a-f625-4bee-bcb1-e4eaffeea0e4",
                                "sense_id": "852faef5-8bf2-3c3c-ac81-99db5f8557cb",
                                "text": "It fell without a struggle or a groan, unpitied and unregretted."
                            },
                            {
                                "example_id": "d89e03a1-35b5-402d-aaa5-de0742721ff6",
                                "sense_id": "852faef5-8bf2-3c3c-ac81-99db5f8557cb",
                                "text": "The old witch doctor and his son had disappeared, perhaps to try their skill with a neighbouring tribe, but the loss of his watch was unregretted by Connolly."
                            }
