{
    "word_family": [
        "получение",
        "получатель"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44fd2a85-2281-3d74-b906-4d598b9576d6",
                    "sense_definition": "Взять, принять что-либо вручаемое, присылаемое или выдаваемое (письмо, деньги, товар).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завтра я должен <получить> зарплату в кассе.",
                            "target_lang_translations": {
                                "en": "Tomorrow I have to <receive> my salary at the cashier's.",
                                "zh": "明天我得去财务室<领取>工资。"
                            }
                        },
                        {
                            "text": "Мы <получили> важное письмо от наших партнёров.",
                            "target_lang_translations": {
                                "en": "We <received> an important letter from our partners.",
                                "zh": "我们<收到>了合作伙伴发来的一封重要信件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "принять",
                        "забрать"
                    ],
                    "antonyms": [
                        "отправить",
                        "послать",
                        "передать"
                    ],
                    "common_phrases": [
                        "получить письмо",
                        "получить деньги",
                        "получить паспорт",
                        "получить посылку"
                    ],
                    "target_lang_definitions": {
                        "en": "To take or accept something that is sent, given, or paid to you.",
                        "zh": "指收到、领取或接纳别人送来、寄来或发放的东西（如信件、钱款、货物）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "receive",
                                "target_lang_sense_clarification": "formal or standard"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "common, informal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收到",
                                "target_lang_sense_clarification": "指收到信件或物品"
                            },
                            {
                                "target_lang_word": "领取",
                                "target_lang_sense_clarification": "指去特定地点拿取工资或物资"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ae145cb-d41d-3271-91da-960018e318d5",
                    "sense_definition": "Стать обладателем чего-либо предоставляемого, присуждаемого или наследуемого (награды, отпуска, подарка).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На день рождения она <получила> много подарков.",
                            "target_lang_translations": {
                                "en": "She <got> a lot of presents for her birthday.",
                                "zh": "生日那天她<得到>了许多礼物。"
                            }
                        },
                        {
                            "text": "Летом все сотрудники хотят <получить> отпуск.",
                            "target_lang_translations": {
                                "en": "In summer, all employees want to <get> a vacation.",
                                "zh": "夏天所有员工都想<获得>休假。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "получить подарок",
                        "получить приз",
                        "получить отпуск",
                        "получить наследство"
                    ],
                    "target_lang_definitions": {
                        "en": "To be given something such as a gift, award, or permission.",
                        "zh": "指获得被给予、被授予或继承的东西（如奖品、假期、礼物）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "general use"
                            },
                            {
                                "target_lang_word": "receive",
                                "target_lang_sense_clarification": "awards, official grants"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "得到",
                                "target_lang_sense_clarification": "通用词，指获得某物"
                            },
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "较正式，常用于奖项或荣誉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96130f03-ba03-3145-9706-555a9fbdab0a",
                    "sense_definition": "Приобрести нематериальный результат (образование, известность) или подвергнуться воздействию (травме, выговору).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат хочет <получить> высшее образование.",
                            "target_lang_translations": {
                                "en": "My brother wants to <get> a higher education.",
                                "zh": "我弟弟想<获得>高等教育。"
                            }
                        },
                        {
                            "text": "Во время игры футболист <получил> серьёзную травму.",
                            "target_lang_translations": {
                                "en": "During the game, the football player <sustained> a serious injury.",
                                "zh": "比赛中，那名足球运动员<受到>了严重的伤害。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "получить образование",
                        "получить травму",
                        "получить известность",
                        "получить доступ"
                    ],
                    "target_lang_definitions": {
                        "en": "To acquire a qualification or result, or to suffer something unpleasant like an injury.",
                        "zh": "指取得非物质性的成果（如学历、名声）或遭受某种负面影响（如受伤、受批评）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obtain",
                                "target_lang_sense_clarification": "education, degrees, results"
                            },
                            {
                                "target_lang_word": "receive",
                                "target_lang_sense_clarification": "injuries, reprimands"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "general use"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "用于学历、名声等成果"
                            },
                            {
                                "target_lang_word": "受到",
                                "target_lang_sense_clarification": "用于遭受伤害或批评"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fd50d68-e936-3201-aa44-269f192661f2",
                    "sense_definition": "Испытать какое-либо чувство или эмоциональное состояние.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <получили> огромное удовольствие от концерта.",
                            "target_lang_translations": {
                                "en": "We <derived> great pleasure from the concert.",
                                "zh": "我们从音乐会中<获得>了极大的快乐。"
                            }
                        },
                        {
                            "text": "Туристы <получили> массу впечатлений от поездки.",
                            "target_lang_translations": {
                                "en": "The tourists <got> a lot of impressions from the trip.",
                                "zh": "游客们从这次旅行中<获得>了许多深刻的印象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "получить удовольствие",
                        "получить наслаждение",
                        "получить впечатления"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience a particular feeling or emotion from something.",
                        "zh": "指从某事中体验到某种情感或心理状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "derive",
                                "target_lang_sense_clarification": "pleasure, satisfaction"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "指从经历中得到某种感受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5d36101-cdfb-3bad-b7f5-e9d7b62e81e9",
                    "sense_definition": "Произвести, добыть или вывести в результате труда, обработки или исследования.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фермеры надеются <получить> хороший урожай в этом году.",
                            "target_lang_translations": {
                                "en": "Farmers hope to <get> a good harvest this year.",
                                "zh": "农民们希望今年能<获得>好的收成。"
                            }
                        },
                        {
                            "text": "Из нефти можно <получить> бензин и другие продукты.",
                            "target_lang_translations": {
                                "en": "One can <derive> gasoline and other products from oil.",
                                "zh": "从石油中可以<提取>汽油和其他产品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "добыть"
                    ],
                    "common_phrases": [
                        "получить результат",
                        "получить урожай",
                        "получить вещество",
                        "получить данные"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce or extract something through a process or work.",
                        "zh": "指通过劳动、加工或研究产生、提取或得出某种结果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obtain",
                                "target_lang_sense_clarification": "general production"
                            },
                            {
                                "target_lang_word": "derive",
                                "target_lang_sense_clarification": "from a source/substance"
                            },
                            {
                                "target_lang_word": "produce",
                                "target_lang_sense_clarification": "results, harvest"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "指得出结果或数据"
                            },
                            {
                                "target_lang_word": "提取",
                                "target_lang_sense_clarification": "指从物质中分离出成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6689e47f-963e-3f15-9a05-eb54ac7d294e",
                    "sense_definition": "Подвергнуться наказанию или нагоняю за какой-либо проступок.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если ты опоздаешь, то обязательно <получишь> от начальника.",
                            "target_lang_translations": {
                                "en": "If you are late, you will definitely <get it> from the boss.",
                                "zh": "如果你迟到了，肯定会<挨>老板的<骂>。"
                            }
                        },
                        {
                            "text": "Мальчик <получил> от родителей за разбитое окно.",
                            "target_lang_translations": {
                                "en": "The boy <got it> from his parents for the broken window.",
                                "zh": "那个男孩因为打破窗户而<受到>了父母的<责罚>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "получить по шее",
                        "получить нагоняй"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be punished or scolded for doing something wrong.",
                        "zh": "指因做错事而受到惩罚或责骂。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get it",
                                "target_lang_sense_clarification": "idiomatic, colloquial"
                            },
                            {
                                "target_lang_word": "be in for it",
                                "target_lang_sense_clarification": "idiomatic"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挨骂",
                                "target_lang_sense_clarification": "指受到责骂"
                            },
                            {
                                "target_lang_word": "受罚",
                                "target_lang_sense_clarification": "指受到惩罚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}