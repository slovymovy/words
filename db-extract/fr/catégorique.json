                        "entry_id": "dbba8b22-8c88-3c92-a080-0560d0ff8bff",
                        "glosses": [
                            "Qui est clair, précis, qui ne souffre pas d’objection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b0c00d-cc48-407f-bcf1-82601436d1d9",
                                "sense_id": "e3e7e9d5-9ab9-3d1b-b9af-56ee706b7caa",
                                "text": "Une réponse catégorique."
                            },
                            {
                                "example_id": "8a03ce61-c319-4e01-b9cc-f05e69a29767",
                                "sense_id": "e3e7e9d5-9ab9-3d1b-b9af-56ee706b7caa",
                                "text": "Quand il prenait ainsi une décision, il était plus que catégorique, à cause de l'effort qu'il devait faire."
                            }
                        ]
                    },
                    {
                        "sense_id": "2458b2f1-9721-3b34-93c7-ee76927494f6",
                        "entry_id": "dbba8b22-8c88-3c92-a080-0560d0ff8bff",
                        "glosses": [
                            "Une proposition énoncée simplement et absolument."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a7406a-72cd-4a4a-9bbb-5f81a1e6cd9a",
                                "sense_id": "2458b2f1-9721-3b34-93c7-ee76927494f6",
                                "text": "Une proposition catégorique, telle que Tout homme est mortel."
                            }
                        ]
                    }
                ],
