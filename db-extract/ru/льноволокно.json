                "senses": [
                    {
                        "sense_id": "d8ac1ec5-e47a-32b3-8da2-1fe3371d07a5",
                        "entry_id": "68dcf214-7c17-3987-b0f3-bb60917b546f",
                        "glosses": [
                            "собир. то же, что льняное волокно; волокно, содержащееся в стеблях льна долгунца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53bdb666-9738-422d-9afb-52bbccc5e09a",
                                "sense_id": "d8ac1ec5-e47a-32b3-8da2-1fe3371d07a5",
                                "text": "Льноволокна с каждого гектара получено по 4,5 центнера, льносемени 4,3 центнера."
                            },
                            {
                                "example_id": "77d48534-89b7-4703-8694-022e39a1e623",
                                "sense_id": "d8ac1ec5-e47a-32b3-8da2-1fe3371d07a5",
                                "text": "В прошлом году предприятие получило рекламации на 10,6 тонны длинного льноволокна и на 13,4 тонны короткого."
                            }
                        ]
                    }
