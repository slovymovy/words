                                        "glosses": [
                                            "Onomatopée évoquant le bruit du moteur d’un petit bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c85fe82-a37f-4519-9bce-58dee29fd789",
                                                "sense_id": "05558984-5fe5-39d5-af38-1727f249f06b",
                                                "text": "Vers dix-huit heures un petit put put put put se met à résonner, amplifie l’espace. On a l’impression qu’il a demandé son autorisation au silence. De fait ce moteur invisible n’abusera en rien."
                                            }
