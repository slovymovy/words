        "nl-extract.jsonl": [
            {
                "entry_id": "06b3cf21-c87c-3b65-9846-8e9c536f21ea",
                "word": "ontluizen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c738632-65b4-349e-9294-a651394d390f",
                        "entry_id": "06b3cf21-c87c-3b65-9846-8e9c536f21ea",
                        "glosses": [
                            "het verwijderen van luizen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac91b14-5cc6-4d5c-838a-3cfbc8325971",
                                "sense_id": "6c738632-65b4-349e-9294-a651394d390f",
                                "text": "Mak wordt ‘blij en gelukkig’ van haar uitvinding, al hebben haar dochters er een hoge prijs voor betaald. Voordat ze de groene luizenkappen liet produceren, verzon ze zelf oplossingen die ze op haar kinderen testte. ,,Ik naaide mutsjes van de binnenbanden voor kinderfietsjes. Mijn dochter heeft wel eens een blauwe plek gehad, omdat mijn creaties te strak om haar hoofd zaten. Lachend: ,,Op een gegeven moment moest ik haar 5 euro betalen om haar met mijn kap te mogen ontluizen."
                            },
                            {
                                "example_id": "41bea275-f6a5-4fe6-ac6a-36aea0597614",
                                "sense_id": "6c738632-65b4-349e-9294-a651394d390f",
                                "text": "Voor degenen die Wittemans columns regelmatig lezen is dat herkenbaar materiaal. Hilarisch soms ook, vooral in de beschrijvingen van kwellingen als het organiseren van steeds originelere kinderfeestjes met bijpassende versnaperingen ('Lady Gaga met een rokje van rosbief'), het ontluizen van kinderhoofdjes en romances op het schoolplein."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e553afde-a424-40da-bef6-6c5702f53826",
                        "source_entry_id": "06b3cf21-c87c-3b65-9846-8e9c536f21ea",
                        "source_sense_id": "6c738632-65b4-349e-9294-a651394d390f",
                        "target_lang_word": "delouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4693eab-8cd7-3df4-8727-0acd222c366a",
                                        "entry_id": "97d2a850-7686-3a6a-ad2f-9523c14b408b",
                                        "glosses": [
                                            "To remove lice from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5e0e0e-acd9-4c41-b09e-933eaf84b9fc",
                                                "sense_id": "d4693eab-8cd7-3df4-8727-0acd222c366a",
                                                "text": "A veterinarian could delouse your dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50b535c-1ceb-3fd2-8bfc-23b20e213225",
                                        "entry_id": "97d2a850-7686-3a6a-ad2f-9523c14b408b",
                                        "glosses": [
                                            "To apply insecticides or insect repellents to, in order to be sure that no lice or other parasites are present."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e3f5413-93bf-419e-9e9c-de9dcec8a74b",
                                                "sense_id": "d50b535c-1ceb-3fd2-8bfc-23b20e213225",
                                                "text": "During the Korean Conflict, American soldiers were deloused with DDT upon entering basic training."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "228b90b0-afaa-3e52-8d6a-80fcdbe29fc1",
                                        "entry_id": "97d2a850-7686-3a6a-ad2f-9523c14b408b",
                                        "glosses": [
                                            "To remove malicious software, such as viruses, trojans, spyware, or worms, from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8cdbafb-ec8a-42a6-babb-fd2599cefd75",
                                                "sense_id": "228b90b0-afaa-3e52-8d6a-80fcdbe29fc1",
                                                "text": "A deloused computer may still be considered no longer trustworthy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "987d086c-bd53-48f6-ac79-6f4686f75783",
                        "source_entry_id": "06b3cf21-c87c-3b65-9846-8e9c536f21ea",
                        "source_sense_id": "6c738632-65b4-349e-9294-a651394d390f",
                        "target_lang_word": "debug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dad11304-4482-3568-a3cd-cd778c8bb0af",
                                        "entry_id": "5c6dfb0c-556b-339d-b52f-3f26648e884e",
                                        "glosses": [
                                            "To search for and eliminate malfunctioning elements or errors in something, especially a computer program or machinery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ce6ed6-f0f1-4f54-838f-fe36c5d638b1",
                                                "sense_id": "dad11304-4482-3568-a3cd-cd778c8bb0af",
                                                "text": "It ranged from the pre-design development of essential components, through the stage of type test and flight test and \"debugging\" right through to later development of the engine to higher powers and efficiency."
                                            },
                                            {
                                                "example_id": "71c53aed-eb89-40b5-ac3a-52d47176c9c0",
                                                "sense_id": "dad11304-4482-3568-a3cd-cd778c8bb0af",
                                                "text": "It debugs all program errors, including those that are hardware initiated."
                                            },
                                            {
                                                "example_id": "c78caaaa-ece3-4713-937f-1018cd4e7976",
                                                "sense_id": "dad11304-4482-3568-a3cd-cd778c8bb0af",
                                                "text": "Additionally, it's up to you to remember to remove this cron entry when you've debugged the firewall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb0d148-4c34-3923-88fe-71e29e0bfc3d",
                                        "entry_id": "5c6dfb0c-556b-339d-b52f-3f26648e884e",
                                        "glosses": [
                                            "To remove a hidden electronic surveillance device from (somewhere)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7eda51-a827-49fe-971f-6718cb59df47",
                                                "sense_id": "cfb0d148-4c34-3923-88fe-71e29e0bfc3d",
                                                "text": "Typical fees: $75 to check a particular telephone, $125 to debug one room, $500 to debug a suite of offices— all plus expenses and transportation."
                                            },
                                            {
                                                "example_id": "2151ae77-9ac1-4edc-b9d0-148a4e4e3b87",
                                                "sense_id": "cfb0d148-4c34-3923-88fe-71e29e0bfc3d",
                                                "text": "It conducts background investigations of new CIA employees and CIA contractors, administers polygraph tests to employees and agents, debugs offices at Langley and overseas stations, patrols the buildings and grounds, protects the director and other key CIA officials, and investigates security problems."
                                            },
                                            {
                                                "example_id": "1e2809e0-139e-4127-b516-64766ea498d8",
                                                "sense_id": "cfb0d148-4c34-3923-88fe-71e29e0bfc3d",
                                                "text": "It is good to acquire information about how to perform the debugging operation and the type of tools that will be used, from which you may already have an idea of the technical and instrumental skills, having acquired a plenty of technical information after reading this chapter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc77f38f-1966-37ea-956b-ab53a8bab00f",
                                        "entry_id": "5c6dfb0c-556b-339d-b52f-3f26648e884e",
                                        "glosses": [
                                            "To remove insects from (somewhere), especially lice."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3afc0a68-94e7-4f35-811d-26d81a7b731c",
                                                "sense_id": "bc77f38f-1966-37ea-956b-ab53a8bab00f",
                                                "text": "Mr. Moses started out his garden this year with only two toads. As they were differently marked, they soon became known as \"Henry\" and \"Frank.\" Henry was strong in the pursuit of \"ants.\" Every morning he is seen perched on his favorite hill \"anting\" for breakfast. Frank's occupation is that of debugging the roses and beating up the paths for miscellaneous insects."
                                            },
                                            {
                                                "example_id": "e0b0bc93-1db0-489a-8bf8-1672fbd8c27b",
                                                "sense_id": "bc77f38f-1966-37ea-956b-ab53a8bab00f",
                                                "text": "You can debug yourself at home with various over-the-counter medications."
                                            },
                                            {
                                                "example_id": "785a5849-82f9-405e-a80a-c23b1de8c6e3",
                                                "sense_id": "bc77f38f-1966-37ea-956b-ab53a8bab00f",
                                                "text": "If you find nits, it's time for some serious debugging."
                                            },
                                            {
                                                "example_id": "4f01ef3c-38d5-4d90-b13c-43a20f7af22b",
                                                "sense_id": "bc77f38f-1966-37ea-956b-ab53a8bab00f",
                                                "text": "Before we moved into our new quarters we, and our belongings, had to be deloused and debugged."
                                            },
                                            {
                                                "example_id": "d60c7d1d-9f10-4b57-8185-3455e6d90694",
                                                "sense_id": "bc77f38f-1966-37ea-956b-ab53a8bab00f",
                                                "text": "MK2 has said that its theatres have been de-bugged and that “there is no more risk in our rooms than in any other public place in Paris”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5aa53031-d6a6-3eaf-844d-be560c402713",
                                        "entry_id": "477605b3-1892-31f3-b45d-0fa93e0a7cf8",
                                        "glosses": [
                                            "The action, or a session, of reviewing source code to find and eliminate errors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90a4090-c3ca-47e1-9172-9debc9b2bfbb",
                                                "sense_id": "5aa53031-d6a6-3eaf-844d-be560c402713",
                                                "text": "It may appear odd in the example that the no debug all command was entered before and after the debug was done. The first command is unnecessary, but getting into this habit can save you!"
                                            },
                                            {
                                                "example_id": "8256b0c1-5971-4bc2-8e17-8297df4d23ef",
                                                "sense_id": "5aa53031-d6a6-3eaf-844d-be560c402713",
                                                "text": "What should be the next steps following a test failure during debug?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
