                "senses": [
                    {
                        "sense_id": "afe7754b-ef00-37e0-8108-f9fdf7f6df11",
                        "entry_id": "48424d20-3284-32ea-8f0e-15b2c2550d21",
                        "glosses": [
                            "Donner un caractère remarquable à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea978566-451b-4f7c-9795-ccceb2b16479",
                                "sense_id": "afe7754b-ef00-37e0-8108-f9fdf7f6df11",
                                "text": "Il faut être capable de « remarquabiliser » votre marque grâce à l'innovation."
                            },
                            {
                                "example_id": "da789303-49f8-41c1-a041-415f91f34eed",
                                "sense_id": "afe7754b-ef00-37e0-8108-f9fdf7f6df11",
                                "text": "\"Remarquabiliser\" des arbres n'a plus vraiment de sens pour des gens convaincus de la cause qui trouvent effectivement chaque arbre \"remarquable\" de principe..."
                            },
                            {
                                "example_id": "07f608b0-76fc-4dad-86ae-65d94583ab10",
                                "sense_id": "afe7754b-ef00-37e0-8108-f9fdf7f6df11",
                                "text": "Cela éviterait le risque de remarquabiliser des private jokes incompréhensibles au plus grand nombre."
                            }
                        ]
                    }
