                "senses": [
                    {
                        "sense_id": "8ad57bb3-4fbf-3096-912b-1a64bb3e62c2",
                        "entry_id": "a04d39e0-6f33-34a5-9ed1-8ac9ea643f7d",
                        "glosses": [
                            "Lehrziel mit grober struktureller Beschreibung, das in Feinziele aufgegliedert werden kann"
                        ],
                        "tags": [
                            "Pädagogik"
                        ],
                        "examples": [
                            {
                                "example_id": "25142cc5-3ee5-4ce5-8943-935aba01f85d",
                                "sense_id": "8ad57bb3-4fbf-3096-912b-1a64bb3e62c2",
                                "text": "„Das Grobziel ist die Bildung einer familienbewussten und geschlechtergerechten Universität.“"
                            },
                            {
                                "example_id": "aca791ac-ab27-4bcd-917b-226444d2733e",
                                "sense_id": "8ad57bb3-4fbf-3096-912b-1a64bb3e62c2",
                                "text": "„Zunächst erfolgt eine Festlegung der Grobziele um die Lehreinheiten vorausschauend und ökonomisch planen zu können und um nach Erkenntnis der speziellen Voraussetzungen der Teilnehmer Feinziele ableiten zu können […].“"
                            },
                            {
                                "example_id": "b84fec0a-fec7-4c7e-96f1-d378aa4b271e",
                                "sense_id": "8ad57bb3-4fbf-3096-912b-1a64bb3e62c2",
                                "text": "„So hat einleuchtenderweise das Grobziel ‘Verantwortungsvoller Umgang mit Sucht- und Genussmitteln’ in einer Gruppe von Jugendlichen eine ganz andere Relevanz und Wertigkeit als in einer Gruppe mit Vorschulkindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
