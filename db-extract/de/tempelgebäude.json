                        "glosses": [
                            "Gebäude, das als Tempel dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e9b71b8-bc9f-49fe-be1d-59ad1db1f270",
                                "sense_id": "5b178dc0-b65e-3cc7-aaaa-35cce67b6d5e",
                                "text": "„Die Tempelgebäude bestehen aus einem öffentlichen Teil, den jeder Ägypter betreten und als Gebetsstätte nutzen kann (Vorhöfe, Außenmauern) und aus einem inneren Teil, zu dem nur die Priester Zutritt haben.“"
                            },
                            {
                                "example_id": "ddb2a3a2-0c81-46eb-ad92-8b258b02ef78",
                                "sense_id": "5b178dc0-b65e-3cc7-aaaa-35cce67b6d5e",
                                "text": "„Ob die in Deutschland festgestellten vorrömischen Tempelgebäude die Pracht der gallischen Anlagen erreicht haben, ist noch ungewiss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
