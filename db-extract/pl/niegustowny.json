                        "source_sense_id": "6d5af57b-47d0-3052-834c-69804fe9b1ea",
                        "target_lang_word": "tasteless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tasteless",
