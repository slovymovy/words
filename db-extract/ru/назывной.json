                "senses": [
                    {
                        "sense_id": "7df8e8d8-cdfa-3229-babb-daaf6d50e781",
                        "entry_id": "caf6eeed-240a-39dc-bf67-45cb3d38f406",
                        "glosses": [
                            "лингв. такой, в котором предмет только назван, но о нём ничего не говорится кроме того, что он есть (о предложении)"
                        ],
