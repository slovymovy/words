                                                "example_id": "b26f9585-7894-44cd-bed2-f324bc580db2",
                                                "sense_id": "62ac400b-21ef-3d4d-b26a-3e99f52e631f",
                                                "text": "J’utilisais un baron, vous savez ce que c’est un baron ? Un baron, c’est un faux client, qui achetait."
                                            }
                                        ]
                                    }
