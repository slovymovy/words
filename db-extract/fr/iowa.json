                "forms": [],
                "senses": [
                    {
                        "sense_id": "3547c9fb-f48b-364d-b90d-fd82cc7f0f74",
                        "entry_id": "185925ab-b279-30d4-b518-e60fb12319d4",
                        "glosses": [
                            "Un des cinquante États des États-Unis d’Amérique (capitale Des Moines, code postal IA), bordé par le Minnesota au nord, le Wisconsin au nord-est, l’Illinois au sud-est, le Missouri au sud, le Nebraska au sud-ouest, et le Dakota du Sud au nord-ouest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eeef12e-4582-4665-ac4d-7d28c8558a4e",
                                "sense_id": "3547c9fb-f48b-364d-b90d-fd82cc7f0f74",
                                "text": "Ce n'est pas le genre de discours populiste qui fonctionne normalement en Iowa, reconnu surtout pour ses champs de maïs et ses gigantesques porcheries."
                            },
                            {
                                "example_id": "ec9dc17d-28e2-496a-b887-bc0ca3669666",
                                "sense_id": "3547c9fb-f48b-364d-b90d-fd82cc7f0f74",
                                "text": "En novembre 2021, en Iowa, deux adolescents de 16 ans ont battu leur prof d’espagnol à mort parce qu’elle leur avait donné une mauvaise note."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "786bc829-6fad-4ad2-9895-bb4ea5e16fa3",
                        "source_entry_id": "185925ab-b279-30d4-b518-e60fb12319d4",
                        "source_sense_id": "3547c9fb-f48b-364d-b90d-fd82cc7f0f74",
                        "target_lang_word": "Iowa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iowa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                                        "entry_id": "61b29a2d-7b54-3077-ba31-1cb546db947d",
                                        "glosses": [
                                            "Bundesstaat im Mittleren Westen der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92757ec9-8755-49e8-bdaa-b328914d7328",
                                                "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                                                "text": "Mein Mann kommt aus Iowa."
                                            },
                                            {
                                                "example_id": "5b383f02-e54e-4956-bd7a-b5e8c93ed674",
                                                "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                                                "text": "Iowa ist für seine weiten Naturlandschaften bekannt, aber auch für seine dörfliche und kleinstädtische Natur."
                                            },
                                            {
                                                "example_id": "f9b752a9-d014-477a-a224-d6dcbf183092",
                                                "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                                                "text": "Man nennt Iowa nicht ohne Grund den Corn State, denn nirgendwo anders wird soviel Mais angebaut wie hier."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f6fae24-11f9-42c5-b90e-c7c7477ff321",
                        "source_entry_id": "185925ab-b279-30d4-b518-e60fb12319d4",
                        "source_sense_id": "3547c9fb-f48b-364d-b90d-fd82cc7f0f74",
                        "target_lang_word": "Iowa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iowa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                        "entry_id": "9196b3e7-2cc2-34fe-80ee-4fa5f1728c89",
                                        "glosses": [
                                            "A state in the Midwestern region of the United States. Capital and largest city: Des Moines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed7560e-0200-4471-8889-b233a0885c46",
                                                "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                                "text": "His family, who live in West Des Moines, Iowa, have been left “devastated,” his owner Tracy Wolfe said in GWR press release. “He was just the best giant boy,” she added."
                                            },
                                            {
                                                "example_id": "aa5581b2-6dc4-4c21-a5ad-46c10f452b4e",
                                                "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                                "text": "I prefer to think of Iowa as I saw it through the eyes of a ten-year-old boy. Those were eyes filled with the wonders of Iowa’s streams and woods, of the mystery of growing crops."
                                            },
                                            {
                                                "example_id": "bb7e217e-f510-40d1-b673-5ac96f1ce038",
                                                "sense_id": "5137db09-5cec-3110-bc58-4b9244f9bd3d",
                                                "text": "When University of Iowa researchers surveyed first-responders in Cedar Rapids, their study published last year found no noticeable difference in response time when a road diet was in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fde867d-e72b-3f06-9c1c-fc1350c6db3e",
                                        "entry_id": "9196b3e7-2cc2-34fe-80ee-4fa5f1728c89",
                                        "glosses": [
                                            "A tributary of the Mississippi River which flows through Iowa in a southeast direction."
                                        ],
