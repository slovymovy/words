                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm winds <w>vex</w> the surface of the dark ocean.",
                            "target_lang_translations": {
                                "ru": "Штормовые ветры <w>волнуют</w> поверхность темного океана.",
                                "tr": "Fırtına rüzgârları karanlık okyanusun yüzeyini <w>çalkalıyor</w>.",
                                "zh": "暴风<w>搅动</w>着黑暗海洋的水面。"
                            }
                        },
                        {
                            "text": "The ship was <w>vexed</w> by the rough and unpredictable waves.",
                            "target_lang_translations": {
                                "ru": "Корабль <w>трепали</w> бурные и непредсказуемые волны.",
