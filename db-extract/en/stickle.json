                ],
                "senses": [
                    {
                        "sense_id": "a24dcebd-57d0-3679-8098-cba75f83d577",
                        "entry_id": "2128ff27-d5a1-3000-a58b-242ade1d56e3",
                        "glosses": [
                            "A shallow rapid in a river."
                        ],
                        "tags": [
                            "British",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "4870c341-b0db-4354-ade8-71567c248762",
                                "sense_id": "a24dcebd-57d0-3679-8098-cba75f83d577",
                                "text": "He swam through the plying poles of the stickle, and ran over the shallow, reaching safe water before the pack came down. He was young and fast and strong."
                            }
                        ]
                    },
                    {
                        "sense_id": "da114514-13b4-3004-84ee-870334d2176c",
                        "entry_id": "2128ff27-d5a1-3000-a58b-242ade1d56e3",
                        "glosses": [
                            "The current below a waterfall."
                        ],
                        "tags": [
                            "British",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "ba63ce06-d30d-47a3-9be0-4d51165c4228",
                                "sense_id": "da114514-13b4-3004-84ee-870334d2176c",
                                "text": "[P]atient Anglers ſtanding all the day / Neere to ſome ſhallovv ſtickle or deepe bay."
                            }
                        ]
                    }
                ],
