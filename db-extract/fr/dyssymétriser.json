                "senses": [
                    {
                        "sense_id": "17032c0c-2da4-3678-9653-f88a9f3cf02d",
                        "entry_id": "87d4af24-da57-3bc2-bacd-fd0d84a10609",
                        "glosses": [
                            "Rendre dyssymétrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce59aaf-fe0a-46b7-87ae-30deb33944ad",
                                "sense_id": "17032c0c-2da4-3678-9653-f88a9f3cf02d",
                                "text": "Par exemple, — détail bien mince mais caractéristique — la raie des cheveux sur le côté, qui dyssymétrise la chevelure, est certainement un progrès sur la raie au milieu du front."
                            },
                            {
                                "example_id": "5d350800-6306-43cf-9d3e-2ee8684236b0",
                                "sense_id": "17032c0c-2da4-3678-9653-f88a9f3cf02d",
                                "text": "Il utilise des cartes à effet symmétrique mais les dyssymétrise grâce à sa base de mana et son haut nombre de permanents."
                            },
                            {
                                "example_id": "b1710459-1866-4e09-8e9e-9929c66ce3bd",
                                "sense_id": "17032c0c-2da4-3678-9653-f88a9f3cf02d",
                                "text": "On garde le jeu de solution symétriques le plus longtemps possible, afin qu'on le dyssymétrise au tout dernier moment lors d'intégrations/conditions limites ?"
                            }
                        ]
                    }
                ],
