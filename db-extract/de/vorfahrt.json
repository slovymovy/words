                                    {
                                        "sense_id": "d452ab13-eb17-3a4e-b4f2-49a7d3c119e6",
                                        "entry_id": "b5de677a-3dfe-3f3f-b860-1ec5fcf8bb09",
                                        "glosses": [
                                            "The right to proceed first in traffic, on land, on water or in the air. Also in metaphorical senses."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068e3402-f4c8-4455-b29c-779db0318502",
                                                "sense_id": "d452ab13-eb17-3a4e-b4f2-49a7d3c119e6",
                                                "text": "Even when you have the right of way, you must take action to avoid a collision if another boat fails to give way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a3d131-369e-384f-9814-a74248de2b0c",
                                        "entry_id": "b5de677a-3dfe-3f3f-b860-1ec5fcf8bb09",
                                        "glosses": [
                                            "A legal right of passage over another's land or pathways."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a39559-c1c9-47f2-ac2f-77e671340953",
                                                "sense_id": "38a3d131-369e-384f-9814-a74248de2b0c",
                                                "text": "2000, \"Countryside and Rights of Way Act (2000) (c.37)\" (UK), II.48(4),\n“restricted byway” means a highway over which the public have restricted byway rights, with or without a right to drive animals of any description along the highway, but no other rights of way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66193fb-b615-3b37-be3c-c161962969ca",
                                        "entry_id": "b5de677a-3dfe-3f3f-b860-1ec5fcf8bb09",
                                        "glosses": [
                                            "A strip of land or alignment where portions of a roadway, railway, power line, or other utilities and their associated structures and facilities is located or passes acquired through eminent domain or expropriation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86375c44-d8b1-4304-9c37-b4c11bc4c371",
                                                "sense_id": "a66193fb-b615-3b37-be3c-c161962969ca",
                                                "text": "Meronym: permanent way"
                                            },
                                            {
                                                "example_id": "3fe4bb78-7056-47bb-9461-512e9c5c4fe1",
                                                "sense_id": "a66193fb-b615-3b37-be3c-c161962969ca",
                                                "text": "Phillips granted a right-of-way to the Southern Pacific Railroad in 1873."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5b226c0-b1af-38fc-9e9e-ee6f6cd014f6",
                                        "entry_id": "b5de677a-3dfe-3f3f-b860-1ec5fcf8bb09",
                                        "glosses": [
                                            "Land on which a right of way exists."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f334f0b3-91ff-457d-92fe-bb790cccd58b",
                                                "sense_id": "e5b226c0-b1af-38fc-9e9e-ee6f6cd014f6",
                                                "text": "New York's Metropolitan Transportation Authority plans a rail line on an unused right of way of the Long Island Rail Road between JFK and Penn Station to whisk passengers to midtown Manhattan in twenty minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae6bf0c4-2b61-3364-b331-c618c009c038",
                                        "entry_id": "b5de677a-3dfe-3f3f-b860-1ec5fcf8bb09",
                                        "glosses": [
                                            "The area modified for passage of a railway; often specifically the railbed and tracks."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d1b182-79ac-4dc9-bcb2-9115f5733fdd",
                                                "sense_id": "ae6bf0c4-2b61-3364-b331-c618c009c038",
                                                "text": "For example, if a railroad is required to connect a mine and a smelter, it is necessary to construct a right of way, to lay tracks, etc."
                                            },
                                            {
                                                "example_id": "a5467c06-cc7c-45ca-b003-4bd69454a71b",
                                                "sense_id": "ae6bf0c4-2b61-3364-b331-c618c009c038",
                                                "text": "Mayne, speaking at the 1999 meeting, ranked the trees along the right-of-way as \"old growth\" or \"rare,\" although she never defined these terms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07cf2157-a1aa-37cf-8c1d-e2e84ca2dc14",
                                        "entry_id": "b5de677a-3dfe-3f3f-b860-1ec5fcf8bb09",
                                        "glosses": [
                                            "The priority granted to the first person to properly execute an attack."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092564a7-df88-467d-82e9-54ae9a09a29b",
                                                "sense_id": "07cf2157-a1aa-37cf-8c1d-e2e84ca2dc14",
                                                "text": "In foil the important thing is to be sure you have the right of way. You gain right of way by starting the attack first or beating the blade last."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76bf725a-a85c-3744-b3b6-bc53b9b7bde7",
                                        "entry_id": "b5de677a-3dfe-3f3f-b860-1ec5fcf8bb09",
                                        "glosses": [
                                            "The strip of grass between the sidewalk and the street."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
