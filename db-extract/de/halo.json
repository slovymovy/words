                    {
                        "sense_id": "0d83035b-fef5-3419-84c0-8823b155db98",
                        "entry_id": "c7775e5e-8c68-34ee-a4e9-33176d185b07",
                        "glosses": [
                            "ein Lichthof, der durch Brechung des Lichts um ein Objekt herum entsteht"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "24d98580-b5ce-4e2f-9397-8accfb865738",
                                "sense_id": "0d83035b-fef5-3419-84c0-8823b155db98",
                                "text": "Der Halo kann auch durch Reflexion entstehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c033faa3-6986-3993-ab55-357a3d8ebfbc",
                        "entry_id": "c7775e5e-8c68-34ee-a4e9-33176d185b07",
                        "glosses": [
                            "ein atmosphärischer Lichteffekt, der durch Brechung oder Reflexion an Eiskristallen entsteht"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "c3552acf-3786-462b-894a-419e7ed05076",
                                "sense_id": "c033faa3-6986-3993-ab55-357a3d8ebfbc",
                                "text": "Diesen Halo kann man am bestem vom Flugzeug aus beobachten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0c2db200-cab5-3494-ba5f-ee5683d5f45a",
                        "entry_id": "c7775e5e-8c68-34ee-a4e9-33176d185b07",
                        "glosses": [
                            "ein Bereich, der eine Galaxie umgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a835117-4f95-412f-864b-c211edd8b58e",
                                "sense_id": "0c2db200-cab5-3494-ba5f-ee5683d5f45a",
                                "text": "„Anders als die galaktische Scheibe ist der Halo weitgehend staubfrei und enthält fast ausschließlich Sterne der älteren, metallarmen Population II, deren Orbit sehr stark gegen die galaktische Ebene geneigt ist.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ff51c75b-4d5f-33f6-98f8-f8da71b9b029",
                        "entry_id": "c7775e5e-8c68-34ee-a4e9-33176d185b07",
                        "glosses": [
                            "ein ungewollter Effekt in der digitalen Bildbearbeitung"
                        ],
                        "tags": [
                            "digitale Fotografie",
                            "digitale Bildbearbeitung"
                        ],
                        "examples": [
                            {
                                "example_id": "9dc7d8a6-a517-4401-915e-6367774c79ac",
                                "sense_id": "ff51c75b-4d5f-33f6-98f8-f8da71b9b029",
                                "text": "Der Halo kann entstehen, wenn das Bild zu sehr komprimiert wurde."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
