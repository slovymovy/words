                        "examples": [
                            {
                                "example_id": "3425901b-761c-447a-be4d-93363c60ddeb",
                                "sense_id": "5e636497-a050-365a-8734-028c5cc504b2",
                                "text": "„Die Biotonne wird als hygienisch unbedenklich eingestuft, wenn bestimmte Vorsichtsmaßnahmen zur Verminderung der Keimzahlen eingehalten werden, z. B. die portionsweise Abpackung der Abfälle in verrottbare Kunststoffbeutel durch den Abfallproduzenten und eine turnusmäßige Spülung der Biotonne durch den öffentlich-rechtlichen Entsorgungsträger (Bioabfallentsorgung).“"
                            },
                            {
                                "example_id": "220bbd2b-c86e-4225-b704-634325fe6b7e",
                                "sense_id": "5e636497-a050-365a-8734-028c5cc504b2",
                                "text": "„Betriebliche Anlagen dürfen von anderen Abfallproduzenten mitbenutzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
