                        "examples": [
                            {
                                "example_id": "f10fce45-3c5f-49e3-a952-53be363c9d77",
                                "sense_id": "7d92d586-83fc-3607-a137-5287791873c2",
                                "text": "Er deed zich gisterenmorgen een wegverzakking voor op de ventweg van de Koningin Astridlaan."
                            },
                            {
                                "example_id": "b1ec6698-ad34-4841-8bef-bea7e151689e",
                                "sense_id": "7d92d586-83fc-3607-a137-5287791873c2",
                                "text": "Het slachtoffer is per ambulance naar het MST is Enschede gebracht. De nasleep wordt afgehandeld op de ventweg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7911a5fe-5384-42b3-bf08-60ec2bbf556b",
