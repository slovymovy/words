                                "target_senses": [
                                    {
                                        "sense_id": "f713152c-59c3-3a55-9779-5a5741ca393d",
                                        "entry_id": "062f7b9c-fd8e-3104-98bf-72c4ee3fdf06",
                                        "glosses": [
                                            "Pertaining to a sophist or sophistry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a81b2283-b710-3c9c-b065-9ef774175071",
                                        "entry_id": "062f7b9c-fd8e-3104-98bf-72c4ee3fdf06",
                                        "glosses": [
                                            "Fallacious, misleading or incorrect in logic or reasoning, especially intentionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03bba728-da11-4e21-af12-d072be38822a",
                                                "sense_id": "a81b2283-b710-3c9c-b065-9ef774175071",
                                                "text": "This is, we believe, a fair summary of Mr. Lamb's doctrine. We are sure that we do not wish to represent him unfairly. […] But we must plainly say that his argument, though ingenious, is altogether sophistical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
