                "senses": [
                    {
                        "sense_id": "6f7b67bc-379f-3bae-8c1f-7b10c6d176ca",
                        "entry_id": "c9ae9d48-88eb-3579-b907-b0d92564c97c",
                        "glosses": [
                            "Donner plusieurs médicaments différents à (un malade)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f59eada-30c9-4571-9c44-f793c962853c",
                                "sense_id": "6f7b67bc-379f-3bae-8c1f-7b10c6d176ca",
                                "text": "L’analyse de l’évolution du nombre de lignes de prescriptions montre que l’hospitalisation a tendance à polymédicamenter le patient."
                            },
                            {
                                "example_id": "42da092d-5931-4835-abaf-fe573076cf8f",
                                "sense_id": "6f7b67bc-379f-3bae-8c1f-7b10c6d176ca",
                                "text": "La patiente était également polymédicamentée par ailleurs, recevant 12 médicaments en traitement d'un angor, d'une douleur neuropathique chronique, d'une épilepsie, d'allergies, d'une hypercholestérolémie, ainsi que des suppléments vitaminiques."
                            },
                            {
                                "example_id": "53f17bae-ff5e-4db6-9f0e-ce80f233e613",
                                "sense_id": "6f7b67bc-379f-3bae-8c1f-7b10c6d176ca",
                                "text": "Se polymédicamenter pour un trouble bénin est stupide, surtout si c'est répété."
                            }
                        ]
                    }
