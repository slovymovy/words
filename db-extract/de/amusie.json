                ],
                "senses": [
                    {
                        "sense_id": "891b0d5e-2aec-3f84-9f7d-413854162ee7",
                        "entry_id": "bf8026dc-0443-315e-ac4b-95d3962508f6",
                        "glosses": [
                            "Unfähigkeit, Tonfolgen oder Rhythmen zu erkennen oder wiederzugeben"
                        ],
                        "tags": [
                            "Sinnesphysiologie",
                            "Sinnespathologie"
                        ],
                        "examples": [
                            {
                                "example_id": "15500b88-8ca8-4f74-8781-806e2c744cae",
                                "sense_id": "891b0d5e-2aec-3f84-9f7d-413854162ee7",
                                "text": "„Genauer wird mit rezeptiver Amusie ein Defizit in der Musikwahrnehmung und mit expressiver Amusie eine Störung der musikalischen Produktion bezeichnet. Die Amusie ist damit eine Form der auditiven Agnosie.“"
                            },
                            {
                                "example_id": "39b25961-b125-42fa-829c-9202e4837c26",
                                "sense_id": "891b0d5e-2aec-3f84-9f7d-413854162ee7",
                                "text": "„Für mich ist es nur schwer vorstellbar, aber Menschen, die an Amusie leiden, sind nicht in der Lage, Musik zu hören. Alles was sie wahrnehmen, ist ein unangenehmes bis unerträgliches Scheppern im Kopf. Musikhören wird zur Qual.“"
                            },
                            {
                                "example_id": "e73ef1a4-8eb1-4ffd-8e50-63a872010ea9",
                                "sense_id": "891b0d5e-2aec-3f84-9f7d-413854162ee7",
                                "text": "„Der Komponist Maurice Ravel (1875-1937) bezeichnet den wohl bekanntesten Fall von Amusie in der Musikgeschichte. Nachdem sein Gehirn in Folge einer Läsion Schaden genommen hatte, litt er fortan an einer Notenlesestörung. Erschwerend hinzu kam die Unfähigkeit, Kompositionen zu Papier bringen zu können. In seinem Kopf hingegen komponierte er weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
