        "fr-extract.jsonl": [
            {
                "entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
                "word": "réincarnation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "72a04afd-f8b5-40ad-acff-5edf0ce610bb",
                        "entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
                        "tags": [
                            "plural"
                        ],
                        "form": "réincarnations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21ca4c08-c57a-3b91-9c1e-003a10695746",
                        "entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
                        "glosses": [
                            "Action de se réincarner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5a2f970-6406-4a1b-a76a-0c668b66472e",
                                "sense_id": "21ca4c08-c57a-3b91-9c1e-003a10695746",
                                "text": "Au Québec, depuis les années cinquante, la croyance en la réincarnation est passée d’un petit 5 % à plus de 30 %."
                            },
                            {
                                "example_id": "6493761c-7a89-4cd3-9e19-74b9d8a56ef8",
                                "sense_id": "21ca4c08-c57a-3b91-9c1e-003a10695746",
                                "text": "Le but de la vie est de se libérer du lien karmique. L'âme doit se détacher de la matière et mourir en état de liberté pour sortir du cycle des réincarnations."
                            }
                        ]
                    },
                    {
                        "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                        "entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf5b0e12-ae09-4282-af14-d7aa02f5435b",
                                "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                                "text": "Le Jebtsundamba Khutuktu est le chef spirituel de l’église bouddhiste en Mongolie. Il serait la réincarnation du lama Zanabazar, lama fondateur de la ville d’Oulan-Bator."
                            },
                            {
                                "example_id": "20409376-cac1-4a62-9a60-3c7d7b55456a",
                                "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                                "text": "— Alors je me borne à l’écouter, me félicitant de l’heureux hasard qui me fait rencontrer cette réincarnation d’un savant d'un autre âge."
                            },
                            {
                                "example_id": "098efd55-15f7-4192-8704-41730684afbc",
                                "sense_id": "f23db187-b773-3591-b9d6-eae00f714eda",
                                "text": "— Au Bouillon Pigalle, nouveau spot apprécié du boulevard de Clichy, la star s’appelle bourguignon aux coquillettes (notre strogonoff à nous). Le lieu est d’ailleurs une moderne réincarnation des bouillons, ces restos populaires de la Belle Époque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6308f60c-6c6a-4abc-80d2-b66c13b2437a",
                        "source_entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
                        "target_lang_word": "Wiedergeburt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiedergeburt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                        "entry_id": "8f815b01-95c5-35fc-9d3c-f138beb628fb",
                                        "glosses": [
                                            "der Anfang eines neuen Lebens ein und desselben Individuums nach dem Tod als ein anderes Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22641106-7e15-4fe2-9f19-24b1e4499bbf",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "Im Buddhismus glaubt man an Wiedergeburt."
                                            },
                                            {
                                                "example_id": "070051ae-8bb6-4ced-b494-25e02612960b",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„In den meisten Fassungen der Loreleysage haben die Dichter Loreleys Wiedergeburt einfach übergangen, wahrscheinlich weil das Thema Reinkarnation nicht in das christliche Weltbild der damaligen Zeit paßte.“"
                                            },
                                            {
                                                "example_id": "641fd7e5-26f3-477f-895e-3c320d91b8f2",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„Ich gebe allerdings zu, daß ich mich, um das schöne Vorrecht der Wiedergeburt zu haben, auch damit zufrieden geben würde; besonders heute wäre ich einverstanden, nicht nur als Frau, sondern sogar als irgendein stumpfes Geschöpf wiedergeboren zu werden, das aber nur, wenn ich mein Gedächtnis behielte, denn ohne das wäre ich nicht ich selbst.“"
                                            },
                                            {
                                                "example_id": "6cfb41a7-40cc-4403-88e0-c1eafde8c420",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„Denn dieser Käfer wurde im alten Ägypten als Bringer der Wiedergeburt und des Glücks verehrt.“"
                                            },
                                            {
                                                "example_id": "595f2a70-4e1a-4223-b83f-a6a1a0f4573b",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„Die Pythagoräer waren zudem von der Möglichkeit einer Wiedergeburt in tierischer Gestalt überzeugt und deshalb Vegetarier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8436dba0-877a-396d-8094-5125f5012d7a",
                                        "entry_id": "8f815b01-95c5-35fc-9d3c-f138beb628fb",
                                        "glosses": [
                                            "erneute Popularität oder Verwendung eines Systems, einer Sache oder Idee"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a50d052-c858-41b1-8795-ce187a6d095e",
                                                "sense_id": "8436dba0-877a-396d-8094-5125f5012d7a",
                                                "text": "In Deutschland feiert man zurzeit die Wiedergeburt des Protests."
                                            },
                                            {
                                                "example_id": "6710ce24-54b4-441c-8909-02648adfdb34",
                                                "sense_id": "8436dba0-877a-396d-8094-5125f5012d7a",
                                                "text": "„Damals hielten sich die kaiserlichen Landsknechte, darunter auch solche aus deutschen Ländern, für ihren ausgebliebenen Sold an den Reichtümern der Ewigen Stadt schadlos, die gerade ihre Wiedergeburt aus den antiken Ruinen erlebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b954114-a996-35ba-8ede-d47619492066",
                                        "entry_id": "8f815b01-95c5-35fc-9d3c-f138beb628fb",
                                        "glosses": [
                                            "Eintritt in einen spirituellen/religiösen Zustand des Daseins durch einen Akt göttlicher Gnade/Berufung, als Gegensatz zum vorhergehenden Lebensabschnitt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb09944-d5bc-4312-9b0b-9620da046855",
                                                "sense_id": "2b954114-a996-35ba-8ede-d47619492066",
                                                "text": "„Die Taufe ist daher ein wirksames Zeichen der Wiedergeburt, um innerlich erneut zu leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb32e416-de0b-411f-92a1-fd8f93d42ffa",
                        "source_entry_id": "a9002adb-eb97-3253-9260-39f45c27542f",
