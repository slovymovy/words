                        "form": "striations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5c9233e-b8e5-3e4c-a4b1-58addd668c23",
                        "entry_id": "73643ee0-fdd8-3f38-a298-159d860a95a0",
                        "glosses": [
                            "One of a number of parallel grooves and ridges in a rock or rocky deposit, formed by repeated twinning or cleaving of crystals."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "deedfb4b-a6f3-37de-a4d6-eb48185dd491",
                        "entry_id": "73643ee0-fdd8-3f38-a298-159d860a95a0",
                        "glosses": [
                            "One of a number of parallel scratch lines in rock outcrops, formed when glaciers dragged rocks across the landscape."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "6b9c6a18-a1ac-4af4-b986-940cbdd8e436",
                                "sense_id": "deedfb4b-a6f3-37de-a4d6-eb48185dd491",
                                "text": "The energy raised the temperature of the snow a couple of degrees, and the friction carved striations high in the icy sides of the canyon walls."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2f4e124-e0a9-3ac4-8cea-d2962db176cf",
                        "entry_id": "73643ee0-fdd8-3f38-a298-159d860a95a0",
                        "glosses": [
                            "The action of marking with a stria."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c96bbecb-4d72-3b07-b53c-cb0e4025020b",
                        "entry_id": "73643ee0-fdd8-3f38-a298-159d860a95a0",
                        "glosses": [
                            "The result of being marked with a stria."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "37cd4a71-b949-373c-804c-378c28043e19",
                        "entry_id": "73643ee0-fdd8-3f38-a298-159d860a95a0",
                        "glosses": [
                            "a parallel series of small grooves, channels, or impressions typically within a metal roof panel used to help reduce the potential for oil-canning."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de1fe5e2-fd9f-4103-826c-75c1ae392f13",
                        "source_entry_id": "73643ee0-fdd8-3f38-a298-159d860a95a0",
                        "source_sense_description": "action of marking with a stria",
                        "target_lang_word": "Streifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d57cc766-f536-3c57-9e21-b62b7ad725b3",
                                        "entry_id": "2800db46-b4b2-3456-b4c7-1ce3015a9d95",
                                        "glosses": [
                                            "ein langer, schmaler, farblich abgehobener Abschnitt von einer Fläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a43bf99e-be3d-4885-9b2d-200708c4a132",
                                                "sense_id": "d57cc766-f536-3c57-9e21-b62b7ad725b3",
                                                "text": "Der Pullover hat schwarze und weiße Streifen auf der Vorderseite."
                                            },
                                            {
                                                "example_id": "9870dca3-18ce-4662-a93f-e776809b8c31",
                                                "sense_id": "d57cc766-f536-3c57-9e21-b62b7ad725b3",
                                                "text": "„Der gelbweißgelbe Streifen der Mittellinie schlängelte sich unter den linken Kotflügel und wieder hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34101e57-7317-3c52-98f1-6d319979cdfd",
                                        "entry_id": "2800db46-b4b2-3456-b4c7-1ce3015a9d95",
                                        "glosses": [
                                            "ein langes, schmales Stück Land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7219d55f-9201-4432-8b72-24710a2b28ab",
                                                "sense_id": "34101e57-7317-3c52-98f1-6d319979cdfd",
                                                "text": "Mein Vater besaß nur einen kleinen Streifen Land."
                                            },
                                            {
                                                "example_id": "981b3396-c0e9-4d0a-aa2d-b3ffc0a7f150",
                                                "sense_id": "34101e57-7317-3c52-98f1-6d319979cdfd",
                                                "text": "Im Gaza-Streifen setzt wenige Monate nach dem Krieg zwischen Israel und der Hamas der Winter ein. Das verschärft die Not zehntausender Menschen, die durch die Kämpfe Wohnung und Arbeit verloren haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f57d4cb4-19ff-319e-bbca-e1c38bbc95ce",
                                        "entry_id": "2800db46-b4b2-3456-b4c7-1ce3015a9d95",
                                        "glosses": [
                                            "ein langes, bandartiges Stück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac2e1d93-477e-4600-831c-b52e30009d9b",
                                                "sense_id": "f57d4cb4-19ff-319e-bbca-e1c38bbc95ce",
                                                "text": "Ich brauche einen Streifen Papier."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3fd9a2af-3556-385d-b4f3-0a8ef225e730",
                                        "entry_id": "2800db46-b4b2-3456-b4c7-1ce3015a9d95",
                                        "glosses": [
                                            "ein Film"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38295e4c-c855-4df2-bf85-efa352cf7d9c",
                                                "sense_id": "3fd9a2af-3556-385d-b4f3-0a8ef225e730",
                                                "text": "Wenn der Streifen in die Kinos kommt, wird er ein Superhit!"
                                            },
                                            {
                                                "example_id": "4efd6eeb-6503-4b0c-818f-de64b7e02d70",
                                                "sense_id": "3fd9a2af-3556-385d-b4f3-0a8ef225e730",
                                                "text": "„Für Erwachsene lief der sagenhafte Streifen schon eine Woche, und es hatte nach den atemlosen Berichten mitgenommener Platzanweiserinnen in einem deutschen Kino noch nie so viele genäßte Taschentücher gegeben wie bei diesem Hollywood-Produkt.“"
                                            },
                                            {
                                                "example_id": "37e3d5ac-dea9-4177-9b36-beacd4efcbf5",
                                                "sense_id": "3fd9a2af-3556-385d-b4f3-0a8ef225e730",
                                                "text": "„Als der Streifen abgelaufen war, dehnte jedermann wohlig seine Glieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "146a436d-75ea-38e6-ad1d-02ec4095f824",
                                        "entry_id": "2800db46-b4b2-3456-b4c7-1ce3015a9d95",
                                        "glosses": [
                                            "ein kräftiger Schluck"
                                        ],
                                        "tags": [
                                            "Studentenverbindung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac381a62-5c86-4630-8c41-a3a51cd0e2bb",
                                                "sense_id": "146a436d-75ea-38e6-ad1d-02ec4095f824",
                                                "text": "ein geziemender Streifen"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
