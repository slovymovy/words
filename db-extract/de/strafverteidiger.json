                "senses": [
                    {
                        "sense_id": "8980c504-6af2-3485-bb98-92f32363a71b",
                        "entry_id": "884c752a-b7f4-380f-be37-ae7c6ebc952f",
                        "glosses": [
                            "der dem Angeklagten, dem Beschuldigten bzw. dem Angeschuldigten in einem Strafverfahren zur Seite gestellte Verteidiger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4bdb66d-3eb6-4b72-89ee-2a234b0984c4",
                                "sense_id": "8980c504-6af2-3485-bb98-92f32363a71b",
                                "text": "Nach dem Abschluss der Beweisaufnahme hielt der Strafverteidiger sein Plädoyer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cab412e-8332-41cc-83b4-1e994cd23cb0",
                        "source_entry_id": "884c752a-b7f4-380f-be37-ae7c6ebc952f",
                        "source_sense_id": "8980c504-6af2-3485-bb98-92f32363a71b",
                        "target_lang_word": "criminal defense lawyer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b0cea671-e0a4-4e86-968c-77434d764bbe",
                        "source_entry_id": "884c752a-b7f4-380f-be37-ae7c6ebc952f",
                        "source_sense_id": "8980c504-6af2-3485-bb98-92f32363a71b",
                        "target_lang_word": "counsel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counsel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0703f906-82c3-3bf9-a426-bfc5085d20b5",
                                        "entry_id": "63837a8a-2dcd-3fd6-b3d3-455e1f57bb22",
                                        "glosses": [
                                            "The exchange of opinions and advice especially in legal issues; consultation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd1b423a-8cc6-4604-a83f-8b3bf8fc968f",
                                                "sense_id": "0703f906-82c3-3bf9-a426-bfc5085d20b5",
                                                "text": "Bleſſed is that man that hath not walked in the counſaile of the vngodly: nor ſtand in the waye of ſynners, and hath not ſit in the ſeate of ſkornefull."
                                            },
                                            {
                                                "example_id": "cdda21e9-c232-4384-aeb8-3c2245abcb74",
                                                "sense_id": "0703f906-82c3-3bf9-a426-bfc5085d20b5",
                                                "text": "All the chief priests and elders of the people took counsel against Jesus, to put him to death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3dbf8e-0fae-3849-9f4a-f9d15d799287",
                                        "entry_id": "63837a8a-2dcd-3fd6-b3d3-455e1f57bb22",
                                        "glosses": [
                                            "Exercise of judgment; prudence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4948e30-8c80-46b3-b230-c41eaf557d09",
                                                "sense_id": "2c3dbf8e-0fae-3849-9f4a-f9d15d799287",
                                                "text": "They all confess, therefore, in the working of that first cause, that counsel is used."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7908a73-d261-3fbf-8b91-f60dd3e77af7",
                                        "entry_id": "63837a8a-2dcd-3fd6-b3d3-455e1f57bb22",
                                        "glosses": [
                                            "Advice; guidance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4301bc2-0158-443d-a507-480ba391d98c",
                                                "sense_id": "c7908a73-d261-3fbf-8b91-f60dd3e77af7",
                                                "text": "I like thy counsel; well hast thou advised."
                                            },
                                            {
                                                "example_id": "3d842e08-4af2-4a4e-a5d9-732be5e32e17",
                                                "sense_id": "c7908a73-d261-3fbf-8b91-f60dd3e77af7",
                                                "text": "This Book will make a Travailer of thee, / If by its Counſel thou wilt ruled be; / It will direct thee to the Holy Land, / If thou wilt its Directions understand: / Yea, it will make the ſloathful, active be; / The Blind alſo, delightful things to ſee."
                                            },
                                            {
                                                "example_id": "75d0aecd-67b4-4bb6-af35-eef4e87e85d2",
                                                "sense_id": "c7908a73-d261-3fbf-8b91-f60dd3e77af7",
                                                "text": "It was ill counsel had misled the girl."
                                            },
                                            {
                                                "example_id": "f2f4e0db-2eaf-4336-871a-4116253f4133",
                                                "sense_id": "c7908a73-d261-3fbf-8b91-f60dd3e77af7",
                                                "text": "Further, he suggested strategies and gave counsel to his superiors at Soochow and Ch'ang-chou. (The Governor-General resided temporarily in Ch'ang-chou after the Taiping capture of Nanking in 1853.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59e8acb-42b5-3fcd-be7c-5bf29aae343a",
                                        "entry_id": "63837a8a-2dcd-3fd6-b3d3-455e1f57bb22",
                                        "glosses": [
                                            "Deliberate purpose; design; intent; scheme; plan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "426b4deb-09d7-4bb4-8480-eb0341ec36b1",
                                                "sense_id": "e59e8acb-42b5-3fcd-be7c-5bf29aae343a",
                                                "text": "The counsel of the Lord standeth forever."
                                            },
                                            {
                                                "example_id": "674b1e07-5c99-45a4-809c-26184386e5e0",
                                                "sense_id": "e59e8acb-42b5-3fcd-be7c-5bf29aae343a",
                                                "text": "The counsels of the wicked are deceit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0564cd3-b010-33c6-8a2a-260e178fcd58",
                                        "entry_id": "63837a8a-2dcd-3fd6-b3d3-455e1f57bb22",
                                        "glosses": [
                                            "A lawyer, as in King's Counsel (KC) or Queen's Counsel (QC)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "counsel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2515a56f-7d85-3972-8448-2e4bc8425aba",
                                        "entry_id": "751a92ef-07c8-389f-bb53-b4a1d8ab0474",
                                        "glosses": [
                                            "To give advice, especially professional advice, to (somebody)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "828c77e5-5a06-4de7-a6a3-7ed5a8da5dbf",
                                                "sense_id": "2515a56f-7d85-3972-8448-2e4bc8425aba",
                                                "text": "The lawyer counselled his client to remain silent."
                                            },
                                            {
                                                "example_id": "82978cf1-013c-4b3e-bcaf-6ccc36ed62e8",
                                                "sense_id": "2515a56f-7d85-3972-8448-2e4bc8425aba",
                                                "text": "Psychiatrists, psychologists, social workers and other mental health professionals counsel clients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5367d9f2-35f3-31e6-9c90-07a8b3f493d6",
                                        "entry_id": "751a92ef-07c8-389f-bb53-b4a1d8ab0474",
                                        "glosses": [
                                            "To recommend (a course of action)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b4ce11-825c-4b01-81d0-a0645a67ea28",
                                                "sense_id": "5367d9f2-35f3-31e6-9c90-07a8b3f493d6",
                                                "text": "I would counsel prudence in this matter."
                                            },
                                            {
                                                "example_id": "3bd5f525-9148-4c4b-87e7-87ede934e04d",
                                                "sense_id": "5367d9f2-35f3-31e6-9c90-07a8b3f493d6",
                                                "text": "He counseled his daughter to resist the lure of hatred and bitterness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
