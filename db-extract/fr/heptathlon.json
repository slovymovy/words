        "fr-extract.jsonl": [
            {
                "entry_id": "75a706fb-bce4-336e-aaf4-2f245fe329db",
                "word": "heptathlon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4441f26d-55b4-425b-996b-f06f3e6ebb64",
                        "entry_id": "75a706fb-bce4-336e-aaf4-2f245fe329db",
                        "tags": [
                            "plural"
                        ],
                        "form": "heptathlons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                        "entry_id": "75a706fb-bce4-336e-aaf4-2f245fe329db",
                        "glosses": [
                            "Épreuve sportive constituée de sept disciplines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d9da9b3-2b01-481b-8f72-daeed6cc8142",
                                "sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                                "text": "Enfin en l’absence de la double championne olympique belge Nafissatou Thiam, blessée, l’Américaine Anna Hall fait figure de favorite de l’heptathlon, qui débute ce matin."
                            },
                            {
                                "example_id": "dadab21b-62c5-489d-8b33-d9c2fab117d3",
                                "sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                                "text": "Cette fois, c’est la Syrienne Ghada Shouaa qui décroche une médaille d’or et le championnat du monde dans l’heptathlon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8cefb41-4bdd-48cf-9087-cb1bc248f774",
                        "source_entry_id": "75a706fb-bce4-336e-aaf4-2f245fe329db",
                        "source_sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                        "target_lang_word": "Siebenkampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siebenkampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c55f371a-ee7a-3276-818c-6b0ab0102399",
                                        "entry_id": "78dca850-9986-3725-a71e-2a5684e18c40",
                                        "glosses": [
                                            "Wettkampf in der Leichtathletik, der aus Einzelwettbewerben im Hürdenlauf über 100 m, Hochsprung, Kugelstoßen, Laufen über 200 m, Weitsprung, Speerwurf und Laufen über 800 m besteht; überwiegend wird der Wettkampf für Frauen anstelle des Zehnkampfs der Männer ausgerichtet, in der Halle gibt es auch Wettkämpfe für Männer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0cc966-dc9c-4417-8b35-f702fd0e9a6f",
                                                "sense_id": "c55f371a-ee7a-3276-818c-6b0ab0102399",
                                                "text": "Britta hat bereits drei Siebenkämpfe gewonnen."
                                            },
                                            {
                                                "example_id": "2fb07d4d-5380-4e56-bae7-994b23bd16df",
                                                "sense_id": "c55f371a-ee7a-3276-818c-6b0ab0102399",
                                                "text": "Im Siebenkampf tritt heute ein ganz exzellentes Teilnehmerfeld an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a0e216c-61ea-4b8a-a96a-57299dde008d",
                        "source_entry_id": "75a706fb-bce4-336e-aaf4-2f245fe329db",
                        "source_sense_id": "ca8d03ea-c87b-3f5c-ad39-bee9bd119d73",
                        "target_lang_word": "heptathlon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heptathlon",
