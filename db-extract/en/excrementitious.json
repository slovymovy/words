                        "glosses": [
                            "Of or pertaining to the nature of excrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9318f1d9-b3db-4b67-83d9-da584d0b4821",
                                "sense_id": "9967eb09-d909-39ce-bd86-6562c674115f",
                                "text": "wormwood, and the like, […]dissipate and digest any inutile or excrementitious moisture which lieth in the flesh"
                            },
                            {
                                "example_id": "4b30f86a-67eb-4f85-a489-0da2fd14b697",
                                "sense_id": "9967eb09-d909-39ce-bd86-6562c674115f",
                                "text": "in their excretive faculty in evacuating the excrementicious humours"
                            },
                            {
                                "example_id": "59e7780e-2896-4d77-85bf-fb091cf03eb3",
                                "sense_id": "9967eb09-d909-39ce-bd86-6562c674115f",
                                "text": "[It is an opinion of some moderns] that it [vital flame] requires constant eventilation, through the trachea and pores of the body for the discharge of a fuliginous and excrementitious vapour."
                            },
                            {
                                "example_id": "5054f3b5-a5e5-4f80-874a-52438f268a12",
                                "sense_id": "9967eb09-d909-39ce-bd86-6562c674115f",
                                "text": "Every Genius and Temper, as the sundry sorts of Beasts and living Creatures, have their proper excrement: and it is the part of a wise man to take notice of it, and to chuse what is profitable, as well as to abandon what is useless and excrementitious."
                            },
                            {
                                "example_id": "5a00b61f-5411-41b7-803d-a229e79f9b0c",
                                "sense_id": "9967eb09-d909-39ce-bd86-6562c674115f",
                                "text": "You are to die— […]\nI absolve you from all except yourself, spiritual, bodily—that is eternal,\n(The corpse you will leave will be but excrementitious.)"
                            }
                        ]
                    }
