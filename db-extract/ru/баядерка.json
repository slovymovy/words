                        "form": "баяде́рке"
                    },
                    {
                        "form_id": "742207fe-9799-40d7-9dd2-9a38575de6e0",
                        "entry_id": "0ac74dc7-24dc-36bb-ac12-1b09aaa0ff1c",
                        "tags": [
                            "plural",
