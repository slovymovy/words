                "senses": [
                    {
                        "sense_id": "6981e873-8891-3a90-893a-d9b6a67637ce",
                        "entry_id": "0e45d155-562e-3deb-9a58-6de1cf15bbca",
                        "glosses": [
                            "Situated beneath the Moon."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b754484-690b-4255-ae88-2228a53b0a76",
                                "sense_id": "6981e873-8891-3a90-893a-d9b6a67637ce",
                                "text": "The City’s moon-lit spires and myriad lamps,\nLike stars in a sublunar sky did glow,\nAnd fires blazed far amid the scattered camps,\nLike springs of flame, which burst where’er swift Earthquake stamps."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ef6ee7e-35fb-32ef-b0f5-2410a3a6ba20",
                        "entry_id": "0e45d155-562e-3deb-9a58-6de1cf15bbca",
                        "glosses": [
                            "Of this world; earthly."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
