    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b394a91d-2152-31c9-908c-edb7399f433f",
                    "sense_definition": "Used to express repugnance, disgust, or annoyance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ugh</w>! The bread in the pantry has gone moldy.",
                            "target_lang_translations": {
                                "zh": "<w>呃</w>！储藏室里的面包发霉了。"
                            }
                        },
                        {
                            "text": "<w>Ugh</w>, I have to wake up early tomorrow for work.",
                            "target_lang_translations": {
                                "zh": "<w>哎呀</w>，我明天得早起去上班。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yuck",
                        "ew",
                        "ick",
                        "argh",
                        "blech"
                    ],
                    "common_phrases": [
                        "ugh, gross",
                        "ugh, really",
                        "ugh, please"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于表达厌恶、反感或烦恼的感叹词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呃",
                                "target_lang_sense_clarification": "表示反感或厌恶"
                            },
                            {
                                "target_lang_word": "哎呀",
                                "target_lang_sense_clarification": "表示烦恼或不耐烦"
                            },
                            {
                                "target_lang_word": "呕",
                                "target_lang_sense_clarification": "表示极度恶心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89cc9e6f-3620-33d6-be58-24703f5477fd",
                    "sense_definition": "Used to express inarticulate vocalisations, such as used by a caveman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The caveman pointed at the fire and grunted, \"<w>Ugh</w>!\"",
                            "target_lang_translations": {
                                "zh": "那个原始人指着火堆，发出“<w>呃</w>”的一声。"
                            }
                        },
                        {
                            "text": "He lifted the heavy rock with a strained <w>ugh</w>.",
                            "target_lang_translations": {
                                "zh": "他<w>哼</w>了一声，吃力地举起了那块大石头。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于模拟原始人或用力时发出的含糊声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呃",
                                "target_lang_sense_clarification": "模拟原始人的发声"
                            },
                            {
                                "target_lang_word": "哼",
                                "target_lang_sense_clarification": "用力时发出的声音"
                            }
                        ]
                    }
                }
            ]
        }
    ]
