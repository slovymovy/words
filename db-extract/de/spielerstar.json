                "senses": [
                    {
                        "sense_id": "18bd3523-fa3b-3f00-8f14-9e6fcc12c5de",
                        "entry_id": "912e40a2-80ab-3dc0-bb92-4e96e96eee28",
                        "glosses": [
                            "durch seine Leistungen im Spiel herausragende und weithin bekannte Spielerpersönlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34caa1e3-a47b-45d7-b369-eb6ac1a50bb5",
                                "sense_id": "18bd3523-fa3b-3f00-8f14-9e6fcc12c5de",
                                "text": "„Das passiv genossene, hoch artifizielle Spiel von Spielerstars beherrscht das Spielgeschehen der breiten Bevölkerungsmehrheit.“"
                            },
                            {
                                "example_id": "555733f6-1564-4635-8b31-2764675695c5",
                                "sense_id": "18bd3523-fa3b-3f00-8f14-9e6fcc12c5de",
                                "text": "„So ist ein weiterer Spielerstar für ein bereits gut besetztes, reiches Team weniger wert als für eine sportlich schwächere, ärmere Mannschaft auf Grund seiner geringeren Grenzproduktivität in dem Topteam.“"
                            },
                            {
                                "example_id": "17b5207f-4d21-48cd-82ff-6e8654e2a07c",
                                "sense_id": "18bd3523-fa3b-3f00-8f14-9e6fcc12c5de",
                                "text": "„Reiche und Arme sitzen nun himmelweit voneinander entfernt, und der Spielerstar der Minnesota Twins macht heute 23 Millionen Dollar im Jahr.“"
                            },
                            {
                                "example_id": "dc1f5efe-e268-4634-b9a5-d4a4432e1c35",
                                "sense_id": "18bd3523-fa3b-3f00-8f14-9e6fcc12c5de",
                                "text": "„Vor genau 90 Jahren hat ein Sohn des legendären Fiat-Gründers Giovanni Agnelli das Imperium um den Juventus FC, einen Fußballklub in der Regionalhauptstadt Turin, erweitert, und fast ebenso lange besteht der Familienclan nun darauf, dass sich die Spielerstars eine Woche vor Beginn der Fußballsaison in ihrem Bergtal gegen den eigenen Nachwuchs präsentieren.“"
                            },
                            {
                                "example_id": "32911a75-a8eb-4ac6-85d9-23af2a514fa0",
                                "sense_id": "18bd3523-fa3b-3f00-8f14-9e6fcc12c5de",
                                "text": "„Christian Spiegel und Christian Schwamberger sind extra nach Dallas gereist, um den deutschen Spielerstar bei seiner Titelmission zu unterstützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
