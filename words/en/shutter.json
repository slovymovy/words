                    "semantic_group_id": "roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gate-openers and <w>shutters</w> worked together to manage the cattle flow.",
                            "target_lang_translations": {
                                "ru": "Те, кто открывал и <w>закрывал</w> ворота, работали сообща, чтобы управлять потоком скота.",
                                "cs": "Ti, co otevírali a <w>zavírali</w> brány, spolupracovali na řízení pohybu dobytka.",
                                "tr": "Kapıyı açanlar ve <w>kapatanlar</w>, sığır akışını yönetmek için birlikte çalıştılar."
