                        "entry_id": "ec08d028-7f2b-3ccf-a168-62718b2cdd97",
                        "glosses": [
                            "Ces jolies fesses elles-mêmes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1ea61401-1c37-49cc-b4d5-486e0549f0c0",
                                "sense_id": "86502680-02c6-3139-902b-a84b75606665",
                                "text": "En même temps, il glissait sa large patte sous la jupe de la fille qui ne broncha point et tapotait délicatement une callipygie orgueilleuse et prévenante."
                            }
                        ]
