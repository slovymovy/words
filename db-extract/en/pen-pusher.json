                        "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                        "entry_id": "2f295066-b20f-3121-a533-c579482e5822",
                        "glosses": [
                            "A person who performs routine office work, involving mainly paperwork."
                        ],
                        "tags": [
                            "derogatory",
                            "informal",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "a30bf10a-b1c1-411a-9559-3b812856f212",
                                "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                                "text": "A pen-pusher in a Sixth ave. office said a coal miner is paid well. I asked him if he ever dug coal. Oh no!"
                            },
                            {
                                "example_id": "e6350375-14c8-4444-9685-a959f7808842",
                                "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                                "text": "\"I had to prove to people who were unimportant, who'd never achieved anything in their lives—the administrator, the pen-pusher—that I could fight.\""
                            },
                            {
                                "example_id": "af8722d8-40a6-4d26-ae30-8f998564cf21",
                                "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                                "text": "Investors may have a lopsided view of the company’s reputation simply because an uncaring pen pusher in the finance department responded lethargically to an investor’s query."
                            }
                        ]
                    }
                ],
