                ],
                "senses": [
                    {
                        "sense_id": "7205f825-c07b-3ee1-a296-b1cd7d02f8f1",
                        "entry_id": "81340c70-f29d-3a46-b451-4759f1645bc9",
                        "glosses": [
                            "über die Wahrnehmung von Geruch realisierte, abgerufene Erfahrungen/Informationen, die ein Geruchsbild erzeugt oder neu kreiert/definiert; individuelle Entscheidung = Vergleich mit Geruchserfahrungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca86b8f8-8f8b-420a-9de7-4d5dfc44741f",
                                "sense_id": "7205f825-c07b-3ee1-a296-b1cd7d02f8f1",
                                "text": "„Dadurch werden die eintreffenden Geruchsinformationen vor der Weiterleitung in andere Gehirnregionen gebündelt und leichter verständlich gemacht.“"
                            },
                            {
                                "example_id": "720107a6-cdfe-4593-b120-ec669d6afcac",
                                "sense_id": "7205f825-c07b-3ee1-a296-b1cd7d02f8f1",
                                "text": "„Auf der anderen Seite senden sie die Geruchsinformationen über lange Fortsätze, die Axone, zur Verarbeitungsstation im Gehirn weiter - dem Riechkolben.“"
                            },
                            {
                                "example_id": "74fc2cde-0acf-43c4-aa24-3d72dfffbdd8",
                                "sense_id": "7205f825-c07b-3ee1-a296-b1cd7d02f8f1",
                                "text": "„Die Analyse der Geruchsinformation, das Wiedererkennen bekannter Düfte sowie die Planung und Ausführung sinnvoller Verhaltensmuster aufgrund der Geruchsinformation – all das sind Leistungen des Gehirns.“"
                            },
                            {
                                "example_id": "e827df69-c557-4a3b-9efb-4bae8c475a9b",
                                "sense_id": "7205f825-c07b-3ee1-a296-b1cd7d02f8f1",
                                "text": "„Wer sich gezielt Düften aussetzt und versucht, diese zu kategorisieren, steigert seine Wahrnehmung und kann die Geruchsinformationen besser verarbeiten und benennen.“"
                            },
                            {
                                "example_id": "627d4909-fb2e-4199-bf69-ba898585b6a4",
                                "sense_id": "7205f825-c07b-3ee1-a296-b1cd7d02f8f1",
                                "text": "„Die Rezeptor-Nervenzellen in den Antennen werden durch Duftstoffe angeregt. Sie werden dadurch elektrisch aktiv und leiten diese Information an den sogenannten Antennallobus weiter - die erste Verschaltungsebene der Geruchsinformation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
