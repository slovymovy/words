                                "target_senses": [
                                    {
                                        "sense_id": "a0c7a985-417c-3662-8bf3-abe22b31aa26",
                                        "entry_id": "99b00cdf-c969-3b07-b30d-a3f19f88852f",
                                        "glosses": [
                                            "For an indefinitely long time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4008827b-3a8a-4049-bb2d-bc0948ac0b3f",
                                                "sense_id": "a0c7a985-417c-3662-8bf3-abe22b31aa26",
                                                "text": "bequeathed to the nation in perpetuity"
                                            },
                                            {
                                                "example_id": "43e7eb4c-b81a-45ec-812c-ee8c186ee79d",
                                                "sense_id": "a0c7a985-417c-3662-8bf3-abe22b31aa26",
                                                "text": "The interest payments on consols were in perpetuity."
                                            },
                                            {
                                                "example_id": "6ba28a36-bf71-46c2-a51a-23c8aacdb617",
                                                "sense_id": "a0c7a985-417c-3662-8bf3-abe22b31aa26",
                                                "text": "Queen Victoria travelled to Chingford on May 6, 1882, to dedicate Epping Forest to the public in perpetuity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528dfaf6-63a1-3fb5-821e-62602e3614aa",
                                        "entry_id": "99b00cdf-c969-3b07-b30d-a3f19f88852f",
                                        "glosses": [
                                            "For life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7c16b0-ea06-42f6-b5fe-06bc42be532e",
                                                "sense_id": "528dfaf6-63a1-3fb5-821e-62602e3614aa",
                                                "text": "desire happiness in perpetuity"
                                            },
                                            {
                                                "example_id": "7e00cad2-5f90-4fd9-96e7-9cb6aeaff267",
                                                "sense_id": "528dfaf6-63a1-3fb5-821e-62602e3614aa",
                                                "text": "the annuity was in perpetuity"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
