                "senses": [
                    {
                        "sense_id": "33844e72-7358-3387-aba0-e23c467965ff",
                        "entry_id": "015bb40c-dd5c-35bc-a4b8-7d2541ff972f",
                        "glosses": [
                            "Soldat der Bundeswehr"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "37223ac4-b32d-4d50-8100-22c435b33170",
                                "sense_id": "33844e72-7358-3387-aba0-e23c467965ff",
                                "text": "„Es sei frustrierend, hierher zu kommen und nichts mehr tun zu können, sagte ein Bundeswehrsoldat.“"
                            },
                            {
                                "example_id": "e9179844-0281-428a-ac5e-9be184aeeb00",
                                "sense_id": "33844e72-7358-3387-aba0-e23c467965ff",
                                "text": "„Um Zeit und damit Geld zu sparen, hätten die Filmemacher für diese Szenen am liebsten Bundeswehrsoldaten eingesetzt.“"
                            },
                            {
                                "example_id": "6cd3eb73-9cf0-40bc-a502-e8b4f899484a",
                                "sense_id": "33844e72-7358-3387-aba0-e23c467965ff",
                                "text": "„Die Beamten kamen dem Leid der Menschen nicht hinterher, sogar Bundeswehrsoldaten wurden zu Hilfe gerufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
