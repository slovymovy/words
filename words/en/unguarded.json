{
    "word_family": [
        "guard",
        "guardian",
        "guardianship",
        "unguardedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98b97bbc-06ee-32da-99f2-84e27acb0894",
                    "sense_definition": "Having no guard or protection; vulnerable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>unguarded</w> gatehouse was soon taken by the invading army.",
                            "target_lang_translations": {
                                "pl": "<w>Niestrzeżona</w> strażnica została szybko zajęta przez armię najeźdźców."
                            }
                        },
                        {
                            "text": "He left his bicycle <w>unguarded</w> outside the busy shop.",
                            "target_lang_translations": {
                                "pl": "Zostawił swój rower <w>bez opieki</w> przed ruchliwym sklepem."
                            }
                        }
                    ],
                    "synonyms": [
                        "unprotected",
                        "vulnerable",
                        "defenseless"
                    ],
                    "antonyms": [
                        "guarded",
                        "protected"
                    ],
                    "common_phrases": [
                        "left unguarded"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbawiony ochrony lub zabezpieczenia; narażony na niebezpieczeństwo."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niestrzeżony",
                                "target_lang_sense_clarification": "odnoszące się do miejsca lub obiektu bez nadzoru"
                            },
                            {
                                "target_lang_word": "bezbronny",
                                "target_lang_sense_clarification": "odnoszące się do osoby lub rzeczy narażonej na atak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02823815-59e6-3051-bc22-8f0b921be34d",
                    "sense_definition": "Displaying a lack of caution or thought.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I let out her secret in an <w>unguarded</w> moment.",
                            "target_lang_translations": {
                                "pl": "Wypaplałem jej sekret w <w>nieostrożnej</w> chwili."
                            }
                        },
                        {
                            "text": "He made an <w>unguarded</w> comment that offended his boss.",
                            "target_lang_translations": {
                                "pl": "Poczynił <w>nieostrożną</w> uwagę, która uraziła jego szefa."
                            }
                        }
                    ],
                    "synonyms": [
                        "careless",
                        "thoughtless",
                        "imprudent"
                    ],
                    "antonyms": [
                        "cautious",
                        "careful"
                    ],
                    "common_phrases": [
                        "unguarded moment",
                        "unguarded comment"
                    ],
                    "target_lang_definitions": {
                        "pl": "Cechujący się brakiem ostrożności lub przemyślenia; nieostrożny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieostrożny",
                                "target_lang_sense_clarification": "odnoszące się do wypowiedzi lub zachowania bez namysłu"
                            },
                            {
                                "target_lang_word": "niefortunny",
                                "target_lang_sense_clarification": "odnoszące się do niefortunnej wypowiedzi lub momentu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}