                "senses": [
                    {
                        "sense_id": "c8cbd7ff-c689-3fe0-b123-a2749e4acbaa",
                        "entry_id": "d8a1acbc-f114-3f65-9a5a-7a1551c3c67a",
                        "glosses": [
                            "Autofahrer, der sein Auto an einer Stelle abstellt, an der es nicht erlaubt ist (beispielsweise im Parkverbot)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d742332c-bec6-488d-93b1-c9053ece2478",
                                "sense_id": "c8cbd7ff-c689-3fe0-b123-a2749e4acbaa",
                                "text": "„Die meisten Falschparker zahlen fürs Abschleppen, um ihr Auto schnell wiederzubekommen - ein Mann aber wehrte sich gegen die nach seiner Ansicht zu hohe Forderung eines privaten Abschleppdienstes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79f8ddd3-6f88-4574-af8c-dc6d08eb7107",
                        "source_entry_id": "d8a1acbc-f114-3f65-9a5a-7a1551c3c67a",
                        "source_sense_id": "c8cbd7ff-c689-3fe0-b123-a2749e4acbaa",
                        "target_lang_word": "foutparkeerder",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foutparkeerder",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f0e6cd07-9570-3ff8-b432-221d8a361a37",
                                        "entry_id": "27bac400-6a19-36d9-a268-08fade473992",
                                        "glosses": [
                                            "persoon die zijn auto op een plaats heeft gezet waarop dat verboden is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef11f84-72c6-432f-b1c0-53a7b5c850e1",
                                                "sense_id": "f0e6cd07-9570-3ff8-b432-221d8a361a37",
                                                "text": "De vrouw raakte in paniek toen ze terugkwam en zag dat haar auto met baby en al was verdwenen. Een andere ouder vermoedde dat de auto was weggesleept en bracht de foutparkeerder naar het kantoor van de Parijse sleepdienst. Daar stond inderdaad de wagen, en de baby lag nog steeds achterin te slapen."
                                            },
                                            {
                                                "example_id": "90614fc5-e420-4009-a5f8-0a2f7920f931",
                                                "sense_id": "f0e6cd07-9570-3ff8-b432-221d8a361a37",
                                                "text": "Een 61-jarige man heeft vanochtend in Someren een invalide man in elkaar geslagen toen die hem aansprak op zijn parkeergedrag. Daarna mishandelde de foutparkeerder ook een vrouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
