                            {
                                "example_id": "a7e95c90-7454-422d-a634-f51abea56390",
                                "sense_id": "efeb9c56-f3ad-3053-9e8e-3357cdedaae3",
                                "text": "La ficoïde (Mesembryanthemum crinifolium) – pour faire plus simple, nommons-là mésembryanthème à fleurs de crinum – est une espèce annuelle de ficoïde aux innombrables fleurs blanches, roses, rouges ou jaunes, qui s’épanouissent tout l’été."
                            }
                        ]
                    },
