                                    {
                                        "sense_id": "fd597caa-e939-36b9-93d9-dbb8031583de",
                                        "entry_id": "8b468844-d893-35a8-ab9e-19d5814aff1f",
                                        "glosses": [
                                            "einige Gemeinschaften in Nordafrika"
                                        ],
                                        "tags": [
                                            "Volksstamm"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "229d8c94-5807-4091-b9ae-01dc223598e2",
                                                "sense_id": "fd597caa-e939-36b9-93d9-dbb8031583de",
                                                "text": "Berber ist ein Oberbegriff für eine Reihe von Gemeinschaften in Nordafrika westlich des Nils, die eine Berbersprache sprechen."
                                            },
                                            {
                                                "example_id": "5f846f16-8656-4585-91f0-6949e0000619",
                                                "sense_id": "fd597caa-e939-36b9-93d9-dbb8031583de",
                                                "text": "„Paramilitärische und reguläre Einheiten griffen daraufhin die Araber und Berber an, auch mit Bomben.“"
                                            },
                                            {
                                                "example_id": "6eae490e-28ed-4e40-b1bf-799eeee7a5c7",
                                                "sense_id": "fd597caa-e939-36b9-93d9-dbb8031583de",
                                                "text": "„Die Berber gründen in der Folgezeit eigene Königreiche, die durch die Kontrolle der Karawanenwege in der Sahara reich werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fdbaf52-3c30-3d63-9f98-14957aa35860",
                                        "entry_id": "8b468844-d893-35a8-ab9e-19d5814aff1f",
                                        "glosses": [
                                            "eine der ältesten Pferderassen weltweit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8d449d-c730-45ee-a7ee-8e1b60ea0117",
                                                "sense_id": "1fdbaf52-3c30-3d63-9f98-14957aa35860",
                                                "text": "Der Berber ist neben dem Arabischen Vollblut eine der ältesten Pferderassen weltweit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ed4f11e2-6b90-36cf-b78e-90ed061137a1",
                                        "entry_id": "8b468844-d893-35a8-ab9e-19d5814aff1f",
                                        "glosses": [
                                            "Angehöriger sozial organisierter Gruppen nicht sesshafter Obdachloser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebfbbb4-87f8-45c5-85bd-a74d6dc27a76",
                                                "sense_id": "ed4f11e2-6b90-36cf-b78e-90ed061137a1",
                                                "text": "Unter Berbern versteht man in Deutschland die Angehörigen sozial organisierter Gruppen nicht sesshafter Obdachloser."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
