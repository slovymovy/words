                    "semantic_group_id": "beruehren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das kleine Kind möchte den Hund vorsichtig <w>streicheln</w>."
                        },
                        {
                            "text": "Anna sitzt gemütlich auf dem Sofa und <w>streichelt</w> glücklich ihre Katze."
                        }
                    ],
