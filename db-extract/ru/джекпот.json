                "senses": [
                    {
                        "sense_id": "e9863b0b-0595-3feb-8ac2-8d331ec2ade9",
                        "entry_id": "e0e79d48-5238-3012-885c-9cf2e19c998a",
                        "glosses": [
                            "игр. самый крупный выигрыш в лотерее за счёт присоединения суммы, не выигранной в предыдущем тираже"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "617a5eb9-4cb2-476f-a0c7-e766a4913c72",
                                "sense_id": "e9863b0b-0595-3feb-8ac2-8d331ec2ade9",
                                "text": "Кровь там проливается вёдрами, а стреляные гильзы сыплются, как джекпот из игрового автомата."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5be232a0-d045-458d-bc61-8a61c53b25b2",
                        "source_entry_id": "e0e79d48-5238-3012-885c-9cf2e19c998a",
                        "source_sense_id": "e9863b0b-0595-3feb-8ac2-8d331ec2ade9",
                        "target_lang_word": "jackpot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jackpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e7141e-f4fc-37cc-8ea4-00111d609770",
                                        "entry_id": "edf560ef-717b-3375-acc7-8084a0560354",
                                        "glosses": [
                                            "A money prize pool which accumulates until the conditions are met for it to be won."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3341b7ad-617d-49aa-b438-533c64914a4c",
                                                "sense_id": "e1e7141e-f4fc-37cc-8ea4-00111d609770",
                                                "text": "If no player picks all six numbers correctly, the jackpot is rolled over and added to the next week's jackpot; several weeks of rollovers can build up jackpots up to $350 million or more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8f4d228-5568-396a-9824-2e46e3270576",
                                        "entry_id": "edf560ef-717b-3375-acc7-8084a0560354",
                                        "glosses": [
                                            "A large cash prize or money."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56684075-32d8-306a-87b9-814daab9f6e8",
                                        "entry_id": "edf560ef-717b-3375-acc7-8084a0560354",
                                        "glosses": [
                                            "An unexpected windfall or reward."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13b51566-42eb-3886-bba6-9526707953ad",
                                        "entry_id": "edf560ef-717b-3375-acc7-8084a0560354",
                                        "glosses": [
                                            "A concentration of surface wood or fuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd2f3af3-5818-463b-afee-d92335fe4340",
                                                "sense_id": "13b51566-42eb-3886-bba6-9526707953ad",
                                                "text": "a juniper jackpot"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f438dc82-4df0-3abb-9b79-4021cc2b5d53",
                                        "entry_id": "edf560ef-717b-3375-acc7-8084a0560354",
                                        "glosses": [
                                            "A large accumulated point bonus, originally awarded after a long set of actions but now often easily available in multiball modes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jackpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc2cb14-d197-3710-a983-e08448abbbe6",
                                        "entry_id": "95c2baa0-eaca-37d9-9c45-593fa9011610",
                                        "glosses": [
                                            "Of a slot machine, to issue a jackpot."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b227965-a91f-4d88-a263-8309a19b39b3",
                                                "sense_id": "5cc2cb14-d197-3710-a983-e08448abbbe6",
                                                "text": "I went into the Las Vegas Casino and played $20 in a nickel slot, and it jackpotted for $300."
                                            },
                                            {
                                                "example_id": "6ecaaf84-d39d-4cf9-bd01-e15b74f5d6b6",
                                                "sense_id": "5cc2cb14-d197-3710-a983-e08448abbbe6",
                                                "text": "She sought out the machines along the aisles, the ones most frequently used, stuffed with tokens, especially likely to jackpot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f477da34-0862-3965-a4da-e2844ab5d40b",
                                        "entry_id": "95c2baa0-eaca-37d9-9c45-593fa9011610",
                                        "glosses": [
                                            "To fraudulently exploit an automatic teller machine so that it dispenses cash that has not been withdrawn from an account."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jackpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f28bc8-a1eb-37e0-9e81-aedf15fe8cfc",
                                        "entry_id": "606dfc87-6cee-303b-9a46-28f37ca29e29",
                                        "glosses": [
                                            "A ball game in which a thrower calls out a point value and whether the ball must be caught \\\"alive\\\" (in the air) or \\\"dead\\\" (having touched the ground), and a group of catchers compete to catch the ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5452bf-d5c7-461d-85c2-33f1e980d412",
                                                "sense_id": "c0f28bc8-a1eb-37e0-9e81-aedf15fe8cfc",
                                                "text": "As a little girl, I was something of a tomboy. I played jackpot in the mud at recess, and my Christmas wish lists consisted of baseball mitts and remote controlled cars."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jackpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "529f4c14-8b0c-376d-b4d0-bf87245830e0",
                                        "entry_id": "35b24cac-802b-37c4-8b1a-bc63f1e63544",
                                        "glosses": [
                                            "A difficult situation."
                                        ],
                                        "tags": [
                                            "US",
                                            "Western"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae9bccba-1935-4c0f-a96f-dc0a5154a10f",
                                                "sense_id": "529f4c14-8b0c-376d-b4d0-bf87245830e0",
                                                "text": "and if you are not next to the ways and customs, the first thing you know you are in a jackpot so big four one spots would not be openers. I don't know what that last expression means, but I heard a fellow use it, and he was talking about a fellow that was in a very bad fix."
                                            },
                                            {
                                                "example_id": "d0b583df-ab16-45b5-8f38-b79c97f1ee61",
                                                "sense_id": "529f4c14-8b0c-376d-b4d0-bf87245830e0",
                                                "text": "\"I'm in a jackpot.\" Sympathy shone from those friendly eyes at once. \"It's shore too bad for a lady to be in a jackpot,\" he answered me earnestly."
                                            },
                                            {
                                                "example_id": "dbc3fdd9-4889-432f-bfde-116b1af940b9",
                                                "sense_id": "529f4c14-8b0c-376d-b4d0-bf87245830e0",
                                                "text": "You're already in a jackpot, he said. I'm tryin to get you out of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4756afe3-d0dc-3efd-8a09-cdca99a0d273",
                                        "entry_id": "35b24cac-802b-37c4-8b1a-bc63f1e63544",
                                        "glosses": [
                                            "A jumble of felled timber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26130184-1171-486d-ac33-84be4a29d713",
                                                "sense_id": "4756afe3-d0dc-3efd-8a09-cdca99a0d273",
                                                "text": "It frequently happens that trees fall across one another, forming what is known as a jackpot. A number of trees may fall in a single jackpot. One of the tools with which appellant claims a bucker should be provided is an undercutter rigging. When trees are in a jackpot, the proper method of procedure is to first cut the lower tree, and then the upper one. This lessens the liability of an upper log rolling or falling upon the workman while he Is engaged in cutting the lower tree. The cut of the lower tree is ordinarily made by sawing it from the upper side, but, when its position produces a strain which pinches the saw, it is sawed from the under side by what is known as an undercut. To make an undercut, it is necessary to have some appliance to support the moving saw which is then operated teeth upward. The appliance which appellant contends Is ordinarily used is known as an undercutter rigging. Having no undercutter rigging, appellant requested respondent's foreman to provide one, complaining that his work in a jackpot of large trees without one was unsafe and dangerous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
