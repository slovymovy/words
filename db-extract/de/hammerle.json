                ],
                "senses": [
                    {
                        "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                        "entry_id": "6c2a047b-2656-3603-9118-ed41c2a2e92e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db2d056-fc48-482f-9924-8b78d74b9f7c",
                                "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                                "text": "Frau Hammerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9f8865e9-bba4-48f7-a602-309824344b39",
                                "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                                "text": "Herr Hammerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "20888427-d168-456b-a0e6-2675c4a00a18",
                                "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                                "text": "Die Hammerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "f716383b-a064-4450-8dc1-494773458ba3",
                                "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                                "text": "Der Hammerle trägt nie die Pullover, die die Hammerle ihm strickt."
                            },
                            {
                                "example_id": "9d35ced5-19ce-4ec0-bf79-d0f0d8ae2ebe",
                                "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hammerle kommt, geht der Herr Hammerle.“"
                            },
                            {
                                "example_id": "c0a6a41a-da7c-4d71-8fa4-1eeb8cffe322",
                                "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                                "text": "Hammerle kommt und geht."
                            },
                            {
                                "example_id": "3e48b410-ca4a-445f-8cb4-0b67a47bb488",
                                "sense_id": "6006e614-4e0f-356f-b52f-82d36b816c6e",
                                "text": "Hammerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
