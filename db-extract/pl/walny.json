                                "target_senses": [
                                    {
                                        "sense_id": "45677357-42cb-3d2a-a648-0be25ac7e2d8",
                                        "entry_id": "9660c5d1-07a1-30a9-a87c-56c0a912e03f",
                                        "glosses": [
                                            "Having the power or quality of deciding a question or controversy; putting an end to contest or controversy; final; conclusive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3702dc01-98a2-4bec-8064-67646e30dd69",
                                                "sense_id": "45677357-42cb-3d2a-a648-0be25ac7e2d8",
                                                "text": "decisive vote"
                                            },
                                            {
                                                "example_id": "011b0aa9-eb74-458e-9f01-b255e55dd31b",
                                                "sense_id": "45677357-42cb-3d2a-a648-0be25ac7e2d8",
                                                "text": "decisive battle"
                                            },
                                            {
                                                "example_id": "5408a936-0c65-4c6b-a3e1-814afa2d6bfe",
                                                "sense_id": "45677357-42cb-3d2a-a648-0be25ac7e2d8",
                                                "text": "In truth, Tottenham never really looked like taking all three points and this defeat means they face a battle to reach the knockout stages -with their next home game against PAOK Salonika on 30 November likely to prove decisive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb29a84b-c6f9-3791-8440-3fead8d9b8fb",
                                        "entry_id": "9660c5d1-07a1-30a9-a87c-56c0a912e03f",
                                        "glosses": [
                                            "Decided; definite; incontrovertible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efaa2ebe-13cf-4f9f-a0d3-b4e8a93a9198",
                                                "sense_id": "eb29a84b-c6f9-3791-8440-3fead8d9b8fb",
                                                "text": "decisive victory"
                                            },
                                            {
                                                "example_id": "d72d4732-006b-4b95-9624-6483389e9646",
                                                "sense_id": "eb29a84b-c6f9-3791-8440-3fead8d9b8fb",
                                                "text": "[F]abulous forces are there encountered and a decisive victory is won: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aa798c0-7fc2-3989-82e1-be155068448a",
                                        "entry_id": "9660c5d1-07a1-30a9-a87c-56c0a912e03f",
                                        "glosses": [
                                            "Marked by promptness and decision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d313489-d36a-4ac2-9e4a-ea42c381ee31",
                                                "sense_id": "4aa798c0-7fc2-3989-82e1-be155068448a",
                                                "text": "decisive action"
                                            },
                                            {
                                                "example_id": "a6e9022f-dc47-4909-8939-2a9d61bf11bf",
                                                "sense_id": "4aa798c0-7fc2-3989-82e1-be155068448a",
                                                "text": "A noble instance of this attribute of the decisive character."
                                            }
                                        ]
