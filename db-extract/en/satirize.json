                                    {
                                        "sense_id": "2277f01b-7c8d-398d-b033-96ec86d554a4",
                                        "entry_id": "f57de4e0-9263-393b-baea-a036248b317e",
                                        "glosses": [
                                            "Railler quelqu’un d’une manière mordante, satirique."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f591fe66-b159-4591-8d68-b8ad27a25074",
                                                "sense_id": "2277f01b-7c8d-398d-b033-96ec86d554a4",
                                                "text": "C’est un homme qui satirise ses meilleurs amis."
                                            },
                                            {
                                                "example_id": "5915c85e-1c48-4b44-8f4f-82666f8f782e",
                                                "sense_id": "2277f01b-7c8d-398d-b033-96ec86d554a4",
                                                "text": "Il ne fait autre chose que satiriser."
                                            },
                                            {
                                                "example_id": "dab93f40-41cc-4b3c-8de8-da6858729fdb",
                                                "sense_id": "2277f01b-7c8d-398d-b033-96ec86d554a4",
                                                "text": "Satiriser finement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9161adb7-d437-4f6d-ba8c-71898ec885d6",
