                    },
                    {
                        "translation_id": "4453a55a-1c50-4f47-9748-cfba52def7c6",
                        "source_entry_id": "3c392a1a-3208-34ff-83cc-4c64332bca7e",
                        "source_sense_id": "a69b0934-efc5-3f30-808e-fddbf36f8e13",
                        "source_sense_description": "Tätigkeit, bei der mit Nadel und Garn ein Stück Stoff verziert wird",
                        "target_lang_word": "broderie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broderie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74a79014-d302-341c-be23-021e26e50864",
                                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                                        "glosses": [
                                            "Action de broder."
                                        ],
                                        "tags": [
                                            "Broderie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                                        "glosses": [
                                            "Ouvrage que l’on fait en brodant."
                                        ],
                                        "tags": [
                                            "Broderie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9067aecd-cc85-408f-b5db-7e8c5a943b94",
                                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                                "text": "Et elle glissa dans son corsage, tout raide de broderies et de diamants, cette lettre qui sortait du pourpoint du jeune homme, […]."
                                            },
                                            {
                                                "example_id": "b27b72f2-36dc-496d-813c-7c239ad7ba24",
                                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                                "text": "La soie artificielle. […]. Pour certains articles, notamment la passementerie, la rubannerie, les broderies brillantes, on la préfère à la soie naturelle; […]."
                                            },
                                            {
                                                "example_id": "7629b494-807f-4046-927d-abf5b6580f43",
                                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                                "text": "Souvent, à mi-pente, le touriste aperçoit les grosses touffes jaunes des genêts, une broderie d'orfroi court sous les taillis; […]."
                                            },
                                            {
                                                "example_id": "6a469d37-772e-4ce8-8451-c0fb89f9dd20",
                                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                                "text": "Quand il revint, il portait sous son bras trois ou quatre livres. Je n’en puis dire le nombre exact, car ce n’étaient que des liasses de feuilles imprimées, dont les bords jaunis et rongés par le temps rappelaient les broderies du pantalon de ma grand-mère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6be631c6-3e32-3fec-b5ea-1b19774f6124",
                                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                                        "glosses": [
                                            "Détail ou circonstance, que l’on ajoute à un récit pour l’embellir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9f89f91-008e-425c-a5ef-d85344d69cf0",
                                                "sense_id": "6be631c6-3e32-3fec-b5ea-1b19774f6124",
                                                "text": "Il y a de la broderie, un peu de broderie dans ce que vous dites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "807e2043-46e4-3132-9f50-6918adfd6be1",
                                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                                        "glosses": [
                                            "Dissonance passagère, consistant en une ou plusieurs notes étrangères suivant, sur un temps faible, une note réelle avant de revenir à cette même note sur un temps fort."
