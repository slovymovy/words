{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "575ad28b-2314-3866-be31-78c09f8e6c8d",
                    "sense_definition": "To stop or intercept someone unexpectedly, especially in order to talk to them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intercept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reporters tried to <w>waylay</w> the senator as she walked out of the committee meeting.",
                            "target_lang_translations": {
                                "zh": "参议员刚走出委员会会议室，记者们就试图<w>拦住</w>她。"
                            }
                        },
                        {
                            "text": "I was <w>waylaid</w> by an old colleague on my way to lunch and arrived late.",
                            "target_lang_translations": {
                                "zh": "我去吃午饭的路上被一位老同事<w>拦住</w>了，结果迟到了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buttonhole"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指为与某人交谈而）半路拦截，拦住"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拦住",
                                "target_lang_sense_clarification": "中途拦截交谈"
                            },
                            {
                                "target_lang_word": "拦截",
                                "target_lang_sense_clarification": "中途截停某人"
                            },
                            {
                                "target_lang_word": "半路拦下",
                                "target_lang_sense_clarification": "在途中挡住某人以便说话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e08bcaa-1e02-37e5-8274-1e1f7aaf9c43",
                    "sense_definition": "To lie in wait for and attack someone from ambush.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ambush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bandits used to <w>waylay</w> travelers along the mountain pass and rob them of their goods.",
                            "target_lang_translations": {
                                "zh": "土匪过去常在山口<w>伏击</w>过往旅客，抢劫他们的财物。"
                            }
                        },
                        {
                            "text": "The soldiers were <w>waylaid</w> in the narrow gorge before they could reach safety.",
                            "target_lang_translations": {
                                "zh": "士兵们还没来得及撤到安全地带，就在狭窄的峡谷中遭到了<w>伏击</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ambush"
                    ],
                    "target_lang_definitions": {
                        "zh": "埋伏突袭，伏击（以便抢劫或伤害）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "伏击",
                                "target_lang_sense_clarification": "埋伏袭击"
                            },
                            {
                                "target_lang_word": "埋伏袭击",
                                "target_lang_sense_clarification": "暗中埋伏并进行攻击"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}