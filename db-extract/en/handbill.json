                                "target_senses": [
                                    {
                                        "sense_id": "84b78ff1-e0dd-3431-8b61-cd71ceadf090",
                                        "entry_id": "8794275f-eb9f-393a-822a-367fe472dbdf",
                                        "glosses": [
                                            "Blatt Papier mit Infos zum Verteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "638682d4-e2c5-4072-a7c9-44a598edc793",
                                                "sense_id": "84b78ff1-e0dd-3431-8b61-cd71ceadf090",
                                                "text": "„Es gab ein paar Verhaftungen, darauf zum erstenmal einen Schwarm von Handzetteln gegen die Nazis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
