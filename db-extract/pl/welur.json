                                        "sense_id": "e9ea39ef-ff2d-3719-8d92-d2dfe84876da",
                                        "entry_id": "8eab0aeb-cb07-337c-8e53-db223e7f3e1b",
                                        "glosses": [
                                            "Epidermis de las frutas, raíces y tubérculos."
