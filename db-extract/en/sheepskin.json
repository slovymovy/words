                                        "sense_id": "e582d1ed-8a7e-3518-8ed9-b41fb14e3a74",
                                        "entry_id": "dc61ddb7-5f02-3b6d-821c-dde3835d1777",
                                        "glosses": [
                                            "Pelz aus Schafswolle"
                                        ],
                                        "tags": [],
