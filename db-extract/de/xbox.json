                                            {
                                                "example_id": "209b8ce1-0480-4257-8f72-44ab148a2af3",
                                                "sense_id": "ab1d033d-316b-37ea-a5e3-a32574bb4b26",
                                                "text": "The Xbox or the Arcade Game Box? That's weird. They knocked off the look of the Xbox with the PlayStation controller."
