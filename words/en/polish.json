{
    "word_family": [
        "polisher",
        "unpolished",
        "repolish"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45245ae8-4980-3edf-bea4-42e63b09f85e",
                    "sense_definition": "To make a surface smooth and shiny by rubbing it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a soft cloth to <w>polish</w> the silver until it sparkled.",
                            "target_lang_translations": {
                                "ru": "Он использовал мягкую ткань, чтобы <w>отполировать</w> серебро до блеска.",
                                "zh": "他用一块软布把银器<w>擦亮</w>，直到它闪闪发光。"
                            }
                        },
                        {
                            "text": "You should <w>polish</w> furniture regularly to keep the wood looking new.",
                            "target_lang_translations": {
                                "ru": "Мебель следует регулярно <w>натирать</w>, чтобы дерево выглядело как новое.",
                                "zh": "你应该定期给家具<w>抛光</w>，以保持木材看起来像新的一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shine",
                        "buff",
                        "smooth",
                        "wax"
                    ],
                    "common_phrases": [
                        "polish furniture",
                        "polish silver",
                        "polish the floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать поверхность гладкой и блестящей путем натирания.",
                        "zh": "通过擦拭使表面变得光滑且有光泽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полировать",
                                "target_lang_sense_clarification": "придавать блеск"
                            },
                            {
                                "target_lang_word": "натирать",
                                "target_lang_sense_clarification": "до блеска"
                            },
                            {
                                "target_lang_word": "шлифовать",
                                "target_lang_sense_clarification": "делать гладким"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦亮",
                                "target_lang_sense_clarification": "使表面发亮"
                            },
                            {
                                "target_lang_word": "抛光",
                                "target_lang_sense_clarification": "工业或精细处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caa836b3-d90e-335a-924f-f7f03bf808e0",
                    "sense_definition": "To apply a cleaning substance specifically to shoes.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "shine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>polish</w> shoes every morning before going to work.",
                            "target_lang_translations": {
                                "ru": "Ему приходилось <w>чистить</w> туфли каждое утро перед уходом на работу.",
                                "zh": "他每天早上上班前都得<w>擦</w>鞋。"
                            }
                        },
                        {
                            "text": "It is important to <w>polish</w> leather boots to protect them from rain.",
                            "target_lang_translations": {
                                "ru": "Важно <w>чистить</w> кожаные ботинки кремом, чтобы защитить их от дождя.",
                                "zh": "给皮靴<w>上油</w>很重要，这样可以保护它们免受雨水侵蚀。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shine"
                    ],
                    "common_phrases": [
                        "polish shoes",
                        "polish boots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить чистящее вещество специально на обувь.",
                        "zh": "专门用于鞋子的清洁或护理物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "обувь кремом"
                            },
                            {
                                "target_lang_word": "натирать",
                                "target_lang_sense_clarification": "обувь до блеска"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦",
                                "target_lang_sense_clarification": "清洁鞋子"
                            },
                            {
                                "target_lang_word": "上油",
                                "target_lang_sense_clarification": "涂抹鞋油"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca8f2f5c-f5f4-3bb3-8c6b-93439a719ee0",
                    "sense_definition": "To improve or refine something by removing small flaws.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author needs to <w>polish</w> the manuscript before sending it to the publisher.",
                            "target_lang_translations": {
                                "ru": "Автору нужно <w>отшлифовать</w> рукопись перед отправкой в издательство.",
                                "zh": "作者在把手稿寄给出版商之前需要进行<w>润色</w>。"
                            }
                        },
                        {
                            "text": "The band spent weeks in the studio to <w>polish</w> their performance for the tour.",
                            "target_lang_translations": {
                                "ru": "Группа провела недели в студии, чтобы <w>отточить</w> свое исполнение для турне.",
                                "zh": "乐队在录音室里花了数周时间来<w>打磨</w>他们的巡演表现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "refine",
                        "perfect",
                        "hone"
                    ],
                    "common_phrases": [
                        "polish a performance",
                        "polish a skill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать или совершенствовать что-либо, устраняя мелкие недостатки.",
                        "zh": "通过消除细微缺陷来改进或完善某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттачивать",
                                "target_lang_sense_clarification": "мастерство или навык"
                            },
                            {
                                "target_lang_word": "шлифовать",
                                "target_lang_sense_clarification": "дорабатывать детали"
                            },
                            {
                                "target_lang_word": "совершенствовать",
                                "target_lang_sense_clarification": "улучшать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "润色",
                                "target_lang_sense_clarification": "修改文章或作品"
                            },
                            {
                                "target_lang_word": "打磨",
                                "target_lang_sense_clarification": "改进技能或表现"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4cfe58c0-5e52-31f0-af74-2f41b352bfd6",
                    "sense_definition": "A substance, such as a liquid or cream, used to make something shiny.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a bottle of nail <w>polish</w> in a bright red color.",
                            "target_lang_translations": {
                                "ru": "Она купила флакон <w>лака</w> для ногтей ярко-красного цвета.",
                                "zh": "她买了一瓶鲜红色的<w>指甲油</w>。"
                            }
                        },
                        {
                            "text": "Apply a small amount of shoe <w>polish</w> to the leather with a brush.",
                            "target_lang_translations": {
                                "ru": "Нанесите небольшое количество <w>крема</w> для обуви на кожу с помощью щетки.",
                                "zh": "用刷子蘸取少量<w>鞋油</w>涂在皮革上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wax"
                    ],
                    "common_phrases": [
                        "nail polish",
                        "shoe polish",
                        "silver polish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, такое как жидкость или крем, используемое для придания блеска.",
                        "zh": "用于使物体表面产生光泽的液体或膏状物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лак",
                                "target_lang_sense_clarification": "для ногтей"
                            },
                            {
                                "target_lang_word": "крем",
                                "target_lang_sense_clarification": "для обуви"
                            },
                            {
                                "target_lang_word": "полироль",
                                "target_lang_sense_clarification": "средство для блеска"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指甲油",
                                "target_lang_sense_clarification": "用于指甲"
                            },
                            {
                                "target_lang_word": "鞋油",
                                "target_lang_sense_clarification": "用于鞋子"
                            },
                            {
                                "target_lang_word": "抛光剂",
                                "target_lang_sense_clarification": "通用清洁剂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "538abba5-87da-3ff0-be63-11d4b7a53869",
                    "sense_definition": "A smooth and bright surface finish produced by rubbing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marble floor had a high <w>polish</w> that reflected the ceiling lights.",
                            "target_lang_translations": {
                                "ru": "Мраморный пол имел сильный <w>блеск</w>, в котором отражались потолочные светильники.",
                                "zh": "大理石地板有着极高的<w>光泽</w>，映照出了天花板的灯光。"
                            }
                        },
                        {
                            "text": "After hours of work, the car had a beautiful <w>polish</w>.",
                            "target_lang_translations": {
                                "ru": "После нескольких часов работы машина приобрела прекрасный <w>глянец</w>.",
                                "zh": "经过几个小时的工作，这辆车呈现出迷人的<w>光泽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shine",
                        "sheen",
                        "finish",
                        "smoothness"
                    ],
                    "common_phrases": [
                        "high polish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гладкая и яркая поверхность, полученная в результате натирания.",
                        "zh": "通过擦拭而形成的平滑且明亮的表面状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "сияние поверхности"
                            },
                            {
                                "target_lang_word": "глянец",
                                "target_lang_sense_clarification": "гладкий отблеск"
                            },
                            {
                                "target_lang_word": "полировка",
                                "target_lang_sense_clarification": "качество отделки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "光泽",
                                "target_lang_sense_clarification": "表面反射的光亮"
                            },
                            {
                                "target_lang_word": "亮度",
                                "target_lang_sense_clarification": "表面平滑程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28f45b80-9868-360a-9261-91e44b753756",
                    "sense_definition": "A quality of being sophisticated, elegant, or well-practiced.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "refinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young diplomat lacked the professional <w>polish</w> expected at such events.",
                            "target_lang_translations": {
                                "ru": "Молодому дипломату не хватало профессионального <w>лоска</w>, ожидаемого на таких мероприятиях.",
                                "zh": "这位年轻的外交官缺乏在此类活动中应有的专业<w>风度</w>。"
                            }
                        },
                        {
                            "text": "Her writing has a certain <w>polish</w> that makes it very pleasant to read.",
                            "target_lang_translations": {
                                "ru": "Её слог отличается определенной <w>отточенностью</w>, благодаря чему его очень приятно читать.",
                                "zh": "她的文字有一种独特的<w>精湛</w>感，读起来非常愉悦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "refinement",
                        "elegance",
                        "style",
                        "class"
                    ],
                    "common_phrases": [
                        "professional polish",
                        "lack polish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество утонченности, элегантности или хорошей практики.",
                        "zh": "一种老练、优雅或经过良好训练的品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лоск",
                                "target_lang_sense_clarification": "внешняя элегантность"
                            },
                            {
                                "target_lang_word": "отточенность",
                                "target_lang_sense_clarification": "мастерство исполнения"
                            },
                            {
                                "target_lang_word": "изысканность",
                                "target_lang_sense_clarification": "манеры или стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风度",
                                "target_lang_sense_clarification": "优雅的举止"
                            },
                            {
                                "target_lang_word": "精湛",
                                "target_lang_sense_clarification": "技艺的完美"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "29c80047-dd34-39a8-8699-89ba73b72134",
                    "sense_definition": "Relating to the country of Poland, its people, or its language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nationality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My neighbor is <w>Polish</w> and often cooks traditional dishes from Warsaw.",
                            "target_lang_translations": {
                                "ru": "Мой сосед — <w>поляк</w>, и он часто готовит традиционные варшавские блюда.",
                                "zh": "我的邻居是<w>波兰的</w>人，经常做华沙的传统菜肴。"
                            }
                        },
                        {
                            "text": "The <w>Polish</w> government announced new economic policies this morning.",
                            "target_lang_translations": {
                                "ru": "<w>Польское</w> правительство объявило сегодня утром о новой экономической политике.",
                                "zh": "<w>波兰</w>政府今天上午宣布了新的经济政策。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Polish food",
                        "Polish culture",
                        "Polish history"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Польше, её народу или языку.",
                        "zh": "与波兰国家、人民或语言有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "польский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波兰的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "48d2007d-371b-32eb-8ce0-ba65dc07e396",
                    "sense_definition": "The Slavic language spoken primarily in Poland.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He is learning <w>Polish</w> because he wants to move to Krakow.",
                            "target_lang_translations": {
                                "ru": "Он учит <w>польский</w>, потому что хочет переехать в Краков.",
                                "zh": "他正在学习<w>波兰语</w>，因为他想搬到克拉科夫去。"
                            }
                        },
                        {
                            "text": "Can you translate this letter from <w>Polish</w> into English for me?",
                            "target_lang_translations": {
                                "ru": "Можешь перевести для меня это письмо с <w>польского</w> на английский?",
                                "zh": "你能帮我把这封信从<w>波兰语</w>翻译成英语吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Polish",
                        "learn Polish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Славянский язык, на котором говорят преимущественно в Польше.",
                        "zh": "主要在波兰使用的斯拉夫语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "польский",
                                "target_lang_sense_clarification": "язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波兰语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}