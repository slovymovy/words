        "fr-extract.jsonl": [
            {
                "entry_id": "f0453673-f670-38db-98d1-b7c310347606",
                "word": "impureté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "071b75e3-2bfd-4e2a-96ac-47f3bc7c9050",
                        "entry_id": "f0453673-f670-38db-98d1-b7c310347606",
                        "tags": [
                            "plural"
                        ],
                        "form": "impuretés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27e0c057-7378-3264-a25e-4cafc5896b32",
                        "entry_id": "f0453673-f670-38db-98d1-b7c310347606",
                        "glosses": [
                            "Ce qu’il y a dans une chose d’impur, de grossier et d’étranger, qui l’altère ou la gâte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65739e9e-e233-4071-bb9a-f7cc18056ef0",
                                "sense_id": "27e0c057-7378-3264-a25e-4cafc5896b32",
                                "text": "L’impureté de l’eau cause beaucoup de maladies."
                            },
                            {
                                "example_id": "e9ec7b92-b199-4bff-a925-a77a641b9b00",
                                "sense_id": "27e0c057-7378-3264-a25e-4cafc5896b32",
                                "text": "Il faut filtrer les liquides pour en ôter les impuretés."
                            },
                            {
                                "example_id": "e6d05548-74e4-4bbc-99b8-6f02d73bb6d0",
                                "sense_id": "27e0c057-7378-3264-a25e-4cafc5896b32",
                                "text": "L’impureté des humeurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e1dc7f0-0cff-315d-a769-2ffa4d42d1da",
                        "entry_id": "f0453673-f670-38db-98d1-b7c310347606",
                        "glosses": [
                            "Souillure que l’on contracte en faisant certaines choses défendues par une règle religieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ffe29e-eef8-4663-81dc-77126a5b3cb0",
                                "sense_id": "9e1dc7f0-0cff-315d-a769-2ffa4d42d1da",
                                "text": "La notion religieuse essentielle, ici, est celle d’impureté rituelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "be600ce6-3208-328a-8031-952beaa26b82",
                        "entry_id": "f0453673-f670-38db-98d1-b7c310347606",
                        "glosses": [
                            "Impudicité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "00f474ef-4340-4e74-9dec-65c765cadbd9",
                                "sense_id": "be600ce6-3208-328a-8031-952beaa26b82",
                                "text": "Vivre dans l’impureté."
                            },
                            {
                                "example_id": "0a45c80e-2527-4038-959e-1d7b2366ae3f",
                                "sense_id": "be600ce6-3208-328a-8031-952beaa26b82",
                                "text": "Le péché d’impureté."
                            },
                            {
                                "example_id": "89867528-9aa0-4ac5-988c-163c4c2140a6",
                                "sense_id": "be600ce6-3208-328a-8031-952beaa26b82",
                                "text": "Le démon de l’impureté."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b898719-39e7-3acc-883e-f2236fb1fa7c",
                        "entry_id": "f0453673-f670-38db-98d1-b7c310347606",
                        "glosses": [
                            "Élément ajouté en petite quantité à un semi-conducteur pour en modifier les caractéristiques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a8b1423-493f-42b5-af61-b1bbe91ef128",
                        "source_entry_id": "f0453673-f670-38db-98d1-b7c310347606",
                        "target_lang_word": "impurity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impurity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f9caf0-a46b-3379-8bb9-d1b48b9ee74f",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "The condition of being impure; because of contamination, pollution, adulteration or insufficient purification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eceec55-d301-4c5e-81fd-763a3e053734",
                                                "sense_id": "d1f9caf0-a46b-3379-8bb9-d1b48b9ee74f",
                                                "text": "Even animals in the Jewish system cause impurity only when they are dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "A component or additive that renders something else impure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56afd81c-595d-4858-8569-f1d0ef290ac4",
                                                "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                                "text": "The impurities in the iron ore made extraction of the iron very difficult."
                                            },
                                            {
                                                "example_id": "d2540255-667a-4f00-85bf-eba7407275a0",
                                                "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d730e686-0849-328b-9c09-89d1162eb5c9",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "A state of immorality or sin; especially the weakness of the flesh: inchastity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6498f97f-51f9-449c-bc85-fae845925ee1",
                                                "sense_id": "d730e686-0849-328b-9c09-89d1162eb5c9",
                                                "text": "With his cheating, lying and stealing, he epitomised the impurity of humanity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
