        "ru-extract.jsonl": [
            {
                "entry_id": "45f14d8c-c4c9-33e4-b630-35b26e2f0813",
                "word": "траченный",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c176458e-f14b-376c-84bf-eda63bf9f2e1",
                        "entry_id": "45f14d8c-c4c9-33e4-b630-35b26e2f0813",
                        "glosses": [
                            "страд. прич. прош. вр. от тратить; изъеденный (обычно молью), подточенный"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "804e3a57-3eab-4b3b-9eaf-0bd73ea82fbf",
                                "sense_id": "c176458e-f14b-376c-84bf-eda63bf9f2e1",
                                "text": "На бревенчатые, давно ободранные стены в столовой палате повесили траченные молью ковры."
                            },
                            {
                                "example_id": "d3c95a56-af95-4822-83f2-7f95a0f56018",
                                "sense_id": "c176458e-f14b-376c-84bf-eda63bf9f2e1",
                                "text": "Все было трачено молью и запорошено пылью — все требовалось кропотливо подлатать и заштопать, бережно выстирать и высушить."
                            },
                            {
                                "example_id": "9dfdfe7d-3134-49fd-9219-a2e570ef0a42",
                                "sense_id": "c176458e-f14b-376c-84bf-eda63bf9f2e1",
                                "text": "Его публику [Театра Виктюка] составили немолодые, траченные жизнью дамы, мечтающие о красоте — крепкие бицепсы и стройные торсы молодых виктюковских актеров кажутся им совершенством."
                            }
                        ]
                    }
                ],
