                "senses": [
                    {
                        "sense_id": "074ceafb-2f85-31e5-a7a6-f521cb9d0e4d",
                        "entry_id": "1c164bf9-2113-3d08-b987-83f94c968ccc",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus auf einem Berg oder an einem Dorf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63dea303-a738-4e77-8c42-fdb6523fd72f",
                                "sense_id": "074ceafb-2f85-31e5-a7a6-f521cb9d0e4d",
                                "text": "„Die Illinger Bergkapelle \"Zu den Sieben Schmerzen Mariens\" mit der Pietà von Matthias Weiser zählt zu den bekanntesten Sehenswürdigkeiten der Region.“"
                            },
                            {
                                "example_id": "ca4ce7c1-83c9-41d8-b80e-dce4a8517a0e",
                                "sense_id": "074ceafb-2f85-31e5-a7a6-f521cb9d0e4d",
                                "text": "„Die Bergkapelle verdankt ihre Entstehung einem Gelöbnis, das die Einwohner Hofheims am 03. Juni 1666 wegen der ringsrum wütenden Pest ablegten.“"
                            },
                            {
                                "example_id": "0cb678c7-92df-4d6d-99ce-d9443d45736e",
                                "sense_id": "074ceafb-2f85-31e5-a7a6-f521cb9d0e4d",
                                "text": "„Mitten auf dem Schöppinger Berg, in freier Lage und von allen Seiten sichtbar, steht die Bergkapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1afcf900-8a2a-39c1-8275-003229105498",
                        "entry_id": "1c164bf9-2113-3d08-b987-83f94c968ccc",
                        "glosses": [
                            "kleiner Spielmannszug der Bergmänner, die zumeist Marsch- und Bergmannsmusik spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "ddd0cd9d-100e-4ee7-9e40-9117f59462a3",
                                "sense_id": "1afcf900-8a2a-39c1-8275-003229105498",
                                "text": "„Die Bergkapelle Rüdersdorf e.V. hat - wie der Name schon sagt - ihren Sitz in Rüdersdorf bei Berlin.“."
                            },
                            {
                                "example_id": "39b3aa11-0707-441c-93eb-e28f15aabe14",
                                "sense_id": "1afcf900-8a2a-39c1-8275-003229105498",
                                "text": "„Neben militärischen Tönen spielte die Bergkapelle bei Platzkonzerten, Tanzabenden und auch zum Geleit auf dem letzten Weg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
