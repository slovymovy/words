{
    "word_family": [
        "accent",
        "accentuation",
        "accentuable",
        "désaccentuer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82281df6-a9d3-30e9-bfe5-2138eb71dcad",
                    "sense_definition": "Écrire un accent graphique sur une lettre ou une voyelle.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "orthographe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En français, il faut <w>accentuer</w> le e de ce mot pour obtenir le son correct."
                        },
                        {
                            "text": "N'oubliez pas d'<w>accentuer</w> les lettres nécessaires quand vous écrivez ce devoir."
                        }
                    ],
                    "common_phrases": [
                        "accentuer une lettre",
                        "accentuer une voyelle"
                    ]
                },
                {
                    "sense_id": "8849c08b-11e9-3e1c-aaf6-a65128c90c43",
                    "sense_definition": "Faire porter l'accent tonique sur une syllabe ou prononcer un mot avec force pour le mettre en valeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prononciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette langue, on doit <w>accentuer</w> la dernière syllabe de presque chaque phrase."
                        },
                        {
                            "text": "Le comédien prend le temps d'<w>accentuer</w> certains termes pour susciter l'émotion du public."
                        }
                    ],
                    "common_phrases": [
                        "accentuer un mot",
                        "accentuer la prononciation"
                    ]
                },
                {
                    "sense_id": "81b98c54-e5ec-308c-92e0-577b4e0f5558",
                    "sense_definition": "Donner plus de force, de netteté ou de relief à un élément.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette lumière rasante vient <w>accentuer</w> les ombres et donner du volume au tableau."
                        },
                        {
                            "text": "Le maquillage léger permet d'<w>accentuer</w> les traits du visage sans excès."
                        }
                    ],
                    "synonyms": [
                        "renforcer"
                    ],
                    "antonyms": [
                        "atténuer",
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "accentuer les contrastes",
                        "accentuer les traits"
                    ]
                },
                {
                    "sense_id": "82c14c71-5790-3ac5-a51d-6b947f7396d5",
                    "sense_definition": "Prendre de l'ampleur, augmenter en intensité ou s'aggraver.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La baisse des températures va s'<w>accentuer</w> au cours des prochains jours."
                        },
                        {
                            "text": "Avec la crise, les disparités entre les différentes régions risquent de s'<w>accentuer</w>."
                        }
                    ],
                    "synonyms": [
                        "augmenter",
                        "accroître"
                    ],
                    "antonyms": [
                        "diminuer"
                    ],
                    "common_phrases": [
                        "accentuer les écarts"
                    ]
                }
            ]
        }
    ]
}