                            {
                                "example_id": "53792c8e-9b3f-43e7-9c65-7da4dc899423",
                                "sense_id": "99f65f9d-1ac7-31ac-8a03-2d6d0e53f5a5",
                                "text": "Ik maakte er een zooitje van."
                            },
                            {
                                "example_id": "c898c048-c6b5-4d02-a38d-12688f989cfa",
                                "sense_id": "99f65f9d-1ac7-31ac-8a03-2d6d0e53f5a5",
                                "text": "Ik heb altijd veel zooi bij me in de auto."
                            },
                            {
                                "example_id": "b5858fbb-824f-47b8-bcfe-3a10d3e07e1e",
                                "sense_id": "99f65f9d-1ac7-31ac-8a03-2d6d0e53f5a5",
                                "text": "Ik raapte het hele zooitje weer op en deed een volgende poging."
                            }
                        ]
                    },
                    {
                        "sense_id": "b24adfaf-7419-32ae-bfe4-f8dffe600a5a",
                        "entry_id": "92570b29-f50c-3cb4-84b5-c0bb59491d3c",
