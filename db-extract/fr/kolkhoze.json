                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee01240-80bd-4a07-a1c2-909215c53e12",
                                                "sense_id": "83bcc165-099d-3334-abc2-d40c9c61e6f8",
                                                "text": "Они завалились к нам в гости всем колхозом."
                                            }
