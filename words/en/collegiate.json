                            {
                                "target_lang_word": "instituto",
                                "target_lang_sense_clarification": "centro de educación secundaria"
                            },
                            {
                                "target_lang_word": "escuela secundaria",
                                "target_lang_sense_clarification": "institución educativa de nivel medio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8500208-854a-3ebb-b972-42d3a527db27",
                    "sense_definition": "A member of a college, or a person who has received a college education.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_college",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a proud <w>collegiate</w>, she regularly attended university reunions.",
                            "target_lang_translations": {
                                "es": "Como orgullosa <w>universitaria</w>, asistía regularmente a las reuniones de antiguos alumnos."
                            }
                        },
                        {
                            "text": "The debating society was open only to a verified <w>collegiate</w> of the university.",
                            "target_lang_translations": {
                                "es": "La sociedad de debate estaba abierta únicamente a un <w>colegial</w> acreditado de la universidad."
                            }
                        }
                    ],
                    "synonyms": [
                        "collegian"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Miembro de un colegio universitario o persona con educación universitaria."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "universitario",
                                "target_lang_sense_clarification": "estudiante o graduado universitario"
                            },
                            {
                                "target_lang_word": "colegial",
                                "target_lang_sense_clarification": "estudiante interno o miembro de un colegio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38940243-2207-3576-ae57-9db3aef15696",
                    "sense_definition": "A fellow student or colleague from the same college.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_college",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He welcomed an old <w>collegiate</w> who had studied mathematics alongside him.",
                            "target_lang_translations": {
                                "es": "Recibió calurosamente a un antiguo <w>compañero de universidad</w> que había estudiado matemáticas junto a él."
                            }
                        },
                        {
                            "text": "The author dedicated his latest treatise to his dear former <w>collegiate</w>.",
                            "target_lang_translations": {
                                "es": "El autor dedicó su último tratado a su querido antiguo <w>condiscípulo</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "colleague"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Compañero de estudios o colega de la misma universidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "compañero de universidad",
                                "target_lang_sense_clarification": "compañero de estudios superiores"
                            },
                            {
                                "target_lang_word": "condiscípulo",
                                "target_lang_sense_clarification": "compañero de estudios"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6e7a77a-2c95-3b5b-bf8d-9464420b797a",
                    "sense_definition": "An inmate confined in a prison.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warden kept a close watch on each newly arrived <w>collegiate</w>.",
                            "target_lang_translations": {
                                "es": "El alcaide vigilaba de cerca a cada <w>recluso</w> recién llegado."
                            }
                        },
                        {
                            "text": "A veteran <w>collegiate</w> explained the unwritten rules of the jailhouse.",
                            "target_lang_translations": {
                                "es": "Un <w>preso</w> veterano explicó las reglas no escritas de la cárcel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Historical criminal or prison slang"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Recluso confinado en una prisión (jerga antigua)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "recluso",
                                "target_lang_sense_clarification": "preso o convicto"
                            },
                            {
                                "target_lang_word": "preso",
                                "target_lang_sense_clarification": "persona privada de libertad"
                            }
                        ]
                    }
                }
            ]
        }
