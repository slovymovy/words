                        "glosses": [
                            "ein Unternehmen, das Schifffahrt mit Dampfschiffen betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a256084-da20-430a-84ee-c79a2044b819",
                                "sense_id": "e29db509-3ac2-35e8-be08-29f6d6da28b7",
                                "text": "„Im Frühjahr 1853 gründete Freiherr Edmund von Herbert die erste Dampfschifffahrtsgesellschaft am Wörthersee und investierte 13.500 Gulden für einen gebrauchten Raddampfer, die Maria Wörth, welche das einzige Schiff seiner Dampfschifffahrtsgesellschaft blieb.“"
                            },
                            {
                                "example_id": "3fb2e78b-3fa6-4ce3-b3d1-c63a077305f4",
                                "sense_id": "e29db509-3ac2-35e8-be08-29f6d6da28b7",
                                "text": "„Es ist auch nicht schlecht, wenn der Wodka- Hoflieferant des Zaren zugleich leitender Angestellter der Westrussischen Dampfschifffahrtsgesellschaft ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
