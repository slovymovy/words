                                        ],
                                        "examples": [
                                            {
                                                "example_id": "398ba755-a3f5-4029-b9dc-608d228169fc",
                                                "sense_id": "c82cccb8-73b6-3681-a7f7-61c5b59f775d",
                                                "text": "Die Streikenden barrikadierten die Zufahrt mit Baumaschinen."
                                            },
                                            {
                                                "example_id": "deff5bd3-8de0-4920-b50a-bd85208db99e",
                                                "sense_id": "c82cccb8-73b6-3681-a7f7-61c5b59f775d",
                                                "text": "Die Verteidiger barrikadieren den gesamten Strafraum."
                                            }
