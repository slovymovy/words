                "senses": [
                    {
                        "sense_id": "dee122fc-e1d8-3118-a945-3fe5b01915a6",
                        "entry_id": "75588e32-8b6c-3653-b555-39cb6223d998",
                        "glosses": [
                            "Zusammenfluss, zum Beispiel zweier Gletscher oder von Strom und Nebenfluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ca9016-5076-406c-801a-8c63b8b56d9f",
                                "sense_id": "dee122fc-e1d8-3118-a945-3fe5b01915a6",
                                "text": "Das klassische Beispiel für Konfluenz ist der Konkordiaplatz, an dem der Grosse Aletschfirn, der Jungfraufirn, das Ewigschneefeld und der Grüneggfirn den Grossen Aletschgletscher bilden."
                            },
                            {
                                "example_id": "b2f763b9-a1ef-47e0-80b6-c9161f035d25",
                                "sense_id": "dee122fc-e1d8-3118-a945-3fe5b01915a6",
                                "text": "Fast alle Gewässer des Schwarzmeerbeckens fließen in Belgrader Konfluenz - Save, Donau, Theiß, Tamis, Velika Morava, Drina mit ihren Nebenflüssen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
