            "senses": [
                {
                    "sense_id": "218f69c9-3ff5-332e-8ab1-cfc0ed0cfc99",
                    "sense_definition": "A pair of small loudspeakers worn inside or over the ears to listen to audio privately.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "audio_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always wear my <w>earphones</w> when I am traveling on the bus to listen to music.",
                            "target_lang_translations": {
                                "ru": "Я всегда надеваю <w>наушники</w>, когда еду в автобусе, чтобы послушать музыку."
                            }
                        },
                        {
                            "text": "She plugged her <w>earphones</w> into the laptop to watch the movie without disturbing anyone.",
                            "target_lang_translations": {
                                "ru": "Она подключила свои <w>наушники</w> к ноутбуку, чтобы посмотреть фильм, никому не мешая."
                            }
                        }
                    ],
                    "synonyms": [
