                "senses": [
                    {
                        "sense_id": "047259f4-295d-3cf6-afb0-76c142b1ba6d",
                        "entry_id": "8fce9346-c976-3b59-83b3-e493fcf1a936",
                        "glosses": [
                            "прост. человек, занимающийся изготовлением чучел животных и птиц"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0018eac-e280-4a35-9e51-bd684259e444",
                                "sense_id": "047259f4-295d-3cf6-afb0-76c142b1ba6d",
                                "text": "Я отдал медведя чучельнику, а у чучельника очередь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf5db443-b0cc-49ce-8c08-3ab226c096f3",
                        "source_entry_id": "8fce9346-c976-3b59-83b3-e493fcf1a936",
                        "source_sense_id": "047259f4-295d-3cf6-afb0-76c142b1ba6d",
                        "target_lang_word": "taxidermist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxidermist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6db354aa-e1aa-351f-8bd8-674072a84e45",
                                        "entry_id": "95ec45d8-7bb4-35f0-95d5-51676a68e1f2",
                                        "glosses": [
                                            "One who practices taxidermy, the stuffing of animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb1bebb5-a8b1-4e43-9d00-d864b1f60078",
                        "source_entry_id": "8fce9346-c976-3b59-83b3-e493fcf1a936",
                        "source_sense_id": "047259f4-295d-3cf6-afb0-76c142b1ba6d",
                        "target_lang_word": "taxidermiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxidermiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "867333ad-9b3a-337d-86aa-443b507c6b35",
                                        "entry_id": "4f2fc9ea-1763-3846-979a-787218bfada9",
                                        "glosses": [
                                            "Personne qui maîtrise l’art de donner l’apparence du vivant à des animaux morts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d3f54c1-5126-4014-93a9-5bae90d5fad7",
                                                "sense_id": "867333ad-9b3a-337d-86aa-443b507c6b35",
                                                "text": "Au début, toute le monde fut un peu effrayé, car l’oiseau avait – le taxidermiste la lui avait-il sciemment prêtée ? – une expression sournoise…"
                                            },
                                            {
                                                "example_id": "d49d4d6a-5a39-489d-bf64-9af958733c8b",
                                                "sense_id": "867333ad-9b3a-337d-86aa-443b507c6b35",
                                                "text": "Si vous décidez de posséder au moins une tête complètement reconstituée, vous aurez besoin de l’aide d’un bon taxidermiste, et ils sont relativement rares. Les têtes de chevreuil mal montées sont une abomination !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5c9d1e4-79e9-420a-851c-497afca4448a",
                        "source_entry_id": "8fce9346-c976-3b59-83b3-e493fcf1a936",
                        "source_sense_id": "047259f4-295d-3cf6-afb0-76c142b1ba6d",
                        "target_lang_word": "empailleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1453f851-3431-3672-898e-c8bcce295617",
                                        "entry_id": "a4b50438-f5fe-3f2e-be40-fc28499e6585",
                                        "glosses": [
                                            "Personne qui empaille des chaises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de53f94c-8aa1-4364-9ec8-15e682baade5",
                                                "sense_id": "1453f851-3431-3672-898e-c8bcce295617",
                                                "text": "Empailleur de chaises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                                        "entry_id": "a4b50438-f5fe-3f2e-be40-fc28499e6585",
                                        "glosses": [
                                            "Personne qui empaille des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271ee707-66ae-4e0d-adf4-bd824635dbd1",
                                                "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                                                "text": "Or, plus la vie est facile, plus ces occupations sont fastidieuses, à moins d’appartenir à la secte des quakers-tourneurs, à l’honorable corps des charpentiers ou des empailleurs d’oiseaux."
                                            },
                                            {
                                                "example_id": "05363b93-6361-4662-81aa-8703a8a50040",
                                                "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                                                "text": "Enfin, il arriva, — et splendide, droit sur une branche d’arbre, qui se vissait dans un socle d’acajou, une patte en l’air, la tête oblique, et mordant une noix, que l’empailleur par amour du grandiose avait dorée."
                                            },
                                            {
                                                "example_id": "4136e404-e4e6-46d5-a559-fc8aab0def10",
                                                "sense_id": "42e3793e-3148-3b04-af4b-7442ff913a07",
                                                "text": "C’était un bon commerçant autant qu’un empailleur talentueux, et ses affaires prospéraient grâce à sa faconde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f80eed3b-e182-45c6-9e26-811428c38436",
                        "source_entry_id": "8fce9346-c976-3b59-83b3-e493fcf1a936",
                        "source_sense_id": "047259f4-295d-3cf6-afb0-76c142b1ba6d",
                        "target_lang_word": "naturaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naturaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                        "entry_id": "ec20e2e4-0233-32df-bf15-b1b9c283e4e7",
                                        "glosses": [
                                            "Qualifie un romancier partisan du naturalisme, ou une œuvre littéraire répondant aux principes du naturalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75089294-f4c9-424d-b8e9-9a871f6dfd0d",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Les romanciers naturalistes."
                                            },
                                            {
                                                "example_id": "f1617b30-265f-4ce0-a345-e6baad35b8c9",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Un roman naturaliste."
                                            },
                                            {
                                                "example_id": "895676a6-fa87-4729-8183-8d06c7bbefea",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "L'École naturaliste."
                                            },
                                            {
                                                "example_id": "a8d0a494-ece5-4571-b90d-79450e4555c5",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Et c'est le théâtre naturaliste. C'est, pour faire vrai, l'acteur tournant le dos au public. C'est le quartier de viande saignant. C'est la réalité crue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0056226-ad85-323f-8e90-03b837637036",
                                        "entry_id": "ec20e2e4-0233-32df-bf15-b1b9c283e4e7",
                                        "glosses": [
                                            "Conforme au naturalisme, approche des sciences humaines selon laquelle il existe une réalité objective répondant à un certain nombre de règles, par opposition au constructivisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edfab6ce-ad5a-4d42-b8b5-9df9de35944f",
                                                "sense_id": "d0056226-ad85-323f-8e90-03b837637036",
                                                "text": "Selon la conception naturaliste (ou positiviste) de la science, il existerait des régularités et des tendances générales dans le comportement humain qui peuvent être décelées grâce à l'expérimentation et à l'observation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "naturaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a487877c-8f7b-3fc3-bb16-3db995ff7cbc",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Romancier partisan du naturalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7185ad82-16f1-412d-ab6a-b800137115a7",
                                                "sense_id": "a487877c-8f7b-3fc3-bb16-3db995ff7cbc",
                                                "text": "Élevée par des parents soigneux de ses lectures et n’ayant pas beaucoup d’idées dans la cervelle, mais les ayant saines et bonnes, jamais elle ne connut les Naturalistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Savant qui s’applique à l’histoire naturelle, qui s’attache à l’étude des plantes, des minéraux, des animaux, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d398f1-867f-4a70-84c2-425bf0e9acc3",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Celui qui ne connaît d'un animal que le nom et la place qui lui revient dans un système de nomenclature plus ou moins bien assis, ne mérite pas plus le titre de naturaliste qu'un garçon de bibliothèque n'est digne de l'épithète de savant parce qu'il sait par cœur le titre de ses livres, leur numéro d'ordre et la case où ils sont logés."
                                            },
                                            {
                                                "example_id": "edae7d82-4e34-4bdd-a412-f0e3afacf736",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Ce sont les pigeons, pour la douceur desquels quelques naturalistes ont escrit qu’eux et les tourtres estoient sans fiel."
                                            },
                                            {
                                                "example_id": "007bbe5f-1ffb-49cd-94f7-c44d2075abf1",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Un naturaliste allemand, envoyé par une société scientifique de son pays, habitait également Adwa."
                                            },
                                            {
                                                "example_id": "63116f62-545c-43b1-afb4-df217477afbf",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Autour de cette vasque, sous d'élégantes vitrines fixées par des armatures de cuivre, étaient classés et étiquetés les plus précieux produits de la mer qui eussent jamais été livrés aux regards d'un naturaliste. On conçoit ma joie de professeur."
                                            },
                                            {
                                                "example_id": "013fe35d-0936-49f6-a945-61f6a32f9b4c",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Très vite incriminés, les naturalistes ont procédé à une enquête visant à reconstituer la progression des loups depuis les Abruzzes jusqu'au Mercantour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f539ab4-618f-3de4-b6b1-0771d10b6e44",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Taxidermiste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
