                                        "entry_id": "7a0322dc-c7a0-3b35-90ee-ff49c60afe16",
                                        "glosses": [
                                            "Indication qui est contraire à l’emploi de tel ou tel moyen qui paraissait indiqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519079e5-4b05-4ceb-ad22-c17393567b7b",
                                                "sense_id": "77acc69c-5efb-3c14-9612-f2121f8e10ba",
                                                "text": "Des contrindications."
                                            },
                                            {
                                                "example_id": "69991387-7732-47ee-94d5-c0ad70beedb9",
                                                "sense_id": "77acc69c-5efb-3c14-9612-f2121f8e10ba",
                                                "text": "Les infiltrations ou ulcérations étendues à une grande partie de l’organe ne sont pas une contrindication à une thérapeutique active par le galvano."
                                            }
