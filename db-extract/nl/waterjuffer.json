                        "source_entry_id": "c2dd398e-9204-3b5a-b385-e864d6f86aff",
                        "source_sense_id": "e978adb3-e051-3272-88dc-e3cb89e66a7f",
                        "source_sense_description": "een dier dat behoort tot een van honderden soorten van de Coenagrionidae",
                        "target_lang_word": "dragonfly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragonfly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e201a496-af0f-3a25-9127-2afafccd422d",
                                        "entry_id": "49484c45-64eb-3e48-8225-24f2d53f7cef",
                                        "glosses": [
                                            "An insect of the suborder Epiprocta or, more strictly, the infraorder Anisoptera, having four long transparent wings held perpendicular to a long body when perched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c0f055-f510-4cd6-8303-d33708de0a3c",
                                                "sense_id": "e201a496-af0f-3a25-9127-2afafccd422d",
                                                "text": "There were two dragonflies in the garden today."
                                            },
                                            {
                                                "example_id": "7c1746e9-3321-4ed0-8eb3-21b2c3ee9324",
                                                "sense_id": "e201a496-af0f-3a25-9127-2afafccd422d",
                                                "text": "The delicate coloured Dragon Flies may have likewise some Corrosive quality."
                                            },
                                            {
                                                "example_id": "ee422b99-28ea-4285-a426-f4229c3a8f98",
                                                "sense_id": "e201a496-af0f-3a25-9127-2afafccd422d",
                                                "text": "The sapphire needled dragonflies\nThat flirt with the crested newt!\nAnd now before his newtly nose, […]"
                                            },
                                            {
                                                "example_id": "99018ce3-33bb-4894-befe-28c9d3d6890e",
                                                "sense_id": "e201a496-af0f-3a25-9127-2afafccd422d",
                                                "text": "Stacey Combes, who studies the biomechanics of dragonfly flight at Harvard, once watched a laboratory dragonfly eat 30 flies in a row."
                                            },
                                            {
                                                "example_id": "ae50b972-a911-46b9-b65c-20e37fb8f4cd",
                                                "sense_id": "e201a496-af0f-3a25-9127-2afafccd422d",
                                                "text": "As the airboat skimmed across the shallow water, scattering blue dragonflies and launching a heron into the air, Keith Price squinted into the sun and relished the isolation of Florida’s unrivaled river of grass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec58b5ae-9787-4ce0-a0a8-9a235176b069",
                        "source_entry_id": "c2dd398e-9204-3b5a-b385-e864d6f86aff",
                        "source_sense_id": "e978adb3-e051-3272-88dc-e3cb89e66a7f",
