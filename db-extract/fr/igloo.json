                        ],
                        "form": "igloos"
                    },
                    {
                        "form_id": "54424e16-110c-4011-86a2-577a82f2c236",
                        "entry_id": "5b7c6c22-6a95-3bc4-a0b0-5a3224e88d21",
                        "tags": [
                            "Moins courant"
                        ],
                        "form": "iglou"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7cdee95-a464-3149-b25f-259ddec19d67",
                        "entry_id": "5b7c6c22-6a95-3bc4-a0b0-5a3224e88d21",
                        "glosses": [
                            "Habitation hémisphérique faite de blocs de neige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a73cd8-da71-43c6-8c72-25357668934f",
                                "sense_id": "f7cdee95-a464-3149-b25f-259ddec19d67",
                                "text": "Kalumah […] lui montra la hutte d’un air satisfait. C’était un gros cône de neige, percé d’une étroite ouverture à son sommet qui donnait issue à la fumée d’un foyer intérieur, et dans lequel ces Esquimaux avaient creusé leur demeure passagère. Ces « snow-houses », qu’ils établissent avec une extrême rapidité, se nomment « igloo » dans la langue du pays."
                            },
                            {
                                "example_id": "fccf3a9c-f498-4cc3-84e6-b54b9807c7b6",
                                "sense_id": "f7cdee95-a464-3149-b25f-259ddec19d67",
                                "text": "Nous étions loin des igloos de neige, demeures primitives des Groenlandais."
                            },
                            {
                                "example_id": "2787416c-c8a0-40c9-8caf-f70a0925f25b",
                                "sense_id": "f7cdee95-a464-3149-b25f-259ddec19d67",
                                "text": "L’igloo serait construit plus tard, aux neiges venues."
                            },
                            {
                                "example_id": "f390c6ff-e4ea-4f2c-95ee-2cedbd2d87a6",
                                "sense_id": "f7cdee95-a464-3149-b25f-259ddec19d67",
                                "text": "J’ai dans la tête un vieux sapin, une crèche en d’ssous\n Un Saint-Joseph avec une canne en caoutchouc\n Était mal faite pis j’avais frette\n Quand je r’venais d’passer trois heures dans un igloo\n Qu’on avait fait deux ou trois gars chez Guy Rondoux"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2e713e7-3f86-429f-a655-55fe730545cf",
                        "source_entry_id": "5b7c6c22-6a95-3bc4-a0b0-5a3224e88d21",
                        "source_sense_id": "f7cdee95-a464-3149-b25f-259ddec19d67",
                        "target_lang_word": "Iglu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iglu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99d1e121-ae1a-3970-8ede-4e4dcf05f574",
                                        "entry_id": "03e58047-e9b4-302d-88c6-6a002429dc06",
                                        "glosses": [
                                            "Schneehütte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd7481d-568c-4945-b312-2e4339b13b9a",
                                                "sense_id": "99d1e121-ae1a-3970-8ede-4e4dcf05f574",
                                                "text": "Das Iglu hat riesige Vorteile gegenüber der Zeltunterkunft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6cd12304-caed-323d-9fdb-16f7e8e0ff75",
                                        "entry_id": "03e58047-e9b4-302d-88c6-6a002429dc06",
                                        "glosses": [
                                            "aus Schneeblöcken errichtetes halbkugelförmiges Haus der Eskimos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07208709-4dc1-488a-b096-2a16c9975c6b",
                                                "sense_id": "6cd12304-caed-323d-9fdb-16f7e8e0ff75",
                                                "text": "Schon seit 4000 Jahren beherrschen die Eskimos die Kunst, einen Iglu zu bauen."
                                            },
                                            {
                                                "example_id": "22802df8-181e-49c5-85ad-d7b2a7c8fb7c",
                                                "sense_id": "6cd12304-caed-323d-9fdb-16f7e8e0ff75",
                                                "text": "„Auch die Schlafräume im Konvikt hatten grönländischen Iglus geglichen; dazu Sport in arktischer Kälte; das probate Mittel zur Dämpfung unzüchtiger Gedanken und Gefühle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aef26528-1881-3d30-9cbe-6e7b40919b60",
                                        "entry_id": "03e58047-e9b4-302d-88c6-6a002429dc06",
                                        "glosses": [
                                            "in Nordkanada: Winterwohnung, Reiseunterkunft, Jagdunterkunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1524312-61b0-4024-abc5-def20915e4e2",
                                                "sense_id": "aef26528-1881-3d30-9cbe-6e7b40919b60",
                                                "text": "Die in kleinen Gruppen zerstreut lebenden Indianer bewohnten entgegen der allgemeinen Meinung nur während der Jagd und auf Reisen Iglu genannte Schneehütten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d64a6baa-5ac0-4bde-bb24-1abd85eadcfb",
                        "source_entry_id": "5b7c6c22-6a95-3bc4-a0b0-5a3224e88d21",
