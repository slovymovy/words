                {
                    "sense_id": "8a5381a9-a41a-3524-8973-7780f22342f3",
                    "sense_definition": "instytucja o charakterze opiekuńczym, wychowawczym, leczniczym lub karnym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
