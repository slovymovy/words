                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "608b457e-704e-4ffd-9773-bee4f177b4a2",
                                "sense_id": "782cc572-b501-3b33-93ad-32e62c5a8701",
                                "text": "Ce que nous appelons la paix pourrait n’être finalement qu’un interlude entre deux guerres."
                            },
                            {
                                "example_id": "0e929f59-d8ba-4022-87d4-f7debaad5ec0",
                                "sense_id": "782cc572-b501-3b33-93ad-32e62c5a8701",
                                "text": "– Simpliste ? Je ne suis qu’un interlude pour toi, un défouloir sexuel pour oublier ton deuil."
                            }
                        ]
                    }
                ],
