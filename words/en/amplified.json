                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиленный",
                                "target_lang_sense_clarification": "общий термин для чего-то, что стало мощнее или громче"
                            },
                            {
                                "target_lang_word": "громкий",
                                "target_lang_sense_clarification": "применительно к звуку, который был сделан громче"
