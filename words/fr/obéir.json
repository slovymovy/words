    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e548e3ef-cfe2-31ed-8ae9-fd518d84b1db",
                    "sense_definition": "Se soumettre aux ordres d'une personne ou d'une autorité et exécuter ce qui est demandé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "soumission_autorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants doivent <w>obéir</w> à leurs parents quand ils leur parlent."
                        },
                        {
                            "text": "Le jeune soldat a promis d'<w>obéir</w> aux ordres de son supérieur sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "se soumettre"
                    ],
                    "antonyms": [
                        "désobéir"
                    ],
                    "common_phrases": [
                        "obéir aux ordres",
                        "obéir à ses parents"
                    ]
                },
                {
                    "sense_id": "f519e5cd-dd07-3f35-9695-17783a7a933e",
                    "sense_definition": "Se conformer à une règle, une loi ou une obligation établie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "respect_regles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque conducteur doit <w>obéir</w> aux règles du code de la route."
                        },
                        {
                            "text": "Dans une république, tous les citoyens doivent impérativement <w>obéir</w> à la loi."
                        }
                    ],
                    "synonyms": [
                        "respecter",
                        "suivre"
                    ],
                    "antonyms": [
                        "désobéir"
                    ],
                    "common_phrases": [
                        "obéir à la loi",
                        "obéir aux règles"
                    ]
                },
                {
                    "sense_id": "aaa7f56d-1d11-371f-bbb5-eeca3528d563",
                    "sense_definition": "Céder à une pulsion, un sentiment intérieur ou une nécessité extérieure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ceder_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face au danger soudain, elle a préféré <w>obéir</w> à son instinct de survie."
                        },
                        {
                            "text": "Il est parfois difficile de ne pas <w>obéir</w> à une impulsion spontanée."
                        }
                    ],
                    "synonyms": [
                        "céder"
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "obéir à son instinct",
                        "obéir à une impulsion"
                    ]
                },
                {
                    "sense_id": "891a6b63-c514-322c-8ca0-303e371175da",
                    "sense_definition": "Répondre avec précision à un mouvement, une commande ou une action mécanique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'accident, ses doigts fatigués refusaient de lui <w>obéir</w> correctement."
                        },
                        {
                            "text": "Le véhicule refuse d'<w>obéir</w> aux commandes lorsque la route est verglacée."
                        }
                    ],
                    "synonyms": [
                        "répondre"
                    ],
                    "common_phrases": [
                        "obéir aux commandes"
                    ]
                }
            ]
        }
    ]
}