                "senses": [
                    {
                        "sense_id": "e1052ca8-7482-3250-b454-5c38aede333f",
                        "entry_id": "5d3ed4a7-2150-32cc-a24c-89787838613a",
                        "glosses": [
                            "Kavallerie der Landwehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2e4e3d5-bbf0-4dd8-ac96-3b0688211365",
                                "sense_id": "e1052ca8-7482-3250-b454-5c38aede333f",
                                "text": "„Diese Brigade bestand aus vier Bataillonen des dritten kurmärkischen Landwehrinfanterie-Regiments und aus eben so viel Schwadronen Landwehrkavallerie.“"
                            },
                            {
                                "example_id": "27567e67-90d4-465f-848a-47a8d443577c",
                                "sense_id": "e1052ca8-7482-3250-b454-5c38aede333f",
                                "text": "„Die für die Dauer des mobilen Verhältnisses zu Commandeuren von Landwehrkavallerie-Regimentern ernannten Stabsoffizier haben die Uniform der genannten Regimenter anzulegen.“"
                            },
                            {
                                "example_id": "adb40f46-3af4-42c6-b807-b859d5def4d5",
                                "sense_id": "e1052ca8-7482-3250-b454-5c38aede333f",
                                "text": "„Da in Folge der neuen Formation der Landwehr-Kavallerie an Stelle der Landwehr-Bataillons-Bezirke die Bezirke der Landwehr-Kavallerie-Regimenter getreten sind, so ermächtige ich Sie, den Minister des Innern, …, auf die zu einem Landwehr-Kavallerie-Regiments-Bezirke gehörigen Kreise und Kreistheile ausgedehnt werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
