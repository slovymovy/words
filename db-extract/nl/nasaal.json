                                    {
                                        "sense_id": "92b3c5d0-cb6f-31ac-8995-067dada7ef62",
                                        "entry_id": "3391ab8a-189f-3c3b-9042-9ff28926fa7f",
                                        "glosses": [
                                            "Of or pertaining to the nose or to the nasion."
                                        ],
                                        "tags": [
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d3ac473-c2e5-4519-97b0-01662c997b23",
                                                "sense_id": "92b3c5d0-cb6f-31ac-8995-067dada7ef62",
                                                "text": "Neffy uses the same spray device as Narcan, the naloxone nasal spray for opioid overdose, according to a spokesperson for its maker, ARS Pharmaceuticals."
                                            },
                                            {
                                                "example_id": "ae98ffaa-ef90-490b-b717-51656a694eb6",
                                                "sense_id": "92b3c5d0-cb6f-31ac-8995-067dada7ef62",
                                                "text": "Reindeer are well suited to the taiga’s frigid winters. They can maintain a thermogradient between body core and the environment of up to 100 degrees, in part because of insulation provided by their fur, and in part because of counter-current vascular heat exchange systems in their legs and nasal passages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c215993-feda-3f6b-b645-7fb1f8c1af26",
                                        "entry_id": "3391ab8a-189f-3c3b-9042-9ff28926fa7f",
                                        "glosses": [
                                            "Having a sound imparted by means of the nose; and specifically, made by lowering the soft palate, in some cases with closure of the oral passage, the voice thus issuing (wholly or partially) through the nose, as in the consonants m, n, ng."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc73734-f51b-4ae8-b2e7-c2426e09953f",
                                                "sense_id": "3c215993-feda-3f6b-b645-7fb1f8c1af26",
                                                "text": "nasal vowel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9abcca-4349-32bc-a572-1dd17595707c",
                                        "entry_id": "3391ab8a-189f-3c3b-9042-9ff28926fa7f",
                                        "glosses": [
                                            "Characterized by resonance in the nasal passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0429309-622a-4967-9292-ae9b3ead6b96",
                                                "sense_id": "be9abcca-4349-32bc-a572-1dd17595707c",
                                                "text": "nasal utterance"
                                            },
                                            {
                                                "example_id": "897954cb-426d-4165-b62d-6cbeb7d35c15",
                                                "sense_id": "be9abcca-4349-32bc-a572-1dd17595707c",
                                                "text": "\"Are you sure you're OK?\" she said with a nasal Australian accent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da43e70a-62d9-3e78-a051-02891610b3ad",
                                        "entry_id": "3391ab8a-189f-3c3b-9042-9ff28926fa7f",
                                        "glosses": [
                                            "Sharp, penetrating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nasal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b72e4d-7941-3be7-ae10-34844c66f24e",
                                        "entry_id": "c94a02ff-0d79-3248-88a2-ce9fccbf7cb6",
                                        "glosses": [
