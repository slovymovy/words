{
    "word_family": [
        "lopen",
        "los",
        "losloper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1191709-5be1-388f-a15c-bf2c47f5fbf1",
                    "sense_definition": "vrij rondlopen zonder aangelijnd of opgesloten te zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit park mogen honden het hele jaar door vrij <w>loslopen</w>.",
                            "target_lang_translations": {
                                "fr": "Dans ce parc, les chiens sont autorisés à <w>se promener en liberté</w> toute l'année."
                            }
                        },
                        {
                            "text": "De boer waarschuwde dat er een paar jonge paarden in de wei <w>losliepen</w>.",
                            "target_lang_translations": {
                                "fr": "Le fermier a prévenu que quelques jeunes chevaux <w>étaient en liberté</w> dans le pré."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondlopen"
                    ],
                    "common_phrases": [
                        "vrij loslopen",
                        "mogen loslopen"
                    ],
                    "target_lang_definitions": {
                        "fr": "se promener librement sans être tenu en laisse ou enfermé"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se promener en liberté",
                                "target_lang_sense_clarification": "pour un animal, sans laisse"
                            },
                            {
                                "target_lang_word": "vagabonder",
                                "target_lang_sense_clarification": "errer librement"
                            },
                            {
                                "target_lang_word": "être en liberté",
                                "target_lang_sense_clarification": "ne pas être attaché"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d2ca561-ef7d-3d56-be40-395b139ca5cd",
                    "sense_definition": "een goede afloop kennen of uiteindelijk meevallen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verloop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Maak je geen zorgen over het examen, het zal allemaal wel <w>loslopen</w>.",
                            "target_lang_translations": {
                                "fr": "Ne t'inquiète pas pour l'examen, tout va bien <w>s'arranger</w>."
                            }
                        },
                        {
                            "text": "Iedereen was bang voor problemen, maar uiteindelijk is het gelukkig <w>losgelopen</w>.",
                            "target_lang_translations": {
                                "fr": "Tout le monde craignait des ennuis, mais heureusement, tout a fini par <w>bien se passer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "meevallen"
                    ],
                    "common_phrases": [
                        "wel loslopen",
                        "zal loslopen"
                    ],
                    "target_lang_definitions": {
                        "fr": "bien se terminer ou s'arranger finalement"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "s'arranger",
                                "target_lang_sense_clarification": "pour une situation, bien finir"
                            },
                            {
                                "target_lang_word": "bien se passer",
                                "target_lang_sense_clarification": "se dérouler sans problème"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34ecc6ec-9bfc-346e-8ec4-bdc82c5803b4",
                    "sense_definition": "lopen zonder steun of houvast",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na maanden van zware revalidatie kon de patiënt eindelijk weer zelfstandig <w>loslopen</w>.",
                            "target_lang_translations": {
                                "fr": "Après des mois d'une rééducation difficile, le patient a enfin pu <w>marcher seul</w> de façon autonome."
                            }
                        },
                        {
                            "text": "Het kind durfde nog niet zonder de hand van zijn moeder <w>los</w> te <w>lopen</w>.",
                            "target_lang_translations": {
                                "fr": "L'enfant n'osait pas encore <w>marcher sans soutien</w> en lâchant la main de sa mère."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "marcher seul sans aide ni appui"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "marcher seul",
                                "target_lang_sense_clarification": "sans aide ni béquilles"
                            },
                            {
                                "target_lang_word": "marcher sans soutien",
                                "target_lang_sense_clarification": "sans appui"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}