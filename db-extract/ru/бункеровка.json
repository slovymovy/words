                                        "glosses": [
                                            "The supplying of a ship or steam locomotive with coal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325250bf-f572-44e1-863f-7a33d7829760",
                                                "sense_id": "136142f7-1418-3360-9233-12f954c65ccf",
                                                "text": "Apart from brief intervals for watering and coaling, No. 2395 is continuously in steam each week from 4 a.m. on Monday until 3 a.m. on the following Sunday."
