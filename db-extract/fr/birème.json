                        "entry_id": "d6882330-2dc8-3d2e-bc5b-2e714560adf1",
                        "glosses": [
                            "Sorte de galère qui avait deux rangs de rames de chaque côté."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "0948f0bc-5dc5-45dc-93b5-95583ebdf70b",
                                "sense_id": "b4878b8e-4ff9-3c2d-889e-7cc3bfb90cd1",
                                "text": "Séjan attendait pour le conduire lui-même à la mer, où une birème de guerre se balançait dans le port, prête à déployer ses voiles."
                            }
                        ]
                    },
                    {
                        "sense_id": "db1d55d3-1adf-3415-b14a-cc524e969c1c",
                        "entry_id": "d6882330-2dc8-3d2e-bc5b-2e714560adf1",
                        "glosses": [
                            "Barque à deux rames."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ad1d37c9-04f0-48b6-9514-2dc58696e431",
                                "sense_id": "db1d55d3-1adf-3415-b14a-cc524e969c1c",
                                "text": "Neptune ou les vents, tourmentèrent notre frêle birème : matelots, officiers, passagers, deux femme même, tour-à-tour nous conduisions les rames ; […]."
                            }
                        ]
                    }
