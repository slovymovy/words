    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1072e5b7-8a57-34c1-b104-dd48e3d4e04b",
                    "sense_definition": "The dried leaf of the South American coca shrub, chewed as a mild stimulant or processed into cocaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coca_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Locals often chew <w>coca</w> leaves to help combat the effects of altitude sickness.",
                            "target_lang_translations": {
                                "zh": "当地人经常咀嚼<w>古柯</w>叶，以帮助缓解高原反应。"
                            }
                        },
                        {
                            "text": "The traditional market sold bags of dried <w>coca</w> alongside various herbal remedies.",
                            "target_lang_translations": {
                                "zh": "传统市场上出售成袋的干<w>古柯叶</w>，以及各种草药制剂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "coca leaves",
                        "coca tea"
                    ],
                    "target_lang_definitions": {
                        "zh": "南美古柯灌木的干叶，可作轻度兴奋剂咀嚼，或用于提炼可卡因。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "古柯叶",
                                "target_lang_sense_clarification": "古柯树叶"
                            },
                            {
                                "target_lang_word": "古柯",
                                "target_lang_sense_clarification": "指代古柯叶或制成品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "598d05d5-86e3-3a21-8e90-175d4e1b6857",
                    "sense_definition": "A South American shrub of the genus Erythroxylum, cultivated for its leaves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coca_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers in the Andes have cultivated <w>coca</w> for thousands of years.",
                            "target_lang_translations": {
                                "zh": "安第斯山脉的农民种植<w>古柯</w>已有数千年历史。"
                            }
                        },
                        {
                            "text": "The government launched a campaign to eradicate illicit <w>coca</w> crops in the valley.",
                            "target_lang_translations": {
                                "zh": "政府发起了一场铲除该山谷非法<w>古柯</w>作物的行动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "coca plant",
                        "coca cultivation"
                    ],
                    "target_lang_definitions": {
                        "zh": "古柯属的一种南美灌木，因其叶片而被人工种植。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "古柯",
                                "target_lang_sense_clarification": "植物名，一种灌木"
                            },
                            {
                                "target_lang_word": "古柯树",
                                "target_lang_sense_clarification": "古柯植株"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be1f3ea0-7ce2-3148-bf6b-ff8369eed5d6",
                    "sense_definition": "A traditional flat pastry or bread from Catalan cuisine, topped with sweet or savory ingredients.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For lunch we shared a savory <w>coca</w> topped with roasted peppers and sardines.",
                            "target_lang_translations": {
                                "zh": "午餐时，我们分享了一块铺有烤辣椒和沙丁鱼的咸味<w>科卡饼</w>。"
                            }
                        },
                        {
                            "text": "Every local bakery prepares a special sweet <w>coca</w> to celebrate the midsummer festival.",
                            "target_lang_translations": {
                                "zh": "每家当地面包店都会准备一款特别的甜味<w>科卡饼</w>来庆祝仲夏节。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Spain"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "加泰罗尼亚的一种传统扁平面包或馅饼，上面铺有甜味或咸味配料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "科卡饼",
                                "target_lang_sense_clarification": "西班牙加泰罗尼亚传统糕点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8ced514d-7d68-383c-91f4-631eb4d7bd7e",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We attended an art exhibition curated by Professor <w>Coca</w>.",
                            "target_lang_translations": {
                                "zh": "我们参加了由<w>科卡</w>教授策划的艺术展。"
                            }
                        },
                        {
                            "text": "The library dedicated a special wing to the historical works of Mr. <w>Coca</w>.",
                            "target_lang_translations": {
                                "zh": "图书馆专门设立了一个侧翼展厅，用于收藏<w>科卡</w>先生的历史著作。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "人名，姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "科卡",
                                "target_lang_sense_clarification": "姓氏译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2a74c72-60d3-3685-8366-4826f33782e9",
                    "sense_definition": "A river in eastern Ecuador, flowing as a tributary of the Napo River.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ecuador_geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Heavy rainfall caused the <w>Coca</w> to overflow its banks, flooding nearby villages.",
                            "target_lang_translations": {
                                "zh": "暴雨导致<w>科卡河</w>决堤，淹没了附近的村庄。"
                            }
                        },
                        {
                            "text": "The research team traveled along the <w>Coca</w> to study local freshwater biodiversity.",
                            "target_lang_translations": {
                                "zh": "研究小组沿着<w>科卡河</w>顺流而行，以研究当地淡水生物的多样性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "厄瓜多尔东部的一条河流，纳波河的支流。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "科卡河",
                                "target_lang_sense_clarification": "厄瓜多尔河流名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaed87cc-3cc4-399a-957e-e02076c4e1df",
                    "sense_definition": "A city in eastern Ecuador, also known as Puerto Francisco de Orellana.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ecuador_geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Travelers often use <w>Coca</w> as the main gateway to the Amazon rainforest.",
                            "target_lang_translations": {
                                "zh": "旅行者通常将<w>科卡</w>作为前往亚马逊雨林的主要门户。"
                            }
                        },
                        {
                            "text": "Our flight landed in <w>Coca</w> just before the afternoon storm began.",
                            "target_lang_translations": {
                                "zh": "我们的航班在下午的风暴来临之前降落在了<w>科卡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Puerto Francisco de Orellana"
                    ],
                    "target_lang_definitions": {
                        "zh": "厄瓜多尔东部城市，又称弗朗西斯科-德奥雷亚纳港。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "科卡",
                                "target_lang_sense_clarification": "厄瓜多尔城市名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "438a89ff-4a2e-3e0e-b553-77a8f026f2a8",
                    "sense_definition": "An acronym for the Corpus of Contemporary American English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "Linguists frequently consult <w>COCA</w> to analyze changes in modern English grammar.",
                            "target_lang_translations": {
                                "zh": "语言学家经常查阅<w>COCA</w>来分析现代英语语法的演变。"
                            }
                        },
                        {
                            "text": "She extracted thousands of text samples from <w>COCA</w> for her dissertation.",
                            "target_lang_translations": {
                                "zh": "她从<w>COCA</w>中提取了数千个文本样本用于她的学位论文。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
