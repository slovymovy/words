                "entry_id": "c07cf8d8-0e00-3b77-a5d6-5e32313e8421",
                "word": "lookit",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "41319d36-e5da-3345-b4c0-5f5749afd541",
                        "entry_id": "c07cf8d8-0e00-3b77-a5d6-5e32313e8421",
                        "glosses": [
                            "look, listen; see here, pay attention; the thing is, to be honest"
                        ],
                        "tags": [
                            "Canada",
                            "Ireland",
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "909cd6ac-2dfd-41a2-989f-21514d752de5",
                                "sense_id": "41319d36-e5da-3345-b4c0-5f5749afd541",
                                "text": "Ah lookit deputy, with all due respect to you, if you come in here and act like an ass that's exactly the label that you'll gain"
                            },
                            {
                                "example_id": "70dd343c-98f0-4779-85a4-d80ae7a2ac3f",
                                "sense_id": "41319d36-e5da-3345-b4c0-5f5749afd541",
                                "text": "Lookit! I'm old enough now, I'll wear what I want!"
                            },
                            {
                                "example_id": "7895e1eb-6d5f-429d-94bf-671c7657ac5c",
                                "sense_id": "41319d36-e5da-3345-b4c0-5f5749afd541",
                                "text": "Paddy said yesterday morning: \"Lookit he didn't murder anybody. He is not a bad lad.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b1e54162-cfc6-36b5-bfc6-76f3895c34f5",
                        "entry_id": "c07cf8d8-0e00-3b77-a5d6-5e32313e8421",
                        "glosses": [
                            "behold!; look at that; look here or there; look!"
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c618579d-2a07-47f9-8c9d-392006c38d86",
                                "sense_id": "b1e54162-cfc6-36b5-bfc6-76f3895c34f5",
                                "text": "He went right on cackling, \"Lookit lookit lookit. Oh Jesus, lookit. Lookit lookit.\" The blast had shattered all the windows, and flames were shooting out of all of them."
                            }
                        ]
                    }
