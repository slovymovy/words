                ],
                "senses": [
                    {
                        "sense_id": "05334c3c-21fe-399f-8fc0-695238abeaca",
                        "entry_id": "9817fc7a-c36d-3a3b-a5cf-0bd410dae653",
                        "glosses": [
                            "Person, die beim Spielen unmittelbar neben einer anderen agiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1acd721-772f-4273-bb56-a66790569146",
                                "sense_id": "05334c3c-21fe-399f-8fc0-695238abeaca",
                                "text": "„Die Spielnachbarn erhalten dann die Aufgabe, die Einzelteile wieder aneinanderzufügen.“"
                            },
                            {
                                "example_id": "3c1ccc92-4a03-4598-af9b-2dbaec89aaa0",
                                "sense_id": "05334c3c-21fe-399f-8fc0-695238abeaca",
                                "text": "„Die Sache falle schließlich auf seinen Spielnachbar, den seine Geldgier trieb, aus dem Erlebnis der Phantasie eines schwächlichen Mannes einen gesellschaftlichen Skandal zu machen.“"
                            },
                            {
                                "example_id": "3cf00dd1-049c-45bf-8462-43ca74e21317",
                                "sense_id": "05334c3c-21fe-399f-8fc0-695238abeaca",
                                "text": "„Der Spieler mit den meisten Karten auf der Hand beginnt. Der Reihe nach dürfen die Mitspieler immer vom linken Spielnachbarn eine Karte ziehen.“"
                            },
                            {
                                "example_id": "2b11b3cc-d94d-4b6e-b9d3-a32ef9dce773",
                                "sense_id": "05334c3c-21fe-399f-8fc0-695238abeaca",
                                "text": "„Wenn man auf einen Mond kommt, liest der linke Spielnachbar eine Fragekarte vor.“"
                            },
                            {
                                "example_id": "90a5da42-046c-41eb-8830-768f66173ff7",
                                "sense_id": "05334c3c-21fe-399f-8fc0-695238abeaca",
                                "text": "„Der linke Spielnachbar zieht die nächste Karte und beschreibt sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
