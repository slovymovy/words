                    {
                        "form_id": "09c7a56d-b998-493c-bfe3-f8590bb286b0",
                        "entry_id": "e65382cc-b130-31e5-8360-89f03b9befcc",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "прони́кнувши"
                    },
                    {
                        "form_id": "3a62bb0b-d304-421f-983a-d26a99c5be6c",
                        "entry_id": "e65382cc-b130-31e5-8360-89f03b9befcc",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "прони́кши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0dad2526-2a97-337f-9744-e60fdadf5e75",
                        "entry_id": "e65382cc-b130-31e5-8360-89f03b9befcc",
                        "glosses": [
                            "попасть внутрь чего-либо;"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93827c8-a879-43c3-ac96-732c250abc3d",
                                "sense_id": "0dad2526-2a97-337f-9744-e60fdadf5e75",
                                "text": "Этот необычный стон достиг слуха путешественников даже в кабине, куда, казалось, не мог проникнуть ни один звук извне."
                            }
                        ]
                    },
                    {
                        "sense_id": "703a17b4-2d90-30bf-978e-5ae21979add9",
                        "entry_id": "e65382cc-b130-31e5-8360-89f03b9befcc",
                        "glosses": [
                            "перен. скрытно пробраться куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84922579-c03f-42a3-932c-551d329e6958",
                                "sense_id": "703a17b4-2d90-30bf-978e-5ae21979add9",
                                "text": "Некоторые, как говорят, пытаются проникнуть на территорию Кремля, используя подземные городские коммуникации."
                            },
                            {
                                "example_id": "9cf045e3-6669-4fce-a37e-41412770f5df",
                                "sense_id": "703a17b4-2d90-30bf-978e-5ae21979add9",
                                "text": "Кто угодно мог проникнуть в квартиру в пятницу вечером, пока шла гулянка…"
                            }
                        ]
                    },
                    {
                        "sense_id": "dae17a5f-b474-35d1-a66e-6a8b7860a809",
                        "entry_id": "e65382cc-b130-31e5-8360-89f03b9befcc",
                        "glosses": [
                            "перен. детально понять, осознать что-либо сложное или неизвестное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43a28a69-cc27-4cd8-a152-b8890c5ceb7b",
                                "sense_id": "dae17a5f-b474-35d1-a66e-6a8b7860a809",
                                "text": "Ах, дорого бы я дал, чтобы проникнуть в его тайну, чтобы знать, какую такую Венеру он утратил и теперь бесплодно шарит руками в воздухе, ловит её?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a20f1c1-1156-4bd5-ab36-66e43fcebc6d",
                        "source_entry_id": "e65382cc-b130-31e5-8360-89f03b9befcc",
                        "source_sense_description": "попасть внутрь чего-либо",
                        "target_lang_word": "pénétrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pénétrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e8ab391-c280-355a-8007-056486650620",
                                        "entry_id": "c84c0eb7-dc53-3b0d-9260-cb0a85e1e94a",
                                        "glosses": [
                                            "Passer à travers ; entrer fort avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3841e70-b762-42e4-ade3-ec397634db3a",
                                                "sense_id": "3e8ab391-c280-355a-8007-056486650620",
                                                "text": "On ne lui aurait pas permis de pénétrer, ce jour-là, dans l’enceinte palissadée et encore moins de chercher des morts parmi les ruines."
                                            },
                                            {
                                                "example_id": "1e7483ca-3872-4975-86f4-cee999132825",
                                                "sense_id": "3e8ab391-c280-355a-8007-056486650620",
                                                "text": "Les vagues brisent à bord et submergent constamment le pont qui, mal calfaté à New-York, laisse pénétrer l’eau dans la cabine."
                                            },
                                            {
                                                "example_id": "a49d605b-7580-41b2-9d88-8bedf2ae855f",
                                                "sense_id": "3e8ab391-c280-355a-8007-056486650620",
                                                "text": "Un jour pourtant, il revint tout heureux. Il avait trouvé une entremetteuse qui l’introduirait auprès de sa bien-aimée. Il se déguiserait en femme, et pénétrerait ainsi dans le harem."
                                            },
                                            {
                                                "example_id": "5250ec34-ae32-4a13-b91e-2d150e110818",
                                                "sense_id": "3e8ab391-c280-355a-8007-056486650620",
                                                "text": "Il regardait au bas de la falaise la Morava tenter avec peine de faire pénétrer ses eaux vertes dans les flots boueux du Danube."
                                            },
                                            {
                                                "example_id": "f1ee3e4e-e72e-44d5-9195-e938f76ad504",
                                                "sense_id": "3e8ab391-c280-355a-8007-056486650620",
                                                "text": "De l’œuf sort une larve nageante, le miracidium, qui pénètre dans un mollusque gastéropode d’eau douce."
                                            },
                                            {
                                                "example_id": "910afd72-2b09-4498-9225-593f0cbda518",
                                                "sense_id": "3e8ab391-c280-355a-8007-056486650620",
                                                "text": "La Banque, qui à l’origine s’appelait Banco, est l’un des plus anciens jeux de cartes pratiqués en France, avant d’envahir l’Europe. Comme son nom l’indique, il est d’origine italienne et il pénétra en France sous Charles VIII, à la suite de guerres d’Italie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66e4e1e0-e0de-311c-953c-39b5a9ab9e52",
                                        "entry_id": "c84c0eb7-dc53-3b0d-9260-cb0a85e1e94a",
                                        "glosses": [
                                            "Découvrir, parvenir à connaître, avoir une profonde connaissance de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "760412e4-08b8-4903-ac80-bf32c4616cec",
                                                "sense_id": "66e4e1e0-e0de-311c-953c-39b5a9ab9e52",
                                                "text": "Tous les esclaves des rois et des reines sont autant d'espions de leurs cœurs. On pénétra bientôt qu'Astarté était tendre, et que Moabdar était jaloux."
                                            },
                                            {
                                                "example_id": "7e6b3f23-bbc0-43e1-a2b2-2ef3e544e24a",
                                                "sense_id": "66e4e1e0-e0de-311c-953c-39b5a9ab9e52",
                                                "text": "Quand Eugène fut parti, Félicité essaya de pénétrer le secret qu’on lui cachait."
                                            },
                                            {
                                                "example_id": "eb203e6e-e603-4fde-9a19-a7c2c8f8fde4",
                                                "sense_id": "66e4e1e0-e0de-311c-953c-39b5a9ab9e52",
                                                "text": "Dieu pénètre le fond des cœurs, les pensées les plus secrètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7368597-5fe1-3ab1-b823-b6592782dfb4",
                                        "entry_id": "c84c0eb7-dc53-3b0d-9260-cb0a85e1e94a",
                                        "glosses": [
                                            "Découvrir ses secrètes pensées, ses desseins cachés de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726f937a-0f11-4576-aac2-4848c636550f",
                                                "sense_id": "a7368597-5fe1-3ab1-b823-b6592782dfb4",
                                                "text": "Cet homme a beau feindre, il n’est pas difficile à pénétrer. — Il ne se laisse pas facilement pénétrer."
                                            },
                                            {
                                                "example_id": "ea6198cd-5423-4b60-bcfc-f072442021e7",
                                                "sense_id": "a7368597-5fe1-3ab1-b823-b6592782dfb4",
                                                "text": "Des éperviers, dorés eux aussi, m’escortaient un bout de chemin, tournaient sur ma tête très haut pour pénétrer mes intentions, et comme j’étais pur de tout dessein, ils m’abandonnaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e9b06a-f83e-3b25-a271-0946411f802c",
                                        "entry_id": "c84c0eb7-dc53-3b0d-9260-cb0a85e1e94a",
                                        "glosses": [
                                            "Pratiquer un coït sur ; commencer un rapport sexuel avec quelqu'un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3165985-0814-4dd4-9cbb-95b6afe9859e",
                                                "sense_id": "64e9b06a-f83e-3b25-a271-0946411f802c",
                                                "text": "Dans les relations sexuelles, l’un doit pénétrer, l’autre se laisser pénétrer, être réceptif. Les sociétés brodent des figures diverses sur le thème : l’homme doit faire ses preuves (rites de passage divers), la femme attendre (ses règles, un mari, des enfants, la ménopause)."
                                            },
                                            {
                                                "example_id": "a5c7388d-094d-42bc-bb47-9943f068d3af",
                                                "sense_id": "64e9b06a-f83e-3b25-a271-0946411f802c",
                                                "text": "Et sa volupté particulière, quand elle appliquait son corps contre le sien et qu’elle se pliait pour qu’il la pénétrât."
                                            },
                                            {
                                                "example_id": "55817698-c746-4081-978d-4029b1edd17f",
                                                "sense_id": "64e9b06a-f83e-3b25-a271-0946411f802c",
                                                "text": "Il la pénétrait bestialement, dans une hébétude sensuelle qui n'atteignait à la lucidité qu'à la minute où l'on voit, par une nuit d'été, la fusée d'un feu d'artifice fondre en un riche bouquet d'étoiles pâmées qui retombent au néant."
                                            },
                                            {
                                                "example_id": "ce3cc00e-faa1-4f37-ba52-f7069559a1ab",
                                                "sense_id": "64e9b06a-f83e-3b25-a271-0946411f802c",
                                                "text": "Un instant après, elle gisait sur sa couche. Un instant après, la robe neuve n’était que lambeaux. À travers l’une de ses déchirures Ouroz pénétra la nomade avec la violence d’un assassin qui, jusqu’au fond d’un ventre, plante son couteau."
                                            },
                                            {
                                                "example_id": "a0f4116e-cffc-4a7d-9a30-5fd134bbb837",
                                                "sense_id": "64e9b06a-f83e-3b25-a271-0946411f802c",
                                                "text": "Ils avaient glissé sur la moquette, elle écartait ses cuisses en détachant ses pieds du sol, il se reculait un peu et la pénétrait tout droit sans la moindre difficulté, ce dont je n’étais plus à m’étonner."
                                            },
                                            {
                                                "example_id": "1c52d7d2-d982-41eb-acd1-9afd1f88c282",
                                                "sense_id": "64e9b06a-f83e-3b25-a271-0946411f802c",
                                                "text": "Le scénario décrit par les victimes est identique : toutes deux ont raconté avoir été pénétrées par surprise par […] Y. alors qu’elles étaient endormies dans des appartements parisiens après des «afters», respectivement en 2014 et en 2017."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff1de23-437b-35ed-983d-5b892ea70d5a",
                                        "entry_id": "c84c0eb7-dc53-3b0d-9260-cb0a85e1e94a",
                                        "glosses": [
                                            "Toucher profondément."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad6f41b-875f-474e-9968-2f0ef0fd00c4",
                                                "sense_id": "cff1de23-437b-35ed-983d-5b892ea70d5a",
                                                "text": "Les beautés de la religion le pénètrent, pénètrent son âme."
                                            },
                                            {
                                                "example_id": "c60fe20f-e048-423f-b7df-8435f6078343",
                                                "sense_id": "cff1de23-437b-35ed-983d-5b892ea70d5a",
                                                "text": "Sa douleur me pénètre le cœur."
                                            },
                                            {
                                                "example_id": "dd5e94a6-7e6c-42d0-8a50-8feb9f46a036",
                                                "sense_id": "cff1de23-437b-35ed-983d-5b892ea70d5a",
                                                "text": "Silvia.— Je suis pénétrée de vos bontés, mon père. Vous me défendez toute complaisance, et je vous obéirai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da770fd-edde-3c81-a2dc-9d37d91aeaf6",
                                        "entry_id": "c84c0eb7-dc53-3b0d-9260-cb0a85e1e94a",
                                        "glosses": [
                                            "S’emploie comme verbe intransitif dans la plupart de ses acceptions."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c9ad06-f813-47f5-a14d-6b40aa0c4d49",
                                                "sense_id": "1da770fd-edde-3c81-a2dc-9d37d91aeaf6",
                                                "text": "Ces personnes ont craint, en pénétrant trop avant dans le système de l’homme, de voir disparaître ses plus brillantes attributions."
                                            },
                                            {
                                                "example_id": "94ab9f62-5e40-4c9a-b9bd-b7ff07ac1b11",
                                                "sense_id": "1da770fd-edde-3c81-a2dc-9d37d91aeaf6",
                                                "text": "Dès qu’il fait beau, la moindre brise soulève une fine poussière basaltique qui noircit tous les objets et pénètre dans les habitations les mieux closes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d7011d-ede7-333e-a6c3-1a49deade319",
                                        "entry_id": "c84c0eb7-dc53-3b0d-9260-cb0a85e1e94a",
                                        "glosses": [
                                            "Remplir son esprit, son âme de quelque pensée, de quelque sentiment."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a57bb4cd-5303-4d5e-8e57-589fb7ce3701",
                                                "sense_id": "63d7011d-ede7-333e-a6c3-1a49deade319",
                                                "text": "Il faut bien vous pénétrer de cette vérité."
                                            },
                                            {
                                                "example_id": "c4d80998-4144-4316-9c4b-1297feac5a7e",
                                                "sense_id": "63d7011d-ede7-333e-a6c3-1a49deade319",
                                                "text": "Se pénétrer du sentiment de ses devoirs."
                                            },
                                            {
                                                "example_id": "c12e242b-a557-4c8f-92c8-cca42d33d72c",
                                                "sense_id": "63d7011d-ede7-333e-a6c3-1a49deade319",
                                                "text": "Lorsque la fille de Bordeaux, qui était mariée avec Armingaud le charron, se fut bien pénétrée de ce sentiment qu’ils allaient rester à bâiller là jusqu’à l’heure du déjeuner, elle ne put retenir sa colère."
                                            },
                                            {
                                                "example_id": "bcd7c05e-7969-4eeb-9ab3-173d91868083",
                                                "sense_id": "63d7011d-ede7-333e-a6c3-1a49deade319",
                                                "text": "Lis-moi cela cette semaine et tâche de t’en pénétrer car je t’interrogerai sur son contenu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
