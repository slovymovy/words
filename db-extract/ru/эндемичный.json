                    },
                    {
                        "translation_id": "ab98f8f0-1eee-4d5a-8cbe-6591b058a37f",
                        "source_entry_id": "f1295781-5e17-3f42-97d2-eff5cb346c9a",
                        "source_sense_id": "ebcb1bcc-3461-3d4a-98b4-2af386c75e5c",
                        "target_lang_word": "endemico",
