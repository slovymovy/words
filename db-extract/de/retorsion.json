                            "accusative",
                            "singular"
                        ],
                        "form": "die Retorsion"
                    },
                    {
                        "form_id": "bbf40d24-e048-4810-9df3-fba8983bb2ff",
                        "entry_id": "8853019f-4df5-3960-b148-37b38f45efcf",
                        "tags": [
                            "accusative",
