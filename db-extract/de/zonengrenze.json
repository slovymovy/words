                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6876b27-10dc-3fef-8959-c704a385c7b1",
                        "entry_id": "ea3e47ec-3a3b-34e5-b5c6-4b8bad39a79c",
                        "glosses": [
                            "Grenze zwischen zwei Besatzungszonen nach dem zweiten Weltkrieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1877854d-6dfe-4960-a9be-0d51d7565d33",
                                "sense_id": "c6876b27-10dc-3fef-8959-c704a385c7b1",
                                "text": "„Als sie ihn an sich zog, ließ Kurt die Tasche fallen, die er von der Zonengrenze bis nach Kudenow geschleppt hatte.“"
                            },
                            {
                                "example_id": "1e890ce2-693b-47df-83bb-dc9f0de6f0e7",
                                "sense_id": "c6876b27-10dc-3fef-8959-c704a385c7b1",
                                "text": "„Mein erstes Etappenziel ist ein Dorf bei Braunschweig, nahe an der Zonengrenze.“"
                            },
                            {
                                "example_id": "39f1a351-c024-4fd2-b8af-1a4d554ef4a2",
                                "sense_id": "c6876b27-10dc-3fef-8959-c704a385c7b1",
                                "text": "„Die Zonengrenze wurde zur Grenze zwischen zwei Welten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "440ac0d0-64bd-311a-a2d5-d643510a956c",
                        "entry_id": "ea3e47ec-3a3b-34e5-b5c6-4b8bad39a79c",
                        "glosses": [
                            "Grenze zwischen der BRD und der DDR"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b214f2d8-a32d-4dd4-ae75-6be5e2b3749a",
                                "sense_id": "440ac0d0-64bd-311a-a2d5-d643510a956c",
                                "text": "„Hinter der Zonengrenze wird dir das Gleiche begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
