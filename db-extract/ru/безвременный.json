                                                "example_id": "9c5a0573-2544-40cd-a109-47de4b23d0dc",
                                                "sense_id": "a7e7fe3f-3478-32b0-b828-caded7ed87f3",
                                                "text": "Votre démarche paraîtra prématurée."
                                            }
                                        ]
                                    },
