                    },
                    {
                        "translation_id": "a5fdceb4-8cd3-4ba6-8bf7-8f98c2c07abf",
                        "source_entry_id": "a484a34e-b131-3142-be0c-cc6b1c8d9d70",
                        "source_sense_id": "8bcdf79d-a04a-3c4e-bdcb-6fb5b3fca956",
                        "target_lang_word": "vorausahnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorausahnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53542f29-faf1-309a-aacc-f7e99bd258d9",
                                        "entry_id": "0f263e90-4dec-3bf8-95da-198003c3dd1e",
                                        "glosses": [
                                            "etwas im Voraus ahnen, ahnend vorhersehen, ein Vorgefühl von etwas haben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f025b8f-6c7f-4825-9962-f682a5376e7f",
                                                "sense_id": "53542f29-faf1-309a-aacc-f7e99bd258d9",
                                                "text": "In den darauf folgenden Tagen stellte sich heraus, dass einige der Kinder und außerdem Menschen in ganz England die Tragödie vorausgeahnt hatten."
                                            },
                                            {
                                                "example_id": "5f3659bf-9d27-4708-8d16-e69170a5f064",
                                                "sense_id": "53542f29-faf1-309a-aacc-f7e99bd258d9",
                                                "text": "Auch etliche andere erkennen Parallelen zum aktuellen Unglücksfall und verweisen darauf, dass die \"Simpsons\"-Macher berühmt-berüchtigt dafür sind, Ereignisse der Zeitgeschichte scheinbar vorausgeahnt zu haben."
                                            },
                                            {
                                                "example_id": "a77107ae-bc0e-4b33-b150-cb76f122eed5",
                                                "sense_id": "53542f29-faf1-309a-aacc-f7e99bd258d9",
                                                "text": "Er sah gut und sah richtig, indem er die Spaltung des Königreichs in zwei Feldlager vorausahnte."
