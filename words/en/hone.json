                },
                {
                    "sense_id": "d8b8bf8e-8975-327e-a5a0-bbd1f36fdab6",
                    "sense_definition": "A type of swelling or growth located in the cheek.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the painful <w>hone</w> that had developed on the patient's inner cheek.",
                            "target_lang_translations": {
                                "zh": "医生检查了病人脸颊内侧长出的那个疼痛的<w>肿块</w>。"
                            }
                        },
                        {
                            "text": "She sought medical advice for the persistent <w>hone</w> inside her mouth.",
                            "target_lang_translations": {
                                "zh": "她因嘴里持续存在的<w>肿块</w>寻求了医疗建议。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This is a rare or obsolete medical term."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "脸颊内侧的肿胀或赘生物。"
                    },
                    "translations": {
                        "zh": []
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "3c87c145-2e0c-349c-b193-b0f2398b42bc",
                    "sense_definition": "An exclamation used to express deep sorrow or grief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hone</w>, the tragedy has left us all in complete despair.",
                            "target_lang_translations": {
                                "zh": "<w>唉</w>，这场悲剧让我们所有人都陷入了彻底的绝望。"
                            }
                        },
                        {
                            "text": "He cried out <w>hone</w> as he realized the extent of his loss.",
                            "target_lang_translations": {
                                "zh": "当他意识到损失的程度时，他大喊了一声“<w>唉</w>”。"
                            }
