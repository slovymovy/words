                ],
                "senses": [
                    {
                        "sense_id": "7a3111a0-f894-34e8-8906-85935679c71f",
                        "entry_id": "bf1d1ca1-f266-3f18-96e9-379afd604d95",
                        "glosses": [
                            "ein Werkzeugkasten, in dem Nüsse zum Schrauben und das Zusatzwerkzeug untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15edeaa0-c728-4838-b32c-fb78ef7c261c",
                                "sense_id": "7a3111a0-f894-34e8-8906-85935679c71f",
                                "text": "„Ca. 250 Verschraubungen bei der Montage von Stromumrichterkomponenten, wobei über einen Nussenkasten 10 verschiedene Sollwertsätze aufgerufen werden.“"
                            },
                            {
                                "example_id": "677a01d2-fcce-43d5-931c-0b037bba4837",
                                "sense_id": "7a3111a0-f894-34e8-8906-85935679c71f",
                                "text": "Fast jeder Mann hat zu Hause einen Nussenkasten."
                            },
                            {
                                "example_id": "9db232dd-74b3-40d9-a1a4-85747122b2ce",
                                "sense_id": "7a3111a0-f894-34e8-8906-85935679c71f",
                                "text": "„Ein einfacher Werkzeugkasten bestehend aus: Nussenkasten, Schraubendrehersortiment, diverse Gabel- und Ringschlüssel, Zangensortiment, Durchschlag, Hammer und Bohrmaschine sind bei weitem ausreichend. Spezialwerkzeuge, wie ein Schweißgerät, Hebebühne etc. sind nicht notwendig.“"
                            },
                            {
                                "example_id": "3cbb8fbd-f1db-4bc9-b4a0-f6473928143e",
                                "sense_id": "7a3111a0-f894-34e8-8906-85935679c71f",
                                "text": "Darüberhinaus habe ich einen Nussenkasten, bei dem die Nüsse ein \"Metrinch\"-Profil haben, damit sind Zollschrauben auch kein Thema mehr weil die Schlüssel an den Flanken und nicht an den Schraubenkanten angreifen."
                            },
                            {
                                "example_id": "564f8b25-45b8-4199-bd7b-add9f67824c0",
                                "sense_id": "7a3111a0-f894-34e8-8906-85935679c71f",
                                "text": "In einem Nussenkasten \"Made in Germany\" kann es also durchaus sein, dass nur das teure Kreuzgelenk, der Knebel und die Knarre in Deutschland gefertigt ist, der Kasten und die Nüsse aber aus einer Produktion sonstwoher kommen können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
