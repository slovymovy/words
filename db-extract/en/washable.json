                        "cross_references": [
                            {
                                "target_word": "lavable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77d859d4-0f15-366f-8920-95dc31f9af5b",
                                        "entry_id": "116f1a60-6437-3de2-abd5-b9818fd49770",
                                        "glosses": [
                                            "Qualifie un matériau, un objet qui peut être lavé sans être détérioré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea8e995f-b8c3-41b8-85a7-1b39d0f35139",
                                                "sense_id": "77d859d4-0f15-366f-8920-95dc31f9af5b",
                                                "text": "Sur le sol soit un revêtement lavable ou un tapis, moquette rêche et lavable."
                                            },
                                            {
                                                "example_id": "ec1f6c5a-ab78-4183-9ad6-f768c5cc62f9",
                                                "sense_id": "77d859d4-0f15-366f-8920-95dc31f9af5b",
                                                "text": "Place de la Comédie, une dame aux allures pincées demanda des gants de peau lavables.\n- Lavables ? répéta Alice d’un air ahuri. Ça n’existe pas !"
                                            },
                                            {
                                                "example_id": "6526cf52-2b96-4251-ba98-a52179cf39c8",
                                                "sense_id": "77d859d4-0f15-366f-8920-95dc31f9af5b",
                                                "text": "Si la couette est lavable en machine, ajoutez une ou deux balles de tennis dans le tambour : cela évitera que la garniture intérieure ne se mette en boule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56abcee1-c3b7-3a17-91e0-12e8a0d2f8b0",
                                        "entry_id": "116f1a60-6437-3de2-abd5-b9818fd49770",
                                        "glosses": [
                                            "Qualifie une substance qui peut être enlevée par un lavage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ec3270-db16-4054-9544-18ffedb74c1d",
                                                "sense_id": "56abcee1-c3b7-3a17-91e0-12e8a0d2f8b0",
                                                "text": "Les enfants se sont amusés comme des fous, moi aussi, les parents beaucoup moins quand ils sont venus récupérer leurs rejetons barbouillés de ce fichu glaçage rose. Une des mères m’a demandé si c’était lavable."
                                            },
                                            {
                                                "example_id": "45d13382-802a-468a-a2f2-d0fd34979f73",
                                                "sense_id": "56abcee1-c3b7-3a17-91e0-12e8a0d2f8b0",
                                                "text": "Et cette encre, qui sèche en deux minutes à peine, n’est non seulement pas dangereuse pour la santé, mais est en plus lavable avec de l’eau et du savon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7ad8df7-5465-36be-b42e-ff63f6cf3ac3",
                                        "entry_id": "116f1a60-6437-3de2-abd5-b9818fd49770",
                                        "glosses": [
                                            "Qualifie un billet vendu à prix réduit, à charge pour l’acheteur de faire partie de la claque."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "792b8c06-b6e4-4f8b-a17d-d533440e9d8a",
                                                "sense_id": "d7ad8df7-5465-36be-b42e-ff63f6cf3ac3",
                                                "text": "Ils vendent alors la moitié ou les trois quarts des billets, et ceux qu’ils destinent au commerce sont lavables : …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lavable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ced10f2-2766-352b-a2c2-62d4d3735238",
                                        "entry_id": "d8567999-ef5f-373d-a166-55c67a5b3ac1",
                                        "glosses": [
                                            "Billet vendu à prix réduit, à charge pour l’acheteur de faire partie de la claque."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee64ae5c-c97b-42ac-9b6b-5eef9468e586",
                                                "sense_id": "0ced10f2-2766-352b-a2c2-62d4d3735238",
                                                "text": "… un lavable coûte presque toujours les deux tiers de la valeur d'un billet pris au bureau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48756b5a-315b-32f5-aab3-4725c6ccb660",
                                        "entry_id": "d8567999-ef5f-373d-a166-55c67a5b3ac1",
                                        "glosses": [
                                            "Spectateur ayant payé un tel billet et faisant donc partie de la claque."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a540c2e0-61e6-4e0a-8d55-210cae8e8b16",
                                                "sense_id": "48756b5a-315b-32f5-aab3-4725c6ccb660",
                                                "text": "Donc le lavable entre au café, prend quelque chose et discute avec le chef de claque d’une place avec rabais, moyennant quoi il doit suivre attentivement les indications de son supérieur, et frapper durement et longuement à l’instant où le mouvement sera propagé jusqu’à lui de l’œil, du geste et des coudes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "512d275d-ec0b-459d-8786-4321b59d0acf",
                        "source_entry_id": "1ba3a248-fe6e-3084-8802-d12bce407aec",
                        "source_sense_id": "54af251b-0828-369a-a49a-f682f8534ac8",
                        "source_sense_description": "capable of being washed without being damaged",
                        "target_lang_word": "waschbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waschbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                        "entry_id": "5660f73e-0a3c-38df-85d5-94f1fb7475cc",
                                        "glosses": [
                                            "so, dass es gewaschen oder (meist mit Wasser und Seife) gereinigt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c230bfd8-e662-4f7c-940a-a294addd6b8b",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "Es gibt waschbare Windeln (Stoffwindeln), aber meist werden in Mitteleuropa Wegwerfwindeln bevorzugt."
                                            },
                                            {
                                                "example_id": "8d1c2889-a311-443d-9fd5-ba668b0a9bec",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "„Ob waschbare Mehrwegwindeln wirklich umweltfreundlicher sind, haben Wissenschaftler der University of Queensland in Australien untersucht.“"
                                            },
                                            {
                                                "example_id": "46a8e520-aaa9-483d-8b1b-0293f512d556",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "Welche Kleidungsstücke in der Maschine waschbar sind, erkennt man am Etikett."
                                            },
                                            {
                                                "example_id": "a8b27dd8-7049-4143-8b70-1b30a9d7d2e0",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "„Taschentücher gibt es als waschbare Stofftaschentücher oder als Papiertaschentücher, die nach dem Gebrauch entsorgt werden.“"
                                            },
                                            {
                                                "example_id": "1e74a981-832a-447c-98ce-69820414aed5",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "[Flecken:] „Waschbare Stoffe behandelt man am besten gleich mit lauwarmem Wasser - außer bei eiweißhaltigen Verschmutzungen wie Blut.“"
                                            },
                                            {
                                                "example_id": "48d3431a-f915-4062-9f69-8b4b749bb8a1",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "„Den waschbaren Bezug der Matratze sollten Sie alle drei Monate waschen, wobei normales Waschmittel genügt.“"
                                            },
                                            {
                                                "example_id": "a644d906-4f6e-47fa-816e-83b9fdc887a6",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "„Waschbare Daunenduvets sollte man jährlich waschen.“"
                                            },
                                            {
                                                "example_id": "cff0ddc5-337e-49a3-9a67-64f464f80e4c",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "„Entsorgt werden Einwegmasken im nächsten Abfallkübel. Waschbare Masken bewahrt man in einem Plastiksäckchen auf.“"
                                            },
                                            {
                                                "example_id": "86cbb131-3f45-4911-a73d-542659b08252",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "Das Jackett ist nicht waschbar, das muss man zur chemischen Rerinigung bringen."
                                            },
                                            {
                                                "example_id": "6b8aff1f-5fa9-4388-8498-0a8ce53ca147",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "Daunenjacken sind schlechter waschbar als solche aus synthetischem Material."
                                            },
                                            {
                                                "example_id": "b8a3a91e-a17c-4775-a8e5-b2c100402cc3",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "Wenn eine Mund-Nase-Maske mehrfach waschbar ist, reduziert man den Müll."
                                            },
                                            {
                                                "example_id": "26b02995-b937-459d-9dcb-b5abe3d74af1",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "„Aus hygienischen Gründen sollte ein Handtuch bei mindestens 60 Grad waschbar sein.“"
                                            },
                                            {
                                                "example_id": "4fc93ea1-f926-4551-83e6-6f4d3eb974d3",
                                                "sense_id": "45d82716-2562-3030-b1f1-06610fde3f09",
                                                "text": "„Auch weitverbreite überwiegend aus Kunstfaser und Thermoplastschaum hergestellte leichte Freizeitschuhe sind vorsichtig in der privaten Waschmaschine waschbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
