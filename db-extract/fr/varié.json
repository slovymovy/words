                                "sense_id": "b82023ab-93c0-32a2-a663-ae9cc62100c4",
                                "text": "Thème varié."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "318cf7bc-3929-4ad7-ad6c-f2c027af2cba",
                        "source_entry_id": "569c09c7-2e6d-375a-a496-84409fcc5b63",
                        "target_lang_word": "vielfältig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielfältig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                        "entry_id": "4703e92f-ce1e-30a3-8eab-4b0eca99d9f3",
                                        "glosses": [
                                            "in verschiedenen Arten und Weisen, mit vielen Seiten, vielen Aspekten, vielen Facetten, vielen Varianten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239f24ca-944c-4af8-a85d-56a30add9c13",
                                                "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                                "text": "„Ganztagsschulen, in denen Kinder vielfältige Lernerfahrungen sammeln, Phasen der An- und Entspannung erleben, mit ihren Mitschüler sozial interagieren können, seien eine geeignete Form, die Folgen der demografischen Entwicklung abzufedern.“"
                                            },
                                            {
                                                "example_id": "1d406064-bba8-44a4-9ef3-676d237ea847",
                                                "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            },
                                            {
                                                "example_id": "fc5d667f-09db-4e14-aa0a-068076fb956d",
                                                "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                                "text": "„Bergerlebnisse im Zillertal lassen sich auf vielfältige Weise zelebrieren. Beispielsweise beim Klettern, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
