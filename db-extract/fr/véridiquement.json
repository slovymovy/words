                        "glosses": [
                            "D’une manière véridique ; avec l’accent de la vérité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8932b5b-6917-4600-8550-115bdf56e6e3",
                                "sense_id": "2ae23dcb-c62f-34af-8775-be7c4d21f482",
                                "text": "Il faut en conclure que chaque fois qu'on affirme véridiquement une chose, elle existe réellement ; et inversement, que chaque fois qu'on affirme qu'une chose existe réellement, l'affirmation est véridique."
                            }
                        ]
                    }
                ],
                "translations": [
