                    },
                    {
                        "translation_id": "4add7d5e-7ee4-4083-a8ff-daa5dde8933d",
                        "source_entry_id": "f079abdc-46c4-33c2-bd56-2e998d5b9257",
                        "source_sense_id": "798eecac-3d41-3090-baa3-7d283cd5cc5f",
                        "source_sense_description": "insect uit de orde Ephemeroptera",
                        "target_lang_word": "efímera",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efímera",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "484e9f4c-bec8-3ef2-9662-312dfd99fbf9",
                                        "entry_id": "53f612d4-a88d-353a-8e79-9488d5c3799b",
                                        "glosses": [
                                            "(orden Ephemeroptera) Cualquiera de unas 2500 especies de insectos pterigotos, característicos por su complejo ciclo vital. Pasan la mayor parte de su vida en forma de ninfa, de hábito acuático, mudando repetidamente hasta alcanzar la forma madura de imago alada; la mayoría de las especies sólo vive unas pocas horas en esta forma, muriendo poco después de la reproducción."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8093cd7-73f7-480e-b2b0-47813bdca5de",
                                                "sense_id": "484e9f4c-bec8-3ef2-9662-312dfd99fbf9",
                                                "text": "Encontraron que al reducir del 10 al 60% en la riqueza de las especies, al utilizar la densidad de la población de una especie de efímera (Insecta: Ephemeroptera) y la diversidad de especies, como caracterizadoras del impacto."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fe748a0-7106-3125-8bee-094b347e1f4d",
                                        "entry_id": "53f612d4-a88d-353a-8e79-9488d5c3799b",
                                        "glosses": [
                                            "Fiebre repentina y pasajera, que se diagnosticaba antiguamente como debida a la fatiga."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d729e0-8dd7-4840-9450-186269178d52",
                                                "sense_id": "5fe748a0-7106-3125-8bee-094b347e1f4d",
                                                "text": "—Pues desengáñelo Vuesa Merced, que ésta no es efímera, sino otra fiebre y muy vellaca; tanto digo, que no se levantará della, sy no es para el hoyo."
                                            }
                                        ],
