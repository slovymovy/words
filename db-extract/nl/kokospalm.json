                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71d9bc55-7116-40b3-9e32-e2f0bd58edf6",
                                                "sense_id": "21c40e86-3f87-3d1b-953a-c155704d8180",
                                                "text": "[Ashley J. Williams shoots a zombified version of the Winter Soldier in the head.]\nDazzler: Oh my God...thank you! I-i-is he--\nAshley J. Williams: A double-barrel boomstick blast straight through the coconut? Trust me, babe--he's not comin' back from that one."
                                            },
                                            {
                                                "example_id": "0a3e072f-d712-4092-9033-68e01dae918e",
                                                "sense_id": "21c40e86-3f87-3d1b-953a-c155704d8180",
                                                "text": "'How unfortunate.'\n'Yes. It's rather causing him to go off his coconut. He's met a girl, you see. A peach.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
