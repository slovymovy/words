                                        "entry_id": "3f38c86b-971e-3ba5-a90e-76c82b20fd85",
                                        "glosses": [
                                            "Not contestable; indisputable; certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71891e94-0f2d-47ef-9d13-334a15258324",
                                                "sense_id": "c8cd4e62-dce4-3b28-8b13-bc3c5133c9f9",
                                                "text": "That he was the greatest 100m runner of his generation was incontestable."
                                            }
