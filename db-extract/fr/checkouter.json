                "senses": [
                    {
                        "sense_id": "398c01c5-4f91-3385-b184-4386528af59a",
                        "entry_id": "6a1298f8-d65f-3d7a-992b-a39c6d203ed3",
                        "glosses": [
                            "Fournir des fichiers par une commande checkout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd22bcfc-4610-4dd8-bda3-7830811345e4",
                                "sense_id": "398c01c5-4f91-3385-b184-4386528af59a",
                                "text": "En effet, l’une des forces de Maven est qu’il est actuellement possible de checkouter un seul module (et non tous) et de travailler dessus."
                            },
                            {
                                "example_id": "3089a7bc-8152-4fbc-8c64-ee057d75ee47",
                                "sense_id": "398c01c5-4f91-3385-b184-4386528af59a",
                                "text": "Tu peux \"checkouter\" le projet directement depuis l’écran d’accueil d’Android Studio en cliquant sur \"Check out from Version Control\" : image."
                            },
                            {
                                "example_id": "2f45ea54-b4d3-46a9-b59d-55ed90e7952f",
                                "sense_id": "398c01c5-4f91-3385-b184-4386528af59a",
                                "text": "Tous les fichiers que l’on vient de \"checkouter\" sont les fichiers que je vais vouloir inclure à mon dépôt privé."
                            }
                        ]
                    }
