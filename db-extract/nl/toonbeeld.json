                        "examples": [
                            {
                                "example_id": "e16ac421-b5c6-4056-98d8-08848a332a05",
                                "sense_id": "148beef9-dbc6-30ee-9213-d34b52a799c2",
                                "text": "Hij was voor mij het toonbeeld van alles waar de trail voor stond: Amerikaans, groot, sterk."
                            },
                            {
                                "example_id": "c8a4b9b1-8b6a-4866-b9f2-b371f084d471",
                                "sense_id": "148beef9-dbc6-30ee-9213-d34b52a799c2",
                                "text": "Hij zat voorovergebogen, ellebogen op zijn knieën, zijn handen tegen de zijkant van zijn hoofd gedrukt het toonbeeld van neerslachtigheid."
                            }
                        ]
                    }
