                    },
                    {
                        "form_id": "cd038cfb-be5e-42c7-9e71-03843f33102e",
                        "entry_id": "2ede6abe-f28e-3a83-8692-bd2246d58233",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Telepathie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                        "entry_id": "2ede6abe-f28e-3a83-8692-bd2246d58233",
                        "glosses": [
                            "Wahrnehmung von Gedanken anderer oder anderen Dingen ohne Hilfe der Sinnesorgane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b73768bb-5e7a-46c6-a2a5-b47cb129b9b4",
                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                "text": "Die Parapsychologie unterscheidet im Bereich der übersinnlichen Wahrnehmung drei Formen: die Telepathie, das Hellsehen und die Präkognition."
                            },
                            {
                                "example_id": "3db6122e-75e4-48f0-8145-a2dfd45cf500",
                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                "text": "„Es war fast wie Telepathie, denn Lea hatte kein Geräusch vernommen, als sie noch im Finstern, etwa gegen drei Uhr früh, leise aufstand und durch Zimmer und Küche zu dem kleinen Raum bei der Haustür gelangte.“"
                            },
                            {
                                "example_id": "bf7f8235-323a-48d2-8b8c-5dbe1bac1082",
                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                "text": "„Sie hatte ihm Vorträge über Telepathie und Magnetismus gehalten, die sie offensichtlich wortgleich aus einem ihrer esoterischen Bücher entnommen hatte.“"
                            },
                            {
                                "example_id": "365a4773-5a37-466a-8498-e2cec93db077",
                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                "text": "„Nur Telepathie ist noch günstiger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20ce52fc-33c5-4bd5-bf6e-b920b9239bfb",
                        "source_entry_id": "2ede6abe-f28e-3a83-8692-bd2246d58233",
                        "source_sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                        "source_sense_description": "Wahrnehmung von Gedanken anderer oder anderen Dingen ohne Hilfe der Sinnesorgane",
                        "target_lang_word": "telepathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telepathy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "402f5abe-ea52-3604-a510-357c748a4c16",
                                        "entry_id": "49f07c8b-b52e-3a36-8e53-4a06f785b962",
                                        "glosses": [
                                            "The capability to communicate directly by psychic means; the sympathetic affection of one mind by the thoughts, feelings, or emotions of another at a distance, without communication through the ordinary channels of sensation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc428e4-190a-4ccd-bea7-c888d167e69a",
                                                "sense_id": "402f5abe-ea52-3604-a510-357c748a4c16",
                                                "text": "Gerwin Schalk and Anthony Ritaccio, at the Albany Medical Center, are working under a multimillion-dollar grant from the U.S. military to design and develop devices that enable soldiers to communicate telepathically. Although this seems like something out of a science fiction story, the Pentagon believes that these so-called telepathy helmets are sufficiently feasible that it is devoting more than $6 million to the project. The target date for completion of the prototype device is 2017."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c71ab9e-b92f-42f1-b87d-42bdbf894b48",
                        "source_entry_id": "2ede6abe-f28e-3a83-8692-bd2246d58233",
                        "source_sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                        "source_sense_description": "Wahrnehmung von Gedanken anderer oder anderen Dingen ohne Hilfe der Sinnesorgane",
                        "target_lang_word": "τηλεπάθεια",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "τηλεπάθεια",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "eca9ea66-47a3-3921-a8ab-0bbd0ec35686",
                                        "entry_id": "304357bd-5612-367f-93f2-532edf6df6c9",
                                        "glosses": [
                                            "η υποτιθέμενη δυνατότητα ψυχικής επικοινωνίας συναισθημάτων, σκέψεων ή αισθήσεων από απόσταση, χωρίς το συνηθισμένο τρόπο επικοινωνίας"
                                        ],
                                        "tags": [
                                            "παραψυχολογία",
                                            "επιστημονική φαντασία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "795ddf02-d6d0-4e14-96e0-eb5319b25fe0",
                                                "sense_id": "eca9ea66-47a3-3921-a8ab-0bbd0ec35686",
                                                "text": "※ Ήξερε ο μπαμπάς σου να κάνει τέτοια πράγματα;» «Τι πράγματα;» «Τηλεπάθεια… τέτοια πράγματα. Δεν ήξερε, ε; Μπα, δεν πρέπει να ’ξερε, δεν υπάρχει τηλεπάθεια, γι' αυτό και πρέπει να κατεβάζεις μαλακίες, για να γράφεις βιβλία, αντί να ψάξεις για την αλήθεια. (Οι πληροφοριοδότες, Juan Gabriel Vásquez, Εκδόσεις Ίκαρος, 2015)"
                                            },
                                            {
                                                "example_id": "33350040-98c0-41e0-9453-74a62626eb54",
                                                "sense_id": "eca9ea66-47a3-3921-a8ab-0bbd0ec35686",
                                                "text": "※ Το άτομο μπορεί να γοητεύεται από τη μαγεία, τη μαντεία, την αστρολογία, το μεταφυσικό, να δονείται από την πίστη στην τηλεπάθεια, τη μεταθανάτια ζωή, να έχει εμμονές με συγκεκριμένες προκαταλήψεις ή δεισιδαιμονίες. (Μιλώντας για εμάς και τα προβλήματά μας, Μυρσίνη Κωστοπούλου, Εκδ. Καστανιώτη 2014)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
