        "fr-extract.jsonl": [
            {
                "entry_id": "29dd9bca-56d1-304d-be96-fcb88d087a36",
                "word": "nachmittags",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d330917a-2191-3c39-9795-33da3c1a053f",
                        "entry_id": "29dd9bca-56d1-304d-be96-fcb88d087a36",
                        "glosses": [
                            "L'après-midi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4c9dabc-070e-47c1-97a2-cc7f6c6578cc",
                                "sense_id": "d330917a-2191-3c39-9795-33da3c1a053f",
                                "text": "Nachmittags spielen die Jungen Fußball.",
                                "translation": "L'après-midi, les jeunes jouent au football."
                            },
                            {
                                "example_id": "68dc7ec2-8123-457e-863e-4875c5da390c",
                                "sense_id": "d330917a-2191-3c39-9795-33da3c1a053f",
                                "text": "Il est six heures de l'après-midi.",
                                "translation": "Es ist sechs Uhr nachmittags."
                            },
                            {
                                "example_id": "c49505cf-112e-4c2e-9015-3e7613c3d0f4",
                                "sense_id": "d330917a-2191-3c39-9795-33da3c1a053f",
                                "text": "Humboldt durchlief das Kurrikulum der (Bergbauakademie) in einem Vierteljahr. Morgens war er sechs Stunden unter der Erde, nachmittags hörte er Vorlesungen, am Abend und die Hälfte der Nacht lernte er für den nächsten Tag.",
                                "translation": "Humboldt acheva le programme de l’académie (des mines) en trois mois. Le matin, il passait six heures sous terre, l’après-midi il assistait aux cours, le soir et la moitié de la nuit, il travaillait pour le jour suivant."
                            },
                            {
                                "example_id": "ac19c70a-96c2-4489-ac45-581bc8307110",
                                "sense_id": "d330917a-2191-3c39-9795-33da3c1a053f",
                                "text": "Wer nachmittags viel Kaffee trinkt, beeinträchtigt damit seine Melatonin-Produktion. Das körpereigene Hormon trägt in ausreichender Menge jedoch zu einem erholsamen Schlaf bei.",
                                "translation": "Boire beaucoup de café l’après-midi nuit à la production de mélatonine. Cette hormone produite par l’organisme contribue toutefois, en quantité suffisante, à un sommeil réparateur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
