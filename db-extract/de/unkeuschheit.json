                    {
                        "sense_id": "d47f7dfe-bb0e-37e7-aabf-dfd645afa231",
                        "entry_id": "0d15c03a-9f1e-3422-be44-5e38f6908c84",
                        "glosses": [
                            "sexuelle Aktivität gegen moralische oder religiöse Vorschriften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5556410b-a447-49b5-ac19-d43d5cec573a",
                                "sense_id": "d47f7dfe-bb0e-37e7-aabf-dfd645afa231",
                                "text": "„Er fragte den Delinquenten gerne nach anstößigen Gedanken und wollte wissen, wann jener Unkeuschheit betrieben habe.“"
                            },
                            {
                                "example_id": "1afabe10-bcd7-44a3-846b-b177065fd6ca",
                                "sense_id": "d47f7dfe-bb0e-37e7-aabf-dfd645afa231",
                                "text": "„Anna hat nie von meinen Orgien der Unkeuschheit erfahren, die ausschließlich in meinem Hirn tobten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
