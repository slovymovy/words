                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49078b1c-039e-4be4-870e-f4e6eda7a4d3",
                                "sense_id": "b8187d81-e273-3dd3-be5b-489f9c37e7c3",
                                "text": "Natürlich macht die Holzsorte einen Unterschied, Buche hat viel mehr Heizenergie als Fichte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ddc4bf9-29a3-4194-ba26-844aaca1686f",
                        "source_entry_id": "76c4bfaa-69e8-3e96-8ced-3cf45e8f1d45",
