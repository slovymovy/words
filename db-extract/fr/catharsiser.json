                        "examples": [
                            {
                                "example_id": "ced27ec0-b06a-47d4-9ec2-fbdd2957ab2a",
                                "sense_id": "4af3722a-23ed-3e92-a254-a23a7d360c76",
                                "text": "Le thérapeute est seulement là pour servir au transfert du passé et pour « catharsiser » le refoulement d’aujourd’hui."
                            },
                            {
                                "example_id": "8ccf274c-51b2-4b48-8a11-ac6870aced6f",
                                "sense_id": "4af3722a-23ed-3e92-a254-a23a7d360c76",
                                "text": "Je vous mets seulement en garde et vous dis : Enfant, tu as l’âge, fais ton ménage, catharsise, nettoie, renouvelle, culbute du coupable dans le sauf, révolutionne-toi toi-même avant de vouloir révolutionner les autres, tiens-toi à la poutre qui est dans ton œil et va trouver la créature bénie, un paysan celui-là, qui n’a qu’une paille dans l’œil et demande lui de t’aider à retirer la poutre…"
                            },
                            {
                                "example_id": "73f323c3-a9b1-40e6-b40d-ec08cbc31b1b",
                                "sense_id": "4af3722a-23ed-3e92-a254-a23a7d360c76",
                                "text": "Il catharsise et permet de vivre au-delà de tout."
                            }
                        ]
                    }
