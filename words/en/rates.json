{
    "word_family": [
        "rate",
        "rating",
        "ratable",
        "rater",
        "overrated",
        "underrated"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e50b42e4-5a07-38bf-bee9-f968748a75b0",
                    "sense_definition": "Plural of <w>rate</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exchange <w>rates</w> change every day.",
                            "target_lang_translations": {
                                "ru": "Обменные <w>курсы</w> меняются каждый день.",
                                "tr": "Döviz <w>kurları</w> her gün değişir."
                            }
                        },
                        {
                            "text": "Hotel <w>rates</w> are usually higher during the summer holidays.",
                            "target_lang_translations": {
                                "ru": "<w>Цены</w> в отелях обычно выше во время летних каникул.",
                                "tr": "Otel <w>fiyatları</w> yaz tatillerinde genellikle daha yüksektir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exchange rates",
                        "interest rates",
                        "high rates"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова \"rate\" (ставка, тариф, курс, темп).",
                        "tr": "\"Rate\" sözcüğünün çoğul şekli (oran, kur, fiyat, oranlar)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставки",
                                "target_lang_sense_clarification": "размер платежа или налога"
                            },
                            {
                                "target_lang_word": "тарифы",
                                "target_lang_sense_clarification": "цены на услуги"
                            },
                            {
                                "target_lang_word": "курсы",
                                "target_lang_sense_clarification": "валютные"
                            },
                            {
                                "target_lang_word": "темпы",
                                "target_lang_sense_clarification": "скорость развития или роста"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oranlar",
                                "target_lang_sense_clarification": "yüzde veya oran anlamında"
                            },
                            {
                                "target_lang_word": "kurlar",
                                "target_lang_sense_clarification": "döviz kurları"
                            },
                            {
                                "target_lang_word": "fiyatlar",
                                "target_lang_sense_clarification": "ücret veya tarifeler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56ebe5d4-1383-3c37-bfa5-c20207853527",
                    "sense_definition": "Abbreviation of interest rates.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The central bank decided to cut <w>rates</w> to help the economy.",
                            "target_lang_translations": {
                                "ru": "Центральный банк решил снизить <w>ставки</w>, чтобы помочь экономике.",
                                "tr": "Merkez bankası ekonomiye yardımcı olmak için <w>faizleri</w> düşürmeye karar verdi."
                            }
                        },
                        {
                            "text": "Investors are worried that <w>rates</w> might rise next month.",
                            "target_lang_translations": {
                                "ru": "Инвесторы обеспокоены тем, что <w>ставки</w> могут вырасти в следующем месяце.",
                                "tr": "Yatırımcılar <w>faiz oranlarının</w> önümüzdeki ay yükselebileceğinden endişeleniyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cut rates",
                        "raise rates",
                        "fed rates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"interest rates\" (процентные ставки).",
                        "tr": "\"Interest rates\" (faiz oranları) teriminin kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставки",
                                "target_lang_sense_clarification": "процентные"
                            },
                            {
                                "target_lang_word": "процентные ставки",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "faiz oranları",
                                "target_lang_sense_clarification": "genel anlamda faiz oranları"
                            },
                            {
                                "target_lang_word": "faizler",
                                "target_lang_sense_clarification": "kısaltma olarak faiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa05c2e9-2d10-3e54-886d-2aff560384c4",
                    "sense_definition": "Taxes, usually on property, levied by local government.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Homeowners have to pay their council <w>rates</w> annually.",
                            "target_lang_translations": {
                                "ru": "Домовладельцы должны платить муниципальные <w>налоги</w> ежегодно.",
                                "tr": "Ev sahipleri belediye <w>vergilerini</w> her yıl ödemek zorundadır."
                            }
                        },
                        {
                            "text": "The money collected from <w>rates</w> is used to maintain local parks and roads.",
                            "target_lang_translations": {
                                "ru": "Деньги, собранные за счет <w>налогов</w>, используются для содержания местных парков и дорог.",
                                "tr": "<w>Vergilerden</w> toplanan para yerel parkların ve yolların bakımında kullanılır."
                            }
                        }
                    ],
                    "synonyms": [
                        "property taxes",
                        "local taxes",
                        "levies"
                    ],
                    "common_phrases": [
                        "council rates",
                        "pay rates",
                        "water rates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Налоги, обычно на недвижимость, взимаемые местными органами власти.",
                        "tr": "Yerel yönetimler tarafından genellikle gayrimenkul üzerinden alınan vergiler."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "местные налоги",
                                "target_lang_sense_clarification": "муниципальные сборы"
                            },
                            {
                                "target_lang_word": "коммунальные сборы",
                                "target_lang_sense_clarification": "платежи за обслуживание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerel vergiler",
                                "target_lang_sense_clarification": "belediye veya yerel yönetim harçları"
                            },
                            {
                                "target_lang_word": "emlak vergisi",
                                "target_lang_sense_clarification": "taşınmaz mala uygulanan vergi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6dc661ca-8f89-339d-a70a-d5a95d5d59b7",
                    "sense_definition": "Third-person singular simple present indicative of <w>rate</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>rates</w> this restaurant as the best in the city.",
                            "target_lang_translations": {
                                "ru": "Она <w>считает</w> этот ресторан лучшим в городе.",
                                "tr": "Bu restoranı şehirdeki en iyi restoran olarak <w>değerlendiriyor</w>."
                            }
                        },
                        {
                            "text": "He <w>rates</w> highly among his colleagues for his hard work.",
                            "target_lang_translations": {
                                "ru": "Его высоко <w>ценят</w> коллеги за его усердную работу.",
                                "tr": "Çalışkanlığı nedeniyle iş arkadaşları arasında yüksek <w>takdir görüyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rates highly",
                        "rates as"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Третье лицо единственного числа настоящего времени глагола \"rate\" (оценивать, считать).",
                        "tr": "\"Rate\" fiilinin geniş zamanda üçüncü tekil şahıs çekimi (değerlendirmek, oranlamak)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивает",
                                "target_lang_sense_clarification": "дает оценку"
                            },
                            {
                                "target_lang_word": "считает",
                                "target_lang_sense_clarification": "имеет мнение"
                            },
                            {
                                "target_lang_word": "котируется",
                                "target_lang_sense_clarification": "занимает определенное место в рейтинге"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değerlendiriyor",
                                "target_lang_sense_clarification": "puan veriyor veya derecelendiriyor"
                            },
                            {
                                "target_lang_word": "görüyor",
                                "target_lang_sense_clarification": "şeklinde nitelendiriyor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}