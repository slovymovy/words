                                        "entry_id": "acf6e915-8f6c-3acb-b855-4d5af2d6209a",
                                        "glosses": [
                                            "An organic compound, HO-CH₂-CH₂-OH, and the chemical structure at right. It is a clear, colorless liquid under normal conditions, and is widely used as a vehicle engine coolant due to its anti-freeze properties."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "036c409d-98fb-47ab-ab46-28c00735869b",
                                                "sense_id": "092a57c1-6c36-375f-bf61-cbc07d55050c",
                                                "text": "It is concerned in the manufacture of ethylene glycol, a principal raw material in the production of Terylene, and a block train of eleven 25-ton tank wagons, designed by I.C.I., has been specially constructed by B.R. to convey output to I.C.I.'s Wilton works in North Yorkshire."
                                            },
                                            {
                                                "example_id": "a5faf39d-b46c-4ce7-b323-5a1ed8c18a9d",
                                                "sense_id": "092a57c1-6c36-375f-bf61-cbc07d55050c",
                                                "text": "‘Antifreeze contains ethylene glycol, rather good stuff.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
