                        "glosses": [
                            "Celui qui obtient une nouvelle variété végétale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76845f7a-5afd-4c20-8d2e-b1879f104ce9",
                                "sense_id": "3c1b652f-0d78-39b5-bbce-a3f0e0cc5f29",
                                "text": "Le véritable obtenteur de la rose du roi."
                            },
                            {
                                "example_id": "e8a2c801-fef4-4cb3-86b3-2fba5eb3fc62",
                                "sense_id": "3c1b652f-0d78-39b5-bbce-a3f0e0cc5f29",
                                "text": "Le certificat d’obtention végétale, comme un brevet, permet à l’obtenteur (inventeur) de maîtriser l’exploitation commerciale de sa variété (choisir ses partenaires, négocier des licences, percevoir des royalties) et de se protéger contre d’éventuels contrefacteurs, et ceci pour une durée limitée (20 à 30 ans selon les espèces)."
                            }
                        ]
