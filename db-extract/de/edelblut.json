                ],
                "senses": [
                    {
                        "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                        "entry_id": "432dc34e-dbf1-3748-8c69-554987f8a188",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1fbef10-1231-41ab-8295-b5755145fb06",
                                "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                                "text": "Frau Edelblut ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4ba8891f-cb78-464b-a993-ee9762251ef0",
                                "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                                "text": "Herr Edelblut wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0b135d38-491b-448b-9eed-d566ffeef6e4",
                                "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                                "text": "Die Edelbluts kommen heute aus dem Taunus."
                            },
                            {
                                "example_id": "d615daed-85a2-4384-9725-4bac43b6c8b1",
                                "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                                "text": "Der Edelblut trägt nie die Schals, die die Edelblut ihm strickt."
                            },
                            {
                                "example_id": "6971da54-aa9c-4b4e-a6a0-8fd92cb0a58e",
                                "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Edelblut kommt, geht der Herr Edelblut.“"
                            },
                            {
                                "example_id": "04abfa88-d26f-4265-88b2-1df8c7d59e09",
                                "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                                "text": "Edelblut kommt und geht."
                            },
                            {
                                "example_id": "52564784-9b00-4ff2-9deb-1e4e4375b221",
                                "sense_id": "47a11a3a-b0c9-3d08-b4a5-4132dd2acae2",
                                "text": "Edelbluts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
