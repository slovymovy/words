                "senses": [
                    {
                        "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                        "entry_id": "ff908d80-b2b5-3694-96b2-be26812940e3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ed6378-3f5c-41c1-967c-820939e08e5c",
                                "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                                "text": "Frau Dinkelacker ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b798796f-1d69-4dd0-8920-40221bc63939",
                                "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                                "text": "Herr Dinkelacker wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cfbd2bd0-9df8-47a2-9a10-eba5e0c766b8",
                                "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                                "text": "Die Dinkelackers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c82a7d5b-f0be-4ccd-ac67-2658e14e3dfa",
                                "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                                "text": "Der Dinkelacker trägt nie die Schals, die die Dinkelacker ihm strickt."
                            },
                            {
                                "example_id": "beb8bbf6-3d43-4b48-be56-8af0bdd1aa42",
                                "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dinkelacker kommt, geht der Herr Dinkelacker.“"
                            },
                            {
                                "example_id": "029f9b24-37f0-4053-834e-ad73c10413c5",
                                "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                                "text": "Dinkelacker kommt und geht."
                            },
                            {
                                "example_id": "16115d6a-b41d-4a73-8560-35bc9e1d1bad",
                                "sense_id": "b5bc849f-f65b-3a9b-8ff6-73fa6f95a228",
                                "text": "Dinkelackers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
