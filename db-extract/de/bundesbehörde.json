                "senses": [
                    {
                        "sense_id": "14df5b8a-ea1e-3d17-bece-c137260534b6",
                        "entry_id": "0b03c2d1-ee23-3687-aab9-12d66ac5e39e",
                        "glosses": [
                            "höchste Behörde auf Bundesebene in einem föderalen Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099513d8-1c35-49ed-ab26-78bca15bd563",
                                "sense_id": "14df5b8a-ea1e-3d17-bece-c137260534b6",
                                "text": "„Der Bundespräsident übt dieses Recht jedoch nur bei den höheren Beamten selbst aus und hat es bei den übrigen Beamten auf die obersten Bundesbehörden übertragen.“"
                            },
                            {
                                "example_id": "6b1f69ef-ad5e-4e46-8a75-b3278872b93f",
                                "sense_id": "14df5b8a-ea1e-3d17-bece-c137260534b6",
                                "text": "„Für März rechnet die Bundesbehörde mit einem neuen Rekord bei Anträgen auf Kurzarbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
