{
    "word_family": [
        "forceful",
        "forcible",
        "enforce",
        "reinforce",
        "forceps",
        "unforced",
        "perforce"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23a4f408-6936-39da-9d5e-5422f75b8ac4",
                    "sense_definition": "To make someone or something do something, often regardless of their will.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "compulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad weather might <w>force</w> the pilot to land the plane early.",
                            "target_lang_translations": {
                                "ru": "Плохая погода может <w>заставить</w> пилота посадить самолет раньше."
                            }
                        },
                        {
                            "text": "You cannot <w>force</w> someone to love you if they do not feel the same way.",
                            "target_lang_translations": {
                                "ru": "Нельзя <w>принудить</w> кого-то любить тебя, если человек не испытывает взаимности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "force a decision",
                        "force someone to act"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо или что-либо делать что-то, часто вопреки их воле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заставлять",
                                "target_lang_sense_clarification": "принуждать к действию"
                            },
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "насильно навязывать совершение действия"
                            },
                            {
                                "target_lang_word": "вынуждать",
                                "target_lang_sense_clarification": "создавать условия, при которых нет другого выбора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0399101-a307-32a5-8cef-42ac3170eb96",
                    "sense_definition": "To use physical strength to open something that is locked or stuck.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters had to <w>force</w> the door open to rescue the family.",
                            "target_lang_translations": {
                                "ru": "Пожарным пришлось <w>выломать</w> дверь, чтобы спасти семью."
                            }
                        },
                        {
                            "text": "He tried to <w>force</w> the lock with a heavy tool but it would not budge.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>вскрыть</w> замок тяжелым инструментом, но тот не поддался."
                            }
                        }
                    ],
                    "common_phrases": [
                        "force a lock",
                        "force open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать физическую силу, чтобы открыть что-то запертое или заклинившее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскрывать силой",
                                "target_lang_sense_clarification": "взламывать замок или дверь"
                            },
                            {
                                "target_lang_word": "выламывать",
                                "target_lang_sense_clarification": "открывать с применением грубой силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adfba14e-0643-3abd-ba3c-b60c0114745c",
                    "sense_definition": "To cause something to happen despite resistance or lack of natural inclination.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "compulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though she was sad, she managed to <w>force</w> a smile for the guests.",
                            "target_lang_translations": {
                                "ru": "Несмотря на грусть, ей удалось <w>выдавить</w> улыбку ради гостей."
                            }
                        },
                        {
                            "text": "The comedian's jokes were not funny, but I <w>forced</w> a laugh to be polite.",
                            "target_lang_translations": {
                                "ru": "Шутки комика были несмешными, но я <w>выдавил</w> смешок из вежливости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "force a smile",
                        "force a laugh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать какое-либо действие или эмоцию вопреки сопротивлению или отсутствию естественного желания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавливать",
                                "target_lang_sense_clarification": "через силу (например, улыбку)"
                            },
                            {
                                "target_lang_word": "напускать на себя",
                                "target_lang_sense_clarification": "притворно изображать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f395483-b4bb-349b-bfbd-be24dd9992f2",
                    "sense_definition": "To drive or propel something in a specific direction using physical power.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind <w>forced</w> the small boat off its original course.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>сбил</w> маленькую лодку с первоначального курса."
                            }
                        },
                        {
                            "text": "He used a hammer to <w>force</w> the metal pin into the narrow hole.",
                            "target_lang_translations": {
                                "ru": "Он использовал молоток, чтобы <w>вбить</w> металлический штифт в узкое отверстие."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrust"
                    ],
                    "common_phrases": [
                        "force off the road"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать или толкать что-либо в определенном направлении, используя физическую мощь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вталкивать",
                                "target_lang_sense_clarification": "с силой помещать внутрь"
                            },
                            {
                                "target_lang_word": "сбивать",
                                "target_lang_sense_clarification": "заставлять отклониться от курса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9b88d69-b5c6-3ab4-adc4-9b7cfeaeae38",
                    "sense_definition": "In baseball, to create an out by touching a base before a runner who is required to advance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shortstop managed to <w>force</w> the runner at second base to end the inning.",
                            "target_lang_translations": {
                                "ru": "Шортстопу удалось <w>сделать вынужденный аут</w> на второй базе, чтобы завершить иннинг."
                            }
                        },
                        {
                            "text": "With the bases loaded, any ground ball could <w>force</w> an out at home plate.",
                            "target_lang_translations": {
                                "ru": "При загруженных базах любой граунд-бол мог <w>привести к вынужденному ауту</w> в доме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "force the runner"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in baseball"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В бейсболе: вынуждать игрока нападения покинуть базу, коснувшись базы раньше него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынуждать аут",
                                "target_lang_sense_clarification": "технический термин в бейсболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420595b3-c44d-3331-9dc5-f45ec01c783a",
                    "sense_definition": "To make plants grow faster or earlier than usual by artificial means, such as heat or darkness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardeners often <w>force</w> rhubarb in the dark to produce a sweeter crop earlier in the spring.",
                            "target_lang_translations": {
                                "ru": "Садоводы часто <w>выгоняют</w> ревень в темноте, чтобы получить более сладкий урожай в начале весны."
                            }
                        },
                        {
                            "text": "You can <w>force</w> flower bulbs to bloom indoors during the cold winter months.",
                            "target_lang_translations": {
                                "ru": "Можно <w>заставить зацвести</w> цветочные луковицы в помещении в холодные зимние месяцы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "force rhubarb"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "horticultural term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять растения расти быстрее или цвести раньше срока искусственными методами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгонять",
                                "target_lang_sense_clarification": "садоводческий термин для ускорения роста"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "141dae4d-df47-34b7-afe6-4df9d3f24f00",
                    "sense_definition": "Physical or mental strength, energy, or the power to influence people or events.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>force</w> of the impact was enough to shatter the glass window.",
                            "target_lang_translations": {
                                "ru": "<w>Сила</w> удара была такой, что оконное стекло разлетелось вдребезги."
                            }
                        },
                        {
                            "text": "He argued his case with great <w>force</w> and eventually convinced the committee.",
                            "target_lang_translations": {
                                "ru": "Он отстаивал свою позицию с большой <w>убедительностью</w> и в итоге убедил комитет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "show of force",
                        "brute force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая или ментальная мощь, энергия или способность влиять на людей и события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "физическая или моральная мощь"
                            },
                            {
                                "target_lang_word": "мощь",
                                "target_lang_sense_clarification": "высокая степень силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3ce8b5d-5c23-3599-8f11-05c65c4991bf",
                    "sense_definition": "An organized group of people, especially military or police, trained for a specific purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>force</w> is working hard to reduce crime in the city center.",
                            "target_lang_translations": {
                                "ru": "Местная <w>полиция</w> усердно работает над снижением преступности в центре города."
                            }
                        },
                        {
                            "text": "He spent twenty years serving on the <w>force</w> before he decided to retire.",
                            "target_lang_translations": {
                                "ru": "Он прослужил в <w>органах</w> двадцать лет, прежде чем решил уйти на пенсию."
                            }
                        }
                    ],
                    "synonyms": [
                        "police force"
                    ],
                    "common_phrases": [
                        "on the force",
                        "police force",
                        "air force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованная группа людей, особенно военные или полиция, обученная для определенных целей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "органы",
                                "target_lang_sense_clarification": "полиция или силовые структуры"
                            },
                            {
                                "target_lang_word": "войска",
                                "target_lang_sense_clarification": "вооруженные силы"
                            },
                            {
                                "target_lang_word": "отряд",
                                "target_lang_sense_clarification": "формирование для выполнения задач"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "196e65c8-9040-3137-af09-2dde0e382428",
                    "sense_definition": "In physics, an influence that can change the motion of an object, measured in newtons.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gravity is the <w>force</w> that keeps the planets in orbit around the sun.",
                            "target_lang_translations": {
                                "ru": "Гравитация — это <w>сила</w>, которая удерживает планеты на орбите вокруг Солнца."
                            }
                        },
                        {
                            "text": "When two <w>forces</w> act in opposite directions, they can cancel each other out.",
                            "target_lang_translations": {
                                "ru": "Когда две <w>силы</w> действуют в противоположных направлениях, они могут нейтрализовать друг друга."
                            }
                        }
                    ],
                    "common_phrases": [
                        "centrifugal force",
                        "gravitational force",
                        "magnetic force"
                    ],
                    "target_lang_definitions": {
                        "ru": "В физике: воздействие, изменяющее движение объекта, измеряемое в ньютонах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "физическая величина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d0f403-5377-3cc8-81c1-84ea33676cfa",
                    "sense_definition": "The state of being legally valid or in operation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new safety regulations will come into <w>force</w> starting next month.",
                            "target_lang_translations": {
                                "ru": "Новые правила техники безопасности вступят в <w>силу</w> со следующего месяца."
                            }
                        },
                        {
                            "text": "The old treaty remains in <w>force</w> until a new agreement is signed.",
                            "target_lang_translations": {
                                "ru": "Старый договор остается в <w>силе</w> до подписания нового соглашения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "come into force",
                        "in force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние юридической силы или действия закона/правила."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "законная правомочность"
                            },
                            {
                                "target_lang_word": "действие",
                                "target_lang_sense_clarification": "период функционирования закона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db7fe093-2abe-32c8-8564-38c3d0c34b17",
                    "sense_definition": "A person or thing that has a powerful influence over a system or society.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economic <w>forces</w> are driving the change in how people shop today.",
                            "target_lang_translations": {
                                "ru": "Экономические <w>факторы</w> определяют изменения в том, как люди совершают покупки сегодня."
                            }
                        },
                        {
                            "text": "She is a <w>force</w> of nature who gets things done no matter what.",
                            "target_lang_translations": {
                                "ru": "Она — настоящая <w>стихия</w>, которая добивается своего несмотря ни на что."
                            }
                        }
                    ],
                    "common_phrases": [
                        "market forces",
                        "force of nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или явление, обладающее мощным влиянием на систему или общество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сила",
                                "target_lang_sense_clarification": "влиятельный фактор или субъект"
                            },
                            {
                                "target_lang_word": "двигатель",
                                "target_lang_sense_clarification": "основная причина перемен"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "840907d1-129d-3deb-ae41-45978c013e5c",
                    "sense_definition": "A metaphysical power from the fictional Star Wars universe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Jedi uses the <w>Force</w> to sense danger before it actually happens.",
                            "target_lang_translations": {
                                "ru": "Джедай использует <w>Силу</w>, чтобы почувствовать опасность до того, как она возникнет."
                            }
                        },
                        {
                            "text": "He felt a great disturbance in the <w>Force</w> as the ship approached.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал сильное возмущение в <w>Силе</w>, когда корабль приблизился."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the dark side"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метафизическая энергия из вымышленной вселенной «Звёздных войн»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сила",
                                "target_lang_sense_clarification": "понятие из фантастики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90789a99-863d-3e81-9f5a-47a53a80217d",
                    "sense_definition": "A waterfall or cascade, typically used in Northern England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hiked through the valley to see the magnificent <w>force</w> crashing down the rocks.",
                            "target_lang_translations": {
                                "ru": "Мы шли через долину, чтобы увидеть великолепный <w>водопад</w>, низвергающийся со скал."
                            }
                        },
                        {
                            "text": "High <w>Force</w> is one of the most famous waterfalls in the entire country.",
                            "target_lang_translations": {
                                "ru": "Хай-<w>Форс</w> — один из самых известных водопадов во всей стране."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern England"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водопад или каскад (используется преимущественно в Северной Англии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водопад",
                                "target_lang_sense_clarification": "диалектное название в Англии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cb00baae-69ac-34d1-a638-8021bad65868",
                    "sense_definition": "A component of place names referring to a waterfall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The village of Stock Ghyll <w>Force</w> is a popular destination for tourists.",
                            "target_lang_translations": {
                                "ru": "Деревня Сток-Гилл-<w>Форс</w> — популярное место среди туристов."
                            }
                        },
                        {
                            "text": "Many local landmarks in the district include the word <w>force</w> in their names.",
                            "target_lang_translations": {
                                "ru": "Многие местные достопримечательности в этом районе включают слово «<w>форс</w>» в свои названия."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компонент географических названий, обозначающий водопад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Форс",
                                "target_lang_sense_clarification": "часть топонима"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c7c729f-cebf-392e-b58c-3cb1e7618185",
