                "senses": [
                    {
                        "sense_id": "895ad756-996f-327f-9fae-6a34b4c26bb3",
                        "entry_id": "00494603-18b3-3f2c-bf52-d0b398acf1c3",
                        "glosses": [
                            "aus Plastik bestehender Becher"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "cdaa19ac-344b-4048-80bc-d6310506f610",
                                "sense_id": "895ad756-996f-327f-9fae-6a34b4c26bb3",
                                "text": "„Marco füllte dann einen Plastebecher mit Klarem und Bier.“"
                            },
                            {
                                "example_id": "be8342b5-59dd-4bc2-bc59-f77e781f8444",
                                "sense_id": "895ad756-996f-327f-9fae-6a34b4c26bb3",
                                "text": "„Zur Überwinterung wurden die Pflanzen mit Torfballen in mit Weißtorf gefüllte Plastebecher eingebettet, die in großen Photoschalen standen.“"
                            },
                            {
                                "example_id": "7ba5d1d3-c5c7-4200-ad05-6a63ed16d346",
                                "sense_id": "895ad756-996f-327f-9fae-6a34b4c26bb3",
                                "text": "„Auch die Tatsache, dass der Kaffee in Porzellantassen und nicht aus dünnen Plastebechern gereicht wird, an denen man sich regelmäßig die Finger verbrennt, trägt zum Genuss bei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
