                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aca2d307-2334-46b3-a142-b28f574fa3f7",
                        "source_entry_id": "31586639-5b0e-368f-8c22-1d068e0fba0f",
