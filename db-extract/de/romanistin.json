                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5351dc1e-dc62-4dc4-a7a1-d1b601e90c06",
                                "sense_id": "6b155fd3-df1d-3fdb-984e-e233b0943fe2",
                                "text": "Die Romanistin und Germanistin lehrt an der Universität Bielefeld."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c2042346-3e21-3a51-921e-a00db7304c7d",
                        "entry_id": "112f558a-f6de-38d0-9804-f4e684a1727c",
                        "glosses": [
                            "weibliche Person, die eine Anhängerin oder Vertreterin des Romanismus ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4009d24d-a9bf-4e0c-b996-1094c865f07b",
                                "sense_id": "c2042346-3e21-3a51-921e-a00db7304c7d",
                                "text": "Die Romanisten und Romanistinnen legten in den Augen der Reformierten zu viel Gewicht auf Rom und den Papst."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1a4b7f48-877a-36b9-9346-e42731be0c7b",
