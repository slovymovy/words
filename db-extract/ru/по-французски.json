                        "cross_references": [
                            {
                                "target_word": "französisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c54d6a7-1824-3b4c-9058-fb327c7c0d73",
                                        "entry_id": "769e75bc-d248-39af-88d3-811fc10f8e20",
                                        "glosses": [
                                            "Frankreich betreffend, zu Frankreich gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cbb1cd3-d636-4332-8e97-d78e2779e2e7",
                                                "sense_id": "6c54d6a7-1824-3b4c-9058-fb327c7c0d73",
                                                "text": "Die französische Küche ist weltberühmt."
                                            },
                                            {
                                                "example_id": "3ec6b480-64a4-45d1-a93d-0e5f5e35ce81",
                                                "sense_id": "6c54d6a7-1824-3b4c-9058-fb327c7c0d73",
                                                "text": "Der Röstigraben gilt als geografische und mentale Grenze zwischen der deutschen Schweiz einerseits und der französischen und italienischen Schweiz andererseits."
                                            },
                                            {
                                                "example_id": "ec84c435-ad88-40ef-b993-f2206c50b903",
                                                "sense_id": "6c54d6a7-1824-3b4c-9058-fb327c7c0d73",
                                                "text": "„Die Frage der verfassungsrechtlichen Stellung Algeriens wurde schließlich vom französischen Staatsrat (Conseil d’Etat) dahingehend entschieden, daß die algerischen Departements in die Gruppe der überseeischen Departements, wie sie der Artikel 60 der Verfassung aufzählt, einzuordnen sind.“"
                                            },
                                            {
                                                "example_id": "39d7790c-0384-47af-8893-50d684dcb66e",
                                                "sense_id": "6c54d6a7-1824-3b4c-9058-fb327c7c0d73",
                                                "text": "„Sie ist landschaftlich westlicher, man möchte ruhig sagen: französischer als alle.“"
                                            },
                                            {
                                                "example_id": "eae27832-f0fb-41c8-ba1c-55f2a53d5d2d",
                                                "sense_id": "6c54d6a7-1824-3b4c-9058-fb327c7c0d73",
                                                "text": "„Einen Heißluftballon erwarben französische Ballonfahrer für den Schnäppchenpreis von 6400 Euro - normalerweise kostet ein solches Fluggerät mehrere zehntausend Euro.“"
                                            },
                                            {
                                                "example_id": "1b5e51d6-630d-4e59-aaf8-41ebcad0c30f",
                                                "sense_id": "6c54d6a7-1824-3b4c-9058-fb327c7c0d73",
                                                "text": "„Im Absolutismus verbreiteten sich dann mit der Orientierung am französischen Königtum französische Lebensart und Sprache sehr schnell und sehr konsequent auch im deutschen Sprachraum, so dass man für das 18. Jh. zumindest ‚für die oberen Schichten eine deutsch-französische Zweisprachigkeit‘, wenngleich wohl mit durchaus abgestufter Kompetenz, annehmen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ab6452c-61d5-32b6-b002-5e85e8efb224",
                                        "entry_id": "769e75bc-d248-39af-88d3-811fc10f8e20",
                                        "glosses": [
                                            "die Franzosen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3795b447-45c3-46c3-a721-77331d0825e9",
                                                "sense_id": "0ab6452c-61d5-32b6-b002-5e85e8efb224",
                                                "text": "„Im Absolutismus verbreiteten sich dann mit der Orientierung am französischen Königtum französische Lebensart und Sprache sehr schnell und sehr konsequent auch im deutschen Sprachraum, so dass man für das 18. Jh. zumindest ‚für die oberen Schichten eine deutsch-französische Zweisprachigkeit‘, wenngleich wohl mit durchaus abgestufter Kompetenz, annehmen kann.“"
                                            },
                                            {
                                                "example_id": "ac5ba035-df34-46a8-b08f-f6ed60ef47e0",
                                                "sense_id": "0ab6452c-61d5-32b6-b002-5e85e8efb224",
                                                "text": "Die französische Küche ist weltberühmt."
                                            },
                                            {
                                                "example_id": "ca197cab-83b9-416e-b967-2eea60bf2163",
                                                "sense_id": "0ab6452c-61d5-32b6-b002-5e85e8efb224",
                                                "text": "Der Grund meiner Bemerkung gegen Sie, die ich auf eine französischere Weise hätte einkleiden können, bleibt wahr, ich muß darauf beharren, daß Sie kein Franzose sind und nicht französische Gesinnungen äußerten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1e00fd7f-9163-30ca-a4cc-2ef3443b408b",
                                        "entry_id": "769e75bc-d248-39af-88d3-811fc10f8e20",
                                        "glosses": [
                                            "die Sprache der Franzosen betreffend"
                                        ],
                                        "tags": [
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c890d3b7-72be-400a-b5ff-a20deba38a95",
                                                "sense_id": "1e00fd7f-9163-30ca-a4cc-2ef3443b408b",
                                                "text": "„Im Absolutismus verbreiteten sich dann mit der Orientierung am französischen Königtum französische Lebensart und Sprache sehr schnell und sehr konsequent auch im deutschen Sprachraum, so dass man für das 18. Jh. zumindest ‚für die oberen Schichten eine deutsch-französische Zweisprachigkeit‘, wenngleich wohl mit durchaus abgestufter Kompetenz, annehmen kann.“"
                                            },
                                            {
                                                "example_id": "1515e140-fadd-40e9-9609-86afe3f4b41f",
                                                "sense_id": "1e00fd7f-9163-30ca-a4cc-2ef3443b408b",
                                                "text": "„Mit französisch-provenzalischen Lebensformen werden in der sog. höfischen Zeit (von 1150 bis 1250) auch französische Wörter in die deutsche Sprache des Hochmittelalters übernommen, wobei diese meist über das Mittelniederländische vermittelt werden.“"
                                            },
                                            {
                                                "example_id": "d60f720d-6953-4e46-a5d8-fc33214cf20e",
                                                "sense_id": "1e00fd7f-9163-30ca-a4cc-2ef3443b408b",
                                                "text": "Der Röstigraben gilt als geografische und mentale Grenze zwischen der deutschen Schweiz einerseits und der französischen und italienischen Schweiz andererseits."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0049e75d-01dd-3335-a1e9-fedb8911eb45",
                                        "entry_id": "769e75bc-d248-39af-88d3-811fc10f8e20",
                                        "glosses": [
                                            "Charakterisierung einer Sexualpraktik, bei der die Geschlechtsorgane des Partners/der Partnerin mit dem Mund stimuliert werden"
                                        ],
                                        "tags": [
                                            "Sexualität"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c3e468-7a24-4535-80df-17c8d33caf02",
                                                "sense_id": "0049e75d-01dd-3335-a1e9-fedb8911eb45",
                                                "text": "Oder sagt er das, weil wir es auch französisch machten? Also mit dem Mund, das ist französisch, wenn ichs richtig behalten habe."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
