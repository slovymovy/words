                "senses": [
                    {
                        "sense_id": "50b35181-c857-32e7-a40e-0063883078a2",
                        "entry_id": "47de74bf-c1e6-33fc-9fcc-f07f8a89df4a",
                        "glosses": [
                            "Verringerung der von Zahnfleisch bedeckten Zahnfläche"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "220318d2-8356-4825-af89-0fded49e065a",
                                "sense_id": "50b35181-c857-32e7-a40e-0063883078a2",
                                "text": "Der Attachmentverlust machte die Zähne locker."
                            },
                            {
                                "example_id": "21477001-4866-402c-8924-8ce255fbb546",
                                "sense_id": "50b35181-c857-32e7-a40e-0063883078a2",
                                "text": "„Attachmentverluste können an allen Zahnflächen auftreten, sind jedoch nach Untersuchungen am häufigsten mesial und distal vorhanden.“"
                            },
                            {
                                "example_id": "383bdfd3-25fe-4ed8-b12a-8f659cc791aa",
                                "sense_id": "50b35181-c857-32e7-a40e-0063883078a2",
                                "text": "„Bei der Einschätzung der Schwere und des Ausmaßes der Parodontitis stehen die Sondierungstiefen und der Attachmentverlust im Vordergrund, beide werden in mm an mehreren Stellen pro Zahn gemessen.“"
                            },
                            {
                                "example_id": "529daa3b-672e-446e-9de5-d3e0989b7c30",
                                "sense_id": "50b35181-c857-32e7-a40e-0063883078a2",
                                "text": "„Der fortlaufende Attachmentverlust entblößt den Zahnhals.“"
                            },
                            {
                                "example_id": "8f575bc4-be04-4ffd-99f1-9ce04a88cec3",
                                "sense_id": "50b35181-c857-32e7-a40e-0063883078a2",
                                "text": "„Entscheidend für den Schweregrad sind die Tiefe der Taschen und der Attachmentverlust.“"
                            },
                            {
                                "example_id": "d27029ac-3190-416f-9bd8-485ba7e3e2e2",
                                "sense_id": "50b35181-c857-32e7-a40e-0063883078a2",
                                "text": "„Praktisch bei allen Senioren (65 – 74 Jahre) wurden Attachmentverluste von 3 mm oder mehr gefunden […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
