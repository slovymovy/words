                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subwoofer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d478402-507b-303e-b4bf-2e5dd4af5985",
                                        "entry_id": "5014f113-cbbd-3561-9136-2e7bdefc39fd",
                                        "glosses": [
                                            "Haut-parleur de sous-graves destiné à la reproduction des fréquences sonores comprises entre 20 et 80 Hz."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4facc735-fd9a-48fa-85e0-b862693a1533",
                                                "sense_id": "6d478402-507b-303e-b4bf-2e5dd4af5985",
                                                "text": "Outre sa qualité sonore, cette barre a le mérite d’être évolutive et peut se voir associer un subwoofer sans fil et des enceintes surround sans fil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
