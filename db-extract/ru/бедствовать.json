                                                "sense_id": "2f8d2f81-ae5b-3f43-9bb8-e4830cb75fe4",
                                                "text": "Während die Bauern und die ärmeren Bürger in den Städten darbten, ließ es sich an den Tischen der Reichen noch recht wohl sein."
                                            },
                                            {
                                                "example_id": "699549ac-2942-4edc-9b1c-fe5e9465ba00",
                                                "sense_id": "2f8d2f81-ae5b-3f43-9bb8-e4830cb75fe4",
                                                "text": "Der Sender darbt, da die Gelder fehlen."
                                            },
                                            {
                                                "example_id": "bd4370a6-7dbf-4f64-b8ab-fd87417134a2",
                                                "sense_id": "2f8d2f81-ae5b-3f43-9bb8-e4830cb75fe4",
                                                "text": "Die Menschen darben dahin, da sie nichts zu essen haben."
                                            },
                                            {
                                                "example_id": "c0d5a0a4-638c-44f9-a4ee-9b735f328c44",
                                                "sense_id": "2f8d2f81-ae5b-3f43-9bb8-e4830cb75fe4",
                                                "text": "Ich habe keine Lust mehr zu darben, wollen wir nicht mit der Fastenkur aufhören?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
