                                                "example_id": "9c1b4164-9ab4-4e9a-8d42-eaa750dd7ae2",
                                                "sense_id": "8a71f3e9-6332-3e8c-835c-3dd94331e114",
                                                "text": "For here we met, some ten or twelve of us, / To chase a creature that was current then / In these wild woods, the hart with golden horns."
                                            }
                                        ]
