                                    {
                                        "sense_id": "81fad4b5-be47-3106-af4c-a73226183366",
                                        "entry_id": "dcf6be88-d3d6-345f-81f9-a8d245e58f08",
                                        "glosses": [
                                            "den Zustand des (durch Alkohol verursachten) Rausches wieder verlieren und nüchtern werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0c014c-38bd-41f3-bb27-5acf47c5232b",
                                                "sense_id": "81fad4b5-be47-3106-af4c-a73226183366",
                                                "text": "„Hier schritt ich, den Hut in der Hand, auf und ab, um mich zu ernüchtern. In der Alkohollaune kam mir dann der Gedanke, ein kaltes Bad zu nehmen, damit die Weindünste sich schneller verflüchtigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fe96a23-6993-3110-9bf7-469710cfd237",
                                        "entry_id": "dcf6be88-d3d6-345f-81f9-a8d245e58f08",
                                        "glosses": [
                                            "die positive Einschätzung, Hoffnung, Euphorie oder Illusionen nehmen und in eine ernstere Stimmung versetzen, die mehr den Tatsachen entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d96592-c0a4-4529-af0a-10914eba16f5",
                                                "sense_id": "5fe96a23-6993-3110-9bf7-469710cfd237",
                                                "text": "„Diese drastischen Bemerkungen erreichten ihren Zweck: Sie ernüchterten den Paläontologen so, daß er jetzt zornig ausrief: »Du hast nicht das mindeste Verständnis für solche Verhältnisse und Schönheiten!«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
