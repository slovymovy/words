                                "example_id": "787b5839-ae19-4904-8e5d-fa42c9fb02ef",
                                "sense_id": "5dc1f589-49e0-3637-a518-8adef00679a2",
                                "text": "„Wir stehen in Papierhemd und -hose zum Angriff auf das Universum bereit.“"
                            },
                            {
                                "example_id": "1bdaef18-3366-4cd6-9e29-73fe515cb46d",
                                "sense_id": "5dc1f589-49e0-3637-a518-8adef00679a2",
                                "text": "„Das erste Papierhemd soll ein japanischer Mönch aus der Not heraus gebastelt haben. In den 60ern kamen „Do-it yourself“-Kleider aus Papier für Partys in Mode, heute sind Anzüge der Spurensicherung daraus gefertigt.“"
                            }
                        ],
