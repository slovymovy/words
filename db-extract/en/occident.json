                                "target_senses": [
                                    {
                                        "sense_id": "36a7752b-b825-31ab-bba9-e42803c99c81",
                                        "entry_id": "c99d95a7-15e8-3fb2-ab1c-3040978a0dff",
                                        "glosses": [
                                            "Ouest : point cardinal indiquant la direction du Soleil couchant, exacte aux équinoxes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f81929d-d12b-48e4-bf1f-5ac3a84388f3",
                                                "sense_id": "36a7752b-b825-31ab-bba9-e42803c99c81",
                                                "text": "Du côté de l’occident, il y avait une entrée à travers la palissade."
                                            },
                                            {
                                                "example_id": "7d7d800a-eb3e-4d84-a8f6-4978a24919b9",
                                                "sense_id": "36a7752b-b825-31ab-bba9-e42803c99c81",
                                                "text": "Une large couleur de pourpre enflammait le ciel à l’occident."
                                            },
                                            {
                                                "example_id": "17cc34d1-bca6-4237-8518-005ed0245821",
                                                "sense_id": "36a7752b-b825-31ab-bba9-e42803c99c81",
                                                "text": "Le coucher de soleil est d’un gris inquiétant et de gros nuages noirs s’accumulent vers l’occident."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fe9a094-6473-4c56-b517-d9f8bb7a104a",
                        "source_entry_id": "8e0afb6a-6111-3dcb-89f7-6687756b4525",
                        "source_sense_description": "part of the horizon where the sun last appears in the evening; that part of the earth towards the sunset; the west",
                        "target_lang_word": "Okzident",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okzident",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f85c7bec-bdaf-3fdf-9622-befea3b32857",
                                        "entry_id": "ad9ba033-2d86-3261-889a-a5c41ea09616",
                                        "glosses": [
                                            "das Abendland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a215645-50e2-45ee-b217-a6bd74147a92",
                                                "sense_id": "f85c7bec-bdaf-3fdf-9622-befea3b32857",
                                                "text": "Dem Dichter schwebte eine Synthese zwischen Orient und Okzident vor."
                                            },
                                            {
                                                "example_id": "33c54131-4b76-4536-b23c-54cbe3b16d92",
                                                "sense_id": "f85c7bec-bdaf-3fdf-9622-befea3b32857",
                                                "text": "„Besondere Bedeutung kam der Gründung eines neuen Regierungssitzes am Bosporus an der Nahtstelle zwischen Orient und Okzident zu.“"
                                            },
                                            {
                                                "example_id": "b2164feb-6c41-4c4e-bbda-2fa23b3b1db3",
                                                "sense_id": "f85c7bec-bdaf-3fdf-9622-befea3b32857",
                                                "text": "„Der Erzfeind des Okzidents hängt an meiner Zimmerwand, und, was soll ich sagen, ich mag ihn.“"
                                            },
                                            {
                                                "example_id": "a987dfa1-a3a7-4abb-bb5a-73bd755c5ff3",
                                                "sense_id": "f85c7bec-bdaf-3fdf-9622-befea3b32857",
                                                "text": "„Die Ideenwelten, die den Okzident geprägt haben, sei es in Judäa oder in Griechenland, sind unter einem makellosen, zermürbend blauen Himmel geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
