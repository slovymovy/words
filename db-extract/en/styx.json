                        "target_lang_word": "Styx",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "10cb64d7-564e-4e37-920a-2c49db980efb",
                        "source_entry_id": "16f0a3b4-32c3-383d-8d9c-2566e6b3d7f4",
