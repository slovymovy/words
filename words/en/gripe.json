{
    "word_family": [
        "griping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "529bf7a3-e405-39a9-aa31-4eac6cf71573",
                    "sense_definition": "To complain or whine about something, often in a petty or annoying way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Employees often <w>gripe</w> about the office temperature during the summer months.",
                            "target_lang_translations": {
                                "cs": "Zaměstnanci si v letních měsících často <w>stěžují</w> na teplotu v kanceláři."
                            }
                        },
                        {
                            "text": "Stop <w>griping</w> about the weather and let us enjoy our walk.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>remcat</w> kvůli počasí a pojďme si užít procházku."
                            }
                        }
                    ],
                    "synonyms": [
                        "bitch",
                        "complain",
                        "whine",
                        "whinge"
                    ],
                    "common_phrases": [
                        "gripe about"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stěžovat si nebo kňourat kvůli něčemu, často malicherným nebo otravným způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stěžovat si",
                                "target_lang_sense_clarification": "obecné vyjádření nespokojenosti"
                            },
                            {
                                "target_lang_word": "remcat",
                                "target_lang_sense_clarification": "neformální, vyjadřuje otravné stěžování"
                            },
                            {
                                "target_lang_word": "brblat",
                                "target_lang_sense_clarification": "vyjadřování nespokojenosti pod vousy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f77cec6-9cba-3a63-bb81-07ec7c801a78",
                    "sense_definition": "To annoy or bother someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site really <w>gripes</w> me.",
                            "target_lang_translations": {
                                "cs": "Ten neustálý hluk ze staveniště mě opravdu <w>štve</w>."
                            }
                        },
                        {
                            "text": "It <w>gripes</w> me when people do not return borrowed books on time.",
                            "target_lang_translations": {
                                "cs": "Opravdu mě <w>irituje</w>, když lidé nevracejí půjčené knihy včas."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Někoho štvát, obtěžovat nebo iritovat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "štvat",
                                "target_lang_sense_clarification": "vyvolávat v někom podráždění"
                            },
                            {
                                "target_lang_word": "iritovat",
                                "target_lang_sense_clarification": "způsobovat někomu nepříjemné pocity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30e67156-9fa6-3cea-bb23-0c47ff35ec97",
                    "sense_definition": "To seize or grasp something firmly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grasping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete had to <w>gripe</w> the rope tightly to climb the wall.",
                            "target_lang_translations": {
                                "cs": "Sportovec musel lano pevně <w>sevřít</w>, aby vyšplhal na zeď."
                            }
                        },
                        {
                            "text": "He <w>griped</w> the handle of the sword before stepping into the arena.",
                            "target_lang_translations": {
                                "cs": "Před vstupem do arény <w>sevřel</w> rukojeť meče."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pevně něco uchopit nebo sevřít."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sevřít",
                                "target_lang_sense_clarification": "pevně uchopit rukou"
                            },
                            {
                                "target_lang_word": "chytit",
                                "target_lang_sense_clarification": "uchopit předmět"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21382f91-5841-3f27-9191-0eab41f25d40",
                    "sense_definition": "A complaint, especially one that is petty or trivial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a minor <w>gripe</w> about the service at the restaurant.",
                            "target_lang_translations": {
                                "cs": "Měl drobnou <w>stížnost</w> na obsluhu v restauraci."
                            }
                        },
                        {
                            "text": "The manager listened to every <w>gripe</w> from the staff during the meeting.",
                            "target_lang_translations": {
                                "cs": "Manažer si během schůzky vyslechl každou <w>stížnost</w> od zaměstnanců."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain"
                    ],
                    "common_phrases": [
                        "common gripe"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stížnost, zejména malicherná nebo triviální."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stížnost",
                                "target_lang_sense_clarification": "vyjádření nespokojenosti"
                            },
                            {
                                "target_lang_word": "výtka",
                                "target_lang_sense_clarification": "drobná kritika nebo připomínka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecbc563c-e050-3673-9be6-9f3279c2c189",
                    "sense_definition": "A sharp, pinching pain in the stomach or intestines.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spoiled food caused a sudden <w>gripe</w> in his stomach.",
                            "target_lang_translations": {
                                "cs": "Zkažené jídlo mu způsobilo náhlé <w>křeče v břiše</w>."
                            }
                        },
                        {
                            "text": "She suffered from a severe <w>gripe</w> after eating the spicy meal.",
                            "target_lang_translations": {
                                "cs": "Po snědení pálivého jídla trpěla silnými <w>bolestmi v břiše</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This medical usage is now rare."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ostrá, svíravá bolest v žaludku nebo střevech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bolesti v břiše",
                                "target_lang_sense_clarification": "obecné označení pro břišní potíže"
                            },
                            {
                                "target_lang_word": "křeče v břiše",
                                "target_lang_sense_clarification": "svíravá, ostrá bolest"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}