                "senses": [
                    {
                        "sense_id": "cb924f9d-98c8-33a8-898e-83ed91c41238",
                        "entry_id": "80779971-dd26-34af-9bfc-1235b73151ac",
                        "glosses": [
                            "Donner un caractère hard-discount à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6a8083-8659-4b97-9099-1dbf80ab177d",
                                "sense_id": "cb924f9d-98c8-33a8-898e-83ed91c41238",
                                "text": "En effet, rien n'empêche Migros de « hard-discountiser » les succursales Denner d'après les conditions requises par la Comco35."
                            },
                            {
                                "example_id": "6de18fdc-8ece-45c9-87f3-a9dc88f87bdb",
                                "sense_id": "cb924f9d-98c8-33a8-898e-83ed91c41238",
                                "text": "Un souci pour ces éditeurs de donner accès au très grand public à une cinéphilie honorable, mais plus intéressant, de briser le cercle vicieux du DVD hard-discountisé en présentant de bons titres à petits prix, sans donner l’impression de brader vulgairement ces œuvres cinématographiques."
                            }
                        ]
                    }
