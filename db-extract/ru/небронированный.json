                "senses": [
                    {
                        "sense_id": "8b7df99b-48cf-383e-9953-2d22f17232b1",
                        "entry_id": "dfe59003-e13a-3f50-a9ea-13e0aaf0b1ac",
                        "glosses": [
                            "не защищённый бронёй"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae481e8-7f77-4795-8070-2f3fe149abb2",
                                "sense_id": "8b7df99b-48cf-383e-9953-2d22f17232b1",
                                "text": "Макаров отдавал предпочтение малым, быстроходным, небронированным крейсерам."
                            },
                            {
                                "example_id": "f0b36881-a53b-4f1c-8538-06991572ff15",
                                "sense_id": "8b7df99b-48cf-383e-9953-2d22f17232b1",
                                "text": "Так и в тот день слишком много сотрудников было размещено в одной небронированной автомашине, что повлекло такие значительные жертвы в результате взрыва."
                            }
                        ]
                    }
                ],
