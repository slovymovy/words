                ],
                "senses": [
                    {
                        "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                        "entry_id": "ffbf1e54-4f22-3566-a06a-259f3a7b7ed1",
                        "glosses": [
                            "Qui offre des cannelures, des sillons, des stries profondes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee34b310-5413-4395-ab31-38637fd2d450",
                                "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                                "text": "À l’intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                            },
                            {
                                "example_id": "b657a447-f86e-417d-821b-b9596ccae3aa",
                                "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                                "text": "Les colonnes du péristyle et du portique reposaient immédiatement sur les degrés du temple ; elles étaient sans base, cannelées et d’ordre dorique s’étaient écoulé."
                            },
                            {
                                "example_id": "4d4049f8-1d6e-4ab5-9833-0fe83e89b5ed",
                                "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                                "text": "La semaine suivante, Masson apporta un numéro de journal, et de son ongle dur et cannelé désigna trois lignes de la Correspondance privée."
                            }
                        ]
                    },
                    {
                        "sense_id": "790dd89a-1d3a-3614-b1d7-2b7e01c09cad",
                        "entry_id": "ffbf1e54-4f22-3566-a06a-259f3a7b7ed1",
                        "glosses": [
                            "Se dit des bordures des pièces présentant des cannelures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa72011-1ffe-48cc-a82e-89a82998097e",
                                "sense_id": "790dd89a-1d3a-3614-b1d7-2b7e01c09cad",
                                "text": "De sinople à la barre d’argent courbée et abaissée en chef, le trait supérieur cannelé et le trait inférieur engrelé, accompagnée en chef de deux bars adossés d’or et en pointe d’une roue de moulin du même, qui est de Roche-les-Clerval (cf. illustration)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
