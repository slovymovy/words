                                    {
                                        "sense_id": "d5574d4b-300f-39c9-b8a5-9c75c0ad572a",
                                        "entry_id": "38c3e34a-cbec-3402-8183-e3248d509399",
                                        "glosses": [
                                            "The state of being abridged or lessened."
