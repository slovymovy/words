                                    {
                                        "sense_id": "965c47bb-81e4-337f-bd47-3c66ecae6741",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "A warm cloth cap worn while sleeping, often with pajamas, being common attire in northern Europe before effective home heating became widespread."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd1e17a-c81a-47b8-90a9-5308a6de9bf0",
                                                "sense_id": "965c47bb-81e4-337f-bd47-3c66ecae6741",
                                                "text": "Winston wore a nightcap to stave off the cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "A beverage drunk before bed that is usually alcoholic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bafc843-2408-4689-8b49-1b4596bd37ba",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "I'll make myself a nightcap of whisky and lemon before heading to bed."
                                            },
                                            {
                                                "example_id": "e9bcf6bd-4701-4823-b514-2ac139963881",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "You know the other night, when I had dinner with Afro-Dite? When Jo was in San Francisco? Well we dropped into the Sinners, right, just for a nightcap."
                                            },
                                            {
                                                "example_id": "19bc62bb-5971-4efc-ae88-4050be821b25",
                                                "sense_id": "c4ccb788-545e-32d2-ae4d-cc05b3dd70ec",
                                                "text": "This week I took up the relatively simple challenge of buying breakfast, lunch and dinner—and a nightcap—exclusively from konbini, as well as completing a couple of admin tasks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89fe19a-69f5-3f76-bac1-cf0858092a59",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "Something that a person reads or listens to before bed."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605012f3-58de-4d78-9199-4f25785bda87",
                                                "sense_id": "d89fe19a-69f5-3f76-bac1-cf0858092a59",
                                                "text": "\"[…] and as a nightcap I happened to pick the copy of Plato […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb76627-ead5-34dd-851e-aff2131310f3",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "The final match of a sporting contest, especially the second game of a baseball doubleheader."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e313087f-0c54-3097-b8a4-72d18a56cfc0",
                                        "entry_id": "a4734bc8-fd59-3fc1-91b2-8dcb8b1e227b",
                                        "glosses": [
                                            "A cap drawn over the face of the condemned person before they are hanged."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nightcap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
                                        "entry_id": "1a1f3175-7a87-30ca-9db9-d99986ba791c",
                                        "glosses": [
                                            "To drink an alcoholic beverage shortly before retiring to bed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5b3b48-ab2b-475f-9918-33645ef3d3a9",
                                                "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
                                                "text": "Even better than breakfast, though, is nightcapping at the Waffle House . Nightcapping happens after the bars close, but before the southern sunrise: the hours when their jukeboxes play “Freebird” on a continual loop, […]"
                                            },
                                            {
                                                "example_id": "28622363-13cb-4888-8e48-db0ad9c82b2e",
                                                "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
                                                "text": "We nightcapped at the Four Seasons Hotel George V, on the most extravagant cocktails I'd ever purchased in life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dcc6b89-6222-4afa-a59e-4d27710eae79",
                        "source_entry_id": "e58ac15d-bca5-3b82-8b06-975976ba151a",
                        "source_sense_id": "23188764-6c9e-3a9f-ba8c-4e11feb819c2",
                        "source_sense_description": "letztes Glas eines alkoholischen Getränks, das nach einem Event zu sich genommen wird",
                        "target_lang_word": "un dernier pour la route",
