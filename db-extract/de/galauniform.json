                        "glosses": [
                            "aufwendig ausgestattete Uniform, die nur bei besonderen Anlässen getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "146a4af2-8328-4c07-8505-fc7da0ead5eb",
                                "sense_id": "2455dda0-fc27-3a7c-b8c8-bf752759d58e",
                                "text": "„Die Reiter hatten ihre Galauniformen angezogen, um den Feind zu beeindrucken.“"
                            },
                            {
                                "example_id": "36199d2e-0257-4db6-b8f5-93a2c48b66f4",
                                "sense_id": "2455dda0-fc27-3a7c-b8c8-bf752759d58e",
                                "text": "„Auf höchster Ebene ist man der Ansicht, das deutsche Offizierskorps könne auf das Tragen eines Degens sowie einer Galauniform mit großer Ordensschnalle verzichten.“"
                            }
                        ],
