                    {
                        "sense_id": "9f0d1289-ac61-3c4f-95ad-48082a2ff4f8",
                        "entry_id": "04dd6869-c02f-3c3d-937e-b5323e618f17",
                        "glosses": [
                            "a law enforcement officer in protective uniforms without identification marks"
                        ],
                        "tags": [
                            "colloquial",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "b6548783-1c8e-4714-8f85-fcd3e43d632c",
                                "sense_id": "9f0d1289-ac61-3c4f-95ad-48082a2ff4f8",
                                "text": "А сего́дняшние космона́вты разгоня́ют ми́тинги и бьют же́нщин и дете́й дуби́нками!",
                                "translation": "And today's cosmonauts disperse rallies and beat women and children with batons!",
                                "english": "And today's cosmonauts disperse rallies and beat women and children with batons!"
                            }
                        ]
                    }
