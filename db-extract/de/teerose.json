                "senses": [
                    {
                        "sense_id": "758a68e7-a7ac-33d0-997d-052df1691a9e",
                        "entry_id": "ace23947-84ad-3b15-8164-396f62864f8d",
                        "glosses": [
                            "Rosenklasse, die ursprünglich aus China stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe08fbf8-448b-433f-b61a-0aa72662e1c8",
                                "sense_id": "758a68e7-a7ac-33d0-997d-052df1691a9e",
                                "text": "Teerosen kamen im 18. Jahrhundert von China nach Europa."
                            },
                            {
                                "example_id": "5c768b6a-c8c1-40d3-9f33-3bcdf85baffd",
                                "sense_id": "758a68e7-a7ac-33d0-997d-052df1691a9e",
                                "text": "„Es war fremd, nur zweimal hatte ich es in dieser Wohnung gehört, als ein Junge Milch brachte und Züpfner Marie die Teerosen schickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "49a639c4-13d2-3ae8-b6ab-a760a6487d53",
                        "entry_id": "ace23947-84ad-3b15-8164-396f62864f8d",
                        "glosses": [
                            "Bündel aus ausgesuchten Teezweigen, das zur Teebereitung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "703211e0-661e-44cb-b1bc-eb5821352837",
                                "sense_id": "49a639c4-13d2-3ae8-b6ab-a760a6487d53",
                                "text": "Nachdem beim ersten Aufguss die Teerose viel Wasser aufsaugt, soll der zweite Aufguss den besten Tee ergeben."
                            }
                        ],
                        "sense_index_json": "\"2\""
