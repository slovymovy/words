                "senses": [
                    {
                        "sense_id": "fa09aa23-9dd5-358a-9fb3-3e26b6880e35",
                        "entry_id": "957324fa-c391-3d9e-ab5c-29c2ea98e519",
                        "glosses": [
                            "The summit of a mountain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f732fa73-0a41-4633-8efc-273ba29b8164",
                                "sense_id": "fa09aa23-9dd5-358a-9fb3-3e26b6880e35",
                                "text": "So we follow dear Jenny along the mountaintop trail, until it descends to the forest below, where Maple and Oak, and violet Trefoil, and velvety Viburnum grow; where polynose clusters hang from Striped Maple, and Cinnamon Ferns that show."
                            },
                            {
                                "example_id": "a2cb7f22-2a23-43dd-8273-151bf887833d",
                                "sense_id": "fa09aa23-9dd5-358a-9fb3-3e26b6880e35",
                                "text": "While I've gazed at the sky from my sleeping bag on isolated mountaintops in Montana and southern beaches of Mexico and seen a jazillion stars basking in the peace of the evening, only in Rishikesh do the jazillion merge upon another bajillion jazillion and seem to lay overhead thick as glittering ceiling tiles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77aa2196-01b1-4225-b40b-37d73b7c6d6e",
                        "source_entry_id": "957324fa-c391-3d9e-ab5c-29c2ea98e519",
                        "source_sense_id": "fa09aa23-9dd5-358a-9fb3-3e26b6880e35",
                        "source_sense_description": "the summit of a mountain",
                        "target_lang_word": "bergtop",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bergtop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "37066e11-e09d-33db-b1f9-cf0c7a769f42",
                                        "entry_id": "8849c969-09dd-3ca5-8e5f-cc4d711c38d7",
                                        "glosses": [
                                            "de top van een berg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02a59538-ac4e-4a11-a006-c6a4bd0af387",
                                                "sense_id": "37066e11-e09d-33db-b1f9-cf0c7a769f42",
                                                "text": "De hoogte van bergtoppen wordt voor een belangrijk deel bepaald door de hoogte van de sneeuwgrens."
                                            },
                                            {
                                                "example_id": "04ca0add-82fa-4e78-b667-9686d41a00ac",
                                                "sense_id": "37066e11-e09d-33db-b1f9-cf0c7a769f42",
                                                "text": "Gespannen rende ik naar de enige beschutte plek op de bergtop, een kleine berghut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46cda886-1c26-4e9c-bf16-f062204a82cb",
                        "source_entry_id": "957324fa-c391-3d9e-ab5c-29c2ea98e519",
                        "source_sense_id": "fa09aa23-9dd5-358a-9fb3-3e26b6880e35",
                        "source_sense_description": "the summit of a mountain",
                        "target_lang_word": "Berggipfel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berggipfel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db7eec08-32c6-3978-af86-864f5f36e36a",
                                        "entry_id": "a127ad5a-9176-3f58-addf-6ccd8dff75fc",
                                        "glosses": [
                                            "der höchste Punkt eines Berges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e2e3c0-45dd-4279-847a-599e41784447",
                                                "sense_id": "db7eec08-32c6-3978-af86-864f5f36e36a",
                                                "text": "Die Bergsteiger erklommen mehrere Berggipfel bei ihrer Tour."
                                            },
                                            {
                                                "example_id": "102f5056-3fff-4093-b514-fa798c6ea201",
                                                "sense_id": "db7eec08-32c6-3978-af86-864f5f36e36a",
                                                "text": "„Ebenso steht es mit den Höhenmarkierungen, die der Ort, die Baumgrenze, die Gletscherzunge oder der Berggipfel bieten: Sie sind in ihrer skalensprengenden Wirkung selber die Signale eines Höhentaumels, diese Meter-Angaben.“"
                                            },
                                            {
                                                "example_id": "80d4c7bc-2384-485e-8a60-a807691a6a58",
                                                "sense_id": "db7eec08-32c6-3978-af86-864f5f36e36a",
                                                "text": "„Der Himmel über den Berggipfeln war von reinstem Blau, die Gletscher wirkten menschenfeindlicher denn je.“"
                                            },
                                            {
                                                "example_id": "b475bc16-ec02-49a6-bbd0-ad2d07651c9a",
                                                "sense_id": "db7eec08-32c6-3978-af86-864f5f36e36a",
                                                "text": "„Nach einigen Stunden verzieht sich der Nebel von den Berggipfeln; die Sonne scheint.“"
                                            },
                                            {
                                                "example_id": "9d518849-f261-4a7c-9fb9-d6486d70d148",
                                                "sense_id": "db7eec08-32c6-3978-af86-864f5f36e36a",
                                                "text": "„Sie sind kleiner als Oppida, umringen Berggipfel und gelten als Fluchtburgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9a713a1-a97d-4dec-a777-171c339b3b8b",
                        "source_entry_id": "957324fa-c391-3d9e-ab5c-29c2ea98e519",
