                                                "sense_id": "f7826683-0d4c-33a1-9009-abc2bb02390d",
                                                "text": "„Laut Definition des Centers for Desease Control and Prevention (CDC) gelten alle im Krankenhaus sowie in anderen medizinischen Einrichtungen erworbenen Infektionen als nosokomial.“"
                                            },
                                            {
                                                "example_id": "b9101ae6-144b-4d5a-8564-76940d35afa6",
                                                "sense_id": "f7826683-0d4c-33a1-9009-abc2bb02390d",
                                                "text": "„Als weitere Infektionen können z.B. Knochen- und Gelenkinfektionen, Infektionen im Bereich des Herz-Kreislauf-Systems, Haut- und Weichteilinfektionen, gastrointestinale Infektionen und obere Atemwegsinfektionen nosokomial erworben werden.“"
                                            },
                                            {
                                                "example_id": "99e5886a-0058-4e6f-912c-38a0ed230959",
                                                "sense_id": "f7826683-0d4c-33a1-9009-abc2bb02390d",
                                                "text": "„Dauerkatheter sind die Hauptursache nosokomial erworbener Harnwegsinfektionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
