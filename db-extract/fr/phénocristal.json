                        "glosses": [
                            "Cristal de grande taille, généralement visible à l’œil nu, formé avant la cristallisation complète d’une roche magmatique et se distinguant nettement de la pâte plus fine qui l’entoure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd00748-f1f8-4d46-8fd4-3984fd2e4d27",
                                "sense_id": "3e157839-4a05-3140-9e7e-28a5726e0a0e",
                                "text": "Les nombreuses inclusions de verre dans le phénocristal sont réparties suivant les zones croissance du cristal."
                            },
                            {
                                "example_id": "7b70f4ca-99da-4600-a207-acf13604e93c",
                                "sense_id": "3e157839-4a05-3140-9e7e-28a5726e0a0e",
                                "text": "On peut parler de phénocristaux d'un millimètre jusqu'à dix centimètres."
                            }
                        ]
                    }
                ],
