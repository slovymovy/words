                "senses": [
                    {
                        "sense_id": "46adab7b-39a4-32a0-b012-2f0ae6bd434e",
                        "entry_id": "52031250-e73c-3a99-8c4b-656c1c001de4",
                        "glosses": [
                            "Caoutchouc vulcaniser avec 30 à 40 % de soufre matériaux noir, dur , cassant et qui s’employait beaucoup dans l’industrie, notamment comme isolateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c4505aa-eaad-4b6e-a55b-3bf191ac105f",
                                "sense_id": "46adab7b-39a4-32a0-b012-2f0ae6bd434e",
                                "text": "La découverte de l’ébonite est liée à la vulcanisation du caoutchouc."
                            },
                            {
                                "example_id": "94c0cec9-6133-458b-a1e7-a64519bc9b27",
                                "sense_id": "46adab7b-39a4-32a0-b012-2f0ae6bd434e",
                                "text": "Les ébonites fabriquées avec le néoprène présentent les mêmes supériorités sur les ébonites de caoutchouc naturel."
                            },
                            {
                                "example_id": "0510567f-fc86-4a51-9f93-454231febd92",
                                "sense_id": "46adab7b-39a4-32a0-b012-2f0ae6bd434e",
                                "text": "Comme il n’était pas mauvais qu’il eût de la complaisance envers lui-même et saisît le récepteur pour crier dans l’ébonite chaque fois que grésillait le téléphone. « Ici, maître Méliset… »"
                            }
                        ]
                    }
