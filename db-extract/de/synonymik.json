                "senses": [
                    {
                        "sense_id": "f2aa7d09-2357-30bc-9b22-c4f225e8347d",
                        "entry_id": "4b2542d7-9919-36f0-884f-809eb4f7a3b8",
                        "glosses": [
                            "die Lehre von den Synonymen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2eb5dd35-ec4b-4991-b911-2a18d72e3e0a",
                                "sense_id": "f2aa7d09-2357-30bc-9b22-c4f225e8347d",
                                "text": "„Als der eigentliche Begründer der deutschen Synonymik ist der Prediger Sam. Joh. Ernst Stosch zu bezeichnen, der in seinem Versuch in richtiger Bestimmung einiger gleichbedeutenden Wörter der deutschen Sprache (Frankfurt a. d. O. 1770—75, 4 Teile; 2. Auflage Berlin 1780) zuerst nicht ein bloßes Verzeichnis von Synonymen, wie deren schon im 16. Jahrhundert vorhanden waren*), sondern wirkliche Erklärungen und Unterscheidungen der sinnverwandten Wörter gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2665f7f3-e0f1-3e48-a313-a5e32b91af7f",
                        "entry_id": "4b2542d7-9919-36f0-884f-809eb4f7a3b8",
                        "glosses": [
                            "Wörterbuch der Synonyme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17b0d45-e238-47bb-a58f-a7472058cae9",
                                "sense_id": "2665f7f3-e0f1-3e48-a313-a5e32b91af7f",
                                "text": "Kumulative Synonymiken ordnen die einem Lexem ähnlichen lexikalischen Zeichen ohne Unterscheidung der Lesarten diesem Lexem zu; eine kumulative Synonymik ist Duden Band 8. Die sinn- und sachverwandten Wörter."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "66dcedc5-cfbe-3740-a5ac-04d7b434a524",
                        "entry_id": "4b2542d7-9919-36f0-884f-809eb4f7a3b8",
                        "glosses": [
                            "Übereinstimmung der Bedeutung verschiedener Wörter"
                        ],
                        "tags": [
                            "no-plural",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "69a80b04-470f-4160-bd2a-7fec1fad336c",
                                "sense_id": "66dcedc5-cfbe-3740-a5ac-04d7b434a524",
                                "text": "„Die verschiedenen Bedeutungen jedes Wortes sind in übersichtlicher, verständlicher Weise unter weitgehender Beachtung der Phraseologie und Synonymik und unter sorgfältiger Angabe der Konstruktionen aufgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
