                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e06c02b8-6c44-449a-9595-8768d71c1ddf",
                                                "sense_id": "48dc5522-aac8-3086-8b7a-3c3d102fa7d2",
                                                "text": "The animation, in a style somewhere between Arthur Rackham’s and Disney gothic, is handsome enough to have furnished publisher Harry Abrams with a new, coffee-table edition of “The Hobbit,” and the voices of the characters—Orson Bean, John Huston, Richard Boone, Cyril Ritchard and Brother Theodore—are as distinctive as you’d want for this odd assortment of Middle-earthians."
                                            }
                                        ]
