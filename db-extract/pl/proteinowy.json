                                "example_id": "fd69cc61-d47d-45d4-a855-155ba44c2f9f",
                                "sense_id": "a4037eb0-b2ed-334b-bcf9-64a5308e3d60",
                                "text": "Przed treningiem pijemy zawsze odżywkę proteinową, aby dostarczyć organizmowi odpowiednią dozę białka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
