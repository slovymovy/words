                ],
                "senses": [
                    {
                        "sense_id": "a66c084e-46eb-32ec-9620-be44255ade44",
                        "entry_id": "c45e281a-aef5-3431-a017-f7aefa7f627a",
                        "glosses": [
                            "eine von mehreren möglichen Formen eines bestimmten Schriftzeichens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff50848e-c5a1-4227-bbf6-c9fb0b792994",
                                "sense_id": "a66c084e-46eb-32ec-9620-be44255ade44",
                                "text": "Kursive, fette oder normale Schriftzeichen bilden verschiedene Allographe."
                            },
                            {
                                "example_id": "85b73e70-1685-4128-a975-8fa53734704a",
                                "sense_id": "a66c084e-46eb-32ec-9620-be44255ade44",
                                "text": "„Wie die Beispiele zeigen, werden sowohl schreibtechnische als auch funktionale Varianten als Allographen bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2103bab4-d10b-3852-b59b-2ff9dbc52a65",
                        "entry_id": "c45e281a-aef5-3431-a017-f7aefa7f627a",
                        "glosses": [
                            "unterschiedliche Schreibweise desselben Phonems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f574124-f762-4805-898d-a361a91a457b",
                                "sense_id": "2103bab4-d10b-3852-b59b-2ff9dbc52a65",
                                "text": "Das Phonem [s] wird unterschiedlich geschrieben, je nachdem, nach welchem Laut es steht: „Biss“, aber „beißen“; „ss“ und „ß“ sind Allographe zur Wiedergabe des /s/."
                            },
                            {
                                "example_id": "5182fa2e-93b3-41d9-91b2-3d4fba65d1d4",
                                "sense_id": "2103bab4-d10b-3852-b59b-2ff9dbc52a65",
                                "text": "„Die einzelnen Varianten heißen Allographe.“"
                            },
                            {
                                "example_id": "3ccfd5d6-d3e5-4ea6-8fa8-78ac03db0683",
                                "sense_id": "2103bab4-d10b-3852-b59b-2ff9dbc52a65",
                                "text": "„Solche Varianten, solche Allographe also, können einfach individuell verschieden sein; jeder von uns hat eine etwas andere Handschrift.“"
                            },
                            {
                                "example_id": "d8dbdf3f-aea6-4a13-90c4-bcb4f2f74563",
                                "sense_id": "2103bab4-d10b-3852-b59b-2ff9dbc52a65",
                                "text": "„Graphische Varianten, sogenannte Allographe, sind demnach verschiedene Schreibungen für ein und dasselbe Phonem (…).“"
                            },
                            {
                                "example_id": "f17a395a-097a-47cf-a80d-5f62d7c79b50",
                                "sense_id": "2103bab4-d10b-3852-b59b-2ff9dbc52a65",
                                "text": "„Allographen, die ein Phonem wiedergeben, heißen Allographone“."
                            },
                            {
                                "example_id": "a905c515-9551-4dd8-9f6d-7a0c01f49c73",
                                "sense_id": "2103bab4-d10b-3852-b59b-2ff9dbc52a65",
                                "text": "„Wie die Beispiele zeigen, werden sowohl schreibtechnische als auch funktionale Varianten als Allographen bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "90df04c4-652b-38a4-94fa-ef858fe26379",
                        "entry_id": "c45e281a-aef5-3431-a017-f7aefa7f627a",
                        "glosses": [
                            "unterschiedliche Schreibweisen sprachlicher Ausdrücke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161fccc7-2522-48d6-8e8f-26d627dc9e14",
                                "sense_id": "90df04c4-652b-38a4-94fa-ef858fe26379",
                                "text": "Viele Wörter können unterschiedlich geschrieben werden und bilden dann Allographe: „Photo“ und „Foto“."
                            },
                            {
                                "example_id": "fa020308-98e2-46c9-a1b1-3bac72aa689c",
                                "sense_id": "90df04c4-652b-38a4-94fa-ef858fe26379",
                                "text": "„Wie die Beispiele zeigen, werden sowohl schreibtechnische als auch funktionale Varianten als Allographen bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
