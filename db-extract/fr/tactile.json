                    },
                    {
                        "translation_id": "cb2166ef-1bb6-4944-bbdf-f3cba8233510",
                        "source_entry_id": "43156b6e-3c7e-3d49-9a00-47d6f5b1b0aa",
                        "target_lang_word": "touchy-feely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touchy-feely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f621acea-106c-3cad-854d-2680e878e160",
                                        "entry_id": "e902d741-f0db-3cbc-8322-c3e2cda1884f",
                                        "glosses": [
                                            "Having a fondness for physical contact with other people, especially to an excessive degree."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5f8a842-51e5-4541-a63f-d9d8584f1b91",
                                                "sense_id": "f621acea-106c-3cad-854d-2680e878e160",
                                                "text": "My last boyfriend was a lovely guy, but I dumped him because he was too touchy-feely with me in public."
                                            },
                                            {
                                                "example_id": "ff21108e-b15c-445c-a7af-fe49cb6ae276",
                                                "sense_id": "f621acea-106c-3cad-854d-2680e878e160",
                                                "text": "Kühnel’s wife, Berta, began by asking everyone to join hands. […] When I asked her later what she made of the exercise, Hellar told me: “First of all, I’m not a good-feelings, touchy-feely kind of person.”"
                                            },
                                            {
                                                "example_id": "62e49e7d-6571-44b8-9289-839d7344d5cc",
                                                "sense_id": "f621acea-106c-3cad-854d-2680e878e160",
                                                "text": "This time, the actor was in uncomfortably touchy-feely form. First he sidled up behind Scarlett Johansson as she posed on the red carpet, kissed her, and slid his hand around her waist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5685852a-dc50-3c31-8eb3-d8fec0bd5ace",
                                        "entry_id": "e902d741-f0db-3cbc-8322-c3e2cda1884f",
                                        "glosses": [
                                            "Driven by intuition or emotion, with a connotation of de-emphasis of rational thought or logic."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b6f3f1-f8de-4132-a0d8-fd28fd1f8f69",
                                                "sense_id": "5685852a-dc50-3c31-8eb3-d8fec0bd5ace",
                                                "text": "He preferred the clarity of science and left the touchy-feely stuff to others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75397a7f-8af0-3d2a-82ea-9ce4ef4dbb9b",
                                        "entry_id": "e902d741-f0db-3cbc-8322-c3e2cda1884f",
                                        "glosses": [
                                            "Appealing to emotion, sympathy, or romance."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ec7228-c2e9-4634-9a76-2f17896e8444",
                                                "sense_id": "75397a7f-8af0-3d2a-82ea-9ce4ef4dbb9b",
                                                "text": "I think the movie had too much touchy-feely nonsense and not enough action."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "touchy-feely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69706aa9-0876-368e-b6a0-cc5ed3a11724",
                                        "entry_id": "bbe550c7-7244-3f2c-8c75-b6e5b4761e2a",
                                        "glosses": [
                                            "Physical contact, typically sexual, and usually inappropriate or unwanted."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bdd7037-d1df-4ecd-90ff-e62bdbe5c0d2",
                                                "sense_id": "69706aa9-0876-368e-b6a0-cc5ed3a11724",
                                                "text": "Why is it that, when straight men are touched, it is an affront worthy of outrage and police investigation, yet a woman's being the subject of a bar-wide game of touchy-feely is par for the course?"
                                            },
                                            {
                                                "example_id": "e078ea7f-d6ba-42d9-bd3e-e62627543798",
                                                "sense_id": "69706aa9-0876-368e-b6a0-cc5ed3a11724",
                                                "text": "When I was wrestling, females were just appearing on the scene. I loved my coach's position. \"If they want to wrestle with the boys, sure, I will put our wrestlers on the mat for some touchy feely. (Paraphrased, but not by much)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
