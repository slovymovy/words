                "senses": [
                    {
                        "sense_id": "bdbb86ff-0da9-37d0-b9bc-c0ee50e8d354",
                        "entry_id": "3c01969e-ff69-3ca7-ba9a-112a0e7aff7c",
                        "glosses": [
                            "Destiné à contrer les attaques venues des airs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1f786d-eed6-4818-984e-278994f655f9",
                                "sense_id": "bdbb86ff-0da9-37d0-b9bc-c0ee50e8d354",
                                "text": "Le ton est désabusé. Nous avons connu le déluge. Le tir antiaérien n'est, chez nous, qu'une pluie de printemps."
                            },
                            {
                                "example_id": "0de473ab-e12b-4c2a-923d-446262366366",
                                "sense_id": "bdbb86ff-0da9-37d0-b9bc-c0ee50e8d354",
                                "text": "Contournant ce char immobilisé, le chauffeur du char antiaérien de Wortmann continua à avancer."
                            },
                            {
                                "example_id": "591abb0c-6347-4dc7-bea2-1eafc32e3e7a",
                                "sense_id": "bdbb86ff-0da9-37d0-b9bc-c0ee50e8d354",
                                "text": "Missile antiaérien."
                            },
                            {
                                "example_id": "5568d643-b9aa-4345-9062-aa8a35eeec3c",
                                "sense_id": "bdbb86ff-0da9-37d0-b9bc-c0ee50e8d354",
                                "text": "Le président russe s’exprimait au cours d’une très longue séance annuelle de questions-réponses avec ses concitoyens en direct à la télévision où il a également évoqué la guerre en Ukraine, sa décision d’ouvrir la voie à la possible vente de batteries antiaériennes S-300 à l’Iran, ainsi que l’enquête sur la mort de Boris Nemtsov."
                            }
                        ]
                    }
