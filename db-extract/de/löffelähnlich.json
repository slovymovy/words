                ],
                "senses": [
                    {
                        "sense_id": "7282c538-624a-3e77-af11-2955f0a25970",
                        "entry_id": "c12d0d03-1055-3f69-a1cf-38ae7ebfa4fd",
                        "glosses": [
                            "wie ein Löffel (aussehend); einem Löffel ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8e9f4a-f4c9-4c6e-92ab-39a74cb67585",
                                "sense_id": "7282c538-624a-3e77-af11-2955f0a25970",
                                "text": "„Darunter waren auch flache Schalen und löffelähnliche Gegenstände aus Plastik gewesen, und der Obmann hatte zufrieden genickt.“"
                            },
                            {
                                "example_id": "4506cc5b-182a-4b6f-ad87-7f5caef0bf68",
                                "sense_id": "7282c538-624a-3e77-af11-2955f0a25970",
                                "text": "„Es hatte eine löffelähnliche hohle Schaufel, in die vorne drei Gabelzinken geschlitzt waren.“"
                            },
                            {
                                "example_id": "50e31e80-3ef9-42db-adc3-025023c68188",
                                "sense_id": "7282c538-624a-3e77-af11-2955f0a25970",
                                "text": "„Wenn ich die Augen schließe, sehe ich nur dieses lange, löffelähnliche Instrument vor mir, das der Arzt in meine Scheide schob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
