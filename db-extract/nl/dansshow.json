                            {
                                "example_id": "a1f5f7b6-4cf1-46f1-818c-9ff6d23b19ad",
                                "sense_id": "61fe31b6-876e-3640-ad48-93bacba94caa",
                                "text": "Talpa gaat samen met zijn Chinese partner meer dan 200 televisieprogramma's uit eigen stal in de Chinese markt zetten, zoals de dansshow Dance Dance Dance. Ook heeft Zheijang Tangde de licentierechten gekocht voor de komende vier jaar van het ook in China zeer populaire The Voice of China."
                            },
                            {
                                "example_id": "bd06539a-1efa-4199-ab0d-83d5b5a65965",
                                "sense_id": "61fe31b6-876e-3640-ad48-93bacba94caa",
                                "text": "'Strictly Come Dancing' is een Brits concept en lijkt op de dansshow 'Dancing with the Stars' van RTL. Daarin leerden bekende Nederlanders ballroomdansen met een professionele danser."
                            },
                            {
                                "example_id": "e4ed4d06-2e63-478b-b3c8-d4c57c593c38",
                                "sense_id": "61fe31b6-876e-3640-ad48-93bacba94caa",
                                "text": "Al het werk kwam tot stilstand. Er waren parades, een vliegshow, ontvangsten, een diner en een grote dansshow."
                            }
                        ]
                    }
