                                "target_senses": [
                                    {
                                        "sense_id": "cc53884e-7281-3612-94ed-a3c9532d5c12",
                                        "entry_id": "900af26c-8f07-3203-86e4-2d2429f503de",
                                        "glosses": [
                                            "Affection cutanée, caractérisée par des tubercules blancs, lisses, luisants, qui s’élèvent sur la peau aux environs des oreilles, du cou, de la face, quelquefois sur tout le corps, et qui sont ordinairement mêlées de papules luisantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab266c3-bb13-4c8b-bc98-203d1748dca5",
                                                "sense_id": "cc53884e-7281-3612-94ed-a3c9532d5c12",
                                                "text": "Edouard Philippe était interrogé sur la transformation de son apparence du fait d’une alopécie et d’un vitiligo, maladies qui provoquent la perte des cheveux et des poils et une dépigmentation. Ces affections n’ont aucun impact sur la forme physique et intellectuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82787a51-270a-4c64-9e72-0acf7d0d6192",
                        "source_entry_id": "9a94d1bd-4888-378c-8af7-dea5aceb8354",
                        "source_sense_id": "1d3d7534-a13e-33fe-a6e8-da42ac1d0b63",
                        "target_lang_word": "vitiligo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitiligo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd08e46-a2a0-3a9f-a20e-443eb447df56",
                                        "entry_id": "ca33bf5b-7a1f-35ab-bce5-e72a02b53fba",
                                        "glosses": [
                                            "huidaandoening gekenmerkt door plaatselijke ontkleuring van de huid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba99afd7-b7e0-445a-a76e-c464f1a5e3a3",
                                                "sense_id": "ebd08e46-a2a0-3a9f-a20e-443eb447df56",
                                                "text": "De coureur en de voormalige deelneemster van America's Next Top Model, die de huidaandoening vitiligo heeft, verlieten dinsdagavond in Londen samen de GQ Awards."
                                            },
                                            {
                                                "example_id": "97a88aee-5f10-4388-9b9e-6736891b56b6",
                                                "sense_id": "ebd08e46-a2a0-3a9f-a20e-443eb447df56",
                                                "text": "De roem en de druk om te presteren wogen zwaar, waardoor Michael zijn toevlucht nam tot cosmetische ingrepen. Zelf beweerde hij slechts twee neuscorrecties te hebben ondergaan, maar die bewering botste op veel ongeloof. Verder zou Michael zijn huid hebben gebleekt nadat hij gediagnosticeerd werd met vitiligo, een huidziekte die pigment uit de huid doet verdwijnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
