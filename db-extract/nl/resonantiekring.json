                "senses": [
                    {
                        "sense_id": "bbe986d0-0b3a-389d-8369-6b0a171343a1",
                        "entry_id": "f5cd1489-da57-3ffd-94a5-5151ff6866b8",
                        "glosses": [
                            "een (hoogfrequent) schakeling die zo is ontworpen dat de “wisselstroomweerstand” van capaciteit en de zelfinductie van de erin opgenomen componenten elkaar bij een welbepaalde frequentie teniet doen. De stroomkring is dan in resonantie en, afhankelijk van het type schakeling, is de stroom of de spanning maximaal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32a9c47d-4245-4692-bdbd-ca8298eee119",
                                "sense_id": "bbe986d0-0b3a-389d-8369-6b0a171343a1",
                                "text": "In een resonantiekring kunnen de spoelen (zelfinductie) en condensatoren (capaciteit) in serie, of parallel geschakeld zijn."
                            }
                        ]
                    }
                ],
