                    }
                ],
                "senses": [
                    {
                        "sense_id": "107cf017-599f-3c36-9109-33eb8a0e8f5f",
                        "entry_id": "4601b716-fe93-32ea-b25b-ccd8985db626",
                        "glosses": [
                            "skała z grupy minerałów skałotwórczych, występujących w barwach od białej do żółtawej, zielonej lub czarnej, zawierających krzemiany wapnia, sodu, litu, magnezu, żelaza i/lub glinu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c86e99-6f42-434a-a02a-80121822c6a3",
                                "sense_id": "107cf017-599f-3c36-9109-33eb8a0e8f5f",
                                "text": "W czasie naszej podróży chcemy dotrzeć do kilku klasycznych stanowisk geologicznych z barwnymi odmianami piroksenów, amfiboli, turmalinów i nefrytów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cd0cc87-301f-4239-9971-135d0b602d6e",
                        "source_entry_id": "4601b716-fe93-32ea-b25b-ccd8985db626",
                        "source_sense_id": "107cf017-599f-3c36-9109-33eb8a0e8f5f",
                        "target_lang_word": "pyroxene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyroxene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b16ddd02-d730-33e5-bd03-3a8c922a8c22",
                                        "entry_id": "aa57a0a6-4823-36bf-8ae0-785fb122ee26",
                                        "glosses": [
                                            "Any of a group of crystalline minerals containing silicates of iron, magnesium and calcium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734a1018-66f9-4937-80ef-b4c2f3aafa95",
                                                "sense_id": "b16ddd02-d730-33e5-bd03-3a8c922a8c22",
                                                "text": "By the pathside, there are occasional large boulders that shown black crystals the size of a fingernail; these are pyroxene minerals that had time to crystallise out deep within the chamber of liquid rock – or magma – beneath the volcano."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83baee38-83e6-42f7-bf6e-4832bfa4d142",
                        "source_entry_id": "4601b716-fe93-32ea-b25b-ccd8985db626",
                        "source_sense_id": "107cf017-599f-3c36-9109-33eb8a0e8f5f",
                        "target_lang_word": "pyroxène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyroxène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08bcbdcf-593b-3332-a4ce-ccc373f5b6ba",
                                        "entry_id": "299163a5-8ff5-3926-a995-3338a7429082",
                                        "glosses": [
                                            "Groupe qui comprend actuellement 22 inosilicates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72e17f48-b19a-4e0c-9100-fc915406a40c",
                                                "sense_id": "08bcbdcf-593b-3332-a4ce-ccc373f5b6ba",
                                                "text": "Les minéraux qu'elle renferme sont le quartz, l’albite, des pyroxènes sodiques, l’ægyrine, et l’acmite supposées, zirconifères et cérifères."
                                            },
                                            {
                                                "example_id": "ca932e06-40d7-4840-8751-8191fcbd015f",
                                                "sense_id": "08bcbdcf-593b-3332-a4ce-ccc373f5b6ba",
                                                "text": "La source la plus considérable est le manteau terrestre, où les péridotites sont justement formées de minéraux ferro-magnésiens comme les olivines et les pyroxènes."
                                            },
                                            {
                                                "example_id": "51dbfcb8-ae0f-45a0-ab53-1bfe35a9eaa5",
                                                "sense_id": "08bcbdcf-593b-3332-a4ce-ccc373f5b6ba",
                                                "text": "Les informations recueillies ne sont cohérentes que s'il existe, sous la croûte lunaire composée de silicate de magnésium et de pyroxène, une masse gigantesque, une couche plus profonde en «fusion partielle»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aca12a6f-9a3b-4473-8516-82dbfe2a3451",
                        "source_entry_id": "4601b716-fe93-32ea-b25b-ccd8985db626",
                        "source_sense_id": "107cf017-599f-3c36-9109-33eb8a0e8f5f",
                        "target_lang_word": "piroxeno",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piroxeno",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3ebe46f9-df24-3ee8-b03b-1396e11c8b34",
                                        "entry_id": "e6cf4717-2836-3b42-865a-315d00f0f318",
                                        "glosses": [
                                            "Grupo de minerales cristalinos que contienen silicatos de hierro, magnesio y calcio."
                                        ],
                                        "tags": [
                                            "Minerales"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2843446-6ec3-4b35-8e06-1c7a1998a8fe",
                        "source_entry_id": "4601b716-fe93-32ea-b25b-ccd8985db626",
                        "source_sense_id": "107cf017-599f-3c36-9109-33eb8a0e8f5f",
                        "target_lang_word": "Pyroxen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyroxen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c78414fe-a3d9-3a6a-9bcc-34c71bc35fb7",
                                        "entry_id": "a12e2c7d-27bc-33e4-8eea-be006e083d8d",
                                        "glosses": [
                                            "gesteinsbildendes Mineral"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4824be6-c3f7-487a-9b36-09853b2206c8",
                                                "sense_id": "c78414fe-a3d9-3a6a-9bcc-34c71bc35fb7",
                                                "text": "Alle Pyroxene sind Kettensilikate, in denen neben Silizium und Sauerstoff vor allem Magnesium, Eisen und Kalzium eine Rolle spielen."
                                            },
                                            {
                                                "example_id": "d9b70933-c99f-4f6b-8260-41c713c83a59",
                                                "sense_id": "c78414fe-a3d9-3a6a-9bcc-34c71bc35fb7",
                                                "text": "Pyroxene haben eine Härte von etwa 5–6, sind also nicht oder nur mit Mühe ritzbar."
                                            },
                                            {
                                                "example_id": "acc1809d-6fc7-4581-9a70-802e361df2ae",
                                                "sense_id": "c78414fe-a3d9-3a6a-9bcc-34c71bc35fb7",
                                                "text": "Die Pyroxene werden eingeteilt in a) Magnesium-Eisen-Pyroxene, b) Calcium-Pyroxene, c) Natrium-Pyroxene, d) Calcium-Natrium-Pyroxene, e) Lithium-Pyroxene (Spodumen) und f) Mangan-Magnesium-Pyroxene (selten)."
                                            },
                                            {
                                                "example_id": "4ff1d8ff-2d7a-4a57-9a6d-771e7234108a",
                                                "sense_id": "c78414fe-a3d9-3a6a-9bcc-34c71bc35fb7",
                                                "text": "Wegen der Bedeutung für die Zusammensetzung und den Aufbau der unteren Erdkruste und des oberen Erdmantels sind Pyroxene Gegenstand zahlreicher neuerer Untersuchungen, insbesondere zum Verhalten der Pyroxene und ihrer Strukturen bei hohen Drucken (Hochdrucksynthese)."
                                            },
                                            {
                                                "example_id": "5f6caeec-0437-4ec8-a60f-7005e1b5b48e",
                                                "sense_id": "c78414fe-a3d9-3a6a-9bcc-34c71bc35fb7",
                                                "text": "Die Analyse zeigt jetzt, dass das Gestein hohe Anteile von Mineralien wie Feldspat und Pyroxen enthält, die vermutlich vulkanischer Herkunft sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
