                                "target_senses": [
                                    {
                                        "sense_id": "a8d60673-5e6e-3422-8d4c-9dad3d9ae60c",
                                        "entry_id": "ed9f4b35-8a9b-3c90-b2e3-9354bdc9e814",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 35 et de symbole Br qui fait partie des halogènes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5da33091-0c82-4bdc-994e-00f0a12f7a6e",
                                                "sense_id": "a8d60673-5e6e-3422-8d4c-9dad3d9ae60c",
                                                "text": "On évitera de préférence en culture maraîchère les nématicides contenant du brome, comme le dibromoéthane ou le bromure de méthyle ; en effet : les Allium sont très sensibles aux résidus de brome […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99277652-b2be-3575-b317-7384c3ef01e6",
                                        "entry_id": "ed9f4b35-8a9b-3c90-b2e3-9354bdc9e814",
                                        "glosses": [
                                            "Dibrome (Br₂) ; liquide de couleur brunâtre à température ambiante. Il est très volatil et ses vapeurs irritantes sont très toxiques."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f1b195f-a089-47dc-bc6c-0d37dcf626e6",
                                                "sense_id": "99277652-b2be-3575-b317-7384c3ef01e6",
                                                "text": "Les vapeurs du brome et l'eau de brome ont été recommandées comme désinfectant ; l'emploi des vapeurs de brome comme désinfectant a été beaucoup facilité par la préparation « du brome solide » de FRANK, qui contient jusqu'à 75 p. 10 de brome qu'il abandonne lentement à l'air (…)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e874b8df-1f6d-3803-ab4f-581ed3d28389",
                                        "entry_id": "81cc4723-fa48-3bb9-8773-b96f70778f89",
                                        "glosses": [
                                            "Plante herbacée, utilisée comme plante fourragère. Elle constitue un genre de la famille des Poacées (graminées), son nom taxinomique est Bromus L.."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b33611a-9770-4fae-bff6-22747970fc80",
                                                "sense_id": "e874b8df-1f6d-3803-ab4f-581ed3d28389",
                                                "text": "Une association luzerne x dactyle produit plus de lait par hectare, mais moins de lait par vache, qu'une association luzerne x brome."
                                            },
                                            {
                                                "example_id": "cfeb2d98-ecd8-4f46-8a13-8f613b1703a0",
                                                "sense_id": "e874b8df-1f6d-3803-ab4f-581ed3d28389",
                                                "text": "Ce n’est sûrement pas moi qui ferai concurrence aux vaches : brome, fétuque, pâturin, merci bien."
                                            },
                                            {
                                                "example_id": "89e304f4-791d-4eab-a974-0e3afda0b79e",
                                                "sense_id": "e874b8df-1f6d-3803-ab4f-581ed3d28389",
                                                "text": "Des vaches peuvent produire 22 kg de lait, sans complémentation, avec un pâturage de luzerne x brome. Au delà, un apport de concentré est nécessaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brome",
                                "target_lang_code": "fr",
                                "target_senses": [
