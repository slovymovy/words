                        "entry_id": "ee152a52-b8ca-363e-abdc-741da7cf2076",
                        "glosses": [
                            "White beads of low value made from shells, formerly used for ornaments and currency by Native Americans of colonial Virginia."
                        ],
                        "tags": [
                            "US",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "59536077-458d-45f3-8ea2-5d5bde0ef116",
                                "sense_id": "a259dc61-27cb-3c50-95fd-6cde2f90f8b2",
                                "text": "Cuscarawaoke, where is made so much Rawranoke or white beads that occasion as much dissention among the savages, as gold and silver amongst Christians […]"
                            },
                            {
                                "example_id": "424db7f0-5611-4854-8e50-9b04fdb98629",
                                "sense_id": "a259dc61-27cb-3c50-95fd-6cde2f90f8b2",
                                "text": "Pohatan, King of Virgiania's habit all embroidered with shells, or Roanoke (p. 47); Virginian purses imbroidered with Roanoake (p. 51)"
                            },
                            {
                                "example_id": "0850b9b7-cabb-4e51-9bfe-c8bf07808200",
                                "sense_id": "a259dc61-27cb-3c50-95fd-6cde2f90f8b2",
                                "text": "The king of Machepungo was ordered to deliver over twice as much roanoke in graduated payments over the course of eight months."
                            }
                        ]
                    }
