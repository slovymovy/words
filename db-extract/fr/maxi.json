            {
                "entry_id": "2ca48c8d-b1af-3c56-8eba-19000e812646",
                "word": "Maxi",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4287bf60-a146-3034-9b6b-2e184ac25cc8",
                        "entry_id": "2ca48c8d-b1af-3c56-8eba-19000e812646",
                        "glosses": [
                            "Nom donné par la marque automobile Austin à un modèle de voiture familiale compacte, produit de 1969 à 1981."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "558e2780-bfa3-4823-9ec9-1f0e28594557",
                                "sense_id": "4287bf60-a146-3034-9b6b-2e184ac25cc8",
                                "text": "Victime de la cacophonie interne, la Maxi doit lutter face aux Morris Marina et Austin Allegro."
                            },
                            {
                                "example_id": "7ccd7a85-65ed-4d5f-8ee3-054a65d8a4f9",
                                "sense_id": "4287bf60-a146-3034-9b6b-2e184ac25cc8",
                                "text": "Plus que la Mini Clubman Estate, le nouveau Mini Clubman semble le descendant de l’Austin Maxi, de par son gabarit."
                            },
                            {
                                "example_id": "a391a426-2ea9-4c3e-b92f-9e20aa0d51ad",
                                "sense_id": "4287bf60-a146-3034-9b6b-2e184ac25cc8",
                                "text": "L’Austin Maxi, malgré son habitabilité intérieure généreuse, possède des dimensions encore inférieures à la Marina."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5a249b5a-e9e0-3d08-bd1e-64432df22076",
                "word": "maxi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "de9d81ed-d68c-48da-842d-3deb7f4a074b",
                        "entry_id": "5a249b5a-e9e0-3d08-bd1e-64432df22076",
                        "tags": [
                            "plural"
                        ],
                        "form": "maxis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc9d683a-db29-3435-98e6-08160470b668",
                        "entry_id": "5a249b5a-e9e0-3d08-bd1e-64432df22076",
                        "glosses": [
                            "Album de musique en vinyle, de format 45 tours, dont le morceau de la face A est plus long que la version du même morceau sur un disque 33 tours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e2bc9c-cbea-426e-a411-52968d228cc8",
                                "sense_id": "cc9d683a-db29-3435-98e6-08160470b668",
                                "text": "Les mécanismes du marketing fonctionnent toujours selon la loi des rendements décroissants : à mesure que tout le monde avait son propre gimmick, il fallait aller toujours plus loin pour conserver l’exclusivité. Les maxis ordinaires furent rapidement dépassés par les éditions en vinyle de couleur et des produits spéciaux comme le maxi de Phonogram …"
                            }
                        ]
                    },
                    {
                        "sense_id": "b9b0a68a-5aca-39c4-87b6-6b908292ddbe",
                        "entry_id": "5a249b5a-e9e0-3d08-bd1e-64432df22076",
                        "glosses": [
                            "Nom francophone de l'EP ou extended play, support musical plus court que l’album."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f19b37d2-6077-3eee-a28b-e5738ddaae1c",
                        "entry_id": "5a249b5a-e9e0-3d08-bd1e-64432df22076",
                        "glosses": [
                            "Vêtement très long, maxi-manteau, robe maxi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e894cf4b-a3dc-43c0-b33e-dbc97fc1a47e",
                                "sense_id": "f19b37d2-6077-3eee-a28b-e5738ddaae1c",
                                "text": "Porter un maxi."
                            },
                            {
                                "example_id": "07499e06-e364-42aa-9f31-a567db0fd722",
                                "sense_id": "f19b37d2-6077-3eee-a28b-e5738ddaae1c",
                                "text": "Chics ... maxi-cuir, col véritable fourrure ou à capuche, …."
                            }
                        ]
                    }
