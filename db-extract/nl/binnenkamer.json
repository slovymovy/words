                    {
                        "sense_id": "36b36371-d1e0-36bd-81ca-dd8fa5034caa",
                        "entry_id": "a9a321f5-9856-3951-b5e7-3f294c701933",
                        "glosses": [
                            "een ruimte in een gebouw die geen uitzicht heeft op de buitenwereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "551f1ca5-e217-4af0-9733-3f84c39f0488",
                                "sense_id": "36b36371-d1e0-36bd-81ca-dd8fa5034caa",
                                "text": "Diezelfde avond nog, het was 23 april 1744, ontbood raadpensionaris Van der Heim de Engelse gezant Trevor in het Secreet Besogne, de Nederlandse binnenkamer voor buitenlandse zaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "00aa2704-40b7-3516-9336-fbb50a7584ce",
                        "entry_id": "a9a321f5-9856-3951-b5e7-3f294c701933",
                        "glosses": [
                            "een geheime, verborgen, niet openbare plek"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "537bce03-12c4-4d0c-94d4-a21a1fed1301",
                                "sense_id": "00aa2704-40b7-3516-9336-fbb50a7584ce",
                                "text": "Minister Hoekstra (Financiën) wil vrijdagmiddag niet reageren op de nieuwsberichten. De gesprekken met de luchtvaartmaatschappij en de Franse staat worden in de ’binnenkamer’ gevoerd. „Als de tijd daar is, zullen we daar natuurlijk over communiceren. Maar niet hier en nu, op basis van wilde geruchten en bedragen. Dat ga ik niet alleen nu hier niet doen, maar ook de komende periode niet.”"
                            }
                        ]
                    }
