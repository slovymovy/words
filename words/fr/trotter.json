                {
                    "sense_id": "2938e941-bb31-3b4f-9895-f254cb37f7e3",
                    "sense_definition": "Aller au trot, en parlant d'un cheval ou d'un autre animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cheval commence à <w>trotter</w> calmement le long de la rivière."
                        },
                        {
                            "text": "Après quelques minutes de marche, la jument a <w>trotté</w> avec beaucoup d'énergie."
                        }
                    ]
                },
                {
                    "sense_id": "198389ae-012c-3edf-88da-74b0aad89a36",
                    "sense_definition": "Marcher vivement à petits pas rapides.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit enfant s'amuse à <w>trotter</w> derrière son grand frère dans le salon."
                        },
                        {
                            "text": "Des souris <w>trottent</w> discrètement sous le plancher de la vieille maison."
                        }
                    ],
                    "synonyms": [
