                "translations": [
                    {
                        "translation_id": "a181d6e6-7091-454e-8283-9606f64d2232",
                        "source_entry_id": "ddfd5607-4a93-3d20-a9b8-21b620de5608",
                        "source_sense_id": "7d7d250a-b186-38db-8910-8e35343deda5",
                        "target_lang_word": "Bilderbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bilderbuch",
