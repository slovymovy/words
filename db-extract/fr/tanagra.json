            {
                "entry_id": "e6369d0a-ae71-385b-996a-d43b44720bc4",
                "word": "Tanagra",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f46f5809-0c3f-378d-8175-119a2129b15b",
                        "entry_id": "e6369d0a-ae71-385b-996a-d43b44720bc4",
                        "glosses": [
                            "Ancienne ville de Béotie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e179e6ac-e293-41b2-92ed-882e6cb1bbd3",
                                "sense_id": "f46f5809-0c3f-378d-8175-119a2129b15b",
                                "text": "La courbe oblique, imperceptiblement déhanchée, qui va des reins au talon rappelle à Michel celle de certaines statuettes de Tanagra, dont, comme toute son époque, il raffole."
                            }
                        ]
                    },
                    {
                        "sense_id": "b00fcf24-1cc5-3386-89ff-85f0652549e0",
                        "entry_id": "e6369d0a-ae71-385b-996a-d43b44720bc4",
                        "glosses": [
                            "Dème de Grèce-Centrale, qui a repris le nom de la ville antique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "785060f6-e162-3138-aaa1-507086f76af0",
                "word": "tanagra",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "892a16e9-9ba9-41a8-923f-e35c9a60943c",
                        "entry_id": "785060f6-e162-3138-aaa1-507086f76af0",
                        "tags": [
                            "plural"
                        ],
                        "form": "tanagras"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c7fe7a8-6086-3d16-b79d-3929b95c7b74",
                        "entry_id": "785060f6-e162-3138-aaa1-507086f76af0",
                        "glosses": [
                            "Statuette votive grecque de terre cuite représentant des patriciennes, des danseuses, des éphèbes ou des enfants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3dfe2e-ea10-404e-bf86-cbebaafec9f2",
                                "sense_id": "1c7fe7a8-6086-3d16-b79d-3929b95c7b74",
                                "text": "Modelée comme un tanagra, statuette de chair aux petits seins pointus, hanches étroites et jambes fines, vive et souple, Lizzie inspirait un chaud désir, tempéré de tendres égards."
                            },
                            {
                                "example_id": "ac7f5289-bc90-44d5-aa78-d2eb841109fe",
                                "sense_id": "1c7fe7a8-6086-3d16-b79d-3929b95c7b74",
                                "text": "Sa marchandise sous le bras, il se faufilait entre deux malades, déballait un masque égyptien ou une tanagra hellénistique."
                            },
                            {
                                "example_id": "65abf50a-f04d-447a-a92b-b609327431d5",
                                "sense_id": "1c7fe7a8-6086-3d16-b79d-3929b95c7b74",
                                "text": "Elle est, d'ailleurs, mignonne comme un cœur, et serait une Tanagra sans cette tendance à l'embonpoint due à son péché mignon : la gourmandise."
                            },
                            {
                                "example_id": "e812f702-5b6e-412e-9281-7258179f7868",
                                "sense_id": "1c7fe7a8-6086-3d16-b79d-3929b95c7b74",
                                "text": "Elle avait toute la grâce de cette statuette de Tanagra que tu as dans ton atelier, Basil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94aab735-8da2-4b77-a6ee-15c734ed55fd",
                        "source_entry_id": "785060f6-e162-3138-aaa1-507086f76af0",
                        "source_sense_id": "1c7fe7a8-6086-3d16-b79d-3929b95c7b74",
