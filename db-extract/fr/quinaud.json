                            {
                                "target_word": "beschaamd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ad8d432d-4542-34c9-8d63-aa9c40d67a21",
                                        "entry_id": "ad32474d-4df3-3d2f-b63a-2b8702e5dcda",
                                        "glosses": [
                                            "vol met de neiging zich te verbergen voor anderen, verlegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae54fa32-7d39-4514-b8dd-0850b4a19886",
                                                "sense_id": "ad8d432d-4542-34c9-8d63-aa9c40d67a21",
                                                "text": "De beschaamde ouders wilden niet onderkennen dat hun jonge dochter zwanger was."
                                            },
                                            {
                                                "example_id": "5731c829-6ab5-4a5c-b4f9-2f89ef41bd1e",
                                                "sense_id": "ad8d432d-4542-34c9-8d63-aa9c40d67a21",
                                                "text": "Hoewel zijn collega's volwassen mannen waren, hadden ze een manier om over vrouwen te praten die hem even neerslachtig als beschaamd maakte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beschaamd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                                        "entry_id": "93949ad1-3d91-3742-8281-d28abc919867",
                                        "glosses": [
                                            "vol met de neiging zich te verbergen voor anderen, verlegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84703372-cab7-47d3-8cbe-61f2ee00343c",
                                                "sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                                                "text": "Ze keek beschaamd voor zich uit toen een passerende verpleger zijn hoofd haar kant op draaide."
                                            },
                                            {
                                                "example_id": "9b9a9f6e-edd5-4c98-9a02-8f3d52a66941",
                                                "sense_id": "3d42fe13-a565-3490-a204-a59e122b09c4",
                                                "text": "Ik lach hard om het gesprek een beetje lucht te geven. Joy sist beschaamd. Zij houdt maar heel selectief van mijn lach."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
