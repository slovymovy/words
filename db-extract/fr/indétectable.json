                "senses": [
                    {
                        "sense_id": "c1e64f7f-64f1-3976-a771-c535d3b85667",
                        "entry_id": "e186dafa-39a8-3fe4-8430-ffd4e5f66976",
                        "glosses": [
                            "Qui ne peut pas être détecté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abae1ea3-6de8-4e7c-a87a-f0c56eee6013",
                                "sense_id": "c1e64f7f-64f1-3976-a771-c535d3b85667",
                                "text": "Avant de rabattre son voile, elle l’a soulevé davantage, libérant un regard qu’Omar recueille, aspire, voudrait retenir. Instant indétectable pour la foule, éternité pour l’amant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6216a3a0-6e64-4348-8611-f94c1c4bab1d",
                        "source_entry_id": "e186dafa-39a8-3fe4-8430-ffd4e5f66976",
                        "source_sense_id": "c1e64f7f-64f1-3976-a771-c535d3b85667",
                        "target_lang_word": "undetectable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undetectable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                        "entry_id": "556fd0cc-73c4-3205-86fe-407124391f16",
                                        "glosses": [
                                            "Unable to be detected; not detectable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac0aef9-1bdf-4424-9920-87f875ddb2ee",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "In these days of “rolled” gold, electro-plate, and undetectable pearls, it is curious that almost the only honest Ersatz material known to the goldsmith's art should be utterly forgotten."
                                            },
                                            {
                                                "example_id": "8f014d50-a304-49ad-99af-8acc92cabd63",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "A trial of scar may be justified in a woman with a previous cesarean section who is currently on HAART, has an undetectable virus and spontaneously goes into labor."
                                            },
                                            {
                                                "example_id": "b1195444-5c70-4c35-a9d5-658dfa4db303",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "“OK, so for a few weeks I've been working on a bit of a side project. I give you the Red Kriegtober.” “Um--” “Or the Red Octkrieger. I can't decide. It's a narco sub for transporting cocaine. It's totally undetectable by the Coast Guard. Thoughts?”"
                                            },
                                            {
                                                "example_id": "0cb37757-4ed1-4198-b55f-6c6c2954ed53",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "Some forms of data poisoning are undetectable. Attackers can insert adversarial noise into the training data, altering the training data in a way that is hidden to human observers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
