                    {
                        "sense_id": "0459f5b8-e37c-349f-9001-a94cad2eccb4",
                        "entry_id": "053d5d24-e824-3d7b-b3ab-51daa5436bf3",
                        "glosses": [
                            "a fan or admirer of Jane Austen; someone who studies the works of Jane Austen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0294b92f-38df-4909-9f33-50f825a7ad76",
                                "sense_id": "0459f5b8-e37c-349f-9001-a94cad2eccb4",
                                "text": "[I]t seems a pity that they should not form a volume in one of the neat series of Jane Austen's novels now published, as to a real Austenite they contain much that is valuable, and are full of characteristic touches."
                            },
                            {
                                "example_id": "e44668ba-258a-4999-bf5d-02e6e51cffeb",
                                "sense_id": "0459f5b8-e37c-349f-9001-a94cad2eccb4",
                                "text": "Towards the end of his life, Twain took Jane Austen as one of his stock jibes and the items collected here (No. 23), dating from 1896 to 1909, show how much he enjoyed needling his Austenite friends, Howells in particular."
                            }
                        ]
                    }
