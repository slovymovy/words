                    {
                        "sense_id": "451e6118-5c91-3d62-bd9a-e1c16c4b4ba7",
                        "entry_id": "2751ee40-f835-32fa-9926-44a875d22dc6",
                        "glosses": [
                            "dienst om met behulp van een mobiele telefoon korte berichten te versturen en te ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "632b067a-9440-4bea-9023-bb8c083e8865",
                                "sense_id": "451e6118-5c91-3d62-bd9a-e1c16c4b4ba7",
                                "text": "Sms wordt vooral veel gebruikt door jongeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "097ea25a-f417-3f9d-be68-9b9af12bbd11",
                        "entry_id": "2751ee40-f835-32fa-9926-44a875d22dc6",
                        "glosses": [
                            "berichtje verstuurd met een mobiele telefoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38386b7e-41b8-434e-acdb-7e9b9a217327",
                                "sense_id": "097ea25a-f417-3f9d-be68-9b9af12bbd11",
                                "text": "Hij heeft een wel erg hoge gsm-rekening sinds hij enkele sms'en verstuurde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "956b1e8b-e6bb-454c-8b62-3834bec2473a",
                        "source_entry_id": "2751ee40-f835-32fa-9926-44a875d22dc6",
                        "source_sense_id": "451e6118-5c91-3d62-bd9a-e1c16c4b4ba7",
                        "source_sense_description": "dienst om met behulp van een mobiele telefoon korte berichten te versturen en te ontvangen",
                        "target_lang_word": "SMS-Dienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0ad219e5-34d5-4227-801a-4f86259246cf",
                        "source_entry_id": "2751ee40-f835-32fa-9926-44a875d22dc6",
                        "source_sense_id": "097ea25a-f417-3f9d-be68-9b9af12bbd11",
                        "source_sense_description": "berichtje verstuurd met een gsm",
                        "target_lang_word": "SMS",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "SMS",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                        "entry_id": "0ff7c362-386c-36e5-bc68-d7bbbd8a8f72",
                                        "glosses": [
                                            "eine über das Mobilfunknetz durch den gleichnamigen Dienst versandte Kurznachricht"
                                        ],
                                        "tags": [
                                            "Mobilfunk",
                                            "Telekommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5186700c-954e-4a88-b81d-0d3bb06a9fc4",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Dabei verrät das SMS natürlich auch, wo in Tirol es wie viel geschneit hat.“"
                                            },
                                            {
                                                "example_id": "652241c7-3dcb-4b39-a091-8cd7ca762fc5",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Das SMS kann einfach als Gedankenstütze im Handy gespeichert bleiben.“"
                                            },
                                            {
                                                "example_id": "174f377e-f4b4-4ccc-98c2-ce10d53a26e3",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„In Gaza wurde Ende Juli ein junger Mann verhaftet, nachdem er eine SMS erhalten hatte, in der eine gewisse Freude über den Tod von fünf Hamas-Kämpfern anklang.“"
                                            },
                                            {
                                                "example_id": "f59d8bdc-fbd3-4235-bd36-5c058f35a9c1",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Diese SMS stammt aus einer Datenbank, in der alle Textnachrichten erfasst sind, die im Herbst 2009 im Rahmen des an der Universität Zürich und Neuchâtel durchgeführten Projekts »SMS4science« gesammelt wurden.“"
                                            },
                                            {
                                                "example_id": "94d1b187-00b6-4c41-b951-eeb2c108d3e0",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Hin und wieder wurde die Streiterei in der Ecke lauter, und ab und zu erhielt der Barkeeper eine SMS.“"
                                            },
                                            {
                                                "example_id": "4af8b2bf-185c-4ee6-b63a-313976a4b7bf",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Ich verliere schnell den Überblick und rufe gähnend meine SMSen ab.“"
                                            },
                                            {
                                                "example_id": "e72b8aac-5479-4dd2-935f-c1aa7c023a3e",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Die SMSe, die nur so auf mein Handy spritzten, enthielten diverse Begriffe, die sich zur Veröffentlichung nicht eignen.“"
                                            },
                                            {
                                                "example_id": "463caee2-e469-4fdc-bfcf-569a1fe081d0",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Die SMSe sind so furchtbar, dass selbst ich es kaum aushalten kann und ich frage mich natürlich, wie das Mädchen sowas wohl verkraftet.“"
                                            },
                                            {
                                                "example_id": "2714ea03-0be7-4244-84e3-d3045867fd63",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Schnell schloss er die Tür hinter sich und rief die SMSe ab.“"
                                            },
                                            {
                                                "example_id": "36303ae8-0305-48c4-85be-84bbf30e6548",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Krampfhaft versuchte sie, an etwas Schönes zu denken: an die wunderbare Zeit mit Holger, an die SMSe, die sie sich gegenseitig geschickt hatten, weil sie sich nicht sehen konnten.“"
                                            },
                                            {
                                                "example_id": "649e446a-1a4a-41d9-9b48-a6128b3df582",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Da war dieser Drang, auf dich loszugehen. Von wegen unwichtig. All die Vorbereitungen, die SMSe, das neue Kleid. Ich hätte dich wütend in die Mangel nehmen wollen.“"
                                            },
                                            {
                                                "example_id": "cd6be165-e25e-4bd8-bdb6-eae17830b286",
                                                "sense_id": "7c617084-fd4f-382a-a9a0-03c22563b746",
                                                "text": "„Aber wenn ich dem von den SMSen erzähle, muss ich auch die Wahrheit über mich gestehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "SMS",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb792440-3e08-3dcc-9e1f-cc1ce0a61121",
                                        "entry_id": "06ecbc6f-a1e4-36b5-abee-80f570011eac",
                                        "glosses": [
                                            "Telekommunikationsdienst zur Übermittlung kurzer Textnachrichten"
                                        ],
                                        "tags": [
                                            "Mobilfunk",
                                            "Telekommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e0f0f18-87aa-4ec4-88d0-c656792f4022",
                                                "sense_id": "bb792440-3e08-3dcc-9e1f-cc1ce0a61121",
                                                "text": "„Seit einigen Jahren entwickelt sich unter den Internet- und Handynutzern eine neue Art von sprachlicher Kommunikation: in Chatrooms und per SMS.“"
                                            },
                                            {
                                                "example_id": "5b5a001a-b3f8-4f7d-956f-bb8ff0add3c5",
                                                "sense_id": "bb792440-3e08-3dcc-9e1f-cc1ce0a61121",
                                                "text": "„Wir erwarten in einem informellen Medium wie SMS keinen Punkt am Ende des Satzes.“"
                                            },
                                            {
                                                "example_id": "bdea2f7f-ea29-48e6-9da3-1a77fc468457",
                                                "sense_id": "bb792440-3e08-3dcc-9e1f-cc1ce0a61121",
                                                "text": "„Der SMS ist ein Speichervermittlungsdienst, der über das SMS Centre realisiert ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
