                ],
                "senses": [
                    {
                        "sense_id": "a2d25451-9c8c-3007-b771-1383d6f922a0",
                        "entry_id": "b7ecd1ac-68e0-3494-8a73-4ad9036d7719",
                        "glosses": [
                            "мякоть ореха кокосовой пальмы, из которой добывается кокосовое масло"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b5e1664-78ec-446d-bd70-60b1a216beda",
                                "sense_id": "a2d25451-9c8c-3007-b771-1383d6f922a0",
                                "text": "Караван за караваном отправлялся к морскому берегу, отвозя португальцам кожи, шкуры диких животных, кокосовую копру, страусовые перья."
                            },
                            {
                                "example_id": "f71a887c-173a-4119-b4da-55defa7d40d2",
                                "sense_id": "a2d25451-9c8c-3007-b771-1383d6f922a0",
                                "text": "Копру (сушёная мякоть кокосового ореха) производят в Южной и Юго-Восточной Азии, в Океании."
                            },
                            {
                                "example_id": "a8bfab49-c272-48f8-9938-330276eb798a",
                                "sense_id": "a2d25451-9c8c-3007-b771-1383d6f922a0",
                                "text": "Мякоть кокоса (копру), богатую витаминами и минеральными веществами, едят свежей или высушивают."
                            },
                            {
                                "example_id": "6baa4b59-3c89-41a8-a47b-128d4654f685",
                                "sense_id": "a2d25451-9c8c-3007-b771-1383d6f922a0",
                                "text": "Кокосовое масло получают из копры — мякоти кокосовых орехов .."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3458857f-d77c-4f0c-b3db-c08abb702431",
                        "source_entry_id": "b7ecd1ac-68e0-3494-8a73-4ad9036d7719",
                        "source_sense_id": "a2d25451-9c8c-3007-b771-1383d6f922a0",
                        "target_lang_word": "copra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1bc1b8-b63a-3671-a2ed-a3d93320c2ee",
                                        "entry_id": "e5d08771-ecba-3987-821e-e811f00bc15a",
                                        "glosses": [
                                            "The dried kernel of the coconut, from which coconut oil is extruded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51b128e-eb73-4b9f-a9e6-b021ce5bb6cd",
                                                "sense_id": "5d1bc1b8-b63a-3671-a2ed-a3d93320c2ee",
                                                "text": "The principal economic activity is copra production, the Government copra plantation covering some 5,170 ha. The population in 1989 was estimated at 2,000, the great majority of whom live in London, Banana and Poland villages in the west."
                                            },
                                            {
                                                "example_id": "32c83823-0bf5-46c5-bcee-7c49c6848005",
                                                "sense_id": "5d1bc1b8-b63a-3671-a2ed-a3d93320c2ee",
                                                "text": "She burnt a small quantity of straw and copra in an earthern incense bowl and took it out to him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
