                                                "example_id": "e0e88400-31b7-4acd-a604-014290ee81de",
                                                "sense_id": "6dc03031-e363-34de-956c-e016980053b6",
                                                "text": "She told him the machine was poorly built, but they both knew that she was the one who had malfunctioned."
                                            },
