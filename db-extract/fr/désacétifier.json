                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76bce9cd-a5eb-49c6-9549-c90f6b8822e3",
                                "sense_id": "826457ab-6116-3731-9716-4a5bfb4f9076",
                                "text": "Si la saveur vinaigrée a disparu, on trouve de suite par un calcul simple la proportion de tartrate à employer pour désacétifier un ou plusieurs hectolitres."
                            },
                            {
                                "example_id": "16748975-9a09-4f27-b645-09ca0a679889",
                                "sense_id": "826457ab-6116-3731-9716-4a5bfb4f9076",
                                "text": "L’eau-de-vie ainsi désacétifiée sera ramenée à 30° et distillée à nouveau, car les acétates ne sont pas volatils."
                            }
                        ]
