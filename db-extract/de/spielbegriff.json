                "senses": [
                    {
                        "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                        "entry_id": "f8441766-fc79-34f6-b161-04ba7aa16ba0",
                        "glosses": [
                            "Vorstellung von dem, was Spiel ist, definierende Bezeichnung des Phänomens Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a4099b-42da-4ddd-9a36-cf71ce48a788",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Mit Hilfe des Spielbegriffs soll aufgezeigt werden, was Musik ist und welche Möglichkeiten der Mensch hat, den Umgang mit Musik als lebendige, aktive Erfahrung von der Musik und von sich selbst zu betreiben.“"
                            },
                            {
                                "example_id": "6d0b25ca-fd65-44e5-a9e6-c6ebfd89b334",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Dem nachfolgenden Buch wurde ein weiter Spielbegriff unterlegt.“"
                            },
                            {
                                "example_id": "06b4091c-3417-47e9-a9bb-c770b6eaa836",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Huizinga bemüht sich um einen kulturwissenschaftlichen Spielbegriff, der dort angesetzt werden dürfe, wo Biologie und Psychologie mit ihm fertig seien.“"
                            },
                            {
                                "example_id": "36f68007-69e5-4d51-b9da-1db7b293c10e",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Ein klar umreißbarer Spielbegriff, wie er für die Diskussionen nur wünschenswert wäre, steht daher nicht schon am Ausgangspunkt dieser Schrift, sondern gehört erst zu deren Zielen.“"
                            },
                            {
                                "example_id": "34e9b4eb-7a26-4de8-932e-a2fe3056c084",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Unter dem programmatischen Titel Für eine Ästhetik des Spiels entwirft Ruth Sonderegger eine Theorie der Kunst, die alles auf die Karte des Spielbegriffs setzt.“"
                            },
                            {
                                "example_id": "6538ed27-35c9-47bb-8b26-c2889e747f2a",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Nicht nur die Definition des Spielbegriffs mißfällt Eichler an Huizingas Homo Ludens: Huizinga macht den Wettkampf zum zentralen Begriff seiner Theorie.“"
                            },
                            {
                                "example_id": "93bb846e-47d2-459b-8de9-6a8adaf20cbd",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Es ist unbestreitbar, dass der Spielbegriff bisweilen missbraucht wird.“"
                            },
                            {
                                "example_id": "87ce2157-d350-45fc-8208-0047c95c2b6d",
                                "sense_id": "4b567cfd-3862-389d-b1e4-0389faf52f37",
                                "text": "„Mit „LesJeux Français“ will er bewußt den Facettenreichtum des Spielbegriffs einfangen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
