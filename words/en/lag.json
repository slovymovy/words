{
    "word_family": [
        "laggard",
        "lagging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b63f5c0-b6be-3f81-bd92-a6a5e2a6d2a0",
                    "sense_definition": "To fail to keep up the pace; to move or develop slower than others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "delay_slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired runner began to <w>lag</w> behind the rest of the group during the race.",
                            "target_lang_translations": {
                                "ru": "Уставший бегун начал <w>отставать</w> от остальной группы во время забега.",
                                "zh": "比赛中，那位疲惫的选手开始<w>落后</w>于其他队员。"
                            }
                        },
                        {
                            "text": "If we <w>lag</w> in our production schedule, we will miss the deadline.",
                            "target_lang_translations": {
                                "ru": "Если мы будем <w>отставать</w> от производственного графика, мы пропустим крайний срок.",
                                "zh": "如果我们生产进度<w>滞后</w>，就无法按时完成。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lag behind",
                        "lag in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не поспевать за кем-либо или чем-либо; двигаться или развиваться медленнее других.",
                        "zh": "指未能跟上进度；比别人移动或发展得慢。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отставать",
                                "target_lang_sense_clarification": "двигаться медленнее других"
                            },
                            {
                                "target_lang_word": "задерживаться",
                                "target_lang_sense_clarification": "медлить, опаздывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "落后",
                                "target_lang_sense_clarification": "在进度或位置上处于后方"
                            },
                            {
                                "target_lang_word": "滞后",
                                "target_lang_sense_clarification": "发展速度慢于预期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d0d76bf-e5b4-313c-a6df-99534cb91496",
                    "sense_definition": "To respond slowly or with a delay, especially regarding computers or digital connections.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "delay_slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My computer started to <w>lag</w> when I opened too many heavy applications at once.",
                            "target_lang_translations": {
                                "ru": "Мой компьютер начал <w>тормозить</w>, когда я открыл слишком много тяжелых приложений одновременно.",
                                "zh": "当我同时打开太多大型程序时，电脑就开始<w>卡顿</w>了。"
                            }
                        },
                        {
                            "text": "The video call might <w>lag</w> because the internet connection is very unstable.",
                            "target_lang_translations": {
                                "ru": "Видеозвонок может <w>виснуть</w>, так как интернет-соединение очень нестабильное.",
                                "zh": "由于网络连接非常不稳定，视频通话可能会出现<w>延迟</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "video might lag",
                        "screen starts to lag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно реагировать или работать с задержкой (о компьютерах или цифровых соединениях).",
                        "zh": "指反应缓慢或有延迟，尤指计算机或数字连接。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "разг. работать медленно"
                            },
                            {
                                "target_lang_word": "лагать",
                                "target_lang_sense_clarification": "комп. жарг. работать с перебоями"
                            },
                            {
                                "target_lang_word": "виснуть",
                                "target_lang_sense_clarification": "замирать, не реагировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡顿",
                                "target_lang_sense_clarification": "运行不流畅"
                            },
                            {
                                "target_lang_word": "延迟",
                                "target_lang_sense_clarification": "响应速度慢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e482c6ee-23aa-3145-a3cb-e5945d879e12",
                    "sense_definition": "To slacken; to decrease in intensity or interest.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "delay_slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Public interest in the scandal began to <w>lag</w> after a few weeks.",
                            "target_lang_translations": {
                                "ru": "Общественный интерес к скандалу начал <w>ослабевать</w> спустя несколько недель.",
                                "zh": "几周后，公众对这起丑闻的兴趣开始<w>减弱</w>。"
                            }
                        },
                        {
                            "text": "The conversation started to <w>lag</w> as they ran out of things to talk about.",
                            "target_lang_translations": {
                                "ru": "Разговор начал <w>затухать</w>, так как у них закончились темы для обсуждения.",
                                "zh": "随着话题用尽，谈话开始<w>冷场</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interest lagged",
                        "conversation lagged"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ослабевать; уменьшаться по интенсивности или интересу.",
                        "zh": "指减弱；强度或兴趣降低。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "становиться менее интенсивным"
                            },
                            {
                                "target_lang_word": "затухать",
                                "target_lang_sense_clarification": "постепенно прекращаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "强度降低"
                            },
                            {
                                "target_lang_word": "消退",
                                "target_lang_sense_clarification": "兴趣或热情逐渐消失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e99ea19-693e-3ce2-a8c3-0102603f0fb5",
                    "sense_definition": "To cover pipes or boilers with material to prevent heat loss.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber needs to <w>lag</w> the pipes in the attic to stop them from freezing.",
                            "target_lang_translations": {
                                "ru": "Сантехнику нужно <w>изолировать</w> трубы на чердаке, чтобы они не замерзли.",
                                "zh": "水管工需要给阁楼里的管道做<w>保温</w>，以防它们冻裂。"
                            }
                        },
                        {
                            "text": "They used felt strips to <w>lag</w> the boiler for better energy efficiency.",
                            "target_lang_translations": {
                                "ru": "Они использовали полоски войлока, чтобы <w>обшить</w> бойлер для лучшей энергоэффективности.",
                                "zh": "他们用毛毡条给锅炉做<w>隔热</w>，以提高能源效率。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lag the pipes",
                        "lag a boiler"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical or construction context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обшивать трубы или котлы теплоизоляционным материалом для предотвращения потери тепла.",
                        "zh": "用隔热材料包裹管道或锅炉以防止热量散失。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "покрывать изоляцией"
                            },
                            {
                                "target_lang_word": "утеплять",
                                "target_lang_sense_clarification": "делать теплым"
                            },
                            {
                                "target_lang_word": "обшивать",
                                "target_lang_sense_clarification": "покрывать материалом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保温",
                                "target_lang_sense_clarification": "进行隔热处理"
                            },
                            {
                                "target_lang_word": "隔热",
                                "target_lang_sense_clarification": "防止热量流失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5e58c29-b9b2-3992-bc8b-074ecce59d7a",
                    "sense_definition": "To arrest or send to prison.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief was worried the police would <w>lag</w> him for the robbery.",
                            "target_lang_translations": {
                                "ru": "Вор беспокоился, что полиция <w>посадит</w> его за ограбление.",
                                "zh": "小偷担心警察会因为那起抢劫案将他<w>关押</w>。"
                            }
                        },
                        {
                            "text": "He didn't want to get <w>lagged</w> for a crime he did not commit.",
                            "target_lang_translations": {
                                "ru": "Он не хотел, чтобы его <w>посадили</w> за преступление, которого он не совершал.",
                                "zh": "他不想因为没犯过的罪而被<w>逮捕</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Арестовывать или отправлять в тюрьму.",
                        "zh": "逮捕或送入监狱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сажать",
                                "target_lang_sense_clarification": "разг. отправлять в тюрьму"
                            },
                            {
                                "target_lang_word": "арестовывать",
                                "target_lang_sense_clarification": "брать под стражу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关押",
                                "target_lang_sense_clarification": "送入监狱"
                            },
                            {
                                "target_lang_word": "逮捕",
                                "target_lang_sense_clarification": "拘捕"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47bf204d-55ca-3db3-adaf-6fd6e6c05a59",
                    "sense_definition": "A period of time between two events; a delay or interval.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "delay_slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is often a time <w>lag</w> between the flash of lightning and the sound of thunder.",
                            "target_lang_translations": {
                                "ru": "Между вспышкой молнии и раскатом грома часто бывает временная <w>задержка</w>.",
                                "zh": "闪电和雷声之间通常存在时间<w>延迟</w>。"
                            }
                        },
                        {
                            "text": "The <w>lag</w> between ordering the product and receiving it was three weeks.",
                            "target_lang_translations": {
                                "ru": "<w>Задержка</w> между заказом товара и его получением составила три недели.",
                                "zh": "从订购产品到收到货之间的<w>间隔</w>是三周。"
                            }
                        }
                    ],
                    "synonyms": [
                        "latency"
                    ],
                    "common_phrases": [
                        "time lag",
                        "brief lag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Промежуток времени между двумя событиями; задержка или интервал.",
                        "zh": "两个事件之间的时间间隔；延迟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задержка",
                                "target_lang_sense_clarification": "промедление"
                            },
                            {
                                "target_lang_word": "интервал",
                                "target_lang_sense_clarification": "промежуток времени"
                            },
                            {
                                "target_lang_word": "лаг",
                                "target_lang_sense_clarification": "спец. временной разрыв"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "延迟",
                                "target_lang_sense_clarification": "时间上的滞后"
                            },
                            {
                                "target_lang_word": "间隔",
                                "target_lang_sense_clarification": "时间上的空隙"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3faf110-15b8-3642-9d59-5e93211e864f",
                    "sense_definition": "A noticeable delay between the action of a user and the response of the server in computing or gaming.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "delay_slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player lost the match because of the terrible <w>lag</w> on the server.",
                            "target_lang_translations": {
                                "ru": "Игрок проиграл матч из-за ужасного <w>лага</w> на сервере.",
                                "zh": "由于服务器严重的<w>延迟</w>，选手输掉了比赛。"
                            }
                        },
                        {
                            "text": "You need a fast internet connection to reduce <w>lag</w> while gaming online.",
                            "target_lang_translations": {
                                "ru": "Вам нужно быстрое интернет-соединение, чтобы уменьшить <w>лаг</w> во время онлайн-игр.",
                                "zh": "在线游戏时，你需要快速的网络连接来减少<w>卡顿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "latency",
                        "delay"
                    ],
                    "common_phrases": [
                        "input lag",
                        "server lag",
                        "reduce lag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметная задержка между действием пользователя и откликом сервера в вычислениях или играх.",
                        "zh": "在计算或游戏中，用户操作与服务器响应之间明显的延迟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаг",
                                "target_lang_sense_clarification": "комп. жарг. задержка отклика"
                            },
                            {
                                "target_lang_word": "задержка",
                                "target_lang_sense_clarification": "медленный отклик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "延迟",
                                "target_lang_sense_clarification": "网络或系统响应慢"
                            },
                            {
                                "target_lang_word": "卡顿",
                                "target_lang_sense_clarification": "游戏或程序运行不顺畅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ab0e0e3-6e75-382f-9584-5dac4ce126a6",
                    "sense_definition": "A prisoner or a person who has been in prison frequently.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>lag</w> told stories about his many years spent behind bars.",
                            "target_lang_translations": {
                                "ru": "Старый <w>зек</w> рассказывал истории о своих долгих годах, проведенных за решеткой.",
                                "zh": "那位老<w>囚犯</w>讲述了他多年铁窗生涯的故事。"
                            }
                        },
                        {
                            "text": "He was known as a <w>lag</w> who had spent more time inside prison than out.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>уголовник</w>, который провел в тюрьме больше времени, чем на воле.",
                                "zh": "他是个出了名的<w>惯犯</w>，在监狱里待的时间比在外面还长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "old lag"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключённый или человек, который часто сидел в тюрьме.",
                        "zh": "囚犯或经常坐牢的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зек",
                                "target_lang_sense_clarification": "жарг. заключенный"
                            },
                            {
                                "target_lang_word": "уголовник",
                                "target_lang_sense_clarification": "преступник-рецидивист"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "囚犯",
                                "target_lang_sense_clarification": "在押人员"
                            },
                            {
                                "target_lang_word": "惯犯",
                                "target_lang_sense_clarification": "多次入狱的罪犯"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bec451e3-ddd5-31e5-bea5-15659277ad4f",
                    "sense_definition": "Coming late or staying behind; tardy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "delay_slow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lag</w> runner struggled to finish the race long after the others.",
                            "target_lang_translations": {
                                "ru": "<w>Отстающий</w> бегун с трудом закончил гонку намного позже остальных.",
                                "zh": "那位<w>落后</w>的选手在其他人跑完很久之后才艰难地完成了比赛。"
                            }
                        },
                        {
                            "text": "He arrived at the <w>lag</w> end of the event, missing most of the excitement.",
                            "target_lang_translations": {
                                "ru": "Он прибыл в самом <w>конце</w> мероприятия, пропустив всё самое интересное.",
                                "zh": "他赶在活动的<w>尾声</w>才到，错过了大部分精彩内容。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приходящий поздно или остающийся позади; запоздалый.",
                        "zh": "来得晚或落在后面；迟缓的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстающий",
                                "target_lang_sense_clarification": "находящийся позади"
                            },
                            {
                                "target_lang_word": "запоздалый",
                                "target_lang_sense_clarification": "пришедший поздно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "落后",
                                "target_lang_sense_clarification": "处于后方"
                            },
                            {
                                "target_lang_word": "迟缓",
                                "target_lang_sense_clarification": "动作或进度慢"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}