                "senses": [
                    {
                        "sense_id": "c2603442-4c75-3a32-bb7e-001a5171c75b",
                        "entry_id": "501432ee-4a19-3289-8b31-1b817651370d",
                        "glosses": [
                            "knitted trousers for a baby or child"
                        ],
                        "tags": [
                            "informal",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "8deb7acb-ccd2-4c0b-87d9-989e2df01ee2",
                                "sense_id": "c2603442-4c75-3a32-bb7e-001a5171c75b",
                                "text": "For longies, therefore, I cast on sufficiently for the waist, and work a piece of ribbing."
                            },
                            {
                                "example_id": "69701e11-7f01-42cd-bf23-c29056619599",
                                "sense_id": "c2603442-4c75-3a32-bb7e-001a5171c75b",
                                "text": "Wool 'longies' are another useful clothing item. These are like leggings that have waterproofing qualities because they are made of wool."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bd57433-1bdc-3d76-a438-b45c150982d8",
                        "entry_id": "501432ee-4a19-3289-8b31-1b817651370d",
                        "glosses": [
                            "Full-length trousers for a young boy (as distinguished from knickerbockers)."
                        ],
                        "tags": [
                            "dated",
                            "informal",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "86405e93-ecdd-4024-8a33-3c968f65d3ba",
                                "sense_id": "2bd57433-1bdc-3d76-a438-b45c150982d8",
                                "text": "Johnnie was in possession of the long trousers. He put them on. \"How do I look in longies, Sam?\" he laughed."
                            },
                            {
                                "example_id": "2e59a6b7-ed12-4d38-9c44-1b89890682a3",
                                "sense_id": "2bd57433-1bdc-3d76-a438-b45c150982d8",
                                "text": "It seemed that one firm had been sending its children's long pants, known as \"longies,\" to be made up in men's pants shops, believing the men's pants contractors better qualified to make longies than were the children's knee pants shops, as the latter do not have \" the requisite machinery nor the properly trained workers to make the longies,\" and the firm felt that the quality of the product ..."
                            },
                            {
                                "example_id": "d1b911dc-a561-461e-9b91-241420c7d299",
                                "sense_id": "2bd57433-1bdc-3d76-a438-b45c150982d8",
                                "text": "And now the same Talon fastener that the air mail pilots use in their flying suits is on your longies and knickers!"
                            },
                            {
                                "example_id": "d7e0c3d2-dd65-48e3-ad6a-2e400bb104ac",
                                "sense_id": "2bd57433-1bdc-3d76-a438-b45c150982d8",
                                "text": "Gabe's suit had one pair of longies and one pair of knickers, but his mother said he couldn't wear the longies until after the bar-mitzvah."
                            }
                        ]
                    },
                    {
                        "sense_id": "58d114aa-137f-3b65-8c41-29a32258b338",
                        "entry_id": "501432ee-4a19-3289-8b31-1b817651370d",
                        "glosses": [
                            "long underwear."
                        ],
                        "tags": [
                            "informal",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2d1012ea-a542-4cb6-92d1-809f6aca2304",
                                "sense_id": "58d114aa-137f-3b65-8c41-29a32258b338",
                                "text": "I'm not going to change anything! Not even my underwear! And that's that. Get me my old red longies!"
                            },
                            {
                                "example_id": "c5a6d041-8e4d-4d33-b5a7-1d477c1707c5",
                                "sense_id": "58d114aa-137f-3b65-8c41-29a32258b338",
                                "text": "This as she donned jeans over the longies."
                            },
                            {
                                "example_id": "bbf9e082-5aba-4bb3-94c0-289320f1f9a2",
                                "sense_id": "58d114aa-137f-3b65-8c41-29a32258b338",
                                "text": "He's got a nice heavy coat and he's wearin longies, but nights have been in the twenties everywhere north of the county line since Halloween."
                            }
                        ]
                    }
