                "senses": [
                    {
                        "sense_id": "9ca9beb1-97d2-3bf2-b78f-f4a32f6f52c0",
                        "entry_id": "d26cc654-d707-35ac-8646-92f7394e25ef",
                        "glosses": [
                            "Défriser, enlever les frisettes de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41f68e2b-d170-498c-9062-6a24e8cfa024",
                                "sense_id": "9ca9beb1-97d2-3bf2-b78f-f4a32f6f52c0",
                                "text": "D’autant plus que lesdites spécialisations toutes neuves n’ont pas nécessairement de quoi défrisoter les moustaches."
                            },
                            {
                                "example_id": "e8fecdca-b607-49d7-b42d-7f5911c8c745",
                                "sense_id": "9ca9beb1-97d2-3bf2-b78f-f4a32f6f52c0",
                                "text": "Une petite astuce pour défrisoter tes mèches, consiste à se faire deux demi-queues et à les maintenir sur l’arrière du crâne en catogan le plus fréquemment possible…"
                            },
                            {
                                "example_id": "fd319b95-e352-4f76-bea9-fdd3701e3cb4",
                                "sense_id": "9ca9beb1-97d2-3bf2-b78f-f4a32f6f52c0",
                                "text": "Pas bon pour la peau, il faut donc brosser beaucoup plus souvent un chien tondu pour aérer la peau et \"défrisoter\" le sous poil."
                            }
                        ]
                    }
