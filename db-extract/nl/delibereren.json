                "translations": [
                    {
                        "translation_id": "82eee473-df0e-459d-b254-33794410a375",
                        "source_entry_id": "cb526829-bee8-3c9b-9f74-1fa1bbbb5b6b",
                        "source_sense_id": "16278ef9-71b1-3dcf-ac73-583f77e69fa9",
                        "target_lang_word": "délibérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délibérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                        "entry_id": "12b81251-bc11-340b-aee4-0f80d13b69e5",
                                        "glosses": [
                                            "Se livrer à un examen approfondi à propos d’une question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbcd82be-d74c-4e8e-831e-4db14852c5a6",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "Il a longtemps délibéré sur ce qu’il devait faire."
                                            },
                                            {
                                                "example_id": "88c7c3eb-ebc8-4129-8e18-a9de518236ef",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "Je ne me déciderai pas à cela avant d’avoir mûrement délibéré."
                                            },
                                            {
                                                "example_id": "b4445bd9-e53c-414a-b770-2d1b989480ab",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "De propos délibéré, à dessein, exprès, après y avoir bien pensé."
                                            },
                                            {
                                                "example_id": "d96a5b24-8081-4936-b795-100505177fe2",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "On lui a rendu ce mauvais office de propos délibéré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                        "entry_id": "12b81251-bc11-340b-aee4-0f80d13b69e5",
                                        "glosses": [
                                            "Se livrer avec d’autres personnes à un examen approfondi à propos d’une question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3383d36-ef14-492f-a217-cc7e7e01b499",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Le tribunal ordonna qu’il en serait délibéré dans la chambre du Conseil."
                                            },
                                            {
                                                "example_id": "8c5a6690-1be2-4197-8270-ab302adc932e",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Les délais accordés à l’héritier bénéficiaire pour faire inventaire et délibérer."
                                            },
                                            {
                                                "example_id": "48e96a05-b03a-46b6-819b-4c179943c88e",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Le roi et les privilégiés auraient voulu que les états délibérassent comme en 1614, c'est-à-dire « par ordre ». Les privilégiés auraient eu immanquablement la majorité et les états auraient été incapables d'opérer aucune réforme sérieuse."
                                            },
                                            {
                                                "example_id": "55f901ee-5688-46eb-870b-0f7784e01a9a",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Je vais en délibérer avec lui."
                                            },
                                            {
                                                "example_id": "f2fe4866-4f4c-4194-b12d-fb86ac2ad872",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Le jury, la cour a délibéré pendant trois heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                        "entry_id": "12b81251-bc11-340b-aee4-0f80d13b69e5",
                                        "glosses": [
                                            "Décider le résultat de cet examen approfondi."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fef437a-f235-4e1f-9663-e9e322f8e942",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "C’est une chose bien délibérée."
                                            },
                                            {
                                                "example_id": "73c29bbf-7f77-4672-977d-0e897fbccbfc",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "Qu’a-t-on délibéré?"
                                            },
                                            {
                                                "example_id": "700f3b10-a34f-4075-b178-29fb6a4da478",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "J’ai délibéré de partir."
                                            },
                                            {
                                                "example_id": "b9d3c0f3-3898-494d-a27f-7e3893f122c6",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "On délibéra d’aller à l’ennemi."
                                            },
                                            {
                                                "example_id": "cadb8fd6-3522-4da0-99f9-480c27b96e61",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "Il a été délibéré en séance du Conseil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
