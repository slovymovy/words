                        "glosses": [
                            "Qui peut être troublé, perturbable."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dbc8d047-75f4-4b84-aa86-8a6f8dfcc5ae",
                                "sense_id": "722c50ea-bb1e-3320-84c5-6a1897b8d260",
                                "text": "Elle croit qu’on n’est jamais assez dédaigneux pour épier le Réel ; assez mystérieux, assez mystique, assez profond, assez troublable."
                            },
                            {
                                "example_id": "fa653929-015e-4cf5-8384-68f2ae7ee147",
                                "sense_id": "722c50ea-bb1e-3320-84c5-6a1897b8d260",
                                "text": "Jeune encore, par la seule contemplation des beautés florales, il avait atteint l'état suprême de tranquillité non troublable."
                            },
                            {
                                "example_id": "bb44b2b0-9acf-49d9-8d6d-0569f4ad5bd8",
                                "sense_id": "722c50ea-bb1e-3320-84c5-6a1897b8d260",
                                "text": "Les rabbins considèrent que les hommes sont plus « troublables » que les femmes."
                            }
                        ]
                    }
