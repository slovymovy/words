            },
            {
                "entry_id": "ac6436bf-ae63-35ec-b698-4e664f504cb2",
                "word": "isomère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b8be4f1-93d7-4b58-bbf0-fb258b90dd0b",
                        "entry_id": "ac6436bf-ae63-35ec-b698-4e664f504cb2",
                        "tags": [
                            "plural"
                        ],
                        "form": "isomères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4298cab-7b86-3bd3-b120-da7638047934",
                        "entry_id": "ac6436bf-ae63-35ec-b698-4e664f504cb2",
                        "glosses": [
                            "Molécule organique qui possède la même formule brute qu’une autre molécule, mais qui a une formule semi-développée ou une formule développée différente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee00224-02fa-4194-b65d-c394c5e78890",
                                "sense_id": "f4298cab-7b86-3bd3-b120-da7638047934",
                                "text": "On appelle isomères des composés chimiques qui ont la même formule brute mais qui diffèrent par une ou plusieurs propriétés."
                            },
                            {
                                "example_id": "fb09b977-8ce9-4215-9cef-9f0ef794d3e4",
                                "sense_id": "f4298cab-7b86-3bd3-b120-da7638047934",
                                "text": "Une perte importante d’acide benzoïque pour les isomères trans suggèrent que la protonation soit régiosélective sur le site benzoate."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae09b48a-e0a2-3f41-9a7b-b43e4224f7da",
                        "entry_id": "ac6436bf-ae63-35ec-b698-4e664f504cb2",
                        "glosses": [
                            "Noyau maintenu dans un état excité instable de manière anormalement longue."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "27afe69d-1981-467a-aadb-03a2feac2ee3",
                                "sense_id": "ae09b48a-e0a2-3f41-9a7b-b43e4224f7da",
                                "text": "On sait que l’usage s’est introduit d’appeler isotopes deux noyaux de même charge différant par la masse, isobares deux noyaux de même masse différant par la charge. Deux noyaux seront dits isomères s’ils sont à la fois isotopes et isobares."
                            },
                            {
                                "example_id": "98853d32-38e9-41f6-b410-1262c3b81729",
                                "sense_id": "ae09b48a-e0a2-3f41-9a7b-b43e4224f7da",
                                "text": "Les noyaux isomères sont des noyaux indiscernables par leur nombre atomique et leur masse atomique. Ils se distinguent cependant par leurs propriétés radioactives et notamment par leurs périodes de désintégration."
                            },
                            {
                                "example_id": "ad7e2479-d8c8-4afe-b8a7-a9870973f312",
                                "sense_id": "ae09b48a-e0a2-3f41-9a7b-b43e4224f7da",
                                "text": "L’étain-117 (¹¹⁷Sn) est stable et possède un isomère (¹¹⁷ᵐSn) d’une demi-vie de 14 jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdec2ebe-15b2-432c-aa68-8b39d31b5fcf",
                        "source_entry_id": "ac6436bf-ae63-35ec-b698-4e664f504cb2",
                        "source_sense_description": "Composé chimique en chimie (1)",
                        "target_lang_word": "Isomer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isomer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf09e0e-c305-392b-920f-67dcdaf5d406",
                                        "entry_id": "ed33c6fd-f5e7-361e-83ae-80b367316f46",
                                        "glosses": [
                                            "langlebiger, angeregter Zustand eines Atomkerns (außer dem Grundzustand); wobei langlebig etwa 1 Nanosekunde und länger bedeutet"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fa25cb5-405f-4eea-811d-e3149bf9cdeb",
                                                "sense_id": "9cf09e0e-c305-392b-920f-67dcdaf5d406",
                                                "text": "Nuklide mit gleich vielen Protonen und Neutronen, aber unterschiedlichem innerem Anregungszustand werden Kernisomere/Isomere genannt. Bezeichnet werden Nuklide mit dem chemischen Elementsymbol und der Massenzahl, wie z.B. das häufigste Kohlenstoffisotop C-12 oder das häufigste Eisenisotop Fe-56 (bei Isomeren noch mit einem Zusatz wie \"i\")."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32030f8d-12ca-34a0-a883-a18bb0cfe348",
                                        "entry_id": "ed33c6fd-f5e7-361e-83ae-80b367316f46",
                                        "glosses": [
                                            "Bezeichnung für organische Verbindungen mit gleicher Bruttoformeln, aber verschiedener Konstitution, aus der sich auch unterschiedliche chemische und physikalische Eigenschaften ergeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42eacf9a-1b9f-426d-81bb-0790a542d608",
                                                "sense_id": "32030f8d-12ca-34a0-a883-a18bb0cfe348",
                                                "text": "Eine eindeutige Unterscheidung zwischen den beiden Isomeren Sacculatal (9α H-Form) und Isosacculatal (9β H-Form) wird beim Vergleich der ¹³C-Werte der Methylgruppe C-13 möglich."
                                            },
                                            {
                                                "example_id": "394740eb-36eb-4883-8629-a0c7b4e25970",
                                                "sense_id": "32030f8d-12ca-34a0-a883-a18bb0cfe348",
                                                "text": "Die Biosynthese der Terpene verläuft in mehreren Phasen und beginnt mit dem Aufbau des Isopentenyldiphosphates (IPP), welches mit seinem Isomer, dem Dimethylallyldiphosphat (DMAPP), enzymkatalysiert im Gleichgewicht steht […]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
