                        ]
                    },
                    {
                        "translation_id": "787f70b6-ea19-430d-82db-8b2cbc358d50",
                        "source_entry_id": "ae28cbb5-2479-3247-8cc9-92743f195440",
                        "source_sense_id": "75c65547-08d0-32d9-8ed8-e475429a583a",
                        "target_lang_word": "plouf",
