                        "glosses": [
                            "Guérir d’une hallucination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad638f2-1306-415e-b386-c5955880b35f",
                                "sense_id": "4184aa6d-b64e-371f-8bf4-5de4d43ccfc3",
                                "text": "Ce moment de cure permet à Winnicott de considérer une tension entre deux activités psychiques inconscientes, l’une qui déshallucine et l’autre qui hallucine."
                            },
                            {
                                "example_id": "f1da8334-df87-46d9-aead-9ad4be12ebf5",
                                "sense_id": "4184aa6d-b64e-371f-8bf4-5de4d43ccfc3",
                                "text": "Une langue naturelle d’un groupe social se construit, je crois (cf. Jorion), à partir de mots clés, souvent des noms propres, faits pour déshalluciner le psychisme."
                            },
                            {
                                "example_id": "fe50c5a2-77a6-4dda-ad8c-5e95a1fad337",
                                "sense_id": "4184aa6d-b64e-371f-8bf4-5de4d43ccfc3",
                                "text": "Quelque chose a été supprimé, « déshalluciné », et secondairement le patient a une hallucination, qui dénie la suppression."
                            },
                            {
                                "example_id": "af306aa7-90f2-4c46-b50c-46e4d278e356",
                                "sense_id": "4184aa6d-b64e-371f-8bf4-5de4d43ccfc3",
                                "text": "C’est le meilleur moyen de déshalluciner, confirmai-je en lui tendant le sachet en question."
                            }
                        ]
                    }
