                                "example_id": "783b3694-1cfe-41f4-a133-6d4812723b96",
                                "sense_id": "86cd8b4d-1dbb-342f-9153-f11f020ec697",
                                "text": "The study found that U.S. technology company IBM had by far the largest number of AI-related patents, with 8,920."
                            }
                        ]
