                "senses": [
                    {
                        "sense_id": "4fc81c6b-2480-32c2-a05b-85373007a518",
                        "entry_id": "53e991bd-6e9f-3195-ae50-49837eb2c088",
                        "glosses": [
                            "A unit of length equal to 10⁻¹⁰ meters (that is, one ten-billionth of a meter), approximately the size of an atom, and denoted by the symbol Å, used especially to measure the wavelength of electromagnetic radiation or distances between atoms."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b450bc79-8974-472f-93cb-8022fa08a40f",
                        "source_entry_id": "53e991bd-6e9f-3195-ae50-49837eb2c088",
                        "source_sense_id": "4fc81c6b-2480-32c2-a05b-85373007a518",
                        "source_sense_description": "a very small unit of length, 10−10 m",
                        "target_lang_word": "ångström",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ångström",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e6f35d-bd67-327b-8beb-0c4a33c3b4d2",
                                        "entry_id": "ff2c59bb-2615-3dec-ad7d-b06ebc7cc5d9",
                                        "glosses": [
                                            "lengtemaat met een waarde van 10⁻¹⁰ m, dus 0,1 nanometer of 100 picometer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47210725-c938-4519-8c4b-b3f29d44087d",
                                                "sense_id": "b0e6f35d-bd67-327b-8beb-0c4a33c3b4d2",
                                                "text": "Röntgenstralen zijn niet met het oog waarneembaar. Ter vergelijking: zichtbaar licht, eveneens uit elektromagnetische golven bestaand, heeft een golflengte van 350 tot 800 nanometer, ofwel 3500 tot 8000 ångström. In de radiodiagnostiek wordt gebruik gemaakt van röntgenstralen met een golflengte van 0,008 tot 0,05 nm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47c8ac71-b0c3-4496-90f3-c456f609c824",
                        "source_entry_id": "53e991bd-6e9f-3195-ae50-49837eb2c088",
                        "source_sense_id": "4fc81c6b-2480-32c2-a05b-85373007a518",
                        "source_sense_description": "a very small unit of length, 10−10 m",
