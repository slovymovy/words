                "word_linkages": []
            },
            {
                "entry_id": "cfa90dae-85f5-3a76-a917-425fc467ff0d",
                "word": "spadassin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e4a25e89-ad46-4b70-914d-b8ffb79fd879",
                        "entry_id": "cfa90dae-85f5-3a76-a917-425fc467ff0d",
                        "tags": [
                            "plural"
                        ],
                        "form": "spadassins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "761b5b7f-f591-37bc-b043-9b0b701f6c2c",
                        "entry_id": "cfa90dae-85f5-3a76-a917-425fc467ff0d",
                        "glosses": [
                            "Bretteur, ferrailleur, duelliste utilisant l’épée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4adc76-4259-4808-b615-9645a5b93631",
                                "sense_id": "761b5b7f-f591-37bc-b043-9b0b701f6c2c",
                                "text": "Je ne suis pas un spadassin, et n’étant mousquetaire que par intérim, je ne me bats que lorsque j’y suis forcé."
                            },
                            {
                                "example_id": "0dc6438b-50f7-4122-8b4c-295a06733421",
                                "sense_id": "761b5b7f-f591-37bc-b043-9b0b701f6c2c",
                                "text": "Entre don César De Bazan. Chapeau défoncé. Grande cape déguenillée qui ne laisse voir de sa toilette que des bas mal tirés et des souliers crevés. Épée de spadassin."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2126f0f-0ae7-3b7b-8f53-abe5515ecd27",
                        "entry_id": "cfa90dae-85f5-3a76-a917-425fc467ff0d",
                        "glosses": [
                            "Tueur à gages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91c2d8f-414d-4072-a932-ef796cc41551",
                                "sense_id": "b2126f0f-0ae7-3b7b-8f53-abe5515ecd27",
                                "text": "C’est de là qu’un soir de 1407, le duc d’Orléans, le frère du roi, sortait en faisant vinaigre, lorsqu’il fut assailli et congrument trucidé par les spadassins de Jean-sans-Peur…"
                            }
                        ]
                    }
                ],
