                                        "entry_id": "3f6ad148-62a4-3054-8bf2-9448ee09c04e",
                                        "glosses": [
                                            "Alternative spelling of boy band."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a4f20d-66c2-4481-beb9-89ef6dc7acf8",
                                                "sense_id": "3dfa09a6-ce41-31f1-9dde-4bbccbb97ce6",
                                                "text": "Kay Murphy and former Boyzoner Stephen Gately, who ditches the boyband look in favour of the loincloth attire for his stage debut as Joseph."
                                            },
                                            {
                                                "example_id": "68ed862a-2e78-4e94-a386-4e7ac8b7b507",
                                                "sense_id": "3dfa09a6-ce41-31f1-9dde-4bbccbb97ce6",
                                                "text": "The man who gave us all those cheesy 1990s boybands has died. Lou Pearlman was the brains behind *NSYNC and the Backstreet Boys (and many other copy-and-paste acts)."
                                            },
                                            {
                                                "example_id": "ccb7da4d-6f93-4e4e-8c6a-9edb9c98ce50",
                                                "sense_id": "3dfa09a6-ce41-31f1-9dde-4bbccbb97ce6",
                                                "text": "Liam Payne, a former member of the boyband One Direction, has died after falling from the third floor of a hotel in Buenos Aires, Argentina, according to local police. Payne, who was 31, leaves behind his seven-year-old son, Bear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
