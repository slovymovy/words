                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9187af3e-b1bc-4219-a3e6-aa0bb3b25440",
                                                "sense_id": "946ce39d-2d51-32af-8d11-6e3a7b87d130",
                                                "text": "Poszła wiadomość, że za kilka dni marki miały wyjść z użycia, ponieważ Europa wprowadzała właśnie euro"
