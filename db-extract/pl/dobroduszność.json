                "senses": [
                    {
                        "sense_id": "7215b04a-783c-3af4-9dfa-06be608b9dcb",
                        "entry_id": "7dddf1ad-6286-3aa5-ba59-9270faa98d5c",
                        "glosses": [
                            "cecha tego, co dobroduszne; cecha tych, którzy są dobroduszni"
                        ],
                        "tags": [],
