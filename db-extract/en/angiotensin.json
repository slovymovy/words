                        "entry_id": "1e33f9d1-0cd4-32c3-8b1f-86c16f7383e3",
                        "glosses": [
                            "Any of several polypeptides that narrow blood vessels and thus regulate arterial pressure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a673f73-3e2a-4de0-9c88-6a438409223f",
                                "sense_id": "f1cd5c41-10ae-3fe3-b982-228a3a148bff",
                                "text": "2001: In addition to stimulating the srteries to constrict, angiotensin also acts on the kidneys to suppress urine production, and acts on the brain to stimulate thirst and drinking behaviour. — Leslie Iversen, Drugs: A Very Short Introduction (Oxford 2001, p. 43)"
                            }
                        ]
                    }
                ],
