                "senses": [
                    {
                        "sense_id": "b74d45fb-e268-32dd-9536-aa51839251ea",
                        "entry_id": "c5424ff1-74e6-3692-964d-379eeaf69d17",
                        "glosses": [
                            "einseitig begrenzte Nut zur Aufnahme einer Fensterscheibe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12ee98e-f3bc-4117-8fb2-212475567d13",
                                "sense_id": "b74d45fb-e268-32dd-9536-aa51839251ea",
                                "text": "„Der Glasfalz ist zweyerley; entweder bildet derselbe eine wirkliche Rinne (ganzer Glasfalz), oder nur einen halben Falz […], in welch letzterem Falle jedoch die Glastafeln verkittet werden müssen, daher man diesen auch Kittfalz nennt.“"
                            },
                            {
                                "example_id": "0dd33137-94f6-4916-abe0-f95e91f5febe",
                                "sense_id": "b74d45fb-e268-32dd-9536-aa51839251ea",
                                "text": "„‚Als Sie gestern die neue Scheibe einsetzten, fiel Ihnen auf, dass der Kittfalz nicht so glatt war, wie Sie ihn sonst immer ziehen. Ist das richtig?‘“"
                            },
                            {
                                "example_id": "b0e28f0d-8541-4482-a8f1-c2ac094d690a",
                                "sense_id": "b74d45fb-e268-32dd-9536-aa51839251ea",
                                "text": "„Wir erwähnen noch kurz, dass die Sprosseneisen, mit Kittfalz und Schweisrinnen versehen, auch ganz aus Zinkblech angefertigt und verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
