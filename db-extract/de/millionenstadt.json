                                        "glosses": [
                                            "A very large city; a megalopolis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7720d0-f479-4e0c-a002-bf3cf45924e7",
                                                "sense_id": "cbbcbdf6-27d1-3010-ab5a-51303a59d3fd",
                                                "text": "Why, for instance, do water users in a megacity like Lagos not pay an extra charge to get cesspits pumped out?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "760d05d0-a05e-4e51-a14b-e6f7ad7a1870",
