                "senses": [
                    {
                        "sense_id": "846c9391-df45-3ed8-a19e-5edbad2be091",
                        "entry_id": "6faa2cb6-b2b9-3eac-a4ec-7877aba241cd",
                        "glosses": [
                            "gestohlene Gegenstände; Dinge, die ein Dieb entwendet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e946ea6-3d62-4ffe-9e55-eadd85b11422",
                                "sense_id": "846c9391-df45-3ed8-a19e-5edbad2be091",
                                "text": "Das Diebesgut wird meist auf Flohmärkten weiter verkauft."
                            },
                            {
                                "example_id": "5d7c2145-4e68-44ab-a7dc-b81185950e14",
                                "sense_id": "846c9391-df45-3ed8-a19e-5edbad2be091",
                                "text": "„Wegen des hohen Wertes des Diebesguts und der Umstände der Tat hätte eigentlich die Todesstrafe über sie verhängt werden müssen.“"
                            },
                            {
                                "example_id": "cb5d907c-37b1-420b-8886-af6d414aa8ff",
                                "sense_id": "846c9391-df45-3ed8-a19e-5edbad2be091",
                                "text": "„Der Chef der Kommandantur versprach ihr, sie werde das Diebesgut zurückbekommen.“"
                            },
                            {
                                "example_id": "9e988de2-c7af-4b49-bd42-8da95b3c1b71",
                                "sense_id": "846c9391-df45-3ed8-a19e-5edbad2be091",
                                "text": "„Die Meldung aus England, der englische Kriminologe Hawkins habe geäußert, dass Verbrechen sich auszahle, da die Polizei von 83 Millionen DM Diebesgut, gestohlen 1958 in London, nur 32 Millionen wieder beibringen konnte, stimmt mich nachdenklich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3f04426-3607-4a0a-aef9-1c6cc610a3d3",
                        "source_entry_id": "6faa2cb6-b2b9-3eac-a4ec-7877aba241cd",
                        "source_sense_id": "846c9391-df45-3ed8-a19e-5edbad2be091",
                        "source_sense_description": "gestohlene Gegenstände; Dinge, die ein Dieb entwendet hat",
                        "target_lang_word": "stolen property",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d1926831-4d03-4115-9470-0b0314fc930b",
                        "source_entry_id": "6faa2cb6-b2b9-3eac-a4ec-7877aba241cd",
                        "source_sense_id": "846c9391-df45-3ed8-a19e-5edbad2be091",
                        "source_sense_description": "gestohlene Gegenstände; Dinge, die ein Dieb entwendet hat",
                        "target_lang_word": "butin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "butin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53d297cb-de4e-38da-b4e6-f8350b76f151",
                                        "entry_id": "5686d025-3190-3d3b-933c-c821e0f7e080",
                                        "glosses": [
                                            "Ce que l’on prend sur les ennemis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4631a4a6-2f81-4c60-abaf-031b27f2cd08",
                                                "sense_id": "53d297cb-de4e-38da-b4e6-f8350b76f151",
                                                "text": "Torquilstone est à nous ; songez à l’honneur, songez au butin ; encore un effort et la place est à nous !"
                                            },
                                            {
                                                "example_id": "8df66358-2d3c-48a3-b57a-25fcdbf9493d",
                                                "sense_id": "53d297cb-de4e-38da-b4e6-f8350b76f151",
                                                "text": "Le général, accoutumé par les événements de la guerre à des idées assez larges en fait de butin, accepta les présents offerts par sa fille."
                                            },
                                            {
                                                "example_id": "0e583f9e-535d-44de-8e5d-7e931942a320",
                                                "sense_id": "53d297cb-de4e-38da-b4e6-f8350b76f151",
                                                "text": "Huit jours après, on sut que nous étions à Moscou, la plus grande ville de Russie et la plus riche ; chacun se figurait le butin que nous allions avoir, et l’on pensait que cela ferait diminuer les contributions."
                                            },
                                            {
                                                "example_id": "b6113bf8-29d1-4e77-b065-58028355c257",
                                                "sense_id": "53d297cb-de4e-38da-b4e6-f8350b76f151",
                                                "text": "Et commence la cueillette du butin. N'ayant plus ni chaussettes, ni bottines, ni sac, les déguenillés remontent tranquillement leur garde-robe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb75dcfe-ab9f-3c74-888d-ec35e947f6a0",
                                        "entry_id": "5686d025-3190-3d3b-933c-c821e0f7e080",
                                        "glosses": [
                                            "Ce qu'un malfaiteur prend à ses victimes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbc772df-3c54-4657-b71d-42120a3e6548",
                                                "sense_id": "cb75dcfe-ab9f-3c74-888d-ec35e947f6a0",
                                                "text": "Au mois de juillet 1641, raconte Dom Grenier, la garnison de Péronne détacha une douzaine de cavaliers sur Allaines pour y faire des prisonniers et du butin. Ils pénétrèrent à l’improviste dans les basses-cours et s'emparèrent de tous les porcs qu'ils purent y rencontrer."
                                            },
                                            {
                                                "example_id": "4002c9cb-dfa8-486a-9332-303bad4803fa",
                                                "sense_id": "cb75dcfe-ab9f-3c74-888d-ec35e947f6a0",
                                                "text": "Nous nous regardons dans les yeux, férocement, ainsi que deux complices prêts à se déchirer et à s’entr’égorger sur leur butin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b3f83fa-67f8-385f-a8a9-b2c1ba4dac8c",
                                        "entry_id": "5686d025-3190-3d3b-933c-c821e0f7e080",
                                        "glosses": [
                                            "Ce qu’on obtient par de laborieuses recherches, récolte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be612ca2-3565-4e6a-a62a-43c37a177b30",
                                                "sense_id": "6b3f83fa-67f8-385f-a8a9-b2c1ba4dac8c",
                                                "text": "Le gouvernement fédéral a profité de la Deuxième Guerre mondiale pour s’accaparer tous les pouvoirs de taxation, d’où le fameux «redonnez-nous notre butin» que M. Duplessis lançait à chaque occasion."
                                            },
                                            {
                                                "example_id": "3cab3cfe-8f45-4084-aa6b-2d9271692899",
                                                "sense_id": "6b3f83fa-67f8-385f-a8a9-b2c1ba4dac8c",
                                                "text": "Il y a un riche butin à faire dans ces vieux manuscrits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b62dcc2-ee5c-3297-9444-b0d85266c381",
                                        "entry_id": "5686d025-3190-3d3b-933c-c821e0f7e080",
                                        "glosses": [
                                            "Ce qui est récolté par un insecte."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e7d944f-2f83-4dcc-85fe-ab0def8360d9",
                                                "sense_id": "7b62dcc2-ee5c-3297-9444-b0d85266c381",
                                                "text": "Le butin de l’abeille, de la fourmi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
