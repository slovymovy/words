                        "sense_id": "831409f1-b391-3c71-9186-e77090c77130",
                        "entry_id": "da45c265-21c7-3fe6-bbb6-b56575325eff",
                        "glosses": [
                            "Personne extrêmement riche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15320f06-4d95-4eab-ae76-3c7cd3adfe2c",
                                "sense_id": "831409f1-b391-3c71-9186-e77090c77130",
                                "text": "En 2019, les 1 % de super-riches étaient responsables de 16 % des émissions mondiales de carbone, soit l’équivalent des émissions des 66 % les plus pauvres."
                            },
                            {
                                "example_id": "2d90e802-852b-4277-aa8b-0e5d9693fc65",
                                "sense_id": "831409f1-b391-3c71-9186-e77090c77130",
                                "text": "Ils peuvent aussi illustrer l’accroissement des inégalités et montrer combien l’écart se creuse entre les super-riches et le reste de la population."
                            },
                            {
                                "example_id": "69495bc7-853b-4863-aba7-fbdee8af54d7",
                                "sense_id": "831409f1-b391-3c71-9186-e77090c77130",
                                "text": "Les super-riches, auront, alors, découvert d’autres horizons, qui maintiendront la distance entre eux et le reste de la planète."
                            }
                        ]
                    }
                ],
