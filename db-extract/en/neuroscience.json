                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                        "entry_id": "27d1a8e0-7229-37d1-bd5e-09e978e594f7",
                        "glosses": [
                            "The scientific study of the nervous system."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "03da633c-eb13-4401-b5fb-c7d3bf073114",
                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                "text": "Meronym: brain science"
                            },
                            {
                                "example_id": "476ac1df-5bc1-4db7-b70f-cb715f6f64b0",
                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                "text": "Near-synonym: neurobiology"
                            },
                            {
                                "example_id": "a3bde6b4-6dae-4532-a7c6-60c755de290b",
                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2696c81c-b030-4d43-a4aa-039d81daf2b9",
                        "source_entry_id": "27d1a8e0-7229-37d1-bd5e-09e978e594f7",
                        "source_sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
