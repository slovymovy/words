                    {
                        "sense_id": "d156af85-ed41-3d9f-9fce-3fd81517dda0",
                        "entry_id": "5e90b617-061d-3e29-a36b-6006ff34fe90",
                        "glosses": [
                            "An act in which a company downsizes or is downsized."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e69a1c41-867f-4062-abe4-9ca9d8943379",
                                "sense_id": "d156af85-ed41-3d9f-9fce-3fd81517dda0",
                                "text": "He lost his job in the last downsizing."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3f8b842-b332-32a7-a3b8-00e038400fd1",
                        "entry_id": "5e90b617-061d-3e29-a36b-6006ff34fe90",
