                    {
                        "translation_id": "d566270a-06d0-42e4-9ca9-4922c45cab37",
                        "source_entry_id": "9bfa2725-d915-3d01-9183-17b7b36046f6",
                        "source_sense_description": "governor",
                        "target_lang_word": "burchtgraaf",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "271d8e5c-a416-47c9-a74b-437b2cd1b70f",
                        "source_entry_id": "9bfa2725-d915-3d01-9183-17b7b36046f6",
                        "source_sense_description": "governor",
                        "target_lang_word": "burgrave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burgrave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                        "entry_id": "184cfa5b-e760-3d37-b5c2-381774105d60",
                                        "glosses": [
                                            "Au Moyen Âge, en Allemagne, commandant militaire d’une ville ou d’une place forte qui exerçait en outre sur les bourgeois le droit de juridiction."
                                        ],
                                        "tags": [
                                            "Middle-Ages"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b0e50b-0260-43f6-8758-91089e11a253",
                                                "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                                "text": "À Bingen, situé au confluent de la Nahe, commence le Rhin des burgs et des burgraves, la partie véritablement pittoresque du voyage."
                                            },
                                            {
                                                "example_id": "d546506a-20f2-44e4-bbbb-d38874479951",
                                                "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                                "text": "Mais nous n’en sommes pas là. Nous en sommes au règne des burgraves. Il y a lutte entre les chefs des trusts, — Stinnes contre Rathenau —, comme jadis entre les forbans titrés dont le Rhin reflète les châteaux en ruines. Au reste, de même que leurs devanciers, ces burgraves modernes rencontrent des rivaux en France, en Angleterre…"
                                            },
                                            {
                                                "example_id": "986a689a-668d-4b07-a626-651641d2deac",
                                                "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                                "text": "— J’ai, six mille nuits durant, valeureusement aimé la divine langue française : je puis tout dire en Français, j’y suis burgrave sans vasselage aucun, même aux lois !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2a6315d-3397-4fe2-906b-587b1b6d3e41",
                        "source_entry_id": "9bfa2725-d915-3d01-9183-17b7b36046f6",
                        "source_sense_description": "governor",
                        "target_lang_word": "Burggraf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Burggraf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b1b7232-37c5-3c09-a12b-bc916bf62dfb",
                                        "entry_id": "b4a98257-c707-3adf-a8fb-10a21095a30c",
                                        "glosses": [
                                            "Befehlshaber einer Burg aus dem niederen Adel mit administrativen und militärischen Rechten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd70d302-a353-407c-997c-2904421965d5",
                                                "sense_id": "8b1b7232-37c5-3c09-a12b-bc916bf62dfb",
                                                "text": "„Möglicherweise hat bereits König Konrad III. nach dem Tode des Wendenfürsten zur Wahrung der Rechte des Reiches einen Burggrafen eingesetzt.“"
                                            },
                                            {
                                                "example_id": "dcc6699b-2eb8-4feb-965b-dc959e8d5c51",
                                                "sense_id": "8b1b7232-37c5-3c09-a12b-bc916bf62dfb",
                                                "text": "„Er erhielt seinen Namen nach den Wildgehegen, die einer der Burggrafen vor Dürers Zeit im Stadtgraben unterhalten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
