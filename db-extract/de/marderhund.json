                                "example_id": "65aa1a66-a0d0-4d73-87f3-6b8403095987",
                                "sense_id": "c9ea4553-f9e1-390a-bb7d-52f95dc03af1",
                                "text": "„Mit Inkrafttreten des novellierten Landesjagdgesetzes (LJagdG) im Mai 2015 unterliegen Marderhunde weiterhin dem Landesjagdrecht.“"
                            }
                        ],
