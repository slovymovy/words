                "senses": [
                    {
                        "sense_id": "86208b27-919a-31cd-8c3f-f5104868a30c",
                        "entry_id": "6b17f4b5-a6c7-3cf1-b965-2e9f690f7839",
                        "glosses": [
                            "To give wood the color or texture of ebony."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "86a60024-1994-46f9-8b6b-86aa12a3604a",
                                "sense_id": "86208b27-919a-31cd-8c3f-f5104868a30c",
                                "text": "To ebonize, the table top is painted over several times with a strong solution of logwood, and when this is nearly dry the whole is brushed over with the iron vinegar..."
                            },
                            {
                                "example_id": "07e004ac-554a-41c9-b843-675660817a19",
                                "sense_id": "86208b27-919a-31cd-8c3f-f5104868a30c",
                                "text": "Kawrie Pine is a tougher wood, and ebonizes very well, but requires some strength to carve."
                            },
                            {
                                "example_id": "ab583980-1a96-4d16-af6c-805ae4de9018",
                                "sense_id": "86208b27-919a-31cd-8c3f-f5104868a30c",
                                "text": "Ebonized furniture is the DeLorean of the furniture world; few other styles speak so directly of their time and place."
                            },
                            {
                                "example_id": "523500fc-e7ce-4749-964d-6a15ec05c6da",
                                "sense_id": "86208b27-919a-31cd-8c3f-f5104868a30c",
                                "text": "Ebonize and finish the pulls to match the feet and trim strips."
                            },
                            {
                                "example_id": "79cf38e2-36f4-4e4e-ae2d-c6d055ca7ef3",
                                "sense_id": "86208b27-919a-31cd-8c3f-f5104868a30c",
                                "text": "The reason black dye works so well for ebonizing wood is that dye is transparent."
                            }
                        ]
                    }
