                                    {
                                        "sense_id": "b56f541a-694a-382d-9463-451129175ebf",
                                        "entry_id": "e795f420-944b-374b-a6a6-6291ecf2bc33",
                                        "glosses": [
                                            "samozřejmě"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b34042f7-fb73-41db-a819-37339248e071",
                                                "sense_id": "b56f541a-694a-382d-9463-451129175ebf",
                                                "text": "„To je blbost. Zbraně si necháme,“ řekl Benda. „Samo. Ať si každej sežene svý,“ řekl Procházka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2825d66-56aa-49bf-81f3-cbf0873ff0a4",
                        "source_entry_id": "7eded231-c1e5-3bb8-b1bf-51575327a8cd",
                        "source_sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                        "source_sense_description": "naturally",
                        "target_lang_word": "ben ouais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ben ouais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b36595a3-27bf-3f63-9197-924361624bd3",
                                        "entry_id": "9c448e24-d412-3b92-99a7-088291459baa",
                                        "glosses": [
                                            "Expression de dépit qu’on utilise quand on se retrouve forcé de faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64dfd40-dac2-442f-8155-c98a444c129e",
                                                "sense_id": "b36595a3-27bf-3f63-9197-924361624bd3",
                                                "text": "« Bon ! Tu vas la ranger, ta chambre ? » « Ben ouais, j’ai pas le choix ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e448e39b-62f1-3705-9a94-07750465609a",
                                        "entry_id": "9c448e24-d412-3b92-99a7-088291459baa",
                                        "glosses": [
                                            "Se dit en réponse à une proposition tentante ou évidente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b683b02-dcfb-4434-ab59-ed6c277d86ae",
                                                "sense_id": "e448e39b-62f1-3705-9a94-07750465609a",
                                                "text": "« Au fait, il y a la fête foraine, cette semaine ! » « Ben ouais, on n’a qu’à y aller ! »"
                                            },
                                            {
                                                "example_id": "af299104-0976-4780-8004-77cbae7fc143",
                                                "sense_id": "e448e39b-62f1-3705-9a94-07750465609a",
                                                "text": "« On va boire des coups ce soir ? » « Ben ouais! »"
                                            },
                                            {
                                                "example_id": "c9748bbc-e584-4a22-b536-2ec488f625b7",
                                                "sense_id": "e448e39b-62f1-3705-9a94-07750465609a",
                                                "text": "« Mais alors l'oncologie c'est l'étude du cancer ? » « Ben ouais, paie-toi un cerveau ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "721bd6ee-627b-3844-aef7-e442255285d9",
                                        "entry_id": "9c448e24-d412-3b92-99a7-088291459baa",
                                        "glosses": [
                                            "Expression qu’on utilise pour approuver ou avouer quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ece6158-e9c6-496a-9560-a29b0663cc33",
                                                "sense_id": "721bd6ee-627b-3844-aef7-e442255285d9",
                                                "text": "« Tu te rends compte que, tout ça, c’est de ta faute ? » « Ben... ouais, je sais. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5c832f4-879f-44e0-981c-2781acf69e95",
                        "source_entry_id": "7eded231-c1e5-3bb8-b1bf-51575327a8cd",
                        "source_sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                        "source_sense_description": "naturally",
                        "target_lang_word": "na klar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "869b34a3-4a13-471f-b4a6-5d5e0d5e69d7",
                        "source_entry_id": "7eded231-c1e5-3bb8-b1bf-51575327a8cd",
                        "source_sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                        "source_sense_description": "naturally",
                        "target_lang_word": "есте́ственно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "есте́ственно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bc02a878-6c7b-3a3a-b0f9-5ac032df0a36",
                                        "entry_id": "746c261b-2584-386d-a783-aadcd85823b3",
                                        "glosses": [
                                            "наречие к естественный; нормально, обычно"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c406eb8a-c061-4faa-a9d5-2dbc9c07aebf",
                                                "sense_id": "bc02a878-6c7b-3a3a-b0f9-5ac032df0a36",
                                                "text": "Следовательно, вполне естественно, что для продления жизни необходимо избежать заражения сифилисом."
                                            },
                                            {
                                                "example_id": "6f0502eb-175e-4d66-9bc5-2c153e938e86",
                                                "sense_id": "bc02a878-6c7b-3a3a-b0f9-5ac032df0a36",
                                                "text": "Вы скажете, что тут культурные влияния, что старая жизнь естественно должна была уступить место новой."
                                            },
                                            {
                                                "example_id": "0f1ec815-daca-4a42-b627-98179c46a6d4",
                                                "sense_id": "bc02a878-6c7b-3a3a-b0f9-5ac032df0a36",
                                                "text": "Поймите, разве естественно, чтоб человек сам себе зложелательствовал!"
                                            },
                                            {
                                                "example_id": "482a1ce0-f80f-442d-b201-161c2c49360e",
                                                "sense_id": "bc02a878-6c7b-3a3a-b0f9-5ac032df0a36",
                                                "text": "Пьеру, казалось, так естественно быть добрым со всеми, что не было никакой заслуги в его доброте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb4bb0b-d49b-3280-88c6-98a1d0c65357",
                                        "entry_id": "746c261b-2584-386d-a783-aadcd85823b3",
                                        "glosses": [
                                            "непринуждённо"
                                        ],
                                        "tags": [
                                            "наречие"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b9bfcc4-f6f8-46d4-8216-7571b29e0c85",
                                                "sense_id": "beb4bb0b-d49b-3280-88c6-98a1d0c65357",
                                                "text": "Она говорила очень просто и естественно, но слишком много и слишком скоро."
                                            },
                                            {
                                                "example_id": "91ed67d9-d071-420a-a151-5332e990cbe2",
                                                "sense_id": "beb4bb0b-d49b-3280-88c6-98a1d0c65357",
                                                "text": "Слова́ э́ти бы́ли ска́заны так есте́ственно, по-дома́шнему жа́лобно, что мы снача́ла не по́няли, что э́то и есть пе́рвые стро́ки но́вой поэ́мы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9aa197-4721-343f-a686-4eb80dfa082e",
                                        "entry_id": "746c261b-2584-386d-a783-aadcd85823b3",
                                        "glosses": [
                                            "разумеется, по вполне понятным причинам"
                                        ],
                                        "tags": [
                                            "вводн. слово"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c45936ea-8458-46e2-8929-257a740b4c7c",
                                                "sense_id": "5e9aa197-4721-343f-a686-4eb80dfa082e",
                                                "text": "В соседстве телеги ему, естественно, показалось благонадёжнее, но, обогнав её, он тотчас же опять забыл обо всём и опять погрузился в свои обрывки мыслей и представлений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdbe0ab5-5d80-3f47-a7f8-2109776d26c3",
                                        "entry_id": "746c261b-2584-386d-a783-aadcd85823b3",
                                        "glosses": [
                                            "оценка какой-либо ситуации, чьих-либо действий как представляющихся обычными, нормальными, обусловленными общим ходом вещей"
                                        ],
                                        "tags": [
                                            "предикатив"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5937ee6-5491-4c66-b1cf-fddf2585c622",
                                                "sense_id": "cdbe0ab5-5d80-3f47-a7f8-2109776d26c3",
                                                "text": "Это такие пустяки. И так естественно. Мальчик никогда не видал меня."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9dd06d9-d6a7-38c6-9998-3033227027b3",
                                        "entry_id": "746c261b-2584-386d-a783-aadcd85823b3",
                                        "glosses": [
                                            "само собой разумеется, конечно"
                                        ],
                                        "tags": [
                                            "межд."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "164bbec0-f8a6-45a6-b5d6-bea13e33f3fa",
                                                "sense_id": "e9dd06d9-d6a7-38c6-9998-3033227027b3",
                                                "text": "— А ты что, выводить его будешь? — обратился он к Румате. — Естественно, — сказал Румата. — Он мой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
