                    "sense_definition": "De manière certaine et indubitable ; sans aucun doute.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "certitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as <w>sûrement</w> raison à propos de cette situation délicate.",
                            "target_lang_translations": {
                                "en": "You are <w>certainly</w> right about this delicate situation.",
                                "ru": "Ты <w>наверняка</w> прав насчёт этой непростой ситуации.",
                                "nl": "Je hebt <w>zeker</w> gelijk over deze lastige situatie.",
                                "de": "Du hast bei dieser heiklen Situation <w>sicher</w> recht.",
                                "pl": "Masz <w>na pewno</w> rację w sprawie tej delikatnej sytuacji.",
                                "it": "Hai <w>sicuramente</w> ragione riguardo a questa situazione delicata.",
                                "cs": "Ty máš <w>určitě</w> pravdu ohledně této citlivé situace.",
                                "tr": "Bu hassas durumla ilgili <w>kesinlikle</w> haklısın.",
                                "es": "<w>Seguramente</w> tienes razón sobre esta situación delicada.",
                                "zh": "关于这种棘手的情况，你<w>肯定</w>是对的。"
                            }
                        },
                        {
                            "text": "Il viendra <w>sûrement</w> nous voir pendant le week-end prochain.",
                            "target_lang_translations": {
                                "en": "He will <w>certainly</w> come to see us next weekend.",
                                "ru": "Он <w>наверняка</w> зайдёт к нам в следующие выходные.",
                                "nl": "Hij komt ons volgend weekend <w>zeker</w> opzoeken.",
                                "de": "Er kommt uns am nächsten Wochenende <w>sicher</w> besuchen.",
                                "pl": "<w>Na pewno</w> wpadnie do nas w przyszły weekend.",
                                "it": "Verrà <w>sicuramente</w> a trovarci il prossimo fine settimana.",
                                "cs": "Příští víkend nás <w>určitě</w> navštíví.",
                                "tr": "Önümüzdeki hafta sonu bize <w>kesinlikle</w> uğrayacak.",
                                "es": "Nos visitará <w>seguramente</w> el próximo fin de semana.",
                                "zh": "下个周末他<w>一定</w>会来看我们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certainement",
                        "assurément"
                    ],
                    "target_lang_definitions": {
                        "en": "In a certain and unquestionable way; without any doubt.",
                        "ru": "Обозначает полную уверенность в том, что что-то истинно, без всяких сомнений.",
                        "nl": "Zonder enige twijfel, op een stellige en onmiskenbare manier.",
                        "de": "Ohne jeden Zweifel und mit völliger Gewissheit. Man drückt damit aus, dass etwas als sicher wahr gilt.",
                        "pl": "Bez żadnych wątpliwości, w sposób pewny i niepodważalny.",
                        "it": "In modo certo e indiscutibile, senza alcun dubbio.",
                        "cs": "Zcela určitě a bez jakékoli pochybnosti.",
                        "tr": "Hiç şüphe bırakmayacak biçimde, kesin ve açık olarak; şüphesiz.",
                        "es": "Con total certeza y sin ninguna duda. Se usa para afirmar algo de manera rotunda.",
                        "zh": "表示某事确定无疑，没有任何怀疑。"
