                    {
                        "sense_id": "253e7070-50ef-3d68-87c3-2ffc3b8297d3",
                        "entry_id": "92ab16ae-c5d9-3b6c-a2aa-f86be22d86c1",
                        "glosses": [
                            "Fahrzeugmotor, dessen Teile aus Aluminium bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f7dea9-93f8-4556-8018-e6df81f55aef",
                                "sense_id": "253e7070-50ef-3d68-87c3-2ffc3b8297d3",
                                "text": "„Weiter ist festzustellen, daß der Motor von der Lieferfirma als Aluminiummotor hergestellt wurde.“"
                            },
                            {
                                "example_id": "27b94cf3-26b1-4a71-b8dc-f6d475127bc3",
                                "sense_id": "253e7070-50ef-3d68-87c3-2ffc3b8297d3",
                                "text": "„Erst im Laufe der 90er Jahre setzte sich der Aluminiummotor auf diesem Marktsegment auch in der Bundesrepublik durch.“"
                            },
                            {
                                "example_id": "707ce114-37b3-4fe9-9c28-c5d1c1807de8",
                                "sense_id": "253e7070-50ef-3d68-87c3-2ffc3b8297d3",
                                "text": "„Handelt es sich um einen Aluminiummotor, lässt man die Kühlflüssigkeit dagegen ab, weil diese das Leichtmetall während der Standzeit angreifen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
