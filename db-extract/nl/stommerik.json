                        "glosses": [
                            "iemand die ergerlijk stom doet"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b176bb41-0274-415a-96d1-502eeb7b5eed",
                                "sense_id": "a836fd99-e562-3a4b-b7e8-cd084f04869d",
                                "text": "Ik ben zelf een stommerik geweest."
