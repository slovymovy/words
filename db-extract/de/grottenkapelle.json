                ],
                "senses": [
                    {
                        "sense_id": "333d4b0d-cd26-32a6-9a7b-8b843b907d1a",
                        "entry_id": "23afd7df-b3c2-3564-9934-9c79ee77e0ee",
                        "glosses": [
                            "vorhandene Grotte, die als Kapelle gestaltet und genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d795504-b67d-4d9a-8863-feeaad4eb28f",
                                "sense_id": "333d4b0d-cd26-32a6-9a7b-8b843b907d1a",
                                "text": "„1680 gelobten die umliegenden Bewohner die Errichtung einer Grottenkapelle, wenn sie unversehrt bleiben würden; auf dieses Versprechen geht die Anlage in der Grotte zurück.“"
                            },
                            {
                                "example_id": "2b80c1e3-3912-40aa-9a48-096b2cb0f290",
                                "sense_id": "333d4b0d-cd26-32a6-9a7b-8b843b907d1a",
                                "text": "„Die Grottenkapelle des Klosters ist prachtvoll mit kostbaren Fresken verziert.“"
                            },
                            {
                                "example_id": "58d5dcca-297c-4f87-9756-95372f1dc510",
                                "sense_id": "333d4b0d-cd26-32a6-9a7b-8b843b907d1a",
                                "text": "„Vorbei an einer alten Grottenkapelle lädt die abwechslungsreiche Strecke immer wieder zu herrlichen Ausblicken ein.“"
                            },
                            {
                                "example_id": "eabd0c06-e98a-4dde-b09e-f5a9f5e450ca",
                                "sense_id": "333d4b0d-cd26-32a6-9a7b-8b843b907d1a",
                                "text": "„Links eine schöne mit Fresken bemalte Grottenkapelle.“"
                            },
                            {
                                "example_id": "55b21ca5-bdb8-4bf1-ac56-bd03d34de349",
                                "sense_id": "333d4b0d-cd26-32a6-9a7b-8b843b907d1a",
                                "text": "„Doch dann werden wir der typischen Atmosphäre der Grottenkapelle gewahr, in der sich die urtümliche Kraft des Felsens und die feine spirituelle Schwingung des uralten Heiligtums verbinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
