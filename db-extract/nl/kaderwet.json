                        "sense_id": "65ea22e3-4f7e-37d7-8e42-d540bd9c9106",
                        "entry_id": "ade0f4c2-3104-3dae-95ee-23eded51c877",
                        "glosses": [
                            "een wet die de algemene principes, verantwoordelijkheden en procedures regelt, maar geen gedetailleerde regels bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbefa2fe-bd6a-4d41-8341-316d26859649",
                                "sense_id": "65ea22e3-4f7e-37d7-8e42-d540bd9c9106",
                                "text": "Onder het toezicht van de kaderwet vallen bijvoorbeeld de Kiesraad, keuringsinstellingen, Sociale Verzekeringsbank, OPTA, rijksmusea en universiteiten. Die ontvingen in 2010 in totaal 47 miljard van het Rijk en incasseerden daarnaast nog eens voor 85,6 miljard euro aan premies en tarieven."
                            },
                            {
                                "example_id": "5674fccc-916c-45a5-8fd5-41b5ede01dcc",
                                "sense_id": "65ea22e3-4f7e-37d7-8e42-d540bd9c9106",
                                "text": "Op basis van bestaand beleid zou Achilles 100 procent kostendekkende huur betalen voor het kunstgras. \"In een extra algemene ledenvergadering hebben de leden hier unaniem mee ingestemd”, stelt het college. \"Deze kostendekkende overeenkomst vervalt echter op het moment dat het college de nieuwe Kaderwet Sport en Bewegen vaststelt. Dan gaat Achilles waarschijnlijk veertig procent kostendekkende huur betalen.” De bewuste nota ligt nu ter inspraak."
                            }
                        ]
                    }
