                "senses": [
                    {
                        "sense_id": "a67ece88-a5a8-3851-adf2-fcb9c1a14ab1",
                        "entry_id": "e1bec09b-fc07-3037-9190-a2f8f49aca80",
                        "glosses": [
                            "anderer optionaler Weg beziehungsweise Strecke; auch übertragen: festgelegter, bestimmter Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e130fe7-21ab-4b54-b87a-7c8a67b2c00d",
                                "sense_id": "a67ece88-a5a8-3851-adf2-fcb9c1a14ab1",
                                "text": "„Inzwischen wird in unseren Nachbarländern darüber diskutiert, eine Alternativroute durch Belgien und Frankreich zu wählen – statt auf die deutschen Nachzügler zu warten.“"
                            },
                            {
                                "example_id": "51042991-2472-41a5-ab96-9e3f56853249",
                                "sense_id": "a67ece88-a5a8-3851-adf2-fcb9c1a14ab1",
                                "text": "„Auf der Alternativroute von Australien über den Indischen Ozean und südlich um Afrika zurück nach Europa würde das Schiff unter anderem Ziele auf den Malediven, auf den Seychellen, auf Madagaskar, in Südafrika, Namibia, Senegal und Marokko anlaufen.“"
                            },
                            {
                                "example_id": "c542320c-b6dd-47d8-b2fa-1c19b7824d56",
                                "sense_id": "a67ece88-a5a8-3851-adf2-fcb9c1a14ab1",
                                "text": "„Erst wenn es die Verkehrsbedingungen zuliessen, werde die A13 wieder als Alternativroute zur A2 am Gotthard empfohlen.“"
                            },
                            {
                                "example_id": "5baceac6-610e-4bff-94b4-65426eb1eb14",
                                "sense_id": "a67ece88-a5a8-3851-adf2-fcb9c1a14ab1",
                                "text": "„Die vorgeschlagene günstigere Alternativroute verläuft auf rund 150 km von Mainz-Bischofsheim nach Köln-Gremberg.“"
                            },
                            {
                                "example_id": "0b6718a9-a6cc-47ef-b68e-ca858b1e0782",
                                "sense_id": "a67ece88-a5a8-3851-adf2-fcb9c1a14ab1",
                                "text": "„Die Alternativroute von A über B nach D hat durch ihre Länge von 5,3 km bei erlaubten 50 km/h ohne Warteschlangen eine über 5 Minuten längere Fahrtzeit als die direkte Route über C.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
