                                        "entry_id": "58d87ff8-5ca8-3a6e-88a4-0f24b7b97705",
                                        "glosses": [
                                            "groß angelegte Veräußerung zur Räumung eines Warenlagers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d18c49f-4853-41a0-9da6-da55317e757a",
                                                "sense_id": "d418a324-e793-3899-a3ce-6fed60b78659",
                                                "text": "„Noch in dieser Woche soll der große Ausverkauf starten, heißt es seitens der Insolvenzverwaltung.“"
                                            },
                                            {
                                                "example_id": "5e64ac7e-b179-4eb0-8a38-d6948838cbd2",
                                                "sense_id": "d418a324-e793-3899-a3ce-6fed60b78659",
                                                "text": "übertragen: „Angeführt von Heinrich Prinz von Hannover, dem Onkel der Auktionsinitiatoren Ernst-August und Christian, beklagten Museumsdirektoren aus ganz Deutschland den Ausverkauf von Landeskultur.“"
                                            }
