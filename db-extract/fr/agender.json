                "senses": [
                    {
                        "sense_id": "efd25595-5d96-38ef-8a9b-0a87d281b450",
                        "entry_id": "a7dadbf6-483a-366c-863b-16ebc6bc4925",
                        "glosses": [
                            "Écrire dans un agenda, fixer un rendez-vous."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "3547f922-db8f-45c3-9622-f3e813984524",
                                "sense_id": "efd25595-5d96-38ef-8a9b-0a87d281b450",
                                "text": "Voici les prochains rendez-vous à bien agender pour ne pas les oublier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f530f162-1697-3090-94dd-71fc606e05ee",
                        "entry_id": "a7dadbf6-483a-366c-863b-16ebc6bc4925",
                        "glosses": [
                            "Mettre à l’ordre du jour."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "eed94583-d559-43a6-8c48-94e8112f42a6",
                                "sense_id": "f530f162-1697-3090-94dd-71fc606e05ee",
                                "text": "Les sujets importants à négocier lors de la prochaine réunion seront à agender par la secrétaire et à envoyer à toute l’équipe."
                            },
                            {
                                "example_id": "42d98110-20f7-4890-879d-c305abf2ce23",
                                "sense_id": "f530f162-1697-3090-94dd-71fc606e05ee",
                                "text": "Surtout si, comme on nous en avertit déjà, lʼexpérience devait se répéter à la faveur dʼune «deuxième vague» déjà agendée pour lʼautomne par certaines institutions dotées de voyance virologique."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e75f626-effe-37b2-ba43-bfd359d37fd6",
                        "entry_id": "a7dadbf6-483a-366c-863b-16ebc6bc4925",
                        "glosses": [
                            "Sauvegarder automatiquement des données par un logiciel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c9d4fd-011c-4335-b130-4de672e8b521",
                                "sense_id": "9e75f626-effe-37b2-ba43-bfd359d37fd6",
                                "text": "Chaque acte de gestion est agendé en automatique par le logiciel. Les dossiers sont donc révisés quotidiennement."
                            }
                        ]
                    }
                ],
