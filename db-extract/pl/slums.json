                                        "examples": [
                                            {
                                                "example_id": "3cdd0125-ea40-46b8-8f87-0147a769849d",
                                                "sense_id": "02207db2-4276-3555-89e7-4ee04c02f903",
                                                "text": "L’impact […] s’inscrit dans la géographie des villes, des quartiers et des bidonvilles où les migrants tendent à se regrouper par ethnies, il s’inscrit aussi au niveau régional, accentuant les déséquilibres entre régions dynamiques et en crise."
                                            },
                                            {
                                                "example_id": "070571fa-2a9d-47eb-b578-2505e98186d4",
                                                "sense_id": "02207db2-4276-3555-89e7-4ee04c02f903",
                                                "text": "Les images de forêts luxuriantes, de montagnes enneigées et de réserves naturelles masquent celles des natures urbaines, des bidonvilles et des plantations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e8071ed-f01c-444a-8ff3-372f0ba252dc",
                        "source_entry_id": "f8f29152-1856-35dc-b6f5-750df93cc934",
                        "source_sense_id": "62e44d76-71b1-3485-99e5-4e2e8645c5dc",
                        "target_lang_word": "Slum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                        "entry_id": "983d84f9-a568-3949-87ea-ea374a4b8b74",
                                        "glosses": [
                                            "verwahrloster Stadtbezirk (vor allem in einer Großstadt), der von armen Menschen bewohnt wird und durch heruntergekommene Bausubstanz und schlecht ausgestattete Infrastruktur gekennzeichnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb9000b-4fb8-40fa-bc85-7fe3b4ea4623",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "Die Wasserversorgung in den indischen Slums ist katastrophal."
                                            },
                                            {
                                                "example_id": "106d9610-4abc-48e2-aba9-12b25500dd22",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„Johanna Sarre, die fließend Kisuaheli spricht, hat zwei Monate im Slum gewohnt und Feldforschung direkt vor Ort betrieben.“"
                                            },
                                            {
                                                "example_id": "3873f4a7-1d74-4677-a9b1-c9d22414730f",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„Sie war vor allem in den Slums von Luanda zu einer Massenbewegung geworden.“"
                                            },
                                            {
                                                "example_id": "d3ae41ea-e9ee-4a25-8558-363371431f23",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„Für die Tollkühnsten unter uns wurde ein Ausflug in die umliegenden Slums organisiert.“"
                                            },
                                            {
                                                "example_id": "3b940feb-392b-4440-bf95-2ba7e642d5fc",
                                                "sense_id": "7ab9a729-40fd-3e16-b137-c16a4f11b00d",
                                                "text": "„In der ersten Woche bereits besuchten sie die Slums von Isale Eko.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a7eb4da-5966-4802-ad4e-c36deaaebeda",
                        "source_entry_id": "f8f29152-1856-35dc-b6f5-750df93cc934",
                        "source_sense_id": "62e44d76-71b1-3485-99e5-4e2e8645c5dc",
                        "target_lang_word": "трущоба",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "трущоба",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "489644b8-9a1d-3c2a-94d7-670184c6c210",
                                        "entry_id": "fc1c9335-3e54-3e21-9ada-6b7b7cc9de5f",
                                        "glosses": [
                                            "устар. труднопроходимое место, например чаща леса, глубокий заросший овраг и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c83f826-12b7-449d-b873-baeab0708d8f",
                                                "sense_id": "489644b8-9a1d-3c2a-94d7-670184c6c210",
                                                "text": "По озеру плавали дикие лебеди, по лесным трущобам скитались хитрые росомахи, с шумом взлетали тяжёлые глухари, свистели и перепархивали рябчики."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920ef236-65ce-36a0-9f6a-5563d9ac3830",
                                        "entry_id": "fc1c9335-3e54-3e21-9ada-6b7b7cc9de5f",
                                        "glosses": [
                                            "устар. отдалённое место, глушь, захолустье"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cda5dcc-453b-4041-955f-1372d680d00e",
                                                "sense_id": "920ef236-65ce-36a0-9f6a-5563d9ac3830",
                                                "text": "Но осенью степь имеет много прелести, и теперь, после моих петербургских и московских терзаний, я был так счастлив очутиться в настоящей деревенской трущобе, что мирюсь с неприглядностью местоположения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e521b4a3-facb-3b2b-ad5f-20b664d5a4ec",
                                        "entry_id": "fc1c9335-3e54-3e21-9ada-6b7b7cc9de5f",
                                        "glosses": [
                                            "неблагоустроенная, бедная, грязная, обычно тесно застроенная часть города"
                                        ],
                                        "tags": [
                                            "often",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d62562-f0c7-4d8d-b20b-9e25c9830032",
                                                "sense_id": "e521b4a3-facb-3b2b-ad5f-20b664d5a4ec",
                                                "text": "Видно, что девушки поступают на рынок разврата очень рано и очень быстро сходят с него в трущобы, где их ждет голод и смерть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce15de4-6eb2-3efd-885b-c059db32836f",
                                        "entry_id": "fc1c9335-3e54-3e21-9ada-6b7b7cc9de5f",
                                        "glosses": [
                                            "разг. бедный, грязный, неудобный для жилья дом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87e946d6-3b7c-4ffa-aa66-248e318970af",
                                                "sense_id": "1ce15de4-6eb2-3efd-885b-c059db32836f",
                                                "text": "А утром Вакс говорил по телефону в коридоре ― он требовал у Союза писателей материалов и средств, чтобы отремонтировать свою трущобу, которую мы считали крепостью или раем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
