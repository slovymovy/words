                "entry_id": "5cd1e937-cde4-3ce1-aaa4-efa9f79c770d",
                "word": "désépépiner",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                        "entry_id": "5cd1e937-cde4-3ce1-aaa4-efa9f79c770d",
                        "glosses": [
                            "Enlever les pépins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7c84c38-ac2e-48ff-a21b-2d9a877b8860",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Retirer les graines de la grenade dans l'eau est le moyen le plus simple de désépépiner vos fruits car les graines sont plus lourdes que la membrane qui entoure les graines."
                            },
                            {
                                "example_id": "a3d1a047-57d8-42b3-a32a-935823331fcc",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Apprenez à couper une grenade et à la désépépiner, sans gâchis ni graines gaspillées!"
                            },
                            {
                                "example_id": "92dcd59b-d9d8-4617-8d04-0421cec1839d",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Il existe différentes manières de désépépiner une grenade, mais la méthode la plus simple consiste à les couper en quartiers et à les plonger dans un grand bol d'eau."
                            },
                            {
                                "example_id": "d2c90f32-976e-41cf-9665-404f9fad0faa",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "La purée de pastèque pour bébés nécessite des morceaux de fruits coupés et désépépinés, qui sont ensuite mélangés à l'aide d'un mélangeur pour en faire une purée."
                            },
                            {
                                "example_id": "7f5739fb-8a74-4e58-9e72-ee70f39f19c4",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Une tasse d'une contenance de 130 ml contenant des tomates désépépinées et coupées en dés;"
                            },
                            {
                                "example_id": "aa6cc9b0-616f-4f3a-b10f-9f053f8327fb",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Retirez les piments de l'eau, éraflez-les et désépépinez-les."
                            },
                            {
                                "example_id": "f3dd1289-911f-484c-a0f3-352bd92c786f",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Désépépinez-le. Écrasez soigneusement la chair pendant quelques minutes jusqu'à ce que vous obteniez une purée lisse."
                            },
                            {
                                "example_id": "cafd9444-7ab0-44c8-bcbf-350667315168",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Cela va certainement être trop chaud, même si je désépépine et coupe l'intérieur."
                            },
                            {
                                "example_id": "4d849e07-d319-4171-a0c5-a9e185bb99f9",
                                "sense_id": "aeaf13ea-153e-34ec-80aa-99c700f09a3d",
                                "text": "Lorsque les tomates sont utilisées comme légume dans un plat qui a besoin de plus d'eau, je désépépine souvent mes tomates."
                            }
                        ]
                    }
