{
    "word_family": [
        "avenger",
        "vengeance",
        "vengeful"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4443733-a922-34fc-bd2d-c7b921491028",
                    "sense_definition": "To inflict harm in return for an injury or wrong suffered by oneself or another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "retribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero swore to <w>avenge</w> his family after the tragic attack.",
                            "target_lang_translations": {
                                "ru": "Герой поклялся <w>отомстить за</w> свою семью после трагического нападения."
                            }
                        },
                        {
                            "text": "She wanted to <w>avenge</w> the injustice done to her community.",
                            "target_lang_translations": {
                                "ru": "Она хотела <w>отомстить за</w> несправедливость, совершённую по отношению к её общине."
                            }
                        }
                    ],
                    "synonyms": [
                        "retaliate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинить вред или наказать в ответ на обиду, зло или ущерб, нанесённый себе или другому лицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отомстить",
                                "target_lang_sense_clarification": "совершить акт возмездия за обиду, преступление или несправедливость"
                            },
                            {
                                "target_lang_word": "мстить",
                                "target_lang_sense_clarification": "совершать действия мести за кого-либо или что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5eaa118b-11b3-30f5-929a-ba5590d6a65e",
                    "sense_definition": "To take revenge on behalf of oneself.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>avenge</w> himself against those who had betrayed his trust.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>отомстить</w> тем, кто предал его доверие."
                            }
                        },
                        {
                            "text": "The knight sought to <w>avenge</w> himself upon the king who exiled him.",
                            "target_lang_translations": {
                                "ru": "Рыцарь стремился <w>отомстить</w> королю, который изгнал его."
                            }
                        }
                    ],
                    "synonyms": [
                        "take revenge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отомстить за себя, рассчитаться с обидчиком за нанесённый лично ущерб или оскорбление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отомстить",
                                "target_lang_sense_clarification": "поквитаться с обидчиком за себя"
                            },
                            {
                                "target_lang_word": "рассчитаться",
                                "target_lang_sense_clarification": "свести счёты с обидчиком"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d39121d9-68ac-38bf-828c-894942b35d70",
                    "sense_definition": "An act of vengeance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "retribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brutal <w>avenge</w> left the village in ruins.",
                            "target_lang_translations": {
                                "ru": "Жестокая <w>месть</w> оставила деревню в руинах."
                            }
                        },
                        {
                            "text": "His final <w>avenge</w> was swift and merciless.",
                            "target_lang_translations": {
                                "ru": "Его окончательное <w>возмездие</w> было стремительным и беспощадным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun usage is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт возмездия или мести (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "месть",
                                "target_lang_sense_clarification": "действие в отплату за причинённое зло"
                            },
                            {
                                "target_lang_word": "возмездие",
                                "target_lang_sense_clarification": "карающая месть, кара"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}