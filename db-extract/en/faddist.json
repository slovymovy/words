                        "entry_id": "45471a8f-5a5d-3cb2-9c7e-392bdc3fbf79",
                        "glosses": [
                            "A person or entity given to following fads."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "694101d7-6a10-442d-be42-874cd161e258",
                                "sense_id": "76ff037c-2e51-385a-8f28-8f80444b3d0c",
                                "text": "He is such a fashion faddist."
                            },
                            {
                                "example_id": "9d1fda3f-21a1-4756-9972-87e2e7650ddb",
                                "sense_id": "76ff037c-2e51-385a-8f28-8f80444b3d0c",
                                "text": "The faddist magazines have been hyping that lately."
                            },
                            {
                                "example_id": "22b04c59-2bb7-44d6-9050-475491fdb202",
                                "sense_id": "76ff037c-2e51-385a-8f28-8f80444b3d0c",
                                "text": "In speaking thus somewhat emphatically I would not wish to be classed as a faddist on the question of sanatorial treatment because personally I am of the opinion that sanatorial institutes are not the permanencies that many would have them be in the treatment of pulmonary tuberculosis […]"
                            }
                        ]
                    }
