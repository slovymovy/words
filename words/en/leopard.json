{
    "word_family": [
        "leopardess"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "babb0b0c-2826-3048-9b8f-e673641b9270",
                    "sense_definition": "A large wild cat with a spotted coat native to Africa and Asia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wild_cat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>leopard</w> is a powerful hunter that often drags its prey up into trees.",
                            "target_lang_translations": {
                                "zh": "<w>豹</w>是一种强有力的猎手，经常把猎物拖到树上。"
                            }
                        },
                        {
                            "text": "We saw a <w>leopard</w> resting in the shade during our safari trip.",
                            "target_lang_translations": {
                                "zh": "在游猎旅行中，我们看到一只<w>豹</w>正在阴凉处休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "common leopard"
                    ],
                    "common_phrases": [
                        "spotted leopard"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种产于非洲和亚洲、皮毛上有斑点的猫科大型野生动物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "豹",
                                "target_lang_sense_clarification": "指豹属动物，通常指花豹。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1159ab5-4783-3c97-a070-c57609883e55",
                    "sense_definition": "A large wild cat native to Asia with a clouded coat pattern.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wild_cat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elusive <w>clouded</w> <w>leopard</w> is rarely seen in the wild.",
                            "target_lang_translations": {
                                "zh": "行踪隐秘的<w>云豹</w>在野外很难见到。"
                            }
                        },
                        {
                            "text": "Conservationists are working to protect the habitat of the <w>clouded</w> <w>leopard</w>.",
                            "target_lang_translations": {
                                "zh": "自然保护主义者正致力于保护<w>云豹</w>的栖息地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clouded leopard"
                    ],
                    "common_phrases": [
                        "clouded leopard"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种产于亚洲、皮毛上有云状斑纹的猫科大型野生动物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "云豹",
                                "target_lang_sense_clarification": "特指云豹属的猫科动物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd86d558-ab5d-3744-92ba-d2ad8f7fd833",
                    "sense_definition": "A large wild cat native to the mountain ranges of Central Asia.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wild_cat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fur of the <w>snow</w> <w>leopard</w> keeps it warm in freezing temperatures.",
                            "target_lang_translations": {
                                "zh": "<w>雪豹</w>厚实的皮毛使它在严寒中保持温暖。"
                            }
                        },
                        {
                            "text": "It is very difficult to spot a <w>snow</w> <w>leopard</w> against the rocky mountain landscape.",
                            "target_lang_translations": {
                                "zh": "在岩石嶙峋的山地背景下，很难发现<w>雪豹</w>的踪迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snow leopard"
                    ],
                    "common_phrases": [
                        "snow leopard"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种产于中亚山区的猫科大型野生动物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "雪豹",
                                "target_lang_sense_clarification": "生活在高海拔地区的猫科动物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4917305-6bdd-3397-9c99-f4379228d9cf",
                    "sense_definition": "A type of butterfly with black markings on an orange base.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>leopard</w> butterfly is commonly found in open fields and gardens.",
                            "target_lang_translations": {
                                "zh": "<w>豹纹蝶</w>常见于开阔的田野和花园中。"
                            }
                        },
                        {
                            "text": "Its wings have a distinct pattern that gives the <w>leopard</w> butterfly its name.",
                            "target_lang_translations": {
                                "zh": "它的翅膀上有独特的斑纹，这也是<w>豹纹蝶</w>得名的原因。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种翅膀上有橙色底色和黑色斑点的蝴蝶。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "豹纹蝶",
                                "target_lang_sense_clarification": "指蛱蝶科中具有豹纹特征的蝴蝶。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f902436e-9cca-35c8-a9e6-aab268a23952",
                    "sense_definition": "A lion depicted in a specific walking pose in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms features a golden <w>leopard</w> on a red background.",
                            "target_lang_translations": {
                                "zh": "该纹章的特色是在红色背景上绘有一只金色的<w>豹形狮</w>。"
                            }
                        },
                        {
                            "text": "In medieval heraldry, the <w>leopard</w> was often used to represent courage.",
                            "target_lang_translations": {
                                "zh": "在中世纪纹章学中，<w>豹形狮</w>常被用来象征勇气。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in the context of heraldry."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "纹章学中指代一种特定行走姿态的狮子图案。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "豹形狮",
                                "target_lang_sense_clarification": "纹章学中指侧身行走、头向侧面的狮子。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "437c1d5b-df71-3def-a488-ceb20f46638d",
                    "sense_definition": "A family name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named Mr. <w>Leopard</w>.",
                            "target_lang_translations": {
                                "zh": "这本书的作者名叫<w>利奥帕德</w>先生。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Leopard</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "zh": "昨天我在会议上遇到了一位名叫莎拉·<w>利奥帕德</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "利奥帕德",
                                "target_lang_sense_clarification": "作为外文姓氏的音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}