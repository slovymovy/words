                    "sense_id": "189a7fe0-e87b-37b8-bee7-9049e4cc2fed",
                    "sense_definition": "Qui réunit toutes les perfections souhaitables ou qui convient parfaitement à une situation donnée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite maison de campagne est le lieu <w>idéal</w> pour se reposer le week-end. Les enfants adorent le grand jardin. Les vacances y sont calmes."
                        },
                        {
                            "text": "Nous avons enfin trouvé une solution <w>idéale</w> pour régler ce conflit de voisinage sans devoir aller au tribunal."
                        }
                    ],
                    "synonyms": [
                        "parfait",
                        "optimal",
                        "impeccable"
                    ],
                    "antonyms": [
                        "inadéquat",
                        "imparfait"
                    ],
                    "common_phrases": [
                        "solution idéale",
                        "moment idéal",
                        "cadre idéal",
                        "partenaire idéal"
                    ]
                },
                {
                    "sense_id": "60046eb5-1261-37a0-a227-609b0b694956",
                    "sense_definition": "Qui n'existe que dans l'esprit ou l'imagination, par opposition à ce qui est réel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète imagine un univers <w>idéal</w> détaché des contraintes et des souffrances de la réalité terrestre."
                        },
                        {
                            "text": "Ce modèle théorique repose sur une concurrence <w>idéale</w> qui ne se vérifie jamais tout à fait dans le monde économique."
                        }
                    ],
                    "synonyms": [
                        "théorique",
                        "abstrait",
                        "imaginaire"
                    ],
                    "antonyms": [
                        "réel",
                        "concret",
                        "matériel"
                    ],
                    "common_phrases": [
                        "monde idéal",
                        "existence idéale"
                    ]
                }
            ]
        },
        {
