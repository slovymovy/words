                        ],
                        "form": "explosietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98bd278a-76e8-3929-9154-f23fe2a7f0cb",
                        "entry_id": "5dc9cb16-106f-365d-a661-eb51efb099db",
                        "glosses": [
                            "het barsten van een onder druk staande gastank, of een heftige chemische reactie waarbij plotseling zeer grote gasdruk ontstaat. Altijd met een knal, en vaak met vuurverschijnselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46164ade-ef53-424e-8ada-e5d79bedd61d",
                                "sense_id": "98bd278a-76e8-3929-9154-f23fe2a7f0cb",
                                "text": "Een explosie is niet denkbeeldig als je de band nog verder oppompt."
                            },
                            {
                                "example_id": "81df51f4-1fd2-4c69-b385-81101257c771",
                                "sense_id": "98bd278a-76e8-3929-9154-f23fe2a7f0cb",
                                "text": "Als er niet zo veel herrie was geweest, had hij kunnen nadenken over wat hem dwarszat, maar de krijsende fluittonen volgden elkaar op, onderbroken door explosies die je van hoofd tot voeten door elkaar schudden."
                            }
                        ]
                    },
                    {
                        "sense_id": "c03e8c41-2985-35c1-9c76-bc1907f8f1ee",
                        "entry_id": "5dc9cb16-106f-365d-a661-eb51efb099db",
                        "glosses": [
                            "plotselinge uitbarsting van drift en woede"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "127573da-5635-42bf-8fc4-70ba3eb232a2",
                                "sense_id": "c03e8c41-2985-35c1-9c76-bc1907f8f1ee",
                                "text": "'Je zou bij me moeten willen zijn! Je zou ' Een gedempte explosie aan de andere kant van de vallei snoerde hun beiden de mond."
                            },
                            {
                                "example_id": "91f127e4-d838-4355-a377-d6b1d65f0852",
                                "sense_id": "c03e8c41-2985-35c1-9c76-bc1907f8f1ee",
                                "text": "Alle gesprekken op dat gebied waren als een mijnenveld waarbij de kleinste onvoorzichtige opmerking een explosie van onbehaaglijkheid kon veroorzaken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "356325a0-a45f-4af3-a8a9-cecbcdded714",
                        "source_entry_id": "5dc9cb16-106f-365d-a661-eb51efb099db",
                        "target_lang_word": "Explosion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Explosion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "057bfbcc-7834-3d07-9910-0fcafff86ba1",
                                        "entry_id": "4a80bc72-2bb8-3cd3-89fc-5b0b90167dcb",
                                        "glosses": [
                                            "plötzliche, mit lautem Knall verbundene Volumenausdehnung auf Grund von chemischen oder kernphysikalischen Reaktionen bei gleichzeitigem Temperatur- und Druckanstieg, die zur Beschädigung oder Zerstörung der Umgebung führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77194a5-19e7-443e-9950-110aad33c5cf",
                                                "sense_id": "057bfbcc-7834-3d07-9910-0fcafff86ba1",
                                                "text": "In Texas-City, 56 Kilometer südöstlich von Houston, sind mindestens 14 Menschen bei einer Explosion in der drittgrößten Ölraffinerie der Vereinigten Staaten ums Leben gekommen. Die Explosion riss ein tiefes Loch in die Erde, in direkter Umgebung wurden Bürogebäude zerstört, Autos explodierten und Flammen schossen mehr als siebzig Meter in die Höhe."
                                            },
                                            {
                                                "example_id": "f29f003e-37d2-4b0f-8f04-69f2400d9630",
                                                "sense_id": "057bfbcc-7834-3d07-9910-0fcafff86ba1",
                                                "text": "In der Nacht zum Dienstag entgleiste nach einer Explosion ein Personenzug mit mehr als 200 Insassen auf der Strecke von Moskau nach St. Petersburg."
                                            },
                                            {
                                                "example_id": "028a9586-89fc-4c21-ae7d-7a9803f54987",
                                                "sense_id": "057bfbcc-7834-3d07-9910-0fcafff86ba1",
                                                "text": "Mit seiner Annahme, die Plutoniumabfälle hätten eine kritische Masse gebildet und eine atomare Explosion erzeugt, lag er allerdings tatsächlich falsch."
                                            },
                                            {
                                                "example_id": "8d8c20c5-cf3d-4799-ba9d-dacd324723e3",
                                                "sense_id": "057bfbcc-7834-3d07-9910-0fcafff86ba1",
                                                "text": "„Er sprengte sich selbst und den Apoll in die Luft durch eine Panzerfaust, die er irrtümlich zur Explosion brachte.“"
                                            },
                                            {
                                                "example_id": "0926a532-339d-4d08-8f37-17e97394c815",
                                                "sense_id": "057bfbcc-7834-3d07-9910-0fcafff86ba1",
                                                "text": "„Am 16. Juli fand in New Mexiko der sogenannte Trinity-Test statt. Es war die erste Explosion einer Atombombe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ceba70d-d578-342e-b363-c4a84cf04f21",
                                        "entry_id": "4a80bc72-2bb8-3cd3-89fc-5b0b90167dcb",
                                        "glosses": [
                                            "plötzlicher Zuwachs einer Sache; plötzlicher Anstieg der Artenvielfalt, Bevölkerung oder Kosten; enorme Steigerung sportlicher Leistung"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "general",
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a805b4-cdb5-47f9-a128-169abd67314d",
                                                "sense_id": "5ceba70d-d578-342e-b363-c4a84cf04f21",
                                                "text": "Wir plündern die Schöpfung, weil eine maßlos gewordene Spezies ihre Grenzen sprengt: die Südhemisphäre durch Explosion der Bevölkerung, die Nordhemisphäre durch Explosion der Ansprüche."
                                            },
                                            {
                                                "example_id": "d96c8595-3822-4b06-b536-1735608a7f1b",
                                                "sense_id": "5ceba70d-d578-342e-b363-c4a84cf04f21",
                                                "text": "\"Von einer Explosion der Kosten im Gesundheitswesen kann keine Rede sein.\""
                                            },
                                            {
                                                "example_id": "59a82a07-9cfc-4f2f-92e9-7d7da773308f",
                                                "sense_id": "5ceba70d-d578-342e-b363-c4a84cf04f21",
                                                "text": "Klinsis Elf ist beseelt von Leidenschaft, sie strotzt vor Kraft und Neugierde, weil sie eigene Grenzen nicht kennt. Dies alles führt zu einer sportlichen Explosion, da wird hemmungslos und unbeschwert gestürmt, mitunter auch glücklich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9bd6e8f9-f05a-3a7f-8601-eda00d5022f7",
                                        "entry_id": "4a80bc72-2bb8-3cd3-89fc-5b0b90167dcb",
                                        "glosses": [
                                            "Ausbruch von Gefühlen, Wutausbruch, Zornausbruch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b83dd2e-7e93-4eab-a134-a339bfe5af7b",
                                                "sense_id": "9bd6e8f9-f05a-3a7f-8601-eda00d5022f7",
                                                "text": "In anderen Ländern hätte eine Situation, wie sie gegenwärtig in Rußland herrscht, längst zu einer großen sozialen Explosion geführt."
                                            },
                                            {
                                                "example_id": "16065e0b-bb31-45dc-9626-7e5811ec59c9",
                                                "sense_id": "9bd6e8f9-f05a-3a7f-8601-eda00d5022f7",
                                                "text": "Denn, als sie bemerkte, für solche Götzenbilder sei in einem evangelischen Hause kein Platz, rollte Henry die Augen mit so entschlossenem Grimme, daß sie eine Explosion befürchtete und aufseufzend schwieg."
                                            },
                                            {
                                                "example_id": "f29dc81a-e7a5-4f3b-9242-b1c37dce8029",
                                                "sense_id": "9bd6e8f9-f05a-3a7f-8601-eda00d5022f7",
                                                "text": "Vielleicht hatte sich dies alles zu einer einzigen Explosion angesammelt, aber der unmittelbare Anlaß zu dieser Explosion war die Kost."
                                            },
                                            {
                                                "example_id": "9436bbcc-9789-4d71-b537-960ec108b953",
                                                "sense_id": "9bd6e8f9-f05a-3a7f-8601-eda00d5022f7",
                                                "text": "„Nach dieser Explosion erwähnte der Fürst die Angelegenheit mit keinem Worte wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39973688-6454-461e-930a-adeff9f59a12",
                        "source_entry_id": "5dc9cb16-106f-365d-a661-eb51efb099db",
                        "target_lang_word": "explosion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explosion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ecbbf5a-c8ad-329c-bdfb-3537a3a20b65",
                                        "entry_id": "dfe4a21d-c195-3ea0-b822-cc265b7d5a3b",
                                        "glosses": [
                                            "A violent release of energy (sometimes mechanical, nuclear, or chemical); an act or instance of exploding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73458996-aaeb-4f36-b426-6de971f931c8",
                                                "sense_id": "4ecbbf5a-c8ad-329c-bdfb-3537a3a20b65",
                                                "text": "A man was injured by an explosion caused by drilling into a missed shot at the Mendota mine above Silver Plume, Colo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a836c11-9f1f-3c4f-bec3-924646e4636c",
                                        "entry_id": "dfe4a21d-c195-3ea0-b822-cc265b7d5a3b",
                                        "glosses": [
                                            "The sound of an explosion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cbacf7c-ca5f-3e24-9bc5-0270e36854c3",
                                        "entry_id": "dfe4a21d-c195-3ea0-b822-cc265b7d5a3b",
                                        "glosses": [
                                            "A sudden, uncontrolled or rapid increase, expansion, or bursting out."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a41ec8-751d-4a73-b97f-a11114c7a341",
                                                "sense_id": "6cbacf7c-ca5f-3e24-9bc5-0270e36854c3",
                                                "text": "As with the Lejeuneaceae, this pattern of massive speciation appears to be correlated with the Cretaceous explosion of the angiosperms and the simultaneous creation of a host of new microenvironments, differing in humidity, light intensity, texture, etc."
                                            },
                                            {
                                                "example_id": "fbbf9aae-fc57-4e5d-84a7-7ffdab48220a",
                                                "sense_id": "6cbacf7c-ca5f-3e24-9bc5-0270e36854c3",
                                                "text": "Her image is supposedly rebellious, but she looks scrubbed and healthy, with an explosion of blonde hair and generous curves shoved into too-tight clothing."
                                            },
                                            {
                                                "example_id": "92e510df-bcf1-4c66-b6a2-c0fc7d9a2d48",
                                                "sense_id": "6cbacf7c-ca5f-3e24-9bc5-0270e36854c3",
                                                "text": "All this has led to an explosion of protest across China, including among a middle class that has discovered nimbyism. That worries the government, which fears that environmental activism could become the foundation for more general political opposition. It is therefore dealing with pollution in two ways—suppression and mitigation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9becc880-91b5-454c-94ac-880d8d76aa92",
                        "source_entry_id": "5dc9cb16-106f-365d-a661-eb51efb099db",
                        "target_lang_word": "explosion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explosion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c72af48-bd78-39e3-8a9b-5075ff31152f",
                                        "entry_id": "54dd99d7-d3b3-3461-b454-e4f9edc8879f",
                                        "glosses": [
                                            "État, bruit, mouvement subit et impétueux que produisent les poudres, les mélanges de salpêtre et de soufre, certains mélanges de gaz, etc., lorsqu’ils s’enflamment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb89679-2f34-4884-b4f7-2dc4a307183f",
                                                "sense_id": "5c72af48-bd78-39e3-8a9b-5075ff31152f",
                                                "text": "Lorsqu'on veut se figurer la cosmogenèse, c'est une aventure étrange, assez récente, pareille en somme à ce que serait une explosion hiroshimesque aperçue au ralenti : à partir d'un moment improbable, une avalanche de nébuleuses ignées, qui fuient."
                                            },
                                            {
                                                "example_id": "2170de08-4598-4587-bd76-f929ea627763",
                                                "sense_id": "5c72af48-bd78-39e3-8a9b-5075ff31152f",
                                                "text": "L’explosion d’une mine, d’un magasin à poudre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20593d63-4e3c-3eaf-aca8-3516c4cd8e00",
                                        "entry_id": "54dd99d7-d3b3-3461-b454-e4f9edc8879f",
                                        "glosses": [
                                            "Action d’éclater, produite par l’excès de tension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9c7f659-41e6-44ad-b352-a1245d616b13",
                                                "sense_id": "20593d63-4e3c-3eaf-aca8-3516c4cd8e00",
                                                "text": "L’explosion d’une machine à vapeur, d’un moteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27f1170e-5081-3e68-92b0-07a47a8e9c7b",
                                        "entry_id": "54dd99d7-d3b3-3461-b454-e4f9edc8879f",
                                        "glosses": [
                                            "Se dit en parlant des passions violentes qui viennent à éclater."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6455ea-3411-40e0-9865-0018e1483ada",
                                                "sense_id": "27f1170e-5081-3e68-92b0-07a47a8e9c7b",
                                                "text": "L’explosion de la haine, de la colère."
                                            },
                                            {
                                                "example_id": "4948b0e7-9706-4782-86f9-ada32558aa05",
                                                "sense_id": "27f1170e-5081-3e68-92b0-07a47a8e9c7b",
                                                "text": "L’explosion d’un complot."
                                            },
                                            {
                                                "example_id": "6e14d792-dda0-4c20-ba37-4dc6c7b9e2ec",
                                                "sense_id": "27f1170e-5081-3e68-92b0-07a47a8e9c7b",
                                                "text": "Il y eut contre lui une explosion de murmures, d’invectives, etc."
                                            },
                                            {
                                                "example_id": "37b29348-06a2-43c5-bf93-3b83ae777d09",
                                                "sense_id": "27f1170e-5081-3e68-92b0-07a47a8e9c7b",
                                                "text": "Ce jugement a été accueilli par une explosion de joie par la trentaine de manifestants réunis devant l'Old Bailey, qui se sont mis à crier et à s'étreindre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3126a1f-7c48-303f-891d-de6715208314",
                                        "entry_id": "54dd99d7-d3b3-3461-b454-e4f9edc8879f",
                                        "glosses": [
                                            "Accroissement très rapide, spectaculaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4fdb12-4f47-4878-888b-8b8e893d7cc0",
                                                "sense_id": "d3126a1f-7c48-303f-891d-de6715208314",
                                                "text": "L’explosion des accès Internet à haut débit."
                                            },
                                            {
                                                "example_id": "24711ad4-a7e6-4eb2-8a5b-cad9ec09992b",
                                                "sense_id": "d3126a1f-7c48-303f-891d-de6715208314",
                                                "text": "Alors que l’année n’est pas encore terminée, les premiers chiffres pour 2000 annoncent une explosion des fraudes par cartes bancaires."
                                            },
                                            {
                                                "example_id": "104ab00f-be1c-4d10-be95-b2dd3a40b0d0",
                                                "sense_id": "d3126a1f-7c48-303f-891d-de6715208314",
                                                "text": "[L]e développement du vocabulaire chez l’enfant entre 1 et 3 ans connaît deux phases distinctes : une première étape d’acquisition lente (2 à 3 mots nouveaux … par semaine …), précédant une période d’acquisition rapide (5 à 10 mots nouveaux par semaine), appelée couramment explosion lexicale."
                                            },
                                            {
                                                "example_id": "e28d86d2-0c54-493b-b1e8-8fc546674116",
                                                "sense_id": "d3126a1f-7c48-303f-891d-de6715208314",
                                                "text": "L’explosion cambrienne a duré seulement 5 à 10 millions d’années, c’est-à-dire un clin d’œil en terme géologique (comparez cette période aux 1,4 milliard d’années nécessaires à l’évolution des procaryotes en eucaryotes)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bda2f42-dafc-48a8-9aed-8b00955dccee",
                        "source_entry_id": "5dc9cb16-106f-365d-a661-eb51efb099db",
                        "target_lang_word": "explosión",
