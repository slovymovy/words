                "senses": [
                    {
                        "sense_id": "c75362d2-2b21-34c0-98fe-b086c473d03f",
                        "entry_id": "4957d06c-f38e-3061-902e-02e8a9290140",
                        "glosses": [
                            "Suche nach Informationen im Internet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e374a3e0-3b27-45c0-941a-52e35d37a35e",
                                "sense_id": "c75362d2-2b21-34c0-98fe-b086c473d03f",
                                "text": "„Während seiner zwei Flüge von Beirut nach Nizza recherchierte Russ im Internet, wer seine Zielperson genau war. Lebensgeschichte, Freunde und Bekannte, derzeitige Lebensumstände, alles, was eine Internetsuche an allgemein Zugänglichem ergab.“"
                            },
                            {
                                "example_id": "70a2e5dc-f414-4df5-afc9-37d0da00af33",
                                "sense_id": "c75362d2-2b21-34c0-98fe-b086c473d03f",
                                "text": "„Eine schnelle Internetsuche ergab, dass Devereux, der Gouverneur und der Vorsitzende Richter des kalifornischen Obersten Gerichtshofs häufig gemeinsam Golf spielten.“"
                            },
                            {
                                "example_id": "8dfb2490-1716-4647-96f5-43e5488c99c5",
                                "sense_id": "c75362d2-2b21-34c0-98fe-b086c473d03f",
                                "text": "„Ich blickte von der Internetsuche auf, die ich gerade durchführte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
