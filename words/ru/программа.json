                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Школьная <w>программа</w> по математике стала намного сложнее.",
                            "target_lang_translations": {
                                "en": "The school math <w>curriculum</w> has become much more difficult.",
                                "zh": "学校的数学<w>课程</w>变得难多了。"
                            }
                        },
                        {
                            "text": "Этот вопрос не входит в <w>программу</w> экзамена.",
                            "target_lang_translations": {
                                "en": "This question is not included in the exam <w>syllabus</w>.",
                                "zh": "这个问题不在考试的<w>大纲</w>范围内。"
                            }
                        }
