                        "entry_id": "68cee5c1-cf1b-315a-a26c-b013fa340657",
                        "glosses": [
                            "Modifier une région de chromosome d'un organisme afin d'inactiver un ou plusieurs gènes cibles qui s'y trouvent."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
