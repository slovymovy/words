                "translations": [
                    {
                        "translation_id": "1267e7b1-332e-4a28-9808-dc0238462682",
                        "source_entry_id": "a35bc97c-7a80-3fc8-aece-72f2b25cf062",
                        "source_sense_id": "61a26868-8c04-3202-be83-1ba48018d37e",
                        "target_lang_word": "Lydia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lydia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74720b48-8e05-39fc-a54a-8654f36c1f5a",
                                        "entry_id": "d6056570-dee9-3b16-b19f-fd9fee136055",
                                        "glosses": [
                                            "A historical region and ancient kingdom in western Asia Minor, in modern-day Turkey."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a4adf08-90cb-3e26-b1dd-0fd554f87157",
                                        "entry_id": "d6056570-dee9-3b16-b19f-fd9fee136055",
                                        "glosses": [
                                            "A woman converted by St. Paul; presumably named for ancestry or residence in Lydia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21172c4f-3785-46aa-a02e-9c238eda7f30",
                                                "sense_id": "2a4adf08-90cb-3e26-b1dd-0fd554f87157",
                                                "text": "And a certain woman named Lydia, a seller of purple, of the city of Thyatira, which worshipped God, heard us: whose heart the Lord opened, that she attended unto the things which were spoken of Paul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1ff1031-09c4-3af1-af45-b09ed78abb77",
                                        "entry_id": "d6056570-dee9-3b16-b19f-fd9fee136055",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83846844-e50d-47bf-ad3b-6e601d74cd2a",
                                                "sense_id": "c1ff1031-09c4-3af1-af45-b09ed78abb77",
                                                "text": "Lydia was a stout, well-grown girl of fifteen, with a fine complexion and good-humoured countenance; a favourite with her mother, whose affection had brought her into public at an early age."
                                            },
                                            {
                                                "example_id": "7bd0aba9-83ee-4f09-840c-65b62e656f9f",
                                                "sense_id": "c1ff1031-09c4-3af1-af45-b09ed78abb77",
                                                "text": "The first three, Macklin, Lydia, and Randall, were the special ones. Even those names, we thought, showed greater imagination, greater involvement on our parents' part, than ours did: Nina, Mary, Sarah."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
