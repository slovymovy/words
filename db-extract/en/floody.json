                        "glosses": [
                            "Pertaining to or characteristic of a flood or flooding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78e16c4-340f-4799-ba00-f99f3d9456fe",
                                "sense_id": "105952ad-ea39-364a-b923-5ab116afd39a",
                                "text": "The adjoining figure represents an under-shot wheel in floody water, or when the river is high, and the water up to its shaft."
                            },
                            {
                                "example_id": "42c5d7a4-aff5-4d91-a47d-d8eb788b14bb",
                                "sense_id": "105952ad-ea39-364a-b923-5ab116afd39a",
                                "text": "We strolled along floody beaches in gloaming twilights; […]"
                            },
                            {
                                "example_id": "13fa0ce6-28b0-4714-9e29-2113c96a59c2",
                                "sense_id": "105952ad-ea39-364a-b923-5ab116afd39a",
                                "text": "The water twirled and tossed him while the rain came down and the Hundred Acre Wood got floodier and floodier. But the water couldn't come up to Christopher Robin's house on high ground. And that's where everyone was gathering."
                            },
                            {
                                "example_id": "844a716e-7b61-4849-8b5c-83e28815b958",
                                "sense_id": "105952ad-ea39-364a-b923-5ab116afd39a",
                                "text": "The floody abyss was extremely deep—\nHow did he fill it in?"
                            }
                        ]
                    }
                ],
