                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33fb16c-55a0-40e5-b359-5b912c8bb038",
                                "sense_id": "22f70cc1-8427-3b99-9df6-f02de97825a9",
                                "text": "„In Orenburg warteten drei kirgisische Sultane, die mit großem Gefolge angereist waren, um den Mann zu treffen, der alles wußte.“"
                            }
