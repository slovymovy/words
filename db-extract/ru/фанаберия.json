                        ]
                    },
                    {
                        "translation_id": "b5d84b96-e2be-401b-9798-2d76d0319042",
                        "source_entry_id": "d4e2724a-2935-3652-916d-d4c3910726fb",
                        "source_sense_id": "ecd60d22-07e3-36d9-bf2e-2cc46859fe92",
