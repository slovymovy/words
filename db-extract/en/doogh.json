                        "glosses": [
                            "A savory Persian yogurt drink with a mint flavor."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e54b16ac-8fd2-4aad-9698-4054cc9c9c14",
                                "sense_id": "85cce89c-2f84-3b79-94e7-ac56b7f36433",
                                "text": "For a counterpoint to its molar-tingling sweetness, you might try a glass of doogh, the Persian yogurt drink, bracingly tart with a high note of dill."
                            }
                        ]
                    }
                ],
                "translations": [
