                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de65c4f4-cd2c-4f6f-9613-3d881260dc22",
                        "source_entry_id": "aa6d8ca4-a609-3891-b15c-e807b9032b68",
                        "source_sense_id": "0c56e618-d34b-3028-8b14-a02288c4658f",
                        "source_sense_description": "ein von der allgemeinen Gesellschaft ausgestoßener Mann, der sich nicht an die Gesetze hält",
                        "target_lang_word": "outlaw",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outlaw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b03e997-5035-3920-a213-7203dfb854a5",
                                        "entry_id": "51bb91bf-c433-3d34-98c4-14fc70248bca",
                                        "glosses": [
                                            "A fugitive from the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96683495-a33e-451d-a25c-20e5d65e46f5",
                                                "sense_id": "0b03e997-5035-3920-a213-7203dfb854a5",
                                                "text": "“I am going to a certain tower, one of three that were built in my grandsire’s time to guard Lantern Waste against certain perilous outlaws who dwelled there in his day. […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c3d19e-17d8-3041-8719-e14fe70ab242",
                                        "entry_id": "51bb91bf-c433-3d34-98c4-14fc70248bca",
                                        "glosses": [
                                            "A criminal who is excluded from normal legal rights; one who can be killed at will without legal penalty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6beb269b-a251-350f-8134-f269c4cc0d1c",
                                        "entry_id": "51bb91bf-c433-3d34-98c4-14fc70248bca",
                                        "glosses": [
                                            "A person who operates outside established norms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eaf65ae-bf74-4e84-b5f2-d820d72b8ac5",
                                                "sense_id": "6beb269b-a251-350f-8134-f269c4cc0d1c",
                                                "text": "The main character in the play was a bit of an outlaw who refused to shake hands or say thank you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aacd2c5-fb79-3c11-8e26-deda5cbc6358",
                                        "entry_id": "51bb91bf-c433-3d34-98c4-14fc70248bca",
                                        "glosses": [
                                            "A wild or violent animal, such as a horse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08f908a4-9c06-386a-8188-e9273c7a1308",
                                        "entry_id": "51bb91bf-c433-3d34-98c4-14fc70248bca",
                                        "glosses": [
                                            "An in-law: a relative by marriage."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f07a50b1-2368-344d-bbc9-e2f2751d86d6",
                                        "entry_id": "51bb91bf-c433-3d34-98c4-14fc70248bca",
                                        "glosses": [
                                            "One who would be an in-law except that the marriage-like relationship is unofficial."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "068a54c8-446c-31ff-b106-c24e231c1f63",
                                        "entry_id": "51bb91bf-c433-3d34-98c4-14fc70248bca",
                                        "glosses": [
                                            "A prostitute who works alone, without a pimp."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6d4c34-e980-46c5-a64a-d1a95cac2e52",
                                                "sense_id": "068a54c8-446c-31ff-b106-c24e231c1f63",
                                                "text": "Without a pimp, she was an \"outlaw,\" likely to be harassed, or threatened with assault or robbery on the street."
                                            },
                                            {
                                                "example_id": "bedcd8b0-8fd5-41d7-80e6-24f1544f4466",
                                                "sense_id": "068a54c8-446c-31ff-b106-c24e231c1f63",
                                                "text": "She was an outlaw. Chance is doing some double-checking to see if she had a pimp nobody knew about, but it doesn't look likely."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outlaw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c8b537e-043c-3dc2-b8f7-fc7aadfb9695",
                                        "entry_id": "65ec10e2-60ce-3f58-bc87-77269adbc09e",
                                        "glosses": [
                                            "To declare illegal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6dcf207-eef6-34a3-a3da-bd1c50622afb",
                                        "entry_id": "65ec10e2-60ce-3f58-bc87-77269adbc09e",
                                        "glosses": [
                                            "To place a ban upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1f420e2-7c81-4e15-b9fb-9dd849cb0adc",
                                                "sense_id": "d6dcf207-eef6-34a3-a3da-bd1c50622afb",
                                                "text": "The legal change in England and Wales will outlaw selling, manufacturing, renting or importing zombie knives."
                                            },
                                            {
                                                "example_id": "4653a9eb-3635-46a7-8668-c961573b588b",
                                                "sense_id": "d6dcf207-eef6-34a3-a3da-bd1c50622afb",
                                                "text": "And outlawing these AR-15s would not require confiscating them from people who already have them. Once you’ve made these weapons illegal, anyone found with one would be subject to arrest, since possession of these weapons would be a crime. I think it’s likely that you would see a lot of people opting to turn them in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bae9335-26bd-307b-90ab-3e241ca99dc4",
                                        "entry_id": "65ec10e2-60ce-3f58-bc87-77269adbc09e",
                                        "glosses": [
                                            "To make or declare (a person) an outlaw."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46b7bc7c-5b92-414c-8980-4bd8a92c3c36",
                                                "sense_id": "1bae9335-26bd-307b-90ab-3e241ca99dc4",
                                                "text": "Eirik and his people were outlawed at Thorsnes Thing."
                                            },
                                            {
                                                "example_id": "a33e3e4b-6b86-42f3-b017-8554ecee1522",
                                                "sense_id": "1bae9335-26bd-307b-90ab-3e241ca99dc4",
                                                "text": "AB has now gone beyond her original stance against gays as teachers and is now advocating a federal law to outlaw gays, a law which would override state law in the 19 states which have consenting adults sex laws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce34cccf-e574-3322-89c8-3f01926e5676",
                                        "entry_id": "65ec10e2-60ce-3f58-bc87-77269adbc09e",
                                        "glosses": [
                                            "To remove from legal jurisdiction or enforcement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d083b9-2c67-4a16-9fb0-cc9f36990e60",
                                                "sense_id": "ce34cccf-e574-3322-89c8-3f01926e5676",
                                                "text": "to outlaw a debt or claim"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2fe8733-dc39-3716-ae33-81adbecd9321",
                                        "entry_id": "65ec10e2-60ce-3f58-bc87-77269adbc09e",
                                        "glosses": [
                                            "To deprive of legal force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0e5699-d1cc-4446-a2b1-e916a2a47156",
                                                "sense_id": "e2fe8733-dc39-3716-ae33-81adbecd9321",
                                                "text": "our English common law was outlawed in those parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
