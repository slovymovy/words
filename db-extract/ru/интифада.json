                ],
                "senses": [
                    {
                        "sense_id": "aae46380-1b9e-3fb7-b43e-84dd7ab7943c",
                        "entry_id": "9a7fdd2d-49e3-3826-8831-5ba784427902",
                        "glosses": [
                            "война палестинцев с Израилем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1326505a-07e9-4940-88db-0ef173040376",
                                "sense_id": "aae46380-1b9e-3fb7-b43e-84dd7ab7943c",
                                "text": "Началась интифада («отряхивание», «выступление» в переводе с арабского), получившая название «война камней»."
                            },
                            {
                                "example_id": "7bd49a0c-11cf-4024-9816-af75783d0b67",
                                "sense_id": "aae46380-1b9e-3fb7-b43e-84dd7ab7943c",
                                "text": "Переговоры, проходившие в Кемп-Дэвиде и Табе в 2000–2001 годах, закончились не подписанием мирного соглашения, а новым витком террора и насилия, который палестинская администрация именует «интифадой Аль-Акса»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b929d22-7f9b-4d0d-93df-9e756fa2dafe",
                        "source_entry_id": "9a7fdd2d-49e3-3826-8831-5ba784427902",
                        "source_sense_id": "aae46380-1b9e-3fb7-b43e-84dd7ab7943c",
                        "target_lang_word": "intifada",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intifada",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34fbe08b-a318-3311-9484-bfd354fa26bb",
                                        "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                                        "glosses": [
                                            "An insurrection; a usually violent attempt to take control of a government."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b2bbcde-a0fc-3f04-a7bf-9cd29e0bdccd",
                                        "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                                        "glosses": [
                                            "An uprising, resistant struggle, or rebellious protest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7230e8de-4547-35f6-ac17-f2d004464383",
                                        "entry_id": "c8ca7987-4eb1-31ae-b363-5ac7a3b7cbec",
                                        "glosses": [
                                            "An uprising, resistant struggle, or rebellious protest.",
                                            "The Palestinian uprisings against Israel."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f320e2-a8a6-4a8b-b2b4-378a998d10e4",
                                                "sense_id": "7230e8de-4547-35f6-ac17-f2d004464383",
                                                "text": "Indeed, violence broke out in the occupied territories in mid-May 2000 as Palestinians observed the anniversary of the 1948 nakba—these disturbances paled in comparison to the second intifada, which erupted in the autumn."
                                            },
                                            {
                                                "example_id": "99e455cf-7fb7-40ff-ad05-47db1535925e",
                                                "sense_id": "7230e8de-4547-35f6-ac17-f2d004464383",
                                                "text": "But unlike the Intifadas that began in 1987 and 2000, when Israel had someone to call to try to turn it off, there is no Palestinian on the other end of the phone this time […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
