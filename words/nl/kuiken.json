{
    "word_family": [
        "kuikentje"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0609ede-0618-3cd9-b903-67bc4186e245",
                    "sense_definition": "Een jong hoen of meer algemeen een donzig jong vogeltje dat net uit het ei is gekomen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lente zie je vaak een <w>kuiken</w> achter de moederkip aanlopen in de wei.",
                            "target_lang_translations": {
                                "en": "In the spring, you often see a <w>chick</w> walking behind the mother hen in the meadow."
                            }
                        },
                        {
                            "text": "Het kleine <w>kuiken</w> uit het ei kruipen was een prachtig gezicht voor de kinderen.",
                            "target_lang_translations": {
                                "en": "Watching the little <w>chick</w> crawl out of the egg was a beautiful sight for the children."
                            }
                        }
                    ],
                    "synonyms": [
                        "pullus"
                    ],
                    "common_phrases": [
                        "pasgeboren kuiken",
                        "donzig kuiken"
                    ],
                    "target_lang_definitions": {
                        "en": "A young fowl or more generally a downy young bird that has just hatched from the egg."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chick",
                                "target_lang_sense_clarification": "a young bird or chicken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f59c91b8-633a-3a12-a642-f95a46ab6e85",
                    "sense_definition": "Een persoon die als licht onnozel, naïef of dom wordt beschouwd.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geloof je dat echt? Je bent ook een onnozel <w>kuiken</w> als je dat denkt.",
                            "target_lang_translations": {
                                "en": "Do you really believe that? You are such a naive <w>person</w> if you think that."
                            }
                        },
                        {
                            "text": "Hij gedroeg zich als een <w>kuiken</w> door zonder na te denken in die val te trappen.",
                            "target_lang_translations": {
                                "en": "He acted like a <w>fool</w> by falling into that trap without thinking."
                            }
                        }
                    ],
                    "common_phrases": [
                        "onnozel kuiken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "gebruikt om iemand op een informele manier als dom aan te duiden"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is considered slightly silly, naive, or foolish."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "naive person",
                                "target_lang_sense_clarification": "someone easily fooled"
                            },
                            {
                                "target_lang_word": "silly person",
                                "target_lang_sense_clarification": "someone acting foolishly"
                            },
                            {
                                "target_lang_word": "greenhorn",
                                "target_lang_sense_clarification": "an inexperienced or naive person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}