                ],
                "senses": [
                    {
                        "sense_id": "fc4c3b8e-64da-35e1-a6fe-bea7936f2e82",
                        "entry_id": "fbc0a2db-efdc-3afc-bb96-8c33e7b75d1f",
                        "glosses": [
                            "Untersuchungsverfahren, bei dem nach Ansammlung von Speichel die Speichelbestandteile, wie Bakterien zur Diagnose des Kariesrisikos oder die enthaltenen Hormone für eine Hormonersatztherapie oder Drogen zur Feststellung des Zeitpunkts des Drogenkonsums bestimmt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ec9f03-3646-4d29-977c-fe1395de8ee9",
                                "sense_id": "fc4c3b8e-64da-35e1-a6fe-bea7936f2e82",
                                "text": "Bei einem bakteriellen Speicheltest wird ein Träger mit einem speziellen Nährboden beidseitig mit dem Speichel befeuchtet, in ein spezielles Kulturgefäß gesteckt und 2 bis 4 Tage lang im Brutschrank bei 37 °C bebrütet."
                            },
                            {
                                "example_id": "0ccd9966-081e-4201-b1d2-0b948ec67557",
                                "sense_id": "fc4c3b8e-64da-35e1-a6fe-bea7936f2e82",
                                "text": "Beim Speicheltest, der inzwischen meistverbreiteten Testform des Drogenwischtests, wird die Zunge beprobt."
                            },
                            {
                                "example_id": "4c91e679-c0a0-4a40-853f-1a38b043dcd9",
                                "sense_id": "fc4c3b8e-64da-35e1-a6fe-bea7936f2e82",
                                "text": "In den vergangenen Jahren sind immer mehr Hormonspeicheltests auf den Markt gekommen. Die Tests sind attraktiv, da Speichel nichtinvasiv und schnell vom Patienten selbst gewonnen und in ein Labor geschickt werden kann."
                            },
                            {
                                "example_id": "866e89d8-899b-48d8-b67c-21fbac17d612",
                                "sense_id": "fc4c3b8e-64da-35e1-a6fe-bea7936f2e82",
                                "text": "Der Speicheltest wird aufgrund seiner Einfachheit und Schnelligkeit ebenfalls oft als Drogenschnelltest von der Polizei bei der Verkehrskontrolle benutzt."
                            },
                            {
                                "example_id": "a753bd9d-affc-4364-b9c1-5ecc2222f5b2",
                                "sense_id": "fc4c3b8e-64da-35e1-a6fe-bea7936f2e82",
                                "text": "„Das war noch vor der Einführung von Speicheltests und anderen Methoden, mit denen künstlich aufgeputschte Pferde entlarvt werden sollten, zu einer Zeit, als Doping noch eine weitverbreitete Praxis war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
