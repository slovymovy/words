                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "transpiración",
                                "target_lang_sense_clarification": "acción de transpirar"
                            },
                            {
                                "target_lang_word": "sudoración",
                                "target_lang_sense_clarification": "acción o proceso de sudar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}