                "senses": [
                    {
                        "sense_id": "44b66308-883d-3d68-aaed-547ae2054611",
                        "entry_id": "f3a6f470-6a53-3f44-9102-972962a58e86",
                        "glosses": [
                            "eingefriedeter Bereich, in dem (Huf)tiere untergebracht und/oder mit ihnen gearbeitet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bc463e-3745-4b16-8f82-96a92394a9e9",
                                "sense_id": "44b66308-883d-3d68-aaed-547ae2054611",
                                "text": "„Dann gingen wir zum Korral, wo die Tochter des Hauses ein Reitpferd trainierte, einen talentierten Hengst namens Specklebottom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2353ad72-8d96-4159-ae25-6b1ae4936d21",
                        "source_entry_id": "f3a6f470-6a53-3f44-9102-972962a58e86",
                        "source_sense_id": "44b66308-883d-3d68-aaed-547ae2054611",
                        "source_sense_description": "eingefriedeter Bereich, in dem (Huf)tiere untergebracht und/oder mit ihnen gearbeitet werden kann",
                        "target_lang_word": "corral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50b6edd1-dee4-3e8e-b033-a1450800f6dc",
                                        "entry_id": "d5b08944-21ad-3e31-b7b8-c97613fe7b98",
                                        "glosses": [
                                            "An enclosure for livestock, especially a circular one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b573cc0-1c81-4386-8fc4-24254fbd096c",
                                                "sense_id": "50b6edd1-dee4-3e8e-b033-a1450800f6dc",
                                                "text": "We had a small corral out back where we kept our pet llama."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2976d606-d594-33b4-9657-52d0a2423145",
                                        "entry_id": "d5b08944-21ad-3e31-b7b8-c97613fe7b98",
                                        "glosses": [
                                            "An enclosure or area to concentrate a dispersed group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377acac0-11aa-48c4-b836-c2bdcde54364",
                                                "sense_id": "2976d606-d594-33b4-9657-52d0a2423145",
                                                "text": "Please return the shopping carts to the corral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "106293ef-3f24-3b88-b171-f9baa37da146",
                                        "entry_id": "d5b08944-21ad-3e31-b7b8-c97613fe7b98",
                                        "glosses": [
                                            "A circle of wagons, either for the purpose of trapping livestock, or for defense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdff0f4a-0742-40d2-8a86-703c2c34a2f0",
                                                "sense_id": "106293ef-3f24-3b88-b171-f9baa37da146",
                                                "text": "The wagon train formed a corral to protect against Comanche attacks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee745551-fe3c-3d5e-9fdc-8b73f8b27c71",
                                        "entry_id": "62da2421-532b-3f39-bad8-c813371e1a41",
                                        "glosses": [
                                            "To capture or round up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c1b4e76-1ecf-43ca-9957-ed17af34dbb0",
                                                "sense_id": "ee745551-fe3c-3d5e-9fdc-8b73f8b27c71",
                                                "text": "Between us, we managed to corral the puppies in the kitchen."
                                            },
                                            {
                                                "example_id": "6ad9bd73-49fa-4de4-9e21-9e139b627399",
                                                "sense_id": "ee745551-fe3c-3d5e-9fdc-8b73f8b27c71",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed. And thus we came by a circuitous route to Mohair, the judge occupied by his own guilty thoughts, and I by others not less disturbing."
                                            },
                                            {
                                                "example_id": "55d6f729-2bc5-406f-b432-b168bddc07fc",
                                                "sense_id": "ee745551-fe3c-3d5e-9fdc-8b73f8b27c71",
                                                "text": "By the end of this year the work of 168 coal depots scattered throughout the Birmingham Division will have been coralled [sic] into about two dozen concentration depots."
                                            },
                                            {
                                                "example_id": "329fd48d-7409-4e13-a3c4-cb8f9e969cb6",
                                                "sense_id": "ee745551-fe3c-3d5e-9fdc-8b73f8b27c71",
                                                "text": "They provide an unprecedented inside view of the continuing clampdown in Xinjiang, in which the authorities have corralled as many as a million ethnic Uighurs, Kazakhs and others into internment camps and prisons over the past three years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef0fc88a-8146-3fed-b3eb-34aafb2bf2d6",
                                        "entry_id": "62da2421-532b-3f39-bad8-c813371e1a41",
                                        "glosses": [
                                            "To place inside of a corral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "124bcf19-4732-4020-a2ea-cf52fc1b4d26",
                                                "sense_id": "ef0fc88a-8146-3fed-b3eb-34aafb2bf2d6",
                                                "text": "After we corralled the last steer, we headed off to the chuck wagon for dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd8280b-92a0-30b8-af3c-d7165bf8e249",
                                        "entry_id": "62da2421-532b-3f39-bad8-c813371e1a41",
                                        "glosses": [
                                            "To make a circle of vehicles, as of wagons so as to form a corral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb6c80a-7e37-40b3-a7a9-10182ccb8440",
                                                "sense_id": "2bd8280b-92a0-30b8-af3c-d7165bf8e249",
                                                "text": "The cattle drivers corralled their wagons for the night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78fe876b-b7d6-40a7-9634-b18622d229ae",
