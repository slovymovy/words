                    {
                        "form_id": "d720a279-0309-4aca-8668-4f5e5ef3f09c",
                        "entry_id": "becb2b8e-b0fe-3425-b4da-539c58f3e1a5",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind fachintegrativ"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66dca826-57b2-3778-b57a-460bf8e450b7",
                        "entry_id": "becb2b8e-b0fe-3425-b4da-539c58f3e1a5",
                        "glosses": [
                            "ein Fachgebiet in eine Gruppe mit anderen Disziplinen einbindend, es vernetzend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86804b95-149a-41ca-948f-4e23ab323f09",
                                "sense_id": "66dca826-57b2-3778-b57a-460bf8e450b7",
                                "text": "„Die Inhalte der Fachdisziplinen Haushalt und Textil können somit fachintegrativ realisiert werden.“"
                            },
                            {
                                "example_id": "edeee5d0-2142-4301-9953-9f9f2eb6d182",
                                "sense_id": "66dca826-57b2-3778-b57a-460bf8e450b7",
                                "text": "„Um den hier vertretenen methodischen Ansatz wissenschaftstheoretisch zu lokalisieren und kritisch zu begründen, ist den fachspezifischen Überlegungen eine historische Problemrückschau vorangestellt, die umso notwendiger erscheint, als eine umfassende systematische Aufarbeitung der vielfältigen Erscheinungsformen fachintegrativer Konzentrationsbemühungen m.W. bisher noch nicht geleistet wurde.“"
                            },
                            {
                                "example_id": "69f24358-2705-40ac-a8d4-be3290c9226c",
                                "sense_id": "66dca826-57b2-3778-b57a-460bf8e450b7",
                                "text": "„Das fachintegrative Wissen wurde mittels eines Concept Mapping Verfahrens […] erfasst.“"
                            },
                            {
                                "example_id": "96fd29e0-2867-46a4-aa97-2eeac3868ba0",
                                "sense_id": "66dca826-57b2-3778-b57a-460bf8e450b7",
                                "text": "„In der Schule ist Medienbildung kein eigenes Fach. Sie soll und kann nur fachintegrativ und fächerübergreifend verwirklicht werden.“"
                            },
                            {
                                "example_id": "a1595c16-6449-4b28-aa49-94856f549910",
                                "sense_id": "66dca826-57b2-3778-b57a-460bf8e450b7",
                                "text": "„Zur Unterstützung aller Lehrkräfte an allgemeinbildenden Schulen in der Umsetzung der Bildungspläne 2016 gab und gibt es umfangreiche Fortbildungsangebote. Die Leitperspektiven werden dabei fachintegrativ thematisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
