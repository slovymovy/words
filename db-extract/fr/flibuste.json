        "fr-extract.jsonl": [
            {
                "entry_id": "290aeb5e-b235-3002-9733-dcecf184b95a",
                "word": "flibuste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a4b81304-ab50-46c6-ae96-7b8a2bee9501",
                        "entry_id": "290aeb5e-b235-3002-9733-dcecf184b95a",
                        "tags": [
                            "plural"
                        ],
                        "form": "flibustes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57027751-346f-38bb-ba98-87f7eab7b483",
                        "entry_id": "290aeb5e-b235-3002-9733-dcecf184b95a",
                        "glosses": [
                            "Métier du pirate des mers, activités relatives à la piraterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52472ae5-245e-4877-b866-b96eb5560966",
                                "sense_id": "57027751-346f-38bb-ba98-87f7eab7b483",
                                "text": "Un de leurs ancêtres, enrichi par la flibuste, acheta la maison en l’an de grâce 1712 et y fit graver ses initiales dans la pierre."
                            }
                        ]
                    },
                    {
                        "sense_id": "25e1aa6f-4e17-3ef0-a352-350381d3e90c",
                        "entry_id": "290aeb5e-b235-3002-9733-dcecf184b95a",
                        "glosses": [
                            "Association de pirates des mers, ensemble des pirates."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "184af2b6-ada0-4406-a31e-6931a82b6fa5",
                                "sense_id": "25e1aa6f-4e17-3ef0-a352-350381d3e90c",
                                "text": "On s’imagine aisément qu’entre les fugitifs de la Tortue, dont on a rapporté les aventures, ce n’étaient pas les plus honnêtes gens qui avaient donné naissance à la flibuste."
                            },
                            {
                                "example_id": "716399a0-95a7-4159-9120-fd65362bc091",
                                "sense_id": "25e1aa6f-4e17-3ef0-a352-350381d3e90c",
                                "text": "Sous la protection de la flibuste, la colonie française fit des progrès et devint bientôt assez florissante pour mériter l'appui de la métropole."
                            },
                            {
                                "example_id": "d7029e74-e1f6-4cf9-9b50-7536fa71a51d",
                                "sense_id": "25e1aa6f-4e17-3ef0-a352-350381d3e90c",
                                "text": "Si le compositeur fit fortune dans le film de cap et d'épée (en particulier avec Errol Flynn), il n'en oublia jamais son sens tout viennois du raffinement — la flibuste aussi a ses exigences."
                            },
                            {
                                "example_id": "0a05762d-78b3-43bc-a0d5-b76186ab5d7d",
                                "sense_id": "25e1aa6f-4e17-3ef0-a352-350381d3e90c",
                                "text": "La Flibuste = association des pirates des Caraïbes au début du XVIIIᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e7b01ef-925c-3b61-af9d-53626ca04963",
                        "entry_id": "290aeb5e-b235-3002-9733-dcecf184b95a",
                        "glosses": [
                            "Activité de vol, de fraude ou d’escroquerie à grande échelle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e2fa999d-3f0e-4536-b894-83db0dda3b25",
                                "sense_id": "3e7b01ef-925c-3b61-af9d-53626ca04963",
                                "text": "Il est pas bonnard, le papa Limousé, pour dresser dans son étude une série d’actes qui respireraient la flibuste pour le plus innocent des clercs."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd2db163-35fb-3a4e-83da-715bb11ab5fd",
                        "entry_id": "290aeb5e-b235-3002-9733-dcecf184b95a",
                        "glosses": [
                            "Association de ceux qui commettent vol, fraude ou escroquerie à grande échelle."
                        ],
                        "tags": [
                            "figuratively",
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70e51f4f-311a-4113-b258-d1365c052e2e",
                        "source_entry_id": "290aeb5e-b235-3002-9733-dcecf184b95a",
                        "source_sense_description": "Métier du pirate des mers",
                        "target_lang_word": "freebooting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freebooting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19a3d7d1-b96a-3e49-b63a-a75e0ede11a8",
                                        "entry_id": "9791b675-d0cb-3357-88b7-ffcb33616017",
                                        "glosses": [
                                            "To pilage or plunder; piracy"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ae76d3-f41e-4d3c-9b37-3c6e7993d67e",
                                                "sense_id": "19a3d7d1-b96a-3e49-b63a-a75e0ede11a8",
                                                "text": "The Haghar are well known, even in Europe, for their freebooting propensities."
                                            },
                                            {
                                                "example_id": "63e70653-4636-4347-8a17-f25ee9ccfa91",
                                                "sense_id": "19a3d7d1-b96a-3e49-b63a-a75e0ede11a8",
                                                "text": "Why do you now refuse to protect your own highway into the Interior, […] and thus put an end to the freebooting of the Boers, and of our own people who joined them?"
                                            },
                                            {
                                                "example_id": "904ef425-5c21-4884-a724-0e320ac910bf",
                                                "sense_id": "19a3d7d1-b96a-3e49-b63a-a75e0ede11a8",
                                                "text": "In a short time freebooting assumed all of the routine of a regular business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "416aa86f-b1b0-34d8-9f46-e9b60a6ae5ee",
                                        "entry_id": "9791b675-d0cb-3357-88b7-ffcb33616017",
                                        "glosses": [
                                            "Software piracy, or stealing or unauthorized rehosting of digital content."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62abc687-7ccf-4be7-a334-ddc0c4761754",
                                                "sense_id": "416aa86f-b1b0-34d8-9f46-e9b60a6ae5ee",
                                                "text": "Your recent issue about the problems of electronic software piracy or \"freebooting\" — if you will — was excellent and timely. However, I wonder if both sides have failed to understand the social significance of the struggle."
                                            },
                                            {
                                                "example_id": "fc070100-96a0-4744-8f0a-20e593236c93",
                                                "sense_id": "416aa86f-b1b0-34d8-9f46-e9b60a6ae5ee",
                                                "text": "Freebooting of broadcast satellite signals may exist privately, but we have no evidence of illegal signal capture being commercialized any longer."
                                            },
                                            {
                                                "example_id": "e09899f8-fd6c-4836-be0b-05b11d62fa76",
                                                "sense_id": "416aa86f-b1b0-34d8-9f46-e9b60a6ae5ee",
                                                "text": "Many felt that the software companies are really the ones who ought to be called pirates. […] No wonder, the reader said, that customers are tempted to a little freebooting of their own."
                                            },
                                            {
                                                "example_id": "3ac49f2c-dd2f-488d-be03-505a192fd500",
                                                "sense_id": "416aa86f-b1b0-34d8-9f46-e9b60a6ae5ee",
                                                "text": "Oh those freebooters taking our videos! I'm sick of it. Freebooting, you know, it's a serious issue!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "freebooting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30a18cae-c0d8-3018-989a-814b1ebf4a69",
                                        "entry_id": "849b8783-7b60-3a26-93a1-edcd69d61e3b",
                                        "glosses": [
                                            "Engaged in piracy or plunder"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e54c5785-6775-4e56-9381-0fb91d42a0d7",
                                                "sense_id": "30a18cae-c0d8-3018-989a-814b1ebf4a69",
                                                "text": "In one respect, as I hinted above, it is only too good, so sure of success, I mean, that you are no longer secure of any respect to your property in our freebooting America."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "freebooting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65a9ea1b-d65d-3907-b427-5498aa2991dc",
                                        "entry_id": "0f2de6a4-6bf5-3543-8292-a8aca1631ac6",
                                        "glosses": [
                                            "present participle and gerund of freeboot"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
