                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a146512-193d-320a-9e6b-cc2f71649e8f",
                                        "entry_id": "1a744678-e2d2-39ca-98c5-504ce5497be3",
                                        "glosses": [
                                            "Doctrine philosophique selon laquelle le mal l’emporte sur le bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202a733e-2e64-4189-8a25-a29a93771986",
                                                "sense_id": "7a146512-193d-320a-9e6b-cc2f71649e8f",
                                                "text": "J’imagine que le pessimisme grec provient de tribus pauvres, guerrières et montagnardes, qui avaient un énorme orgueil aristocratique, mais dont la situation était par contre fort médiocre […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85cdb353-7fc1-39c8-b027-6a170eee3fb6",
                                        "entry_id": "1a744678-e2d2-39ca-98c5-504ce5497be3",
                                        "glosses": [
                                            "Opinion, état d’esprit, de ceux qui sont portés à croire que tout va mal."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b022459-d4bb-4a08-8488-6770ec8096d9",
                                                "sense_id": "85cdb353-7fc1-39c8-b027-6a170eee3fb6",
                                                "text": "Vous voulez sans doute dire, monsieur, que la vie est sans but? N'est-ce pas ce qu'on appelle le pessimisme?"
                                            },
                                            {
                                                "example_id": "4869faa8-0f50-4719-8ea5-a594c378cb84",
                                                "sense_id": "85cdb353-7fc1-39c8-b027-6a170eee3fb6",
                                                "text": "En dépit du mauvais pressentiment qui s'insinue en moi, je continue d'espérer. Il m'arrive parfois d'outrepasser mon pessimisme et de me retrouver « déçu en bien », comme disent les Suisses romands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
