                        "examples": [
                            {
                                "example_id": "444eaab4-d6b8-4a38-bccc-dbc3acda2010",
                                "sense_id": "4b7a9522-9976-36eb-b045-eb8349f1e4df",
                                "text": "Für die Lösung des Problems musste er einen rekursiven Sortieralgorithmus verwenden."
                            },
                            {
