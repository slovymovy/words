                                                "sense_id": "ecaafc8d-ea9e-3e02-8d10-939053a58089",
                                                "text": "to concentrate rays of light into a focus"
                                            },
                                            {
                                                "example_id": "674a8206-112a-4586-801a-097693b503be",
                                                "sense_id": "ecaafc8d-ea9e-3e02-8d10-939053a58089",
                                                "text": "to concentrate the attention"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3741ad95-c692-3f4a-a09f-7d1ae11a9d1a",
                                        "entry_id": "51d76a2f-ad20-3740-8415-db39c1d44f3e",
                                        "glosses": [
                                            "To increase the strength and diminish the bulk of, as of a liquid or an ore; to intensify, by getting rid of useless material; to condense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7869c7c6-0c2d-4980-907d-3f0392b0b5cc",
                                                "sense_id": "3741ad95-c692-3f4a-a09f-7d1ae11a9d1a",
                                                "text": "to concentrate acid by evaporation"
                                            },
                                            {
                                                "example_id": "6e00cf58-606c-493d-8a36-23145368c1b5",
                                                "sense_id": "3741ad95-c692-3f4a-a09f-7d1ae11a9d1a",
                                                "text": "to concentrate by washing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "962951df-9de9-346c-8300-8643763e0657",
                                        "entry_id": "51d76a2f-ad20-3740-8415-db39c1d44f3e",
                                        "glosses": [
                                            "To approach or meet in a common center; to consolidate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55860284-e93c-4471-b4b8-38226949073c",
                                                "sense_id": "962951df-9de9-346c-8300-8643763e0657",
                                                "text": "Population tends to concentrate in cities."
                                            },
                                            {
                                                "example_id": "8bd4148f-7d45-4101-a167-333c12eb05fa",
                                                "sense_id": "962951df-9de9-346c-8300-8643763e0657",
                                                "text": "Buried within the Mediterranean littoral are some seventy to ninety million tons of slag from ancient smelting, about a third of it concentrated in Iberia. This ceaseless industrial fueling caused the deforestation of an estimated fifty to seventy million acres of woodlands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                        "entry_id": "51d76a2f-ad20-3740-8415-db39c1d44f3e",
                                        "glosses": [
                                            "To focus one's thought or attention (on)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a8f1e1-c41c-4e9b-90b4-a0734c371af1",
                                                "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                                "text": "(oneself)"
                                            },
                                            {
                                                "example_id": "75747334-3739-46a2-8cdb-8a71d0480f74",
                                                "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                                "text": "Let me concentrate!"
                                            },
                                            {
                                                "example_id": "ee823333-24c2-488c-be09-2cd24d7146bc",
                                                "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                                                "text": "The Group has recently concentrated on two main objectives, the implementation of a Code of Practice on minor station improvements and the preparation of a stock list of approved items of equipment for railway stations."
                                            }
                                        ]
                                    }
                                ]
                            },
