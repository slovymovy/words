                "senses": [
                    {
                        "sense_id": "e1dd3105-4dca-3761-9cbd-ae6f2f11e09d",
                        "entry_id": "53e58350-6388-3b66-b216-c590d604b340",
                        "glosses": [
                            "financiering van sociale verzekering waarbij de kosten van de uitkeringen in een bepaalde periode worden verdeeld over de premiebetalers in die periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ab5d4a-d051-4cc5-94c5-cf430c566040",
                                "sense_id": "e1dd3105-4dca-3761-9cbd-ae6f2f11e09d",
                                "text": "De nog niet-uitkeringsgerechtigden betalen AOW-premie en de AOW-gerechtigden krijgen daaruit de AOW-uitkering. Dit is het omslagstelsel. Daarnaast hebben we het aanvullend pensioen, dat draait als een kapitaaldekkingsstelsel. Heel simpel gesteld is dit een spaarsysteem."
                            },
                            {
                                "example_id": "4fe25ddf-de45-4155-9a30-15b3e30f1f03",
                                "sense_id": "e1dd3105-4dca-3761-9cbd-ae6f2f11e09d",
                                "text": "Het is een van de weinige landen met volledig gefinancierde aanvullende pensioenen, in tegenstelling tot de andere landen van de eurozone, waar omslagstelsels de boventoon voeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "afd44e05-7587-344b-a13c-77989f810791",
                        "entry_id": "53e58350-6388-3b66-b216-c590d604b340",
                        "glosses": [
                            "vorm van belastingheffing waarbij een bepaalde totaalopbrengst wordt vastgesteld, met een bepaalde verdeling over de belastingplichtigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45cccef2-4395-466b-9fba-c7481bd5fefc",
                                "sense_id": "afd44e05-7587-344b-a13c-77989f810791",
                                "text": "Voor een goed functioneren van het omslagstelsel achtte de studiecommissie het noodzakelijk dat de taken van het waterschap, waarbij de omslagplichtigen in verschillende mate belang hebben, bijvoorbeeld door het instellen van afzonderlijke beheren, zodanig worden onderscheiden dat de daaruit voortvloeiende kosten op zichzelf kunnen worden bepaald."
                            }
                        ]
                    },
                    {
                        "sense_id": "91449aee-6f5e-3974-a2e7-9828cfe32c8a",
                        "entry_id": "53e58350-6388-3b66-b216-c590d604b340",
                        "glosses": [
                            "delen van de totale kosten door betrokkenen volgens een vooraf afgesproken verdeelsleutel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a60d8b-94ae-407c-be38-1f2a9d84ccde",
                                "sense_id": "91449aee-6f5e-3974-a2e7-9828cfe32c8a",
                                "text": "De banken willen dat de regeling wordt omgezet in een verzekering van spaargelden, waarbij de banken een vaste premie betalen en de overheid indien nodig uitkeert. (…) De commissie wil dus af van het huidige omslagstelsel, waarin vorig jaar alle banken opdraaiden voor de garantie van de spaargelden van Nederlanders bij de IJslandse internetbank Icesave."
                            }
                        ]
                    }
