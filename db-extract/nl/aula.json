                            {
                                "example_id": "5be030ea-50e9-4709-b6eb-04aa0b05add0",
                                "sense_id": "4af8f91e-668e-3e66-8ced-ac2a83b4dc99",
                                "text": "De centrale hal van de school functioneerde ook als aula."
                            },
                            {
                                "example_id": "939b6ea8-452b-4ad0-8757-a6743983c7f4",
                                "sense_id": "4af8f91e-668e-3e66-8ced-ac2a83b4dc99",
                                "text": "Haar geest stapte over naar de aula van het uitvaartcentrum waar koffie werd gedronken."
