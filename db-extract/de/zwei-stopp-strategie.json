                        "sense_id": "9cc25c7c-6d5e-3db9-8c36-377866d1d72f",
                        "entry_id": "4dfc7704-1068-36bf-b79b-46f43b07f5a5",
                        "glosses": [
                            "Taktik, bei der zwei Boxenstopps eingeplant sind"
                        ],
                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d20fdfc7-951f-464a-9955-2fddadcff021",
                                "sense_id": "9cc25c7c-6d5e-3db9-8c36-377866d1d72f",
                                "text": "„Für den Fall der Fälle hatte Lotus eine Zwei-Stopp-Strategie als Plan B im Hinterkopf.“"
                            },
                            {
                                "example_id": "e5a92e3a-c2b9-493d-8a3d-eac13be6de37",
                                "sense_id": "9cc25c7c-6d5e-3db9-8c36-377866d1d72f",
                                "text": "„Zweiter wurde Kimi Raikkonen, der eine Zwei-Stop-Strategie gewählt hatte, während alle anderen (bis auf Coulthard) zu drei Boxenstops reinkamen.“"
                            },
                            {
                                "example_id": "5c02a3db-6e34-4058-b85c-7a3d22b69ab7",
                                "sense_id": "9cc25c7c-6d5e-3db9-8c36-377866d1d72f",
                                "text": "„Auch den Gefallen einer Zwei-Stopp-Strategie bei Schumacher - die seine anfänglichen Rekordzeiten erklärt hätte -, unterbreiten die Italiener ihrem schwäbisch-britischen Widersacher nicht.“"
                            }
                        ],
