                        ]
                    },
                    {
                        "sense_id": "02bd5cb4-58bf-341b-80c2-6a9f81068d84",
                        "entry_id": "14a4388b-5f39-3d48-b0ef-d8347dd50b5c",
                        "glosses": [
                            "To sleep, especially in the open or in a derelict building because one is homeless."
                        ],
                        "tags": [
                            "British",
                            "intransitive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0b8d295a-22a2-4b4a-bf03-449e25f35c3a",
                                "sense_id": "02bd5cb4-58bf-341b-80c2-6a9f81068d84",
                                "text": "I normally have to doss in shop doorways or on park benches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14d934e0-b400-4237-98e0-366e49adda3d",
                        "source_entry_id": "14a4388b-5f39-3d48-b0ef-d8347dd50b5c",
                        "source_sense_description": "sleep in the open",
                        "target_lang_word": "nocovat (nouzově)",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0c13e2ea-c4e9-4ba5-98c6-5663a22a7782",
                        "source_entry_id": "14a4388b-5f39-3d48-b0ef-d8347dd50b5c",
                        "source_sense_description": "sleep in the open",
                        "target_lang_word": "spát",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spát",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "18d5b143-eeed-3233-820c-6513eae65de6",
                                        "entry_id": "ccf69116-c296-34ff-b1ff-52e17e12f98b",
                                        "glosses": [
                                            "být ve spánku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d655ee70-90f3-4b41-8a73-fc27e5c86647",
                                                "sense_id": "18d5b143-eeed-3233-820c-6513eae65de6",
                                                "text": "Novorozeňata spí po většinu dne i noci."
                                            },
                                            {
                                                "example_id": "c7737616-1bec-4d2a-8e07-35e7e2b06015",
                                                "sense_id": "18d5b143-eeed-3233-820c-6513eae65de6",
                                                "text": "Má-li někdo veliké starosti, učiní nejmoudřeji, když jde spát. Ve spánku splývá duše s nekonečnem a v tom se všecky trampoty rozplývají v nic."
                                            },
                                            {
                                                "example_id": "c78df326-8fb7-43b5-9300-4946de1febf0",
                                                "sense_id": "18d5b143-eeed-3233-820c-6513eae65de6",
                                                "text": "Každá věc svým způsobem někdy spí. I rostlinstvo spí a podobně i voda. Též andělé Páně někdy svým způsobem spí a dokonce i Zákon Boží spává."
                                            },
                                            {
                                                "example_id": "751dbb35-31bf-4963-9f0a-c33a8b5b8823",
                                                "sense_id": "18d5b143-eeed-3233-820c-6513eae65de6",
                                                "text": "Čím hlouběji věda proniká do tajemství spánku, tím menší se zdá možnost, že najdeme tvora, který vůbec nespí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a6d3526-1ee1-3686-80e8-270e14e0b3b3",
                                        "entry_id": "ccf69116-c296-34ff-b1ff-52e17e12f98b",
                                        "glosses": [
                                            "být neaktivní"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f81112-0204-4dfa-9294-926906dac7c3",
                                                "sense_id": "1a6d3526-1ee1-3686-80e8-270e14e0b3b3",
                                                "text": "Sopka po mnoho staletí jen spala, pak se ale náhle probudila k životu."
                                            },
                                            {
                                                "example_id": "20619c05-a075-4996-9dff-66b90aeebd06",
                                                "sense_id": "1a6d3526-1ee1-3686-80e8-270e14e0b3b3",
                                                "text": "Předpokládá se, že na celém Západě „spí“ řada teroristických buněk - zásadní problém je, aby je tajné služby dokázaly podchytit hned na začátku jejich případného probuzení."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62903129-314e-33aa-b000-13e5628e71e0",
                                        "entry_id": "ccf69116-c296-34ff-b1ff-52e17e12f98b",
                                        "glosses": [
                                            "(spát s + instrumentál) (eufemisticky) vykonávat pohlavní styk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3236865-0c01-4d00-95d9-e668b2555b44",
                                                "sense_id": "62903129-314e-33aa-b000-13e5628e71e0",
                                                "text": "Tvrdí, že s ní včera spal, ale tomu se dá těžko věřit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
