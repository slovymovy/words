                ],
                "senses": [
                    {
                        "sense_id": "c25e5855-22a6-325c-ab11-d36a0ef1f2a4",
                        "entry_id": "20b35088-9183-3f1b-8c12-838dc11eb48f",
                        "glosses": [
                            "Carte que délivre la police pour permettre de couper la file des voitures, les barrages d’agents ou de soldats dans un défilé, une cérémonie, etc."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "b94e192b-09e3-44cd-b5b9-42db0e1c77ea",
                                "sense_id": "c25e5855-22a6-325c-ab11-d36a0ef1f2a4",
                                "text": "Pour l’intelligence de mes lecteurs, je leur dirai ce que c’est qu’un coupe-file. C’est une carte de la préfecture au moyen de laquelle la voiture du titulaire de cette carte peut, quel que soit l’encombrement, passer avant les autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "18870e54-a010-33e3-a66d-955b4637300f",
                        "entry_id": "20b35088-9183-3f1b-8c12-838dc11eb48f",
                        "glosses": [
                            "Billet coupe-file."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "d9b763f5-c560-4416-8ae9-f4290b72f31e",
                                "sense_id": "18870e54-a010-33e3-a66d-955b4637300f",
                                "text": "En dépit des règles très strictes imposées par les organisateurs pour tenter de régulariser un peu le temps des visites, des groupes de plus en plus compacts pourvus de laissez-passer et de coupe-file de toutes sortes forçaient la vigilance des gardiens et restaient collés le nez au tableau pendant des heures entières."
                            }
                        ]
                    },
                    {
                        "sense_id": "a84d39af-67fc-3584-bd86-c97bb4107752",
                        "entry_id": "20b35088-9183-3f1b-8c12-838dc11eb48f",
                        "glosses": [
                            "Manière de surpasser un obstacle, d'avancer plus rapidement vers un but."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "443b4855-09f8-43fb-bbb4-7a78ca599499",
                                "sense_id": "a84d39af-67fc-3584-bd86-c97bb4107752",
                                "text": "Le seul fait divers qu'il avait encore envie de suivre, c'était évidemment l'affaire Lampson parce qu'elle avait été son coupe-file vers la réussite et demeurait sa mascotte."
                            }
                        ]
                    }
