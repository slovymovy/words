                "senses": [
                    {
                        "sense_id": "3ab236b0-bfba-376e-a9a2-204952ed86b6",
                        "entry_id": "0f0de809-d1a8-306b-9435-0c02ee18172a",
                        "glosses": [
                            "Faire partager en live sur son blogue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb314e92-cd06-4065-8caf-e3ae49a44a73",
                                "sense_id": "3ab236b0-bfba-376e-a9a2-204952ed86b6",
                                "text": "Les articles live-bloggés font exploser le compteur de visites sur les sites ayant adopté le concept."
                            },
                            {
                                "example_id": "3792d9b4-2b7c-4b4c-9ef7-7b411c4e04f7",
                                "sense_id": "3ab236b0-bfba-376e-a9a2-204952ed86b6",
                                "text": "Traditionnellement, nous avons live-bloggé des journées électorales : du matin au soir."
                            },
                            {
                                "example_id": "964286b6-8336-4e6a-ac2d-808bbc29ce25",
                                "sense_id": "3ab236b0-bfba-376e-a9a2-204952ed86b6",
                                "text": "Les nanas et les mecs qui live-bloggent Pekin Express ou L'amour est aveugle me saoulent mais après tout, ils font ce qu'ils veulent, ils ne sont pas journalistes, ils ne font que raconter leur petite life."
                            }
                        ]
                    }
