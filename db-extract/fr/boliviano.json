                    },
                    {
                        "sense_id": "2a8b7493-1945-3fa9-a867-fe2e789ddd2f",
                        "entry_id": "b7e020d1-e1b9-382d-9ab5-16f2e340117a",
                        "glosses": [
                            "Ancienne monnaie bolivienne, qui eut cours entre 1864 et 1963."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b38146c-031b-43c5-9704-95e43524870d",
                                "sense_id": "2a8b7493-1945-3fa9-a867-fe2e789ddd2f",
                                "text": "En 1864, le boliviano remplace le scudo au taux de deux bolivianos pour un scudo."
                            },
                            {
                                "example_id": "3777c7dd-0715-44c1-85d8-bea46c08d808",
                                "sense_id": "2a8b7493-1945-3fa9-a867-fe2e789ddd2f",
                                "text": "L’ancien boliviano se subdivisait d’abord en 100 centécimos ; le centavo fut introduit en 1870. Dix bolivianos valaient un bolivar."
                            },
                            {
                                "example_id": "13355dba-eb56-4254-9e6b-1f1cd2c65303",
                                "sense_id": "2a8b7493-1945-3fa9-a867-fe2e789ddd2f",
                                "text": "Entre 1963 et 1987, le boliviano disparut, remplacé par le peso bolivien."
                            }
                        ]
                    }
