                        "glosses": [
                            "Mathématicien grec de l'école pythagoricienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7343386c-3caa-4efd-ad24-5c16e1f16aa3",
                                "sense_id": "737651ec-3ebc-321e-b212-963ba57a7d7c",
                                "text": "En Grèce, on appelait canon harmonique les proportions numériques calculées sur le monocorde pour définir les intervalles, d'où le nom de canonistes parfois donné aux harmoniciens de l'école pythagoricienne."
                            },
                            {
                                "example_id": "cf2edad4-df63-4c2a-87a6-c6da5de5f35d",
                                "sense_id": "737651ec-3ebc-321e-b212-963ba57a7d7c",
                                "text": "Il ne se rend nullement compte qu’il ne peut être un vrai harmonicien, l’instruction lui faisant défaut."
                            }
                        ]
                    }
