                    },
                    {
                        "form_id": "e9a37ecf-afae-422c-adab-52389aea3dfc",
                        "entry_id": "ee8df9a8-0fea-31ff-bea4-9ef621b9f7a9",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\os.mɑ̃\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9add8c25-32fa-391e-9e99-72979d1691ea",
                        "entry_id": "ee8df9a8-0fea-31ff-bea4-9ef621b9f7a9",
                        "glosses": [
                            "Action de hausser quelque chose."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "387f138f-a0ed-3b7f-b04c-6cb06b93871e",
                        "entry_id": "ee8df9a8-0fea-31ff-bea4-9ef621b9f7a9",
                        "glosses": [
                            "Mouvement qu’on fait des épaules, pour marquer de l’indignation ou du mépris."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "26e33d38-8d2e-479a-ae49-1900ed933145",
                                "sense_id": "387f138f-a0ed-3b7f-b04c-6cb06b93871e",
                                "text": "Eh bien ! sir Francis Trevellyan n’a que des regards de mépris et des haussements d’épaules pour tout ce que nous avons fait."
                            },
                            {
                                "example_id": "ff258d18-2846-4192-86d2-425f8a1a8e70",
                                "sense_id": "387f138f-a0ed-3b7f-b04c-6cb06b93871e",
                                "text": "— C’est idiot ! déclara nettement celui-ci, avec un haussement d’épaules."
                            },
                            {
                                "example_id": "f5c083b9-e982-4f26-8c88-930d3d256d71",
                                "sense_id": "387f138f-a0ed-3b7f-b04c-6cb06b93871e",
                                "text": "[…], chacun est bien obligé de reconnaître pour soi comme pour le monde, l'exceptionnelle gravité de l'heure, gravité qui même au léger pays de France ne saurait cette fois se résoudre aux chansons et dont on ne réussit plus à chasser définitivement la hantise par un insouciant haussement d’épaules, un bridge, un souper joyeux ou un « ouikenne » aux sports d'hiver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04b3b6d1-643e-4ad4-9b6c-3485416280fa",
                        "source_entry_id": "ee8df9a8-0fea-31ff-bea4-9ef621b9f7a9",
                        "target_lang_word": "shrug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d71dadb-c050-3965-a3ed-49a3dc536ee4",
                                        "entry_id": "b2b7b3ed-d0e7-32db-88ab-e5683a28dae9",
                                        "glosses": [
                                            "A lifting of the shoulders to signal indifference or a casual lack of knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67d267b-17aa-498c-842b-ad17d8cee3d6",
                                                "sense_id": "1d71dadb-c050-3965-a3ed-49a3dc536ee4",
                                                "text": "He dismissed my comment with a shrug."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35444622-19df-3e52-8b51-00429e129e44",
                                        "entry_id": "b2b7b3ed-d0e7-32db-88ab-e5683a28dae9",
                                        "glosses": [
                                            "A cropped, cardigan-like garment with short or long sleeves, typically knitted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shrug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                        "entry_id": "bd5e31b5-6b5d-348e-bea2-6dcd30fd6896",
                                        "glosses": [
                                            "To raise (the shoulders) to express uncertainty, lack of concern, (formerly) dread, etc."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca91abe-7538-4bf0-9ff1-765ef6b6c42b",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "I asked him for an answer and he just shrugged."
                                            },
                                            {
                                                "example_id": "6b70f9f0-90c9-4e87-a869-79ee967d8714",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "When he saw the problem, he just shrugged and started fixing it."
                                            },
                                            {
                                                "example_id": "d4f052aa-7fcd-4b92-8411-b492e9e5f23e",
                                                "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                                                "text": "He[…] shrugs his shoulders when you talk of securities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
