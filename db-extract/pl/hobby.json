                    {
                        "translation_id": "cb189542-865c-4146-981a-f91f7c6f9902",
                        "source_entry_id": "fc7bee32-2814-3ab6-915b-431a7577d7db",
                        "source_sense_id": "2e7d0fd9-fd40-38b3-9a8c-7d460888cc6a",
                        "target_lang_word": "Hobby",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hobby",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                        "entry_id": "86d04b54-5c4d-369c-82fc-bad40e21ee62",
                                        "glosses": [
                                            "Betätigung, Steckenpferd, Interessengebiet; etwas, das man freiwillig und gerne tut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94e4306-d0a9-4b5b-af35-649f53ebc51b",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "Wenn jemand ganz viel Glück hat, hat er einen Beruf, der zugleich sein Hobby ist."
                                            },
                                            {
                                                "example_id": "0aad44ff-5ced-4f66-98b1-13532b21601f",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "In der Pension kann er endlich seinen Hobbys nachgehen."
                                            },
                                            {
                                                "example_id": "7ae0a110-e374-4131-889e-846dc5589013",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Roger Militon war ein Glücksritter auf der Suche nach einer reichen Frau, die ihm seine Hobbys finanzieren sollte.“"
                                            },
                                            {
                                                "example_id": "7741a0fb-864e-4345-9b5a-4e879ad3f709",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Auch eine Unfallversicherung kann sinnvoll sein, für extravagante Hobbys wie Fallschirmspringen oder Extrembergsteigen sind allerdings Zusatzdeckungen erforderlich.“"
                                            },
                                            {
                                                "example_id": "9dcb23f9-cf3a-4df6-a539-74cae01a97e4",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Hinter dieser Gegebenheit verbirgt sich das Geheimnis, warum Risikosport und Grenzgang, aber auch zahlreiche Sportformen und Hobbies im mittleren Gefahrenbereich Außenstehenden keinen inneren Zugang gewähren.“"
                                            },
                                            {
                                                "example_id": "3ca06733-3d99-4079-9930-785eba5eaa45",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Eine Blondine beschließt, sich für die Wintermonate ein ganz neues Hobby zuzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5025e98-cda5-443e-afe7-cb0ce0ca12b4",
                        "source_entry_id": "fc7bee32-2814-3ab6-915b-431a7577d7db",
                        "source_sense_id": "2e7d0fd9-fd40-38b3-9a8c-7d460888cc6a",
