                {
                    "sense_id": "3851e165-d531-309f-a5cd-8dded34a12bd",
                    "sense_definition": "Elektrische Energie, die über Leitungen transportiert und zum Betrieb von Geräten oder Lampen genutzt wird",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "Elektrizität",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plötzlich fiel im ganzen Haus der <w>Strom</w> aus und alle Lampen erloschen."
                        },
                        {
                            "text": "Wir versuchen im Haushalt bewusst weniger <w>Strom</w> zu verbrauchen."
                        }
                    ],
                    "common_phrases": [
                        "Strom sparen",
                        "Strom verbrauchen",
                        "grüner Strom"
                    ]
                },
                {
                    "sense_id": "88aa78db-08e6-3ed7-b21b-69314dd164dc",
                    "sense_definition": "Sehr großes, breites fließendes Gewässer, das meist in ein Meer mündet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Fließen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Rhein ist ein mächtiger <w>Strom</w>, der durch mehrere europäische Länder fließt."
                        },
                        {
                            "text": "Träge fließt das schlammige Wasser des breiten <w>Stroms</w> durch das flache Tal."
                        }
                    ],
                    "synonyms": [
                        "Fluss"
                    ],
                    "common_phrases": [
                        "breiter Strom",
                        "mächtiger Strom"
                    ]
                },
                {
                    "sense_id": "0fe4d912-f155-38aa-b4cf-d0c7970d7c41",
                    "sense_definition": "Große Menge von Menschen, Fahrzeugen oder Daten, die sich kontinuierlich in eine Richtung bewegt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Fließen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein ununterbrochener <w>Strom</w> von Besuchern zog den ganzen Nachmittag durch das Museum."
                        },
                        {
                            "text": "Nach dem Konzert ergoss sich ein riesiger <w>Strom</w> von Menschen in die U-Bahn-Station."
                        }
                    ],
                    "common_phrases": [
                        "Strom von Besuchern",
                        "Strom von Menschen"
                    ]
                },
                {
                    "sense_id": "51cc2599-1c6d-3a9c-8c36-1b59568906b5",
                    "sense_definition": "Gerichtete Bewegung von elektrischen Ladungsträgern durch einen elektrischen Leiter",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "Elektrizität",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sobald der Stromkreis geschlossen wird, fließt ein messbarer <w>Strom</w> durch das Bauteil."
                        },
                        {
                            "text": "Die Stärke des fließenden <w>Stroms</w> wird in der Einheit Ampere angegeben."
                        }
                    ],
                    "synonyms": [
                        "Elektronenstrom",
                        "Ladungsstrom"
