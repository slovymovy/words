                        "examples": [
                            {
                                "example_id": "6b003e2c-8643-41f1-9e04-1046228be945",
                                "sense_id": "6e13d4ca-22f6-3e59-a1e1-99d8f40ee0a1",
                                "text": "La veille de notre départ, des choquards ou corneilles à bec jaune (corvus pyrrhocorax) vinrent voler autour de nous, attirés sans doute par quelques débris de pain gelé et des os de mouton et de poulet gisant aux environs de notre tente."
                            },
                            {
                                "example_id": "de91ef63-6d53-4c3f-84fa-844f92953be0",
                                "sense_id": "6e13d4ca-22f6-3e59-a1e1-99d8f40ee0a1",
                                "text": "On peine, en sueur, sur les éboulis du col, sous les quolibets des choquards qui, avec une décourageante aisance, évoluent au flanc des parois verticales."
                            }
                        ]
                    }
