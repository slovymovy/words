                        "entry_id": "b46297ac-b2c5-39dd-b6cd-534f631241c1",
                        "glosses": [
                            "Rivière d'Irlande qui traverse les villes de Dunmore, Milltown et Claregalway."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": []
                    },
