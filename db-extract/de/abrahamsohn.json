                ],
                "senses": [
                    {
                        "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                        "entry_id": "58e447e3-ce41-39fa-bcb7-2955dfbbd4ee",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a2364d9-3969-4c05-9023-473c338005cd",
                                "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                                "text": "Frau Abrahamsohn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "39c59f00-dffc-4152-a18b-0df9f400aadb",
                                "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                                "text": "Herr Abrahamsohn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "df51aed4-1979-4b90-8fee-1cb03a75d5c8",
                                "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                                "text": "Die Abrahamsohns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "11d0c1de-2a25-4ff1-b2b3-943ae01ecb4b",
                                "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                                "text": "Der Abrahamsohn trägt nie die Schals, die die Abrahamsohn ihm strickt."
                            },
                            {
                                "example_id": "40586668-a4df-4090-b322-ee1e8b8cf8fc",
                                "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Abrahamsohn kommt, geht der Herr Abrahamsohn.“"
                            },
                            {
                                "example_id": "84868ba7-5e84-49e4-af34-f9d3ea6e7e6f",
                                "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                                "text": "Abrahamsohn kommt und geht."
                            },
                            {
                                "example_id": "065ba78f-b2f8-484f-9377-6f33ea027818",
                                "sense_id": "5afe31ab-2feb-3781-85eb-37e3c3fc7999",
                                "text": "Abrahamsohns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
