                "senses": [
                    {
                        "sense_id": "e48da284-4f95-3f6d-8065-7780805f130c",
                        "entry_id": "1aefba69-9b3d-3ee3-babe-b8e2b10f6fb0",
                        "glosses": [
                            "Ballungsraum in Nordrhein-Westfalen, Gebiet zwischen dem Kreis Wesel (mit Xanten) und Duisburg im Westen und Hamm, Hagen und Kreis Unna sowie dem Ennepe-Ruhr-Kreis im Osten. Das Gebiet umfasst die Flüsse Rhein, Lippe und Ruhr mit etwa 5,3 Millionen Einwohnern"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "22428a05-11e2-425e-9756-e438640cb3a7",
                                "sense_id": "e48da284-4f95-3f6d-8065-7780805f130c",
                                "text": "„Der Mann, der in der deutschen Nationalmannschaft spielt und bei Real Madrid sein Geld verdient, ist im Ruhrpott geboren.“"
                            },
                            {
                                "example_id": "0323c87c-00a9-449e-bbbe-f8746c9ec8c6",
                                "sense_id": "e48da284-4f95-3f6d-8065-7780805f130c",
                                "text": "„Wir Kinder im Ruhrpott haben die Berliner Türken dagegen immer beneidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
