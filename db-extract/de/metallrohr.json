                "senses": [
                    {
                        "sense_id": "857516aa-a4d1-39c9-b745-942e8b0d2b87",
                        "entry_id": "ba5445bd-03fb-3e75-9e18-234c1786aa70",
                        "glosses": [
                            "aus Metall hergestelltes Rohr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed6f884-409a-4492-87d8-77e84a6fee5c",
                                "sense_id": "857516aa-a4d1-39c9-b745-942e8b0d2b87",
                                "text": "„Der 52-Jährige hatte - anscheinend bei Sexspielen - seinen Penis in ein Metallrohr gesteckt und nicht mehr herausbekommen.“"
                            },
                            {
                                "example_id": "50000e19-45b8-424c-9fab-ace0208ee18e",
                                "sense_id": "857516aa-a4d1-39c9-b745-942e8b0d2b87",
                                "text": "„Ein dünnes Metallrohr lief etwa einen Meter über dem Boden die gesamte hintere Wand entlang; Wasser tröpfelte aus kleinen, ins Metall hineingebohrten Löchern.“"
                            },
                            {
                                "example_id": "15368175-7620-44b8-b411-8e6b96a587c0",
                                "sense_id": "857516aa-a4d1-39c9-b745-942e8b0d2b87",
                                "text": "„Dazu verwendete er eine selbst gebaute Abschussvorrichtungen aus senkrecht aufgestellten Metallrohren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
