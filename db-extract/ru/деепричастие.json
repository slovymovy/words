                            {
                                "example_id": "bad3fbc4-2d18-413a-aee7-e1a0af3d0b5b",
                                "sense_id": "550ce18d-6a0b-3656-95dc-e35b8c2a9e87",
                                "text": "Сло́во «чита́я» — э́то дееприча́стие настоя́щего вре́мени",
                                "translation": "The word “чита́я” (“while reading”) is a present adverbial participle (from чита́ть (čitátʹ)).",
                                "english": "The word “чита́я” (“while reading”) is a present adverbial participle (from чита́ть (čitátʹ))."
                            },
                            {
                                "example_id": "a5257d55-3390-46db-a0eb-19735972bda5",
                                "sense_id": "550ce18d-6a0b-3656-95dc-e35b8c2a9e87",
                                "text": "Сло́во «прочита́в» — э́то дееприча́стие проше́дшего вре́мени",
                                "translation": "The word “прочита́в” (“having read”) is a past adverbial participle (from чита́ть (čitátʹ).)",
                                "english": "The word “прочита́в” (“having read”) is a past adverbial participle (from чита́ть (čitátʹ).)"
                            }
                        ]
