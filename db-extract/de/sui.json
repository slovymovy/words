                        "translation_id": "26d6d315-9d0f-40a9-bba9-94eff24c68bc",
                        "source_entry_id": "4feeaf0f-d337-3a89-a863-0d69e20650b0",
                        "source_sense_id": "62337190-f388-3855-a7fe-00d171bd3838",
                        "source_sense_description": "Ort in Belutschistan",
