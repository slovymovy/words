                        "glosses": [
                            "Bahamainsel, auf der Christoph Kolumbus 1492 erstmals den Boden Amerikas betrat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9ec1e4a-ee7c-4d08-92fc-ba704285c3e5",
                                "sense_id": "ba70202a-a6fc-3de3-a263-2f6f584fcf36",
                                "text": "„Ihre genaue Lage bleibt bis heute umstritten, die Bewohner nannten sie Guanahani.“"
                            },
                            {
                                "example_id": "43eb5f6b-e757-4ea7-9f1d-8b62b8bdbdc1",
                                "sense_id": "ba70202a-a6fc-3de3-a263-2f6f584fcf36",
                                "text": "„Seit dem Tag von Guanahani 1492 hatten sich die Hoffnunngen auf die Entdeckung des Seewegs zu sagenhaften Goldländern des Ostens nicht erfüllt.“"
                            }
                        ],
