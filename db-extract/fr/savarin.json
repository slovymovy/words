                ],
                "senses": [
                    {
                        "sense_id": "f9226da8-77c1-32ea-b599-82edac58524d",
                        "entry_id": "5d8c7299-96d6-3f60-a799-fc36a81fe4f7",
                        "glosses": [
                            "Gâteau moelleux généralement en forme de couronne, proche du baba au rhum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efaf74b4-c28e-4294-b2e2-aaab05357c9f",
                                "sense_id": "f9226da8-77c1-32ea-b599-82edac58524d",
                                "text": "Elle suivait la rue Turbigo, revenait dix fois, pour passer devant les gâteaux aux amandes, les saint-honoré, les savarins, les flans, les tartes aux fruits, les assiettes de babas, d’éclairs, de choux à la crème."
                            },
                            {
                                "example_id": "12ee92a5-2b01-4ad0-b821-3773f90462f0",
                                "sense_id": "f9226da8-77c1-32ea-b599-82edac58524d",
                                "text": "Il laissait musiquer les noms enchanteurs qui avaient résonné autrefois à son oreille : linzer, colisées, pithiviers, souvaroffs, reine-de-saba, sultane, savarins, colombiers de la Pentecôte…"
                            },
                            {
                                "example_id": "95180477-947f-4bdd-96c6-495d91178d39",
                                "sense_id": "f9226da8-77c1-32ea-b599-82edac58524d",
                                "text": "De Paris au Pérou, de Londre a Navarin,\nDu Danube à la Loire, et du Nil jusqu'au Rhin,\nS’il existe un gâteau délicat, souverain,\nIl n’en existe qu’un, et c’est le Savarin."
                            }
                        ]
                    }
                ],
