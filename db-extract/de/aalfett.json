                        "form": "die Aalfette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "effb970a-ab57-3680-9061-7305ed8daf82",
                        "entry_id": "3c2dd6de-86da-3a67-b493-68e9ea269b5e",
                        "glosses": [
                            "in der Medizin eingesetztes, aus dem Aal gewonnenes Fett"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "01e3385c-0b9b-4839-ae8f-1aa07396c395",
                                "sense_id": "effb970a-ab57-3680-9061-7305ed8daf82",
                                "text": "„Es solle auch das frische Kraut mit Aalfett angebrüht, und in die Sonne gestellt, ein trefliches Mittel wider die Schwierigkeiten des Gehörs seyn.“"
                            },
                            {
                                "example_id": "006f242e-f0a1-40aa-951f-f5531d81d7bb",
                                "sense_id": "effb970a-ab57-3680-9061-7305ed8daf82",
                                "text": "„Es werden 4 Loth Aalfett, das nicht ausgebraten, sondern nach dem Schlachten aus dem Aal genommen ist, in einem glasirten Gefäße mit 2 Lth. Rosmarinöl und 1 Lth. Thymianöl unter gelinder Wärme zerlassen.“"
                            },
                            {
                                "example_id": "71405782-691e-4c9f-b669-0796bcd6d4cf",
                                "sense_id": "effb970a-ab57-3680-9061-7305ed8daf82",
                                "text": "„Das reine Aalfett, äusserlich gegen Gicht empfohlen.“"
                            },
                            {
                                "example_id": "0ed092d9-1371-4d41-afcf-fe47aedeb3d3",
                                "sense_id": "effb970a-ab57-3680-9061-7305ed8daf82",
                                "text": "„Aalfett wird in der Medicin verbraucht als Adeps Anguillarum.“"
                            },
                            {
                                "example_id": "2c85f7fe-2ef2-48fd-bdfd-594586bb6fe0",
                                "sense_id": "effb970a-ab57-3680-9061-7305ed8daf82",
                                "text": "„Dann soll er Betonienkraut, dreimal so viel Liebstöckel und etwas Aalfett nehmen, in Wein kochen und durch ein Tuch seihen, in diesen Wein das erwähnte Pulver hineingiessen und so trinken“"
                            },
                            {
                                "example_id": "3d0d08ee-1fea-4051-ac1b-be8a848adbbc",
                                "sense_id": "effb970a-ab57-3680-9061-7305ed8daf82",
                                "text": "„Um Neermoor träufelte man gegen Schwerhörigkeit Aalfett in die Ohren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
