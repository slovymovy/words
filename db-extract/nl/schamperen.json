                                            {
                                                "example_id": "5641491c-e90a-497f-8665-9a3edd9c3929",
                                                "sense_id": "50294643-151e-3826-9c23-e153fe59cb14",
                                                "text": "Lunch for the busy has become a quick scoff of processed, terrifyingly orange couscous, […]"
                                            }
                                        ]
