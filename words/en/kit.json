                                "target_lang_word": "uitrusting",
                                "target_lang_sense_clarification": "benodigdheden voor een taak of reis"
                            },
                            {
                                "target_lang_word": "pakket",
                                "target_lang_sense_clarification": "een samengestelde set benodigdheden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fd79a76-3704-357a-ae63-a3e6f991c71a",
                    "sense_definition": "The standard set of clothing and equipment worn by players of a sports team.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The football team wore their new red <w>kit</w> for the final match.",
                            "target_lang_translations": {
                                "ru": "Футбольная команда надела свою новую красную <w>форму</w> на финальный матч.",
                                "zh": "足球队在决赛中穿上了他们崭新的红色<w>队服</w>。",
                                "nl": "Het voetbalteam droeg hun nieuwe rode <w>tenue</w> voor de finale."
                            }
                        },
                        {
                            "text": "You need to wash your gym <w>kit</w> after school.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно постирать свою спортивную <w>форму</w> после школы.",
                                "zh": "放学后你需要把你的体育<w>装备</w>洗一下。",
                                "nl": "Je moet je <w>gymkleding</w> wassen na school."
                            }
                        }
                    ],
                    "common_phrases": [
                        "football kit",
                        "home kit",
                        "away kit",
                        "gym kit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартный набор одежды и снаряжения для игроков спортивной команды.",
                        "zh": "运动队队员穿着的标准服装和装备。",
                        "nl": "De standaardset kleding en uitrusting die door spelers van een sportteam wordt gedragen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форма",
                                "target_lang_sense_clarification": "спортивная одежда"
                            },
                            {
                                "target_lang_word": "экипировка",
                                "target_lang_sense_clarification": "снаряжение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "队服",
                                "target_lang_sense_clarification": "运动队统一服装"
                            },
                            {
                                "target_lang_word": "装备",
                                "target_lang_sense_clarification": "运动器材或服装"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tenue",
                                "target_lang_sense_clarification": "sportkleding van een team"
                            },
                            {
                                "target_lang_word": "uitrusting",
                                "target_lang_sense_clarification": "sportkleding en beschermende middelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e986e741-24a6-38df-b0d6-59c5a4071e3f",
                    "sense_definition": "A set of separate parts sold together to be assembled by the buyer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "assembly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I built this model airplane from a <w>kit</w> I bought at the hobby shop.",
                            "target_lang_translations": {
                                "ru": "Я собрал эту модель самолета из <w>набора</w>, который купил в магазине хобби.",
                                "zh": "我用在模型店买的<w>拼装套件</w>组装了这架飞机模型。",
                                "nl": "Ik heb dit vliegtuigmodel gebouwd van een <w>bouwpakket</w> dat ik in de hobbywinkel kocht."
                            }
                        },
                        {
                            "text": "The furniture comes in a <w>kit</w> with all the necessary screws.",
                            "target_lang_translations": {
                                "ru": "Мебель поставляется в <w>комплекте</w> со всеми необходимыми винтами.",
                                "zh": "这件家具是以<w>组装套件</w>的形式出售的，里面包含了所有必要的螺丝。",
                                "nl": "Het meubelstuk wordt geleverd als <w>bouwpakket</w> met alle benodigde schroeven."
                            }
                        }
                    ],
                    "common_phrases": [
                        "model kit",
                        "assembly kit",
                        "kit car"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор отдельных деталей, продаваемых вместе для сборки покупателем.",
                        "zh": "成套出售、供购买者自行组装的零件集合。",
                        "nl": "Een set losse onderdelen die samen worden verkocht om door de koper in elkaar te worden gezet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "для сборки, моделирования"
                            },
                            {
                                "target_lang_word": "конструктор",
                                "target_lang_sense_clarification": "сборная модель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拼装套件",
                                "target_lang_sense_clarification": "用于组装的零件"
                            },
                            {
                                "target_lang_word": "模型",
                                "target_lang_sense_clarification": "拼装模型"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bouwpakket",
                                "target_lang_sense_clarification": "set onderdelen om zelf in elkaar te zetten"
                            },
                            {
                                "target_lang_word": "modelbouwset",
                                "target_lang_sense_clarification": "specifiek voor het bouwen van modellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36086755-3bda-3fa3-a7c4-ad54c5993fc5",
                    "sense_definition": "A set of drums and cymbals arranged to be played by one person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drummer sat behind his <w>kit</w> and started to play a beat.",
                            "target_lang_translations": {
                                "ru": "Барабанщик сел за свою <w>установку</w> и начал играть ритм.",
                                "zh": "鼓手坐在他的<w>架子鼓</w>后，开始打起节奏。",
                                "nl": "De drummer zat achter zijn <w>drumstel</w> en begon een ritme te spelen."
                            }
                        },
                        {
                            "text": "He bought a new electronic drum <w>kit</w> to practice quietly.",
                            "target_lang_translations": {
                                "ru": "Он купил новую электронную ударную <w>установку</w>, чтобы репетировать тихо.",
                                "zh": "他买了一套新的电子<w>架子鼓</w>以便安静地练习。",
                                "nl": "Hij kocht een nieuw elektronisch <w>drumstel</w> om in stilte te kunnen oefenen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drum kit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор барабанов и тарелок, расставленных для игры одним человеком.",
                        "zh": "由一人演奏的一套鼓和镲。",
                        "nl": "Een set trommels en bekkens die zo is opgesteld dat deze door één persoon kan worden bespeeld."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "установка",
                                "target_lang_sense_clarification": "ударная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "架子鼓",
                                "target_lang_sense_clarification": "打击乐器组合"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "drumstel",
                                "target_lang_sense_clarification": "het instrument zelf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd28035b-cb26-33fe-b70c-c29ee5bff9e0",
                    "sense_definition": "The young of certain animals, such as the fox, beaver, or ferret.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A fox <w>kit</w> waited near the den for its mother to return.",
                            "target_lang_translations": {
                                "ru": "Лисий <w>детёныш</w> ждал у норы возвращения матери.",
                                "zh": "一只狐狸<w>幼崽</w>在洞穴附近等待母亲回来。",
                                "nl": "Een vossen<w>welp</w> wachtte bij het hol tot zijn moeder terugkwam."
                            }
                        },
                        {
                            "text": "The beaver <w>kit</w> is learning how to swim.",
                            "target_lang_translations": {
                                "ru": "<w>Детёныш</w> бобра учится плавать.",
                                "zh": "那只海狸<w>幼崽</w>正在学习游泳。",
                                "nl": "Het bever<w>jong</w> leert hoe het moet zwemmen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Детёныш определенных животных, таких как лиса, бобр или хорек.",
                        "zh": "某些动物（如狐狸、海狸或雪貂）的幼崽。",
                        "nl": "Het jong van bepaalde dieren, zoals de vos, bever of fret."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детёныш",
                                "target_lang_sense_clarification": "животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幼崽",
                                "target_lang_sense_clarification": "动物幼体"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "jong",
                                "target_lang_sense_clarification": "algemene term voor een dierenbaby"
                            },
                            {
                                "target_lang_word": "welp",
                                "target_lang_sense_clarification": "specifiek voor vossen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4761fc77-57df-3551-af49-c8256d69ab23",
                    "sense_definition": "Clothing or personal effects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took his <w>kit</w> off and jumped into the pool.",
                            "target_lang_translations": {
                                "ru": "Он снял с себя <w>одежду</w> и прыгнул в бассейн.",
                                "zh": "他脱掉<w>衣服</w>跳进了游泳池。",
                                "nl": "Hij trok zijn <w>kleding</w> uit en sprong in het zwembad."
                            }
                        },
                        {
                            "text": "Get your <w>kit</w> on, we are leaving in five minutes.",
                            "target_lang_translations": {
                                "ru": "Надевай свои <w>шмотки</w>, мы уходим через пять минут.",
                                "zh": "快穿上你的<w>行头</w>，我们五分钟后出发。",
                                "nl": "Trek je <w>kleren</w> aan, we vertrekken over vijf minuten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get your kit off"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одежда или личные вещи.",
                        "zh": "衣服或个人物品。",
                        "nl": "Kleding of persoonlijke bezittingen."
                    },
                    "translations": {
