                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d39d7b3-e8a8-48fc-9deb-5af5e9622486",
                                "sense_id": "9f00ee52-8cba-315c-8bf8-76b73b141856",
                                "text": "Poczwórne działo frach­towca wypa­liło i zdjęło przeciwników – dwóch obró­ciło w pył, a trzeciego, tego zmo­dy­fi­ko­wa­nego, posłało po spi­rali w otwartą przestrzeń"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
