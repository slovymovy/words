                "senses": [
                    {
                        "sense_id": "23bd160a-e11e-3e6f-b7ec-5a013ea5ef42",
                        "entry_id": "4358a64e-9134-3c14-9605-2708e75eb5d0",
                        "glosses": [
                            "schmaler Landstreifen, der auf zwei Seiten von Wasser umgeben ist und zwei größere Landmassen miteinander verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798f9e57-af94-4a71-a82c-8afc33785052",
                                "sense_id": "23bd160a-e11e-3e6f-b7ec-5a013ea5ef42",
                                "text": "Ein Isthmus stellt meist den günstigsten Ort für den Bau von Transportwegen und Verteidigungsanlagen dar."
                            },
                            {
                                "example_id": "3fe37484-4f25-4a18-a9bc-5afb478ab0a5",
                                "sense_id": "23bd160a-e11e-3e6f-b7ec-5a013ea5ef42",
                                "text": "„Und ich habe gehört, daß sie dort sogar die seltenste und eigenartigste aller Blumen haben, die wundervolle Espiritu Santo, wie die Spanier sie nennen - oder die Blume des Heiligen Geistes -, obwohl ich dachte, sie gedeihe nur in Mittelamerika in der Gegend des Isthmus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
