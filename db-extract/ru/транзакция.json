                                    {
                                        "sense_id": "0f2fdf79-8634-34f0-b7b1-1fdefaa0d24b",
                                        "entry_id": "6272ad1d-a971-3952-839e-cbf38ea4be57",
                                        "glosses": [
                                            "operacja handlowa związana z kupnem lub sprzedażą towarów bądź usług"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "05972525-e265-3aec-b83b-d0506e5a808d",
                                        "entry_id": "6272ad1d-a971-3952-839e-cbf38ea4be57",
                                        "glosses": [
                                            "grupa operacji, które razem wszystkie są wycofywane, np. jeśli choć jedna z nich zakończy się błędem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "180cb703-c4c3-40c3-8b05-819f6f4befc9",
                                                "sense_id": "05972525-e265-3aec-b83b-d0506e5a808d",
                                                "text": "Jeśli którakolwiek modyfikacja wchodząca w skład transakcji nie powiedzie się, dochodzi do unieważnienia również wszystkich innych modyfikacji"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
