                "senses": [
                    {
                        "sense_id": "e3c2b9dc-4a14-3895-bdfd-19d8e407605f",
                        "entry_id": "e37c2a90-1b4b-3328-9fc9-e819f08bdfe4",
                        "glosses": [
                            "(anhaltende) Tätigkeit des Ausraubens unter Androhung von Gewalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0505e79-56ed-48b6-94ae-f7e8022318fd",
                                "sense_id": "e3c2b9dc-4a14-3895-bdfd-19d8e407605f",
                                "text": "„Der Marchese sprach Chigi nun direkt an, und man plauderte über das beschwerliche Reisen, die zunehmende Wegelagerei und die politische Situation in Florenz, die im Grunde nichts anderes als politische Wegelagerei der Medici sei, wie Gonzaga meinte.“"
                            },
                            {
                                "example_id": "1011c10e-3c7d-42ea-89e5-b7092f68edbf",
                                "sense_id": "e3c2b9dc-4a14-3895-bdfd-19d8e407605f",
                                "text": "„Als moderne Wegelagerei empfindet mancher Verkehrsteilnehmer das Kontrollverhalten der Polizei und der Behörden bei Geschwindigkeits-, Abstandsmessungen und sonstigen Kontrollen an deren Ende eine kostenpflichtige Verwarnung, ein Bußgeldbescheid oder schlimmstenfalls eine strafrechtliche Verurteilung stehen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
