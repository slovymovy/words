                        "sense_id": "3c9cfef9-e2b4-368f-bf61-030cede5696f",
                        "entry_id": "f2b91b18-5d05-3d1e-a5f5-c73522283b39",
                        "glosses": [
                            "aangebracht vlak van stevig materiaal, bestemd voor een vermelding hoe iets of iemand wordt genoemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eadcacd-96e6-4904-b7da-545331ff01f8",
                                "sense_id": "3c9cfef9-e2b4-368f-bf61-030cede5696f",
                                "text": "De naamplaat aan de Jip Golsteijnbrug leek aan vervanging toe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd122f0b-3367-4d93-a256-67f7f7d426c6",
                        "source_entry_id": "f2b91b18-5d05-3d1e-a5f5-c73522283b39",
                        "source_sense_id": "3c9cfef9-e2b4-368f-bf61-030cede5696f",
                        "target_lang_word": "Namensschild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namensschild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                        "entry_id": "2845e59f-502c-3301-a21a-d2ca4bd9fd99",
                                        "glosses": [
                                            "an einem Gegenstand befestigte kleine beschriftete Platte zur Erläuterung (etwa an Denkmälern der Name des Dargestellten, des Künstlers, an Gebäuden die Namen der Bewohner, der ansässigen Firma)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc415ff7-037a-4a41-986c-136c56a04cfb",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "Jetzt wohnen wir schon seit zwei Wochen hier und haben immer noch kein neues Namensschild an der Haustür angebracht."
                                            },
                                            {
                                                "example_id": "801bad8d-fdf9-4416-8a67-45ac22bcd8f7",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„Staszek ging hinaus und versuchte das Namensschild zu entziffern und drückte gegen die Tür.“"
                                            },
                                            {
                                                "example_id": "bd42e52f-ee6c-484a-984c-8297c6417f18",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„Während seines Versuchs, das Namensschild zu entziffern, hatte Almuth die Tür geöffnet.“"
                                            },
                                            {
                                                "example_id": "b1087fd9-e9ad-4cb4-a303-2e9e81442c00",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„An der Tür zu den Büroräumen, wo Felber jetzt die Anwaltspraxis führte, befand sich noch das alte Namensschild.“"
                                            },
                                            {
                                                "example_id": "8ecb5b95-9d33-4700-b7e8-3811b228ae84",
                                                "sense_id": "88c4ef60-f2ce-30a6-84a5-eb465d3e0cc9",
                                                "text": "„Ein Namensschild an der Tür mit Titel erscheint vielen als ein Zeichen von Arroganz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                        "entry_id": "2845e59f-502c-3301-a21a-d2ca4bd9fd99",
                                        "glosses": [
                                            "an der Kleidung befestigtes Schildchen, um den Hals getragene Karte oder Ähnliches mit dem Namen des Trägers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "523f572f-7e16-45a8-808c-c889274d68f4",
                                                "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                                "text": "Tragen eigentlich alle Polizisten Namensschilder?"
                                            },
                                            {
                                                "example_id": "6a802b0d-5be2-4aee-987c-1ae82ba98856",
                                                "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                                "text": "„Wir sollten Namensschilder malen.“"
                                            },
                                            {
                                                "example_id": "01432baa-fdbf-4a07-8ae8-29b32efa9b05",
                                                "sense_id": "819724d5-a649-30a1-ae66-7d0b5e94749e",
                                                "text": "„Sie zeigt auf ihr Namensschild, das sie an ihrer weißen Bluse trägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
