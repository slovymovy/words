                    {
                        "translation_id": "ba98e54a-5e34-443e-b752-b6f99234325a",
                        "source_entry_id": "e5a3c463-358e-323b-9c57-a08b76ecc7a8",
                        "source_sense_description": "pump which draws gas through a liquid",
                        "target_lang_word": "aspirateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspirateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "861a5d58-3bc3-3692-bcd5-dd890bed6fa3",
                                        "entry_id": "02925e06-552d-37ef-bb38-5054edb1c63d",
                                        "glosses": [
                                            "Qui sert à aspirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ff3e11-d902-4e4a-9814-320d3c9a8019",
                                                "sense_id": "861a5d58-3bc3-3692-bcd5-dd890bed6fa3",
                                                "text": "La force aspiratrice de l'aspirateur."
                                            },
                                            {
                                                "example_id": "5886338f-1c57-4b3c-9f98-010f504f9da3",
                                                "sense_id": "861a5d58-3bc3-3692-bcd5-dd890bed6fa3",
                                                "text": "On attendait le Père Lathuile avec véhémence ; il se forma, au milieu de l’église, un vide aspirateur. L’auditoire avait soif du Père Lathuile ; l’auditoire était pendu à la chaire ; comme un jeune pourceau qui presse, mordille et secoue une tétine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aspirateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8828f694-3e5e-3c8b-ada7-ffcc44f6182e",
                                        "entry_id": "eab745a1-a51f-37ef-bb8f-539788c72477",
                                        "glosses": [
                                            "Appareil électroménager pneumatique servant à enlever les poussières dans les appartements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f77e63c4-65d5-49e5-848f-8ca023bbd767",
                                                "sense_id": "8828f694-3e5e-3c8b-ada7-ffcc44f6182e",
                                                "text": "Passer l’aspirateur, le balai, laver le sol peuvent fournir une occasion de faire de l’exercice physique de façon efficace : ils sollicitent à la fois les bras et les jambes."
                                            },
                                            {
                                                "example_id": "c26eaaaa-e730-45ac-8327-ce3cc01eb869",
                                                "sense_id": "8828f694-3e5e-3c8b-ada7-ffcc44f6182e",
                                                "text": "Mon voisin commence à disjoncter avec le confinement. Je l'ai vu parler à son chien… J'ai raconté ça à mon aspirateur, on était morts de rire!"
                                            },
                                            {
                                                "example_id": "bf533d5c-04a8-4c64-9a99-181010774e70",
                                                "sense_id": "8828f694-3e5e-3c8b-ada7-ffcc44f6182e",
                                                "text": "Elles sont élevées pour devenir de bonnes épouses, recevant des dînettes et des minicuisines comme cadeaux de Noël, de faux aspirateurs ou fers à repasser, des poussettes et des poupons."
                                            },
                                            {
                                                "example_id": "931b01a5-e7a8-4e3f-a86b-3108fa62fbaf",
                                                "sense_id": "8828f694-3e5e-3c8b-ada7-ffcc44f6182e",
                                                "text": "Il vous faut passer l’aspirateur sur la moquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "694c0bfc-ca61-30c5-9773-ead3611eb343",
                                        "entry_id": "eab745a1-a51f-37ef-bb8f-539788c72477",
                                        "glosses": [
                                            "Par métaphore, ce qui permet de collecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e66710bd-3595-4c87-9b75-88483bbec8db",
                                                "sense_id": "694c0bfc-ca61-30c5-9773-ead3611eb343",
                                                "text": "Souvent pratiques, parfois addictives, des applications utilisées par des millions de Français se révèlent être des aspirateurs à données personnelles, dont la géolocalisation. Elles circulent ensuite dans d'autres mains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
