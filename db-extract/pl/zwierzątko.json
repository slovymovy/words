                    {
                        "translation_id": "8d2ad003-220e-4890-8d59-fb071f6751da",
                        "source_entry_id": "ddf3b6c9-99e4-393d-aa78-8c8086385019",
                        "source_sense_id": "6563ffc8-f218-38a2-8e5a-123750207b8a",
                        "target_lang_word": "animalillo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "08ff206c-de40-46ef-9930-e40cde1485c4",
                        "source_entry_id": "ddf3b6c9-99e4-393d-aa78-8c8086385019",
                        "source_sense_id": "6563ffc8-f218-38a2-8e5a-123750207b8a",
                        "target_lang_word": "Tierchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tierchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                        "entry_id": "01f3126e-e6e5-3e76-a7ab-d67388a9d0fa",
                                        "glosses": [
                                            "kleines Tier, junges Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3dabbeb-e7bd-4732-a673-90503692a613",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "Die Kinder pflegten das verletzte Tierchen wieder gesund."
                                            },
                                            {
                                                "example_id": "a957090e-d927-4e8b-85d6-7f5b3509d130",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Der Wirt schmeckt an seiner Plombe, man muß den Stieglitz mehr ans Fenster rücken, solch Tierchen will auch ein bißchen Licht.“"
                                            },
                                            {
                                                "example_id": "f851dd53-5b4a-4d50-9cb0-7c0f31183260",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Uns, als künftigen Weltraumpassagieren, drängt sich die Frage auf, was die Tierchen unter diesen ungewöhnlichen Umständen bewogen haben mag, sich so kühn zu vermehren.“"
                                            },
                                            {
                                                "example_id": "76c336d2-381d-4ae8-bcaa-10de9ce89218",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Im Schrank roch es seltsam, und sie war sicher, dass allerlei Tierchen herumkrabbelten, aber dort konnte ihr niemand etwas anhaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
