                        ]
                    },
                    {
                        "translation_id": "2c00e1e3-ef36-427a-a82a-4e74169a8e84",
                        "source_entry_id": "cb18c51c-fa16-31a5-8a5e-b1536478aa9a",
                        "source_sense_description": "guard",
                        "target_lang_word": "Wärter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wärter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                        "entry_id": "66a245c1-1bc3-36cb-b369-9216834d9063",
                                        "glosses": [
                                            "Person, die etwas beaufsichtigt oder bewacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066a6da1-dbd5-4ce0-b93d-e7173bbca943",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "Die Wärter waren alle eingeschlafen."
                                            },
                                            {
                                                "example_id": "cca730d7-1dbf-415e-ba7d-c17af511443a",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Andere wandten ein, es werde die Gemeinde zehn Pfund und zwölf Schilling für die Kutsche und die Dienste eines Wärters kosten, das Mädchen zur Einschiffung nach London zu schaffen.“"
                                            },
                                            {
                                                "example_id": "412e101d-d06b-49fc-8a4a-50a140e53b1b",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Der Wärter hatte seinen Kopf gewaltsam dem Maler zugedreht.“"
                                            },
                                            {
                                                "example_id": "89ced730-5b63-4206-9d0d-14eb8d8e170c",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Bewacht wird die Zufahrt von zwei Wärtern in Tarnuniform, von denen einer auf einem Holzturm achtgibt, dass der Wald nirgends brennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec126030-91ef-4837-9c3b-6b98b9d6d5ed",
                        "source_entry_id": "cb18c51c-fa16-31a5-8a5e-b1536478aa9a",
                        "source_sense_description": "guard",
                        "target_lang_word": "Gefängniswärter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefängniswärter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                        "entry_id": "48bb14e2-7643-3760-824e-ee62d3377e24",
                                        "glosses": [
                                            "Mitglied des Sicherheitspersonals eines Gefängnisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b14b04-2af4-494d-93c1-f06b475ad81c",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "Sie überwältigten die Gefängniswärter und letztendlich gelang ihnen die Flucht."
                                            },
                                            {
                                                "example_id": "3388ac2d-507a-4e0f-8594-a0a39b194461",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "„Nie im Leben hätte ich der Zärtlichkeit, die sich in meinem Herzen angesammelt hatte, vor diesem Gorilla von einem Gefängniswärter, der hinter uns stand, Ausdruck verleihen können.“"
                                            },
                                            {
                                                "example_id": "14f8d788-3c7b-4c30-bd54-da35bb60c673",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "„Den Grund für all diese Veränderungen kann ich nicht nennen, aber ich weiß, dass der Gefängniswärter, als er das Tor hinter uns schloss, sagte, dass dies bis zum Ende des Krieges unser Zuhause sein würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4f3c0f2-7507-4374-96dc-92f47877dcc8",
                        "source_entry_id": "cb18c51c-fa16-31a5-8a5e-b1536478aa9a",
                        "source_sense_description": "guard",
                        "target_lang_word": "Wächter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wächter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                        "entry_id": "5f6c3e8e-7f78-393a-9be7-2b09c631b0df",
                                        "glosses": [
                                            "Person, die etwas oder jemanden bewacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98be2035-37c0-4384-b255-f0aedc8b8b0b",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "Der Wächter hat den Dieb auf frischer Tat ertappt."
                                            },
                                            {
                                                "example_id": "93368b81-7a79-4670-92ef-cebafe4762c9",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Zwei Wächter hielten den zum Gelage angereisten Fürsten an den Armen fest.“"
                                            },
                                            {
                                                "example_id": "ffe16304-b553-417f-8cef-06e677c3a304",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Ein junger Wächter eilt davon, während die mit Marderpelz und Rossleder bekleideten Skythen das mächtige Tor bestaunen.“"
                                            },
                                            {
                                                "example_id": "34f2a167-c059-438c-8962-172b11e76af4",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Der Wächter des Platzes wechselte häufig, weil kein halbwegs normaler Ordnungshüter dieses Zentrum einer entfesselten Jugend länger als höchstens ein Vierteljahr ertragen konnte.“"
                                            },
                                            {
                                                "example_id": "fb14d00d-131c-48ad-9e7b-2261d3df8a95",
                                                "sense_id": "cf337bb6-c261-3a7d-970d-89ec2c912b66",
                                                "text": "„Der Wächter war mir gleich aufgefallen, und nicht nur, weil er die Menge um Haupteslänge überragte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a776c5c6-bcfe-3cca-84e2-9171a0e9cf24",
                                        "entry_id": "5f6c3e8e-7f78-393a-9be7-2b09c631b0df",
                                        "glosses": [
                                            "technische Einrichtung, die eine Messgröße überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30bcdaa1-6e6e-438e-905f-a6a6a6419b80",
                                                "sense_id": "a776c5c6-bcfe-3cca-84e2-9171a0e9cf24",
                                                "text": "Der Wächter wurde manipuliert und lieferte so falsche Zahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
