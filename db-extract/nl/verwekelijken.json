                                                "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                                "text": "Il s’affaiblit."
                                            },
                                            {
                                                "example_id": "021728b9-abf9-4a75-85de-918b75b501e2",
                                                "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                                "text": "Son esprit, sa tête s’affaiblit."
                                            }
