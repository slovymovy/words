                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik erg ziek ben, <w>braak</w> ik meestal de hele dag.",
                            "target_lang_translations": {
                                "en": "When I am very sick, I usually <w>vomit</w> all day."
