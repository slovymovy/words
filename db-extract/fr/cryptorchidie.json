                                        "entry_id": "c918809b-8136-3310-8ad4-359812108692",
                                        "glosses": [
                                            "The failure of one or both testes to descend into the scrotum."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6eb5d3b-52cf-4148-8823-38ce08270db9",
                                                "sense_id": "e8523f4b-2ced-3411-a52d-01d3729d0d47",
                                                "text": "Other publications report a similar rate of 4–7%, but emphasize the influence of cryptorchidism, with which polyorchidism has been closely associated and which independently conveys an increased risk of testicular dysplasia [6], [9]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
