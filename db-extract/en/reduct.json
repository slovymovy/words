                                                "sense_id": "8e17bd17-56f0-3e9e-97e2-148cad3e7d44",
                                                "text": "Er verringerte seinen Einsatz."
                                            },
                                            {
                                                "example_id": "07353c63-1144-496e-b96d-8794467faeb5",
                                                "sense_id": "8e17bd17-56f0-3e9e-97e2-148cad3e7d44",
                                                "text": "Trink den Saft, der verringert deine Beschwerden."
                                            },
                                            {
                                                "example_id": "ab48e000-3c97-4739-b202-1f8855937301",
                                                "sense_id": "8e17bd17-56f0-3e9e-97e2-148cad3e7d44",
                                                "text": "Wenn wir die Anzahl Aushilfen verringern, werden wir unflexibler."
                                            },
                                            {
                                                "example_id": "7383c5d8-3003-42a1-b2c5-c3c1d552fefd",
                                                "sense_id": "8e17bd17-56f0-3e9e-97e2-148cad3e7d44",
                                                "text": "Man könnte den Verbrauch an Toilettenpapier noch deutlich verringern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43a88db7-d286-3754-bac0-acecbd583d18",
                                        "entry_id": "622d2540-3763-3eb3-88d7-3d8f91811624",
