                "senses": [
                    {
                        "sense_id": "265d6d5b-7d00-339a-8e99-115df2556180",
                        "entry_id": "31584921-e4e4-3f13-b1f2-2577afda6a32",
                        "glosses": [
                            "Donner un caractère franglais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c8b79d5-bac8-4dac-987a-c7a2be4f33bb",
                                "sense_id": "265d6d5b-7d00-339a-8e99-115df2556180",
                                "text": "Bro, comme le fameux Code, comme pour dire qu'on est entre copains, et parce qu'il faut bien frangliser la chose."
                            },
                            {
                                "example_id": "bbadfb74-05e0-4a03-b81a-18fb8e5bb676",
                                "sense_id": "265d6d5b-7d00-339a-8e99-115df2556180",
                                "text": "Mais c'est bien sûr, on allait « frangliser » !"
                            },
                            {
                                "example_id": "d81d94b1-3092-4d1c-8f31-1fd8edf41a3b",
                                "sense_id": "265d6d5b-7d00-339a-8e99-115df2556180",
                                "text": "Il y a des jours où je me dis : ce langage se franglise, il absorbe toutes les modes étrangères sans distinction, il en fait un pot-pourri."
                            }
                        ]
                    }
