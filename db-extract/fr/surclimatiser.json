                ],
                "senses": [
                    {
                        "sense_id": "dd605286-3f58-3af8-98bd-06fcd4490a3d",
                        "entry_id": "75255b7e-edce-3204-ad0b-9cb9dce97ab2",
                        "glosses": [
                            "Climatiser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94546a6d-8a7c-43f1-9631-20af0f672d8c",
                                "sense_id": "dd605286-3f58-3af8-98bd-06fcd4490a3d",
                                "text": "Il serait donc important de cesser de surchauffer en hiver et de surclimatiser en été et de reprendre l’habitude de porter des pulls, des tricots de corps."
                            },
                            {
                                "example_id": "089d629d-71ff-47e3-b94e-8ba0656aa131",
                                "sense_id": "dd605286-3f58-3af8-98bd-06fcd4490a3d",
                                "text": "Et puis, l’été venu, on évite de surclimatiser."
                            },
                            {
                                "example_id": "10e901a7-f518-4a4d-a7cc-fbf2dd8604f3",
                                "sense_id": "dd605286-3f58-3af8-98bd-06fcd4490a3d",
                                "text": "Ne pas \"surchauffer\" son logement, ne pas \"surclimatiser\" son intérieur, ne pas gaspiller son eau chaude sanitaire."
                            }
                        ]
                    }
                ],
