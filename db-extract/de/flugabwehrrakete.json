                "senses": [
                    {
                        "sense_id": "d93bb2a4-4435-3f99-aa1d-0d4bc66935b0",
                        "entry_id": "576643a7-e6d6-386e-abd9-b8cc7feadc83",
                        "glosses": [
                            "Rakete zur Bekämpfung von Luftzielen von der Erdoberfläche (der Wasseroberfläche) aus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01dad78c-cfe0-4de4-893d-a114590e6482",
                                "sense_id": "d93bb2a4-4435-3f99-aa1d-0d4bc66935b0",
                                "text": "Das in den Luftraum eingedrungene feindliche Flugzeug wurde von einer Flugabwehrrakete zerstört."
                            },
                            {
                                "example_id": "81bd93f0-076a-4086-b72f-cbaf58a85cac",
                                "sense_id": "d93bb2a4-4435-3f99-aa1d-0d4bc66935b0",
                                "text": "„Oder hat sich der Kampfjet hinter dem Zivilflugzeug versteckt und damit die Flugabwehrrakete zum falschen Ziel geleitet?“"
                            },
                            {
                                "example_id": "57aa3dc6-816f-4c85-baad-c62a9f8dfab7",
                                "sense_id": "d93bb2a4-4435-3f99-aa1d-0d4bc66935b0",
                                "text": "„Dies war das erste Mal in der Geschichte, dass eine Flugabwehrrakete von einem Raketenabwehrsystem aus dem Himmel geschossen wurde – das war der Knall in der Nacht zum Freitag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
