                                        "examples": [
                                            {
                                                "example_id": "0ee42db8-44a1-479f-8cdb-f5e72907a3ba",
                                                "sense_id": "33607cb7-5594-3099-97d7-7a63e922fa37",
                                                "text": "N’oublie pas de mettre un chapeau sur le premier e de bête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "123327af-b72a-33d4-9b3e-8405330f034b",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Chapeau de cardinal, dignité de cardinal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8d7113-a2ca-449a-80e3-1dab04fba690",
                                                "sense_id": "123327af-b72a-33d4-9b3e-8405330f034b",
                                                "text": "— Ah ! interrompit le Cardinal, je te vois venir : tu veux me rappeler son entêtement à ne pas te donner le chapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe7f1eb-35c5-310c-a9af-2096b4d263ba",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Se dit d'une variable surmontée d’un accent circonflexe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "003bf22f-d404-4ae2-b260-78f92eb9ec6d",
                                                "sense_id": "afe7f1eb-35c5-310c-a9af-2096b4d263ba",
                                                "text": "f-chapeau est l’estimateur des moindres carrés de f."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29fe6c2d-426d-3bba-ae60-08102eb74bc9",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Pièce de bois servant de plafond aux galeries de mine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dfb27cf-d110-4791-9e4c-53903c3ac9bd",
                                                "sense_id": "29fe6c2d-426d-3bba-ae60-08102eb74bc9",
                                                "text": "Un pareil cadre se compose de deux montant et d’un chapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138aa4e8-942d-39b8-b90f-79034ccee35d",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Élément de protection couvrant la sortie de toit d’une cheminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55430690-bb43-4825-ac2a-5d746bdca85f",
                                                "sense_id": "138aa4e8-942d-39b8-b90f-79034ccee35d",
                                                "text": "Le chapeau. J’avais oublié le chapeau de la cheminée sur le devis. Je ne sais pas pourquoi, j’oublie toujours les chapeaux. Là, vous rajoutez donc un chapeau RV80, la fixation RX3, vous faites le total hors taxes, voilà, et maintenant vous comptez la TVA à 5,5."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chapeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9564291b-09e8-32be-887c-b3f0ea261de6",
                                        "entry_id": "dcd96ba0-9827-3fb6-9c86-4ebd5876a5a2",
                                        "glosses": [
                                            "Pour exprimer l’admiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35e6ee91-d50d-4138-9714-31ad69284fdb",
                                                "sense_id": "9564291b-09e8-32be-887c-b3f0ea261de6",
                                                "text": "Quelle ambiance ! Franchement chapeau !"
                                            },
                                            {
                                                "example_id": "c6eb3c07-f504-4b34-95e3-d2e724e82acd",
                                                "sense_id": "9564291b-09e8-32be-887c-b3f0ea261de6",
                                                "text": "— Chapeau, mon pote, chapeau."
                                            },
                                            {
                                                "example_id": "47766513-a377-41e3-9057-c2601a3de3cf",
                                                "sense_id": "9564291b-09e8-32be-887c-b3f0ea261de6",
                                                "text": "Chapeau au ministre de la Santé, Christian Dubé, de l’avoir fait en toute candeur. En deuxième vague de la COVID-19, son aveu n’est pas anodin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16824b60-9c80-3cd6-a8f8-6f7d688e6c1f",
                                        "entry_id": "dcd96ba0-9827-3fb6-9c86-4ebd5876a5a2",
                                        "glosses": [
                                            "Pour souligner la désapprobation."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ea21b2b-4dec-48c4-ba61-a7a24ef253c6",
                                                "sense_id": "16824b60-9c80-3cd6-a8f8-6f7d688e6c1f",
                                                "text": "S’il vous suffit de lire une ligne d’un journaliste pour tirer des conclusions sur un joueur, eh bien chapeau !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf5f580-94eb-33b0-873b-b06388974ea8",
                                        "entry_id": "dcd96ba0-9827-3fb6-9c86-4ebd5876a5a2",
                                        "glosses": [
                                            "Pour demander à quelqu'un d'ôter son couvre-chef, parce qu'il gêne la vue ou pour respecter le savoir-vivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d79d0b7-c135-44f8-be98-49900b2f0a00",
                                                "sense_id": "0cf5f580-94eb-33b0-873b-b06388974ea8",
                                                "text": "Si un client entrait, le chapeau sur la tête, je criais : « Chapeau ! » et je jetais en l’air son couvre-chef."
                                            }
                                        ]
                                    }
                                ]
                            }
