                        "examples": [
                            {
                                "example_id": "5dff459f-12a3-4146-844f-136a234d6508",
                                "sense_id": "0c34ad6a-3a6f-3274-890c-646a1dd31dbc",
                                "text": "„Pumpspeicher nehmen im Wesentlichen nachts Energie auf (rosa) und speisen sie zur Abendspitze der Last wieder ein (blau).“"
