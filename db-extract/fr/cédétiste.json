                ],
                "senses": [
                    {
                        "sense_id": "f1391c18-c7b7-3b2e-b75a-185b4424f233",
                        "entry_id": "76aa29ef-cd83-3fcd-afc7-f594031f90ab",
                        "glosses": [
                            "Relatif à ce syndicat ou à ses membres."
                        ],
                        "tags": [
                            "France",
                            "Syndicalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "12f224d0-d2a9-4c9e-b55d-ffe607420d86",
                                "sense_id": "f1391c18-c7b7-3b2e-b75a-185b4424f233",
                                "text": "Le responsable cédétiste a pris sa retraite."
                            },
                            {
                                "example_id": "0efa4dc1-e75d-470d-9d0f-3fab841a98e5",
                                "sense_id": "f1391c18-c7b7-3b2e-b75a-185b4424f233",
                                "text": "Au regard de certains syndicats affiliés à la CMT, la proposition cédétiste fait « figure d’hérésie »."
                            },
                            {
                                "example_id": "dab02f1f-902d-4585-9372-665336507dc2",
                                "sense_id": "f1391c18-c7b7-3b2e-b75a-185b4424f233",
                                "text": "Et cette situation risque de se reproduire pour l’exercice 2024 : « Il n’y a pas de vision et pas de possibilité d’engager toutes les actions prévues », déplore le représentant cédétiste."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
