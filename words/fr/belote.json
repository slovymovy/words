            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21b55358-b80a-303a-bde0-44feeca480c6",
                    "sense_definition": "Jeu de cartes très populaire qui se joue à quatre personnes avec un jeu de trente-deux cartes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jeu de cartes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dimanche après-midi, nous aimons jouer à la <w>belote</w> en famille."
                        },
                        {
                            "text": "Ils ont organisé un grand tournoi de <w>belote</w> dans la salle des fêtes du village."
                        }
                    ],
                    "common_phrases": [
                        "jouer à la belote",
                        "partie de belote"
                    ]
                },
                {
                    "sense_id": "015423a4-34bb-3da3-8f1d-d5ba7ea040cf",
                    "sense_definition": "Combinaison formée par la dame et le roi d'atout dans la main d'un joueur, rapportant des points supplémentaires.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu de cartes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En jouant sa dame d'atout, elle a marqué vingt points grâce à la <w>belote</w>."
                        },
                        {
                            "text": "Il possédait la <w>belote</w> mais il a oublié de l'annoncer au bon moment."
                        }
                    ],
                    "common_phrases": [
                        "annoncer la belote"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "2019aafb-20bf-3318-9ee6-51ce56c6e6f6",
                    "sense_definition": "Annonce vocale obligatoire faite par un joueur lorsqu'il joue la première des deux cartes de la paire roi-dame d'atout.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu de cartes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lorsqu'il a posé son roi d'atout sur le tapis, il a immédiatement crié : « <w>Belote</w> ! »"
                        },
                        {
                            "text": "Le joueur a fièrement annoncé « <w>Belote</w> ! » avant d'abattre sa carte maîtresse."
                        }
                    ],
                    "common_phrases": [
