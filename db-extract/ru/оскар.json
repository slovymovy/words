                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0c65ba-882d-46bf-ae21-ad82925a927e",
                                "sense_id": "f3890300-42fc-34e6-ab52-67efeb7b2864",
                                "text": "Концерт в Большом зале консерватории джазмен Алексей Баташев посвятил Оскару Питерсону ― американскому пианисту, который, можно сказать, вывел джаз на филармоническую сцену 50 лет назад."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6cea5e2-e067-45d6-8f08-80e36889c6c8",
                        "source_entry_id": "4353c1a2-60d8-3364-89fc-683106ea8eb5",
                        "source_sense_id": "f3890300-42fc-34e6-ab52-67efeb7b2864",
                        "target_lang_word": "Oscar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
