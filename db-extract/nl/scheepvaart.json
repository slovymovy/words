                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32d0a061-875c-3140-8420-5605a47d7aa2",
                                        "entry_id": "b1d2eb82-9f80-3a45-982f-3de04582d34e",
                                        "glosses": [
                                            "Gesamtheit der Aktivitäten, die Reise, Transport und anderes mit einem Schiff betreffen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9e2590-76eb-4e6d-a815-c60a484524fe",
                                                "sense_id": "32d0a061-875c-3140-8420-5605a47d7aa2",
                                                "text": "In der Schifffahrt sagt man anstatt rechts „steuerbord“."
                                            },
                                            {
                                                "example_id": "a7d7b3e3-7111-4825-a0d6-6da6da2afc24",
                                                "sense_id": "32d0a061-875c-3140-8420-5605a47d7aa2",
                                                "text": "„Die Schifffahrt ist für 2,5 Prozent der globalen CO₂-Emissionen verantwortlich“ […]."
                                            },
                                            {
                                                "example_id": "6ae35423-0ce4-426c-ab6d-74bf90099e87",
                                                "sense_id": "32d0a061-875c-3140-8420-5605a47d7aa2",
                                                "text": "„Mit den Jahren entwickelte sich eine große Leidenschaft für die Schifffahrt und die Navigation.“"
                                            },
                                            {
                                                "example_id": "9f012f87-ed90-477e-8739-c82c4bce0c15",
                                                "sense_id": "32d0a061-875c-3140-8420-5605a47d7aa2",
                                                "text": "„Die Schifffahrt und der Handel machten Hamburg einst stolz und unabhängig.“"
                                            },
                                            {
                                                "example_id": "63545736-b2be-40c4-a738-402bf843d9fc",
                                                "sense_id": "32d0a061-875c-3140-8420-5605a47d7aa2",
                                                "text": "„Bei Bamako war die Schifffahrt auf dem Niger unterbrochen und wurde erst fünfzig Kilometer flussabwärts in Koulikoro wieder aufgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0bc9a770-da50-3881-93cd-0f53944b6b5d",
                                        "entry_id": "b1d2eb82-9f80-3a45-982f-3de04582d34e",
                                        "glosses": [
                                            "eine Reise oder Fahrt mit einem Schiff"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5369f7e8-249d-463b-99f5-426038382ba7",
                                                "sense_id": "0bc9a770-da50-3881-93cd-0f53944b6b5d",
                                                "text": "Mir wurde schlecht während der Schifffahrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "002234e5-78ee-45ee-a434-bb176b5dbb61",
                        "source_entry_id": "0e406450-d6ef-3a48-bc56-1264390585ae",
                        "source_sense_id": "d461b670-2084-325c-89fd-5663e9b6aaee",
