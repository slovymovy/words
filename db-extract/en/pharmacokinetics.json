                        "entry_id": "b4a32859-0249-3d7c-9e2e-9f9c8a8381be",
                        "glosses": [
                            "The particular rates at which drugs are absorbed, distributed, metabolized, and eliminated by the body."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9fc0410a-f16a-4005-a718-d39efec8c8ce",
                                "sense_id": "88b1c8a4-d368-36ab-8218-96bc8d7176ca",
                                "text": "Physiologic-based pharmocokinetic models are sometimes used to describe pharmocokinetics in laboratory animals, but they are seldom used to describe the pharmocokinetics of drugs used in humans."
                            }
                        ]
                    }
                ],
