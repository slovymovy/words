                        "translation_id": "41f15d24-70d9-4124-8c17-64a20855c9f9",
                        "source_entry_id": "177f17ca-1dff-37c9-8cea-154c01e6b2bb",
                        "source_sense_id": "44f8df96-7864-3ad5-8ed7-8d3eecd8dd7e",
                        "target_lang_word": "Lackschuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lackschuh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62e3491c-8f7b-38f1-8931-60a0bfe73744",
                                        "entry_id": "210222bc-a4eb-3d4e-936f-7542ca6dc05a",
                                        "glosses": [
                                            "Schuh, dessen Oberleder aus Lackleder besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd2293f-a79f-489b-a962-5b6c55923981",
                                                "sense_id": "62e3491c-8f7b-38f1-8931-60a0bfe73744",
                                                "text": "„Der verschwand nach der Feier übrigens gleich im Kleiderschrank, ganz im Gegensatz zu den Lackschuhen, die mich bei jedem Spaziergang verfolgten, solange sie passten.“"
                                            },
                                            {
                                                "example_id": "978a6b3c-ab99-4d3c-87da-09d0b7c2bf21",
                                                "sense_id": "62e3491c-8f7b-38f1-8931-60a0bfe73744",
                                                "text": "„Nun trug er schicke Anzüge mit Hahnentrittmuster, einen weißen Schal aus Kunstseide und Lackschuhe mit Gamaschen; er ließ sich ein Menjou-Bärtchen wachsen und die Nägel maniküren.“"
                                            },
                                            {
                                                "example_id": "bea14e49-498e-4321-996d-bcc6f1308ed1",
                                                "sense_id": "62e3491c-8f7b-38f1-8931-60a0bfe73744",
                                                "text": "„Mir brachte sie außerdem jedes Mal Lackschuhe mit, die viel zu hart waren und die ich wie ein Ausstellungsstück ins Bücherregal stellte.“"
                                            },
                                            {
                                                "example_id": "9005b656-0cbf-4934-91d1-d39493b94b31",
                                                "sense_id": "62e3491c-8f7b-38f1-8931-60a0bfe73744",
                                                "text": "„Sie zog sich um und streifte rote Lackschuhe über die Strümpfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
