                "senses": [
                    {
                        "sense_id": "6a916162-c894-3d9f-aa4f-4614330b62f8",
                        "entry_id": "ac3f8d34-2487-391b-8e8c-7005c9e25faa",
                        "glosses": [
                            "устар. запрещать, возбранять, заказывать, не давать делать что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d286b019-bd10-45f9-bfdf-081081b31d19",
                                "sense_id": "6a916162-c894-3d9f-aa4f-4614330b62f8",
                                "text": "Я тебе не бороню и не боранивал дела делать, а бороню дурить."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e45974a-36cc-3efd-a59f-7e03589e8e5c",
                        "entry_id": "ac3f8d34-2487-391b-8e8c-7005c9e25faa",
                        "glosses": [
                            "устар. защищать, отстаивать, оберегать, охранять, стеречь, блюсти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ce3539-4508-450f-91c8-8710af2ccb20",
                                "sense_id": "1e45974a-36cc-3efd-a59f-7e03589e8e5c",
                                "text": "Собаки нас от волков боронят."
                            },
                            {
                                "example_id": "77c8adcb-b101-4cde-be89-09bc6bf931d7",
                                "sense_id": "1e45974a-36cc-3efd-a59f-7e03589e8e5c",
                                "text": "Борони Бог пожара."
                            }
                        ]
                    }
