                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd95fc77-54eb-4f09-af00-143332140720",
                                "sense_id": "7212e056-3454-303b-a97c-ee46c77e7638",
                                "text": "Excavating with the suction dredge, the field crew located a parrel, and a second parrel was found a short distance away."
                            },
                            {
                                "example_id": "2b52ea06-3fa1-4854-a55f-bf3b2d4ff313",
                                "sense_id": "7212e056-3454-303b-a97c-ee46c77e7638",
                                "text": "The batten parrels are best made of large diameter polypropylene line because it slides well."
                            },
                            {
                                "example_id": "8fb653f5-c18a-4121-8d79-c7a130ea98e8",
                                "sense_id": "7212e056-3454-303b-a97c-ee46c77e7638",
                                "text": "The earliest form of parrel was probably a rope loosely lashed about the mast and yard."
