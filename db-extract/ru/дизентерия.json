                    },
                    {
                        "translation_id": "86432562-cf81-4f00-a7b6-e48a6a240f5c",
                        "source_entry_id": "f13edcc0-e06a-3d4b-bdf2-ca5731f35b24",
                        "source_sense_id": "1c8a1610-ae66-3edb-b180-c2c99d5db440",
                        "target_lang_word": "Dysenterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dysenterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "968273d5-bba6-361d-b848-8a351c00b574",
                                        "entry_id": "92981db5-8ec2-32cf-be96-5fe8f7b45faa",
                                        "glosses": [
                                            "durch eine Infektion des Darms verursachte Durchfallerkrankung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f1d8af4-89e6-4ba7-847d-311c5353b1c0",
                                                "sense_id": "968273d5-bba6-361d-b848-8a351c00b574",
                                                "text": "„Die verschiedenen Spielarten dieser Infektionskrankheit, auch Dysenterie genannt, werden von Amöben oder Stäbchenbakterien ausgelöst, die in den Heerlagern der Frühen Neuzeit ideale Bedingungen vorfanden.“"
                                            },
                                            {
                                                "example_id": "7a36e87b-6589-42ed-b3c6-f693bc18b451",
                                                "sense_id": "968273d5-bba6-361d-b848-8a351c00b574",
                                                "text": "„Die meisten von ihnen starben an der Roten Ruhr, der blutigen Erscheinungsform der Dysenterie.“"
                                            },
                                            {
                                                "example_id": "910fcb91-66ba-4d6e-8446-a68efdc515b2",
                                                "sense_id": "968273d5-bba6-361d-b848-8a351c00b574",
                                                "text": "„Das schlechte Essen und Epidemien, wie sie zu jedem Krieg gehören, verursachen eine Dysenterie, die ihn ungeheuer schwächt.“"
                                            },
                                            {
                                                "example_id": "2d80986e-645c-4d84-9204-63bf5d756c33",
                                                "sense_id": "968273d5-bba6-361d-b848-8a351c00b574",
                                                "text": "„Das Kleine Lager befand sich wegen Dysenterie unter einer losen Art von Quarantäne, und die SS kam selten herein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a517222-0471-33d0-b24c-ff9225a0d28c",
                                        "entry_id": "92981db5-8ec2-32cf-be96-5fe8f7b45faa",
                                        "glosses": [
                                            "Durchfallerkrankung, die durch Shigellen verursacht wird"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4bbd5c5-e4fa-47ee-851a-4cb3db95a446",
                                                "sense_id": "9a517222-0471-33d0-b24c-ff9225a0d28c",
                                                "text": "„Bei der Shigellenruhr (Shigellose, Bakterienruhr, bakterielle Ruhr, bakterielle Dysenterie) handelt es sich um eine akute fieberhafte Durchfallerkrankung, die sich vorwiegend im Dickdarm abspielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fe96bed-eeec-43cd-8147-d9acee2c84d4",
                        "source_entry_id": "f13edcc0-e06a-3d4b-bdf2-ca5731f35b24",
                        "source_sense_id": "1c8a1610-ae66-3edb-b180-c2c99d5db440",
                        "target_lang_word": "Ruhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "571babe4-6608-33c2-bab4-d43029da9243",
                                        "entry_id": "16a673fd-0214-3765-a9e6-371986d68c1f",
                                        "glosses": [
                                            "Infektionskrankheit des Darms"
                                        ],
                                        "tags": [
                                            "selten im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911d14f6-aa0f-4b69-8fc0-8083f9d6360e",
                                                "sense_id": "571babe4-6608-33c2-bab4-d43029da9243",
                                                "text": "„In den dreißiger Jahren hatte Eisenhower, das wußte Dr. Snyder, einmal an der Ruhr gelitten.“"
                                            },
                                            {
                                                "example_id": "f27aaf01-0b9f-4a75-abf6-5f3e80e5aaba",
                                                "sense_id": "571babe4-6608-33c2-bab4-d43029da9243",
                                                "text": "„Die Ruhr bricht aus, und für diejenigen, die daran erkranken, gibt es keine Hoffnung mehr.“"
                                            },
                                            {
                                                "example_id": "61cc86c2-b923-4864-8f1a-65ec535d8fc8",
                                                "sense_id": "571babe4-6608-33c2-bab4-d43029da9243",
                                                "text": "„Schließlich raffte ihn am 5. Juli 1929 die Ruhr dahin.“"
                                            },
                                            {
                                                "example_id": "21a679f6-b73a-43a7-ad99-3a5d90af3d68",
                                                "sense_id": "571babe4-6608-33c2-bab4-d43029da9243",
                                                "text": "„Mich überfällt die Ruhr nur wenige Tage nach der Geburt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ruhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aec7ef1a-913e-319a-92a7-e07958878d0b",
                                        "entry_id": "5a802f16-3f9c-3e43-a874-014369a10dc1",
                                        "glosses": [
                                            "rechter Nebenfluss des Rheins in Deutschland"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a6980d2-04bf-4eee-918c-9b37abdfa3ae",
                                                "sense_id": "aec7ef1a-913e-319a-92a7-e07958878d0b",
                                                "text": "Die Ruhr hat eine Länge von 219 km."
