        "nl-extract.jsonl": [
            {
                "entry_id": "75a2e4c7-6d56-348c-a81a-5b385a1f3c18",
                "word": "wegwissen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3f9ba51-3565-3164-937d-751d71c4d727",
                        "entry_id": "75a2e4c7-6d56-348c-a81a-5b385a1f3c18",
                        "glosses": [
                            "met een vegende beweging iets verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b20f4e0-1e57-434c-9d97-e7cab13c1e42",
                                "sense_id": "c3f9ba51-3565-3164-937d-751d71c4d727",
                                "text": "Ik ben gaan rondlopen en iets zei mij dat ik daar weg moest gaan. Ik vond dat ik sporen moest wegwissen. Ik had bloed op mijn handen”."
                            },
                            {
                                "example_id": "12f8e84d-c1fe-4b6d-92db-d9d6b08c87f6",
                                "sense_id": "c3f9ba51-3565-3164-937d-751d71c4d727",
                                "text": ",,De zaal stond op z’n kop,’’ zegt organisator Paul Gelen. ,,Het was een super, super, supermiddag. Waanzinnig. Soms moesten de zakdoeken de emotie wegwissen. Geweldig.’’ De zangers Thomas Berge en Marga Bult zaten in de jury."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b96d3df-1e5b-4afc-bc9e-248594bd5d88",
                        "source_entry_id": "75a2e4c7-6d56-348c-a81a-5b385a1f3c18",
                        "source_sense_id": "c3f9ba51-3565-3164-937d-751d71c4d727",
                        "source_sense_description": "verwijderen",
                        "target_lang_word": "delete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2753b304-8143-3b5f-a819-03bc0a067bff",
                                        "entry_id": "4267c160-ef15-351b-8a17-227604cf445f",
                                        "glosses": [
                                            "To remove, get rid of or erase, especially written or printed material, or data on a computer or other device."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42419024-d02c-4f52-b79e-fb6aaaf3467e",
                                                "sense_id": "2753b304-8143-3b5f-a819-03bc0a067bff",
                                                "text": "Early on in the model year [1968] Pontiac experienced some production problems [in producing polyurethane bumpers] regarding fit, matching paint color, and bonding the material to the base metal. As a result, 2,108 1968 GTOs left the factory with chrome bumpers borrowed from the LeMans. These cars had a special option on their order sheets called \"Endura bumper delete.\" Everyone wanted the Endura bumpers and no one ordered that option of his or her own free will. As soon as Pontiac worked out the production problems the chrome bumpers disappeared for good and \"Endura bumper delete\" disappeared from the option list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c359480-913d-3fa3-be16-546d778ad34d",
                                        "entry_id": "4267c160-ef15-351b-8a17-227604cf445f",
                                        "glosses": [
                                            "To defeat or dominate."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da8b83c3-c0c5-4169-8cef-6a02105ef7e3",
                                                "sense_id": "2c359480-913d-3fa3-be16-546d778ad34d",
                                                "text": "Also I got deleted by a rogue and druid who were both invisible and just popped up and cleaned me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42fb56c8-0378-3a81-9a77-c0d41102c904",
                                        "entry_id": "4267c160-ef15-351b-8a17-227604cf445f",
                                        "glosses": [
                                            "To kill or murder."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6acdb4b9-fc3c-4c38-be59-142950e9d8dd",
                                                "sense_id": "42fb56c8-0378-3a81-9a77-c0d41102c904",
                                                "text": "\"Go find this guy, Alex,\" Conch had said. \"And delete him.\""
                                            },
                                            {
                                                "example_id": "106b6f62-e759-4bcd-a150-62b92e4174ee",
                                                "sense_id": "42fb56c8-0378-3a81-9a77-c0d41102c904",
                                                "text": "\"[…]The less we discover about him, the more we are convinced he needs to be deleted...\"\n[…]\n\"Yes. In other words I kill a terrorist, right?\""
                                            },
                                            {
                                                "example_id": "56152d6b-4aaa-477e-b8f9-dbcaefe0c61e",
                                                "sense_id": "42fb56c8-0378-3a81-9a77-c0d41102c904",
                                                "text": "I'm a forty-something psychopath who thinks he has the right to delete anyone he sees fit."
                                            },
                                            {
                                                "example_id": "8147f08a-9d8e-4262-923b-2af9ae40bcc0",
                                                "sense_id": "42fb56c8-0378-3a81-9a77-c0d41102c904",
                                                "text": "She either felt pity for him and put him out of pain, a ridiculous, untrue solution for pity and sorrow are delusions, or she was part of his triangle had to delete him before he spoke again, he had to be silenced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "delete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "577ae788-fbb5-3425-8a4e-bf034826e6e7",
                                        "entry_id": "59b90faf-669f-302e-a698-111f514917c8",
                                        "glosses": [
                                            "A deletion."
