                                "target_senses": [
                                    {
                                        "sense_id": "ef8bc43e-bfe8-3e9c-a581-a9fb658b22cb",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A point or place where a check is performed, especially a point along a road or on a frontier where travellers are stopped for inspection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f82d61f-8221-4630-b737-94becc4b6a1d",
                                                "sense_id": "ef8bc43e-bfe8-3e9c-a581-a9fb658b22cb",
                                                "text": "The travellers were stopped at the checkpoint."
                                            },
                                            {
                                                "example_id": "042cfcb1-5d3f-4a23-972d-e4fa25097ebc",
                                                "sense_id": "ef8bc43e-bfe8-3e9c-a581-a9fb658b22cb",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nA few days later I ford the Jordan River on a bus: Foot travel across Allenby Bridge checkpoint is strictly prohibited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023dad88-ea92-30e3-83e5-ed84266512cc",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A situation, often represented by a point in time, at which the state of a database system is known to be valid, and to which it can be returned in the event of a crisis by using a combination of backups and logs; the data stored at this event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9eff31-e279-46cc-a950-6e764b86a15f",
                                                "sense_id": "023dad88-ea92-30e3-83e5-ed84266512cc",
                                                "text": "After the crash, we rolled back the database to the last checkpoint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c306a7f-64e4-3c8c-891d-d12aa8decdbf",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A predetermined point in a map, level or scenario that the player may resume from if they die or restart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8413909a-a1c2-4dae-b13f-1ab54667d9d1",
                                                "sense_id": "0c306a7f-64e4-3c8c-891d-d12aa8decdbf",
                                                "text": "You can't finish the race if you haven't passed all of the checkpoints on the track."
                                            },
                                            {
                                                "example_id": "3e5ff7bb-9967-4180-b45b-5b674249206a",
                                                "sense_id": "0c306a7f-64e4-3c8c-891d-d12aa8decdbf",
                                                "text": "This is not a videogame, this is real life! People get hurt! There is no restart from last checkpoint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d847e5-da80-3351-adcd-9f3df767070d",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A biological control mechanism ensuring correct progression through the cell cycle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
