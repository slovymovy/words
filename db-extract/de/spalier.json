                        ],
                        "form": "das Spalier"
                    },
                    {
                        "form_id": "6f4abeca-e47a-417a-ae58-c57269464355",
                        "entry_id": "1fbb90a7-4831-3b35-91e7-f9ebd3eae5b3",
                        "tags": [
                            "accusative",
