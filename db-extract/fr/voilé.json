                    }
                ],
                "senses": [
                    {
                        "sense_id": "6640bf04-6f70-36f0-a431-5454c8d4a500",
                        "entry_id": "620a2d47-2cc1-3366-8090-e4391945eb49",
                        "glosses": [
                            "Relatif à la voilure, aux voiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6944bfc-bd07-4b86-abd6-98f3d797a1eb",
                                "sense_id": "6640bf04-6f70-36f0-a431-5454c8d4a500",
                                "text": "Ce bâtiment est bien voilé, mal voilé."
                            },
                            {
                                "example_id": "351ab2b1-737c-43d7-a118-a97d3c730898",
                                "sense_id": "6640bf04-6f70-36f0-a431-5454c8d4a500",
                                "text": "Un bâtiment voilé en brick, en goélette."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed2bf4d8-b560-3d7e-a200-3aaa5058b422",
                        "entry_id": "620a2d47-2cc1-3366-8090-e4391945eb49",
                        "glosses": [
                            "Couvert d’un voile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1997d116-9241-4980-bb74-953922cffe7d",
                                "sense_id": "ed2bf4d8-b560-3d7e-a200-3aaa5058b422",
                                "text": "Une femme voilée."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9ba6b8a-72d5-35cf-8c35-15c26249434f",
                        "entry_id": "620a2d47-2cc1-3366-8090-e4391945eb49",
                        "glosses": [
                            "Portant le voile islamique, ou hidjab."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "1d1103b4-41a4-4c6a-9349-37c98e99b925",
                                "sense_id": "d9ba6b8a-72d5-35cf-8c35-15c26249434f",
                                "text": "Cependant, des situations problématiques vont perdurer dans des écoles, l'adoption de résolutions à l'amiable est parfois favorisées, alors que dans d'autres cas, des élèves voilées sont exclues pour prosélytisme et des grèves d'enseignants sont menées."
                            }
                        ]
                    },
                    {
                        "sense_id": "afe50d6f-16c2-3e00-bd4d-80444953486f",
                        "entry_id": "620a2d47-2cc1-3366-8090-e4391945eb49",
                        "glosses": [
                            "Couvert par tout autre obstacle qui rend l’objet moins visible, moins net."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a805a172-dcf6-42f2-9e91-371e1537d0ff",
                                "sense_id": "afe50d6f-16c2-3e00-bd4d-80444953486f",
                                "text": "La lune voilée de printemps montait sur la mer d’Ariaké."
                            }
                        ]
                    },
                    {
                        "sense_id": "86125945-8b3a-3749-9228-696c1e6428bc",
                        "entry_id": "620a2d47-2cc1-3366-8090-e4391945eb49",
                        "glosses": [
                            "Qui n’a qu’une partie de son timbre et de son éclat, en parlant de la voix ou d’un enregistrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ef4ce1-fc5e-406f-8239-c6e33e8f29ac",
                                "sense_id": "86125945-8b3a-3749-9228-696c1e6428bc",
                                "text": "— Moi, monsieur ? dit Marthe bouleversée par cette parole qui n’avait pas d’éclats et qui n’avait pas d’emportement, mais qui n’en était que plus terrifiante dans le ton voilé et discret qu’elle gardait toujours."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bcf35bf-6681-39d8-badd-f547bc40acea",
                        "entry_id": "620a2d47-2cc1-3366-8090-e4391945eb49",
                        "glosses": [
                            "Dont le négatif a été obscurci en partie ou en totalité par l’action accidentelle d’une lumière trop grande."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c79780b4-d565-3446-bfb2-4e02df04d60a",
                        "entry_id": "620a2d47-2cc1-3366-8090-e4391945eb49",
                        "glosses": [
                            "Pièce qui a un défaut ou qui a subi une déformation à la suite d'une utilisation au-delà de ses limites élastiques (gauchissement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddabae01-2ed0-454f-9b81-d6588b0ccaf7",
                                "sense_id": "c79780b4-d565-3446-bfb2-4e02df04d60a",
                                "text": "Le mécanicien a constaté que ma roue était voilée et m’a demandé si je n’avais pas heurté une bordure de trottoir."
                            },
                            {
                                "example_id": "ba667143-8c79-4957-b313-8d921ab69945",
                                "sense_id": "c79780b4-d565-3446-bfb2-4e02df04d60a",
                                "text": "Il faudra changer l’arbre d’entraînement de cette machine car il est voilé et cela va détériorer les roulements."
                            },
                            {
                                "example_id": "ad98c009-2584-4f9e-a10a-05274732d734",
                                "sense_id": "c79780b4-d565-3446-bfb2-4e02df04d60a",
                                "text": "Choisis une autre planche, celle-ci est voilée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
