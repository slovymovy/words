                "senses": [
                    {
                        "sense_id": "2e509a16-ff9d-3920-b301-079f0354a144",
                        "entry_id": "22f060de-390b-3cef-b13e-9e4e1ae379e3",
                        "glosses": [
                            "związany z Sasanidami, dynastią panującą w Iranie w latach 224-651 n.e."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d1f1ef-a629-4e65-b4db-e4f3bf5c1838",
                                "sense_id": "2e509a16-ff9d-3920-b301-079f0354a144",
                                "text": "Ekspansja imperium Arabów niedługo po śmierci proroka Mohammeda w 632 roku była zaiste niezwykła, wręcz niewiarygodna. Niewątpliwie sprzyjała tu Arabom długotrwała wojna między sasanidzką Persją a Cesarstwem Bizantyjskim (603-628), która całkowicie wyczerpała siły obu głównych potęg regionu; […]."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
