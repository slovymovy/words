{
    "word_family": [
        "houden",
        "houdbaarheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "862678a6-6edb-34b4-9206-9493a38c843d",
                    "sense_definition": "Een zekere tijd bestand tegen bederf",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze melk is nog lang <w>houdbaar</w> in de koelkast.",
                            "target_lang_translations": {
                                "en": "This milk will stay <w>good</w> for a long time in the fridge."
                            }
                        },
                        {
                            "text": "De moderne verwerking van verse melk maakt een veel <w>houdbaarder</w> product mogelijk.",
                            "target_lang_translations": {
                                "en": "Modern processing of fresh milk allows for a much more <w>shelf-stable</w> product."
                            }
                        }
                    ],
                    "synonyms": [
                        "vers"
                    ],
                    "common_phrases": [
                        "lang houdbaar",
                        "beperkt houdbaar"
                    ],
                    "target_lang_definitions": {
                        "en": "Able to be kept for a certain period without spoiling"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "perishable",
                                "target_lang_sense_clarification": "often used in negative contexts (e.g., non-perishable)"
                            },
                            {
                                "target_lang_word": "shelf-stable",
                                "target_lang_sense_clarification": "specifically for food that does not require refrigeration"
                            },
                            {
                                "target_lang_word": "long-lasting",
                                "target_lang_sense_clarification": "general term for items that remain good for a long time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34eafebd-eb97-303d-9cf9-0e0457bd07ab",
                    "sense_definition": "Geschikt om bewaard te worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gedroogd fruit is zeer <w>houdbaar</w> tijdens lange reizen.",
                            "target_lang_translations": {
                                "en": "Dried fruit is very <w>durable</w> during long trips."
                            }
                        },
                        {
                            "text": "Vacuüm verpakken maakt voedsel veel <w>houdbaarder</w>.",
                            "target_lang_translations": {
                                "en": "Vacuum packing makes food much more <w>storable</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Suitable for being stored or preserved"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "storable",
                                "target_lang_sense_clarification": "capable of being stored"
                            },
                            {
                                "target_lang_word": "durable",
                                "target_lang_sense_clarification": "able to withstand wear or decay over time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "631f671a-bc84-3e3e-afe9-dc72acf0f1ac",
                    "sense_definition": "Logisch verdedigbaar of vol te houden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defensibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn standpunt is in deze discussie niet langer <w>houdbaar</w>.",
                            "target_lang_translations": {
                                "en": "His position is no longer <w>tenable</w> in this discussion."
                            }
                        },
                        {
                            "text": "De huidige strategie is op de lange termijn niet <w>houdbaar</w>.",
                            "target_lang_translations": {
                                "en": "The current strategy is not <w>sustainable</w> in the long term."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdedigbaar"
                    ],
                    "antonyms": [
                        "onhoudbaar"
                    ],
                    "common_phrases": [
                        "niet houdbaar"
                    ],
                    "target_lang_definitions": {
                        "en": "Logically defensible or sustainable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tenable",
                                "target_lang_sense_clarification": "able to be maintained or defended against attack or objection"
                            },
                            {
                                "target_lang_word": "sustainable",
                                "target_lang_sense_clarification": "able to be maintained at a certain rate or level"
                            },
                            {
                                "target_lang_word": "defensible",
                                "target_lang_sense_clarification": "justifiable by argument"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}