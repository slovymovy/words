                ],
                "senses": [
                    {
                        "sense_id": "094abf29-b7b6-3169-befa-45467e2a9d07",
                        "entry_id": "142fc1b6-969a-34e0-acc4-3a3ccb9efde6",
                        "glosses": [
                            "лицо, которое подлежит по законам государства призыву на военную службу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73c4f8f-d925-429c-a433-80857a292a03",
                                "sense_id": "094abf29-b7b6-3169-befa-45467e2a9d07",
                                "text": "Командир отряда с первых дней занялся обучением призывников."
                            },
                            {
                                "example_id": "6d655a66-853c-4893-8207-8fcd8f6dec4a",
                                "sense_id": "094abf29-b7b6-3169-befa-45467e2a9d07",
                                "text": "В Израиле призывниками являются не только мужчины, но и женщины."
                            },
                            {
                                "example_id": "3a252ad0-6f20-483a-92d5-aff074be246a",
                                "sense_id": "094abf29-b7b6-3169-befa-45467e2a9d07",
                                "text": "Призывники собрались на пункте сбора для отправки к месту прохождения военной службы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
