                "senses": [
                    {
                        "sense_id": "0ce4b831-9c31-3bd7-9664-9ceda28478a0",
                        "entry_id": "adf50b84-b3c2-3aac-8375-22d9159aae28",
                        "glosses": [
                            "meistens geplante und strukturierte Abfolge der jeweiligen Übungen (oder sonstigen Maßnahmen) innerhalb eines Trainings"
                        ],
                        "tags": [
                            "insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "21d81e3b-859d-4297-98af-358fd5959b33",
                                "sense_id": "0ce4b831-9c31-3bd7-9664-9ceda28478a0",
                                "text": "„In der abgelaufenen Woche war auf Grund der Länderspiele ein normaler Trainingsablauf nicht realisierbar.“"
                            },
                            {
                                "example_id": "da8f9493-1289-4e2e-89da-b82bb7f8aed6",
                                "sense_id": "0ce4b831-9c31-3bd7-9664-9ceda28478a0",
                                "text": "„Von regulären Trainingsabläufen konnte jedoch keine Rede sein, seine Spitzenleistungen erreichte er nicht mehr.“"
                            },
                            {
                                "example_id": "1a543af6-ec01-4bce-aefe-73d2c5c8e4d5",
                                "sense_id": "0ce4b831-9c31-3bd7-9664-9ceda28478a0",
                                "text": "„Nach den Fitnessübungen gab es zum ersten Mal seit Wochen einen normalen Trainingsablauf ohne Regenerationseinheiten.“"
                            },
                            {
                                "example_id": "7fc54bb4-e0ed-48c0-a4b7-65ad46b1b5ce",
                                "sense_id": "0ce4b831-9c31-3bd7-9664-9ceda28478a0",
                                "text": "„Das ist echt toll dass zur Zeit so viele Videos hochgeladen werden gerade für die die sonst nie so Trainingsabläufe sehen können ! Mach weiter so !“"
                            },
                            {
                                "example_id": "526fc1b1-cb51-4ce8-b22a-7ac6ce172bc3",
                                "sense_id": "0ce4b831-9c31-3bd7-9664-9ceda28478a0",
                                "text": "Neben Neuerungen im Trainingsablauf, sollen zukünftig auch neue Methoden zur Ermittlung der Leistungsfähigkeit der Spieler zum Einsatz kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
