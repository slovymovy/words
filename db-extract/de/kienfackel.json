                        "examples": [
                            {
                                "example_id": "7058f659-944e-4b4d-9af4-8e9a9c73aa28",
                                "sense_id": "e6c1efac-cfd0-3eb8-95f7-a7e5421c7ac2",
                                "text": "„Jeder und jede hielten in der einen Hand eine lange brennende Kienfackel, in der andern ein Schelle.“"
                            },
                            {
                                "example_id": "733df1b2-1508-40f0-ab20-941d1582edea",
                                "sense_id": "e6c1efac-cfd0-3eb8-95f7-a7e5421c7ac2",
                                "text": "„Die Männer entzündeten hiernach ihre größtenteils verlöschten Kienfackeln wieder, bestiegen die Pferde und ritten langsam nach Mullins' Hause zurück.“"
                            }
