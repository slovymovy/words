                ],
                "senses": [
                    {
                        "sense_id": "db9fd457-c15f-30c6-9cb6-af7623734ac4",
                        "entry_id": "9a0ba81d-0c67-3760-ad88-b0129e7ec38d",
                        "glosses": [
                            "ringförmiger Gegenstand um den Leib als Bestandteil der Kleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc2c859-e48b-46cb-b426-4918f2886486",
                                "sense_id": "db9fd457-c15f-30c6-9cb6-af7623734ac4",
                                "text": "„Daneben fand man Leibringe aus Bronze oder Eisen und bronzene Gürtelketten, als Gürtelschmuck Ringe, Kugeln, Zierscheiben oder Hohlwulstringe.“"
                            },
                            {
                                "example_id": "99362d3b-3a80-4560-94b3-5d308748582a",
                                "sense_id": "db9fd457-c15f-30c6-9cb6-af7623734ac4",
                                "text": "„Übrig bleibt, daß alle Leibringe nur in als Frauenbestattung zu interpretierenden archäologischen Grabinventaren vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f970d000-20e5-3035-bd9c-9e1841c980a3",
                        "entry_id": "9a0ba81d-0c67-3760-ad88-b0129e7ec38d",
                        "glosses": [
                            "ringförmiger Gegenstand um den Leib als Fessel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a7d77ab-49f4-417f-91c5-da77e6cc1b2d",
                                "sense_id": "f970d000-20e5-3035-bd9c-9e1841c980a3",
                                "text": "„Für die Brandmarkung verwendete man Brandstempel, für Freiheitsstrafen Fesseln, Fusskugeln, Leibringe und Strafjoche.“"
                            },
                            {
                                "example_id": "5f3eb8f6-094a-4623-97ea-e4007eb0ebb7",
                                "sense_id": "f970d000-20e5-3035-bd9c-9e1841c980a3",
                                "text": "„Die Leibringe wurden den Gefangenen direkt um den Leib gelegt und engten sie nicht nur in ihrer Freiheit ein, sondern waren bei Bewegungen unangenehm und schmerzhaft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dc3d7e17-3772-3b20-b79b-468007ee03ce",
                        "entry_id": "9a0ba81d-0c67-3760-ad88-b0129e7ec38d",
                        "glosses": [
                            "ringförmiges Segment eines Insekts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67afbf51-2e79-482b-baf8-019d8dc6474f",
                                "sense_id": "dc3d7e17-3772-3b20-b79b-468007ee03ce",
                                "text": "„Durch das Aufblasen erhalten die Leibringe der Insekten wieder ihre natürliche Form, nachdem die inneren Weichteile zunächst herausgedrückt worden sind — ein für die Präparation von Amphibien recht unwahrscheinlicher Vorgang (Auskunft von HWeidner, Zoolog Institut der Univ Hambg).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
