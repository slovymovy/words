                                        "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                        "entry_id": "df7cdadd-fc8b-3c72-93e9-125c86bf2e20",
                                        "glosses": [
                                            "goldgelber, sizilianischer Süßwein, der nur aus den Traubensorten Grillo, Cattaratto und Inozolia hergestellt werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831319bf-acb9-4cc0-aa7e-1b520edbd7c4",
                                                "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                                "text": "Den Marsala haben englische Kaufleute in der zweiten Hälfte des 18. Jahrhunderts erfunden, die einen preiswerten Ersatz für in England beliebte spanische und portugiesische Weine suchten."
                                            },
                                            {
                                                "example_id": "c57cb049-0fab-4399-86d5-10a9b1c7259b",
                                                "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                                "text": "Der Marsala erinnert leicht an den Sherry."
                                            },
                                            {
                                                "example_id": "762adcb2-be38-43f4-8968-aace3555bda9",
                                                "sense_id": "31bc2b4b-be10-340a-82e8-62f8f2e608f0",
                                                "text": "„Ebenso wie Sherry ist Marsala im Naturzustand […] ein trockener Wein, der seinen Alkoholgehalt durch Zusatz hochprozentigen Traubenbranntweines und die jeweils gewünschte Süße durch Verbesserung mit einem sehr süßen Traubenkonzentrat erhält, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
