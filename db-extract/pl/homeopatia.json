                                "target_senses": [
                                    {
                                        "sense_id": "bd6b919e-76b9-30e6-906a-159b491eaac4",
                                        "entry_id": "4ab02723-f028-3a7c-a379-98799f0329ff",
                                        "glosses": [
                                            "Método curativo que aplica, en dosis mínimas, substancias que en cantidad mayor producirían efectos o afecciones semejantes a las que se combaten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2ed53f-0138-48d1-8845-de16d3885fc0",
                                                "sense_id": "bd6b919e-76b9-30e6-906a-159b491eaac4",
                                                "text": "Capaz que no le hizo gracia al de la farmacia\nCuando dije que yo defiendo a muerte a la eutanasia\nDecía que si todos se morían, se fundía\nY me tiró con un frasco de homeopatía"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "064397b1-4aac-4a25-a3bf-c56b204fdde2",
                        "source_entry_id": "b7eae806-ea4e-3009-b0ca-57269d883487",
                        "source_sense_id": "eac252ed-5aa7-33d2-8f1a-b00ec3c5ebc2",
