                "senses": [
                    {
                        "sense_id": "b142772a-d6e5-3445-b82e-bee732c3cb24",
                        "entry_id": "df520e1f-0a68-3dab-8bfc-5a995fff1bc6",
                        "glosses": [
                            "Volksgruppe einer kleinen turksprachigen Minderheit griechischer Abstammung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e52e56-a623-46e5-8c56-2e7e45e241f7",
                                "sense_id": "b142772a-d6e5-3445-b82e-bee732c3cb24",
                                "text": "Die Urum sind eines der wenigen turksprachigen Völker, die nicht den Islam angenommen haben, sondern bis heute griechisch-orthodoxe Christen geblieben sind."
                            },
                            {
                                "example_id": "1b3e5d50-e2fb-4fe7-9fa7-62918bab0e01",
                                "sense_id": "b142772a-d6e5-3445-b82e-bee732c3cb24",
                                "text": "Die Urum, Gagausen oder Tschuwaschen bekennen sich seit Jahrhunderten zum orthodoxen Christentum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42532f48-bf6f-3427-bfd8-525942fc248a",
                        "entry_id": "df520e1f-0a68-3dab-8bfc-5a995fff1bc6",
                        "glosses": [
                            "einzelne Person der Volksgruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a740f26e-f0de-4f73-a4bd-85439585ac76",
                                "sense_id": "42532f48-bf6f-3427-bfd8-525942fc248a",
                                "text": "Ein Urum gibt häufig seinen Kindern griechische Namen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
