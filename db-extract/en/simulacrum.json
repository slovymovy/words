                                    },
                                    {
                                        "sense_id": "75922e21-c997-3afc-b47e-e5bb85c4653f",
                                        "entry_id": "89516a33-e88e-32e5-95d8-32ca359abf55",
                                        "glosses": [
                                            "Imitación, acto fingido, falsificación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a0dc79-264b-491f-a689-47ca1007eefe",
                                                "sense_id": "75922e21-c997-3afc-b47e-e5bb85c4653f",
                                                "text": "A mi modo de ver la retórica no es más que el simulacro de una parte de la política."
                                            }
