                        "target_lang_word": "Tratsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tratsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8658cff9-71ea-3fb4-a142-f889918438a3",
                                        "entry_id": "48d52f72-d28b-36bb-87ba-57edd793c888",
                                        "glosses": [
                                            "Unterhaltung über Angelegenheiten anderer, abwesender Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a957f6-4780-45c3-8de2-1359a80155b9",
                                                "sense_id": "8658cff9-71ea-3fb4-a142-f889918438a3",
                                                "text": "„Irgendwer war immer da und erzählte den neuesten Tratsch oder diskutierte über die Unfähigkeit der Stadt, sich endlich um eine anständige Wasserversorgung zu kümmern.“"
                                            },
                                            {
                                                "example_id": "b401f514-674a-4a1e-ad96-594ceeaef74d",
                                                "sense_id": "8658cff9-71ea-3fb4-a142-f889918438a3",
                                                "text": "„Der Tratsch vom Nachbartisch mischte sich in ihr Gespräch.“"
                                            },
                                            {
                                                "example_id": "7304677c-c19f-4d73-9a25-0def1ea6a8f3",
                                                "sense_id": "8658cff9-71ea-3fb4-a142-f889918438a3",
                                                "text": "„Da liebte ich auch Tratsch und konnte vor Freude in die Hände klatschen, wenn ich mir beispielsweise Houellebecq auf seinem Hochzeitsfoto ansah oder Stuckrad-Barre mal wieder auf einem Tisch stand.“"
                                            },
                                            {
                                                "example_id": "50eed354-8374-471f-8bdf-fb5868a8c685",
                                                "sense_id": "8658cff9-71ea-3fb4-a142-f889918438a3",
                                                "text": "„Das Gespräch bewegte sich um jenen Tratsch aus den leitenden Sphären, den die meisten Menschen für das Wichtigste und Interessanteste der ganzen inneren Politik halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
