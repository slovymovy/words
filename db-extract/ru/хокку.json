                                "target_senses": [
                                    {
                                        "sense_id": "48ced9ad-1490-35a1-9a95-e340f17f5f6c",
                                        "entry_id": "1bda6314-e538-3920-bf0b-0d7660124b26",
                                        "glosses": [
                                            "Ensemble des dix-sept premières mores d’un tanka réparties en trois vers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b37ce23-6020-31ce-b3ec-976feccf8ffd",
                                        "entry_id": "1bda6314-e538-3920-bf0b-0d7660124b26",
                                        "glosses": [
                                            "Poème japonais indépendant composé de trois vers de 5, 7 et 5 mores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f143c1-91f1-43d2-a665-a6f4f3dd4283",
                                                "sense_id": "8b37ce23-6020-31ce-b3ec-976feccf8ffd",
                                                "text": "Je me suis donné pour objectif d’avoir le plus de pensée profondes possibles et de les noter dans ce cahier. […] Mais comme j’ai un gros côté japonais, j’ai ajouté une contrainte : cette pensée profonde doit être formulée sous la forme d’un petit poème à la japonaise : d’un hokku (trois vers) ou d’un tanka (cinq vers)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b41988-040a-3741-ada9-b9e4efe67536",
                                        "entry_id": "1bda6314-e538-3920-bf0b-0d7660124b26",
                                        "glosses": [
                                            "Haïku."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bbc7a62-b25d-42eb-893b-9e67858f1d5f",
                                                "sense_id": "a2b41988-040a-3741-ada9-b9e4efe67536",
                                                "text": "Un genre nouveau connut une vogue sans pareille, ce fut celle du hokku, qu’on appelle encore haiku ou haikai, de noms qui font allusion au caractère humoristique d’une partie de cette production"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
