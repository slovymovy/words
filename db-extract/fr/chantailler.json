                "senses": [
                    {
                        "sense_id": "de16220d-e0ee-3b5d-87ba-91b57a029f20",
                        "entry_id": "8e1ec4fe-5a0c-3e98-8296-a47e8b942574",
                        "glosses": [
                            "Chanter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b296c5-8782-4c47-aa39-01799704532d",
                                "sense_id": "de16220d-e0ee-3b5d-87ba-91b57a029f20",
                                "text": "Lorsqu’on voit une bande de notables chantailler la Marseillaise, on comprend ce que signifie le mot « karaoké »?"
                            },
                            {
                                "example_id": "b153455b-279a-4747-ad11-bbcd3bec9206",
                                "sense_id": "de16220d-e0ee-3b5d-87ba-91b57a029f20",
                                "text": "Je me suis donc retrouvé à \"chantailler\" du rock’n’roll à l’arrière-salle des cafés ou dans des boums."
                            },
                            {
                                "example_id": "d9bf81ab-b062-44a2-8b5c-11316599d5e7",
                                "sense_id": "de16220d-e0ee-3b5d-87ba-91b57a029f20",
                                "text": "Bref, après 17 ans de commerce, comme j’adore papotailler et chantailler en m’enjaillant, je me suis souvent retrouvée bien accompagnée en scène ouverte avec toute une bande de potes."
                            }
                        ]
                    }
