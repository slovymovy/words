                        "glosses": [
                            "Initialism of Q-identifier, a unique identifier for an item in Wikidata."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "ebaf4f09-c4e5-4767-a68f-b1bf07026cf4",
                                "sense_id": "b8b46137-5382-3ad5-9b4d-7e1b7c784740",
                                "text": "Inside the bot-friendly world of Wikidata, every concept and thing is represented with a numeric code dubbed a QID."
                            },
                            {
                                "example_id": "c98adcf2-8e96-4cb2-92eb-b95b87eca19e",
                                "sense_id": "b8b46137-5382-3ad5-9b4d-7e1b7c784740",
                                "text": "Within the Unicode consortium, a discussion has been started to use the Wikidata numbering system (“QID”) to create a system of emoji encoding that lies outside core Unicode regulation […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a9132233-5eac-3070-acb8-4164ed2a2948",
                        "entry_id": "2942a600-d206-36ef-8394-472a5ed6e2e2",
                        "glosses": [
                            "Initialism of quasi-identifier."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "0be542cb-5ef0-4fa6-a681-4052faff21e7",
                                "sense_id": "a9132233-5eac-3070-acb8-4164ed2a2948",
                                "text": "Due to the absence of unique entity identifiers across different databases, it is required to use the commonly available quasi-identifiers (QIDs), such as names and addresses, for linking records from those databases."
                            }
                        ]
                    },
