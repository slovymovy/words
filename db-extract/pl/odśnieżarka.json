                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5c53ba-24c9-4ee8-bcb9-bd0da45a7c7f",
                                "sense_id": "5e82060b-bfdf-3f77-9c97-d8be153e6cdb",
                                "text": "Odśnieżarka wirnikowa pomoże zaoszczędzić twój czas, usuwając śnieg z takich obszarów jak podjazdy czy chodniki."
