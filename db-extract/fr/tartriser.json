                "senses": [
                    {
                        "sense_id": "517d7a89-66db-3d10-8a84-a9e548f9c186",
                        "entry_id": "7e513a92-2f5a-3769-9891-53f85be293e0",
                        "glosses": [
                            "Purifier à l’aide du sel de tartre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fc914cd-7fc5-49e2-ad38-da18c0b0025e",
                                "sense_id": "517d7a89-66db-3d10-8a84-a9e548f9c186",
                                "text": "Si le liquide, quoique tartrisé, ne renferme pas de sucre, le ferment mannitique ne s’y développe pas."
                            },
                            {
                                "example_id": "cef64728-17d0-46bf-b9a4-9362ecde5e64",
                                "sense_id": "517d7a89-66db-3d10-8a84-a9e548f9c186",
                                "text": "Enfin, ces potions tartrisées, ces boissons laxatives, adjuvant indispensable de la médecine mesmérienne, que les grandes dames habituées de la place Vendôme avalaient avec une répugnance si naturelle, ne seront plus invoquées que comme un souvenir ignoble."
                            }
                        ]
                    }
                ],
