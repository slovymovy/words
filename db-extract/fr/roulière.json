                ],
                "senses": [
                    {
                        "sense_id": "916cf745-ec39-3758-9819-7da9a73b2057",
                        "entry_id": "76c2c03f-fb78-306d-ae26-2762578f79f9",
                        "glosses": [
                            "Blouse des rouliers ou des conducteurs de grosses messageries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af65caa7-e60e-4a67-8285-9248135c428f",
                                "sense_id": "916cf745-ec39-3758-9819-7da9a73b2057",
                                "text": "Luizzi la soutenait dans ses bras en protégeant sa tête contre le mouvement et les cahots de la voiture ; il l'enveloppa dans la roulière et la contempla ainsi pâle, froide, presque mourante."
                            },
                            {
                                "example_id": "9377759c-7f73-481c-91de-ccc0aa3cef18",
                                "sense_id": "916cf745-ec39-3758-9819-7da9a73b2057",
                                "text": "On tailla deux vêtements noirs pour les enfants dans une vieille roulière de leur père, et la vie, la triste vie recommença."
                            }
                        ]
                    },
                    {
                        "sense_id": "d56519ce-3b95-3870-9fa7-fc4e6a4b001c",
                        "entry_id": "76c2c03f-fb78-306d-ae26-2762578f79f9",
                        "glosses": [
                            "Trace creusée dans un chemin ni pavé, ni revêtu, par le passage des roues ; ornière."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "3d9aec94-dcc0-4ce9-a22f-ab04f6d582b0",
                                "sense_id": "d56519ce-3b95-3870-9fa7-fc4e6a4b001c",
                                "text": "La formation de roulières sur nos autoroutes et nos routes est donc inévitable, selon lui."
                            },
                            {
                                "example_id": "938f5c9a-fc4a-459b-8afc-588b6c847f50",
                                "sense_id": "d56519ce-3b95-3870-9fa7-fc4e6a4b001c",
                                "text": "Après s'être empêtrés à plusieurs reprises dans les roulières boueuses et avoir poussé sur la voiture dans le but d'alléger la charge de Grattan, Elwin et Mary arrivèrent enfin à la cabane."
                            },
                            {
                                "example_id": "b53a79e0-e308-4db2-8d3a-dcffa94d6017",
                                "sense_id": "d56519ce-3b95-3870-9fa7-fc4e6a4b001c",
                                "text": "Nadia conduit lentement, tant par crainte d'enliser sa Fiat, qui patine dans les roulières, qu'en raison de la nervosité qu'elle ressent à la perspective de cette rencontre."
                            }
                        ]
                    }
                ],
