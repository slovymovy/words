                    {
                        "sense_id": "0234bf84-d793-31b6-b7ef-cd1ed70282ef",
                        "entry_id": "f2cc19b4-1c26-3ab5-b1ef-d1b6342941e5",
                        "glosses": [
                            "Ordre donné au cours de la cérémonie des couleurs à un ou plusieurs servants de hisser le drapeau national avec la drisse jusqu’en haut du mât des couleurs."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "c977b6a9-1ab7-4239-9d1c-f4d936964ba5",
                                "sense_id": "0234bf84-d793-31b6-b7ef-cd1ed70282ef",
                                "text": "Attention pour les couleurs (ordre)\nPrêt (réponse du servant)\nEnvoyez (ordre)"
                            },
                            {
                                "example_id": "85c7b492-cfd2-4617-9096-aabaa5521c16",
                                "sense_id": "0234bf84-d793-31b6-b7ef-cd1ed70282ef",
                                "text": "– Envoyez !\nLe drapeau tricolore à croix de Lorraine, un pauvre torchon délavé grimpe péniblement au mât qui n’est qu’un arbre maigre et tordu, auquel on a coupé les branches… J’ai envie de pleurer, très envie de pleurer.\n– Repos."
                            }
                        ]
                    }
