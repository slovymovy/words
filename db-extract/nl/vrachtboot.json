                                    {
                                        "sense_id": "84656753-9126-3c72-9ee4-508dbe2cb678",
                                        "entry_id": "8a1d52f8-1167-3a15-8a28-657f0ccf4466",
                                        "glosses": [
                                            "Navire destiné à transporter des marchandises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959c4649-9a70-43c7-92bc-4fe17610a532",
                                                "sense_id": "84656753-9126-3c72-9ee4-508dbe2cb678",
                                                "text": "Les glaces de la mer Blanche n’avaient que peu de rapports avec celles de la banquise, et les cargos étaient précédés et convoyés par de remarquables « brise-glaces »."
                                            },
                                            {
                                                "example_id": "d8bf691d-a269-43db-aef0-520545fc9843",
                                                "sense_id": "84656753-9126-3c72-9ee4-508dbe2cb678",
                                                "text": "Le bulbe opalin déchirait la pellicule liquide, des floches d'écume chatouillaient les flancs du cargo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbfc6cd7-0ac9-3a57-b30e-3a83c905f2cf",
                                        "entry_id": "8a1d52f8-1167-3a15-8a28-657f0ccf4466",
                                        "glosses": [
                                            "Véhicule destiné à transporter des marchandises (en général dans un nom composé)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
