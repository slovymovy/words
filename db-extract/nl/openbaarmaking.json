                                    {
                                        "sense_id": "c5f1d7e4-9fec-3109-95b5-6daa788ca50e",
                                        "entry_id": "0f9bb563-c752-3041-91ee-18666d0b4357",
                                        "glosses": [
                                            "öffentliche Mitteilung"
                                        ],
                                        "tags": [],
