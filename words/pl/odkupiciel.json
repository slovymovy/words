    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27c8f771-f357-3730-8a0e-065b69071a73",
                    "sense_definition": "osoba, która kogoś ratuje, wyzwala lub uwalnia od nieszczęścia, kary lub długu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wybawca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W oczach uciemiężonych mieszkańców wioski przybyły wędrowiec uchodził za prawdziwego <w>odkupiciela</w>.",
                            "target_lang_translations": {
                                "en": "In the eyes of the oppressed villagers, the newly arrived wanderer was considered a true <w>redeemer</w>."
                            }
                        },
                        {
                            "text": "Po spłaceniu zaległych zobowiązań firmy poczuł się jak jej jedyny <w>odkupiciel</w>.",
                            "target_lang_translations": {
                                "en": "After paying off the company's overdue liabilities, he felt like its sole <w>savior</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wybawca",
                        "wybawiciel",
                        "zbawca",
                        "zbawiciel",
                        "oswobodziciel"
                    ],
                    "common_phrases": [
                        "prawdziwy odkupiciel"
                    ],
                    "target_lang_definitions": {
                        "en": "a person who saves, frees, or delivers someone from misfortune, punishment, or debt"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "redeemer",
                                "target_lang_sense_clarification": "someone who redeems, delivers, or saves"
                            },
                            {
                                "target_lang_word": "savior",
                                "target_lang_sense_clarification": "person who rescues or delivers from harm"
                            },
                            {
                                "target_lang_word": "deliverer",
                                "target_lang_sense_clarification": "someone who sets others free"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ed9775d3-7e44-369d-9421-b2c9fd7bce3c",
                    "sense_definition": "w chrześcijaństwie: określenie Jezusa Chrystusa jako tego, który odkupił ludzkość przez swoją śmierć na krzyżu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bóstwo",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Wierni zgromadzili się w świątyni, aby wspólnie modlić się do boskiego <w>Odkupiciela</w>.",
                            "target_lang_translations": {
                                "en": "The faithful gathered in the temple to pray together to the divine <w>Redeemer</w>."
                            }
                        },
                        {
                            "text": "Dla chrześcijan Jezus jest jedynym i wiecznym <w>Odkupicielem</w> człowieka.",
                            "target_lang_translations": {
                                "en": "For Christians, Jesus is the only and eternal <w>Redeemer</w> of humankind."
                            }
                        }
                    ],
                    "synonyms": [
                        "Zbawiciel",
                        "Zbawca",
                        "Mesjasz",
                        "Chrystus",
                        "Jezus Chrystus",
                        "Pan Jezus"
                    ],
                    "common_phrases": [
                        "boski Odkupiciel",
                        "Odkupiciel człowieka"
                    ],
                    "target_lang_definitions": {
                        "en": "in Christianity: a title for Jesus Christ as the one who redeemed humanity through his death on the cross"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Redeemer",
                                "target_lang_sense_clarification": "honorific title for Jesus Christ"
                            },
                            {
                                "target_lang_word": "Savior",
                                "target_lang_sense_clarification": "Jesus Christ as the savior of humanity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
