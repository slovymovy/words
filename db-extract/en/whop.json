                "senses": [
                    {
                        "sense_id": "b493bc39-e1e2-3497-b7fe-630bdba8fc84",
                        "entry_id": "876bb552-9777-3e19-88d6-fbf57b52c28c",
                        "glosses": [
                            "To throw or move (something) quickly, usually with an impact."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0be54c34-895a-4789-9b4d-f6124d5dd06f",
                                "sense_id": "b493bc39-e1e2-3497-b7fe-630bdba8fc84",
                                "text": "He angrily whopped the book onto the table."
                            },
                            {
                                "example_id": "1b091131-1eb6-4f74-91bb-2aa2db04e401",
                                "sense_id": "b493bc39-e1e2-3497-b7fe-630bdba8fc84",
                                "text": "Then I'd wake up an' screech and roar—then off to sleep again—to dream that Spanker had run away with me, or that father was whopping me, or some other plaguey thing, till mornin'."
                            },
                            {
                                "example_id": "bcb58511-9b34-43c0-b4a5-428c538bf54c",
                                "sense_id": "b493bc39-e1e2-3497-b7fe-630bdba8fc84",
                                "text": "A man & a younge maid that loued a long time / were tane in a frenzye ithe Midsommer prime; / the maid shee lay drooping, hye; / the man he lay whopping, hey, the man he lay whopping hoe."
                            }
                        ]
                    },
