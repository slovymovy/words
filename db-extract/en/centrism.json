        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1ba66569-0b6e-3064-a2d4-0ae7aa57848d",
                "word": "centrism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "836e1634-57c1-44de-879c-a002ae650288",
                        "entry_id": "1ba66569-0b6e-3064-a2d4-0ae7aa57848d",
                        "tags": [
                            "plural"
                        ],
                        "form": "centrisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e3f62ab-fa68-31bd-9e0e-995eb57dc51e",
                        "entry_id": "1ba66569-0b6e-3064-a2d4-0ae7aa57848d",
                        "glosses": [
                            "Any moderate political philosophy that avoids extremes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fcc48ea-9ba7-407b-a7f1-6a3cf8116243",
                        "source_entry_id": "1ba66569-0b6e-3064-a2d4-0ae7aa57848d",
                        "source_sense_id": "9e3f62ab-fa68-31bd-9e0e-995eb57dc51e",
                        "source_sense_description": "moderate political philosophy",
                        "target_lang_word": "centrisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centrisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c92b901-96da-3d0c-a927-ac6de72b9661",
                                        "entry_id": "d3c6b3f0-7339-3b06-b364-4610aab3fb06",
                                        "glosses": [
                                            "Courant politique se situant à mi-chemin entre la droite et la gauche, entre le conservatisme et le progressisme."
                                        ],
                                        "tags": [
                                            "Science politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1e1f8d3-3900-4d7c-810b-2438624d24a6",
                                                "sense_id": "2c92b901-96da-3d0c-a927-ac6de72b9661",
                                                "text": "On peut le constater, la vie politique française pose périodiquement la question de la possibilité et de la légitimité du centrisme."
                                            },
                                            {
                                                "example_id": "e7515b3f-d704-4304-9967-a505238ef30e",
                                                "sense_id": "2c92b901-96da-3d0c-a927-ac6de72b9661",
                                                "text": "Mais ce centrisme ainsi défini se veut ouvert, hospitalier, accueillant, se conçoit lui-même comme potentiellement élargi à des tendances proches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b3da99f-113b-3a83-894c-c6106f0b2010",
                                        "entry_id": "d3c6b3f0-7339-3b06-b364-4610aab3fb06",
                                        "glosses": [
                                            "Biais systémique où un groupe ou un point de vue particulier est érigé en norme universelle, servant à exclure, subordonner ou dominer les « autres ». Val Plumwood y voit un mécanisme central de la logique de domination (masculine, humaine, occidentale...) qui légitime l’exploitation des non humains, des femmes, des peuples colonisés, etc."
                                        ],
                                        "tags": [
                                            "Luttes sociales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37bbd336-4ae9-43ce-a241-729b1c4d0b25",
                                                "sense_id": "4b3da99f-113b-3a83-894c-c6106f0b2010",
                                                "text": "Le coup de génie de Val Plumwood consiste à diagnostiquer comme fondement réel des mouvements de libération politique qui ont animé le XXᵉ siècle, non pas l’élargissement de la personne sacralisée, mais la lutte contre les centrismes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcead8e5-e046-4a5d-960f-0cbbb918420f",
                        "source_entry_id": "1ba66569-0b6e-3064-a2d4-0ae7aa57848d",
                        "source_sense_id": "9e3f62ab-fa68-31bd-9e0e-995eb57dc51e",
                        "source_sense_description": "moderate political philosophy",
                        "target_lang_word": "Zentrismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zentrismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fca1a93-b18c-380a-b778-4f0566d41cd6",
                                        "entry_id": "c8acaf77-6ad3-34fe-9e78-552a89c7f0e9",
                                        "glosses": [
                                            "Strömung in der Arbeiterbewegung zwischen Revolution und Reformismus"
                                        ],
                                        "tags": [
                                            "historical",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e90590-cd42-4090-bb64-2c73154c25aa",
                                                "sense_id": "1fca1a93-b18c-380a-b778-4f0566d41cd6",
                                                "text": "„Da eben Zentrismus keine vollständige Überwindung des Reformismus ist, ist dieser geneigt, gegenüber der Gewerkschaftsbürokratie oder reformistischen Kräften eine diplomatische Beziehung aufzubauen.“"
                                            },
                                            {
                                                "example_id": "811fb745-3f79-4423-a042-6e6fad191647",
                                                "sense_id": "1fca1a93-b18c-380a-b778-4f0566d41cd6",
                                                "text": "„Es hieße aber, die Rolle des Zentrismus zu eng zu sehen, konzentrierten sich die Forschungen nur darauf, seine Funktion in den innerparteilichen Auseinandersetzungen zwischen Marxisten und Revisionisten zu präzisieren […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06bd62d1-eaf7-38db-8ff2-82f8e47c2496",
                                        "entry_id": "c8acaf77-6ad3-34fe-9e78-552a89c7f0e9",
                                        "glosses": [
                                            "Betonung einer Mittelposition im politischen Spektrum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5b4ea8-5e8b-4453-b809-70033fd73ba1",
                                                "sense_id": "06bd62d1-eaf7-38db-8ff2-82f8e47c2496",
                                                "text": "Nach den Jahren der Polarisierung von rechts liegt die Alternative nicht in der Polarisierung von links, sondern im Zentrismus der neunziger Jahre."
                                            },
                                            {
                                                "example_id": "f22a2238-983c-4188-8381-85e0dffeef0e",
                                                "sense_id": "06bd62d1-eaf7-38db-8ff2-82f8e47c2496",
                                                "text": "Und zur rechten Gewichtung der Bilanz von Bill Clinton sollte auch das Faktum beitragen, dass sein «Zentrismus» den parteipolitischen Gegner auf eine gemässigte Linie gezwungen, die politische Konfrontation abgemildert und Amerika insgesamt auf die «Mitte» hin ausgerichtet hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f77accce-b84b-363b-870d-3fb341bf7846",
                                        "entry_id": "c8acaf77-6ad3-34fe-9e78-552a89c7f0e9",
                                        "glosses": [
                                            "System mit einem exklusiven (andere Sichtweisen ausschließenden) Zentrum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7150f30f-62fa-48ea-8821-39c1d9d34359",
                                                "sense_id": "f77accce-b84b-363b-870d-3fb341bf7846",
                                                "text": "„Der exklusivistische Zentrismus ist in der Regel universalistisch ausgerichtet und besitzt missionarischen Charakter. Diese Form von Zentrismus, die expansionistisch angelegt ist, bestimmt das Eigene als Zentrum und das Andere als Peripherie.“"
                                            },
                                            {
                                                "example_id": "ecdf77fb-7415-499f-a90a-902d96d74eed",
                                                "sense_id": "f77accce-b84b-363b-870d-3fb341bf7846",
                                                "text": "„Den Anlass für interkulturelles Philosophieren sehen Vertreter wie Jameleddine Ben Abdel Jelil in den verschiedenen Zentrismen westlicher Denktradition, \"die es zu überwinden gilt.\"“"
                                            },
                                            {
                                                "example_id": "08bb36b9-fbbd-4846-9240-3c6d4a291731",
                                                "sense_id": "f77accce-b84b-363b-870d-3fb341bf7846",
                                                "text": "„Der individuellen Zentrierung entsprechen kollektive Zentrismen: Jede Familie, jeder Clan, jeder Stamm, jedes Volk usw. sieht sich im Mittelpunkt der Welt und der Geschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
