                                        "sense_id": "e7a3c3b8-202e-366a-935d-ee575f800ec7",
                                        "entry_id": "ac828a48-ead3-32dc-943f-036adab6e5fd",
                                        "glosses": [
                                            "Témoigner qu’une chose est vraie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1049df1-c18a-42f8-aa12-17b121434bcb",
                                                "sense_id": "e7a3c3b8-202e-366a-935d-ee575f800ec7",
                                                "text": "Je vous certifie que cela est. Je puis vous le certifier."
                                            },
                                            {
                                                "example_id": "09ec99e2-c945-4e04-be38-c294ef92ae53",
                                                "sense_id": "e7a3c3b8-202e-366a-935d-ee575f800ec7",
                                                "text": "Copie certifiée conforme à l’original. (Absolument) Certifié conforme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a79a453-ea3e-3135-acdc-254e5db2273c",
                                        "entry_id": "ac828a48-ead3-32dc-943f-036adab6e5fd",
                                        "glosses": [
                                            "Déclarer solvable une caution, une criée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a91520-8e14-4216-ac5c-ea8ef07d0cab",
                        "source_entry_id": "05e70c82-d024-3880-a619-c14d3c6f6762",
                        "source_sense_id": "b08c345f-7bcd-3008-9c53-0cca563d26f8",
                        "target_lang_word": "garantir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garantir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88ed4d7e-fecb-3617-85d6-f9903e451cf8",
                                        "entry_id": "e92264cd-4414-30e6-8a80-32be11a16ed5",
                                        "glosses": [
                                            "Se porter garant, répondre d’une chose, du maintien, de l’exécution d’une chose."
                                        ],
                                        "tags": [],
                                        "note": "Se dit surtout en matière de procès, d’affaires et de négociation",
                                        "examples": [
                                            {
                                                "example_id": "c7615a3c-8203-4155-be0f-ed2bacbfc0b9",
                                                "sense_id": "88ed4d7e-fecb-3617-85d6-f9903e451cf8",
                                                "text": "Garantir une créance."
                                            },
                                            {
                                                "example_id": "69b24e60-776c-40c5-b724-e654f3b82de3",
                                                "sense_id": "88ed4d7e-fecb-3617-85d6-f9903e451cf8",
                                                "text": "Garantir la propriété d’une maison."
                                            },
                                            {
                                                "example_id": "b1f10849-37a1-4af2-bf92-1fe5c00e381b",
                                                "sense_id": "88ed4d7e-fecb-3617-85d6-f9903e451cf8",
                                                "text": "Garantir un contrat, une vente, un traité entre puissances, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e07e148-47f4-389e-8282-cb0c132c4189",
                                        "entry_id": "e92264cd-4414-30e6-8a80-32be11a16ed5",
                                        "glosses": [
                                            "Se rendre garant de la valeur, de la qualité d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c54de2ef-4d8a-4cff-ad9e-e4d486a3fbaf",
                                                "sense_id": "4e07e148-47f4-389e-8282-cb0c132c4189",
                                                "text": "Je vous garantis cette montre pour six mois."
                                            },
                                            {
                                                "example_id": "0c5b2c7d-7b84-4498-8126-aa4edf5864d8",
                                                "sense_id": "4e07e148-47f4-389e-8282-cb0c132c4189",
                                                "text": "Je vous garantis ce cheval, cette montre de tout défaut."
                                            },
                                            {
                                                "example_id": "5070ba6e-4793-410c-8687-4246b0c2c001",
                                                "sense_id": "4e07e148-47f4-389e-8282-cb0c132c4189",
                                                "text": "Le contrôle garantit le titre des pièces d’or et d’argent."
                                            },
                                            {
                                                "example_id": "f9359448-e216-46fc-a707-52b953901f86",
                                                "sense_id": "4e07e148-47f4-389e-8282-cb0c132c4189",
                                                "text": "Ce qu’il vient de faire vous garantit sa fidélité."
                                            },
                                            {
                                                "example_id": "39722fd0-c88e-40fb-b6d5-25aaa9c8857e",
                                                "sense_id": "4e07e148-47f4-389e-8282-cb0c132c4189",
                                                "text": "Qui me garantit que vous serez plus sage à l’avenir ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc2e7a6f-04ea-311c-8dec-8ed20d43abef",
                                        "entry_id": "e92264cd-4414-30e6-8a80-32be11a16ed5",
                                        "glosses": [
                                            "Se rendre garant de l’existence de la réalité d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ab87410-1ab4-4cf6-b9d7-65cdca7c6ea9",
                                                "sense_id": "cc2e7a6f-04ea-311c-8dec-8ed20d43abef",
                                                "text": "Je vous garantis que les choses se sont passées ainsi."
                                            },
                                            {
                                                "example_id": "3f57b344-67a8-49ff-898a-9eaa4059e83f",
                                                "sense_id": "cc2e7a6f-04ea-311c-8dec-8ed20d43abef",
                                                "text": "Je lui ai garanti le fait."
                                            },
                                            {
                                                "example_id": "4db78936-5f96-41dc-a7b1-2d84ab4c5775",
                                                "sense_id": "cc2e7a6f-04ea-311c-8dec-8ed20d43abef",
                                                "text": "Je vous garantis qu’il ne fera pas cela."
                                            },
                                            {
                                                "example_id": "746ffc47-51cb-41d9-ba5b-01877490de05",
                                                "sense_id": "cc2e7a6f-04ea-311c-8dec-8ed20d43abef",
                                                "text": "On m’a assuré cela, mais je ne vous le garantis pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66c9866-d27e-393f-8521-f4ff047a33d2",
                                        "entry_id": "e92264cd-4414-30e6-8a80-32be11a16ed5",
                                        "glosses": [
                                            "Défendre quelqu’un contre une demande, ou l’indemniser du tort qu’il souffre par une éviction, une condamnation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf35aae-36ed-403e-891e-f5328e768dff",
                                                "sense_id": "a66c9866-d27e-393f-8521-f4ff047a33d2",
                                                "text": "Garantir quelqu’un de toutes poursuites. — Garantir d’une éviction."
                                            },
                                            {
                                                "example_id": "270bb4a6-c879-494d-9771-5daec87e128f",
                                                "sense_id": "a66c9866-d27e-393f-8521-f4ff047a33d2",
                                                "text": "Le débiteur doit garantir sa caution des condamnations qui peuvent être prononcées contre elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e24c4e9-7018-3710-8f58-187d202e8123",
                                        "entry_id": "e92264cd-4414-30e6-8a80-32be11a16ed5",
                                        "glosses": [
                                            "Donner l’assurance ; assurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc719057-1074-4553-8954-02dec6865208",
                                                "sense_id": "1e24c4e9-7018-3710-8f58-187d202e8123",
                                                "text": "Ce petit potager remonte aux années 1920. Il garantissait aux habitants l’autosuffisance alimentaire et leur offrait l’occasion d’un sain exercice physique – un souci très allemand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "804eea47-3ea4-31e3-acd9-147551c95461",
                                        "entry_id": "e92264cd-4414-30e6-8a80-32be11a16ed5",
                                        "glosses": [
                                            "Mettre à l’abri ; préserver de ; protéger de."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ed0c520-8289-4494-96a2-bfdaef656c79",
                                                "sense_id": "804eea47-3ea4-31e3-acd9-147551c95461",
                                                "text": "Le seul moyen de se garantir d’oignons, & même de toute incommodité aux pieds, c'est d'être absolument en garde contre les chaussures trop courtes; […]."
                                            },
                                            {
                                                "example_id": "00cd95e6-02ce-4862-bbc7-fa1b42da5a4b",
                                                "sense_id": "804eea47-3ea4-31e3-acd9-147551c95461",
                                                "text": "Sans les digues élevées et solidement établies qui l’en garantissent, la Camargue serait submergée par le Rhône plusieurs fois durant le cours du printemps, au moment sur-tout de la fonte des neiges, et pendant l’automne lors des pluies équinoxiales : […]."
                                            },
                                            {
                                                "example_id": "89f049a3-7a13-41bb-b91c-9d4541f319b1",
                                                "sense_id": "804eea47-3ea4-31e3-acd9-147551c95461",
                                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l'ondée cinglante."
                                            },
                                            {
                                                "example_id": "fa2bc799-6a33-49ab-b9ad-d3789a6c4cb3",
                                                "sense_id": "804eea47-3ea4-31e3-acd9-147551c95461",
                                                "text": "L’œuf pondu le vendredi saint préservait de la foudre, mangé il garantissait de la fièvre ou de la rage…"
                                            },
                                            {
                                                "example_id": "e5899074-1344-409f-9ae3-2de1d7115a24",
                                                "sense_id": "804eea47-3ea4-31e3-acd9-147551c95461",
                                                "text": "Voyez-vous […] nous avons à Paris plusieurs catégories de malandrins. Pour nous en garantir, il nous faut recourir à des hommes présentant des qualités particulières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58944543-2506-4bdd-9f89-35ec3398b103",
                        "source_entry_id": "05e70c82-d024-3880-a619-c14d3c6f6762",
                        "source_sense_id": "b08c345f-7bcd-3008-9c53-0cca563d26f8",
                        "target_lang_word": "se porter garant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se porter garant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f76d363-ca7e-3a45-96a5-7b919b933238",
                                        "entry_id": "0f83405e-cb4b-339e-9681-635ad3244406",
                                        "glosses": [
                                            "S’engager à garantir le bon fonctionnement ou la bonne fin d'une action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e4f23c-3e9d-4d45-8577-ec90f0aed863",
                                                "sense_id": "7f76d363-ca7e-3a45-96a5-7b919b933238",
                                                "text": "L’amghar était investi d'un pouvoir exécutif alors que la djemaâ possédait un pouvoir consultatif et se portait garante des coutumes et des relations intérieures et extérieures de la communauté."
                                            },
                                            {
                                                "example_id": "988c6c4e-5979-4170-a1fe-ab447c040b6f",
                                                "sense_id": "7f76d363-ca7e-3a45-96a5-7b919b933238",
                                                "text": "Oui, car toute personne peut se porter garante du paiement du loyer pour une autre. En pratique, c'est le plus souvent les parents du locataire qui se portent caution, […]."
                                            },
                                            {
                                                "example_id": "9a64a9ef-d42c-41f2-b7c4-996ddc99bdc1",
                                                "sense_id": "7f76d363-ca7e-3a45-96a5-7b919b933238",
                                                "text": "Dans le respect de chartes graphiques, elles assurent la mise en forme des documents et leur reproduction réalisée en interne ou sous-traitée. Elles se portent garantes du résultat final."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
