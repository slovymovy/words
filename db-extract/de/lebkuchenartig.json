                ],
                "senses": [
                    {
                        "sense_id": "939666d2-1091-39bb-bdcc-33fec3621ea2",
                        "entry_id": "23366938-a382-37f9-9c20-ad83e9a92c83",
                        "glosses": [
                            "einem Lebkuchen ähnelnd, an Lebkuchen erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5054de1e-e57e-46bb-9f5e-31e0c8f4d702",
                                "sense_id": "939666d2-1091-39bb-bdcc-33fec3621ea2",
                                "text": "„Was sie sah, waren platte Makronen, ausgelaufene Mozartplätzchen und blasses Spritzgebäck, dazwischen rechteckige lebkuchenartige Teile, die einen harten Eindruck machten.“"
                            },
                            {
                                "example_id": "e140b3ff-62cb-4ec8-ace0-23a15f963cc9",
                                "sense_id": "939666d2-1091-39bb-bdcc-33fec3621ea2",
                                "text": "„Am Heiligen Abend gibt es ein Festessen mit einem riesigen Schinken in Brühe, dazu das schwedische lebkuchenartige Brot, Randensalat und zum Dessert, wie es sein muss, Milchreis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
