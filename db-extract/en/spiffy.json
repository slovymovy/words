            {
                "entry_id": "468a27ca-3918-3ba1-b144-71d8da3b25ac",
                "word": "spiffy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "07c1c584-8c00-4deb-83f8-23dfeb4e90ad",
                        "entry_id": "468a27ca-3918-3ba1-b144-71d8da3b25ac",
                        "tags": [
                            "comparative"
                        ],
                        "form": "spiffier"
                    },
                    {
                        "form_id": "da70efed-5fbe-4dfb-8819-595faf087a8e",
                        "entry_id": "468a27ca-3918-3ba1-b144-71d8da3b25ac",
                        "tags": [
                            "superlative"
                        ],
                        "form": "spiffiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca224b79-3752-3655-8931-87a3e95c0417",
                        "entry_id": "468a27ca-3918-3ba1-b144-71d8da3b25ac",
                        "glosses": [
                            "Dapper; fine or neat, especially in style of clothing or other appearance."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "cb6e1cbd-dff1-4ad8-900c-95c923091f14",
                                "sense_id": "ca224b79-3752-3655-8931-87a3e95c0417",
                                "text": "He was “great” (as he expressed it) with the Bloomer who kept the bar where their club was held, and whom he styled “a spiffy girl,” and who had been graciously pleased to accept of a pair of very Brummagem-looking earrings, set with paste diamonds, with which he had presented her."
                            },
                            {
                                "example_id": "c5cfe1d2-e87d-49f7-87f1-3ea10924f8d9",
                                "sense_id": "ca224b79-3752-3655-8931-87a3e95c0417",
                                "text": "The charming twins came last week, and you should see their clothes. ‘Spiffy’ is the word."
                            },
                            {
                                "example_id": "f06528eb-03e9-4e6c-9093-f2d6647bdd16",
                                "sense_id": "ca224b79-3752-3655-8931-87a3e95c0417",
                                "text": "Plead the fifth, sip wine stiffly / Patiently come up and be spiffy in a jiffy"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c65ca19-51bf-49c1-a3b1-656d4787363c",
                        "source_entry_id": "468a27ca-3918-3ba1-b144-71d8da3b25ac",
                        "source_sense_id": "ca224b79-3752-3655-8931-87a3e95c0417",
                        "source_sense_description": "dapper, fine or neat",
                        "target_lang_word": "schick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                        "entry_id": "cc7c88cd-eb80-3be5-a560-cd1c451a89ee",
                                        "glosses": [
                                            "von Mode und Geschmack zeugend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f483819-01a4-4d75-92d1-4d09e888a66b",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "Sie ist eine ausgesprochen schicke Person."
                                            },
                                            {
                                                "example_id": "ef1f69d5-98b7-44a3-9c07-a1d6e6a5f9c3",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "Der neue Laden ist sehr schick aufgemacht."
                                            },
                                            {
                                                "example_id": "1c28395d-c201-4242-ba57-dd32c3caadc1",
                                                "sense_id": "80e72f22-8893-3ce5-8731-e689347d8a72",
                                                "text": "„Wir hatten uns schick gemacht am ersten Tag nach den großen Ferien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa6fe3a3-24e2-3f05-9180-1953d3a55dce",
                                        "entry_id": "cc7c88cd-eb80-3be5-a560-cd1c451a89ee",
                                        "glosses": [
                                            "sich positiv abhebend, hervorragend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "740da69f-b807-4fed-87f7-e08c8c65cfad",
                                                "sense_id": "fa6fe3a3-24e2-3f05-9180-1953d3a55dce",
                                                "text": "Das ist aber schick, dass Du die Prüfung bestanden hast!"
                                            },
                                            {
                                                "example_id": "bc529288-8a1a-45d8-90c0-69350be834be",
                                                "sense_id": "fa6fe3a3-24e2-3f05-9180-1953d3a55dce",
                                                "text": "„Abgesehen von der deutschen Sprache, der modischen Kleidung aus Kunstseide, Arbeit im Handel und der Verachtung für die niederen Klassen war es außerdem schick, Zigaretten zu rauchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "schick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89fd74b9-8612-3e5d-afc5-179f4fa82692",
                                        "entry_id": "541c12ab-4997-3040-83ab-dcc8eb812f68",
                                        "glosses": [
                                            "2. Person Singular Imperativ Präsens Aktiv des Verbs schicken"
