                                    {
                                        "sense_id": "85dc5641-b0d0-327c-a553-cdaa67d74d10",
                                        "entry_id": "dbdb0183-53c1-3132-a850-c92ba8725af6",
                                        "glosses": [
                                            "synkretyczny nurt filozoficzno-religijny wczesnego chrześcijaństwa głoszący dualistyczą koncepcję świata, który łączył elementy religii chrześcijańskiej, filozofii hellenistycznej i z religii pogańskich Azji Mniejszej, Babilonu, Egiptu, Grecji i Syrii oraz motywy z astrologii i judaizmu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6901c9c8-7647-4b65-93a2-392dfd73c2bf",
                                                "sense_id": "85dc5641-b0d0-327c-a553-cdaa67d74d10",
                                                "text": "Obecnie gnostycyzm łączy się zazwyczaj z twierdzeniem, że ludzka natura jest plastyczna i można ją zmieniać"
                                            },
                                            {
                                                "example_id": "63581b10-c25b-4b3e-bc2a-d532d0ca7816",
                                                "sense_id": "85dc5641-b0d0-327c-a553-cdaa67d74d10",
                                                "text": "Franciszek wskazuje na dwóch wrogów świętości: współczesne postacie gnostycyzmu i pelagianizmu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
