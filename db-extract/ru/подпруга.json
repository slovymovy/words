                    {
                        "translation_id": "e9742a10-0a1d-4ac9-b0c2-5ded3d18209a",
                        "source_entry_id": "473492c3-f10b-37a7-955a-6e68ba8ad00a",
                        "target_lang_word": "cinch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b42e72-c148-3270-98fd-5a4d0833bbd5",
                                        "entry_id": "217f2765-e4cb-35dd-aafc-c68f916ad7ce",
                                        "glosses": [
                                            "A simple saddle girth used in Mexico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dc78860-44a1-4fdf-8363-bfc3c118a6e1",
                                                "sense_id": "a3b42e72-c148-3270-98fd-5a4d0833bbd5",
                                                "text": "He found Andy morosely replacing some broken strands in his cinch, and he went straight at the mooted question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05915b85-ab5f-3f26-a18a-d06b71902c13",
                                        "entry_id": "217f2765-e4cb-35dd-aafc-c68f916ad7ce",
                                        "glosses": [
                                            "Something that is very easy to do."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdac4f5-08c1-4f37-913b-ea73f8ce6e2c",
                                                "sense_id": "05915b85-ab5f-3f26-a18a-d06b71902c13",
                                                "text": "We thought we had a cinch on getting out by way of this cord and so we followed that."
                                            },
                                            {
                                                "example_id": "be563320-bdf1-4015-941c-41ab5e96ca5a",
                                                "sense_id": "05915b85-ab5f-3f26-a18a-d06b71902c13",
                                                "text": "The job was a snap. I travelled the country averaging a thousand miles a week and, since the previous incumbent had been a lazy bugger, managed to treble the business. It was a cinch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e953a0-e4f1-3adb-aa89-5d84caf2e51e",
                                        "entry_id": "217f2765-e4cb-35dd-aafc-c68f916ad7ce",
                                        "glosses": [
                                            "Something that is obvious or certain to occur; a sure thing."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c749331d-dec0-44a2-8989-4701f10ea199",
                                                "sense_id": "79e953a0-e4f1-3adb-aa89-5d84caf2e51e",
                                                "text": "As a matter of fact, from the look of Elmer's shoulder, it wasn't a cinch that he would ever pitch again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f3598a-4832-30ab-8fb2-047852e511b7",
                                        "entry_id": "217f2765-e4cb-35dd-aafc-c68f916ad7ce",
                                        "glosses": [
                                            "A firm hold."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e768736-620e-466b-a7d5-c731f1a93cae",
                                                "sense_id": "76f3598a-4832-30ab-8fb2-047852e511b7",
                                                "text": "You've got the cinch on him. You could send him to quod, and I'd send him there as quick as lightning. I'd hang him, if I could, for what he done to Lil Sarnia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cinch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c961fde-28ab-3990-b2b3-3f7c5e7aa84d",
                                        "entry_id": "a1cbaf36-ac9a-3ee4-9e2b-cb7ea22a08c4",
                                        "glosses": [
                                            "To bring to certain conclusion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9996d50e-45fa-3818-81c6-1aa04b17f74e",
                                        "entry_id": "a1cbaf36-ac9a-3ee4-9e2b-cb7ea22a08c4",
                                        "glosses": [
                                            "To tighten down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85593e1b-4bf2-4793-8e25-046478ce6c98",
                                                "sense_id": "9996d50e-45fa-3818-81c6-1aa04b17f74e",
                                                "text": "[Ostriches] also lack the tiny hooks, or barbicels, that cinch feathers together in most other birds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cinch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
