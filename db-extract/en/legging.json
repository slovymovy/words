                    },
                    {
                        "sense_id": "8b7874f3-2261-3bb5-b3aa-5318451efbe3",
                        "entry_id": "94f12e66-85b0-3553-bd53-39a8cd62f202",
                        "glosses": [
                            "One of the legs of a pair of trousers."
