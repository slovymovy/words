                "senses": [
                    {
                        "sense_id": "af4a1e2d-37c2-39fa-aa4e-23c4b13f5568",
                        "entry_id": "d3df53ba-5231-3777-9f66-d17cce4061e8",
                        "glosses": [
                            "einen Algorithmus benutzen, der nach der Maximin-Regel verfährt"
                        ],
                        "tags": [
                            "Entscheidungstheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "3a9828cb-56af-458f-bc6e-50bab2ca2b79",
                                "sense_id": "af4a1e2d-37c2-39fa-aa4e-23c4b13f5568",
                                "text": "„Specifically, he could commit himself by taking the choice out of his own hands; he could for example give appropriate irreversible instructions to his agent, and then go home and sleep a just man's sleep, knowing that he has maximined.“"
                            },
                            {
                                "example_id": "220157ec-14f0-48e9-8dc2-043961157ed2",
                                "sense_id": "af4a1e2d-37c2-39fa-aa4e-23c4b13f5568",
                                "text": "„First is the internal stability of the set of Slater maximins (cf. Proposition 2.3), which the associated saddle points cannot provide.“"
                            },
                            {
                                "example_id": "411c3c56-857a-4f18-af4a-bf2a227d2178",
                                "sense_id": "af4a1e2d-37c2-39fa-aa4e-23c4b13f5568",
                                "text": "„Private property holdings allow national income to be maximised (more accurately maximinned), and also allow individuals to pursue their own goals in their own ways;“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
