                    {
                        "sense_id": "8b7b722b-235b-3be2-b482-62e15c4a13c0",
                        "entry_id": "6d2e25b8-06b8-3943-b94f-be60cede69b2",
                        "glosses": [
                            "The action of the verb to kick."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18485e8e-16e5-43c7-b9fe-a017c756ea98",
                                "sense_id": "8b7b722b-235b-3be2-b482-62e15c4a13c0",
                                "text": "In boxing, kicking one's opponent is not allowed."
                            }
                        ]
                    },
                    {
                        "sense_id": "0155dd5b-5a87-31de-9b52-0fdeec834ed2",
                        "entry_id": "6d2e25b8-06b8-3943-b94f-be60cede69b2",
                        "glosses": [
                            "A violent assault involving repeated kicks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cfc56c9-694b-43b0-b252-e2e932007c2f",
                                "sense_id": "0155dd5b-5a87-31de-9b52-0fdeec834ed2",
                                "text": "The bullies pushed the boy over and gave him a kicking."
                            }
                        ]
                    },
                    {
                        "sense_id": "4076a9e8-91a6-30c6-9d4d-6919177e04c2",
                        "entry_id": "6d2e25b8-06b8-3943-b94f-be60cede69b2",
                        "glosses": [
                            "A great loss or defeat; licking."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6a6ac81d-bd87-4261-a23d-7cbed2ee0197",
                                "sense_id": "4076a9e8-91a6-30c6-9d4d-6919177e04c2",
                                "text": "It’s always fun when something massive comes along and sweeps the board, giving everything else a thoroughly good kicking – think Titanic, The Silence of the Lambs, or Lord of the Rings. There’s a sort of deranged, gluttonous feeling, a perverse glee in seeing so many dreams trampled on by a massive cultural juggernaut."
                            }
                        ]
                    },
                    {
                        "sense_id": "7addb88c-ce62-3514-9c1e-187b2df17a69",
                        "entry_id": "6d2e25b8-06b8-3943-b94f-be60cede69b2",
                        "glosses": [
                            "A performance art that is a mix of dance footwork, acrobatic maneuver, and martial arts kicks, drawn from a variety of disciplines. Used in stage dance choreography and staged fight choreography."
                        ],
                        "tags": [],
                        "examples": []
                    }
