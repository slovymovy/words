                                                "sense_id": "a9300804-febc-3025-bfe1-8726d39c6c5a",
                                                "text": "Het gehele proces is overgenomen door de techniek."
                                            },
                                            {
                                                "example_id": "bb536c7c-e8db-4eff-8ba4-58b11abeb4ec",
                                                "sense_id": "a9300804-febc-3025-bfe1-8726d39c6c5a",
                                                "text": "Het was gek om mijn gezondheid helemaal in handen van deze wonderlijke techniek te leggen, maar het leek mij de meest efficiënte optie."
                                            }
