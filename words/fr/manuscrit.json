            "senses": [
                {
                    "sense_id": "366f507c-4b95-3b9b-8f4b-5d59def0ec31",
                    "sense_definition": "Texte original d'une œuvre littéraire ou scientifique rédigé par un auteur avant sa publication.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ecrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain a enfin envoyé son <w>manuscrit</w> à plusieurs grandes maisons d'édition."
                        },
                        {
                            "text": "Elle a passé tout l'été à relire et corriger le <w>manuscrit</w> de son premier roman."
                        }
                    ],
                    "common_phrases": [
                        "manuscrit original",
                        "envoyer un manuscrit",
                        "corriger un manuscrit"
                    ]
                },
                {
                    "sense_id": "471cc128-af2d-397f-a54a-1870aa59bc51",
                    "sense_definition": "Document ancien ou livre précieux écrit ou copié à la main avant l'apparition de l'imprimerie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La bibliothèque conserve un précieux <w>manuscrit</w> médiéval orné de superbes enluminures."
                        },
                        {
                            "text": "Des chercheurs venus du monde entier étudient ces rares <w>manuscrits</w> anciens."
                        }
                    ],
                    "common_phrases": [
                        "manuscrit médiéval",
                        "manuscrit enluminé",
                        "collection de manuscrits"
                    ]
                },
                {
                    "sense_id": "4ac2547a-6934-3595-99bd-599f79e4793c",
                    "sense_definition": "Document écrit à la main, par opposition aux textes imprimés ou dactylographiés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est parfois très difficile de déchiffrer l'écriture sur ce vieux <w>manuscrit</w>."
                        },
                        {
                            "text": "Nous avons comparé le texte imprimé avec le <w>manuscrit</w> pour vérifier les variantes."
                        }
                    ],
                    "common_phrases": [
                        "lire un manuscrit"
                    ]
                }
            ]
        },
        {
