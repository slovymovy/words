                        "glosses": [
                            "Qui se rapporte à l’œuvre cinématographique de Michelangelo Antonioni."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33055f58-e47b-4caf-b931-8fc532898725",
                                "sense_id": "6228e3b4-17cd-305e-a0ba-136bc0cf7b97",
                                "text": "L’homme antonionien est un être fragile, déconcerté par l’attitude des femmes et incapable d’assumer ses propres sentiments."
                            },
