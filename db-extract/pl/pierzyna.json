                "senses": [
                    {
                        "sense_id": "5d9a2ebc-8bc9-332a-9045-dc0e6cee368c",
                        "entry_id": "93a3c3ff-dba6-3caa-92d4-fb2d41ccdd43",
                        "glosses": [
                            "gruba kołdra wykonana z pierza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "446b1241-19d6-43cc-83b4-a82f741101d1",
                                "sense_id": "5d9a2ebc-8bc9-332a-9045-dc0e6cee368c",
                                "text": "To też, gdy mu się jednego razu udało wejść do izby chyłkiem i nieobaczkiem, wskoczył na łóżko, zakopał się głęboko w pierzynie i zasnął"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "331c5615-8f83-3fae-a20d-95f4873cb3f0",
                        "entry_id": "93a3c3ff-dba6-3caa-92d4-fb2d41ccdd43",
                        "glosses": [
                            "warstwa okrywająca"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "10248fef-e28b-4398-8c9c-80121480c388",
                                "sense_id": "331c5615-8f83-3fae-a20d-95f4873cb3f0",
                                "text": "Śnieg okrył białą pierzyną cały ogród."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0a89a36-1bb4-441e-a71c-ef6cf320f822",
                        "source_entry_id": "93a3c3ff-dba6-3caa-92d4-fb2d41ccdd43",
                        "source_sense_id": "5d9a2ebc-8bc9-332a-9045-dc0e6cee368c",
                        "target_lang_word": "featherbed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "featherbed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0d81a2-65dc-3b48-bce1-f14fa27537a8",
                                        "entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                                        "glosses": [
                                            "A mattress stuffed with feathers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                                        "entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                                        "glosses": [
                                            "An area of bog where a layer of moss covers a pool of water or mud, presenting a hazard to walkers who may fall through it. (Also in UK and Irish placenames.)"
                                        ],
                                        "tags": [
                                            "UK",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4db97f-b3ff-4f9d-859a-2f0b3b9735ab",
                                                "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                                                "text": "There are mires, bogs, and 'featherbeds' or quaking bogs. With the first two, look for the tussocks of heavy grass or rushes around the edges, which offer a relatively firm footing, but if you see a stretch of bright green sphagnum moss, for God's sake stay away from it. The moss is a mat covering a pit of wet ooze; […]"
                                            },
                                            {
                                                "example_id": "fb08ec2a-19c5-4b47-9502-48c410155187",
                                                "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                                                "text": "[…] bog. The writers and the old fellows you meet in pubs will tell you to look out for grass or 'bright green areas', and to fear the land that looks the easiest; but bogs - 'featherbeds', the locals call them - might be marked[…]"
                                            },
                                            {
                                                "example_id": "3ee930ba-bf05-43ad-9a1c-3a6413c8535d",
                                                "sense_id": "cea80f5b-0bef-330b-a673-e1d7a1fa3601",
                                                "text": "[...] a featherbed bog of moss and cotton grasses. Much of their effort has just burned away to nothing — the peat giving[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ecf8132-3c4b-3beb-8002-3892d98ad642",
                                        "entry_id": "f6976bad-fffa-3087-b4af-ed5008645521",
                                        "glosses": [
                                            "A soft, slow pitch of predictable bounce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "featherbed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1067d64e-4480-31e2-825d-81e40b748598",
                                        "entry_id": "0c1da32a-8ae6-3620-b29a-46ea99261824",
                                        "glosses": [
                                            "To treat someone with excessive indulgence; to pamper, cosset or mollycoddle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38572377-2b4f-3bf0-99a0-afca9f790edb",
                                        "entry_id": "0c1da32a-8ae6-3620-b29a-46ea99261824",
                                        "glosses": [
                                            "To engage in featherbedding; to employ more workers than necessary to fulfill a labor union requirement."
                                        ],
