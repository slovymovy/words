                ],
                "senses": [
                    {
                        "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                        "entry_id": "afe7382d-3c5a-32ce-bea0-0a4f8eb8894e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ed1772-0bb1-4c78-815b-5efcfdb3d6df",
                                "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                                "text": "Frau Küntzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dc034e09-c644-4e76-bd3e-35efea36da8c",
                                "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                                "text": "Herr Küntzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "36fd0ca2-3a03-44a8-bbca-b5912558b9d2",
                                "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                                "text": "Die Küntzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "79dd350f-0983-4dfa-b16e-6e8ea5583a73",
                                "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                                "text": "Der Küntzle trägt nie die Schals, die die Küntzle ihm strickt."
                            },
                            {
                                "example_id": "8ae9f476-0f5d-4901-ac4a-9b65e0ae31c6",
                                "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Küntzle kommt, geht der Herr Küntzle.“"
                            },
                            {
                                "example_id": "28cc8cf9-fdd4-4f1a-a1c0-da6edf187c1d",
                                "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                                "text": "Küntzle kommt und geht."
                            },
                            {
                                "example_id": "a8dc7501-0da8-44c2-80f7-0acd6a670582",
                                "sense_id": "f30b3a6a-489e-3a8a-a8cf-733886c56729",
                                "text": "Küntzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
