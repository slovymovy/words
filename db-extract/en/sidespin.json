                        "examples": [
                            {
                                "example_id": "6f3b6956-5580-412a-a21c-20286fa9a346",
                                "sense_id": "e91193ff-d05d-380e-9418-306d5aa906d9",
                                "text": "When a right-handed golfer hits a ball with a clockwise sidespin (when viewed from the top), it is called a fade or if extreme a slice and the flight of the ball will curve to the right."
                            },
                            {
                                "example_id": "cd136737-827b-42cd-b97c-349180fdaa9e",
                                "sense_id": "e91193ff-d05d-380e-9418-306d5aa906d9",
                                "text": "When a right-handed golfer hits a ball with an anticlockwise sidespin (when viewed from the top), it is called a draw or if extreme a hook and the flight of the ball will curve to the left."
                            }
                        ]
