                ],
                "senses": [
                    {
                        "sense_id": "fe7f7c65-0a19-33e3-81c2-9d81b743936a",
                        "entry_id": "1cf293e0-d853-335d-97a4-503e2107fe27",
                        "glosses": [
                            "mehrjährige Pflanze mit leuchtend roten bis purpurnen Blüten und roten, essbaren Früchten, die im Norden Eurasiens und in Nordamerika vorkommt (Rubus arcticus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51bfeb6e-b49b-47dc-af89-7b205ef52a5b",
                                "sense_id": "fe7f7c65-0a19-33e3-81c2-9d81b743936a",
                                "text": "„Schokolade findet sich als Stichwort auch in der Neuauflage von Waverley Roots köstlicher Enzyklopädie. Alles, was man essen kann.Eine kulinarische Weltreise von Aakerbeere bis Zwiebel (a. d. Engl. von Melanie Walz; Eichborn Verlag, Frankfurt a. M. 2003; 408 S., 19,90 ¤). Gesund oder nicht spielt da jedoch keine Rolle.“"
                            },
                            {
                                "example_id": "f6359bd6-b703-4874-9e41-bf73b91cd6a7",
                                "sense_id": "fe7f7c65-0a19-33e3-81c2-9d81b743936a",
                                "text": "„Die Aakerbeere [oder] Arktische Brombeere (R[ubus] arcticus) […] ist in N[ord]europa heimisch[, hat einen] 10 [bis] 20 cm [hohen Stängel], langgestielte, [drei]- bis [fünf]zählige gefiederte Blätter[,] große rote Blüten von Juli [bis] August [und] würzig schmeckende Früchte.“"
                            },
                            {
                                "example_id": "21e6ba4b-73c5-4a40-877d-3062e412f7e6",
                                "sense_id": "fe7f7c65-0a19-33e3-81c2-9d81b743936a",
                                "text": "Die Aakerbeere gehört zur Gattung der Rosengewächse mit rund 700 Arten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5e31d75-1fa6-3625-b358-1d2e3441cfac",
                        "entry_id": "1cf293e0-d853-335d-97a4-503e2107fe27",
                        "glosses": [
                            "essbare Frucht von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ac1813-ef37-4b94-9d81-b2c1c95e42ab",
                                "sense_id": "c5e31d75-1fa6-3625-b358-1d2e3441cfac",
                                "text": "Die Aakerbeere ist eine gelblich-bräunliche Frucht und schmeckt würzig."
                            },
                            {
                                "example_id": "d16b392b-601b-49b2-9ac7-e3ce1a8e123b",
                                "sense_id": "c5e31d75-1fa6-3625-b358-1d2e3441cfac",
                                "text": "„Von Aakerbeere bis Yamswurzel kann man in diesem amüsant geschriebenen Lexikon über alle Lebensmittel Neuigkeiten erfahren, an die man vorher nie gedacht hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
