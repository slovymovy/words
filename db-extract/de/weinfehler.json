                "senses": [
                    {
                        "sense_id": "a8eba4a7-f4ef-38b9-bc27-ac12e8cdbef2",
                        "entry_id": "9a50ad61-a37f-3c42-8220-a2c9f4fb9254",
                        "glosses": [
                            "eine Sammelbezeichnung für unerwünschte Geschmacks-, Geruchs- oder optische Eindrücke im Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85fb8e03-70cc-4c2c-a4bd-95183702c350",
                                "sense_id": "a8eba4a7-f4ef-38b9-bc27-ac12e8cdbef2",
                                "text": "Der häufigste Weinfehler ist der sogenannte Korkgeschmack."
                            },
                            {
                                "example_id": "c7c6ef56-bbbd-4ede-81b6-88239d495a62",
                                "sense_id": "a8eba4a7-f4ef-38b9-bc27-ac12e8cdbef2",
                                "text": "„Weinfehler können entweder bei der Produktion entstehen (z. B. durch unerwünschte Effekte bei der Gärung), bei der Lagerung (Oxidation) oder durch externe Materialien (Korkfehler) in den Wein gebracht werden.“"
                            },
                            {
                                "example_id": "878beee0-bf6f-4890-88d8-36ddf84f3414",
                                "sense_id": "a8eba4a7-f4ef-38b9-bc27-ac12e8cdbef2",
                                "text": "„Einige typische Weinfehler sind: Rahnwerden (Bräunung durch Polyphenoloxidasen) […], Luftgeschmack (Sherryton) […], Weißer, grauer, schwarzer Bruch […], Böchser Böckser […], Metallgeschmack, Altersgeschmack, Fassgeschmack (Holzgeschmack), […] Stopfengeschmack (Korkgeschmack).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
