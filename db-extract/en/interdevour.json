                        "glosses": [
                            "Of many people, creatures etc.: to devour each other."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1850321a-72b8-4a54-90f5-d6b87ce72ef5",
                                "sense_id": "1add1cf9-61c6-3303-b37b-142a5dcae921",
                                "text": "Epicurus said of the lawes that the worst were so necessary unto us, that without them men would enterdevour one another."
                            },
                            {
                                "example_id": "68c998ff-4db4-40eb-9b1d-e28e2efd3a76",
                                "sense_id": "1add1cf9-61c6-3303-b37b-142a5dcae921",
                                "text": "His prime suspect for cannibalism was a nightmarish object — a pack of nine galaxies in a feeding frenzy, interdevouring one another."
                            }
                        ]
                    }
