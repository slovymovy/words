                        "glosses": [
                            "Werkzeug, das von einem Elektromotor angetrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7c5c9c-834e-4220-bbe6-b004b5c136cb",
                                "sense_id": "2a3ba0d0-2414-30cd-99da-3f2a5d75559f",
                                "text": "„Das neutrale VDE-Institut kennt die Anforderungen, die an ein Elektrowerkzeug gestellt werden.“"
                            },
                            {
                                "example_id": "c23d4652-7f3d-4ded-8eae-2ca75aa4280f",
                                "sense_id": "2a3ba0d0-2414-30cd-99da-3f2a5d75559f",
                                "text": "„Mit diesem Wissen wurde schließlich der Akkuschrauber Ixo entwickelt, der laut Bosch das meistverkaufte Elektrowerkzeug der Welt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
