{
    "word_family": [
        "embarkation",
        "disembark",
        "disembarkation",
        "re-embark"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72819aaa-f1b7-3171-8a4a-6633fdb8dde8",
                    "sense_definition": "To begin a new project, journey, or course of action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After graduating from university, she decided to <w>embark</w> on a career in international law.",
                            "target_lang_translations": {
                                "ru": "После окончания университета она решила <w>начать</w> карьеру в области международного права."
                            }
                        },
                        {
                            "text": "The company is ready to <w>embark</w> on a journey toward complete digital transformation.",
                            "target_lang_translations": {
                                "ru": "Компания готова <w>встать на путь</w> полной цифровой трансформации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "embark on a journey",
                        "embark on a career",
                        "embark on a mission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать новый проект, путешествие или курс действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начать",
                                "target_lang_sense_clarification": "приступить к какому-либо действию"
                            },
                            {
                                "target_lang_word": "встать на путь",
                                "target_lang_sense_clarification": "начать карьеру или образ жизни"
                            },
                            {
                                "target_lang_word": "отправиться",
                                "target_lang_sense_clarification": "начать путешествие"
                            },
                            {
                                "target_lang_word": "приступить",
                                "target_lang_sense_clarification": "начать выполнение задачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a350f13b-8b0f-3839-a72b-63fc5b052fcd",
                    "sense_definition": "To go on board a ship, aircraft, or other vehicle for transportation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain announced that all passengers should <w>embark</w> the vessel immediately.",
                            "target_lang_translations": {
                                "ru": "Капитан объявил, что всем пассажирам следует немедленно <w>подняться на борт</w> судна."
                            }
                        },
                        {
                            "text": "It is difficult to settle into a routine until everyone has <w>embarked</w> and the ship begins to move.",
                            "target_lang_translations": {
                                "ru": "Трудно войти в привычный ритм, пока все не <w>сядут</w> на корабль и он не тронется."
                            }
                        }
                    ],
                    "synonyms": [
                        "board",
                        "make sail",
                        "take shipping"
                    ],
                    "antonyms": [
                        "disembark"
                    ],
                    "common_phrases": [
                        "embark the ship",
                        "ready to embark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подняться на борт корабля, самолета или другого транспортного средства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "садиться",
                                "target_lang_sense_clarification": "на борт судна или самолета"
                            },
                            {
                                "target_lang_word": "подняться на борт",
                                "target_lang_sense_clarification": "войти на судно"
                            },
                            {
                                "target_lang_word": "погрузиться",
                                "target_lang_sense_clarification": "сесть на транспорт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cab97e8-7bb1-39bf-abbf-4c77e191da93",
                    "sense_definition": "To invest money, effort, or oneself into a particular business or venture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "investment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>embarked</w> his entire fortune in the risky trade of rare spices.",
                            "target_lang_translations": {
                                "ru": "Он <w>вложил</w> все свое состояние в рискованную торговлю редкими специями."
                            }
                        },
                        {
                            "text": "The entrepreneur <w>embarked</w> her capital in several tech startups last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году предпринимательница <w>инвестировала</w> свой капитал в несколько технологических стартапов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "embark one's fortune"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вкладывать деньги, усилия или самого себя в определенное дело или предприятие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладывать",
                                "target_lang_sense_clarification": "инвестировать капитал или силы"
                            },
                            {
                                "target_lang_word": "инвестировать",
                                "target_lang_sense_clarification": "вкладывать средства в бизнес"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fd9bcc2-f9b0-3162-a449-70933d1bd53d",
                    "sense_definition": "To cause someone or something to go on board a vessel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military officers worked quickly to <w>embark</w> the troops before the storm arrived.",
                            "target_lang_translations": {
                                "ru": "Офицеры работали быстро, чтобы <w>погрузить</w> войска до начала шторма."
                            }
                        },
                        {
                            "text": "They had to <w>embark</w> the heavy cargo using specialized cranes at the dock.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>погрузить</w> тяжелый груз с помощью специальных кранов в доке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "embark the troops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовать посадку людей или погрузку груза на борт судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производить посадку",
                                "target_lang_sense_clarification": "людей на борт"
                            },
                            {
                                "target_lang_word": "погружать",
                                "target_lang_sense_clarification": "войска или груз на судно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12b43c82-4749-3582-a1c2-aaedd0403b38",
                    "sense_definition": "To cover or enclose something with bark.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan chose to <w>embark</w> the frame with natural wood to give it a rustic look.",
                            "target_lang_translations": {
                                "ru": "Мастер решил <w>покрыть корой</w> раму, чтобы придать ей деревенский вид."
                            }
                        },
                        {
                            "text": "In some traditional building styles, they <w>embark</w> the exterior walls for insulation.",
                            "target_lang_translations": {
                                "ru": "В некоторых традиционных строительных стилях внешние стены <w>облицовывают корой</w> для изоляции."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или облицовывать что-либо корой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрывать корой",
                                "target_lang_sense_clarification": "для отделки или изоляции"
                            },
                            {
                                "target_lang_word": "облицовывать корой",
                                "target_lang_sense_clarification": "декорировать деревом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}