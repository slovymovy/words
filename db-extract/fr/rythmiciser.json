                "senses": [
                    {
                        "sense_id": "a35e989e-12a6-3794-af34-4583c1073e59",
                        "entry_id": "59bb30d6-0849-36f0-a5ba-a7ed1e558aa7",
                        "glosses": [
                            "Donner un caractère rythmique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0d8ba41-a223-4784-ba28-decb84f467be",
                                "sense_id": "a35e989e-12a6-3794-af34-4583c1073e59",
                                "text": "Ainsi, les composantes posturales dominantes – boire, séparer, rythmiciser – que met au jour Gilbert Durand éclairent trois expériences relationnelles de l’humain avec son milieu, dont l’eau."
                            },
                            {
                                "example_id": "cc7b72f4-8208-4442-9e78-6fae9119054b",
                                "sense_id": "a35e989e-12a6-3794-af34-4583c1073e59",
                                "text": "L’ouvrier est décervelé, son corps psychomoteur se trouve engrené et rythmicisé par la machine, les ordres des petits chefs, l’automate que dirige l’entrepreneur."
                            }
                        ]
                    }
