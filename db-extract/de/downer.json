                "senses": [
                    {
                        "sense_id": "e6351757-f45e-3d24-b3d3-dea04cedc16b",
                        "entry_id": "d7a83999-e058-3316-88c7-66d761bf4898",
                        "glosses": [
                            "Rauschmittel, das den Konsumenten beruhigt, träge und müde macht"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "0c4cfd18-eafa-4542-8a90-9c8b4153f8e4",
                                "sense_id": "e6351757-f45e-3d24-b3d3-dea04cedc16b",
                                "text": "„Jetzt wollte er nur noch ein paar Bier kippen, ein paar Downer einwerfen und ins Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68cd3da9-1506-4d99-9e3f-e23ca890f097",
                        "source_entry_id": "d7a83999-e058-3316-88c7-66d761bf4898",
                        "source_sense_id": "e6351757-f45e-3d24-b3d3-dea04cedc16b",
                        "source_sense_description": "Jargon: Rauschmittel, das den Konsumenten beruhigt, träge und müde macht",
                        "target_lang_word": "downer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39ceb4a0-4475-3f68-b25d-f026fe305b22",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A negative drug trip."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded3a653-477d-4821-ad61-d331efd74de7",
                                                "sense_id": "39ceb4a0-4475-3f68-b25d-f026fe305b22",
                                                "text": "Normally those pills give me a boost, but last night they gave me a downer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079e5dab-0fd2-3233-8f66-91b9f0d3f35f",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A drug that has depressant qualities."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f35105-c6e6-499e-a970-21eb4ed49efd",
                                                "sense_id": "079e5dab-0fd2-3233-8f66-91b9f0d3f35f",
                                                "text": "Say, for example, a person starts with the use of a downer that reduces any anxiety and produces a sense of relaxation. When their energy levels drop, they take a stimulant in order to continue participating in the party or another event. This creates a cycle that could lead to significant drug use and drastically increases the risk of overdose or death. It is critical to know which drugs are uppers and downers to avoid this combination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "274e63df-98dd-36ed-8274-f4f792f18cdd",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "Something or someone disagreeable, dispiriting or depressing; a killjoy."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8125738-230a-4fb4-99db-68bb2023f56a",
                                                "sense_id": "274e63df-98dd-36ed-8274-f4f792f18cdd",
                                                "text": "You don't really need to know me. I'm kind of a downer."
                                            },
                                            {
                                                "example_id": "2c4bcca4-8009-49c2-99d6-006e3ddd5cd1",
                                                "sense_id": "274e63df-98dd-36ed-8274-f4f792f18cdd",
                                                "text": "Geffen had never understood why such a downer of a film was being released over the holidays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A livestock animal that has collapsed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a7156fd-e6fb-41e3-97ae-cdab34abf9a5",
                                                "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                                "text": "The ten-dollar bill was for eating money and the prod pole to be used when the train stopped for water in getting \"downers\" back on their feet."
                                            },
                                            {
                                                "example_id": "6fd6a573-09bb-403b-83df-501b487e7e94",
                                                "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                                "text": "In 1993, Farm Sanctuary produced undercover footage of downers being lifted by forklift at Hallmark, prompting introduction of a California downer cattle law the next year. Either management provided instructions to get the downers moving or was asleep at the wheel and let employees run wild — in either case, it's an indictment of management."
                                            },
                                            {
                                                "example_id": "fbf3f1d5-4397-493a-a7b5-e1d8b638c66d",
                                                "sense_id": "6014c41a-f6ae-377b-a018-52996fbe69a8",
                                                "text": "The two plants where I saw great reductions in downers have reduced, but not eliminated Paylean use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083fb389-b1ed-3285-9634-5abe65cd9464",
                                        "entry_id": "581767a2-1fb4-3ec7-ae30-9337597a3a50",
                                        "glosses": [
                                            "A form of industrial action in which workers down tools and refuse to work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa60377-b41d-4743-b9b8-05f767014ea0",
                                                "sense_id": "083fb389-b1ed-3285-9634-5abe65cd9464",
                                                "text": "In the Workplace Industrial Relations Survey, a strike may be a downer or a stoppage as defined by the Department."
                                            },
                                            {
                                                "example_id": "36c414cb-acc7-4c1f-81af-cc718f874a8d",
                                                "sense_id": "083fb389-b1ed-3285-9634-5abe65cd9464",
                                                "text": "Cowley experienced a rash of 'downers' — short, sharp, unofficial strikes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ffec4b5-6b6a-3af1-adef-96e27c81f955",
                                        "entry_id": "fd2f7c51-07a1-3a15-a776-c84b60c3925e",
                                        "glosses": [
                                            "A sixpence."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d07ca8-735d-4676-b6d5-05fc4e0bb0e9",
                                                "sense_id": "5ffec4b5-6b6a-3af1-adef-96e27c81f955",
                                                "text": "The price of a case (five shillings piece bad) from the smasher is about one shilling; an alderman (two and sixpence) about sixpence; a peg (shilling) about threepence; a downer or sprat (sixpence) about twopence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
