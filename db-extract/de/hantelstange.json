                ],
                "senses": [
                    {
                        "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                        "entry_id": "7eb17b72-0be8-3d6d-ae42-df599feba023",
                        "glosses": [
                            "Stange zum Greifen, auf der unterschiedliche Gewichte aufgeschoben werden können; Teil der Langhantel"
                        ],
                        "tags": [
                            "Gewichtheben",
                            "Krafttraining",
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "ebd7d00d-e919-4c77-a5d5-59c1b6d4f44a",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "Du darfst die Gewichte nicht nur auf die Hantelstange schieben, du musst sie auch mit dem Verschluss sichern."
                            },
                            {
                                "example_id": "31fc66e9-202b-4d8a-8c8f-0ef3b7b03786",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "„Eine um die zwei Meter lange Eisenstange und diverse Hantelscheiben unterschiedlichen Gewichts, zwei Verschlüsse, damit die Scheiben nicht von der Hantelstange rutschen – fertig! Einsatzbereit ist die Langhantel.“"
                            },
                            {
                                "example_id": "72ac19d8-b294-44ed-8652-de50476ae04c",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "Ich übte das Umsetzen zuerst mit einem Besenstiel, nach 14 Tagen mit der Hantelstange, aber ohne Gewichte, und erst als ich die Technik sicher beherrschte mit Gewichten."
                            },
                            {
                                "example_id": "ebc0cc07-4a16-4722-a9bf-61e414c0a9f7",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "„Ende Januar hockte Harting im Kraftraum, nicht fähig, eine Hantelstange ohne Gewichte zu stemmen.“"
                            },
                            {
                                "example_id": "df1308fb-e341-4ab4-aa16-d941591083bc",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "„Jetzt will sich Heiligensetzer herunterbeugen, um eine Hantelstange zu greifen.“"
                            },
                            {
                                "example_id": "ecc8437f-0ffa-4a81-842f-718238e1b25b",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "„Steiner schreit kurz und kehlig, dann liegt er seltsam verdreht auf seinem Bauch und macht, von der Hantelstange eingeklemmt, gar nichts mehr.“"
                            },
                            {
                                "example_id": "13d2c39e-9572-457c-8a8e-0a2c7b48f39a",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "„Heute steht Krafttraining auf dem Programm. Kombiniererinnen brauchen schnellkräftige Beine für den Absprung und die Landung. Eine Übung dafür: Kniebeugen mit Hantelstange.“"
                            },
                            {
                                "example_id": "6527f222-a576-4121-9a96-08f2f768071c",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "„Eigentlich ist die Langhantel nur eine rund zwei Meter lange Eisenstange, auf die Hantelscheiben unterschiedlichen Gewichts geschoben werden. Kein Strom, keine Displays, keine Kabelzüge und Umlenkrollen, keine komplizierte Mechanik. Nur zwei Verschlüsse, damit die Scheiben nicht von der Hantelstange rutschen.“"
                            },
                            {
                                "example_id": "8fdac4fb-9119-475b-a58f-970b4d0afcd8",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "[Coronapandemie:] „Weil die Fitnessstudios geschlossen sind, ist die Nachfrage bei Fitnessgeräten enorm hoch. Am meisten gefragt sind schwere Gewichte, Hanteln und Hantelstangen.“"
                            },
                            {
                                "example_id": "8629305a-8733-428f-acb6-701233fe20f8",
                                "sense_id": "ff96ae26-cfbf-3096-8eaf-7d5fd034333b",
                                "text": "„Der junge Mann hatte in einer Flüchtlingsunterkunft mit einer Hantelstange Polizisten angegriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
