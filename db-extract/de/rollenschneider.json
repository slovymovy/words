                "senses": [
                    {
                        "sense_id": "1a0480be-9928-3ee8-831e-5fd2ddc8b409",
                        "entry_id": "6518fb4c-110d-3313-a81e-615bcc653b4c",
                        "glosses": [
                            "Gerät mit runder Messerklinge zum Beschneiden von Materialien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0dc806c-7a90-4eee-a07d-663a827de8ef",
                                "sense_id": "1a0480be-9928-3ee8-831e-5fd2ddc8b409",
                                "text": "„Die Metallfolien konnten mit geringem Kraftaufwand mit einem Cuttermesser oder Rollenschneider zugeschnitten werden.“"
                            },
                            {
                                "example_id": "615a008f-d9e7-44a8-adef-784098d25fdc",
                                "sense_id": "1a0480be-9928-3ee8-831e-5fd2ddc8b409",
                                "text": "„Für das Zuschneiden verwendet man einen Rollenschneider mit kleiner Klinge oder eine gute, scharfe Schneiderschere.“"
                            },
                            {
                                "example_id": "faf89c03-2846-4a29-baf0-8ac0627e3248",
                                "sense_id": "1a0480be-9928-3ee8-831e-5fd2ddc8b409",
                                "text": "„Den Teig rollt man aus und schneidet mit einem Rollenschneider etwa 5 cm dicke, fingerbreite Nudeln.“"
                            },
                            {
                                "example_id": "853b60c0-f939-4165-b50f-b71fe4f72aa3",
                                "sense_id": "1a0480be-9928-3ee8-831e-5fd2ddc8b409",
                                "text": "„Mit einem Rollenschneider wurden jeweils 100 mm * 10 mm lange, rechteckige Streifen in Produktionsrichtung zugeschnitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
