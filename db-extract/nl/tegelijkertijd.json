        "nl-extract.jsonl": [
            {
                "entry_id": "b40e042d-af22-3795-a874-e7b8434965ce",
                "word": "tegelijkertijd",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                        "entry_id": "b40e042d-af22-3795-a874-e7b8434965ce",
                        "glosses": [
                            "op hetzelfde moment, gelijktijdig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cee3869-d131-4f61-9df5-bca3591f8920",
                                "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                                "text": "Dan kun je dat tegelijkertijd laten doen."
                            },
                            {
                                "example_id": "0b5aac36-97c4-49a8-ba9f-1c331b65a17a",
                                "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                                "text": "Zweden koos aan het begin van de coronacrisis een aanpak die afweek van die in veel andere landen in Europa: scholen, sportscholen, horecazaken en winkels bleven open. Wel moesten Zweden 1,5 meter afstand van elkaar houden op straat. Tegelijkertijd werd erop gerekend dat mensen de nieuwe coronaregels vrijwillig zouden naleven, tot afschuw van buurlanden."
                            },
                            {
                                "example_id": "2f733436-08a1-4c75-be50-b422c7c9bcb7",
                                "sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                                "text": "Het idee om een lange tijd alleen door te brengen trok mij enorm aan, maar vond ik tegelijkertijd doodeng omdat ik geen ervaring had met langdurig alleen zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c77be868-d215-43b8-9527-0e757bb9fcbb",
                        "source_entry_id": "b40e042d-af22-3795-a874-e7b8434965ce",
                        "source_sense_id": "7dd44211-2ee3-3523-8280-be25cd39a9aa",
                        "target_lang_word": "gleichzeitig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichzeitig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "zur selben/gleichen Zeit ablaufend, stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49837d2-81c0-43cc-a8bf-242674918503",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "Ich kann nicht gleichzeitig an verschiedenen Orten sein."
                                            },
                                            {
                                                "example_id": "078a879a-2b28-4615-ae03-f171711d8851",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„Seit der Jahrtausendwende könne jedoch ein Rückgang der Deutschlernenden bei gleichzeitigem Anstieg der Englischlernenden festgestellt werden.“"
                                            },
                                            {
                                                "example_id": "66fadb38-67bc-437f-9ba9-54ecd3ade6e7",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "auch noch, daneben, zugleich"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd657abb-350d-46ca-8119-0ccc5303950c",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„K. wartete noch ein Weilchen, sah von seinem Kopfkissen aus die alte Frau, die ihm gegenüber wohnte und die ihn mit einer an ihr ganz ungewöhnlichen Neugierde beobachtete, dann aber, gleichzeitig befremdet und hungrig, läutete er.“"
                                            },
                                            {
                                                "example_id": "915b2cf7-ea87-4aec-a48f-a00c5ed5c151",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Er war Edelmann und gleichzeitig Prolet."
                                            },
                                            {
                                                "example_id": "23df94f1-c644-441c-994c-690d3d55ddf7",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Unser Nachbar ist gleichzeitig unser Vermieter."
                                            },
                                            {
                                                "example_id": "dc804a4b-abf5-4711-804a-c64e6eb998a4",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„Gleichzeitig könnte der Vulkanausbruch auch das Ende der Trichterbecherkultur in Skandinavien eingeläutet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
