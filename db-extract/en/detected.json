                        "entry_id": "8e21d94b-2fea-343c-8892-99af93cd6edc",
                        "glosses": [
                            "Having been noticed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d334ca95-5dd6-4032-80c1-2563ad4e49f6",
                                "sense_id": "252aab5a-0df7-3cea-89a5-d203c27ff695",
                                "text": "The detected submarine was tracked by sonar, it was easy once they knew where to look."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "651fcfae-c48f-4b1e-9b5e-6fa34c8ab848",
                        "source_entry_id": "8e21d94b-2fea-343c-8892-99af93cd6edc",
                        "source_sense_id": "252aab5a-0df7-3cea-89a5-d203c27ff695",
                        "source_sense_description": "Referring to something that has been noticed",
                        "target_lang_word": "détecté",
