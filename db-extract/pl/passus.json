                "senses": [
                    {
                        "sense_id": "1ebfb958-211f-354f-84be-88dc39df3c7e",
                        "entry_id": "977b0a81-19c2-3783-a631-7d9d904bc155",
                        "glosses": [
                            "fragment tekstu, wyjątek z jakiejś książki, zazwyczaj jakiś szczególny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50b8be6-713f-4b61-81aa-b6b12d9bf612",
                                "sense_id": "1ebfb958-211f-354f-84be-88dc39df3c7e",
                                "text": "Już na pierwszych kartach książki, przykuł moją uwagę pewien interesujący passus."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e7e011ef-cb24-3dea-aa0b-d75912789a84",
                        "entry_id": "977b0a81-19c2-3783-a631-7d9d904bc155",
                        "glosses": [
                            "jakieś nieoczekiwane wydarzenie, które wydarzyło się w najmniej odpowiedniej chwili"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cd7bde3b-4a0d-4d4b-b622-cb216bc7bd0b",
                                "sense_id": "e7e011ef-cb24-3dea-aa0b-d75912789a84",
                                "text": "Od passusu z kradzieżą portfela, staram się nie nosić przy sobie dużej kwoty pieniędzy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "130d7e15-ef6c-4c5a-9eed-62ab359af506",
                        "source_entry_id": "977b0a81-19c2-3783-a631-7d9d904bc155",
                        "source_sense_id": "1ebfb958-211f-354f-84be-88dc39df3c7e",
                        "target_lang_word": "Passus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Passus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20cde29f-8cd8-3573-91b0-f2277f084864",
                                        "entry_id": "caed91b8-e51f-3bc0-bc3a-8bb910b482d7",
                                        "glosses": [
                                            "relativ kurzer Abschnitt eines laufenden Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b323175-130f-4178-8824-092e13fd6cfc",
                                                "sense_id": "20cde29f-8cd8-3573-91b0-f2277f084864",
                                                "text": "„Am Vorabend eines erneuten Protesttages gegen die Rentenreform verabschiedete der französische Senat einen besonders umstrittenen Passus des Gesetzes.“"
                                            },
                                            {
                                                "example_id": "36317737-cfd3-4c72-bcec-b2d7227eea86",
                                                "sense_id": "20cde29f-8cd8-3573-91b0-f2277f084864",
                                                "text": "„Dieser Passus erklärt ganz beiläufig, warum herausragende Kritik auf dem Feld der Kunst ebenso selten ist wie herausragende Werke – und warum beides im Grunde derselben Kategorie angehört.“"
                                            },
                                            {
                                                "example_id": "ed2ac7de-6453-4787-9d8e-a2c0747fa5b4",
                                                "sense_id": "20cde29f-8cd8-3573-91b0-f2277f084864",
                                                "text": "„Mir gefiel besonders der Passus, dass die älteren Mitbürger lernen sollten, ihre eigene Leistungsfähigkeit besser einzuschätzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
