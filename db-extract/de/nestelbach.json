                "senses": [
                    {
                        "sense_id": "e91904b2-8fa5-37df-9a25-3b2482afdfe0",
                        "entry_id": "57bcd655-a29a-38d6-861b-eae18718f648",
                        "glosses": [
                            "Name verschiedener Fließgewässer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4c7b7a1-53b1-4540-825b-95250321eecd",
                                "sense_id": "e91904b2-8fa5-37df-9a25-3b2482afdfe0",
                                "text": "Nestelbach ist ein früherer Name des Baches Nesselbach, der zwischen Bühlertann und Obersontheim von rechts in die Bühler mündet. Und auch im Wiener Gemeindebezirk Döbling gibt es einen außer Nesselbach auch Nestelbach genannten Bach, der dort in den Donaukanal mündet."
                            },
                            {
                                "example_id": "848189b4-afa6-4259-9e54-a81cd627d64d",
                                "sense_id": "e91904b2-8fa5-37df-9a25-3b2482afdfe0",
                                "text": "Der kurze Nestelbach mündet bei Nestelberg in der Gemeinde Sulzbach-Laufen in den Kocher-Zufluss Hopfenbach."
                            },
                            {
                                "example_id": "5a7be3ab-211b-4bcd-a743-d8bce1ce4cea",
                                "sense_id": "e91904b2-8fa5-37df-9a25-3b2482afdfe0",
                                "text": "Ein anderer Nestelbach ist linker Zufluss des Laßnitzbaches beim Ort Laßnitzthal in der Stadt Gleisdorf im steirischen Bezirk Weiz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
