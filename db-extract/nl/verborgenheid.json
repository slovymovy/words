                        "examples": [
                            {
                                "example_id": "43f7f77d-746e-49d6-8da4-7962776b8421",
                                "sense_id": "ac9ab544-fa59-3ea0-a262-e46259d98873",
                                "text": "Geen wonder dat de apostel spreekt van de „wijsheid Gods in verborgenheid.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "263385bc-3f0a-3691-8960-9d5ef2ee515c",
                        "entry_id": "949f4e00-d76e-33f4-8455-75897d1c9a92",
