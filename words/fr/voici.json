{
    "word_family": [
        "revoici"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b8bf555-4414-360a-835e-2d8a764a5372",
                    "sense_definition": "Sert à désigner ou à présenter une personne ou un objet proche dans l'espace ou la situation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Voici</w> les clés de votre nouvelle chambre d'hôtel."
                        },
                        {
                            "text": "Prenez une chaise et asseyez-vous, me <w>voici</w> enfin disponible."
                        }
                    ],
                    "synonyms": [
                        "voilà"
                    ],
                    "common_phrases": [
                        "me voici",
                        "en voici"
                    ]
                },
                {
                    "sense_id": "3d027bee-f8ad-3bc5-9af3-becb34fd1670",
                    "sense_definition": "Sert à annoncer immédiatement ce que l'on va dire, expliquer ou détailler.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Écoutez attentivement car <w>voici</w> ce que nous allons faire aujourd'hui."
                        },
                        {
                            "text": "<w>Voici</w> la liste des ingrédients nécessaires pour préparer ce gâteau."
                        }
                    ],
                    "common_phrases": [
                        "voici ce que",
                        "voici pourquoi"
                    ]
                },
                {
                    "sense_id": "9f50ed0f-b2a7-3ae8-9d3c-ba488dd547f3",
                    "sense_definition": "Sert à exprimer un état actuel ou une situation en cours de déroulement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un long voyage en train, nous <w>voici</w> enfin arrivés à destination."
                        },
                        {
                            "text": "<w>Voici</w> que la pluie commence à tomber sur la terrasse du jardin."
                        }
                    ],
                    "common_phrases": [
                        "nous voici",
                        "voici que"
                    ]
                },
                {
                    "sense_id": "82fa1a70-2bbc-3ee1-a9ed-e4c052c2616e",
                    "sense_definition": "S'emploie devant un infinitif pour annoncer une action imminente ou une arrivée soudaine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regardez au loin sur la route, <w>voici</w> venir le facteur avec notre courrier."
                        },
                        {
                            "text": "Après les rudes froids de l'hiver, <w>voici</w> venir les beaux jours du printemps."
                        }
                    ],
                    "common_phrases": [
                        "voici venir"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "tournure archaïque ou littéraire"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "6188c2f8-820d-3853-8f13-a1bed9ba7191",
                    "sense_definition": "Indique un moment antérieur pour marquer la durée écoulée depuis un événement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train pour la capitale est parti <w>voici</w> une dizaine de minutes seulement."
                        },
                        {
                            "text": "Nous avons acheté cette ancienne maison de campagne <w>voici</w> trois ans déjà."
                        }
                    ],
                    "synonyms": [
                        "il y a",
                        "voilà"
                    ],
                    "common_phrases": [
                        "voici peu",
                        "voici quelques jours"
                    ]
                }
            ]
        }
    ]
}