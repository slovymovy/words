                "senses": [
                    {
                        "sense_id": "4b84fabc-cea4-3b30-88c7-9fba36e70f54",
                        "entry_id": "29273eea-73c3-3b07-8f32-8bfa69f1ac45",
                        "glosses": [
                            "ein becherartiges Trinkgefäß, aus dem man Wein trinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe904fa4-0144-4283-8504-9bee441453c9",
                                "sense_id": "4b84fabc-cea4-3b30-88c7-9fba36e70f54",
                                "text": "Der Zecher leerte den Weinbecher."
                            },
                            {
                                "example_id": "e45b3c33-3e64-43cc-837a-8093d3b0d62a",
                                "sense_id": "4b84fabc-cea4-3b30-88c7-9fba36e70f54",
                                "text": "„Während Lenzbunt hinging, ließ Väsele Li durch Lenzfreude einen Stuhl holen, auch Weinbecher und Eßstäbchen dazu auf den Tisch setzen.“"
                            },
                            {
                                "example_id": "d2d57a91-1915-4adc-8155-193be56a44af",
                                "sense_id": "4b84fabc-cea4-3b30-88c7-9fba36e70f54",
                                "text": "„Robert trat mit dem Weinbecher zu ihm und forderte ihn auf, einen Schluck zu trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
