{
    "word_family": [
        "apply",
        "applicable",
        "applicant",
        "application",
        "applicator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eae6d85c-13a9-326a-978e-2f9efd583e57",
                    "sense_definition": "A machine or device, usually powered by electricity, used in the home for domestic tasks like cooking or cleaning.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "household_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many house fires are caused by faulty <w>appliances</w> such as refrigerators and washing machines.",
                            "target_lang_translations": {
                                "ru": "Многие домашние пожары вызваны неисправными <w>электроприборами</w>, такими как холодильники и стиральные машины."
                            }
                        },
                        {
                            "text": "We need to buy a new kitchen <w>appliance</w> to help with the cooking.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новый кухонный <w>прибор</w>, чтобы облегчить процесс готовки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kitchen appliance",
                        "household appliance",
                        "electrical appliance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина или устройство, обычно электрическое, используемое дома для бытовых задач, таких как приготовление пищи или уборка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бытовой прибор",
                                "target_lang_sense_clarification": "устройство для дома"
                            },
                            {
                                "target_lang_word": "электроприбор",
                                "target_lang_sense_clarification": "электрическое устройство"
                            },
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "бытовая техника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fcb7b7c-f717-364d-8793-ac8cbf04290f",
                    "sense_definition": "A tool, instrument, or piece of equipment designed to perform a specific task or function.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "household_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist used a specialized <w>appliance</w> to measure the chemical reaction.",
                            "target_lang_translations": {
                                "ru": "Ученый использовал специализированный <w>аппарат</w> для измерения химической реакции."
                            }
                        },
                        {
                            "text": "Every seed is armed with an <w>appliance</w> of dispersal to help it travel in the wind.",
                            "target_lang_translations": {
                                "ru": "Каждое семя снабжено <w>приспособлением</w> для распространения, помогающим ему перемещаться по ветру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mechanical appliance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, прибор или оборудование, предназначенное для выполнения определенной задачи или функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибор",
                                "target_lang_sense_clarification": "техническое устройство"
                            },
                            {
                                "target_lang_word": "аппарат",
                                "target_lang_sense_clarification": "механическое устройство"
                            },
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "механизм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6389aef-bacf-3bea-baf6-61e855084e8b",
                    "sense_definition": "An attachment or piece of equipment used to adapt a tool or machine for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "household_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This vacuum cleaner comes with a special <w>appliance</w> for cleaning thick carpets.",
                            "target_lang_translations": {
                                "ru": "Этот пылесос поставляется со специальной <w>насадкой</w> для чистки густых ковров."
                            }
                        },
                        {
                            "text": "The technician added a small <w>appliance</w> to the lathe to allow for more precise cutting.",
                            "target_lang_translations": {
                                "ru": "Техник добавил небольшое <w>приспособление</w> к токарному станку для более точной резки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Насадка или часть оборудования, используемая для адаптации инструмента или машины для конкретной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "вспомогательное устройство"
                            },
                            {
                                "target_lang_word": "насадка",
                                "target_lang_sense_clarification": "съемная деталь"
                            },
                            {
                                "target_lang_word": "оснастка",
                                "target_lang_sense_clarification": "техническое дополнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f00f67de-e887-3f0c-a9c3-e7e06815cf72",
                    "sense_definition": "The act of applying something, such as a treatment, ornament, or rule.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that the <w>appliance</w> of the remedy was just as important as the medicine itself.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что <w>применение</w> средства так же важно, как и само лекарство."
                            }
                        },
                        {
                            "text": "She admired the tasteful <w>appliance</w> of ornament on the historic building.",
                            "target_lang_translations": {
                                "ru": "Она восхищалась изысканным <w>наложением</w> орнамента на историческом здании."
                            }
                        }
                    ],
                    "synonyms": [
                        "application"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт применения чего-либо, например, лечения, украшения или правила."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "применение",
                                "target_lang_sense_clarification": "использование метода или средства"
                            },
                            {
                                "target_lang_word": "наложение",
                                "target_lang_sense_clarification": "например, повязки или украшения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac3c8fc5-1406-3d9b-b379-ea87a9105cce",
                    "sense_definition": "A means or method used to cure a disease or solve a desperate problem.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diseases that have grown desperate are often relieved by desperate <w>appliance</w>.",
                            "target_lang_translations": {
                                "ru": "Болезни, ставшие безнадежными, часто облегчаются отчаянными <w>средствами</w>."
                            }
                        },
                        {
                            "text": "The patient recovered quickly thanks to the <w>appliance</w> of modern medical techniques.",
                            "target_lang_translations": {
                                "ru": "Пациент быстро поправился благодаря <w>использованию</w> современных медицинских методов."
                            }
                        }
                    ],
                    "synonyms": [
                        "cure",
                        "medicine",
                        "remedy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used in older medical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средство или метод, используемый для излечения болезни или решения отчаянной проблемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "лечебное или вспомогательное"
                            },
                            {
                                "target_lang_word": "лекарство",
                                "target_lang_sense_clarification": "медицинский препарат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a9bb3ca-5550-340f-a74e-5811aae6c360",
                    "sense_definition": "The state of being willing to serve or act according to someone else's wishes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The courtier offered his humble <w>appliance</w> to the king during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Придворный выразил свою смиренную <w>покорность</w> королю во время церемонии."
                            }
                        },
                        {
                            "text": "I come to tender my <w>appliance</w> with all bound humbleness to your majesty.",
                            "target_lang_translations": {
                                "ru": "Я пришел засвидетельствовать свою <w>услужливость</w> со всем подобающим смирением перед вашим величеством."
                            }
                        }
                    ],
                    "synonyms": [
                        "compliance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние готовности служить или действовать в соответствии с чьими-либо пожеланиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "услужливость",
                                "target_lang_sense_clarification": "готовность помочь"
                            },
                            {
                                "target_lang_word": "покорность",
                                "target_lang_sense_clarification": "смиренное служение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}