                "senses": [
                    {
                        "sense_id": "b21b128b-8573-32c9-a240-516c14f91a47",
                        "entry_id": "63845370-f638-388a-acb9-b0ec6a8df5a8",
                        "glosses": [
                            "Rendre hygiénique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b231f0cc-4b53-4ce5-97d8-e336fc914ea0",
                                "sense_id": "b21b128b-8573-32c9-a240-516c14f91a47",
                                "text": "M. Triebel, Baudirektor, parla des possibilités d’hygiéniser les boues au moyen de la pasteurisation."
                            },
                            {
                                "example_id": "a9fdf9fa-92a9-4cda-adbd-676eb0eedc23",
                                "sense_id": "b21b128b-8573-32c9-a240-516c14f91a47",
                                "text": "Dans le cas d’un regroupement de déchets pour la production de biogaz, il est nécessaire d’hygiéniser les déchets avant de procéder au mélange."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e7b6a4a-6de0-4499-bb0b-02cc506a7454",
                        "source_entry_id": "63845370-f638-388a-acb9-b0ec6a8df5a8",
                        "source_sense_id": "b21b128b-8573-32c9-a240-516c14f91a47",
                        "target_lang_word": "sanitize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
