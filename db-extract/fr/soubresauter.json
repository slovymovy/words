                        "tags": [],
                        "examples": [
                            {
                                "example_id": "909ab382-0cbb-48f5-b89e-cb0bf951c571",
                                "sense_id": "0b666e04-628b-3b11-b1a5-dc532ad83650",
                                "text": "L’enfant était tombé sur le côté, sans sortir les mains de ses poches. Il soubresautait et on entendait claquer ses dents."
                            },
                            {
                                "example_id": "4d29928b-b6ab-4fe5-b374-ef7617dcca12",
                                "sense_id": "0b666e04-628b-3b11-b1a5-dc532ad83650",
                                "text": "Ça n’entend plus rien, ça voit trouble, ça dodeline de la tête, ça soubresaute une dernière fois et ça meurt."
                            }
                        ]
                    }
