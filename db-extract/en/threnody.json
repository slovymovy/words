                "senses": [
                    {
                        "sense_id": "437c7f9e-a309-3173-a027-e4b766f432c5",
                        "entry_id": "0d0b5beb-8d8c-3838-9c04-161c06b3cfa2",
                        "glosses": [
                            "挽歌；挽诗"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee4bd00-8bfe-4a91-8c60-0f3c3aa52ea4",
                                "sense_id": "437c7f9e-a309-3173-a027-e4b766f432c5",
                                "text": "The fifer actually knew but one tune \"The Bonnie Blue Flag\"—and did not know that well. But it was all that he had, and he played it with wearisome monotony for every camp call. . . . I never hated any piece of music as I came to hate that threnody of treason."
                            },
                            {
                                "example_id": "3a6b8565-c7a8-47b2-99e9-6427f1b8e9df",
                                "sense_id": "437c7f9e-a309-3173-a027-e4b766f432c5",
                                "text": "This was the boy whose memory lives in the tenderest and most pathetic of Emerson's poems, the \"Threnody,\"—a lament not unworthy of comparison with Lycidas for dignity."
                            }
                        ]
                    }
                ],
