                    {
                        "form_id": "65a83cb5-e4d8-4888-b6fa-ddb2d2525daf",
                        "entry_id": "3b48b271-1e6c-3609-a138-9ea8f3363187",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Trunksucht"
                    },
                    {
                        "form_id": "0b9c3cbc-372d-4723-987d-f00d95ee9ec2",
                        "entry_id": "3b48b271-1e6c-3609-a138-9ea8f3363187",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Trunksucht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                        "entry_id": "3b48b271-1e6c-3609-a138-9ea8f3363187",
                        "glosses": [
                            "zwanghafter Genuss alkoholischer Getränke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b73dce-91fa-4861-a2ed-74798ee44831",
                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                "text": "„Neben Klischees betonten die antiken Autoren gerne das Ungewöhnliche, Fremde und Exotische — so zum Beispiel die Trunksucht der Kelten.“"
                            },
                            {
                                "example_id": "71be6093-487b-468c-8a16-031a42413387",
                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                "text": "„Denn die Kolonialherren sorgten auch für die Verbreitung von Trunksucht und Tripper.“"
                            },
                            {
                                "example_id": "5663e6e6-451a-463b-9bf7-f9ab1e42cf23",
                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                "text": "„Die Heilsarmee hat ein großes Arbeitsfeld in den Hafenstädten, um der Trunksucht und anderen Lastern entgegenzutreten.“"
                            },
                            {
                                "example_id": "2e0098a8-2674-4d71-8237-1993b57fe05c",
                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                "text": "„Platon missbilligt ihre Trunksucht; sein Schüler Aristoteles ist nicht weniger kritisch, er nennt sie unbeherrscht und unfähig zu staatlicher Ordnung.“"
                            },
                            {
                                "example_id": "ad116852-1d79-4bda-8b27-81db2daa8132",
                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                "text": "„So bestand und bewährte sich unsere Freundschaft mehrere Jahre lang. In dieser Zeit aber hatte mein Charakter infolge meiner teuflischen Trunksucht – ich erröte bei diesem Bekenntnis – eine völlige Wandlung zum Bösen durchgemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed2465c4-bdef-4831-98fa-3ef6262806f7",
                        "source_entry_id": "3b48b271-1e6c-3609-a138-9ea8f3363187",
                        "source_sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                        "source_sense_description": "zwanghafter Genuss alkoholischer Getränke",
                        "target_lang_word": "alcoholisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcoholisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c3f9fb87-f542-321f-80a3-b3b52377d20b",
                                        "entry_id": "b29f23cd-3b41-359c-ac1d-bc1fea6d7c96",
                                        "glosses": [
                                            "verslaving aan het gebruik van alcohol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58971cc7-0dd6-40dd-8b41-c39210e3e087",
                                                "sense_id": "c3f9fb87-f542-321f-80a3-b3b52377d20b",
                                                "text": "Voorbeelden hiervan zijn gebroken gezinnen, huiselijk geweld, slecht ouderschap, alcoholisme, drugsverslaving, obesitas, depressie, angststoornissen, jeugdcriminaliteit en eenzaamheid."
                                            },
                                            {
                                                "example_id": "8abf4276-e0af-4841-9763-ab9b223c5ff9",
                                                "sense_id": "c3f9fb87-f542-321f-80a3-b3b52377d20b",
                                                "text": "Eens in de zoveel tijd wint zijn ijdelheid het van zijn kieskeurige alcoholisme en laat hij zich verleiden tot het kopen van een jas, een horloge, een overhemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "832be1e6-c76d-41f1-94ed-a1b674ae0212",
                        "source_entry_id": "3b48b271-1e6c-3609-a138-9ea8f3363187",
                        "source_sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                        "source_sense_description": "zwanghafter Genuss alkoholischer Getränke",
                        "target_lang_word": "алкоголизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "алкоголизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3bbabd39-4b7e-36d5-9b6c-79b2718d31eb",
                                        "entry_id": "08290bad-4194-31bc-a5c7-a261de0ea991",
                                        "glosses": [
                                            "мед. тяжёлое, хроническое заболевание, проявляющееся в болезненном непреодолимом пристрастии к алкоголю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e4d5b27-9ead-489f-82e6-2f2c1f2be380",
                                                "sense_id": "3bbabd39-4b7e-36d5-9b6c-79b2718d31eb",
                                                "text": "Очень существенным симптомом перехода бытового пьянства в алкоголизм считается изменение картины опьянения: приятное возбуждение довольно быстро сменяется агрессией, злобностью, испорченным настроением."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "421e3bcb-a19c-4389-b86e-8e141ceb4377",
                        "source_entry_id": "3b48b271-1e6c-3609-a138-9ea8f3363187",
                        "source_sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                        "source_sense_description": "zwanghafter Genuss alkoholischer Getränke",
                        "target_lang_word": "пьянство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пьянство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                        "entry_id": "4c9824be-8e2d-3c01-b0e7-5e3c56ff3cb6",
                                        "glosses": [
                                            "постоянное употребление спиртных напитков; алкоголизм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44db94d7-6205-4e16-86fc-0efd2c6e342e",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Он дошел до той чёрточки пьянства, когда иным пьяным, дотоле смирным, непременно вдруг захочется разозлиться и себя показать."
                                            },
                                            {
                                                "example_id": "a8f1070e-accb-447b-b969-807ee2304672",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Вашему Величеству известно, какую страшную язву в нашем народе составляет пьянство, с каждым годом возрастающее."
                                            },
                                            {
                                                "example_id": "0c92545d-94cd-45dc-85a4-92edc3633533",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Ты… лечись! От пьянства нынче лечат, слышь! Бесплатно, браток, лечат… такая уж лечебница устроена для пьяниц… чтобы, значит, даром их лечить…"
                                            },
                                            {
                                                "example_id": "5f90b269-2bac-42cf-bb73-be511e91f98a",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Только один ребенок ― сирота, у остальных матери и отцы лишены родительских прав (в основном из-за беспробудного пьянства)."
                                            },
                                            {
                                                "example_id": "df3a49d0-c699-4b47-aa78-9d8eaa212e18",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Пьянство и алкоголизм ― абсолютно разные вещи. Алкоголизм ― это болезнь, чаще всего наследственная. И чаще всего неизлечимая.〈…〉 Пьянство ― это совсем другое. Это ― бытовая распущенность. Вот с пьянством можно бороться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
