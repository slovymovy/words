                    {
                        "sense_id": "28e573bd-1a32-3e00-b4fe-7e9dea41d14f",
                        "entry_id": "eb424684-de3d-38be-8a29-1146f20f537d",
                        "glosses": [
                            "A rushing, rustling sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0182092-ff07-4da9-a35c-27c503186236",
                                "sense_id": "28e573bd-1a32-3e00-b4fe-7e9dea41d14f",
                                "text": "So she sat, looking at the rain, listening to the many noiseless noises of it, and to the strange soughings of wind in upper branches, when there seemed to be no wind."
                            },
                            {
                                "example_id": "f49c2e03-a179-4bb9-a3a9-d9ac4a178df9",
                                "sense_id": "28e573bd-1a32-3e00-b4fe-7e9dea41d14f",
                                "text": "From the mallee and kurrajong trees came a rowdy chatter of parakeets, while queer soughing of air-currents came from the valley top."
                            },
                            {
                                "example_id": "1b595572-01a3-461d-ab08-664c30d31e85",
                                "sense_id": "28e573bd-1a32-3e00-b4fe-7e9dea41d14f",
                                "text": "“To drown out the soughing of the wind through the treetops old King Hrethel tried to sing to himself.”"
                            }
                        ]
                    }
                ],
