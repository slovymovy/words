                "senses": [
                    {
                        "sense_id": "d7fb396c-fc90-3a59-9e23-8357ec251fb2",
                        "entry_id": "5b26d86a-1235-3d19-84e5-7ace82e5a954",
                        "glosses": [
                            "(absichtlich) besonders trauriger Blick"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eccba32a-b234-4f91-a71d-2a8294d73b29",
                                "sense_id": "d7fb396c-fc90-3a59-9e23-8357ec251fb2",
                                "text": "Jetzt mache doch nicht so eine Leichenbittermiene!"
                            },
                            {
                                "example_id": "3424c9a2-465e-4eeb-93e7-9e673b947a96",
                                "sense_id": "d7fb396c-fc90-3a59-9e23-8357ec251fb2",
                                "text": "„Letzte Woche standen die beiden Minister wieder mit Leichenbittermienen vor der Kamera und schraubten den Terroralarm hoch auf Stufe Orange (die zweithöchste).“"
                            },
                            {
                                "example_id": "9e060f92-a3c8-4f07-80a8-f4f68b45c096",
                                "sense_id": "d7fb396c-fc90-3a59-9e23-8357ec251fb2",
                                "text": "[Novemberpogrome 1938:] „Nach meiner unmaßgeblichen Meinung tragen die zu den einschlägigen Terminen mit Leichenbittermiene und Zerknirschungspathos vorgetragenen Standardreden von Politikern und Verbandsfunktionären dazu bei, die Erinnerung an das Grauen des Nationalismus nach und nach zu einem gesellschaftsfähigen historischen Datum herabzuwürdigen.“"
                            },
                            {
                                "example_id": "516039bc-145c-4c3e-bd83-7a4da3cc671d",
                                "sense_id": "d7fb396c-fc90-3a59-9e23-8357ec251fb2",
                                "text": "[…] „geben Sie sich einen Ruck und wählen Sie SPD. Sie hätten zehn gute Gründe für Ihre Entscheidung: 1. […] 2. Die Leichenbittermiene von Angela Merkel. Ein unglaublicher Anblick, wie sie versucht, tapfer zu lächeln und wie ihr dann doch die Mundwinkel entgleiten und wie Blei nach unten sinken.“"
                            },
                            {
                                "example_id": "72522e12-993d-4b3e-968e-e34a5cd5141e",
                                "sense_id": "d7fb396c-fc90-3a59-9e23-8357ec251fb2",
                                "text": "„Aber nun sind alle ergriffen und machen Leichenbittermienen wegen einer Lawine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
