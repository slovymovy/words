{
    "word_family": [
        "vraag",
        "teken",
        "vragen",
        "tekenen",
        "vraagstelling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8dde0f9-b774-3030-9f8d-003341e74c23",
                    "sense_definition": "Een leesteken (?) dat men aan het eind van een zin plaatst om aan te geven dat het een vraag is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "leesteken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aan het einde van een vraag schrijf je altijd een <w>vraagteken</w>.",
                            "target_lang_translations": {
                                "en": "At the end of a question, you always write a <w>question mark</w>."
                            }
                        },
                        {
                            "text": "Hij snapte die opdracht niet, dus zette hij er een paar <w>vraagtekens</w> bij.",
                            "target_lang_translations": {
                                "en": "He didn't understand that assignment, so he put a few <w>question marks</w> next to it."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een vraagteken zetten"
                    ],
                    "target_lang_definitions": {
                        "en": "A punctuation mark (?) placed at the end of a sentence to indicate that it is a question."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "question mark",
                                "target_lang_sense_clarification": "punctuation mark"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5860920-f904-3645-a05d-7c3e3f444895",
                    "sense_definition": "Iets wat onduidelijk of onzeker is; twijfels of onbeantwoorde vragen over een bepaalde kwestie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onzekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staat nog een groot <w>vraagteken</w> achter de plannen voor de vakantie.",
                            "target_lang_translations": {
                                "en": "There is still a big <w>question mark</w> over the plans for the holiday."
                            }
                        },
                        {
                            "text": "Veel mensen zetten <w>vraagtekens</w> bij de grootte en de zogeheten hubfunctie van Schiphol.",
                            "target_lang_translations": {
                                "en": "Many people raise <w>question marks</w> about the size and the so-called hub function of Schiphol."
                            }
                        }
                    ],
                    "synonyms": [
                        "twijfel",
                        "onzekerheid"
                    ],
                    "antonyms": [
                        "zekerheid"
                    ],
                    "common_phrases": [
                        "vraagtekens zetten bij",
                        "groot vraagteken"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that is unclear or uncertain; doubts or unanswered questions about a particular matter."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "question mark",
                                "target_lang_sense_clarification": "state of doubt or uncertainty"
                            },
                            {
                                "target_lang_word": "doubt",
                                "target_lang_sense_clarification": "uncertainty or lack of conviction"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}