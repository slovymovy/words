                "senses": [
                    {
                        "sense_id": "c27c1cbc-c4d2-3a60-b501-972d26d4918f",
                        "entry_id": "d2c8da43-2374-3bf2-ab0d-7f1145e69fb7",
                        "glosses": [
                            "to carry (by, past, through), to smuggle, to sneak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82b6ed4-1232-4094-9474-8710f1d6cb02",
                                "sense_id": "c27c1cbc-c4d2-3a60-b501-972d26d4918f",
                                "text": "я пыта́лся пронести́ ей еду́, но медсестра́ останови́ла меня́",
                                "translation": "I tried to sneak her some food, but the nurse stopped me",
                                "english": "I tried to sneak her some food, but the nurse stopped me"
                            }
                        ]
                    },
                    {
                        "sense_id": "9fd37365-5a32-3ea3-b36e-5010a24b467a",
                        "entry_id": "d2c8da43-2374-3bf2-ab0d-7f1145e69fb7",
                        "glosses": [
                            "to carry with one (for a length of time)"
                        ],
                        "tags": [
                            "colloquial",
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "491fbffa-03c5-44a9-849b-6986a4a53e8c",
                                "sense_id": "9fd37365-5a32-3ea3-b36e-5010a24b467a",
                                "text": "пронесло́!",
                                "translation": "the danger is over!",
                                "english": "the danger is over!"
                            },
                            {
                                "example_id": "2aa33b9e-9ada-4f16-88c1-ab50cb25d38a",
                                "sense_id": "9fd37365-5a32-3ea3-b36e-5010a24b467a",
                                "text": "е́ле пронесло́!",
                                "translation": "that was close",
                                "english": "that was close"
                            },
                            {
                                "example_id": "ee15c505-32fb-4c5c-88a9-637315b88b59",
                                "sense_id": "9fd37365-5a32-3ea3-b36e-5010a24b467a",
                                "text": "они́ пронесли́ па́мять об э́том че́рез всю жизнь",
                                "translation": "they carried that memory with them for the rest of their lives",
                                "english": "they carried that memory with them for the rest of their lives"
                            },
                            {
                                "example_id": "670b1f67-2dd6-4baa-96f9-bbe3ad16b909",
                                "sense_id": "9fd37365-5a32-3ea3-b36e-5010a24b467a",
                                "text": "пронести́ че́рез века́",
                                "translation": "to retain through the centuries",
                                "english": "to retain through the centuries"
                            }
                        ]
                    },
                    {
                        "sense_id": "4fb40e50-ab85-3f85-b2fd-b725b5dfee4a",
                        "entry_id": "d2c8da43-2374-3bf2-ab0d-7f1145e69fb7",
                        "glosses": [
                            "to cause (bad) diarrhea"
                        ],
                        "tags": [
                            "colloquial",
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "f4a5ef93-2b43-4072-9e51-14d85f2a08da",
                                "sense_id": "4fb40e50-ab85-3f85-b2fd-b725b5dfee4a",
                                "text": "его́ пронесло́",
                                "translation": "his bowels moved; he had diarrhea",
                                "english": "his bowels moved; he had diarrhea"
                            }
                        ]
                    }
