                    {
                        "form_id": "02672a01-c619-421d-92de-a6dd564bff52",
                        "entry_id": "7d8fee83-371e-3e73-9d68-f3b8b4899bb2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tupinambá"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bfebba3-cace-39d1-90a1-2b04a664c85b",
                        "entry_id": "7d8fee83-371e-3e73-9d68-f3b8b4899bb2",
                        "glosses": [
                            "ein südamerikanisches eingeborenes Volk, das ausgestorben beziehungsweise in der brasilianischen Mischbevölkerung aufgegangen ist"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1e31ad96-2e30-4610-8416-c46eadcd9f0c",
                                "sense_id": "2bfebba3-cace-39d1-90a1-2b04a664c85b",
                                "text": "„Der aus Burgund stammende Jean de Léry, der […] an einer der erfolglosen französischen Kolonisationsversuche unter Villegaignon in der Bucht von Guanabara (Rio de Janeiro) teilnahm und ein Jahr unter den Tupinambá und Tupinakin lebte, kann dagegen als einer der ersten ethnographischen und linguistischen Beobachter bezeichnet werden.“"
                            },
                            {
                                "example_id": "ffef9b1d-b81c-4dad-a86d-31c6fdff8499",
                                "sense_id": "2bfebba3-cace-39d1-90a1-2b04a664c85b",
                                "text": "„In Folge verbringt er zehn Monate in Gefangenschaft der Tupinambá, bis ihm durch eine List die Flucht gelingt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5533a7a-83fb-3258-b647-46580bae0be6",
                        "entry_id": "7d8fee83-371e-3e73-9d68-f3b8b4899bb2",
                        "glosses": [
                            "ein Angehöriger des gleichnamigen Volks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c950fbf2-fffc-4208-9bd0-33f46261f37c",
                                "sense_id": "c5533a7a-83fb-3258-b647-46580bae0be6",
                                "text": "„Allerdings muss ich bemerken, dass ich selbst keine Tupinambá im Zustande ursprünglicher Freiheit, sondern nur sogenannte Indios ladinos […] über das Herkommen ihres Volkes vernommen habe.“"
                            },
                            {
                                "example_id": "ea963b44-94ce-40ca-949e-aa8efd0c56fa",
                                "sense_id": "c5533a7a-83fb-3258-b647-46580bae0be6",
                                "text": "„Er betont zwar im ersten Teil seine große Nähe zu den Tupinambá (deren Aussagen häufig wörtlich und namentlich wiedergegeben werden), wechselt dann aber im zweiten Teil zu einem systematisierenden Blick, der die anderen erneut anonymisiert.“"
                            },
                            {
                                "example_id": "c51f5dd7-b047-4b93-a530-44396a4e5530",
                                "sense_id": "c5533a7a-83fb-3258-b647-46580bae0be6",
                                "text": "„Maragnan schützte die Franzosen vor anderen Europäern, und eine geschickte Diplomatie, in deren Rahmen Indianerhäuptlinge als große Fürsten in Frankreich empfangen wurden, sicherte die Freundschaft örtlicher Tupinambá gegen die Portugiesen, welche mit verbündeten Potiguar bereits gefährlich nahe ans französische Gebiet vorgedrungen waren.“"
                            },
                            {
                                "example_id": "213a5ee2-3bd3-4fbe-832d-c1132e0f0693",
                                "sense_id": "c5533a7a-83fb-3258-b647-46580bae0be6",
                                "text": "„Die Tupinambá, Männer und Frauen, auf den Bildern in dem Buche des Franzosen Jean de Lery entsprechen dem europäischen Schönheitsideal der Zeit, des 16. Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
