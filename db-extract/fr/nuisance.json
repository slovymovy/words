                "senses": [
                    {
                        "sense_id": "363925bd-6aec-36ea-a76c-6a945aae5555",
                        "entry_id": "ff77f95d-fc65-30cc-8997-ee767d4918eb",
                        "glosses": [
                            "Trouble, dérangement, gêne persistante, calamité, fléau, pollution. Cause de perturbation pour le bon fonctionnement d'une entreprise, d'un projet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a0574f2-2515-49ac-a066-66710c56aebf",
                                "sense_id": "363925bd-6aec-36ea-a76c-6a945aae5555",
                                "text": "Hitler, Staline, Mussolini, tout le monde connaît leurs crimes et leurs capacités de nuisance sur leurs congénères."
                            },
                            {
                                "example_id": "ed160399-e1ec-4cc2-8075-c4900ed989f5",
                                "sense_id": "363925bd-6aec-36ea-a76c-6a945aae5555",
                                "text": "Les astres ne nous font pas de nuisance : ils sont donc pleins de bonté."
                            },
                            {
                                "example_id": "26bfe3b6-919e-4137-84f3-17f34b847039",
                                "sense_id": "363925bd-6aec-36ea-a76c-6a945aae5555",
                                "text": "La tour lyonnaise UAP est déconstruite étage par étage, sous une coiffe, pour limiter les nuisances de ce chantier situé en périphérie immédiate des halles de Lyon et d’une école notamment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b95b8e8-566a-44be-b864-fc31e25bdd30",
                        "source_entry_id": "ff77f95d-fc65-30cc-8997-ee767d4918eb",
                        "source_sense_id": "363925bd-6aec-36ea-a76c-6a945aae5555",
