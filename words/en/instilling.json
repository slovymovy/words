    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79f3bc89-462c-385d-a959-ebd280510f96",
                    "sense_definition": "The present participle and gerund of <w>instill</w>, meaning to gradually establish an idea or attitude in a person's mind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "teaching_and_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>instilling</w> a love of reading in her young students.",
                            "target_lang_translations": {
                                "pl": "Ona <w>zaszczepia</w> miłość do czytania u swoich młodych uczniów."
                            }
                        },
                        {
                            "text": "The coach is <w>instilling</w> confidence in the team before the big game.",
                            "target_lang_translations": {
                                "pl": "Trener <w>wlewa</w> pewność siebie w zespół przed wielkim meczem."
                            }
                        }
                    ],
                    "synonyms": [
                        "implanting",
                        "imbuing",
                        "inculcating"
                    ],
                    "common_phrases": [
                        "instilling confidence",
                        "instilling values"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stopniowe wpajanie komuś idei, postawy lub nawyku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wpojenie",
                                "target_lang_sense_clarification": "proces stopniowego przekazywania wartości lub przekonań"
                            },
                            {
                                "target_lang_word": "zaszczepianie",
                                "target_lang_sense_clarification": "metaforyczne wprowadzanie idei lub uczuć do czyjegoś umysłu"
                            },
                            {
                                "target_lang_word": "wpajanie",
                                "target_lang_sense_clarification": "częste i cierpliwe powtarzanie w celu utrwalenia wiedzy lub postawy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8bb23242-227f-396a-b17f-ec7f0660a1da",
                    "sense_definition": "The act or process of gradually introducing an idea, attitude, or habit into someone's mind.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "teaching_and_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>instilling</w> of discipline is a key part of their training program.",
                            "target_lang_translations": {
                                "pl": "<w>Wpajanie</w> dyscypliny jest kluczową częścią ich programu szkoleniowego."
                            }
                        },
                        {
                            "text": "He focused on the <w>instilling</w> of moral values in his children.",
                            "target_lang_translations": {
                                "pl": "Skupił się na <w>wpajaniu</w> wartości moralnych swoim dzieciom."
                            }
                        }
                    ],
                    "synonyms": [
                        "implantment",
                        "inculcation"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proces stopniowego wprowadzania idei, postawy lub nawyku do czyjegoś umysłu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wpajanie",
                                "target_lang_sense_clarification": "proces długotrwałego kształtowania postaw"
                            },
                            {
                                "target_lang_word": "zaszczepianie",
                                "target_lang_sense_clarification": "proces inicjowania nowych idei lub wartości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
