                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord geur"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f702a081-aeb6-4944-97a9-44e6b8a3e8cb",
                                                "sense_id": "0c388e3e-0085-38ce-a154-ccf5d00c02c4",
                                                "text": "Omdat ik word afgeleid door de heerlijke geuren die uit de keuken komen, heb ik pas laat door dat ik de stem ken die er vandaan komt."
                                            },
                                            {
                                                "example_id": "de910d8b-8dcc-4219-9470-496cdb34c83f",
                                                "sense_id": "0c388e3e-0085-38ce-a154-ccf5d00c02c4",
                                                "text": "Om hen heen dreigen de geuren van gebraden kip, het gestoofde fruit en de gretig leeggedronken kannen met wijn hun gesprek binnen te dringen, maar de magnetische aantrekkingskracht die Nella kennelijk voor Agnes heeft, verdrijft alles naar de achtergrond."
                                            }
                                        ]
                                    }
