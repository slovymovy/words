                    "frequency": "VeryLow",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The town organized a <w>pounding</w> to welcome the new minister.",
                            "target_lang_translations": {
                                "cs": "Město zorganizovalo uvítací <w>sbírku potravin</w> pro nového duchovního."
                            }
