                "senses": [
                    {
                        "sense_id": "21bfda28-4976-3d34-b053-9d3a6d593fbf",
                        "entry_id": "d21e2195-7c98-376e-a99d-027c8eb6e6b2",
                        "glosses": [
                            "Regarder discrètement."
                        ],
                        "tags": [
                            "Touraine",
                            "Vendée",
                            "Poitou"
                        ],
                        "examples": [
                            {
                                "example_id": "bc446f1e-6a58-4190-abf7-7e829fc09674",
                                "sense_id": "21bfda28-4976-3d34-b053-9d3a6d593fbf",
                                "text": "Enfournez, boulitez au bout de 20 minutes, le gâteau ne doit pas grâler."
                            },
                            {
                                "example_id": "6e0c2e91-d0aa-4f89-814b-58fd0026e9d9",
                                "sense_id": "21bfda28-4976-3d34-b053-9d3a6d593fbf",
                                "text": "Au-dessus, un grenier avec ces petites ouvertures carrées que l’on appelle des boulites. Victorine se souvenait des parties faites avec Victor dans la métairie de sa mère et combien ils aimaient l’un et l’autre bouliter à se faire peur, d’une ouverture à l’autre."
                            },
                            {
                                "example_id": "d93a207c-298b-437e-9856-5ddf68579c38",
                                "sense_id": "21bfda28-4976-3d34-b053-9d3a6d593fbf",
                                "text": "Vous les voyez bouliter entre les sacs ?"
                            },
                            {
                                "example_id": "7d51c6af-e98d-4d11-ba29-b58d8fdcf1fb",
                                "sense_id": "21bfda28-4976-3d34-b053-9d3a6d593fbf",
                                "text": "Je boulite à la fenêtre et voit le proprio en train de téléphoner."
                            }
                        ]
                    }
                ],
