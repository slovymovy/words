                                            {
                                                "example_id": "9abfa31c-b46b-4c6c-b5aa-f1bd3c8f1de4",
                                                "sense_id": "a295f74e-c3c4-3257-853e-b42586b50b5b",
                                                "text": "\"Its name is Samantha Jo, after Josiah and me. You know they call girls Jo and Josie a sight lately; its name is agreeable to Josiah and me, very."
                                            },
                                            {
                                                "example_id": "a4c43378-0e0d-41e2-8b99-8fae20c0d7aa",
                                                "sense_id": "a295f74e-c3c4-3257-853e-b42586b50b5b",
                                                "text": "Jo Rae Perkins was carrying about 50 percent of the vote in Oregon’s primary as of Wednesday afternoon, vanquishing three other Republican candidates to become the party’s nominee for the seat currently held by Senator Jeff Merkley, a Democrat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
