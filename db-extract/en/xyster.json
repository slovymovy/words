                "translations": [
                    {
                        "translation_id": "37083d20-9b03-4ee1-883b-81e2eb991505",
                        "source_entry_id": "a2b4c035-3b36-3336-bd21-9595b2706d59",
                        "source_sense_id": "b8bb5764-aa12-39ec-889f-d938178e2e8c",
                        "source_sense_description": "surgical instrument",
                        "target_lang_word": "rašple",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rašple",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "aa6219da-4a48-3470-9c94-939d825cc954",
                                        "entry_id": "aa623f9c-caa5-362f-a1b1-f14c60a39cb2",
                                        "glosses": [
                                            "nástroj k opracovávání dřeva, pilník s hrubším povrchem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fced5f4-492b-45eb-81a9-fe7c048e66ea",
                                                "sense_id": "aa6219da-4a48-3470-9c94-939d825cc954",
                                                "text": "Tak udělal ku př. z ramenní kosti, již náhodou našel, dláto, z koralů třelec (rašpli), z lastury nůž, pilník z kůže rybí."
                                            },
                                            {
                                                "example_id": "74f49d91-a714-4489-bdc9-d6f5ba263bff",
                                                "sense_id": "aa6219da-4a48-3470-9c94-939d825cc954",
                                                "text": "Myšlenka, že bude nucen celou noc v zimě prosedět v tmavém lese a poslouchat pouze vlky, ozvěnu a frkání hubené kobylky, počala geometra tak trýzniti, jakoby mu někdo jezdil po zádech studenou rašplí."
                                            },
                                            {
                                                "example_id": "4e12bb56-45ab-493b-bfb6-abae439b4ee8",
                                                "sense_id": "aa6219da-4a48-3470-9c94-939d825cc954",
                                                "text": "Byly to následující věci: 1. bedna s hřeby a šrouby; 2. dvě sekery; 3. několik palic; 4. pila; 5. menší bedna obsahující hoblíky, kleště, nebozezy, dláta, pilníky a rašple;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d289aa-3c49-3bd8-aa70-36ec651e820e",
                                        "entry_id": "aa623f9c-caa5-362f-a1b1-f14c60a39cb2",
                                        "glosses": [
                                            "neatraktivní stará žena"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d5196f2-d56f-46f3-8b62-3dc06e89b027",
                                                "sense_id": "c2d289aa-3c49-3bd8-aa70-36ec651e820e",
                                                "text": "Počkej, řekl jsem si; a už jsem seděl a začal jsem svým nejúhlednějším písmem psát: Ty strašidlo poštmistrovské, ty nosatá fuchtle, ty kometo, ty treperendo zvědavá, ty zmije, ty rašple, ty ježibabo a tak dále, s úctou veškerou Jan Kubát."
                                            },
                                            {
                                                "example_id": "8a692630-36a1-4bc8-a788-2df9eb7ba3c5",
                                                "sense_id": "c2d289aa-3c49-3bd8-aa70-36ec651e820e",
                                                "text": "Kdyby aspoň taková vopice vypadala k světu, ale je to jako čáp, člověk nic jiného nevidí než ty haksny a vypadá to jako boží umučení, a ještě si taková stará rašple chce něco začínat s vojáky."
                                            },
                                            {
                                                "example_id": "1dafed4b-287f-422c-ae14-98e31ab1c5c8",
                                                "sense_id": "c2d289aa-3c49-3bd8-aa70-36ec651e820e",
                                                "text": "Vočko, já znám výborný pití. A má pěknej říz. Vymyslel jsem ho sám. Jednou ty dvě rašple, co má Marge za sestry, promítaly diáky z dovolený."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
