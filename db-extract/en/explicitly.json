                                    {
                                        "sense_id": "f35b6f22-0002-3431-ac6a-a5b407561bb3",
                                        "entry_id": "58944677-3f5b-3c0e-af69-0087e00b80d6",
                                        "glosses": [
                                            "met nadruk, op zo'n manier dat het duidelijk moet zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1343bb2f-8131-4983-9e7d-f66c9f596d8a",
                                                "sense_id": "f35b6f22-0002-3431-ac6a-a5b407561bb3",
                                                "text": "De docent had uitdrukkelijk gezegd dat het huiswerk op tijd moest worden ingeleverd, toch hadden lang niet alle leerlingen dat gedaan."
                                            }
                                        ]
                                    }
                                ]
