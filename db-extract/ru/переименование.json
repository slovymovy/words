                                        "entry_id": "a2fc7448-69a3-3b29-a14c-07d77200b811",
                                        "glosses": [
                                            "das Ändern des Namens von etwas oder jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d906275-96c1-40d0-b0e7-95af228d8072",
                                                "sense_id": "b3f18c42-36f0-31b5-b1b0-1a608bcbebe2",
                                                "text": "„Ich war damals acht, ich hätte mich nicht gegen die Umbenennung wehren können, aber meine Eltern.“"
                                            },
                                            {
                                                "example_id": "c042c75e-ddf1-4545-8d5b-233dff14f7c2",
                                                "sense_id": "b3f18c42-36f0-31b5-b1b0-1a608bcbebe2",
                                                "text": "„Für die Umbenennung des Nachbarortes Ballupönen übernimmt Tamara Worobjowa mit einem leicht verschmitzten, stolzen Lächeln selber die Verantwortung.“"
                                            },
                                            {
                                                "example_id": "490a2882-fed1-4603-9dea-55186f272874",
                                                "sense_id": "b3f18c42-36f0-31b5-b1b0-1a608bcbebe2",
                                                "text": "„Zusammen mit den anderen Neu- und Umbenennungen seit 1945 brachte es Erlangen bis 1976 auf 565 neue StraßenN (…).“"
                                            }
