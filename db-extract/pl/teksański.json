                                        "entry_id": "d9ccb360-9b3a-3264-a182-28f813100a72",
                                        "glosses": [
                                            "A native or inhabitant of the state of Texas, United States."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e259115-24dd-4d46-a766-b3cb0c95e11d",
                                                "sense_id": "94c65082-5904-3a74-a8e2-46576443dd59",
                                                "text": "Cruz was obviously analogizing Bernie Sanders to the Bolsheviks and Hillary Clinton to the Mensheviks. The oleaginous Texan is an erudite slyboots, but his history is off-kilter."
                                            },
                                            {
                                                "example_id": "bb3e7a77-2926-450f-95a6-2678d6969062",
                                                "sense_id": "94c65082-5904-3a74-a8e2-46576443dd59",
                                                "text": "In 2012, over three million Texans voted Democrat."
                                            },
                                            {
                                                "example_id": "b3122a16-359b-4158-b810-85e5d7efa550",
                                                "sense_id": "94c65082-5904-3a74-a8e2-46576443dd59",
                                                "text": "Even though the mandatory inspections have been eliminated, Texans with vehicles registered in emissions counties are required to have emissions tests."
                                            }
                                        ]
