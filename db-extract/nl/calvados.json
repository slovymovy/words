                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                        "entry_id": "848327cd-855f-343c-99d0-766b8d7d0446",
                                        "glosses": [
                                            "Eau-de-vie de cidre fabriquée dans le Calvados, et plus généralement en Normandie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d94f69-e2e4-4fbb-9460-5253f937dd63",
                                                "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                                "text": "On trouvait le père et la mère [Prouane] en travers des portes, assommés par le calvados, la terrible eau-de-vie normande ; tandis que la petite les enjambait, pour égoutter leurs verres."
                                            },
                                            {
                                                "example_id": "17731411-831b-4264-8dbc-37e2b85b7f79",
                                                "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                                "text": "Jésus-la-Caille poussa la porte vitrée du bar. Il entra et, s’accoudant au comptoir, annonça qu’il boirait « un » calvados."
                                            },
                                            {
                                                "example_id": "18231eac-f1a9-48ec-a230-4dd111d49ab1",
                                                "sense_id": "6f64e837-5598-3cf0-9a7d-3fece576aa0b",
                                                "text": "Le souvenir de l’énorme Mme Lebrasseur, qui mêlait aux biberons qu’elle préparait pour son dernier-né quelques gouttes de calvados, car « c’est bon pour la santé », demeure en moi indestructible. J’aime ces Normands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
