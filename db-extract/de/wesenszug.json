                        ],
                        "form": "die Wesenszüge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "930b5a87-7a8f-35da-8bb9-7efb62c186c2",
                        "entry_id": "6f9bd526-c1ce-3e96-9b0b-7ce913730781",
                        "glosses": [
                            "charakteristische, das Wesen bestimmende Eigenschaft einer Person oder Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff054cf-c7f7-40ce-89ae-1ff126863985",
                                "sense_id": "930b5a87-7a8f-35da-8bb9-7efb62c186c2",
                                "text": "„Den Eltern fällt bald ein außergewöhnlicher Wesenszug auf. Michel, wegen starker Fehlsichtigkeit inzwischen mit einer Brille ausgestattet, ist extrem neugierig auf Menschen.“"
                            },
                            {
                                "example_id": "7d91db97-6462-438e-a176-20f7d7465db7",
                                "sense_id": "930b5a87-7a8f-35da-8bb9-7efb62c186c2",
                                "text": "„Das Anarchische gehört nicht erst seitdem zum Wesenszug der Bayern.“"
                            },
                            {
                                "example_id": "cbf1bf44-8cab-4bd5-9297-4665d43c3410",
                                "sense_id": "930b5a87-7a8f-35da-8bb9-7efb62c186c2",
                                "text": "„Leider werten noch heute Außenstehende diesen Wesenszug entweder als Arroganz oder als grenzenlose Borniertheit.“."
                            },
                            {
                                "example_id": "02f5c779-6472-43bf-8dcf-37e60de28087",
                                "sense_id": "930b5a87-7a8f-35da-8bb9-7efb62c186c2",
                                "text": "„Auf den beiden Bildern, die sie in sich trug, zeigte er zwei Wesenszüge, die jedoch keine Gegensätze waren: einmal zuhörend und abwartend, klug und entspannt, zum andern nachdenkend als Zuschauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f11c65cf-c1dd-4d2e-ac80-b68e65347af4",
                        "source_entry_id": "6f9bd526-c1ce-3e96-9b0b-7ce913730781",
                        "source_sense_id": "930b5a87-7a8f-35da-8bb9-7efb62c186c2",
                        "source_sense_description": "charakteristische, das Wesen bestimmende Eigenschaft einer Person oder Sache",
                        "target_lang_word": "trait de caractère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trait de caractère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                        "entry_id": "d62b81d6-15c0-309d-8d59-6cf0ca45b885",
                                        "glosses": [
                                            "Comportements et personnalité relevant de l'acquis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e968e75-11d3-4067-bdbc-46c1e160a34f",
                                                "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                                "text": "Les traits de caractère et les traits de tempérament définissent notre personnalité et nos comportements."
                                            },
                                            {
                                                "example_id": "4bd0891a-564a-427e-976f-2fea612ff1be",
                                                "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                                "text": "Les traits de caractère varient pendant la vie d'un individu, en fonction des expériences et des situations rencontrées."
                                            },
                                            {
                                                "example_id": "b32809de-1bed-41e4-8782-7c88ab4f057d",
                                                "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                                "text": "Je sentais que chaque fois que je posais une question, cela l’embarrassait et la contrariait - un trait de caractère commun avec ma mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
