                "senses": [
                    {
                        "sense_id": "1e8c96b1-3646-324f-a386-450df9ec0978",
                        "entry_id": "3e5b1d96-f38a-3f82-991c-2f33e25764ef",
                        "glosses": [
                            "действ. прич. прош. вр. от зарасти"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "195ed46d-f504-4306-97ac-8b717c5a24a8",
                                "sense_id": "1e8c96b1-3646-324f-a386-450df9ec0978",
                                "text": "Но тут, за кустами, была незнакомая ему канавка, заросшая крапивой〈…〉"
                            },
                            {
                                "example_id": "05d28254-93e4-4052-b45b-e7ef177f6a6c",
                                "sense_id": "1e8c96b1-3646-324f-a386-450df9ec0978",
                                "text": "Внизу ― речка Стугна, обмелевшая и заросшая тиною."
                            },
                            {
                                "example_id": "0e6df3f2-95f3-4d02-9c62-6fb57c73260a",
                                "sense_id": "1e8c96b1-3646-324f-a386-450df9ec0978",
                                "text": "Лицо сторожа, заросшее густыми волосами, внушало Илье уважение и робость: было в этом лице что-то важное, суровое."
                            }
                        ]
                    },
                    {
                        "sense_id": "d393346c-25a2-38d8-b956-28b96afea64d",
                        "entry_id": "3e5b1d96-f38a-3f82-991c-2f33e25764ef",
                        "glosses": [
                            "статив. небритый, щетинистый, нестриженый, обросший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03fa3297-5bb3-430f-a127-e9f687d6cefa",
                                "sense_id": "d393346c-25a2-38d8-b956-28b96afea64d",
                                "text": "Роман так увлекся разглядыванием этого речного феномена, что чуть не пропустил появление заросшего мужика, который все так же брассом наплывал сверху."
                            }
                        ]
                    }
                ],
