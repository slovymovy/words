                "senses": [
                    {
                        "sense_id": "18d7878f-746d-32ea-a22b-684688c6ceac",
                        "entry_id": "7514bc7a-40f4-3e35-b9c3-00c8f9307579",
                        "glosses": [
                            "Küchengerät zum Zerstoßen/Zerstampfen von gehobeltem Kohl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d20581fc-ef6f-4d63-afd4-104a3f75a15d",
                                "sense_id": "18d7878f-746d-32ea-a22b-684688c6ceac",
                                "text": "„Der geschnipselte Kohl wird dann mit dem Krautstampfer bearbeitet, sodass Saft austritt.“"
                            },
                            {
                                "example_id": "3664c30d-8e2e-46ce-99db-cc5aa3bd9a02",
                                "sense_id": "18d7878f-746d-32ea-a22b-684688c6ceac",
                                "text": "„Mit einem Krautstampfer werden die Pflanzenzellen zersprengt, der Zellsaft kann austreten und muss schließlich den Kohl ganz bedecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33519800-ed57-3527-8037-434a5933263d",
                        "entry_id": "7514bc7a-40f4-3e35-b9c3-00c8f9307579",
                        "glosses": [
                            "plumpes, dickes (Frauen-)Bein"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "figurative",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "aa1981e4-8483-4537-b64b-9637e7d1305a",
                                "sense_id": "33519800-ed57-3527-8037-434a5933263d",
                                "text": "„Die kurzen Hosen sind viel zu kurz, die Schuhe zu derb und die Socken machen das schönste Bein zum Krautstampfer.“"
                            },
                            {
                                "example_id": "1a9e26e3-815b-4d8f-8d82-1f1877ba52a3",
                                "sense_id": "33519800-ed57-3527-8037-434a5933263d",
                                "text": "„Sie schaute auf ihre Beine: Ziemliche Krautstampfer, fand sie. Das hatte sie nun davon, dass sie ihr schlankes Sport- und Ernährungsprogramm hatte schleifen lassen.“"
                            },
                            {
                                "example_id": "a0675979-5acc-4cd0-a114-fb9bc1e42ed0",
                                "sense_id": "33519800-ed57-3527-8037-434a5933263d",
                                "text": "„Sie wusste genau, wie man Beine so drapierte, dass sie weit besser wirkten als sie waren. Gina sprach von den ihren gern als Krautstampfer und freute sich über Widerspruch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
