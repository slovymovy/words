                                "example_id": "864b1c16-6348-43e1-a881-5c7091769499",
                                "sense_id": "f46e8e4c-e553-3706-bca0-72101b6e70d6",
                                "text": "Désir de mahoriser les postes?"
                            },
                            {
                                "example_id": "c4292967-b0ec-4fbb-bb37-b8b08e997f68",
                                "sense_id": "f46e8e4c-e553-3706-bca0-72101b6e70d6",
                                "text": "Quelle offre de soin pour Mayotte ? Comment éradiquer le problème de manque de personnel ? Et surtout comment « mahoriser » les professions de cadres et de médecins ?"
                            },
                            {
                                "example_id": "461062eb-437f-4f98-b64c-32984d1ebff8",
                                "sense_id": "f46e8e4c-e553-3706-bca0-72101b6e70d6",
                                "text": "Désormais, on parle de mahoriser le personnel, grace à la formation."
                            }
                        ]
                    }
