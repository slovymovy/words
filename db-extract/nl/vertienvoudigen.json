                "senses": [
                    {
                        "sense_id": "c53cad89-0cfc-344d-9154-a6d96ebea869",
                        "entry_id": "ebc9a57f-28f6-3bf6-b9ec-02c59547f875",
                        "glosses": [
                            "iets tienmaal zo groot of zo talrijk maken of laten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5df2b4-4a7b-402a-a5cc-07e812e35ac5",
                                "sense_id": "c53cad89-0cfc-344d-9154-a6d96ebea869",
                                "text": "Volgens de analisten is het veel te complex en te duur om de aardmetalen commercieel te kunnen winnen. 'De metalen liggen op 4000 tot 5000 meter diepte waar nooit commerciële winning heeft plaatsgevonden, en ook nooit zal plaatsvinden tenzij de prijzen van zeldzame aardmetalen vertienvoudigen', aldus analist John Kaiser."
                            },
                            {
                                "example_id": "38cc21a9-546a-4f3d-b9ce-6f3d99472be2",
                                "sense_id": "c53cad89-0cfc-344d-9154-a6d96ebea869",
                                "text": "Telefoon-producent Ericsson verwacht dat het mobiele dataverkeer nog eens zal vertienvoudigen tussen 2011 en 2016, omdat steeds meer mensen tablets en smartphones aanschaffen."
                            },
                            {
                                "example_id": "67fb8f2f-d2ed-45fe-b8c7-0e3878f915d5",
                                "sense_id": "c53cad89-0cfc-344d-9154-a6d96ebea869",
                                "text": "Rovio Entertainment, het bedrijf achter het populaire spelletje Angry Birds, heeft de omzet vorig jaar zien vertienvoudigen tot 100 miljoen dollar (77 miljoen euro). De winst voor belastingen kwam uit op 48 miljoen dollar. Dat maakte de Finse onderneming vandaag bekend."
                            }
                        ]
