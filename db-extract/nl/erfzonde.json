                "senses": [
                    {
                        "sense_id": "9919aeef-9d24-3aa2-b60e-aab22b66fd0c",
                        "entry_id": "5ea7e5cc-ecab-3ef0-a6ce-84a601afec0f",
                        "glosses": [
                            "schending van Gods regels door de eerste mens Adam als last die op ieder mens rust; kader om de natuur van de mens te begrijpen"
                        ],
                        "tags": [
                            "christendom"
                        ],
                        "examples": [
                            {
                                "example_id": "72830e01-578d-46d8-a01e-2e38eaa1d9c0",
                                "sense_id": "9919aeef-9d24-3aa2-b60e-aab22b66fd0c",
                                "text": "Hij was ervan overtuigd dat het kind als onbeschreven blad ter wereld kwam. Het kind was van nature goed, betoogde hij, en daarom bepleitte hij een empirische opvoeding. En dat was iets heel nieuws; eerder vond men dat kinderen een erfzonde droegen, een overdracht van de zonden van Adam en Eva."
                            },
                            {
                                "example_id": "3ffe50c8-38ca-48b4-9e92-c8edbd0d2683",
                                "sense_id": "9919aeef-9d24-3aa2-b60e-aab22b66fd0c",
                                "text": "Alleen in de dogmatiek zoals de kruisiging, de erfzonde en de drie-eenheid kan ik niet meer geloven. En als ik dat niet meer geloof, dan kan ik mezelf geen christen meer noemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbeb3b86-3da2-3e57-accf-075b5ada807a",
                        "entry_id": "5ea7e5cc-ecab-3ef0-a6ce-84a601afec0f",
                        "glosses": [
                            "verkeerd gedrag dat van generatie op generatie overgaat"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1e18c831-c192-4883-a555-7e539e57ab29",
                                "sense_id": "bbeb3b86-3da2-3e57-accf-075b5ada807a",
                                "text": "De westerse moderniteit is inderdaad besmet door de erfzonde van de trans-Atlantische slavenhandel en het kolonialisme, maar het waren tezelfdertijd westerse landen die het voortouw namen in de mensenrechten-revoluties, bijvoorbeeld door andere landen onder druk te zetten om slavernij af te schaffen (…)."
                            }
                        ]
                    }
                ],
