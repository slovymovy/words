                        ],
                        "form": "вертля́ва"
                    },
                    {
                        "form_id": "5dc6997d-9620-41fd-9b5f-51563d8c1630",
                        "entry_id": "59530d24-6875-36c4-823f-b15547de967f",
                        "tags": [
