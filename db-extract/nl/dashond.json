                                    },
                                    {
                                        "sense_id": "c64e16e9-399c-3e00-8601-38a80b1e38ef",
                                        "entry_id": "68e458ad-ddf9-3a2b-853c-dbcc142343bc",
                                        "glosses": [
                                            "Sorte de panier ou d’ustensile en métal :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de58725-4dbe-478c-a880-3f71ff3ccc17",
                                                "sense_id": "c64e16e9-399c-3e00-8601-38a80b1e38ef",
                                                "text": "les mottes [de beurre] doivent être mises en petits paniers ou bassets bien paillés et en emballage perdu."
                                            },
                                            {
                                                "example_id": "d323a3f1-7f24-4827-bf45-4f77f7087e6f",
                                                "sense_id": "c64e16e9-399c-3e00-8601-38a80b1e38ef",
                                                "text": "la chambre était semée de ces pots d’étain et de ces bassets de laiton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c1e2030-058b-31d7-add3-f9950b314036",
                                        "entry_id": "68e458ad-ddf9-3a2b-853c-dbcc142343bc",
                                        "glosses": [
                                            "Petite basse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
