                                    {
                                        "sense_id": "ef00ad70-6a56-300c-a3fa-ff7b2b67597a",
                                        "entry_id": "cafb0531-7a91-3da6-8fdb-50c742d4f649",
                                        "glosses": [
                                            "A picture made by sticking other pictures onto a surface or juxtaposing them digitally in analogous manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecd47a06-6d37-3f79-bd86-0659c660a25f",
                                        "entry_id": "cafb0531-7a91-3da6-8fdb-50c742d4f649",
                                        "glosses": [
                                            "A composite object or collection (abstract or concrete) created by the assemblage of various media; especially for a work of art such as text, film, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b467b817-1a86-4e52-8d88-5c1f01541e62",
                                                "sense_id": "ecd47a06-6d37-3f79-bd86-0659c660a25f",
                                                "text": "Near-synonyms: bricolage, montage"
                                            },
                                            {
                                                "example_id": "ec546fff-bacf-4350-934e-0aff2ff3ff1d",
                                                "sense_id": "ecd47a06-6d37-3f79-bd86-0659c660a25f",
                                                "text": "Richard Brautigan's novel So the Wind Won't Blow It All Away is a collage of memories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e25a38-66f8-3654-88fb-637abf82cd76",
                                        "entry_id": "cafb0531-7a91-3da6-8fdb-50c742d4f649",
