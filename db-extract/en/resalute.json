                        "examples": [
                            {
                                "example_id": "991f5c8b-31e2-44d8-8a20-8e5ba2c94d35",
                                "sense_id": "b9094049-fae0-36e2-a6e9-14b9e4a6b70e",
                                "text": "Whereas the Priestes she found full busily / About their holy things for morrow Mas; / Whom she saluting faire, faire resaluted was […]."
                            },
                            {
                                "example_id": "a7a93d0e-42c7-4d92-9e2b-8a162291e969",
                                "sense_id": "b9094049-fae0-36e2-a6e9-14b9e4a6b70e",
                                "text": "Hippocrates, after a little pause, saluted him by his name, whom he resaluted, ashamed almost that he could not call him likewise by his, or that he had forgot it."
                            }
                        ]
                    },
