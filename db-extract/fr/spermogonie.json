                "senses": [
                    {
                        "sense_id": "adfc4940-ee00-3e55-a24c-f2a42f4f587c",
                        "entry_id": "d3d432cf-3c3a-381f-8cf5-5869483ae3b2",
                        "glosses": [
                            "Cavité enfoncée dans l'épaisseur du thalle des lichens, et émergeant seulement par le petit orifice qui les fait communiquer avec l'extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab39a11-04fe-4834-a889-fd5305502ce2",
                                "sense_id": "adfc4940-ee00-3e55-a24c-f2a42f4f587c",
                                "text": "La germination génère ensuite un thalle haploïde duquel émanera la spermogonie, le printemps suivant ou des années plus tard, selon la période de latence."
                            },
                            {
                                "example_id": "df535681-97e7-40a8-8ecd-52f46a1a1986",
                                "sense_id": "adfc4940-ee00-3e55-a24c-f2a42f4f587c",
                                "text": "La cavité de la spermogonie porte de petits filaments dressés sur les parois et dirigés vers le centre. Ce sont les stérigmates ; ils sont simples ou rameux et donnent naissance à de petits bâtonnets formés d'une seule cellule, les spermaties."
                            }
                        ]
                    }
                ],
