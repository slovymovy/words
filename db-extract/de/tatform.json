                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d5fc6fc-9bfd-41b5-abde-bd65e0b38f01",
                                                "sense_id": "f06368a6-b398-36fd-84d1-afddc5753d16",
                                                "text": "I think it should be upgraded to Visual BASIC, but I'm no good at that. So maybe someone here would like to take a crack at it. There are only 40 lines of active code, plus a few REMs. About 100 BASIC commands altogether."
                                            },
                                            {
                                                "example_id": "8b9f51ac-4c62-4835-bbbb-17137889a75b",
                                                "sense_id": "f06368a6-b398-36fd-84d1-afddc5753d16",
                                                "text": "Edge uses green text for comments. This makes it easier for you to quickly differentiate between active code and comments."
