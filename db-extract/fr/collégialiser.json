                        "glosses": [
                            "Donner un caractère collégial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924b5800-7018-48c3-bb0b-e93cf2ceb5d4",
                                "sense_id": "ac009a9d-d2ee-3591-8583-779db6676d49",
                                "text": "Mais ceux qui ont soif d’équité peuvent miser sur un programme de travail de longue haleine : diversifier et collégialiser l’étage supérieur, le démonolithiser, le désenclaver, pour réduire son arrogance."
                            },
                            {
                                "example_id": "d910f576-6c2c-4998-8595-0aac9f086dcd",
                                "sense_id": "ac009a9d-d2ee-3591-8583-779db6676d49",
                                "text": "Il existe actuellement aux Etats-Unis dans leur organisation administrative une tendance à « collégialiser » les organes de direction des services publics."
                            }
                        ]
