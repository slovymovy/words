{
    "word_family": [
        "jittery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02f642fc-95b6-3c19-a6de-e5fe4c6fac64",
                    "sense_definition": "A state of extreme nervousness or anxiety.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nervousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That scary movie gave me the <w>jitters</w>.",
                            "target_lang_translations": {
                                "it": "Quel film dell'orrore mi ha fatto venire <w>la tremarella</w>."
                            }
                        },
                        {
                            "text": "I always get the <w>jitters</w> before a big public speech.",
                            "target_lang_translations": {
                                "it": "Ho sempre <w>l'agitazione</w> prima di un discorso pubblico importante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get the jitters"
                    ],
                    "target_lang_definitions": {
                        "it": "Uno stato di estremo nervosismo, ansia o agitazione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "agitazione",
                                "target_lang_sense_clarification": "stato di nervosismo"
                            },
                            {
                                "target_lang_word": "nervoso",
                                "target_lang_sense_clarification": "tensione emotiva"
                            },
                            {
                                "target_lang_word": "fifa",
                                "target_lang_sense_clarification": "paura o ansia intensa, colloquiale"
                            },
                            {
                                "target_lang_word": "tremarella",
                                "target_lang_sense_clarification": "paura con tremore, colloquiale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16a25468-818d-3123-a90e-aa603678fae7",
                    "sense_definition": "A small, involuntary nervous movement or twitch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nervousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to hide the <w>jitter</w> in his hand by putting it in his pocket.",
                            "target_lang_translations": {
                                "it": "Cercò di nascondere il <w>tremolio</w> della mano mettendola in tasca."
                            }
                        },
                        {
                            "text": "A slight <w>jitter</w> in her eye betrayed her hidden anxiety.",
                            "target_lang_translations": {
                                "it": "Un lieve <w>tic</w> all'occhio tradiva la sua ansia nascosta."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidget"
                    ],
                    "target_lang_definitions": {
                        "it": "Un piccolo movimento o tremolio involontario dovuto al nervosismo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "tremolio",
                                "target_lang_sense_clarification": "movimento oscillatorio involontario"
                            },
                            {
                                "target_lang_word": "tic",
                                "target_lang_sense_clarification": "spasmo muscolare involontario"
                            },
                            {
                                "target_lang_word": "contrazione",
                                "target_lang_sense_clarification": "piccolo scatto muscolare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "584713d7-307d-31b9-8a6d-3da3ed6e6ae8",
                    "sense_definition": "An unwanted, rapid variation in a signal or image.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The digital display suffered from a constant <w>jitter</w> that made it hard to read.",
                            "target_lang_translations": {
                                "it": "Il display digitale soffriva di un costante <w>sfarfallio</w> che lo rendeva difficile da leggere."
                            }
                        },
                        {
                            "text": "Engineers worked to reduce the <w>jitter</w> in the high-speed data transmission.",
                            "target_lang_translations": {
                                "it": "Gli ingegneri lavorarono per ridurre il <w>jitter</w> nella trasmissione dati ad alta velocità."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Variazione rapida e indesiderata in un segnale, impulso o immagine."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "jitter",
                                "target_lang_sense_clarification": "termine tecnico per la variazione di fase o ritardo del segnale"
                            },
                            {
                                "target_lang_word": "sfarfallio",
                                "target_lang_sense_clarification": "instabilità visiva di uno schermo o immagine"
                            },
                            {
                                "target_lang_word": "fluttuazione",
                                "target_lang_sense_clarification": "instabilità di un segnale elettronico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11c4f64e-5473-39ff-8cf9-e82af15860aa",
                    "sense_definition": "The random shifting of data points on a graph to prevent them from overlapping.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "data_visualization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding <w>jitter</w> to the scatter plot helps reveal the density of the data points.",
                            "target_lang_translations": {
                                "it": "Aggiungere <w>dispersione casuale</w> al grafico a dispersione aiuta a mostrare la densità dei punti dati."
                            }
                        },
                        {
                            "text": "The software applies <w>jitter</w> to ensure that every individual entry is visible.",
                            "target_lang_translations": {
                                "it": "Il software applica il <w>jittering</w> per garantire che ogni singola voce sia visibile."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Spostamento casuale di punti dati su un grafico per evitare sovrapposizioni."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "jittering",
                                "target_lang_sense_clarification": "tecnica di visualizzazione dati"
                            },
                            {
                                "target_lang_word": "dispersione casuale",
                                "target_lang_sense_clarification": "spostamento artificiale dei punti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0e1dfd3-2196-340a-aa67-95a79e8155db",
                    "sense_definition": "A computer program that performs just-in-time compilation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jitter</w> optimizes the code execution speed during runtime.",
                            "target_lang_translations": {
                                "it": "Il <w>compilatore JIT</w> ottimizza la velocità di esecuzione del codice durante il runtime."
                            }
                        },
                        {
                            "text": "Modern virtual machines often include a built-in <w>jitter</w> for better performance.",
                            "target_lang_translations": {
                                "it": "Le moderne macchine virtuali spesso includono un <w>compilatore JIT</w> integrato per prestazioni migliori."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Programma o componente software che esegue la compilazione just-in-time."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "compilatore JIT",
                                "target_lang_sense_clarification": "compilatore just-in-time in informatica"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bdd48b75-f222-30e3-93dc-d0a40784c4ba",
                    "sense_definition": "To feel or act nervous and restless.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nervousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>jitter</w> as the time for her interview approached.",
                            "target_lang_translations": {
                                "it": "Cominciò ad <w>agitarsi</w> con l'avvicinarsi dell'orario del suo colloquio."
                            }
                        },
                        {
                            "text": "The students started to <w>jitter</w> while waiting for their final exam results.",
                            "target_lang_translations": {
                                "it": "Gli studenti iniziarono a <w>essere nervosi</w> mentre aspettavano i risultati dell'esame finale."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidget"
                    ],
                    "target_lang_definitions": {
                        "it": "Sentirsi o comportarsi in modo nervoso e irrequieto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "agitarsi",
                                "target_lang_sense_clarification": "essere irrequieti per l'ansia"
                            },
                            {
                                "target_lang_word": "essere nervoso",
                                "target_lang_sense_clarification": "provare nervosismo"
                            },
                            {
                                "target_lang_word": "tremare",
                                "target_lang_sense_clarification": "avere tremolii per l'ansia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f5c12dd-a6f1-3a33-9554-6928b6062a03",
                    "sense_definition": "To add random noise to data points to prevent them from overlapping on a chart.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "data_visualization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>jitter</w> the points to make the distribution clearer.",
                            "target_lang_translations": {
                                "it": "Dovresti <w>disperdere casualmente</w> i punti per rendere la distribuzione più chiara."
                            }
                        },
                        {
                            "text": "The script will <w>jitter</w> the data to avoid visual clutter.",
                            "target_lang_translations": {
                                "it": "Lo script <w>applicherà il jittering a</w> i dati per evitare confusione visiva."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Aggiungere variazioni casuali alla posizione dei punti dati per evitarne la sovrapposizione in un grafico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "applicare jittering",
                                "target_lang_sense_clarification": "spostare leggermente i punti grafici"
                            },
                            {
                                "target_lang_word": "disperdere casualmente",
                                "target_lang_sense_clarification": "introdurre rumore casuale nella posizione"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}