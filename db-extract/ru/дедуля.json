                        "translation_id": "89c8185e-deb2-4e97-9126-56d14836bda2",
                        "source_entry_id": "d5fab406-9be9-3271-90c7-1c577fc3da01",
                        "source_sense_id": "b6809259-5e9a-3c33-ba64-20f90c911a3b",
                        "target_lang_word": "Opi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Opi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb83ddfa-5813-3969-9f30-97a55f6f94c0",
                                        "entry_id": "ec6ec744-a3aa-3e40-9c5c-2876f8696df0",
                                        "glosses": [
                                            "Kosewort für Opa"
                                        ],
                                        "tags": [
                                            "familiär"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a4718c-f179-4eed-8bf6-8e537ff7d7c8",
                                                "sense_id": "cb83ddfa-5813-3969-9f30-97a55f6f94c0",
                                                "text": "Das ist mein Opi."
                                            },
                                            {
                                                "example_id": "7d8a37cd-3432-4366-9324-5e8582b57790",
                                                "sense_id": "cb83ddfa-5813-3969-9f30-97a55f6f94c0",
                                                "text": "Hab keine Angst vor Opi, er ist sehr nett."
                                            },
                                            {
                                                "example_id": "8f71c753-68a9-4502-a859-d51ffe0008b1",
                                                "sense_id": "cb83ddfa-5813-3969-9f30-97a55f6f94c0",
                                                "text": "Opi arbeitet wieder fleißig im Garten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "693b3e9b-0615-3647-8592-d9a691035f1d",
                                        "entry_id": "ec6ec744-a3aa-3e40-9c5c-2876f8696df0",
                                        "glosses": [
                                            "älterer Mann"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8958d927-5952-4195-ab1f-e169f5df5de3",
                                                "sense_id": "693b3e9b-0615-3647-8592-d9a691035f1d",
                                                "text": "„Meine schmalen Hüften sind heute etwas breiter und mein Hintern so dick, dass fremde Opis es wagen, immer wieder mit ihren Einkaufswagen dagegen zu fahren. So wie jetzt.“"
                                            },
                                            {
                                                "example_id": "6719d8dc-4393-446c-97de-ec1a9719b91b",
                                                "sense_id": "693b3e9b-0615-3647-8592-d9a691035f1d",
                                                "text": "„‚Los, weiter geht’s, du Waschlappen! Willst du Fußball spielen oder rumdaddeln wie die Opis?‘, fragte Niklas, warf Tobias den Ball vor die Füße und ging schon wieder in Verteidigungsposition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
