                    "sense_id": "e8f9a834-a311-3331-bbb0-9523849f37f9",
                    "sense_definition": "iemand of iets dwingen weg te gaan of te verdwijnen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke wind zal de donkere wolken snel <w>verdrijven</w>.",
                            "target_lang_translations": {
                                "en": "The strong wind will quickly <w>disperse</w> the dark clouds."
                            }
                        },
                        {
                            "text": "Zij probeerde haar angst te <w>verdrijven</w> door diep adem te halen.",
                            "target_lang_translations": {
                                "en": "She tried to <w>dispel</w> her fear by breathing deeply."
                            }
                        }
                    ],
                    "synonyms": [
                        "verjagen"
                    ],
                    "antonyms": [
                        "aantrekken",
                        "uitnodigen"
                    ],
                    "common_phrases": [
                        "wolken verdrijven",
                        "angst verdrijven",
                        "de vijand verdrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone or something to leave or disappear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dispel",
                                "target_lang_sense_clarification": "to make a feeling or belief disappear"
                            },
                            {
                                "target_lang_word": "drive away",
                                "target_lang_sense_clarification": "to force someone or something to leave"
                            },
                            {
                                "target_lang_word": "disperse",
                                "target_lang_sense_clarification": "to cause to thin out or disappear, like clouds"
                            },
                            {
                                "target_lang_word": "banish",
                                "target_lang_sense_clarification": "to get rid of something unwanted"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5a845d5-6155-33c0-9b93-0de67e510315",
                    "sense_definition": "iemand met geweld dwingen zijn woonplaats of land te verlaten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze bevolkingsgroep is de voorbije oorlog uit dat gebied <w>verdreven</w>.",
                            "target_lang_translations": {
                                "en": "This population group was <w>driven out</w> of that area during the past war."
                            }
                        },
                        {
                            "text": "Na de overwinning hadden de soldaten de lokale bewoners uit hun huizen <w>verdreven</w>.",
                            "target_lang_translations": {
                                "en": "After the victory, the soldiers had <w>expelled</w> the local residents from their homes."
                            }
                        }
                    ],
                    "synonyms": [
                        "verjagen"
                    ],
                    "common_phrases": [
                        "uit het land verdrijven",
                        "bevolkingsgroepen verdrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone to leave their home or country, often by force or during conflict"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expel",
                                "target_lang_sense_clarification": "to force to leave a country"
                            },
                            {
                                "target_lang_word": "drive out",
                                "target_lang_sense_clarification": "to force people to leave an area"
                            },
                            {
                                "target_lang_word": "displace",
                                "target_lang_sense_clarification": "to force people to leave the place where they live"
                            },
                            {
                                "target_lang_word": "evict",
                                "target_lang_sense_clarification": "to force someone to leave a property"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e15ec9dc-a8d0-3734-9f52-e4fa2f2e24c1",
                    "sense_definition": "tijd op een aangename manier doorbrengen om verveling te voorkomen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tijdsbesteding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij lazen een boek om de tijd te <w>verdrijven</w> tijdens het wachten.",
                            "target_lang_translations": {
                                "en": "They read a book to <w>pass the time</w> while waiting."
                            }
                        },
                        {
                            "text": "Met een spelletje kaarten konden we de lange avond <w>verdrijven</w>.",
                            "target_lang_translations": {
                                "en": "With a game of cards, we were able to <w>while away</w> the long evening."
                            }
