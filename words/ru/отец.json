                            {
                                "target_lang_word": "大叔",
                                "target_lang_sense_clarification": "口语称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c70ca9e6-c28d-3c86-9cdb-a3d407ce7404",
                    "sense_definition": "Священнослужитель или монах (часто используется как обращение или титул).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Отец</w> Михаил начал утреннюю службу в храме.",
                            "target_lang_translations": {
                                "en": "<w>Father</w> Mikhail began the morning service in the church.",
                                "zh": "<w>神父</w>米哈伊尔在教堂开始了晨祷。"
                            }
                        },
                        {
                            "text": "Прихожане подошли к <w>отцу</w> настоятелю за благословением.",
                            "target_lang_translations": {
                                "en": "The parishioners approached the <w>Father</w> Superior for a blessing.",
                                "zh": "教徒们走到<w>神父</w>面前请求祝福。"
                            }
                        }
