                "entry_id": "495bcb3f-5b32-34ed-9de4-6e366456677f",
                "word": "carrack",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ab94d0b0-1c70-4d45-bd75-edf5f9cec29d",
