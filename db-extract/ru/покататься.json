                "senses": [
                    {
                        "sense_id": "3576f0cb-2675-3e93-ace6-4d9059cbcf38",
                        "entry_id": "a51c578e-30d0-348e-9c20-03f655827275",
                        "glosses": [
                            "to go for a drive, to drive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d645dc2-db31-4a4c-9975-44208cbe066a",
                                "sense_id": "3576f0cb-2675-3e93-ace6-4d9059cbcf38",
                                "text": "поката́ться на са́нках",
                                "translation": "to go for a run in a sledge; go sledging",
                                "english": "to go for a run in a sledge; go sledging"
                            },
                            {
                                "example_id": "9fa4048a-75c0-44d8-ad75-88a42ca6e70d",
                                "sense_id": "3576f0cb-2675-3e93-ace6-4d9059cbcf38",
                                "text": "поката́ться на ло́дке",
                                "translation": "to go out boating",
                                "english": "to go out boating"
                            },
                            {
                                "example_id": "e53bc9c3-e33e-4ba5-a31e-6624712cc1d4",
                                "sense_id": "3576f0cb-2675-3e93-ace6-4d9059cbcf38",
                                "text": "поката́ться немно́го/де́сять мину́т",
                                "translation": "to go for a short drive/for a ten minutes' drive",
                                "english": "to go for a short drive/for a ten minutes' drive"
                            },
                            {
                                "example_id": "1658c01b-0484-400c-8d75-4be0c1773ca9",
                                "sense_id": "3576f0cb-2675-3e93-ace6-4d9059cbcf38",
                                "text": "уго́нщики заяви́ли, что взя́ли маши́ну то́лько поката́ться",
                                "translation": "the car thieves said they were merely joy-riding",
                                "english": "the car thieves said they were merely joy-riding"
                            }
                        ]
                    },
