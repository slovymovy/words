                    "sense_id": "a1d1992f-6926-38fa-b855-2ea25d9cb6d1",
                    "sense_definition": "Projeter de l'eau, de la boue ou un autre liquide sur quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une voiture est passée à toute vitesse dans la flaque et a <w>éclaboussé</w> mon manteau blanc."
                        },
                        {
                            "text": "Les enfants s'amusent à sauter dans la piscine pour <w>éclabousser</w> leurs parents au bord de l'eau."
                        }
                    ],
                    "synonyms": [
