                "senses": [
                    {
                        "sense_id": "7f1d07fc-8606-3938-a8c9-13cb29273580",
                        "entry_id": "aafd3b8d-5be6-3169-b8a9-be91b0703461",
                        "glosses": [
                            "Donner un caractère non-organisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff7870d-9558-407f-905f-7bdb8d823244",
                                "sense_id": "7f1d07fc-8606-3938-a8c9-13cb29273580",
                                "text": "Ou peut-être est-ce à une façon de désorganiser méthodiquement, à une façon d’« anorganiser » son texte, que tient le choix de la longueur pour White;"
                            },
                            {
                                "example_id": "14fb242c-866e-41e7-ab7d-9b6493a3fe08",
                                "sense_id": "7f1d07fc-8606-3938-a8c9-13cb29273580",
                                "text": "La fatalité de la Weltanschauung de Spider : anorganiser un monde de morceaux, qui n'appelle finalement jamais véritablement la signification mais présentifie (présenter plutôt que re présenter) le monde de la souvenance (nouvelle affirmation de la prééminence du réalisme ontologique plutôt que de l'ordre discursif chez Cronenberg)."
                            }
                        ]
                    }
