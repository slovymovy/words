                                    {
                                        "sense_id": "eac3181f-f220-384e-898c-a26a5ee50c2b",
                                        "entry_id": "6a829863-e6a7-3892-ae10-b44eee0b3338",
                                        "glosses": [
                                            "gelblich-erdfarbenes Pigment, das aus verschiedenen Mineralien hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00935ee3-c2e2-4f1d-821a-615457eba53b",
                                                "sense_id": "eac3181f-f220-384e-898c-a26a5ee50c2b",
                                                "text": "Schon für die steinzeitlichen Höhlenmalereien wurden Ocker verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "850d8560-8772-3fa3-a600-c4a7e2b2dd29",
                                        "entry_id": "6a829863-e6a7-3892-ae10-b44eee0b3338",
                                        "glosses": [
                                            "gelblich-braune Erdfarbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da45082e-a091-4a5a-b3e7-bb0e7e9f5357",
                                                "sense_id": "850d8560-8772-3fa3-a600-c4a7e2b2dd29",
                                                "text": "Dieses Ocker gefällt mir nicht, ich hätte die Kacheln lieber in weiß."
                                            },
                                            {
                                                "example_id": "dbe93bf2-244d-4bdf-a4ff-57f7c6ac9f1f",
                                                "sense_id": "850d8560-8772-3fa3-a600-c4a7e2b2dd29",
                                                "text": "„Massai färbten sich die Haut mit Ocker, durchtränkten die Haare mit Kuhdung und flochten sich lange Zöpfe.“"
                                            },
                                            {
                                                "example_id": "d67fc57f-781c-4fe7-a487-3e7c076c1c6a",
                                                "sense_id": "850d8560-8772-3fa3-a600-c4a7e2b2dd29",
                                                "text": "„Im Licht des Sonnenuntergangs bekam das Ocker der Ebene einen warmen, fast orangeroten Schimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
