                                "target_senses": [
                                    {
                                        "sense_id": "8203353c-831b-33c2-ae1e-623920d91819",
                                        "entry_id": "43ab8b10-9714-3560-96ca-c6cc65e8a4fd",
                                        "glosses": [
                                            "Accumulation pathologique de tissus adipeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a141efe9-176c-4e12-b3bd-e85d288e52a4",
                                                "sense_id": "8203353c-831b-33c2-ae1e-623920d91819",
                                                "text": "L’adipose et la fibrose concernent l’hypoderme ; la rétention d’eau concerne le derme et l’hypoderme."
                                            },
                                            {
                                                "example_id": "17da3e0c-6050-4202-a6bb-8d00f9796409",
                                                "sense_id": "8203353c-831b-33c2-ae1e-623920d91819",
                                                "text": "Cette malade présente les symptômes cardinaux de la maladie de Dercum : adipose volumineuse, douleurs spontanées et douleurs provoquées par la palpation des masses adipeuses, asthénie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
