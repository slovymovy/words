                                    {
                                        "sense_id": "5f30e113-026b-34ea-8f80-705bba16379a",
                                        "entry_id": "db5e93eb-2643-3a07-ac67-f8268af6378a",
                                        "glosses": [
                                            "Erde^([1, 2, 6]), Erdboden enthaltend, mit Erde bedeckt sein, aus Erde bestehend, in der Art und Weise der Erde, des Erdbodens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46dc102a-bf94-4f22-97e1-3849ecccdbe4",
                                                "sense_id": "5f30e113-026b-34ea-8f80-705bba16379a",
                                                "text": "Immer bin ich es, der die erdigen Plastikdosen im geochemischen Labor reinigen muss."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44e933fd-2fa2-3f4a-8c37-54b7254b5afc",
                                        "entry_id": "db5e93eb-2643-3a07-ac67-f8268af6378a",
                                        "glosses": [
                                            "nach Erde, Erdboden schmeckend, riechend, an Erde erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a07e8d-e4d2-497f-a0ca-8bb6f36d70e9",
                                                "sense_id": "44e933fd-2fa2-3f4a-8c37-54b7254b5afc",
                                                "text": "Deine Bio-Küche hat immer einen erdigen Nachgeschmack."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e9500009-8a33-3061-9881-023100affa8d",
                                        "entry_id": "db5e93eb-2643-3a07-ac67-f8268af6378a",
                                        "glosses": [
                                            "ursprünglich, unverändert, original, bodenständig, urig, ungekünstelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe80890-509f-4674-83ec-5ef341bd15b2",
                                                "sense_id": "e9500009-8a33-3061-9881-023100affa8d",
                                                "text": "Diese erdigen Gemälde haben alle ihren eigenen Reiz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4169b7f-0dd0-4417-bf9c-ffbf5f9fa347",
                        "source_entry_id": "9dfd9579-b56b-3e24-86b4-f4f5f7e4cdeb",
                        "target_lang_word": "fahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e13c93a-749b-362d-b9c9-4ec3528f7ca8",
                                        "entry_id": "f6d4ae4a-12cf-3a61-9036-50da7e6913c6",
                                        "glosses": [
                                            "(auf nicht schöne Weise) ohne kräftige Farbe, farbenarm, blass, fast farblos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e50e043-3e72-417b-8a5f-032dac365138",
                                                "sense_id": "7e13c93a-749b-362d-b9c9-4ec3528f7ca8",
                                                "text": "Der Lehrer wurde fahl vor Ärger."
                                            },
                                            {
                                                "example_id": "2313d9b2-8e92-42ee-aef1-b6517243e1d8",
                                                "sense_id": "7e13c93a-749b-362d-b9c9-4ec3528f7ca8",
                                                "text": "„Der fahle Herr stellte sich sofort als Regierungsrat Hifthorn von Hosenboden vor und begann von einer Geschwulst zu reden, die er im Leibe habe.“"
                                            },
                                            {
                                                "example_id": "d81ef73a-f57a-4292-ac0d-927e08f2241b",
                                                "sense_id": "7e13c93a-749b-362d-b9c9-4ec3528f7ca8",
                                                "text": "„Die Vegetation, die ihr glänzendes Grün durch die vorangehende trockene Glut verloren und fahlere Tinten angenommen hatte, erhält ihre ganze Frische und Schönheit wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7da3b0f-cf5f-36d2-b734-b21957d1d480",
                                        "entry_id": "f6d4ae4a-12cf-3a61-9036-50da7e6913c6",
                                        "glosses": [
                                            "nicht hell, schwach erhellt, trüb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e8fbdb5-e265-4a6c-9c71-1d522967922c",
                                                "sense_id": "d7da3b0f-cf5f-36d2-b734-b21957d1d480",
                                                "text": "Das Zimmer lag – in ein fahles Licht getaucht – verlassen vor ihr."
                                            },
                                            {
                                                "example_id": "3e00da24-70bb-45fd-921b-03cb3bd4f714",
                                                "sense_id": "d7da3b0f-cf5f-36d2-b734-b21957d1d480",
                                                "text": "„Der Donner rollt, und fahle Blitze zucken … / Wer ist’s, der drüben froh die Mütze schwingt, / Um dann sich scheu in das Gestrüpp zu ducken, / Bevor sein Fuß den Grenzbach überspringt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e82e1ee5-a385-3bc5-8f9a-4b5fb75af909",
                                        "entry_id": "f6d4ae4a-12cf-3a61-9036-50da7e6913c6",
                                        "glosses": [
                                            "kaum Kraft habend, schwach, wie tot"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne; gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a8011f5-68a4-4591-b5b7-6ecf9e6b7c8d",
                                                "sense_id": "e82e1ee5-a385-3bc5-8f9a-4b5fb75af909",
                                                "text": "„Die elende Speise erhöhte nur noch die Sterblichkeit; viele Familien gingen rettungslos zugrunde; es war eine allgemeine Verheerung. Andere wanderten aus, fahl, bleich, abgezehrt, um in der Fremde Hilfe zu finden.“"
                                            },
                                            {
                                                "example_id": "1187bab2-e1a1-49c3-9dd1-17e2b4ef6fe7",
                                                "sense_id": "e82e1ee5-a385-3bc5-8f9a-4b5fb75af909",
                                                "text": "„Mira warf ihm ein fahles Lächeln zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c75afa81-2116-3aa6-b016-0748a6ff48d2",
                                        "entry_id": "f6d4ae4a-12cf-3a61-9036-50da7e6913c6",
                                        "glosses": [
                                            "leicht übel, schwindelig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880e00ea-7569-4ae1-973c-553529e79059",
                                                "sense_id": "c75afa81-2116-3aa6-b016-0748a6ff48d2",
                                                "text": "„Mittlerweile war mir extrem fahl im Magen, sowohl von der Höhe wie auch den vielen Süssigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2db2fd4e-850a-3cb9-88a0-1b76f2debb90",
                                        "entry_id": "f6d4ae4a-12cf-3a61-9036-50da7e6913c6",
                                        "glosses": [
                                            "(bis ins 17. Jahrhundert geläufig); in Bezug auf Haar und Bart: blond"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e8cba1a-3d73-47d1-8fa9-f5ba34ec28b3",
