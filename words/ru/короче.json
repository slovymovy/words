        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "663093a2-bce2-39c3-945d-c7ab4aa8b38d",
                    "sense_definition": "Употребляется как вводное слово для подведения итога сказанному, вывода или перехода к сути дела; одним словом.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "parenthetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Короче, <w>короче</w>, мы решили не ехать в этот отпуск.",
                            "target_lang_translations": {
                                "en": "Anyway, <w>long story short</w>, we decided not to go on this vacation.",
                                "es": "<w>En fin</w>, decidimos no ir a estas vacaciones.",
                                "fr": "<w>Bref</w>, nous avons décidé de ne pas partir en vacances."
                            }
                        },
                        {
                            "text": "Ну, <w>короче</w>, фильм мне совсем не понравился, зря потратил время.",
                            "target_lang_translations": {
                                "en": "Well, <w>basically</w>, I didn't like the movie at all, I wasted my time.",
                                "es": "Bueno, <w>resumiendo</w>, la película no me gustó nada, perdí el tiempo.",
                                "fr": "Eh bien, <w>en gros</w>, je n'ai pas du tout aimé le film, j'ai perdu mon temps."
                            }
                        }
                    ],
                    "synonyms": [
                        "короче говоря"
                    ],
                    "common_phrases": [
                        "ну короче",
                        "если короче"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a filler word to summarize, conclude, or get to the point; in a word.",
                        "es": "Se utiliza como palabra de relleno para resumir, concluir o ir al grano; en una palabra.",
                        "fr": "Utilisé comme mot de remplissage pour résumer, conclure ou aller à l'essentiel ; en un mot."
                    },
