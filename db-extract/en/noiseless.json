    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                "word": "noiseless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c0bb056d-b0d5-46b3-8c00-eb49dee74080",
                        "entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
