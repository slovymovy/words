                ],
                "senses": [
                    {
                        "sense_id": "92f5183e-b36d-32e9-8bcf-ca5059f0d076",
                        "entry_id": "583e3908-bef0-3f32-bfff-32806f6c9bf4",
                        "glosses": [
                            "To make (something) dirty or soiled; to soil; to stain; to sully."
                        ],
                        "tags": [
                            "archaic",
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ca24ad7c-50d2-4aea-b75b-899af5d9f227",
                                "sense_id": "92f5183e-b36d-32e9-8bcf-ca5059f0d076",
                                "text": "Is it that the world has assoiled my soul? Yet I have not tasted of worldly joys; all that I have known of it has been suffering and tears."
                            }
                        ]
                    }
                ],
