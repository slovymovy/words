                        "target_lang_word": "čtyřkařka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čtyřkařka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2dc8a7-6e6c-3f7e-b205-361b4b5bf8d9",
                                        "entry_id": "49ea0146-07f5-3c3a-9c42-bb00fb9e460e",
                                        "glosses": [
                                            "učnice/žákyně/středoškolská studentka, výsledky jejíž školní práce bývají (o)hodnoceny stupněm „dostatečný“ / „méně uspokojivý“"
                                        ],
                                        "tags": [
                                            "tedy „čtyřkou“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e876b476-7d3d-4a4a-8009-de76b36d2a88",
                                                "sense_id": "0b2dc8a7-6e6c-3f7e-b205-361b4b5bf8d9",
                                                "text": "Vyznamenání by mohly dostat herečka Šafránková a čtyřkařka Fibingerová."
                                            },
                                            {
                                                "example_id": "92dad4fd-a559-4f56-8b45-0e1f7c5c8a41",
                                                "sense_id": "0b2dc8a7-6e6c-3f7e-b205-361b4b5bf8d9",
                                                "text": "Na základní škole jsem byla nemotivovaná jedničkářka, která si celý den četla pod lavicí. Na gymplu jsem se pak postupně stala nemotivovanou čtyřkařkou, která si celý den četla pod lavicí. Protože jsem si ze škol nic moc jiného neodnesla, celkem logicky jsem se vydala studovat literaturu – konkrétně bohemistiku a anglistiku-amerikanistiku."
                                            },
                                            {
                                                "example_id": "6382e2e3-b45e-4d46-af1e-120343e91a81",
                                                "sense_id": "0b2dc8a7-6e6c-3f7e-b205-361b4b5bf8d9",
                                                "text": "Řada absolventek obchodní akademie, čtyřkařek, je v praktickém životě mnohem flexibilnější a použitelnější než jejich spolužačky s vyznamenáním."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bb89357-3644-3b6e-b669-9a341c478ca6",
                                        "entry_id": "49ea0146-07f5-3c3a-9c42-bb00fb9e460e",
                                        "glosses": [
                                            "žena nebo dívka, jejíž poprsí má velikost č. čtyři"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
