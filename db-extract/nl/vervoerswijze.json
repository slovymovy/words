                        "examples": [
                            {
                                "example_id": "9450f5c3-b1b3-4f7d-88ad-b5a17010fad8",
                                "sense_id": "24c2741d-2cee-3324-afb2-d1418602b4fe",
                                "text": "De nachttrein naar Hamburg, Liegewagen tweede klas met papieren lakens, de goedkoopste vervoerswijze voor de juridisch medewerker van het advocatenbureau van Henning Sjôstrand terug naar het leven zoals het voor haar was geweest."
                            },
                            {
                                "example_id": "28c037b1-3868-465b-a814-1fa73c2800bc",
                                "sense_id": "24c2741d-2cee-3324-afb2-d1418602b4fe",
                                "text": "Ze verbleef vanaf medio juni 1990 bij het Leger des Heils in Rotterdam, maar vanaf 5 september was zij hier niet meer welkom omdat ze haar financiële verplichtingen niet nakwam. Nadat zij uit haar woning was gezet, is ze ook haar uitkering kwijtgeraakt, waarna ze geen inkomsten meer had. Haar meest gebruikte vervoerswijze was te voet."
                            }
                        ]
