                    {
                        "translation_id": "874b6ec5-1a16-4305-94ce-09cf888ee231",
                        "source_entry_id": "2d840402-22ff-32a8-9a9b-cb7239d4a0ca",
                        "source_sense_description": "to cause to lose orientation or direction",
                        "target_lang_word": "дезориенти́ровать",
                        "target_lang_code": "ru",
