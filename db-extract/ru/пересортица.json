                "senses": [
                    {
                        "sense_id": "93b084f7-ad56-3eae-b5bc-51ebcee48448",
                        "entry_id": "95acc708-439b-3994-bb21-e83525c4e2c4",
                        "glosses": [
                            "экон. перевод товара из одного (обычно более низкого) сорта в другой (обычно в более высокий, с целью продажи по более высокой цене)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3649a5d5-aac4-4d5f-b8a6-6d5fe9567678",
                                "sense_id": "93b084f7-ad56-3eae-b5bc-51ebcee48448",
                                "text": "К пересортице все привыкли, на ней кормятся."
                            },
                            {
                                "example_id": "b8921500-80b5-40f3-bd35-677f45cdcf71",
                                "sense_id": "93b084f7-ad56-3eae-b5bc-51ebcee48448",
                                "text": "Каждый советский торгаш был сформирован властью для воровства. Обсчет, обвес, усушка, утруска, пересортица, списание товаров, стеклобой, левый товар и вечный дефицит."
                            }
                        ]
                    }
