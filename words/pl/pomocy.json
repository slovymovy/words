                    "sense_id": "3ead61b5-7902-3a96-a807-2c4ec9a7de2a",
                    "sense_definition": "wołanie o wsparcie w sytuacji zagrożenia lub nagłej potrzeby",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pomocy</w>! – krzyczał, wisząc nad przepaścią.",
                            "target_lang_translations": {
                                "ru": "<w>Помогите</w>! — кричал он, вися над пропастью.",
                                "en": "<w>Help</w>! he shouted, hanging over the abyss.",
                                "nl": "<w>Help</w>! – schreeuwde hij, hangend boven de afgrond.",
                                "de": "<w>Hilfe</w>! – schrie er, während er über dem Abgrund hing.",
                                "fr": "<w>À l'aide</w> ! – criait-il, suspendu au-dessus du précipice.",
                                "it": "<w>Aiuto</w>! – gridava, appeso sopra l'abisso.",
                                "cs": "<w>Pomoc</w>! – křičel, když visel nad propastí.",
                                "tr": "<w>İmdat</w>! – diye bağırıyordu uçurumun kenarında asılıyken.",
                                "es": "¡<w>Socorro</w>! – gritaba mientras colgaba sobre el abismo.",
                                "zh": "他悬在深渊上空大喊：“<w>救命</w>！”"
                            }
                        },
                        {
                            "text": "<w>Pomocy</w>, czy jest tu jakiś lekarz?",
                            "target_lang_translations": {
                                "ru": "<w>Помогите</w>, здесь есть врач?",
                                "en": "<w>Help</w>, is there a doctor here?",
                                "nl": "<w>Help</w>, is hier een dokter?",
                                "de": "<w>Hilfe</w>, ist hier ein Arzt?",
                                "fr": "<w>À l'aide</w>, y a-t-il un médecin ici ?",
                                "it": "<w>Aiuto</w>, c'è un medico qui?",
                                "cs": "<w>Pomoc</w>, je tu nějaký lékař?",
                                "tr": "<w>Yardım edin</w>, burada bir doktor var mı?",
                                "es": "¡<w>Ayuda</w>!, ¿hay algún médico aquí?",
                                "zh": "<w>救命</w>，这里有医生吗？"
                            }
                        }
                    ],
                    "synonyms": [
