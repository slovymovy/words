                    "sense_id": "a9f4e71e-fc02-3a05-aeb1-6516e7cedad7",
                    "sense_definition": "De eerste trap vanuit de middencirkel bij het begin van de speeltijd van een voetbalwedstrijd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De scheidsrechter floot voor het begin van de wedstrijd en de thuisploeg nam de <w>aftrap</w>.",
                            "target_lang_translations": {
                                "en": "The referee blew the whistle for the start of the match and the home team took the <w>kick-off</w>."
                            }
                        },
                        {
                            "text": "Na het doelpunt moesten we de <w>aftrap</w> nemen vanaf de middenstip.",
                            "target_lang_translations": {
                                "en": "After the goal, we had to take the <w>kick-off</w> from the center spot."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de aftrap nemen"
                    ],
                    "target_lang_definitions": {
