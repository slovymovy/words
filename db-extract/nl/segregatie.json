                                        "sense_id": "221e4fda-e968-3e5e-86cb-dba8b5006f6d",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "The setting apart in Mendelian inheritance of alleles, such that each parent passes only one allele to its offspring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
