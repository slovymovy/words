                "senses": [
                    {
                        "sense_id": "42f2157a-e3e7-3d60-beaf-481b6a27a0d4",
                        "entry_id": "964437f5-4823-3d18-85e3-ec51f118136e",
                        "glosses": [
                            "hiszpański taniec ludowy w rytmie 3/4 lub 6/8, ostro wybijanym kastanietami, tańczony z akompaniamentem gitary"
                        ],
                        "tags": [],
