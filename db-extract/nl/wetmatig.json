                                        "sense_id": "196f44d1-8814-3cf1-8c05-33b687750ecc",
                                        "entry_id": "3d8a2d58-6b3e-3fb5-8569-53c13cd7efba",
                                        "glosses": [
                                            "A character having a lawful alignment."
                                        ],
