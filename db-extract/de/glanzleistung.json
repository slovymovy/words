                "senses": [
                    {
                        "sense_id": "ce337339-6d40-38ca-82b7-30c737987c7e",
                        "entry_id": "ed748c50-ca44-3863-bf3b-a6cd833f149e",
                        "glosses": [
                            "eine Tat, die besonders geschätzt, gewürdigt, gelobt wird; ein Ergebnis, das besonders geschätzt, gewürdigt, gelobt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87a749b-caaf-4548-aad9-4dddf0506b8f",
                                "sense_id": "ce337339-6d40-38ca-82b7-30c737987c7e",
                                "text": "Es war eine Glanzleistung als die Außenseiter das Turnier gewannen."
                            },
                            {
                                "example_id": "d68de392-df67-4c02-88c7-be6353dfd477",
                                "sense_id": "ce337339-6d40-38ca-82b7-30c737987c7e",
                                "text": "Die Skulptur ist eine Glanzleistung."
                            },
                            {
                                "example_id": "69977a4f-327d-4b1b-bb75-b9d4fe9fb0d8",
                                "sense_id": "ce337339-6d40-38ca-82b7-30c737987c7e",
                                "text": "„Nach der rhetorischen Glanzleistung des Präsidenten folgte ein Schwall blecherner patriotischer Phrasen.“"
                            },
                            {
                                "example_id": "d915b735-27b6-4cda-b9f2-95b1704192a6",
                                "sense_id": "ce337339-6d40-38ca-82b7-30c737987c7e",
                                "text": "„Wenn sie will, kann die deutsche Presse Glanzleistungen vollbringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5829c41-7d65-37f9-9f23-f7bd6984b174",
                        "entry_id": "ed748c50-ca44-3863-bf3b-a6cd833f149e",
                        "glosses": [
                            "schlechte Leistung, dumme Tat"
                        ],
                        "tags": [
                            "ironisch"
                        ],
                        "examples": [
                            {
                                "example_id": "84f655ca-2608-4462-808d-decc76989275",
                                "sense_id": "f5829c41-7d65-37f9-9f23-f7bd6984b174",
                                "text": "Mit der Demontage der falschen Brücke haben die Schildbürger eine Glanzleistung vollbracht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
