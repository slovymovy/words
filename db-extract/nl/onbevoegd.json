                                                "sense_id": "e2258b76-caef-38e5-8293-9a3956a90d26",
                                                "text": "Le tribunal s’est déclaré incompétent."
                                            },
                                            {
                                                "example_id": "ed8e77fa-3a77-4c3b-b18d-020069f946d7",
                                                "sense_id": "e2258b76-caef-38e5-8293-9a3956a90d26",
                                                "text": "Il est incompétent pour connaître de cette affaire."
                                            },
                                            {
                                                "example_id": "b395277d-b200-4c92-ae51-9c61cac9aea7",
                                                "sense_id": "e2258b76-caef-38e5-8293-9a3956a90d26",
