                    {
                        "sense_id": "329dd64d-7480-3eec-b11c-e8607ace60d0",
                        "entry_id": "61422df4-d8c4-382a-8703-820888f29a84",
                        "glosses": [
                            "Not disconcerted or embarrassed; not concealed; not eliciting shame."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4854ea8d-c4a0-4ae1-aca2-12ccf78e6978",
                                "sense_id": "329dd64d-7480-3eec-b11c-e8607ace60d0",
                                "text": "Nor wanted words as ready and as big\nAs the part he played, the bold abashless one."
                            },
                            {
                                "example_id": "30e4b8ec-647f-4ae5-af3a-99a6f829bb55",
                                "sense_id": "329dd64d-7480-3eec-b11c-e8607ace60d0",
                                "text": "I had endured through watches of the dark\nThe abashless inquisition of each star,"
                            },
                            {
                                "example_id": "c8a49938-6cff-45d0-9519-c579ff3455b1",
                                "sense_id": "329dd64d-7480-3eec-b11c-e8607ace60d0",
                                "text": "Where every bird is bold to go / And bees abashless play, / The foreigner before he knocks / Must thrust the tears away."
                            },
                            {
                                "example_id": "734c8121-892c-4ca8-b316-2ebb437ce48e",
                                "sense_id": "329dd64d-7480-3eec-b11c-e8607ace60d0",
                                "text": "a place created for and by voluptuousness, the abashless and unabashed senses"
                            }
                        ]
                    }
                ],
