                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f13fa398-029e-462e-9b51-e63f18c0bc29",
                                "sense_id": "ae07d6c6-a725-3644-be4d-02140ce17eee",
                                "text": "La beauté est l’excitant, l’exhilarant de l’imagination ; et l’admiration rafraîchit le cœur et l’âme."
