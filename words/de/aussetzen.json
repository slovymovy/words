                    ]
                },
                {
                    "sense_id": "b253eaef-57d7-32b4-a300-711d51ffdf0d",
                    "sense_definition": "Ein Tier oder eine Person an einem Ort hilflos zurücklassen oder in die freie Natur entlassen",
