                "senses": [
                    {
                        "sense_id": "1d996c94-ebd5-3551-8113-bb58edef3b40",
                        "entry_id": "da98c60d-4879-3797-a67c-c672c028906f",
                        "glosses": [
                            "Qui extermine."
                        ],
                        "tags": [
                            "Par apposition"
                        ],
                        "examples": [
                            {
                                "example_id": "49842e89-e0e2-44c3-9231-021e470d9d8d",
                                "sense_id": "1d996c94-ebd5-3551-8113-bb58edef3b40",
                                "text": "Nous étions ainsi en face, le fantôme et moi, […], lorsque je vis, […], Grégoriska sortir de derrière la stalle de bois, semblable à l'ange exterminateur et tenant son épée à la main."
                            },
                            {
                                "example_id": "278ba4ba-dd14-461a-a8b6-8f182211effa",
                                "sense_id": "1d996c94-ebd5-3551-8113-bb58edef3b40",
                                "text": "Elle avait toujours détesté Carole. Une sorte de jalousie femelle depuis des années, tirant argument de la moindre faute, rassemblant des broutilles pour allumer un feu exterminateur."
                            }
                        ]
                    }
                ],
