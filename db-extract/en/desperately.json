                    },
                    {
                        "translation_id": "dc1debd7-3a66-4278-9560-ac68405d1c41",
                        "source_entry_id": "201c2a18-25ef-3219-a873-3d0355d80b3a",
                        "source_sense_description": "in a desperate manner",
                        "target_lang_word": "wanhopig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wanhopig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3e23556e-fa01-39ed-82f9-2309e75cee32",
                                        "entry_id": "ed499900-acbf-331c-9f8f-941ae313e7a0",
                                        "glosses": [
                                            "zonder hoop op een positieve uitkomst of althans sterk daaraan twijfelend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f4bbba-38a9-4224-8ec4-6070d177b027",
                                                "sense_id": "3e23556e-fa01-39ed-82f9-2309e75cee32",
                                                "text": "Hij zag een wanhopige blik in de ogen van zijn tegenstander en schepte daaruit moed."
                                            },
                                            {
                                                "example_id": "9079c7f0-d6b2-4278-96ad-98d7369acae1",
                                                "sense_id": "3e23556e-fa01-39ed-82f9-2309e75cee32",
                                                "text": "Ze had haar blik gericht op iets in de verte, voorbij de drukke weg, de hoge en beroete gebouwen, de kleurige reclameborden, de voetgangers die wanhopig plassen probeerden te ontwijken."
                                            },
                                            {
                                                "example_id": "ac2a905a-bcc0-4e79-a128-081e03bb8fec",
                                                "sense_id": "3e23556e-fa01-39ed-82f9-2309e75cee32",
                                                "text": "Enkele dagen geleden zijn ze naar het uitzetcentrum in Zeist gebracht en maandagochtend vroeg naar Schiphol. De advocate hoorde aan de stem van vader Hovik (38) dat hij wanhopig was. Zij sprak hem nog vlak voor hun vertrek."
                                            },
                                            {
                                                "example_id": "882e07b7-b369-4950-8430-e61608800d3e",
                                                "sense_id": "3e23556e-fa01-39ed-82f9-2309e75cee32",
                                                "text": "Hier was geen interior designer aan het werk geweest met een efficiënt, anoniem ontwerp, maar had een overdaad aan geschiedenis een wanhopig zuchtende overdaad aan weelderige sporen achtergelaten."
                                            },
                                            {
                                                "example_id": "1cf93595-fda0-48c6-95c2-41725e602931",
                                                "sense_id": "3e23556e-fa01-39ed-82f9-2309e75cee32",
                                                "text": "Dit was het moeilijke moment, dat was altijd zo. Nu moest hij zeggen dat de dienst hem helaas riep en dat hij rond lunchtijd al opgehaald zou worden met een geheim transport. Maar dat ze elkaar altijd konden schrijven, dat de oorlog niet eeuwig duurde en dat hij haar onmogelijk zou kunnen vergeten. Ze was natuurlijk wanhopig en vond dat hij haar erin had geluisd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75969c4d-3499-4b8b-a1d4-bbff6ccab701",
                        "source_entry_id": "201c2a18-25ef-3219-a873-3d0355d80b3a",
                        "source_sense_description": "in a desperate manner",
                        "target_lang_word": "désespérément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désespérément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb923b1f-5d0e-3309-8d83-9488137de294",
                                        "entry_id": "1d035e2b-b63e-3b5a-8e68-07d34cf91174",
                                        "glosses": [
                                            "D’une façon désespérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf666480-546f-4512-8243-4ff75cfa15ed",
                                                "sense_id": "fb923b1f-5d0e-3309-8d83-9488137de294",
                                                "text": "Les autres apprennent à guérir les âmes par des austérités pénibles ; mais vous montrez que celles qu’on aurait crues le plus désespérément malades se portent bien."
                                            },
                                            {
                                                "example_id": "a08f854c-b25d-4fa6-ab39-ddc2f3123e95",
                                                "sense_id": "fb923b1f-5d0e-3309-8d83-9488137de294",
                                                "text": "Sous un ciel fuligineux et sur une mer furieuse, un voilier démâté fuyait la tempête, donnant fortement de la bande, luttant désespérément contre l’assaut d’énormes vagues bondissantes qui se ruaient, secouant leurs crinières écumantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a6f02f-100b-309b-bc82-7b90e44a894f",
                                        "entry_id": "1d035e2b-b63e-3b5a-8e68-07d34cf91174",
                                        "glosses": [
                                            "Avec excès, surtout avec l’idée de manquer d’espoir dans le succès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41dc3ca5-0bdd-4eba-8038-dae0bb1b63cc",
                                                "sense_id": "c2a6f02f-100b-309b-bc82-7b90e44a894f",
                                                "text": "J’étais maintenant, en ces après-midi du samedi, un jeune homme désespérément amoureux, un crétin absolu totalement indifférent à quoi que ce soit d’autre dans le monde."
                                            },
                                            {
                                                "example_id": "8493213a-1ef9-4c49-9fff-2131f7516305",
                                                "sense_id": "c2a6f02f-100b-309b-bc82-7b90e44a894f",
                                                "text": "J'ai désespérément besoin d'une douche. Je suis à deux doigts de faire couler l'eau quand j'entends frapper à la porte d'entrée. Je grognasse en regardant la pendule :"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
