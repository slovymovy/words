                                    {
                                        "sense_id": "f87cee01-c92a-3d28-b73b-bcc794de120d",
                                        "entry_id": "ccb8485f-7061-3e8a-b849-d4d916b43c3c",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3824abd-7e81-4f53-8da1-be086b9297b2",
                                                "sense_id": "f87cee01-c92a-3d28-b73b-bcc794de120d",
                                                "text": "\"Euphemia is Grandmama's name, my dear.\" The children looked grave. Euphemia sounded very strange and old-fashioned to them. \"Or Effie,\" added Mr. Barclay, \"if you like that better.\"\nEffie, the prettiest of diminutives, gained all suffrages."
                                            },
                                            {
                                                "example_id": "2d74a4b7-6c2a-48c2-ab78-f7c07855a147",
                                                "sense_id": "f87cee01-c92a-3d28-b73b-bcc794de120d",
                                                "text": "\"Euphemia,\" said Kipps at last, unable altogether to keep to himself this suspicion of a high origin that floated so delightfully about him, \"Eu-phemia; it isn't a name common people would give to a girl, is it?\" - - -\n\"It's givin' girls names like that,\" said Buggins, \"that nine times out of ten makes 'em go wrong. It unsettles 'em. If ever I was to have a dozen girls, I'd call 'em all Jane."
                                            }
                                        ]
                                    }
                                ]
                            }
