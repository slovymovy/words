                                        "sense_id": "816fc7f6-2b8e-3f09-a1c8-6eace5d74781",
                                        "entry_id": "53c592d1-b035-36eb-9be8-80f344940f74",
                                        "glosses": [
                                            "Pluriel de couvert."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68fe3716-dac8-38fe-bde7-cd5b3b0d4521",
                                        "entry_id": "53c592d1-b035-36eb-9be8-80f344940f74",
                                        "glosses": [
                                            "Tout ce qui a constitué le couvert d'une table."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e0ac0f-5a96-49b7-8429-28c68d5cd226",
                                                "sense_id": "68fe3716-dac8-38fe-bde7-cd5b3b0d4521",
                                                "text": "Et malgré cela, certains vendeurs font l’erreur de “décapricier” le client, en économisant sur les serviettes, les pailles, les couverts en plastique, les sachets personnalisés ou de qualité…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couverts",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a94ac86d-402c-36dd-8ac1-0fd334a85a9e",
                                        "entry_id": "cfe8496a-fbba-3a7c-8c42-ee7065779a3a",
                                        "glosses": [
                                            "Participe passé masculin pluriel de couvrir."
