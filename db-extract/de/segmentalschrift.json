                ],
                "senses": [
                    {
                        "sense_id": "90f1e2e1-27eb-3e18-a525-af260beb965f",
                        "entry_id": "a4d7f77f-f4d6-3dad-8397-e4695dcb85b2",
                        "glosses": [
                            "Schrift, bei der nur die Konsonanten, aber nicht die Vokale geschrieben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f703962f-3579-4d34-a699-40f71939895c",
                                "sense_id": "90f1e2e1-27eb-3e18-a525-af260beb965f",
                                "text": "„Im Unterschied zum System einer Segmentalschrift, dessen Zeichen einzelne Konsonanten, aber auch Konsonantengruppen wiedergeben, sind die Strukturen einer Silbenschrift einfacher und klarer.“"
                            },
                            {
                                "example_id": "7cfe6465-bde9-425b-956f-d3bf571d1f06",
                                "sense_id": "90f1e2e1-27eb-3e18-a525-af260beb965f",
                                "text": "„Beispiele für Segmentalschriften sind die Arabische Schrift oder die Hebräische Schrift.“"
                            },
                            {
                                "example_id": "0d6852c7-f13d-4ed6-8541-2e64a55c1601",
                                "sense_id": "90f1e2e1-27eb-3e18-a525-af260beb965f",
                                "text": "„Bevor die ägyptische Hieroglyphenschrift ihre Eigenart als Segmentalschrift ausgeprägt hatte, wurden Piktogramme verwendet, die, in Schiefertafeln geritzt, zu Kompositionen zusammengesetzt wurden.“"
                            },
                            {
                                "example_id": "efa9ae63-d899-431d-9da5-cf5b4a6e283b",
                                "sense_id": "90f1e2e1-27eb-3e18-a525-af260beb965f",
                                "text": "„Die ersten bekannten Alphabetschriften (phönizisch, ägyptisch) waren sogenannte Segmentalschriften, das heißt es wurden nur die Konsonanten geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
