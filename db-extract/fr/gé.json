                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24834a13-ba7a-4c08-b6b7-f05e59614700",
                                                "sense_id": "c8cca233-c272-3753-854f-2378de1aa7f0",
                                                "text": "You may need to walk up to the front of the pack and physically gee the lead dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e5b7a1-6e2a-3b3e-8ebe-5e72d1fe649b",
                                        "entry_id": "31cefb2a-d77d-365e-86d2-8de6f653324d",
                                        "glosses": [
                                            "To agree; to harmonize."
