                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d217610-7eb6-38a1-a55a-896b180eba71",
                        "entry_id": "364a25c5-7d7a-384a-bb45-c9317a718e03",
                        "glosses": [
                            "ювел. очень тонкая металлическая нить, используемая для вышивания или для украшения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1767dbcd-1aee-4e70-a1ee-54a01015d404",
                                "sense_id": "7d217610-7eb6-38a1-a55a-896b180eba71",
                                "text": "Для изготовления флагов часто применяется вышивка золотой канителью."
                            }
                        ]
                    },
                    {
                        "sense_id": "43c435fb-a11d-338d-b65a-75406fcf1fbb",
                        "entry_id": "364a25c5-7d7a-384a-bb45-c9317a718e03",
                        "glosses": [
                            "перен. разг. затяжное, нудное, хлопотное дело"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "250fe2ea-7177-44df-9a7f-29d7209db316",
                                "sense_id": "43c435fb-a11d-338d-b65a-75406fcf1fbb",
                                "text": "Дело теперь объяснилось, главному факту мы соглашаемся верить, зачем же тянуть далее тяжелую и обидную канитель?"
                            },
                            {
                                "example_id": "c673bc72-3447-4a8f-bc4d-db17575ba86b",
                                "sense_id": "43c435fb-a11d-338d-b65a-75406fcf1fbb",
                                "text": "Тут на первом плане томное выражение лица, загадочно-жгучий взор, провожание, «понимание друг друга без слов», просиживание по целым часам рядом на диване, романсы, записочки и прочая канитель."
                            },
                            {
                                "example_id": "45292bdf-a63a-4dbc-af21-612e57674274",
                                "sense_id": "43c435fb-a11d-338d-b65a-75406fcf1fbb",
                                "text": "Ну, ты и развёл здесь канитель!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e81cf26-e31e-4a09-aa7f-b94ac672f94d",
                        "source_entry_id": "364a25c5-7d7a-384a-bb45-c9317a718e03",
                        "source_sense_description": "нить",
                        "target_lang_word": "cannetille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cannetille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                                        "entry_id": "a17d0904-06dd-316d-84d7-b3aa87aebe09",
                                        "glosses": [
                                            "Fil d’or ou d’argent torsadé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eba7282-6a6d-4d31-8c7a-161fb9af171c",
                                                "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                                                "text": "Il y avait dans sa coiffure, des roses artificielles et des ornements en cannetille dédorée qui lui donnaient l’air d’une poupée."
                                            },
                                            {
                                                "example_id": "e7a6746d-9d03-4adf-8d27-e897cac2bfa1",
                                                "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                                                "text": "Les feuilles longues et minces, faites de paillettes cousues chacune avec un brin de cannetille, retombaient en une pluie d’étoiles."
                                            },
                                            {
                                                "example_id": "85e607ad-6c3e-4d0e-b1db-ac1f55a2c2a6",
                                                "sense_id": "9f5ec1ab-a24c-3b9b-885a-765db60502fc",
                                                "text": "Dans ses chenaux pleins de cannetille, l’Erdre laissait fluer un sirop pour têtards et se découvrir peu à peu le chevelu des souches ancrées de biais sur ses bords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a111feb-7bd3-3233-bbbf-890f1f5a5da1",
                                        "entry_id": "a17d0904-06dd-316d-84d7-b3aa87aebe09",
                                        "glosses": [
                                            "Fil de laiton argenté entouré en spirale sur un boyau pour former les grosses cordes de violons, violoncelles, contrebasses."
                                        ],
                                        "tags": [
                                            "Lutherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0666a09-6698-41a0-8cd4-899b27d11751",
                                                "sense_id": "7a111feb-7bd3-3233-bbbf-890f1f5a5da1",
                                                "text": "Cordes à canetille d'argent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c9c655d-2739-311b-a206-9f9ade116871",
                                        "entry_id": "a17d0904-06dd-316d-84d7-b3aa87aebe09",
                                        "glosses": [
                                            "Tissu de fil de laiton que les chapeliers utilisent pour mettre en forme les chapeaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ac69ea-b543-41fa-8617-d44f126d855a",
                                                "sense_id": "6c9c655d-2739-311b-a206-9f9ade116871",
                                                "text": "Même pour une Aielle, elle était très grande – peut-être plus que lui – et arborait une chevelure évoquant la cannetille et des yeux d’un bleu céruléen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cannetille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18fe9695-573c-3ff8-bbc5-1ba5746a16d3",
                                        "entry_id": "31e12a12-d532-3fd9-9a0a-7024a00acc90",
                                        "glosses": [
