                        "entry_id": "bfdbc01e-789b-3c4d-94a2-23a07d7f99ff",
                        "glosses": [
                            "A financial transaction whereby a business sells its accounts receivable to a third party (called a factor) at a discount."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eaad0740-d8c9-3df9-a38b-801f10066f6a",
                        "entry_id": "bfdbc01e-789b-3c4d-94a2-23a07d7f99ff",
                        "glosses": [
                            "The process of rewriting an expression as the product of its factor."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
