                    {
                        "sense_id": "551472df-42a8-3c4c-857e-7cef98ce0891",
                        "entry_id": "d972f65b-3e8c-310a-9fbc-5c886178fc4b",
                        "glosses": [
                            "Professionnel dont le travail a un impact sur la société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a479d0e2-9bd7-436f-a2da-2ea89a22aab4",
                                "sense_id": "551472df-42a8-3c4c-857e-7cef98ce0891",
                                "text": "Ce n’était pas un spécialiste de la chose, c’était plutôt un socioprofessionnel, un bâtisseur."
                            },
                            {
                                "example_id": "455c81f3-86b3-4e16-898b-16c452ce6f8c",
                                "sense_id": "551472df-42a8-3c4c-857e-7cef98ce0891",
                                "text": "Certains socioprofessionnels commencent à l’entendre."
                            },
                            {
                                "example_id": "8f9cd64b-4f9a-427d-9bc5-bd5b6ea22cb5",
                                "sense_id": "551472df-42a8-3c4c-857e-7cef98ce0891",
                                "text": "Les socioprofessionnels s’inquiètent. La crainte d’un affrontement entre grévistes et socioprofessionnels est réelle."
                            }
                        ]
                    }
