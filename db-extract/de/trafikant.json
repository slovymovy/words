                "senses": [
                    {
                        "sense_id": "41d3c1d9-6395-351c-9473-b67e0c692c49",
                        "entry_id": "85b4f73c-e7dd-3e0b-aea1-f61ea5a2df00",
                        "glosses": [
                            "Person, die eine Trafik betreibt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "9ad0a5e7-e3a6-46e2-8e79-f8657fc9096c",
                                "sense_id": "41d3c1d9-6395-351c-9473-b67e0c692c49",
                                "text": "„Im März 2014 trat ein österreichischer Trafikant in einen Steuerstreik und forderte u. a. einen Untersuchungsausschuss in der Causa Hypo Alpe Adria, eine Lohn- und Einkommensteuerreform und eine Verwaltungs- und Bildungsreform.“"
                            },
                            {
                                "example_id": "248e5cf4-34c6-47a7-b4b0-0a605731505a",
                                "sense_id": "41d3c1d9-6395-351c-9473-b67e0c692c49",
                                "text": "„Aus der Tatsache, dass 1962 die Trafikanten beschlossen, sonntags nicht mehr zu öffnen, musste eine Alternative gefunden werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cef5f0e-a72f-4f69-b02d-7f7efc626d19",
                        "source_entry_id": "85b4f73c-e7dd-3e0b-aea1-f61ea5a2df00",
                        "source_sense_id": "41d3c1d9-6395-351c-9473-b67e0c692c49",
                        "source_sense_description": "österreichisch: Person, die eine Trafik betreibt",
                        "target_lang_word": "trafficker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trafficker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69b15009-5296-39f1-94dd-cce7c575285a",
                                        "entry_id": "b021988e-10cc-3417-94f4-a280a14ea262",
                                        "glosses": [
                                            "Someone who traffics; a trader or merchant of illegal products, or of legal products in an illegal setting."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa3981b7-64c9-470f-96c9-8ef80c0fda78",
                                                "sense_id": "69b15009-5296-39f1-94dd-cce7c575285a",
                                                "text": "drug trafficker"
                                            },
                                            {
                                                "example_id": "72ab28fa-5c63-4b5f-853c-1ffced00f6e7",
                                                "sense_id": "69b15009-5296-39f1-94dd-cce7c575285a",
                                                "text": "human trafficker"
                                            },
                                            {
                                                "example_id": "311d163a-934d-4152-8150-8f9a148d8beb",
                                                "sense_id": "69b15009-5296-39f1-94dd-cce7c575285a",
                                                "text": "Trafficking Methods Traffickers may be members of organized crime networks or may be locals, friends, or even family members well known to the victim. […] In addition, traffickers may be involved in other criminal activities— for example, using the vehicles that transport victims and drugs out of a country to transport weapons or other items back in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fcd0128-8605-43b3-a7df-3eb414ad5464",
                        "source_entry_id": "85b4f73c-e7dd-3e0b-aea1-f61ea5a2df00",
                        "source_sense_id": "41d3c1d9-6395-351c-9473-b67e0c692c49",
                        "source_sense_description": "österreichisch: Person, die eine Trafik betreibt",
                        "target_lang_word": "trafiquant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trafiquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0df98dd-8da3-38b5-aa98-85063e06e914",
                                        "entry_id": "aa2fb450-e12a-3272-b91a-5c694ae3ae50",
                                        "glosses": [
                                            "Commerçant, négociant."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230cf9a9-655a-46a2-938f-6358a47aa900",
                                                "sense_id": "c0df98dd-8da3-38b5-aa98-85063e06e914",
                                                "text": "Perrot poursuit ses courses lointaines jusqu'en 1697, partageant son temps entre ses occupations de trafiquant, d'interprète, de diplomate et de pacificateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                        "entry_id": "aa2fb450-e12a-3272-b91a-5c694ae3ae50",
                                        "glosses": [
                                            "Truand spécialisé dans le commerce de produits interdits, contrefaits ou de contrebande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed5b1db-3f9d-4063-810b-a936253e467a",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Un édit alla jusqu’à prononcer la peine de mort contre les trafiquants […]"
                                            },
                                            {
                                                "example_id": "a2672611-8b5c-4d0f-8d25-a1a71e6f6fd0",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Un vague et déprimant malaise planait. Sous le porche des Réguliers, personne. Les trafiquants de drogue qui s’y postaient le soir s’étaient, prudemment, éclipsés."
                                            },
                                            {
                                                "example_id": "918f732f-01ea-4a18-bfbb-d652f69a000c",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Notre ancienne camée n'avait jamais été revendeuse et, notre trafiquant ignorait qu'elle ne se schnouffait plus."
                                            },
                                            {
                                                "example_id": "71ba54d1-f618-48be-a9dc-9ecaa6fb92b4",
                                                "sense_id": "537258ef-663a-39b2-94a7-1b43c7419de3",
                                                "text": "Claude Riendeau, lui, est un ex-flic devenu voleur à main armée, usurier, trafiquant de coke et « détaillant » d’armes, comme il aime dire pudiquement."
                                            }
                                        ]
                                    }
                                ]
                            },
