                    {
                        "translation_id": "9ff89857-ab9e-453f-9875-42e2123805f2",
                        "source_entry_id": "0ce7fe27-38bd-3393-8ba0-e57c6efca811",
                        "source_sense_id": "d831c5f9-f37f-301a-8cbf-efe50a325660",
                        "source_sense_description": "related by birth",
                        "target_lang_word": "konsanguin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konsanguin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a6c867e-a9f9-30ce-adca-fae6a5790b35",
                                        "entry_id": "0e50b740-a8c2-3de8-9fe7-37401d1a0d8f",
                                        "glosses": [
                                            "genetisch verwandt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dee127b9-74a4-443c-8392-235846984c39",
                                                "sense_id": "9a6c867e-a9f9-30ce-adca-fae6a5790b35",
                                                "text": "\"Die Konsanguinität zwischen zwei Personen wird in Graden angegeben. So sind Bruder und Schwester der gleichen leiblichen Eltern miteinander zweitgradig konsanguin.\""
                                            },
                                            {
                                                "example_id": "8b27468f-c85b-4623-832b-b43fae815481",
                                                "sense_id": "9a6c867e-a9f9-30ce-adca-fae6a5790b35",
                                                "text": "\"Aber selbst bei wissenschaftlich als ‚konsanguin‘ bezeichneten Beziehungen dritten Grades, die gesetzlich in Deutschland und der Türkei erlaubt sind, kann es zu gesundheitlichen Problemen kommen.\""
                                            },
                                            {
                                                "example_id": "ee9e847b-fe31-4e15-90f4-1ee0b4ce61bd",
                                                "sense_id": "9a6c867e-a9f9-30ce-adca-fae6a5790b35",
                                                "text": "\"Heute sind diese Bindungen in Europa aber eher die Ausnahme. Im vorderen wie hinteren Asien hingegen ist die konsanguine Ehe, also Verwandtenehe, immer noch verbreitet.\""
                                            },
                                            {
                                                "example_id": "4af8c75c-7a5e-4b3d-b263-cb5815bd2ca3",
                                                "sense_id": "9a6c867e-a9f9-30ce-adca-fae6a5790b35",
                                                "text": "„Bei seltenen autosomal-rezessiven Erkrankungen sind die Eltern betroffener Kinder häufig konsanguin., d. h. verwandt.“"
                                            },
                                            {
                                                "example_id": "af321c7f-6175-49b0-9ca5-f5102ca0d86d",
                                                "sense_id": "9a6c867e-a9f9-30ce-adca-fae6a5790b35",
                                                "text": "„Die Eltern waren ‚wahrscheinlich‘ konsanguin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e83b8f92-8dfa-41df-86a3-88f4c30f85c7",
