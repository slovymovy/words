                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡罗尔",
                                "target_lang_sense_clarification": "女性名"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Carol",
                                "target_lang_sense_clarification": "nombre propio"
                            }
                        ]
