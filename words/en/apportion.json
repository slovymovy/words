                    "sense_definition": "To divide and allocate shares or responsibilities fairly and proportionally among different people or groups.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee met to decide how to <w>apportion</w> resources among the regional hospitals."
                        },
                        {
                            "text": "Investigators worked diligently to <w>apportion</w> blame fairly between the two companies involved in the collision."
                        }
                    ],
                    "synonyms": [
                        "allocate",
                        "allot",
                        "share out"
                    ],
                    "common_phrases": [
