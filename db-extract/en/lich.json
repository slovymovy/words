                    },
                    {
                        "form_id": "e654b2af-3e75-4184-b913-72b541ef910d",
                        "entry_id": "fa238e47-da63-34f5-825e-7ae5f68b6ea9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most lich"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1daf7713-4fce-32dc-bab2-61a3aa2fede5",
                        "entry_id": "fa238e47-da63-34f5-825e-7ae5f68b6ea9",
                        "glosses": [
                            "相似的；相像的；相等的"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1933a4c9-4a45-4bf3-8bce-49ff2da61bf6",
                                "sense_id": "1daf7713-4fce-32dc-bab2-61a3aa2fede5",
                                "text": "很快他讓人製作了兩個箱子 / 外觀和工藝都一樣 / 如此相似，以至於無人 / 能將它們分辨開來。"
                            },
                            {
                                "example_id": "3c879d0d-bf76-4d46-8839-7216d8504233",
                                "sense_id": "1daf7713-4fce-32dc-bab2-61a3aa2fede5",
                                "text": "[He] rather joy'd to be than seemen sich, For both to be and seeme to him was labour lich.",
                                "translation": "（他）寧願真實存在也不願虛有其表，因為對他來說，兩者皆是相同的徒勞。"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1feba79d-b224-3567-ab72-61f7dd5e3d3a",
                "word": "lich",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a40b0647-c5c0-4fd8-a519-7ad0805c0a89",
                        "entry_id": "1feba79d-b224-3567-ab72-61f7dd5e3d3a",
                        "tags": [
