        "fr-extract.jsonl": [
            {
                "entry_id": "ee8d25b8-5827-31a7-9c99-e5de80d26270",
                "word": "étrangement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                        "entry_id": "ee8d25b8-5827-31a7-9c99-e5de80d26270",
                        "glosses": [
                            "D'une manière étrange ; bizarrement, étonnamment, de manière peu commune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f922f6-f230-486b-b715-2fed1c9550bf",
                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                "text": "Dix-sept îles, tufs et basaltes en amas pyramidaux ou étrangement déchiquetés, surgissent de la mer ; […]."
                            },
                            {
                                "example_id": "810ed90e-05ac-4013-9cd6-2769f947e1d0",
                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                "text": "Par contraste, le côté du lagon était étrangement calme, une eau merveilleusement tranquille, à peine ridée par les alizés, où passaient des poissons aux couleurs éblouissantes."
                            },
                            {
                                "example_id": "cf56dc80-e5ed-4f66-b9d7-71144ee10f49",
                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                "text": "Ces étudiantes national-socialistes cent pour cent affichent volontiers une allure soldatesque qui contraste, étrangement, avec leur pruderie réelle et touchante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e579eb33-f4af-4001-8444-651b25897650",
                        "source_entry_id": "ee8d25b8-5827-31a7-9c99-e5de80d26270",
                        "source_sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                        "target_lang_word": "strangely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strangely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                        "entry_id": "0f978319-00a9-320d-aaf9-509f31667b8b",
                                        "glosses": [
                                            "In a strange or coincidental manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddaeb662-b412-4c7f-af56-4ff1b74ecd21",
                                                "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                                "text": "Though I'd never gone to Boston before, everything looked strangely familiar."
                                            },
                                            {
                                                "example_id": "344ce64b-68dd-476a-9ab6-922f8d5c1fa1",
                                                "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                                "text": "Daniel was walking strangely because he had twisted his ankle."
                                            },
                                            {
                                                "example_id": "1dbfacf3-94a3-4b6a-bd5b-a1b8799c6eec",
                                                "sense_id": "367cb77a-0b7e-3841-8b34-e3d35055df32",
                                                "text": "A tale of gangland warfare and filial loyalty in the Glasgow of 1958, Small Faces is an enjoyable but strangely unmoving film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27550ba9-6d68-3331-a923-fd303354b7d3",
                                        "entry_id": "0f978319-00a9-320d-aaf9-509f31667b8b",
                                        "glosses": [
                                            "Surprisingly, wonderfully."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6b8b2b-2070-49c6-8d1f-75c4fe5842c7",
                                                "sense_id": "27550ba9-6d68-3331-a923-fd303354b7d3",
                                                "text": "[…]all thy vexations / Were but my trials of thy love, and thou / Hast strangely stood the test[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
