                                            {
                                                "example_id": "fe42e534-f53c-4797-9c32-1137c82a845c",
                                                "sense_id": "fc6e725a-1b26-311c-9ed6-16961827c167",
                                                "text": "One of the pricetags of the U.S. military buildup is a lack of health care in poorer communities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb106b6-6adf-3d3f-9a1b-61bca1e7330d",
