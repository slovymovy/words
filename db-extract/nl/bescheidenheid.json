        "nl-extract.jsonl": [
            {
                "entry_id": "ed418815-ea3c-343d-aa35-a7438b56e2cf",
                "word": "bescheidenheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ce07a85-5294-30b3-8359-b1805b00c83a",
                        "entry_id": "ed418815-ea3c-343d-aa35-a7438b56e2cf",
                        "glosses": [
                            "het de eigen verworvenheden kleiner voorstellen dan zij zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "755ab879-f739-444d-aa4c-15af74e58b82",
                                "sense_id": "1ce07a85-5294-30b3-8359-b1805b00c83a",
                                "text": "De man die generaties heeft laten schuddebuiken van het lachen is opgetrokken uit bijna banale bescheidenheid."
                            },
                            {
                                "example_id": "c8c83f4d-1158-4576-b64c-ee234a7041e8",
                                "sense_id": "1ce07a85-5294-30b3-8359-b1805b00c83a",
                                "text": "Inspiratiebron: Europese Commissievoorzitter Von der Leyen noemt de Argentijn een inspiratiebron. \"Hij inspireerde miljoenen mensen, ver buiten de katholieke kerk, met zijn bescheidenheid en pure liefde voor de minderbedeelden.\" Ook CDU-leider Merz, aankomend bondskanselier van Duitsland, zegt dat de paus herinnerd zal worden \"vanwege zijn onvermoeibare inzet voor de zwaksten in de samenleving, voor rechtvaardigheid en verzoening\"."
                            },
                            {
                                "example_id": "19b9a971-b6c2-404c-a13b-70e035c23525",
                                "sense_id": "1ce07a85-5294-30b3-8359-b1805b00c83a",
                                "text": "Maar, en dat heb je misschien niet geleerd, bescheidenheid is een hoog goed' Mijn hart roffelt, mijn slapen kloppen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d89fce4-9905-48d4-bd23-e6b87124d273",
                        "source_entry_id": "ed418815-ea3c-343d-aa35-a7438b56e2cf",
                        "source_sense_id": "1ce07a85-5294-30b3-8359-b1805b00c83a",
                        "target_lang_word": "skromność",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skromność",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "272548b9-9f74-3eb7-b1d4-277a3c4f6a8a",
                                        "entry_id": "ad5f0423-7ff6-3b6f-8efc-f73fcdebbfcb",
                                        "glosses": [
                                            "cecha kogoś, kto nie wywyższa się i nie dba o rozgłos i uznanie innych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c13cdba7-db36-499c-bfad-81c472a76020",
                                                "sense_id": "272548b9-9f74-3eb7-b1d4-277a3c4f6a8a",
                                                "text": "Cnota skromności polega przede wszystkim na wyrzeczeniu się pychy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "732b45b4-74ae-32a0-ac6f-c531469474de",
                                        "entry_id": "ad5f0423-7ff6-3b6f-8efc-f73fcdebbfcb",
                                        "glosses": [
                                            "cecha kogoś, kto jest powściągliwy lub wstydliwy w relacjach z osobami przeciwnej płci"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11c4dc32-9a5e-4e42-8f73-c0de32784185",
                                                "sense_id": "732b45b4-74ae-32a0-ac6f-c531469474de",
                                                "text": "Panienka na balu w swoim zachowaniu powinna zachować skromność i obyczajność."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "0beb995c-a5ae-32eb-941f-0ecf928ae45c",
                                        "entry_id": "ad5f0423-7ff6-3b6f-8efc-f73fcdebbfcb",
                                        "glosses": [
                                            "cecha czegoś, co jest proste i pozbawione ozdób"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f11a50dd-701d-47e4-8d19-1cfec2058c71",
                                                "sense_id": "0beb995c-a5ae-32eb-941f-0ecf928ae45c",
                                                "text": "Ubiory lub mundury dyktatorów cechuje albo przesadna skromność, albo nadmierna strojność."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "89dd9be5-bc04-3dc3-880d-087244271bc1",
                                        "entry_id": "ad5f0423-7ff6-3b6f-8efc-f73fcdebbfcb",
                                        "glosses": [
                                            "cecha czegoś, co nie jest zbyt efektowne ani głośne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfd8507-15e0-4387-8eea-b66459fa4fe7",
                                                "sense_id": "89dd9be5-bc04-3dc3-880d-087244271bc1",
                                                "text": "Uroczystość przebiegła ze skromnością i bez zbędnej celebry."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "d3119544-2e60-350a-8d34-ec951d6a6fe7",
                                        "entry_id": "ad5f0423-7ff6-3b6f-8efc-f73fcdebbfcb",
                                        "glosses": [
                                            "cecha czegoś, co ma małą wartość materialną"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34d1b5e-ac8b-447c-b356-6286a8b3ca78",
                                                "sense_id": "d3119544-2e60-350a-8d34-ec951d6a6fe7",
                                                "text": "Stowarzyszenie nie wynajęło reprezentacyjnej siedziby, bo na taką decyzję nie pozwoliła skromność budżetu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            }
                        ]
