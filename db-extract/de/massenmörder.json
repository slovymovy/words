                "senses": [
                    {
                        "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                        "entry_id": "290ae3ea-6348-3b04-9e5e-6b6f91e00bb1",
                        "glosses": [
                            "jemand, der den Tod einer großen Anzahl Menschen zu verantworten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8327fc-8a6f-4c5d-b5a8-72f3193deda9",
                                "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                                "text": "In Kanada trieb in den 90ern ein Massenmörder sein Unwesen."
                            },
                            {
                                "example_id": "8729e439-74cc-417c-b654-58e2015d82eb",
                                "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                                "text": "Man kann Jack the Ripper als den ersten Massenmörder in der zivilen Gesellschaft Englands betrachten."
                            },
                            {
                                "example_id": "beea411c-4bed-4cc3-8de6-a008d55a8aac",
                                "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                                "text": "Ob vor Ort oder als Schreibtischtäter, Massenmörder ist Massenmörder und gehört vor das Kriegsverbrechertribunal in Den Haag."
                            },
                            {
                                "example_id": "0170e5a2-d4d0-47e4-915f-1ba5826de35f",
                                "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                                "text": "„Der Attentäter und Massenmörder von Oslo und Utöya hatte neun Jahre Zeit, seinen Plan vorzubereiten.“"
                            },
                            {
                                "example_id": "38118714-4681-4951-bf8e-966a2cbcfd74",
                                "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                                "text": "„Unter Historikern ist der Generalleutnant, der 1904 in der deutschen Kolonie Südwestafrika den Aufstand der Herero niederschlug, nicht umstritten, sondern er gilt vielen als brutaler Massenmörder.“"
                            },
                            {
                                "example_id": "298cbdb8-f65e-4c7d-8d8f-965cc7901d9d",
                                "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                                "text": "„Keiner würde mich für einen Massenmörder halten.“"
                            },
                            {
                                "example_id": "d0e1e2b1-9cd4-43e8-bcdd-c01223a56224",
                                "sense_id": "295e0552-31b6-30d8-b7bb-2db34d55ff1e",
                                "text": "„Aber Churchill kämpfte gerade gegen den Massenmörder Hitler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
