                        "entry_id": "fbc9c012-c094-3593-96ac-4e38e255649b",
                        "glosses": [
                            "Roman, in dem der Held ein Abenteurer ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f9344c-72d3-433a-a63b-492f855d8581",
                                "sense_id": "a42dabd5-5617-3892-a715-ec7242883f59",
                                "text": "„Vor 40 Jahren schrieb ein junger Ostdeutscher einen Arbeiterund [sic!] Abenteurerroman, den die DDR-Oberen öffentlich verdammten.“"
                            },
                            {
                                "example_id": "f7958a7f-4da2-464b-afb3-c09cb7ad2bec",
                                "sense_id": "a42dabd5-5617-3892-a715-ec7242883f59",
                                "text": "„Aus Dutzenden Ländern kommen die 30.000 Werke, aus denen die Wände des Turms bestehen. […] Abenteurerromane, eine Biografie über Prinz Charles, japanische Kinderbücher, eine baskische Übersetzung des argentinischen Gaucho-Gedichtes \"Martín Fierro\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
