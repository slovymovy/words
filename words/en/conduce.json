{
    "word_family": [
        "conducive",
        "conduciveness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b679430a-a638-32c2-b1cf-b558806d33a0",
                    "sense_definition": "To contribute or lead to a particular outcome or result (usually followed by \"to\").",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "contribute_or_lead",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise and a balanced diet will <w>conduce</w> to long-term health.",
                            "target_lang_translations": {
                                "ru": "Регулярные физические упражнения и сбалансированное питание будут <w>способствовать</w> крепкому здоровью в долгосрочной перспективе."
                            }
                        },
                        {
                            "text": "The quiet atmosphere of the library may <w>conduce</w> to productive study.",
                            "target_lang_translations": {
                                "ru": "Тихая атмосфера библиотеки может <w>способствовать</w> продуктивной учебе."
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "subserve"
                    ],
                    "antonyms": [
                        "disconduce"
                    ],
                    "common_phrases": [
                        "conduce to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствовать достижению определенного исхода, результата или вести к нему (обычно с предлогом «to»)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способствовать",
                                "target_lang_sense_clarification": "содействовать достижению результата (чему-л.)"
                            },
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "вести к определенному результату или последствию (к чему-л.)"
                            },
                            {
                                "target_lang_word": "содействовать",
                                "target_lang_sense_clarification": "помогать осуществлению чего-либо"
                            },
                            {
                                "target_lang_word": "поспешествовать",
                                "target_lang_sense_clarification": "устар., содействовать или благоприятствовать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58dc5c9c-d2ff-3bf1-8e53-e3d46e929730",
                    "sense_definition": "To be advantageous or of benefit to someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "benefit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such prudent financial measures can only <w>conduce</w> the public good.",
                            "target_lang_translations": {
                                "ru": "Такие благоразумные финансовые меры могут лишь <w>пойти на пользу</w> общественному благу."
                            }
                        },
                        {
                            "text": "Fresh mountain air was thought to <w>conduce</w> the recovery of the sick.",
                            "target_lang_translations": {
                                "ru": "Считалось, что свежий горный воздух <w>способствует</w> выздоровлению больных."
                            }
                        }
                    ],
                    "synonyms": [
                        "profit"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare or obsolete in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть выгодным или идти на пользу кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти на пользу",
                                "target_lang_sense_clarification": "оказывать благоприятное действие"
                            },
                            {
                                "target_lang_word": "служить во благо",
                                "target_lang_sense_clarification": "приносить пользу"
                            },
                            {
                                "target_lang_word": "благоприятствовать",
                                "target_lang_sense_clarification": "создавать выгодные условия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f723e7a-aab3-3e52-8112-1225ec275ead",
                    "sense_definition": "To bring about or cause something to happen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat worked tirelessly, <w>conducing</w> an agreement between both warring factions.",
                            "target_lang_translations": {
                                "ru": "Дипломат неустанно трудился, <w>приближая</w> заключение соглашения между обеими враждующими сторонами."
                            }
                        },
                        {
                            "text": "Careful planning was essential for <w>conducing</w> the desired outcome.",
                            "target_lang_translations": {
                                "ru": "Тщательное планирование имело решающее значение для <w>достижения</w> желаемого результата."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in general modern use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать или влечь за собой какое-либо событие; приводить к возникновению чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "вызывать к жизни, приводить к возникновению"
                            },
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "быть причиной появления чего-либо"
                            },
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "служить причиной свершения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cefe5f36-3a54-364c-b667-69bc8ac03aef",
                    "sense_definition": "To guide, conduct, or lead someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lead",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guide attempted to <w>conduce</w> the travelers safely through the rocky mountain pass.",
                            "target_lang_translations": {
                                "ru": "Проводник попытался безопасно <w>провести</w> путешественников через скалистый горный перевал."
                            }
                        },
                        {
                            "text": "He sought to <w>conduce</w> the debate toward a peaceful resolution.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>направить</w> дебаты в сторону мирного разрешения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять, вести или сопровождать кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "указывать путь, сопровождать"
                            },
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "руководить движением или развитием"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "вести через какое-либо место"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}