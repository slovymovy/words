                "senses": [
                    {
                        "sense_id": "609c2a43-f5b1-30d9-9603-19aabb8a1594",
                        "entry_id": "991d60d6-8a9a-385e-9fee-aba51c83e221",
                        "glosses": [
                            "устар. жить вдовой, вдовцом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee84c66-9c5e-495d-af06-a61d07ed4c56",
                                "sense_id": "609c2a43-f5b1-30d9-9603-19aabb8a1594",
                                "text": "Пять лет купчиха вдовствовала, питая постоянно искреннее желание выйти замуж за молодого, красивого и здорового офицера."
                            },
                            {
                                "example_id": "3388e360-2d5a-4bb6-a7b5-c25ae78bab91",
                                "sense_id": "609c2a43-f5b1-30d9-9603-19aabb8a1594",
                                "text": "Сам посуди: старику был шестой десяток, пять лет вдовствовал, девки на возрасте, я тоже в подростках немалых — пошто было жениться?"
                            }
                        ]
                    }
