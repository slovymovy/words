                        "entry_id": "f25d1a18-4b73-3eb2-8dce-eaea66872f5d",
                        "glosses": [
                            "Organisation où les éléments de l'organisation sont classés de différentes manières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056c7909-7000-402c-9720-86a315e68eb3",
                                "sense_id": "a39218be-5aef-328b-a878-dce4d41cc67a",
                                "text": "Une hétérarchie qualifie ainsi une organisation qui favorise l'interrelation et la coopération entre les entités qui la composent plutôt qu'une structure hiérarchique descendante."
                            }
                        ]
                    }
                ],
