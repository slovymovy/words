{
    "word_family": [
        "lastly",
        "lasting",
        "everlasting",
        "outlast"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1fb28628-f0a9-30a6-b60d-04e183690c8c",
                    "sense_definition": "Most recent, latest, last so far.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>last</w> time I saw him, he was married.",
                            "target_lang_translations": {
                                "ru": "В <w>последний</w> раз, когда я его видел, он был женат."
                            }
                        },
                        {
                            "text": "She told him the <w>last</w> news about little Georgy.",
                            "target_lang_translations": {
                                "ru": "Она рассказала ему <w>последние</w> новости о маленьком Георгии."
                            }
                        }
                    ],
                    "synonyms": [
                        "latest",
                        "most recent"
                    ],
                    "common_phrases": [
                        "last time",
                        "last news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый недавний, последний на данный момент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после́дний",
                                "target_lang_sense_clarification": "самый недавний"
                            },
                            {
                                "target_lang_word": "неда́вний",
                                "target_lang_sense_clarification": "произошедший недавно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c8a0002-34b6-30ab-b447-6c591b779b38",
                    "sense_definition": "Final, ultimate, coming after all others of its kind.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eyes Wide Shut was the <w>last</w> film to be directed by Stanley Kubrick.",
                            "target_lang_translations": {
                                "ru": "«С широко закрытыми глазами» был <w>последним</w> фильмом Стэнли Кубрика."
                            }
                        },
                        {
                            "text": "The group stopped to say the <w>last</w> prayer before leaving.",
                            "target_lang_translations": {
                                "ru": "Группа остановилась, чтобы прочитать <w>последнюю</w> молитву перед уходом."
                            }
                        }
                    ],
                    "synonyms": [
                        "final",
                        "terminal",
                        "ultimate"
                    ],
                    "common_phrases": [
                        "last prayer",
                        "last film"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конечный, завершающий ряд или последовательность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после́дний",
                                "target_lang_sense_clarification": "конечный в ряду"
                            },
                            {
                                "target_lang_word": "заключи́тельный",
                                "target_lang_sense_clarification": "финальный"
                            },
                            {
                                "target_lang_word": "заверша́ющий",
                                "target_lang_sense_clarification": "ставящий точку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19e1eae8-3f31-3123-935f-792b728f9c2c",
                    "sense_definition": "Being the only one remaining of its class.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uniqueness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Japan is the <w>last</w> empire in the modern world.",
                            "target_lang_translations": {
                                "ru": "Япония — <w>последняя</w> империя в современном мире."
                            }
                        },
                        {
                            "text": "He felt like the <w>last</w> survivor of a forgotten era.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>последним</w> выжившим из забытой эпохи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last empire",
                        "last survivor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единственный оставшийся представитель своего рода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после́дний",
                                "target_lang_sense_clarification": "единственный оставшийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad363c67-330e-32e7-b69b-54831f07c5ed",
                    "sense_definition": "Farthest of all from a given quality, character, or condition; most unlikely, or least preferable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unlikelihood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is the <w>last</w> person to be accused of theft.",
                            "target_lang_translations": {
                                "ru": "Он <w>последний</w> человек, которого можно обвинить в краже."
                            }
                        },
                        {
                            "text": "More rain is the <w>last</w> thing we need right now.",
                            "target_lang_translations": {
                                "ru": "Еще один дождь — это <w>последнее</w>, что нам сейчас нужно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last person",
                        "last thing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наименее вероятный, подходящий или желательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после́дний",
                                "target_lang_sense_clarification": "наименее вероятный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6d57d56-24ce-3c76-9a7e-1484312e2143",
                    "sense_definition": "Lowest in rank or degree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hierarchy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three contestants will win awards, but the <w>last</w> prize is just a book voucher.",
                            "target_lang_translations": {
                                "ru": "Трое участников получат награды, но <w>последний</w> приз — всего лишь книжный ваучер."
                            }
                        },
                        {
                            "text": "The <w>last</w> rank had desks out in an open room.",
                            "target_lang_translations": {
                                "ru": "В <w>последнем</w> ряду столы стояли в открытом помещении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last prize",
                        "last rank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый низкий по рангу, степени или качеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после́дний",
                                "target_lang_sense_clarification": "низший по рангу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "829f19da-d22e-3f4d-a9ee-e1da33e43fcb",
                    "sense_definition": "Supreme; highest in degree; utmost.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were contending for principles of the <w>last</w> importance.",
                            "target_lang_translations": {
                                "ru": "Они боролись за принципы <w>первостепенной</w> важности."
                            }
                        },
                        {
                            "text": "The decision was made with the <w>last</w> degree of care.",
                            "target_lang_translations": {
                                "ru": "Решение было принято с <w>крайней</w> осторожностью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last importance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in formal or older literature to mean utmost"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высший, предельный; чрезвычайный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кра́йний",
                                "target_lang_sense_clarification": "предельный"
                            },
                            {
                                "target_lang_word": "вы́сший",
                                "target_lang_sense_clarification": "наивысший"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ecea59d-55ef-36bf-a54b-b6fe2dd9ee9a",
                    "sense_definition": "To endure, continue over time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Summer seems to <w>last</w> longer each year.",
                            "target_lang_translations": {
                                "ru": "Кажется, что лето с каждым годом <w>длится</w> всё дольше."
                            }
                        },
                        {
                            "text": "They seem happy now, but that won't <w>last</w> long.",
                            "target_lang_translations": {
                                "ru": "Сейчас они кажутся счастливыми, но это не <w>продлится</w> долго."
                            }
                        }
                    ],
                    "synonyms": [
                        "continue",
                        "endure",
                        "go on"
                    ],
                    "antonyms": [
                        "wear out",
                        "dissipate"
                    ],
                    "common_phrases": [
                        "last long",
                        "last forever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжаться в течение определенного времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дли́ться",
                                "target_lang_sense_clarification": "продолжаться во времени"
                            },
                            {
                                "target_lang_word": "продолжа́ться",
                                "target_lang_sense_clarification": "не прекращаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f9ef4d0-cee8-310c-b326-865e6ed2b01f",
                    "sense_definition": "To hold out, continue undefeated or entire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't know how much longer we can <w>last</w> without reinforcements.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, сколько еще мы сможем <w>продержаться</w> без подкрепления."
                            }
                        },
                        {
                            "text": "The supplies will <w>last</w> for another week if we are careful.",
                            "target_lang_translations": {
                                "ru": "Запасов <w>хватит</w> еще на неделю, если мы будем экономны."
                            }
                        }
                    ],
                    "synonyms": [
                        "survive"
                    ],
                    "antonyms": [
                        "fall apart"
                    ],
                    "common_phrases": [
                        "last without"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдерживать, оставаться в сохранности или не сдаваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продержа́ться",
                                "target_lang_sense_clarification": "выстоять некоторое время"
                            },
                            {
                                "target_lang_word": "хвати́ть",
                                "target_lang_sense_clarification": "быть достаточным (о запасах)"
                            },
                            {
                                "target_lang_word": "вы́держать",
                                "target_lang_sense_clarification": "не сломаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c25ea9a8-e404-3c32-933c-81b5e75f5986",
                    "sense_definition": "To shape with a last; to fasten or fit to a last; to place smoothly on a last.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shoemaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler began to <w>last</w> a boot using the wooden form.",
                            "target_lang_translations": {
                                "ru": "Сапожник начал <w>натягивать на колодку</w> ботинок, используя деревянную форму."
                            }
                        },
                        {
                            "text": "It takes skill to <w>last</w> the leather perfectly over the mold.",
                            "target_lang_translations": {
                                "ru": "Требуется мастерство, чтобы идеально <w>затянуть</w> кожу на форме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last a boot"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in shoemaking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Натягивать заготовку обуви на колодку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затя́гивать на коло́дку",
                                "target_lang_sense_clarification": "формовать обувь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "5a34a2c2-b37e-3ace-b92f-a867f9b2e206",
                    "sense_definition": "The (one) immediately before the present.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the beach <w>last</w> year.",
                            "target_lang_translations": {
                                "ru": "Мы ездили на пляж в <w>прошлом</w> году."
                            }
                        },
                        {
                            "text": "I was <w>last</w> to go; you're next.",
                            "target_lang_translations": {
                                "ru": "Я шел <w>последним</w>, ты следующий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last year",
                        "last week"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, который был непосредственно перед текущим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "про́шлый",
                                "target_lang_sense_clarification": "предшествующий настоящему"
                            },
                            {
                                "target_lang_word": "после́дний",
                                "target_lang_sense_clarification": "предыдущий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cb841c55-7e1c-326e-ac7e-699179c2d2ad",
                    "sense_definition": "Most recently.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When we <w>last</w> met, he was based in Toronto.",
                            "target_lang_translations": {
                                "ru": "Когда мы виделись в <w>последний</w> раз, он жил в Торонто."
                            }
                        },
                        {
                            "text": "I cannot remember when I <w>last</w> saw her.",
                            "target_lang_translations": {
                                "ru": "Я не помню, когда видел её в <w>последний</w> раз."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last met",
                        "last seen"
                    ],
                    "target_lang_definitions": {
                        "ru": "В последний раз, совсем недавно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в после́дний раз",
                                "target_lang_sense_clarification": "недавно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83109ca0-650d-3889-bd2e-350a61126cbb",
                    "sense_definition": "After everything else; finally.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As I arrived <w>last</w> of all, I'll go <w>last</w> to add the butter.",
                            "target_lang_translations": {
                                "ru": "Так как я пришел <w>последним</w>, я и масло буду добавлять в последнюю очередь."
                            }
                        },
                        {
                            "text": "He mentioned the most important point <w>last</w> but not least.",
                            "target_lang_translations": {
                                "ru": "Он упомянул самый важный момент <w>напоследок</w>, но это не значит, что он менее важен."
                            }
                        }
                    ],
                    "synonyms": [
                        "finally",
                        "lastly"
                    ],
                    "common_phrases": [
                        "last but not least",
                        "last of all"
                    ],
                    "target_lang_definitions": {
                        "ru": "В самом конце, после всего остального."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после́дним",
                                "target_lang_sense_clarification": "в конце очереди"
                            },
                            {
                                "target_lang_word": "в конце́",
                                "target_lang_sense_clarification": "после всего"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb3a214a-0409-32af-8d53-a22326c1139f",
                    "sense_definition": "A tool for shaping or preserving the shape of shoes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shoemaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are both made on a <w>last</w>, the wood or plastic foot-shaped form.",
                            "target_lang_translations": {
                                "ru": "Оба они сделаны на <w>колодке</w> — деревянной или пластиковой форме в виде стопы."
                            }
                        },
                        {
                            "text": "The shoemaker placed the leather over the <w>last</w> to stretch it.",
                            "target_lang_translations": {
                                "ru": "Сапожник надел кожу на <w>колодку</w>, чтобы растянуть её."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoe last"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянная или пластмассовая форма в виде человеческой стопы для изготовления обуви."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коло́дка",
                                "target_lang_sense_clarification": "сапожная форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4966318f-658f-32d4-838a-85fbb4b200b6",
                    "sense_definition": "A measure of weight or quantity, varying in designation depending on the goods concerned.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>last</w> of wool is twelve sacks.",
                            "target_lang_translations": {
                                "ru": "<w>Ласт</w> шерсти равен двенадцати мешкам."
                            }
                        },
                        {
                            "text": "They produced three or four <w>last</w> of tar in three months.",
                            "target_lang_translations": {
                                "ru": "За три месяца они произвели три или четыре <w>ласта</w> дегтя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last of wool"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical unit of measure"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная мера веса или объема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ласт",
                                "target_lang_sense_clarification": "мера веса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ff6ac2ea-1a9f-3794-ae1a-19d830fd7e75",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Peter <w>Last</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Питер <w>Ласт</w>."
                            }
                        },
                        {
                            "text": "We are meeting the <w>Lasts</w> for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы ужинаем с семьей <w>Ласт</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}