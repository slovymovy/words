                                        "entry_id": "ff132048-a895-3f67-9ed9-854a5f975d18",
                                        "glosses": [
                                            "Habitual kindness or mildness of temper or disposition; amiability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d53795b-4829-45af-b043-d3a066c654a6",
                                                "sense_id": "4999435a-7a50-3c0f-b345-3866e7774296",
                                                "text": "I am disposed to think that Mrs. Butler Cornbury did Mrs. Tappitt an injury when she with so much ready goodnature accepted the invitation for the party […]."
                                            },
                                            {
                                                "example_id": "ae551644-56b8-44be-a84c-f80b97f1b637",
                                                "sense_id": "4999435a-7a50-3c0f-b345-3866e7774296",
                                                "text": "the goodnature and generosity which belonged to his character"
                                            },
                                            {
                                                "example_id": "3a997e97-012a-4b68-8715-5ce7f85067d8",
                                                "sense_id": "4999435a-7a50-3c0f-b345-3866e7774296",
                                                "text": "The young count's good nature and easy persuadability were among his best characteristics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd0afc1c-f1f2-41e8-b467-6911e49756a3",
                        "source_entry_id": "7ac90ecd-9b2e-380c-9c2d-0a10a743c30b",
                        "source_sense_id": "beae0516-91c4-3ced-a39c-19adeb6111f3",
                        "source_sense_description": "het heel aardig zijn",
