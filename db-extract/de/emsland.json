                "senses": [
                    {
                        "sense_id": "2440a625-23f0-3348-914b-dd1b43f91185",
                        "entry_id": "7652c855-262e-3acf-bf43-c0a60fef0328",
                        "glosses": [
                            "Landschaft in Nordrhein-Westfalen und dem westlichen Niedersachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb34f2f-6e7f-4de6-b045-b3c5a0e82e3d",
                                "sense_id": "2440a625-23f0-3348-914b-dd1b43f91185",
                                "text": "„Seit Wochen schwelt ein Moorbrand im Emsland.“"
                            },
                            {
                                "example_id": "adbbfc58-c07a-4357-901f-560f108b9da7",
                                "sense_id": "2440a625-23f0-3348-914b-dd1b43f91185",
                                "text": "„Im Naturschutzgebiet Bockholter Dose im Emsland wurden Flächen in ihren ursprünglichen feuchten Zustand zurückversetzt.“"
                            },
                            {
                                "example_id": "2117a67b-0489-4cdb-ba76-38ae9a42b253",
                                "sense_id": "2440a625-23f0-3348-914b-dd1b43f91185",
                                "text": "„Allerdings nicht nur, weil die 40-Grad-Marke noch in weiter Ferne ist, sondern auch weil die bisherige Höchstmarke so aberwitzig hoch ist: 42,6 Grad wurden vergangenen Sommer in Lingen im Emsland gemessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ea20b0e-a24a-388c-8791-ad30873e7517",
                        "entry_id": "7652c855-262e-3acf-bf43-c0a60fef0328",
                        "glosses": [
                            "Landkreis in Niedersachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "116f1bcd-aaa3-4d6b-bbd9-62710a3f0aef",
                                "sense_id": "5ea20b0e-a24a-388c-8791-ad30873e7517",
                                "text": "Meppen ist der Verwaltungssitz des Emslandes."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
