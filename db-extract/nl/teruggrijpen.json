                    {
                        "translation_id": "3dbfc665-8d80-43bb-8ada-dd2553ab0a88",
                        "source_entry_id": "637de6eb-0a6a-3774-a543-18b0dc4da802",
                        "source_sense_id": "4cfabaa3-1d77-3cd2-a84d-409b8be99bdb",
