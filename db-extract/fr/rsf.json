                                    {
                                        "sense_id": "81d512c6-c5c5-3a5c-8256-2950c64a5e9e",
                                        "entry_id": "cd033f2d-84a0-33ca-aab5-93aa8d646456",
                                        "glosses": [
                                            "Initialism of Mars Sample Return mission."
                                        ],
                                        "tags": [
                                            "US",
