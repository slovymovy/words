                ],
                "senses": [
                    {
                        "sense_id": "d7dbe1c1-c012-34c7-a8fe-94af61c5a9b6",
                        "entry_id": "c40e6b58-19d9-3e84-8f86-e3dc107bd6bf",
                        "glosses": [
                            "kronkelige tak van een wijnstok waaraan de druiventrossen hangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c8cf0e-602c-4911-a354-f7d4de413e8d",
                                "sense_id": "d7dbe1c1-c012-34c7-a8fe-94af61c5a9b6",
                                "text": "De druiven zijn in uitstekende conditie vanwege de droogte van de afgelopen weken. Maar nu is het tijd ze in bevroren toestand van de wijnranken te plukken."
                            },
                            {
                                "example_id": "070b6129-409b-4286-8a5c-3d109fc993e7",
                                "sense_id": "d7dbe1c1-c012-34c7-a8fe-94af61c5a9b6",
                                "text": "Tijdens een rondleiding op dag twee van ons verblijf leren we dat deze miniversie van het New Yorkse Central Park, het eerste park ooit op een cruiseschip, is beplant met 10.587 planten, 48 wijnranken en 52 bomen, sommige tot wel zes meter hoog. Leuk om te weten: veel ervan zijn gekweekt in Nederlandse kassen."
                            },
                            {
                                "example_id": "1b416701-2801-4915-a51a-ecec90a1c88a",
                                "sense_id": "d7dbe1c1-c012-34c7-a8fe-94af61c5a9b6",
                                "text": "„Het meest bizarre is nog dat de mensen van de CCAA vanuit hun kantoor zo op de wijngaard uitkijken”, zegt een verbijsterde Ilse Visscher. „Ze hebben de wijnranken de afgelopen twee jaar zien groeien en bloeien, maar hebben nooit aan de bel getrokken dat dit niet door de beugel kon.”"
                            }
                        ]
                    }
