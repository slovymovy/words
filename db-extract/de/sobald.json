                                                "example_id": "84842c0b-984f-4224-b64c-d4352d558e6d",
                                                "sense_id": "dc33c676-cfe5-3bb5-90a2-4c6ddd8d8e62",
                                                "text": "Dès que le soleil fut levé."
                                            },
                                            {
                                                "example_id": "9356de00-8c88-49ab-bf3f-fa9e34e802e2",
                                                "sense_id": "dc33c676-cfe5-3bb5-90a2-4c6ddd8d8e62",
                                                "text": "Dès qu’il parut."
                                            },
