                "senses": [
                    {
                        "sense_id": "43a1eba9-42ab-360d-8d09-14c55d02537c",
                        "entry_id": "39197f8e-27e3-32f1-a4fb-2e6453c496c7",
                        "glosses": [
                            "unterstützender, dem verantwortlichen Cheftrainer nachgeordneter Trainer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8dc785b-1202-46c9-9ff2-1c17e9361c63",
                                "sense_id": "43a1eba9-42ab-360d-8d09-14c55d02537c",
                                "text": "„Der bisherige Chefcoach Christian Sossenheimer erkannte, dass er sich als Ko-Trainer wohler fühlt, und zog sich freiwillig auf seine angestammte Position zurück, die er zuvor schon acht Jahre ausfüllte.“"
                            },
                            {
                                "example_id": "db03dee9-6b4d-4e32-b858-c7ed00f83e5b",
                                "sense_id": "43a1eba9-42ab-360d-8d09-14c55d02537c",
                                "text": "„Sens, der im Bundesliga-Alltag als Ko-Trainer Koslowskis beim Schweriner SC wirkt, muss Einkäufe erledigen, besondere Wünsche erfüllen und vor allem die stapelweise anfallende Wäsche erledigen.“"
                            },
                            {
                                "example_id": "d0588c56-d791-4c50-a10e-5905b460a141",
                                "sense_id": "43a1eba9-42ab-360d-8d09-14c55d02537c",
                                "text": "„Der 67 Jahre alte gebürtige Bochumer arbeitete bis zum Ende der vergangenen Saison beim FC Bayern München als Ko-Trainer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
