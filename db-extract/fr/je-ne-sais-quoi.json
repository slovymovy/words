                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a3175b00-4a96-4ca6-ac08-ae8d91c37ac1",
                                "sense_id": "393b536c-0509-3676-8cc1-146c3b2df71c",
                                "text": "L’accent du chauffeur me plut, par la perfection musicale que ce mot de Camparoles prenait dans sa bouche, avec un je-ne-sais-quoi de mélancolie dans la richesse mélodique."
                            },
                            {
                                "example_id": "782aa76d-ddd3-49cc-80a9-54aea8944596",
                                "sense_id": "393b536c-0509-3676-8cc1-146c3b2df71c",
                                "text": "Ils ont su retrouver un je-ne-sais-quoi de calme, d’apaisé dont leur enfance leur a fait cadeau."
                            },
                            {
                                "example_id": "820d3ee6-00fc-4267-b90f-1e5ddbae54d7",
                                "sense_id": "393b536c-0509-3676-8cc1-146c3b2df71c",
                                "text": "Les serveurs ont déposé devant nous des bouteilles de saké et, dans une myriade de coupelles précieuses, toute une série de petits légumes qui ont l’air marinés dans un je-ne-sais-quoi qui doit être très bon."
                            },
                            {
                                "example_id": "89b57cd1-0f72-439d-8b84-a121d9251480",
                                "sense_id": "393b536c-0509-3676-8cc1-146c3b2df71c",
                                "text": "[…], elle plongea une première fois la main dans son sac et commença à filmer nos ébats avec son iPhone 6 ! Comme en transe, elle psalmodiait des je-ne-sais-quoi dans son sabir magyar, entrecoupés de petits halètements saccadés de chienne mettant bas sa portée."
                            }
                        ]
                    }
