                ],
                "senses": [
                    {
                        "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                        "entry_id": "6b47e0ca-d7de-36da-8154-6791fa4cdf0a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a866ef83-a3fb-40f2-a532-992d58eeff07",
                                "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                                "text": "Frau Hefele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d0ba715a-cb9e-4f8a-98b8-74fc71dbef7e",
                                "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                                "text": "Herr Hefele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d894ccbb-9395-4b38-8aad-1f93060d93a7",
                                "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                                "text": "Die Hefeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1f8800a9-f933-4511-9a28-cdd01920020b",
                                "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                                "text": "Der Hefele trägt nie die Schals, die die Hefele ihm strickt."
                            },
                            {
                                "example_id": "4b1cd62a-55d9-49d2-a469-f4feaf51ae4e",
                                "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hefele kommt, geht der Herr Hefele.“"
                            },
                            {
                                "example_id": "270e92f9-2f28-4f92-8604-d87cb916bd31",
                                "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                                "text": "Hefele kommt und geht."
                            },
                            {
                                "example_id": "14b81437-75c6-4ab5-ade6-2435904315a9",
                                "sense_id": "ae6240bb-805d-376c-b2f8-47c097b5dff6",
                                "text": "Hefeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
