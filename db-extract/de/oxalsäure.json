                                "sense_id": "be923627-760d-3239-8c61-d5fac18998f4",
                                "text": "Rhababer hat mit zunehmendem Alter mehr Oxalsäure."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
