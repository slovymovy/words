            {
                "entry_id": "66976ce3-7e56-3133-b4d5-0239045afafc",
                "word": "Melanesian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bf63f140-48ad-4b14-aad2-78de17962f34",
                        "entry_id": "66976ce3-7e56-3133-b4d5-0239045afafc",
                        "tags": [
                            "plural"
                        ],
                        "form": "Melanesians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1afb7cab-9f38-31ca-a1a9-b63816332cac",
                        "entry_id": "66976ce3-7e56-3133-b4d5-0239045afafc",
                        "glosses": [
                            "A Melanesian person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e60d4a5-574c-45d5-992e-96fe0fe88c9d",
                                "sense_id": "1afb7cab-9f38-31ca-a1a9-b63816332cac",
                                "text": "Blackbirding was the euphemism given to the slave-trading that occurred in the Pacific from the mid-1800s through to the early-1900s. According to one study, blackbirding, [as] “the practice of luring Melanesians and Polynesians to toil for next to nothing was called”, involved upwards of 60,000 people between 1863 and 1904 (Horne, 2007, p. 2)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfcc25df-bd2e-4e8f-98fb-a8d53b6f4f04",
                        "source_entry_id": "66976ce3-7e56-3133-b4d5-0239045afafc",
                        "source_sense_id": "1afb7cab-9f38-31ca-a1a9-b63816332cac",
                        "source_sense_description": "person living in or coming from Melanesia",
                        "target_lang_word": "Mélanésien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mélanésien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9e5149-e3dd-369d-8866-3380603b47df",
                                        "entry_id": "25636ccc-9343-3d58-8895-55d64b9ab3b3",
                                        "glosses": [
                                            "Habitant ou natif de la Mélanésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226566d9-c21d-4502-a480-cd2c020f569b",
                                                "sense_id": "bb9e5149-e3dd-369d-8866-3380603b47df",
                                                "text": "Enfin, seul un Mélanésien sur six et demi avait suivi des études secondaires ou supérieures contre un Européen sur deux."
                                            },
                                            {
                                                "example_id": "1fe9fa0c-a050-4ced-a090-1ab2de9e6abb",
                                                "sense_id": "bb9e5149-e3dd-369d-8866-3380603b47df",
                                                "text": "Le Mélanésien, en effet, est resté pendant des millénaires (la remarque vaut également pour d’autres peuples) fondu dans son groupe et le monde physique environnant, sans avoir une conscience claire de lui-même et de son autonomie, parce que lui faisait défaut une représentation nette du corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2e8b2bc-1771-4bd7-9c5f-571dadfbcfbe",
                        "source_entry_id": "66976ce3-7e56-3133-b4d5-0239045afafc",
                        "source_sense_id": "1afb7cab-9f38-31ca-a1a9-b63816332cac",
                        "source_sense_description": "person living in or coming from Melanesia",
                        "target_lang_word": "Mélanésienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mélanésienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88523448-e59e-3503-9010-fed9a1c3bd84",
                                        "entry_id": "59b7a84a-4e3b-3e2b-9664-a2b9b598aaa2",
                                        "glosses": [
                                            "Habitante ou originaire de la Mélanésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a30bbfd0-a472-4b97-9d41-12a70d5aef77",
                                                "sense_id": "88523448-e59e-3503-9010-fed9a1c3bd84",
                                                "text": "Je retrouvai chez les Mélanésiennes la même façon d’entourer les enfants, allaités à la demande, s'endormant dès qu'ils en avaient besoin dans les bras de leur mère."
                                            },
                                            {
                                                "example_id": "e50f76e5-95df-4f01-8c8d-56ca9338e68a",
                                                "sense_id": "88523448-e59e-3503-9010-fed9a1c3bd84",
                                                "text": "Quand on habite Hawaii, on s'habitue vite aux clichés exotiques : le décor de carte postale, les Mélanésiennes en colliers de fleurs, les surfeurs se maintenant en équilibre sur la crête des rouleaux qui défilent face à la plage de Waikiki."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12d500a7-9acd-4f8d-97e8-5fd86e209bb1",
                        "source_entry_id": "66976ce3-7e56-3133-b4d5-0239045afafc",
                        "source_sense_id": "1afb7cab-9f38-31ca-a1a9-b63816332cac",
                        "source_sense_description": "person living in or coming from Melanesia",
                        "target_lang_word": "Melanesier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Melanesier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2377301-4010-3b32-90a8-8b3a54d051c9",
                                        "entry_id": "2d8a3046-dc0c-3d14-b55d-7b8c539b53c4",
                                        "glosses": [
                                            "Bewohner Melanesiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "314d3c32-e234-4dca-8b5f-1c9c13f45173",
                                                "sense_id": "a2377301-4010-3b32-90a8-8b3a54d051c9",
                                                "text": "„Da die Einheimischen nicht zur Arbeit in den Plantagen bereit waren, holte man Melanesier und Chinesen ins Land.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
