                        "glosses": [
                            "Faire le galant auprès des femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02232829-9982-46d9-bfed-b4511caae416",
                                "sense_id": "a75e5f9a-ae7d-3273-beb3-9c362216fe22",
                                "text": "Innocent, çui-là, qui n'arrête pas de fricoter et ne pense qu'à godelurer ?"
                            },
                            {
                                "example_id": "d2765758-9b38-44e9-b69d-f970831357ff",
                                "sense_id": "a75e5f9a-ae7d-3273-beb3-9c362216fe22",
                                "text": "Ça ira godelurer on ne sait où, pour vous faire en rentrant un mensonge mal fait."
                            }
                        ]
                    }
