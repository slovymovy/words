                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le sommet de la montagne, nous pouvons <w>contempler</w> toute la vallée."
                        },
                        {
                            "text": "Elle s'arrête devant le tableau pour <w>contempler</w> les détails de la peinture."
