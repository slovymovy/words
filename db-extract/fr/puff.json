                        ]
                    },
                    {
                        "sense_id": "ba778f83-51c9-387a-ac5c-56006bf1c263",
                        "entry_id": "2132d236-36cc-306e-ba00-eb3c1c3cb8f3",
                        "glosses": [
                            "Cigarette électronique jetable."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "26e5b103-4444-428c-917b-2eb1fe42205d",
                                "sense_id": "ba778f83-51c9-387a-ac5c-56006bf1c263",
                                "text": "La puff, cette cigarette électronique jetable, est particulièrement prisée des adolescents, bien que sa vente aux mineurs soit interdite."
                            },
                            {
                                "example_id": "c169e436-b2ab-4a8a-a122-bad7546564e8",
                                "sense_id": "ba778f83-51c9-387a-ac5c-56006bf1c263",
                                "text": "La Commission européenne a annoncé mercredi 25 septembre qu'elle donne son feu vert à la France pour interdire les puffs, ces cigarettes électroniques jetables très en vogue chez les adolescents. Selon une étude d'Alliance contre le tabac publié en novembre 2023, 15% des ados ont déjà utilisé une puff et parmi eux, 47% ont commencé leur initiation à la nicotine à travers ce dispositif."
                            }
                        ]
                    }
                ],
