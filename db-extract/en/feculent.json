                                    {
                                        "sense_id": "7acf891a-e463-3ae7-b06e-569359ed6b6d",
                                        "entry_id": "2f333bf1-7d3e-3fb9-96c1-4fa79407a672",
                                        "glosses": [
                                            "von Kot bedeckt, voller Kot"
                                        ],
                                        "tags": [
                                            "Grundbedeutung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "418d7137-d30a-4011-b06c-a8076b7cfaf0",
                                                "sense_id": "7acf891a-e463-3ae7-b06e-569359ed6b6d",
                                                "text": "„Über schlechte, durch die Regengüsse aufgeweichte, oft kotige Wege ging's über Monterosi nach Civita Castellani, einem Ort, der fast rundum mit Felsen umgeben ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db17ec6b-25a6-32f4-b1f9-d02a9d0a74ba",
                                        "entry_id": "2f333bf1-7d3e-3fb9-96c1-4fa79407a672",
                                        "glosses": [
                                            "äußerst schmutzig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc0c5c0b-30ee-4358-980f-e1c694fb0655",
                                                "sense_id": "db17ec6b-25a6-32f4-b1f9-d02a9d0a74ba",
                                                "text": "„Ich lief zur Fensterfront, riß die Vorhänge zurück, doch anstelle einer Jalousie war dort eine dichte Stahlplatte heruntergelassen, die gegen Luft, Freiheit und Licht uns nun abriegelte, den kotigen Dämon und mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95c8c88e-8483-4436-9c66-27ad95bdd2d1",
                        "source_entry_id": "3e884db0-3201-3428-bb47-7a403331a8d0",
