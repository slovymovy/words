                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quarrelsome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb6162a-5576-3207-926c-6de96e55d9d0",
                                        "entry_id": "b6dfba6b-8170-3f73-9c99-2234367f6b88",
                                        "glosses": [
                                            "Argumentative; fond of or prone to quarreling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea16dbc7-66c3-4dac-8638-97bfb9ff4cbf",
                                                "sense_id": "9fb6162a-5576-3207-926c-6de96e55d9d0",
                                                "text": "She's too quarrelsome to participate in a civil conversation."
                                            },
                                            {
                                                "example_id": "7e2dcd5d-5b6c-4852-bc74-fc06f0eea1ce",
                                                "sense_id": "9fb6162a-5576-3207-926c-6de96e55d9d0",
                                                "text": "Rampion grown in the cottage garden made the children of the house quarrelsome; breathing deeply into a handful of mint refreshed your senses, but aconite could cause your death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
