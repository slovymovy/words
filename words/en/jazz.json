{
    "word_family": [
        "jazzy",
        "jazzman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3aa2a9e-f6fc-3caf-b413-a637c5d74acc",
                    "sense_definition": "A musical art form rooted in West African cultural and musical expression and in the African American blues tradition, commonly characterized by improvisation, syncopation, and a strong rhythm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "music_genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They hired a <w>jazz</w> band to play at the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Они наняли <w>джаз</w>-банд, чтобы он сыграл на свадебном приеме.",
                                "zh": "他们雇了一支<w>爵士乐</w>队在婚礼招待会上演奏。",
                                "es": "Contrataron una banda de <w>jazz</w> para tocar en la recepción de la boda."
                            }
                        },
                        {
                            "text": "He prefers listening to smooth <w>jazz</w> while he studies.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает слушать смус-<w>джаз</w>, пока учится.",
                                "zh": "他学习时更喜欢听柔和的<w>爵士乐</w>。",
                                "es": "Él prefiere escuchar <w>jazz</w> suave mientras estudia."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jazz band",
                        "smooth jazz",
                        "jazz music",
                        "jazz club"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный вид искусства, уходящий корнями в западноафриканскую культуру и афроамериканские блюзовые традиции, обычно характеризующийся импровизацией, синкопированием и сильным ритмом.",
                        "zh": "一种起源于西非文化和非裔美国人蓝调传统的音乐艺术形式，通常以即兴创作、切分音和强烈的节奏为特征。",
                        "es": "Género musical nacido a finales del siglo XIX en Estados Unidos en las comunidades afroamericanas, caracterizado por la improvisación, la síncopa y un ritmo marcado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джаз",
                                "target_lang_sense_clarification": "музыкальный стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爵士乐",
                                "target_lang_sense_clarification": "音乐风格"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "jazz",
                                "target_lang_sense_clarification": "género musical"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f8b7a06-a8df-354c-b16b-bd1f2c6ec01d",
                    "sense_definition": "The substance or makeup of a thing; unspecified related things.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stuff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to buy decorations, snacks, drinks, and all that <w>jazz</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить украшения, закуски, напитки и всякую такую <w>всячину</w>.",
                                "zh": "我们需要买装饰品、零食、饮料以及<w>之类的东西</w>。",
                                "es": "Necesitamos comprar decoraciones, bocadillos, bebidas y <w>todo eso</w>."
                            }
                        },
                        {
                            "text": "He started talking about regulations, taxes, and all that <w>jazz</w>.",
                            "target_lang_translations": {
                                "ru": "Он начал говорить о правилах, налогах и всём в таком <w>духе</w>.",
                                "zh": "他开始谈论规章制度、税收以及<w>诸如此类</w>的事情。",
                                "es": "Empezó a hablar de regulaciones, impuestos y <w>todo eso</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stuff",
                        "junk",
                        "paraphernalia"
                    ],
                    "common_phrases": [
                        "and all that jazz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mostly used in the phrase 'and all that jazz'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Суть или состав чего-либо; неуточненные сопутствующие вещи.",
                        "zh": "事物的本质或构成；未指明的相关事物。",
                        "es": "Cosas diversas, asuntos o elementos no especificados; se usa a menudo en la expresión 'y todo eso'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всячина",
                                "target_lang_sense_clarification": "разговорное, в выражении 'and all that jazz'"
                            },
                            {
                                "target_lang_word": "всё такое",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "之类的东西",
                                "target_lang_sense_clarification": "用于表示同类事物"
                            },
                            {
                                "target_lang_word": "等等",
                                "target_lang_sense_clarification": "用于列举"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "y todo eso",
                                "target_lang_sense_clarification": "expresión coloquial"
                            },
                            {
                                "target_lang_word": "y demás",
                                "target_lang_sense_clarification": "para indicar cosas similares"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed77970e-0bc9-37ed-8fa4-8bd5d82a4fe6",
                    "sense_definition": "Energy, excitement, or liveliness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party needs a little more <w>jazz</w> to get people dancing.",
                            "target_lang_translations": {
                                "ru": "Вечеринке нужно немного больше <w>драйва</w>, чтобы заставить людей танцевать.",
                                "zh": "派对需要多一点<w>活力</w>才能让大家跳起舞来。",
                                "es": "La fiesta necesita un poco más de <w>chispa</w> para que la gente baile."
                            }
                        },
                        {
                            "text": "Her performance was technically correct but lacked <w>jazz</w>.",
                            "target_lang_translations": {
                                "ru": "Ее выступление было технически правильным, но ему не хватало <w>огонька</w>.",
                                "zh": "她的表演技术上没问题，但缺乏<w>感染力</w>。",
                                "es": "Su actuación fue técnicamente correcta pero le faltaba <w>chispa</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pep",
                        "vigor",
                        "liveliness"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергия, волнение или живость.",
                        "zh": "活力、兴奋或生机。",
                        "es": "Energía, entusiasmo, vitalidad o chispa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драйв",
                                "target_lang_sense_clarification": "энергия, кураж"
                            },
                            {
                                "target_lang_word": "огонёк",
                                "target_lang_sense_clarification": "живость, задор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活力",
                                "target_lang_sense_clarification": "精力充沛"
                            },
                            {
                                "target_lang_word": "劲头",
                                "target_lang_sense_clarification": "热情或生机"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "chispa",
                                "target_lang_sense_clarification": "vitalidad o gracia"
                            },
                            {
                                "target_lang_word": "energía",
                                "target_lang_sense_clarification": "entusiasmo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4f99437-4cf8-3a69-89bc-e0c2d5461c2c",
                    "sense_definition": "Nonsense or foolish talk.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't pay attention to him, he is just talking <w>jazz</w>.",
                            "target_lang_translations": {
                                "ru": "Не обращай на него внимания, он просто несет <w>чушь</w>.",
                                "zh": "别理他，他只是在<w>胡扯</w>。",
                                "es": "No le prestes atención, solo está diciendo <w>tonterías</w>."
                            }
                        },
                        {
                            "text": "I am tired of listening to all this <w>jazz</w> about the new policy.",
                            "target_lang_translations": {
                                "ru": "Я устал слушать всю эту <w>чепуху</w> о новой политике.",
                                "zh": "我听腻了关于新政策的那些<w>废话</w>。",
                                "es": "Estoy cansado de escuchar todas estas <w>tonterías</w> sobre la nueva política."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsense",
                        "rubbish",
                        "rot",
                        "tripe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бессмыслица или глупые разговоры.",
                        "zh": "胡言乱语或愚蠢的谈话。",
                        "es": "Habladurías, tonterías o cosas sin sentido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "вздор"
                            },
                            {
                                "target_lang_word": "чепуха",
                                "target_lang_sense_clarification": "бессмыслица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废话",
                                "target_lang_sense_clarification": "无意义的话"
                            },
                            {
                                "target_lang_word": "胡扯",
                                "target_lang_sense_clarification": "荒谬的言论"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tonterías",
                                "target_lang_sense_clarification": "cosas sin sentido"
                            },
                            {
                                "target_lang_word": "patrañas",
                                "target_lang_sense_clarification": "mentiras o disparates"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c29d2331-6a53-362a-82f2-e6f3c2ad013b",
                    "sense_definition": "To enliven, brighten up, or make something more colorful or exciting.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "enliven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought some colorful cushions to <w>jazz</w> up the living room.",
                            "target_lang_translations": {
                                "ru": "Она купила несколько ярких подушек, чтобы <w>оживить</w> гостиную.",
                                "zh": "她买了一些色彩鲜艳的靠垫来<w>点缀</w>客厅。",
                                "es": "Compró unos cojines coloridos para <w>animar</w> la sala de estar."
                            }
                        },
                        {
                            "text": "The chef used fresh herbs to <w>jazz</w> up the simple pasta dish.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар использовал свежую зелень, чтобы <w>приукрасить</w> простое блюдо из пасты.",
                                "zh": "厨师用了新鲜香草来<w>提升</w>这道简单意面的风味。",
                                "es": "El chef usó hierbas frescas para <w>darle vida</w> al sencillo plato de pasta."
                            }
                        }
                    ],
                    "synonyms": [
                        "enliven",
                        "invigorate",
                        "brighten up"
                    ],
                    "common_phrases": [
                        "jazz up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оживить, сделать ярче или сделать что-то более красочным или захватывающим.",
                        "zh": "使活跃、使明亮，或使某物更丰富多彩、更令人兴奋。",
                        "es": "Hacer algo más animado, colorido, emocionante o atractivo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживить",
                                "target_lang_sense_clarification": "сделать интереснее"
                            },
                            {
                                "target_lang_word": "приукрасить",
                                "target_lang_sense_clarification": "добавить яркости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增添情趣",
                                "target_lang_sense_clarification": "使更有吸引力"
                            },
                            {
                                "target_lang_word": "使生动",
                                "target_lang_sense_clarification": "增加活力"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "animar",
                                "target_lang_sense_clarification": "hacer más interesante"
                            },
                            {
                                "target_lang_word": "dar vida",
                                "target_lang_sense_clarification": "hacer más atractivo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92574aaf-810a-3e09-8836-193bf222c2a4",
                    "sense_definition": "To play jazz music.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "play_music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band <w>jazzed</w> together in the basement for hours.",
                            "target_lang_translations": {
                                "ru": "Группа часами <w>играла джаз</w> вместе в подвале.",
                                "zh": "乐队在地下室里一起<w>演奏爵士乐</w>了好几个小时。",
                                "es": "La banda <w>tocó jazz</w> junta en el sótano durante horas."
                            }
                        },
                        {
                            "text": "He loves to <w>jazz</w> on his saxophone whenever he gets the chance.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>играть джаз</w> на своем саксофоне при любой возможности.",
                                "zh": "他一有机会就喜欢用萨克斯<w>演奏爵士乐</w>。",
                                "es": "Le encanta <w>tocar jazz</w> en su saxofón siempre que tiene la oportunidad."
                            }
                        }
                    ],
                    "synonyms": [
                        "jam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть джазовую музыку.",
                        "zh": "演奏爵士乐。",
                        "es": "Tocar o interpretar música de jazz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть джаз",
                                "target_lang_sense_clarification": "исполнять музыку"
                            },
                            {
                                "target_lang_word": "джемовать",
                                "target_lang_sense_clarification": "импровизировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演奏爵士乐",
                                "target_lang_sense_clarification": "表演音乐"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tocar jazz",
                                "target_lang_sense_clarification": "interpretar el género"
                            },
                            {
                                "target_lang_word": "improvisar",
                                "target_lang_sense_clarification": "en el contexto de una jam session"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1598e8f4-4223-36a2-a1be-788574649ccc",
                    "sense_definition": "A diminutive of the female given name <w>Jasmine</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name_jasmine",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her name is Jasmine, but everyone calls her <w>Jazz</w>.",
                            "target_lang_translations": {
                                "ru": "Ее зовут Жасмин, но все называют ее <w>Джаз</w>.",
                                "zh": "她叫贾斯敏，但大家都叫她<w>爵士</w>。",
                                "es": "Su nombre es Jasmine, pero todos la llaman <w>Jazz</w>."
                            }
                        },
                        {
                            "text": "I am going to the movies with <w>Jazz</w> later tonight.",
                            "target_lang_translations": {
                                "ru": "Я иду в кино с <w>Джаз</w> сегодня вечером.",
                                "zh": "今晚晚些时候我要和<w>爵士</w>去看电影。",
                                "es": "Voy al cine con <w>Jazz</w> más tarde esta noche."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма женского имени Жасмин.",
                        "zh": "女性名字 Jasmine 的昵称。",
                        "es": "Forma diminutiva del nombre propio femenino Jasmine."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джаз",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爵士",
                                "target_lang_sense_clarification": "人名昵称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Jazz",
                                "target_lang_sense_clarification": "nombre propio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53ef204e-3cc3-37cd-ac22-64244939c562",
                    "sense_definition": "A diminutive of the male given name <w>Jasper</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name_jasper",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Jazz</w> is coming over to help us move the furniture.",
                            "target_lang_translations": {
                                "ru": "<w>Джаз</w> придет, чтобы помочь нам передвинуть мебель.",
                                "zh": "<w>爵士</w>要过来帮我们搬家具。",
                                "es": "<w>Jazz</w> vendrá a ayudarnos a mover los muebles."
                            }
                        },
                        {
                            "text": "We nicknamed him <w>Jazz</w> because Jasper sounded too formal.",
                            "target_lang_translations": {
                                "ru": "Мы прозвали его <w>Джаз</w>, потому что Джаспер звучало слишком официально.",
                                "zh": "我们给他起了个绰号叫<w>贾兹</w>，因为贾斯珀听起来太正式了。",
                                "es": "Le pusimos el apodo de <w>Jazz</w> porque Jasper sonaba demasiado formal."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма мужского имени Джаспер.",
                        "zh": "男性名字 Jasper 的昵称。",
                        "es": "Forma diminutiva del nombre propio masculino Jasper."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джаз",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贾兹",
                                "target_lang_sense_clarification": "男名 Jasper 的昵称音译"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Jazz",
                                "target_lang_sense_clarification": "nombre propio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}