                    }
                ],
                "senses": [
                    {
                        "sense_id": "3890e312-f507-3fe9-a692-5e130fc36a52",
                        "entry_id": "050d8613-649a-3f1f-a1f9-c3d94138b5ef",
                        "glosses": [
                            "The principal ore of aluminium; a clay-like mineral, being a mixture of hydrated oxides and hydroxides."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b92b8a65-813d-41b8-96d9-83cd8497bd0f",
                                "sense_id": "3890e312-f507-3fe9-a692-5e130fc36a52",
                                "text": "A thin red stream poured down one of the rises, snaking its way around trees; a river turned red with bauxite?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6a7cd95-3c93-42e6-acec-452a2893dc2e",
                        "source_entry_id": "050d8613-649a-3f1f-a1f9-c3d94138b5ef",
                        "source_sense_id": "3890e312-f507-3fe9-a692-5e130fc36a52",
                        "source_sense_description": "ore",
