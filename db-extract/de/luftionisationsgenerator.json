                "senses": [
                    {
                        "sense_id": "b249d8dd-e5d1-30e6-9837-abfd4a3c0146",
                        "entry_id": "e6672525-7937-34c9-95e1-17ade7e4490f",
                        "glosses": [
                            "Gerät zur Ionisation der Luft (Erzeugung von positiven und negativen Sauerstoffionen), mittels einer Ionisationsröhre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb8afab-6034-4914-a82c-dcac26ba8569",
                                "sense_id": "b249d8dd-e5d1-30e6-9837-abfd4a3c0146",
                                "text": "„Ein Luftionisationsgenerator […] weist eine Isolatorröhre […] auf, in deren Innenraum sich eine hülsenförmige Innenelektrode […] innenwandnah erstreckt, […].“"
                            },
                            {
                                "example_id": "2371a23c-6610-49be-ad59-adec44f8da9d",
                                "sense_id": "b249d8dd-e5d1-30e6-9837-abfd4a3c0146",
                                "text": "„Die Ionisation von Luftsauerstoff bewirkt die Reinigung und Entkeimung der Luft. Zur Entkeimung werden z.B. Luftionisationsgeneratoren gemäß der CH 666 372 A5 eingesetzt.“"
                            },
                            {
                                "example_id": "80d8cd33-ef53-44b9-af69-598afeca7dce",
                                "sense_id": "b249d8dd-e5d1-30e6-9837-abfd4a3c0146",
                                "text": "„Der in [2] offenbarte Luftionisationsgenerator weist eine Ionisationsröhre auf, in deren Innenraum sich eine hülsenförmige Innenelektrode innenwandnah erstreckt, während eine hülsenförmige Aussenelektrode auf der Aussenfläche der Ionisationsröhre aufgeschoben und gegenüber der Innenelektrode verschiebbar ist.“"
                            },
                            {
                                "example_id": "d5344639-9086-4065-b62b-b754a84b961b",
                                "sense_id": "b249d8dd-e5d1-30e6-9837-abfd4a3c0146",
                                "text": "„Luftionisationsgeneratoren reichern die Raumluft mit Negativ Ionen an (durch Koronalentladungen an Hochspannungsnadeln – ähnlich wie bei einem Gewitter).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
