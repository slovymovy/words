                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc38262c-80f2-4ccb-9d97-9d8aa83cad16",
                                "sense_id": "2bb79674-b1c9-3087-9615-d1689f8c0640",
                                "text": "„Schon nach einer schnellen Runde kam es zum sogenannten \"Graining\".“"
                            },
                            {
                                "example_id": "d0c99523-a02e-4206-a2f5-63775f55e81a",
                                "sense_id": "2bb79674-b1c9-3087-9615-d1689f8c0640",
                                "text": "„Im Freien Training klagten die Fahrer mehrfach per Funk über Graining - mal auf der Hinter-, mal auf der Vorderachse.“"
                            },
                            {
                                "example_id": "89e8f91a-5c84-4a13-ac19-7ff3158a46cb",
                                "sense_id": "2bb79674-b1c9-3087-9615-d1689f8c0640",
                                "text": "„Ganz zufrieden ist Button demnach nicht, denn die Reifen überhitzten rasch und es trat Graining auf.“"
                            },
                            {
                                "example_id": "77c25ee2-1d11-4adc-87b9-22974bf94fec",
                                "sense_id": "2bb79674-b1c9-3087-9615-d1689f8c0640",
                                "text": "„Die ersten drei Rennen der Saison 2014 waren eventuell nur die Ruhe vor dem Sturm, denn in China berichten die Fahrer erstmals in dieser Saison reihenweise von massivem Graining an den Vorderreifen.“"
                            }
                        ],
