                    {
                        "sense_id": "9c739299-534d-3f20-8133-b8c75467cde4",
                        "entry_id": "419f2bf1-ddbf-37f4-ae11-48adaaf880f2",
                        "glosses": [
                            "Having jaws that project forward more than is usual, or being such a jaw."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3101406e-5afd-4a36-8554-c4e791ecda68",
                                "sense_id": "9c739299-534d-3f20-8133-b8c75467cde4",
                                "text": "A huge brute with thick lips and prognathous jaw stood at her shoulder. He was talking loudly and gesticulating wildly."
                            },
                            {
                                "example_id": "499105ec-0686-4314-aa39-d8e9348ed99a",
                                "sense_id": "9c739299-534d-3f20-8133-b8c75467cde4",
                                "text": "Phycosecids are small, ovate, convex beetles with a prognathous head, partly covered by a semicircular projection of the pronotum and a dorsal vestiture of whitish scales or scalelike setae."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a8282c5-96ef-42b5-8515-74b34dd89a8e",
                        "source_entry_id": "419f2bf1-ddbf-37f4-ae11-48adaaf880f2",
                        "source_sense_id": "9c739299-534d-3f20-8133-b8c75467cde4",
                        "source_sense_description": "with jaws projecting forward",
                        "target_lang_word": "prognathe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prognathe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "167e8cb7-501f-311e-b141-cecf25e8302c",
                                        "entry_id": "cd540824-e907-3ed4-b3b7-a5651130d0c1",
                                        "glosses": [
                                            "Qualifie une personne dont les mâchoires sont proéminentes ou dont la mâchoire inférieure fait saillie par rapport à la mâchoire supérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16013ae2-fed0-4020-a27c-2c9690251bd8",
                                                "sense_id": "167e8cb7-501f-311e-b141-cecf25e8302c",
                                                "text": "Je me demande ce qu’est devenu ce charmant jeune homme légèrement prognathe qui nous apprenait à jouer aux cartes."
                                            },
                                            {
                                                "example_id": "580de6a1-91ed-4627-8d6c-672cfb16aea8",
                                                "sense_id": "167e8cb7-501f-311e-b141-cecf25e8302c",
                                                "text": "Certes, ils sont assez reconnaissables, à leur taille plus petite, à leur visage plus prognathe et à leurs yeux très fleur de tête."
                                            },
                                            {
                                                "example_id": "6e4077d8-26b7-4279-8dea-81c3ad304127",
                                                "sense_id": "167e8cb7-501f-311e-b141-cecf25e8302c",
                                                "text": "Alors apparut une mine patibulaire, au menton prognathe, au nez écrasé, ainsi que de gros yeux blancs roulant hideusement dans leurs orbites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b647535-b23d-3c53-b9ae-f0668c2f99c4",
                                        "entry_id": "cd540824-e907-3ed4-b3b7-a5651130d0c1",
                                        "glosses": [
                                            "Qualifie un animal dont les mâchoires se déportent plus ou moins fortement vers l’avant."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b6ef8e-0f83-4ca9-9f82-d5a97a90f317",
                                                "sense_id": "4b647535-b23d-3c53-b9ae-f0668c2f99c4",
                                                "text": "Le dogue de Bordeaux doit être prognathe inférieur (dont la mâchoire inférieure dépasse l’autre)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65d5961f-c5e7-32ad-9455-3368e23452af",
                                        "entry_id": "cd540824-e907-3ed4-b3b7-a5651130d0c1",
                                        "glosses": [
                                            "Qualifie un insecte dont les parties buccales sont situées en avant de la tête ou du céphalothorax."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
