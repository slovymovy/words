                "senses": [
                    {
                        "sense_id": "b082fc1c-3c6a-3c21-a703-e3b80131cb66",
                        "entry_id": "cf80c432-9034-3c74-aeee-d7e9d6ba900d",
                        "glosses": [
                            "mannelijke eigenaar van een kasteel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b38f796f-0e49-4bec-a30b-1f71e3a4bc00",
                                "sense_id": "b082fc1c-3c6a-3c21-a703-e3b80131cb66",
                                "text": "De Belgische kasteelheer Stijn Saelens is omgebracht in opdracht van zijn schoonvader. Dat bekende deze André G. vanavond in de rechtbank in Brugge."
                            },
                            {
                                "example_id": "c5e6dda0-edee-4437-ae25-b3eb006b6178",
                                "sense_id": "b082fc1c-3c6a-3c21-a703-e3b80131cb66",
                                "text": "Ook is het belangrijk om donoren inspraak te geven in het kasteel, denkt Delaume. \"Iedere gulle gever mag zich kasteelheer van l'Ebaupinay noemen, een chatelain, dat vinden mensen een leuk idee. Ze voelen zich er thuis.\""
                            }
                        ]
                    }
