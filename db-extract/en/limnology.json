                "entry_id": "3a1f4852-5021-3094-a082-725bd3d776ce",
                "word": "limnology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a435c523-082d-4735-989f-64694cbfdb00",
                        "entry_id": "3a1f4852-5021-3094-a082-725bd3d776ce",
