                    "sense_id": "1f034b68-9859-3074-a324-1bb72921ba2d",
                    "sense_definition": "Personne unie à une autre par les liens du mariage ; épouse.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est parti en vacances avec sa <w>femme</w> et leurs enfants.",
                            "target_lang_translations": {
                                "en": "He went on holiday with his <w>wife</w> and their children.",
                                "ru": "Он уехал в отпуск с <w>женой</w> и детьми.",
                                "nl": "Hij is met zijn <w>vrouw</w> en hun kinderen op vakantie gegaan.",
                                "de": "Er ist mit seiner <w>Frau</w> und den Kindern in den Urlaub gefahren.",
                                "pl": "Wyjechał na wakacje z <w>żoną</w> i dziećmi.",
                                "it": "È partito in vacanza con sua <w>moglie</w> e i loro figli.",
                                "cs": "Odjel na dovolenou se svou <w>manželkou</w> a dětmi.",
                                "tr": "<w>Karısıyla</w> ve çocuklarıyla tatile gitti.",
                                "es": "Se fue de vacaciones con su <w>esposa</w> y sus hijos.",
                                "zh": "他和他的<w>妻子</w>以及孩子们一起去度假了。"
                            }
                        },
                        {
                            "text": "Le prêtre les a déclarés mari et <w>femme</w> devant toute la famille.",
                            "target_lang_translations": {
                                "en": "The priest pronounced them husband and <w>wife</w> in front of the whole family.",
                                "ru": "Священник объявил их мужем и <w>женой</w> перед всей семьёй.",
                                "nl": "De priester verklaarde hen in het bijzijn van de hele familie tot man en <w>vrouw</w>.",
                                "de": "Der Priester erklärte die beiden vor der ganzen Familie zu Mann und <w>Frau</w>.",
                                "pl": "Ksiądz ogłosił ich mężem i <w>żoną</w> przed całą rodziną.",
                                "it": "Il sacerdote li ha dichiarati marito e <w>moglie</w> davanti a tutta la famiglia.",
                                "cs": "Kněz je před celou rodinou prohlásil za muže a <w>ženu</w>.",
                                "tr": "Rahip, ailenin hepsinin önünde onları <w>karı</w> koca ilan etti.",
                                "es": "El sacerdote los declaró marido y <w>mujer</w> delante de toda la familia.",
                                "zh": "神父当着全家人的面宣布他们结为夫妻。"
                            }
                        }
