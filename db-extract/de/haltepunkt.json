                "senses": [
                    {
                        "sense_id": "91ef8e92-7dcd-348e-9823-13d090cc3f85",
                        "entry_id": "4eb5d16c-f221-3358-994c-c1ed4d13d494",
                        "glosses": [
                            "Ort an einer Bahnanlage, an dem Fahrgäste in die Züge ein- und aussteigen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e18ead47-6935-4c1d-8a47-c27f7a74ee0b",
                                "sense_id": "91ef8e92-7dcd-348e-9823-13d090cc3f85",
                                "text": "„Haltepunkte sind Bahnanlagen ohne Weichen, wo Züge planmäßig halten, beginnen oder enden dürfen.“ (§ 4 Abs. 8 der Eisenbahn-Bau- und Betriebsordnung)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba34c4c2-38f2-4955-b644-8d7b13bb200f",
                        "source_entry_id": "4eb5d16c-f221-3358-994c-c1ed4d13d494",
                        "source_sense_id": "91ef8e92-7dcd-348e-9823-13d090cc3f85",
                        "source_sense_description": "Ort an einer Bahnanlage, an dem Fahrgäste in die Züge ein- und aussteigen können",
                        "target_lang_word": "halt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f47842-b351-31a9-b8e2-92abdbd5e52e",
                                        "entry_id": "e3134316-8061-3239-915e-f32310a95680",
                                        "glosses": [
                                            "To limp; move with a limping gait."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fab053a-8cd9-4cbf-9bcc-9f26890f09ef",
                                                "sense_id": "b7f47842-b351-31a9-b8e2-92abdbd5e52e",
                                                "text": "Here comes Sir Toby halting — you shall hear more; but if he had not been in drink, he would have tickled you othergates than he did."
                                            },
                                            {
                                                "example_id": "bd24fa07-796f-4bdd-b8a8-5653b4782242",
                                                "sense_id": "b7f47842-b351-31a9-b8e2-92abdbd5e52e",
                                                "text": "Do not smile at me that I boast her of,\nFor thou shalt find she will outstrip all praise,\nAnd make it halt behind her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e778cac-2816-328b-bfbc-7fb44b18365e",
                                        "entry_id": "e3134316-8061-3239-915e-f32310a95680",
                                        "glosses": [
                                            "To stand in doubt whether to proceed, or what to do; hesitate; be uncertain; linger; delay; mammer."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "384ba762-541c-4696-905b-3a1584e84e1b",
                                                "sense_id": "6e778cac-2816-328b-bfbc-7fb44b18365e",
                                                "text": "How long halt ye between two opinions?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1428a489-4daa-3e0f-9550-fdca01ab83cd",
                                        "entry_id": "e3134316-8061-3239-915e-f32310a95680",
                                        "glosses": [
