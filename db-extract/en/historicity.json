    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9cf1672d-9d02-3cd0-8fa2-f09a36e17f30",
                "word": "historicity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b56a2f0d-1def-44c5-b77c-882b050c1bbe",
                        "entry_id": "9cf1672d-9d02-3cd0-8fa2-f09a36e17f30",
                        "tags": [
                            "plural"
                        ],
                        "form": "historicities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac12ab0d-3bcd-3be5-ac18-b7ce7d11449a",
                        "entry_id": "9cf1672d-9d02-3cd0-8fa2-f09a36e17f30",
                        "glosses": [
                            "Historical quality or authenticity based on fact."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "166236fc-db78-42c1-a4a1-8b6433c1cfb7",
                                "sense_id": "ac12ab0d-3bcd-3be5-ac18-b7ce7d11449a",
                                "text": "The historicity of minor political figures of this period is often hard to establish due to a dearth of sources."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f0a955d-95a4-3579-b7af-7ca249221e39",
                        "entry_id": "9cf1672d-9d02-3cd0-8fa2-f09a36e17f30",
                        "glosses": [
                            "The characteristic of having appeared or developed in history, as opposed to being natural or universal."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e1a11a75-e5e1-430b-bf17-a2c85e6863e2",
                                "sense_id": "7f0a955d-95a4-3579-b7af-7ca249221e39",
                                "text": "This particular school places great emphasis on the historicity of ideas, practices, or institutions."
                            },
                            {
                                "example_id": "e8830147-a39b-4659-85e4-9a2ab8e2e63a",
                                "sense_id": "7f0a955d-95a4-3579-b7af-7ca249221e39",
                                "text": "A superficial impression of Asia may be of disorder, whereas this condition is in fact the immediate historicity that speaks for an undertheorised heteroglossia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "958a5169-268b-47f6-abaf-367f63cc2c0f",
                        "source_entry_id": "9cf1672d-9d02-3cd0-8fa2-f09a36e17f30",
                        "source_sense_description": "historical quality",
                        "target_lang_word": "historiciteit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historiciteit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7f644145-0971-30db-8b63-7e5b81c53d4b",
                                        "entry_id": "4ca978eb-b929-323b-a49d-f0054f7307d6",
                                        "glosses": [
                                            "historische echtheid, het historisch (waargebeurd) zijn (van verhalen) of echt bestaan hebben (van personen/voorwerpen/instituties)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f4aefd-9e08-4b25-97b7-9bb0652ac229",
                                                "sense_id": "7f644145-0971-30db-8b63-7e5b81c53d4b",
                                                "text": "Hij gold als uitgesproken vrijzinnig, een dominee die niet geloofde in de historiciteit van de Bijbelse verhalen, maar ze begrijpelijk wilde maken voor de moderne lezer door hun diepere betekenis uit te leggen. Het is wel waar, maar het is niet echt gebeurd. Dat is kort samengevat hoe Nico ter Linden naar de Bijbelse verhalen keek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f44334c-0875-3938-9fcc-e4730d64bd6e",
                                        "entry_id": "4ca978eb-b929-323b-a49d-f0054f7307d6",
                                        "glosses": [
                                            "historische betrouwbaarheid (van verhalen), de mate waarin gegevens in een verhaal waarschijnlijk historisch accuraat zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87702b43-81f3-4a50-84e2-6a99cadad944",
                                                "sense_id": "6f44334c-0875-3938-9fcc-e4730d64bd6e",
                                                "text": "'Voor de schrijvers uit de oudheid waren historische feiten niet hetzelfde als voor ons.' (...) Dergelijke kanttekeningen mogen we volgens de zogeheten kritisch-historische bijbelwetenschap ook plaatsen bij andere bijbelverhalen - van de tocht van het Joodse volk door de woestijn tot de getuigenverklaringen van Jezus' wederopstanding. Voor [nieuwtestamenticus] Lietaert Peerbolte en zijn collega's is het niet meer dan vanzelfsprekend. Toch is het nieuws als de paus [Benedictus XVI] (of in Nederland: de 'atheïstische dominee' Klaas Hendrikse) de historiciteit van de verhalen betwijfelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35ba349c-b639-3f2f-8a86-f9a4577dc668",
                                        "entry_id": "4ca978eb-b929-323b-a49d-f0054f7307d6",
                                        "glosses": [
                                            "historische waarde (van bronnen), de mate waarin gegevens in bronnen kunnen worden gebruikt voor reconstructies van het verleden (bijvoorbeeld in de geschiedschrijving)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbebe36-7766-4405-b25c-3ad44b19d741",
                                                "sense_id": "35ba349c-b639-3f2f-8a86-f9a4577dc668",
                                                "text": "Experts hebben ellenlange discussies gevoerd over de historiciteit van de verhalen van Homerus. Magnasco en Baikouzis interpreteren het verhaal van Homerus op zo'n manier dat er referenties aan de positie van zon en sterren in kunnen worden gelezen. (...) Door dit soort referenties te koppelen aan het daadwerkelijk voorkomen van deze verschijnselen in het verleden, kan een datum worden vastgesteld. Volgens de wetenschappers is dat dus 16 april 1178 voor Christus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "434656d2-d7d2-4435-a146-ad034277ef3d",
                        "source_entry_id": "9cf1672d-9d02-3cd0-8fa2-f09a36e17f30",
                        "source_sense_description": "historical quality",
                        "target_lang_word": "historicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "070b41a1-b0ce-3f40-8291-3e1ac56ea896",
                                        "entry_id": "2a8cff4f-0d1d-3296-9004-714c9c918eca",
                                        "glosses": [
                                            "Caractère de ce qui est historique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ad3f0c-e302-4e4c-bc1d-668480f71812",
                                                "sense_id": "070b41a1-b0ce-3f40-8291-3e1ac56ea896",
                                                "text": "L’historicité de Jésus est incontestable, mais les circonstances de sa naissance donnent lieu à de nombreuses interprétations."
                                            },
                                            {
                                                "example_id": "4fa991f1-c009-41af-a3a9-4cfdb0d1bd33",
                                                "sense_id": "070b41a1-b0ce-3f40-8291-3e1ac56ea896",
                                                "text": "L’historicité de Romulus et Rémus n’est pas établie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a4a71e-78e2-3036-8e38-d00db574bde9",
                                        "entry_id": "2a8cff4f-0d1d-3296-9004-714c9c918eca",
                                        "glosses": [
                                            "Caractère de ce qui est apparu ou s'est développé au cours de l’histoire (idées, pratiques, institutions…), par opposition à une chose naturelle ou universelle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0aea89e-95a9-4042-9322-7d7306dd4d8f",
                                                "sense_id": "d4a4a71e-78e2-3036-8e38-d00db574bde9",
                                                "text": "C'est que, par ailleurs, l'idéologie de l'Histoire est strictement liée à l'idéologie totalitaire de la culture. Si l'Histoire est, dans son idée - exclusive de la \"barbarie\" historique, du retour de l'historicité sur soi qui l'institue comme devenir sauvage -, histoire purement humaine, la culture est, de son côté, immuable dans le changement : elle est une sorte de totalité fermée sur soi, qui n'a pas de dehors, de laquelle l'Histoire ne fait jamais sortir, même si elle est histoire de ruptures ;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
