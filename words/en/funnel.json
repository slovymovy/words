                        {
                            "text": "She placed the <w>funnel</w> in the bottle neck before adding the spices."
                        }
                    ]
                },
                {
                    "sense_id": "9e9a1bd0-898d-3d42-ab87-442818373ac5",
                    "sense_definition": "A chimney or pipe used to vent smoke or steam, especially on a ship.",
