    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ba28792-ea2d-302c-8581-d97c70eb0a00",
                    "sense_definition": "Characterized by a vulgar or pretentious display designed to impress or attract notice.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "showy behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The billionaire built an <w>ostentatious</w> mansion that stood out from the modest houses in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Миллиардер построил <w>роскошный напоказ</w> особняк, который выделялся на фоне скромных домов по соседству."
                            }
                        },
                        {
                            "text": "He made an <w>ostentatious</w> display of wealth by tipping the waiter with a hundred-dollar bill.",
                            "target_lang_translations": {
                                "ru": "Он устроил <w>показную</w> демонстрацию богатства, оставив официанту стодолларовую купюру в качестве чаевых."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretentious"
                    ],
                    "antonyms": [
                        "modest",
                        "unobtrusive",
                        "understated"
                    ],
                    "common_phrases": [
                        "ostentatious display of wealth",
                        "ostentatious lifestyle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся вульгарным или претенциозным поведением, направленным на то, чтобы произвести впечатление или привлечь внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показной",
                                "target_lang_sense_clarification": "сделанный ради привлечения внимания"
                            },
                            {
                                "target_lang_word": "нарочитый",
                                "target_lang_sense_clarification": "подчеркнутый, выставленный напоказ"
                            },
                            {
                                "target_lang_word": "хвастливый",
                                "target_lang_sense_clarification": "содержащий элемент хвастовства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3323b728-b2b1-3b11-8758-c91a7a880ccb",
                    "sense_definition": "Excessively showy in a way that is tasteless, cheap, or kitsch.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "showy behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with <w>ostentatious</w> gold-plated furniture that looked quite tacky.",
                            "target_lang_translations": {
                                "ru": "Комната была заставлена <w>кричащей</w> позолоченной мебелью, которая выглядела довольно безвкусно."
                            }
                        },
                        {
                            "text": "She wore an <w>ostentatious</w> dress covered in bright sequins and feathers to the quiet dinner party.",
                            "target_lang_translations": {
                                "ru": "На тихий званый ужин она надела <w>вычурное</w> платье, расшитое яркими пайетками и перьями."
                            }
                        }
                    ],
                    "synonyms": [
                        "gaudy"
                    ],
                    "antonyms": [
                        "tasteful",
                        "elegant"
                    ],
                    "common_phrases": [
                        "ostentatious jewelry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно броский, безвкусный, дешевый или китчевый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "слишком яркий и безвкусный"
                            },
                            {
                                "target_lang_word": "кичёвый",
                                "target_lang_sense_clarification": "относящийся к китчу, безвкусный"
                            },
                            {
                                "target_lang_word": "вычурный",
                                "target_lang_sense_clarification": "излишне украшенный, претенциозный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}