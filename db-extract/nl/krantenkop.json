                "senses": [
                    {
                        "sense_id": "c592afa4-6a08-389d-9f84-de9b1e252891",
                        "entry_id": "b9513f8a-c724-3de3-8c9e-2badd8e2080a",
                        "glosses": [
                            "de titel van een krantenartikel, afgedrukt in een groter lettertype"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc434c7-47c9-41ee-a5c1-5febd520ca11",
                                "sense_id": "c592afa4-6a08-389d-9f84-de9b1e252891",
                                "text": "Met die onthulling haalt ze de krantenkoppen in binnen- en buitenland."
                            },
                            {
                                "example_id": "47bab65a-7b6a-4d15-ad9b-6a19dc662c21",
                                "sense_id": "c592afa4-6a08-389d-9f84-de9b1e252891",
                                "text": "\"Armer dan Crooswijk kan je het niet treffen\", was in 2016 een krantenkop toen het SCP postcode '3034' tot de armste wijk van Nederland uitriep. Dat bleek uit cijfers over de werkloosheid, het aantal uitkeringen, opgroeien in armoede, taalachterstand, gezondheid en (jeugd)criminaliteit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88f145ec-cf36-472e-a64a-89860443dbb9",
                        "source_entry_id": "b9513f8a-c724-3de3-8c9e-2badd8e2080a",
                        "source_sense_id": "c592afa4-6a08-389d-9f84-de9b1e252891",
                        "source_sense_description": "de titel van een krantenartikel",
                        "target_lang_word": "headline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
