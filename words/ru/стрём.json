{
    "word_family": [
        "стремать",
        "стрематься",
        "стремный",
        "стрёмно"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9521a92a-f12b-3b80-887a-0dcff729f378",
                    "sense_definition": "Дежурство с целью предупреждения об опасности или человек, ведущий такое наблюдение; охрана, караул.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "сторожевой_пост",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Один из парней встал на <w>стрём</w> возле входа, чтобы вовремя заметить охрану.",
                            "target_lang_translations": {
                                "en": "One of the guys was on <w>lookout</w> near the entrance to spot security in time."
                            }
                        },
                        {
                            "text": "Стоять на <w>стрёме</w> было холодно и страшно, но выхода у него не оставалось.",
                            "target_lang_translations": {
                                "en": "Standing on <w>lookout</w> was cold and frightening, but he had no other choice."
                            }
                        }
                    ],
                    "synonyms": [
                        "охрана",
                        "стража"
                    ],
                    "common_phrases": [
                        "стоять на стрёме",
                        "встать на стрём"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Keeping watch to warn of danger, or the person serving as a sentry; guard, watch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lookout",
                                "target_lang_sense_clarification": "person or state of watching for danger"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "guard duty or sentry post"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba7dcb75-d5aa-3f59-b460-c0ee1bcd3580",
                    "sense_definition": "Чувство сильного страха, испуга, тревоги или беспокойства.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "страх_тревога",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Меня неожиданно пробил сильный <w>стрём</w>, когда в темноте послышались шаги.",
                            "target_lang_translations": {
                                "en": "A wave of intense <w>dread</w> suddenly hit me when footsteps were heard in the dark."
                            }
                        },
                        {
                            "text": "Он почувствовал нарастающий <w>стрём</w> и сразу захотел как можно быстрее уйти оттуда.",
                            "target_lang_translations": {
                                "en": "He felt a growing sense of <w>panic</w> and immediately wanted to get away from there as quickly as possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "страх",
                        "тревога"
                    ],
                    "common_phrases": [
                        "навести стрём"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A slang term for a feeling of intense fear, dread, anxiety, or paranoia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dread",
                                "target_lang_sense_clarification": "intense fear or anxiety"
                            },
                            {
                                "target_lang_word": "freak-out",
                                "target_lang_sense_clarification": "state of sudden panic or intense fear"
                            },
                            {
                                "target_lang_word": "paranoia",
                                "target_lang_sense_clarification": "anxious fear of danger or being caught"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d641a432-1e53-3585-9b59-c2059ae9ccc6",
                    "sense_definition": "Опасность, угроза разоблачения или неблагоприятная, подозрительная ситуация.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребята сразу почуяли <w>стрём</w> и быстро покинули заброшенное здание до приезда полиции.",
                            "target_lang_translations": {
                                "en": "The guys immediately sensed <w>danger</w> and quickly left the abandoned building before the police arrived."
                            }
                        },
                        {
                            "text": "В этой сделке был явный <w>стрём</w>, поэтому опытный предприниматель сразу отказался от участия.",
                            "target_lang_translations": {
                                "en": "There was obvious <w>sketchiness</w> in that deal, so the experienced entrepreneur turned down participation immediately."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A risky, dangerous, or shady situation; threat of being caught or exposed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sketchiness",
                                "target_lang_sense_clarification": "suspicious or risky nature of a situation"
                            },
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "danger or risk of being caught"
                            },
                            {
                                "target_lang_word": "danger",
                                "target_lang_sense_clarification": "peril or threat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}