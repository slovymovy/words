                    {
                        "translation_id": "9f0dc890-9073-47fe-a7be-86b9b9eb16ba",
                        "source_entry_id": "d79881dd-9eb3-3212-83d9-2e68abfd9e96",
                        "source_sense_description": "section of a garden made from decorative rocks",
                        "target_lang_word": "rocaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
