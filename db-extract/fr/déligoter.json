                "senses": [
                    {
                        "sense_id": "1b662c10-e338-3058-b8a7-3119c95fd466",
                        "entry_id": "335a305c-6d4d-3bd0-8081-1f949c88e2ea",
                        "glosses": [
                            "Libérer (quelqu'un qui était ligoté)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b88a992-b4bb-4264-b6dc-05328fc48ec4",
                                "sense_id": "1b662c10-e338-3058-b8a7-3119c95fd466",
                                "text": "Avec une précipitation extrême, Juve alors, entreprit de déligoter le malheureux étranger."
                            },
                            {
                                "example_id": "f357d488-0646-4f4a-9ee7-4e19e1102401",
                                "sense_id": "1b662c10-e338-3058-b8a7-3119c95fd466",
                                "text": "Et, toujours comme dans un cauchemar, je tendis mes forces au hasard, pour me déligoter, pour me réveiller."
                            },
                            {
                                "example_id": "69194877-fdd6-4ff4-820d-c1e0eb73f846",
                                "sense_id": "1b662c10-e338-3058-b8a7-3119c95fd466",
                                "text": "Alors je vais rejoindre mes deux “invités”, et voilà que je déligote papa."
                            }
                        ]
                    }
                ],
