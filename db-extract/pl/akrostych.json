                "translations": [
                    {
                        "translation_id": "7c458fc1-7d45-44e4-9121-5ccfd2d9af3a",
                        "source_entry_id": "2ad345ad-3587-3ea5-b0ce-0f2f55f60ae5",
                        "source_sense_id": "fe1d25f8-4fec-3ae1-9413-68aca654dd98",
                        "target_lang_word": "acrostiche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrostiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee84fcab-159c-3a07-be41-2baab3bc4124",
                                        "entry_id": "8e660f77-cf8e-3b0e-99a3-10c19973b02f",
                                        "glosses": [
                                            "Qualifie une pièce de vers acrostiche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa0dfad-6a40-43ed-b33b-dc902865a3a0",
                                                "sense_id": "ee84fcab-159c-3a07-be41-2baab3bc4124",
                                                "text": "Sonnets acrostiches."
                                            },
                                            {
                                                "example_id": "d1f2bf38-d5f0-44a1-99d5-405021c3d372",
                                                "sense_id": "ee84fcab-159c-3a07-be41-2baab3bc4124",
                                                "text": "Vers acrostiches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acrostiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff3c686-2c5c-38ae-9af2-47d9ef748e5d",
                                        "entry_id": "7cee111a-f172-3328-b8e7-1db7ef151074",
                                        "glosses": [
                                            "Pièce de vers dans laquelle les initiales de chaque vers, lues verticalement, composent un mot ou un texte."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f9f560a-50d9-46e6-a20e-8c6d41a54298",
                                                "sense_id": "7ff3c686-2c5c-38ae-9af2-47d9ef748e5d",
                                                "text": "J’en veux faire un poème en forme d’acrostiche, Dans les deux bouts du vers et dans chaque hémistiche."
                                            },
                                            {
                                                "example_id": "6db1e3a8-7e53-426d-bb7f-c20940a3ac9d",
                                                "sense_id": "7ff3c686-2c5c-38ae-9af2-47d9ef748e5d",
                                                "text": "Dans l’allégorique Songe vert dont les personnages portent des noms en forme d’anagrammes (Seganissegede = Génie des Sages, Ellugate = Glu étale, Linemalore = Lie normale, Tripsarecopsem = Corps, Ame, Esprit), ou le Miroir des sept chapitres où Roger Bacon dissimula un acrostiche (chacun de ses chapitres commence par les mots suivants : In Verbis Praesentibus Invenies Terminum Exquisitae Rei, dont les initiales prises ensemble forment Iupiter, symbole de l’étain)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3efc524-4312-4225-9afe-43f6c8254efb",
                        "source_entry_id": "2ad345ad-3587-3ea5-b0ce-0f2f55f60ae5",
                        "source_sense_id": "fe1d25f8-4fec-3ae1-9413-68aca654dd98",
                        "target_lang_word": "Akrostichon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akrostichon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fb06839-0ca3-374c-bba3-13b188d4f752",
                                        "entry_id": "4a35d835-b162-3d71-b3c7-da43030440d2",
                                        "glosses": [
                                            "Gedicht als Wortspiel, bei dem die Anfangsbuchstaben, -silben oder -wörter der Verse hintereinandergereiht einen Namen oder einen sinnvollen Satz bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99e39d3f-b3b6-430a-a200-9e9f55fe3d60",
                                                "sense_id": "0fb06839-0ca3-374c-bba3-13b188d4f752",
                                                "text": "Sprachspiele wie zum Beispiel das Akrostichon gab es schon in der Antike."
                                            },
                                            {
                                                "example_id": "ef5c2f74-f598-4d0d-8631-46aaf73df2ee",
                                                "sense_id": "0fb06839-0ca3-374c-bba3-13b188d4f752",
                                                "text": "„An Bilderrätseln, Rebussen und Akrosticha versucht er sich immer wieder.“"
                                            },
                                            {
                                                "example_id": "7206caa0-f368-4677-a5a2-804fef4c040b",
                                                "sense_id": "0fb06839-0ca3-374c-bba3-13b188d4f752",
                                                "text": "Akrostichon mit dem Namen Karl:",
                                                "translation": "lesen."
                                            },
                                            {
                                                "example_id": "9e2f5fe5-5242-43b6-adcb-3080aea43d0c",
                                                "sense_id": "0fb06839-0ca3-374c-bba3-13b188d4f752",
                                                "text": "Akrostichon mit dem Wort Herbst:",
                                                "translation": "Traurig nun mein Herz"
                                            },
                                            {
                                                "example_id": "2e15d5f8-d5e2-43b4-85f1-dae1313a4b49",
                                                "sense_id": "0fb06839-0ca3-374c-bba3-13b188d4f752",
                                                "text": "„Die Versanfänge des Joseph-Liedes folgen dem hebräischen Alphabet und bildeten in den letzten Strophen wahrscheinlich ursprünglich auch ein sogenanntes Akrostichon, möglichrweise mit dem Namen des Verfassers, das jedoch durch wiederholtes Kopieren entstellt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "487d1c4d-834e-46df-9f96-fe909c463f36",
                        "source_entry_id": "2ad345ad-3587-3ea5-b0ce-0f2f55f60ae5",
                        "source_sense_id": "fe1d25f8-4fec-3ae1-9413-68aca654dd98",
                        "target_lang_word": "акростих",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "акростих",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "382968a3-2d6b-333e-ad84-e93e623122b7",
                                        "entry_id": "36fbdebf-992c-30ee-bd76-cb58bc69c53e",
                                        "glosses": [
                                            "стихотворение, в котором первые буквы каждого стиха составляют осмысленный текст (слово, словосочетание или предложение)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d495d73-e3ca-45e2-8559-3a89f0ff4eaa",
                                                "sense_id": "382968a3-2d6b-333e-ad84-e93e623122b7",
                                                "text": "И музы приютились у молодого пришельца: не мало написал он элегий, посланий, просто стихов и, наконец, тех литературных игрушек, которые под именем шарад, логогрифов, анаграмм, акростихов потешали публику того времени."
                                            },
                                            {
                                                "example_id": "496e61b6-9cc4-45db-8b7b-e397d81b5f84",
                                                "sense_id": "382968a3-2d6b-333e-ad84-e93e623122b7",
                                                "text": "Одного лицеиста, часто нападавшего на него, он прозвал за коротко остриженные волосы: «Расстригою Спиридоном», и вот вечером, в день именин его, он уставил в гимназическом зале транспарант собственного изделия с изображением черта, стригущего дервиша, и со следующим акростихом: Се образ жизни нечестивой, Пугалище дервишей всех И…строптивой Расстрига, сотворивший грех И за сие то преступленье Достал он титул сей О чтец! имей терпенье, Начальные слова в устах запечатлей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
