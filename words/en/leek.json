            "senses": [
                {
                    "sense_id": "81b06ae1-b729-3c18-91da-cd98ecca040d",
                    "sense_definition": "A vegetable of the onion family with long, edible green leaves and a mild, white bulb.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef chopped a fresh <w>leek</w> to add flavor to the soup.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар нарезал свежий <w>лук-порей</w>, чтобы добавить вкуса супу."
                            }
                        },
                        {
                            "text": "Many traditional recipes use a <w>garden</w> <w>leek</w> as a base for savory dishes.",
                            "target_lang_translations": {
                                "ru": "Во многих традиционных рецептах <w>лук-порей</w> используется как основа для пикантных блюд."
                            }
                        }
                    ],
                    "synonyms": [
                        "garden leek"
                    ],
                    "common_phrases": [
                        "garden leek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Овощ семейства луковых с длинными съедобными зелеными листьями и мягкой белой луковицей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лук-поре́й",
                                "target_lang_sense_clarification": "общепринятое название овоща"
                            },
                            {
                                "target_lang_word": "поре́й",
                                "target_lang_sense_clarification": "сокращенное название овоща"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adc1d4dc-788c-38b4-a99a-8f179aed9b3f",
                    "sense_definition": "Any wild plant species that looks similar to the common domesticated vegetable.",
