            {
                "entry_id": "6d7fddca-504b-3429-b652-2ea966d0c537",
                "word": "adequaat",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                        "entry_id": "6d7fddca-504b-3429-b652-2ea966d0c537",
                        "glosses": [
                            "correct en passend bij het beoogde doel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d1ec3c9-844a-4c8f-817d-82e78f599115",
                                "sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                                "text": "Zout is een adequaat middel tegen gladheid."
                            },
                            {
                                "example_id": "244472f7-bf94-43c0-829d-bd29146e9f60",
                                "sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                                "text": "De piloot reageerde adequaat toen de motoren van het vliegtuig uitvielen en wist het vliegtuig keurig op de snelweg te laten landen."
                            },
                            {
                                "example_id": "92567d88-b461-4595-beb3-39b98e54eeff",
                                "sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                                "text": "Hoe vrouwen het aanpakten tijdens hun menstruatie weet ik niet precies. Er bestaat een speciale PCT-vrouwenfacebookgroep (women of the PCT) waar onderling tips en tricks over dit soort onderwerpen worden gedeeld. Ik heb er tijdens de tocht niemand over horen praten dus voor alles blijkt een adequate oplossing te zijn."
                            },
                            {
                                "example_id": "348e1c62-27e8-4ff0-9bb9-660930227878",
                                "sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                                "text": "Dan moest er adequaat worden gereageerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2e6bfef-6eaf-4387-a0ea-7a758ce0f93d",
                        "source_entry_id": "6d7fddca-504b-3429-b652-2ea966d0c537",
                        "source_sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                        "source_sense_description": "correct en passend bij het beoogde doel",
                        "target_lang_word": "adäquat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adäquat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                        "entry_id": "c5d0f010-a444-3931-ae73-d3fb6a541345",
                                        "glosses": [
                                            "den gestellten Bedingungen angemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf6623a-c980-405e-8325-6f3bb3fc4961",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Daß niemals ein Mensch demjenigen adäquat handeln werde, was die reine Idee der Tugend enthält, beweist gar nicht etwas Chimärisches in diesem Gedanken.“"
                                            },
                                            {
                                                "example_id": "8dc67ed3-af99-4b60-9327-457418600daa",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Die Schrift ist nicht nur nicht die Sprache selbst, sondern sie ist derselben auch in keiner Weise adäquat.“"
                                            },
                                            {
                                                "example_id": "1a1548fd-44e8-486a-830c-e01c0417d206",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Es handelt sich bei dem konkreten mitgeführten Messer nicht mehr um einen Gebrauchsgegenstand des täglichen Lebens, der regelmäßig mitgeführt und durchweg in sozial adäquater Weise eingesetzt wird.“ (Urteilstext)"
                                            },
                                            {
                                                "example_id": "d9b49be2-10bb-4d15-a8f5-fe0fd4b4112c",
                                                "sense_id": "2c46459a-1252-3a41-9de4-90cab5da2ba6",
                                                "text": "„Den Neukelten beziehungsweise Neuheiden und vor allem den neuen Druiden geht es um eine Wiederbelebung keltischer Tradition, vor allem der keltischen Religion nach dem Motto: Nicht das Christentum, sondern das Heidentum ist die für Europa adäquate Religion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d6fa7e3-1060-433b-95d7-3773e85eb02a",
                        "source_entry_id": "6d7fddca-504b-3429-b652-2ea966d0c537",
                        "source_sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                        "source_sense_description": "correct en passend bij het beoogde doel",
                        "target_lang_word": "adequate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adequate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e98c4cfc-5921-3de7-b5ee-f3878984afa8",
                                        "entry_id": "b24e40b1-9e3a-3a6f-8522-eb6218c99a9d",
                                        "glosses": [
                                            "A sufficient amount of; enough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "866e40e4-0693-49d1-b312-020aa6b0ccd2",
                                                "sense_id": "e98c4cfc-5921-3de7-b5ee-f3878984afa8",
                                                "text": "We have adequate money for the journey."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adequate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                        "entry_id": "07d9b5f4-c965-3799-8592-9fe4694c0655",
                                        "glosses": [
                                            "Equal to or fulfilling some requirement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa19414-d46c-4625-9f72-be8e69e54d1e",
                                                "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                                "text": "powers adequate to a great work"
                                            },
                                            {
                                                "example_id": "ded9e4f6-58bd-427f-94fe-c286c756d7d6",
                                                "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                                "text": "an adequate definition"
                                            },
                                            {
                                                "example_id": "4feacb5f-de73-4062-8697-041c8334f536",
                                                "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                                "text": "Proportion therefore your Clothes to your bodies, and let them be proper for your persons. […] Agreeableness […] ought to be exact, and adequate both to age, person and condition, avoiding extremities on both sides, being neither too much out, nor in the fashions."
                                            },
                                            {
                                                "example_id": "82b8d6bf-c7bb-48db-b4b9-4e4dcc476bcd",
                                                "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                                "text": "Her legal allowance was not adequate to her fortune, nor sufficient for her comfortable maintenance […]"
                                            },
                                            {
                                                "example_id": "55e1c16c-4576-46b0-bdeb-2d81d20f256d",
                                                "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                                "text": "1853, Thomas De Quincey, Autobiographic Sketches in Narrative and Miscellaneous Papers, Boston: Ticknor, Reed, and Fields, “Dublin,” p. 254,\n[…] in those days, Ireland had no adequate champion; the Hoods and the Grattans were not up to the mark."
                                            },
                                            {
                                                "example_id": "bf7dd180-fefc-461d-a1cd-e22ca232f9a2",
                                                "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                                "text": "All day as I drove upon my round I turned over the case in my mind, and found no explanation which appeared to me to be adequate."
                                            },
                                            {
                                                "example_id": "91a45564-83cb-478f-890e-db95e1c2888d",
                                                "sense_id": "4b6c68ea-f595-315e-aa93-f98914cded33",
                                                "text": "John was a perfectly adequate academic. A perfectly adequate academic but not a notable teacher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adequate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c90258f-35a3-3301-9a6d-1a303eddbdb0",
                                        "entry_id": "1e83dba3-153e-3c3f-a9fd-024bd61df0ce",
                                        "glosses": [
                                            "To equalize; to make adequate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cdaec93-61e2-4b8b-a38e-a89feaef9825",
                                                "sense_id": "2c90258f-35a3-3301-9a6d-1a303eddbdb0",
                                                "text": "Let me giue yet one instance more, of a truly intellectuall obiect, exactly adequated and proportioned vnto the intellectuall appetite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02c83750-de10-3990-9040-9e5108491cb0",
                                        "entry_id": "1e83dba3-153e-3c3f-a9fd-024bd61df0ce",
                                        "glosses": [
                                            "To equal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dac03768-5f22-4de6-9768-7e5e9cbf292a",
                                                "sense_id": "02c83750-de10-3990-9040-9e5108491cb0",
                                                "text": "[…] though it be an impossibilitie for any creature to adequate God in his eternitie, yet he hath ordained all his sonnes in Christ to partake of it by living with him eternally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
