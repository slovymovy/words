                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2ea2bb-6446-4115-8bbe-393e025fb711",
                                "sense_id": "69f6357f-85a0-305e-a409-c21995cb9114",
                                "text": "Rembrandt maakte het werk op 29-jarige leeftijd, toen hij in Amsterdam woonde. Op het portret is hij te zien met een zwarte schoudermantel, een vedermuts en een halskraag van een ridder. De waarde van het werk wordt op 30 miljoen pond (37 miljoen euro) geschat."
                            }
                        ]
