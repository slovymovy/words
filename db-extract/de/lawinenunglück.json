                "senses": [
                    {
                        "sense_id": "d4efffe7-929b-3aab-8d20-8568f8086089",
                        "entry_id": "2f47d1e7-2a0d-3fed-b909-0d6be89792ac",
                        "glosses": [
                            "tragisches und folgenschweres Ereignis, ausgelöst durch einen Lawinenabgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e6b6e0-09f3-4870-94ff-c4f8f77a3c8d",
                                "sense_id": "d4efffe7-929b-3aab-8d20-8568f8086089",
                                "text": "„Das Lawinenunglück macht auf tragische Art deutlich, unter welchen Bedingungen die nepalesischen Bergführer arbeiten.“"
                            },
                            {
                                "example_id": "688a924c-ee0f-402c-a74e-0ddb8a59f929",
                                "sense_id": "d4efffe7-929b-3aab-8d20-8568f8086089",
                                "text": "„Das Lawinenunglück im Januar beschädigte neben dem Hotel auch eine Seilbahnstütze.“"
                            },
                            {
                                "example_id": "bcb5ccc5-7b03-4dcf-b3f0-a0e9827a675a",
                                "sense_id": "d4efffe7-929b-3aab-8d20-8568f8086089",
                                "text": "„Das war das Jahr, in dem sehr viele Leute bei Lawinenunglücken ums Leben kamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
