                        "source_sense_description": "Wirtschaft: ein Wettbewerb, bei dem mehr Ressourcen aufgewendet werden, als gewonnen werden können",
                        "target_lang_word": "rat race",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
