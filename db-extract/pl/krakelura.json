                                            "αποτέλεσμα"
                                        ],
                                        "tags": [
                                            "με αιτιατική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28f0203-0c6e-4eb5-8e5e-b2a74223a9b3",
                                                "sense_id": "049406f7-b016-3888-ac6e-e95b1c53c9c3",
                                                "text": "Το χαρτί σκίστηκε σε δύο κομμάτια."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc9c32b-c9bd-376c-afb5-0e15bd5179f6",
                                        "entry_id": "f7dc90a1-28d7-3951-afc4-fcb8df0d9f75",
                                        "glosses": [
                                            "δηλώνει:",
                                            "αναφορά"
                                        ],
                                        "tags": [
