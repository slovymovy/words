{
    "word_family": [
        "breken",
        "breuk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "500ba01b-a200-36ef-9d1e-971cd60b07af",
                    "sense_definition": "De eigenschap hebbend gemakkelijk te breken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die elegante glazen zijn nu eenmaal <w>breekbare</w> dingen.",
                            "target_lang_translations": {
                                "zh": "那些优雅的玻璃杯本来就是<w>易碎的</w>东西。"
                            }
                        },
                        {
                            "text": "Wees voorzichtig met de doos, want de inhoud is erg <w>breekbaar</w>.",
                            "target_lang_translations": {
                                "zh": "搬运这个箱子时要小心，因为里面的东西非常<w>易碎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fragiel",
                        "bros",
                        "delicaat"
                    ],
                    "common_phrases": [
                        "zeer breekbaar"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体容易破碎或损坏的性质"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易碎的",
                                "target_lang_sense_clarification": "形容物体容易破碎，常用于描述玻璃、瓷器等物品"
                            },
                            {
                                "target_lang_word": "脆弱的",
                                "target_lang_sense_clarification": "形容物体结构不牢固，容易损坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4fff219-775f-35e1-a2f4-bdf93cf3486c",
                    "sense_definition": "Makkelijk te kwetsen of makkelijk te verstoren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De harpiste maakte mooie <w>breekbare</w> muziek.",
                            "target_lang_translations": {
                                "zh": "那位竖琴手演奏出了优美而<w>纤细</w>的音乐。"
                            }
                        },
                        {
                            "text": "Na het verlies van haar baan voelde ze zich erg <w>breekbaar</w>.",
                            "target_lang_translations": {
                                "zh": "失去工作后，她感到内心非常<w>脆弱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kwetsbaar",
                        "teder",
                        "fijn"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人的情感、心理状态或某种事物容易受到伤害或干扰"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脆弱的",
                                "target_lang_sense_clarification": "形容人的心理或情感容易受到伤害"
                            },
                            {
                                "target_lang_word": "纤细的",
                                "target_lang_sense_clarification": "形容事物（如音乐、艺术）细腻且容易被破坏的特质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}