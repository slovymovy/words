                    }
                ],
                "senses": [
                    {
                        "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                        "entry_id": "4a3e2a21-484a-3c5d-a372-31bb169903fb",
                        "glosses": [
                            "Petite construction habitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c6898b-cfe4-4171-916a-cf7e31f1d11f",
                                "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                                "text": "La vapeur se contournait en spirales autour des groupes de palmiers, entre lesquels apparaissaient de pittoresques bungalows, quelques viharis, sortes de monastères abandonnés, et des temples merveilleux qu’enrichissait l’inépuisable ornementation de l’architecture indienne."
                            },
                            {
                                "example_id": "d9272121-5a90-4d4d-b649-c8626ae4493e",
                                "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                                "text": "— Moi non plus, je n'ai plus de cigarettes, dit-il.\n— Putain de votre race à tous, dit Louise. J'en ai dans mon bungalow au Sun, je vais les chercher. De toute façon, fallait que je m'habille."
                            },
                            {
                                "example_id": "8698f863-6bea-4d04-89e3-b9a2175ac5ee",
                                "sense_id": "c45cf305-29f1-35fd-8739-75be1a0e5df9",
                                "text": "À Bangui, j'habitais un petit bungalow perdu parmi les bananiers, au pied d'une colline où la lune venait chaque nuit se percher comme un hibou lumineux."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb4231a1-bff0-3fb2-a39f-85ba5aa2aae6",
                        "entry_id": "4a3e2a21-484a-3c5d-a372-31bb169903fb",
                        "glosses": [
                            "Local temporaire sur un chantier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26792b9-1feb-4421-bb7d-70f6cf8f6ecf",
                                "sense_id": "cb4231a1-bff0-3fb2-a39f-85ba5aa2aae6",
                                "text": "Sur un chantier, on croise de nombreuses personnes, on mange dans le même bungalow, on prend des camionnettes ensemble…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfd4115c-1d03-48d3-a9c4-ba5dbebaa781",
                        "source_entry_id": "4a3e2a21-484a-3c5d-a372-31bb169903fb",
                        "target_lang_word": "bungalow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bungalow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52035f41-feb9-3499-86d1-eff3bcaf0584",
                                        "entry_id": "772cee2f-1c26-30ce-8c96-c9abc323b5e1",
                                        "glosses": [
                                            "A single-storey house, typically with rooms all on one level, or sometimes also with upper rooms set into the roof space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed322e41-ea56-4e8d-8d68-6a80653f4cd4",
                                                "sense_id": "52035f41-feb9-3499-86d1-eff3bcaf0584",
                                                "text": "My aunt can't manage the stairs any more, so she's moving to a bungalow."
                                            },
                                            {
                                                "example_id": "ac66cda7-1076-4851-820f-a56b13f0b607",
                                                "sense_id": "52035f41-feb9-3499-86d1-eff3bcaf0584",
                                                "text": "Slowly she turned round and faced towards a neat white bungalow, set some way back from the path behind a low hedge of golden privet. No light showed, but someone there was playing the piano. The strange elusiveness of the soft, insistent melody seemed to draw her forward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09339fa2-e182-332f-9ca8-2b0c96433449",
                                        "entry_id": "772cee2f-1c26-30ce-8c96-c9abc323b5e1",
                                        "glosses": [
                                            "A thatched or tiled one-story house in India surrounded by a wide veranda; a similar house in this style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "105945db-5db4-4e35-900e-c7761072f3c2",
                                                "sense_id": "09339fa2-e182-332f-9ca8-2b0c96433449",
                                                "text": "Following the rule adopted in most tropical countries, a bungalow style of house was chosen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead53bf8-2348-390a-8f8d-adff038760bc",
                                        "entry_id": "772cee2f-1c26-30ce-8c96-c9abc323b5e1",
                                        "glosses": [
                                            "A chalet or lodge"
                                        ],
