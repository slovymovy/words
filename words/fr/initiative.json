    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42cdc8a4-d540-3ea2-b01d-3a0ca4d6fa09",
                    "sense_definition": "Action de proposer ou d'entreprendre le premier quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a pris l'<w>initiative</w> d'organiser une réunion pour trouver une solution au problème."
                        },
                        {
                            "text": "Grâce à cette belle <w>initiative</w>, le quartier est devenu beaucoup plus propre et agréable."
                        }
                    ],
                    "synonyms": [
                        "entreprise",
                        "proposition"
                    ],
                    "common_phrases": [
                        "prendre l'initiative",
                        "sur l'initiative de",
                        "belle initiative"
                    ]
                },
                {
                    "sense_id": "d51da91a-1535-348f-bdb4-f48168ff266b",
                    "sense_definition": "Disposition d'esprit consistant à concevoir et exécuter des projets sans attendre d'ordres.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet employé fait preuve d'<w>initiative</w> et résout les imprévus avec une remarquable efficacité."
                        },
                        {
                            "text": "L'entreprise recherche des candidats qui possèdent un excellent esprit d'<w>initiative</w> au quotidien."
                        }
                    ],
                    "synonyms": [
                        "audace",
                        "dynamisme"
                    ],
                    "antonyms": [
                        "passivité"
                    ],
                    "common_phrases": [
                        "esprit d'initiative",
                        "faire preuve d'initiative",
                        "manquer d'initiative"
                    ]
                },
                {
                    "sense_id": "60d97786-ad0f-3a81-8589-064e267f3fbc",
                    "sense_definition": "Droit ou faculté reconnue par la loi de faire une proposition, notamment législative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans notre système constitutionnel, l'<w>initiative</w> des lois est partagée entre l'exécutif et le Parlement."
                        },
                        {
                            "text": "Les citoyens ont défendu cette réforme par une pétition d'<w>initiative</w> populaire très suivie."
                        }
                    ],
                    "common_phrases": [
                        "initiative des lois",
                        "initiative populaire",
                        "initiative citoyenne"
                    ]
                },
                {
                    "sense_id": "47ed3747-0e82-3c19-8725-a7d27b31c66c",
                    "sense_definition": "Fait d'imposer son rythme ou son jeu à un adversaire en le forçant à réagir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tactique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aux échecs, les Blancs cherchent souvent à conserver l'<w>initiative</w> dès le début de la partie."
                        },
                        {
                            "text": "L'équipe a complètement perdu l'<w>initiative</w> en seconde période après une série d'erreurs tactiques."
                        }
                    ],
                    "synonyms": [
                        "ascendant",
                        "avantage"
                    ],
                    "common_phrases": [
                        "garder l'initiative",
                        "perdre l'initiative",
                        "reprendre l'initiative"
                    ]
                },
                {
                    "sense_id": "5535a3d1-32b4-3eb4-b308-4e5f7f41b3dd",
                    "sense_definition": "Dans un jeu de rôle ou de société, valeur ou mécanisme déterminant l'ordre d'action pendant un affrontement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître de jeu demande un jet d'<w>initiative</w> avant de commencer la phase d'affrontement."
                        },
                        {
                            "text": "Grâce à son agilité extraordinaire, le héros a remporté l'<w>initiative</w> sur l'ensemble de ses ennemis."
                        }
                    ],
                    "common_phrases": [
                        "jet d'initiative",
                        "ordre d'initiative"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "8dab687e-9a18-3c95-8cc9-a00ed1f6a01f",
                    "sense_definition": "Cri ou avertissement utilisé dans certains jeux pour annoncer le début immédiat des hostilités.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître du jeu a posé ses notes et a crié : « <w>Initiative</w> ! Préparez vos dés. »"
                        },
                        {
                            "text": "Dès l'apparition de l'embuscade, tous les joueurs autour de la table ont hurlé : « <w>Initiative</w> ! »"
                        }
                    ]
                }
            ]
        }
    ]
}