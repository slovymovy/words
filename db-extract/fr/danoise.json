            {
                "entry_id": "d4fcbf3e-13a8-3366-9778-37a0f7dd5eea",
                "word": "Danoise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8700583f-b888-43b5-a5bf-1b8837366b50",
                        "entry_id": "d4fcbf3e-13a8-3366-9778-37a0f7dd5eea",
                        "tags": [
                            "plural"
                        ],
                        "form": "Danoises"
                    },
                    {
                        "form_id": "8199f85c-4777-4a74-b7f4-be006a679e88",
                        "entry_id": "d4fcbf3e-13a8-3366-9778-37a0f7dd5eea",
                        "tags": [
                            "masculine"
                        ],
                        "form": "Danois"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fe9ad43-4af9-30f2-babc-b4a56b9f1e4a",
                        "entry_id": "d4fcbf3e-13a8-3366-9778-37a0f7dd5eea",
                        "glosses": [
                            "Habitante du Danemark, femme de nationalité danoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab2ee96-ba7c-4e57-b6be-b147771e9904",
                                "sense_id": "3fe9ad43-4af9-30f2-babc-b4a56b9f1e4a",
                                "text": "La Danoise souligne que la législation en vigueur permet à l'UE de contrôler les aides accordées par les États membres, mais pas celles allouées par des pays tiers, ce qui crée des distorsions de concurrence."
                            },
                            {
                                "example_id": "c719e15f-a4a7-4665-998f-b87a8ac94a19",
                                "sense_id": "3fe9ad43-4af9-30f2-babc-b4a56b9f1e4a",
                                "text": "Quant à Emma Norsgaard, prise dans l’amas de roues, de cadres et de coureuses transformées en pantins, la Danoise a abandonné, touchée à l’épaule gauche."
                            },
                            {
                                "example_id": "0d1e3347-28d6-4657-b1ed-8d2ddcb4d038",
                                "sense_id": "3fe9ad43-4af9-30f2-babc-b4a56b9f1e4a",
                                "text": "La Danoise Cecilie Uttrup Ludwig, qui a gagné la troisième étape, est également en embuscade à moins d’une minute trente…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f81ee278-a4ad-4a13-86ba-742e5edcd543",
                        "source_entry_id": "d4fcbf3e-13a8-3366-9778-37a0f7dd5eea",
                        "source_sense_id": "3fe9ad43-4af9-30f2-babc-b4a56b9f1e4a",
                        "target_lang_word": "Dänin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dänin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75b3ef7c-305a-3d5c-a4e4-1ed915aa0830",
                                        "entry_id": "24a3ab23-d3ec-3745-b1cd-72eb4ad5ee13",
                                        "glosses": [
                                            "Staatsbürgerin von Dänemark"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf5c3fe-48f8-4742-8e2a-57f49c7be421",
                                                "sense_id": "75b3ef7c-305a-3d5c-a4e4-1ed915aa0830",
                                                "text": "„Du machst dich an eine Dänin ran.“"
                                            },
                                            {
                                                "example_id": "34205773-af23-4e35-a209-6cf7957641cd",
                                                "sense_id": "75b3ef7c-305a-3d5c-a4e4-1ed915aa0830",
                                                "text": "„Katrine ist Anfang dreißig, eine schlanke blonde Dänin mit spöttischen grünen Augen, einem Bubikopf und einem ausgesprochenen Hang zur Arktis.“"
                                            },
                                            {
                                                "example_id": "e19a743d-be61-40fe-8420-7bd7ceba7731",
                                                "sense_id": "75b3ef7c-305a-3d5c-a4e4-1ed915aa0830",
                                                "text": "„Sie ist Dänin und heißt Tove, wie die Schriftstellerin, und sie lässt euch grüßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
