                                    {
                                        "sense_id": "45f0dfa1-23e4-36dc-a1e4-d24c55516e3f",
                                        "entry_id": "1fc65b60-0ff8-3fdf-8e25-457975b6d80a",
                                        "glosses": [
                                            "bezieht sich auf ein Gebiet, in dem Militär der Zutritt verwehrt ist, außer zu Überwachungszwecken durch dritte Militärs (autorisiert beispielsweise durch die UN)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d167d55a-bfbf-4962-92d8-d4d0d5157c66",
                                                "sense_id": "45f0dfa1-23e4-36dc-a1e4-d24c55516e3f",
                                                "text": "[1949:] Auch wenn der Zweite Weltkrieg den Beteiligten noch gut im Gedächtnis ist, ist der große Feind der NATO nicht das entmilitarisierte Deutschland, sondern die Sowjetunion."
                                            },
                                            {
                                                "example_id": "63fdaffa-a9c5-4017-8bc6-bc3332275775",
                                                "sense_id": "45f0dfa1-23e4-36dc-a1e4-d24c55516e3f",
                                                "text": "[Korea:] Im Waffenstillstandsvertrag wurde 1953 die Einrichtung einer entmilitarisierten Zone vereinbart, die beide Staaten voneinander trennt."
                                            },
                                            {
                                                "example_id": "cf2c2983-c8de-4a97-8161-2001505ed65a",
                                                "sense_id": "45f0dfa1-23e4-36dc-a1e4-d24c55516e3f",
                                                "text": "Die Mission hat das Ziel, den im \"Abkommen von Algier\" im Juni 2000 ausgehandelten Waffenstillstand und die eingerichtete entmilitarisierte Zone zwischen Äthiopien und Eritrea zu überwachen."
                                            },
                                            {
                                                "example_id": "d77b0cb3-a4bb-42e1-9128-9a22e226942b",
                                                "sense_id": "45f0dfa1-23e4-36dc-a1e4-d24c55516e3f",
                                                "text": "Die anhaltenden Gefechte der syrischen Regierungsarmee gegen Rebellen greifen immer wieder auf die entmilitarisierte Zone der Golanhöhen an der Grenze zu Israel über und führten zu Verletzungen der Waffenstillstandslinie."
                                            }
                                        ],
