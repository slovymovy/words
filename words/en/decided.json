                    "common_phrases": [
                        "decided manner",
                        "decided opinion",
                        "decided views"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий твердыми убеждениями или характером; решительный.",
                        "zh": "性格或立场坚定的；果断的，坚决的。"
                    },
                    "translations": {
