{
    "word_family": [
        "vocalist",
        "vocalize",
        "vocalization",
        "vocally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "70d9527c-5b5c-31c0-8c5e-531bb081374c",
                    "sense_definition": "Expressing opinions or feelings freely, loudly, or insistently.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens were very <w>vocal</w> about their opposition to the new construction project.",
                            "target_lang_translations": {
                                "ru": "Граждане очень <w>громко высказывались</w> о своём несогласии с новым строительным проектом.",
                                "zh": "市民们对新建筑项目表示了非常<w>直言不讳的</w>反对。"
                            }
                        },
                        {
                            "text": "She has become a <w>vocal</w> critic of the government's environmental policies.",
                            "target_lang_translations": {
                                "ru": "Она стала <w>ярым</w> критиком экологической политики правительства.",
                                "zh": "她已成为政府环境政策的<w>大声疾呼的</w>批评者。"
                            }
                        },
                        {
                            "text": "Despite being a minority, the group was <w>vocal</w> enough to delay the decision.",
                            "target_lang_translations": {
                                "ru": "Несмотря на меньшинство, группа была достаточно <w>громкой</w>, чтобы отложить принятие решения.",
                                "zh": "尽管人数占少数，该团体依然足够<w>直言不讳</w>，从而推迟了决策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outspoken",
                        "loud"
                    ],
                    "antonyms": [
                        "quiet",
                        "silent"
                    ],
                    "common_phrases": [
                        "vocal critic",
                        "vocal support",
                        "vocal minority",
                        "vocal opponent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободно, громко или настойчиво выражающий своё мнение или чувства.",
                        "zh": "自由、大声或坚持不懈地表达自己的观点或感受。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громогласный",
                                "target_lang_sense_clarification": "шумный, громкий"
                            },
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "прямолинейный, откровенный"
                            },
                            {
                                "target_lang_word": "громкий",
                                "target_lang_sense_clarification": "привлекающий внимание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直言不讳的",
                                "target_lang_sense_clarification": "敢于直率表达意见的"
                            },
                            {
                                "target_lang_word": "大声疾呼的",
                                "target_lang_sense_clarification": "强烈表达观点的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6513b8e5-faeb-3024-8f7e-5355841add3e",
                    "sense_definition": "Relating to, produced by, or resembling the human voice.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "voice_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer rested for a week to recover from a strain on his <w>vocal</w> cords.",
                            "target_lang_translations": {
                                "ru": "Певец отдыхал неделю, чтобы восстановиться после перенапряжения <w>голосовых</w> связок.",
                                "zh": "歌手休息了一周，以恢复因过度使用而受损的<w>声带</w>。"
                            }
                        },
                        {
                            "text": "Human language relies heavily on the precise control of the <w>vocal</w> tract.",
                            "target_lang_translations": {
                                "ru": "Человеческая речь сильно зависит от точного контроля <w>голосового</w> тракта.",
                                "zh": "人类语言高度依赖对<w>发声器官</w>的精确控制。"
                            }
                        },
                        {
                            "text": "She has an impressive <w>vocal</w> range that allows her to sing difficult opera pieces.",
                            "target_lang_translations": {
                                "ru": "У неё впечатляющий <w>вокальный</w> диапазон, позволяющий исполнять сложные оперные партии.",
                                "zh": "她拥有令人印象深刻的<w>音域</w>，这使她能够演唱高难度的歌剧作品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "oral",
                        "spoken"
                    ],
                    "common_phrases": [
                        "vocal cords",
                        "vocal range",
                        "vocal tract",
                        "vocal folds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к человеческому голосу, производимый им или напоминающий его.",
                        "zh": "与人类声音有关、由其产生或类似其的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голосовой",
                                "target_lang_sense_clarification": "относящийся к голосу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声带",
                                "target_lang_sense_clarification": "指代发声器官"
                            },
                            {
                                "target_lang_word": "发声的",
                                "target_lang_sense_clarification": "与声音产生相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a30ed34a-6061-38bd-ba0e-ebebaa4ef6a4",
                    "sense_definition": "Relating to or composed for singing rather than instruments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert featured a mix of instrumental and <w>vocal</w> performances.",
                            "target_lang_translations": {
                                "ru": "В концерте сочетались инструментальные и <w>вокальные</w> номера.",
                                "zh": "音乐会包含了器乐和<w>声乐</w>表演。"
                            }
                        },
                        {
                            "text": "They specialize in <w>vocal</w> music from the Renaissance period.",
                            "target_lang_translations": {
                                "ru": "Они специализируются на <w>вокальной</w> музыке эпохи Возрождения.",
                                "zh": "他们专门研究文艺复兴时期的<w>声乐</w>作品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vocal music",
                        "vocal performance",
                        "vocal jazz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к пению или предназначенный для него, в отличие от инструментальной музыки.",
                        "zh": "与歌唱有关或为歌唱而创作的，而非乐器演奏的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокальный",
                                "target_lang_sense_clarification": "относящийся к пению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声乐",
                                "target_lang_sense_clarification": "与歌唱相关的音乐"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e51af45-e4f3-3f38-aae5-cac9f2658496",
                    "sense_definition": "Produced with vibration of the vocal cords; voiced.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "phonetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In phonetics, vowels are always considered <w>vocal</w> sounds.",
                            "target_lang_translations": {
                                "ru": "В фонетике гласные всегда считаются <w>голосовыми</w> звуками.",
                                "zh": "在语音学中，元音总是被视为<w>浊音</w>。"
                            }
                        },
                        {
                            "text": "The distinction between <w>vocal</w> and non-vocal consonants is crucial in this language.",
                            "target_lang_translations": {
                                "ru": "Различие между <w>звонкими</w> и глухими согласными имеет решающее значение в этом языке.",
                                "zh": "区分<w>浊辅音</w>和清辅音在这种语言中至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "voiced",
                        "vocalic",
                        "sonant"
                    ],
                    "antonyms": [
                        "voiceless"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносимый с вибрацией голосовых связок; звонкий.",
                        "zh": "发音时声带振动的；浊音的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонкий",
                                "target_lang_sense_clarification": "о согласных звуках"
                            },
                            {
                                "target_lang_word": "гласный",
                                "target_lang_sense_clarification": "о типе звуков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浊音",
                                "target_lang_sense_clarification": "语音学中声带振动的音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f493b430-33aa-361a-ab22-3c38b5a72c1e",
                    "sense_definition": "The part of a piece of music that is sung.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "music_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band is looking for someone to provide backing <w>vocals</w> for their new album.",
                            "target_lang_translations": {
                                "ru": "Группа ищет человека для записи бэк-<w>вокала</w> для их нового альбома.",
                                "zh": "乐队正在寻找能为他们的新专辑录制<w>和声</w>的人。"
                            }
                        },
                        {
                            "text": "Her powerful <w>vocals</w> made the song an instant hit on the radio.",
                            "target_lang_translations": {
                                "ru": "Её мощный <w>вокал</w> сделал песню мгновенным хитом на радио.",
                                "zh": "她充满力量的<w>人声</w>让这首歌在电台迅速走红。"
                            }
                        },
                        {
                            "text": "He recorded the lead <w>vocals</w> in a professional studio in London.",
                            "target_lang_translations": {
                                "ru": "Он записал основной <w>вокал</w> в профессиональной студии в Лондоне.",
                                "zh": "他在伦敦的一家专业录音室录制了<w>主唱</w>部分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "backing vocals",
                        "lead vocals",
                        "on vocals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть музыкального произведения, которая исполняется голосом.",
                        "zh": "音乐作品中由人声演唱的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокал",
                                "target_lang_sense_clarification": "пение"
                            },
                            {
                                "target_lang_word": "вокальная партия",
                                "target_lang_sense_clarification": "партия голоса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人声",
                                "target_lang_sense_clarification": "音乐中的演唱部分"
                            },
                            {
                                "target_lang_word": "声乐部分",
                                "target_lang_sense_clarification": "演唱的旋律或段落"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}