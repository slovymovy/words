                    {
                        "sense_id": "e1d58c63-5234-3ffe-ac9d-c75a9dac820e",
                        "entry_id": "f66266ed-601c-33ac-89df-186b72cd5dfd",
                        "glosses": [
                            "Incommensurability."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "533fd355-4fd2-481f-995c-8cfa2f368478",
                                "sense_id": "e1d58c63-5234-3ffe-ac9d-c75a9dac820e",
                                "text": "In view of this incommensurableness of most numbers and their respective logarithms, only an approximate definition can be given of a logarithm in general."
                            },
                            {
                                "example_id": "62dfdb1c-7afa-485d-9117-e4e38101903e",
                                "sense_id": "e1d58c63-5234-3ffe-ac9d-c75a9dac820e",
                                "text": "The incommensurableness and mystery of the world, which are, perhaps, even more necessary to the very life of religion than the right to regard it teleologically, reassert themselves afresh in the all-too-comprehensible and mathematically-formulated world."
                            },
                            {
                                "example_id": "908c0cf9-16f0-4ea6-bed5-cfa43c04bf70",
                                "sense_id": "e1d58c63-5234-3ffe-ac9d-c75a9dac820e",
                                "text": "The non-correspondence between meaning and working begins in the process of conception, as incommensurableness between objects and interests."
                            }
                        ]
                    }
                ],
