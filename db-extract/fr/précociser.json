                "senses": [
                    {
                        "sense_id": "da2d8eb1-04df-318a-909c-44e4dc7d732b",
                        "entry_id": "ddba9c4d-587a-3e59-9d17-d1505447aada",
                        "glosses": [
                            "Rendre précoce, ou plus précoce."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ed945260-3484-4a7f-a4dd-56222862efaa",
                                "sense_id": "da2d8eb1-04df-318a-909c-44e4dc7d732b",
                                "text": "Y a-t-il quelque chose à faire pour \"précociser\" son orgasme ?"
                            },
                            {
                                "example_id": "9953b52e-8451-4064-9898-ea399a76c9db",
                                "sense_id": "da2d8eb1-04df-318a-909c-44e4dc7d732b",
                                "text": "Privé d'un lien charnel important, l'enfant se précocise et ses autres intérêts sexuels s'éveillent beaucoup plus tôt."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c578bbb-479f-3cbe-a75b-1130b012c3f0",
                        "entry_id": "ddba9c4d-587a-3e59-9d17-d1505447aada",
                        "glosses": [
                            "Considérer comme précoce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26c4086-0c4e-4766-b40e-e03dc0fd91de",
                                "sense_id": "4c578bbb-479f-3cbe-a75b-1130b012c3f0",
                                "text": "On a tendance à \"précociser\" un peu trop et c'est vrai que le \"diagnostic\" doit être bien compliqué à établir."
                            }
                        ]
                    }
