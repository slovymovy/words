                "senses": [
                    {
                        "sense_id": "2efb44e4-a66d-37a5-a546-699fa8ff390f",
                        "entry_id": "dc813fd1-14b1-39d7-b3ce-d9047ec54108",
                        "glosses": [
                            "typische representant van een groep, kenmerkend voorbeeld uit een categorie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea56495d-b39c-4100-9d19-5c8540b2ecf6",
                                "sense_id": "2efb44e4-a66d-37a5-a546-699fa8ff390f",
                                "text": "Bijna vanzelfsprekend werd hij de leidende autoriteit op het gebied van coprolieten — versteende uitwerpselen — en hij bezat een tafel die geheel uit zijn verzameling specimens was opgebouwd."
                            },
                            {
                                "example_id": "75b30a91-2e2e-42eb-82c2-1ee4b92238fc",
                                "sense_id": "2efb44e4-a66d-37a5-a546-699fa8ff390f",
                                "text": "De schilder Mondriaan is ongetwijfeld een representatieve figuur onder de hedendaagsche schilders en als zoodanig is zijn werk een aanvulling; er is thans van vele 'richtingen' een specimen van hedendaagsche schilderkunst in ons raadhuis te vinden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "422187ff-061d-4b0a-9165-138d70dfb941",
                        "source_entry_id": "dc813fd1-14b1-39d7-b3ce-d9047ec54108",
                        "source_sense_id": "2efb44e4-a66d-37a5-a546-699fa8ff390f",
                        "source_sense_description": "exemplaar van een groep",
                        "target_lang_word": "sample",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sample",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f19ea70e-7926-34c8-9bd3-11cde77480ac",
                                        "entry_id": "60475795-0b01-3c6e-a439-9fe6c6467910",
                                        "glosses": [
                                            "A part or snippet of something taken or presented for inspection, or shown as evidence of the quality of the whole; a specimen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457b595d-b741-4f2d-b57a-b3d001679ae7",
                                                "sense_id": "f19ea70e-7926-34c8-9bd3-11cde77480ac",
                                                "text": "a blood sample"
                                            },
                                            {
                                                "example_id": "a5a10c7b-a8a1-4d34-920c-47e9178c2314",
                                                "sense_id": "f19ea70e-7926-34c8-9bd3-11cde77480ac",
                                                "text": "He looked down into Glen Doone first, and sniffed as if he were smelling it, like a sample of goods from a wholesale house; and then he looked at the hills over yonder, and then he stared at me."
                                            },
                                            {
                                                "example_id": "10d3c345-e941-48b5-a6bd-3550f73beb81",
                                                "sense_id": "f19ea70e-7926-34c8-9bd3-11cde77480ac",
                                                "text": "Then one day in May 2012, he picked up a free sample of a Vietnamese-language magazine based in New Jersey. In it, he saw an article about a career Navy officer named Kimberly Mitchell and her search into her past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521b6dd4-4ebd-3529-97d8-77b5484151e9",
                                        "entry_id": "60475795-0b01-3c6e-a439-9fe6c6467910",
                                        "glosses": [
                                            "A subset or portion of a population that is systematically selected for measurement, observation, or questioning, with the objective of generating statistical information that accurately reflects the characteristics of the entire population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a1bfd6-2484-4b2e-bce8-898b6f6d2fca",
                                                "sense_id": "521b6dd4-4ebd-3529-97d8-77b5484151e9",
                                                "text": "Large samples are generally more reliable than small samples due to having less variability."
                                            },
                                            {
                                                "example_id": "ac890511-cb22-4bd9-a4b5-c5c68833c925",
                                                "sense_id": "521b6dd4-4ebd-3529-97d8-77b5484151e9",
                                                "text": "It is interesting to find that, with the exception of a few imperfectly-observed South Sea Islanders, and whose actual numbers, if the measurements are correct, are very few, the English professional classes head the long list [in average height], and that the Anglo-Saxon race takes the chief place in it among the civilised communities, although it is possible it might stand second to the Scandinavian countries if a fair sample of their population were obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ce31937-8cb1-3b11-b68d-80b2998209d3",
                                        "entry_id": "60475795-0b01-3c6e-a439-9fe6c6467910",
                                        "glosses": [
                                            "A small quantity of food for tasting, typically given away for free."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd25e21b-ee0e-385b-921d-c0a93dc9b881",
                                        "entry_id": "60475795-0b01-3c6e-a439-9fe6c6467910",
                                        "glosses": [
                                            "A small piece of some goods, for determining quality, colour, etc., typically given away for free."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cce0727-590f-332b-9c34-f0f305855ced",
                                        "entry_id": "60475795-0b01-3c6e-a439-9fe6c6467910",
                                        "glosses": [
                                            "Gratuitous borrowing of easily recognised phases (or moments) from other music (or movies) in a recording."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acec5589-3fa2-4817-bffc-382d4a14e25c",
                                                "sense_id": "6cce0727-590f-332b-9c34-f0f305855ced",
                                                "text": "Jeffrey conceives a fascination with nightclub singer Dorothy Vallens (Isabella Rossellini) who sings Blue Velvet, while her abusive, misogynist sugar-daddy Frank (Dennis Hopper) watches, caressing a sample of this same material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b6d8534-766a-353e-b7bf-dc25aed67b57",
                                        "entry_id": "60475795-0b01-3c6e-a439-9fe6c6467910",
                                        "glosses": [
                                            "Example; pattern."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c45df550-433b-41a2-9d16-6539b2a77369",
                                                "sense_id": "7b6d8534-766a-353e-b7bf-dc25aed67b57",
                                                "text": "Thus he concludes, and euery hardie knight / His ſample follow’d, and his brethren twaine, / The other Princes put on harneſſe light, / As footmen vſe."
                                            },
                                            {
                                                "example_id": "e43b1d01-b030-4f46-adb9-b762cc6150e2",
                                                "sense_id": "7b6d8534-766a-353e-b7bf-dc25aed67b57",
                                                "text": "[The King] Liu’d in Court / (Which rare it is to do) moſt prais’d, moſt lou’d, / A ſample to the yongeſt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sample",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af2729c5-3e07-3423-9f91-ae8f1437212d",
                                        "entry_id": "98cc8c2d-24b3-392c-b2dd-fef05a6c346b",
                                        "glosses": [
                                            "To take or to test a sample or samples of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40a79d21-fb78-4aca-9b6f-69e4e9bf98b0",
                                                "sense_id": "af2729c5-3e07-3423-9f91-ae8f1437212d",
                                                "text": "They had just finished their breakfast, and the sight of the remains of it almost overpowered me. I could hardly keep my wits together in the presence of that food, but as I was not asked to sample it, I had to bear my trouble as best I could."
                                            },
                                            {
                                                "example_id": "e1230508-28e8-4e4c-8e0c-79f81e897868",
                                                "sense_id": "af2729c5-3e07-3423-9f91-ae8f1437212d",
                                                "text": "Mok was enjoying himself very much. It was not often that he had such an opportunity to sample the delights of Paris. His young master, Ralph, had given him strict orders never to go out at night, or in his leisure hours, unless accompanied by Cheditafa."
                                            },
                                            {
                                                "example_id": "84d70a67-1355-42fe-822b-9efb15c35eac",
                                                "sense_id": "af2729c5-3e07-3423-9f91-ae8f1437212d",
                                                "text": "It is certainly my personal favourite, for it was by way of Hardwick's great Doric arch that I first sampled the roar and clatter of London streets, the trip being a boyhood reward for achieving (unexpected) success in a school examination!"
                                            },
                                            {
                                                "example_id": "5598db95-2942-4919-847e-fbbaad60e741",
                                                "sense_id": "af2729c5-3e07-3423-9f91-ae8f1437212d",
                                                "text": "I did not really wonder, after sampling the \"Settebello's\" standards of comfort and service, that even on a midweek day in autumn there was not a seat to spare, despite the cost."
                                            },
                                            {
                                                "example_id": "3869f3bc-9a9d-4567-9e59-6c5905cddb95",
                                                "sense_id": "af2729c5-3e07-3423-9f91-ae8f1437212d",
                                                "text": "The Eyedropper tool allows you to sample colors from anywhere in your open InDesign documents (yes, even from placed images!) You can add a sampled color to the Swatches palette and then apply it to the fill or stroke of any frame, shape, path, line, or table."
                                            },
                                            {
                                                "example_id": "737589d7-0c93-4092-8363-2f50f0a9c6d9",
                                                "sense_id": "af2729c5-3e07-3423-9f91-ae8f1437212d",
                                                "text": "The Healing brush is similar to the Clone Stamp in that information is sampled by Alt-clicking and then painted into other parts of the image. The big difference is that the Healing brush attempts to make the sampled data match the lighting and shading of the area to which it's being applied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d83696c-657f-3afa-9998-94f81242a972",
                                        "entry_id": "98cc8c2d-24b3-392c-b2dd-fef05a6c346b",
                                        "glosses": [
                                            "To reduce a continuous signal (such as a sound wave) to a discrete signal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23d8656c-3231-35bd-aa9e-b95a3b70da02",
                                        "entry_id": "98cc8c2d-24b3-392c-b2dd-fef05a6c346b",
                                        "glosses": [
                                            "To reuse a portion of (an existing sound recording) in a new piece of music."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7bfa6bd-ca85-4230-be4f-77aadf79f6e9",
                                                "sense_id": "23d8656c-3231-35bd-aa9e-b95a3b70da02",
                                                "text": "To address this novel legal quandary, one legal treatise on copyright has developed the concept of fragmented literal similarity, a method of determining whether a sample-based work is substantially similar to the source it sampled. The name reflects the exactness of the similarity between the snippet of a track that is sampled and the sampled copy of that snippet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d9572d1-18b7-34d8-87c8-0f606b393a94",
                                        "entry_id": "98cc8c2d-24b3-392c-b2dd-fef05a6c346b",
                                        "glosses": [
                                            "To make or show something similar to a sample."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a6733b-ac77-4bf1-9b66-1b5041147646",
                                                "sense_id": "4d9572d1-18b7-34d8-87c8-0f606b393a94",
                                                "text": "It means that a larger image field can be sampled from a lower resolution copy without much loss in comparative data, only the number of data points to be manipulated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d98319f4-d005-4e7c-917f-01f67e94c1ec",
                        "source_entry_id": "dc813fd1-14b1-39d7-b3ce-d9047ec54108",
                        "source_sense_id": "2efb44e4-a66d-37a5-a546-699fa8ff390f",
                        "source_sense_description": "exemplaar van een groep",
                        "target_lang_word": "individual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "individual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05e141f6-e7b3-3be5-92f8-7d1d1536e381",
                                        "entry_id": "cee96f84-4d72-3b29-ac71-451b4cec496e",
                                        "glosses": [
                                            "A person considered alone, rather than as belonging to a group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bfa5cd-1758-45a0-a236-2f2f4c0f7682",
                                                "sense_id": "05e141f6-e7b3-3be5-92f8-7d1d1536e381",
                                                "text": "He is an unusual individual."
                                            },
                                            {
                                                "example_id": "6fd55b43-d12e-450e-bef0-fdd193be370c",
                                                "sense_id": "05e141f6-e7b3-3be5-92f8-7d1d1536e381",
                                                "text": "“You have to be an individual,” said Ms. Smoke, a 40-year-old saleswoman, as she sipped her beverage. “You can’t just get black coffee.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e34fe43-a994-39cc-8b65-3407cbd8c2b5",
                                        "entry_id": "cee96f84-4d72-3b29-ac71-451b4cec496e",
                                        "glosses": [
                                            "A single physical human being as a legal subject, as opposed to a legal person such as a corporation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af059a23-0987-4c39-ae5a-0e1b716a566e",
                                                "sense_id": "5e34fe43-a994-39cc-8b65-3407cbd8c2b5",
                                                "text": "Every individual is equal before and under the law and has the right to the equal protection and equal benefit of the law without discrimination […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc4e56c-9cc0-3bd3-931b-bee1c1ea0d35",
                                        "entry_id": "cee96f84-4d72-3b29-ac71-451b4cec496e",
                                        "glosses": [
                                            "An object, be it a thing or an agent, as contrasted to a class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21eb82bc-f04f-4de6-8abb-a9cfafbb984e",
                                                "sense_id": "6dc4e56c-9cc0-3bd3-931b-bee1c1ea0d35",
                                                "text": "It is typically held that chairs, trees, rocks, people and many of the so-called ‘everyday’ objects we encounter can be regarded as individuals."
                                            },
                                            {
                                                "example_id": "e6314225-76ac-468e-a9bd-e6c9ef5f61d1",
                                                "sense_id": "6dc4e56c-9cc0-3bd3-931b-bee1c1ea0d35",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1826bba4-8230-3448-b50b-656bf1898fa4",
                                        "entry_id": "cee96f84-4d72-3b29-ac71-451b4cec496e",
                                        "glosses": [
                                            "An element belonging to a population."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "individual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2371ac6e-13ec-32cd-a047-684cd5c2889d",
                                        "entry_id": "ff6d7ad4-9e45-3ee3-88df-edf499fac31e",
                                        "glosses": [
                                            "Relating to a single person or thing as opposed to more than one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "797cfa2a-0ff5-47f5-ac0b-0cc762ee1692",
                                                "sense_id": "2371ac6e-13ec-32cd-a047-684cd5c2889d",
                                                "text": "Near-synonyms: individuated, solitary, self-standing, freestanding"
                                            },
                                            {
                                                "example_id": "1e6950ff-0173-4b9e-83f4-e0a57c53f81b",
                                                "sense_id": "2371ac6e-13ec-32cd-a047-684cd5c2889d",
                                                "text": "As we can't print them all together, the individual pages will have to be printed one by one."
                                            },
                                            {
                                                "example_id": "d4e8f57f-5e23-49b5-ab1d-17e09e9138c8",
                                                "sense_id": "2371ac6e-13ec-32cd-a047-684cd5c2889d",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f5ca35-766b-3d44-a7f1-34600907598e",
                                        "entry_id": "ff6d7ad4-9e45-3ee3-88df-edf499fac31e",
                                        "glosses": [
                                            "Intended for a single person as opposed to more than one person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42aeea2b-1259-4d7e-80fe-0b85d60ef6b7",
                                                "sense_id": "35f5ca35-766b-3d44-a7f1-34600907598e",
                                                "text": "individual personal pension"
                                            },
                                            {
                                                "example_id": "3f4eca08-c685-4ff8-9bcc-3dc012efe427",
                                                "sense_id": "35f5ca35-766b-3d44-a7f1-34600907598e",
                                                "text": "individual cream cakes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21710f88-0bd0-3fb6-8e61-29ad40390f5d",
                                        "entry_id": "ff6d7ad4-9e45-3ee3-88df-edf499fac31e",
                                        "glosses": [
                                            "Not divisible without losing its identity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3a2001-7c4e-4a9d-b45a-aed11edaaef5",
                                                "sense_id": "21710f88-0bd0-3fb6-8e61-29ad40390f5d",
                                                "text": "Near-synonyms: unatomizable, indivisible, undividable"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
