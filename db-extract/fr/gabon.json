                "senses": [
                    {
                        "sense_id": "322504fd-7dfb-3f50-9a3c-ac879a51c85f",
                        "entry_id": "0f8c2ad0-0f57-307e-8581-8e0be76bdaaf",
                        "glosses": [
                            "Pays situé dans l’Ouest de l’Afrique centrale, et dont la capitale est Libreville."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "6a898e0f-65e7-420a-aeca-479654a80bff",
                                "sense_id": "322504fd-7dfb-3f50-9a3c-ac879a51c85f",
                                "text": "L’histoire de l’exploration du Gabon nous donne un exemple saillant de la gravité des erreurs que les explorateurs européens sont exposés à faire lorsqu’ils arrivent dans des régions inconnues."
                            },
                            {
                                "example_id": "d4f54f49-479a-4c84-9268-3dd94363c744",
                                "sense_id": "322504fd-7dfb-3f50-9a3c-ac879a51c85f",
                                "text": "Dès les premiers pas dans l'entrepôt, on découvre les placages (ou feuilles) d’okoumé en provenance du Gabon, épais de quelques millimètres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae009b4e-05b5-4d93-b4dc-72f914f4991d",
