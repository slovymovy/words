                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture_sowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>broadcast</w> of seeds must be done evenly for a good crop.",
                            "target_lang_translations": {
                                "ru": "<w>Посев вразброс</w> должен выполняться равномерно для хорошего урожая.",
                                "zh": "为了获得好收成，<w>撒播</w>种子必须均匀。"
                            }
                        },
                        {
                            "text": "Traditional methods often involved the manual <w>broadcast</w> of grain.",
                            "target_lang_translations": {
                                "ru": "Традиционные методы часто включали ручное <w>разбрасывание</w> зерна.",
                                "zh": "传统方法通常涉及手工<w>撒播</w>谷物。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "agricultural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс разбрасывания семян по большой площади.",
                        "zh": "在大面积范围内撒播种子的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посев вразброс",
                                "target_lang_sense_clarification": "агротехнический прием"
                            },
                            {
                                "target_lang_word": "разбрасывание",
                                "target_lang_sense_clarification": "действие по значению глагола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撒播",
                                "target_lang_sense_clarification": "播种方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
