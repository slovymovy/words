{
    "word_family": [
        "snug",
        "snugly",
        "snugness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a61e4bc7-27ae-3711-8476-bebd6584ba44",
                    "sense_definition": "To lie or press close together with another person or thing for warmth or affection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affectionate_closeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young couple decided to <w>snuggle</w> on the sofa while watching a movie.",
                            "target_lang_translations": {
                                "ru": "Молодая пара решила <w>прижаться</w> друг к другу на диване во время просмотра фильма."
                            }
                        },
                        {
                            "text": "The child likes to <w>snuggle</w> close to her mother when she feels cold.",
                            "target_lang_translations": {
                                "ru": "Ребенок любит <w>прижиматься</w> к матери, когда ему холодно."
                            }
                        }
                    ],
                    "synonyms": [
                        "cuddle"
                    ],
                    "common_phrases": [
                        "snuggle close",
                        "snuggle together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лежать или прижиматься близко к другому человеку или предмету для тепла или выражения нежности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прижиматься",
                                "target_lang_sense_clarification": "тесно прислоняться к кому-либо"
                            },
                            {
                                "target_lang_word": "обниматься",
                                "target_lang_sense_clarification": "заключать друг друга в объятия"
                            },
                            {
                                "target_lang_word": "прильнуть",
                                "target_lang_sense_clarification": "ласково прижаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aa84c38-c25b-3be2-af94-00615b082fef",
                    "sense_definition": "To move or settle oneself into a comfortable and cozy position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day of hiking, the children <w>snuggled</w> into their warm sleeping bags.",
                            "target_lang_translations": {
                                "ru": "После долгого дня в походе дети <w>уютно устроились</w> в своих теплых спальных мешках."
                            }
                        },
                        {
                            "text": "The cat will <w>snuggle</w> down into the pile of fresh laundry.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>зароется</w> в кучу чистого белья."
                            }
                        }
                    ],
                    "synonyms": [
                        "snug",
                        "snudge"
                    ],
                    "common_phrases": [
                        "snuggle down",
                        "snuggle into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устраиваться поудобнее, принимая комфортное и уютное положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уютно устроиться",
                                "target_lang_sense_clarification": "занять удобное положение"
                            },
                            {
                                "target_lang_word": "свернуться калачиком",
                                "target_lang_sense_clarification": "принять позу эмбриона для тепла"
                            },
                            {
                                "target_lang_word": "зарыться",
                                "target_lang_sense_clarification": "спрятаться во что-то мягкое"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "519d729e-3d89-32ed-98b4-2758d1814f30",
                    "sense_definition": "An act of hugging or lying close to someone in an affectionate way.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "affectionate_closeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler asked his father for a quick <w>snuggle</w> before going to bed.",
                            "target_lang_translations": {
                                "ru": "Малыш попросил папу немного <w>пообниматься</w> перед сном."
                            }
                        },
                        {
                            "text": "There is nothing better than a morning <w>snuggle</w> on a rainy Sunday.",
                            "target_lang_translations": {
                                "ru": "Нет ничего лучше утренних <w>объятий</w> в дождливое воскресенье."
                            }
                        }
                    ],
                    "synonyms": [
                        "cuddle",
                        "hug"
                    ],
                    "common_phrases": [
                        "morning snuggle",
                        "quick snuggle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт объятия или тесного прилегания к кому-либо в знак нежности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объятие",
                                "target_lang_sense_clarification": "проявление ласки"
                            },
                            {
                                "target_lang_word": "нежности",
                                "target_lang_sense_clarification": "ласковое поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74894c04-367a-3d27-b9f8-f2fe62c7b901",
                    "sense_definition": "The very last bit of liquid remaining at the bottom of a bottle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liquids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tilted the bottle back to get the last <w>snuggle</w> of whiskey.",
                            "target_lang_translations": {
                                "ru": "Он запрокинул бутылку, чтобы допить последний <w>глоток</w> виски."
                            }
                        },
                        {
                            "text": "There was only a tiny <w>snuggle</w> left in the wine bottle after the party.",
                            "target_lang_translations": {
                                "ru": "После вечеринки в бутылке вина остались лишь жалкие <w>капли</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sip"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "rare or regional usage for remnants of drink"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый последний остаток жидкости на дне бутылки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "последние капли на дне"
                            },
                            {
                                "target_lang_word": "глоток",
                                "target_lang_sense_clarification": "последняя порция напитка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}