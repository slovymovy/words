                                "target_lang_sense_clarification": "a general term for something built or constructed"
                            },
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "the act or result of building something"
                            },
                            {
                                "target_lang_word": "building",
                                "target_lang_sense_clarification": "a physical structure with a roof and walls"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dcf7bee-4b38-3b46-8375-5518af73aaea",
                    "sense_definition": "Een bouwwerk dat niet erg stevig of nuttig is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hele wijk staat vol met lelijke <w>bouwsels</w> die niet voldoen aan de veiligheidseisen.",
                            "target_lang_translations": {
                                "en": "The whole neighborhood is full of ugly <w>structures</w> that do not meet safety requirements."
                            }
                        },
                        {
                            "text": "Het is zonde dat het landschap wordt ontsierd door dergelijke wankele <w>bouwsels</w>.",
                            "target_lang_translations": {
