                                    {
                                        "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                                        "entry_id": "ee32020f-8859-3714-a5ce-f2475b42420d",
                                        "glosses": [
                                            "symbolischer Preis, den der Verlierer erhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db4f2fd-0ae9-4410-b4ef-86042c239df1",
                                                "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                                                "text": "Mit dem Trostpreis war Ralf nicht zufrieden, lieber hätte er das Spiel gewonnen."
                                            },
                                            {
                                                "example_id": "f6a844f8-9fb8-4f46-9e2d-1b57ac34c9e0",
                                                "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                                                "text": "Der Sieger erhielt eine Medaille, und die anderen Teilnehmer des Wettbewerbs gingen mit einem Trostpreis nach Hause."
                                            },
                                            {
                                                "example_id": "c12185bd-8da9-4d04-9cea-2d550b92aa08",
                                                "sense_id": "4fed6e56-1236-33f6-ac89-453e98eac5d8",
                                                "text": "Der Hauptpreis ist schon verlost, aber es sind noch jede Menge Trostpreise zu vergeben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59555e14-3a0b-4d76-8d75-88775147f77d",
                        "source_entry_id": "cf171079-8aac-36c7-b627-c3c94fa87e01",
                        "source_sense_description": "unfavorable card or token",
                        "target_lang_word": "Arschkarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arschkarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                        "entry_id": "0730b95e-7525-3ffb-8d4b-6acf46ca9e08",
                                        "glosses": [
                                            "Pech, Missgeschick"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa26408-0323-4c84-8edc-bd4a65762f08",
                                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                                "text": "„Ich war es schon gewohnt, wenn Arschkarten verteilt wurden, eine davon zu erhalten.“"
                                            },
                                            {
                                                "example_id": "55b1aede-dd47-495f-9315-574af12b5bcd",
                                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                                "text": "Wer so viel Unsinn macht, hat bei uns die Arschkarte gezogen."
                                            },
                                            {
                                                "example_id": "cc61edc1-9536-4c04-9723-56fefaa17bf3",
                                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                                "text": "„Paul war auch bei diesem Treffen dabei, natürlich, und ich fühlte mich nicht nur[,] als hätte ich mir die Arschkarte selbst ausgesucht, sondern als wären alle Arschkarten der Welt auf einmal auf mich eingestürzt und hätten mich unter sich begraben.“"
                                            },
                                            {
                                                "example_id": "6ee07b38-b853-4753-bcfe-f691cb07e08e",
                                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                                "text": "„Die Arschkarte stammt also auch als geflügeltes Wort aus dem Fußball und wird heute aufs gesamte Pech im Leben bezogen.“"
                                            },
                                            {
                                                "example_id": "74a9837a-9d6b-41fb-bede-62adc8bfc78b",
                                                "sense_id": "01a347f0-bebf-377b-ae3d-885cba10d305",
                                                "text": "„Ich sollte nicht allzu sehr schwärmen, jetzt, unmittelbar nachdem er die Arschkarte gezogen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
