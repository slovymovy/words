                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9241b0ca-7192-492b-9b47-26aa03c67f03",
                                                "sense_id": "dd93f79d-7db5-3667-97da-572e26f96754",
                                                "text": "Температура резко снизилась."
                                            },
                                            {
                                                "example_id": "e949aa80-7325-4247-98e1-7d9044a61bff",
                                                "sense_id": "dd93f79d-7db5-3667-97da-572e26f96754",
                                                "text": "Погода резко изменилась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "823d64d0-d9dd-3038-8d56-43a9b8ef7c78",
                                        "entry_id": "79d9b313-56b4-366a-93e9-8791d376cc6e",
                                        "glosses": [
                                            "очень сильно, ощутимо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fec44e1-95d0-4fd9-82b5-d74de504c7ce",
                                                "sense_id": "823d64d0-d9dd-3038-8d56-43a9b8ef7c78",
                                                "text": "От него резко пахло муравьиным спиртом."
                                            },
                                            {
                                                "example_id": "741c0a7f-fb21-42dc-bd86-a58048ffc16f",
                                                "sense_id": "823d64d0-d9dd-3038-8d56-43a9b8ef7c78",
                                                "text": "Казахстанцы резко раскритиковали введение штрафов в отношении родителей шестилеток, не пошедших в школу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d067f0a1-4348-34ef-ae33-a601e8ed0fcc",
                                        "entry_id": "79d9b313-56b4-366a-93e9-8791d376cc6e",
                                        "glosses": [
                                            "без плавных переходов, отрывисто"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdbe356e-bd00-4364-a5ce-7042580b3225",
                                                "sense_id": "d067f0a1-4348-34ef-ae33-a601e8ed0fcc",
                                                "text": "И атмосфера панихиды резко сменяется праздником коммунальной кухни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6762719-c70e-3ebf-bcff-4ae3e169ed63",
                                        "entry_id": "79d9b313-56b4-366a-93e9-8791d376cc6e",
                                        "glosses": [
                                            "ясно, отчётливо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d93081-7419-4a97-b46d-27a00c89764b",
                                                "sense_id": "b6762719-c70e-3ebf-bcff-4ae3e169ed63",
                                                "text": "Позади резко выделялся очень высокий руль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f61b91-3d27-37b3-8d92-1b7bb734e67e",
                                        "entry_id": "79d9b313-56b4-366a-93e9-8791d376cc6e",
                                        "glosses": [
                                            "грубо, порывисто, с прямотой, нелицеприятно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c79925c1-85f5-45e0-ae21-0e62414deb93",
                                                "sense_id": "09f61b91-3d27-37b3-8d92-1b7bb734e67e",
                                                "text": "Он резко отзывался о русской литературе."
                                            },
                                            {
                                                "example_id": "11739757-1382-40a3-8878-1cb7d482ad46",
                                                "sense_id": "09f61b91-3d27-37b3-8d92-1b7bb734e67e",
                                                "text": "Вам что надо? — вдруг отчеканил он резко, ставя блюдце на стол."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
