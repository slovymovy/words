                                                "sense_id": "90f2d312-3133-3de0-b543-e521979df241",
                                                "text": "Une assiette de vermicelle."
                                            },
                                            {
                                                "example_id": "00df3687-4a2e-42a0-aafd-fa8daab4d3ce",
                                                "sense_id": "90f2d312-3133-3de0-b543-e521979df241",
                                                "text": "Vermicelle au gras, au maigre, au lait."
                                            }
                                        ]
                                    },
