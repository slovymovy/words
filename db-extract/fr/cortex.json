                    {
                        "translation_id": "a4f5c093-2c16-459a-b7f6-9dd63206392e",
                        "source_entry_id": "fab48757-b8ab-3546-bffc-32de26ff49aa",
                        "source_sense_description": "enveloppe anatomique",
                        "target_lang_word": "hersenschors",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hersenschors",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "94a2c10d-3649-36e5-a197-8a8429f0baf7",
                                        "entry_id": "0f1d8986-b818-3bf2-a332-23a7935b9f25",
                                        "glosses": [
                                            "de buitenste laag van de grote hersenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da2916ad-09de-44dc-bd30-525fb4812764",
                                                "sense_id": "94a2c10d-3649-36e5-a197-8a8429f0baf7",
                                                "text": "ALS is een (zeldzame) zenuwziekte waarbij zenuwcellen uit het ruggenmerg, de hersenstam en de motorische hersenschors geleidelijk aan afsterven. Patiënten verliezen daardoor de controle over hun spieren en overlijden doorgaans door verstikking, wanneer ook hun ademhalingsspieren het begeven."
                                            },
                                            {
                                                "example_id": "0290a534-0537-415d-9151-134f7e87fe64",
                                                "sense_id": "94a2c10d-3649-36e5-a197-8a8429f0baf7",
                                                "text": "Door het fijnstof kan er een dunnere hersenschors kan ontstaan. Dat heeft gevolgen voor de structuur en de werking van de hersenen op latere leeftijd. Het gevaar bestaat 'zelfs bij de als veilig veronderstelde huidige normen voor luchtverontreiniging', voegen de onderzoekers eraan toe."
                                            },
                                            {
                                                "example_id": "3f377312-4298-46a2-b72a-9b030065275c",
                                                "sense_id": "94a2c10d-3649-36e5-a197-8a8429f0baf7",
                                                "text": "Wetenschappers zijn erachter gekomen dat drie verschillende hersenaandoeningen 80 procent van alle epilepsiegevallen veroorzaken. De boosdoeners zijn volgens Maastricht UMC+ langzaam groeiende hersentumoren, aangeboren stoornissen van de hersenschors of een verharding in een bepaald deel van de hersenen (de hippocampus)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
