                                    {
                                        "sense_id": "aa40b5b9-2069-3b26-82bb-276c91ffe209",
                                        "entry_id": "13b044bb-8c3a-37ca-93b6-0eb6fe25f6e2",
                                        "glosses": [
                                            "A small piece; a fragment."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46fda886-4743-4ead-95dc-314a1009ca95",
                                                "sense_id": "aa40b5b9-2069-3b26-82bb-276c91ffe209",
                                                "text": "O ſhe tore the letter into a thouſand halfpence, raild at her ſelf, that ſhe ſhould be ſo immodeſt to vvrite, to one that ſhe knevv vvould flout her, […]"
                                            }
