                                    {
                                        "sense_id": "288a2803-e23c-3bc1-ba23-eed68e7c949d",
                                        "entry_id": "7687a247-c311-30b6-a9d6-c589affc1c99",
                                        "glosses": [
                                            "A mark on a graph or chart corresponding to a piece of data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac94bb31-edac-4286-8511-f9f53400cec3",
                                                "sense_id": "288a2803-e23c-3bc1-ba23-eed68e7c949d",
                                                "text": "Could you make all the yellow data points bigger?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35551616-a910-31ee-b526-265a74cb14bf",
                                        "entry_id": "7687a247-c311-30b6-a9d6-c589affc1c99",
                                        "glosses": [
                                            "The datum that the mark represents; a single piece of information."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e721c3-72fe-4211-8732-1994342a72a2",
                                                "sense_id": "35551616-a910-31ee-b526-265a74cb14bf",
                                                "text": "I think the third data point is inaccurate. Let's measure it again."
                                            },
                                            {
                                                "example_id": "d19e38a5-3919-431a-88db-1147e2651ef5",
                                                "sense_id": "35551616-a910-31ee-b526-265a74cb14bf",
                                                "text": "Each time a language was recognised, a data point was recorded, and attention was switched to collecting the next data point."
                                            },
                                            {
                                                "example_id": "50983d6d-2ed7-4d4a-870d-c7267f59b1b6",
                                                "sense_id": "35551616-a910-31ee-b526-265a74cb14bf",
                                                "text": "Test scores are just one imperfect data point, and none of this is to suggest Seattle schools don’t have problems. These scores still show a decline, and more than 3,000 students have left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "010a74a7-4902-330c-bf66-f259f7219441",
                                        "entry_id": "7687a247-c311-30b6-a9d6-c589affc1c99",
                                        "glosses": [
                                            "A socket for connecting to a phone line or other electronic network."
                                        ],
