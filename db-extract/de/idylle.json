                    }
                ],
                "senses": [
                    {
                        "sense_id": "b80415b3-d416-3c71-8651-d818c1c7b61b",
                        "entry_id": "d6fe3d70-478d-3b1f-9666-6977f6f5300f",
                        "glosses": [
                            "paradiesisch anmutende Landschaft, paradiesisch anmutendes einfaches Leben"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "13e2c163-b60e-425f-b3ff-960f886674fc",
                                "sense_id": "b80415b3-d416-3c71-8651-d818c1c7b61b",
                                "text": "„So bilden die Wilhelm-Busch-Mühle, das Brotmuseum und die intakte dörfliche Idylle eine dermaßen vom Geist der Geschichte durchdrungene Einheit, dass Ebergötzen seit einigen Jahren mit dem selbstverliehenen Titel »Museumsdorf« eine jährlich immer zahlreicher werdende Fangemeinde anlockt.“"
                            },
                            {
                                "example_id": "84d5d077-2c97-4405-b538-9337fa88d6a7",
                                "sense_id": "b80415b3-d416-3c71-8651-d818c1c7b61b",
                                "text": "„So schön klingt die Idylle einer vergangenen Zeit, lieblich und süß, froh und heiter.“"
                            },
                            {
                                "example_id": "99e7614a-ac44-4efd-baa9-ffdad8fc475f",
                                "sense_id": "b80415b3-d416-3c71-8651-d818c1c7b61b",
                                "text": "„Doch diese Idylle währte nicht allzu lang."
                            },
                            {
                                "example_id": "1ed06eb0-12a2-4809-8cce-a498e6f20f2f",
                                "sense_id": "b80415b3-d416-3c71-8651-d818c1c7b61b",
                                "text": "„Das goldene Zeitalter ist eine Idylle hinter der Mauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6215911-523c-3921-bd82-dd75d8f7016c",
                        "entry_id": "d6fe3d70-478d-3b1f-9666-6977f6f5300f",
                        "glosses": [
                            "literarische Gattung/Gemälde, worin das paradiesisch ländliche Leben einfacher Menschen geschildert wird"
                        ],
                        "tags": [
                            "Malerei"
                        ],
                        "examples": [
                            {
                                "example_id": "ea123340-fdf0-451b-93ae-fdce78d4440b",
                                "sense_id": "e6215911-523c-3921-bd82-dd75d8f7016c",
                                "text": "„Ich habe darüber eine Idylle in Form einer Ekloge geschrieben, die mir noch heute Tränen in die Augen treibt, sooft ich sie lese.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
