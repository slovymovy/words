    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fd3f88f4-48bb-38f4-96b3-fd9d236a52a3",
                "word": "poetaster",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cc49ac54-cacf-4d28-aa53-2054ff8469e0",
                        "entry_id": "fd3f88f4-48bb-38f4-96b3-fd9d236a52a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "poetasters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0057d73-e6d1-3430-b61d-5eec790931ed",
                        "entry_id": "fd3f88f4-48bb-38f4-96b3-fd9d236a52a3",
                        "glosses": [
                            "An unskilled poet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d11e278-a33a-4b1a-8fb6-139b3555aa4f",
                                "sense_id": "c0057d73-e6d1-3430-b61d-5eec790931ed",
                                "text": "Where the personal feelings were not engaged, it was also an agreeable pastime to follow his destructive feats; see him annihilate a poetaster, or insinuate away the pretensions of a book-wright."
                            },
                            {
                                "example_id": "680150f3-24ff-4969-a690-24914cae20b0",
                                "sense_id": "c0057d73-e6d1-3430-b61d-5eec790931ed",
                                "text": "Innumerable poetasters of the early eighteenth century enjoyed fame in their day and some possessed talent; but the obscure and trivial style of the age from which they could not free themselves deprived them of any chance of enduring fame."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dc8afed-bb0c-4766-ba5e-6473b1f49d77",
                        "source_entry_id": "fd3f88f4-48bb-38f4-96b3-fd9d236a52a3",
                        "source_sense_id": "c0057d73-e6d1-3430-b61d-5eec790931ed",
                        "source_sense_description": "unskilled poet",
                        "target_lang_word": "poétastre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poétastre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb24662-da85-39aa-8fda-f5ab793cc738",
                                        "entry_id": "f5639c73-e639-3b03-860a-a635e3e960e6",
                                        "glosses": [
                                            "Poète médiocre, mauvais poète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81482b9c-0e06-4931-8c03-7b72da9a45a6",
                                                "sense_id": "ddb24662-da85-39aa-8fda-f5ab793cc738",
                                                "text": "Nul remords, nul regret vrai, nul désastre !\nC’est effrayant ce que nous nous sentons\nD’affinités avecque les moutons\nEnrubannées du pire poétastre."
                                            },
                                            {
                                                "example_id": "6a2661ff-aa0b-46db-828f-9fa4506e343b",
                                                "sense_id": "ddb24662-da85-39aa-8fda-f5ab793cc738",
                                                "text": "Vous savez comme moi, Madame,\nQue Platon fout hors des cités\nLe Poétastre qui déclame\nDes blagues trop fortes pour l’âme\nAmoureuse de vérités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acc2227a-eeae-40c9-9c4d-0c0a4ac6919a",
                        "source_entry_id": "fd3f88f4-48bb-38f4-96b3-fd9d236a52a3",
                        "source_sense_id": "c0057d73-e6d1-3430-b61d-5eec790931ed",
                        "source_sense_description": "unskilled poet",
                        "target_lang_word": "rimailleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rimailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "942fc20a-f5cb-3cfa-a03e-93ff43ecf0f9",
                                        "entry_id": "06bfd799-4edb-3469-a470-305ec0958816",
                                        "glosses": [
                                            "Poète qui fait de mauvais vers."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c7377a-154e-4ee1-bdf0-19410125e95b",
                                                "sense_id": "942fc20a-f5cb-3cfa-a03e-93ff43ecf0f9",
                                                "text": "Ce n’est qu’un rimailleur."
                                            },
                                            {
                                                "example_id": "bc7c45c1-cd36-4181-b6e5-3b0b6fd41346",
                                                "sense_id": "942fc20a-f5cb-3cfa-a03e-93ff43ecf0f9",
                                                "text": "C’est un plat rimailleur."
                                            },
                                            {
                                                "example_id": "84097cee-9057-4d71-9987-13b39777c66d",
                                                "sense_id": "942fc20a-f5cb-3cfa-a03e-93ff43ecf0f9",
                                                "text": "Elever la préciosité au rang de panacée de l’écriture risque de noyer le rimailleur dans un océan de snobisme culturel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b571035-1d46-3e00-b37a-da22a23d99ce",
                                        "entry_id": "06bfd799-4edb-3469-a470-305ec0958816",
                                        "glosses": [
                                            "(Poésie) Troubadour qui compose des vers."
                                        ],
