                                        "entry_id": "c61192c7-2eda-33a1-8cdb-221cb4043bc9",
                                        "glosses": [
                                            "Of or pertaining to Greek or Roman culture."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a91a0b3f-3f81-49e4-95f3-2097edfee190",
                                                "sense_id": "a33f0201-2f15-32a3-bfc8-bbc22e7709f2",
                                                "text": "In the beginning and height of the Greco-Roman civilization, everyone was expected to have courage, because it was deemed to be the First Virtue above all others."
                                            }
                                        ]
                                    },
