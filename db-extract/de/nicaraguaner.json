                                "sense_id": "951544b5-f8ac-3e99-a469-e7b462a49d08",
                                "text": "Sie ist Guatemaltekin, er ist Nicaraguaner."
                            },
                            {
                                "example_id": "f5ddb046-0ef8-49d4-a401-057f8c63aae6",
                                "sense_id": "951544b5-f8ac-3e99-a469-e7b462a49d08",
                                "text": "Viele Nicaraguaner sind nach Costa Rica oder in den USA gezogen."
