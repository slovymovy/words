{
    "word_family": [
        "cupboard-love"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                    "sense_definition": "A piece of furniture with shelves and doors, used for storing food, dishes, or other household items.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "storage furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the clean plates back into the <w>cupboard</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убери чистые тарелки обратно в <w>шкаф</w>."
                            }
                        },
                        {
                            "text": "The <w>kitchen</w> <w>cupboard</w> is full of snacks and canned goods.",
                            "target_lang_translations": {
                                "ru": "Кухонный <w>шкафчик</w> полон перекусов и консервов."
                            }
                        }
                    ],
                    "synonyms": [
                        "pantry",
                        "larder"
                    ],
                    "common_phrases": [
                        "kitchen cupboard",
                        "cupboard door",
                        "empty cupboard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет мебели с полками и дверцами, используемый для хранения продуктов, посуды или других хозяйственных принадлежностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкаф",
                                "target_lang_sense_clarification": "общий термин для мебели с дверцами"
                            },
                            {
                                "target_lang_word": "кухонный шкаф",
                                "target_lang_sense_clarification": "специально для кухни"
                            },
                            {
                                "target_lang_word": "буфет",
                                "target_lang_sense_clarification": "для посуды и продуктов"
                            },
                            {
                                "target_lang_word": "сервант",
                                "target_lang_sense_clarification": "низкий шкаф для посуды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6b18880-8b1d-3023-adfc-2794aa834b76",
                    "sense_definition": "A small room or closet used for storing clothes, especially coats.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "storage furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hung my heavy winter coat in the <w>cupboard</w> by the front door.",
                            "target_lang_translations": {
                                "ru": "Я повесил свое тяжелое зимнее пальто в <w>шкаф</w> у входной двери."
                            }
                        },
                        {
                            "text": "The <w>hall</w> <w>cupboard</w> is where we keep all our umbrellas and boots.",
                            "target_lang_translations": {
                                "ru": "В <w>чулане</w> в прихожей мы храним все наши зонты и ботинки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hall cupboard",
                        "coat cupboard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое помещение или встроенный шкаф, используемый для хранения одежды, особенно пальто."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чулан",
                                "target_lang_sense_clarification": "подсобное помещение"
                            },
                            {
                                "target_lang_word": "встроенный шкаф",
                                "target_lang_sense_clarification": "в стене"
                            },
                            {
                                "target_lang_word": "гардероб",
                                "target_lang_sense_clarification": "для одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2fb50c5-29ba-30fe-8cf2-d3cfddb973d4",
                    "sense_definition": "A sideboard or table used to display valuable dishware or silver plate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "storage furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grand dining room featured a large <w>cupboard</w> displaying the family's finest silver.",
                            "target_lang_translations": {
                                "ru": "В величественной столовой стоял большой <w>сервант</w>, в котором было выставлено лучшее фамильное серебро."
                            }
                        },
                        {
                            "text": "In the old manor, a <w>cupboard</w> of plate stood beside the long oak table.",
                            "target_lang_translations": {
                                "ru": "В старинном поместье рядом с длинным дубовым столом стоял <w>поставец</w> с посудой."
                            }
                        }
                    ],
                    "synonyms": [
                        "sideboard"
                    ],
                    "common_phrases": [
                        "cupboard of plate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical use for display furniture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сервант или стол, используемый для демонстрации ценной посуды или столового серебра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сервант",
                                "target_lang_sense_clarification": "для демонстрации посуды"
                            },
                            {
                                "target_lang_word": "горка",
                                "target_lang_sense_clarification": "шкаф-витрина для посуды"
                            },
                            {
                                "target_lang_word": "поставец",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5fedd9b5-664f-3739-9107-d7e41583e483",
                    "sense_definition": "To collect or store something away as if in a cupboard; to hoard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "storing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of <w>cupboarding</w> the supplies while others went hungry.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он <w>припрятывал</w> припасы, пока другие голодали."
                            }
                        },
                        {
                            "text": "The greedy merchant would <w>cupboard</w> his wealth rather than invest it.",
                            "target_lang_translations": {
                                "ru": "Жадный купец скорее стал бы <w>копить</w> свое богатство, чем инвестировать его."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать или прятать что-либо, как в шкаф; копить или припрятывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припрятывать",
                                "target_lang_sense_clarification": "скрывать запасы"
                            },
                            {
                                "target_lang_word": "копить",
                                "target_lang_sense_clarification": "собирать впрок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}