    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5073e124-e9e2-362c-99af-a2ab6c4ccc53",
                    "sense_definition": "Chacune des parties poétiques ou strophes qui composent une chanson, généralement de même mètre et alternant avec le refrain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le public chantait le refrain, mais personne ne se souvenait du deuxième <w>couplet</w>."
                        },
                        {
                            "text": "L'artiste a composé un dernier <w>couplet</w> pour rendre un hommage émouvant à sa ville natale."
                        }
                    ],
                    "synonyms": [
                        "strophe"
                    ],
                    "antonyms": [
                        "refrain"
                    ],
                    "common_phrases": [
                        "chanter un couplet"
                    ]
                },
                {
                    "sense_id": "71d58344-c066-384c-86ad-a33075f39b9f",
                    "sense_definition": "Tirade ou développement oratoire récurrent et convenu sur un sujet particulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur nous a encore servi son habituel <w>couplet</w> sur la rigueur et la ponctualité."
                        },
                        {
                            "text": "Elle a patiemment écouté son voisin sans l'interrompre pendant son long <w>couplet</w> nostalgique."
                        }
                    ],
                    "synonyms": [
                        "tirade",
                        "rengaine",
                        "sermon"
                    ],
                    "common_phrases": [
                        "sortir son couplet",
                        "servir un couplet"
                    ]
                },
                {
                    "sense_id": "6643bb76-9be0-3f2a-b1ae-395ebfd3fdc8",
                    "sense_definition": "Groupe de deux vers consécutifs rimant ensemble, formant une unité de sens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "poesie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poème classique se termine par un <w>couplet</w> rimé qui résume l'idée maîtresse."
                        },
                        {
                            "text": "L'étudiant a analysé la structure rythmique de chaque <w>couplet</w> dans l'œuvre de l'auteur."
                        }
                    ],
                    "synonyms": [
                        "distique"
                    ]
                },
                {
                    "sense_id": "77af1e4b-320b-368a-9d49-fdbce4ada1b3",
                    "sense_definition": "Pièce de quincaillerie formée de deux branches de fer réunies par une charnière, servant à articuler un battant ou un couvercle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier a fixé un solide <w>couplet</w> métallique pour maintenir le couvercle de la boîte."
                        },
                        {
                            "text": "La vieille malle s'ouvrait difficilement à cause d'un <w>couplet</w> entièrement rouillé par l'humidité."
                        }
                    ],
                    "synonyms": [
                        "charnière",
                        "penture"
                    ]
                }
            ]
        }
    ]
}