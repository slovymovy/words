                    {
                        "sense_id": "e46810ef-70fe-3b58-9671-156ba1acb3c9",
                        "entry_id": "fc677253-5fcf-38b3-bb2d-1559a0bb0ed1",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße riesige (kolossale) Ausprägung zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44081461-2bf8-4f4a-b90e-d674255f4c98",
                                "sense_id": "e46810ef-70fe-3b58-9671-156ba1acb3c9",
                                "text": "„Da hatte ich sie nun vor mir, förmlich in Reih und Glied aufgestellt, die berühmten Schanzelweiber, berühmt ob der Kolossalität ihrer Leibesformen und nicht minder ob der Kolossalität der Derbheit ihrer Ausdrucksformen, wenn sie gereizt werden oder sonst in schlechter Laune sind.“"
                            },
                            {
                                "example_id": "05102e3b-eb26-4abb-a353-b81d75fc3a1a",
                                "sense_id": "e46810ef-70fe-3b58-9671-156ba1acb3c9",
                                "text": "„Hätte sich dieser bronzene Koloß in seiner übertrumpfenden Kolossalität nicht selbst ins Reich der Utopie verwiesen, wäre Fontainebleau mit ihm endgültig zu einem zweiten Rom geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
