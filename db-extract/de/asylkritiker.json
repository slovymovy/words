                ],
                "senses": [
                    {
                        "sense_id": "97882efa-152d-3fde-b876-fcecff77588c",
                        "entry_id": "18ec657f-58eb-3d4b-8e80-8632b69a93fc",
                        "glosses": [
                            "Person, die sich gegen den Schutz und die Aufnahme von hilfsbedürftigen Flüchtlingen ausspricht beziehungsweise Gewalt gegen jene fordert oder ausübt"
                        ],
                        "tags": [
                            "euphemistisch"
                        ],
                        "examples": [
                            {
                                "example_id": "cf1fce22-95d0-4eb3-bcdb-24f36b807c36",
                                "sense_id": "97882efa-152d-3fde-b876-fcecff77588c",
                                "text": "„Mittlerweile sind für diesen Mob, der da seine Ressentiments durch die Straßen trägt, die Wörter \"Asylkritiker\" oder \"Asylgegner\" üblich geworden – Begriffe, die sich diese Gruppen selbst zueignen und die mit den \"Asylbefürwortern\" ein neues Begriffspaar bilden.“"
                            },
                            {
                                "example_id": "2cd1b65e-4082-4484-8771-7a5622f70fa0",
                                "sense_id": "97882efa-152d-3fde-b876-fcecff77588c",
                                "text": "„Selbsternannten Asylkritikern ist kein Argument zu wirr, um gegen Flüchtlinge zu hetzen.“"
                            },
                            {
                                "example_id": "22adb373-8f1a-446d-a776-47557a239541",
                                "sense_id": "97882efa-152d-3fde-b876-fcecff77588c",
                                "text": "„Woher kommen solche zynische Verzerrungen der Fakten? Für viele \"Asylkritiker\" planen westeuropäische Regierungen mithilfe von Medien einen \"Bevölkerungsaustausch\".“"
                            },
                            {
                                "example_id": "bd2244ca-a943-4608-9ff6-257cf5aa647b",
                                "sense_id": "97882efa-152d-3fde-b876-fcecff77588c",
                                "text": "„Die sogenannten Asylkritiker, die mit Brandanschlägen und Naziparolen auf sich aufmerksam machen, sind keine lokal begrenzte Erscheinung.“"
                            },
                            {
                                "example_id": "2d0fd14a-e7bb-4e8c-acb3-c1bc11c25415",
                                "sense_id": "97882efa-152d-3fde-b876-fcecff77588c",
                                "text": "„Özoguz äußerte sich „entsetzt“ über das Ausmaß der Ausschreitungen. „Für mich sind Menschen, die derart gegen Schutzsuchende hetzen, keine 'Asylkritiker', wir müssen hier ganz klar von Extremisten sprechen“, sagte sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
