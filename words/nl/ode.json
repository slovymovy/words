                    "sense_id": "cac7f330-ebd1-3646-bf88-a84c8a514706",
                    "sense_definition": "Een lyrisch gedicht, meestal geschreven ter ere van een persoon, zaak of gebeurtenis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dichter schreef een prachtige <w>ode</w> aan de schoonheid van de natuur.",
                            "target_lang_translations": {
                                "en": "The poet wrote a beautiful <w>ode</w> to the beauty of nature."
                            }
                        },
                        {
                            "text": "Tijdens de ceremonie droeg zij een plechtige <w>ode</w> voor aan de overleden koning.",
                            "target_lang_translations": {
                                "en": "During the ceremony, she recited a solemn <w>ode</w> to the deceased king."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerdicht",
                        "lofdicht"
                    ],
                    "common_phrases": [
                        "een ode brengen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "A lyric poem, usually written in honor of a person, thing, or event."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ode",
                                "target_lang_sense_clarification": "a lyric poem of praise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dffe2ee-0529-3960-a5fc-27aac6575529",
                    "sense_definition": "Een loflied of lofzang ter verheerlijking van iemand of iets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het koor zong een indrukwekkende <w>ode</w> ter ere van de overwinning.",
                            "target_lang_translations": {
                                "en": "The choir sang an impressive <w>ode</w> in honor of the victory."
                            }
                        },
                        {
                            "text": "Zijn nieuwste compositie is een muzikale <w>ode</w> aan zijn geboortestad.",
                            "target_lang_translations": {
                                "en": "His latest composition is a musical <w>ode</w> to his hometown."
