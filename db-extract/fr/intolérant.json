                        ],
                        "form": "intolérante"
                    },
                    {
                        "form_id": "cf6188a6-5503-4b7d-bc9d-186cf40d4162",
                        "entry_id": "420862f4-a979-30af-bd6e-5e0c8cde4f73",
                        "tags": [
