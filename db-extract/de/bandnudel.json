                    {
                        "sense_id": "95187eda-1e68-3e62-8b73-b9e20a90eafd",
                        "entry_id": "5227e27d-94a2-3784-ab6f-6e7dab34d25c",
                        "glosses": [
                            "breite, flache und lange Nudel, deren Form an ein Band erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5917ac2a-93b5-439e-845b-804b87d2f455",
                                "sense_id": "95187eda-1e68-3e62-8b73-b9e20a90eafd",
                                "text": "Zu den gebratenen Hühnerbruststreifen reichen wir eine Tomatensauce und Bandnudeln oder auf Wunsch Farfalle."
                            },
                            {
                                "example_id": "eb688c44-49a7-4618-9d78-850f905e1496",
                                "sense_id": "95187eda-1e68-3e62-8b73-b9e20a90eafd",
                                "text": "„Sie, die Suppe, wird auf Basis von Kokosmilch und Chili zubereitet und enthält typischerweise Reisnudeln oder auch Bandnudeln, Gemüse, Fisch und Krabben.“"
                            },
                            {
                                "example_id": "c7fd4451-1f6d-4f8c-8c0a-dcfcb7f1fefc",
                                "sense_id": "95187eda-1e68-3e62-8b73-b9e20a90eafd",
                                "text": "Morgen kochen wir Bandnudeln."
                            }
                        ],
