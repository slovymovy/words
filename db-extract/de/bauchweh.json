                ],
                "senses": [
                    {
                        "sense_id": "b13c5e96-9f7a-3c58-92d6-cad846b6517b",
                        "entry_id": "2bf86dc8-b5df-3595-a068-c81033a6cbde",
                        "glosses": [
                            "Schmerzgefühl im Bauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e48b9e7-cc89-4ddd-8cfd-bc918154cbea",
                                "sense_id": "b13c5e96-9f7a-3c58-92d6-cad846b6517b",
                                "text": "„Hat Ihr Kind aber regelmäßig Bauchweh, insbesondere morgens nach dem Trinken der Milch, dann sollten Sie Ihren Kinderarzt aufsuchen und überprüfen lassen, ob eine Laktoseintoleranz vorliegt.“"
                            },
                            {
                                "example_id": "5b39ce5f-2a71-4882-9630-a5a0aed23ae9",
                                "sense_id": "b13c5e96-9f7a-3c58-92d6-cad846b6517b",
                                "text": "„Ratzfatz wieder gesund Fieber, Schnupfnase, Bauchweh, Ohrenschmerzen - kleine Kinder machen so einiges an Krankheiten durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
