        "fr-extract.jsonl": [
            {
                "entry_id": "46e4aa5b-1187-3e5b-8a8b-bee2b9b51534",
                "word": "grésil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b2a66e5-effb-43b9-99fe-c3ea9c9b1d2f",
                        "entry_id": "46e4aa5b-1187-3e5b-8a8b-bee2b9b51534",
                        "tags": [
                            "plural"
                        ],
                        "form": "grésils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                        "entry_id": "46e4aa5b-1187-3e5b-8a8b-bee2b9b51534",
                        "glosses": [
                            "Petite grêle fort menue et dure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56c0ca46-1620-48fc-bd52-a8a190df889e",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "Ce n’est pas de la neige qui tombe, c’est du grésil."
                            },
                            {
                                "example_id": "0e51b115-973c-4998-89ba-22130f81c32f",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "\" Un déluge glacé, gentiment assaisonné de grésil, nous cingla presque à l'horizontale dans un mugissement insensé.\" (Jean Philippe Jaworski, le chevalier aux épines, tome 2, le conte de l'assassin)"
                            },
                            {
                                "example_id": "0a5e018d-8d97-4230-aed6-ce0f18d88943",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "La nuit était claire, les étoiles avivées de froid ; la bise piquait, et un fin grésil, glissant sur les vêtements sans les mouiller, gardait fidèlement la tradition des Noëls blancs de neige."
                            },
                            {
                                "example_id": "174d75cc-a4b7-441a-8b23-0c99ff9d7c58",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "C’était un clair matin d’avril, quand l’air est encore froid. De grands nuages passant sur le soleil, des ombres couraient sur les bois dépouillés et des averses tombaient, dures et cinglantes ; des volées de grésil tourbillonnaient, s’amoncelant sous les pruniers frileux, parmi les terres des enclos fraîchement labourés."
                            },
                            {
                                "example_id": "7d9b8609-5e3a-4902-83dd-9ec696c3718c",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "Le grésil tambourine sur le granit, s’accumule déjà dans les fissures et sur les vestes."
                            },
                            {
                                "example_id": "615541e7-8199-47ee-846a-c491c0ae88c2",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "Des gerbes de grésil rayent l’air, s’éparpillent contre les parois, rejaillissent en feux d’artifice, accumulent un caviar blanchâtre dans les angles et les rainures."
                            },
                            {
                                "example_id": "dfe170a9-4625-4207-9320-09542fe0279e",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "Deux silhouettes se profilaient à travers le grésil."
                            },
                            {
                                "example_id": "c8909153-1c70-4f01-9dc0-1a03dcd44e86",
                                "sense_id": "fce57d72-4acf-3e02-82f9-1bfa6b78ec99",
                                "text": "Nous nous encordâmes dans le grésil et nous gagnâmes le sommet par une escalade facile."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0411ae9-dd8a-3b14-9ef2-20a4762744f7",
                        "entry_id": "46e4aa5b-1187-3e5b-8a8b-bee2b9b51534",
                        "glosses": [
                            "Granules formés de neige et de cristaux de glace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a57ae6bb-3053-409f-8e99-ba81e38e487c",
                                "sense_id": "a0411ae9-dd8a-3b14-9ef2-20a4762744f7",
                                "text": "Une montagne de neige rose semblait avoir givré à même la verrière qu’elle boursouflait de son trouble grésil comme une vitre à laquelle il serait resté des flocons."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4b350d7-9d85-38ea-95d8-815c0b5d80e2",
                        "entry_id": "46e4aa5b-1187-3e5b-8a8b-bee2b9b51534",
                        "glosses": [
                            "Bruit semblable à celui d’une précipitation de ce météore."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "7ffdaa80-5aba-4eab-8d42-eaf989dffae0",
                                "sense_id": "c4b350d7-9d85-38ea-95d8-815c0b5d80e2",
                                "text": "Mais rien de plus, rien d’autre encore. Ni ces longues rumeurs d’ailes qui s’endorment, ni ce grésil incessant de cisailles si ténu qu’il échappe à ceux dont l’ouïe n’est pas restée sauvage…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a570e778-83e7-403e-ba1b-415701181b8a",
                        "source_entry_id": "46e4aa5b-1187-3e5b-8a8b-bee2b9b51534",
