                    {
                        "translation_id": "9c53429c-d306-4dc2-afea-07487562f437",
                        "source_entry_id": "af63a71e-4028-3134-abad-ba760dc97876",
                        "source_sense_id": "6406a21a-8255-32fd-9141-d99f88d5bf9b",
                        "source_sense_description": "language",
                        "target_lang_word": "Cebuano",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cebuano",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bc0a55b-06a9-3bba-8ddb-2e330ae59663",
                                        "entry_id": "f09dfd14-28dd-3809-8444-ae077e351ece",
                                        "glosses": [
                                            "eine Sprache, die vor allem im Süden der Philippinen gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d41ea4c-ddf6-40b7-aa5c-0c8a2407fbd1",
                                                "sense_id": "0bc0a55b-06a9-3bba-8ddb-2e330ae59663",
                                                "text": "„Drei größere Sprachgruppen gibt es: das Cebuano in Cebu, in Negros Oriental, in Bohol und in Teilen von Leyte; das Waray in Samar und in Nord-Leyte; das Ilongo in Panay und Negros Occidental.“"
                                            },
                                            {
                                                "example_id": "04536be2-98e0-4149-89e4-8f583d3f1e58",
                                                "sense_id": "0bc0a55b-06a9-3bba-8ddb-2e330ae59663",
                                                "text": "„Ein Europäer, der noch nie die Blume gesehen hat, die auf Cebuano butô-butô heißt, kann sich relativ wenig vorstellen, wenn er folgende Definition liest, deren Bedeutung in Termini der semantischen Merkmalanalyse vollkommen hinreichend beschrieben ist: butô-butô […] A vulva-shaped flower of a wild vine (pukinggan).“"
                                            },
                                            {
                                                "example_id": "785f180e-5988-4e06-b954-9c51290c7dc9",
                                                "sense_id": "0bc0a55b-06a9-3bba-8ddb-2e330ae59663",
                                                "text": "„Allein auf Mindanao waren über 30 Sprachen in Gebrauch, wobei allerdings Cebuano, Maguindanao und Maranao überdurchschnittlich weite Verbreitung gefunden hatten, ebenso wie Bisayan, das auch auf den nördlich Mindanaos gelegenen Inseln gesprochen wurde.“"
                                            },
                                            {
                                                "example_id": "78157af1-2583-46b9-94fa-7daa824f4c14",
                                                "sense_id": "0bc0a55b-06a9-3bba-8ddb-2e330ae59663",
                                                "text": "„Lumad bezeichnet die Volksstämme der Philippinen, die sich weder der christlichen, noch der muslimischen Religion angeschlossen haben, sondern weiterhin ihrer Stammesreligionen nachgehen. Wörtlich aus dem Cebuano übersetzt heißt Lumad: ‚Eingeborener‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
