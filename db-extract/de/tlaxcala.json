                "senses": [
                    {
                        "sense_id": "f5078a29-370f-313a-ae52-fbfd8d9faccd",
                        "entry_id": "b2f364f5-1cc0-3afb-b019-517fe0a9e859",
                        "glosses": [
                            "mexikanischer Bundesstaat"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c00573f6-6cc9-395b-997d-3ed28078a317",
                        "entry_id": "b2f364f5-1cc0-3afb-b019-517fe0a9e859",
                        "glosses": [
                            "Hauptstadt von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6627e4e-8482-4c0e-b83f-7cfc3d32a70c",
                                "sense_id": "c00573f6-6cc9-395b-997d-3ed28078a317",
                                "text": "„In der Gegend rings um Tlaxcala kannte ich mich recht gut aus - wahrscheinlich sogar sehr viel besser als der verschwundene Mann -, sodass ich ihm gegenüber bei meiner Suche im Vorteil war, es sei denn, er war bereits mit einem Zug irgendwohin geflohen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f076348-788f-44b3-86c7-de0c1ca84ea3",
                        "source_entry_id": "b2f364f5-1cc0-3afb-b019-517fe0a9e859",
                        "source_sense_id": "f5078a29-370f-313a-ae52-fbfd8d9faccd",
                        "source_sense_description": "Bundesstaat",
                        "target_lang_word": "Tlaxcala",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tlaxcala",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3833bfb-84ea-3fe1-9c98-8da5c1ed7f1f",
                                        "entry_id": "f565cbbf-c2af-3791-b39f-ed5d3200f801",
                                        "glosses": [
                                            "An indigenous Mesoamerican polity in what is now Mexico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e34ee2c2-aa34-4da0-b9b0-b193d2f49c35",
                                                "sense_id": "b3833bfb-84ea-3fe1-9c98-8da5c1ed7f1f",
                                                "text": "A more formidable enemy still was the little republic of Tlascala, lying midway between the Mexican Valley and the coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c289b834-0b98-3cf7-9ecc-440f9213d9cf",
                                        "entry_id": "f565cbbf-c2af-3791-b39f-ed5d3200f801",
                                        "glosses": [
                                            "A province of New Spain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1708b33f-6e22-4fec-98ba-4bba3378aeec",
                                                "sense_id": "c289b834-0b98-3cf7-9ecc-440f9213d9cf",
                                                "text": "Tlascala, a province of New Spain, in the audience of Mexico; bounded on the N by Panuco, on the E by the gulf of Mexico, on the S by Guaxica and the Pacific Ocean, and on the W by the audience of Mexico."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1692931b-c920-3934-b89f-0f4dbd1328c1",
                                        "entry_id": "f565cbbf-c2af-3791-b39f-ed5d3200f801",
                                        "glosses": [
                                            "A state of Mexico."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cd2c414-9216-359f-9fda-9f2c50ca1f09",
                                        "entry_id": "f565cbbf-c2af-3791-b39f-ed5d3200f801",
                                        "glosses": [
                                            "The capital city of the state of Tlaxcala."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1c8fe0-dc44-45df-a60e-226ea8ddabc2",
                                                "sense_id": "7cd2c414-9216-359f-9fda-9f2c50ca1f09",
                                                "text": "Tlascala, a town of New Spain, capital of a province of the same name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5588c24-58d9-3e12-bed4-a9f53520660c",
                                        "entry_id": "f565cbbf-c2af-3791-b39f-ed5d3200f801",
                                        "glosses": [
                                            "Until 1903, a Roman Catholic diocese; now the archdiocese of Puebla de los Ángeles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bacb5c0f-0448-44e2-b025-f7606d4523c3",
                                                "sense_id": "a5588c24-58d9-3e12-bed4-a9f53520660c",
                                                "text": "The Biſhopricke of Tlaſcala, which by another name is called de los Angeles, between the Archbiſhopricke of Mexico, and the Biſhopricke of Guaxaca, if of 100. leagues, and more in length, from the Coaſt of the South to that of the North, and betwixt the confines of the Archbiſhopricke, and of Guaxaca 80. and as many in breadth, by the Coaſt of the North sea, and no more then 18. or 20. by that of the South."
                                            },
                                            {
                                                "example_id": "acede77d-ba88-4f3e-a682-9054cc336bc6",
                                                "sense_id": "a5588c24-58d9-3e12-bed4-a9f53520660c",
                                                "text": "On information received from Julian Garces, Bishop of Tlascala, of the Order of Friars Preachers, Pope Paul III. issued in 1537 bulls vindicating the liberty of the Indians and their dignity as human beings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ae94a2-7dcf-305a-af64-9eacb26795f0",
                                        "entry_id": "f565cbbf-c2af-3791-b39f-ed5d3200f801",
                                        "glosses": [
                                            "A Roman Catholic diocese erected in 1959."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
