                        "zh": [
                            {
                                "target_lang_word": "膝部",
                                "target_lang_sense_clarification": "裤子等覆盖膝盖的部分"
                            },
                            {
                                "target_lang_word": "膝盖处",
                                "target_lang_sense_clarification": "衣物上膝盖所在处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84baf7db-731e-3fa7-b1e2-c75ed66e2115",
                    "sense_definition": "A hard hit or strike given with the knee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fighter delivered a powerful <w>knee</w> to his opponent's stomach.",
                            "target_lang_translations": {
                                "ru": "Боец нанес мощный удар <w>коленом</w> в живот противника.",
                                "zh": "那名拳手朝对手腹部使出了一记有力的<w>膝击</w>。"
                            }
                        },
                        {
                            "text": "He defended himself against a sudden <w>knee</w> during the struggle.",
                            "target_lang_translations": {
                                "ru": "Он защитился от внезапного удара <w>коленом</w> во время борьбы.",
                                "zh": "扭打时，他挡住了对方突然的一记<w>膝击</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flying knee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный удар, нанесенный коленом.",
                        "zh": "用膝盖发出的有力一击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар коленом",
                                "target_lang_sense_clarification": "боевой прием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膝击",
                                "target_lang_sense_clarification": "搏击中用膝盖发出的攻击"
                            },
                            {
                                "target_lang_word": "膝撞",
                                "target_lang_sense_clarification": "较通俗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffbed8ea-6836-3871-8853-0ce1a4e633dc",
                    "sense_definition": "A sharp bend or angle in a line, curve, or object that looks like a bent knee.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer pointed to the <w>knee</w> of the graph where the performance suddenly dropped.",
                            "target_lang_translations": {
                                "ru": "Инженер указал на <w>изгиб</w> графика, где производительность внезапно упала.",
                                "zh": "工程师指着图表上性能突然下降的那个<w>拐点</w>。"
                            }
                        },
                        {
                            "text": "There is a distinct <w>knee</w> in the pipe where it turns toward the wall.",
                            "target_lang_translations": {
                                "ru": "В трубе есть отчетливое <w>колено</w> там, где она поворачивает к стене.",
                                "zh": "管道朝墙面转过去的地方有一个明显的<w>弯头</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
