                                        "entry_id": "bd95a54e-0cab-3a14-83b1-7710239c3674",
                                        "glosses": [
                                            "An act or ability to simulate or effect the appearance, characteristics, or behavior of someone or something else."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1703101-acba-4f29-b8ff-24c6726310d1",
                                                "sense_id": "33386152-654d-3024-87af-40662c75dee0",
                                                "text": "They say that mimicry is the sincerest form of flattery, but I still think I'm being mocked when he acts just like me."
                                            },
                                            {
                                                "example_id": "84711707-1225-41a2-b8d0-5cbba94cdd9b",
                                                "sense_id": "33386152-654d-3024-87af-40662c75dee0",
                                                "text": "When animal mimicry goes really wrong they don't just look like something that a predator would ignore, they look like lunch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
