                {
                    "sense_id": "a098b2e2-0a85-3522-a62a-413b0c134864",
                    "sense_definition": "Политическая организация общества, которая управляет страной, издаёт законы и обеспечивает порядок.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Глава <w>государства</w> подписал новый указ.",
                            "target_lang_translations": {
                                "en": "The head of <w>state</w> signed a new decree.",
                                "es": "El jefe de <w>Estado</w> firmó un nuevo decreto.",
                                "fr": "Le chef de l'<w>État</w> a signé un nouveau décret."
                            }
                        },
                        {
                            "text": "Налоги граждан составляют основной доход <w>государства</w>.",
                            "target_lang_translations": {
                                "en": "Citizens' taxes constitute the main income of the <w>state</w>.",
                                "es": "Los impuestos de los ciudadanos constituyen el ingreso principal del <w>Estado</w>.",
                                "fr": "Les impôts des citoyens constituent le revenu principal de l'<w>État</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "анархия"
                    ],
                    "common_phrases": [
                        "глава государства",
                        "законы государства",
                        "бюджет государства",
                        "роль государства"
                    ],
                    "target_lang_definitions": {
                        "en": "A political organization of society that governs the country, issues laws, and ensures order.",
                        "es": "Organización política de la sociedad que gobierna el país, promulga leyes y garantiza el orden.",
                        "fr": "Organisation politique de la société qui régit le pays, édicte les lois et assure l'ordre."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "state",
                                "target_lang_sense_clarification": "political organization"
                            }
                        ],
