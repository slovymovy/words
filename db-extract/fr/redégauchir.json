                "senses": [
                    {
                        "sense_id": "da9c7342-5e02-3871-ae30-725e55393ba4",
                        "entry_id": "f0f5dfbc-55de-3d6b-b805-0b802edef96a",
                        "glosses": [
                            "Dégauchir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaa321fe-7184-4da6-99b7-ab3e41356df5",
                                "sense_id": "da9c7342-5e02-3871-ae30-725e55393ba4",
                                "text": "Si tu veux un manche qui vrille, une touche que tu dois redégauchir toutes les 2 semaines ouaip, dans ce cas c'est le meilleur moyen."
                            },
                            {
                                "example_id": "e7dea815-09a3-4a56-a9ba-734ce59ea0ca",
                                "sense_id": "da9c7342-5e02-3871-ae30-725e55393ba4",
                                "text": "Pour le corps à redégauchir faut trouver une dégau de 51, pas trop répandue..."
                            },
                            {
                                "example_id": "3a4a1d67-75e7-403d-887e-a1389dc20be0",
                                "sense_id": "da9c7342-5e02-3871-ae30-725e55393ba4",
                                "text": "Normalement, si vous déplacez une pièce lors d'une gamme d'inspection, vous devez redégauchir la pièce et remesurer toutes les formes à nouveau."
                            }
                        ]
                    }
