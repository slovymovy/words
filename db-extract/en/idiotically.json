                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d249d44-1c01-4030-90b9-f4557cb73f4a",
                                "sense_id": "b29b576a-4f35-3be9-8a66-4cdd650cd498",
                                "text": "The agents, particularly a woman named Betty (Lynne Cormack), gush idiotically about what great potential Robin has, and dream of revamping his act so antiseptically that they can bill him as \"Canada's Comic Illusionist,\" instead of the specialty performer that he clearly is."
                            }
                        ]
                    }
                ],
                "translations": [
