                        "examples": [
                            {
                                "example_id": "300030b7-2a5c-4946-9832-6de0c1b73bec",
                                "sense_id": "9be78c30-97c2-346b-b621-554c305a1a3e",
                                "text": "„Als geklärt darf gelten, daß die genannten Anforderungen – abwägende Berücksichtigung gemeindlicher Belange – von Verfassungs wegen an (Planungs-)Entscheidungen zu stellen sind, die eine den gemeindlichen Vorstellungen zuwiderlaufende Regelung der Bodennutzung im Gemeindegebiet zum Gegenstand haben.“"
                            }
