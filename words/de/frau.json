                    "sense_definition": "Erwachsener, weiblicher Mensch",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "weibliche_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dort drüben an der Haltestelle steht eine junge <w>Frau</w> und wartet auf den Bus."
