                ],
                "senses": [
                    {
                        "sense_id": "7f4380ab-9b8c-37a0-95c4-21951e2dab47",
                        "entry_id": "b1acb6f9-b908-3a5d-8e48-687be6dd24b1",
                        "glosses": [
                            "große, steile Erhebung auf der Landoberfläche der Erde und Bauplatz einer Kapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62737a8a-265c-4255-8456-3c1626c8b987",
                                "sense_id": "7f4380ab-9b8c-37a0-95c4-21951e2dab47",
                                "text": "„Der Kapellenberg beherbergt drei interessante Sehenswürdigkeiten, von denen die Bergkapelle die wohl auffälligste ist.“"
                            },
                            {
                                "example_id": "8cb27ce0-edd9-436e-9212-219b3f365b20",
                                "sense_id": "7f4380ab-9b8c-37a0-95c4-21951e2dab47",
                                "text": "„Bei der mittlerweile sechsten Grabungskampagne auf dem 6.000 Jahre alten, jungsteinzeitlichen Fundplatz auf dem Kapellenberg bei Hofheim am Taunus werden weitere Flächen im Vorderbereich der etwa 45 Hektar großen Wallanlage untersucht.“"
                            },
                            {
                                "example_id": "4f0d80da-d687-4787-a6a3-3834b00478f8",
                                "sense_id": "7f4380ab-9b8c-37a0-95c4-21951e2dab47",
                                "text": "„Schon von weitem sichtbar erhebt sich mitten im Landsberger Stadtzentrum die Spitze des Kapellenberges.“"
                            },
                            {
                                "example_id": "6551e89e-1141-432f-8288-b03838242106",
                                "sense_id": "7f4380ab-9b8c-37a0-95c4-21951e2dab47",
                                "text": "„Der Kapellenberg in Menden ist Naturschutzgebiet.“"
                            },
                            {
                                "example_id": "e21cd0b8-3bbd-4fe4-b98f-ad47564648aa",
                                "sense_id": "7f4380ab-9b8c-37a0-95c4-21951e2dab47",
                                "text": "„Am Westhang des Kapellenbergs steht der Cohausentempel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
