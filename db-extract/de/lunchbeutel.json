                        "examples": [
                            {
                                "example_id": "17e081a4-4517-4048-8a44-ed36f44a4aca",
                                "sense_id": "729fe680-44a6-336b-9b65-0acac0e47cd0",
                                "text": "„Er ging auf dem rechten Straßenrain und trug in der Hand einen Lunchbeutel aus braunem Papier.“"
                            },
                            {
                                "example_id": "5b3e7fdc-9376-4638-92a6-dd7fb807ae26",
                                "sense_id": "729fe680-44a6-336b-9b65-0acac0e47cd0",
                                "text": "„Salat und Lunchbeutel können leider bis auf Weiteres nicht angeboten werden.“"
                            },
                            {
                                "example_id": "44191f23-9221-4a22-8f89-a81e18feae71",
                                "sense_id": "729fe680-44a6-336b-9b65-0acac0e47cd0",
                                "text": "„Ganz ohne Müll kommt dagegen ein selbst genähter Lunchbeutel aus.“"
                            }
