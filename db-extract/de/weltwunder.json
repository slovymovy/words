                ],
                "senses": [
                    {
                        "sense_id": "3f1a7ae8-ea19-36e3-89a7-2bfc607d617e",
                        "entry_id": "960ba611-58e9-3329-b322-84f3e516af6d",
                        "glosses": [
                            "etwas, das sich durch seine bewundernswürdigen Eigenschaften von allen anderen Erscheinungen der Welt abhebt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "4a1ee8ab-4ffa-4353-80c1-a9bf168e353f",
                                "sense_id": "3f1a7ae8-ea19-36e3-89a7-2bfc607d617e",
                                "text": "Viele Anhänger des Vereins empfanden das nach Jahrzehnten der Diskussion neu erbaute Stadion als Weltwunder."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3265df6b-ef3d-3032-a513-5e9e306ac30a",
                        "entry_id": "960ba611-58e9-3329-b322-84f3e516af6d",
                        "glosses": [
                            "die Sieben Weltwunder der Antike, also diejenigen herausragendsten Weltwunder nach [1] schlechthin"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "c0082a24-b58f-40e2-a29b-189104453964",
                                "sense_id": "3265df6b-ef3d-3032-a513-5e9e306ac30a",
                                "text": "Der Artemistempel von Ephesus wurde zu den \"Sieben Weltwundern\" der Antike gezählt."
                            },
                            {
                                "example_id": "7884d7d0-9073-483b-844a-a652ca0273d1",
                                "sense_id": "3265df6b-ef3d-3032-a513-5e9e306ac30a",
                                "text": "Die älteste Überlieferung einer Liste von Weltwundern geht auf den Geschichtsschreiber Herodot (etwa 450 v. Chr.) zurück."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df786e0e-6e69-47f6-9186-0fa75ebcf593",
