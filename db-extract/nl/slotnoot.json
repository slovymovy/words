                        "glosses": [
                            "de laatste toon van een muziekstuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f85ae5-2e64-449d-8a92-d6431b608c44",
                                "sense_id": "2de4585e-b2ff-3634-97a4-896e145b42aa",
                                "text": "Met de slotnoot nog in de mond draaide ze zich om naar het geweldige orkest Ludwig, gaf de opmaat, en wat volgde was de mooiste overgang naar het mineur van het Adagio uit Haydns symfonie nr. 49 La passione die je je kunt voorstellen."
                            },
                            {
                                "example_id": "98f442c4-eed8-49f1-9523-e10b1a1b0ab9",
                                "sense_id": "2de4585e-b2ff-3634-97a4-896e145b42aa",
                                "text": "Jammer is dat bij hem klankeffect boven voordracht lijkt te gaan; het is soms nauwelijks te verstaan wat hij zingt omdat hij per woord met dynamiek speelt. Steeds ook dat uitgestelde vibrato op de slotnoten: dat gaat vermoeien."
                            },
                            {
                                "example_id": "2874064a-52b9-4334-b7c3-7ec22cf4fc4c",
                                "sense_id": "2de4585e-b2ff-3634-97a4-896e145b42aa",
                                "text": "Geniale inval: de stamelende slotnoten van Siroe boven een stilvallend orkest, terwijl de opgetakelde coulissen een kaal achtertoneel tonen. Het sprookje is doorgeprikt."
                            }
                        ]
                    }
