                ],
                "senses": [
                    {
                        "sense_id": "95452304-2665-3bad-b7da-1d778a986397",
                        "entry_id": "735364da-760e-3eae-a452-d8127843fd1e",
                        "glosses": [
                            "Développer de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d7564cd-f3ab-4bbd-b562-1126a0b48af4",
                                "sense_id": "95452304-2665-3bad-b7da-1d778a986397",
                                "text": "Cette mutation du désir en besoin régressif, excessif, addictif, tel l’or changé en plomb ou le bon vin en vinaigre, contraint d’hyperdévelopper un seul pan de son identité plurielle, au détriment de tous les autres, laissés en jachère."
                            },
                            {
                                "example_id": "d8868a68-9bb5-49fd-8594-825e5b54e49c",
                                "sense_id": "95452304-2665-3bad-b7da-1d778a986397",
                                "text": "Rappelons qu’il est toujours plus judicieux (en termes de points à gagner) de traiter l’ensemble d’un sujet plutôt que de s’acharner sur un point qui vous résiste ou « d’hyperdévelopper » certaines réponses au risque de ne pas achever le travail."
                            }
                        ]
                    }
                ],
