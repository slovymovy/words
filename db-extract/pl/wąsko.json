                                        "glosses": [
                                            "In a tight manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abedf23-bfd3-47e2-aaec-96a176443b4f",
                                                "sense_id": "444a0abb-7e1f-3d0b-a23f-fa7259b18a18",
                                                "text": "tightly clenched fingers"
                                            },
                                            {
                                                "example_id": "d850b9bd-597d-4b24-8b4e-138536fbe0d7",
                                                "sense_id": "444a0abb-7e1f-3d0b-a23f-fa7259b18a18",
                                                "text": "Clutching my cure / I tightly lock the door / I try to catch my breath again"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fcf2a6b-fedc-3b02-a3e1-b19c6d5aa4cf",
                                        "entry_id": "dc8fab16-ed0f-3517-9e7b-f8d27bbcbfae",
                                        "glosses": [
                                            "Curtly in a way that suggests anger or other intense emotion is being contained."
                                        ],
                                        "tags": [
                                            "of speech"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77a399ee-2aec-4464-bbc3-dd45a3b9a17d",
                        "source_entry_id": "6d680629-fe53-3c62-b1f7-671f369d0ec4",
                        "source_sense_id": "0397a7eb-184a-3780-b11e-8a24de58db71",
                        "target_lang_word": "narrowly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narrowly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76e62c90-d668-3fbe-ac82-a29cc08b3d83",
                                        "entry_id": "f3220005-04af-3212-9ff4-001378b57b5b",
                                        "glosses": [
                                            "In a narrow manner; without flexibility or latitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c85663ad-eded-403b-8b7c-2d8a2ca8ceb6",
                                                "sense_id": "76e62c90-d668-3fbe-ac82-a29cc08b3d83",
                                                "text": "They regarded the new idea rather narrowly."
                                            },
                                            {
                                                "example_id": "404dc192-ba52-4828-af46-6d25717f8ed8",
                                                "sense_id": "76e62c90-d668-3fbe-ac82-a29cc08b3d83",
                                                "text": "There is now such an immense \"microliterature\" on hepatics that, beyond a certain point I have given up trying to integrate (and evaluate) every minor paper published—especially narrowly floristic papers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1da6940-7530-3f1e-ba59-ab7f21407d7d",
                                        "entry_id": "f3220005-04af-3212-9ff4-001378b57b5b",
                                        "glosses": [
                                            "Closely; by a narrow margin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed452e0d-81fc-4124-8f81-183bb6ab4be4",
                                                "sense_id": "e1da6940-7530-3f1e-ba59-ab7f21407d7d",
                                                "text": "They narrowly escaped collision."
                                            },
                                            {
                                                "example_id": "d85ee264-c914-497b-9ad8-77c14282fa43",
                                                "sense_id": "e1da6940-7530-3f1e-ba59-ab7f21407d7d",
                                                "text": "The next day Opra Pitrachard ſent for Monſieur Conſtance to come to him, and ordered him to go and tell the French Officers that there was no deſign of keeping them Priſoners […] I charge you that you ſay this, and no more to thoſe French Officers; and know, that you ſhall be narrowly watched and overheard."
                                            },
                                            {
                                                "example_id": "399f81fd-2caa-4888-8e62-746c108d9793",
                                                "sense_id": "e1da6940-7530-3f1e-ba59-ab7f21407d7d",
                                                "text": "One inconsequent dream he related, about fancying himself quite young and rich, and finding himself suddenly in a field cropping razors around him, when, just as he had, by steps dainty as those of a French dancing-master, reached the middle, he to his dismay beheld a path clear of the blood, thirsty steel-crop, which he might have taken at first had he looked narrowly; and there he was."
                                            },
                                            {
                                                "example_id": "6db2ea5c-7b0e-43f1-af57-f818fc2eb79d",
                                                "sense_id": "e1da6940-7530-3f1e-ba59-ab7f21407d7d",
                                                "text": "The visitors had not managed an away win in the top flight since the final day of last season, but Mauro Formica set the tone in the second minute with a rasping 25-yard drive which flew narrowly wide."
                                            },
                                            {
                                                "example_id": "5de1d2e1-4946-4b2e-8cf6-94e32c3f0649",
                                                "sense_id": "e1da6940-7530-3f1e-ba59-ab7f21407d7d",
                                                "text": "The House narrowly approved a rescissions package from the White House that aims to cancel billions in unspent funds from the prior fiscal year, much of which would not have been spent otherwise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf906ab8-1f45-4514-a23e-8752b2ac5a1c",
                        "source_entry_id": "6d680629-fe53-3c62-b1f7-671f369d0ec4",
                        "source_sense_id": "0397a7eb-184a-3780-b11e-8a24de58db71",
                        "target_lang_word": "schmal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a54e608e-0e63-3dba-9254-f246c976098d",
                                        "entry_id": "b7855688-ddc9-32be-b9e7-a777a09d04a6",
                                        "glosses": [
                                            "wenig breit, keine große Ausdehnung in der Breite aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edfe3860-859b-4867-863f-922d1ea03140",
                                                "sense_id": "a54e608e-0e63-3dba-9254-f246c976098d",
                                                "text": "Es ist ein schmaler Grat zwischen Genie und Wahnsinn."
                                            },
                                            {
                                                "example_id": "60f7dfa6-10e2-4342-8654-ad9f7497d430",
                                                "sense_id": "a54e608e-0e63-3dba-9254-f246c976098d",
                                                "text": "„Die schmale Allee wird nach zwei Kilometern von Stacheldraht und Betonklötzen brutal durchtrennt.“"
                                            },
                                            {
                                                "example_id": "7e900bb3-765d-4dee-b7f4-098e16682f20",
                                                "sense_id": "a54e608e-0e63-3dba-9254-f246c976098d",
                                                "text": "Er schweigt, verschränkt die Arme vor der Brust und macht ganz schmale Augen."
                                            },
                                            {
                                                "example_id": "a44d0d20-58a0-42d2-a875-45bd705613e8",
                                                "sense_id": "a54e608e-0e63-3dba-9254-f246c976098d",
                                                "text": "In den Raum gelangt man nur durch eine schmale Geheimtür."
                                            },
                                            {
                                                "example_id": "41ee95a8-3e4f-44b4-bbf3-9c19907113d8",
                                                "sense_id": "a54e608e-0e63-3dba-9254-f246c976098d",
                                                "text": "„Noch mehr Einschränkungen resultieren aus dem deutlich schmäleren Anwendungsbereich“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c76f5101-0b27-3205-a7f9-a7894e20d5cb",
                                        "entry_id": "b7855688-ddc9-32be-b9e7-a777a09d04a6",
                                        "glosses": [
                                            "wenig, knapp, unzureichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ceadeb3-de37-42bf-be66-5ee5f6824bf0",
                                                "sense_id": "c76f5101-0b27-3205-a7f9-a7894e20d5cb",
                                                "text": "Er bekam nur eine schmale Rente."
                                            },
                                            {
                                                "example_id": "58a06dc1-b660-4c2d-9947-fe9f7a361b50",
                                                "sense_id": "c76f5101-0b27-3205-a7f9-a7894e20d5cb",
                                                "text": "Ihren Gästen serviert Hulda meist nur schmale Kost."
                                            },
                                            {
                                                "example_id": "41e2b78c-dbfe-4ced-ae72-04749e6c3b11",
                                                "sense_id": "c76f5101-0b27-3205-a7f9-a7894e20d5cb",
                                                "text": "„Nicht von ungefähr sind es, zumindest in Deutschland, vor allem unterbeschäftigte Postbeamte, die durch die Zusammenstellung und private Publikation von Eisenbahnkursbüchern ihr schmales Salär aufbessern.“"
                                            },
                                            {
                                                "example_id": "6434cea7-0e27-44a1-9250-7aed5d4aa6f4",
                                                "sense_id": "c76f5101-0b27-3205-a7f9-a7894e20d5cb",
                                                "text": "„Deine neue Ehefrau hat einen etwas schmalen Geschmack, findest du nicht?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7e1478b6-9be3-3ca0-96f1-1d17a8043fb3",
                                        "entry_id": "b7855688-ddc9-32be-b9e7-a777a09d04a6",
                                        "glosses": [
                                            "im zweiten Lebensjahr seiend"
                                        ],
                                        "tags": [
                                            "Jägersprache (in Bezug auf Schalenwild mit Ausnahme des Schwarzwildes); meist in Zusammensetzungen"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6a2694c-9e2e-422a-8944-a9a9c903af81",
                        "source_entry_id": "6d680629-fe53-3c62-b1f7-671f369d0ec4",
                        "source_sense_id": "0397a7eb-184a-3780-b11e-8a24de58db71",
                        "target_lang_word": "eng",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eng",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "schmal, nahe anliegend; von relativ geringer Ausdehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c1dfc1-75b2-483f-a196-f647ab5cea27",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "Ich habe wohl zugenommen, meine Hose ist jetzt etwas eng."
                                            },
                                            {
                                                "example_id": "d3222db5-33c4-4afb-a565-4ea8924b6efc",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "In der engen Gasse war ein Überholen unmöglich."
                                            },
                                            {
                                                "example_id": "55c0f382-00ad-4318-941e-341fa1608077",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "Wenn du auch noch zum Bäcker willst, wird es eng."
                                            },
                                            {
                                                "example_id": "cce00e8a-dea9-4c4a-9d48-52cc3b8abafb",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "„Um durch das enge Gitter vor dem Fenster zu kommen, muß man fast ein Zirkusakrobat sein, so Blume.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "sehr dicht beieinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae248f-664b-4560-b3d9-7bcc3ab5ca69",
                                                "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                                "text": "Die beiden auf der Tanzfläche müssen sich sehr mögen, so eng wie die miteinander tanzen."
                                            },
                                            {
                                                "example_id": "3cac56b0-371f-4680-a0cd-547894aae19c",
                                                "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                                "text": "Auf der Geburtstagskarte ist nicht viel Platz, du musst ganz eng schreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "ein intimes Verhältnis besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c01036-c99d-4b50-aa38-3c98e8c305f9",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "Wir sind so eng miteinander, der besorgt mir bestimmt auch eine Eintrittskarte."
                                            },
                                            {
                                                "example_id": "6a91906d-652f-4e7b-9578-19736528b2ba",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "Zur Hochzeit kommt nur der engste Freundeskreis."
                                            },
                                            {
                                                "example_id": "be84b3cc-af61-4919-b9e8-212daa2dd3e0",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "„Wie eng war die Verbindung zwischen der kleinen Gruppe der Araber in Berlin und der viel größeren Gruppe der Juden gewesen, wie viel hatten Araber in dieser Stadt gerade den Juden zu verdanken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "keinen Spielraum habend, in Schwierigkeiten steckend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7fb190f-5f01-4813-b96a-8e4d05528152",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "Wenn es um die Deutsche Bank irgendwann eng wird, dann wird es wieder Steuerzahlergelder geben."
                                            },
                                            {
                                                "example_id": "3e7be11a-e077-48a0-9877-f1499eb05a37",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "Wenn es für ihn eng wird, steht für Präsident Erdogan der Schuldige oft schon fest."
                                            },
                                            {
                                                "example_id": "023cef77-96e5-49ac-a62e-70a9bf534a01",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "\"Wir haben erwartet, dass es eng wird. Wir hätten noch eine Nullrunde gebraucht\", sagte [der Bundestrainer der deutschen Springreiter Otto] Becker: \"Das ist bitter.\""
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
