                        ],
                        "examples": [
                            {
                                "example_id": "b9e3986d-00b1-46cc-b1ac-c610cfe57750",
                                "sense_id": "058b22c8-2b3d-3234-8374-56f37c6278b1",
                                "text": "The institution of Rechabitism needs no commendations from us; its objects are already well known and appreciated."
                            },
                            {
                                "example_id": "4600d495-7d7e-44c7-8521-8fbbe285c5a0",
                                "sense_id": "058b22c8-2b3d-3234-8374-56f37c6278b1",
                                "text": "It appears evident that the principles of Rechabitism are not generally understood, its objects not appreciated, its moral tendencies and powers not known. Hence arises the general apathy which now exists and which makes Rechabitism appear of little moment in developing the principles and requirements of the great Temperance movement."
                            }
                        ]
                    }
