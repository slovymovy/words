                "senses": [
                    {
                        "sense_id": "b845ccaf-2ec2-337c-9a05-b123d79131b2",
                        "entry_id": "2c287716-fd89-3835-ba68-c383910f60cf",
                        "glosses": [
                            "A floor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a598807c-61ba-45f5-81c6-b31a91d97663",
                                "sense_id": "b845ccaf-2ec2-337c-9a05-b123d79131b2",
                                "text": "Every day we are exposed to low doses of phthalates in food containers, perfumes, hairsprays, floorings, paints, toys and medical devices."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cccaef7-ab6f-3a0c-b99c-a87998674ca4",
                        "entry_id": "2c287716-fd89-3835-ba68-c383910f60cf",
                        "glosses": [
                            "A material used to make floors."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9252bc27-18c4-4efd-84df-6bb9828d051b",
                                "sense_id": "1cccaef7-ab6f-3a0c-b99c-a87998674ca4",
                                "text": "Now that it owns the best-known brand names in residential carpet, don't be surprised if Mohawk Industries sails into new waters - tile, resilient or even wood floorings - Chairman David Kolb hinted Wednesday."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1b5912b-ec94-3044-b5ad-dfb4cd04fcba",
                        "entry_id": "2c287716-fd89-3835-ba68-c383910f60cf",
                        "glosses": [
                            "The act of putting one's opponent on the floor; a knockdown."
                        ],
