    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e7b35da-d578-39d9-bd57-06b0b0b192ff",
                    "sense_definition": "Faire connaître ou rendre public ce qui était caché, secret ou ignoré de tous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a choisi de <w>dévoiler</w> la vérité lors de sa conférence de presse."
                        },
                        {
                            "text": "Ils refusent obstinément de <w>dévoiler</w> un secret aussi important à leurs concurrents."
                        }
                    ],
                    "synonyms": [
                        "révéler",
                        "mettre au jour",
                        "démasquer"
                    ],
                    "antonyms": [
                        "cacher"
                    ],
                    "common_phrases": [
                        "dévoiler un secret",
                        "dévoiler la vérité"
                    ]
                },
                {
                    "sense_id": "e827b356-f500-3edf-b284-7f17309857be",
                    "sense_definition": "Ôter le voile ou la couverture qui dissimule un objet, en particulier lors d'une cérémonie officielle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decouvrir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire s'apprête à <w>dévoiler</w> une statue au centre de la place."
                        },
                        {
                            "text": "Les autorités vont <w>dévoiler</w> une plaque en mémoire des victimes de la guerre."
                        }
                    ],
                    "antonyms": [
                        "voiler",
                        "cacher"
                    ],
                    "common_phrases": [
                        "dévoiler une statue",
                        "dévoiler une plaque"
                    ]
                },
                {
                    "sense_id": "5f5025c9-0edc-3f6f-919b-8a38ffb8fd93",
                    "sense_definition": "Se faire connaître tel que l'on est, montrer ses sentiments ou ses intentions cachées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Très timide au début, il commence enfin à se <w>dévoiler</w> devant nous."
                        },
                        {
                            "text": "L'artiste a préféré se <w>dévoiler</w> peu à peu à travers ses nouvelles chansons."
                        }
                    ],
                    "synonyms": [
                        "fendre l'armure"
                    ]
                },
                {
                    "sense_id": "112176c4-d58f-325e-8a76-2871a91ff31c",
                    "sense_definition": "Redresser une roue dont la jante est déformée en réglant la tension de ses rayons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien doit <w>dévoiler</w> une roue de bicyclette avant la longue course."
                        },
                        {
                            "text": "Il utilise un outil spécial pour <w>dévoiler</w> la jante arrière de son vélo."
                        }
                    ],
                    "common_phrases": [
                        "dévoiler une roue"
                    ]
                }
            ]
        }
    ]
