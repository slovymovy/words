                                    {
                                        "sense_id": "1e99ec36-5219-3257-9514-a5a87dd3909f",
                                        "entry_id": "0e99c481-6e02-3978-a4e2-1ef1eea68720",
                                        "glosses": [
                                            "met wie men intiem omgaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e1af99-c187-4bc3-a17c-9368220e7fc2",
                                                "sense_id": "1e99ec36-5219-3257-9514-a5a87dd3909f",
                                                "text": "Er was niets anders meer dan onze lichamen, tegen elkaar aan, onze adem, onze drang, onze handen die weer vertrouwd met elkaar werden, onze armen die elkaar met geweld vastklemden, gulzige kussen en precieze, verrukkelijke liefkozingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "961d7fc2-cc39-3691-ab88-130e46f88f7f",
                                        "entry_id": "0e99c481-6e02-3978-a4e2-1ef1eea68720",
                                        "glosses": [
                                            "wat men gewend, gewoon is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e568d690-2780-4eb7-b8e8-4d3f0c2b1582",
                                                "sense_id": "961d7fc2-cc39-3691-ab88-130e46f88f7f",
                                                "text": "' Dat Titan er zo vertrouwd uitziet, vindt hij nog het meest verrassend."
                                            },
                                            {
                                                "example_id": "98877ede-81af-431b-91df-c98fa5bce6cf",
                                                "sense_id": "961d7fc2-cc39-3691-ab88-130e46f88f7f",
                                                "text": "Ze was ver van alles wat haar vertrouwd was, er werd aan haar getrokken en op haar geduwd en ze had niet eens de kracht om zich te verweren."
                                            },
                                            {
                                                "example_id": "29f87fcd-3bb2-4703-9606-b08fe0552bb7",
                                                "sense_id": "961d7fc2-cc39-3691-ab88-130e46f88f7f",
                                                "text": "' Die stem die zo vertrouwd was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6c6422-7a65-31ea-9bb1-1360f0de2149",
                                        "entry_id": "0e99c481-6e02-3978-a4e2-1ef1eea68720",
                                        "glosses": [
                                            "waarop men vertrouwen kan"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vertrouwd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e55f30-b079-3442-82fe-7bdf56a925d7",
                                        "entry_id": "0ac03fb2-aea4-3103-930b-8cb5edd022fb",
                                        "glosses": [
                                            "waarop men vertrouwen kan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a90847d6-a802-4cf6-ae84-0a0ebf27695d",
                                                "sense_id": "b3e55f30-b079-3442-82fe-7bdf56a925d7",
                                                "text": "Ik kon niet alles goed volgen, maar het monotone geluid van stemmen om mij heen voelde veilig en vertrouwd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
