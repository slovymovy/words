                    {
                        "translation_id": "ecdef2d6-8ef1-4184-8246-0dd98ae42890",
                        "source_entry_id": "1a0faf04-4201-36e4-acfc-5a9f97d823d2",
                        "source_sense_id": "7fcd485e-17b4-3139-8c61-9ee843ee7091",
                        "source_sense_description": "Gerät zur Messung und Aufzeichnung von Bewegungen des Bodens, insbesondere bei Erdbeben",
                        "target_lang_word": "seismometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seismometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b18e3bda-3539-3575-a0fb-cbd2ef9e8b69",
                                        "entry_id": "7e15308a-ba16-32a4-9f6e-3a0b6c7eed1e",
                                        "glosses": [
                                            "A device used by seismologists to detect and measure seismic waves and therefore locate earthquakes etc; a seismograph."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9de6e5c-f167-4e12-b5a3-31c64641e56f",
                                                "sense_id": "b18e3bda-3539-3575-a0fb-cbd2ef9e8b69",
                                                "text": "Despite the Hebgen Lake quake and the other known risks, Yellowstone didn't get permanent seismometers until the 1970s."
                                            },
                                            {
                                                "example_id": "3378bc32-0ecc-44df-94d5-3b6e2d020314",
                                                "sense_id": "b18e3bda-3539-3575-a0fb-cbd2ef9e8b69",
                                                "text": "Researchers monitor the volcano through instruments and cables that extend from the coast. Among them are seismometers, which provide real-time data on the earthquakes occurring near the volcano, Chadwick said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41271256-400a-40d1-8e0e-3eb472e1d767",
                        "source_entry_id": "1a0faf04-4201-36e4-acfc-5a9f97d823d2",
                        "source_sense_id": "7fcd485e-17b4-3139-8c61-9ee843ee7091",
                        "source_sense_description": "Gerät zur Messung und Aufzeichnung von Bewegungen des Bodens, insbesondere bei Erdbeben",
                        "target_lang_word": "sismomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sismomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "485e6575-ef1b-3eeb-b62b-1dc8b8ceaca0",
                                        "entry_id": "ce0ff888-08c3-353d-bbf0-9d7428c2b7fb",
                                        "glosses": [
                                            "Variante de séismomètre."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a44d89-6a84-4226-b692-ff6d195f093d",
                                                "sense_id": "485e6575-ef1b-3eeb-b62b-1dc8b8ceaca0",
                                                "text": "… ils déploieront des sismomètres sensibles aux basses fréquences pour sonder les profondeurs de la Lune."
                                            },
                                            {
                                                "example_id": "36dcefb7-4958-4226-a502-2041ad5671d6",
                                                "sense_id": "485e6575-ef1b-3eeb-b62b-1dc8b8ceaca0",
                                                "text": "L’atterrisseur InSight, arrivé sur Mars le mois dernier, a déployé avec succès sur la surface de la planète rouge un sismomètre hypersensible de fabrication française, instrument clé pour la suite de cette mission scientifique, a déclaré la Nasa jeudi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7f2c27a-7129-4836-88f3-e5ad6f34db55",
                        "source_entry_id": "1a0faf04-4201-36e4-acfc-5a9f97d823d2",
