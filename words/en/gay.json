                                "target_lang_sense_clarification": "在中文语境中常用于指代同性恋群体或身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "159f88f6-1009-3335-91ee-692762108179",
                    "sense_definition": "Foolish, stupid, or unimpressive; used to express dislike.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pejorative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He thinks studying on a Friday night is <w>gay</w>.",
