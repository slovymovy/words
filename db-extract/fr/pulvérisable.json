                "senses": [
                    {
                        "sense_id": "57098142-8070-3966-b121-0fb286cb3a5a",
                        "entry_id": "d4c8d582-3753-36f2-92b9-aa72bcf90eed",
                        "glosses": [
                            "Qualifie un solide que l’on peut réduire en poudre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e836da-ce09-4af2-9d12-8c4deca8fcf9",
                                "sense_id": "57098142-8070-3966-b121-0fb286cb3a5a",
                                "text": "Le protosulfure est d’un gris bleuâtre métallique, très cassant et facilement pulvérisable."
                            },
                            {
                                "example_id": "50daac10-c5f0-4156-a507-61dfe0e8a1f7",
                                "sense_id": "57098142-8070-3966-b121-0fb286cb3a5a",
                                "text": "La plus petite quantité d’étain, même sa vapeur, rend l’or aigre, cassant, & même pulvérisable."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dc0311c-8e0d-3470-8a4f-efb45f3afdaf",
                        "entry_id": "d4c8d582-3753-36f2-92b9-aa72bcf90eed",
                        "glosses": [
                            "Qualifie un liquide que l’on peut projeter en fines gouttelettes grâce à un pulvérisateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71c1e817-adc2-4399-a3fb-3f009bed0c48",
                                "sense_id": "3dc0311c-8e0d-3470-8a4f-efb45f3afdaf",
                                "text": "En 2006, c’est au tour du Locabiotal, antibiotique pulvérisable dans le nez ou la bouche, d'être frappé d’une mesure d’interdiction de commercialisation."
                            },
                            {
                                "example_id": "81f63a09-72ef-4ec9-baa6-12ebbd31e12d",
                                "sense_id": "3dc0311c-8e0d-3470-8a4f-efb45f3afdaf",
                                "text": "Le liquide est à garder sous la langue environ 1 minute pour une bonne diffusion des minéraux et oligoéléments dans l’organisme. Il existe également une forme pulvérisable pour les affections dermatologiques."
                            }
                        ]
                    }
