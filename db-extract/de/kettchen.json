                ],
                "senses": [
                    {
                        "sense_id": "e9f20314-b8d0-387a-9356-e28680ab6f39",
                        "entry_id": "d9ea3c88-6e9f-3e58-ad0c-c850cbc07fb2",
                        "glosses": [
                            "Schmuckstück in der Form einer kleinen Kette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3976bf42-aa66-4e16-a11d-d8ec980abe92",
                                "sense_id": "e9f20314-b8d0-387a-9356-e28680ab6f39",
                                "text": "„Sie trägt ein silbernes Kettchen.“"
                            },
                            {
                                "example_id": "3b563276-bebf-4b88-a5df-7fe8aab73166",
                                "sense_id": "e9f20314-b8d0-387a-9356-e28680ab6f39",
                                "text": "„Ich untersuchte aufmerksam ihre beiden reich gearbeiteten Uhren und die schönen, an Kettchen angehängten, juwelengeschmückten Petschafte.“"
                            },
                            {
                                "example_id": "207dab19-5139-4d75-8d0a-47d13b444868",
                                "sense_id": "e9f20314-b8d0-387a-9356-e28680ab6f39",
                                "text": "„An heißen Wochenenden, vor den Sommerferien, sonnte sich Irmhild auf der Schulwiese hinterm Haus, im Bikini, mit einem Kettchen um die Wespentaille, korrigierte auch Hefte im Liegestuhl sitzend, las Bücher und Zeitschriften und trank Orangensaft und rauchte Zigaretten dabei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
