                "senses": [
                    {
                        "sense_id": "1d5b8a6e-7e2d-31ae-a396-5fc2f5e7cf87",
                        "entry_id": "e3c9fc60-0a66-3bc5-ac10-2bf1440cef43",
                        "glosses": [
                            "ronde ton waarin men verschillende (vloei)stoffen met elkaar kan mengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db5b173f-eaba-4c94-a9d0-6a87cdc0163c",
                                "sense_id": "1d5b8a6e-7e2d-31ae-a396-5fc2f5e7cf87",
                                "text": "In 2013 liep een monteur brandwonden op toen door een onbekende oorzaak een 160 graden hete substantie uit een mengvat spoot. Tegen de regels in droeg de man geen beschermende kleding."
                            },
                            {
                                "example_id": "8be020f8-a55e-4aa1-a2f2-322f536b59be",
                                "sense_id": "1d5b8a6e-7e2d-31ae-a396-5fc2f5e7cf87",
                                "text": "De vaas is een bronzen krater of mengvat dat als gift werd bijgezet in het graf van een Keltische prinses of priesteres die niet ouder werd dan dertig jaar."
                            },
                            {
                                "example_id": "ad25450f-d8b4-4ca0-a603-fa08946cf410",
                                "sense_id": "1d5b8a6e-7e2d-31ae-a396-5fc2f5e7cf87",
                                "text": "Een van de topstukken uit de buit is een Grieks mengvat, met een geschatte waarde van 150.000 euro. In de collectie zit een reeks Grieks aardewerk uit de vierde eeuw voor Christus, en een set van 340 zeldzame munten."
                            }
                        ]
                    }
