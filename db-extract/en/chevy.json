                "senses": [
                    {
                        "sense_id": "a88eca21-b858-36c3-94a2-059e69dbe424",
                        "entry_id": "24b880fb-93aa-3c33-970a-1b88af53f236",
                        "glosses": [
                            "A vehicle of this make."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "372933ce-011f-43bd-b55b-fbe0a2645db6",
                                "sense_id": "a88eca21-b858-36c3-94a2-059e69dbe424",
                                "text": "I saw a late-model Chevy pull around back. That would have been around 10 PM."
                            },
                            {
                                "example_id": "2351d9a0-ad5e-47a0-90f9-ee00407dfe4c",
                                "sense_id": "a88eca21-b858-36c3-94a2-059e69dbe424",
                                "text": "Drove my Chevy to the levee but the levee was dry […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fd88121-8696-4385-bb87-4baa71020b96",
                        "source_entry_id": "24b880fb-93aa-3c33-970a-1b88af53f236",
                        "source_sense_id": "a88eca21-b858-36c3-94a2-059e69dbe424",
                        "source_sense_description": "(informal) a car made by Chevrolet — see also Chevrolet",
                        "target_lang_word": "ше́вик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ше́вик",
