                ],
                "senses": [
                    {
                        "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                        "entry_id": "c5845090-3a3d-3d59-9827-3de3b26b6d67",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e93645-5d6b-4bd1-b863-173ffd098a7b",
                                "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                                "text": "Frau Jäkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fa6d3dbe-e687-41f6-9c35-e0c838007260",
                                "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                                "text": "Herr Jäkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "11f32911-c390-4ede-a22b-0b20165fb547",
                                "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                                "text": "Die Jäkles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7aa6a7d7-bb8a-4bb7-9965-e34836e3b83a",
                                "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                                "text": "Der Jäkle trägt nie die Schals, die die Jäkle ihm strickt."
                            },
                            {
                                "example_id": "453d99a0-cd73-4a1d-aff2-5f4bcff50c95",
                                "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jäkle kommt, geht der Herr Jäkle.“"
                            },
                            {
                                "example_id": "5599438f-2dd8-46a9-8cc1-2c35a3b1b593",
                                "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                                "text": "Jäkle kommt und geht."
                            },
                            {
                                "example_id": "8cf853fd-521b-45b7-8c9e-1cc0267907c9",
                                "sense_id": "f7432672-dcd0-37bb-844f-fe5500c4b34f",
                                "text": "Jäkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
