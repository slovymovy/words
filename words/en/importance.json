{
    "word_family": [
        "important",
        "importantly",
        "unimportant",
        "import"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6f2f575-8b5c-3e9a-88e7-e36a3a409921",
                    "sense_definition": "The quality or condition of being significant, valuable, or worthy of attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education is of great <w>importance</w> for the future of the country.",
                            "target_lang_translations": {
                                "ru": "Образование представляет огромную <w>важность</w> для будущего страны.",
                                "zh": "教育对国家的未来具有极大的<w>重要性</w>。"
                            }
                        },
                        {
                            "text": "The doctor explained the <w>importance</w> of getting enough sleep every night.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил <w>важность</w> полноценного сна каждую ночь.",
                                "zh": "医生解释了每晚保证充足睡眠的<w>重要性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "significance",
                        "value",
                        "consequence",
                        "weight"
                    ],
                    "antonyms": [
                        "insignificance",
                        "unimportance",
                        "triviality"
                    ],
                    "common_phrases": [
                        "of great importance",
                        "attach importance to",
                        "utmost importance",
                        "matter of importance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние значительности, ценности или того, что заслуживает внимания.",
                        "zh": "指事物具有重大价值、意义或值得关注的性质或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важность",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "значимость",
                                "target_lang_sense_clarification": "существенность, весомость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重要性",
                                "target_lang_sense_clarification": "指事物所具有的价值或意义"
                            },
                            {
                                "target_lang_word": "意义",
                                "target_lang_sense_clarification": "指事物所包含的价值或作用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffae7390-ac19-3f99-81d1-d96db86accff",
                    "sense_definition": "High personal status, influence, or social standing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked into the room with an air of <w>importance</w> that commanded attention.",
                            "target_lang_translations": {
                                "ru": "Он вошел в комнату с видом собственной <w>важности</w>, который требовал внимания.",
                                "zh": "他走进房间时带着一种引人注目的<w>威严</w>神态。"
                            }
                        },
                        {
                            "text": "She is a person of some <w>importance</w> in the local business community.",
                            "target_lang_translations": {
                                "ru": "Она — человек определенной <w>значимости</w> в местном деловом сообществе.",
                                "zh": "她在当地商界是一位有一定<w>地位</w>的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "status",
                        "standing",
                        "prestige",
                        "eminence"
                    ],
                    "antonyms": [
                        "obscurity"
                    ],
                    "common_phrases": [
                        "person of importance",
                        "air of importance",
                        "sense of importance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий личный статус, влияние или общественное положение.",
                        "zh": "指个人的社会地位高、影响力大或身份显赫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важность",
                                "target_lang_sense_clarification": "высокомерие, напыщенность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显赫",
                                "target_lang_sense_clarification": "指地位高、名声大"
                            },
                            {
                                "target_lang_word": "地位",
                                "target_lang_sense_clarification": "指人在社会中的位置或身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12721468-46e4-3658-9fb8-6129a1230518",
                    "sense_definition": "A specific thing, event, or matter that is considered significant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>importances</w> of daily life often keep us from thinking about the future.",
                            "target_lang_translations": {
                                "ru": "Мелкие <w>важности</w> повседневной жизни часто мешают нам думать о будущем.",
                                "zh": "日常生活中琐碎的<w>要事</w>常常使我们无暇思考未来。"
                            }
                        },
                        {
                            "text": "He listed the various <w>importances</w> required for the long journey ahead.",
                            "target_lang_translations": {
                                "ru": "Он перечислил различные <w>важности</w>, необходимые для предстоящего долгого путешествия.",
                                "zh": "他列举了前方漫长旅途中所需的各项<w>要点</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная вещь, событие или дело, которое считается значимым.",
                        "zh": "指被认为具有重大意义的具体事物、事件或事项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важный момент",
                                "target_lang_sense_clarification": "нечто значимое, важное дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "要事",
                                "target_lang_sense_clarification": "指重要的事情"
                            },
                            {
                                "target_lang_word": "要点",
                                "target_lang_sense_clarification": "指关键的环节或内容"
                            }
                        ]
                    }
                }
            ]
        }
    ]
