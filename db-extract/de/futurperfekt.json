                        "tags": [],
                        "examples": [
                            {
                                "example_id": "870c528d-0b8f-45d7-9e0d-27a7bfb8860f",
                                "sense_id": "aaf663b2-0b73-3915-81d8-d1050a5e8389",
                                "text": "„Auch die Formen im Konjunktiv Futurperfekt erscheinen vor allem für den Bezug auf Äußerungen anderer.“"
                            },
                            {
                                "example_id": "ac6fc5b3-5ea6-4e5f-adf3-0a740eed9441",
                                "sense_id": "aaf663b2-0b73-3915-81d8-d1050a5e8389",
                                "text": "„Das Futurperfekt (Futur II; frz. futur antérieur) als Vorzukunft entspricht dem deutschen Futur II.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
