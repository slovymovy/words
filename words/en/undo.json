                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document contained a typo where the author wrote <w>undo</w> instead of undue.",
                            "target_lang_translations": {
                                "ru": "В документе была опечатка: автор написал <w>undo</w> вместо undue.",
                                "cs": "Dokument obsahoval překlep, kde autor napsal <w>undo</w> místo undue.",
                                "de": "Das Dokument enthielt einen Tippfehler, bei dem der Autor <w>undo</w> anstelle von 'undue' schrieb.",
                                "nl": "Het document bevatte een typefout waarbij de auteur <w>undo</w> schreef in plaats van undue."
                            }
                        },
                        {
                            "text": "Using <w>undo</w> in this context is technically a misspelling of the intended adjective.",
                            "target_lang_translations": {
                                "ru": "Использование <w>undo</w> в этом контексте технически является орфографической ошибкой вместо нужного прилагательного.",
                                "cs": "Použití <w>undo</w> v tomto kontextu je technicky vzato pravopisná chyba místo zamýšleného přídavného jména.",
                                "de": "Die Verwendung von <w>undo</w> in diesem Kontext ist technisch gesehen eine falsche Schreibweise des beabsichtigten Adjektivs.",
                                "nl": "Het gebruik van <w>undo</w> in deze context is technisch gezien een spelfout van het bedoelde bijvoeglijk naamwoord."
                            }
                        }
