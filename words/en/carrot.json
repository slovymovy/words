{
    "word_family": [
        "carrot-top",
        "carroty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2b3bd6e-62df-334b-8569-3cdea616e454",
                    "sense_definition": "A long, orange root vegetable that is often eaten raw or cooked.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vegetables",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually add a chopped <w>carrot</w> to my salad for extra crunch.",
                            "target_lang_translations": {
                                "ru": "Я обычно добавляю нарезанную <w>морковь</w> в салат для хруста."
                            }
                        },
                        {
                            "text": "The rabbit was happily eating a <w>raw</w> <w>carrot</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "Кролик с удовольствием грыз <w>сырую</w> <w>морковку</w> в саду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "raw carrot",
                        "chopped carrot",
                        "carrot juice",
                        "carrot cake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный оранжевый корнеплод, который часто едят сырым или приготовленным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морковь",
                                "target_lang_sense_clarification": "собирательное название овоща"
                            },
                            {
                                "target_lang_word": "морковка",
                                "target_lang_sense_clarification": "отдельный корнеплод или уменьшительно-ласкательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daf65eba-75aa-3f71-b8cc-01a2b34cd161",
                    "sense_definition": "A reward or incentive offered to someone to encourage them to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incentive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager used a bonus as a <w>carrot</w> to increase productivity.",
                            "target_lang_translations": {
                                "ru": "Менеджер использовал бонус в качестве <w>пряника</w>, чтобы повысить производительность."
                            }
                        },
                        {
                            "text": "The government is using a <w>carrot</w> <w>and</w> <w>stick</w> approach to environmental policy.",
                            "target_lang_translations": {
                                "ru": "Правительство использует политику <w>кнута</w> <w>и</w> <w>пряника</w> в вопросах экологии."
                            }
                        }
                    ],
                    "antonyms": [
                        "stick"
                    ],
                    "common_phrases": [
                        "carrot and stick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Награда или стимул, предлагаемые кому-либо, чтобы побудить его что-то сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пряник",
                                "target_lang_sense_clarification": "в контексте поощрения, как в выражении «кнут и пряник»"
                            },
                            {
                                "target_lang_word": "приманка",
                                "target_lang_sense_clarification": "средство привлечения или соблазна"
                            },
                            {
                                "target_lang_word": "стимул",
                                "target_lang_sense_clarification": "общее значение побудительного фактора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "771ee348-b54c-3506-b121-e52685b2c8d8",
                    "sense_definition": "A bright shade of orange similar to the color of the vegetable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunset was a brilliant shade of <w>carrot</w> orange.",
                            "target_lang_translations": {
                                "ru": "Закат был ярко-<w>морковного</w> цвета."
                            }
                        },
                        {
                            "text": "She decided to paint the kitchen walls in a warm <w>carrot</w> hue.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить стены кухни в теплый <w>морковный</w> оттенок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carrot orange"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий оттенок оранжевого, похожий на цвет моркови."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морковный",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9368c7c-3dfb-312b-9132-210634e34c2f",
                    "sense_definition": "A person with red or ginger hair.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kids at school used to call him <w>carrot</w> because of his bright hair.",
                            "target_lang_translations": {
                                "ru": "Дети в школе дразнили его <w>рыжим</w> из-за его ярких волос."
                            }
                        },
                        {
                            "text": "He was a tall <w>carrot</w> with a face full of freckles.",
                            "target_lang_translations": {
                                "ru": "Он был высоким <w>рыжиком</w> с веснушчатым лицом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с рыжими волосами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыжий",
                                "target_lang_sense_clarification": "о человеке с рыжими волосами"
                            },
                            {
                                "target_lang_word": "рыжик",
                                "target_lang_sense_clarification": "ласковое или шутливое прозвище"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8160eaab-85cd-3d47-9906-e98cbc4ef108",
                    "sense_definition": "A person from a rural or country background.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city dwellers looked down on the <w>carrot</w> who had just moved to town.",
                            "target_lang_translations": {
                                "ru": "Горожане свысока смотрели на <w>деревенщину</w>, который только что переехал в город."
                            }
                        },
                        {
                            "text": "He was a simple <w>carrot</w> who preferred the quiet of the fields.",
                            "target_lang_translations": {
                                "ru": "Он был простым <w>сельским</w> парнем, который предпочитал тишину полей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal and potentially derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек из сельской местности или деревни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "пренебрежительное обозначение сельского жителя"
                            },
                            {
                                "target_lang_word": "селюк",
                                "target_lang_sense_clarification": "сленговое, часто грубое обозначение провинциала"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7987be7c-7e1d-3344-8369-e45113d79841",
                    "sense_definition": "To treat an animal pelt with mercuric nitrate during the process of making felt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manufacturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>carrot</w> the furs before they could be turned into hats.",
                            "target_lang_translations": {
                                "ru": "Рабочим приходилось <w>морковать</w> мех перед тем, как делать из него шляпы."
                            }
                        },
                        {
                            "text": "The process to <w>carrot</w> pelts was dangerous due to the mercury involved.",
                            "target_lang_translations": {
                                "ru": "Процесс <w>моркования</w> шкур был опасен из-за использования ртути."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to an older industrial process"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать шкуру животного нитратом ртути в процессе изготовления фетра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моркование",
                                "target_lang_sense_clarification": "технический термин в производстве фетра"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}