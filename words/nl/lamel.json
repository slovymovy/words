                    "sense_id": "281cc45e-e300-3596-9f57-fbce4a97c140",
                    "sense_definition": "Een dunne, platte strook of plaatje van hout, kunststof of metaal, vaak gebruikt als onderdeel van zonwering of jaloezieën.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zonwering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draaide aan de knop om elke <w>lamel</w> van de jaloezie te sluiten en het zonlicht buiten te houden.",
                            "target_lang_translations": {
                                "en": "He turned the knob to close every <w>slat</w> of the blind and keep the sunlight out."
                            }
                        },
                        {
                            "text": "De zonwering bestaat uit een verticale <w>lamel</w> die gemakkelijk kan worden schoongemaakt.",
                            "target_lang_translations": {
                                "en": "The window covering consists of a vertical <w>slat</w> that can be easily cleaned."
                            }
                        }
                    ],
                    "synonyms": [
                        "jaloeziestrook",
                        "lamelstrook"
                    ],
                    "common_phrases": [
                        "verticale lamel",
                        "lamel van kunststof"
                    ],
                    "target_lang_definitions": {
                        "en": "A thin, flat strip or plate of wood, plastic, or metal, often used as part of blinds or window coverings."
                    },
                    "translations": {
