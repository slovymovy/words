                "senses": [
                    {
                        "sense_id": "73ecfdd1-db8b-3a7f-929c-f6710ad7229d",
                        "entry_id": "68439d93-0b0e-3633-8b0d-f615320976b3",
                        "glosses": [
                            "eenvoudig medicijn dat zonder recept verkocht mag worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "244f5051-7936-4d9f-8ae0-132adb382b5f",
                                "sense_id": "73ecfdd1-db8b-3a7f-929c-f6710ad7229d",
                                "text": "Vrijwel iedere cent die wordt besteed aan een vrij verkrijgbaar zelfzorgmiddel dat mensen kopen bij de drogist om griep te bestrijden, is weggegooid geld."
                            },
                            {
                                "example_id": "2cbfd1c4-bed2-4249-bb28-f338cf19ed2e",
                                "sense_id": "73ecfdd1-db8b-3a7f-929c-f6710ad7229d",
                                "text": "Ouders kunnen dan zelf al met zelfzorgmiddelen een behandeling starten, of ze kunnen bepalen of een kind professionele zorg nodig heeft."
                            },
                            {
                                "example_id": "9d3b2a71-bc9f-4e00-ba6b-3157236c7a23",
                                "sense_id": "73ecfdd1-db8b-3a7f-929c-f6710ad7229d",
                                "text": "Er bestaat geen doorslaggevend bewijs dat het populaire voedingssupplement glucosamine effectief is tegen gewrichtsslijtage, maar Zwitserse en Duitse onderzoekers beweren in Nature Communications een veel belangrijker effect van het zelfzorgmiddel te hebben ontdekt: muizen die glucosamine kregen, hadden een tien procent langere levensduur, vergelijkbaar met acht extra levensjaren bij mensen."
                            }
                        ]
                    }
