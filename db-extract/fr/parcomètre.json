                "senses": [
                    {
                        "sense_id": "6d979449-70e3-3aad-8c65-706a072e9629",
                        "entry_id": "b0dc485f-143d-3cd7-8de8-a4b4f0997394",
                        "glosses": [
                            "Variante de parcmètre."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "12c8cb92-2722-4573-aa15-c766b475430f",
                                "sense_id": "6d979449-70e3-3aad-8c65-706a072e9629",
                                "text": "Le préposé se déplace sur le trottoir d’un parcomètre à l’autre et n’est donc pas obligé de respecter les sens uniques indiqués sur la figure."
                            },
                            {
                                "example_id": "06158d13-11b1-488d-9083-35aba216b1af",
                                "sense_id": "6d979449-70e3-3aad-8c65-706a072e9629",
                                "text": "Les systèmes suivants sont appliqués : zones bleues, stationnement à terme fixe contrôlé par des disques ou parcomètres, et zones réservées aux livraisons de marchandises dans les magasins."
                            },
                            {
                                "example_id": "3734e799-1bf0-4bea-814e-1aa67e8b8011",
                                "sense_id": "6d979449-70e3-3aad-8c65-706a072e9629",
                                "text": "Les clients qui viendront magasiner en voiture n’auront pas à verser d’argent dans les parcomètres durant cette période et cette mesure s’applique à l’ensemble du territoire montréalais."
                            }
                        ]
                    }
                ],
