                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e951ee-336c-4081-8226-c1693008f821",
                                "sense_id": "f73649e1-8b5a-3be2-a0bb-2c3b95167a04",
                                "text": "„Einmal blieb er sogar stehen, um ein paar zum Verkauf angebotene Hühner zu begutachten, die in kleinen Holzkäfigen am Rücken eines Esels hingen.“"
                            },
                            {
                                "example_id": "5d6720b4-25ab-43c3-8a27-11b3648f8f56",
                                "sense_id": "f73649e1-8b5a-3be2-a0bb-2c3b95167a04",
                                "text": "„Geradeaus erspähte er einen ungeordneten Polizeiposten neben einer lang gezogenen Holz- und Wellblechüberdachung, die Hunderten von Holzkäfigen Platz bot.“"
                            }
                        ],
