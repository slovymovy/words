                            {
                                "example_id": "42259e27-458b-47c6-bee2-a99118139b4e",
                                "sense_id": "14ef9c52-2c29-34af-ad7d-ac443aca90db",
                                "text": "Apple crumble: het ideale toetje in een gourmetpannetje. Tip: geen kaneelsuiker in huis? Meng dan 1 tl kaneel met 4 el kristalsuiker."
                            },
                            {
                                "example_id": "8a744e9d-62e2-4d64-87ee-4d30e1b41765",
                                "sense_id": "14ef9c52-2c29-34af-ad7d-ac443aca90db",
                                "text": "Dan gaat het fruit grof gesneden in de bakvorm, vervolgens de marshmallows erbij. ,,Het lekkere daaraan is dat het in de oven een beetje gaat smelten’’, zegt Jansen. Tot slot voegt hij er nog wat pecannoten aan toe. ,,En daarover gaat de crumble.’’"
                            },
                            {
                                "example_id": "3a9f2977-4f0d-4fff-a655-96fddf122046",
                                "sense_id": "14ef9c52-2c29-34af-ad7d-ac443aca90db",
                                "text": ",,Met een mislukt bananenbrood kun je nog best veel. Je kunt er een crumble van maken en ermee ontbijten, of een stukje grillen met stukjes chocola erop. Dan heb je een kleine snack. Van droog bananenbrood kun je zelfs nog granola maken.”"
                            }
                        ]
