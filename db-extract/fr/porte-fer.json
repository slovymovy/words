                ],
                "senses": [
                    {
                        "sense_id": "a35975c1-d328-3410-abec-cff9a410cbd6",
                        "entry_id": "5d7ab08d-0505-3772-ad9b-721d961f6a6b",
                        "glosses": [
                            "Poche de cuir, contenant un fer à cheval et placée sous chaque quartier de la selle, en arrière de la cuisse du cavalier, qui est ainsi muni d’un fer de rechange pour le pied de devant et d’un pour le pied de derrière."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c5d5b159-ab2e-3e2b-82ca-5027c8b492b6",
                        "entry_id": "5d7ab08d-0505-3772-ad9b-721d961f6a6b",
                        "glosses": [
                            "Support pour un fer à braser / fer à souder, servant notamment de protection quand ce dernier est chaud."
                        ],
                        "tags": [
                            "Électrotechnique"
                        ],
                        "examples": [
                            {
                                "example_id": "63871c7a-9576-4544-b93e-cc0363d1d910",
                                "sense_id": "c5d5b159-ab2e-3e2b-82ca-5027c8b492b6",
                                "text": "L’élément central de cette station de soudage est la station de base. Compacte, celle-ci comprend un interrupteur marche/arrêt illuminé, un porte-fer, des compartiments réservés au rangement des bobines d’étain, des pannes et de l'éponge. Le fer à souder de 23 cm de long est relié à la station par un cordon flexible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1b15c51-896b-4492-b1b2-b39c4d77346a",
                        "source_entry_id": "5d7ab08d-0505-3772-ad9b-721d961f6a6b",
                        "source_sense_id": "c5d5b159-ab2e-3e2b-82ca-5027c8b492b6",
