                        "sense_id": "08aafe2a-ec84-3b2a-aa64-04d1e7af57cb",
                        "entry_id": "531e8f63-d473-3d43-b450-fc373967f79b",
                        "glosses": [
                            "handschoen die gedragen moet worden tijdens het boksen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c5cd03-e2b5-4e8c-a140-f722d63bdbb5",
                                "sense_id": "08aafe2a-ec84-3b2a-aa64-04d1e7af57cb",
                                "text": "Ze staat zelf op de cover van het laatste nummer: strijdbaar, sterk, bokshandschoenen aan haar handen. Hoda Hamdaoui (Al Hoceima, 1974) begon vijf jaar geleden het eerste lifestylemagazine over Marokkaans-Nederlandse vrouwen: hoda magazine. Ze was zelf altijd al gek op mooie bladen, maar zag nooit zichzelf terug in een glossy. Iedereen was wit. Zij wilde de 80.000 Marokkaans-Nederlandse vrouwen tussen zestien en veertig in Nederland, die bladenmakers links laten liggen, wél bereiken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc59f706-add8-49e7-bca5-aefda1ae59a1",
                        "source_entry_id": "531e8f63-d473-3d43-b450-fc373967f79b",
                        "source_sense_id": "08aafe2a-ec84-3b2a-aa64-04d1e7af57cb",
                        "source_sense_description": "handschoen gedragen tijdens het boksen",
                        "target_lang_word": "Boxhandschuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boxhandschuh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5cd0709-5f66-3a65-8e26-cadab1eb53ee",
                                        "entry_id": "f27811c9-e634-3515-bbee-035332947f77",
                                        "glosses": [
                                            "gepolsterter Handschuh aus Leder, der beim Boxen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f8899f-0220-4cee-914d-ead7061017b6",
                                                "sense_id": "a5cd0709-5f66-3a65-8e26-cadab1eb53ee",
                                                "text": "„Vor dem Wiener Museumsquartier installierte er etwa 2011 einen riesig aufgeblasenen Boxhandschuh mit der Aufschrift \"We got the Power\".“"
                                            },
                                            {
                                                "example_id": "e8b36b39-78ae-4c88-9e2a-5ee88a4057a5",
                                                "sense_id": "a5cd0709-5f66-3a65-8e26-cadab1eb53ee",
                                                "text": "„Er hatte die längsten Hände, die ich je an einem Boxer gesehen hatte; in normale Boxhandschuhe würden die nicht passen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
