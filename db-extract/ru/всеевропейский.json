                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "15c73405-7590-47e8-bbed-9c71d7ed8243",
                        "source_entry_id": "4998954f-6423-3fba-bffa-39c49c17f4d3",
                        "source_sense_id": "12460ea6-970c-385e-a99a-b2725084ecc6",
                        "target_lang_word": "paneuropäisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paneuropäisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acad56b8-8c99-3bce-9250-781f4e39047d",
                                        "entry_id": "d9e6cbf5-5894-370b-adbf-64160da562ad",
                                        "glosses": [
                                            "das gesamte Europa betreffend, im gesamten Europa vorkommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100a7026-9754-4b30-bb61-cef0ac4b58f3",
                                                "sense_id": "acad56b8-8c99-3bce-9250-781f4e39047d",
                                                "text": "„Nach den Erfahrungen zweier verheerender Kriege in Europa lag es nahe, paneuropäische Gedanken aus den zwanziger Jahren wieder aufzugreifen, um eine Ordnung zu schaffen, die künftig Sicherheit, Frieden und Wohlstand garantiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d5de79d-604b-4364-8cde-fe63999f13e4",
                        "source_entry_id": "4998954f-6423-3fba-bffa-39c49c17f4d3",
                        "source_sense_id": "12460ea6-970c-385e-a99a-b2725084ecc6",
                        "target_lang_word": "gesamteuropäisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "71fb894e-7a3b-4186-b263-c197c0bed7e9",
                        "source_entry_id": "4998954f-6423-3fba-bffa-39c49c17f4d3",
                        "source_sense_id": "12460ea6-970c-385e-a99a-b2725084ecc6",
                        "target_lang_word": "europaweit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "europaweit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa2ffee-0843-37c8-a663-1b62f97a377d",
                                        "entry_id": "d4ef57b9-8d1a-34a8-a858-3ac2daaca555",
                                        "glosses": [
                                            "ganz Europa umfassend, betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7f85d0-6ab5-462d-aa3a-844542f041f7",
                                                "sense_id": "5fa2ffee-0843-37c8-a663-1b62f97a377d",
                                                "text": "„Mit dem Ziel eines europaweiten Raums der Freiheit, der Sicherheit und des Rechts arbeiten die EU-Mitgliedstaaten auch in der Innen- und Justizpolitik zusammen.“"
                                            },
                                            {
                                                "example_id": "b6eba9fd-f204-40a4-9b3e-c67989ef80a5",
                                                "sense_id": "5fa2ffee-0843-37c8-a663-1b62f97a377d",
                                                "text": "„Beschenkt von Adligen und Bischöfen, errichten die Templer europaweit Niederlassungen, die sogenannten Komtureien.“"
                                            },
                                            {
                                                "example_id": "c364d730-3ea7-4a6f-8c6a-61c937dc5dab",
                                                "sense_id": "5fa2ffee-0843-37c8-a663-1b62f97a377d",
                                                "text": "„Von der Öffentlichkeit unbemerkt, läuft gerade ein unglaubliches Bubenstück in der EU-Gesetzgebung betreffs europaweiter Dienstzeitregelungen für Piloten ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fdad518-be83-40f0-baac-7ca31d923368",
                        "source_entry_id": "4998954f-6423-3fba-bffa-39c49c17f4d3",
                        "source_sense_id": "12460ea6-970c-385e-a99a-b2725084ecc6",
                        "target_lang_word": "paneuropéen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paneuropéen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06c3461e-6385-3048-91e5-15bd90c025ff",
                                        "entry_id": "e7c2840a-1dd5-3a57-9b61-6c71286d24ef",
                                        "glosses": [
                                            "Relatif à l’Europe dans son entièreté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c92d86-3d21-4d82-9bfb-5c24866c01d8",
                                                "sense_id": "06c3461e-6385-3048-91e5-15bd90c025ff",
                                                "text": "Les médias paneuropéens tiennent tête à Internet."
                                            },
                                            {
                                                "example_id": "47b821e1-4955-4cd0-9f81-78970f08c69c",
                                                "sense_id": "06c3461e-6385-3048-91e5-15bd90c025ff",
                                                "text": "Neuf Corridors paneuropéens de transport ont été définis, à la seconde conférence paneuropéenne des transports en Crète en mars 1994."
                                            },
                                            {
                                                "example_id": "b9ddea90-6b10-49a3-91bb-8f29b5fc8d29",
                                                "sense_id": "06c3461e-6385-3048-91e5-15bd90c025ff",
                                                "text": "Si les partis politiques paneuropéens ont bien reçu une reconnaissance institutionnelle et des ressources financières au fil du temps, ils sont toujours constitués de fédérations extra-parlementaires des partis nationaux."
                                            },
                                            {
                                                "example_id": "78d8fb6c-412b-45a3-a497-e7fb7956ed12",
                                                "sense_id": "06c3461e-6385-3048-91e5-15bd90c025ff",
                                                "text": "Et tu nous balances tout ça en plus de ta carte permanente paneuropéenne – les gens ont le choix entre du *fish and chips* fait à la friteuse et une salade noyée dans le gras de saucisse. — (Daniel Nayeri, Notre-Dame des Traîtres, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 233)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc1bdb59-d2b1-459c-98df-42e485411391",
                        "source_entry_id": "4998954f-6423-3fba-bffa-39c49c17f4d3",
                        "source_sense_id": "12460ea6-970c-385e-a99a-b2725084ecc6",
