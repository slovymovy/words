                                                "sense_id": "ab4eece6-8fb9-3970-b1fe-bf1f12ee5830",
                                                "text": "Si quel qu’un pouvait apprendre en un jour à jouer du luth excellemment."
                                            },
                                            {
                                                "example_id": "cf058d50-26e3-4bf6-a54b-9ceb782b8f3d",
                                                "sense_id": "ab4eece6-8fb9-3970-b1fe-bf1f12ee5830",
                                                "text": "La Lobivia jajoiana rend excellemment dans les températures basses et Mr Smith, de Koningstown College, m’en a recommandé la culture."
                                            },
                                            {
                                                "example_id": "df7c9142-df4d-4e51-80b8-754fc02fbe1e",
                                                "sense_id": "ab4eece6-8fb9-3970-b1fe-bf1f12ee5830",
                                                "text": "Comme dit excellemment saint Jean Chrysostome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abab397d-2dfc-385e-a568-898deac4f37f",
                                        "entry_id": "1fdab7fe-6fc1-3854-9457-4f04066efaad",
                                        "glosses": [
                                            "Par excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a317983-ac46-4842-af45-550b485a5e9f",
                                                "sense_id": "abab397d-2dfc-385e-a568-898deac4f37f",
                                                "text": "Qui n’est pas contre eux est excellemment pour eux."
                                            },
                                            {
                                                "example_id": "2dd9d92a-e862-4fbe-8c53-6f1fbd59f7c5",
                                                "sense_id": "abab397d-2dfc-385e-a568-898deac4f37f",
                                                "text": "La pudeur, en colorant vos joues, vous rend excellemment belle."
                                            }
                                        ]
                                    }
                                ]
