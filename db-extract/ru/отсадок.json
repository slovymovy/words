                "senses": [
                    {
                        "sense_id": "6c9dd3a1-447c-373b-a90e-140d78b6252e",
                        "entry_id": "f73f36e4-c1e6-37d0-aee8-898893ea5788",
                        "glosses": [
                            "спец. отсаженное растение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d2fb218-2b37-46fc-879c-d72dbd8d73c2",
                                "sense_id": "6c9dd3a1-447c-373b-a90e-140d78b6252e",
                                "text": "— А имеете ли вы плющ? ― Нет, не имеем. ― Так я обещаю вам несколько отсадков."
                            },
                            {
                                "example_id": "8fd5ca44-3ef8-40d0-9f5e-8611e4d4903c",
                                "sense_id": "6c9dd3a1-447c-373b-a90e-140d78b6252e",
                                "text": "Сеять под стеклом; пересадить и выращивать молодые отсадки в богатой почве, на ограниченном пространстве, где за ними можно тщательно ухаживать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43d90302-9e1d-4ac2-8e9a-de3776cd90e2",
                        "source_entry_id": "f73f36e4-c1e6-37d0-aee8-898893ea5788",
                        "source_sense_id": "6c9dd3a1-447c-373b-a90e-140d78b6252e",
