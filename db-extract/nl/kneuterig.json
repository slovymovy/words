                                "target_senses": [
                                    {
                                        "sense_id": "c68db62d-634f-320c-b49c-857a590ae164",
                                        "entry_id": "0b17bb01-fccb-3102-bf24-084f86837fbd",
                                        "glosses": [
                                            "Wohlbehagen, Gemütlichkeit erweckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0378d21c-6a63-4d9f-8852-288a7f53afac",
                                                "sense_id": "c68db62d-634f-320c-b49c-857a590ae164",
                                                "text": "Du hast dein Zimmer wirklich behaglich eingerichtet."
                                            },
                                            {
                                                "example_id": "29021f0c-60a4-4b44-be32-20b1dc698af1",
                                                "sense_id": "c68db62d-634f-320c-b49c-857a590ae164",
                                                "text": "„Doch der Mensch lebt nicht vom Entertainment allein und die behaglichste historische Atmosphäre garantiert noch längst keinen wirtschaftlichen Erfolg.“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b643470-44b8-3183-af53-0ea16e50e96c",
                                        "entry_id": "0b17bb01-fccb-3102-bf24-084f86837fbd",
                                        "glosses": [
                                            "Wohlbehagen, Gemütlichkeit empfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4aa00b4-8d95-4b42-b570-c0b995efba55",
                                                "sense_id": "8b643470-44b8-3183-af53-0ea16e50e96c",
                                                "text": "Es gab eine Zeit, da konnten sich die Chefs der großen Baumärkte in Deutschland behaglich in ihren Sesseln zurücklehnen."
                                            },
                                            {
                                                "example_id": "a07f9e00-e990-446a-8853-243efa0a282e",
                                                "sense_id": "8b643470-44b8-3183-af53-0ea16e50e96c",
                                                "text": "„Um das zu verhindern und wohl auch, um persönlich voranzukommen, hat der CIA-Mann das behagliche Brüssel gegen das schweißtreibende Léopoldville getauscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "063623bd-fd66-4b3e-98d7-4636b9f9fb02",
