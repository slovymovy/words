                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience <w>clapped</w> loudly after the performance ended.",
                            "target_lang_translations": {
                                "ru": "Зрители громко <w>хлопали</w> после окончания выступления."
                            }
                        },
                        {
                            "text": "Everyone <w>clapped</w> when the singer finished the song.",
                            "target_lang_translations": {
                                "ru": "Все <w>аплодировали</w>, когда певец закончил песню."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clapped hands"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «хлопать» (в ладоши)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопали",
                                "target_lang_sense_clarification": "форма прошедшего времени глагола «хлопать»"
                            },
                            {
                                "target_lang_word": "аплодировали",
                                "target_lang_sense_clarification": "выражение одобрения аплодисментами"
                            }
                        ]
                    }
                }
            ]
        },
        {
