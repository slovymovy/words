                                            {
                                                "example_id": "f16581a8-1a22-4740-8518-6d06a36e7de1",
                                                "sense_id": "ba657152-8e6b-31d8-8dbb-d1b62ca4e304",
                                                "text": "Borne, 61 jaar, was lang lid van de sociaaldemocratische Parti socialiste, tot ze in 2017 overstapte naar Macrons La République en Marche."
                                            },
                                            {
                                                "example_id": "c51e8fd4-1c6b-4458-a657-1476cd104175",
                                                "sense_id": "ba657152-8e6b-31d8-8dbb-d1b62ca4e304",
                                                "text": "En hij had hopelijk zowel geamuseerd als humoristisch verteld over de gevreesde sociaaldemocratische machtsovername in Saltsjôbaden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
