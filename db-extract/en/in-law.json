                    {
                        "translation_id": "19813252-d10d-4975-a9ed-aafc1455382f",
                        "source_entry_id": "dbb98584-3649-3621-ba0e-b408a610914b",
                        "source_sense_description": "relative by marriage",
                        "target_lang_word": "Schwiegerfamilie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwiegerfamilie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                        "entry_id": "5bd1bbc4-c356-32c5-8387-3180f2b9239a",
                                        "glosses": [
                                            "Familie des Ehegatten oder der Ehegattin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc41b91-378d-4667-9251-ad2f76ad2057",
                                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                                "text": "„Nach der Skizzierung der Vorstellungen über Paarbeziehungen maghrebinisch-europäischer Paare und der familialen Lebenswelten, stehen nun die Herkunfts- und Schwiegerfamilien zur Diskussion.“"
                                            },
                                            {
                                                "example_id": "5e683d43-adaa-455c-9d9f-cb7261f9cddd",
                                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                                "text": "„Offene oder verdeckte Ablehnung der Schwiegerfamilien wird oft zu einer Quelle ständiger Konflikte oder einer schwer zu überwindenden Distanz der Partner.“"
                                            },
                                            {
                                                "example_id": "7762aa2e-0900-4719-9878-c94f7b01a79a",
                                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                                "text": "„Eine etwas günstigere Situation besteht, wenn die Schwiegerfamilie die Homosexualität der Tochter oder des Sohnes weitgehend ignoriert.“"
                                            },
                                            {
                                                "example_id": "10437452-4fac-411a-940d-bcdb376f81bd",
                                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                                "text": "„Der gesellschaftliche Status ändert sich, vielleicht die Wohnsituation, der Kontostand, der Freundes- und Bekanntenkreis, die Beziehung zur Schwiegerfamilie, die Nachbarschaft.“"
                                            },
                                            {
                                                "example_id": "331155f1-0572-47e1-9df8-6ec7d1c2626f",
                                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                                "text": "„Mit ihrer Heirat tritt eine junge Frau dann in den Verbund der Schwiegerfamilie ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33ed0421-1c96-439e-b77b-f142525f1727",
                        "source_entry_id": "dbb98584-3649-3621-ba0e-b408a610914b",
                        "source_sense_description": "relative by marriage",
                        "target_lang_word": "Schwager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bca29857-0cb9-32bf-a7cb-8321c784ef79",
                                        "entry_id": "94599f1d-2d92-3da7-a442-e118cb7b061b",
                                        "glosses": [
                                            "Bruder des Ehepartners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a4bfcd-ab90-4e24-bdfc-8116d75e71b9",
                                                "sense_id": "bca29857-0cb9-32bf-a7cb-8321c784ef79",
                                                "text": "Für mein' Schwager hier auch 'ne Currywurst."
                                            },
                                            {
                                                "example_id": "e3d70345-c515-4e25-b1d2-35176a2c93a1",
                                                "sense_id": "bca29857-0cb9-32bf-a7cb-8321c784ef79",
                                                "text": "„Sein Schwager hielt bereits in der Kirche eine schöne Rede, in der er einen Wunsch des Verstorbenen erwähnte, den dieser noch auf dem Sterbebett zu Papier gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "85bf1755-f787-4087-9fbe-1787d71d6969",
                                                "sense_id": "bca29857-0cb9-32bf-a7cb-8321c784ef79",
                                                "text": "„Nach Jahren hatte er mit seinem Schwager allein eines Nachmittags in der Gaststube gesessen und war plötzlich aufgesprungen und hatte getan, als hörte er etwas Schreckliches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a66a4f87-0aec-31a2-a7e4-4abf1369a530",
                                        "entry_id": "94599f1d-2d92-3da7-a442-e118cb7b061b",
                                        "glosses": [
                                            "männlicher Ehepartner der Schwester oder des Bruders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a014ba-9a21-4092-8ba4-db6d70391515",
                                                "sense_id": "a66a4f87-0aec-31a2-a7e4-4abf1369a530",
                                                "text": "„Sein Schwager hielt bereits in der Kirche eine schöne Rede, in der er einen Wunsch des Verstorbenen erwähnte, den dieser noch auf dem Sterbebett zu Papier gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "30a11435-9470-440e-9de4-3142b30ca37c",
                                                "sense_id": "a66a4f87-0aec-31a2-a7e4-4abf1369a530",
                                                "text": "„Nach Jahren hatte er mit seinem Schwager allein eines Nachmittags in der Gaststube gesessen und war plötzlich aufgesprungen und hatte getan, als hörte er etwas Schreckliches.“"
                                            },
                                            {
                                                "example_id": "75a87f8e-6648-4a73-aa50-917086e94e6c",
                                                "sense_id": "a66a4f87-0aec-31a2-a7e4-4abf1369a530",
                                                "text": "„Ihr Schwager, der Bischof, umarmte und küßte sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3a952d27-6be0-3c57-8fab-89b3d9c07559",
                                        "entry_id": "94599f1d-2d92-3da7-a442-e118cb7b061b",
                                        "glosses": [
                                            "Postkutschenfahrer"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe32ef4-6c6f-4288-b429-31695818f443",
                                                "sense_id": "3a952d27-6be0-3c57-8fab-89b3d9c07559",
                                                "text": "Hoch auf dem gelben Wagen sitz' ich beim Schwager vorn."
                                            },
                                            {
                                                "example_id": "7fef0fc4-86a6-48fd-800a-f45a189d51ef",
                                                "sense_id": "3a952d27-6be0-3c57-8fab-89b3d9c07559",
                                                "text": "„Die für den Postillion in Süddeutschland auch übliche Bezeichnung »Schwager« ist eine Verballhornung des französischen Begriffs »Chevalier« beziehungsweise des schweizerischen Ausdrucks »Schewalger«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6ea18df-324d-4aa0-98f3-27e412eba48e",
                        "source_entry_id": "dbb98584-3649-3621-ba0e-b408a610914b",
