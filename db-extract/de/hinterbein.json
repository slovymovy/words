                                "target_senses": [
                                    {
                                        "sense_id": "7473f5d7-fb8f-31d4-a6f0-8f7da2b41d22",
                                        "entry_id": "cd256ce4-35f2-3c3f-9128-d37fca3ba5bb",
                                        "glosses": [
                                            "Either of the two legs towards the rear of a multilegged animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfc50211-de05-4867-955d-fd8f29a13f3f",
                                                "sense_id": "7473f5d7-fb8f-31d4-a6f0-8f7da2b41d22",
                                                "text": "Coordinate term: foreleg"
                                            },
                                            {
                                                "example_id": "c24febc9-7723-489c-aff9-febe3921322d",
                                                "sense_id": "7473f5d7-fb8f-31d4-a6f0-8f7da2b41d22",
                                                "text": "“Can you hop on your hind legs?” asked the furry rabbit.\nThat was a dreadful question, for the Velveteen Rabbit had no hind legs at all! The back of him was made all in one piece, like a pincushion. He sat still in the bracken, and hoped that the other rabbits wouldn’t notice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
