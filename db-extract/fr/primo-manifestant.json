                "senses": [
                    {
                        "sense_id": "ed77b7d6-42ce-38ee-96a9-30b2c4930e0e",
                        "entry_id": "c7e694a0-d185-33b0-ad64-115d39bf1cc1",
                        "glosses": [
                            "Personne qui participe pour la première fois à une manifestation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1e0b3f-511f-4def-9cf3-36affd7d70ed",
                                "sense_id": "ed77b7d6-42ce-38ee-96a9-30b2c4930e0e",
                                "text": "Ces \"conseils\" ont aussitôt inspiré les internautes qui ont déclenché une vague de twetts^([sic]) ironiques pour aider ces primo-manifestants comme #AstuceManifPourTous."
                            },
                            {
                                "example_id": "2cb3e12d-f9a4-4ca1-9d74-6507f72e2c79",
                                "sense_id": "ed77b7d6-42ce-38ee-96a9-30b2c4930e0e",
                                "text": "Parmi ceux qui ne sont pas des primo-manifestants, près de 70 % descendent régulièrement (plus de trois fois par an) dans la rue."
                            },
                            {
                                "example_id": "120b9e24-f4f1-4cbc-908f-e825557eeea9",
                                "sense_id": "ed77b7d6-42ce-38ee-96a9-30b2c4930e0e",
                                "text": "En fait, beaucoup étaient des primo-manifestants et ne s’étaient pas encore éveillés à la politique lors du pouvoir du Conseil Supérieur des Forces Armées."
                            },
                            {
                                "example_id": "8ec0651f-4680-48f8-9f1a-d725693c09eb",
                                "sense_id": "ed77b7d6-42ce-38ee-96a9-30b2c4930e0e",
                                "text": "Derrière chaque élève qui a choisi de sécher les cours, un primo-manifestant. Il tient son rang et sa banderole; l’un des cadets a douze ans (sa mère l’accompagne à distance!), l’aîné n’a pas encore atteint sa majorité."
                            }
                        ]
                    }
