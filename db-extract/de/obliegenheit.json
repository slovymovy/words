                ],
                "senses": [
                    {
                        "sense_id": "d02ecd2c-61f1-3eef-a6c3-aa5ddf75cb18",
                        "entry_id": "e2905b38-2543-35df-88af-4c414e8571b8",
                        "glosses": [
                            "jemandem zufallende Last, etwas zu unternehmen oder zu unterlassen, weil er anderenfalls durch Nichtbeachtung Nachteile erlangen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c61e071-1b28-48ea-a6e3-6fe382a4dd47",
                                "sense_id": "d02ecd2c-61f1-3eef-a6c3-aa5ddf75cb18",
                                "text": "Bei einem Wildunfall trifft den Fahrer die Obliegenheit, den Schaden bei der Polizei zu melden."
                            },
                            {
                                "example_id": "483d9271-b8a8-469a-8d2b-7c1e00216e2f",
                                "sense_id": "d02ecd2c-61f1-3eef-a6c3-aa5ddf75cb18",
                                "text": "„Für Robert gab gerade dieses versponnene Stillehalten, das den Figuren und ihren Obliegenheiten eigentümlich war, Anlaß zur Beunruhigung.“"
                            },
                            {
                                "example_id": "3cc41847-3b73-45ab-90b0-dfb11e45c920",
                                "sense_id": "d02ecd2c-61f1-3eef-a6c3-aa5ddf75cb18",
                                "text": "„Jeder erledigt seine Obliegenheiten nach bestem Vermögen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
