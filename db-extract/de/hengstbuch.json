                "senses": [
                    {
                        "sense_id": "17bd398e-3b6c-3aa2-973e-a79909755f8a",
                        "entry_id": "c0a15e2a-b1c5-320a-a399-e8c5c868fee3",
                        "glosses": [
                            "Buch mit Angaben zu als Zuchttiere eingesetzten Hengsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f890498-f881-4be0-b59c-6c61544591cd",
                                "sense_id": "17bd398e-3b6c-3aa2-973e-a79909755f8a",
                                "text": "„Er klopfte sich auf die Westentasche, wo er die Papiere verstaut hatte, seine eigenen und das Hengstbuch, das Sturmkönigs Abstammung bewies.“"
                            },
                            {
                                "example_id": "23376901-5110-4430-8bab-587e99fcc3c1",
                                "sense_id": "17bd398e-3b6c-3aa2-973e-a79909755f8a",
                                "text": "„Erst wenn er die Hengstleistungsprüfung bestanden hat wird er als Zuchthengst oder Beschäler in das Hengstbuch der jeweiligen Rasse eingetragen.“"
                            },
                            {
                                "example_id": "32774d63-d8d9-4d5d-9d23-23fda8fb64ac",
                                "sense_id": "17bd398e-3b6c-3aa2-973e-a79909755f8a",
                                "text": "„Mit anderen Worten, das Stutbuch der englischen Pferdezucht war ein Hengstbuch.“"
                            },
                            {
                                "example_id": "3910155e-f385-44c8-bd05-4285575da0a7",
                                "sense_id": "17bd398e-3b6c-3aa2-973e-a79909755f8a",
                                "text": "„Hengstbuch einer jeden Rasse und stellte auch die entsprechenden Dokumente, wie Fohlenschein und andere Zuchtunterlagen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
