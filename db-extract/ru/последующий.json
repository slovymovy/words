                    }
                ],
                "senses": [
                    {
                        "sense_id": "be77d1c2-224c-3ef2-961a-369bf0470fb3",
                        "entry_id": "15b9903c-4647-32b4-a2ec-587b980a872b",
                        "glosses": [
                            "такой, который следует за чем-либо, происходит после чего-либо, обычно как следствие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72ebb57-16e7-4fa6-ab2b-5bf81ed25ba7",
                                "sense_id": "be77d1c2-224c-3ef2-961a-369bf0470fb3",
                                "text": "Так, каждый последующий рисунок художник обычно не рисует вновь, а копирует его с предыдущего, внося при этом лишь необходимые изменения."
                            },
                            {
                                "example_id": "6f34f021-5e94-43fd-957a-e26433261945",
                                "sense_id": "be77d1c2-224c-3ef2-961a-369bf0470fb3",
                                "text": "Мы живём в такое время, что если в клубе лекцию и последующий концерт поменять местами, то народ придёт прямо на лекцию."
                            },
                            {
                                "example_id": "3f7199e0-65e7-4410-9e31-7986d00b7ed1",
                                "sense_id": "be77d1c2-224c-3ef2-961a-369bf0470fb3",
                                "text": "Лопухин совсем побагровел и весь последующий его тон был уже, раздражённо и властно, повышенный."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9348b6d8-67a7-4bfa-8119-337515f65265",
                        "source_entry_id": "15b9903c-4647-32b4-a2ec-587b980a872b",
                        "source_sense_id": "be77d1c2-224c-3ef2-961a-369bf0470fb3",
                        "target_lang_word": "following",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "following",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5f8fbb8-d06f-398b-a738-ce9b994a100a",
                                        "entry_id": "379612a4-b1c4-35d1-a186-ca1893dd4915",
                                        "glosses": [
                                            "Coming next, either in sequence or in time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c39f2c-4f60-44fd-a1f6-2d6e9b107606",
                                                "sense_id": "a5f8fbb8-d06f-398b-a738-ce9b994a100a",
                                                "text": "See the following section."
