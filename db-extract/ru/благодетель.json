                        "examples": [
                            {
                                "example_id": "dc2d5d01-589d-42cf-822d-1157e6f55c03",
                                "sense_id": "bce17f84-3b58-373e-9e95-84cfccac7b3e",
                                "text": "Поме́щик Бы́ков, зна́вший чино́вника Покро́вского и бы́вший не́когда его́ благоде́телем, при́нял ребёнка под своё покрови́тельство и помести́л его́ в каку́ю-то шко́лу.",
                                "translation": "A country gentleman called Bykov, who had known the elder Pokrovsky and at one time been his patron, took the child under his protection and sent him to school.",
                                "english": "A country gentleman called Bykov, who had known the elder Pokrovsky and at one time been his patron, took the child under his protection and sent him to school."
                            }
                        ]
                    }
