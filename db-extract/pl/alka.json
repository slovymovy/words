                        ],
                        "examples": [
                            {
                                "example_id": "a0168214-69c1-4348-8f70-54d527953a68",
                                "sense_id": "8a7aeeb7-2645-3a2a-9468-4da0c3bf0c56",
                                "text": "Nurniczek czubaty jest małą alką, z charakterystycznym czubkiem z piór przy nasadzie dzioba, tworzącym się u tego ptaka w okresie godowym."
                            }
