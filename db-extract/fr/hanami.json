                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "03ec2493-7a07-3db6-96e8-2bba6611494b",
                        "entry_id": "3f9dbde5-2f7b-3a00-bb53-763387c99b2d",
                        "glosses": [
                            "Observation des cerisiers en fleurs, au Japon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "544278ba-1b4b-433f-91a2-f891191e7cf8",
                                "sense_id": "03ec2493-7a07-3db6-96e8-2bba6611494b",
                                "text": "Pas besoin d’aller jusqu’au Japon pour profiter du hanami, l’observation des cerisiers en fleurs."
                            },
                            {
                                "example_id": "ed6e0445-d573-4bdf-a85c-6b236fdf6846",
                                "sense_id": "03ec2493-7a07-3db6-96e8-2bba6611494b",
                                "text": "Nous marchons lentement. Des gens pique-niquent sous les arbres. Installés sur des bâches bleues, ils mangent, boivent, chantent gaiement. C’est bruyant partout. Je lui explique que ça s’appelle hanami, une tradition japonaise."
                            },
                            {
                                "example_id": "b957a413-e4c7-4823-9452-d3035bf5c776",
                                "sense_id": "03ec2493-7a07-3db6-96e8-2bba6611494b",
                                "text": "Un hanami, quelle bonne idée ! C’est vrai, ce sera bientôt la pleine floraison."
                            },
                            {
                                "example_id": "e902f9e4-a6f0-4616-97c1-f1d6905658dc",
                                "sense_id": "03ec2493-7a07-3db6-96e8-2bba6611494b",
                                "text": "De même qu’au printemps on célèbre hanami en admirant les fleurs de cerisier à leur pleine éclosion, et de même qu’en octobre on admire les feuilles rouges de l’automne – momiji-gari, « chasser les érables » –, on admire la pleine lune de la quinzième nuit du huitième mois de l’ancien calendrier lunaire : tsuki-mi, « contempler la lune »."
                            }
                        ]
                    }
