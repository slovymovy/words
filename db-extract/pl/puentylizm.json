                        "source_entry_id": "4e02221b-8517-398a-b60c-09de6f375af9",
                        "source_sense_id": "2ceff794-8186-326d-8f0c-7b1652e09bb9",
                        "target_lang_word": "пуантилизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пуантилизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "20fd9ad6-123d-34ec-8fe6-f26cf650faba",
                                        "entry_id": "b2e98b91-215e-36c2-b989-01ea722f4cf6",
                                        "glosses": [
                                            "искусств. стиль в живописи, использующий не смешиваемые на палитре краски, наносимые мелкими мазками обычно прямоугольной или круглой формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad1b651c-0b23-411b-b65c-6dbdbd016fa7",
                                                "sense_id": "20fd9ad6-123d-34ec-8fe6-f26cf650faba",
                                                "text": "Дробления краски на точки и линии и, с другой стороны, натюрморт переиначенных предметностей, сдвинутых, повторяемых отдельными частями, окружают меня. Сегантини — их вождь классического пуантилизма."
                                            },
                                            {
                                                "example_id": "584b61be-f22f-4bb0-ae9d-4bda621a16af",
                                                "sense_id": "20fd9ad6-123d-34ec-8fe6-f26cf650faba",
                                                "text": "Техника у художницы своеобразная, она рисует подушечками пальцев, то есть пуантилизм в прямом смысле слова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b4a0ee-1690-32b3-a95d-7e89dcfe8ff2",
                                        "entry_id": "b2e98b91-215e-36c2-b989-01ea722f4cf6",
                                        "glosses": [
                                            "муз. техника музыкальной композиции, в которой отдельные звуки (точки) преобладают над мелодическими мотивами или аккордами (в музыке 2-й половины XX в.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c1dded2-03d0-46d3-a554-2988f33a68d3",
                                                "sense_id": "b6b4a0ee-1690-32b3-a95d-7e89dcfe8ff2",
                                                "text": "Он давно уже знал и о свободной атональности, открытой Шенбергом, и о бурлящих тембрами звуковых «пятнах» Лигети, и об идеях пуантилизма; был знаком с вариабельной композицией, с монтажом разнородных стилевых пластов, создающим впечатление не то вселенского столпотворения стилей и фактур, не то многомерности и разомкнутости звучащего пространства-времени."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
