                        "examples": [
                            {
                                "example_id": "ef804bb4-79ca-4977-9c21-f1b79cae7eb4",
                                "sense_id": "4b8a2fd7-7d78-3742-b317-70498c79f10c",
                                "text": "The blazon will be - A fess abased potentée of Champagne towards the point. The peculiar potent of Champagne may be seen in Bouton, Nouveau Traité de Blason, p. 199 (Paris, 1863.)"
                            },
                            {
                                "example_id": "120e35ca-9430-47f4-aea1-48c73aec84eb",
                                "sense_id": "4b8a2fd7-7d78-3742-b317-70498c79f10c",
                                "text": "(G) Azure 3 bells in fess, abased."
                            },
                            {
                                "example_id": "18943672-cb5f-4c01-ba39-06d2039b3bcd",
                                "sense_id": "4b8a2fd7-7d78-3742-b317-70498c79f10c",
                                "text": "Per fess abased nebuly celeste and gules fimbriated argent throughout a pile azure between two rays in point argent bearing a sword in pale point to base of the like, grip gules, […]"
                            }
                        ]
