                                "target_senses": [
                                    {
                                        "sense_id": "38fa9d4c-e554-3f0f-85cc-f6787ee4be83",
                                        "entry_id": "94fa9c2d-cb62-3380-98fb-4d93b1b5fe5a",
                                        "glosses": [
                                            "Informatics that employs telecommunications to allow remote systems or participants to work together."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de85a6ef-7ebc-4ca6-a2ea-f81351e5804b",
                                                "sense_id": "38fa9d4c-e554-3f0f-85cc-f6787ee4be83",
                                                "text": "Advances in teleinformatics as well as its wide employment in recent years have opened new possibilities for conducting mass screening of hearing, tinnitus (ear noises), speech and vision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "555af0bd-3de2-4254-a803-84d6681d081f",
                        "source_entry_id": "39511743-86d5-3e33-b024-86cad77bee2c",
                        "source_sense_id": "85bb4579-f387-3bf0-adc5-574a6f72ca4c",
