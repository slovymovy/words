                "senses": [
                    {
                        "sense_id": "a05c8216-b551-3fcb-bea3-58a243f37032",
                        "entry_id": "4d31c28f-557b-3269-8366-eb9bde5e89d9",
                        "glosses": [
                            "Une des espèces de grand dauphins au front bombé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621c672e-450b-4e90-a451-1726de34741a",
                                "sense_id": "a05c8216-b551-3fcb-bea3-58a243f37032",
                                "text": "Dans les îles Féroé, situées entre le Danemark et l’Islande, la population se nourrit depuis au moins le Moyen Âge de la chair d’une espèce de mammifère marin, le globicéphale noir."
                            },
                            {
                                "example_id": "597fb677-a999-4b05-b727-9915dd0a311e",
                                "sense_id": "a05c8216-b551-3fcb-bea3-58a243f37032",
                                "text": "Les globicéphales sont « de grands dauphins ». « Tout est dans leur nom : globicéphale pour tête ronde. Ils n’ont pas de rostre, ce bec un peu typique du dauphin, mais une tête globuleuse, totalement noire », vulgarise Aurore Toulot, présidente de cette association qui regroupe des biologistes et des passionnés des mammifères marins."
                            },
                            {
                                "example_id": "0afc1bfa-e6b4-493e-8e05-ec0b968ff424",
                                "sense_id": "a05c8216-b551-3fcb-bea3-58a243f37032",
                                "text": "Ils tuent autour de 800 globicéphales par an."
                            }
                        ]
                    }
