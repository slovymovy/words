                "senses": [
                    {
                        "sense_id": "fdefe477-935f-38f0-bccd-a837c91a8c86",
                        "entry_id": "a4d6851a-5b31-3f9b-b7d4-489434c60161",
                        "glosses": [
                            "Donner un caractère associatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3628ae5e-e030-4be6-a946-d357977b810f",
                                "sense_id": "fdefe477-935f-38f0-bccd-a837c91a8c86",
                                "text": "Autant donc il importe d’individualiser des procédures de saisine de la justice constitutionnelle, autant il est utile d'associativiser des procédures de saisine, parce que la fonction fondamentale de la vie associative est la défense et la promotion des droits et de leur accessibilité."
                            },
                            {
                                "example_id": "5c6fdc61-35f3-4395-bcd5-24fa852636a4",
                                "sense_id": "fdefe477-935f-38f0-bccd-a837c91a8c86",
                                "text": "2 mois « d’improvisations associativisées » en Asie du Sud Est grâce au réseau TWAM et dont notre objectif est également d’en faire la promotion."
                            },
                            {
                                "example_id": "432caf6f-44a8-4ed9-a3c5-34c4daf7b592",
                                "sense_id": "fdefe477-935f-38f0-bccd-a837c91a8c86",
                                "text": "Statuer pour une entité à statut professionnel servirait d'outil pro et associativiser sa manœuvre « personnels »= une sorte de « F.D.D » lui-même ré-amélioré"
                            }
                        ]
                    }
