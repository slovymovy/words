                                        "entry_id": "a678b982-b928-38fd-8fab-4142f4b2c56e",
                                        "glosses": [
                                            "iemand die onwaarschijnlijk veel geluk heeft, een boffer"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c387e3e6-4233-482d-8b6d-e563c71bdd63",
                                                "sense_id": "e36f6030-3409-3e86-ac98-6e7470fc17f6",
                                                "text": "Die bofkont wist weer eens precies wanneer haar huiswerk ingenomen ging worden. Ze ruikt het gewoon!"
