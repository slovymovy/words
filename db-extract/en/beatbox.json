                                                "sense_id": "763a7b48-48e2-3601-bb5d-b0ae3ab1db2f",
                                                "text": "Beatbox!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffbe0fd3-9f58-31b5-bdd2-362395d7bb0b",
                                        "entry_id": "794da1ef-5684-3464-a163-a3f748afedad",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van beatboxen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "inversion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa345d34-335f-41cd-9ab6-e73a746dd0a5",
                                                "sense_id": "ffbe0fd3-9f58-31b5-bdd2-362395d7bb0b",
                                                "text": "Beatbox je?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fc983de-d8bc-4562-a2c7-a892cdccd13a",
                        "source_entry_id": "ca40c955-3f13-3435-bde7-383cfc8a6192",
                        "source_sense_id": "4174afa6-3700-3053-9b94-d22b97958d96",
                        "source_sense_description": "a type of electronic percussion device",
                        "target_lang_word": "beatbox",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beatbox",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f035f21f-5e3b-3e83-85f3-ff88494c33ef",
                                        "entry_id": "befe9d99-921b-3668-9cbe-2184287fe39b",
                                        "glosses": [
                                            "Musique vocale consistant à imiter des instruments."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "934326e3-9b04-4f22-9f4d-4f09564544a5",
                                                "sense_id": "f035f21f-5e3b-3e83-85f3-ff88494c33ef",
                                                "text": "Le beatbox, ou human beatbox, encore méconnu au Congo, est un style de musique qui consiste à imiter des instruments, des mélodies ou encore des scratchs à l’aide de la bouche, du nez et des cordes vocales pour aboutir à un mix précis."
                                            },
                                            {
                                                "example_id": "4feef139-b02f-4286-ac57-2645e6867459",
                                                "sense_id": "f035f21f-5e3b-3e83-85f3-ff88494c33ef",
                                                "text": "Le beatbox c'est quoi ? Littéralement boîte à rythme humaine, cette discipline issue du hip-hop consiste à créer de la musique avec seulement sa bouche et sa voix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
