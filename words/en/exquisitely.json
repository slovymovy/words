{
    "word_family": [
        "exquisite",
        "exquisiteness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ab0bcc09-c620-3293-94be-0e6dbb0774ab",
                    "sense_definition": "In an exceptionally beautiful, delicate, or refined manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dining room was <w>exquisitely</w> decorated with hand-painted silk wallpaper and antique furniture.",
                            "target_lang_translations": {
                                "ru": "Столовая была <w>изысканно</w> украшена расписанными вручную шелковыми обоями и антикварной мебелью."
                            }
                        },
                        {
                            "text": "The chef prepared a fish dish that was <w>exquisitely</w> prepared with a delicate herb sauce.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил рыбное блюдо, которое было <w>великолепно</w> оформлено с нежным травяным соусом."
                            }
                        }
                    ],
                    "synonyms": [
                        "beautifully",
                        "delicately",
                        "superbly",
                        "finely"
                    ],
                    "antonyms": [
                        "crudely",
                        "coarsely"
                    ],
                    "common_phrases": [
                        "exquisitely decorated",
                        "exquisitely prepared",
                        "exquisitely detailed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно красивым, утонченным или изысканным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изысканно",
                                "target_lang_sense_clarification": "с тонким вкусом, изящно"
                            },
                            {
                                "target_lang_word": "великолепно",
                                "target_lang_sense_clarification": "превосходно по исполнению"
                            },
                            {
                                "target_lang_word": "утонченно",
                                "target_lang_sense_clarification": "с высокой степенью изящества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a96cd4f-d925-32d8-a4a1-90fe9c06d64c",
                    "sense_definition": "To an intense, extreme, or highest degree; acutely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was something <w>exquisitely</w> painful in the memories of his childhood that suddenly returned to him.",
                            "target_lang_translations": {
                                "ru": "Было что-то <w>мучительно</w> болезненное в воспоминаниях о детстве, которые внезапно вернулись к нему."
                            }
                        },
                        {
                            "text": "She was <w>exquisitely</w> sensitive to any changes in the temperature of the room.",
                            "target_lang_translations": {
                                "ru": "Она была <w>чрезвычайно</w> чувствительна к любым изменениям температуры в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensely",
                        "acutely",
                        "exceedingly",
                        "extremely"
                    ],
                    "antonyms": [
                        "mildly",
                        "slightly"
                    ],
                    "common_phrases": [
                        "exquisitely painful",
                        "exquisitely sensitive"
                    ],
                    "target_lang_definitions": {
                        "ru": "В высшей, чрезвычайной или острой степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучительно",
                                "target_lang_sense_clarification": "очень остро, до боли"
                            },
                            {
                                "target_lang_word": "чрезвычайно",
                                "target_lang_sense_clarification": "в высшей степени"
                            },
                            {
                                "target_lang_word": "остро",
                                "target_lang_sense_clarification": "крайне чувствительно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}