                    {
                        "translation_id": "1969959d-aa90-473c-9e13-dbc897205990",
                        "source_entry_id": "be4b49f6-1985-3c4d-886c-85e00e365f79",
                        "source_sense_id": "6e289001-a8eb-3b30-9edf-2990c778396c",
                        "target_lang_word": "ébouriffer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ébouriffer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70198a2a-5120-31dc-a2a7-4f04ea7e3a21",
                                        "entry_id": "dd651079-6d7d-3dcc-abab-d657e5a79c45",
                                        "glosses": [
                                            "Mettre la coiffure en désordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674a4287-12f8-4d74-a6fe-64cb800fde2d",
                                                "sense_id": "70198a2a-5120-31dc-a2a7-4f04ea7e3a21",
                                                "text": "Le vieux garde s'arrêta, ramena ses cheveux blancs que la bise avait ébouriffés, et se mit à sourire."
                                            },
                                            {
                                                "example_id": "f343d025-1e57-4e16-8b53-4078de2a9499",
                                                "sense_id": "70198a2a-5120-31dc-a2a7-4f04ea7e3a21",
                                                "text": "Des gamines de la deuxième classe, complaisantes, nous tendent leur tablier noir derrière les vitres d’une fenêtre ouverte ; devant ce sombre miroir, nous remettons nos chapeaux, j’ébouriffe mes boucles."
                                            },
                                            {
                                                "example_id": "30043242-fd5c-4eeb-9db6-ccd8fc586a82",
                                                "sense_id": "70198a2a-5120-31dc-a2a7-4f04ea7e3a21",
                                                "text": "Le malheur l'avait marqué ; il penchait un peu la tête comme un faible qui n’ose pas regarder la vie ; sa belle moustache, autrefois si soignée, s’ébouriffait, plus rousse sur le visage amaigri."
                                            },
                                            {
                                                "example_id": "56d14994-4594-4a85-8beb-bd971bd0b00d",
                                                "sense_id": "70198a2a-5120-31dc-a2a7-4f04ea7e3a21",
                                                "text": "Elle prend un chapeau, en ébouriffe un peu le ruban, puis tient la garniture de roses de ce chapeau près de sa figure, devant la glace, […]."
                                            },
                                            {
                                                "example_id": "556348ff-8d12-466b-a027-0301cc37dc7c",
                                                "sense_id": "70198a2a-5120-31dc-a2a7-4f04ea7e3a21",
                                                "text": "En fait de gloutof [sic pour kouglof], il y a, ébouriffant une débauche de papier de soie bleu nuit, un magnifique cake alsacien revisité par l’inspiration, des tartelettes au whisky si fines qu’on craint de les briser et des tuiles aux amandes bien caramélisées sur les bords. J’en bave instantanément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e3c86a-1c65-3286-aef6-5d2fb22fb40b",
                                        "entry_id": "dd651079-6d7d-3dcc-abab-d657e5a79c45",
                                        "glosses": [
                                            "Surprendre, troubler par quelque chose d’inattendu."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ac3a57-b58f-4f69-9089-7033919860ec",
                                                "sense_id": "24e3c86a-1c65-3286-aef6-5d2fb22fb40b",
                                                "text": "Son langage, son attitude m’ébouriffe."
                                            },
                                            {
                                                "example_id": "75749df6-fca6-4cc8-a94b-f9a80e407082",
                                                "sense_id": "24e3c86a-1c65-3286-aef6-5d2fb22fb40b",
                                                "text": "Elles mangeraient du snobisme dans la paume d’un lépreux et sacrifieraient leur salut pour ébouriffer la galerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
