                        "examples": [
                            {
                                "example_id": "afa87226-86ee-4cb2-8320-e15f8664a8fc",
                                "sense_id": "4bed2015-3e72-3115-b209-d24508990be9",
                                "text": "Laat de paddestoelen uitlekken. Verhit de frituurolie. Klop een beslagje van de tempuramix en het spawater. Bekleed een bord met keukenpapier. Dep de paddestoelen droog en wentel ze door de bloem, klop af. Haal ze aan een vork door het beslag, laat even uitlekken en frituur ze - twee tegelijk - rondom goudbruin. Laat ze uitlekken op keukenpapier en verdeel over de borden."
                            },
                            {
                                "example_id": "03aaea50-37f7-47a4-ad1c-8329e75220e5",
                                "sense_id": "4bed2015-3e72-3115-b209-d24508990be9",
                                "text": "Je zou de druk in de Spawaterfles kunnen afleiden uit het gehalte CO2 dat de fabrikant voor zijn water opgeeft. In water waarboven zuiver CO2 van één bar druk staat lost volgens de tabellen ongeveer 1,5 gram CO2 per liter op (Henry-constante)."
                            }
                        ]
                    }
