                    ]
                },
                {
                    "sense_id": "e3e258a2-ec96-3e5b-8ed4-c7e494e5921b",
                    "sense_definition": "Maladie parasitaire des arbres, touchant surtout le châtaignier et provoquant des suintements noirâtres au collet.",
