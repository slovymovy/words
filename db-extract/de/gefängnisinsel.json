                        "glosses": [
                            "Insel, die zur Gänze für die Unterbringung von Gefangenen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ad1ec3-10ea-4576-ae71-dd8a2c140102",
                                "sense_id": "b236103a-c4b3-300e-ba20-a8132ad5e2f4",
                                "text": "„Auf der letzten Gefängnisinsel Italiens darf nur das Polizeiboot anlegen.“"
                            },
                            {
                                "example_id": "77bc4d83-cdee-4ffe-a3be-0349dfc261fd",
                                "sense_id": "b236103a-c4b3-300e-ba20-a8132ad5e2f4",
                                "text": "„Menschenunwürdige Bedingungen, exzessive Gewalt: Die amerikanische Gefängnisinsel Rikers Island leidet unter großen Problemen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
