                        "examples": [
                            {
                                "example_id": "da68893c-3ca5-43e4-8425-324e55147293",
                                "sense_id": "7c94b8f1-e77d-318d-8eca-8bda210b9408",
                                "text": "Il décrivit l’aridité de l’île, le calima (« vent de sable »), les vallées paisibles et cultivées, et les fermes isolées ; les palmiers et les tamaris, les vallons appelés barrancos et les écureuils de Barbarie."
                            },
                            {
                                "example_id": "e45454a7-7984-4700-8e51-18d5c6fb5301",
                                "sense_id": "7c94b8f1-e77d-318d-8eca-8bda210b9408",
                                "text": "On s’était dit que c’était peut-être la calima, le vent du désert, qui me tournait la tête."
                            }
                        ]
                    }
