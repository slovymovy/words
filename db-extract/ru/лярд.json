                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fec59d72-a560-3e83-b5d6-84ee34f5f55d",
                                        "entry_id": "c494146f-beeb-3d38-bd2f-6893a5616ae0",
                                        "glosses": [
                                            "Fat from the abdomen of a pig, especially as prepared for use in cooking or pharmacy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6620c4a-0240-41d3-b8a9-ba1a8991375d",
                                                "sense_id": "fec59d72-a560-3e83-b5d6-84ee34f5f55d",
                                                "text": "Lard mixed with crushed and strained garlic has been used as an erotic ointment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371e4181-5c80-3f57-a913-c5361d8bf85a",
                                        "entry_id": "c494146f-beeb-3d38-bd2f-6893a5616ae0",
                                        "glosses": [
                                            "Fatty meat from a pig; bacon, pork."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6877845-3489-384c-ab2f-aa1af6f30673",
                                        "entry_id": "c494146f-beeb-3d38-bd2f-6893a5616ae0",
                                        "glosses": [
                                            "Excess fat on a person or animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fecbe97d-7fa4-4d2c-8977-c18b1b976bad",
                                                "sense_id": "a6877845-3489-384c-ab2f-aa1af6f30673",
                                                "text": "My wonderful partner is fond of pointing out that he and I have done the Covid crisis on easy mode: we have no children, no caring responsibilities, […] we have a fabulous community of people at our local fitness studio to keep the lockdown lard at bay and the cats love joining us for afternoon naps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8af48ffd-d95d-348e-ab6e-5e7d9a4d53f9",
                                        "entry_id": "5bb58f57-2d87-352d-8871-f18d3beed24d",
                                        "glosses": [
                                            "To stuff (meat) with bacon or pork before cooking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8df11c4a-701b-31d2-a917-5ce4b10ed802",
                                        "entry_id": "5bb58f57-2d87-352d-8871-f18d3beed24d",
                                        "glosses": [
                                            "To smear with fat or lard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a2be6df-2b71-4caf-864b-7901775a4869",
                                                "sense_id": "8df11c4a-701b-31d2-a917-5ce4b10ed802",
                                                "text": "In his buff doublet larded o'er with fat / Of slaughtered brutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91c5abdf-6245-3309-96f2-5246b2816c08",
                                        "entry_id": "5bb58f57-2d87-352d-8871-f18d3beed24d",
                                        "glosses": [
                                            "To distribute, garnish or strew, especially with reference to fatty or greasy things or words or phrases in speech and writing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b0dcf50-1515-416b-9ce1-f4d19eda007f",
                                                "sense_id": "91c5abdf-6245-3309-96f2-5246b2816c08",
                                                "text": "The first notice came from — of course — a Trump tweet, after his meeting with Barr on the question of voter fraud allegations in the 2020 election. Barr made a point of noting the topic in his resignation letter, which was larded with slavish praise for the president's accomplishments in the face of what Barr called \"relentless, implacable resistance.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8edf6a-f863-32f0-b8ec-99319ab1ef78",
                                        "entry_id": "5bb58f57-2d87-352d-8871-f18d3beed24d",
                                        "glosses": [
                                            "To fatten; to enrich."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85da8fa5-5d0e-479e-9703-252a2d16e7b0",
                                                "sense_id": "ce8edf6a-f863-32f0-b8ec-99319ab1ef78",
                                                "text": "[The oak] with his nuts larded many swine."
                                            },
                                            {
                                                "example_id": "677560a4-cfd9-4bf3-bd76-467881a900c8",
                                                "sense_id": "ce8edf6a-f863-32f0-b8ec-99319ab1ef78",
                                                "text": "Falstaff sweats to death, / And lards the lean earth as he walks along."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57eaf366-3016-3997-9a93-66d02046ed6b",
                                        "entry_id": "5bb58f57-2d87-352d-8871-f18d3beed24d",
                                        "glosses": [
                                            "To mix or garnish with something, as by way of improvement; to interlard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d255f0ef-0c28-4f50-8dfa-26f47fa26810",
                                                "sense_id": "57eaf366-3016-3997-9a93-66d02046ed6b",
                                                "text": "Larded with sweet flowers; Which bewept to the grave"
                                            },
                                            {
                                                "example_id": "c940ff87-dc0e-493e-bbc1-60a42b30528b",
                                                "sense_id": "57eaf366-3016-3997-9a93-66d02046ed6b",
                                                "text": "Let no alien Sedley interpose / To lard with wit thy hungry Epsom prose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abae5f87-0fba-318b-af1f-0c60c302f9fe",
                                        "entry_id": "5bb58f57-2d87-352d-8871-f18d3beed24d",
                                        "glosses": [
                                            "To embellish with unnecessary frills; to pad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b7df78-b380-4cd1-9e94-9e8b641eb410",
                                                "sense_id": "abae5f87-0fba-318b-af1f-0c60c302f9fe",
                                                "text": "Ultimately, the plans were rejected by Senate leadership, Cruz told reporters, after he and a number of others objected. \"That proposal did not carry the day,\" Cruz said. \"Those $350bn in tax increases are not in the bill ... and larding the bill up with new tax increases would have been going the wrong direction.\""
                                            },
                                            {
                                                "example_id": "976f33d9-c37c-4972-99de-6a963f15714b",
                                                "sense_id": "abae5f87-0fba-318b-af1f-0c60c302f9fe",
                                                "text": "Volkswagen avoided the fins and other frills with which U.S. manufacturers larded their vehicles. Instead, the company and its advertising agency, Doyle Dane Bernbach, promoted \"our philosophy of a car that doesn't change for the reason of change, only for the benefit of the consumer,\" Mr. Hahn said at the Haas School of Business at the University of California, Berkeley, in 2011."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7716982f-e216-373e-ba27-005eae6ede3e",
                                        "entry_id": "5bb58f57-2d87-352d-8871-f18d3beed24d",
                                        "glosses": [
                                            "To grow fat."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
