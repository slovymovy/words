                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c09c279-8b9d-4b2f-943d-bd93256228ac",
                                                "sense_id": "674f9e75-a63a-351b-89de-fca2d43feb1b",
                                                "text": "Schenk mir einen lila Luftballon / bei unserm Bummel / über den Rummel – (Edina Pop)"
                                            },
                                            {
                                                "example_id": "f15823ae-8f76-4681-b706-49a5758aa6c7",
                                                "sense_id": "674f9e75-a63a-351b-89de-fca2d43feb1b",
                                                "text": "„Ich mache einen kleinen Bummel an den Häusern vorbei und biege in die Berge hinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
