{
    "word_family": [
        "kind",
        "kindly",
        "unkind",
        "unkindness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                    "sense_definition": "The quality or state of being friendly, generous, and considerate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kindness_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone was touched by her <w>kindness</w> during the difficult time.",
                            "target_lang_translations": {
                                "pl": "Wszyscy byli poruszeni jej <w>życzliwością</w> w tym trudnym czasie."
                            }
                        },
                        {
                            "text": "He showed great <w>kindness</w> to the stranger who lost their way.",
                            "target_lang_translations": {
                                "pl": "Okazał wielką <w>życzliwość</w> nieznajomemu, który się zgubił."
                            }
                        }
                    ],
                    "synonyms": [
                        "compassion",
                        "generosity",
                        "benevolence"
                    ],
                    "antonyms": [
                        "cruelty",
                        "meanness"
                    ],
                    "common_phrases": [
                        "act of kindness",
                        "show kindness"
                    ],
                    "target_lang_definitions": {
                        "pl": "Cecha lub stan bycia przyjaznym, hojnym i troskliwym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "życzliwość",
                                "target_lang_sense_clarification": "Przyjazny stosunek do innych ludzi."
                            },
                            {
                                "target_lang_word": "dobroć",
                                "target_lang_sense_clarification": "Ogólna cecha postępowania odznaczająca się troską o innych."
                            },
                            {
                                "target_lang_word": "przychylność",
                                "target_lang_sense_clarification": "Pozytywne nastawienie do kogoś lub czegoś."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                    "sense_definition": "A specific helpful or charitable action performed for someone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kindness_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will never forget the many <w>kindnesses</w> they showed me when I was sick.",
                            "target_lang_translations": {
                                "pl": "Nigdy nie zapomnę wielu <w>przysług</w>, które mi wyświadczyli, gdy byłem chory."
                            }
                        },
                        {
                            "text": "She did me a small <w>kindness</w> by helping me carry my heavy bags.",
                            "target_lang_translations": {
                                "pl": "Wyświadczyła mi małą <w>przysługę</w>, pomagając mi nieść ciężkie torby."
                            }
                        }
                    ],
                    "synonyms": [
                        "favor",
                        "good deed"
                    ],
                    "common_phrases": [
                        "do a kindness",
                        "return a kindness"
                    ],
                    "target_lang_definitions": {
                        "pl": "Konkretny pomocny lub charytatywny uczynek wykonany dla kogoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przysługa",
                                "target_lang_sense_clarification": "Konkretne działanie wykonane na czyjąś korzyść."
                            },
                            {
                                "target_lang_word": "dobry uczynek",
                                "target_lang_sense_clarification": "Pozytywne działanie wykonane dla innej osoby."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}