{
    "word_family": [
        "bevliegen",
        "bevlogenheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "79e7f1c1-cb11-378c-b394-4bf91717d6b7",
                    "sense_definition": "Met grote passie, enthousiasme en inspiratie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>bevlogen</w> leraar wist alle leerlingen te interesseren voor geschiedenis.",
                            "target_lang_translations": {
                                "en": "The <w>passionate</w> teacher managed to get all students interested in history."
                            }
                        },
                        {
                            "text": "Hij hield een <w>bevlogen</w> toespraak over de toekomst van onze planeet.",
                            "target_lang_translations": {
                                "en": "He gave an <w>inspired</w> speech about the future of our planet."
                            }
                        }
                    ],
                    "synonyms": [
                        "gepassioneerd",
                        "enthousiast",
                        "gedreven",
                        "geïnspireerd"
                    ],
                    "antonyms": [
                        "ongeïnteresseerd",
                        "apathisch",
                        "onverschillig"
                    ],
                    "common_phrases": [
                        "bevlogen toespraak",
                        "bevlogen medewerker"
                    ],
                    "target_lang_definitions": {
                        "en": "Characterized by great passion, enthusiasm, and inspiration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passionate",
                                "target_lang_sense_clarification": "Showing or caused by strong feelings or a strong belief."
                            },
                            {
                                "target_lang_word": "inspired",
                                "target_lang_sense_clarification": "Showing high-quality creative or intellectual energy."
                            },
                            {
                                "target_lang_word": "enthusiastic",
                                "target_lang_sense_clarification": "Having or showing intense and eager enjoyment or interest."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e4f76774-6617-33b4-b768-3795e0156167",
                    "sense_definition": "Op een gepassioneerde, enthousiaste en geïnspireerde manier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kan heel <w>bevlogen</w> vertellen over haar reizen door Azië.",
                            "target_lang_translations": {
                                "en": "She can talk very <w>passionately</w> about her travels through Asia."
                            }
                        },
                        {
                            "text": "De muzikant speelde zo <w>bevlogen</w> dat het publiek muisstil werd.",
                            "target_lang_translations": {
                                "en": "The musician played so <w>enthusiastically</w> that the audience became deathly silent."
                            }
                        }
                    ],
                    "synonyms": [
                        "gepassioneerd",
                        "enthousiast",
                        "gedreven"
                    ],
                    "antonyms": [
                        "onverschillig",
                        "mat"
                    ],
                    "common_phrases": [
                        "bevlogen vertellen",
                        "bevlogen spreken"
                    ],
                    "target_lang_definitions": {
                        "en": "In a passionate, enthusiastic, and inspired manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passionately",
                                "target_lang_sense_clarification": "With strong feelings or enthusiasm."
                            },
                            {
                                "target_lang_word": "enthusiastically",
                                "target_lang_sense_clarification": "With eager interest or approval."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4c9b534-90e5-37e3-94df-b7aa5f540925",
                    "sense_definition": "Voltooid deelwoord van <w>bevliegen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bevliegen_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De route naar het eiland is al vele malen door piloten <w>bevlogen</w>.",
                            "target_lang_translations": {
                                "en": "The route to the island has been <w>flown over</w> many times by pilots."
                            }
                        },
                        {
                            "text": "Dit luchtruim wordt niet vaak door commerciële vliegtuigen <w>bevlogen</w>.",
                            "target_lang_translations": {
                                "en": "This airspace is not often <w>flown over</w> by commercial aircraft."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of 'bevliegen' (to fly over or to attack/seize)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flown over",
                                "target_lang_sense_clarification": "Past participle indicating an area has been traversed by air."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fd3e904-4186-3bf3-8281-6b74a34b03ee",
                    "sense_definition": "Verleden tijd meervoud van <w>bevliegen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bevliegen_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de oefening <w>bevlogen</w> de piloten het gebied vanuit het noorden.",
                            "target_lang_translations": {
                                "en": "During the exercise, the pilots <w>flew over</w> the area from the north."
                            }
                        },
                        {
                            "text": "Wij <w>bevlogen</w> de bergen op zoek naar vermiste bergbeklimmers.",
                            "target_lang_translations": {
                                "en": "We <w>flew over</w> the mountains in search of missing mountaineers."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past tense plural of 'bevliegen' (to fly over or to attack/seize)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flew over",
                                "target_lang_sense_clarification": "Past tense indicating the action of flying over a specific area."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}