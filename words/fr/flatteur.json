                        "lumière flatteuse"
                    ]
                },
                {
                    "sense_id": "a3ae5c02-b882-3405-b43f-17e129998db0",
                    "sense_definition": "Qui loue avec une exagération excessive ou intéressée pour séduire autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Méfie-toi de ses propos <w>flatteurs</w>, car il cherche seulement à obtenir une faveur."
                        },
                        {
                            "text": "Cet homme utilise un ton toujours <w>flatteur</w> pour manipuler son entourage."
                        }
                    ],
                    "synonyms": [
                        "flagorneur"
                    ],
                    "common_phrases": [
                        "propos flatteurs",
