                        "se dérouler comme prévu",
                        "se dérouler sans accroc"
                    ]
                },
                {
                    "sense_id": "c55f0557-a604-398f-899c-693ecba875ae",
                    "sense_definition": "Étendre à plat ce qui était enroulé sur soi-même.",
