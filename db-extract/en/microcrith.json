                        "glosses": [
                            "The weight of the half hydrogen molecule, or of the hydrogen atom, taken as the standard in comparing the atomic weights of the elements."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "157797d3-be2b-404c-9939-8f2c71328861",
                                "sense_id": "c690ced4-56b6-3dcc-bb25-137a2e4e42c3",
                                "text": "An atom of oxygen weighs sixteen microcriths."
                            },
                            {
                                "example_id": "59e6f43b-5ddd-4bd2-ade3-921cf1f29689",
                                "sense_id": "c690ced4-56b6-3dcc-bb25-137a2e4e42c3",
                                "text": "1872, Josiah Parsons Cooke (Jr.), Principles of Chemical Philosophy\nIt will perhaps serve to give greater definiteness to our conceptions if , even at the risk of coining a new word , we call the unit of molecular weights a microcrith ."
                            }
