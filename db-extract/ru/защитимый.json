                ],
                "senses": [
                    {
                        "sense_id": "ba96df0d-9aee-3064-a021-789f39b4a660",
                        "entry_id": "363883a4-28f2-3d6c-a369-d700ea49ead9",
                        "glosses": [
                            "такой, который можно защищать, оборонять, защитить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1848c599-48ff-498b-9c6e-2ec894cb6351",
                                "sense_id": "ba96df0d-9aee-3064-a021-789f39b4a660",
                                "text": "Поскольку славянофилы упирали на «славянство» как на то начало, которым определяется культурно-историческое своеобразие России, они явно брались защищать трудно защитимые позиции."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a09f199c-5902-4def-866e-e797967ead08",
                        "source_entry_id": "363883a4-28f2-3d6c-a369-d700ea49ead9",
                        "source_sense_id": "ba96df0d-9aee-3064-a021-789f39b4a660",
                        "target_lang_word": "defensible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defensible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a4d891e-fa2d-37bd-87ca-33ed5c53eee7",
                                        "entry_id": "89681770-7988-3e3d-a21f-c5455daa8e04",
                                        "glosses": [
                                            "Capable of being defended against armed attack."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c3b67e6-3c5d-4c00-afd9-b4a8b7e76105",
                                                "sense_id": "6a4d891e-fa2d-37bd-87ca-33ed5c53eee7",
                                                "text": "Not only were those cities fortified, but their architects based their whole system on the strategical possibilities of the site, and closely followed its defensible contours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb922f7f-bbd6-39d4-ac14-ba6e3a885cff",
                                        "entry_id": "89681770-7988-3e3d-a21f-c5455daa8e04",
                                        "glosses": [
                                            "Capable of being justified."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0afc8a4-4b60-4cd3-9247-52348f6aa693",
                                                "sense_id": "bb922f7f-bbd6-39d4-ac14-ba6e3a885cff",
                                                "text": "Those who are most familiar with the working of the present society are also usually interested in the preservation of particular features of that society which may not be defensible on general principle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "481bb685-98bb-4263-b7af-ca36b831b63e",
                        "source_entry_id": "363883a4-28f2-3d6c-a369-d700ea49ead9",
