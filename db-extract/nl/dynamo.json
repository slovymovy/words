                "senses": [
                    {
                        "sense_id": "c7c97b0f-4aa3-3e3b-bd9f-c7bc4bb9c113",
                        "entry_id": "8a99652b-51fa-3ee6-b3ae-e34b2a5e2d46",
                        "glosses": [
                            "een machine die mechanische energie, binnenkomend via een draaiende as, omzet in elektrische energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1be4b8-f636-42de-b738-bc7034c6d386",
                                "sense_id": "c7c97b0f-4aa3-3e3b-bd9f-c7bc4bb9c113",
                                "text": "Hij wilde 's avonds op zijn fiets weg, maar zijn dynamo deed het niet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c13bfc89-730b-4a88-b5dc-f73c635aa25c",
                        "source_entry_id": "8a99652b-51fa-3ee6-b3ae-e34b2a5e2d46",
                        "source_sense_id": "c7c97b0f-4aa3-3e3b-bd9f-c7bc4bb9c113",
                        "target_lang_word": "Dynamo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dynamo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "236f0635-0a1f-350d-8a37-33859b6eead0",
                                        "entry_id": "aedd23a5-a793-3990-b2f1-1cd6803fb33d",
                                        "glosses": [
                                            "Maschine zur Erzeugung von elektrischem Strom aus mechanischer Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "448af1e4-4438-47dc-a5ce-adb9ebc9bad4",
                                                "sense_id": "236f0635-0a1f-350d-8a37-33859b6eead0",
                                                "text": "Der Dynamo am Fahrrad kann zur Felge hin geklappt werden."
                                            },
                                            {
                                                "example_id": "728323a2-1a29-498c-a549-fcb226988e2c",
                                                "sense_id": "236f0635-0a1f-350d-8a37-33859b6eead0",
                                                "text": "Wer in die Pedale tritt, erzeugt über den Dynamo elektrischen Strom."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e7d5b63-b469-35e2-abb6-b347062eace1",
                                        "entry_id": "aedd23a5-a793-3990-b2f1-1cd6803fb33d",
                                        "glosses": [
                                            "kurz für: Fahrraddynamo, Erzeuger von elektrischem Strom für die Fahrradbeleuchtung"
                                        ],
                                        "tags": [
                                            "Fahrradtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "007de7b9-7cfe-4be9-859e-32419f3e1558",
                                                "sense_id": "9e7d5b63-b469-35e2-abb6-b347062eace1",
                                                "text": "„Die Handbremse funktionierte jetzt, auch der Dynamo und beide Scheinwerfer, die Kette war frisch geölt und das vordere Schutzblech saß wieder fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b455bcd-232a-3124-85bb-b991e2702794",
                                        "entry_id": "aedd23a5-a793-3990-b2f1-1cd6803fb33d",
                                        "glosses": [
                                            "Bestandteil von Eigennamen von Sportvereinigungen, wie zum Beispiel Dynamo Dresden"
                                        ],
                                        "tags": [
                                            "Vereinswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c7cb438-f769-4f3b-b5cc-1a93cb5a2caa",
                                                "sense_id": "4b455bcd-232a-3124-85bb-b991e2702794",
                                                "text": "Der nächste Gegner wird Dynamo Kiew sein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "127bf02b-9b22-4f4a-9b15-2c54541e98d3",
                        "source_entry_id": "8a99652b-51fa-3ee6-b3ae-e34b2a5e2d46",
                        "source_sense_id": "c7c97b0f-4aa3-3e3b-bd9f-c7bc4bb9c113",
                        "target_lang_word": "dynamo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                        "entry_id": "30cd44ee-bfb7-3d04-852a-30f29e77c65f",
                                        "glosses": [
                                            "Machine à courant continu fonctionnant en générateur électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86febea8-75cf-4c4e-b332-aa8512003dc1",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "Il fallut passer la première nuit sans feu et sans lumière. Les moteurs qui alimentaient les dynamos avaient été mis en pièces, et personne ne possédait d’allumettes ; […]."
                                            },
                                            {
                                                "example_id": "7aa53c02-827c-431d-8e0e-a6f8cb8baa65",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "La machine est commandée soit par une courroie, soit par une dynamo directement."
                                            },
                                            {
                                                "example_id": "9d803a9c-33d1-41c4-8101-a0276e329919",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "Les électro-aimants inducteurs N, S, N, S, etc., sont pourvus d'un enroulement de fil unique, dont le sens alterne de l'un à l'autre; les noyaux de ces electros sont en fer doux ou en fonte; le courant d'excitation est fourni par une petite dynamo à courant continu, du type supérieur Gramme, montée sur le même arbre que l'inducteur de l'alternateur."
                                            },
                                            {
                                                "example_id": "7557c8d1-2dfc-4ba5-ad73-259a3b21fee0",
                                                "sense_id": "fb3720a4-43b9-3cfd-82c4-34aec8a9f2b9",
                                                "text": "[…] ; l'autre par une triple dérivation aboutissant à une large plaque métallique terminée par un balai frotteur, dans le genre de ceux des collecteurs de dynamos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e29a823-83f5-3524-af35-ddea09305787",
                                        "entry_id": "30cd44ee-bfb7-3d04-852a-30f29e77c65f",
                                        "glosses": [
                                            "Petit alternateur fixé à une roue de bicyclette produisant du courant alternatif."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
