{
    "word_family": [
        "divine",
        "divinely",
        "divination",
        "divineness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ead20cda-bab8-3e1c-98cc-5f0bdf199a37",
                    "sense_definition": "A person who claims or is believed to foretell the future or discover hidden knowledge.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prophecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king consulted a local <w>diviner</w> before deciding to march his army into battle.",
                            "target_lang_translations": {
                                "ru": "Царь посоветовался с местным <w>прорицателем</w>, прежде чем принять решение вести свою армию в бой."
                            }
                        },
                        {
                            "text": "Many people in the village trusted the ancient <w>diviner</w> to predict the coming harvest.",
                            "target_lang_translations": {
                                "ru": "Многие жители деревни доверяли старому <w>гадателю</w>, чтобы предсказать будущий урожай."
                            }
                        }
                    ],
                    "synonyms": [
                        "foreteller",
                        "fortune-teller",
                        "prophet",
                        "seer",
                        "soothsayer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который, как утверждается или считается, предсказывает будущее или открывает сокрытое знание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорицатель",
                                "target_lang_sense_clarification": "человек, предсказывающий будущее"
                            },
                            {
                                "target_lang_word": "гадатель",
                                "target_lang_sense_clarification": "тот, кто гадает, предсказывает судьбу"
                            },
                            {
                                "target_lang_word": "провидец",
                                "target_lang_sense_clarification": "человек, способный предвидеть будущее"
                            },
                            {
                                "target_lang_word": "ясновидящий",
                                "target_lang_sense_clarification": "обладающий способностью сверхчувственного восприятия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80399770-9c3c-3eb0-9349-51a4c4878801",
                    "sense_definition": "A person who uses a rod or pendulum to locate underground water or minerals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dowsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers hired a <w>diviner</w> to help them choose the best spot to dig a well.",
                            "target_lang_translations": {
                                "ru": "Фермеры наняли <w>лозоходца</w>, чтобы тот помог им выбрать лучшее место для копки колодца."
                            }
                        },
                        {
                            "text": "Holding a hazel twig in both hands, the experienced <w>diviner</w> walked slowly across the dry field.",
                            "target_lang_translations": {
                                "ru": "Держа ореховый прут обеими руками, опытный <w>лозоходец</w> медленно шёл по сухому полю."
                            }
                        }
                    ],
                    "synonyms": [
                        "water diviner",
                        "dowser"
                    ],
                    "common_phrases": [
                        "water diviner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, использующий лозу или маятник для поиска подземных вод или полезных ископаемых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лозоходец",
                                "target_lang_sense_clarification": "человек, ищущий воду или руду с помощью лозы"
                            },
                            {
                                "target_lang_word": "лозоискатель",
                                "target_lang_sense_clarification": "тот, кто занимается лозоходством"
                            },
                            {
                                "target_lang_word": "водоискатель",
                                "target_lang_sense_clarification": "человек, ищущий подземные источники воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d0d1975-d60e-3dc9-998f-ea2f7f00a5c7",
                    "sense_definition": "One who perceives, deduces, or conjectures intuitively.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a keen <w>diviner</w> of other people's unspoken motives and hidden fears.",
                            "target_lang_translations": {
                                "ru": "Она была проницательным <w>знатоком</w> чужих невысказанных мотивов и скрытых страхов."
                            }
                        },
                        {
                            "text": "He proved to be a skilled <w>diviner</w> of market trends during economic crises.",
                            "target_lang_translations": {
                                "ru": "Он проявил себя как искусный <w>провидец</w> рыночных тенденций во время экономических кризисов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто интуитивно подмечает, делает выводы или догадывается о чём-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провидец",
                                "target_lang_sense_clarification": "человек с глубокой интуицией и проницательностью"
                            },
                            {
                                "target_lang_word": "знаток",
                                "target_lang_sense_clarification": "человек, тонко угадывающий суть вещей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2ef8a49-9a7f-339d-94f2-16cc562374f2",
                    "sense_definition": "comparative form of <w>divine</w>: more divine",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her singing sounded even <w>diviner</w> under the vast acoustics of the ancient stone cathedral.",
                            "target_lang_translations": {
                                "ru": "Её пение звучало ещё <w>божественнее</w> под сводами древнего каменного собора с его великолепной акустикой."
                            }
                        },
                        {
                            "text": "Nothing could feel <w>diviner</w> than a warm bath after an exhausting day in the cold.",
                            "target_lang_translations": {
                                "ru": "Ничто не могло ощущаться <w>божественнее</w>, чем горячая ванна после изнурительного дня на холоде."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сравнительная степень от divine: более божественный, ещё более восхитительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "божественнее",
                                "target_lang_sense_clarification": "более божественный, восхитительный"
                            },
                            {
                                "target_lang_word": "более божественный",
                                "target_lang_sense_clarification": "в большей степени божественный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}