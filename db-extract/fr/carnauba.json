                                "example_id": "7b9c28d6-549c-48b3-840a-cfc79e994850",
                                "sense_id": "b850f832-a58a-3994-8161-4ce270ee0272",
                                "text": "Dans la peinture à l’encaustique on utilise la carnauba pour durcir la cire d’abeille plus molle."
                            }
                        ]
