                    {
                        "translation_id": "faff2287-378f-4bea-85ae-69a652be316e",
                        "source_entry_id": "2b46ce7b-66fb-3d02-a572-ab5ce66a1fef",
                        "source_sense_id": "6826049d-36ca-3561-93b8-c8b6619d369c",
                        "target_lang_word": "maniérisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maniérisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d706faf-bc46-3e2f-a5dd-27495a7f86c8",
                                        "entry_id": "ec4a1aa9-015a-309c-aae9-dee363626f82",
                                        "glosses": [
                                            "Tendance à l’affectation, à la manière ; ensemble des procédés d’un peintre, d’un écrivain maniéré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e264fe-7ffd-4f16-9b21-b62a15bc8872",
                                                "sense_id": "4d706faf-bc46-3e2f-a5dd-27495a7f86c8",
                                                "text": "Cette école est tombée dans le maniérisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a61471-351d-3b34-8bbd-f1069deeebeb",
                                        "entry_id": "ec4a1aa9-015a-309c-aae9-dee363626f82",
                                        "glosses": [
                                            "Mouvement artistique de la Renaissance allant de 1520 (mort du peintre Raphaël) à 1580, qui visait à rompre avec la perfection recherchée jusqu’alors et à provoquer des émotions."
                                        ],
                                        "tags": [
                                            "Peinture",
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a46ecbf-b345-4ee8-ab01-a2353f97f2a3",
                                                "sense_id": "c7a61471-351d-3b34-8bbd-f1069deeebeb",
                                                "text": "Renouant avec l’artisanat, flirtant avec le postmodernisme, brassant plusieurs esthétiques, cette jeune garde a de larges inspirations : du primitivisme aux technologies avancées, du maniérisme à un rigorisme ascétique."
                                            },
                                            {
                                                "example_id": "9dbe8434-c226-47c1-a500-0fd7599b4ca1",
                                                "sense_id": "c7a61471-351d-3b34-8bbd-f1069deeebeb",
                                                "text": "La Babylone imaginaire qui occupe tout le fond de la toile est souvent citée comme exemple de ce maniérisme hambourgeois dont on ne connaît que trop peu d’œuvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcd2c274-285c-3cf4-b9d3-13b28a7393c6",
                                        "entry_id": "ec4a1aa9-015a-309c-aae9-dee363626f82",
                                        "glosses": [
                                            "Trouble du comportement qui se traduit par des tics ou des états psychotiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364facbf-a181-4ce2-abf4-969c4b1768ac",
                                                "sense_id": "bcd2c274-285c-3cf4-b9d3-13b28a7393c6",
                                                "text": "Elle peut être désordonnée et maladroite, rigide ou très minimaliste. On constate aussi des maniérismes moteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
