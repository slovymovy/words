                        "examples": [
                            {
                                "example_id": "c8e6f6cc-40fd-44cb-9b59-baf33c9d6ae4",
                                "sense_id": "b6135c7a-eaed-3b8f-8a67-1a7dea231169",
                                "text": "Hearing loss may be conductive, sensorineural, or mixed, and the degree of loss may be mild, moderate, severe, profound, or total (anacusic)."
                            },
                            {
                                "example_id": "d0caadd7-6700-41fa-894b-18012bb004af",
                                "sense_id": "b6135c7a-eaed-3b8f-8a67-1a7dea231169",
                                "text": "Only vibrotactile responses could be obtained in 59 ears in the presence of effusion, while only 8 ears in an effusion-free condition were classified as anacusic."
                            },
                            {
                                "example_id": "b854604d-5e9a-4139-8cbf-681ba129ee50",
                                "sense_id": "b6135c7a-eaed-3b8f-8a67-1a7dea231169",
                                "text": "In the anacusic ear, eustachian tube obliteration, using muscle, bone, or foreign materials, may be indicated."
                            }
                        ]
                    }
