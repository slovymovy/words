                                "example_id": "ac037985-9adb-4dcd-9a3f-a4d51955aa4f",
                                "sense_id": "fe3e077f-4b36-3a82-be60-4cdbc9417a7f",
                                "text": "You can choose spreadable cheese or cheese blocks."
                            },
