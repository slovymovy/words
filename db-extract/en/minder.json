                                        "sense_id": "c0eab752-d25f-37e4-bff9-453861b6abc5",
                                        "entry_id": "2ce24f0a-c761-33de-a837-bb55756b3bfe",
                                        "glosses": [
                                            "weibliche Person, welche während des Tages auf die Kinder von berufstätigen Müttern aufpasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585a71aa-6a62-4828-91a3-88ac5faafaac",
                                                "sense_id": "c0eab752-d25f-37e4-bff9-453861b6abc5",
                                                "text": "Heute macht die Tagesmutter mit ihren Kindern ein Ausflug in den Zoo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "964e7d6d-63f3-4fd9-835c-26c21ea27787",
                        "source_entry_id": "f5a563c1-2b37-376f-b84a-7ce52248783e",
                        "source_sense_description": "One who minds someone or something",
                        "target_lang_word": "Babysitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Babysitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "675a2a29-a9ff-3e95-b391-cae21d5ab7af",
                                        "entry_id": "f5bbed4f-0af9-3c77-84d5-577d3a6a0ac9",
                                        "glosses": [
                                            "Person, die Säuglinge und Kleinkinder in Abwesenheit ihrer Eltern meist gegen Bezahlung hütet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f7e9a4-a818-48b2-bb1c-72ee2c82192a",
                                                "sense_id": "675a2a29-a9ff-3e95-b391-cae21d5ab7af",
                                                "text": "Meine Schwester arbeitet als Babysitter."
                                            },
                                            {
                                                "example_id": "864c8514-f86f-4cca-be10-d89c92b0abd1",
                                                "sense_id": "675a2a29-a9ff-3e95-b391-cae21d5ab7af",
                                                "text": "Mein Mann und ich brauchen morgen einen Babysitter für unseren achtjährigen Sohn, da wir am Abend ins Theater gehen wollen."
                                            },
                                            {
                                                "example_id": "82a49ccc-68e9-49ca-a811-3896ca82c4d0",
                                                "sense_id": "675a2a29-a9ff-3e95-b391-cae21d5ab7af",
                                                "text": "Ich kann heute Abend nicht zur Feier kommen, weil ich keinen Babysitter bekommen habe."
                                            },
                                            {
                                                "example_id": "13795c38-0faa-4602-88b8-0e4b91b2e226",
                                                "sense_id": "675a2a29-a9ff-3e95-b391-cae21d5ab7af",
                                                "text": "„Die 43-Jährige ist keine Erzieherin, keine Nachhilfelehrerin, kein Babysitter, sondern Mandys Mentorin: jemand, der vor allem Zeit mit ihr verbringt, exklusiv und regelmäßig. „Eine Erweiterung des Beziehungsangebots“, so nennt Oliver Wenninger es.“"
                                            },
                                            {
                                                "example_id": "631361dd-618a-4cf8-b7af-6ad5a83a5bfa",
                                                "sense_id": "675a2a29-a9ff-3e95-b391-cae21d5ab7af",
                                                "text": "„Damals gab es keine Babysitter, und Bumby blieb zufrieden in seinem hohen Gitterbett mit seiner wunderbaren großen Katze, die F. Puss hieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
