                                "target_word": "флибустьер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1bbd6ef7-73d8-3630-a80a-879f87bade77",
                                        "entry_id": "2990a394-9439-360b-8951-89755f778122",
                                        "glosses": [
                                            "истор. морской разбойник, пират, часто действовавший под защитой разрешительной грамоты какого-либо государства"
                                        ],
                                        "tags": [],
