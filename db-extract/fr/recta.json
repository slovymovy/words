        "fr-extract.jsonl": [
            {
                "entry_id": "f5f6a430-7234-3dd7-9226-885f33dedeeb",
                "word": "recta",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "46d8e177-8345-3948-867d-59560c84b2e1",
                        "entry_id": "f5f6a430-7234-3dd7-9226-885f33dedeeb",
                        "glosses": [
                            "Ponctuellement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "28cabd96-fc3e-4cae-9207-e845da3f4550",
                                "sense_id": "46d8e177-8345-3948-867d-59560c84b2e1",
                                "text": "Il a payé recta à l’échéance."
                            },
                            {
                                "example_id": "174246b7-6408-451a-9c47-85ed0fac02de",
                                "sense_id": "46d8e177-8345-3948-867d-59560c84b2e1",
                                "text": "Il est arrivé recta à l’heure indiquée."
                            },
                            {
                                "example_id": "46a7db92-513a-4455-956d-66e60616af6e",
                                "sense_id": "46d8e177-8345-3948-867d-59560c84b2e1",
                                "text": "— Quel brave ! et il payait recta !\nUn maréchal de France a pu sauver l’Empereur ou son pays, il payait recta sera toujours son plus bel éloge dans la bouche d’un commerçant."
                            },
                            {
                                "example_id": "a9e9b137-1807-4eb9-9044-f4e0dec15071",
                                "sense_id": "46d8e177-8345-3948-867d-59560c84b2e1",
                                "text": "Par la volonté de la Misangère, la récolte, au Paridier, se fit recta."
                            },
                            {
                                "example_id": "c3e0f907-7a12-481e-832a-03eea5537b7c",
                                "sense_id": "46d8e177-8345-3948-867d-59560c84b2e1",
                                "text": "– Eh bien moi ! Tous les matins, en rentrant, je donnais cent francs à ma femme. Cent francs ! C’était recta !"
                            },
                            {
                                "example_id": "de432f45-3ac1-441f-8f9c-68fd17d61ee4",
                                "sense_id": "46d8e177-8345-3948-867d-59560c84b2e1",
                                "text": "Sur les une heure, quand on est à table, voilà le chanteur du dimanche qui s’amène. Recta."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0dd0643-22f5-3656-b667-da782f86ff70",
                        "entry_id": "f5f6a430-7234-3dd7-9226-885f33dedeeb",
                        "glosses": [
                            "Conforme aux règles."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e2ff9975-7774-4de2-ab0c-4ae41bbd917f",
                                "sense_id": "e0dd0643-22f5-3656-b667-da782f86ff70",
                                "text": "Quelquefois, de ce temps, il les amusait d’un petit roucoulis de colombe, d’un petit pas espagnol, d’un mouvement de tête calculé pour faire mousser cette crinière soyeuse qu’il avait, toujours peignée recta et propre comme un sou."
                            },
                            {
                                "example_id": "8de35c55-a4b8-410d-b8f6-fb832b762c07",
                                "sense_id": "e0dd0643-22f5-3656-b667-da782f86ff70",
                                "text": "C’est recta comme dans un livre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b990420-b188-4e59-9f34-6623ae600f14",
                        "source_entry_id": "f5f6a430-7234-3dd7-9226-885f33dedeeb",
