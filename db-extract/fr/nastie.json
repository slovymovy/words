                        "entry_id": "fa20cbd2-b696-3beb-8144-7e501278ac29",
                        "glosses": [
                            "Mouvement déclenché par un facteur externe chez un végétal, sans rapport d’orientation avec ce facteur et indépendant de la croissance de ce végétal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36d799e-d9af-489d-a33b-7c3de6889897",
                                "sense_id": "9d92e6dd-0b9f-3daf-96e1-4772c47fafef",
                                "text": "On utilise celui [le mot] de nastie quand l’orientation du mouvement des plantes (tactismes, nasties, tropismes, nutation) n’avaient cessé d'intriguer les naturalistes."
                            }
                        ]
                    }
                ],
