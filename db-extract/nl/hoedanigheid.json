                ],
                "translations": [
                    {
                        "translation_id": "25257b61-0bd1-499c-877e-d70174b5d3b8",
                        "source_entry_id": "17a08887-7b04-39ea-a798-cbf47186e582",
                        "target_lang_word": "Eigenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "304f4107-d97f-32cd-8c36-94f4aef79f3c",
                                        "entry_id": "929e63bf-0af1-3030-aed8-a7370920ce89",
                                        "glosses": [
                                            "Merkmal einer Sache, eines Wesens; das, was für jemanden oder etwas typisch oder kennzeichnend ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122258d2-a9ee-45f0-9f6c-348ff3507d7e",
                                                "sense_id": "304f4107-d97f-32cd-8c36-94f4aef79f3c",
                                                "text": "Sind wir wirklich mehr als die Summe unserer Eigenschaften?"
                                            },
                                            {
                                                "example_id": "6ea99127-16d2-47b0-9abb-2713447eacc6",
                                                "sense_id": "304f4107-d97f-32cd-8c36-94f4aef79f3c",
                                                "text": "Der Ball ist rund, er hat die wesentliche Eigenschaft, das Attribut, rund zu sein. Sonst wäre es kein Ball. Darüber hinaus hat er noch unwesentliche Eigenschaften, Akzidenzien, wie z.B. Farbe und Größe."
                                            },
                                            {
                                                "example_id": "00b10bb1-168a-456c-9eb1-ec5380e0b731",
                                                "sense_id": "304f4107-d97f-32cd-8c36-94f4aef79f3c",
                                                "text": "„Risiken beim Einsatz gentechnisch veränderter Pflanzen sind neben einer Bedrohung der Artenvielfalt auch Nebeneffekte wie das Auftreten neuer unerwünschter Eigenschaften bei den Pflanzen, aber auch allergische Reaktionen bei den Verbrauchern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "531dfb0c-9302-4b01-8287-71fbaa32f194",
                        "source_entry_id": "17a08887-7b04-39ea-a798-cbf47186e582",
                        "target_lang_word": "Beschaffenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschaffenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6981faa0-da77-386d-9b27-750cb721a36e",
                                        "entry_id": "e902e121-a782-3e1f-8224-5468af7220f5",
                                        "glosses": [
                                            "Eigenart oder Zustand einer Sache"
                                        ],
                                        "tags": [
                                            "heutzutage sehr selten im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04defbc9-5023-4149-a064-e4b6b3649cc8",
                                                "sense_id": "6981faa0-da77-386d-9b27-750cb721a36e",
                                                "text": "Die Sichtbarkeit ist die deutlich visuell wahrnehmbare Beschaffenheit."
                                            },
                                            {
                                                "example_id": "5874935e-b21d-42bf-8068-8eaca6d230bd",
                                                "sense_id": "6981faa0-da77-386d-9b27-750cb721a36e",
                                                "text": "Die beiliegende Gebrauchsanweisung gibt auch Auskunft über Herkunft, Beschaffenheit und Fragen zur Gewährleistung."
                                            },
                                            {
                                                "example_id": "e9ec5b11-4800-40b9-8ccc-3f2f809da302",
                                                "sense_id": "6981faa0-da77-386d-9b27-750cb721a36e",
                                                "text": "Man muß sie mit allen Anlagen und Arbeiten bekannt machen, die im Kriege vorkommen können, damit sie lernen, dieselben jederzeit in der gehörigen Uebereinstimmung mit den übrigen Waffen und den Beschaffenheiten des Terrains gemäß anzuordnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
