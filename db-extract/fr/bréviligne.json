                        "sense_id": "50177802-d388-38cf-b9d9-daafef8e79f6",
                        "entry_id": "11bbc627-f092-3929-b1c2-d9f96a6b091e",
                        "glosses": [
                            "De taille courte et épaisse, et avec des membres courts et épais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d858c45-338b-4a0b-beb2-7b5e56fdbc8c",
                                "sense_id": "50177802-d388-38cf-b9d9-daafef8e79f6",
                                "text": "Étienne avait immédiatement reconnu un Asiatique d’une soixantaine d’années, bréviligne, toujours boudiné dans son costume, un comprador qu’il avait maintes fois vu en affaires avec Gaston."
                            },
                            {
                                "example_id": "fbf1088a-4107-4a80-ae65-1ad0c2d3b6fe",
                                "sense_id": "50177802-d388-38cf-b9d9-daafef8e79f6",
                                "text": "C’est un bouledogue dit français, au poil noir et brillant, au petit corps boulot, bréviligne, donc, si on vous demande, et plutôt bonne pâte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3ee9385-23a2-457b-a164-63de349d976e",
                        "source_entry_id": "11bbc627-f092-3929-b1c2-d9f96a6b091e",
                        "source_sense_id": "50177802-d388-38cf-b9d9-daafef8e79f6",
                        "target_lang_word": "brevilineal",
