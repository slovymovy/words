{
    "word_family": [
        "pimping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de403671-808b-3010-bdb4-191ff3c39f92",
                    "sense_definition": "A person who manages prostitutes and solicits customers for them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prostitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police finally arrested the <w>pimp</w> who had been controlling the women in the area.",
                            "target_lang_translations": {
                                "ru": "Полиция наконец арестовала <w>сутенёра</w>, который контролировал женщин в этом районе."
                            }
                        },
                        {
                            "text": "He was known in the neighborhood as a dangerous <w>pimp</w>.",
                            "target_lang_translations": {
                                "ru": "В округе его знали как опасного <w>сутенёра</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hustler",
                        "pandar"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in informal or criminal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который управляет проститутками и ищет для них клиентов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутенёр",
                                "target_lang_sense_clarification": "основной термин для обозначения человека, организующего проституцию"
                            },
                            {
                                "target_lang_word": "кот",
                                "target_lang_sense_clarification": "сленговое, пренебрежительное обозначение сутенёра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b11d5458-41f4-354e-8c44-f4462c60bcb7",
                    "sense_definition": "A man who is very successful at attracting women.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acts like a total <w>pimp</w> whenever he walks into a crowded party.",
                            "target_lang_translations": {
                                "ru": "Он ведёт себя как настоящий <w>бабник</w>, когда заходит на многолюдную вечеринку."
                            }
                        },
                        {
                            "text": "Some guys think being a <w>pimp</w> is a sign of status among their friends.",
                            "target_lang_translations": {
                                "ru": "Некоторые парни считают, что быть <w>бабником</w> — это признак статуса среди друзей."
                            }
                        }
                    ],
                    "synonyms": [
                        "mack"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and often derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, который очень успешен в привлечении женщин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабник",
                                "target_lang_sense_clarification": "мужчина, который часто меняет женщин, ловелас"
                            },
                            {
                                "target_lang_word": "альфа-самец",
                                "target_lang_sense_clarification": "мужчина, демонстрирующий доминирование и успех у женщин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70792e9b-6178-39a0-abc2-53461c077ab4",
                    "sense_definition": "To customize or decorate something, especially a vehicle, in an elaborate or flashy way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "customization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>pimp</w> out their old van with new lights and a sound system.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>прокачать</w> свой старый фургон, установив новые фары и аудиосистему."
                            }
                        },
                        {
                            "text": "He spent all his savings to <w>pimp</w> his car for the upcoming show.",
                            "target_lang_translations": {
                                "ru": "Он потратил все свои сбережения, чтобы <w>прокачать</w> машину для предстоящего шоу."
                            }
                        }
                    ],
                    "synonyms": [
                        "customize"
                    ],
                    "common_phrases": [
                        "pimp out"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Popularized by media and car culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Модернизировать или украшать что-либо, особенно автомобиль, в ярком или броском стиле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокачать",
                                "target_lang_sense_clarification": "сленговый термин для улучшения характеристик или внешнего вида автомобиля"
                            },
                            {
                                "target_lang_word": "тюнинговать",
                                "target_lang_sense_clarification": "технический термин для модификации автомобиля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8add74d-15e6-3036-a753-29519797479c",
                    "sense_definition": "To promote or advertise something aggressively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired influencers to <w>pimp</w> their new product on social media.",
                            "target_lang_translations": {
                                "ru": "Компания наняла инфлюенсеров, чтобы те <w>продвигали</w> их новый продукт в социальных сетях."
                            }
                        },
                        {
                            "text": "He is always trying to <w>pimp</w> his own blog to anyone who will listen.",
                            "target_lang_translations": {
                                "ru": "Он постоянно пытается <w>продвигать</w> свой блог всем, кто готов слушать."
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "tout"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Агрессивно продвигать или рекламировать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвигать",
                                "target_lang_sense_clarification": "активно способствовать распространению или популярности чего-либо"
                            },
                            {
                                "target_lang_word": "впаривать",
                                "target_lang_sense_clarification": "навязчиво предлагать товар или услугу (разг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "529b08c8-277e-31fc-a753-b9323b0a157f",
                    "sense_definition": "To work as a manager for prostitutes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "prostitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal organization was caught trying to <w>pimp</w> vulnerable people in the city.",
                            "target_lang_translations": {
                                "ru": "Преступную организацию поймали на попытке <w>сводничать</w> уязвимыми людьми в городе."
                            }
                        },
                        {
                            "text": "It is illegal to <w>pimp</w> in almost every jurisdiction.",
                            "target_lang_translations": {
                                "ru": "В почти любой юрисдикции <w>сводничество</w> является незаконным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать в качестве сутенёра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сводничать",
                                "target_lang_sense_clarification": "заниматься посредничеством в проституции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ecb9b35c-94a4-3c55-af0b-fe679feba64d",
                    "sense_definition": "Excellent, fashionable, or stylish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is a <w>pimp</w> new jacket you are wearing today.",
                            "target_lang_translations": {
                                "ru": "У тебя сегодня <w>крутая</w> новая куртка."
                            }
                        },
                        {
                            "text": "He showed up in a <w>pimp</w> ride that turned everyone's heads.",
                            "target_lang_translations": {
                                "ru": "Он приехал на <w>шикарной</w> тачке, на которую все обернулись."
                            }
                        }
                    ],
                    "synonyms": [
                        "stylish",
                        "fashionable"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Dated slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, модный или стильный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "разговорное обозначение чего-то очень стильного или впечатляющего"
                            },
                            {
                                "target_lang_word": "шикарный",
                                "target_lang_sense_clarification": "выглядящий дорого и модно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}