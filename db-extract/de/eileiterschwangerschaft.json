                "senses": [
                    {
                        "sense_id": "2334e42c-bd1e-3f2d-80aa-0602b6158871",
                        "entry_id": "71bbbb1b-ce4f-38cb-89f7-b41eac22ef9f",
                        "glosses": [
                            "Schwangerschaft, bei der sich die befruchtete Eizelle nicht in der Gebärmutter, sondern in einem Eileiter einnistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd790c1-c17b-4ee3-a930-a0f36e2302e2",
                                "sense_id": "2334e42c-bd1e-3f2d-80aa-0602b6158871",
                                "text": "„Bei der Eileiterschwangerschaft findet die Einnistung der befruchteten Eizelle im Eileiter statt; in den ersten vier Wochen treten dann periodisch einseitige Unterbauchschmerzen auf.“"
                            },
                            {
                                "example_id": "777cedf4-a6e5-4f40-8871-08ba910a026a",
                                "sense_id": "2334e42c-bd1e-3f2d-80aa-0602b6158871",
                                "text": "„Frau Wittler war es, bei der Henni Trost fand, und von ihr erfuhr sie auch, dass ihre Mutter an einer Eileiterschwangerschaft gestorben war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
