                            {
                                "example_id": "b3e8ee49-9c38-4832-9bd8-cb14d8301409",
                                "sense_id": "6e118b0b-ec49-3dac-827e-d12d1587e86e",
                                "text": "Stał tu podniszczony, przedwojenny kredens, trzydrzwiowa szafa, również wykonana w latach dwudziestych, do tego jeszcze okrągły stół z czterema krzesłami i wyleżany tapczan, który matka Mirka kupiła na raty gdzieś koło roku siedemdziesiątego"
                            }
                        ],
