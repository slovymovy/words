                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "40c4b9f4-c6fa-411a-9cf3-0da8f2b4de9e",
                        "entry_id": "231ef380-a4f2-3f47-8e3b-8e1561e8d2ed",
                        "tags": [
                            "plural"
