                    {
                        "sense_id": "5bb18b49-a545-3151-b3c0-3be70641b680",
                        "entry_id": "0ec104bf-23be-33cb-bd46-dbf0817b1de5",
                        "glosses": [
                            "headphones"
                        ],
                        "tags": [
                            "informal",
