                "senses": [
                    {
                        "sense_id": "eab35d5b-e321-34c8-b653-07003dfa9169",
                        "entry_id": "e38ca28f-f4d1-3f39-a7b9-ab23c67a5e3b",
                        "glosses": [
                            "Sorte de grande corbeille d’osier pour transporter les fruits, les légumes ou les fourrages."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba3aedc-cf12-4084-b267-99d66a56ad5d",
                                "sense_id": "eab35d5b-e321-34c8-b653-07003dfa9169",
                                "text": "Parfois aussi passait un couple de camps volants, de vanniers nomades qui vendent des paniers et des « charpagnes » aux paysans."
                            },
                            {
                                "example_id": "06fd7c40-7a65-4ff9-a94c-5e2e7924bcc5",
                                "sense_id": "eab35d5b-e321-34c8-b653-07003dfa9169",
                                "text": "Ils changent d’activité au rythme des saisons, fabriquent des charpagnes ou cherchent dans les bois les plantes médicinales."
                            },
                            {
                                "example_id": "b6f92951-d0df-46a7-91f4-9266b2f850d6",
                                "sense_id": "eab35d5b-e321-34c8-b653-07003dfa9169",
                                "text": "Le couple a encore ses outils de travail dans cette salle commune, à portée de la main : la lanterne […], les récipients de la traite, les paniers et charpagnes, grandes corbeilles à linge ou à légumes, […]."
                            },
                            {
                                "example_id": "305eacb5-3b97-4914-b155-83c4dc5e0d91",
                                "sense_id": "eab35d5b-e321-34c8-b653-07003dfa9169",
                                "text": "On jouait tous notre couplet, puis, d’une manière franche et résolue, le rouquin sortait de son sac grand comme une charpagne un bocal."
                            }
                        ]
                    },
                    {
                        "sense_id": "df426441-d7eb-31f5-b748-8889306543fd",
                        "entry_id": "e38ca28f-f4d1-3f39-a7b9-ab23c67a5e3b",
                        "glosses": [
                            "Morceau de bois coupé en forme d’ellipse, utilisé pour le transport des pierres."
                        ],
