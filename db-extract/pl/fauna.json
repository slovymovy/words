                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fauna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b72493d-5d4a-3320-8e26-467d005f2783",
                                        "entry_id": "b9b900b0-3979-318f-a601-56b940f9fda5",
                                        "glosses": [
                                            "Gesamtheit aller Tiere eines definierten Gebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683a8cb9-e409-425a-8c7e-d9aa27afa7f9",
                                                "sense_id": "9b72493d-5d4a-3320-8e26-467d005f2783",
                                                "text": "Die Fauna Madagaskars ist außerordentlich interessant."
                                            },
                                            {
                                                "example_id": "33a80910-6eaf-4cd3-97b6-7638b4ff08ac",
                                                "sense_id": "9b72493d-5d4a-3320-8e26-467d005f2783",
                                                "text": "„Kennzeichnend für diese einzigartige Naturlandschaft sind die zahlreichen Bäche, Flüsse, Stauseen sowie die großflächigen Laubwälder mit ihrer seltenen Flora und Fauna.“"
                                            },
                                            {
                                                "example_id": "da6b5e4f-515c-41f8-b48d-d93b78642cd5",
                                                "sense_id": "9b72493d-5d4a-3320-8e26-467d005f2783",
                                                "text": "„Dabei stimmt das nicht, in Island ist nur alles viel kleiner als anderswo, auch die Flora und Fauna.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fauna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7242d2fb-82d5-3cab-8e6c-874a6274bab8",
                                        "entry_id": "18bca17e-e154-34d4-ae9b-3c1e218e5122",
                                        "glosses": [
                                            "Göttin der römischen Mythologie; Ehefrau (alternativ auch Schwester oder Tochter) des Faunus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "966d0da7-c9b2-4846-a0f3-a25dc510c19c",
                                                "sense_id": "7242d2fb-82d5-3cab-8e6c-874a6274bab8",
                                                "text": "„Fauna oder Fatua war die Gemahlin, oder nach anderen Mythen die Tochter des Faunus, eine Göttin der Römer, deren Herkunft und Bedeutung durch mancherlei Sagen sehr dunkel erscheint.“ (1867)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ce942e6-c84a-431e-aa42-ee633a4f6bb6",
                        "source_entry_id": "8e104d2d-60bb-339a-8ea1-ed55d66c3ab5",
