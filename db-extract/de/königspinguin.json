                                "target_senses": [
                                    {
                                        "sense_id": "24cea7a6-dc10-3181-a37d-5b4dfedb1037",
                                        "entry_id": "fe3ce1dc-91df-3d66-a636-e0016b1e6923",
                                        "glosses": [
                                            "a large penguin, Aptenodytes patagonicus, that lives on the coast of Antarctica and nearby islands"
                                        ],
