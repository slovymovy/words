{
    "word_family": [
        "broacher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6def9c3-f392-3c0f-920e-63551da04804",
                    "sense_definition": "To raise or introduce a sensitive, difficult, or important topic for discussion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "introduce_topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was nervous to <w>broach</w> the subject of a salary raise with her manager.",
                            "target_lang_translations": {
                                "ru": "Она нервничала перед тем, как <w>поднять</w> тему повышения зарплаты в разговоре с руководителем."
                            }
                        },
                        {
                            "text": "We need to find the right moment to <w>broach</w> the matter with the family.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выбрать подходящий момент, чтобы <w>завести речь</w> об этом вопросе с семьёй."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broach the subject",
                        "broach the topic",
                        "broach the matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затрагивать или поднимать деликатную, сложную или важную тему для обсуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "вопрос или тему"
                            },
                            {
                                "target_lang_word": "затрагивать",
                                "target_lang_sense_clarification": "тему разговора"
                            },
                            {
                                "target_lang_word": "заводить речь",
                                "target_lang_sense_clarification": "о чём-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63563ab2-7287-342d-b2f4-f6bd9291bbb1",
                    "sense_definition": "To pierce or open a cask or barrel in order to draw liquid from it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pierce_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The innkeeper prepared to <w>broach</w> a fresh barrel of cider for the festival.",
                            "target_lang_translations": {
                                "ru": "Трактирщик приготовился <w>откупорить</w> свежую бочку сидра к празднику."
                            }
                        },
                        {
                            "text": "They decided to <w>broach</w> the wine cask to celebrate the victory.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>распечатать</w> бочонок вина, чтобы отпраздновать победу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broach a cask",
                        "broach a barrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Протыкать, откупоривать бочку или бочонок, чтобы сцедить жидкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откупоривать",
                                "target_lang_sense_clarification": "бочку"
                            },
                            {
                                "target_lang_word": "распечатывать",
                                "target_lang_sense_clarification": "бочонок"
                            },
                            {
                                "target_lang_word": "начинать",
                                "target_lang_sense_clarification": "бочку, пробивая кран"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b7ec2e7-df2c-35ef-9b8e-42798825fbd0",
                    "sense_definition": "To pierce, open, or make a breakthrough into something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pierce_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy forces tried repeatedly to <w>broach</w> our defensive line.",
                            "target_lang_translations": {
                                "ru": "Вражеские войска неоднократно пытались <w>прорвать</w> нашу линию обороны."
                            }
                        },
                        {
                            "text": "Special tools were required to <w>broach</w> the reinforced metal door.",
                            "target_lang_translations": {
                                "ru": "Чтобы <w>вскрыть</w> бронированную металлическую дверь, потребовались специальные инструменты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пробивать, вскрывать или прорывать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробивать",
                                "target_lang_sense_clarification": "преграду, брешь"
                            },
                            {
                                "target_lang_word": "вскрывать",
                                "target_lang_sense_clarification": "дверь, преграду"
                            },
                            {
                                "target_lang_word": "прорывать",
                                "target_lang_sense_clarification": "оборону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49f942be-f97a-33c7-80ea-474d9b678aec",
                    "sense_definition": "To veer or turn unintentionally sideways to the oncoming wind and waves.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical_turn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the violent storm, the yacht started to <w>broach</w> dangerously in the swell.",
                            "target_lang_translations": {
                                "ru": "Во время сильного шторма яхту начало опасно <w>разворачивать лагом к волне</w>."
                            }
                        },
                        {
                            "text": "The crew fought to prevent the sailing vessel from <w>broaching</w> in the heavy seas.",
                            "target_lang_translations": {
                                "ru": "Экипаж изо всех сил старался не допустить, чтобы судно <w>свалилось в брочинг</w> при сильном волнении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broach to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непроизвольно разворачиваться бортом к набегающему ветру и волнам (о судне)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брочить",
                                "target_lang_sense_clarification": "совершать брочинг, разворачиваться бортом к волне"
                            },
                            {
                                "target_lang_word": "разворачиваться бортом к волне",
                                "target_lang_sense_clarification": "о судне при брочинге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79bbcdff-a7fa-3d9c-9756-928175c07ebd",
                    "sense_definition": "To cause a vessel to veer sideways to the wind and oncoming waves.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical_turn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden large wave <w>broached</w> the ship against the rocky coast.",
                            "target_lang_translations": {
                                "ru": "Внезапная огромная волна <w>развернула</w> корабль <w>бортом</w> у скалистого берега."
                            }
                        },
                        {
                            "text": "The rough following sea <w>broached</w> their small boat without warning.",
                            "target_lang_translations": {
                                "ru": "Бурное попутное волнение внезапно <w>развернуло</w> их небольшую лодку <w>боком к волне</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать резкий неконтролируемый разворот судна лагом (бортом) к волне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разворачивать лагом к волне",
                                "target_lang_sense_clarification": "о волне или ветре по отношению к судну"
                            },
                            {
                                "target_lang_word": "бросить в брочинг",
                                "target_lang_sense_clarification": "развернуть судно боком к волне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2643e63-11b8-3538-97de-0128623e53fa",
                    "sense_definition": "To rise and break through the surface of the water, especially of a marine animal or submarine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "break_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the humpback whale suddenly <w>broach</w> right near our tour boat.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как горбатый кит неожиданно <w>вынырнул из воды</w> прямо рядом с нашим экскурсионным судном."
                            }
                        },
                        {
                            "text": "The submarine began to <w>broach</w> through the choppy waters of the bay.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка начала <w>всплывать</w>, прорезая неспокойные воды залива."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выныривать или пробивать поверхность воды (о морском животном или подлодке)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выныривать",
                                "target_lang_sense_clarification": "на поверхность воды"
                            },
                            {
                                "target_lang_word": "всплывать",
                                "target_lang_sense_clarification": "пробивая поверхность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c4ebc80-80fd-3d89-b8ce-665d15652828",
                    "sense_definition": "Alternative spelling of <w>brooch</w>, a decorative piece of jewellery pinned to clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fastener_or_pin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She fastened her woolen scarf with an antique silver <w>broach</w>.",
                            "target_lang_translations": {
                                "ru": "Она заколола шерстяной шарф старинной серебряной <w>брошью</w>."
                            }
                        },
                        {
                            "text": "The heirloom <w>broach</w> sparkled in the dim light of the dressing room.",
                            "target_lang_translations": {
                                "ru": "Фамильная <w>брошь</w> сверкала в полумраке гардеробной."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "alternative spelling of brooch"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова brooch: брошь, декоративное украшение, прикалываемое к одежде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брошь",
                                "target_lang_sense_clarification": "украшение"
                            },
                            {
                                "target_lang_word": "брошка",
                                "target_lang_sense_clarification": "украшение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20ec05f8-f73f-3d1a-a00f-c5f1d0d463d6",
                    "sense_definition": "A toothed cutting tool or a series of chisel points used for shaping or enlarging holes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machinist used a hardened steel <w>broach</w> to cut the internal keyway.",
                            "target_lang_translations": {
                                "ru": "Станочник использовал закалённую стальную <w>протяжку</w>, чтобы проточить внутренний шпоночный паз."
                            }
                        },
                        {
                            "text": "A stonecutter selected a sharp <w>broach</w> to dress the surface of the block.",
                            "target_lang_translations": {
                                "ru": "Каменотёс выбрал острое <w>долото</w>, чтобы обработать поверхность блока."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Многорезцовый режущий инструмент (протяжка) для обработки или расширения отверстий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протяжка",
                                "target_lang_sense_clarification": "металлорежущий инструмент"
                            },
                            {
                                "target_lang_word": "прошивка",
                                "target_lang_sense_clarification": "инструмент для обработки отверстий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f5ed6f-cdf1-364d-9944-8d7fcc006ee7",
                    "sense_definition": "A broad chisel used by stonecutters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He smoothed the rough granite using a heavy <w>broach</w>.",
                            "target_lang_translations": {
                                "ru": "Он выровнял необработанный гранит с помощью тяжёлого <w>зубила</w>."
                            }
                        },
                        {
                            "text": "The mason kept a broad <w>broach</w> in his toolkit for shaping large stones.",
                            "target_lang_translations": {
                                "ru": "Каменщик держал в наборе инструментов широкую <w>троянку</w> для придания формы крупным камням."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкое долото или зубило, используемое каменотёсами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долото",
                                "target_lang_sense_clarification": "инструмент каменотёса"
                            },
                            {
                                "target_lang_word": "зубило",
                                "target_lang_sense_clarification": "для обработки камня"
                            },
                            {
                                "target_lang_word": "троянка",
                                "target_lang_sense_clarification": "зубчатое долото по камню"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd9466a0-52c7-3e5a-a817-01cb91a759e0",
                    "sense_definition": "A spit used for roasting meat over an open fire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pointed_rod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servants turned a heavy iron <w>broach</w> loaded with venison over the fire.",
                            "target_lang_translations": {
                                "ru": "Слуги поворачивали над огнём тяжёлый железный <w>вертел</w> с олениной."
                            }
                        },
                        {
                            "text": "A pig was mounted on a large <w>broach</w> above glowing coals.",
                            "target_lang_translations": {
                                "ru": "Поросёнка насадили на большой <w>вертел</w> над тлеющими углями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "cooking spit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертел для жарки мяса на открытом огне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертел",
                                "target_lang_sense_clarification": "металлический стержень для жарки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a9f26e4-41f6-37f2-8aa6-b1f88edd500f",
                    "sense_definition": "A pointed rod, bodkin, or awl, especially a sharpened wooden pin used to secure thatch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pointed_rod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thatcher fastened the layers of reeds using a wooden <w>broach</w>.",
                            "target_lang_translations": {
                                "ru": "Кровельщик закрепил слои тростника деревянным <w>колышком</w>."
                            }
                        },
                        {
                            "text": "Each pointed <w>broach</w> held the straw securely against the winter winds.",
                            "target_lang_translations": {
                                "ru": "Каждая заострённая <w>спица</w> надёжно удерживала солому от зимних ветров."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заострённый стержень, деревянная спица или колышек, служащий для крепления соломенной кровли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колышек",
                                "target_lang_sense_clarification": "для крепления соломенной крыши"
                            },
                            {
                                "target_lang_word": "спица",
                                "target_lang_sense_clarification": "деревянный штырь кровельщика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10f0c8b2-f812-335d-9bac-419e8fd56ed1",
                    "sense_definition": "A spire that rises directly from a church tower without an intervening parapet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parish church features an octagonal <w>broach</w> built on a square tower.",
                            "target_lang_translations": {
                                "ru": "Приходская церковь выделяется восьмигранным <w>шатровым шпилем</w>, возведённым на квадратной башне."
                            }
                        },
                        {
                            "text": "Architectural historians admired the medieval masonry of the stone <w>broach</w>.",
                            "target_lang_translations": {
                                "ru": "Историки архитектуры восхищались средневековой кладкой каменного <w>шпиля</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broach spire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шатровый шпиль, вырастающий непосредственно из основания квадратной башни без парапета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатровый шпиль",
                                "target_lang_sense_clarification": "в архитектуре"
                            },
                            {
                                "target_lang_word": "шпиль",
                                "target_lang_sense_clarification": "церковной башни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c382fca8-f018-3cdf-82d6-fb9807a1e304",
                    "sense_definition": "A spit-like tine or point on the head of a young stag.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pointed_rod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forester noticed a sharp <w>broach</w> beginning to grow on the young stag.",
                            "target_lang_translations": {
                                "ru": "Лесник заметил острый <w>отросток рога</w>, начавший расти у молодого оленя."
                            }
                        },
                        {
                            "text": "A narrow <w>broach</w> emerged from each side of the juvenile deer's head.",
                            "target_lang_translations": {
                                "ru": "С каждой стороны головы молодого оленя пробивалось по тонкому <w>рогу-спице</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "antler point"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одиночный острый отросток рога у молодого оленя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отросток рога",
                                "target_lang_sense_clarification": "у молодого оленя"
                            },
                            {
                                "target_lang_word": "рог-спица",
                                "target_lang_sense_clarification": "первый неразветвлённый рог"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5c614cd-96d6-3b72-961f-4a9453741b06",
                    "sense_definition": "A rod or stick from which candle wicks are suspended during the dipping process.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pointed_rod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candlemaker hung several wicks from a wooden <w>broach</w> before dipping.",
                            "target_lang_translations": {
                                "ru": "Свечник развесил несколько фитилей на деревянной <w>планке</w> перед маканием."
                            }
                        },
                        {
                            "text": "Wax dripped back into the vat as she lifted the <w>broach</w> carefully.",
                            "target_lang_translations": {
                                "ru": "Воск капал обратно в чан, когда она аккуратно поднимала <w>прут</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прут или планка, на которую подвешивают свечные фитили при макании в воск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "планка",
                                "target_lang_sense_clarification": "для подвешивания свечных фитилей"
                            },
                            {
                                "target_lang_word": "прут",
                                "target_lang_sense_clarification": "в свечном деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2fe4f2f-954e-35c0-896d-0be1d79eb28b",
                    "sense_definition": "A central pin inside a lock that enters the hollow barrel of a key.",
