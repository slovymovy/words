                        "loyaal",
                        "toegewijd"
                    ],
                    "antonyms": [
                        "ontrouw"
                    ],
                    "common_phrases": [
                        "getrouwe aanhanger",
                        "getrouw blijven"
                    ],
                    "target_lang_definitions": {
