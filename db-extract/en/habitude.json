    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                "word": "habitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5ddeae1d-bfd8-40fd-9684-ae71771582e3",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "tags": [
                            "plural"
                        ],
                        "form": "habitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d6eddbc-8f76-38f9-b7d0-94de08ff3b65",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "The essential character of one's being or existence; native or normal constitution; mental or moral constitution; bodily condition; native temperament."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2f1e11fe-24f6-42c3-95bb-fdc68ab27daa",
                                "sense_id": "5d6eddbc-8f76-38f9-b7d0-94de08ff3b65",
                                "text": "His real habitude gave life and grace / To appertainings and to ornament."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dea8eca-b3fc-3319-b394-d55617cdf0f1",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "Habitual disposition; normal or characteristic mode of behaviour, whether from habit or from nature"
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "896bf0e3-e64b-4d7e-91ec-0dc13a730723",
                                "sense_id": "9dea8eca-b3fc-3319-b394-d55617cdf0f1",
                                "text": "[I]ts thought, that, in the Seed are alvvaies potentially ſeuerall indiuiduating Qualities deriu'd from diuers of the neere Anceſtors, vvhich by the formatiue povver of the Parents may be expreſt in the Children, vvith reſpectiue habitude to either Sex; […]"
                            },
                            {
                                "example_id": "89a23c8c-d3f6-409b-a567-3a1ede71156c",
                                "sense_id": "9dea8eca-b3fc-3319-b394-d55617cdf0f1",
                                "text": "An habitude of commanding his passions in order to his health."
                            },
                            {
                                "example_id": "c1a3f1cf-a11c-49f8-8e65-d2977b92fe24",
                                "sense_id": "9dea8eca-b3fc-3319-b394-d55617cdf0f1",
                                "text": "[T]here was something of the habitude of the wild animal in the unreflecting instinct with which she rambled on — disconnecting herself by littles from her eventful past at every step, obliterating her identity […]"
                            },
                            {
                                "example_id": "7e85b95c-b3da-44ad-900d-234660321521",
                                "sense_id": "9dea8eca-b3fc-3319-b394-d55617cdf0f1",
                                "text": "With the instinct of old habitude they fell to the oars, Barbara rowing the better and the stronger."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ad36428-cd8d-3e5f-b6b3-2c0fdcbb23e4",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "Behaviour or manner of existence in relation to something else; relation; respect."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "117ca300-c48c-447c-b58f-0fd9e87e2896",
                                "sense_id": "5ad36428-cd8d-3e5f-b6b3-2c0fdcbb23e4",
                                "text": "And although Proportion ſtrictly ſignifies the Habitude or Relation of one Quantity to another, yet, in a looſer and tranſlated Senſe, it hath been applied to ſignify every other Habitude; and conſequently the Term Analogy comes to ſignify all Similitude or Relations, or Habitudes vvhatſoever."
                            }
                        ]
                    },
                    {
                        "sense_id": "89f1f39e-c85b-3e01-8931-f00d4c2dfd95",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "In full habitude: fully, wholly, entirely; in all respects."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a2a8a0c-927c-404c-8649-4ae4f83b8d5a",
                                "sense_id": "89f1f39e-c85b-3e01-8931-f00d4c2dfd95",
                                "text": "Although I believe not the report in full habitude."
                            }
                        ]
                    },
                    {
                        "sense_id": "a79e7e20-5962-3545-aee4-ab8bc032cf68",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "habitual association; familiar relation; acquaintance; familiarity; intimacy; association; intercourse."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d4decd8-2d7e-4d52-ba82-4c21ee74e8fe",
                                "sense_id": "a79e7e20-5962-3545-aee4-ab8bc032cf68",
                                "text": "The discourse of some with whom I have had some habitudes since my coming home."
                            }
                        ]
                    },
                    {
                        "sense_id": "543fa626-8efa-37a0-a683-a9467406665a",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "an associate; an acquaintance; someone with whom one is familiar."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ddf4d3e5-f7a5-41b2-bfe4-162b6db89bdc",
                                "sense_id": "543fa626-8efa-37a0-a683-a9467406665a",
                                "text": "La Corneus and Sallyes were the only habitudes we had."
                            }
                        ]
                    },
                    {
                        "sense_id": "06e60f01-70d6-3396-9080-7afde6fba02d",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "Habit; custom; usage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d4f32c01-4a69-4106-bc85-dd96b61184f9",
                                "sense_id": "06e60f01-70d6-3396-9080-7afde6fba02d",
                                "text": "Which […] by long habitude, are thought rather vertue than vice among them."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4cdcc87-cb0d-347f-8578-e11377662d80",
                        "entry_id": "c2a748d3-17bc-37f1-8827-a92571cbef40",
                        "glosses": [
                            "The various ways in which one substance reacts with another; chemical reaction."
                        ],
                        "tags": [
                            "countable",
                            "in-plural",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "db8856f6-0773-463c-8f3e-b6dce71b65c3",
                                "sense_id": "d4cdcc87-cb0d-347f-8578-e11377662d80",
                                "text": "Most authors who have had occasion to describe naphthaline, have noticed its habitudes with sulphuric acid."
                            }
                        ]
                    }
