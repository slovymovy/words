                        "examples": [
                            {
                                "example_id": "5a1c4e3e-5d8d-4f0f-9d88-18a81bc39eae",
                                "sense_id": "f34a1f8d-7931-3851-a2cd-775b6b45441b",
                                "text": "De beveiligingsman wist de groepen met zijn hond te scheiden en het slachtoffer te verlossen. Tijdens het optreden werd een verdachte uit Meppel door de hond gebeten. Ook een tweede persoon liep een bijtwond op in zijn hand."
                            },
                            {
                                "example_id": "697d9928-23c4-4947-8bce-161e78083ecb",
                                "sense_id": "f34a1f8d-7931-3851-a2cd-775b6b45441b",
                                "text": "De portier van een nachtclub werd in 1980 opgepakt na een tip. Edith zou haar moordenaar hebben gebeten en H. had een bijtwond aan zijn pink. In zijn huis werden bloedsporen van Tialda en Emy gevonden."
                            },
                            {
                                "example_id": "39c34474-e901-4903-bd56-375798974cb8",
                                "sense_id": "f34a1f8d-7931-3851-a2cd-775b6b45441b",
                                "text": "Een man die nabij het Spaanse Alicante in zee aan het zwemmen was, is gisteren in zijn hand gebeten door een haai. De 40-jarige Spanjaard werd met een fikse bijtwond in zijn hand naar het ziekenhuis gebracht."
                            }
                        ]
                    }
