                                "example_id": "1ce96f7b-5679-46b3-b3a1-33c78e2fe8b3",
                                "sense_id": "a364059f-97b4-30ca-b3c2-35fe6534eedb",
                                "text": "„Seit fünf Jahren bin ich Gartenbesitzerin, das macht viel Freude – und einige Arbeit.“"
                            },
                            {
                                "example_id": "2b0b57c3-68fb-436b-926b-bf299db72fdf",
                                "sense_id": "a364059f-97b4-30ca-b3c2-35fe6534eedb",
                                "text": "„Wer momentan durch Vorstädte spaziert, wird bemerken, dass in den Gärten nichts so schnell sprießt wie die Liebe der Gartenbesitzerinnen und Gartenbesitzer zum Sichtschutzzaun. “"
                            }
