        "nl-extract.jsonl": [
            {
                "entry_id": "8252614e-292c-3ccc-b83d-6efa4b272889",
                "word": "volheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                        "entry_id": "8252614e-292c-3ccc-b83d-6efa4b272889",
                        "glosses": [
                            "het helemaal gevuld zijn zonder dat er iets ontbreekt; het helemaal perfect zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3012c9d-02eb-4db3-adc0-e3d5067ec945",
                                "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                                "text": "Donker, somber. Zo zag de kerk van Zwillbrock eruit toen Edgar Jetter haar in 1958 voor het eerst betrad. Maar onder de lagen bruine verf vond hij de kleurrijke barokke kerk terug, die in 1748 was ingewijd. „Inmiddels spiegelt hier de volheid van de hemel weer op aarde neer.\""
                            },
                            {
                                "example_id": "67ed0225-61ca-4a27-a165-3ede8f5d74cc",
                                "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                                "text": "Die volheid van het leven is mooi. Tegelijk merk ik dat het goed is om soms met een boeddhistische bril naar het leven te kijken. Wat Boeddha 2500 jaar geleden zei, kan nu nog een enorme inspiratiebron zijn.\""
                            },
                            {
                                "example_id": "7bf9eb14-d4f8-4adf-8e4c-4ab572d84dab",
                                "sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                                "text": "‘Al wie heeft geleefd, weet dat de volheid van het leven niet alleen uit feest maar ook uit kwetsuren bestaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b0ccd2f-baa5-43ce-9bb9-4e6c9aea33b9",
                        "source_entry_id": "8252614e-292c-3ccc-b83d-6efa4b272889",
                        "source_sense_id": "161068ab-52ca-3144-8fb8-f276c243e671",
                        "target_lang_word": "plenitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plenitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0d194ca-c378-3f9a-ab0e-ec9636d8d858",
                                        "entry_id": "b8c181b6-7226-3507-91cf-0b7439af9a85",
                                        "glosses": [
                                            "Fullness; completeness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b65c529-1990-410c-8049-a0dc7d96f9a4",
                                                "sense_id": "d0d194ca-c378-3f9a-ab0e-ec9636d8d858",
                                                "text": "The idea that the love of Philimore had abated, when hers for him seemed in its plenitude, was a most severe aggravation of her misfortune."
                                            },
                                            {
                                                "example_id": "9f93797e-dc3e-4907-92cd-198e47b2d42d",
                                                "sense_id": "d0d194ca-c378-3f9a-ab0e-ec9636d8d858",
                                                "text": "Louis ignored him, recalling the parlements to the plenitude of their powers on 23 September."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1007fa02-ab57-3bd4-83c3-939c1632896c",
                                        "entry_id": "b8c181b6-7226-3507-91cf-0b7439af9a85",
                                        "glosses": [
                                            "Fullness (of the moon)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aab191f-5601-3fb1-bc0d-196d95e8ea2a",
                                        "entry_id": "b8c181b6-7226-3507-91cf-0b7439af9a85",
                                        "glosses": [
                                            "An abundance; a full supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d82893-6870-4cf9-8618-425eef2b71f1",
                                                "sense_id": "5aab191f-5601-3fb1-bc0d-196d95e8ea2a",
                                                "text": "Mankind's old greatness was created in scarcity. But what may we expect from plenitude?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c74c5b38-81eb-3260-a7d7-17757e342c95",
                                        "entry_id": "b8c181b6-7226-3507-91cf-0b7439af9a85",
                                        "glosses": [
                                            "The metaphysical idea that the universe contains everything that is possible."
                                        ],
                                        "tags": [
