                "senses": [
                    {
                        "sense_id": "42557916-d4e0-3b75-bc1e-5fc016b42778",
                        "entry_id": "947e8d88-efc5-31e2-a91b-55bf62455158",
                        "glosses": [
                            "gefärbtes Haarbüschel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ef1069-ac06-41c8-b679-1858ea729c40",
                                "sense_id": "42557916-d4e0-3b75-bc1e-5fc016b42778",
                                "text": "„Der Frontmann der Coverband ‚Die 3‘ sieht Rainhard Fendrich bis auf den Selbstbräuner und die blondierten Mèchen zum Verwechseln ähnlich.“"
                            },
                            {
                                "example_id": "e5e27996-1456-4109-ac00-a7ea64a426ad",
                                "sense_id": "42557916-d4e0-3b75-bc1e-5fc016b42778",
                                "text": "„Struwwelperücke mit blonden Mèchen, apricotfarbenes 80er-Jahre-Sakko, Dreitagebart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd1701d8-fbfa-41da-98e4-c396ada57a69",
                        "source_entry_id": "947e8d88-efc5-31e2-a91b-55bf62455158",
                        "source_sense_id": "42557916-d4e0-3b75-bc1e-5fc016b42778",
                        "source_sense_description": "gefärbtes Haarbüschel",
                        "target_lang_word": "mèche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c8ffefe-16a8-3c45-84d3-020d7b134ecc",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Assemblage de fils de coton, de chanvre, etc., qu’on utilise pour l’éclairage dans les lampes à huile, à pétrole, à essence, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddea2857-67aa-448e-b9f0-0d6958d8e7f2",
                                                "sense_id": "0c8ffefe-16a8-3c45-84d3-020d7b134ecc",
                                                "text": "Le « castelet » est aussi très employé, […]. C’est une boîte cubique en fer-blanc à double fond ; celui-ci est rempli d’eau chauffée par une lampe à huile à trois fines mèches de coton […]."
                                            },
                                            {
                                                "example_id": "f63d59e5-d189-4065-83c7-593e1a7fd5ab",
                                                "sense_id": "0c8ffefe-16a8-3c45-84d3-020d7b134ecc",
                                                "text": "Sur la table, que la lampe de la suspension illuminait à toute mèche, les pièces démontées du fusil de mon père s’étalaient autour d’une soucoupe pleine d’huile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4709ccaf-27dc-3d03-b5ae-017b8141066c",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Assemblage de fils tordus que l’on enduit de suif pour faire des chandelles ou que l’on recouvre de cire ou de stéarine pour faire des cierges ou des bougies."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bb6e27e-2f63-4e2e-8018-6718d5af713c",
                                                "sense_id": "4709ccaf-27dc-3d03-b5ae-017b8141066c",
                                                "text": "La flamme se communiqua aussitôt de la mèche au papier, qui en un instant fut consumé ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27a097a7-6751-3382-8551-7ef086be945a",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Assemblage de fils de coton tordus et imprégnés de benzine ou d’essence qu’on enflamme au moyen d’une étincelle produite par une pierre spéciale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa7d513c-ce64-482c-a73e-c7fffe2b5abf",
                                                "sense_id": "27a097a7-6751-3382-8551-7ef086be945a",
                                                "text": "Remonte, remonte, cria la jeune femme ; je vois reluire des épées, je vois briller la mèche d’une arquebuse. C’est un guet-apens."
                                            },
                                            {
                                                "example_id": "fb86c854-8318-4878-b959-b1af6923e971",
                                                "sense_id": "27a097a7-6751-3382-8551-7ef086be945a",
                                                "text": "Mèche de briquet."
                                            },
                                            {
                                                "example_id": "ee0c567d-6f44-4a72-9e73-cc20d1ef1f09",
                                                "sense_id": "27a097a7-6751-3382-8551-7ef086be945a",
                                                "text": "– Regarde, dit-il à Fred en lui montrant la partie de l’amadouvier qui avait adhéré à l’arbre ; regarde ce tissu fauve et fibreux qui remplit l’intérieur du champignon : c’est l’amadou. On le coupait dans le temps en lanières pour en faire la meilleure des mèches à briquet, au temps où celui-ci était fait d’un silex et d’un morceau de fer."
                                            },
                                            {
                                                "example_id": "c7a5ce1c-3cbd-4371-a4eb-2282c55760b0",
                                                "sense_id": "27a097a7-6751-3382-8551-7ef086be945a",
                                                "text": "La boîte contenait quatre paquets de tabac gris, plusieurs carnets de feuilles à cigarettes, des mèches à briquet ainsi que trois petits tubes de pierres, et une autre boîte plus petite en carton bleu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82bb31c3-ce1c-3af0-9184-5ca48f984680",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Sorte de tresse plate trempée dans du soufre et qu’on introduit enflammée dans les tonneaux pour leur enlever toute mauvaise odeur."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6ac82f-371e-4e3c-9fbe-aa6d1ff580da",
                                                "sense_id": "82bb31c3-ce1c-3af0-9184-5ca48f984680",
                                                "text": "Si donc, dans ces conditions, on veut mécher le tonneau, celui-ci ne contenant plus assez d’oxygène dans l'air qu'il renferme, ne pourra entretenir la combustion du soufre, et la mèche s’éteindra dès qu'elle sera introduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1be6b3ad-8558-3d4c-83bb-a4d7391ecccc",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Corde faite d’étoupe broyée et sèche, dont les soldats du génie, les mineurs, les carriers se servaient pour mettre le feu à un explosif."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa92d49a-9e48-4eca-aae2-b888e1b24eae",
                                                "sense_id": "1be6b3ad-8558-3d4c-83bb-a4d7391ecccc",
                                                "text": "Il y planta une mèche dont le jeune homme évalua la longueur à trois mètres, de telle sorte que celle-ci, une fois allumée, communiquât le feu au tas de poudre d’abord, à la barrique tout entière ensuite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf6564e4-9795-31df-8beb-5a983edd26c7",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Chose, dessein qui est dissimulé ou secret."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9dd84c7-265e-4f28-97c1-87713259e4b5",
                                                "sense_id": "bf6564e4-9795-31df-8beb-5a983edd26c7",
                                                "text": "Oui, il n’y plus a dissimuler, la mèche est éventée : un de mes amis de la commission des vingt-quatre me l’a affirmé, et il a vu les pièces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56112192-3dd3-32d3-8854-edc55c9e827a",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Petit rouleau de gaze stérilisée qu’on introduit dans une plaie pour faire séton"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2aadf5c3-a507-37a3-a224-92fc2f9c9cae",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Petit tube de caoutchouc stérilisé faisant le même office."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80510f7a-45e3-305b-94c1-943f75a8874b",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Bout de ficelle attaché à l’extrémité d’un fouet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f584d38-7462-4170-84e5-d50d2d3c2628",
                                                "sense_id": "80510f7a-45e3-305b-94c1-943f75a8874b",
                                                "text": "Le père Thomas est prêt, une mèche neuve a été lestement ajoutée à son fouet de malle ; il part faisant à son tour résonner l'air de ses clics-clacs les plus harmonieux."
                                            },
                                            {
                                                "example_id": "9d80eded-a026-4b07-8c55-c52979de6f02",
                                                "sense_id": "80510f7a-45e3-305b-94c1-943f75a8874b",
                                                "text": "Le cinglement d’une mèche de fouet à travers le cœur, peut-être?…"
                                            },
                                            {
                                                "example_id": "9d1b4155-387a-493c-acda-2db006558774",
                                                "sense_id": "80510f7a-45e3-305b-94c1-943f75a8874b",
                                                "text": "Dans le fouet, il y a le manche qui est un bâton sublimé par la lanière et par la mèche. Alors que le bâton écrase purement et simplement (arme « contondante »), la lanière embrasse. La lanière du fouet est un petit bras qui enveloppe de son étreinte le corps fouetté. Étreinte affectueuse, mais qui blesse jusqu’au sang. Comparer le fouet de Jésus et le baiser de Judas. Le claquement du fouet : la mèche n’a pas trouvé de corps à embrasser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641fb52b-2890-3fab-9d40-3e19cb2cd168",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Houppette d’un bonnet de coton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1212b7eb-86c5-4bfd-9a7e-bb8dd2357c56",
                                                "sense_id": "641fb52b-2890-3fab-9d40-3e19cb2cd168",
                                                "text": "Casque à mèche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "448ae33b-26a5-3a95-a816-f284e46e88c7",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Touffe de cheveux séparée, visuellement ou réellement, du reste de la chevelure."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e2f1cf6-b4d8-4568-83c4-b08e51878722",
                                                "sense_id": "448ae33b-26a5-3a95-a816-f284e46e88c7",
                                                "text": "Elles sont toutes là, soupeuses de Montmartre ou de la rue Royale, avec leurs aigrettes fausses ou vraies, et ces mèches canailles — appelez-les des tanguettes, car on ne dit plus des guiches — qui ne parviennent pas à enlaidir leurs délicieux visages à la pulpe de fleurs."
                                            },
                                            {
                                                "example_id": "2ee6a3a2-c7e2-4dac-bc43-96a4442c889f",
                                                "sense_id": "448ae33b-26a5-3a95-a816-f284e46e88c7",
                                                "text": "[…], il s’enlumina la trogne à la manière d’un clown ou plutôt d’un ivrogne, avant de rabattre sur son front une longue mèche de cheveux."
                                            },
                                            {
                                                "example_id": "932479f0-1016-4e75-a522-5fab6c9b930c",
                                                "sense_id": "448ae33b-26a5-3a95-a816-f284e46e88c7",
                                                "text": "Sa tenue noire assortie à ses mèches ébouriffées lui conférait toujours cette allure rock’n’roll dépassée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a17e82e-e1cf-3818-8d10-dfc936c3867d",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Touffe de filaments en vrac qui n’est pas tressé ou filé. On l'utilise, entre autres, pour faire une souris, soit : une \\\"petite poupée\\\", qui sert à appliquer le vernis au tampon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ea5a5c6-70f8-3b0f-b6dd-c6201e89fd4c",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Crin utilisé dans un archet pour frotter les cordes de certains instruments de musique."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aaf2bf9f-5b71-3cb1-8cb2-32d7da9e135f",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Outil de fer ou d’acier de certains outils servant à percer, perforer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "675e9fcd-6605-4413-a605-05400adcbbf6",
                                                "sense_id": "aaf2bf9f-5b71-3cb1-8cb2-32d7da9e135f",
                                                "text": "La mèche d’un tire-bouchon, d’un vilebrequin."
                                            },
                                            {
                                                "example_id": "86219643-9cdc-4667-8dbc-9a994e3661d8",
                                                "sense_id": "aaf2bf9f-5b71-3cb1-8cb2-32d7da9e135f",
                                                "text": "Il savait bien que plus jamais ces rabots, ces ciseaux à bois, ces burins ou ces mèches ne lui serviraient à rien, mais il continuait de les soigner comme il avait toujours fait, par habitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b84ccb2-4f7d-3d31-8a8e-1a791fca38b7",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Axe plus ou moins vertical du gouvernail d'un navire"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58ef1cd-9816-48f1-bad0-0d034c4eff49",
                                                "sense_id": "2b84ccb2-4f7d-3d31-8a8e-1a791fca38b7",
                                                "text": "Le gouvernail est constitué d’une surface plane, appelée safran, solidaire d’un axe plus ou moins vertical, la mèche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68182403-67a7-33cd-8477-9cd4cd0f8491",
                                        "entry_id": "47208d25-63ac-376f-9681-f72acf3db082",
                                        "glosses": [
                                            "Cigarette de cannabis ; joint."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f36fd0a4-943e-31ce-8104-27b9273c750f",
                                        "entry_id": "9d9876ef-d91d-3775-bfc6-d91e681af25d",
                                        "glosses": [
                                            "La morve qui coule du nez."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "165198e4-e58c-422c-b6fa-2fd7c06b11eb",
                                                "sense_id": "f36fd0a4-943e-31ce-8104-27b9273c750f",
                                                "text": "Maîtresse, j’ai la mèche, je peux prendre un mouchoir ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37ce9d67-ba76-3277-9301-07bca6c7c16e",
                                        "entry_id": "8f1954a3-0a9c-3e91-82fa-ee6f93b27ffa",
                                        "glosses": [
                                            "Le demi, la moitié d’une chose, d’une heure, d’une somme dans l’argot des voleurs."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66e44770-5435-4827-96f1-8cf7ce21ea84",
                                                "sense_id": "37ce9d67-ba76-3277-9301-07bca6c7c16e",
                                                "text": "— Quel blot, qu’on raque le papelard ?\n— Laranque et mèche, pour solir un rond, ça fait la culbute quoi."
                                            },
                                            {
                                                "example_id": "96aba259-a32d-4438-b954-64a3d46df294",
                                                "sense_id": "37ce9d67-ba76-3277-9301-07bca6c7c16e",
                                                "text": "— Qu'est-ce que t'affure sur ton bobino ?\n— Mèche et méchillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "928682cc-07cd-3040-b1ed-f0cec7e98efa",
                                        "entry_id": "8f1954a3-0a9c-3e91-82fa-ee6f93b27ffa",
                                        "glosses": [
                                            "Une demi-heure, et demi."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially",
                                            "slang"
                                        ],
                                        "note": "Une erreur dans un dictionnaire lui attribue le sens de quart, voir la note plus bas",
                                        "examples": [
                                            {
                                                "example_id": "d74afa44-dcb9-48d7-a421-f50c91769eb4",
                                                "sense_id": "928682cc-07cd-3040-b1ed-f0cec7e98efa",
                                                "text": "— Une plombe et mèche de poireau ! Pas un laune alentoire… j’vois qu’tringle comme pante, et la neuille qui s’débine !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a1d4a8-7367-35de-8b0d-67623d62a0e2",
                                        "entry_id": "8f1954a3-0a9c-3e91-82fa-ee6f93b27ffa",
                                        "glosses": [
                                            "Un moyen, une possibilité, une manière de faire quelque chose afin d’obtenir un résultat dans l’argot des voleurs."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ceceec-f46a-4d55-8e87-7f2e6fb080b0",
                                                "sense_id": "f8a1d4a8-7367-35de-8b0d-67623d62a0e2",
                                                "text": "Nib ! Y a pas mèche."
                                            },
                                            {
                                                "example_id": "166b3534-ac73-4b20-bdbe-4361552189d8",
                                                "sense_id": "f8a1d4a8-7367-35de-8b0d-67623d62a0e2",
                                                "text": "Gy, il y a mèche."
                                            },
                                            {
                                                "example_id": "5842de98-7919-4a0d-80e1-c71da9aadbe4",
                                                "sense_id": "f8a1d4a8-7367-35de-8b0d-67623d62a0e2",
                                                "text": "« Ça sent bon, ça vous prend à la tête, ça vous coupe la respiration, ça vous fait des chatouilles, et pas mèche de savoir avec quoi c’est fait, c’en est sorcier, c’est de la rouerie, c’est du miracle (éclatant tout à fait de rire) : c’en est malhonnête ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac92ef2-5ac6-3084-ad57-068c4e7b7ca3",
                                        "entry_id": "8f1954a3-0a9c-3e91-82fa-ee6f93b27ffa",
                                        "glosses": [
                                            "Un travail, de l’ouvrage."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
