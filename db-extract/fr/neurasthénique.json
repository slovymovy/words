        "fr-extract.jsonl": [
            {
                "entry_id": "9123c137-4b37-31de-a69d-9091dcfa3ba8",
                "word": "neurasthénique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ff3a7ddc-1367-4503-b285-485c060bce63",
                        "entry_id": "9123c137-4b37-31de-a69d-9091dcfa3ba8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "neurasthéniques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "130ae89a-3dea-3400-8a7a-f72cd107579e",
                        "entry_id": "9123c137-4b37-31de-a69d-9091dcfa3ba8",
                        "glosses": [
                            "Qui est atteint de neurasthénie, qui a rapport à la neurasthénie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b003412-eade-43d5-aa84-1d06498af151",
                                "sense_id": "130ae89a-3dea-3400-8a7a-f72cd107579e",
                                "text": "Parlant de je ne sais plus quel neurasthénique qui lui exposait sa petite affaire : « Je lui ai dit : vous êtes dans la situation d’un homme assis dans la m… et au-dessus duquel luit l’éclair d’un sabre : plonger ou avoir le col coupé. » La consolation, on le voit, était maigre."
                            },
                            {
                                "example_id": "e62a6990-c849-466c-a71c-db4c2c32af0e",
                                "sense_id": "130ae89a-3dea-3400-8a7a-f72cd107579e",
                                "text": "Milko passait pour un drôle de corps qui rendait sa femme, Cecylia, neurasthénique avec sa manie de toujours prêcher et de critiquer sans cesse le comportement de celui-ci ou de celui-là."
                            },
                            {
                                "example_id": "ed965624-b98d-4632-a0c7-2f064e729b78",
                                "sense_id": "130ae89a-3dea-3400-8a7a-f72cd107579e",
                                "text": "J'ai appris à travailler comme une souris, sans faire le moindre bruit, car la directrice, de plus en plus neurasthénique, ne tolérait ni le frottement d'un balai contre le sol, ni le froissement d'une guenille sur un meuble."
                            }
                        ]
                    },
                    {
                        "sense_id": "53a72ebd-33de-3a07-813f-d50c91ac41e6",
                        "entry_id": "9123c137-4b37-31de-a69d-9091dcfa3ba8",
                        "glosses": [
                            "Fatiguant, triste."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d2d7c8aa-1de8-4fd7-9792-252277e19b3c",
                                "sense_id": "53a72ebd-33de-3a07-813f-d50c91ac41e6",
                                "text": "D’un succès historique pour les droits civils, Jeff Nichols tire un film paradoxalement neurasthénique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbd6f444-277f-4ff4-9f23-ea827c4557b6",
                        "source_entry_id": "9123c137-4b37-31de-a69d-9091dcfa3ba8",
