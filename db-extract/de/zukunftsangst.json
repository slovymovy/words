                "senses": [
                    {
                        "sense_id": "73c6567b-844e-3242-96e6-3c86b38bb01c",
                        "entry_id": "55ad84cf-38b5-3d7c-b799-802d0a7db7ef",
                        "glosses": [
                            "Befürchtung, in Zukunft könnten negative Entwicklungen eintreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bcab320-8edb-4337-b942-22fddab635ed",
                                "sense_id": "73c6567b-844e-3242-96e6-3c86b38bb01c",
                                "text": "„Diese Zukunftsangst ist die eigentliche Leitkultur der Deutschen, sagt Gauck, und zu allem Überfluss haben es sich die Medien zur Aufgabe gemacht, diese Kultur zu verstärken.“"
                            },
                            {
                                "example_id": "79a8c0ca-605d-45da-b6ac-2e15961c2247",
                                "sense_id": "73c6567b-844e-3242-96e6-3c86b38bb01c",
                                "text": "„In diesem Klostergut, umgeben von Ruinen und obdachlosen Halberstädtern, verbrachte die Familie voller Zukunftsängste, aber glücklich vereint die nächsten Wochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
