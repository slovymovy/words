                        ],
                        "form": "die Fürstin"
                    },
                    {
                        "form_id": "c3d3982c-b8a6-4655-ac30-8aa4478269dd",
                        "entry_id": "c5d3db15-1008-3fac-8324-5e6217c989ad",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fürstinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71964503-b1c7-32ee-abf1-364a01054afe",
                        "entry_id": "c5d3db15-1008-3fac-8324-5e6217c989ad",
                        "glosses": [
                            "hohe Adlige im Rang zwischen Gräfin und Herzogin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b79f0bfb-41ee-4a77-9930-6e6254831f76",
                                "sense_id": "71964503-b1c7-32ee-abf1-364a01054afe",
                                "text": "Die Fürstin ließ einen prächtigen Garten hinter ihrem Haus errichten."
                            },
                            {
                                "example_id": "548241bc-e94c-4a14-af9f-994df5e69cdd",
                                "sense_id": "71964503-b1c7-32ee-abf1-364a01054afe",
                                "text": "„Die Fürstin verfolgte jetzt eine ihrer Lieblingsideen, nämlich die Attraktivität des Besitzes durch die Errichtung eines Moor- und Mineralbades zu erhöhen.“"
                            },
                            {
                                "example_id": "764fd571-6492-48c7-a5a5-29dd2db9bb82",
                                "sense_id": "71964503-b1c7-32ee-abf1-364a01054afe",
                                "text": "„Umso kurioser ist es, dass die ersten vier Staatsoberhäupter Fürstinnen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42248aa5-c046-33da-95cb-ffb95026b070",
                        "entry_id": "c5d3db15-1008-3fac-8324-5e6217c989ad",
                        "glosses": [
                            "Frau eines Fürsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfcf946a-ccda-497b-8026-1ba211e68d0d",
                                "sense_id": "42248aa5-c046-33da-95cb-ffb95026b070",
                                "text": "Samuel ist der Sohn einer Fürstin, die arm geboren wurde und später einen reichen Adligen heiratete."
                            },
                            {
                                "example_id": "adc9c084-7f4e-4d0e-9290-92f74d82107a",
                                "sense_id": "42248aa5-c046-33da-95cb-ffb95026b070",
                                "text": "„Die kleine Fürstin war in der letzten Zeit stark geworden, aber ihre Augen und ihre kurze Oberlippe mit den Schnurrbarthärchen, die sich beim Sprechen in die Höhe zog, sahen noch genau so lustig und niedlich aus wie früher.“"
                            },
                            {
                                "example_id": "9235ed50-ff93-4aa1-9c1f-84faaec82645",
                                "sense_id": "42248aa5-c046-33da-95cb-ffb95026b070",
                                "text": "„Die Fürstin, eine begeisterte Musikliebhaberin, umarmte Farinello und sagte ihm, nun könne sie endlich zufrieden sterben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
