                "senses": [
                    {
                        "sense_id": "5f50f467-4539-3b9a-a2d4-46e3f137f484",
                        "entry_id": "d13e9cee-1e58-32bd-8be8-3d4f13660f61",
                        "glosses": [
                            "To live, reside, stay."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a42b0667-7f2e-40ee-a1e8-b542bc243b3c",
                                "sense_id": "5f50f467-4539-3b9a-a2d4-46e3f137f484",
                                "text": "This I make thi wonnyng playce, / ffull of myrth and of solace",
                                "translation": "This I make thy dwelling place, full of mirth and solace",
                                "english": "This I make thy dwelling place, full of mirth and solace"
                            },
                            {
                                "example_id": "55b56fb8-c279-4fc9-b34d-90554ec7067d",
                                "sense_id": "5f50f467-4539-3b9a-a2d4-46e3f137f484",
                                "text": "For now the best and noblest knight alive\nPrince Arthur is, that wonnes in Faerie Lond;\nHe hath a sword, that flames like burning brond."
                            },
                            {
                                "example_id": "2bb5ace3-9555-415d-8156-c80602835468",
                                "sense_id": "5f50f467-4539-3b9a-a2d4-46e3f137f484",
                                "text": "Then we entered the city and found all who therein woned into black stones enstoned[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa270f89-f2b4-45b0-b9ec-4ad10b19e560",
                        "source_entry_id": "d13e9cee-1e58-32bd-8be8-3d4f13660f61",
                        "source_sense_id": "5f50f467-4539-3b9a-a2d4-46e3f137f484",
                        "source_sense_description": "to live, reside, stay",
                        "target_lang_word": "wonen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wonen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "114a134b-1f47-3bb8-8b8a-ed4ba6e95a47",
                                        "entry_id": "5cffbc6f-7116-3050-8fe4-4d1d7285d565",
                                        "glosses": [
                                            "een permanente behuizing hebben"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd029d07-0843-4246-b305-6feba55675c6",
                                                "sense_id": "114a134b-1f47-3bb8-8b8a-ed4ba6e95a47",
                                                "text": "In ons werkgebied wonen ongeveer 200.000 mensen."
                                            },
                                            {
                                                "example_id": "25046dd7-ae5b-4e85-87a1-efafe782919a",
                                                "sense_id": "114a134b-1f47-3bb8-8b8a-ed4ba6e95a47",
                                                "text": "Wonen op drie meter onder zeeniveau (NAP) is heel wat anders dan lopen op duizend meter boven de zeespiegel."
                                            },
                                            {
                                                "example_id": "f8ca4c4d-37cd-47f1-97e4-1a63b1638078",
                                                "sense_id": "114a134b-1f47-3bb8-8b8a-ed4ba6e95a47",
                                                "text": "De zelf omgebouwde camper waar hij in woonde was van alle gemakken voorzien, maar hij was minder dan 800 euro per jaar kwijt aan vaste lasten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2818a2df-482b-4e43-bdc8-006205a2cdca",
                        "source_entry_id": "d13e9cee-1e58-32bd-8be8-3d4f13660f61",
                        "source_sense_id": "5f50f467-4539-3b9a-a2d4-46e3f137f484",
                        "source_sense_description": "to live, reside, stay",
                        "target_lang_word": "wohnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wohnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b0f83a4-0829-3819-bd3d-98be7e472140",
                                        "entry_id": "9fe03605-e7c8-3aa6-b16e-3ddc5906ed7d",
                                        "glosses": [
                                            "wesentliche Zeit seines Lebens an einem bestimmten, geschützten Ort verbringen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b08d86f-67f3-4f8a-9a44-e9c111b26d2e",
                                                "sense_id": "3b0f83a4-0829-3819-bd3d-98be7e472140",
                                                "text": "Obwohl sie seit Jahren Tür an Tür wohnen, kennen sie sich gar nicht."
                                            },
                                            {
                                                "example_id": "ac2c9109-9721-4f3a-88c9-ea7358d62b4e",
                                                "sense_id": "3b0f83a4-0829-3819-bd3d-98be7e472140",
                                                "text": "Meine Schwester wohnt noch bei unseren Eltern, ich dagegen in einer WG."
                                            },
                                            {
                                                "example_id": "c3b1a30e-b2dc-4074-ac5a-6dc3d1628e09",
                                                "sense_id": "3b0f83a4-0829-3819-bd3d-98be7e472140",
                                                "text": "Er wohnt in der Stadt und sein Bruder auf dem Land."
                                            },
                                            {
                                                "example_id": "d99fa8aa-8945-43dc-ba5e-bbb900f39b16",
                                                "sense_id": "3b0f83a4-0829-3819-bd3d-98be7e472140",
                                                "text": "Wo wohnst du?"
                                            },
                                            {
                                                "example_id": "b21ab302-dcb6-4dca-abd9-3ae2d2970c35",
                                                "sense_id": "3b0f83a4-0829-3819-bd3d-98be7e472140",
                                                "text": "Mein Cousin wohnt nur fünf Minuten von der Universität entfernt."
                                            },
                                            {
                                                "example_id": "a8bbd882-2d81-418a-9812-e9849528782e",
                                                "sense_id": "3b0f83a4-0829-3819-bd3d-98be7e472140",
                                                "text": "„Roland hatte mir zugeflüstert, auf den Färöern wohnten jene, die die Wikingerschiffe wegen Seekrankheit verlassen mussten, als sie auf dem Weg nach Island waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fd989ea-d2cb-34af-8b2b-092101721a30",
                                        "entry_id": "9fe03605-e7c8-3aa6-b16e-3ddc5906ed7d",
                                        "glosses": [
                                            "zeitweilig eine Unterkunft haben, vorübergehend untergebracht sein"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28294fa4-6106-4e47-97a7-4f22f40f7858",
                                                "sense_id": "3fd989ea-d2cb-34af-8b2b-092101721a30",
                                                "text": "Im Urlaub wohnen wir in einem Hotel."
                                            },
                                            {
                                                "example_id": "94e61c8e-643b-400d-8be0-4ad67f865764",
                                                "sense_id": "3fd989ea-d2cb-34af-8b2b-092101721a30",
                                                "text": "Das Ferienhaus, in dem wir gewohnt haben, war sehr schön."
                                            },
                                            {
                                                "example_id": "33cad917-6aaf-4d90-ba2c-d7d7eb60d2e5",
                                                "sense_id": "3fd989ea-d2cb-34af-8b2b-092101721a30",
                                                "text": "Bis er eine neue Wohnung gefunden hat, wohnt er bei Freunden."
                                            },
                                            {
                                                "example_id": "40b6d7db-e354-476b-a573-56b2ad22dd1c",
                                                "sense_id": "3fd989ea-d2cb-34af-8b2b-092101721a30",
                                                "text": "Wenn wir in Hamburg sind, wohnen wir bei unserem Onkel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
