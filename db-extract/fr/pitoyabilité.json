                        "entry_id": "3a2d7233-9239-34b6-b918-ed9e9b1af2c1",
                        "glosses": [
                            "État de celle ou de celui qui inspire la pitié."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9d6634a7-153a-45f3-809e-85eeb408bc16",
                                "sense_id": "2d5a6f68-e757-3f61-a2e7-387aa80465cd",
                                "text": "Celui-ci est un miséreux, certes, mais un comédien pour la majeure partie des cas, il se met en scène et joue de sa pitoyabilité pour attendrir le chaland."
                            }
                        ]
                    },
                    {
                        "sense_id": "93d9f036-1842-3e8e-829e-2a454d8f0b76",
                        "entry_id": "3a2d7233-9239-34b6-b918-ed9e9b1af2c1",
                        "glosses": [
                            "État de celui qui est inspiré par la pitié."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6a1d79c2-63e8-4a3c-a9fc-8cae6186ca22",
                                "sense_id": "93d9f036-1842-3e8e-829e-2a454d8f0b76",
                                "text": "Toute pitoyabilité n’est pas morte, cependant; toute solidarité n’est pas étouffée dans la loi brahmanique. L’Aryen transformé n’a point perdu entièrement l’âme védique."
                            }
                        ]
                    }
