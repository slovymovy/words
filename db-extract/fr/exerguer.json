                "senses": [
                    {
                        "sense_id": "f569eacb-f08b-39ac-87b4-374ab15866de",
                        "entry_id": "bf6a91d5-69b4-3e54-8301-f33fceb9ed97",
                        "glosses": [
                            "Mettre en exergue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4646d593-9b6c-46df-9ad7-76609f263462",
                                "sense_id": "f569eacb-f08b-39ac-87b4-374ab15866de",
                                "text": "Il est d'autre part important de savoir quels sont les process qu'il faudra exerguer afin de maintenir un cap économique cohérent !"
                            },
                            {
                                "example_id": "3c31bc29-54fd-4d16-bb50-8795c9d84c49",
                                "sense_id": "f569eacb-f08b-39ac-87b4-374ab15866de",
                                "text": "[…] et qui soupirez avec grand désarroi en vous demandant bien quel beau costume vais-je pouvoir enfiler. \"Peut-être qu'un haut bleu mettra en valeur mon œil gauche et qu'un bas marron exerguera mon œil droit ? Mais que vais-je faire???\""
                            },
                            {
                                "example_id": "7f65c8ef-f1d7-4724-9028-ed3f564143e1",
                                "sense_id": "f569eacb-f08b-39ac-87b4-374ab15866de",
                                "text": "Alors ce soir j'étrenne mon beau maillot tout neuf de la Roja ce soir. Histoire de me fondre, de devenir chilien (qui a dit que le foot exerguait les haines ? c'est aussi un moyen d'intégration incroyable)."
                            }
                        ]
                    }
                ],
