                ],
                "senses": [
                    {
                        "sense_id": "e9482658-f2ce-3041-bffb-846b38aa2f76",
                        "entry_id": "114b7cc7-3010-38ad-b6f7-a5ed917d525a",
                        "glosses": [
                            "Serrer, compresser, courbaturer."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "b947f6b3-4b1b-4a7f-b28d-d6d615f084c4",
                                "sense_id": "e9482658-f2ce-3041-bffb-846b38aa2f76",
                                "text": "OGCN la reine des chaussettes ... tu ne vas pas te laisser estranssiner par un châle non mais"
                            },
                            {
                                "example_id": "acadbee2-811e-4451-9542-125967454e58",
                                "sense_id": "e9482658-f2ce-3041-bffb-846b38aa2f76",
                                "text": "Allez Jean Jacques, ne nous fais plus languir qu’on est en train de s’estranssiner"
                            },
                            {
                                "example_id": "486e3275-cc85-438c-931c-bab764412f6b",
                                "sense_id": "e9482658-f2ce-3041-bffb-846b38aa2f76",
                                "text": "Pleure pas Fanny, pas la peine de t’estranssiner !"
                            },
                            {
                                "example_id": "eb2de8b7-5ae6-4c22-96c2-f78067ea3f93",
                                "sense_id": "e9482658-f2ce-3041-bffb-846b38aa2f76",
                                "text": "Alors, ça s’escagasse, ça s’estranssine, et de tout sûr, ça s’espalouffit."
                            },
                            {
                                "example_id": "35aedeb2-bcfb-45df-aca6-3316c6c4bf92",
                                "sense_id": "e9482658-f2ce-3041-bffb-846b38aa2f76",
                                "text": "La douce, belle carinette\nm’embrasse comme de l’alcool\nme tâte le licou, le col\n me joue un air de clarinette\n Et dans mon cœur estranssiné\nchante un refrain assassiné"
                            }
                        ]
                    }
