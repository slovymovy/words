{
    "word_family": [
        "elimination",
        "eliminator",
        "eliminable",
        "ineliminable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "349dbc2e-1ebe-3a52-81af-a1f67c9cd6f7",
                    "sense_definition": "To completely remove, get rid of, or put an end to something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new air filtration system <w>eliminates</w> all smoke and odors from the room.",
                            "target_lang_translations": {
                                "ru": "Новая система фильтрации воздуха <w>устраняет</w> весь дым и запахи в помещении."
                            }
                        },
                        {
                            "text": "The company decided to <w>eliminate</w> waste by recycling all of its paper products.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>ликвидировать</w> отходы, перерабатывая все свои бумажные изделия."
                            }
                        }
                    ],
                    "synonyms": [
                        "remove",
                        "eradicate",
                        "abolish",
                        "get rid of"
                    ],
                    "antonyms": [
                        "create",
                        "add",
                        "retain"
                    ],
                    "common_phrases": [
                        "eliminate waste",
                        "eliminate the need",
                        "eliminate a problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью удалить, избавиться или положить конец чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устранять",
                                "target_lang_sense_clarification": "проблемы, препятствия, запахи"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "последствия, задолженность, безграмотность"
                            },
                            {
                                "target_lang_word": "искоренять",
                                "target_lang_sense_clarification": "недостатки, привычки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "178a57cd-14fa-335a-8f9e-26a89609b952",
                    "sense_definition": "To exclude someone or something from an investigation, competition, or further consideration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective was able to <w>eliminate</w> the neighbor as a suspect after checking his alibi.",
                            "target_lang_translations": {
                                "ru": "Детектив смог <w>исключить</w> соседа из числа подозреваемых после проверки его алиби."
                            }
                        },
                        {
                            "text": "Our team was <w>eliminated</w> from the tournament after losing the first match.",
                            "target_lang_translations": {
                                "ru": "Наша команда <w>выбыла</w> из турнира после поражения в первом матче."
                            }
                        }
                    ],
                    "synonyms": [
                        "exclude",
                        "rule out",
                        "knock out"
                    ],
                    "antonyms": [
                        "include",
                        "select"
                    ],
                    "common_phrases": [
                        "eliminate a suspect",
                        "eliminated from competition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключить кого-либо или что-либо из расследования, соревнования или дальнейшего рассмотрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "из списка подозреваемых или кандидатов"
                            },
                            {
                                "target_lang_word": "выбывать",
                                "target_lang_sense_clarification": "из соревнований или турнира"
                            },
                            {
                                "target_lang_word": "отсеивать",
                                "target_lang_sense_clarification": "неподходящие варианты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0532491b-ee60-36b5-8619-d9f2649c7cb3",
                    "sense_definition": "To kill a person or animal, often in a cold or systematic way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "killing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy was ordered to <w>eliminate</w> the target before they could share the secret.",
                            "target_lang_translations": {
                                "ru": "Шпиону приказали <w>ликвидировать</w> цель до того, как она успеет выдать секрет."
                            }
                        },
                        {
                            "text": "In the movie, the villain tries to <w>eliminate</w> his enemies one by one.",
                            "target_lang_translations": {
                                "ru": "В фильме злодей пытается <w>уничтожить</w> своих врагов одного за другим."
                            }
                        }
                    ],
                    "synonyms": [
                        "liquidate",
                        "neutralize",
                        "exterminate",
                        "assassinate"
                    ],
                    "common_phrases": [
                        "eliminate the target",
                        "eliminate the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убить человека или животное, часто хладнокровным или систематическим способом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "устранить физически"
                            },
                            {
                                "target_lang_word": "уничтожать",
                                "target_lang_sense_clarification": "врага или цель"
                            },
                            {
                                "target_lang_word": "устранять",
                                "target_lang_sense_clarification": "соперника или свидетеля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b9e43e0-25de-3643-81c1-ccb14425910e",
                    "sense_definition": "To destroy a facility or disable a soldier so they are unable to function or fight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air strike managed to <w>eliminate</w> the enemy's communication center.",
                            "target_lang_translations": {
                                "ru": "В результате авиаудара удалось <w>уничтожить</w> центр связи противника."
                            }
                        },
                        {
                            "text": "The sniper's mission was to <w>eliminate</w> the threat without being detected.",
                            "target_lang_translations": {
                                "ru": "Миссия снайпера заключалась в том, чтобы <w>нейтрализовать</w> угрозу, не будучи обнаруженным."
                            }
                        }
                    ],
                    "synonyms": [
                        "disable",
                        "neutralize",
                        "destroy"
                    ],
                    "common_phrases": [
                        "eliminate a threat",
                        "eliminate the battery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушить объект или вывести из строя солдата, чтобы они не могли функционировать или сражаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уничтожать",
                                "target_lang_sense_clarification": "военный объект или живую силу"
                            },
                            {
                                "target_lang_word": "нейтрализовать",
                                "target_lang_sense_clarification": "угрозу или противника"
                            },
                            {
                                "target_lang_word": "выводить из строя",
                                "target_lang_sense_clarification": "технику или персонал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8de15cd-79ed-3334-b485-d22f01276739",
                    "sense_definition": "To discharge or excrete waste products from the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kidneys help the body <w>eliminate</w> toxins through urine.",
                            "target_lang_translations": {
                                "ru": "Почки помогают организму <w>выводить</w> токсины через мочу."
                            }
                        },
                        {
                            "text": "The patient was having difficulty <w>eliminating</w> waste after the surgery.",
                            "target_lang_translations": {
                                "ru": "У пациента были трудности с <w>выведением</w> продуктов жизнедеятельности после операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "excrete",
                        "void",
                        "expel"
                    ],
                    "common_phrases": [
                        "eliminate waste",
                        "eliminate toxins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выводить продукты жизнедеятельности из организма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "токсины или шлаки из организма"
                            },
                            {
                                "target_lang_word": "удалять",
                                "target_lang_sense_clarification": "продукты распада"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "046bfd7c-3417-31fd-9930-e80310e5f3a7",
                    "sense_definition": "To remove the effects of inter-company transactions when preparing a consolidated financial statement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant must <w>eliminate</w> all internal sales to show the true revenue of the group.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер должен <w>элиминировать</w> все внутренние продажи, чтобы показать истинную выручку группы."
                            }
                        },
                        {
                            "text": "During consolidation, we <w>eliminate</w> inter-company debts to avoid double counting.",
                            "target_lang_translations": {
                                "ru": "При консолидации мы <w>исключаем</w> внутригрупповую задолженность, чтобы избежать двойного счета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eliminate inter-company transactions"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical accounting term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключать результаты внутригрупповых операций при подготовке консолидированной финансовой отчетности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элиминировать",
                                "target_lang_sense_clarification": "внутригрупповые обороты в бухгалтерии"
                            },
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "взаимные расчеты при консолидации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}