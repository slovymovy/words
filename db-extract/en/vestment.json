                    {
                        "sense_id": "936dbaff-ee14-3fcf-ac47-66f822e7469f",
                        "entry_id": "619857c8-e1ad-30e7-8d63-87f060f46306",
                        "glosses": [
                            "A robe, gown, or other article of clothing worn as an indication of office."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa6478a-a211-4770-b96d-78cc420c7042",
                                "sense_id": "936dbaff-ee14-3fcf-ac47-66f822e7469f",
                                "text": "The priest wore a white vestment during the ceremony."
                            },
                            {
                                "example_id": "c6233808-c1f7-48fa-81e9-3d305ed7c28d",
                                "sense_id": "936dbaff-ee14-3fcf-ac47-66f822e7469f",
                                "text": "Medieval paintings often depict bishops in ornate vestments."
                            }
                        ]
                    },
                    {
                        "sense_id": "394e4517-caff-3e8d-9150-f4d32b20d7d7",
                        "entry_id": "619857c8-e1ad-30e7-8d63-87f060f46306",
                        "glosses": [
                            "Any of the special articles of clothing worn by members of the clergy etc., especially a garment worn at the celebration of the Eucharist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7a1221-a55e-467e-b4b3-b73fc7a029ae",
