                                        "sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                                        "entry_id": "7444a631-9e56-3e78-9bf1-a149d8400052",
                                        "glosses": [
                                            "iemand die profiteert van andermans goedheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0525f25-9f1f-4142-bec6-783a0ac337d1",
                                                "sense_id": "1a367545-60b1-37b3-baa9-907dd920e7cd",
                                                "text": "Het was absoluut mijn beurt om Lena ergens voor uit te nodigen, het liefst de bioscoop, anders zou ik een soort klaploper bij haar thuis worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c68ec93-29ae-44d9-83cd-aeed5abd05a9",
                        "source_entry_id": "b35c4e38-cb3e-30b6-8e82-3de8b5850f70",
                        "source_sense_description": "one who sponges",
                        "target_lang_word": "Schnorrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnorrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                        "entry_id": "ebe4404a-166a-3814-a1a1-a366f2aa913a",
                                        "glosses": [
                                            "(männliche) Person, die wiederholt um Gefälligkeiten (zum Beispiel Zigaretten oder Snacks) bittet, ohne die Absicht zu haben, eine Gegenleistung zu erbringen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aca51b18-7651-4d51-ad64-c93ec5a29cfd",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Er war empört gewesen, daß der Bankier Roest ihn als Schnorrer und Nebbich empfangen hatte, aber er sah bald, daß er in dieser Stadt, die in einem Millionentaumel lebte, wirklich ein Nebbich war.“"
                                            },
                                            {
                                                "example_id": "78bfe3c7-aecd-4d6d-8796-22966b38b6de",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "Er hatte nicht viel für Schnorrer übrig, aber ihm gefiel es, wenn jemand sein Talent in der Öffentlichkeit präsentierte, und er fand, dass eine kleine Gage gerechtfertigt war."
                                            },
                                            {
                                                "example_id": "3aca782b-aff2-4cd2-b092-554be12d119c",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Die Schnorrer, das heißt die Bettler, die auf Kosten reicher Gönner lebten, waren fester Bestandteil des durch die jüdische Religion geprägten Selbstverständnisses.“"
                                            },
                                            {
                                                "example_id": "37f8bb00-ef8d-41e0-b935-14dfa059fae4",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Denn einerseits entpuppt sich der Sabbatgast, der seinen Schwiegersohn ungebeten an den Tisch setzt, zwar als ein Schnorrer; andererseits aber folgen alle Beteiligten hier nur dem Gebot: Der Hausherr erfüllt seine Gastgeberpflicht, der Sabbatgast erfüllt seinen Vertrag mit den Eltern des Schwiegersohns, und indem er den Vater seiner Frau begleitet, hält sich auch der Schwiegersohn nur an die Regeln der Tradition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd6a6378-2343-4d00-b67d-f282c065e88a",
