                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kiedyś</w> ludzie częściej pisali do siebie listy.",
                            "target_lang_translations": {
                                "ru": "<w>Раньше</w> люди чаще писали друг другу письма.",
                                "en": "<w>Once</w>, people wrote letters to each other more often.",
                                "nl": "<w>Vroeger</w> schreven mensen vaker brieven naar elkaar.",
                                "de": "<w>Früher</w> schrieben die Menschen sich häufiger Briefe.",
                                "fr": "<w>Autrefois</w>, les gens s'écrivaient des lettres plus souvent.",
                                "it": "<w>Un tempo</w> le persone si scrivevano lettere più spesso.",
                                "cs": "<w>Kdysi</w> si lidé častěji psali dopisy.",
                                "tr": "<w>Eskiden</w> insanlar birbirlerine daha sık mektup yazarlardı.",
                                "es": "<w>Antes</w>, la gente escribía cartas entre sí con más frecuencia.",
                                "zh": "<w>以前</w>人们更常互相写信。"
                            }
                        },
                        {
                            "text": "To było <w>kiedyś</w> bardzo spokojne miasto.",
                            "target_lang_translations": {
                                "ru": "Это был <w>когда-то</w> очень спокойный город.",
                                "en": "This was <w>once</w> a very quiet city.",
                                "nl": "Dit was <w>ooit</w> een erg rustige stad.",
                                "de": "Das war <w>damals</w> eine sehr ruhige Stadt.",
                                "fr": "C'était <w>autrefois</w> une ville très calme.",
                                "it": "Questa era <w>una volta</w> una città molto tranquilla.",
                                "cs": "To bylo <w>kdysi</w> velmi klidné město.",
                                "tr": "Burası <w>bir zamanlar</w> çok sakin bir şehirdi.",
                                "es": "Esta era <w>antiguamente</w> una ciudad muy tranquila.",
                                "zh": "这<w>曾经</w>是一座非常宁静的城市。"
                            }
