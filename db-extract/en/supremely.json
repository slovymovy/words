                                                "sense_id": "bac33be2-f55e-3828-b253-4a8b3d2749be",
                                                "text": "Volgens de waterschappen waren de waterstanden het hoogst sinds de watersnoodramp van 1953, waarbij ruim 1.800 mensen om het leven kwamen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoogst",
