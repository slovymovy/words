                        "entry_id": "d25a391a-3aea-33e5-ae13-cb6f5b673f2f",
                        "glosses": [
                            "Primate nocturne et arboricole d'Afrique tropicale aux gros yeux globuleux, de la famille des lorisidés."
                        ],
                        "tags": [
                            "Primatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2a093fc5-fc45-4171-aae4-da597b146ade",
                                "sense_id": "e529e01d-d566-36c1-9829-570b7cb92c28",
                                "text": "Le potto se nourrit surtout de feuilles et de fruits ; lézards, mollusques, œufs d'oiseaux et oisillons complètent son alimentation."
                            },
                            {
                                "example_id": "1e1df6a0-8f0e-4bbb-8398-e01727b0b830",
                                "sense_id": "e529e01d-d566-36c1-9829-570b7cb92c28",
                                "text": "Le potto, c’est bien connu, passe ses journées à dormir dans les arbres."
                            }
                        ]
                    }
