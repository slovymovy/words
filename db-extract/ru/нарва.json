                    },
                    {
                        "translation_id": "b3883b03-15a6-4ca0-95fa-463ce605eb53",
                        "source_entry_id": "7601bdf0-581b-39e0-b3ff-796d7a090d7d",
                        "source_sense_description": "город",
                        "target_lang_word": "Narva",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narva",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04f17679-0d7b-30ac-8e66-00a4925f723d",
                                        "entry_id": "1e30ed3c-a7ef-3615-b55f-07bdaed73a75",
                                        "glosses": [
                                            "Fleuve de 75 km constituant une partie de la frontière nord entre la Russie et l’Estonie."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6bae20c-1df8-48fb-ace7-a11f31fe9c4a",
                                                "sense_id": "04f17679-0d7b-30ac-8e66-00a4925f723d",
                                                "text": "NARVA, (Géog.) ou Nerva, riviere de Livonie. Elle sort du lac de Peipis, baigne la ville de Narva, à laquelle elle donne le nom ; & à deux lieues au-dessous elle va se jetter dans le golfe de Finlande. Cette riviere est presqu’aussi large que l’Elbe, mais beaucoup plus rapide ; & à demi-lieue au dessus de la ville, elle a un très grand saut qui fait qu’on est contraint de décharger dans cet endroit là toutes les marchandises que l’on envoie de Plescow & de Derpt à Narva."
                                            },
                                            {
                                                "example_id": "326ce704-fd22-4a3d-a8ed-077dcd3ab13e",
                                                "sense_id": "04f17679-0d7b-30ac-8e66-00a4925f723d",
                                                "text": "À la frontière entre l'Estonie et la Russie, le fleuve Narva et le lac Peipsi ont été menacés par des risques d'accident dans les mines et industries liées aux huiles de schiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f38c00de-5cce-3907-aff1-86d661395f1b",
                                        "entry_id": "1e30ed3c-a7ef-3615-b55f-07bdaed73a75",
                                        "glosses": [
                                            "Ville située sur ce fleuve, au nord-est de l’Estonie, dans la région de Virumaa, sur la frontière avec la Russie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "078fc504-5db6-4417-9c0d-6c2a6aa54c7e",
                                                "sense_id": "f38c00de-5cce-3907-aff1-86d661395f1b",
                                                "text": "Le czar, ayant quitté son armée devant Narva, sur la fin de novembre 1700, pour se concerter avec le roi de Pologne, apprit en chemin la victoire des Suédois."
                                            },
                                            {
                                                "example_id": "09c81ff9-bf26-482f-91f2-c9cad8ccd490",
                                                "sense_id": "f38c00de-5cce-3907-aff1-86d661395f1b",
                                                "text": "Ils s’établissaient dans presque toutes les villes de l’empire, à Pskof, Astrakhan, Kazan, les deux Novgorod, Narva, qui venait de tomber au pouvoir des Russes."
                                            },
                                            {
                                                "example_id": "a7adc615-4259-4e03-bc87-12d9dc397adc",
                                                "sense_id": "f38c00de-5cce-3907-aff1-86d661395f1b",
                                                "text": "Peuplée à plus de 90 % de russophones, Narva souffre d’une image à part en Estonie, comme une sorte d’enclave considérée avec méfiance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
