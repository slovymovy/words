                "senses": [
                    {
                        "sense_id": "dc18a839-7244-3954-9c53-e7452a9eac7b",
                        "entry_id": "a1132d9d-2288-3593-af9b-c0b2164a7650",
                        "glosses": [
                            "Donner un caractère sous-optimal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4735484-d37c-4762-a301-23d2f4fbdb88",
                                "sense_id": "dc18a839-7244-3954-9c53-e7452a9eac7b",
                                "text": "Cette modification sous-optimalise le système et le fait converger plus lentement."
                            },
                            {
                                "example_id": "320046ac-973a-4c7f-a9cf-266fd9d44d8d",
                                "sense_id": "dc18a839-7244-3954-9c53-e7452a9eac7b",
                                "text": "Ceci peut aussi sous-optimaliser les résultats, car d’autres questions de conformité fiscale, qui peuvent avoir une plus grande importance économique pour le pays, peuvent ne pas être identifiées ou traitées de manière adéquate (par ex., sous-capitalisation, déductions d’amortissements)."
                            },
                            {
                                "example_id": "40d4853c-9584-432d-9b3d-2367b54489b0",
                                "sense_id": "dc18a839-7244-3954-9c53-e7452a9eac7b",
                                "text": "Un point positif pour la productivité moyenne des investissements et de la production dans les entreprises concernées, mais qui risque de sous-optimaliser le volume total des investissements en Belgique."
                            }
                        ]
                    }
