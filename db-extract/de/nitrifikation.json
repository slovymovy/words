                ],
                "senses": [
                    {
                        "sense_id": "a5b85788-7490-3c02-9b1c-df8465ac16eb",
                        "entry_id": "1f18afe1-bb09-3a58-8dd7-7aaacfa3faa4",
                        "glosses": [
                            "Bildung von Salpeter durch Bodenbakterien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b12a99d-63a1-46e9-8dd5-5495820bfbbc",
                                "sense_id": "a5b85788-7490-3c02-9b1c-df8465ac16eb",
                                "text": "Die Nitrifikation in der Auflage ließ sich durch Ammonium- oder Peptonzugaben nicht steigern."
                            },
                            {
                                "example_id": "f5ec8e85-a05a-485a-9727-99a9d3508912",
                                "sense_id": "a5b85788-7490-3c02-9b1c-df8465ac16eb",
                                "text": "Phosphat-, Kalk- und Basenzugaben steigerten die Nitrifikation."
                            },
                            {
                                "example_id": "25150e92-fe19-494c-a281-cc36400b2363",
                                "sense_id": "a5b85788-7490-3c02-9b1c-df8465ac16eb",
                                "text": "Die Nitrifikation wird durch niedrige pH-Werte im Boden gehemmt, optimal ist ein pH von 6-8."
                            },
                            {
                                "example_id": "28913ad1-1f1c-42aa-9fc1-f459c02d710f",
                                "sense_id": "a5b85788-7490-3c02-9b1c-df8465ac16eb",
                                "text": "Um die Nitrifikation zu erforschen, kombiniert Michael Wagner zwei Einzelzelltechniken: NanoSIMS (im Bild) und Raman-Mikrospektroskopie."
                            },
                            {
                                "example_id": "07a6bb6e-23c2-449c-aac5-8e7b4f0fcf74",
                                "sense_id": "a5b85788-7490-3c02-9b1c-df8465ac16eb",
                                "text": "Der fixierte Luftstickstoff wird nach der Nitrifikation in Form von Cyanophycin gespeichert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
