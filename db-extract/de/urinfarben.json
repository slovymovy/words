                "senses": [
                    {
                        "sense_id": "b91b786c-83c5-378c-9db9-8ceaa26b2452",
                        "entry_id": "6077355e-c55e-3660-8a70-8e0d0946ceac",
                        "glosses": [
                            "die Farbe von Urin habend, in einem an Urin erinnernden Gelbton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7273dbde-80e3-4c0b-b9af-2594684d2143",
                                "sense_id": "b91b786c-83c5-378c-9db9-8ceaa26b2452",
                                "text": "„Am nächsten Morgen tauchte eine urinfarbene Sonne fahl und konturlos durch Staubscheiben in eine trübe Welt.“"
                            },
                            {
                                "example_id": "26dc02cb-5ac8-4544-84ac-c0ce73851dca",
                                "sense_id": "b91b786c-83c5-378c-9db9-8ceaa26b2452",
                                "text": "„Ihre urinfarbenen Augen jedoch wiehern vor Lachen auf meine Kosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
