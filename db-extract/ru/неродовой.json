                                    {
                                        "sense_id": "a8204c37-d13d-3a42-9699-5c7355270091",
                                        "entry_id": "cba2ee90-d020-3f15-9c63-b52577c81a65",
                                        "glosses": [
                                            "Without a gender, in its various senses."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18a200b9-62c3-40d6-bdf9-7274d25de1b2",
                                                "sense_id": "a8204c37-d13d-3a42-9699-5c7355270091",
                                                "text": "A genderless noun includes both the masculine and feminine forms."
                                            },
                                            {
                                                "example_id": "a9b56fc7-bb31-49bf-8ae4-721443607241",
                                                "sense_id": "a8204c37-d13d-3a42-9699-5c7355270091",
                                                "text": "Should retailers promote genderless shopping?... Through its Agender concept store, Selfridges is selling clothing, accessories and beauty supplies that, it says, \"transcend notions of 'his' and 'hers'.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "973dd0a4-4311-496e-b1d2-9759a1ddeb54",
                        "source_entry_id": "c78077c5-4d5d-3e86-b0fd-ef1ab28654be",
                        "target_lang_word": "genuslos",
                        "target_lang_code": "de",
