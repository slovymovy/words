{
    "word_family": [
        "inseparability",
        "inseparableness",
        "inseparably",
        "separable",
        "separate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bd06e5e0-dc23-3095-8431-882bad0f0764",
                    "sense_definition": "Impossible to separate or divide; intimately connected or constantly together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two childhood friends have been <w>inseparable</w> ever since they first met.",
                            "target_lang_translations": {
                                "ru": "Два друга детства были <w>неразлучны</w> с самого момента их знакомства."
                            }
                        },
                        {
                            "text": "Economic stability and social progress are virtually <w>inseparable</w> in modern governance.",
                            "target_lang_translations": {
                                "ru": "Экономическая стабильность и социальный прогресс практически <w>неотделимы</w> в современном государственном управлении."
                            }
                        }
                    ],
                    "synonyms": [
                        "unseparable"
                    ],
                    "antonyms": [
                        "separable"
                    ],
                    "common_phrases": [
                        "inseparable friends",
                        "virtually inseparable",
                        "inseparable from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невозможно разделить; тесно связанный или постоянно находящийся вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразлучный",
                                "target_lang_sense_clarification": "о друзьях, паре, людях"
                            },
                            {
                                "target_lang_word": "неотделимый",
                                "target_lang_sense_clarification": "о понятиях, вещах или качествах"
                            },
                            {
                                "target_lang_word": "нераздельный",
                                "target_lang_sense_clarification": "о частях единого целого"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0df4b88-8429-3253-bf87-a419d9541800",
                    "sense_definition": "A person or thing that cannot be separated from another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two sisters were known throughout the neighborhood as constant <w>inseparables</w>.",
                            "target_lang_translations": {
                                "ru": "Во всей округе двух сестёр знали как вечных <w>неразлучниц</w>."
                            }
                        },
                        {
                            "text": "The philosopher argued that body and mind should not be treated as distinct entities, but as true <w>inseparables</w>.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что тело и разум следует рассматривать не как отдельные сущности, а как поистине <w>неделимые вещи</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который невозможно отделить от другого; неразлучные друзья или неразделимые вещи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразлучники",
                                "target_lang_sense_clarification": "о людях, которые всегда вместе (обычно во мн. числе)"
                            },
                            {
                                "target_lang_word": "неразделимое целое",
                                "target_lang_sense_clarification": "о сущностях или понятиях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}