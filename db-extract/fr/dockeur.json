                    {
                        "sense_id": "71ce3c4c-c93c-3f19-babe-5141512cc53b",
                        "entry_id": "96d3ec15-2edc-3257-a982-4b7c87259082",
                        "glosses": [
                            "Ouvrier qui, dans un dock, travaille au chargement et au déchargement des navires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc6fe28-35cf-4cef-84a7-ebcda7ec0cb7",
                                "sense_id": "71ce3c4c-c93c-3f19-babe-5141512cc53b",
                                "text": "Sublimée par la caméra de Vincent Maël Cardona (Les Magnétiques), De grâce, minisérie franco-belge attendue cet automne sur Arte, met en scène Olivier Gourmet dans la peau de Pierre Leprieur, figure respectable du syndicat des dockeurs du Havre et patriarche d’une famille dysfonctionnelle."
                            },
                            {
                                "example_id": "df56a8d6-8b5d-45b8-b251-0b8192fb937b",
                                "sense_id": "71ce3c4c-c93c-3f19-babe-5141512cc53b",
                                "text": "Bienvenue dans la Londres du malfrat, du dockeur, du barbier, de la prostituée et de l’orphelin."
                            },
                            {
                                "example_id": "0c598180-defc-452a-b68f-3bb19cbfc9c6",
                                "sense_id": "71ce3c4c-c93c-3f19-babe-5141512cc53b",
                                "text": "Dockeur de profession, le Gonnevillais Julien Hauguel a fait connaître son flow à l’époque de Carte Blanche, un duo qu’il formait avec Sfir."
                            }
                        ]
                    }
