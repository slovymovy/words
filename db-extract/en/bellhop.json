                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d857e94c-14d4-4a82-8680-830ed2212c92",
                        "source_entry_id": "56176b1c-7a28-33a8-b2dd-b42eb8f0fc3f",
                        "source_sense_id": "c1502294-d73f-3448-820f-d05f931fc755",
                        "source_sense_description": "Page, Hotelpage, Hotelboy",
                        "target_lang_word": "Page",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Page",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48f427ca-ce64-3773-af6c-c555a0261e28",
                                        "entry_id": "b53967a0-5b77-3ad3-80df-5e2bef6a95d4",
                                        "glosses": [
                                            "Hotelbursche, Hoteldiener in betresster, uniformartiger Bekleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c90366a-5023-4e89-857f-3cc76b8b0426",
                                                "sense_id": "48f427ca-ce64-3773-af6c-c555a0261e28",
                                                "text": "Der Page wird ihnen die Koffer aufs Zimmer bringen."
                                            },
                                            {
                                                "example_id": "aaf7d1ad-b95c-4187-ba35-f4e99801dcd4",
                                                "sense_id": "48f427ca-ce64-3773-af6c-c555a0261e28",
                                                "text": "„Pagen und Zimmermädchen klopften immer wieder an seine Tür und schlossen sie, sogar wenn er im Zimmer war, mit ihrem Schlüssel auf.“"
                                            },
                                            {
                                                "example_id": "a1b0671a-f505-4790-9222-260d04cee253",
                                                "sense_id": "48f427ca-ce64-3773-af6c-c555a0261e28",
                                                "text": "„Jack rührte keinen Finger, also gab ich dem Pagen einen Vierteldollar.“"
                                            },
                                            {
                                                "example_id": "7b3fb46b-2a97-4f85-8ef3-015256ba7c8f",
                                                "sense_id": "48f427ca-ce64-3773-af6c-c555a0261e28",
                                                "text": "„An der Hotelauffahrt wartete ein Page, um die Koffer entgegenzunehmen.“"
                                            },
                                            {
                                                "example_id": "baf29985-34a3-4d88-8080-a7889eb75d83",
                                                "sense_id": "48f427ca-ce64-3773-af6c-c555a0261e28",
                                                "text": "„Der Page trug die Koffer zum Auto.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b51c7b07-652e-3c31-9819-3344d339e561",
                                        "entry_id": "b53967a0-5b77-3ad3-80df-5e2bef6a95d4",
                                        "glosses": [
                                            "„junger Adliger als Diener am Hof eines Fürsten“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4746d861-60ce-4a78-accf-82976044527c",
                                                "sense_id": "b51c7b07-652e-3c31-9819-3344d339e561",
                                                "text": "„Nicht selten findet sich als höchste Karrierestufe eines auf seinem Gut zurückgezogen lebenden Adligen, der den Hofdienst als Kammerjunker quittiert hatte, die Position eines Amtshauptmanns. Die jüngsten Amtsträger sind verständlicherweise jene, bei denen sich eine Bestallung bzw. Tätigkeit als Page belegen läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Page",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60b5eb2f-ca07-381b-9324-a7979fc0bc59",
                                        "entry_id": "4010dfde-a56c-30e1-ba61-fe1dd179602b",
                                        "glosses": [
                                            "Homepage"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66267c7c-0e0d-4b63-ae6c-1f102a7659f6",
                                                "sense_id": "60b5eb2f-ca07-381b-9324-a7979fc0bc59",
                                                "text": "Auf der Page finden sie alle wichtigen Informationen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89fdd08b-83bb-4ea6-9f3c-86e2bc788e2c",
                        "source_entry_id": "56176b1c-7a28-33a8-b2dd-b42eb8f0fc3f",
                        "source_sense_id": "c1502294-d73f-3448-820f-d05f931fc755",
                        "source_sense_description": "Page, Hotelpage, Hotelboy",
                        "target_lang_word": "Hotelpage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hotelpage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                        "entry_id": "f90db3f0-1000-35f4-8e0e-d8bac870834a",
                                        "glosses": [
                                            "(männliche^☆) Person, die als Diener in einem Hotel arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23cdcec-e725-4696-a2df-47259a933009",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Als Max öffnete, sah er sich einem Hotelpagen und einem Mann gegenüber, der einen karierten Anzug trug und eine Melone aufhatte.“"
                                            },
                                            {
                                                "example_id": "f685835b-b418-4516-8999-2b601d22bfde",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Der Hotelpage schob mich durch die Drehtür hinein, ich entdeckte Ramin in einem schwarzen Sessel und blieb am Eingang stehen.“"
                                            },
                                            {
                                                "example_id": "7c9911a1-c3c8-4eda-8317-8fe3aa917da3",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Dann ging sie, von einem Hotelpagen und von ihrem Betreuer begleitet, zum Lift.“"
                                            },
                                            {
                                                "example_id": "d8a9e896-7933-44d6-871a-4feeb0c59cfb",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Jeder, der eine Lehre als Koch oder Kellner beginnen wollte, musste vorher ein Jahr Hotelpage sein, und das nur mit Kost und sehr einfacher Logis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
