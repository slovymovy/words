{
    "word_family": [
        "fulcral",
        "fulcrate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf251dbd-62be-33b5-a579-1cac922e5577",
                    "sense_definition": "The point or support on which a lever pivots.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lever_pivot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Place a solid block underneath the bar to serve as a <w>fulcrum</w> before pushing down.",
                            "target_lang_translations": {
                                "zh": "向下按压之前，在杆子下方放一个实心垫块作为<w>支点</w>。"
                            }
                        },
                        {
                            "text": "The child used a rock as a <w>fulcrum</w> to lift the heavy wooden beam.",
                            "target_lang_translations": {
                                "zh": "那个孩子用一块石头作为<w>支点</w>撬起了沉重的木梁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pivot",
                        "axis"
                    ],
                    "common_phrases": [
                        "act as a fulcrum",
                        "serve as a fulcrum"
                    ],
                    "target_lang_definitions": {
                        "zh": "杠杆作用中的支点或支撑物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "支点",
                                "target_lang_sense_clarification": "物理学中杠杆的支撑点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a905819c-acda-3463-a7e3-1d3fb8290b81",
                    "sense_definition": "A central, essential, or pivotal point on which everything else depends.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "crux_pivot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small family-owned business became the <w>fulcrum</w> of the entire village economy.",
                            "target_lang_translations": {
                                "zh": "这家小型家族企业成为了整个村庄经济的<w>支点</w>。"
                            }
                        },
                        {
                            "text": "Her tireless research served as the <w>fulcrum</w> around which the entire debate turned.",
                            "target_lang_translations": {
                                "zh": "她孜孜不倦的研究成为了整场辩论围绕展开的<w>核心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crux",
                        "pivot",
                        "centerpiece",
                        "linchpin"
                    ],
                    "common_phrases": [
                        "fulcrum of"
                    ],
                    "target_lang_definitions": {
                        "zh": "起关键或核心作用的事物；枢纽"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "支点",
                                "target_lang_sense_clarification": "比喻具有关键支撑作用的事物"
                            },
                            {
                                "target_lang_word": "核心",
                                "target_lang_sense_clarification": "中心、最主要的部分"
                            },
                            {
                                "target_lang_word": "枢纽",
                                "target_lang_sense_clarification": "事物相互联系的关键节点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "31f6b24c-9bcf-36d8-98e6-b5e59ea8c4bb",
                    "sense_definition": "The NATO reporting name for the Soviet twin-engine jet fighter aircraft, the Mikoyan MiG-29.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The museum acquired a retired <w>Fulcrum</w> fighter jet for its military aviation exhibit.",
                            "target_lang_translations": {
                                "zh": "该博物馆为其军事航空展览购入了一架退役的<w>“支点”</w>战斗机。"
                            }
                        },
                        {
                            "text": "Pilots frequently practiced interception drills against simulated <w>Fulcrum</w> aircraft during the exercise.",
                            "target_lang_translations": {
                                "zh": "演习期间，飞行员们频繁针对模拟的<w>“支点”</w>战机进行拦截演练。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "北约对苏联米格-29双发喷气式战斗机的代号（支点）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "“支点”",
                                "target_lang_sense_clarification": "北约对米格-29战斗机的代号"
                            },
                            {
                                "target_lang_word": "支点",
                                "target_lang_sense_clarification": "战机代号"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}