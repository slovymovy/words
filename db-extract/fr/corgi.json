                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corgi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "849048b2-98f9-32b1-ac00-fb89936bb9fe",
                                        "entry_id": "02a0d591-d783-3736-a47d-b67ff9ae0939",
                                        "glosses": [
                                            "Ellipsis of Welsh corgi (“a type of herding dog originating from Wales, having a small body, short legs, and fox-like features such as large ears; two separate breeds are recognized: the Cardigan Welsh Corgi and the Pembroke Welsh Corgi”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ecc490c-2350-45e5-9bc2-a181afbdaea7",
                                                "sense_id": "849048b2-98f9-32b1-ac00-fb89936bb9fe",
                                                "text": "By this time the Pembrokeshire—the short-tailed corgwn—were increasing in popularity very rapidly. The Cardiganshire variety lagged behind their more numerous cousins, but, even so, almost all the larger shows of this country had classes […]"
                                            },
                                            {
                                                "example_id": "ef5e454f-1850-4cc2-b522-1dd3933d6570",
                                                "sense_id": "849048b2-98f9-32b1-ac00-fb89936bb9fe",
                                                "text": "[W]hich news item do we have to worry about and have a view on? Not, presumably, the fact that the Queen is going cool on corgies; probably not how space exploration is getting on; townies can maybe skip the fates of either cows or badgers."
                                            },
                                            {
                                                "example_id": "43a4b34a-2016-4042-aae2-076c947210b1",
                                                "sense_id": "849048b2-98f9-32b1-ac00-fb89936bb9fe",
                                                "text": "While larger, longer corgwn with tails were found in the lowland and hill farms of central and northern Cardiganshire, in the south a shorter, lighter corgi was more common."
                                            },
                                            {
                                                "example_id": "61eac096-77bc-4276-8dc1-a0bcff7464ba",
                                                "sense_id": "849048b2-98f9-32b1-ac00-fb89936bb9fe",
                                                "text": "Participating pooches must be between 12-20 weeks old at the time of taping. This year, two labradoodles, a pomsky and a corgi are among members the Central Florida contingent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
