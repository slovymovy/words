                                "target_senses": [
                                    {
                                        "sense_id": "0a321401-72e9-3e5a-8029-ffd991462dce",
                                        "entry_id": "57884bb1-4a8c-315f-a837-b242f972585d",
                                        "glosses": [
                                            "место, где был пожар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8346813b-b9b1-409c-9fd7-576f8493d77e",
                                                "sense_id": "0a321401-72e9-3e5a-8029-ffd991462dce",
                                                "text": "Ночью навалился снег и прикрыл пожарище; лишь торчали чёрные головни между сугробами да задымленная печка."
                                            }
