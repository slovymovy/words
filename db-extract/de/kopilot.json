                "senses": [
                    {
                        "sense_id": "42014660-5aca-3472-af06-5ea36c93b507",
                        "entry_id": "01da52b3-9789-3fba-a535-15aa9df8d577",
                        "glosses": [
                            "Zweiter Pilot in einem Luftfahrzeug"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "f687ea68-1ea2-40de-9864-d7c549a357cf",
                                "sense_id": "42014660-5aca-3472-af06-5ea36c93b507",
                                "text": "Der Kopilot übernimmt das Flugzeug."
                            },
                            {
                                "example_id": "b837436f-ffd1-4000-92a2-e7a52a208f5b",
                                "sense_id": "42014660-5aca-3472-af06-5ea36c93b507",
                                "text": "„In der Kanzel erkannte man noch die verkohlten Leichen von Pilot und Kopilot, sie hatten sich nicht mehr aus der brennenden Maschine retten können.“"
                            },
                            {
                                "example_id": "5b0fdce1-e6f4-4489-84bc-4278bf8d0235",
                                "sense_id": "42014660-5aca-3472-af06-5ea36c93b507",
                                "text": "„Da erhebt sich der Kopilot wortlos von seinem Sitz, geht hinter, und plötzlich ist es im Flugzeug mäuschenstill."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4008099-9fd5-3d80-b9bc-4099bbce6fa3",
                        "entry_id": "01da52b3-9789-3fba-a535-15aa9df8d577",
                        "glosses": [
                            "Beifahrer bei Autorennen"
                        ],
                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "da243024-e120-467f-9581-82aaf18d6ce1",
                                "sense_id": "e4008099-9fd5-3d80-b9bc-4099bbce6fa3",
                                "text": "Der Kopilot liest dem Fahrer den Aufschrieb vor."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
