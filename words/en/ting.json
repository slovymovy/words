{
    "word_family": [
        "tinkle",
        "tinkling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e2eb54e-4cc3-3d6f-916b-e339d5e88463",
                    "sense_definition": "A high-pitched sharp sound like a small bell being struck.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard the <w>ting</w> of a bell when the customer walked into the shop.",
                            "target_lang_translations": {
                                "de": "Ich hörte das <w>Klingeln</w> einer Glocke, als der Kunde den Laden betrat."
                            }
                        },
                        {
                            "text": "The <w>ting</w> of the spoon against the glass was very clear in the quiet room.",
                            "target_lang_translations": {
                                "de": "Das <w>Klingen</w> des Löffels gegen das Glas war im stillen Raum sehr deutlich zu hören."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinkle",
                        "chime",
                        "ring"
                    ],
                    "common_phrases": [
                        "sharp ting"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein hoher, scharfer Klang, ähnlich dem Anschlagen einer kleinen Glocke."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Klingeln",
                                "target_lang_sense_clarification": "allgemeiner Begriff für das Geräusch einer Glocke"
                            },
                            {
                                "target_lang_word": "Bimmeln",
                                "target_lang_sense_clarification": "umgangssprachlich für ein helles, kurzes Glockengeräusch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa659d75-7881-3230-970c-4d2539ef4e59",
                    "sense_definition": "An ancient Chinese vessel with legs and a lid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a bronze <w>ting</w> from the Shang dynasty.",
                            "target_lang_translations": {
                                "de": "Das Museum stellte ein bronzenes <w>Ting</w> aus der Shang-Dynastie aus."
                            }
                        },
                        {
                            "text": "Archaeologists discovered a decorated <w>ting</w> during the excavation of the tomb.",
                            "target_lang_translations": {
                                "de": "Archäologen entdeckten bei der Ausgrabung des Grabes ein verziertes <w>Ting</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein antikes chinesisches Gefäß mit Beinen und einem Deckel."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ting",
                                "target_lang_sense_clarification": "Fachbegriff für das spezifische chinesische Bronzegefäß"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e143e65f-1e0b-37c7-b96b-3531eb4e208c",
                    "sense_definition": "A person, often used to refer to an attractive woman or a romantic partner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was seen out with one of his <w>tings</w> at the party last night.",
                            "target_lang_translations": {
                                "de": "Er wurde gestern Abend auf der Party mit einer seiner <w>Freundinnen</w> gesehen."
                            }
                        },
                        {
                            "text": "Everyone was talking about his new <w>ting</w> after he posted the photo online.",
                            "target_lang_translations": {
                                "de": "Alle sprachen über seine neue <w>Freundin</w>, nachdem er das Foto online gestellt hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "girlfriend"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in urban youth culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, oft verwendet, um eine attraktive Frau oder einen romantischen Partner zu bezeichnen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Freundin",
                                "target_lang_sense_clarification": "im Sinne einer romantischen Partnerin"
                            },
                            {
                                "target_lang_word": "Schnecke",
                                "target_lang_sense_clarification": "umgangssprachlich für eine attraktive Frau"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "928d4a77-62ec-34ab-97d8-080b6ba12ffd",
                    "sense_definition": "To make a high-pitched sharp sound like a small bell being struck.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bell <w>tinged</w> as the door opened.",
                            "target_lang_translations": {
                                "de": "Die kleine Glocke <w>bimmelte</w>, als sich die Tür öffnete."
                            }
                        },
                        {
                            "text": "I heard the microwave <w>ting</w> when the timer finished.",
                            "target_lang_translations": {
                                "de": "Ich hörte das <w>Klingeln</w> der Mikrowelle, als der Timer abgelaufen war."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinkle",
                        "chime",
                        "ring"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen hohen, scharfen Ton von sich geben, wie eine kleine Glocke."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "klingeln",
                                "target_lang_sense_clarification": "das Geräusch einer Glocke erzeugen"
                            },
                            {
                                "target_lang_word": "bimmeln",
                                "target_lang_sense_clarification": "ein helles, kurzes Geräusch machen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9bd856c9-090e-3077-9e03-46479cf24c98",
                    "sense_definition": "Representing a high-pitched sharp sound like a small bell being struck.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ting</w> went the bell as the customer entered the store.",
                            "target_lang_translations": {
                                "de": "<w>Bling</w> machte die Glocke, als der Kunde den Laden betrat."
                            }
                        },
                        {
                            "text": "The bell rang out with a loud <w>ting</w> that startled everyone.",
                            "target_lang_translations": {
