{
    "word_family": [
        "complaire",
        "complaisamment",
        "complaisant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ffb85fa-e7e1-35af-92c2-f28eb8686756",
                    "sense_definition": "Disposition à s'adapter aux volontés ou aux désirs de quelqu'un pour lui être agréable ou serviable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bienveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auriez-vous la <w>complaisance</w> de m'indiquer le chemin de la gare ?"
                        },
                        {
                            "text": "Le guide a fait preuve d'une grande <w>complaisance</w> envers les touristes égarés."
                        }
                    ],
                    "synonyms": [
                        "amabilité",
                        "obligeance",
                        "serviabilité"
                    ],
                    "antonyms": [
                        "intransigeance",
                        "rudesse"
                    ],
                    "common_phrases": [
                        "avoir la complaisance de",
                        "faire preuve de complaisance"
                    ]
                },
                {
                    "sense_id": "844b9eaa-6d1d-320e-88b9-4e1f768f6673",
                    "sense_definition": "Indulgence excessive ou coupable à l'égard de fautes, d'erreurs ou de comportements répréhensibles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indulgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a été accusée de <w>complaisance</w> face aux retards répétés des employés."
                        },
                        {
                            "text": "Le juge refuse toute <w>complaisance</w> envers ceux qui enfreignent délibérément la loi."
                        }
                    ],
                    "synonyms": [
                        "faiblesse",
                        "indulgence",
                        "laxisme"
                    ],
                    "antonyms": [
                        "fermeté",
                        "inflexibilité",
                        "rigueur",
                        "sévérité"
                    ],
                    "common_phrases": [
                        "sans complaisance",
                        "traiter avec complaisance"
                    ]
                },
                {
                    "sense_id": "32b52bd4-5e40-3f41-8da5-ef1fbcb24865",
                    "sense_definition": "Sentiment de satisfaction excessive ou d'admiration non critique envers soi-même ou ses réalisations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "autosatisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur parlait de son dernier ouvrage avec une <w>complaisance</w> qui agaçait l'auditoire."
                        },
                        {
                            "text": "Il s'observait dans le miroir avec une visible <w>complaisance</w> avant de sortir."
                        }
                    ],
                    "synonyms": [
                        "autosatisfaction",
                        "contentement",
                        "suffisance"
                    ],
                    "antonyms": [
                        "autocritique",
                        "humilité",
                        "modestie"
                    ],
                    "common_phrases": [
                        "regarder avec complaisance"
                    ]
                }
            ]
        }
    ]
}