                "senses": [
                    {
                        "sense_id": "43626227-771d-346f-ab0b-c75c57d4e47f",
                        "entry_id": "d6a72cb9-421b-3b57-bc45-9cb33b6961e7",
                        "glosses": [
                            "iemand die in een stad woont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11e6fac8-5571-4c98-8389-4fa85223f440",
                                "sense_id": "43626227-771d-346f-ab0b-c75c57d4e47f",
                                "text": "Veel Bruggenaren vinden de eisen van Unesco te ver gaan. \"Brugge wordt te veel een museum, een pretpark\", aldus een jonge stadsbewoner. \"Ze moeten Bruggelingen de vrijheid geven om nieuwe projecten op starten. Want anders gaat de stad dood.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e1d03ba-9765-4e0a-ad6e-9d8ec38cd9a2",
                        "source_entry_id": "d6a72cb9-421b-3b57-bc45-9cb33b6961e7",
                        "source_sense_id": "43626227-771d-346f-ab0b-c75c57d4e47f",
                        "source_sense_description": "iemand die in een stad woont",
                        "target_lang_word": "urban dweller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urban dweller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05e75e37-2dd5-34c0-9323-b27270d86d18",
                                        "entry_id": "ca2044da-1eaf-3909-a403-79ff65cbe77f",
                                        "glosses": [
                                            "One accustomed to a city or urban lifestyle or unsuited to life in the country."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "056329e7-daa0-4881-9936-0e16157ef7b7",
                                                "sense_id": "05e75e37-2dd5-34c0-9323-b27270d86d18",
                                                "text": "Look at the urban dweller pulling up in his fancy German car."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce794b7e-0577-451c-afc9-bde684f55be8",
                        "source_entry_id": "d6a72cb9-421b-3b57-bc45-9cb33b6961e7",
                        "source_sense_id": "43626227-771d-346f-ab0b-c75c57d4e47f",
                        "source_sense_description": "iemand die in een stad woont",
                        "target_lang_word": "city dweller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "city dweller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc86dfd-894c-3f00-9847-ae3a935f8373",
                                        "entry_id": "bb0f5c61-dc21-32f3-aeea-e47b50fb4519",
                                        "glosses": [
                                            "A person living in a city."
                                        ],
