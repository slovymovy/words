                "senses": [
                    {
                        "sense_id": "dfe5dd6a-82c9-3261-8f67-6af353509387",
                        "entry_id": "a1ad546d-5b76-34a2-a4fe-d421a169ace4",
                        "glosses": [
                            "zob. wskaźnik"
                        ],
                        "tags": [
                            "variant"
                        ],
                        "examples": [
                            {
                                "example_id": "dd51e53e-6ce6-44db-a1f0-7676c224599f",
                                "sense_id": "dfe5dd6a-82c9-3261-8f67-6af353509387",
                                "text": "Ciała chemiczne, za pomocą których stwierdzamy oddziaływanie kwaśne lub zasadowe, nazywamy wskaźnikami, czyli indykatorami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "40fb5d24-2fbf-36e9-be41-f70a87f103ec",
                        "entry_id": "a1ad546d-5b76-34a2-a4fe-d421a169ace4",
                        "glosses": [
                            "przyrząd pomiarowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77332e5e-e849-4d6c-9da9-09bd4a68238d",
                                "sense_id": "40fb5d24-2fbf-36e9-be41-f70a87f103ec",
                                "text": "Do otrzymania rzeczywistego wykresu obiegu pary służy przyrząd, zwany indykatorem"
                            },
                            {
                                "example_id": "ec5ce2b5-836f-4c4c-b9d2-5bf27df41b53",
                                "sense_id": "40fb5d24-2fbf-36e9-be41-f70a87f103ec",
                                "text": ". Indykator i jego zastosowanie w przemyśle (Odbitka z Przeglądu technicznego). Warszawa, Gebethner i Wolff, druk. Al. Ginsa, 1879. w Sce, str. 31 i 3 tablice. 40 kop."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
