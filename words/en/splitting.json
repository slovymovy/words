        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8ba53b5-4cce-3017-9285-2c1806a9a716",
                    "sense_definition": "An instance where something splits or is divided into parts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>splitting</w> of the atom was a major scientific breakthrough.",
                            "target_lang_translations": {
                                "ru": "<w>Расщепление</w> атома стало крупным научным прорывом.",
                                "pl": "<w>Rozszczepienie</w> atomu było wielkim przełomem naukowym."
                            }
                        },
                        {
                            "text": "Repeated <w>splittings</w> of the political party weakened its influence.",
                            "target_lang_translations": {
                                "ru": "Повторяющиеся <w>расколы</w> политической партии ослабили её влияние.",
                                "pl": "Powtarzające się <w>rozłamy</w> w partii politycznej osłabiły jej wpływy."
                            }
                        }
                    ],
                    "synonyms": [
                        "division",
                        "separation",
                        "cleavage"
                    ],
                    "antonyms": [
                        "union",
                        "merger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай, когда что-то раскалывается или разделяется на части.",
                        "pl": "Przypadek, w którym coś pęka lub zostaje podzielone na części."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расщепление",
                                "target_lang_sense_clarification": "атома или вещества"
                            },
                            {
                                "target_lang_word": "раскол",
                                "target_lang_sense_clarification": "группы, партии или мнения"
                            },
                            {
                                "target_lang_word": "разделение",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozszczepienie",
                                "target_lang_sense_clarification": "np. atomu"
                            },
                            {
                                "target_lang_word": "podział",
                                "target_lang_sense_clarification": "ogólny proces dzielenia"
                            },
                            {
                                "target_lang_word": "rozłam",
                                "target_lang_sense_clarification": "w grupie lub partii"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bbf2346-0aee-304f-87da-479d078c08bf",
                    "sense_definition": "A psychological mechanism involving a division in the mind, often separating positive and negative qualities.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist explained that <w>splitting</w> is a defense mechanism used to handle conflicting emotions.",
                            "target_lang_translations": {
                                "ru": "Терапевт объяснил, что <w>расщепление</w> — это защитный механизм, используемый для справления с противоречивыми эмоциями.",
                                "pl": "Terapeuta wyjaśnił, że <w>rozszczepienie</w> to mechanizm obronny używany do radzenia sobie ze sprzecznymi emocjami."
                            }
                        },
                        {
                            "text": "His behavior showed signs of <w>splitting</w>, as he viewed people as either entirely good or entirely bad.",
                            "target_lang_translations": {
                                "ru": "В его поведении наблюдались признаки <w>расщепления</w>, так как он воспринимал людей либо как полностью хороших, либо как полностью плохих.",
                                "pl": "Jego zachowanie wykazywało oznaki <w>rozszczepienia</w>, ponieważ postrzegał ludzi albo jako całkowicie dobrych, albo całkowicie złych."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "psychology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Психологический механизм, включающий разделение в сознании, часто разделяющий положительные и отрицательные качества.",
                        "pl": "Mechanizm psychologiczny polegający na podziale w umyśle, często rozdzielający cechy pozytywne od negatywnych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расщепление",
                                "target_lang_sense_clarification": "психологический термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozszczepienie",
                                "target_lang_sense_clarification": "termin psychologiczny"
                            }
                        ]
