                "senses": [
                    {
                        "sense_id": "1d33a1db-90aa-3a55-b66f-ed6ef258dd4a",
                        "entry_id": "c34e5d7d-a750-3520-9470-ebab33489585",
                        "glosses": [
                            "геол. участок земной коры, занимающий приподнятое положение по отношению к окружающим областям и ограниченный сбросами или взбросами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1dbcffb-1b75-445b-80f4-4de41ddc3a9c",
                                "sense_id": "1d33a1db-90aa-3a55-b66f-ed6ef258dd4a",
                                "text": "Отсутствие палеозойских морских отложений позволяет думать, что вся область после образования складок из архейских и метаморфических пород осушилась, больше не затоплялась морем, а подверглась разломам, которые расчленили ее поверхность на возвышенности (горсты) и впадины (грабены)."
                            }
                        ]
                    }
