                        "examples": [
                            {
                                "example_id": "33bdf87b-9cbb-45f4-bbce-52aa48cba2ce",
                                "sense_id": "55b48e6b-a010-3d1d-8e8c-9547575a91e6",
                                "text": "In de krant maar ook op de radio en tv waren veel reportages over de aardbeving in Nepal."
                            }
