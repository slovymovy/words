                                    {
                                        "sense_id": "34d7d1eb-f6f9-3c9c-a219-24be316cd7d4",
                                        "entry_id": "f53c4f8d-6774-35d2-937e-a79eecd1cb26",
                                        "glosses": [
                                            "zaburzenie w komunikacji objawiające się bezładną, szybką mową"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085e3d53-cf2f-43af-9d9f-9ee9d8a7a63c",
                                                "sense_id": "34d7d1eb-f6f9-3c9c-a219-24be316cd7d4",
                                                "text": "W specjalistycznym języku medycznym słowotok jest zawsze objawem choroby psychicznej lub neurologicznej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "15344ef5-ae14-37ec-865c-3f2fa4c26f2f",
                                        "entry_id": "f53c4f8d-6774-35d2-937e-a79eecd1cb26",
                                        "glosses": [
                                            "wypowiedź rozwlekła, emocjonalna i pozbawiona głębszej treści"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a049020-1013-4f32-af17-33cbbefd2b27",
                                                "sense_id": "15344ef5-ae14-37ec-865c-3f2fa4c26f2f",
                                                "text": "I w mediach, i w internecie słowo znawcy tematu tudzież mędrca znaczy tyle samo, co bełkot lub słowotok dyletanta i mętniaka, a często mętniak zagada, przegada i podsumuje mówcę treściwego"
                                            }
