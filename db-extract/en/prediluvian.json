                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e886a982-cd4c-4d51-ad78-762b5408c0b2",
                                "sense_id": "34248195-cb09-308c-a58c-623f199d2bc4",
                                "text": "When Noah in ark, with his ſons did embark, / Prediluvians, uplifted and pompous, / Deem’d his nautical ſcheme a fantaſtical dream, / And pronounc’d the projector non compos."
                            },
                            {
                                "example_id": "cfdde561-a6ba-4cb0-b47f-9db15f7473f0",
                                "sense_id": "34248195-cb09-308c-a58c-623f199d2bc4",
                                "text": "[…] for the British have in 1,500 years progressed from an initial stage that was probably inferior to that of the prediluvians, and any shipbuilding that they learned from earlier races was a hindrance, not a help."
                            },
                            {
                                "example_id": "14b41baa-0f40-47a1-bbec-7e845d1e6764",
                                "sense_id": "34248195-cb09-308c-a58c-623f199d2bc4",
                                "text": "With only two exceptions the prediluvians lived into their tenth century."
                            }
                        ]
