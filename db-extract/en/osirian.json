                        "glosses": [
                            "Of or pertaining to Osiris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a1cb17a-ef6e-4824-afb4-79e5594584e4",
                                "sense_id": "ef5d4a79-e60e-3fbd-b016-4aefebc2c467",
                                "text": "It is, indeed, part of the ritual of the candidate for adeptship into the British mysteries, resembling that for the neophyte into the Osirian, Cabiric or Orphean mysteries."
                            },
                            {
                                "example_id": "f0cbd392-a935-4580-835b-ddab20f56e4f",
                                "sense_id": "ef5d4a79-e60e-3fbd-b016-4aefebc2c467",
                                "text": "Nevertheless it is a potentiality, for out of it rises the beetle, the sign for \"form\" and \"coming into being.\" In the next, the Osirian stage, the night sun penetrates to the Underworld and its rays fall upon the soul in its new form as the body of Osiris."
                            }
                        ]
                    }
