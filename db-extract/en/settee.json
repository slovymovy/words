                                            {
                                                "example_id": "f0007cd0-775b-49ce-9215-3b8696ba190d",
                                                "sense_id": "aa6e21bf-e264-3da3-a291-2bf4871c8d38",
                                                "text": "Ta sofa wspaniale wkomponowała się w nasze mieszkanie."
                                            }
