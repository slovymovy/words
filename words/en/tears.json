{
    "word_family": [
        "tearful",
        "tearless",
        "teardrop",
        "tearer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f24e96a-9868-3d20-b948-0a766a86b37e",
                    "sense_definition": "Plural of <w>tear</w> (drops of salty liquid secreted by the lachrymal glands in the eyes).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eye_fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wiped away her <w>tears</w> and tried to smile for the camera.",
                            "target_lang_translations": {
                                "ru": "Она вытерла <w>слезы</w> и попыталась улыбнуться на камеру."
                            }
                        },
                        {
                            "text": "The sad movie brought <w>tears</w> to my eyes.",
                            "target_lang_translations": {
                                "ru": "Грустный фильм вызвал <w>слезы</w> на моих глазах."
                            }
                        }
                    ],
                    "synonyms": [
                        "teardrops"
                    ],
                    "common_phrases": [
                        "tears in eyes",
                        "burst into tears",
                        "shed tears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от tear (капли соленой жидкости, выделяемые слезными железами в глазах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слезы",
                                "target_lang_sense_clarification": "капли жидкости из глаз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db5c6e97-5ec3-356d-a2c9-b76d80a93916",
                    "sense_definition": "Viscous streaks left on the inside of a glass when certain wines are swirled around before tasting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wine_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sommelier pointed out the prominent <w>tears</w> on the side of the glass, indicating a high alcohol content.",
                            "target_lang_translations": {
                                "ru": "Сомелье указал на заметные <w>слезки</w> на стенках бокала, что указывает на высокое содержание алкоголя."
                            }
                        },
                        {
                            "text": "A full-bodied red wine often leaves distinct <w>tears</w> along the inside of the goblet.",
                            "target_lang_translations": {
                                "ru": "Полнотелое красное вино часто оставляет отчетливые <w>ножки</w> на внутренней стороне бокала."
                            }
                        }
                    ],
                    "synonyms": [
                        "legs"
                    ],
                    "common_phrases": [
                        "tears of wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вязкие потеки, остающиеся на внутренней стороне бокала при покачивании некоторых вин перед дегустацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слезки",
                                "target_lang_sense_clarification": "винные ножки на стенках бокала"
                            },
                            {
                                "target_lang_word": "ножки",
                                "target_lang_sense_clarification": "винные потеки на стекле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3af57114-36dd-392c-90c5-ed498114417a",
                    "sense_definition": "Plural of <w>tear</w> (rips, holes, or cuts in paper, fabric, or other material).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old book had several <w>tears</w> in its fragile pages.",
                            "target_lang_translations": {
                                "ru": "В старой книге было несколько <w>надрывов</w> на хрупких страницах."
                            }
                        },
                        {
                            "text": "He noticed some wear and <w>tears</w> on the knees of his favorite jeans.",
                            "target_lang_translations": {
                                "ru": "Он заметил потертости и <w>дыры</w> на коленях своих любимых джинсов."
                            }
                        }
                    ],
                    "synonyms": [
                        "rips",
                        "rents",
                        "slits"
                    ],
                    "common_phrases": [
                        "wear and tears",
                        "rips and tears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от tear (разрывы, дыры или порезы на бумаге, ткани или другом материале)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дыры",
                                "target_lang_sense_clarification": "прорехи на ткани или бумаге"
                            },
                            {
                                "target_lang_word": "разрывы",
                                "target_lang_sense_clarification": "места, где материал порван"
                            },
                            {
                                "target_lang_word": "надрывы",
                                "target_lang_sense_clarification": "небольшие повреждения краев"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e34eb995-3d25-3c58-b884-c9f2a8e24c9f",
                    "sense_definition": "Third-person singular simple present indicative of <w>tear</w> (to rip, pull apart, or divide by force).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ripping_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always <w>tears</w> the wrapping paper off his presents in a hurry.",
                            "target_lang_translations": {
                                "ru": "Он всегда в спешке <w>срывает</w> упаковочную бумагу со своих подарков."
                            }
                        },
                        {
                            "text": "The sharp nail <w>tears</w> any fabric that brushes against it.",
                            "target_lang_translations": {
                                "ru": "Острый гвоздь <w>рвет</w> любую ткань, которая задевает его."
                            }
                        }
                    ],
                    "synonyms": [
                        "rips",
                        "shreds"
                    ],
                    "common_phrases": [
                        "tears apart",
                        "tears down",
                        "tears up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа настоящего времени глагола tear (рвать, разрывать или разделять силой)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рвет",
                                "target_lang_sense_clarification": "разделяет на части с силой"
                            },
                            {
                                "target_lang_word": "разрывает",
                                "target_lang_sense_clarification": "повреждает целостность ткани или бумаги"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}