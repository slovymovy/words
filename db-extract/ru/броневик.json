                                        "glosses": [
                                            "militärischer Eisenbahnzug, mit Eisenbahntruppen bemanntes Militärbahnfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "746c202f-c9b5-4b4d-af16-8d60fdab4a0a",
                                                "sense_id": "c77a530e-8cd0-3e24-8ba1-a82caa44f1c3",
                                                "text": "„Schon der Name klang sonderbar: Panzerzug. Das Symbol des technischen Fortschritts schlechthin in einer mittelalterlichen Rüstung; die Lokomotive als Schlachtross eines fahrenden Ritters.“"
