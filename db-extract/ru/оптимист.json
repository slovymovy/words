                    {
                        "form_id": "215e9410-4349-41d4-9337-acce98f3692d",
                        "entry_id": "f0548e4b-170b-394e-9c51-26721bf3944e",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "оптими́стах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fd9630b-0fa6-36b2-a4a6-2d6f51c667af",
                        "entry_id": "f0548e4b-170b-394e-9c51-26721bf3944e",
                        "glosses": [
                            "человек, воспринимающий события оптимистически, в позитивном свете"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09ca9289-b1d9-477e-935a-3a316c8da98e",
                                "sense_id": "9fd9630b-0fa6-36b2-a4a6-2d6f51c667af",
                                "text": "Я оптимист по натуре и верю, что выход всегда есть из самой, казалось бы, безнадёжной ситуации."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab9a7790-ce32-4030-ae39-088413cf7328",
                        "source_entry_id": "f0548e4b-170b-394e-9c51-26721bf3944e",
                        "source_sense_id": "9fd9630b-0fa6-36b2-a4a6-2d6f51c667af",
                        "target_lang_word": "optimist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optimist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7daefc0d-7c70-3df1-806e-a230ba9e6d29",
                                        "entry_id": "c5d96df9-d392-3d80-b96e-46c78687cf09",
                                        "glosses": [
                                            "A person who expects a favourable outcome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23889dc9-d7ac-4ebf-927f-97aa280302b3",
                                                "sense_id": "7daefc0d-7c70-3df1-806e-a230ba9e6d29",
                                                "text": "We are becoming as a nation, as a world, indeed, atom-conscious. Many of us are already afflicted with atomphobia, though so far it has manifested itself only in a mirage of autoaeromotive discs and a war of words between chronic optimists and empirical pessimists concerning civilization’s probable future."
                                            },
                                            {
                                                "example_id": "2759540f-78a8-4c1d-a6b6-bb580ada41b5",
                                                "sense_id": "7daefc0d-7c70-3df1-806e-a230ba9e6d29",
                                                "text": "People often call me an optimist, because I show them the enormous progress they didn't know about. That makes me angry. I'm not an optimist. That makes me sound naive. I'm a very serious “possibilist”. That’s something I made up. It means someone who neither hopes without reason, nor fears without reason, someone who constantly resists the overdramatic worldview. As a possibilist, I see all this progress, and it fills me with conviction and hope that further progress is possible. This is not optimistic. It is having a clear and reasonable idea about how things are. It is having a worldview that is constructive and useful.;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff6ff23-80f1-32e8-a8d1-5c2e401bb998",
                                        "entry_id": "c5d96df9-d392-3d80-b96e-46c78687cf09",
                                        "glosses": [
                                            "A believer in optimism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "321e4f9f-6e4b-4345-a8cd-a45e842fff54",
                        "source_entry_id": "f0548e4b-170b-394e-9c51-26721bf3944e",
                        "source_sense_id": "9fd9630b-0fa6-36b2-a4a6-2d6f51c667af",
                        "target_lang_word": "Optimist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Optimist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ccf38a9-2b7f-3d7b-9c58-0a033dc439ba",
                                        "entry_id": "685f353b-a43a-35bd-823f-8be9361b45df",
                                        "glosses": [
                                            "Person, die von Optimismus erfüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a5dfe5-354f-493a-b912-2c65f76b2908",
                                                "sense_id": "4ccf38a9-2b7f-3d7b-9c58-0a033dc439ba",
                                                "text": "In der Grundtendenz denke ich immer positiv und glaube an das Optimum einer Sache, so dass ich im Team als Optimist gelte."
                                            },
                                            {
                                                "example_id": "4ed4d527-40f2-4338-ab31-f34d8d938d0e",
                                                "sense_id": "4ccf38a9-2b7f-3d7b-9c58-0a033dc439ba",
                                                "text": "Mein Kollege ist ein übel gelaunter Pessimist, der überall nur Misserfolge sieht, so dass es mir als Optimist sehr schwerfällt, mit ihm zusammenzuarbeiten."
                                            },
                                            {
                                                "example_id": "0bb35533-a8a1-4a61-8337-da2b246fe39b",
                                                "sense_id": "4ccf38a9-2b7f-3d7b-9c58-0a033dc439ba",
                                                "text": "„Ludda-Kristjan wusste nicht, was ein Pessimist ist, und Adelheid, die ihn gern ärgerte, sagte, ein Pessimist sei das Gegenteil eines Optimisten.“"
                                            },
                                            {
                                                "example_id": "2f4b6d01-d785-42d9-9e5b-cb816f8de35c",
                                                "sense_id": "4ccf38a9-2b7f-3d7b-9c58-0a033dc439ba",
                                                "text": "„Freud war ein Rationalist, aber er war kein Optimist, und als er das Unbewusste entdeckte, machte er sich keine Illusionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e9de96f-983d-3b64-88a1-c86bccfa79e3",
                                        "entry_id": "685f353b-a43a-35bd-823f-8be9361b45df",
                                        "glosses": [
                                            "Bootsklasse für Segeljollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da5c98c-8ab8-47e7-91ab-892f5c10580a",
                                                "sense_id": "3e9de96f-983d-3b64-88a1-c86bccfa79e3",
                                                "text": "„Der Optimist ist sehr einfach zu handhaben und dient Kindern als eine der Einstiegsklassen in den Segel- und Regattasport.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04365f96-ec4f-469b-87ac-93c72e01d181",
                        "source_entry_id": "f0548e4b-170b-394e-9c51-26721bf3944e",
