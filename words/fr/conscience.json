            "pos": "noun",
            "senses": [
                {
                    "sense_id": "363204b2-2d05-39f5-b2f3-9619e1dc2ded",
                    "sense_definition": "État d'éveil et de lucidité dans lequel une personne perçoit le monde et ses propres sensations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé a perdu <w>conscience</w> pendant quelques minutes après sa chute."
                        },
                        {
                            "text": "Après une longue opération, le patient a enfin repris <w>conscience</w>."
                        }
                    ],
                    "antonyms": [
                        "inconscience"
                    ],
                    "common_phrases": [
                        "perdre conscience",
                        "reprendre conscience"
                    ]
                },
                {
                    "sense_id": "27829fad-85f8-37ab-bb24-ffb8b5579c80",
                    "sense_definition": "Connaissance ou perception lucide qu'une personne a d'une réalité, d'une situation ou de ses propres actes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lucidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut prendre <w>conscience</w> de l'importance de ce problème environnemental."
                        },
                        {
                            "text": "Les automobilistes ont rarement <w>conscience</w> du danger sur cette route verglacée."
                        }
                    ],
                    "common_phrases": [
                        "avoir conscience",
                        "prendre conscience"
                    ]
                },
                {
                    "sense_id": "7d8ac844-2737-3a03-8997-3b1dace55e2b",
                    "sense_definition": "Faculté de porter un jugement moral sur ses propres actes, sentiment du bien et du mal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a la <w>conscience</w> tranquille parce qu'elle a toujours dit la vérité."
                        },
                        {
                            "text": "Mentir à son ami lui donnait mauvaise <w>conscience</w> depuis des semaines."
                        }
                    ],
                    "common_phrases": [
                        "avoir la conscience tranquille",
                        "bonne conscience",
                        "cas de conscience",
                        "mauvaise conscience"
                    ]
                },
                {
                    "sense_id": "8da49132-620a-3ca7-aa7f-8ade9e875395",
                    "sense_definition": "Personne remarquable par sa droiture morale et ses prises de position éthiques exemplaires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet écrivain engagé était considéré comme la grande <w>conscience</w> de son époque."
                        },
                        {
                            "text": "Tout au long de sa vie, elle est restée une véritable <w>conscience</w> morale pour notre pays."
                        }
                    ]
                }
            ]
        }
