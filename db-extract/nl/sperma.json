                            {
                                "example_id": "8fe8b53a-786e-4ddc-a00f-fab5d336c4bb",
                                "sense_id": "38549864-acd1-34a7-842e-85eb2bb6b7b0",
                                "text": "Bij inseminatie wordt sperma ingebracht."
                            }
                        ]
