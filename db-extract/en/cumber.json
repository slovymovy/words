                        ],
                        "form": "cumbered"
                    },
                    {
                        "form_id": "b14605a6-23fc-40e4-9e62-22280bdb75e9",
                        "entry_id": "47ca6632-4bab-328e-9e68-c97988000e84",
                        "tags": [
                            "past"
                        ],
                        "form": "cumbered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                        "entry_id": "47ca6632-4bab-328e-9e68-c97988000e84",
                        "glosses": [
                            "To slow down; to hinder; to burden; to encumber."
                        ],
                        "tags": [
                            "dated",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aed80854-15ff-406f-bc7c-ac1f7fc70eea",
                                "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                                "text": "Why asks he what avails him not in fight, / And would but cumber and retard his flight?"
                            },
                            {
                                "example_id": "ab29c24c-8c98-4534-91ff-8b80944e0034",
                                "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                                "text": "The multiplying variety of arguments, especially frivolous ones, […] but cumbers the memory."
                            },
                            {
                                "example_id": "6f5ed408-cf96-43b7-a05f-65bfe91ca0aa",
                                "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                                "text": "Wounded and overthrown, the Britons continued their resistance, clung round the legs of the Norman steeds, and cumbered their advance; while their brethren, thrusting with pikes, proved every joint and crevice of the plate and mail, or grappling with the men-at-arms, strove to pull them from their horses by main force, or beat them down with their bills and Welch hooks."
                            },
                            {
                                "example_id": "3d58aadc-1f2e-4010-a62c-7634b1183819",
                                "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                                "text": "[…] the base villain who murdered this poor defenceless old man, when he had not, by the course of nature, a twelvemonth's life in him, shall not cumber the earth long after him."
                            },
                            {
                                "example_id": "48ab63a4-faf4-426d-b974-4f5fe2ecfd99",
                                "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                                "text": "[T]hese people, whose name, much as I would like to express my gratitude to them, I may not even give here, nevertheless cumbered themselves with me, sheltered me and protected me from myself."
                            },
                            {
                                "example_id": "1bfeff5e-9e20-460d-b17b-4d0b3706d338",
                                "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                                "text": "Why had he not killed himself long ago? Why cumbered he the earth?"
                            },
                            {
                                "example_id": "4df312c8-9cb0-46d4-afa7-66be4f3e9b97",
                                "sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                                "text": "Moreover, that distinctive hair of hers was screwed up into a tight plait and she carried a heavy basket on her hip and a weighted bucket of oysters in her other hand, which cumbered the grace of her body and turned her into the dull replica of any other peasant creature."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bec15d1b-f20d-41f1-b529-abeaf5628caf",
                        "source_entry_id": "47ca6632-4bab-328e-9e68-c97988000e84",
                        "source_sense_id": "d51d1eb7-181c-38e5-be81-5d47c5d3aa20",
                        "source_sense_description": "to slow down, to hinder, to burden",
                        "target_lang_word": "encombrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encombrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                        "entry_id": "2f5ccd19-f0a5-3c8a-99e7-ff0bccff4e0a",
                                        "glosses": [
                                            "Obstruer ; embarrasser."
                                        ],
                                        "tags": [],
                                        "note": "Se dit surtout de ce qui gêne la circulation",
                                        "examples": [
                                            {
                                                "example_id": "4af54a0a-7ad1-433a-b080-0ab01b9ed7c6",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "Le bateau, mal conduit et chargé outre mesure, alla donner dans un de ces bas-fonds qui encombrent le lit de la Loire, et y resta engravé."
                                            },
                                            {
                                                "example_id": "12fdd9de-5380-4d05-952d-6319e6a5a5b3",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "Le 1ᵉʳ groupe est en position successivement à la ferme Scay et à Vaux-Champagne, pendant que le 3ᵉ groupe, dont le matériel trop lourd encombrerait inutilement les routes déjà surchargées de convois, reste en position d'attente à Semide."
                                            },
                                            {
                                                "example_id": "1cdb426c-6c3a-46a6-be98-f7e9bdfb602e",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "Ils sortirent par la poterne et suivirent le littoral, dont les glaçons encombraient la lisière."
                                            },
                                            {
                                                "example_id": "ac1e77db-34c4-4e08-9d8b-e6929c40c7dc",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "Le long des rivières se développe une végétation de Cannes de Provence qui s’encombre de Saules et de Peupliers jusqu’à donner des bois de ces arbres qui sont un autre climax."
                                            },
                                            {
                                                "example_id": "541bf5fb-d1df-44e4-8af3-37d948f0e88e",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "Je traversai une cour encombrée de jeeps et de camions militaires et j'arrivai devant l'entrée du bâtiment inachevé."
                                            },
                                            {
                                                "example_id": "5a56045c-5fd0-4b4f-8ee3-0d5d7c50453f",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "Mais il y a aussi le flot ininterrompu des brochures et opuscules sur l'islam qui encombrent les kiosques et les étalages de livres sur les trottoirs des grandes villes d'Égypte."
                                            },
                                            {
                                                "example_id": "27111705-047b-4549-a654-ac3682531bbc",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "— Un certain Jacobeus, ouvrier imprimeur impliqué dans le complot légitimiste de la rue des Prouvaires, trouve la mort. […]. Pour le moment , le cadavre de Jacobeus encombre, et la presse d'opposition carliste, comme celle des républicains, profite de l'aubaine."
                                            },
                                            {
                                                "example_id": "c9cf455f-6916-4515-9658-6c3d421c1d42",
                                                "sense_id": "ea7f815f-1411-3082-9df8-c431964d5f5a",
                                                "text": "— Un mec qui ne s'encombrera pas des convenances et de la séduction à deux balles, qui rentrera, posera le kébab et sans dire un mot, m'embrassera fougueusement en me disant de ne pas m'inquiéter pour toutes les histoires de couple pourries […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
