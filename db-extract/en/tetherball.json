                        "cross_references": [
                            {
                                "target_word": "spiroballe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c331dd2d-ff07-3f66-b9bb-dd21d8f91946",
                                        "entry_id": "72b93ac5-4515-338e-823c-7bd38cf992a5",
                                        "glosses": [
                                            "Jeu au cours duquel deux adversaires se tenant face à face frappent alternativement et en sens opposé, à main nue ou à l’aide d’une raquette, une balle reliée par une cordelette au sommet d’un mât, et tentent chacun d’être le premier à enrouler intégralement le lien autour du mât."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c281bead-e637-440d-aeda-f6e7daaefae0",
                                                "sense_id": "c331dd2d-ff07-3f66-b9bb-dd21d8f91946",
                                                "text": "[…] ; un jeu dit des hommes volants, où des hommes déguisés en oiseaux ; attachés par une corde au sommet d'un mât se poursuivaient à la façon du jeu de spiroballes."
                                            },
                                            {
                                                "example_id": "dd643712-a829-4f65-9823-f6f841ce78a2",
                                                "sense_id": "c331dd2d-ff07-3f66-b9bb-dd21d8f91946",
                                                "text": "Plus tard, le même jour, les élèves avaient chanté This Land Is Your Land, puis ils avaient joué dehors à la spiroballe, par une belle journée ensoleillée."
                                            },
                                            {
                                                "example_id": "9039f8f9-f56c-4969-aaab-bf459f68450b",
                                                "sense_id": "c331dd2d-ff07-3f66-b9bb-dd21d8f91946",
                                                "text": "Comme s'il possédait les lieux, il inspecta la cage à poules, le poteau de la spiroballe, les fillettes qui poussaient des cris aigus sur les balançoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e466daea-f8f3-3023-8f04-6ba38d97dcc5",
                                        "entry_id": "72b93ac5-4515-338e-823c-7bd38cf992a5",
                                        "glosses": [
                                            "Installation pour un tel jeu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e82456-059b-41eb-8999-522a316ac301",
                                                "sense_id": "e466daea-f8f3-3023-8f04-6ba38d97dcc5",
                                                "text": "En quatrième, Tommy McDougal m'avait quittée à côté du spiroballe (celui qui n'avait plus de balle). Il avait dit que je ressemblais à un garçon."
                                            },
                                            {
                                                "example_id": "1ddd3299-97f4-445a-89f5-f7b4d8b7608f",
                                                "sense_id": "e466daea-f8f3-3023-8f04-6ba38d97dcc5",
                                                "text": "Certains courent vers les spiroballes, d'autres vers les cadres à grimper, d'autres encore traînent sur le bitume en se demandant à quoi ils ont envie de jouer."
                                            }
                                        ]
                                    }
                                ]
                            }
