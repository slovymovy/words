                ],
                "senses": [
                    {
                        "sense_id": "4dbcd3f9-2682-345c-ab70-54972e649886",
                        "entry_id": "6eccce10-4d19-3bf7-a3fd-261e59454d20",
                        "glosses": [
                            "Équipé de trois réacteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9dbbd4-cb04-49d4-a386-b5d7b8817a8e",
                                "sense_id": "4dbcd3f9-2682-345c-ab70-54972e649886",
                                "text": "Dassault Aviation est aujourd'hui le seul constructeur au monde à poursuivre la production d’avions triréacteurs avec ses Falcon 900, 7X et 8X."
                            },
                            {
                                "example_id": "1ff4c384-dee3-43ba-a6e7-9f5316cb5b05",
                                "sense_id": "4dbcd3f9-2682-345c-ab70-54972e649886",
                                "text": "Le vol d’un peu plus de quatre heures a présenté plusieurs contraintes pour les deux pilotes de l’avion d’affaires triréacteur."
                            },
                            {
                                "example_id": "17fe432f-8208-488e-8bfb-5efece184acc",
                                "sense_id": "4dbcd3f9-2682-345c-ab70-54972e649886",
                                "text": "Depuis peu, son DC10 est menacé par un concurrent, le Tristar L1011, autre long-courrier triréacteur qui lui grignote des parts de marché."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9fa6326-cc32-47b6-86e5-4dc50eebc5d3",
                        "source_entry_id": "6eccce10-4d19-3bf7-a3fd-261e59454d20",
                        "source_sense_id": "4dbcd3f9-2682-345c-ab70-54972e649886",
                        "target_lang_word": "dreistrahlig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreistrahlig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93e64edf-7969-31e8-af6a-1972e0b57e54",
                                        "entry_id": "05c15d92-6835-3e9d-af59-4c233a65f7c5",
                                        "glosses": [
                                            "mit drei Strahltriebwerken ausgestattet; über drei Strahltriebwerke verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837263ec-7ea5-4fb5-979b-651faff82eb4",
                                                "sense_id": "93e64edf-7969-31e8-af6a-1972e0b57e54",
                                                "text": "„Das dreistrahlige Kleinflugzeug fing Feuer und brannte trotz der Löschmaßnahmen völlig aus.“"
                                            },
                                            {
                                                "example_id": "cc421e9c-2308-4187-acfd-a1775f40e09d",
                                                "sense_id": "93e64edf-7969-31e8-af6a-1972e0b57e54",
                                                "text": "„Der im kanadischen Goose Bay nach Triebwerkschaden gestrandete Airbus-Riese soll noch im Dezember dreistrahlig nach Europa fliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
