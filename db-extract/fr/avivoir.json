                        "glosses": [
                            "Outil pour étaler l’amalgame de l’or."
                        ],
                        "tags": [
                            "Dorure ancienne"
                        ],
                        "examples": [
                            {
                                "example_id": "f82d2798-d86c-4b20-b286-278d7b050448",
                                "sense_id": "a610b250-1128-343b-8dd7-2bd7104aa583",
                                "text": "Aviver l’or. Terme de Doreur sur métal. C’est l’étendre avec l’avivoir, après qu’il a été amalgamé avec le vif-argent."
                            },
                            {
                                "example_id": "43e67ebb-4679-41f7-a6bb-1ef3ac2c9195",
                                "sense_id": "a610b250-1128-343b-8dd7-2bd7104aa583",
                                "text": "Alors on essuie la pièce avec un linge ; si elle reste noire, c’est une marque qu’il n’y a pas assez d’or ; dans ce cas, il faut remettre de nouveau de l’or avec l’avivoir, & recommencer l’opération indiquée."
                            }
                        ]
