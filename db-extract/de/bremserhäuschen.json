                "senses": [
                    {
                        "sense_id": "e1541f9e-140f-3843-a4a9-d5d6bca98ea9",
                        "entry_id": "6ee7aede-61c4-33f9-b634-54472d48c9d4",
                        "glosses": [
                            "kleiner Unterstand für den Bremser, angebaut am Ende eines Eisenbahnwagens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ea96d7c-bf84-4b73-9c12-678c858d0d9b",
                                "sense_id": "e1541f9e-140f-3843-a4a9-d5d6bca98ea9",
                                "text": "„Sie stellten sich auf die Trittbretter und auf die Stufen vor dem Bremserhäuschen.“"
                            },
                            {
                                "example_id": "6020f02d-b3bf-44e9-9b2a-46ebf7ffe9fa",
                                "sense_id": "e1541f9e-140f-3843-a4a9-d5d6bca98ea9",
                                "text": "„Mein Großvater Muhamed war Bremser. Schwitzte in seinem Bremserhäuschen im Sommer, fror im Winter.“"
                            },
                            {
                                "example_id": "fb686f46-1f2b-48c4-aa1c-f4a7be611c69",
                                "sense_id": "e1541f9e-140f-3843-a4a9-d5d6bca98ea9",
                                "text": "„Auf dem letzten Wagen, wo gewöhnlich das Bremserhäuschen zu finden ist, stand ein Maschinengewehr.“"
                            },
                            {
                                "example_id": "a3acc20e-9162-4bfa-9e48-8ab2d8a4cadb",
                                "sense_id": "e1541f9e-140f-3843-a4a9-d5d6bca98ea9",
                                "text": "„Der Zugführer brachte Kern zu dem Bremserhäuschen eines Güterwagens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
