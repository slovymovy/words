                    {
                        "sense_id": "1f2e1bdf-37f4-396a-90ea-0e4eae2dc12d",
                        "entry_id": "2d7cc5e4-78ac-3ad8-808d-e138ce44ee76",
                        "glosses": [
                            "Anything that is stunning.",
                            "A woman or man of stunning beauty or handsomeness (often hyperbolic), a knockout."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "774e34a9-9d64-4fad-a584-5087eb7aa691",
                                "sense_id": "1f2e1bdf-37f4-396a-90ea-0e4eae2dc12d",
                                "text": "She's a runner, rebel and a stunner / On her merry way sayin', \"Baby, what you gonna—?\""
                            }
                        ]
                    },
                    {
                        "sense_id": "cc378070-9e4c-31b5-b015-83a8e07071f8",
                        "entry_id": "2d7cc5e4-78ac-3ad8-808d-e138ce44ee76",
                        "glosses": [
                            "A professional wrestling maneuver in which an attacking wrestler applies a facelock to an opponent and falls to a seated position, forcing the opponent's jaw or neck to drop on the attacker's shoulder."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "22157853-a95e-3847-8355-2dfe39e4a235",
                        "entry_id": "2d7cc5e4-78ac-3ad8-808d-e138ce44ee76",
                        "glosses": [
                            "A pistol firing a beam capable of stunning an enemy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f76af4c-64d1-41fe-bc12-39f7abb96b99",
                                "sense_id": "22157853-a95e-3847-8355-2dfe39e4a235",
                                "text": "March holstered his pistol, reached into his coat, and drew out his own neural stunner, shifting the weapon to his right hand."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8f2dfd4-ef94-3785-afff-be1be43bc3c3",
                        "entry_id": "2d7cc5e4-78ac-3ad8-808d-e138ce44ee76",
                        "glosses": [
                            "A person or machine that stuns an animal before slaughter."
                        ],
                        "tags": [],
                        "examples": []
