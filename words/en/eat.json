                },
                {
                    "sense_id": "86f5300c-b58a-311b-a0d6-07ab7feeddbe",
                    "sense_definition": "To have a particular quality of diet or nutrition.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ingestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to <w>eat</w> healthy if you want to stay fit.",
                            "target_lang_translations": {
                                "ru": "Важно <w>питаться</w> правильно, если хочешь оставаться в форме."
                            }
                        },
                        {
                            "text": "The athlete <w>eats</w> well to maintain his energy levels.",
                            "target_lang_translations": {
                                "ru": "Спортсмен хорошо <w>питается</w>, чтобы поддерживать уровень энергии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eat healthy",
                        "eat well"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь определенный рацион или качество питания."
