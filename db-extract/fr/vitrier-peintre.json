                        "glosses": [
                            "Professionnel travaillant dans les domaines de la vitrerie et de la peinture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bd4c311-cb74-45fb-af8d-9716c79ff225",
                                "sense_id": "8195e014-48ba-3fe1-a046-8efa7681903b",
                                "text": "Des jetons des corporations des Traiteurs-pâtissiers et des vitriers-peintres sur verre portent assez souvent au ℟ des noms gravés en creux (cf. Preux, Ann. Soc. fr. Num., 1867, 259)."
                            },
                            {
                                "example_id": "c25b0c87-1576-4f72-afc1-bef0c5b44b54",
                                "sense_id": "8195e014-48ba-3fe1-a046-8efa7681903b",
                                "text": "Avez-vous des carreaux à remettre, des chambres à tapisser, des meubles à nettoyer, des cadres à dorer, des parquets à cirer, des tableaux à encadrer ou à revernir, le Vitrier-Peintre est prêt ; il entreprend au plus juste prix tout ce qui concerne son état."
                            }
                        ]
                    }
