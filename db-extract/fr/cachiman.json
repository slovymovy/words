                                    {
                                        "sense_id": "f5cb6f02-43c2-33a1-9d37-8f79d3810ee7",
                                        "entry_id": "d552280d-431f-3e65-8d35-6c9d992bdd7c",
                                        "glosses": [
                                            "A small tropical evergreen tree, Annona muricata."
                                        ],
                                        "tags": [],
