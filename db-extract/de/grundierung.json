                    {
                        "translation_id": "c7d750fa-7d6d-4eb7-aa84-81fe30ab1e93",
                        "source_entry_id": "3bd6c600-6b76-3aae-8fa4-fdf28d4207e8",
                        "source_sense_id": "fd70f378-ff65-3480-a3c4-93a6a9f3f7da",
