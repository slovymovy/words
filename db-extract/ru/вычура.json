                "senses": [
                    {
                        "sense_id": "517ff4b3-7c36-356e-8569-e96c9a6ffb4b",
                        "entry_id": "a7272484-9c09-3a98-a7d8-5cfc3d753667",
                        "glosses": [
                            "устар. разг. сложный, прихотливый узор на тканях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55a0c53-2933-4fb2-8adb-fec7bfe9979c",
                                "sense_id": "517ff4b3-7c36-356e-8569-e96c9a6ffb4b",
                                "text": "Заглавные буквы писал он с такими вычурами и завитками, что нельзя было достаточно насмотреться на его рукописи."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c766ab0-7980-3dd7-8711-5bce70a55403",
                        "entry_id": "a7272484-9c09-3a98-a7d8-5cfc3d753667",
                        "glosses": [
                            "перен. разг., причуда, излишняя затейливость, замысловатость"
                        ],
                        "tags": [
                            "обычно мн."
                        ],
                        "examples": [
                            {
                                "example_id": "886a061c-5dc6-4d01-9eae-66c18f90ba49",
                                "sense_id": "9c766ab0-7980-3dd7-8711-5bce70a55403",
                                "text": "Но истинно возвышенное чувство никаких этих округлений не знает и выражается просто, трезво, без вычур."
                            },
                            {
                                "example_id": "6f695baf-c9d4-469e-ae45-bab9fa25d37c",
                                "sense_id": "9c766ab0-7980-3dd7-8711-5bce70a55403",
                                "text": "Ну хорошо, ― пускай изысканность, но зачем же вычура?"
                            },
                            {
                                "example_id": "2f61a38e-151b-46ed-90c8-fab95740e019",
                                "sense_id": "9c766ab0-7980-3dd7-8711-5bce70a55403",
                                "text": "Толстяк Гастон, будучи полон вычур, любил делать подарки ― подарки чуть-чуть тоже вычурные или по крайней мере необыкновенные, на его вычурный вкус."
                            }
                        ]
                    }
