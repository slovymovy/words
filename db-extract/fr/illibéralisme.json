                ],
                "senses": [
                    {
                        "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                        "entry_id": "8d7ca526-4268-31b8-9312-5d0bcbebf3c8",
                        "glosses": [
                            "Refus du libéralisme politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52c139c7-1941-419c-bff3-16835258730e",
                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                "text": "C’est à tort qu’on accuserait d’illibéralisme ceux qui sont partisans du maintien de la contrainte par corps."
                            },
                            {
                                "example_id": "7c41036a-dd01-4eb1-adf7-7e83fc1317c3",
                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                "text": "Plusieurs régimes politiques sont tentés par l’illibéralisme politique."
                            },
                            {
                                "example_id": "beef95c2-0ba6-4ea1-b3b7-7985be876812",
                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                "text": "Cette montée de l’illibéralisme a au moins un mérite : elle nous oblige à devoir nous rappeler en quoi nous croyons et pour quelles valeurs nous sommes prêts à nous battre."
                            },
                            {
                                "example_id": "ed28665d-70f7-4e20-a359-d473d038ca42",
                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                "text": "Un peu plus à l’est, en Pologne et en Hongrie, c’est l’autoritarisme de la vieille école qui revient en force : illibéralisme, recul des droits des femmes, de la liberté de la presse et de l’indépendance de la justice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cb66aae-9fbe-4b03-a34b-935f2dc6b22a",
