                    {
                        "translation_id": "dd0ee8bf-fee0-481a-8c66-4a1cdc89b236",
                        "source_entry_id": "7a6a8ca1-a669-3af7-ab7b-e23e83535fb9",
                        "source_sense_id": "5764f3c6-5062-3360-90a1-1604b7023c8e",
                        "source_sense_description": "veraltet: weiße Schminke",
                        "target_lang_word": "Schminke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schminke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                        "entry_id": "e075093e-cee5-307c-8cc9-09db54661a33",
                                        "glosses": [
                                            "Substanz oder Produkt zur farblichen Gestaltung von Haut, Augen oder Gesicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c17e769-0805-4938-a934-50f7ee00f669",
                                                "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                                "text": "Frau Obermayer trägt immer Schminke und Parfüm auf, bevor sie das Haus verlässt."
                                            },
                                            {
                                                "example_id": "e344c95c-c5de-4936-b7d4-05356ee69a1f",
                                                "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                                "text": "Für Film und Fernsehen wird andere Schminke benutzt als normal."
                                            },
                                            {
                                                "example_id": "2778a4f8-42ec-4efe-b98e-38df060f8a6c",
                                                "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                                "text": "Manche stehen eher auf dezente als auf grelle Schminke."
                                            },
                                            {
                                                "example_id": "58af2a3c-76d6-48b1-bf38-656f628ba705",
                                                "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                                "text": "„Entweder verwahrte sie etwas anderes darin oder benutzte die Schminke nur zu besonderen Gelegenheiten.“"
                                            },
                                            {
                                                "example_id": "99656681-14a9-4fd5-87d6-ee02ff2ba223",
                                                "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                                "text": "„Die dick aufgetragene Schminke konnte ihr hohes Alter nicht verbergen.“"
                                            },
                                            {
                                                "example_id": "b744a834-ea7e-4ce7-b86e-0aee5bd8ec9e",
                                                "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                                "text": "„Ohne Schminke fühle ich mich ungeschützt, sehr privat, fast nackt.“"
                                            },
                                            {
                                                "example_id": "6b762cd5-d14f-4bbe-9322-1f81e3021222",
                                                "sense_id": "7ea0be15-8781-3276-b1d9-fe8e16d6d9fd",
                                                "text": "„Goldlotos ging zunächst in ihr Zimmer, glättete die Schminke auf ihrem Antlitz und begab sich auch in jene Gemächer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
