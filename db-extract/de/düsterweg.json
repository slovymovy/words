                "senses": [
                    {
                        "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                        "entry_id": "ab2e2ed4-806f-3679-a890-66689282a352",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44eba8b5-9fb0-4b5a-8396-f727e739f2c3",
                                "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                                "text": "Frau Düsterweg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dec160e6-2d0e-4e78-9e75-a9b06c7f01ee",
                                "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                                "text": "Herr Düsterweg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "add9b082-c880-4225-b02e-ecc80e7cbeda",
                                "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                                "text": "Die Düsterwegs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7b5a526b-41bc-4c10-a06c-dfef45a39ccd",
                                "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                                "text": "Der Düsterweg trägt nie die Schals, die die Düsterweg ihm strickt."
                            },
                            {
                                "example_id": "4565c3e2-9b3c-4d78-b871-54b8c54e9b3e",
                                "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Düsterweg kommt, geht der Herr Düsterweg.“"
                            },
                            {
                                "example_id": "f67a18f6-229e-4e05-96ee-d34cb890ec3d",
                                "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                                "text": "Düsterweg kommt und geht."
                            },
                            {
                                "example_id": "d381aa35-8ecb-4f4c-80b6-495f4bb4ba91",
                                "sense_id": "d11e88cd-1f87-36cd-ba00-e301a313756e",
                                "text": "Düsterwegs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
