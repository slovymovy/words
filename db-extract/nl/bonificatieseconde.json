                        "sense_id": "d268e857-c2ec-396d-9f66-6acef9577db6",
                        "entry_id": "8266295a-c75a-3e34-8fbd-8cdf3fd8d0e7",
                        "glosses": [
                            "aftrek van één seconde van de eindtijd van een renner in een snelheidswedstrijd die men kan behalen door het winnen van een tussensprint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab31ecb-22a1-4c89-9300-50dced67dc2d",
                                "sense_id": "d268e857-c2ec-396d-9f66-6acef9577db6",
                                "text": "Marcel Kittel pakt de zege. Het ging wel heel makkelijk. Vanuit derde positie kroop hij naar voren en met speels gemak sprint hij naar de zege. Hij pakt 10 seconden bonificatieseconden. Arnaud Démare werd tweede, Sacha Modolo derde. Tom Dumoulin blijft in het roze."
                            },
                            {
                                "example_id": "233f56a9-6ee9-45ec-a5b9-32c55a431c4d",
                                "sense_id": "d268e857-c2ec-396d-9f66-6acef9577db6",
                                "text": "Rubio wint de tussensprint in Valls voor Rossetto en verdient drie bonificatieseconden. In het peloton komt Wout Poels als eerste over de streep. Toch een bescheiden Nederlands succesje: hij verdient één bonificatieseconde."
                            }
                        ]
                    }
