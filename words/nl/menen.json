                {
                    "sense_id": "ea696ab4-f4dd-336c-a4ba-b557cdeddfec",
                    "sense_definition": "De intentie hebben; beogen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>meende</w> het goed, ook al kwam zijn opmerking verkeerd over.",
                            "target_lang_translations": {
                                "en": "He <w>meant</w> well, even though his remark came across wrong.",
                                "ru": "Он <w>хотел</w> как лучше, даже если его замечание было воспринято неправильно.",
                                "pl": "<w>Chciał dobrze</w>, nawet jeśli jego uwaga została źle odebrana.",
                                "de": "Er <w>meinte</w> es gut, auch wenn seine Bemerkung falsch ankam.",
                                "fr": "Il <w>avait de bonnes intentions</w>, même si sa remarque a été mal interprétée.",
                                "it": "Lui <w>aveva buone intenzioni</w>, anche se la sua osservazione è stata fraintesa.",
                                "cs": "<w>Myslel</w> to dobře, i když jeho poznámka vyzněla špatně.",
                                "tr": "Yaptığı yorum yanlış anlaşıldıysa da <w>iyi niyetliydi</w>.",
                                "es": "Él <w>tenía buenas intenciones</w>, aunque su comentario se entendió mal.",
                                "zh": "他的<w>本意是</w>好的，尽管他的话让人误解了。"
                            }
                        },
                        {
                            "text": "Ik <w>meende</w> jou niet met die kritische opmerking.",
                            "target_lang_translations": {
                                "en": "I didn't <w>mean</w> you with that critical remark.",
                                "ru": "Я не <w>имел в виду</w> тебя, делая это критическое замечание.",
                                "pl": "Nie <w>miałem na myśli</w> ciebie, robiąc tę krytyczną uwagę.",
                                "de": "Ich <w>meinte</w> nicht dich mit dieser kritischen Bemerkung.",
                                "fr": "Je ne <w>visais</w> pas toi avec cette remarque critique.",
                                "it": "Non <w>mi riferivo</w> a te con quell'osservazione critica.",
                                "cs": "Tou kritickou poznámkou jsem <w>nemyslel</w> tebe.",
                                "tr": "O eleştirel yorumla seni <w>kastetmemiştim</w>.",
                                "es": "No <w>me refería</w> a ti con ese comentario crítico.",
                                "zh": "我那句批评的话并不是在<w>指</w>你。"
                            }
                        }
