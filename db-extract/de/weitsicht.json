                                "target_senses": [
                                    {
                                        "sense_id": "1ac6d188-8e1f-383e-91a5-153a81a65611",
                                        "entry_id": "659ae30d-162b-3be3-be98-bf0cd10350dd",
                                        "glosses": [
                                            "Alternative form of farsightedness."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb819a2a-2c2e-4ae4-a732-a793ab26dc37",
                                                "sense_id": "1ac6d188-8e1f-383e-91a5-153a81a65611",
                                                "text": "Marc Brunel was a royalist refugee from revolutionary France. He specialised in ideas that were ahead of their time - of which he seems to have had one a week - and he had a gift for making those around him seem churlish and reactionary in comparison to his own far-sightedness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7dc45b3-ae95-42be-b029-7aea50e898ac",
