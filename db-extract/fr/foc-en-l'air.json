                    }
                ],
                "translations": [
                    {
                        "translation_id": "22e2699b-26d2-409d-9847-c38080eaa036",
                        "source_entry_id": "f5f70c0c-e903-359d-beaf-0c3404725cd3",
                        "source_sense_id": "e06cfa86-9857-34a7-9469-3fca766381ac",
                        "target_lang_word": "Flieger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flieger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                        "entry_id": "00c5ae23-680a-35a0-b67d-c499c8c3c05b",
                                        "glosses": [
                                            "Führer eines Fluggerätes"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d8497bb-be4b-4b12-bc11-30625fbb7a1b",
                                                "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                                "text": "„Ich wollte schon immer Flieger werden.“"
                                            },
                                            {
                                                "example_id": "9df7652f-01dc-4f0a-942c-433012bd9b3d",
                                                "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                                "text": "Er war lange Jahre als Flieger bei der Luftwaffe."
                                            },
                                            {
                                                "example_id": "2ce3c351-d812-4840-9666-a4c20bffe6aa",
                                                "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                                "text": "„Ich muss mich vorne auf den Flieger verlassen können. Aber als er einstieg, schwankte er und sah betrunken aus!“"
                                            },
                                            {
                                                "example_id": "f5b5a2db-2675-4fbb-9cb3-065ea260da7b",
                                                "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                                "text": "„Am Himmel leuchteten die Augen des auf die Erde verbannten Fliegers, der sich noch nicht an kleinere Maßstäbe, an begrenzte Räume gewöhnt hatte.“"
                                            },
                                            {
                                                "example_id": "1efaac84-52c9-4b5c-a7df-f9424ca36777",
                                                "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                                "text": "„Wenn es gelingt, […] die Auf- und Abwinde richtig einzuschätzen, den Drachen optimal zu steuern, fehlerfrei zu navigieren, dann stellen sich dem Flieger schon während seiner Tätigkeit positive Rückmeldungen ein, die in einen Flow-Zustand versetzen können.“"
                                            },
                                            {
                                                "example_id": "5d505980-e3c8-4a01-a3ec-549efb52816c",
                                                "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                                "text": "„Bei der Luftwaffe entstanden Männerfreundschaften, ein jeder sprang für den anderen ein, und alle bewunderten die tollen Flieger mit ihren Maschinen.“"
                                            },
                                            {
                                                "example_id": "e9160043-2480-4bff-8643-d23c777fe05d",
                                                "sense_id": "2c2b30bf-23ac-31db-b9f4-f9c53633d0b8",
                                                "text": "„Der Flieger tauscht die Sicht eines Wurms mit der eines Adlers.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80888d7d-1e22-3b2a-836f-fe3eef8ba069",
                                        "entry_id": "00c5ae23-680a-35a0-b67d-c499c8c3c05b",
                                        "glosses": [
                                            "flugtüchtiges Verkehrsmittel, welches Tragflächen besitzt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b72e5061-d161-477a-b018-7df86051cb8f",
                                                "sense_id": "80888d7d-1e22-3b2a-836f-fe3eef8ba069",
                                                "text": "„Ich muss mich beeilen, da ich sonst meinen Flieger nach Rom verpasse.“"
                                            },
                                            {
                                                "example_id": "bee353ab-f100-4bf2-b8d2-8737f17580b6",
                                                "sense_id": "80888d7d-1e22-3b2a-836f-fe3eef8ba069",
                                                "text": "„Machen sie schnell, mein Flieger geht in zehn Minuten.“"
                                            },
                                            {
                                                "example_id": "9841001e-9a49-4525-bc55-330cb5b9b207",
                                                "sense_id": "80888d7d-1e22-3b2a-836f-fe3eef8ba069",
                                                "text": "Der Euro Hawk, ein unbemannter Flieger mit 40 Metern Flügelspannweite, sollte der Bundeswehr dazu dienen, aus 20.000 Metern Höhe Daten eines Gegners, etwa Sprechverbindungen, auszuspähen sowie gegnerische Radars zu erkennen."
                                            },
                                            {
                                                "example_id": "ebecebb6-14f2-4ba4-95f0-4ac15d625281",
                                                "sense_id": "80888d7d-1e22-3b2a-836f-fe3eef8ba069",
                                                "text": "„Ein deutscher Flieger nach dem andern stieg auf, aber kein französischer zeigte sich.“"
                                            },
                                            {
                                                "example_id": "b0791d88-2c09-404c-9382-f166b3ff1318",
                                                "sense_id": "80888d7d-1e22-3b2a-836f-fe3eef8ba069",
                                                "text": "„Es wehte ein scharfer Wind, während sie zur Besucherterrasse des Flughafens gingen, und wenn die Flieger abhoben, schmerzte der Lärm in den Ohren mehr als das Dröhnen in einer Diskothek.“"
                                            },
                                            {
                                                "example_id": "cb34af00-3d0b-4df2-9a9d-88151941e8ad",
                                                "sense_id": "80888d7d-1e22-3b2a-836f-fe3eef8ba069",
                                                "text": "Der portugiesische Staat hat es nämlich in den vergangenen Jahrzehnten versäumt, eine Flotte von Hubschraubern und Fliegern zu erwerben, um die Brände aus der Luft zu bekämpfen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5e82a8c7-3630-3384-986a-cc0c8b383295",
                                        "entry_id": "00c5ae23-680a-35a0-b67d-c499c8c3c05b",
                                        "glosses": [
                                            "spezielles, in einiger Höhe über Deck vor dem Klüver geführtes Vorsegel mancher Segelschiffe"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bead9981-e283-43fc-b5ed-0799987638ad",
                                                "sense_id": "5e82a8c7-3630-3384-986a-cc0c8b383295",
                                                "text": "Sie reparierten den Flieger auf hoher See."
                                            },
                                            {
                                                "example_id": "ed1d875f-b2dc-4557-976b-d08d88f2319c",
                                                "sense_id": "5e82a8c7-3630-3384-986a-cc0c8b383295",
                                                "text": "„Hol den Flieger ein, es ist zu viel Wind!“"
                                            },
                                            {
                                                "example_id": "61e66fb5-c681-4fcd-831c-796afc4d31dd",
                                                "sense_id": "5e82a8c7-3630-3384-986a-cc0c8b383295",
                                                "text": "„Wir können auch noch den Flieger hissen, dann werden wir etwas schneller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
