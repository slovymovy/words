                    {
                        "sense_id": "e3bcc261-e91d-3fea-a6f9-79487dabefaa",
                        "entry_id": "2e89d242-1b6d-3f4a-a25f-76a5421e755d",
                        "glosses": [
                            "een brok min of meer vaste stof in een vloeiende massa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2240360-19ff-47f2-92d8-f2bac1889791",
                                "sense_id": "e3bcc261-e91d-3fea-a6f9-79487dabefaa",
                                "text": "Je moet goed roeren anders krijg je klonters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f34a318-f61a-42e3-b391-40236d344032",
                        "source_entry_id": "2e89d242-1b6d-3f4a-a25f-76a5421e755d",
                        "source_sense_id": "e3bcc261-e91d-3fea-a6f9-79487dabefaa",
                        "source_sense_description": "een brok min of meer vaste stof in een vloeiende massa",
                        "target_lang_word": "Klümpchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klümpchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5518a335-298f-3587-9eaa-5824a2d37324",
                                        "entry_id": "44847d03-f49c-30b7-be53-8e02a7c5a525",
                                        "glosses": [
                                            "kleiner Klumpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4350b71f-76be-4881-b82c-853d3d686d41",
                                                "sense_id": "5518a335-298f-3587-9eaa-5824a2d37324",
                                                "text": "„Er war ein braver, brauner, breiter Mann, die Finger und Daumen gespreizt, wie noch immer bereit, das kleinste Klümpchen Mehl zu ergreifen und zu zerreiben.“"
                                            },
                                            {
                                                "example_id": "1a25afac-d526-4ff1-89e4-8586f40c582b",
                                                "sense_id": "5518a335-298f-3587-9eaa-5824a2d37324",
                                                "text": "„Sie graben nach Gold, manche mit bloßen Händen. […] Er präsentiert ein winziges Klümpchen Gold, das Ergebnis von einer Woche Mühsal.“"
                                            },
                                            {
                                                "example_id": "33160f18-1557-4168-9631-207e98f5cd35",
                                                "sense_id": "5518a335-298f-3587-9eaa-5824a2d37324",
                                                "text": "„Wie glücklich wäre er gewesen, hätte sich nur aus seinem Hirn das kleine Knötchen oder Klümpchen geronnenes Blut wegschaffen lassen, welches sein Gefühlsvermögen lähmte.“"
                                            },
                                            {
                                                "example_id": "5553487f-b1a8-4ee0-b52c-70dcecebde2d",
                                                "sense_id": "5518a335-298f-3587-9eaa-5824a2d37324",
                                                "text": "„Das Blut floß noch immer in großen Tropfen und hing in geronnenen Klümpchen am seidenen Tuche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "056ef855-2f8b-38d5-bd6b-0750034b094e",
                                        "entry_id": "44847d03-f49c-30b7-be53-8e02a7c5a525",
                                        "glosses": [
                                            "Süßigkeit zum Lutschen; Bonbon"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fd98427-7bc2-4302-ba30-514aa0a99db4",
                                                "sense_id": "056ef855-2f8b-38d5-bd6b-0750034b094e",
                                                "text": "„Sämtliche Klümpchen klebten dann fest zusammen, wenn man sie am Karsamstag aus dem Glas nehmen wollte“, erinnert sich der Pastor schmunzelnd an eine vor Jahrzehnten auf dem Land bei vielen Kindern noch weit verbreitete Form des strengen Verzichts (…)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
