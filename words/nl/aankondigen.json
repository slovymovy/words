    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce2680f6-4da2-3a28-a4e2-8bcc3768ea15",
                    "sense_definition": "iets officieel of in het openbaar vertellen of laten weten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bekendmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur zal morgen de nieuwe plannen voor het bedrijf <w>aankondigen</w>.",
                            "target_lang_translations": {
                                "en": "The director will <w>announce</w> the new plans for the company tomorrow."
                            }
                        },
                        {
                            "text": "De Britse premier heeft donderdag <w>aangekondigd</w> op te stappen.",
                            "target_lang_translations": {
                                "en": "The British Prime Minister <w>announced</w> on Thursday that he is stepping down."
                            }
                        },
                        {
                            "text": "De voorzitter zal bij aanvang van de vergadering een extra agendapunt <w>aankondigen</w>.",
                            "target_lang_translations": {
                                "en": "The chairman will <w>announce</w> an additional agenda item at the start of the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekendmaken"
                    ],
                    "common_phrases": [
                        "een bezoek aankondigen",
                        "een maatregel aankondigen",
                        "extra agendapunt aankondigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to tell or let something be known officially or in public"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "announce",
                                "target_lang_sense_clarification": "to make something known publicly"
                            },
                            {
                                "target_lang_word": "declare",
                                "target_lang_sense_clarification": "to state something formally"
                            },
                            {
                                "target_lang_word": "proclaim",
                                "target_lang_sense_clarification": "to announce officially or publicly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "689233e7-0123-37c1-b61e-2d20db84f3be",
                    "sense_definition": "een teken zijn dat er iets gaat gebeuren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voorspellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Donkere wolken <w>kondigen</w> vaak een zware storm <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "Dark clouds often <w>herald</w> a heavy storm."
                            }
                        },
                        {
                            "text": "Extreme vermoeidheid kan soms een hartaanval <w>aankondigen</w>.",
                            "target_lang_translations": {
                                "en": "Extreme fatigue can sometimes <w>signal</w> a heart attack."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een storm aankondigen",
                        "het einde aankondigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be a sign that something is about to happen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "herald",
                                "target_lang_sense_clarification": "to be a sign that something is beginning"
                            },
                            {
                                "target_lang_word": "signal",
                                "target_lang_sense_clarification": "to indicate that something will occur"
                            },
                            {
                                "target_lang_word": "prefigure",
                                "target_lang_sense_clarification": "to suggest or show beforehand"
                            },
                            {
                                "target_lang_word": "foreshadow",
                                "target_lang_sense_clarification": "to be a warning or indication of a future event"
                            }
                        ]
                    }
                }
            ]
        }
    ]
