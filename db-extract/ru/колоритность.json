                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "006fc918-b94c-42f2-8c0f-ed733bdbc242",
                        "source_entry_id": "e3ca8723-0990-394c-ba42-16cf5092d3bb",
                        "source_sense_id": "a5e71b7f-0866-3831-bfa5-a2c0b0bb3ff5",
                        "target_lang_word": "picturesqueness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "picturesqueness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51639143-7ca3-3f60-b8da-e56b12756f00",
                                        "entry_id": "e503c0dc-f42f-36ef-a9ba-957f88df285f",
                                        "glosses": [
                                            "The condition of being picturesque."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ee7984-1304-4e59-9797-000743dcfbb2",
                                                "sense_id": "51639143-7ca3-3f60-b8da-e56b12756f00",
                                                "text": "He [Walter Savage Landor] was a man of somewhat leonine aspect as regards the general appearance and expression of the head and face, which accorded well with the large and massive build of the figure, and to which a superbly curling white beard added not only picturesqueness, but a certain nobility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8efca1c7-6129-4c2b-96f6-a8fe068d393b",
                        "source_entry_id": "e3ca8723-0990-394c-ba42-16cf5092d3bb",
                        "source_sense_id": "a5e71b7f-0866-3831-bfa5-a2c0b0bb3ff5",
                        "target_lang_word": "vividness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vividness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adf080d3-662c-3656-ae20-5ba1773e5330",
                                        "entry_id": "ea5dd055-cdfe-30b8-ba6c-757fbcbd5292",
                                        "glosses": [
                                            "The quality or state of being vivid."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c771f2e8-05a3-4076-8214-9a1574622007",
                                                "sense_id": "adf080d3-662c-3656-ae20-5ba1773e5330",
                                                "text": "I felt light-headed; grotesque hallucinations materialised before me with startling vividness."
                                            },
                                            {
                                                "example_id": "01a67baa-a6b6-456c-9be0-a2c719fbc91e",
                                                "sense_id": "adf080d3-662c-3656-ae20-5ba1773e5330",
                                                "text": "As the rest of the film was made on location in the railway yards of Havre and not in a studio, and was given a sound-track of penetrating vividness, this whole production gives the closest possible ring of truth of any film about railways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
