                ],
                "senses": [
                    {
                        "sense_id": "3c192474-2fcc-370b-a450-b34f2b3557ae",
                        "entry_id": "af3916f2-21bf-3ccb-af0e-74abbb2bd2e7",
                        "glosses": [
                            "получить освобождение от выполнения каких-либо обязанностей; уйти с работы, со службы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2bfb062-b2b7-4007-8cf3-829074183946",
                                "sense_id": "3c192474-2fcc-370b-a450-b34f2b3557ae",
                                "text": "Капитан уволился, и на место его поступил другой, строгий, начальник."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeb9b92a-a477-3286-a29f-cc0930ded9b5",
                        "entry_id": "af3916f2-21bf-3ccb-af0e-74abbb2bd2e7",
                        "glosses": [
                            "получить временное освобождение от выполнения служебных обязанностей, учёбы и т. п. (о военнослужащих, курсантах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af9d0ef-6ef5-41db-80ce-afd14cadd476",
                                "sense_id": "eeb9b92a-a477-3286-a29f-cc0930ded9b5",
                                "text": "Уволиться в отпуск. Уволиться в запас. Уволиться в город."
                            },
                            {
                                "example_id": "2ab042d9-30be-4c44-9654-8907153ac2a7",
                                "sense_id": "eeb9b92a-a477-3286-a29f-cc0930ded9b5",
                                "text": "Случилось, что в следующий четверг уволиться было Дмитрию нельзя. Зато в среду он выходил из наряда и тут нетрудно было отпроситься хотя бы на четыре часа."
                            }
                        ]
                    }
                ],
