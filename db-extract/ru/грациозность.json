                        "cross_references": [
                            {
                                "target_word": "graciosidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "365fc340-079c-3cff-b388-4242f88678ad",
                                        "entry_id": "e5361aae-1d83-38a6-9c50-f6406872b713",
                                        "glosses": [
                                            "Comentario, ocurrencia o suceso que resulta agradable, agudo o gracioso."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b18d926-77ff-390d-91eb-cf2425af641f",
                                        "entry_id": "e5361aae-1d83-38a6-9c50-f6406872b713",
                                        "glosses": [
                                            "Condición o carácter de cómico o divertido."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a76064d6-23ae-3451-8a0d-d252c7c07d1e",
                                        "entry_id": "e5361aae-1d83-38a6-9c50-f6406872b713",
                                        "glosses": [
                                            "Conjunto de cualidades que hacen agradable o apreciable o atractiva a la cosa o persona que las tiene."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545b6c26-2c8d-46e0-afad-d0e8a3aa81de",
                                                "sense_id": "a76064d6-23ae-3451-8a0d-d252c7c07d1e",
                                                "text": "Porque la fortaleza sin la belleza y gracia, es temeridad; y la belleza y graciosidad sin fortaleza y entereza, es relajación"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52512765-3a77-492a-802c-8fb01402f859",
                        "source_entry_id": "81957685-cb8c-3f32-bba3-73c5ff60cc81",
                        "source_sense_id": "0f6cf8bb-1544-34c7-a523-d76efcc150e8",
                        "target_lang_word": "gracia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gracia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "979155b2-c4d1-3d7a-830f-064c373081a5",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Predisposición a favorecer o proteger a alguien, especialmente sin contrapartida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928045b6-5c11-4b97-8cc1-6369f906bc57",
                                                "sense_id": "979155b2-c4d1-3d7a-830f-064c373081a5",
                                                "text": "Perdió mi gracia por su inobediencia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81e38b7c-1adf-3c65-b50b-afdf53436874",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Por extensión, acción o efecto de favorecer o proteger a alguien."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c6d75f0b-6990-34e9-a907-74c03f354364",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Cosa que se concede para favorecer o proteger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d55fcc44-7cba-479a-9000-932498c1b656",
                                                "sense_id": "c6d75f0b-6990-34e9-a907-74c03f354364",
                                                "text": "Determinó el Senado antes que esta hinchazón reventase, fundar una colonia en Saticico y enviar dos mil plebeyos a ella, señalando a cada uno dos yugadas y media de tierra. No quisieron aceptar esta gracia del Senado, pareciéndoles corto el repartimiento y pocos los que iban respecto de los muchos adeudados que había."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9c8f3d24-9879-3a11-9922-88a72e53a4c4",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "En particular, gracia₃ que concede Dios para alcanzar la salvación o para nutrir y sostener el alma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d6b7a5-1420-40c7-b2cc-f614697c0b35",
                                                "sense_id": "9c8f3d24-9879-3a11-9922-88a72e53a4c4",
                                                "text": "Pues quien tantos bienes haze\ny tantos males escusa,\npues al justo Dios aplaze,\nmuy justa tiene la escusa;\ninjustamnte se acusa\nla que destruye los vicios\ny da tales beneficios\npor gracia de Dios infusa."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "88125f7b-b1b6-3038-b8f2-2825ac19d06d",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "En particular, gracia₃ que concede una autoridad para perdonar o indultar una pena judicial."
                                        ],
                                        "tags": [
                                            "Derecho"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2aeacdba-6d73-3ac1-971d-7dc231c0cda2",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Capacidad espontánea para realizar bien alguna cosa difícil."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "04925841-1fd1-3cc3-aaa4-1bb7a75b165c",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "En particular, gracia₆ para tratar con delicadeza y afabilidad a las personas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "21b72ccb-058d-3789-b65d-ace789df77ed",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "En particular, gracia₆ para moverse de manera ágil y atractiva."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "80d6c477-5b7f-3999-b01e-fb83abf78e37",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "En particular, gracia₆ para divertir o hacer reír."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5230224e-5309-42aa-988e-d29f86190cec",
                                                "sense_id": "80d6c477-5b7f-3999-b01e-fb83abf78e37",
                                                "text": "El singular en gracia, el ingenioso\nLope de Rueda, el cómico tablado\nhizo ilustre con él, y deleitoso."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "51b05bb4-cfb2-3405-80c2-768b73a80d36",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Por extensión, gracia₆ para sorprender."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "03a275ff-b559-3737-9c26-f05bb96bb0dc",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Cosa, acción o expresión que tiene gracia_(9–10)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80da8969-da5e-4818-9370-c8b347fb56d8",
                                                "sense_id": "03a275ff-b559-3737-9c26-f05bb96bb0dc",
                                                "text": "Y la dama, no menos bachillera,\nMetáforas derrame y epítetos.\n¡Qué gracia verla hablar como si fuera\nUn doctor in utroque!"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    },
                                    {
                                        "sense_id": "1d8c8b00-1c34-3b38-9aa2-f2cca683110e",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "En particular, gracia₁₁ de un niño que le granjea el aprecio o favor de los adultos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"12\""
                                    },
                                    {
                                        "sense_id": "4b43a6e4-ed34-3053-88d6-7d9be8dadb65",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Irónicamente, cosa, acción o expresión que molesta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4418a391-733b-4a34-b3a7-1a689e93c147",
                                                "sense_id": "4b43a6e4-ed34-3053-88d6-7d9be8dadb65",
                                                "text": "Más tarde ‘un zángano’ de los que tanto abundan en la sierra —como en todas partes— hizo la gracia de ‘asesinar’ a aquel bello animal, matándolo de un postazo."
                                            }
                                        ],
                                        "sense_index_json": "\"13\""
                                    },
                                    {
                                        "sense_id": "cc76734a-cec9-3a54-ac4f-c88ed701a385",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Impresión que causa una gracia_(11–13)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"14\""
                                    },
                                    {
                                        "sense_id": "b731b652-fc16-3098-b2e8-acc4d7d2e19c",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Más generalmente, cualidad cualquiera que hace apreciable una cosa."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"15\""
                                    },
                                    {
                                        "sense_id": "4ccaae18-21b8-3e0a-bb2a-0f8b44bb857d",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "En particular, gracia₁₅ que hace atractivo a alguien o algo independiente de su belleza formal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c76f4ca-7ec3-498e-98a7-9298a1470094",
                                                "sense_id": "4ccaae18-21b8-3e0a-bb2a-0f8b44bb857d",
                                                "text": "Excederá en mi gracia y hermosura\nA los continos de mi eterno estado,\nHermosa mas que el cielo, sol y luna,\nQue será Madre y Vírgen, fénix una."
                                            }
                                        ],
                                        "sense_index_json": "\"16\""
                                    },
                                    {
                                        "sense_id": "b230e499-f224-3383-bf8c-59aa14e9c807",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Parte del nombre propio del individuo, que le distingue específicamente, en especial de otros miembros de su familia o grupo que puedan compartir su apellido, patronímico, etc."
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07458e78-64b0-47b3-8c79-0202f3389df4",
                                                "sense_id": "b230e499-f224-3383-bf8c-59aa14e9c807",
                                                "text": "¿Cómo es su gracia, señora mia?\n —Rufina Cantos, viuda de Muñoz, para servir a usted."
                                            }
                                        ],
                                        "sense_index_json": "\"17\""
                                    },
                                    {
                                        "sense_id": "14c37bd0-e87d-3c96-861a-129e33ac1d10",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Responso que se dice en casa de un difunto tras el entierro."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"18\""
                                    },
                                    {
                                        "sense_id": "7fe02221-3bc6-36cb-821c-d5b3563b9988",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Procesión que acompaña a los deudos luego del entierro para decir gracia₁₈."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"19\""
                                    },
                                    {
                                        "sense_id": "3ccad347-6df1-38d1-a609-166898fb0e82",
                                        "entry_id": "e6b202e4-7727-32ba-b686-f624f9a08579",
                                        "glosses": [
                                            "Trazo ornamentalque remata el asta, cola o brazo de algunos tipos de letra, para mejorar su legibilidad y dotarlos de un aspecto más elegante. Las fuentes que los emplean se denominan, según la clase, romanas o egipcias, mientras que las que no cuentan con ellos se llaman paloseco."
                                        ],
