                "senses": [
                    {
                        "sense_id": "426156a5-0872-385f-9801-ec3654449465",
                        "entry_id": "8ef9690a-bb7d-3f7e-bd1c-11cc9c18e771",
                        "glosses": [
                            "жёлтый с красноватым оттенком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39987f30-62cf-48b6-97a9-70833fc299ae",
                                "sense_id": "426156a5-0872-385f-9801-ec3654449465",
                                "text": "Но тут в глаза крепкому хозяйственнику ударил красновато-жёлтый цвет скульптур."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d42b5217-b585-4d79-9636-56ca72ae1034",
                        "source_entry_id": "8ef9690a-bb7d-3f7e-bd1c-11cc9c18e771",
                        "source_sense_id": "426156a5-0872-385f-9801-ec3654449465",
                        "target_lang_word": "ockerfarben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ockerfarben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81ba8a2c-43f6-3bd1-9bb3-f94d4f8add8c",
                                        "entry_id": "54ba524c-dfe5-367c-8d79-5d6d1207e3b0",
                                        "glosses": [
                                            "die Farbe von Ocker habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57dbd9eb-430b-4a77-a316-0547640b6aa3",
                                                "sense_id": "81ba8a2c-43f6-3bd1-9bb3-f94d4f8add8c",
                                                "text": "„Im obersten Zimmer des Hauses, einem erscheckend engen, schlauchförmigen Gelass, hatte der junge McNeal allem Anschein nach die Toten herbeizitiert, und auf seine Veranlassung hin hatten sie ausführlich Zeugnis von ihren Besuchen abgelegt, indem sie mit hunderterlei Handschriften die fahlen ockerfarbenen Wände beschrieben.“"
                                            },
                                            {
                                                "example_id": "127d5dd3-ddef-443d-901b-bef4fd0400ae",
                                                "sense_id": "81ba8a2c-43f6-3bd1-9bb3-f94d4f8add8c",
                                                "text": "„Blassgrüne Vipern hoben ihre Köpfe von umgestürzten Kakteenstämmen und musterten mich aus hellen, ockerfarbenen Augen ohne Lider oder Pupillen.“"
                                            },
                                            {
                                                "example_id": "c42a7bcd-1645-4f08-b57d-e359791f68ae",
                                                "sense_id": "81ba8a2c-43f6-3bd1-9bb3-f94d4f8add8c",
                                                "text": "„Keine ockerfarbene Tätowierung färbte ihre Wange, denn sie war noch nicht vermählt.“"
                                            },
                                            {
                                                "example_id": "b54d08aa-b849-4364-b38a-a8d7ea070c7e",
                                                "sense_id": "81ba8a2c-43f6-3bd1-9bb3-f94d4f8add8c",
                                                "text": "„Um diese Uhrzeit am späten Vormittag betrug die Sichtweite im trüben Fluss neun Meter unter der ockerfarbenen Oberfläche des warmen Wassers kaum mehr als 30 Zentimeter.“"
                                            },
                                            {
                                                "example_id": "035f85bb-e2d8-484b-bc0d-7c2d80dfa5a7",
                                                "sense_id": "81ba8a2c-43f6-3bd1-9bb3-f94d4f8add8c",
                                                "text": "„Über dem Zentrum von Singapur hing ein leichter, ockerfarbener Dunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
