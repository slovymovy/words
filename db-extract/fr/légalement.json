                "senses": [
                    {
                        "sense_id": "cef05d46-e9ae-3e21-a694-fbed94be1b43",
                        "entry_id": "5dcbdc5d-75a3-3f98-a606-a268f1d1fdb7",
                        "glosses": [
                            "D’une manière légale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "babfdfda-b17a-4fee-abc5-35000425d860",
                                "sense_id": "cef05d46-e9ae-3e21-a694-fbed94be1b43",
                                "text": "Tout s’est fait légalement."
                            },
                            {
                                "example_id": "a988f8e1-5cb2-4e80-ab78-790793ce5dfe",
                                "sense_id": "cef05d46-e9ae-3e21-a694-fbed94be1b43",
                                "text": "Un troisième vous déférera au petit divan d’une petite province, et vous serez légalement empalé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9b113ae-9e32-44f3-b8cc-26ab0190299f",
                        "source_entry_id": "5dcbdc5d-75a3-3f98-a606-a268f1d1fdb7",
                        "source_sense_id": "cef05d46-e9ae-3e21-a694-fbed94be1b43",
                        "target_lang_word": "legally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
