                        "glosses": [
                            "Phorbe, plante à fleur, ni ligneuse ni herbeuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816174c2-346f-4b07-affe-32a00bf3540a",
                                "sense_id": "344d38f2-32b6-3a2b-b273-21f28976878e",
                                "text": "Clover, sunflower, cannabis and milkweed are forbs."
                            },
                            {
                                "example_id": "51dd8c48-944d-47b1-9eb3-8ef8974f7980",
                                "sense_id": "344d38f2-32b6-3a2b-b273-21f28976878e",
                                "text": "Most forbs do not woody stems and branches behind that will comme back to life in the spring. They will grow again from the roots up."
                            }
                        ]
