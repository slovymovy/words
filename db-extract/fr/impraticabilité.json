                                "example_id": "d110634f-711e-4552-a1ea-bde6f3ccd3d4",
                                "sense_id": "a9fa14fb-ad77-361c-9624-505d76af9bf0",
                                "text": "La barbarie de la loi qu’on vous propose est la plus haute preuve de l’impraticabilité d’une loi sur l’émigration."
                            },
                            {
                                "example_id": "a252c11a-d747-4fd6-ab61-4c72c54abea9",
                                "sense_id": "a9fa14fb-ad77-361c-9624-505d76af9bf0",
                                "text": "Il semblait, vraiment, que le château des Carpathes aurait pu se défendre rien que par la seule impraticabilité de ses approches."
                            },
                            {
                                "example_id": "a64cea1a-2303-46a8-a3c2-123010271433",
                                "sense_id": "a9fa14fb-ad77-361c-9624-505d76af9bf0",
                                "text": "[…] ; mais la colonne resta bloquée à Dar El-Caïd Hafed par l’impraticabilité des pistes et des oueds."
                            }
                        ]
                    }
