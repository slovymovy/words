                "senses": [
                    {
                        "sense_id": "648062d9-7fc5-3d50-b820-b8e719d967ef",
                        "entry_id": "61305b41-ae4a-356a-b8a1-0e57bd685cec",
                        "glosses": [
                            "jemand, der rezitiert/Texte vorträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb7d70c9-9a69-4ada-8107-20c4743aafb9",
                                "sense_id": "648062d9-7fc5-3d50-b820-b8e719d967ef",
                                "text": "„Alle Rezitatoren der Passionspsalmen in unserem Rundfunk tragen die Psalmen in einem Tonfall vor, den man in der Zeit vor 1920, als ich aufwuchs, als unpassend und weltlich, ja sogar als sündhaft empfunden hätte.“"
                            },
                            {
                                "example_id": "d6bf9f33-be56-45a2-8751-26cc898d2124",
                                "sense_id": "648062d9-7fc5-3d50-b820-b8e719d967ef",
                                "text": "„Dazu hörte sie seine Stimme, die er der Puppe lieh, wenn der Rezitator mit der Laute fehlte, wie so oft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
