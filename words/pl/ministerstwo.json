                    "sense_id": "7644ee8a-0b8b-39ff-961a-c0a1d923af05",
                    "sense_definition": "urząd administracji państwowej, którym kieruje minister, zajmujący się określoną dziedziną spraw państwowych",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każde <w>ministerstwo</w> musi przygotować plan wydatków na przyszły rok.",
                            "target_lang_translations": {
                                "ru": "Каждое <w>министерство</w> должно подготовить план расходов на следующий год.",
                                "en": "Every <w>ministry</w> must prepare a spending plan for the next year.",
                                "nl": "Elk <w>ministerie</w> moet een uitgavenplan opstellen voor volgend jaar.",
                                "es": "Cada <w>ministerio</w> debe preparar un plan de gastos para el próximo año."
                            }
                        },
                        {
                            "text": "Pracownicy tego <w>ministerstwa</w> są odpowiedzialni za ochronę środowiska.",
                            "target_lang_translations": {
                                "ru": "Сотрудники этого <w>министерства</w> отвечают за охрану окружающей среды.",
                                "en": "The employees of this <w>ministry</w> are responsible for environmental protection.",
                                "nl": "De medewerkers van dit <w>ministerie</w> zijn verantwoordelijk voor de milieubescherming.",
                                "es": "Los empleados de este <w>ministerio</w> son responsables de la protección del medio ambiente."
                            }
                        }
                    ],
                    "synonyms": [
                        "resort"
                    ],
                    "common_phrases": [
                        "Ministerstwo Finansów",
                        "Ministerstwo Zdrowia",
                        "rzecznik ministerstwa",
                        "pracować w ministerstwie"
                    ],
                    "target_lang_definitions": {
                        "ru": "орган государственного управления, возглавляемый министром и занимающийся определенной сферой деятельности",
                        "en": "A government department headed by a minister, responsible for a specific area of state administration.",
                        "nl": "Een overheidsdepartement onder leiding van een minister, verantwoordelijk voor een specifiek gebied van het staatsbestuur.",
                        "es": "Departamento del gobierno encabezado por un ministro, responsable de un área específica de la administración estatal."
