{
    "word_family": [
        "leren",
        "leerling",
        "aanleren",
        "afleren"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70b10524-e48b-3ba1-ae21-d6332df91d8a",
                    "sense_definition": "iets wat ooit geleerd is weer vergeten door gebrek aan oefening",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vergeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is zijn moedertaal inmiddels helemaal <w>verleerd</w>.",
                            "target_lang_translations": {
                                "en": "He has completely <w>forgotten</w> his native language by now."
                            }
                        },
                        {
                            "text": "Als je niet regelmatig oefent, zul je de taal snel <w>verleren</w>.",
                            "target_lang_translations": {
                                "en": "If you do not practice regularly, you will quickly <w>forget</w> the language."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergeten"
                    ],
                    "antonyms": [
                        "leren",
                        "onthouden"
                    ],
                    "common_phrases": [
                        "een taal verleren",
                        "het fietsen verleren"
                    ],
                    "target_lang_definitions": {
                        "en": "To forget something that was once learned due to a lack of practice."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forget",
                                "target_lang_sense_clarification": "a language or skill through lack of practice"
                            },
                            {
                                "target_lang_word": "unlearn",
                                "target_lang_sense_clarification": "to lose a previously acquired skill"
                            },
                            {
                                "target_lang_word": "lose",
                                "target_lang_sense_clarification": "to lose the ability to do something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf28d10-67df-3096-89aa-96694117bbab",
                    "sense_definition": "een gewoonte of vaardigheid niet meer kunnen of doen door het te ontwennen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vergeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zijn in deze drukke maatschappij <w>verleerd</w> om niets te doen.",
                            "target_lang_translations": {
                                "en": "In this busy society, we have <w>forgotten how</w> to do nothing."
                            }
                        },
                        {
                            "text": "Zij is door de jaren heen <w>verleerd</w> hoe ze moet ontspannen.",
                            "target_lang_translations": {
                                "en": "Over the years, she has <w>lost the ability</w> to relax."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontwennen"
                    ],
                    "antonyms": [
                        "aanwennen"
                    ],
                    "common_phrases": [
                        "het verleerd zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "To no longer be able to do or practice a habit or skill due to getting out of the habit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forget how to",
                                "target_lang_sense_clarification": "to lose the habit or ability of doing something"
                            },
                            {
                                "target_lang_word": "unlearn",
                                "target_lang_sense_clarification": "to break a habit or lose a natural capacity"
                            },
                            {
                                "target_lang_word": "lose the knack of",
                                "target_lang_sense_clarification": "to lose the ability to do something easily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}