                    {
                        "translation_id": "3901d6fb-4631-40ca-8376-f5698892bb09",
                        "source_entry_id": "7c9f8735-7d38-3fb7-8408-6c7fbdfce0e9",
                        "source_sense_id": "32e34655-0706-31de-ba1a-3817a81aa132",
