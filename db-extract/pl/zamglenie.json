                                    {
                                        "sense_id": "ebcce870-f4b9-3c75-bc69-60dafd60e6d1",
                                        "entry_id": "80532213-8a00-3379-8912-1a60f706a415",
                                        "glosses": [
                                            "Water or other liquid finely suspended in air. (Compare fog, haze.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb05db9-e4b7-47da-adb0-ca2c3101dd15",
                                                "sense_id": "ebcce870-f4b9-3c75-bc69-60dafd60e6d1",
                                                "text": "It was difficult to see through the morning mist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b56e111-f027-3456-81cd-ad9532557385",
                                        "entry_id": "80532213-8a00-3379-8912-1a60f706a415",
                                        "glosses": [
                                            "A layer of fine droplets or particles."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e802c9dc-bdff-4ced-9ad4-a8c1b185fc9c",
                                                "sense_id": "6b56e111-f027-3456-81cd-ad9532557385",
                                                "text": "There was an oily mist on the lens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2026bdac-51f2-3597-a3a3-cd02e9f0e6cb",
                                        "entry_id": "80532213-8a00-3379-8912-1a60f706a415",
                                        "glosses": [
                                            "Anything that dims, darkens, or hinders vision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d5d41b1-900a-4eaa-b971-28967018a4f0",
                                                "sense_id": "2026bdac-51f2-3597-a3a3-cd02e9f0e6cb",
                                                "text": "His passion cast a mist before his sense."
                                            },
                                            {
                                                "example_id": "3282952f-0701-4744-8bce-13aacf532e09",
                                                "sense_id": "2026bdac-51f2-3597-a3a3-cd02e9f0e6cb",
                                                "text": "Alas, I do not have the strength to continue writing. Already, mist veils my eyes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb99b9c6-78d0-3505-b015-12ab9fca4bd2",
                                        "entry_id": "ceba4995-61c1-3592-9f1f-8bb0d981c084",
                                        "glosses": [
                                            "To form mist."
