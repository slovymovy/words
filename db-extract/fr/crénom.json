        "fr-extract.jsonl": [
            {
                "entry_id": "9f5cd15b-ebe6-3bf7-88cd-f2c0b73bdd96",
                "word": "crénom",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ff929135-5884-337f-953e-fcaff0a23d6a",
                        "entry_id": "9f5cd15b-ebe6-3bf7-88cd-f2c0b73bdd96",
                        "glosses": [
                            "Juron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "609a9a85-a559-4242-919e-426c11415a55",
                                "sense_id": "ff929135-5884-337f-953e-fcaff0a23d6a",
                                "text": "Passe encore que vous fassiez mourir les voyageurs dans la fumée de charbon, la chaleur et les courants d’air, mais vous voulez en plus, crénom ! les achever à coup de formalités !"
                            },
                            {
                                "example_id": "e06e4821-9701-4d13-ad9e-e634e87c2691",
                                "sense_id": "ff929135-5884-337f-953e-fcaff0a23d6a",
                                "text": "L’esprit à Paris est tout autre. Je rencontre deux caricatures dans la rue ; du premier coup on se sent à deux cents lieues. Un mari tient un bébé de six mois ; il a le nez d’une aune ; cependant sa femme, une femme de trente ans, se peigne et s’attife. Il dit d’un air désolé et comique : « Si l’on réfléchissait, crénom ! » — L’autre est sur un mari trompé."
                            },
                            {
                                "example_id": "4bdfdbfd-7116-4f14-ab6c-79757b2df8f6",
                                "sense_id": "ff929135-5884-337f-953e-fcaff0a23d6a",
                                "text": "– Ah ! je vous en prie, ne me faites pas trop chèrement payer vos soins.\n– Je ne dis plus rien… Avec le soin d’un mouchoir propre… je vois ce que c’est… n’ayez pas peur, crénom ! regardez au ciel !… la voici.\nEt Anthime enlève à la pointe du mouchoir une escarbille imperceptible."
                            },
                            {
                                "example_id": "2c228996-9fba-4ed9-9005-b718b60560d4",
                                "sense_id": "ff929135-5884-337f-953e-fcaff0a23d6a",
                                "text": "Un tel émoi dut s’exprimer silencieusement en lui par un de ses laconiques jurons d’ancien cuirassier : Crénom !"
                            },
                            {
                                "example_id": "1bbfca4e-2919-4246-a50a-1f374cf08d36",
                                "sense_id": "ff929135-5884-337f-953e-fcaff0a23d6a",
                                "text": "Quant à nos trépassés, s'ils ont tous l'âme en peine,\nc’est pas d'être hors d'état d'mourir d'amour, crénom de nom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f914f03a-20bd-4e55-833d-2e4567e4c150",
                        "source_entry_id": "9f5cd15b-ebe6-3bf7-88cd-f2c0b73bdd96",
                        "source_sense_id": "ff929135-5884-337f-953e-fcaff0a23d6a",
                        "target_lang_word": "for God's sake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for God's sake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5794afcc-1a9b-395a-90e6-01373f913418",
                                        "entry_id": "ab7bae24-f60d-367a-ad90-e48517066f86",
                                        "glosses": [
                                            "An exclamation of anger, surprise, or impatience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c52a945d-296f-4548-a7dd-45cab585211f",
                                                "sense_id": "5794afcc-1a9b-395a-90e6-01373f913418",
                                                "text": "For God's sake, don't scare me like that!"
                                            },
                                            {
                                                "example_id": "b205ae72-01ca-47d6-a487-6af67539980b",
                                                "sense_id": "5794afcc-1a9b-395a-90e6-01373f913418",
                                                "text": "Put some pants on, for God's sake!"
                                            },
                                            {
                                                "example_id": "784c689d-2149-4363-b9cc-c43cb47cc8e1",
                                                "sense_id": "5794afcc-1a9b-395a-90e6-01373f913418",
                                                "text": "‘Look,’ he began, and she flapped a hand to stop him. ‘For God’s sake don’t say anything that starts with “look”. Sentences like that lead anywhere and they’re always fatal.’"
                                            },
                                            {
                                                "example_id": "dbf354ec-9d78-411b-bea8-f733782a69a4",
                                                "sense_id": "5794afcc-1a9b-395a-90e6-01373f913418",
                                                "text": "“The structure is deteriorating. The roof was leaking. The floor is sinking,” Mr. Biden said in a speech in front of the tunnel, the oldest in the Northeast, where the crowd included dozens of union workers. “This is the United States of America, for God’s sake. We know better than that.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcec30f3-47ed-341b-a3ef-41d99fd9e7f5",
                                        "entry_id": "ab7bae24-f60d-367a-ad90-e48517066f86",
                                        "glosses": [
                                            "Indicating a heartfelt or urgent request."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c8c837-8f6e-4ab4-a8d0-694c21a9a818",
                                                "sense_id": "bcec30f3-47ed-341b-a3ef-41d99fd9e7f5",
                                                "text": "“For God's sake!—quick!—quick!—put me to sleep—or, quick!—waken me!—quick!—I say to you that I am dead!”"
                                            },
                                            {
                                                "example_id": "b81deb62-911f-42b9-a5b6-2767084c92b4",
                                                "sense_id": "bcec30f3-47ed-341b-a3ef-41d99fd9e7f5",
                                                "text": "‘Utterson,’ said the voice, ‘for God's sake, have mercy!’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
