            {
                "entry_id": "6ec60aad-bc2d-340e-a7a7-ad934ca75105",
                "word": "graphisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d031867-a997-41e6-9af2-2e3903d76493",
                        "entry_id": "6ec60aad-bc2d-340e-a7a7-ad934ca75105",
                        "tags": [
