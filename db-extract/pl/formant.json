                    },
                    {
                        "sense_id": "3a585945-b8a1-37a8-a360-ce8ceb8a2325",
                        "entry_id": "94ef966b-8c0f-3cc3-add7-235acd571f08",
                        "glosses": [
                            "element słowotwórczy formujący, kształtujący wyraz pochodny od podstawowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0337d4-5006-48c9-8eaa-b6bd16a2fb00",
                                "sense_id": "3a585945-b8a1-37a8-a360-ce8ceb8a2325",
                                "text": "Wpływ formantów na zabarwienie uczuciowe wyrazów – powiedział Dmuchawiec głosem chorego borsuka. – Oto frapujący temat naszej dzisiejszej lekcji"
                            }
                        ],
