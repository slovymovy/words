                        "examples": [
                            {
                                "example_id": "f8ba0c08-a90b-4de7-8a0c-181cbc763b36",
                                "sense_id": "d175f62e-2111-3779-8b9d-e2edaff37a5a",
                                "text": "[…] le paysage commença très-brusquement à changer d’aspect. On ne vit plus ni lauriers-roses, ni cytises, ni syringas. La grasse verdure des maïs en herbe disparut."
                            },
                            {
                                "example_id": "6d4a2503-b451-40c5-969d-132451ac32ef",
                                "sense_id": "d175f62e-2111-3779-8b9d-e2edaff37a5a",
                                "text": "Une enfant qui d’instinct ennoblissait de paganisme les fêtes chrétiennes, amoureuse seulement du rameau de buis, de l’œuf rouge de Pâques, des roses effeuillées à la Fête-Dieu et des reposoirs – syringas, aconits, camomilles – du surgeon de noisetier sommé d’une petite croix, bénit à la messe de l’Ascension et planté sur la lisière du champ qu’il abrite de la grêle…"
                            }
                        ]
                    }
