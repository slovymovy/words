                        "form": "antisemitischere"
                    },
                    {
                        "form_id": "b0622b87-1672-4036-b3ba-e1f1078aea17",
                        "entry_id": "82ed88db-6dfb-3028-86af-9c1e66e38dc5",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "antisemitischers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                        "entry_id": "82ed88db-6dfb-3028-86af-9c1e66e38dc5",
                        "glosses": [
                            "anti-Joods, tegen het Joodse volk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ceb825-0d5f-4234-b90b-0f64bc4e9509",
                                "sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                                "text": "Een antisemitische actie wordt je in West-Europa door de meeste mensen niet in dank afgenomen."
                            },
                            {
                                "example_id": "e4f592e8-aac1-4af5-b39b-8737f62d3f69",
                                "sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                                "text": "Alle gewone rechtse partijen, en zelfs het centrum, waren antisemitisch, dus die stellingname kon niemand meer voor zichzelf uitbuiten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ae773e1-6e0d-4f6b-a0bf-58bcd7eaa305",
                        "source_entry_id": "82ed88db-6dfb-3028-86af-9c1e66e38dc5",
                        "source_sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                        "source_sense_description": "anti-Joods, tegen het Joodse volk",
                        "target_lang_word": "antisemitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antisemitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                        "entry_id": "bac6bc13-879d-3da9-aa4f-a670753ed427",
                                        "glosses": [
                                            "den Juden gegenüber feindlich und ablehnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d925f35-000c-4c32-a53a-071cf436832b",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "Eine antisemitische Haltung kommt immer noch vor."
                                            },
                                            {
                                                "example_id": "f9348256-9ec7-4c2c-b4eb-e783a77c6265",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Die ältere Tochter Bertha wird erst genannt, als sie wegen antisemitischer Ausschreitungen im Rahmen der 1848er-Revolution in Dornheim, wo sie bei einer Tante mütterlicherseits gewohnt hatte, zurück ins Elterhaus nach Kastel kommt.“"
                                            },
                                            {
                                                "example_id": "0f1d5dcb-d39d-4d05-b798-cb8159d32b0a",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Die antisemitische Zeitschrift des Julius Streicher hing in einem Schaukasten der Dorotheenstraße, und die Bertinis mußten wie andere, die vom Bahnhof Sierichstraße kamen oder dorthin gingen, daran vorbei.“"
                                            },
                                            {
                                                "example_id": "42096647-172c-45f4-9acf-d06a25386322",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Als Yorai Feinberg in Berlin ein Restaurant eröffnete, fühlte sich der Israeli willkommen. Heute erlebt er immer öfter antisemitische Anfeindungen.“"
                                            },
                                            {
                                                "example_id": "31c8d4a8-4ea9-4b5c-b965-ac69bea5f097",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Die Zahl der erfassten antisemitisch motivierten Straftaten ist in Bayern im vergangenen Jahr stark angestiegen.“"
                                            },
                                            {
                                                "example_id": "76c5d23f-f37a-43de-9502-46b2a288ea8a",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "[Schlagzeile:] „Vorwürfe von Kramp-Karrenbauer – Ist die AfD antisemitisch?“"
                                            },
                                            {
                                                "example_id": "aa55e696-d98a-4fee-a698-d13959ffa4a8",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„In der Abi-Zeitung des Eppinger Hartmanni-Gymnasiums sind antisemitische Kommentare aufgetaucht. Der Direktor ließ den Verkauf sofort stoppen.“"
                                            },
                                            {
                                                "example_id": "9d51415f-8777-41a4-8966-17967cdfc8a1",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Nach einem antisemitischen Vorfall in Berlin hat Kanzlerin Merkel ihre Entschlossenheit im Kampf gegen Antisemitismus bekräftigt.“"
                                            },
                                            {
                                                "example_id": "04a2e4e5-9da4-4ea4-897e-fc0f823152a3",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Der Zentralrat der Juden hatte bereits in der Vergangenheit wegen der hohen antisemitischen Gefährdung vom Tragen der Kippa in Teilen von Großstädten abgeraten.“"
                                            },
                                            {
                                                "example_id": "721b47bf-50ee-4dee-ad40-a362b45cd804",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Ein Mann stürmt die \"Tree of Life\"-Synagoge in Pittsburgh und tötet elf Menschen. Es ist der bislang schwerste antisemitische Anschlag in der Geschichte der Vereinigten Staaten.“"
                                            },
                                            {
                                                "example_id": "743e9557-a595-4e9e-8c04-bea78f697579",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Die Forscherinnen und Forscher sprechen von einer Omnipräsenz der Judenfeindschaft im Netz. Laut den Wissenschaftlern sind über die Hälfte der judenfeindlichen Äusserungen klassische antisemitische Klischees.“"
                                            },
                                            {
                                                "example_id": "dc48dcd0-e188-4826-a690-85adb87abd96",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„Hauptsächlich aber war «die Ablehnung der jüdischen Flüchtlinge durch eine weitverbreitete antisemitische Grundhaltung motiviert», wie die Unabhängige Expertenkommission Schweiz–Zweiter Weltkrieg feststellte.“"
                                            },
                                            {
                                                "example_id": "4823fc8e-1c77-49d3-9a71-623ca70e0e0c",
                                                "sense_id": "a81ae772-09a8-302f-9f0a-9bd7878b8998",
                                                "text": "„»Dänemark ist sicherlich eines der am wenigsten antisemitischen Länder der Welt. Als Jude mit relativ großem Bekanntheitsgrad erlebe ich hier nie Antisemitismus.«“ [der dänische Fernsehjournalist Martin Krasnik]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "759825e9-f4df-47c3-988a-21d5a8b102bd",
                        "source_entry_id": "82ed88db-6dfb-3028-86af-9c1e66e38dc5",
                        "source_sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                        "source_sense_description": "anti-Joods, tegen het Joodse volk",
                        "target_lang_word": "anti-Semitic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti-Semitic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6f6502-4c85-3061-898d-d7d57ab83c2c",
                                        "entry_id": "493d5d68-3262-3ea5-9ada-31d0a42aac55",
                                        "glosses": [
                                            "Relating to or exhibiting anti-Semitism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98042644-dc7b-4999-8b5d-5cad5fa1a38a",
                                                "sense_id": "3a6f6502-4c85-3061-898d-d7d57ab83c2c",
                                                "text": "[W]hen a Hamas spokesman recently stood by his statement that Jews used the blood of non-Jewish children for their matzos – one of the oldest anti-Semitic canards around – European elites were largely silent."
                                            },
                                            {
                                                "example_id": "ca0c59cd-8aad-4f62-a27d-c0fd2f5e296e",
                                                "sense_id": "3a6f6502-4c85-3061-898d-d7d57ab83c2c",
                                                "text": "The Anti-Defamation League reported a dramatic increase in antisemitic incidents in 2021 in this country, with a total of 2,717 incidents of assault, harassment and vandalism reported to ADL, the highest number on record since the organization began tracking antisemitic incidents in 1979."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e641343-9b7b-4a7c-b63a-c76b39e76f9d",
                        "source_entry_id": "82ed88db-6dfb-3028-86af-9c1e66e38dc5",
                        "source_sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                        "source_sense_description": "anti-Joods, tegen het Joodse volk",
                        "target_lang_word": "antisémitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antisémitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "879c0d5e-1ff0-32f6-9acb-be9eab599e8a",
                                        "entry_id": "887eaa28-466b-3a09-b422-b30af0af9e95",
                                        "glosses": [
                                            "Qui est hostile aux sémites, aux juifs. Relatif à lʼantisémitisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29dc27b5-a7c4-41b7-be3d-75a98ea2c80d",
                                                "sense_id": "879c0d5e-1ff0-32f6-9acb-be9eab599e8a",
                                                "text": "Les femmes de plusieurs de mes collègues, lorsque madame Schmoll leur fait visite, étalent sous ses yeux, avec affectation, des feuilles antisémitiques. Et croiriez-vous que le ministre de l’Instruction publique m’a refusé la croix de commandeur que je lui demandais ? Voilà l’ingratitude ! voilà l’aberration ! L’antisémitisme, c’est la mort, entendez-vous, de la civilisation européenne."
                                            },
                                            {
                                                "example_id": "7f54a61f-c1ca-4d4a-9d68-d564d2a6c9f6",
                                                "sense_id": "879c0d5e-1ff0-32f6-9acb-be9eab599e8a",
                                                "text": "Cet apport donne à la ligue antisémitique une coloration particulière puisquʼon décèle les influences de Toussenel de Blanqui et de Gustave Tridon, qui publie en 1884 « Du mollochisme juif »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0d12779-139a-4881-9a43-45da6a193204",
                        "source_entry_id": "82ed88db-6dfb-3028-86af-9c1e66e38dc5",
