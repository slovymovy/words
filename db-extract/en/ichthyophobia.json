                        "examples": [
                            {
                                "example_id": "12f439f5-b0f3-4a31-9339-9dd08bd17bb0",
                                "sense_id": "0a57b2c1-8275-3d13-bc70-5ec554643ad5",
                                "text": "Ichthyophobia, defined as the fear of fish, is especially strong in the Navajo Indians, who will not eat fish nor have anything to do with articles made in the shape of fish."
                            },
                            {
                                "example_id": "89b86d24-ffe1-49b4-a526-57c65c175c9f",
                                "sense_id": "0a57b2c1-8275-3d13-bc70-5ec554643ad5",
                                "text": "Such ichthyophobia occurred at the time of first European contact among the Tasmanian Aborigines."
                            },
                            {
                                "example_id": "902d5f37-6ce2-4f08-94a3-0aba56eed36a",
                                "sense_id": "0a57b2c1-8275-3d13-bc70-5ec554643ad5",
                                "text": "'How dreadful. I could never go under the water. The fish frighten me.'\n'My wife has ichthyophobia, you see,' Al-Nassar chimed in. 'The unfortunate condition confines her to swimming pools.'"
                            }
                        ]
                    }
