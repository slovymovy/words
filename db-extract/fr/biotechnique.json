                    {
                        "sense_id": "4974b9d9-b24d-360b-8779-bd5cc8088607",
                        "entry_id": "bdb5fa88-b220-36af-bb1c-c8d149228c8b",
                        "glosses": [
                            "Science appliquée ayant pour but de créer artificiellement des processus biochimiques à l’aide d’appareils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53cbdcf-8c53-4db0-a7fd-c50428074004",
                                "sense_id": "4974b9d9-b24d-360b-8779-bd5cc8088607",
                                "text": "Dans la première moitié du XXᵉ siècle déjà, la biotechnique a trouvé des applications dans la fabrication de produits chimiques, dans le traitement des déchets et dans la synthèse de la vitamine C."
                            },
                            {
                                "example_id": "a75f1638-4e65-49db-b750-0235f4312d41",
                                "sense_id": "4974b9d9-b24d-360b-8779-bd5cc8088607",
                                "text": "La biotechnique, pour l'heure, ne fait que toucher aux instruments ; elle pianote. Viendront bientôt les grandes et terribles compositions de l'orchestre tout entier."
                            }
                        ]
                    }
                ],
