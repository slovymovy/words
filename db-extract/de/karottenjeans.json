                ],
                "senses": [
                    {
                        "sense_id": "a2dace12-a9bf-3ed2-a154-54118bdb86ff",
                        "entry_id": "e24305d8-8a56-3060-881b-8e7214375c05",
                        "glosses": [
                            "Jeanshose, die im Hüftbereich weit geschnitten und nach unten hin schmaler wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472f3180-4fb2-4313-9d7f-c34c6de18b9d",
                                "sense_id": "a2dace12-a9bf-3ed2-a154-54118bdb86ff",
                                "text": "„Sie trug ein kariertes Hemd, Karottenjeans und Hosenträger.“"
                            },
                            {
                                "example_id": "e1201fc0-8218-4b4a-aa23-9567ca68663e",
                                "sense_id": "a2dace12-a9bf-3ed2-a154-54118bdb86ff",
                                "text": "„Sein Jugendbild trat ihm entgegen, Halder, mit ungebärdigem Schopf, Fliegerjacke, Karottenjeans und Turnschuhen.“"
                            },
                            {
                                "example_id": "932b6f1c-0fea-42ec-9343-58dbcd1e94e9",
                                "sense_id": "a2dace12-a9bf-3ed2-a154-54118bdb86ff",
                                "text": "„Ihr Vater lächelte, und ihre Mutter, die inzwischen den Frühstückstisch abgeräumt hatte, lehnte im Türrahmen, als Jola die heißersehnte Karottenjeans auspackte.“"
                            },
                            {
                                "example_id": "2292346e-7476-436b-93c6-c006e4586ea8",
                                "sense_id": "a2dace12-a9bf-3ed2-a154-54118bdb86ff",
                                "text": "„Eileen huscht in weißer Karottenjeans mit Strass-besetztem Gürtel an Nadjas Seite.“"
                            },
                            {
                                "example_id": "4f03a471-2e75-4e30-9cb7-a4f205f10c67",
                                "sense_id": "a2dace12-a9bf-3ed2-a154-54118bdb86ff",
                                "text": "„Als sie um halb acht wieder rauskam, hatte sie ein weinrotes Benetton-Sweatshirt und Karottenjeans an.“"
                            },
                            {
                                "example_id": "8423e6e4-5b18-4ae2-bfb4-3c9637583f67",
                                "sense_id": "a2dace12-a9bf-3ed2-a154-54118bdb86ff",
                                "text": "„Vormals, ich war gerade dem Teeny-Alter entwachsen, waren es schlicht weiße Schuhe unter der knallengen Karottenjeans, die zum oberen Abschluss mit einem weißen Stoffgürtel gehalten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
