                                "target_senses": [
                                    {
                                        "sense_id": "ae976f15-8887-3e8c-81f3-f9532c59e749",
                                        "entry_id": "17654291-9f9d-3017-91e5-3a56eba9ee2c",
                                        "glosses": [
                                            "Of, or relating to hearing, or to the sense or organs of hearing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "auditory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6270bed8-9fbc-3bd7-9cc5-0e0e71c0d77d",
                                        "entry_id": "1f1f8c6d-2e93-3a03-9a9e-67b56a496d74",
                                        "glosses": [
                                            "Synonym of audience."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7850d9f-9d4d-40c1-8cc3-e8a5d0bf026a",
                                                "sense_id": "6270bed8-9fbc-3bd7-9cc5-0e0e71c0d77d",
                                                "text": "...and because though these learned Gentlemen (sayes he, turning to his two friends) need not fear to discourse before any Auditory..."
                                            },
                                            {
                                                "example_id": "a67c7701-43f9-4852-b558-fab1e8f2b0f0",
                                                "sense_id": "6270bed8-9fbc-3bd7-9cc5-0e0e71c0d77d",
                                                "text": "Preaching of Sermons is Speaking to a few of Mankind: Printing of Books is Talking to the whole World. The Parson Prescribes himself, and addresses to the particular Auditory with the Appellation of My Brethren; but he that Prints a Book, ought to Preface it with a Noverint Universi, Know all Men by these Presents. The proper Inference drawn from this remarkable Observation, is, That tho' he that Preaches from the Pulpit ought to be careful of his Words, that nothing pass from him but with an especial Sanction of Truth; yet he that Prints and Publishes to all the World, has a tenfold Obligation."
                                            },
                                            {
                                                "example_id": "b16f94bd-c895-484e-94b3-84b3f5791c6f",
                                                "sense_id": "6270bed8-9fbc-3bd7-9cc5-0e0e71c0d77d",
                                                "text": "A general murmur of assent arose from his little auditory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553e8c70-6b23-3448-807e-c263401b9727",
                                        "entry_id": "1f1f8c6d-2e93-3a03-9a9e-67b56a496d74",
                                        "glosses": [
                                            "Synonym of auditorium."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7d69f3a-86e7-4aa0-9fdc-e7caa8158d20",
                        "source_entry_id": "d26e7bed-76f8-31c2-8862-3b7b29fe6766",
                        "source_sense_id": "23c61a98-93d1-3213-a389-bfa1af3be978",
                        "source_sense_description": "met betrekking tot het gehoor",
                        "target_lang_word": "auditif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auditif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                                        "entry_id": "f18ba246-99bf-33b2-b7f0-5005a1541985",
                                        "glosses": [
                                            "Relatif à l’audition ou à l’ouïe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c153129-c0a9-4505-86a4-3d28f8fdfd8a",
                                                "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                                                "text": "Cette différence entre la sensibilité auditive chez les deux batraciens tient, suivant les auteurs, à ce que, pour le crapaud, animal terrestre, le bruit a plus d’importance que pour la grenouille, animal aquatique."
                                            },
                                            {
                                                "example_id": "21b89b07-4d97-452f-bd88-1c1a8f29f0c0",
                                                "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                                                "text": "Il a été prouvé que la privation de sommeil entraîne une baisse de la résistance aux distractibilités visuelle et auditive (Harrison et Horne, 2000b)."
                                            },
                                            {
                                                "example_id": "9bd4689c-ce52-48ce-acf2-cfd2e2561039",
                                                "sense_id": "6bb72ce2-0a1c-3f12-9f8d-7877881f9db9",
                                                "text": "L'oreille coupée de Van Gogh est probablement l'effet d'un rituel qui devait le protéger contre des hallucinations auditives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "auditif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e69ab94-7526-3176-a5bc-832592b1e094",
                                        "entry_id": "d130116a-89a7-3d95-8904-fa71e20606a4",
                                        "glosses": [
                                            "Personne chez qui l’ouïe est plus importante que pour la moyenne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c923293-605d-4c7c-82b5-7c35ed662bf4",
                                                "sense_id": "7e69ab94-7526-3176-a5bc-832592b1e094",
                                                "text": "C’est un auditif."
                                            },
                                            {
                                                "example_id": "3836ebf9-afd2-4daf-ab3d-c5be51c76b58",
                                                "sense_id": "7e69ab94-7526-3176-a5bc-832592b1e094",
                                                "text": "Un auditif aurait en effet répondu : « ...je serais intéressé d’entendre la réponse... », ce qui paraît, a priori, plus logique puisqu’il s’agit d’une information auditive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
