                ],
                "senses": [
                    {
                        "sense_id": "9165051f-1881-39b6-b8df-65ba5f71ebed",
                        "entry_id": "5b02aba1-225f-3f80-8b08-b25a64492518",
                        "glosses": [
                            "bei Frauen auftretender Herzinfarkt, der meist andere Symptome als bei Männern aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eda0fbd-1d07-4cce-a41b-a52c7a82e3c9",
                                "sense_id": "9165051f-1881-39b6-b8df-65ba5f71ebed",
                                "text": "„Mediziner sprechen inzwischen vom ‚Eva-Infarkt‘, der Haupttodesursache von Frauen noch weit vor Krebserkrankungen.“"
                            },
                            {
                                "example_id": "d4fe9566-9f84-49f2-883b-3631ac7d0a70",
                                "sense_id": "9165051f-1881-39b6-b8df-65ba5f71ebed",
                                "text": "„Vorbeugung ist auch beim Eva-Infarkt die beste Medizin.“"
                            },
                            {
                                "example_id": "d823c4bc-f84d-41b9-9201-2e357bf94a9a",
                                "sense_id": "9165051f-1881-39b6-b8df-65ba5f71ebed",
                                "text": "„Frauen sollen ausführlich darüber informiert werden, was sie tun können, um sich besser vor dem ‚Eva-Infarkt‘ zu schützen.“"
                            },
                            {
                                "example_id": "0b4a83a6-a4fa-420b-8cb3-79be0a22b7dc",
                                "sense_id": "9165051f-1881-39b6-b8df-65ba5f71ebed",
                                "text": "„Doch sind die Symptome bei Frauen häufig etwas anders als bei Männern - frauentypische Symptome für den so genannten ‚Eva-Infarkt‘ sind ungewöhnliche Müdigkeit und Schwäche, anhaltende Schlafstörungen, Kurzatmigkeit, Übelkeit und Erbrechen unter körperlicher Belastung, Schmerzen im Oberbauch, am Hals und im Nacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
