                                "target_senses": [
                                    {
                                        "sense_id": "869ee372-c5ab-30cc-add3-4d898a7582e7",
                                        "entry_id": "6e0ff50a-8071-3436-85c2-eb1630c2174f",
                                        "glosses": [
