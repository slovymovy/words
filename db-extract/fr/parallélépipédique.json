                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51561c41-2d7f-4d16-a280-b251ae186fdd",
                                "sense_id": "a955e460-f3a0-3a77-9cef-83f49ef1a624",
                                "text": "On peut ainsi verser le charbon dans une sorte de benne parallélépipédique, fonctionnant comme benne jaugeuse qui se vide sur le tender."
                            },
                            {
                                "example_id": "74aa202d-bd13-4c8d-854d-c79fbf772d50",
                                "sense_id": "a955e460-f3a0-3a77-9cef-83f49ef1a624",
                                "text": "Il est boulonné sur un sabot en fonte parallélépipédique de 5 m de côté et 1 m de hauteur."
                            },
                            {
                                "example_id": "fa43981e-bcd2-4d44-a39a-e3c510ef6388",
                                "sense_id": "a955e460-f3a0-3a77-9cef-83f49ef1a624",
                                "text": "Les tilleuls aux branches tourmentées s’égouttaient en pleurant avec des soupirs mous, leurs chevelures parallélépipédiques s’emmêlant de tronc en tronc."
                            }
                        ]
