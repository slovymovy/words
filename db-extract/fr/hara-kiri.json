                    {
                        "translation_id": "07ae5386-b314-4d89-b20c-3d6201bf1f4a",
                        "source_entry_id": "fc7bd1ba-d424-3560-b259-4a079afd0505",
                        "target_lang_word": "seppuku",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seppuku",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ba59d1-fd97-3814-97f5-15d2ab9de802",
                                        "entry_id": "170742b3-3093-37ba-b775-ed8ea24fe9f5",
                                        "glosses": [
                                            "A form of ritual suicide by disembowelment using a blade, practiced by Japanese samurai, especially to rid oneself of shame, as a means of protest, or, formerly, as a method of capital punishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013feb22-487b-4257-93c0-6557d97aebd5",
                                                "sense_id": "32ba59d1-fd97-3814-97f5-15d2ab9de802",
                                                "text": "“I feel like the only solution is pretty clear,” he said during one online news program in late 2021. “In the end, isn’t it mass suicide and mass ‘seppuku’ of the elderly?” […] At a panel hosted by Globis, a Japanese graduate business school, Dr. Narita told the audience that “if this can become a Japanese society where people like you all commit seppuku one after another, it wouldn’t be just a social security policy but it would be the best ‘Cool Japan’ policy.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
