                    {
                        "sense_id": "4cfde574-ec9b-3d7f-a6e1-c87f045214a8",
                        "entry_id": "8705a1c7-48cd-3d33-9c22-95a15961537f",
                        "glosses": [
                            "eine in Guatemala gesprochene Sprache; die meistgesprochene Maya-Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56928bd2-6a27-4b83-91d5-2f28e521c41e",
                                "sense_id": "4cfde574-ec9b-3d7f-a6e1-c87f045214a8",
                                "text": "„Im Allgemeinen ist anzunehmen, daß die Quiché-Sprache im Süden und die aztekische im Norden vorherrscht.“"
                            },
                            {
                                "example_id": "9a5aeb2e-fe99-4865-a87b-fed9ce296448",
                                "sense_id": "4cfde574-ec9b-3d7f-a6e1-c87f045214a8",
                                "text": "„Der Name Retaluleu oder nach der offiziellen Schreibweise Retalhuleu entstammt der Quiché-Sprache und bedeutet Landmarke […]“"
                            }
                        ],
