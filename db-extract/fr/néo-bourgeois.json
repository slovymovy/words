                                "sense_id": "5106bc29-6b2e-300c-a03f-a1812380a255",
                                "text": "Le néo-bourgeois tend à s’identifier avec l’homo technicus."
                            },
                            {
                                "example_id": "04f7457d-b02d-471a-ae4d-bc5061e0774b",
                                "sense_id": "5106bc29-6b2e-300c-a03f-a1812380a255",
                                "text": "Bourgeois classiques, néo-bourgeois et petits travailleurs indépendants sont majoritaires et mènent une politique d’esprit conservateur."
                            },
                            {
                                "example_id": "7ea2bdd2-41a9-4c9b-84aa-9a338e29b016",
                                "sense_id": "5106bc29-6b2e-300c-a03f-a1812380a255",
                                "text": "Mais chez les néo-bourgeois bons vivants, quelle part laissait encore le respect des « recettes » à celui des principes ?"
                            }
                        ]
                    }
