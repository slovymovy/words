                ],
                "senses": [
                    {
                        "sense_id": "bfdc550a-3b5b-3f5c-95af-a32836f70dd1",
                        "entry_id": "f13b0e39-adb3-394f-a82a-327c91563dad",
                        "glosses": [
                            "Celle qui annonce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b25565-64a7-4682-8731-bbd0f04b4304",
                                "sense_id": "bfdc550a-3b5b-3f5c-95af-a32836f70dd1",
                                "text": "Des hirondelles qui passent ! Les premières que je vois. Je les aime, ces annonceuses du printemps, ces oiseaux qui suivent doux soleil, chants, parfums et verdure."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ef2ed9c-d805-31b2-9e61-f72ac9fac961",
                        "entry_id": "f13b0e39-adb3-394f-a82a-327c91563dad",
                        "glosses": [
                            "Celle qui fait la réclame de son produit (par opposition à l’agence qui conçoit la publicité et aux médias qui la diffusent)."
                        ],
                        "tags": [
                            "Publicité"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e102fe43-bf5d-3ba9-97f6-e61af4bf68f3",
                        "entry_id": "f13b0e39-adb3-394f-a82a-327c91563dad",
                        "glosses": [
                            "Celle qui fait les annonces au cours d’une rencontre sportive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4391b1b-f6f3-4da6-8077-381d4ef0146d",
                                "sense_id": "e102fe43-bf5d-3ba9-97f6-e61af4bf68f3",
                                "text": "Ils s’étaient rencontrés en 1977 en Tunisie, l’année suivant les Jeux olympiques de Montréal en 1976 où elle était annonceuse officielle pour les cérémonies d’ouverture et de clôture."
                            }
                        ]
                    },
                    {
                        "sense_id": "971f8c2a-5c5f-3941-8071-f897829fc8e5",
                        "entry_id": "f13b0e39-adb3-394f-a82a-327c91563dad",
                        "glosses": [
                            "Comédienne qui venait, à la fin du spectacle, faire l’annonce des pièces qu’on devait jouer le lendemain."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "160755a4-7fd8-45ee-8dc8-9e8233848d71",
                                "sense_id": "971f8c2a-5c5f-3941-8071-f897829fc8e5",
                                "text": "Sur son ventre de poissons,\nAnnonceuse des théâtres d’antan"
                            }
                        ]
                    },
                    {
                        "sense_id": "7c701f8c-fee6-3e12-96ce-873f38e292ec",
                        "entry_id": "f13b0e39-adb3-394f-a82a-327c91563dad",
                        "glosses": [
                            "Celle qui présente ou lance à la radio une émission publicitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "956741a5-2673-437b-9746-43eed183503b",
                                "sense_id": "7c701f8c-fee6-3e12-96ce-873f38e292ec",
                                "text": "Avant de débuter l’émission, une annonceuse « désannonce » l’émission précédente."
                            }
                        ]
                    }
                ],
