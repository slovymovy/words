                            }
                        },
                        {
                            "text": "Le spectacle s'est <w>achevé</w> sous les applaudissements chaleureux du public.",
                            "target_lang_translations": {
                                "en": "The show <w>ended</w> amid warm applause from the audience.",
                                "ru": "Спектакль <w>закончился</w> под тёплые аплодисменты публики.",
                                "nl": "De voorstelling <w>eindigde</w> onder het warme applaus van het publiek.",
                                "de": "Die Vorstellung <w>endete</w> unter dem herzlichen Applaus des Publikums.",
                                "pl": "Przedstawienie <w>zakończyło</w> <w>się</w> przy gorących oklaskach publiczności.",
                                "it": "Lo spettacolo è <w>finito</w> tra i calorosi applausi del pubblico.",
                                "cs": "Představení <w>skončilo</w> za vřelého potlesku diváků.",
                                "tr": "Gösteri, seyircinin sıcak alkışları altında <w>bitti</w>.",
                                "es": "El espectáculo <w>terminó</w> entre los cálidos aplausos del público.",
                                "zh": "演出在观众热烈的掌声中<w>结束</w>了。"
                            }
                        }
