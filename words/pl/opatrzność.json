                {
                    "sense_id": "22a0db73-02b5-3caa-8661-21030713a3fd",
                    "sense_definition": "troskliwa opieka, doglądanie i zaspokajanie czyichś potrzeb",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "troska",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chory pacjent potrzebował nieustannej <w>opatrzności</w> i wsparcia ze strony personelu.",
