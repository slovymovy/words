                            {
                                "example_id": "6297bc87-d99d-4a50-8f7c-2e9ee64ce5e2",
                                "sense_id": "46fd59b3-ef90-3d48-9c14-161ca5c3d30e",
                                "text": "Die Anrufung der Ahnen ist fester Bestandteil in vielen schamanischen Religion."
