                "senses": [
                    {
                        "sense_id": "df774e7d-852a-332d-8ebe-458bf682e078",
                        "entry_id": "7aed7456-8e6a-35ad-b25b-fd835217ecb4",
                        "glosses": [
                            "Person in der Phase der praktischen Ausbildung zum Pastoralreferenten"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "2195e24d-39fb-4bbb-af70-6f22b5e7f30a",
                                "sense_id": "df774e7d-852a-332d-8ebe-458bf682e078",
                                "text": "„Wenn das Pastoralpraktikum erfolgreich abgeschlossen wurde, kann die Übernahme der Pastoralassistentin oder des Pastoralassistenten in den Dienst in einem Pfarrverband erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "074f243b-22dd-3596-ae10-15f994af43de",
                        "entry_id": "7aed7456-8e6a-35ad-b25b-fd835217ecb4",
                        "glosses": [
                            "Laien-Seelsorger mit Hochschul- oder Berufsfachschul-Ausbildung"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "d98f84ac-42bb-4a8a-8f12-b50356e0b74b",
                                "sense_id": "074f243b-22dd-3596-ae10-15f994af43de",
                                "text": "„Pastoralassistenten haben aufgrund ihrer Charismen, ihrer Ausbildung (Kompetenz), ihrer Bereitschaft in der Kirche zu arbeiten, und ihrer Beauftragung durch den Diözesanbischof zum hauptamtlichen Dienst einen besonderen Anteil an der Sendung der Kirche.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "536cf2bc-2461-384e-b169-076ce6b395f4",
                        "entry_id": "7aed7456-8e6a-35ad-b25b-fd835217ecb4",
                        "glosses": [
                            "Laien-Seelsorger mit Hochschul-Ausbildung"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "fdb1d973-eed1-4400-8ab2-05a4af10326c",
                                "sense_id": "536cf2bc-2461-384e-b169-076ce6b395f4",
                                "text": "„Pastoralassistenten und Pastoralassistentinnen sind in der allgemeinen Seelsorge von römisch-katholischen Kirchgemeinden tätig.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b3f554d-754b-49e9-a74d-e83072e486f3",
