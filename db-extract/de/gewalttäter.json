                "senses": [
                    {
                        "sense_id": "cace6978-e32c-3429-af41-1c3cba9105db",
                        "entry_id": "e4470b06-7bf1-32b0-a24a-2f57d862bf5d",
                        "glosses": [
                            "Täter, der Gewalt anwendet oder angewendet hat; jemand, der eine Gewalttat begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8edcfa96-e056-4450-bd58-7f4a546f775f",
                                "sense_id": "cace6978-e32c-3429-af41-1c3cba9105db",
                                "text": "„In Wirklichkeit ist von ukrainischen  Gewalttätern auf der Krim bislang weit und breit nichts zu sehen.“"
                            },
                            {
                                "example_id": "c5c4fa4f-7aed-4bcb-9554-5c551b7ceffb",
                                "sense_id": "cace6978-e32c-3429-af41-1c3cba9105db",
                                "text": "„An jugendlichen Gewalttätern lassen sich die Probleme ablesen, auf die wir immer öfter zusteuern werden, wenn wir es nicht schaffen, sie und ihre Eltern zu integrieren.“"
                            },
                            {
                                "example_id": "c52fcdd6-379a-48fa-8673-8d0696677c5f",
                                "sense_id": "cace6978-e32c-3429-af41-1c3cba9105db",
                                "text": "„Natürlich versuchte Österreich, die Gewalttäter zur Rechenschaft zu ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
