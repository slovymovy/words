                                        "glosses": [
                                            "Conifère, Dacrydium cupressinum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96dfb10e-405f-4c14-bf75-0c1b43fd68a9",
                                                "sense_id": "b17ec1d1-64eb-39f7-a3e9-3171b4e1691d",
                                                "text": "Partout, le rimu domine largement les autres essences, telles que le totara, et le kahekatea."
