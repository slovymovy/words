                "senses": [
                    {
                        "sense_id": "518ecea0-ea90-33dc-81f0-3d95a653b393",
                        "entry_id": "a1053b8e-2787-35db-b31c-f4b3b307a7d4",
                        "glosses": [
                            "Versicherung, die Kosten für versehentlich entstandene Schäden deckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d086ff2-1ec1-4d04-b357-ae3ccab4516a",
                                "sense_id": "518ecea0-ea90-33dc-81f0-3d95a653b393",
                                "text": "Zum Glück kam meine Haftpflichtversicherung für die zerbrochene Vase auf."
                            },
                            {
                                "example_id": "3ec92659-27c5-4731-ac52-9a4432801686",
                                "sense_id": "518ecea0-ea90-33dc-81f0-3d95a653b393",
                                "text": "In Deutschland ist es verpflichtend, eine Haftpflichtversicherung für sein Auto abzuschließen."
                            },
                            {
                                "example_id": "75ae7257-8a11-431d-9406-65905f48d575",
                                "sense_id": "518ecea0-ea90-33dc-81f0-3d95a653b393",
                                "text": "„Es kamen Versicherungsvertreter, um uns klarzumachen, dass ohne Haftpflichtversicherung kein organisches Leben möglich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "650bc0d5-51e7-479c-b8dd-6ffa88573983",
                        "source_entry_id": "a1053b8e-2787-35db-b31c-f4b3b307a7d4",
                        "source_sense_id": "518ecea0-ea90-33dc-81f0-3d95a653b393",
                        "source_sense_description": "Versicherung, die Kosten für versehentlich entstandene Schäden deckt",
                        "target_lang_word": "liability insurance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liability insurance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef89b0fd-529c-39e9-8e3f-b281f2ca4c19",
                                        "entry_id": "f67b21b1-e492-3d93-9081-17418272b15f",
                                        "glosses": [
                                            "Any insurance against a potential loss due to the insured's liability for injury or damage to others."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3893ba12-7de3-49a9-bb2b-6a9a57e9c740",
                        "source_entry_id": "a1053b8e-2787-35db-b31c-f4b3b307a7d4",
                        "source_sense_id": "518ecea0-ea90-33dc-81f0-3d95a653b393",
                        "source_sense_description": "Versicherung, die Kosten für versehentlich entstandene Schäden deckt",
                        "target_lang_word": "assurance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assurance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c82d649b-a417-3ca1-9a09-7dd2a84ea21b",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Certitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf6b5f8-2d3e-4737-a7ef-9925d35bed91",
                                                "sense_id": "c82d649b-a417-3ca1-9a09-7dd2a84ea21b",
                                                "text": "On ne peut plus douter de cette nouvelle, on en a une entière assurance. J’ai l’assurance que cette place me sera donnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357dfd57-8c3d-3c87-b1c8-4694a0c4ce74",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Confiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43c887b-c4a8-4064-bc80-47785d87903b",
                                                "sense_id": "357dfd57-8c3d-3c87-b1c8-4694a0c4ce74",
                                                "text": "Prenez cette étoffe avec assurance, en assurance, elle est fort bonne. En toute assurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d072636-46da-3280-a761-ac568ee1569b",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Confiance en soi-même."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ead6afef-eedc-4ed0-ba07-18eebf547394",
                                                "sense_id": "3d072636-46da-3280-a761-ac568ee1569b",
                                                "text": "Choyé par les siens, protégé par ses aînés, il avait conquis l’assurance, l’arrogance presque de ceux qui se sentent forts, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7512325b-1538-3efe-b318-c4ec8b4b444e",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Ensemble de paroles, de promesses, de protestations par lesquelles on s’efforce de donner à une personne la certitude de quelque chose, ou de lui inspirer de la confiance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7959013c-dd5c-46b4-9bcf-940f76813f86",
                                                "sense_id": "7512325b-1538-3efe-b318-c4ec8b4b444e",
                                                "text": "Ce ne sont pas là de vaines assurances, des assurances en l’air. — Donner à quelqu’un des assurances de sa fidélité, de son dévouement. — On lui a donné l’assurance qu’il serait nommé. Recevoir l’assurance d’une chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Hardiesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91bd321-e0da-4ac0-86b9-a2900e472459",
                                                "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                                "text": "Pour accuser avec une telle assurance, il fallait qu'existât la preuve indéniable de la félonie de François."
                                            },
                                            {
                                                "example_id": "ea11693b-8b19-4a28-8bd5-25841c2c2bfb",
                                                "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                                "text": "C’est un jeune acteur, qui n’a pas encore d’assurance. Prenez de l’assurance."
                                            },
                                            {
                                                "example_id": "32f54094-ef55-4b6a-9a73-083a0fb5c99d",
                                                "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                                "text": "Ayez plus d’assurance. Montrez de l’assurance. Perdre son assurance. Une noble assurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b38f92eb-08fa-38a1-8bfc-8e1252e5cafe",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Sûreté ; état où l’on est hors de péril."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24b0ac9-d3ad-40ba-842d-4041f21e3923",
                                                "sense_id": "b38f92eb-08fa-38a1-8bfc-8e1252e5cafe",
                                                "text": "Je l’ai mis en lieu d’assurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dabc7d1c-0d97-3a17-af3f-18a96b0280ad",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Promesse, obligation nantissement, etc., qu’on donne pour servir de sûreté à quelqu’un avec qui l’on traite."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08da4c06-8e2e-4a8d-8f67-cd3787a25e1f",
                                                "sense_id": "dabc7d1c-0d97-3a17-af3f-18a96b0280ad",
                                                "text": "Je vous donnerai vos assurances, une bonne assurance. C’est un homme dont il est prudent d’exiger des assurances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9d98fc-58b4-3a88-8623-06cae1f14aed",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Contrat par lequel on garantit contre certains risques sa personne ou son bien, ou par lequel, à de certaines conditions, on assure à soi ou à d’autres le paiement d’une somme convenue."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3651689-cf25-455b-8c8c-f04dbdb6610f",
                                                "sense_id": "da9d98fc-58b4-3a88-8623-06cae1f14aed",
                                                "text": "Les sociétaires soumis à l’assurance obligatoire auront à supporter deux tiers du montant des cotisations, l'autre tiers est à la charge du patron."
                                            },
                                            {
                                                "example_id": "ebe46351-b972-40e2-817d-124e5387ca63",
                                                "sense_id": "da9d98fc-58b4-3a88-8623-06cae1f14aed",
                                                "text": "[…] des observateurs, […] signalent chez les campagnards du Lot comme une tare tout à fait caractéristique un individualisme outrancier, féroce, têtu, rétrograde qui leur a laissé ignorer jusqu'à ce jour les bienfaits de la solidarité, de l'entr’aide et même, dans bien des cas, de l'assurance et du remembrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "494915e1-d289-4352-a017-240ead92a403",
                        "source_entry_id": "a1053b8e-2787-35db-b31c-f4b3b307a7d4",
                        "source_sense_id": "518ecea0-ea90-33dc-81f0-3d95a653b393",
                        "source_sense_description": "Versicherung, die Kosten für versehentlich entstandene Schäden deckt",
                        "target_lang_word": "responsabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "responsabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                        "entry_id": "26b97164-5380-3aef-b099-3614ae33a69d",
                                        "glosses": [
                                            "Obligation de répondre de ses actions ou de celles des autres, d’être garant de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fd3ad0-7a30-489d-8fd0-b9ebed3fcf49",
                                                "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                                            },
                                            {
                                                "example_id": "fe7561a8-8c0e-4d22-b52b-5e347de3da9f",
                                                "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                                "text": "Si quelque malheur arrivait, la responsabilité en retomberait justement sur nous. Nous devons donc rester à notre poste tant que le devoir nous y obligera."
                                            },
                                            {
                                                "example_id": "9a0e6467-6911-419f-9387-669545542062",
                                                "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                                "text": "Le cabo­tinage était poussé par Murat jusqu’au grotesque, et les historiens n’ont pas assez remarqué quelle responsabilité incombe à Napoléon dans cette dégénérescence du véritable esprit guerrier."
                                            },
                                            {
                                                "example_id": "43072bf7-7b61-4185-9876-dafd58e7ca18",
                                                "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                                "text": "Pourtant je tiens jalousement à l’avertissement lancé par Homère aux Grecs dans L’Iliade et par Tyrtée dans les Élégies : « C’est une faiblesse déraisonnable que de se décharger sur la divinité de la responsabilité d’une morale et d’un ordre public » — Dieu, Allah ou quel qu’il soit."
                                            },
                                            {
                                                "example_id": "610efea5-9b10-4dd4-818a-bc577b8c0734",
                                                "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                                "text": "Le non-paiement des cotisations sociales est constitutif d'infraction pénale dans le chef de l’employeur, ou de ses préposés et mandataires qui ont la responsabilité du paiement des cotisations."
                                            },
                                            {
                                                "example_id": "0d68bddb-a089-4e3e-a0c4-05dfdce70f8f",
                                                "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                                "text": "Les harkis furent répartis entre un G.M.C., avec Dourdan comme chef de bord, et un half-track, véhicule blindé dont Fabrice aurait la responsabilité."
                                            },
                                            {
                                                "example_id": "0a8bfde7-4103-470c-ba72-f991bf053b83",
                                                "sense_id": "18213fe5-2bf2-3d97-97ed-b3f5bb3a446a",
                                                "text": "Elisabeth Borne n’a d’ailleurs pas hésité à placer les parlementaires face à leurs responsabilités : « Les oppositions sont largement d’accord pour rajouter des dépenses. Mais chaque fois que vous présentez des économies structurelles, vous avez une réticence forte. Ce n’est pas pour rien que j’ai dû passer par 49,3 la réforme des retraites », a-t-elle narré, assumant d’avoir mené des réformes « qui n’étaient pour le moins pas populaires » pour rééquilibrer les comptes publics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
