                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "findig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                        "entry_id": "da3e65f5-164a-39de-8689-1267a805cd7f",
                                        "glosses": [
                                            "mit guten Ideen, wie man eine schwierige Situation meistern kann, und schlau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8d5f69-ab34-4461-9536-e3c364c3a033",
                                                "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                                "text": "Er war sehr findig, wenn es ums Schreiben ging."
                                            },
                                            {
                                                "example_id": "ace77a5f-d76b-47e8-81c1-bca657ddd341",
                                                "sense_id": "5f25112e-141e-3de7-80d7-cba5596fb502",
                                                "text": "„Jetzt wurde Martins von findigen Nutzern als Fälscher entlarvt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "689bd7a2-693f-42ad-aeb2-40850c93ace6",
                        "source_entry_id": "6c4d5ba0-7de8-3901-a7d3-9817691f844d",
                        "source_sense_id": "d2ef45bd-a1f8-395e-8ce7-b3a9d5dd597d",
                        "target_lang_word": "erfinderisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erfinderisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                        "entry_id": "edbae109-ec7f-3182-bd3d-647bd51fee7d",
                                        "glosses": [
                                            "so, dass man viele Einfälle, neue Ideen und Lösungen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb0fa441-9d73-4b9a-a4e0-32c47af44fd4",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Neu und erfinderisch muss die Erfindung also hinsichtlich technischer Merkmale sein.“"
                                            },
                                            {
                                                "example_id": "06ab8073-ded7-4ced-aa33-b527ef6692c2",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Doch wir sind durchaus in der Lage, erfinderisch zu sein, wenn wir mit einem Problem konfrontiert sind, das so drängend ist, dass wir es lösen müssen.“"
                                            },
                                            {
                                                "example_id": "7a84912d-15ea-49dc-9295-3616d0b4a423",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Wer glaubt, es gebe in Deutschland keine erfinderischen Geister mehr, sollte die Halle 16 auf der Cebit besuchen.“"
                                            },
                                            {
                                                "example_id": "1cbd4db2-5295-47a7-80dd-72741709a6b2",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Er sieht in ihm einen Künstler, der wie wenige Vorbild ist: des erfinderischen und erfindenden Ausprobierens in allen denkbaren künstlerischen Bereichen.“"
                                            },
                                            {
                                                "example_id": "1076f346-c87b-4529-a121-0d9a7ae4be9f",
                                                "sense_id": "9a414359-7c8a-392e-9837-3079cd970507",
                                                "text": "„Die Bücher avancierten recht schnell von erfinderischen Kinderbüchern zu reißenden Romanen, deren Spannung sich ins Unerträgliche steigern konnte, nur um dann in einer ungeahnten Pointe zu münden, die oft unglaublich schien, aber von ihrer schöpferischen Kraft getragen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04999e8c-6034-4dd2-aa1a-568f6211649d",
                        "source_entry_id": "6c4d5ba0-7de8-3901-a7d3-9817691f844d",
                        "source_sense_id": "d2ef45bd-a1f8-395e-8ce7-b3a9d5dd597d",
                        "target_lang_word": "ingénieux",
