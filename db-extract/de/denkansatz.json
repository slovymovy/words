                "senses": [
                    {
                        "sense_id": "1bd40544-ca49-30f6-90b3-2fde25b95bd2",
                        "entry_id": "d60e1d6e-46b1-31df-8237-a8b084504dd2",
                        "glosses": [
                            "Approche, postulat, point de départ pour un raisonnement, une démarche intellectuelle ; base, piste de réflexion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1688f93a-3540-4f0a-9d47-aee70bedfc35",
                                "sense_id": "1bd40544-ca49-30f6-90b3-2fde25b95bd2",
                                "text": "Für die Reform unserer Sozialversicherungen brauchen wir unbedingt neue Denkansätze.",
                                "translation": "Pour la réforme de nos assurances sociales, nous avons impérativement besoin de nouvelles approches."
                            },
                            {
                                "example_id": "2f467926-395c-4c60-ab85-729e950194a8",
                                "sense_id": "1bd40544-ca49-30f6-90b3-2fde25b95bd2",
                                "text": "Diese Denkansätze sollte als Grundlage für unsere Entwicklungsarbeit dienen.",
                                "translation": "Ces pistes de réflexion devraient servir de base pour nos travaux de développement."
                            }
                        ]
                    }
