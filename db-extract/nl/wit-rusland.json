                ],
                "senses": [
                    {
                        "sense_id": "c90db356-cf24-3c9d-9005-eabd8651029e",
                        "entry_id": "bc31d59c-379c-3640-b200-815ac3a426bc",
                        "glosses": [
                            "een land in Oost-Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d541352e-513a-4464-adbc-9fa23afcdef8",
                                "sense_id": "c90db356-cf24-3c9d-9005-eabd8651029e",
                                "text": "Van politiestaat naar 'een van schofterigste regimes': zes vragen over Wit-Rusland"
                            },
                            {
                                "example_id": "4fd04533-076e-461e-8c7f-190833a03480",
                                "sense_id": "c90db356-cf24-3c9d-9005-eabd8651029e",
                                "text": "Protesten in Georgië zijn mislukt, constateert de oppositie: ‘We zijn op weg net als Wit-Rusland of Rusland te worden’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4411317-056f-4a1d-98b6-3e6405a9c141",
                        "source_entry_id": "bc31d59c-379c-3640-b200-815ac3a426bc",
                        "source_sense_id": "c90db356-cf24-3c9d-9005-eabd8651029e",
                        "source_sense_description": "land in Oost-Europa.",
                        "target_lang_word": "白俄罗斯",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "12c46dc0-51d9-4904-b701-fd02118da41d",
                        "source_entry_id": "bc31d59c-379c-3640-b200-815ac3a426bc",
                        "source_sense_id": "c90db356-cf24-3c9d-9005-eabd8651029e",
                        "source_sense_description": "land in Oost-Europa.",
                        "target_lang_word": "Weißrussland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weißrussland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2430532-f14e-3276-a054-2ec4c29da6b0",
                                        "entry_id": "5624047b-2d79-357e-9896-a68de35dbc7f",
                                        "glosses": [
                                            "Staat in Osteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a7c8a4-3a53-4673-b169-1864f22189d6",
                                                "sense_id": "e2430532-f14e-3276-a054-2ec4c29da6b0",
                                                "text": "Das Weißrussland der Sowjetzeit war eine relativ weitentwickelte Teilrepublik."
                                            },
                                            {
                                                "example_id": "55f99ebe-77ea-4deb-bc7d-76664eca9e91",
                                                "sense_id": "e2430532-f14e-3276-a054-2ec4c29da6b0",
                                                "text": "Minsk ist die Hauptstadt von Weißrussland."
                                            },
                                            {
                                                "example_id": "68091bb5-f2eb-463e-9ce0-4fe05629564d",
                                                "sense_id": "e2430532-f14e-3276-a054-2ec4c29da6b0",
                                                "text": "„Außer Uhren hatte er noch eine Frau und ein Kind in Weißrussland.“"
                                            },
                                            {
                                                "example_id": "bd3c9a25-4f6d-4734-87aa-19a9c4d00aa7",
                                                "sense_id": "e2430532-f14e-3276-a054-2ec4c29da6b0",
                                                "text": "„Es lief somit auf die Vertreibung und sogar Vernichtung der angestammten Bevölkerung Russlands, der Ukraine und Weißrusslands hinaus.“"
                                            },
                                            {
                                                "example_id": "43a29708-d837-4912-b678-eb7474ad8006",
                                                "sense_id": "e2430532-f14e-3276-a054-2ec4c29da6b0",
                                                "text": "„Östlich von Ostpreußen, in Weißrussland und der Ukraine, war die Wehrmacht schon seit Wochen auf dem Rückzug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d211aae-12b8-4fc4-b32f-7b6a37c98f4d",
                        "source_entry_id": "bc31d59c-379c-3640-b200-815ac3a426bc",
                        "source_sense_id": "c90db356-cf24-3c9d-9005-eabd8651029e",
