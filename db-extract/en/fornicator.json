                        "target_lang_word": "Hure",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hure",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c604dfc-025e-3f5c-bab6-9828ad4c27de",
                                        "entry_id": "58a89eba-e268-3417-a8d0-c08c13b4d724",
                                        "glosses": [
                                            "Frau, die für Geld sexuelle Handlungen vornimmt; Prostituierte"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3104a7f-491c-41b9-a221-35335cb3b7da",
                                                "sense_id": "2c604dfc-025e-3f5c-bab6-9828ad4c27de",
                                                "text": "Er trieb sich mit Huren herum."
                                            },
                                            {
                                                "example_id": "d2272a11-427a-4f5b-9ff4-1fec810f3418",
                                                "sense_id": "2c604dfc-025e-3f5c-bab6-9828ad4c27de",
                                                "text": "„Offiziell hieß es aber, in unserem Dorf gäbe es weder Huren noch Schwule noch Diebe.“"
                                            },
                                            {
                                                "example_id": "1c9bd3f4-07bd-49f1-abe9-d4be19188bb7",
                                                "sense_id": "2c604dfc-025e-3f5c-bab6-9828ad4c27de",
                                                "text": "„Wenn so eine Hure es nun schon vor der Hochzeit mit ihnen treibt, dann tut sie es bestimmt auch mit anderen, und so etwas heiratet man nicht.“"
                                            },
                                            {
                                                "example_id": "de2ea74e-87d1-471e-930f-d86431a10781",
                                                "sense_id": "2c604dfc-025e-3f5c-bab6-9828ad4c27de",
                                                "text": "„Ihr Zuhälter hielt sie für verrückt, aber sie war seine beste und schönste Hure.“"
                                            },
                                            {
                                                "example_id": "74b55f99-a899-4a6d-9067-81f88dde3cd5",
                                                "sense_id": "2c604dfc-025e-3f5c-bab6-9828ad4c27de",
                                                "text": "„Nicht jeder weibliche Sträfling war eine Hure.“"
                                            },
                                            {
                                                "example_id": "406bfb2f-26d0-410c-b505-e3c6bf511493",
                                                "sense_id": "2c604dfc-025e-3f5c-bab6-9828ad4c27de",
                                                "text": "„Eines Tages erzählte der Philosoph ihnen eine ganz unglaubliche Geschichte von sich und einer Pariser Hure.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7671846f-7805-3701-b030-d3ea9826d233",
                                        "entry_id": "58a89eba-e268-3417-a8d0-c08c13b4d724",
                                        "glosses": [
                                            "Frau, die als moralisch leichtfertig angesehen wird, weil sie außerehelich oder wahllos mit Männern geschlechtlich verkehrt"
                                        ],
                                        "tags": [
                                            "derogatory"
