                "senses": [
                    {
                        "sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                        "entry_id": "184bd8b0-9654-383d-9144-7c263f2511b1",
                        "glosses": [
                            "Mittel zur Anregung und Steigerung des Geschlechtstriebes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9659078e-fb93-445c-bdea-34c7df7b520b",
                                "sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                                "text": "Viagra heißt das wohl heute bekannteste Aphrodisiakum."
                            },
                            {
                                "example_id": "c8ddc04b-6c38-468e-aab4-e077201f99e7",
                                "sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                                "text": "„Die Tutanchamun mit in den Sarg gegebenen Alraunenfrüchte waren als Rauschmittel und Aphrodisiakum gedacht.“"
                            },
                            {
                                "example_id": "0d67cde4-0a4f-4923-be4f-8d00b346b727",
                                "sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                                "text": "„Frauen sind ein ungemein potentes Aphrodisiakum, um mein Leben auszuhalten.“"
                            },
                            {
                                "example_id": "b8e6a47f-1d2f-404f-a5fb-0ed9f9696147",
                                "sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                                "text": "„Aphrodisiaka aber sind viel mehr. Seit alters sollen sie nicht nur eine ermüdete Männlichkeit kurieren. Aufgabe der Rezepturen war es, Begehren zu wecken, beide Geschlechter zum Liebesgenuss zu reizen, diesen zu steigern oder zu verlängern.“"
                            },
                            {
                                "example_id": "f978d1ba-b1af-4020-bbe2-28291fb06815",
                                "sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                                "text": "„Als Bruni bemerkt, dass Isoldes depressive Gereiztheit zunimmt, äußert sie ihre Vermutung, dass es für Percys Reserviertheit neben der Nibelungentreue noch handfestere Gründe geben könnte, wogegen halt schärfere Aphrodisiaka eingesetzt werden müssten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9a64c45-83a3-4abd-81ef-55b089fe50c2",
                        "source_entry_id": "184bd8b0-9654-383d-9144-7c263f2511b1",
                        "source_sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                        "source_sense_description": "Mittel zur Anregung und Steigerung des Geschlechtstriebes",
                        "target_lang_word": "aphrodisiac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphrodisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26d16a5a-d17f-3050-8894-f1a7ce0a2477",
                                        "entry_id": "52fb7eaf-1022-31c3-8417-faa6073a3e27",
                                        "glosses": [
                                            "Arousing or intensifying sexual desire."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c5f81c0-7f71-4bfa-9bbd-a180ca3a54f9",
                                                "sense_id": "26d16a5a-d17f-3050-8894-f1a7ce0a2477",
                                                "text": "Cognac, with the addition of a little paprika and the yolk of an egg, is considered an effective aphrodisiac aid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aphrodisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ac951ec-b64a-3ff3-9d8e-db84e0edf127",
                                        "entry_id": "28968bb9-60b3-3880-8cca-ed3a782f4f49",
                                        "glosses": [
                                            "Something, generally a food or drug, having such an effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff32b3e0-2074-46f4-9af1-049911cf7e68",
                                                "sense_id": "5ac951ec-b64a-3ff3-9d8e-db84e0edf127",
                                                "text": "Power is the ultimate aphrodisiac."
                                            },
                                            {
                                                "example_id": "f818800c-844f-4209-a366-bce15f1a315b",
                                                "sense_id": "5ac951ec-b64a-3ff3-9d8e-db84e0edf127",
                                                "text": "This brother told me a secret on how to get more chicks / Put a little Medina in your glass, and the girls'll come real quick / It's better than any alcohol or aphrodisiac"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0a1f812-e753-4f8f-8e57-a29fbb62f24e",
                        "source_entry_id": "184bd8b0-9654-383d-9144-7c263f2511b1",
                        "source_sense_id": "97b06982-ea55-39a0-91df-753d071e3097",
                        "source_sense_description": "Mittel zur Anregung und Steigerung des Geschlechtstriebes",
                        "target_lang_word": "aphrodisiaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphrodisiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43a50b32-5097-33a4-9239-4f548d2e06ef",
                                        "entry_id": "2bdc6052-e964-3360-ab3a-ecc5cd44972a",
                                        "glosses": [
                                            "Qui est propre à exciter aux plaisirs de l’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854c7f5a-de38-4c5a-902e-c48d91893cc0",
                                                "sense_id": "43a50b32-5097-33a4-9239-4f548d2e06ef",
                                                "text": "Belles toutes deux, elles portent des ceintures ocellées et leur quasi-nudité, parfumée violemment, exhale un parfum aphrodisiaque."
                                            },
                                            {
                                                "example_id": "2755254e-bc6f-42d0-bb85-a371602b3850",
                                                "sense_id": "43a50b32-5097-33a4-9239-4f548d2e06ef",
                                                "text": "La camomille est à la fois aphrodisiaque et très relaxante, supprimant le stress."
                                            },
                                            {
                                                "example_id": "87cc4d61-48dd-42ca-8bcc-606c4d874f59",
                                                "sense_id": "43a50b32-5097-33a4-9239-4f548d2e06ef",
                                                "text": "L’odeur de l’ambre solaire avait curieusement un effet aphrodisiaque sur Albert qui devenait infernal. Moi, je mesurais mes élans car je détestais prendre un râteau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aphrodisiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef353b8-8c71-35fb-9231-6a33365e7429",
                                        "entry_id": "ca56e962-740e-3b53-b843-2bd25f054a91",
                                        "glosses": [
                                            "Substance qui rend le tonus sexuel, et excite les plaisirs de l’amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb097c9-a984-4c00-b009-a29413fc7d7d",
                                                "sense_id": "7ef353b8-8c71-35fb-9231-6a33365e7429",
                                                "text": "Les aphrodisiaques les plus en cours, que fabriquent les quarteronnes et mulâtresses pour s’attacher leurs amants de circonstance, sont le bois bandé et les piaïes."
                                            },
                                            {
                                                "example_id": "aa858e10-2da1-4167-9611-c981975fa601",
                                                "sense_id": "7ef353b8-8c71-35fb-9231-6a33365e7429",
                                                "text": "Tandis qu’on voudrait posséder certaines femmes au milieu d’une crise de larmes, parce que leurs pleurs sont un aphrodisiaque, j’imagine qu’un dilettante décuplerait le voltage de ses voluptés, s’il savait faire rire Lady Diana à point nommé."
                                            },
                                            {
                                                "example_id": "4c4b1e8c-369a-429e-8d74-cf39cda166f8",
                                                "sense_id": "7ef353b8-8c71-35fb-9231-6a33365e7429",
                                                "text": "Vous comprenez, l’ivoire des défenses fait encore de bons prix et la corne de rhinocéros, une fois pilée, vaut très cher en Extrême-Orient comme aphrodisiaque."
                                            },
                                            {
                                                "example_id": "efab23f9-6fb3-4fc2-bc77-8f509de8d5a5",
                                                "sense_id": "7ef353b8-8c71-35fb-9231-6a33365e7429",
                                                "text": "Il la soupçonna de l’avoir envoûté à l’aide d’un aphrodisiaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
