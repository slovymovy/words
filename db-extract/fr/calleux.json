                                        "glosses": [
                                            "Having calluses, or relating to calluses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "callous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0643622e-f2a8-36eb-8897-3e12709604b6",
                                        "entry_id": "a23b5093-4c90-3e8e-8931-5a5eb2ebb5c1",
                                        "glosses": [
                                            "Alternative form of callus."
                                        ],
