    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aac61f30-015f-3a72-acd0-8aeb5f953a30",
                    "sense_definition": "Участок суши, со всех сторон окружённый водой, но не являющийся материком.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "география",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы отправились на необитаемый <w>остров</w> в океане.",
                            "target_lang_translations": {
                                "en": "The tourists set off for a deserted <w>island</w> in the ocean."
                            }
                        },
                        {
                            "text": "Этот <w>остров</w> окружён тёплыми водами Средиземного моря.",
                            "target_lang_translations": {
                                "en": "This <w>island</w> is surrounded by the warm waters of the Mediterranean Sea."
                            }
                        }
                    ],
                    "antonyms": [
                        "материк",
                        "континент"
                    ],
                    "common_phrases": [
                        "необитаемый остров",
                        "тропический остров"
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of land completely surrounded by water, smaller than a continent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "island",
                                "target_lang_sense_clarification": "land surrounded by water"
                            },
                            {
                                "target_lang_word": "isle",
                                "target_lang_sense_clarification": "poetic or small island"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a761050-2963-376e-92b7-42604940486b",
                    "sense_definition": "Участок, выделяющийся чем-либо среди окружающей его местности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "переносное значение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зелёный <w>остров</w> леса красиво выделялся посреди жёлтого поля.",
                            "target_lang_translations": {
                                "en": "A green <w>island</w> of forest stood out beautifully in the middle of the yellow field."
                            }
                        },
                        {
                            "text": "Парк стал настоящим зелёным <w>островом</w> в центре шумного города.",
                            "target_lang_translations": {
                                "en": "The park became a true green <w>oasis</w> in the center of the noisy city."
                            }
                        }
                    ],
                    "common_phrases": [
                        "остров зелени"
                    ],
                    "target_lang_definitions": {
                        "en": "An area or patch that stands out distinctly from the surrounding terrain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "island",
                                "target_lang_sense_clarification": "distinct patch or area"
                            },
                            {
                                "target_lang_word": "oasis",
                                "target_lang_sense_clarification": "pleasant isolated spot"
                            },
                            {
                                "target_lang_word": "patch",
                                "target_lang_sense_clarification": "distinct piece of land"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdce9615-bc41-3d85-8c13-c2a7524078fc",
                    "sense_definition": "То, что стоит особняком, отлично от окружающего.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "переносное значение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Её дом был <w>островом</w> спокойствия в этом хаотичном мире.",
                            "target_lang_translations": {
                                "en": "Her home was an <w>island</w> of calm in this chaotic world."
                            }
                        },
                        {
                            "text": "Этот человек всегда чувствовал себя <w>островом</w> в коллективе.",
                            "target_lang_translations": {
                                "en": "This man always felt like an <w>island</w> in the team."
                            }
                        }
                    ],
                    "common_phrases": [
                        "остров тишины"
                    ],
                    "target_lang_definitions": {
                        "en": "Something or someone isolated, standing apart or completely different from its surroundings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "island",
                                "target_lang_sense_clarification": "isolated sanctuary or entity"
                            },
                            {
                                "target_lang_word": "haven",
                                "target_lang_sense_clarification": "refuge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "764b2a50-d3fa-35f2-9a08-355e92687cf5",
                    "sense_definition": "Небольшой отдельно стоящий лес.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "охота",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Охотники окружили густой <w>остров</w> в надежде найти зверя.",
                            "target_lang_translations": {
                                "en": "The hunters surrounded the dense <w>copse</w> hoping to find game."
                            }
                        },
                        {
                            "text": "Волки часто прячутся в таком <w>острове</w> во время облавы.",
                            "target_lang_translations": {
                                "en": "Wolves often hide in such a <w>thicket</w> during a drive hunt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "используется в охотничьем жаргоне"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small, isolated stand of trees or woodland in open country (hunting jargon)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "copse",
