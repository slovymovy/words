                                        "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                        "entry_id": "5862086e-c2c8-351c-a4c5-601496f8265d",
                                        "glosses": [
                                            "Kultivierung von Weinreben zur Gewinnung von Wein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3201e305-1239-4248-8618-2bed024dab9d",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "Der Weinbau wird nördlich der Alpen schon über 2000 Jahre betrieben."
                                            },
                                            {
                                                "example_id": "f885844e-1b9d-4908-a2b9-3220b1cbef63",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "„Der Weinbau besitzt in Koblenz eine mindestens 2000 Jahre alte Tradition.“"
                                            },
                                            {
                                                "example_id": "3d90f184-621e-4b2a-9413-a9ba417d3a82",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "„Wo der Weinbau nicht mehr lohnte, wandte man sich gerne dem Fremdenverkehr zu.“"
                                            },
                                            {
                                                "example_id": "693568d5-2b21-4eba-bd31-687a5c731e13",
                                                "sense_id": "5bf47a2c-5dd3-3093-a6fe-b5ed14528782",
                                                "text": "„Die Landschaft um Meißen ist seit Jahrhunderten vom Weinbau geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b97c66c7-5933-4981-a844-615afe7389e6",
                        "source_entry_id": "b460b04f-6f8c-3e58-9b88-b91a1f6238c2",
                        "source_sense_id": "dbbde8f3-75fd-3e96-92de-3be75109490f",
                        "target_lang_word": "Weinanbau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinanbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8504edc9-2c68-349b-af61-a9d94a23c8b2",
                                        "entry_id": "30803f45-09f4-3953-b120-0949cefde8b8",
                                        "glosses": [
                                            "die Kultivierung von Reben zum Zweck der Gewinnung von Trauben und Wein"
                                        ],
                                        "tags": [
                                            "Agrarwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4584d19e-3f2e-436a-8681-b5075674ca1c",
                                                "sense_id": "8504edc9-2c68-349b-af61-a9d94a23c8b2",
                                                "text": "„In der Langwiese sind noch heute alte Trockenmauern vorzufinden, die zur römischen Zeit dem Weinanbau dienten und dort wie Treppenstufen angelegt wurden.“"
                                            },
                                            {
                                                "example_id": "36bb167e-e7a1-4f5d-8284-e9814fc05426",
                                                "sense_id": "8504edc9-2c68-349b-af61-a9d94a23c8b2",
                                                "text": "„Weinanbau und Weinzubereitung waren den Germanen völlig fremd.“"
                                            },
                                            {
                                                "example_id": "2d536baf-49cb-418a-a04c-8bef6c195452",
                                                "sense_id": "8504edc9-2c68-349b-af61-a9d94a23c8b2",
                                                "text": "„Papa aber erzählte von seinen Gesprächen mit Winzern und davon, was er alles über den Weinanbau erfahren hatte, ich habe nicht alles verstanden, aber das war nicht schlimm, denn ich hatte den Kopf sowieso sehr voll von meiner Fahrt mit der Fähre allein hinüber zum anderen Ufer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9ae399d-5492-40c0-817b-570fa55f2b02",
                        "source_entry_id": "b460b04f-6f8c-3e58-9b88-b91a1f6238c2",
