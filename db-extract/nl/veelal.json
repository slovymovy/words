                    {
                        "translation_id": "5bcc4f52-37a1-4d1d-be8b-780ef9f70e03",
                        "source_entry_id": "9096e1d9-77dc-347b-b90b-6f9d6112d85d",
                        "source_sense_id": "d04c9214-1896-3222-a462-ab2752293fb2",
                        "source_sense_description": "in de meeste gevallen, vaak",
                        "target_lang_word": "oft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oft",
