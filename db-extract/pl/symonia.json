                                        "entry_id": "0d521d1a-affe-3171-b55e-6120d0c22522",
                                        "glosses": [
                                            "die Praxis (kirchliche) Ämter gegen Geld zu vergeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dee1084c-03c2-49a9-8ebc-e5d21bbe42a3",
                                                "sense_id": "192e8d09-c90f-396b-b35a-a13e3776396c",
                                                "text": "Damals betrieb der Staat Simonie."
                                            },
                                            {
                                                "example_id": "41c91f72-c9b5-40e8-bcc4-6d280ab34ded",
                                                "sense_id": "192e8d09-c90f-396b-b35a-a13e3776396c",
                                                "text": "„Wie gesagt waren damals Simonie (nach dem aus der Apostelgeschichte bekannten Magier Simon benannte Sünde des „geistlichen Wuchers“, Kauf und Verkauf von geistlichen Gütern und Stellen für Geld oder Geldeswert) und Nepotismus (Verwandtenbegünstigung) verbreitete Erscheinungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
