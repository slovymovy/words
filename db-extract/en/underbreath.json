                        "entry_id": "a7b17f2f-15c8-36ae-8765-079728285689",
                        "glosses": [
                            "Vocalized under one's breath."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "757b7630-1bf2-4710-a7e1-488852de5be8",
                                "sense_id": "315687bc-fb9e-3c20-9dc9-bcd62e063d0b",
                                "text": "Aleck gave a low, underbreath whistle."
                            },
                            {
                                "example_id": "fa557363-27ba-4c96-b5a2-c930a0c2d42b",
                                "sense_id": "315687bc-fb9e-3c20-9dc9-bcd62e063d0b",
                                "text": "No one laughed out loud, but the smiles and underbreath chuckles added to their discomfort."
                            },
                            {
                                "example_id": "8158252b-42b0-4a0d-89d9-34f3bc30f472",
                                "sense_id": "315687bc-fb9e-3c20-9dc9-bcd62e063d0b",
                                "text": "I got underbreath compliments from people in reference to my singing, but none of them wanted to know me."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
