                                "target_senses": [
                                    {
                                        "sense_id": "c9dc270a-139c-319b-8c99-5dc157f09654",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "A silvery-colored, toxic, metallic chemical element, liquid at room temperature, with atomic number 80 and symbol Hg."
                                        ],
                                        "tags": [
