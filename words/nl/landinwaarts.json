                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inland",
                                "target_lang_sense_clarification": "situated in the interior"
                            },
                            {
                                "target_lang_word": "landward",
                                "target_lang_sense_clarification": "facing or moving towards the land"
                            }
                        ]
                    }
