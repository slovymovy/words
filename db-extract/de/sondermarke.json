                "senses": [
                    {
                        "sense_id": "4ad52ea1-0fe0-37d4-8d44-f6bc61adcd38",
                        "entry_id": "ec5fb812-3c49-3ffa-b67e-877b9bd4702c",
                        "glosses": [
                            "Briefmarke mit besonderem Motiv aus einem besonderen Anlass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf76f2a-d933-42a6-bc22-c3a227d5f3df",
                                "sense_id": "4ad52ea1-0fe0-37d4-8d44-f6bc61adcd38",
                                "text": "„Im Jahre 1941 gab die Deutsche Reichspost erstmals eine eigene Sondermarke zum Tag der Briefmarke zum Preis von 6 Pf plus 24 Pf Zuschlag aus.“"
                            },
                            {
                                "example_id": "825e95a0-657b-4aea-a7b1-9eb657fd4a03",
                                "sense_id": "4ad52ea1-0fe0-37d4-8d44-f6bc61adcd38",
                                "text": "„Zum fünfzigjährigen Jubiläum gab die finnische Post eine Sondermarke heraus.“"
                            },
                            {
                                "example_id": "f41b056c-9c98-4d68-86d6-93a3c2514f66",
                                "sense_id": "4ad52ea1-0fe0-37d4-8d44-f6bc61adcd38",
                                "text": "„Zum Heavy-Metal-Festival in Wacken legte die Post jetzt einige Sondermarken auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
