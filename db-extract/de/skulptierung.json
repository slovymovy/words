                "senses": [
                    {
                        "sense_id": "bf8df83a-305b-3d24-8520-75abfe52777a",
                        "entry_id": "c4ba48a8-41bd-3de4-932d-144e3c722fb9",
                        "glosses": [
                            "durch künstlerische/handwerkliche Bearbeitung geschaffene dreidimensionale Form"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "8c3b3414-6058-4f17-ab50-231b44bac86c",
                                "sense_id": "bf8df83a-305b-3d24-8520-75abfe52777a",
                                "text": "„Grenzenlose Möglichkeiten für die Gestaltung von Oberflächentexturen, Halbreliefs und Skulptierung im Innen- und Außenbereich bieten wir Ihnen mit unseren Spezialspritzmörteln. Filigran formbar und dennoch hoch belastbar.“"
                            },
                            {
                                "example_id": "cf9bf464-3fce-44b2-ac2d-1a1999611f92",
                                "sense_id": "bf8df83a-305b-3d24-8520-75abfe52777a",
                                "text": "„Da war die atemberaubende Skulptierung durch den jungen belgischen Designer Luc Donkerwolcke.“"
                            },
                            {
                                "example_id": "57c265ea-594b-4fc5-8d39-78bc3ebc1b72",
                                "sense_id": "bf8df83a-305b-3d24-8520-75abfe52777a",
                                "text": "„Der klassizistische Obelisk ist aus Basalt gebildet und mit reicher Skulptierung versehen.“"
                            },
                            {
                                "example_id": "2742f304-0be0-40df-a9b7-f5a942675ac7",
                                "sense_id": "bf8df83a-305b-3d24-8520-75abfe52777a",
                                "text": "„Zahlreiche Skulptierungen zieren die Fassade, darunter auch die Gestalt eines gehörnten Mannes […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
