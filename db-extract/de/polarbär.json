                                    {
                                        "sense_id": "95984ffc-ebd5-3031-a88c-83ffbf34500d",
                                        "entry_id": "3a9507eb-9aae-3256-b79a-ff7a2010751d",
                                        "glosses": [
                                            "A hypercarnivorous species of bear, Ursus maritimus, whose native range lies largely within the Arctic Circle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8040a45f-7e08-4e78-b08b-9ab99bb3216b",
                        "source_entry_id": "0cdc7621-27fc-30cc-bad3-fd672e705f85",
                        "source_sense_id": "60edce76-cdea-3ca0-8105-3ee1b4df04b4",
                        "source_sense_description": "Zoologie: Eisbär",
                        "target_lang_word": "ours polaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ours polaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6587247-6c7d-3a3b-aec4-7dbc1daa90d7",
                                        "entry_id": "f170880f-8bc2-35e6-837b-5bdf050ea983",
                                        "glosses": [
                                            "Grand ours de couleur blanche, des régions arctiques, de nom scientifique Ursus maritimus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e04f4244-3296-4027-884c-500f3f3b7e63",
                                                "sense_id": "c6587247-6c7d-3a3b-aec4-7dbc1daa90d7",
                                                "text": "Il n'y a que quelques régions où l’ours polaire cohabite avec le bœuf musqué: sur la côte est du Groenland et dans quelques régions centrales de l’Arctique canadien."
                                            },
                                            {
                                                "example_id": "bf3c909d-c663-4104-89b0-f311c6358317",
                                                "sense_id": "c6587247-6c7d-3a3b-aec4-7dbc1daa90d7",
                                                "text": "Seuls deux échantillons venus du Tibet ont intrigué les scientifiques : ils ne correspondraient à aucun animal connu et proviendraient d’une bête issue d’un croisement d’un ours polaire et un ours paléoarctique qui aurait vécu entre 120 000 et 40 000 ans avant notre ère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
