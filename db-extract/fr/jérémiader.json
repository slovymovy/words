                ],
                "senses": [
                    {
                        "sense_id": "236681ce-7a1b-3089-88f4-29c8f40682e7",
                        "entry_id": "578a83c1-9ccf-3bc7-b798-1b87679f4830",
                        "glosses": [
                            "Se lamenter, se plaindre par des jérémiades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a91d5b-4471-4fcf-9d88-52e429625147",
                                "sense_id": "236681ce-7a1b-3089-88f4-29c8f40682e7",
                                "text": "On ne la voit guère qu’un quart d’heure par jour, et il passe ce quart d’heure à jérémiader sur les entraves que lui apporte sa bonté …."
                            },
                            {
                                "example_id": "6953aa74-3fe0-41ed-a574-9ae0fdb15e6f",
                                "sense_id": "236681ce-7a1b-3089-88f4-29c8f40682e7",
                                "text": "Les hommes aussi sont beaux de pittoresque : les yeux noirs regardent les jolies « gazelles », les mains s’associent aux dires pour vanter, jérémiader ou rêver."
                            }
                        ]
                    }
                ],
