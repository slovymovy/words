                                        "entry_id": "633607b6-f66e-3042-ac45-a964152cbc01",
                                        "glosses": [
                                            "Wandering from place to place, particularly when without any settled employment or habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81aad9e-3e82-4e0e-8027-8dc16eb80e07",
                                                "sense_id": "fd6210b7-938e-3fb1-a0d9-b13a8c72f9ef",
                                                "text": "a vagrant beggar"
                                            },
                                            {
                                                "example_id": "9d2a6161-19fa-4e41-b4fb-4c0f8300db0c",
                                                "sense_id": "fd6210b7-938e-3fb1-a0d9-b13a8c72f9ef",
                                                "text": "[A]ll and every idle, looſe and diſſolute perſon and perſons, which from and after the firſt day of July, One thouſand ſix hundred fifty ſeven, ſhall be found and taken within the Commonwealth of England, vagrant and wandring from his or their uſual place of living or abode, and ſhall not have ſuch good and ſufficient cauſe or buſineſs for ſuch his or their travelling or wandring, [...] ſhall be proceeded againſt and puniſhed as Rogues, Vagabonds and Sturdy Beggers within the ſaid Statute, [...]",
                                                "translation": "Julian calendar",
                                                "english": "Julian calendar"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d25e4a1-c84e-344b-baa8-3bae69ffbae5",
                                        "entry_id": "633607b6-f66e-3042-ac45-a964152cbc01",
                                        "glosses": [
                                            "Of or pertaining to a vagabond or vagrant, or a person fond of wandering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                        "entry_id": "633607b6-f66e-3042-ac45-a964152cbc01",
                                        "glosses": [
                                            "Moving without a certain direction; roving, wandering; also, erratic, unsettled."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e7af44-2f50-4e40-896a-95da0759fdec",
                                                "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                                "text": "Let Prudence yet obſtruct thy venturous way; / And take good heed, what men will think and ſay: / That beauteous Emma vagrant courſes took; / Her father's houſe and civil life forſook; / That, full of youthful blood, and fond of man; / She to the wood-land with an exile ran."
                                            },
                                            {
                                                "example_id": "01d539a6-2ce0-48e1-bd25-f20b1337c0dd",
                                                "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                                "text": "While leading this vagrant and miserable life, Johnson fell in love."
                                            },
                                            {
                                                "example_id": "01bbd930-2292-4979-adad-b8f7abcceb38",
                                                "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                                "text": "I'll ply the fire with kindling / And pull the blankets to my chin / I'll lock the vagrant winter out / And I'll bolt my wandering in"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
