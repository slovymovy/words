                "senses": [
                    {
                        "sense_id": "c395a95e-e465-3675-9816-98ba4b577d91",
                        "entry_id": "27ba6844-99d3-30a6-9240-ec4dcdd5eecb",
                        "glosses": [
                            "Gerät, das dazu dient, etwas abzusaugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e82ba91-d3ab-41fc-afef-13edae1241ee",
                                "sense_id": "c395a95e-e465-3675-9816-98ba4b577d91",
                                "text": "„Hinter der Absauganlage ist ein Aktivkohleadsorber zur Bodenluftreinigung installiert.“"
                            },
                            {
                                "example_id": "f20abfc9-8c88-49e5-a2ac-1a7defff2e8e",
                                "sense_id": "c395a95e-e465-3675-9816-98ba4b577d91",
                                "text": "„Im Lackierraum musste die Luft regelmäßig von feinen Farbpartikeln gereinigt werden. Dazu gab es eine Absauganlage, mit einem Gebläse und einem großen Stoffsack als Filter, der jede Stunde verstopfte, weil er voll war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
