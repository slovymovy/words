{
    "word_family": [
        "acquittal",
        "acquittance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b39d5700-e146-3339-8ff2-87c31cf1484e",
                    "sense_definition": "To formally declare that someone is not guilty of a crime or charge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_exoneration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury decided to <w>acquit</w> the prisoner of the charge after hearing the new evidence.",
                            "target_lang_translations": {
                                "ru": "Присяжные решили <w>оправдать</w> подсудимого по данному обвинению после заслушивания новых улик."
                            }
                        },
                        {
                            "text": "If the evidence is insufficient, the judge must <w>acquit</w> the defendant immediately.",
                            "target_lang_translations": {
                                "ru": "Если доказательств недостаточно, судья должен немедленно <w>оправдать</w> подсудимого."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolve",
                        "clear",
                        "exculpate",
                        "exonerate",
                        "vindicate"
                    ],
                    "antonyms": [
                        "condemn",
                        "convict",
                        "indict"
                    ],
                    "common_phrases": [
                        "acquit the prisoner",
                        "acquit of the charge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально признать кого-либо невиновным в совершении преступления или по предъявленному обвинению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдать",
                                "target_lang_sense_clarification": "вынести судебный приговор о невиновности"
                            },
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "признавать невиновным (процесс)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01cd931b-c97b-3c00-8d6f-dc33c6a42add",
                    "sense_definition": "To behave or perform in a specified way, especially in a challenging situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conduct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young soldier <w>acquitted</w> herself well in her first major battle.",
                            "target_lang_translations": {
                                "ru": "Молодая солдатка хорошо <w>проявила</w> себя в своем первом крупном сражении."
                            }
                        },
                        {
                            "text": "He <w>acquitted</w> himself with honor during the difficult negotiations.",
                            "target_lang_translations": {
                                "ru": "Он с честью <w>вышел</w> из трудных переговоров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acquit oneself well",
                        "acquit oneself with honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя или проявлять себя определенным образом, особенно в сложной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявить себя",
                                "target_lang_sense_clarification": "показать свои качества в деле"
                            },
                            {
                                "target_lang_word": "вести себя",
                                "target_lang_sense_clarification": "действовать определенным образом"
                            },
                            {
                                "target_lang_word": "справиться",
                                "target_lang_sense_clarification": "достойно выйти из ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6e46001-aac0-394a-9bc9-53309a7d19d3",
                    "sense_definition": "To fulfill a duty or pay off a debt or obligation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fulfillment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took him many years to finally <w>acquit</w> the debt he owed to his family.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось много лет, чтобы наконец <w>выплатить</w> долг своей семье."
                            }
                        },
                        {
                            "text": "She sought to <w>acquit</w> this obligation with discretion and generosity.",
                            "target_lang_translations": {
                                "ru": "Она стремилась <w>исполнить</w> это обязательство с осмотрительностью и щедростью."
                            }
                        }
                    ],
                    "synonyms": [
                        "remit"
                    ],
                    "common_phrases": [
                        "acquit the debt",
                        "acquit an obligation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or legal contexts regarding debts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить долг или выплатить задолженность или обязательство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выплатить",
                                "target_lang_sense_clarification": "погасить денежный долг"
                            },
                            {
                                "target_lang_word": "исполнить",
                                "target_lang_sense_clarification": "выполнить обязательство или долг"
                            },
                            {
                                "target_lang_word": "погасить",
                                "target_lang_sense_clarification": "аннулировать задолженность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}