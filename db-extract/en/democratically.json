                    }
                ],
                "senses": [
                    {
                        "sense_id": "5669fc48-d4a1-316e-b280-6ae41abc3915",
                        "entry_id": "b5aee910-0e4a-398c-9dcc-69cc45715e9e",
                        "glosses": [
                            "In a democratic way; according to the principles of democracy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f87e1a5-f855-4721-8372-1096d081f705",
                                "sense_id": "5669fc48-d4a1-316e-b280-6ae41abc3915",
                                "text": "a democratically elected leader"
                            },
                            {
                                "example_id": "2e21e763-8d97-4f3f-a8f9-540d913510be",
                                "sense_id": "5669fc48-d4a1-316e-b280-6ae41abc3915",
                                "text": "[T]hey ſee that they vvere not ſummoned ariſtocratically to a ſenate houſe of lords and great States, but invited democratically and after a popular manner to ſupper, vvhere the pooreſt may take his place vvith the richeſt, like as in the ſtate of a citie and common-vvealth, called Democratie."
                            },
                            {
                                "example_id": "a2ade957-5a28-4167-a91a-9737b46496e1",
                                "sense_id": "5669fc48-d4a1-316e-b280-6ae41abc3915",
                                "text": "Nor are thoſe Provinces vvhich are in ſubjection to a Democracie, or Ariſtocracie of another Common-vvealth, Democratically, or Ariſtocratically governed, but Monarchically."
                            },
                            {
                                "example_id": "6ed92ba3-746c-4f55-9530-3767a9a06fef",
                                "sense_id": "5669fc48-d4a1-316e-b280-6ae41abc3915",
                                "text": "He was not happy in the social changes of thirty years. Three decades ago, Dr. Westlake, Julius Flickerbaugh the lawyer, Merriman Peedy the Congregational pastor and himself had been the arbiters. That was as it should be; the fine arts—medicine, law, religion, and finance—recognized as aristocratic: four Yankees democratically chatting with but ruling the Ohioans and Illini and Swedes and Germans who had ventured to follow them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f402b61-18f5-401c-b26d-f35e188196be",
                        "source_entry_id": "b5aee910-0e4a-398c-9dcc-69cc45715e9e",
                        "source_sense_id": "5669fc48-d4a1-316e-b280-6ae41abc3915",
                        "source_sense_description": "in a democratic way",
                        "target_lang_word": "démocratiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démocratiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77dcaefe-8738-3d9e-bf1f-b019b4477a4c",
                                        "entry_id": "f6d440ed-0725-3342-beae-98a588119cc1",
                                        "glosses": [
                                            "D’une manière démocratique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fbe016-8326-4ea1-bdd9-99a520f8b4cc",
                                                "sense_id": "77dcaefe-8738-3d9e-bf1f-b019b4477a4c",
                                                "text": "Un travail conduit démocratiquement serait réglementé par des arrêtés, surveillé par une police et soumis à la sanction de tribunaux distribuant des amendes ou de la prison."
                                            },
                                            {
                                                "example_id": "db69372a-e311-41d3-8b32-322c1b0bea67",
                                                "sense_id": "77dcaefe-8738-3d9e-bf1f-b019b4477a4c",
                                                "text": "Dès ses 20 ans, il avait entendu « les cris sourds du pays qu’on enchaîne », notamment quand Germain Fortunade, maire élu démocratiquement depuis 1925 et ami de Martial Brigouleix était destitué, puis remplacé par un maire nommé et non élu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02910286-bf6a-4373-9f7a-13741319b1e9",
                        "source_entry_id": "b5aee910-0e4a-398c-9dcc-69cc45715e9e",
                        "source_sense_id": "5669fc48-d4a1-316e-b280-6ae41abc3915",
                        "source_sense_description": "in a democratic way",
                        "target_lang_word": "demokratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demokratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f6bdff-111f-387b-b11c-8e28729e0c5a",
                                        "entry_id": "db847097-a519-3008-b160-6ab6e37a78cd",
                                        "glosses": [
                                            "durch Volksentscheide bestimmt, zur Demokratie gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f938ad32-f007-4c1c-88f4-a3d96013029a",
                                                "sense_id": "c9f6bdff-111f-387b-b11c-8e28729e0c5a",
                                                "text": "Demokratische Gesinnung erkennt auch die Meinungsfreiheit an."
                                            },
                                            {
                                                "example_id": "d59797e7-11c2-4605-9d28-3c75871e219a",
                                                "sense_id": "c9f6bdff-111f-387b-b11c-8e28729e0c5a",
                                                "text": "„Das tief konservative Königreich, das sich noch nicht einmal den Anschein demokratischer Strukturen gibt, verteilt seinen Ölreichtum aber gleichmäßiger als die sich mit Wahlen, Parlamenten und Parteien schmückenden arabischen Republiken.“"
                                            },
                                            {
                                                "example_id": "505f4495-3da6-40b1-8e32-7892041f35e9",
                                                "sense_id": "c9f6bdff-111f-387b-b11c-8e28729e0c5a",
                                                "text": "„Unsere demokratischen Gesellschaften stützen sich in der Tat auf eine meritokratische Weltsicht oder zumindest auf eine meritokratische Hoffnung, das heißt den Glauben an eine Gesellschaft, in der Ungleichheiten auf Verdienst und Arbeit eher denn auf Herkunft und Kapitalrendite beruhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db4d3ba1-18c4-31c4-8814-853b609a507a",
                                        "entry_id": "db847097-a519-3008-b160-6ab6e37a78cd",
                                        "glosses": [
                                            "zu einer demokratischen Partei gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8423e2df-6c2b-45a6-aeee-e0c6e3b7d5f7",
                                                "sense_id": "db4d3ba1-18c4-31c4-8814-853b609a507a",
                                                "text": "Demokratische Abgeordnete sind vom Volk gewählt."
                                            },
                                            {
                                                "example_id": "63ff6ebb-220b-4d46-9ca9-a1218c756e26",
                                                "sense_id": "db4d3ba1-18c4-31c4-8814-853b609a507a",
                                                "text": "„Ben Cardin, demokratischer Senator aus Maryland, bescheinigt: “Der Architekt zur Befreiung Libyens waren eindeutig die USA.““"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
