                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "565de446-938a-4cad-8a83-6cc673521ecb",
                                                "sense_id": "424389ef-c546-39f3-8a07-0af77be9cb1c",
                                                "text": "\"We've been making up the most glamorous names for you, Marguerite and Marlene and Madeleine―\"\n\"And Melanie and Marianne and Marietta,\" put in Jane.\n\"And Mary Anne,\" said Matthew.\n\"Mary Anne's not glamorous,\" said Jane."
                                            },
                                            {
                                                "example_id": "726093da-342a-4597-a981-a65398dcad00",
                                                "sense_id": "424389ef-c546-39f3-8a07-0af77be9cb1c",
                                                "text": "Did Mary (I thought it was odd that they always called her Mary even though her name was Mary Anne, and odder that Mom refused to correct them) have time for some questions?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
