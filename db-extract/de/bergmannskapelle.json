                "senses": [
                    {
                        "sense_id": "4c04a779-6713-33ed-8eda-dbedda2d6eea",
                        "entry_id": "6986735d-cc20-322e-8e4f-39c1eef8cba2",
                        "glosses": [
                            "Gotteshaus oder einfach gestaltete Raum in einem Berg, der für Andachten der Bergmänner genutzt wird; auch in Kirchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5057014-383a-4ad6-bfe8-847743ae2eb1",
                                "sense_id": "4c04a779-6713-33ed-8eda-dbedda2d6eea",
                                "text": "In der Bergmannskapelle finden alle Andachten der Bergmänner Untertage, zu der die Kapelle gehört, statt."
                            },
                            {
                                "example_id": "03fb4d95-65c8-43de-bf2c-5a635bb66496",
                                "sense_id": "4c04a779-6713-33ed-8eda-dbedda2d6eea",
                                "text": "„Darunter befindet sich eine Kammer mit zehn Arkadenfenstern und einer Bergmannskapelle.“"
                            },
                            {
                                "example_id": "0e109bf7-5c4f-4b04-abc1-b9bd05f963c7",
                                "sense_id": "4c04a779-6713-33ed-8eda-dbedda2d6eea",
                                "text": "„Die Bergmannskapelle befindet sich mitten im früheren Bergbaurevier des Ilmenauer Kupfer- und Silberbergbaues an der Sturmheide, unterhalb der Halde des ehemaligen Schachtes \"Gottes Gabe\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3eb291e8-1bc1-3156-b628-88e9ba439d48",
                        "entry_id": "6986735d-cc20-322e-8e4f-39c1eef8cba2",
                        "glosses": [
                            "kleines, privates Musiker-Ensemble von Bergmännern, die Bergmannsmusik spielt, macht"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "886ad3e4-1bb5-45ef-950a-c9ad4325a655",
                                "sense_id": "3eb291e8-1bc1-3156-b628-88e9ba439d48",
                                "text": "Die Bergmannskapelle der Bergmänner unseres Dorfes spielt zu Hochzeiten, Ehrungen, Festen und Trauerfeiern von Bergmännern."
                            },
                            {
                                "example_id": "4e4b93a7-7689-4a34-a0c1-7ec8451bcfe9",
                                "sense_id": "3eb291e8-1bc1-3156-b628-88e9ba439d48",
                                "text": "„Ein sehr schönes verlängertes Wochenende verbrachten die Original Finstergrundmusikanten, die Tanzmusikabteilung der Bergmannskapelle Wieden, in Schruns im Montafon.“"
                            },
                            {
                                "example_id": "60119dd0-e001-44f7-950b-e4e90a37b4ac",
                                "sense_id": "3eb291e8-1bc1-3156-b628-88e9ba439d48",
                                "text": "„Ihr Repertoire reicht von klassischer Musik für Blaskapellen bis zu speziellen Arrangements moderner Unterhaltungsmusik – die Rede ist von der Bergmannskapelle Neuhof, die in der heutigen Form und Besetzung vor 35 Jahren aus der Taufe gehoben wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
