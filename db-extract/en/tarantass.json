                "senses": [
                    {
                        "sense_id": "0397021b-9e42-3dce-a463-5f48907261ca",
                        "entry_id": "8d60f0a0-1594-3ab7-9e18-cd844ae6247c",
                        "glosses": [
                            "A low horse-drawn carriage without springs used in Russia, capable of having its wheels replaced with runners during the winter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dffa9dce-6df7-45ce-9fd5-9a3135d6ad27",
                                "sense_id": "0397021b-9e42-3dce-a463-5f48907261ca",
                                "text": "Three kinds of conveyances are available: the telega, or cart without springs, which has to be changed at every station, and for which a charge of about 8d. is made at every stage; the kibitka, or cart (in winter a sledge) with a hood; and the tarantas, a kind of carriage on wooden springs, which admits of the traveller lying down full length, and which can be made very comfortable at night."
                            },
                            {
                                "example_id": "35af6f9d-7163-49d9-8b0a-63d0f1d1aa8a",
                                "sense_id": "0397021b-9e42-3dce-a463-5f48907261ca",
                                "text": "From Samarkand, using that peculiarly Russian means of transport, the springless, horse-drawn tarantass, Curzon reached Tashkent by the post road in thirty uncomfortable hours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e849b6b9-2d63-464d-80d2-cd5fefbe207d",
                        "source_entry_id": "8d60f0a0-1594-3ab7-9e18-cd844ae6247c",
                        "source_sense_id": "0397021b-9e42-3dce-a463-5f48907261ca",
                        "source_sense_description": "a low horse-drawn carriage without springs used in Russia",
                        "target_lang_word": "tarantass",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tarantass",
