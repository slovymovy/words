                        "tags": [
                            "RAL-kleur"
                        ],
                        "examples": [
                            {
                                "example_id": "931c9888-734c-4cdd-a6b1-b748275903c9",
                                "sense_id": "18ce72ec-9977-35fd-a2e8-f2c3eafc3d73",
                                "text": "De zijkant was een egaal groenblauw vlak."
                            },
                            {
                                "example_id": "4e0134c5-6219-451f-ac85-4fb694ad492f",
                                "sense_id": "18ce72ec-9977-35fd-a2e8-f2c3eafc3d73",
                                "text": "Hij rijdt in een groenblauwe auto."
                            },
                            {
                                "example_id": "55ebea8d-f46d-4017-8212-3bb8d6e5d9fa",
                                "sense_id": "18ce72ec-9977-35fd-a2e8-f2c3eafc3d73",
                                "text": "Ik legde mijn handen op de marmeren brugleuning en keek neer op het gewemel op het groenblauwe water, dat eerder een levensader was dan een barrière."
                            }
                        ]
                    }
                ],
