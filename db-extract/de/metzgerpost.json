                        "examples": [
                            {
                                "example_id": "3e94f42d-c992-4dd1-9626-b50278845571",
                                "sense_id": "0082fb0e-391e-37f9-a7e6-1ce94da93d48",
                                "text": "„Zu Beginn des 17. Jahrhunderts handelte es sich bei den Metzgerposten noch um eine Art Bedarfspost, wenn andere Postbeförderungen nicht zur Verfügung standen.“"
                            },
                            {
                                "example_id": "f7c02414-d57f-42f6-88c0-c107dc638b23",
                                "sense_id": "0082fb0e-391e-37f9-a7e6-1ce94da93d48",
                                "text": "„Auf die Metzgerposten, die bis Ende des 17. Jahrhunderts existierten, soll auch die Entstehung des Posthorns zurückgehen.“"
                            }
                        ],
