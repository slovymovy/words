                                                "sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                                                "text": "Épître, discours consolatoire."
                                            },
                                            {
                                                "example_id": "a87abc6a-6c30-4c90-9c44-448cf5341e88",
                                                "sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                                                "text": "Après quelques propos consolatoires pour l’allegeance du deuil paternel…"
                                            },
                                            {
                                                "example_id": "108ec4d8-a485-4a33-a23e-e5b494b1b29c",
                                                "sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                                                "text": "La lettre consolatoire de Plutarque à sa femme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "688a8844-36a3-49d8-a7d1-ccb19d9603ce",
                        "source_entry_id": "67f3076b-160c-37c1-8b40-dff67983498f",
                        "source_sense_id": "41cbd265-a21e-3363-bd4a-8cf15caa686d",
