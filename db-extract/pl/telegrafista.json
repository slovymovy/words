                        "entry_id": "24570592-3dec-354b-adc3-bd4f5aae9691",
                        "glosses": [
                            "osoba obsługująca aparat telegraficzny, wysyłający depesze"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "bf79c4cf-2a7c-4727-8ff6-05946e431526",
                                "sense_id": "d92d8af4-86d0-3ad6-a117-33b66e2a4f2f",
                                "text": "Na stacji Chandra Unyńska / Gdzieś w mordobijskim powiecie, / Telegrafista Piotr Płaksin / Nie umiał grać na klarnecie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
