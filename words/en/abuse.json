{
    "word_family": [
        "abuser",
        "abusive",
        "abusively",
        "abusiveness",
        "disabuse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4b3b45b-8051-3703-9c6e-bfeaa544e091",
                    "sense_definition": "Cruel, violent, or unfair treatment of someone, often involving physical or emotional harm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maltreatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim suffered years of physical <w>abuse</w> at home.",
                            "target_lang_translations": {
                                "ru": "Жертва годами терпела физическое <w>насилие</w> дома.",
                                "zh": "受害者在家中遭受了多年的身体<w>虐待</w>。"
                            }
                        },
                        {
                            "text": "She bravely reported the <w>abuse</w> to the police.",
                            "target_lang_translations": {
                                "ru": "Она смело заявила в полицию о <w>жестоком обращении</w>.",
                                "zh": "她勇敢地向警方举报了这种<w>虐待</w>行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mistreatment",
                        "maltreatment",
                        "cruelty",
                        "harm",
                        "ill-treatment"
                    ],
                    "antonyms": [
                        "care",
                        "protection"
                    ],
                    "common_phrases": [
                        "domestic abuse",
                        "child abuse",
                        "physical abuse",
                        "sexual abuse",
                        "emotional abuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестокое, насильственное или несправедливое обращение с кем-либо, часто причиняющее физический или моральный вред.",
                        "zh": "指对某人进行残酷、暴力或不公平的对待，通常涉及身体或情感上的伤害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наси́лие",
                                "target_lang_sense_clarification": "применение физической силы"
                            },
                            {
                                "target_lang_word": "жесто́кое обраще́ние",
                                "target_lang_sense_clarification": "бесчеловечное отношение (к детям, животным)"
                            },
                            {
                                "target_lang_word": "издева́тельство",
                                "target_lang_sense_clarification": "злая насмешка или мучение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虐待",
                                "target_lang_sense_clarification": "指对人或动物进行残酷的对待"
                            },
                            {
                                "target_lang_word": "暴力",
                                "target_lang_sense_clarification": "指使用武力造成伤害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "174a88c2-99dc-3ceb-bfaf-35f0b35b376d",
                    "sense_definition": "The use of something in a way that is wrong, harmful, or contrary to its intended purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "misuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation revealed a widespread <w>abuse</w> of public funds.",
                            "target_lang_translations": {
                                "ru": "Расследование выявило масштабное <w>злоупотребление</w> государственными средствами.",
                                "zh": "调查揭露了大规模的公款<w>滥用</w>现象。"
                            }
                        },
                        {
                            "text": "He was fired for the <w>abuse</w> of his position within the company.",
                            "target_lang_translations": {
                                "ru": "Его уволили за <w>злоупотребление</w> служебным положением в компании.",
                                "zh": "他因在公司内<w>滥用</w>职权而被解雇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misuse",
                        "corruption",
                        "exploitation"
                    ],
                    "antonyms": [
                        "proper use"
                    ],
                    "common_phrases": [
                        "abuse of power",
                        "drug abuse",
                        "substance abuse",
                        "alcohol abuse",
                        "abuse of the system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование чего-либо неправильным, вредным или противоречащим назначению образом.",
                        "zh": "指以错误、有害或违背其本意的方式使用某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злоупотребле́ние",
                                "target_lang_sense_clarification": "использование во вред или незаконно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滥用",
                                "target_lang_sense_clarification": "指不合理地使用权力、资金或资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceb2c0ff-62b7-3a84-9f1e-d4df8ac952a8",
                    "sense_definition": "Rude, offensive, and insulting remarks directed at a person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee received a lot of <w>abuse</w> from the angry crowd.",
                            "target_lang_translations": {
                                "ru": "Судья выслушал много <w>оскорблений</w> от разгневанной толпы.",
                                "zh": "裁判遭到了愤怒人群的各种<w>辱骂</w>。"
                            }
                        },
                        {
                            "text": "He ignored the stream of <w>abuse</w> hurled at him by the protesters.",
                            "target_lang_translations": {
                                "ru": "Он проигнорировал поток <w>брани</w>, который обрушили на него протестующие.",
                                "zh": "他无视了抗议者对他发出的连串<w>谩骂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "insults",
                        "invective",
                        "slurs"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "common_phrases": [
                        "shout abuse",
                        "verbal abuse",
                        "scream abuse",
                        "hurled abuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубые, оскорбительные высказывания в адрес человека.",
                        "zh": "指针对某人发表粗鲁、冒犯和侮辱性的言论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбле́ние",
                                "target_lang_sense_clarification": "унижение чести и достоинства"
                            },
                            {
                                "target_lang_word": "брань",
                                "target_lang_sense_clarification": "ругательные слова"
                            },
                            {
                                "target_lang_word": "ру́гань",
                                "target_lang_sense_clarification": "грубые слова, ссора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辱骂",
                                "target_lang_sense_clarification": "指用恶毒的语言攻击他人"
                            },
                            {
                                "target_lang_word": "谩骂",
                                "target_lang_sense_clarification": "指大声且粗鲁地侮辱他人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a6181ba-bec2-32dd-b5ad-f15dc5bb29eb",
                    "sense_definition": "To treat a person or animal in a cruel, violent, or very unfair way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maltreatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is illegal to <w>abuse</w> animals in this country.",
                            "target_lang_translations": {
                                "ru": "В этой стране запрещено <w>жестоко обращаться</w> с животными.",
                                "zh": "在这个国家<w>虐待</w>动物是违法的。"
                            }
                        },
                        {
                            "text": "She was <w>abused</w> by her partner for many years before she left.",
                            "target_lang_translations": {
                                "ru": "Партнер <w>издевался</w> над ней много лет, прежде чем она ушла.",
                                "zh": "在离开之前，她被伴侣<w>虐待</w>了很多年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mistreat",
                        "maltreat",
                        "harm",
                        "injure",
                        "ill-treat",
                        "hurt"
                    ],
                    "antonyms": [
                        "care for",
                        "protect",
                        "cherish"
                    ],
                    "common_phrases": [
                        "abuse a child",
                        "abuse a prisoner",
                        "physically abuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращаться с человеком или животным жестоко, с применением насилия.",
                        "zh": "指以残酷、暴力或非常不公平的方式对待人或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "издева́ться",
                                "target_lang_sense_clarification": "мучить, подвергать унижениям"
                            },
                            {
                                "target_lang_word": "жесто́ко обраща́ться",
                                "target_lang_sense_clarification": "причинять вред (фразовый глагол)"
                            },
                            {
                                "target_lang_word": "наси́ловать",
                                "target_lang_sense_clarification": "принуждать силой (часто сексуально)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虐待",
                                "target_lang_sense_clarification": "指对人或动物施加残酷行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47d9cbe4-0e2c-368f-89cb-ae5284fa71d1",
                    "sense_definition": "To use something for a bad purpose or in a way that is harmful or morally wrong.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "misuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician <w>abused</w> his power to help his friends.",
                            "target_lang_translations": {
                                "ru": "Политик <w>злоупотребил</w> своей властью, чтобы помочь друзьям.",
                                "zh": "那位政客<w>滥用</w>职权来帮助他的朋友。"
                            }
                        },
                        {
                            "text": "He <w>abuses</w> alcohol to cope with the stress of his job.",
                            "target_lang_translations": {
                                "ru": "Он <w>злоупотребляет</w> алкоголем, чтобы справиться со стрессом на работе.",
                                "zh": "他通过<w>滥用</w>酒精来应对工作压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misuse",
                        "exploit",
                        "misapply"
                    ],
                    "antonyms": [
                        "respect"
                    ],
                    "common_phrases": [
                        "abuse power",
                        "abuse authority",
                        "abuse trust",
                        "abuse drugs",
                        "abuse alcohol"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать что-либо в дурных целях или во вред.",
                        "zh": "指为了不良目的或以有害、道德错误的方式使用某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злоупотребля́ть",
                                "target_lang_sense_clarification": "использовать во вред"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滥用",
                                "target_lang_sense_clarification": "指不当使用权力、药物或信任"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4a930ab-b5ae-30b0-abd2-4e6b89cfdff9",
                    "sense_definition": "To speak to someone in a rude, offensive, or insulting manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans started to <w>abuse</w> the opposing team's goalkeeper.",
                            "target_lang_translations": {
                                "ru": "Болельщики начали <w>оскорблять</w> вратаря команды соперника.",
                                "zh": "球迷们开始<w>辱骂</w>对方球队的守门员。"
                            }
                        },
                        {
                            "text": "He <w>abused</w> the staff when they refused to serve him more drinks.",
                            "target_lang_translations": {
                                "ru": "Он <w>обругал</w> персонал, когда ему отказались налить еще выпить.",
                                "zh": "当工作人员拒绝再为他提供饮料时，他<w>辱骂</w>了他们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "revile",
                        "swear at"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "common_phrases": [
                        "abuse someone verbally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговаривать с кем-либо грубо или оскорбительно.",
                        "zh": "指以粗鲁、冒犯或侮辱的方式与某人交谈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбля́ть",
                                "target_lang_sense_clarification": "унижать словами"
                            },
                            {
                                "target_lang_word": "руга́ть",
                                "target_lang_sense_clarification": "бранить, порицать"
                            },
                            {
                                "target_lang_word": "матери́ть",
                                "target_lang_sense_clarification": "ругать нецензурными словами (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辱骂",
                                "target_lang_sense_clarification": "指用言语侮辱他人"
                            },
                            {
                                "target_lang_word": "谩骂",
                                "target_lang_sense_clarification": "指持续地用粗鲁语言攻击"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}