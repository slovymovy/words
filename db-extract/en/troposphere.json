                        "source_sense_id": "612f8a8f-87c3-38ce-a42b-65ca82ba8943",
                        "source_sense_description": "lower levels of the atmosphere",
                        "target_lang_word": "대류권",
                        "target_lang_code": "ko",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "대류권",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "50296b08-6361-3b1a-9568-df93f6a868ac",
                                        "entry_id": "7fe5c47c-d83b-3c7a-ab9f-53f7445f9dc1",
                                        "glosses": [
                                            "대기가 불안정한 층으로 공기분자, 수증기 및 불순물이 집중적으로 다량 존재하며, 지표면의 영향으로 난류나 대류작용에 의한 수직운동이 왕성하여 강수와 같은 눈에 보이는 기상현상을 비롯해서 온대저기압, 전선, 태풍 등 일기변화를 초래하는 거의 모든 대기운동이 일어나는 권역."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "843452c8-0295-441e-a1f0-5906043bc0b0",
                                                "sense_id": "50296b08-6361-3b1a-9568-df93f6a868ac",
                                                "text": "대류권의 높이 즉 권계면의 고도는 극지방에서는 약 8km, 적도지방에서는 약 18km 높이 정도이고, 중위도지방에서는 그 중간정도가 된다."
                                            },
                                            {
                                                "example_id": "b3092d75-3521-4ddc-9ab7-aa7caca1d037",
                                                "sense_id": "50296b08-6361-3b1a-9568-df93f6a868ac",
                                                "text": "이 층의 하단인 지면에서는 일사로 데워지고 상부는 복사냉각으로 차가워져서 기온감률을 증가시키려고 하는데, 평균적으로 거의 일정한 기온감률(5~7⁰C/km)이 유지되고 있는 것은 항상 대류가 일어나서 상하의 혼합이 왕성하기 때문이다."
                                            },
                                            {
                                                "example_id": "9669e685-ee24-42cd-b92c-6368f1429429",
                                                "sense_id": "50296b08-6361-3b1a-9568-df93f6a868ac",
                                                "text": "대류권의 윗면을 대류권계면 또는 권계면이라 하고 그 상부는 성층권에 이어져 있다."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
