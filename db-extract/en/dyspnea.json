                    {
                        "translation_id": "8f2c0b2b-121c-4f65-bb78-b43acf488bc5",
                        "source_entry_id": "c8dfe39b-2ae7-3e57-b430-d424d6699651",
                        "source_sense_id": "a0df2f0c-e75e-3fb8-89ac-fab4aefddbe4",
                        "source_sense_description": "difficult or laboured respiration",
                        "target_lang_word": "dyspnée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dyspnée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "134148f7-81fe-3eb2-aa08-2030cc8148bc",
                                        "entry_id": "a1447430-e050-3a8b-8d7c-87a2c667191b",
                                        "glosses": [
                                            "Gêne ou difficulté respiratoire pouvant être subjective. En pratique, elle définit tout écart par rapport au rythme respiratoire normal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d1c82d-a708-4bd7-9849-65e4752aeac7",
                                                "sense_id": "134148f7-81fe-3eb2-aa08-2030cc8148bc",
                                                "text": "Dans certains cas, on observe en outre de la céphalalgie, de la dyspnée, du coma, symptômes qui sont presque toujours sous la dépendance de l’urémie occasionnée par la néphrite."
                                            },
                                            {
                                                "example_id": "203484ec-a7ad-4afc-974b-02500190c0bb",
                                                "sense_id": "134148f7-81fe-3eb2-aa08-2030cc8148bc",
                                                "text": "Les maladies affectant les poumons et la paroi interne de la cavité thoracique entraînent des difficultés respiratoires désignées sous le terme de dyspnée."
                                            },
                                            {
                                                "example_id": "a72c9235-22de-4b9b-939c-ee374675a293",
                                                "sense_id": "134148f7-81fe-3eb2-aa08-2030cc8148bc",
                                                "text": "Les laryngites aigües sous-glottiques (LASG) constituent la première de cause de dyspnée chez l’enfant de plus de 6 mois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f42e9872-64b9-4a2c-920d-ae7b2747ca0e",
                        "source_entry_id": "c8dfe39b-2ae7-3e57-b430-d424d6699651",
                        "source_sense_id": "a0df2f0c-e75e-3fb8-89ac-fab4aefddbe4",
                        "source_sense_description": "difficult or laboured respiration",
                        "target_lang_word": "essoufflement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essoufflement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd30a28-683f-363b-a029-926bf2cdd3d0",
                                        "entry_id": "4baf0d64-c79b-3793-8bb6-94a9cc79f4c3",
                                        "glosses": [
                                            "État de celui, de celle, qui est essoufflé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67899c1a-e6dd-4976-a089-dd5c9b9f258b",
                                                "sense_id": "0cd30a28-683f-363b-a029-926bf2cdd3d0",
                                                "text": "En effet, la température s’abaissait sensiblement, et le moindre travail, le moindre effort produisait chez chaque individu un essoufflement qui le paralysait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                        "entry_id": "4baf0d64-c79b-3793-8bb6-94a9cc79f4c3",
                                        "glosses": [
                                            "Fort ralentissement qui annonce une fin prochaine."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1719f99-95f4-4f47-b8c3-2e74e4616c73",
                                                "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                                "text": "Une restauration n’est possible qu’aux brefs instants de lassitude quand les idées, les hommes et les faits s’accordent une trêve, quand l’essoufflement rompt l’assaut des générations montantes."
                                            },
                                            {
                                                "example_id": "6fbd42af-aa11-4067-9359-9011201e0f40",
                                                "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                                "text": "La rengaine de l’essoufflement de la mobilisation sans cesse matraqué par les grands médias commence à s’user."
                                            },
                                            {
                                                "example_id": "5d8eca05-10ab-479c-bf5d-c402df926881",
                                                "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                                "text": "L’analyste note également un maintien au cours des dernières années. « Il est quand même notable qu’il n’y ait pas eu plus d’essoufflement au cours des années », dit-elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
