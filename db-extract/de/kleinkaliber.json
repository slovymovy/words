                "senses": [
                    {
                        "sense_id": "4aab5148-1156-3511-ae3b-f2123cc49ac7",
                        "entry_id": "4e597f41-27db-3717-ba8f-2c0647021c76",
                        "glosses": [
                            "Patronen mit einem Durchmesser von 5,6 Millimetern, die vor allem im Sportschießen und bei der Jagd verwendet werden"
                        ],
                        "tags": [
                            "von Feuerwaffen"
                        ],
                        "examples": [
                            {
                                "example_id": "d9b0e3e4-d9e8-46e0-a78b-3469722dad65",
                                "sense_id": "4aab5148-1156-3511-ae3b-f2123cc49ac7",
                                "text": "„Tierschutz und Jagdgesetz haben Vorrang, deswegen ist Schrot als Munition verboten, nur Kleinkaliber sind vom Ordnungsamt zugelassen.“"
                            },
                            {
                                "example_id": "1ee52c35-204e-4d93-bdab-338b215c76af",
                                "sense_id": "4aab5148-1156-3511-ae3b-f2123cc49ac7",
                                "text": "„Wie viel High End steckt denn überhaupt in diesem Kleinkaliber?“"
                            },
                            {
                                "example_id": "444f20ce-a511-4917-94f1-8632b3c2f9a2",
                                "sense_id": "4aab5148-1156-3511-ae3b-f2123cc49ac7",
                                "text": "„Da schossen wir Kleinkaliber und wurden am Kleinkaliber ausgebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
