                "senses": [
                    {
                        "sense_id": "46389828-5e86-377f-ab9f-c811d1e59e99",
                        "entry_id": "7217f43d-56ad-3b87-a961-3eac4fc2ce3b",
                        "glosses": [
                            "Partir (de prison)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c793b22e-b7f0-4b94-bc77-7cdc9a799c83",
                                "sense_id": "46389828-5e86-377f-ab9f-c811d1e59e99",
                                "text": "Dix ans; t’en feras sept au grand maximum… Ça te fait décaner à trente-six ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf1c8d6f-1b7f-3183-84f5-f1f9cba85551",
                        "entry_id": "7217f43d-56ad-3b87-a961-3eac4fc2ce3b",
                        "glosses": [
                            "Partir (mourir)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1644fea-8623-4d94-8f65-9268b1e8872a",
                                "sense_id": "bf1c8d6f-1b7f-3183-84f5-f1f9cba85551",
                                "text": "Si je décane un jour, avait coutume de lui dire Sumi, mon Lit de la Rivière sera pour toi."
                            }
                        ]
                    },
                    {
                        "sense_id": "d542df1f-e9b0-3f7c-b798-70f0cf3b556e",
                        "entry_id": "7217f43d-56ad-3b87-a961-3eac4fc2ce3b",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9a3ccc-b814-46ff-8fda-4e3a0e93db3e",
                                "sense_id": "d542df1f-e9b0-3f7c-b798-70f0cf3b556e",
                                "text": "Les autres couples de nouveaux mariés suivent le premier magistrat, avec, en queue, les deux maris, dont les femmes sont conduites par le maire. On dit que l’on va « décaner » pour prendre un bon départ dans la vie."
                            },
                            {
                                "example_id": "e93005ea-1a0f-4dbc-9e6a-0eb28186318b",
                                "sense_id": "d542df1f-e9b0-3f7c-b798-70f0cf3b556e",
                                "text": "On dit en langage local « les cornards décanent »."
                            }
                        ]
                    }
                ],
