                        "entry_id": "8703632e-8d6a-3ba4-a5fc-1986bf0db043",
                        "glosses": [
                            "Sorte d'appareil de cuisson polyvalent et programmable capable de modes de cuisson différents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f7d176-0945-4e48-8e07-8aa1c2aa0a61",
                                "sense_id": "7e8eda6f-dce8-3d05-ac98-9a58a8808d6c",
                                "text": "De plus, vous allez également apprendre comment confectionner de succulents repas végans à l’aide d’un multicuiseur instant pot ou d’une mijoteuse."
                            },
                            {
                                "example_id": "e493404a-1c02-49e7-bbac-191fd0d05c41",
                                "sense_id": "7e8eda6f-dce8-3d05-ac98-9a58a8808d6c",
                                "text": "Idem pour ces multicuiseurs aux recettes prétendument programmées. Encore faut-il laver, éplucher, couper et trier les légumes ! La faute aux traditions sans doute."
                            },
                            {
                                "example_id": "c149361f-8857-4983-bd4c-db3ac0a0f93e",
                                "sense_id": "7e8eda6f-dce8-3d05-ac98-9a58a8808d6c",
                                "text": "D'autres techniques de remise en température peuvent être utilisées (polycuiseurs ou multicuiseurs, cuiseurs à vapeur sans pression, enceintes à micro-ondes)."
                            }
                        ]
                    }
