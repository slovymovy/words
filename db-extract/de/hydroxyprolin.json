                    {
                        "sense_id": "d73636ed-a056-3514-b566-d1de24be91b5",
                        "entry_id": "542dace2-9217-3109-a4af-868b6dbe1df8",
                        "glosses": [
                            "eine α-Aminosäure, die chemisch gebunden im Kollagen vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f772a094-3209-40d1-89f2-29ff32f5986c",
                                "sense_id": "d73636ed-a056-3514-b566-d1de24be91b5",
                                "text": "„Der Bindegewebeanteil wird berechnet auf Grund des Verhältnisses zwischen Kollagengehalt und Fleischeiweißgehalt. Als Kollagengehalt gilt der mit dem Faktor 8 vervielfältigte Gehalt an Hydroxyprolin.“"
                            },
                            {
                                "example_id": "85c48291-9cb6-40ad-88e9-1a601b2d61e2",
                                "sense_id": "d73636ed-a056-3514-b566-d1de24be91b5",
                                "text": "„Im Kollagen kommt [L-Prolin] als Hydroxyprolin vor.“"
                            },
                            {
                                "example_id": "88fa6347-d82c-4fc0-9c06-72d956ac5ea2",
                                "sense_id": "d73636ed-a056-3514-b566-d1de24be91b5",
                                "text": "„Untersuchungen zur Abhängigkeit der Glykosylierung vom Zellzyklus zeigen schließlich einen Umbau der Hydroxyprolin gebundenen Glykane während der vegetativen Fortpflanzung der Grünalge.“"
                            }
                        ],
