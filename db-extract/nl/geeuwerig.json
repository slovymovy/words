                "senses": [
                    {
                        "sense_id": "3caa6083-61ec-324a-bfe8-267a823142b9",
                        "entry_id": "5f28f236-af8e-3403-8753-a03e2552d644",
                        "glosses": [
                            "op een slaperige, vermoeide, saaie manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5d7812-6d65-40b7-b00d-8d48cdfd4ec3",
                                "sense_id": "3caa6083-61ec-324a-bfe8-267a823142b9",
                                "text": "In het begin van de avond had Peper er nog bijgezeten alsof het hem niet aanging. Een beetje lacherig, een beetje geeuwerig, een beetje schouderophalerig, kortom heel erg Peperig. Hij begint ook steeds vermoeider te praten – als iemand die aan het einde van zijn krachten is. Misschien komt het hem wel goed uit als vandaag het doek valt."
                            },
                            {
                                "example_id": "ba80a5d8-7313-45f8-97bd-cda55878efa6",
                                "sense_id": "3caa6083-61ec-324a-bfe8-267a823142b9",
                                "text": "Niets is vermoeiender dan de sociale komedie, dat was duidel[i]jk aan deze vrouw te zien. Eentonig en geeuwerig breidde ze haar mobiele zinnen aan elkaar."
                            }
                        ]
                    }
                ],
