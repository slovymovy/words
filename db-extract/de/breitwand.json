                        "source_entry_id": "cd34e1cb-e0ef-357c-9abf-d617ebf60b40",
                        "source_sense_id": "a8c82529-a121-3add-8570-80ac913af26f",
                        "source_sense_description": "breite Bildwand",
                        "target_lang_word": "grand écran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grand écran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c93c03c2-fa8d-33a9-8996-5f0341849935",
                                        "entry_id": "459fde3e-7371-3139-8a32-69d674ba5500",
                                        "glosses": [
                                            "Écran de projection de film de cinéma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be19e8c-9f0b-4764-a787-134349868f8a",
                                                "sense_id": "c93c03c2-fa8d-33a9-8996-5f0341849935",
                                                "text": "Pour faire une présentation sur grand écran ou vidéo-projecteur, vous avez le choix entre utiliser votre portable comme d’habitude, en regardant son propre écran, ou bien l’utiliser en regardant directement ce que vous faites sur le grand écran ou la projection."
                                            },
                                            {
                                                "example_id": "23f1d744-b7d2-40a2-8258-508c8842a52c",
                                                "sense_id": "c93c03c2-fa8d-33a9-8996-5f0341849935",
                                                "text": "Les images saisies par les diverses caméras sont dirigées vers la cabine de régie télévisuelle où l’on opère leur sélection et d’où on les envoye aux trois eidophores placés au fond de la salle qui les projette instantanément sur les grands écrans disposés dans l’espace de la scène."
                                            },
                                            {
                                                "example_id": "8d1c8daf-81ea-4550-a8f3-ce5459130601",
                                                "sense_id": "c93c03c2-fa8d-33a9-8996-5f0341849935",
                                                "text": "La vue y était dégagée comme la densité capillaire de Giscard. Elle était maousse, grandiose, aussi choucarde qu'un boulard en HD sur grand écran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc0034a-172f-3cae-9f51-e25c9b511cab",
                                        "entry_id": "459fde3e-7371-3139-8a32-69d674ba5500",
                                        "glosses": [
                                            "(uniquement au singulier) Cinéma, septième art, cinématographie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c11760-b1b2-4688-aa97-c897acf35da4",
                                                "sense_id": "1cc0034a-172f-3cae-9f51-e25c9b511cab",
                                                "text": "Les moyens financiers ont été suffisamment importants pour accueillir des réalisateurs de cinéma célèbres (par exemple Maroun Bagdadi), et surtout des stars du grand écran : Emmanuelle Béart, Richard Bohringer, Stéphane Freiss..."
                                            },
                                            {
                                                "example_id": "4f6e1b4c-4dc1-4b7b-9928-3ad95878df5e",
                                                "sense_id": "1cc0034a-172f-3cae-9f51-e25c9b511cab",
                                                "text": "En 1943, l’Auvergne était projetée sur grand écran dans « L’Éternel Retour » de Jean Delannoy, mettant en scène Jean Marais au château de Pestells."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
