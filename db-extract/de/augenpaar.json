                ],
                "senses": [
                    {
                        "sense_id": "7dfd937b-e4dd-371c-bb1d-208984710f81",
                        "entry_id": "93309caa-b9a3-353c-a661-9460c980193b",
                        "glosses": [
                            "die beiden Augen einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba5e1803-33c3-4d79-afaf-8c105b7751f6",
                                "sense_id": "7dfd937b-e4dd-371c-bb1d-208984710f81",
                                "text": "„Jedes Augenpaar im Raum ruhte nun auf Dwayne.“"
                            },
                            {
                                "example_id": "06a0534c-7398-45d4-a47a-9f8a07d21750",
                                "sense_id": "7dfd937b-e4dd-371c-bb1d-208984710f81",
                                "text": "„Zu wissen, dass gleich hunderte Augenpaare auf uns und bei meinem Solo auf mich gerichtet sein werden, lässt das Kribbeln in meinem Bauch stärker werden.“"
                            },
                            {
                                "example_id": "2bfe2cf0-a733-4987-9374-4c4fb2964804",
                                "sense_id": "7dfd937b-e4dd-371c-bb1d-208984710f81",
                                "text": "„An braver, ernster Lebensführung hatte der Besitzer eines solchen Augenpaares bestimmt keine Freude.“"
                            },
                            {
                                "example_id": "a65ae0e5-80c3-4aef-b7d8-60476aa76ccb",
                                "sense_id": "7dfd937b-e4dd-371c-bb1d-208984710f81",
                                "text": "„Hunderte von Augenpaaren starrten ihn aus einer wächsernen Stille an.“"
                            },
                            {
                                "example_id": "a8c0e69f-abea-46cf-b72e-682e5e903259",
                                "sense_id": "7dfd937b-e4dd-371c-bb1d-208984710f81",
                                "text": "„Das einzige Licht spiegelt sich in einhundert Augenpaaren wider, alle sind auf mich gerichtet, alle warten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
