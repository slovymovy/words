            "senses": [
                {
                    "sense_id": "2c3a2809-9a43-3f1c-8b87-8f06b8af21ed",
                    "sense_definition": "Extremely annoying, frustrating or irritating",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>infuriating</w> when the computer crashes right before I finish my work.",
                            "target_lang_translations": {
                                "nl": "Het is <w>woedend makend</w> wanneer de computer crasht vlak voordat ik mijn werk af heb."
                            }
                        },
                        {
                            "text": "The constant noise from the construction site outside was truly <w>infuriating</w>.",
                            "target_lang_translations": {
                                "nl": "Het constante lawaai van de bouwplaats buiten was werkelijk <w>om gek van te worden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "frustrating",
                        "irritating",
                        "exasperating"
                    ],
                    "common_phrases": [
                        "infuriating habit",
                        "infuriating delay"
                    ],
                    "target_lang_definitions": {
                        "nl": "Extreem vervelend, frustrerend of irriterend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "woedend makend",
                                "target_lang_sense_clarification": "letterlijk: wat iemand woedend maakt"
                            },
                            {
                                "target_lang_word": "razend makend",
                                "target_lang_sense_clarification": "nadruk op de intense irritatie"
                            },
                            {
                                "target_lang_word": "om gek van te worden",
                                "target_lang_sense_clarification": "idiomatische uitdrukking voor iets zeer frustrerends"
                            }
                        ]
                    }
                }
            ]
        },
        {
