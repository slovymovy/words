                "senses": [
                    {
                        "sense_id": "0073b015-dda3-3670-a63f-224237d2d0d6",
                        "entry_id": "2fb23d2f-92ca-3816-8dc4-95ee2e4ad08e",
                        "glosses": [
                            "Hedera helix, een groenblijvende houtige plant die groeit op vochtige, voedselrijke grond langs muren en tegen bomen waaraan de plant zich met korte luchtwortels vastklampt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d925cf3-b95c-413f-890d-02d21fabf7ad",
                                "sense_id": "0073b015-dda3-3670-a63f-224237d2d0d6",
                                "text": "De zuilengalerij was begroeid met klimop. Een van de grote aardewerken vazen waaruit bougainville golfde, was gebarsten. Onkruid groeide tussen het grind. Vredig, maar dat was het woord niet. Berustend. Men zou het verstrijken van de tijd en het verlies van alle dingen inderdaad net zo goed kunnen aanvaarden."
                            },
                            {
                                "example_id": "2cd35583-2945-46d3-bbdb-d0350d852b1c",
                                "sense_id": "0073b015-dda3-3670-a63f-224237d2d0d6",
                                "text": "Ik zag de ratten niet die in het donker rondrenden, noch hoorde ik het geknars van termieten die zich te goed deden aan dakspanten en schoren. Ik voelde de klimop niet die aan de stenen trok en de torens in zand veranderde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b72ecfe-71b8-4584-bf44-5ba4ec12ce37",
                        "source_entry_id": "2fb23d2f-92ca-3816-8dc4-95ee2e4ad08e",
                        "source_sense_id": "0073b015-dda3-3670-a63f-224237d2d0d6",
                        "source_sense_description": "Hedera helix, een groenblijvende houtige plant",
