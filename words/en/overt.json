            "senses": [
                {
                    "sense_id": "a2729b7b-536d-3e7a-8e5c-04a1bdbaf2dc",
                    "sense_definition": "An action or condition deemed detrimental to survival and considered unethical, particularly within Scientology doctrine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Members of the group were pressured to confess every past <w>overt</w> during the auditing session.",
                            "target_lang_translations": {
                                "ru": "На членов группы оказывали давление, заставляя исповедоваться в каждом прошлом <w>оверте</w> во время сеанса одитинга."
                            }
