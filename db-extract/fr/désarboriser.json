                "senses": [
                    {
                        "sense_id": "412e0655-440c-3ce6-ac97-79f3114829fc",
                        "entry_id": "e85d587f-15aa-33ce-9a7b-741a5c37357b",
                        "glosses": [
                            "Faire perdre son caractère arboré à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d4b930-f6ed-4a92-9bd0-4fb17839cc46",
                                "sense_id": "412e0655-440c-3ce6-ac97-79f3114829fc",
                                "text": "Vue vers l'ouest dans une zone rurale où domine le matériel morainique à moitié désarborisé."
                            },
                            {
                                "example_id": "b3f21bfa-124e-490e-92f6-c8aefb4096f0",
                                "sense_id": "412e0655-440c-3ce6-ac97-79f3114829fc",
                                "text": "Et si les chargés de l'abattage diurne poursuivent leur zèle en allant \"désarboriser\" l'autre rive....vous savez ce qui va se passer?"
                            }
                        ]
                    },
                    {
                        "sense_id": "6bd862a6-1fbd-3190-bad7-f001898a2d69",
                        "entry_id": "e85d587f-15aa-33ce-9a7b-741a5c37357b",
                        "glosses": [
                            "Faire perdre son caractère arborescent à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac1f8749-f56b-4be2-bef0-a121837d4423",
                                "sense_id": "6bd862a6-1fbd-3190-bad7-f001898a2d69",
                                "text": "Ce petit outil est très rapide et permet de \"désarboriser\" ou plutôt linéaliser les fichiers en parcourant tout le disque et tous les répertoires."
                            }
                        ]
                    }
