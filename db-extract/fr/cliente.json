                                        "entry_id": "7145ff33-1879-3776-9ce4-7f9e4c7f507e",
                                        "glosses": [
                                            "женск. к клиент"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16de17f0-e966-47dc-99e0-097037dfaa12",
                                                "sense_id": "fc86c929-5740-3080-a845-09b83ba84a48",
                                                "text": "Когда после очередной победы в суде к нему пришла клиентка и стала причитать: «Как же я могу вас отблагодарить?»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86be7de0-1888-4f7a-8860-441653ea14a5",
