                        ],
                        "examples": [
                            {
                                "example_id": "98e1cf46-e582-470e-af14-a5b096a88bd6",
                                "sense_id": "63442588-c16b-3661-a5e7-d6a689398d65",
                                "text": "The authors hazard the guess that the oxolation of ol complexes would result in a loss of the reaction with neutral salts described in this paper."
                            },
                            {
                                "example_id": "eae3ed4d-8364-4dd7-ac3f-82195525d3a5",
                                "sense_id": "63442588-c16b-3661-a5e7-d6a689398d65",
                                "text": "The OH groups in the complex are not ol groups but rather hydroxy groups which can add hydrogen ions thereupon being converted into aquo groups."
                            },
                            {
                                "example_id": "95670d92-5552-4fb0-9503-159e3bc76da2",
                                "sense_id": "63442588-c16b-3661-a5e7-d6a689398d65",
                                "text": "This species with the hydroxo or ol bridges can react in the presence of added base as follows: […]"
                            },
                            {
                                "example_id": "8bf3c8ae-da89-4863-9370-cf57e087f789",
                                "sense_id": "63442588-c16b-3661-a5e7-d6a689398d65",
                                "text": "In very acidic medium, the effect of gel coloring should disappear due to the condensation of the ol-group and the formation of oxy-polymers."
                            }
                        ]
                    }
                ],
