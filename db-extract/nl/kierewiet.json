                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10a85086-7233-4ddd-afa5-49b06e5d98c9",
                                                "sense_id": "d81b6279-bbea-36ec-a5e5-2bd39d638b0a",
                                                "text": "You might go gaga if you stare at this screen too long."
                                            },
                                            {
                                                "example_id": "489396c8-fc97-43f0-bc44-c36216064fdc",
                                                "sense_id": "d81b6279-bbea-36ec-a5e5-2bd39d638b0a",
                                                "text": "Should he lose it once and for all, he and Kathleen would need lots of money. Also, he had said to me, you could be gaga in a tenured chair at Princeton, and would anybody notice?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd3dda4-5eff-3ab1-a5ed-67533070477a",
                                        "entry_id": "24ec2435-032c-3733-82eb-a5198f502ae0",
                                        "glosses": [
                                            "Infatuated."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ba50569-57c8-4e84-92ca-2156f8f197b0",
                                                "sense_id": "6dd3dda4-5eff-3ab1-a5ed-67533070477a",
                                                "text": "The girls were going gaga over the handsome new boy who joined the class."
                                            }
                                        ]
                                    }
                                ]
                            },
