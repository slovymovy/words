                "senses": [
                    {
                        "sense_id": "5bc721af-dca9-3f34-a2a4-34cb4aa5b868",
                        "entry_id": "3cd90a6e-a459-345a-928a-84da9c70a990",
                        "glosses": [
                            "Sorte de contrat de prêt à la grosse aventure, qui était assigné sur la quille ou bodine du vaisseau, & où l’on hypothéquait le navire et sa marchandise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a6bd0b-d554-4933-bcae-c7b86a76d5b2",
                                "sense_id": "5bc721af-dca9-3f34-a2a4-34cb4aa5b868",
                                "text": "La bodinerie diffère du contrat d’assurance, en ça qu’on ne paye point de prime, & qu’il n'est rien dû en cas de naufrage, prise d’armateurs, pirates corsaires, mais seulement quand il arrive heureusement à bon port, on paye la somme principale avec l’intérêt ou profit maritime stipulé dans ledit contrat."
                            }
                        ]
                    }
                ],
