                        "entry_id": "9228b5c1-aa95-3755-9caf-3fc7706d611a",
                        "glosses": [
                            "автономный край Сербии, расположенный севернее Дуная в пределах южной части Среднедунайской низменности"
                        ],
                        "tags": [],
