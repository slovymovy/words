        "fr-extract.jsonl": [
            {
                "entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                "word": "provincialisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f7b49b0d-cd60-4ef8-bbe5-5858b5b9b9f4",
                        "entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                        "tags": [
                            "plural"
                        ],
                        "form": "provincialismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "198341f0-cdb3-33c7-afcc-cbde79db3f67",
                        "entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                        "glosses": [
                            "Locution particulière à une province."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "89349580-3ef1-41b4-a5de-a07f879d8105",
                                "sense_id": "198341f0-cdb3-33c7-afcc-cbde79db3f67",
                                "text": "On remarque dans le style de cet écrivain un certain nombre de provincialismes."
                            }
                        ]
                    },
                    {
                        "sense_id": "32123fc0-340b-30e7-84c7-8cfc8ecda566",
                        "entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                        "glosses": [
                            "Attachement sentimental à sa province."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fa15bfc5-3128-48d6-a887-d440d994f0b7",
                                "sense_id": "32123fc0-340b-30e7-84c7-8cfc8ecda566",
                                "text": "Une culture plus générale et la fréquentation des gens d'une autre région annulent rapidement le provincialisme : […]."
                            },
                            {
                                "example_id": "936a1d7d-5b52-4c31-ba8a-e608287e2f6c",
                                "sense_id": "32123fc0-340b-30e7-84c7-8cfc8ecda566",
                                "text": "Le provincialisme ou le fait de vivre dans une région, d’y travailler et, de quelque manière, de participer d’elle, a longtemps grevé les destins d’artistes dans une France centralisatrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d3ff1ce-c0f3-325a-9634-4445add6390d",
                        "entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                        "glosses": [
                            "Tendance à favoriser les droits des provinces (du Canada) vis-à-vis du pouvoir fédéral."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "95da0571-9ebf-3cd5-ad66-bbd686f4eac6",
                        "entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                        "glosses": [
                            "Tendance à se borner au rôle donné à un gouvernement provincial ou une législature provinciale, par opposition à planifier la construction de l’État québécois en vue de son indépendance."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "0e3829d0-78e9-472a-acbf-6c7d3b3c9c06",
                                "sense_id": "95da0571-9ebf-3cd5-ad66-bbd686f4eac6",
                                "text": "Pour que le premier ministre Legault réalise que le provincialisme mène à notre extinction. L’indépendance s’impose !"
                            }
                        ]
                    },
                    {
                        "sense_id": "726a7af4-d206-39a9-8083-2c60a97505da",
                        "entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                        "glosses": [
                            "Caractéristique d'une unité géographique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c7c891-8747-4e2e-99a2-3caeb1443c85",
                                "sense_id": "726a7af4-d206-39a9-8083-2c60a97505da",
                                "text": "La province zoogéographique était définie comme une vaste aire où est présente une faune caractéristique en raison d'une position géographique par rapport à des barrières (y compris climatiques), en excluant ainsi le faciès en tant que facteur de contrôle du provincialisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c258df1d-d90b-4eaf-a6ae-0ff8b08bd2d4",
                        "source_entry_id": "bec25eb6-5b54-3162-ae11-b53690143926",
                        "target_lang_word": "provincialism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provincialism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea55202-f5c2-3ea9-b947-77adb018fc3d",
                                        "entry_id": "7d2cdfc5-957f-3cee-9a49-fdfeead24448",
                                        "glosses": [
                                            "The quality of being provincial; having provincial tastes, mentality, manners."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5942b05-336f-41a6-aef1-dcc91a99a37b",
                                                "sense_id": "7ea55202-f5c2-3ea9-b947-77adb018fc3d",
                                                "text": "The blacksmith's provincialism showed in his speech and manner"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8992eaee-e43a-3b6a-83c2-cab03941e4d1",
                                        "entry_id": "7d2cdfc5-957f-3cee-9a49-fdfeead24448",
                                        "glosses": [
                                            "A word or locution characteristic of a region or district."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0a2f2fb-1851-4655-b773-9c6f9dd3255c",
                                                "sense_id": "8992eaee-e43a-3b6a-83c2-cab03941e4d1",
                                                "text": "Prose is allowed less liberty in this respect; but no one nowadays would maintain that the adoption of a provincialism into the literary dialect is absolutely prohibited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e95dd412-4072-3180-859f-41094f7d6a79",
                                        "entry_id": "7d2cdfc5-957f-3cee-9a49-fdfeead24448",
                                        "glosses": [
                                            "Synonym of regionalism: belief in the superiority of one's regional government; the belief that most or nearly all political power should be decentralized to provincial governments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
