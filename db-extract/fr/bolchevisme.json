                    {
                        "sense_id": "c6584ac4-22f4-356b-a966-002799567d4a",
                        "entry_id": "ded05e6e-ce9d-3d87-8b0d-0053b41d3c63",
                        "glosses": [
                            "Variante de bolchévisme."
                        ],
                        "tags": [
                            "Communisme"
                        ],
                        "examples": [
                            {
                                "example_id": "9b49adc3-f916-480e-9228-273ec5079f06",
                                "sense_id": "c6584ac4-22f4-356b-a966-002799567d4a",
                                "text": "Autour d'eux, des intellectuels, des écrivains d’avant-garde, snobs gagnés à un bolchevisme moral et politique, arrivistes précocement aigris, les appuient et les encadrent."
                            },
                            {
                                "example_id": "b2c95aa5-6f1e-4193-8b5f-3d658de11d68",
                                "sense_id": "c6584ac4-22f4-356b-a966-002799567d4a",
                                "text": "Ces ignorances furent le terreau sur lequel s’épanouirent l’influence puis l’emprise que le bolchevisme gagna sur les nouveaux partis communistes, par le truchement de la IIIᵉ Internationale."
                            }
                        ]
                    }
