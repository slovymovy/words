                    {
                        "translation_id": "a19b0ca4-d572-44c5-9671-60e00e772c1c",
                        "source_entry_id": "24a698a5-71c4-36eb-9c0a-bba107804c9a",
                        "source_sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                        "target_lang_word": "психосоматический",
                        "target_lang_code": "ru",
