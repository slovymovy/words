            {
                "entry_id": "70ad52f9-1a93-3137-ace9-dc519e8171a2",
                "word": "Sprachgefühl",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "446e31e3-0481-3065-98f7-f92124fecd61",
                        "entry_id": "70ad52f9-1a93-3137-ace9-dc519e8171a2",
                        "glosses": [
                            "The instinctive or intuitive grasp of the natural idiom of a language."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5756c6b8-11a9-46e2-b847-7371202c723a",
                                "sense_id": "446e31e3-0481-3065-98f7-f92124fecd61",
                                "text": "Not everyone has sprachgefühl, and you don't know if you are possessed of it until you are knee-deep in the English language, trying your best to navigate the murky swamp of it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c06baf8d-086c-4222-be19-4b0479f8f6cb",
                        "source_entry_id": "70ad52f9-1a93-3137-ace9-dc519e8171a2",
                        "source_sense_id": "446e31e3-0481-3065-98f7-f92124fecd61",
                        "source_sense_description": "the instinctive or intuitive grasp of a language",
                        "target_lang_word": "taalgevoel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taalgevoel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8810af1c-627b-3d50-a1f1-9b4903701d84",
                                        "entry_id": "9d997ba9-c4dd-3bc0-b4f3-a7a766d7a788",
                                        "glosses": [
                                            "het vermogen om het juiste gebruik van een taal aan te voelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af61fae8-051b-4ded-a9f8-645ecb2bd378",
                                                "sense_id": "8810af1c-627b-3d50-a1f1-9b4903701d84",
                                                "text": "Hij kon zich niet meer herinneren wat voor regel hiervoor was, maar zijn taalgevoel zei hem dat het \"de groene auto\" moest zijn."
                                            },
                                            {
                                                "example_id": "7f613470-82ec-40b4-a4e9-cfdba5b34343",
                                                "sense_id": "8810af1c-627b-3d50-a1f1-9b4903701d84",
                                                "text": "Tekstdichter Lennaert Nijgh (1945-2002) toont op het legendarische album Voor De Overlevenden van Boudewijn de Groot (1944) in Testament zijn grote verbeeldingskracht, levenswijsheid en poëtisch taalgevoel. In glasheldere zinnen vertelt hij zijn verhaal, waarin een enkel archaïsch woord - gaarne, placht - een subtiel ornament vormt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74be1e80-bb6a-4267-85eb-10f257063fc5",
                        "source_entry_id": "70ad52f9-1a93-3137-ace9-dc519e8171a2",
                        "source_sense_id": "446e31e3-0481-3065-98f7-f92124fecd61",
                        "source_sense_description": "the instinctive or intuitive grasp of a language",
                        "target_lang_word": "Sprachgefühl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachgefühl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01ab9350-0931-3a75-95f3-df072c920477",
                                        "entry_id": "301f70c2-b571-395d-9e63-cbf31c8afcb8",
                                        "glosses": [
                                            "Gespür einer Person für grammatische und stilistische Angemessenheit von Formulierungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae075f0e-5150-4527-803d-f51055300c98",
                                                "sense_id": "01ab9350-0931-3a75-95f3-df072c920477",
                                                "text": "„Gebrauchsfeststellungen größeren Ausmaßes sind nicht vorgenommen worden. Der Grammatiker verließ sich zu stark auf seinen persönlichen Sprachbesitz (Sprachgefühl).“"
                                            },
                                            {
                                                "example_id": "c36b9bbc-4468-4592-90e1-fb7f39e0dafa",
                                                "sense_id": "01ab9350-0931-3a75-95f3-df072c920477",
                                                "text": "„Über Sprachgefühl, über guten und sicheren Ausdruck, über flüssigen, angemessenen, gar eleganten Stil läßt sich nämlich streiten, und verschiedene Bewertungskriterien sind möglich.“"
                                            },
                                            {
                                                "example_id": "84ea3d22-c8f3-42f2-9b49-da04a7f3d38a",
                                                "sense_id": "01ab9350-0931-3a75-95f3-df072c920477",
                                                "text": "„Das »Sprachgefühl« ist hier nicht mehr der dunkle Nebel, den es durch Vernunfterkenntnis zu erhellen, aufzuklären und also eigentlich abzuschaffen gilt, sondern das Sprachgefühl ist jetzt die Quelle assoziativer, aber gültiger Erkenntnis über die Sprache.“"
                                            },
                                            {
                                                "example_id": "3b025c0d-3391-4736-8393-8210c44517e0",
                                                "sense_id": "01ab9350-0931-3a75-95f3-df072c920477",
                                                "text": "„Nach meinem Sprachgefühl waren sowohl »Ische« als auch »Schickse« negativ konnotiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
