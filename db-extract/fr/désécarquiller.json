                        "glosses": [
                            "Ne plus écarquiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1949df18-c53a-4622-9705-f76afdbd7db5",
                                "sense_id": "977222d0-2cb2-3dc7-84a6-1c927c66374f",
                                "text": "Il a cligné des yeux plusieurs fois avant de parvenir à les désécarquiller pour froncer les sourcils."
                            },
                            {
                                "example_id": "cd4dbd21-9d22-40cc-b805-b82d9e7b02f3",
                                "sense_id": "977222d0-2cb2-3dc7-84a6-1c927c66374f",
                                "text": "Ah (le temps de rebondir et de désécarquiller les yeux) ! Ce sont des pâtes, un peu comme des spaghettis."
                            },
                            {
                                "example_id": "4f4d32fb-0e14-4163-a162-f35bcd0996bd",
                                "sense_id": "977222d0-2cb2-3dc7-84a6-1c927c66374f",
                                "text": "Désécarquiller les yeux : VOIR où nous allons."
                            },
                            {
                                "example_id": "0bef541d-5b0f-40b6-a871-ca1f216f4670",
                                "sense_id": "977222d0-2cb2-3dc7-84a6-1c927c66374f",
                                "text": "Tandis qu’elle essayait de se désécarquiller les yeux, il a tourné le regard vers moi, le buste calé contre le mur."
                            }
                        ]
                    }
                ],
