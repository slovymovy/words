                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b171577-93aa-4f69-b50e-254573149f62",
                                "sense_id": "1a408f41-25f6-37ff-a8ca-40914965b4f4",
                                "text": "Hé ! tétigué ! ne lantiponez point davantage."
                            },
                            {
                                "example_id": "071a2ece-ad0e-4ddd-8ead-23f1e66e75c2",
                                "sense_id": "1a408f41-25f6-37ff-a8ca-40914965b4f4",
                                "text": "TATIGUÉ, TETIGUÉ, TETIGOINE, ou TATIGOINE. Sorte de jurement burlesque & paysan. Tatigoine n'est que dans la bouche des polissons. Tatigué est fort en usage chez les gens de village.\nTatigué je vois bien que vous êtes mon homme.\nBoursaut."
                            }
                        ]
                    }
