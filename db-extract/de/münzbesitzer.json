                "senses": [
                    {
                        "sense_id": "7c6aaec6-0b2d-36b3-9f30-2f893d740444",
                        "entry_id": "f6b7bd14-5113-39a4-93a7-fa2cebc5c218",
                        "glosses": [
                            "Person, der ein oder mehrere Geldstücke gehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61912d5-2f9b-42ac-907c-00a295e5604f",
                                "sense_id": "7c6aaec6-0b2d-36b3-9f30-2f893d740444",
                                "text": "„Die Münzverrufung brachte dem Münzherren einen Gewinn, dem Münzbesitzer aber einen realen Verlust und stellte gleichsam eine Form indirekter Besteuerung dar.“"
                            },
                            {
                                "example_id": "0b131f28-ad19-4819-9214-fed4912814a8",
                                "sense_id": "7c6aaec6-0b2d-36b3-9f30-2f893d740444",
                                "text": "„Durch Verringerung des Edelmetallgehaltes, Münzverrufe und -valvationen wurden die Münzbesitzer indirekt besteuert und büßten erhebliche Teile ihres Vermögens ein.“"
                            },
                            {
                                "example_id": "c91dab32-0bbe-4eb8-a769-f62e643b4e08",
                                "sense_id": "7c6aaec6-0b2d-36b3-9f30-2f893d740444",
                                "text": "„Bisweilen nämlich sind die Münzbesitzer gar nicht geneigt, ihre gesammelten Münzvorräthe in Umlauf zu setzen, sondern ziehen es vor, sie zu verschließen oder zu vergraben.“"
                            },
                            {
                                "example_id": "265ddac1-8ef2-4554-889d-d06898226dc4",
                                "sense_id": "7c6aaec6-0b2d-36b3-9f30-2f893d740444",
                                "text": "„Münzbesitzer erhielten eine geringere Anzahl neuer Münzen zurück, meistens neun statt zwölf Pfennige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
