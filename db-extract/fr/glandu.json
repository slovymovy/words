                "senses": [
                    {
                        "sense_id": "d22d558b-a7cd-3764-a6ee-c30f82b2b603",
                        "entry_id": "01ba458d-0ad3-3efa-b4e2-6a7cdce9e79e",
                        "glosses": [
                            "Personne quelconque, sans importance, sans esprit."
                        ],
                        "tags": [
                            "colloquial",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "00ac8265-f64a-4ec4-a41e-07044a6abe12",
                                "sense_id": "d22d558b-a7cd-3764-a6ee-c30f82b2b603",
                                "text": "Alors m'entendre dire que je suis un glandu, un étudiant attardé, non."
                            },
                            {
                                "example_id": "d05fce94-595e-4230-a685-f02db2399ee5",
                                "sense_id": "d22d558b-a7cd-3764-a6ee-c30f82b2b603",
                                "text": "Je me suis reculé jusque sur un trottoir, où des braseros crépitaient dans la fumée gerbante des merguez aux abats félins, et où des malins manchaient de manière variée au centre de cercles serrés de glandus goguenards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bd5ceae-2ad2-4b36-b7fc-6d6b6c73abff",
                        "source_entry_id": "01ba458d-0ad3-3efa-b4e2-6a7cdce9e79e",
                        "source_sense_id": "d22d558b-a7cd-3764-a6ee-c30f82b2b603",
                        "target_lang_word": "Dödel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dödel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd97ef7-ef4e-3c34-b766-2bc8314fe7c4",
                                        "entry_id": "034d8b2f-27d5-3621-833d-27ce0ceb37d3",
                                        "glosses": [
                                            "wenig intelligenter, einfältiger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666d718d-2470-45fa-866d-ee2d2180fbfd",
                                                "sense_id": "3fd97ef7-ef4e-3c34-b766-2bc8314fe7c4",
                                                "text": "Diesen Dödel muss man doch nicht ernst nehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "449144eb-cb41-3253-9342-ff8427c26a89",
                                        "entry_id": "034d8b2f-27d5-3621-833d-27ce0ceb37d3",
                                        "glosses": [
                                            "männliches Geschlechtsteil"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfedcf75-8858-426f-b120-39f8b1e29d26",
                                                "sense_id": "449144eb-cb41-3253-9342-ff8427c26a89",
                                                "text": "„Und ich versichere dir, heute Nacht wird er ganz sicher der einundvierzigsten Frau seinen Dödel reinstecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8157a4de-9c1f-4203-a448-9aa6aff832d2",
                        "source_entry_id": "01ba458d-0ad3-3efa-b4e2-6a7cdce9e79e",
                        "source_sense_id": "d22d558b-a7cd-3764-a6ee-c30f82b2b603",
                        "target_lang_word": "Blödian",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blödian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                        "entry_id": "9cca6c6b-336d-33ab-97b4-145099de777d",
                                        "glosses": [
                                            "dummer Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783beffb-578d-4c30-bdea-b94cc00ce6a6",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Auf dem Plakat ist ein Blödian in Hippie-Outfit zusehen, der seine zu einem Victory-Zeichen gespreizten Finger mit Aufschnitt umwickelt hat.“"
                                            },
                                            {
                                                "example_id": "59e8a379-194a-4dda-8305-ec410757fb7f",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Er hatte einen enormen Misthaufen von Blödian dabei.“"
                                            },
                                            {
                                                "example_id": "632afa89-63c7-4584-a8e1-3b2fb79132b0",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Aber wie es so geht – hin und wieder tauchte doch mal ein richtig ausgekochter Blödian auf – einer, der neunzig Prozent seines Lebens seiner Wirbelsäule verdankte – und fing immer wieder damit an, bis schließlich sogar Mr. McAllister es nicht länger mit anhören konnte.“"
                                            },
                                            {
                                                "example_id": "422975ab-8cce-4b24-8773-1f483e0da20f",
                                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                                "text": "„Dieser Blödian in der Feldkommandantur wußte ja nicht einmal, wo die Straße gesperrt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "113eb0a0-5338-458c-a344-03a667754ed8",
                        "source_entry_id": "01ba458d-0ad3-3efa-b4e2-6a7cdce9e79e",
                        "source_sense_id": "d22d558b-a7cd-3764-a6ee-c30f82b2b603",
                        "target_lang_word": "Dumpfbacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dumpfbacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                        "entry_id": "a7566c3c-56ac-33af-ad07-ff10594d08bc",
                                        "glosses": [
                                            "naive, törichte und dumme Person, die es an jeglichem Einfühlungsvermögen gegenüber Mitmenschen fehlen lässt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f57a8b4-c33f-411b-8c6a-afad8e3d440d",
                                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                                "text": "„Mit drastischen Worten haben die Bundesminister Steinmeier und Schäuble vor Stimmungsmache mit den Ängsten der Bürger gewarnt. Steinmeier bezeichnete dies als „geistige Brandstiftung“. Sein Kabinettskollege warnte vor dem Wetteifern mit „Dumpfbacken“.“"
                                            },
                                            {
                                                "example_id": "84dcd6e1-49d1-4317-b95d-40033bae026e",
                                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                                "text": "Du bist eine Dumpfbacke!"
                                            },
                                            {
                                                "example_id": "160351c1-aac6-48df-8018-32e7da195bfb",
                                                "sense_id": "a891512b-39f9-3283-bfb2-b3777f9d6666",
                                                "text": "„Jene Dumpfbacken, die von den Tribünen in Gelsenkirchen aus den dunkelhäutigen Hertha-Verteidiger Jordan Torunarigha mit Affenlauten bedachten, sollten einen Blick ins Grundgesetz werfen. Sie brauchen nicht mal weiter als Artikel 3 zu lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2a670a5-ed85-4932-9609-169838245fd2",
                        "source_entry_id": "01ba458d-0ad3-3efa-b4e2-6a7cdce9e79e",
                        "source_sense_id": "d22d558b-a7cd-3764-a6ee-c30f82b2b603",
                        "target_lang_word": "додик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "додик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac47519-221e-32f7-899c-cc2232bac8f3",
                                        "entry_id": "fafdde28-ac18-331c-b9f9-bd5016d77e7e",
                                        "glosses": [
                                            "жарг. гомосексуалист (в уголовном арго — молодой пассивный)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7071463-633c-4436-9fde-43fd2567e460",
                                                "sense_id": "0ac47519-221e-32f7-899c-cc2232bac8f3",
                                                "text": "В неестественно раскрытых совиных глазах Ястребова вспыхнули ржавые белки, в них металось безумие… Под ним бился молодой додик по кличке Снежинка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b9e965-c38d-33ac-992f-9ded4300045d",
                                        "entry_id": "fafdde28-ac18-331c-b9f9-bd5016d77e7e",
                                        "glosses": [
                                            "жарг. ирон. женственный, женоподобный мужчина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36b8754-5c8b-44d9-ab67-781bd08a44f2",
                                                "sense_id": "56b9e965-c38d-33ac-992f-9ded4300045d",
                                                "text": "И реально, что бы вы думали, из-за кулис выходит какой-то додик, тощий, в зелёных очках и с лысой головой, подходит к микрофону и начинает вещать что-то тонким, по-бабьи жеманным голоском.〈…〉Он очень томно растягивает слова, выпячивает губы и делает все эти педиковские ужимки, которые я так ненавижу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a274a8e-eb5a-362b-bdfd-24176bcd620e",
                                        "entry_id": "fafdde28-ac18-331c-b9f9-bd5016d77e7e",
                                        "glosses": [
                                            "жарг. презр. или пренебр. хилый, ничем не примечательный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56d7aeef-c927-4e4a-9084-77fd96835ddb",
                                                "sense_id": "1a274a8e-eb5a-362b-bdfd-24176bcd620e",
                                                "text": "Например, решит профессор закончить пару пораньше и для приличия спросит, всё ли всем понятно. Группа уже сложила вещички и ждёт предложения разойтись по домам, и в этот момент Борис поднимает руку и говорит: «А вот я не понял один момент…». В результате народ тоскует и томится, один лишь Борис внимательнейшим образом слушает и кивает головой. Чаще всего в процессе кивания у него появляются и другие вопросы. После проявления такого интереса к предмету преподаватели начинали его уважать, студенты называть додиком, а девушки не любить, несмотря на очевидную красоту."
                                            },
                                            {
                                                "example_id": "26c42a7c-3be3-498f-9f3f-cc0234a00e11",
                                                "sense_id": "1a274a8e-eb5a-362b-bdfd-24176bcd620e",
                                                "text": "На прогулку во двор старейшей московской психиатрической больницы выпускали только с часу до двух дня и только самых спокойных обитателей. / — Маша, загоняй додиков! — кричала из окна второго этажа тётка в замызганном голубом халате и косынке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f064f0d7-b1a2-3d6b-a682-0f7ece7f1072",
                                        "entry_id": "fafdde28-ac18-331c-b9f9-bd5016d77e7e",
                                        "glosses": [
                                            "мол. пренебр. глупый, недалёкий человек, который поступает глупо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "додик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4997ec94-f3b4-31df-9fa6-4653755a168b",
                                        "entry_id": "b1887c54-017b-3583-a223-89c32318c3d0",
                                        "glosses": [
                                            "воен. жарг. бортовой грузовик с двухместной кабиной и деревянным кузовом моделей УАЗ-451Д и УАЗ-452Д"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "052e24c2-890f-4669-bd52-9a839c1449f8",
                                                "sense_id": "4997ec94-f3b4-31df-9fa6-4653755a168b",
                                                "text": "В нашу сторону они не проезжали, значит, направились вниз. Ну ничего — под горку даже «додик» грузовик сможет догнать."
                                            }
