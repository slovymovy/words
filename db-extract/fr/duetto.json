                                            {
                                                "example_id": "b1ee6aaf-2768-4936-95ce-a451c3f2e733",
                                                "sense_id": "ff1a2cb8-eaf2-3d7c-9ac8-035b08dfd716",
                                                "text": "Gegen Ende erreicht das Duett seinen Höhepunkt."
