        "fr-extract.jsonl": [
            {
                "entry_id": "17cad047-6e78-3d96-8b1f-9e0ac0c98e4e",
                "word": "bonapartiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "670abb73-258f-447a-adeb-19cb9091134a",
                        "entry_id": "17cad047-6e78-3d96-8b1f-9e0ac0c98e4e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "bonapartistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7e687b4-4767-3917-a34f-5a7dec8b0b81",
                        "entry_id": "17cad047-6e78-3d96-8b1f-9e0ac0c98e4e",
                        "glosses": [
                            "Relatif à l’organisation politique dictatoriale mise en place par Napoléon Bonaparte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57b2424a-ccfa-451a-b804-1a4411b89f2b",
                                "sense_id": "c7e687b4-4767-3917-a34f-5a7dec8b0b81",
                                "text": "Cette fin de l’année 1871 ne fut signalée que par la propagande des partis ; un grand nombre des brochures bonapartistes et légitimistes se distribuèrent en province."
                            },
                            {
                                "example_id": "4d38ed4d-2549-4fb8-80ac-321aff031d3d",
                                "sense_id": "c7e687b4-4767-3917-a34f-5a7dec8b0b81",
                                "text": "Et, quant au général, il ne regrettait des deux empires que les grandes guerres, il laissait de côté le maigre espoir d’une restauration bonapartiste, pour déclarer qu’en ne s’en tenant pas aux armées impériales, qu’en décrétant le service obligatoire, la nation en armes, la république avait tué la guerre, et tué la patrie."
                            },
                            {
                                "example_id": "47a201d4-3c61-44b5-95b1-86d348622793",
                                "sense_id": "c7e687b4-4767-3917-a34f-5a7dec8b0b81",
                                "text": "La dictature stalinienne apparait comme un régime politique bonapartiste dont la fonction consiste à défendre les privilèges de la bureaucratie dans le cadre des rapports de production donnés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e565e33-a0a8-46ab-ba75-b98f82a49c6c",
                        "source_entry_id": "17cad047-6e78-3d96-8b1f-9e0ac0c98e4e",
                        "source_sense_id": "c7e687b4-4767-3917-a34f-5a7dec8b0b81",
                        "target_lang_word": "bonapartistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonapartistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2f829be-aba9-3a50-96d3-8151601f98be",
                                        "entry_id": "a573a124-6711-3ac9-9a87-57f8d30c64a3",
                                        "glosses": [
                                            "sich auf den Bonapartismus, die Bonapartisten beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3567bbb6-0b6a-466e-b20b-c23883350f05",
                                                "sense_id": "f2f829be-aba9-3a50-96d3-8151601f98be",
                                                "text": "„Die Franzosen, aller republikanischen Eigenschaften bar, sind ihrer Natur nach ganz bonapartistisch.“"
                                            },
                                            {
                                                "example_id": "0ee3ff4d-cdc0-408e-8c5c-aa4fa4ba8ae5",
                                                "sense_id": "f2f829be-aba9-3a50-96d3-8151601f98be",
                                                "text": "„Genau das hat Bismarck am Abschluß der großen Kriege verwirklicht: ein ökonomisch-politisch vereintes Deutschland, das deshalb sehr rasch den Weg des kapitalistischen Aufschwungs zum Imperialismus einschlagen konnte; ein Deutschland, das zwar - gut bonapartistisch - das allgemeine Wahlrecht einführte, dessen Parlament jedoch keinerlei reale Macht besitzen durfte, dessen Politik weiter von den Hohenzollern und den zu Zivil- und Militärbürokraten gewordenen Junkern geleitet wurde.“"
                                            },
                                            {
                                                "example_id": "39c71081-786c-4c8c-b269-da6d413623ee",
                                                "sense_id": "f2f829be-aba9-3a50-96d3-8151601f98be",
                                                "text": "„Die Gefahr ist groß, daß Oskar Lafontaine bonapartistisch von Paris nach Moskau und von Moskau nach Madrid zieht, die Partei aber - außer dem Lufthauch eines vorbeiwehenden Mantels - nicht viel neues verspürt und wieder im biederen Scharping-Trott versinkt.“"
                                            },
                                            {
                                                "example_id": "52731706-3956-4ca9-ac0d-610efbef2b4c",
                                                "sense_id": "f2f829be-aba9-3a50-96d3-8151601f98be",
                                                "text": "„Andere wieder – etwa die EPFL (Eritrean People’s Liberation Front – Volksfront für die Befreiung Eritreas) – haben sich zu entsetzlichen bonapartistischen Verirrungen hinreißen lassen.“"
                                            },
                                            {
                                                "example_id": "40c7af39-567c-4bc6-8d16-94f7529affb4",
                                                "sense_id": "f2f829be-aba9-3a50-96d3-8151601f98be",
                                                "text": "„Das Vorgehen des Staatschefs wurde durch das Wahlvolk abgesegnet, auch wenn einige Parlamentarier de Gaulle beschuldigten, mit diesem Volksentscheid die Verfassung verletzt und ‚bonapartistisch‘ gehandelt zu haben.“"
                                            },
                                            {
                                                "example_id": "43619519-3b02-4d55-a6e8-86e2aed5c09c",
                                                "sense_id": "f2f829be-aba9-3a50-96d3-8151601f98be",
                                                "text": "„Sarkozy wird in seiner Heimat gern als ‚bonapartistisch‘ bezeichnet; in jedem Fall hat er das Talent eines Feldherrn, der die großen Schlachtpläne liebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "59fe9273-7bd8-3682-8a83-fecca3cc35b8",
                "word": "bonapartiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "24932b80-cb9e-4f2b-8a29-07d28662cde7",
                        "entry_id": "59fe9273-7bd8-3682-8a83-fecca3cc35b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "bonapartistes"
                    },
                    {
                        "form_id": "89dd6578-354a-4451-a86f-81d8dcb590bf",
                        "entry_id": "59fe9273-7bd8-3682-8a83-fecca3cc35b8",
                        "tags": [],
                        "form": "Bonapartiste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce5ccaa0-7921-3e71-9820-28f616e49b38",
                        "entry_id": "59fe9273-7bd8-3682-8a83-fecca3cc35b8",
                        "glosses": [
                            "Partisan ou partisane de Napoléon Bonaparte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5c3ff96-37b5-4e61-b0d6-9d46aa54aed0",
                                "sense_id": "ce5ccaa0-7921-3e71-9820-28f616e49b38",
                                "text": "Dès lors, la réaction fut maîtresse de la ville. Toutes les opinions étaient représentées dans cette réaction ; jamais on ne vit un pareil mélange de libéraux tournés à l’aigre, de légitimistes, d’orléanistes, de bonapartistes, de cléricaux."
                            },
                            {
                                "example_id": "1279561d-ca78-4cb5-a6cf-f901a6e34566",
                                "sense_id": "ce5ccaa0-7921-3e71-9820-28f616e49b38",
                                "text": "À la différence des orléanistes cherchant à se persuader que le pays consentirait à dormir de longues années sous le mancenillier d’une gloire militaire, les bonapartistes aperçurent que le mac-mahonisme ne vivrait que s’il se résolvait en une dictature."
                            },
                            {
                                "example_id": "d8a59977-a3c8-4f3c-8a96-8df2250f8497",
                                "sense_id": "ce5ccaa0-7921-3e71-9820-28f616e49b38",
                                "text": "Il y a un siècle à peine, en France, seuls étaient glabres les hommes d’Église et les domestiques. Barbes fluviales des socialistes et des anarchistes, favoris des libéraux et des maitres d’hôtel, impériale des bonapartistes, rouflaquettes des apaches, les visages affichaient les convictions politiques et les conditions sociales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c76070f-6f7c-405d-b830-1a1b67fd44c4",
                        "source_entry_id": "59fe9273-7bd8-3682-8a83-fecca3cc35b8",
                        "source_sense_id": "ce5ccaa0-7921-3e71-9820-28f616e49b38",
                        "target_lang_word": "Bonapartist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bonapartist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ec0b6c9-5281-311c-bddd-b148a8426dca",
                                        "entry_id": "1cec3c05-680b-319d-aedf-45f73dbb8830",
                                        "glosses": [
                                            "Anhänger des Herrschaftssystems von Napoleon Bonaparte, die sich für dessen Thronansprüche eingesetzt haben; Anhänger des Bonapartismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba79da4-5908-4427-9662-7bde7475b717",
                                                "sense_id": "7ec0b6c9-5281-311c-bddd-b148a8426dca",
                                                "text": "„Ausgerechnet Charles Napoleon kündigte aber an, nicht als Bonapartist, sondern als ‚parteiloser Demokrat und Republikaner‘ antreten zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fc210c7-437d-3c5c-8b19-9c5a51d89dc9",
                                        "entry_id": "1cec3c05-680b-319d-aedf-45f73dbb8830",
                                        "glosses": [
                                            "Anhänger der Familie (des Hauses) Bonaparte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "379bf6f3-61b2-4ccd-9d86-7c7e7d51966e",
                                                "sense_id": "8fc210c7-437d-3c5c-8b19-9c5a51d89dc9",
                                                "text": "„Die Verhandlungen der letzten Woche, so wenig Licht sie in das Dunkel der Zukunft bringen, haben indessen doch das Eine unwiderleglich bewiesen, daß die vier großen Parteien in Frankreich: Legitimisten, Orleanisten, Bonapartisten und Republikaner sich heute unversöhnlicher gegenüberstehen als je.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a3fa84f-55cb-395b-9e79-e885b37aa032",
                                        "entry_id": "1cec3c05-680b-319d-aedf-45f73dbb8830",
                                        "glosses": [
                                            "==== Herkunft ===="
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
