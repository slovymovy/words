                    "sense_definition": "A complete thing or system consisting of several parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The different essays form a coherent <w>whole</w>.",
