                                "target_senses": [
                                    {
                                        "sense_id": "493a110c-4fb0-394e-865a-fc1f08fcc815",
                                        "entry_id": "71dafa80-090e-3f10-946b-704814d3b1e7",
                                        "glosses": [
                                            "A female mediator; a mediatrix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385c4674-1e84-4635-be3a-145bcc02687d",
                                                "sense_id": "493a110c-4fb0-394e-865a-fc1f08fcc815",
                                                "text": "Juno and other Pagan goddesses were sorry mediatresses; they were sometimes very termagants in the courts above; and they were not always chaste and pure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
