                "senses": [
                    {
                        "sense_id": "0a84ac22-4d7e-3434-ac42-3046ef2b680a",
                        "entry_id": "fe209fc6-0cfb-3985-94f6-58b820444127",
                        "glosses": [
                            "ein reiches Land mit immensen Goldvorkommen, meist mythisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "162c3abc-0027-4638-9e10-79cc0c5e8131",
                                "sense_id": "0a84ac22-4d7e-3434-ac42-3046ef2b680a",
                                "text": "Das Goldland der spanischen Konquistadoren hieß Eldorado."
                            },
                            {
                                "example_id": "83d47d1c-a4c5-4891-908e-86307380cd7e",
                                "sense_id": "0a84ac22-4d7e-3434-ac42-3046ef2b680a",
                                "text": "„Im Altertum galt besonders Afrika als ein Kontinent mit vielen Goldländern, ja es galt im Ganzen als Goldland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
