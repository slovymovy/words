                        "examples": [
                            {
                                "example_id": "ba9cc56b-a753-40b4-8bb3-02895c3f3558",
                                "sense_id": "8afd1087-4298-3486-acba-78f2154c2c9c",
                                "text": "все сомне́ния отпа́ли",
                                "translation": "all doubt fell away",
                                "english": "all doubt fell away"
                            },
                            {
                                "example_id": "48c386a9-a498-43e8-8059-4fd880d7ac0e",
                                "sense_id": "8afd1087-4298-3486-acba-78f2154c2c9c",
                                "text": "э́та иде́я отпа́ла",
                                "translation": "that idea was dismissed",
                                "english": "that idea was dismissed"
                            }
                        ]
                    },
                    {
                        "sense_id": "0c788b1c-86be-3c46-81b1-9a5fdd57e432",
                        "entry_id": "0da8b027-ae03-3b36-844a-a92eaaa5fbef",
                        "glosses": [
                            "to pass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6448739-a2a7-4afd-89a4-aeaa793ef6e7",
                                "sense_id": "0c788b1c-86be-3c46-81b1-9a5fdd57e432",
                                "text": "и́з-за ды́ма у меня́ отпада́ет жела́ние есть",
                                "translation": "the smoke puts me off eating",
                                "english": "the smoke puts me off eating"
                            },
                            {
                                "example_id": "401fe978-1030-4ca1-9082-dba381c9ae56",
                                "sense_id": "0c788b1c-86be-3c46-81b1-9a5fdd57e432",
                                "text": "у него́ отпа́ла охо́та к э́тому",
                                "translation": "his desire to do it has passed",
                                "english": "his desire to do it has passed"
                            }
                        ]
