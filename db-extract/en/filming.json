                    {
                        "translation_id": "15b34a0a-2200-497b-a99c-242c7dfc6f37",
                        "source_entry_id": "87d51ddc-bced-3de3-a2d3-27a56cc6ff7e",
                        "source_sense_id": "0a7ed313-9376-3187-b851-aee92d1ab117",
