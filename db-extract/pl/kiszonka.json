                                        "tags": [
                                            "in Python"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a16b230c-b188-4eb8-92a1-34cf76d80fbe",
                                                "sense_id": "f5948d09-0df5-3a5d-9d05-10a4499e1205",
                                                "text": "You can now restore the pickled data. If you like, close your Python interpreter and open a new instance, to convince yourself […]"
                                            },
                                            {
                                                "example_id": "6d9ede53-3947-47d8-b4a0-65f3e30a3f96",
                                                "sense_id": "f5948d09-0df5-3a5d-9d05-10a4499e1205",
                                                "text": "To illustrate how this would work in practice, consider a field designed to store and retrieve a pickled copy of any arbitrary Python object."
