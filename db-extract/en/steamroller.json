                                        "entry_id": "8fe45a8c-b846-3e73-830c-1be33db42b2d",
                                        "glosses": [
                                            "Straßenwalze, die von einer Dampfmaschine angetrieben wird"
                                        ],
                                        "tags": [
                                            "Straßenbau, veraltet"
                                        ],
                                        "examples": [
                                            {
