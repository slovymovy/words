                        "glosses": [
                            "emotionale/gefühlsmäßige Einstellung, die in einem Volk weit verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "239e134a-d475-47bf-9422-afcbb335a47a",
                                "sense_id": "f146ebbf-c1ba-3eed-973f-2cc34b60c9e8",
                                "text": "„An der schönen Rolle eines spiritus rector des Volksempfindens hatte Rastoptschin soviel Gefallen gefunden und sich so in sie hineingelebt, dass die Notwendigkeit, diese Rolle fallen zu lassen, die Notwendigkeit, Moskau ohne jeden heroischen Effekt aufzugeben, ihn wie ein Schlag aus heiterem Himmel traf und ihm den Boden unter den Füssen entzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
