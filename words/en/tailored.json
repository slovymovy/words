{
    "word_family": [
        "tailor",
        "tailoring"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "854a84a4-1f72-3a57-b8b1-fa70a7892ce6",
                    "sense_definition": "Made or adjusted to fit a specific person or purpose perfectly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "custom_fit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked elegant in a <w>tailored</w> suit that fit her perfectly.",
                            "target_lang_translations": {
                                "de": "Sie sah elegant in einem <w>maßgeschneiderten</w> Anzug aus, der ihr perfekt passte."
                            }
                        },
                        {
                            "text": "The company offers <w>tailored</w> solutions to meet every client's unique needs.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen bietet <w>maßgeschneiderte</w> Lösungen an, um den individuellen Bedürfnissen jedes Kunden gerecht zu werden."
                            }
                        }
                    ],
                    "synonyms": [
                        "customized",
                        "bespoke",
                        "fitted"
                    ],
                    "antonyms": [
                        "ready-made"
                    ],
                    "common_phrases": [
                        "tailored suit",
                        "tailored solution"
                    ],
                    "target_lang_definitions": {
                        "de": "Perfekt auf eine Person oder einen bestimmten Zweck angepasst."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "maßgeschneidert",
                                "target_lang_sense_clarification": "Bezieht sich auf Kleidung oder Konzepte, die exakt angepasst wurden."
                            },
                            {
                                "target_lang_word": "individuell angepasst",
                                "target_lang_sense_clarification": "Betont die Anpassung an spezifische Bedürfnisse."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bba5ae6-90c8-3723-a6ef-c0982dccb70d",
                    "sense_definition": "Created by a professional tailor.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "custom_fit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His expensive <w>tailored</w> shirts lasted much longer than the ones bought at the store.",
                            "target_lang_translations": {
                                "de": "Seine teuren <w>maßgeschneiderten</w> Hemden hielten viel länger als die, die er im Laden gekauft hatte."
                            }
                        },
                        {
                            "text": "He only wears <w>tailored</w> clothing for important business meetings.",
                            "target_lang_translations": {
                                "de": "Er trägt nur <w>maßgeschneiderte</w> Kleidung zu wichtigen Geschäftsterminen."
                            }
                        }
                    ],
                    "synonyms": [
                        "bespoke"
                    ],
                    "common_phrases": [
                        "tailored shirt",
                        "tailored clothing"
                    ],
                    "target_lang_definitions": {
                        "de": "Von einem professionellen Schneider angefertigt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "maßgeschneidert",
                                "target_lang_sense_clarification": "Direkt vom Schneider gefertigt."
                            },
                            {
                                "target_lang_word": "nach Maß",
                                "target_lang_sense_clarification": "Beschreibt Kleidung, die speziell für den Träger angefertigt wurde."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "602f371e-7d8e-3e71-b716-25b88813924e",
                    "sense_definition": "Simple past and past participle of <w>tailor</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer <w>tailored</w> the jacket to fit the model's frame.",
                            "target_lang_translations": {
                                "de": "Der Designer <w>maßschneiderte</w> die Jacke, damit sie der Figur des Models entsprach."
                            }
                        },
                        {
                            "text": "The program was <w>tailored</w> to help students improve their writing skills.",
                            "target_lang_translations": {
                                "de": "Das Programm wurde <w>angepasst</w>, um Schülern dabei zu helfen, ihre Schreibfähigkeiten zu verbessern."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vergangenheitsform von 'maßschneidern' oder 'anpassen'."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "maßgeschneidert",
                                "target_lang_sense_clarification": "Partizip Perfekt von maßschneidern."
                            },
                            {
                                "target_lang_word": "angepasst",
                                "target_lang_sense_clarification": "Partizip Perfekt von anpassen, im Sinne von auf einen Zweck zugeschnitten."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}