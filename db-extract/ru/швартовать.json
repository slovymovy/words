                        "cross_references": [
                            {
                                "target_word": "amarrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79e1ac77-1630-3ede-9737-41ed058398f9",
                                        "entry_id": "8c0d7814-20b4-3ac9-a7f7-1ec12db9f400",
                                        "glosses": [
                                            "Lier à l’aide d’une corde ou d’un câble à un autre objet dans le but d’éviter que l’un ne s’éloigne de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec7a669-95a6-499e-8b53-5900e06d553a",
                                                "sense_id": "79e1ac77-1630-3ede-9737-41ed058398f9",
                                                "text": "Au moyen de palans je « roidis » les étais et j'amarre le beaupré aussi solidement qu'il est possible sur le pont maintenant rasé à l'avant."
                                            },
                                            {
                                                "example_id": "b5e811d2-c175-425e-9e3f-4516e0bc8a7e",
                                                "sense_id": "79e1ac77-1630-3ede-9737-41ed058398f9",
                                                "text": "Et Jean-Marie, malgré la rafale, malgré les soubresauts du brick, grimpait au mât de misaine pour amarrer le hunier qui flottait au vent comme un drapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f62e672-cb83-364e-b858-bd5909d13448",
                                        "entry_id": "8c0d7814-20b4-3ac9-a7f7-1ec12db9f400",
                                        "glosses": [
                                            "Lier à l’aide d’un bout d’amarrage ou une amarre un bateau au quai ou à un autre bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedb8117-324c-457e-97bb-b1563885484b",
                                                "sense_id": "1f62e672-cb83-364e-b858-bd5909d13448",
                                                "text": "Mais prenez garde ! vous avez des ennemis, c’est-à-dire des gens qui convoitent votre magnifique traitement, et vous n’êtes amarré que sur une ancre."
                                            },
                                            {
                                                "example_id": "31883375-a2c0-4ab0-885e-18828f6e256b",
                                                "sense_id": "1f62e672-cb83-364e-b858-bd5909d13448",
                                                "text": "Après un gros effort, nous accostâmes un grand floe sur lequel nous nous amarrâmes avec des ancres à glace."
                                            },
                                            {
                                                "example_id": "7130cce6-c395-406f-af8f-d0b96cecf12e",
                                                "sense_id": "1f62e672-cb83-364e-b858-bd5909d13448",
                                                "text": "Amarrer un navire aux anneaux du quai, une chaloupe au rivage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e92f8f4-912c-3273-a37f-00e83cb6e7c1",
                                        "entry_id": "8c0d7814-20b4-3ac9-a7f7-1ec12db9f400",
                                        "glosses": [
                                            "Arrêter, aborder quelqu’un."
                                        ],
                                        "tags": [
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
