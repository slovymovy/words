                "entry_id": "d654a644-3e7e-3514-a684-2851218aeeb0",
                "word": "kibboutz",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "86e836b6-bb23-42cd-aa08-c86bd82f2516",
                        "entry_id": "d654a644-3e7e-3514-a684-2851218aeeb0",
