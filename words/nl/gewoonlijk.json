                    "sense_id": "6f5b0547-3691-3c1f-bd57-ad4355008a4f",
                    "sense_definition": "Zoals het in de meeste gevallen gebeurt of zoals men het gewend is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga <w>gewoonlijk</w> met de fiets naar mijn werk, maar vandaag neem ik de auto.",
                            "target_lang_translations": {
                                "en": "I <w>usually</w> go to work by bike, but today I am taking the car.",
                                "ru": "Я <w>обычно</w> езжу на работу на велосипеде, но сегодня поеду на машине.",
                                "it": "Vado <w>di solito</w> al lavoro in bicicletta, ma oggi prendo l'auto.",
                                "pl": "Do pracy jeżdżę <w>zazwyczaj</w> rowerem, ale dzisiaj jadę samochodem.",
                                "de": "Ich fahre <w>gewöhnlich</w> mit dem Fahrrad zur Arbeit, aber heute nehme ich das Auto.",
                                "fr": "Je vais <w>habituellement</w> au travail à vélo, mais aujourd'hui je prends la voiture.",
                                "cs": "Do práce jezdím <w>obvykle</w> na kole, ale dnes jedu autem.",
                                "tr": "İşe <w>genellikle</w> bisikletle giderim ama bugün arabayı alıyorum.",
                                "es": "Voy <w>normalmente</w> en bicicleta al trabajo, pero hoy voy en coche.",
                                "zh": "我<w>通常</w>骑自行车去上班，但今天我开车。"
                            }
                        },
                        {
                            "text": "Zoals <w>gewoonlijk</w> was hij weer te laat voor de vergadering.",
                            "target_lang_translations": {
                                "en": "As <w>usual</w>, he was late for the meeting again.",
                                "ru": "Как <w>обычно</w>, он снова опоздал на собрание.",
                                "it": "Come <w>al solito</w> era di nuovo in ritardo per la riunione.",
                                "pl": "<w>Jak zwykle</w> spóźnił się na spotkanie.",
                                "de": "Wie <w>gewöhnlich</w> war er wieder zu spät für die Besprechung.",
                                "fr": "Comme <w>d'habitude</w>, il était encore en retard pour la réunion.",
                                "cs": "Jako <w>obvykle</w> přišel na schůzi zase pozdě.",
                                "tr": "<w>Her zamanki gibi</w> toplantıya yine geç kaldı.",
                                "es": "Como <w>de costumbre</w>, llegó tarde a la reunión otra vez.",
                                "zh": "他<w>照常</w>又在开会时迟到了。"
                            }
                        }
                    ],
