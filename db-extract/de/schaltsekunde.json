                    {
                        "sense_id": "9eae7b02-aff2-3bd1-af5d-87cb5622949b",
                        "entry_id": "13110464-e4e7-35e4-949d-f07a2be432dc",
                        "glosses": [
                            "leap second"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "b8d47d9b-51c5-4352-b138-bc0be4cc5dfc",
                                "sense_id": "9eae7b02-aff2-3bd1-af5d-87cb5622949b",
                                "text": "Die Nacht zum 1. Juli 2012 wird eine Sekunde länger dauern. Zum ersten Mal seit der Neujahrsnacht vom 1. Januar 2009 wird in die „koordinierte Weltzeit“ (UTC) wieder eine sogenannte Schaltsekunde eingefügt.",
                                "translation": "The night before July 1, 2012 will last one second longer. For the first time since the night of New Year's Eve on January 1, 2009, a so-called leap second will be inserted again into the \"Coordinated Universal Time\" (UTC).",
                                "english": "The night before July 1, 2012 will last one second longer. For the first time since the night of New Year's Eve on January 1, 2009, a so-called leap second will be inserted again into the \"Coordinated Universal Time\" (UTC)."
                            }
                        ]
                    }
