                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f23ce4e-9346-475b-95a1-3c0eaa3a1268",
                        "source_entry_id": "e3c3cb24-6471-3833-a896-1571fbeaa003",
                        "source_sense_id": "21bbe575-3723-3909-85a0-64a88d2fc6d3",
                        "target_lang_word": "зоря",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зоря",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8cfc1cff-6e0c-35e4-8a68-0958ed936ac1",
                                        "entry_id": "ab1ec861-7a32-32d6-8b5b-cb29321a4304",
                                        "glosses": [
                                            "устар. заря́"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0551bba-ca78-4f42-8a2f-86853cfd57ec",
                                                "sense_id": "8cfc1cff-6e0c-35e4-8a68-0958ed936ac1",
                                                "text": "Того ж году февраля 5-го в вечернюю зорю бысть землетрясение."
                                            },
                                            {
                                                "example_id": "d3527db9-6175-4326-82de-69bbe90c8093",
                                                "sense_id": "8cfc1cff-6e0c-35e4-8a68-0958ed936ac1",
                                                "text": "Среброствольная роща оливок; над нею — зоря; величавый старик, опираясь на палку, плывёт на зорю .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef284194-fe3a-3833-a759-fcd4397bb140",
                                        "entry_id": "ab1ec861-7a32-32d6-8b5b-cb29321a4304",
                                        "glosses": [
                                            "устар., воен. воинский церемониал и особый сигнал, исполняемый оркестром или трубачом, горнистом, барабанщиком в местах расположения войск после утренней и вечерней проверки, а также перед спуском флага"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82884a7-54ed-4312-bb29-75f7410cadb4",
                                                "sense_id": "ef284194-fe3a-3833-a759-fcd4397bb140",
                                                "text": "Господин подполковник, прибыв в деревню Кляшево, приказал бить зорю и разложить огни."
                                            },
                                            {
                                                "example_id": "466a94c2-b608-40e8-a0de-0935f39f2859",
                                                "sense_id": "ef284194-fe3a-3833-a759-fcd4397bb140",
                                                "text": "Погода была дивная, зоря с церемонией произвела на меня грустное, но чудное впечатление."
                                            },
                                            {
                                                "example_id": "0a579ad1-d1bc-40d0-9642-4b7494c4dace",
                                                "sense_id": "ef284194-fe3a-3833-a759-fcd4397bb140",
                                                "text": "В сыром воздухе плачевно звучит кавалерийская зоря."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "зоря",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9af0cc76-6c88-3692-90ab-fef29cfb776e",
                                        "entry_id": "31c5dfe3-4456-3719-b840-03ec64b8c2f7",
                                        "glosses": [
                                            "ботан., нар.-разг. любисток, многолетнее травянистое растение семейства зонтичные"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4444a206-339e-3dfa-b85b-be21470de7cf",
                                        "entry_id": "31c5dfe3-4456-3719-b840-03ec64b8c2f7",
                                        "glosses": [
                                            "ботан. растение зорник (лат. Veronica latifolia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2c16ef4-d53b-42fa-986c-2743e5d647db",
                                                "sense_id": "4444a206-339e-3dfa-b85b-be21470de7cf",
                                                "text": "Его величество, зная в лечебной науке разные способы противу ядов, желая отвратить вред и правильное негодование и без того утружденных войск, велел добыть растения, называемаго зоря, которой змеи не терпят. Наловя несколько змей, приказал тайно, чтоб не ведали прочие, бросить в зорю, в которую траву они яд свой испустили."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "зоря",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dacae716-1142-3dd2-92dc-755abafe6dc1",
                                        "entry_id": "3a71f1af-0f6d-3dd6-9064-e9cb4824b154",
                                        "glosses": [
                                            "дееприч. от зо́рить"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
