                        "examples": [
                            {
                                "example_id": "5238583e-1958-4e95-819a-c6d451b052a0",
                                "sense_id": "05185cb4-06e4-3ff2-bddc-61c32ce15209",
                                "text": "Un expert est généralement un donneur de conseil, il tend à s’autosélectionner, souvent en fonction de la qualité de la question ou de sa bonne volonté."
                            },
                            {
                                "example_id": "56daa5c3-c782-4385-9db8-282c5f3c30ce",
                                "sense_id": "05185cb4-06e4-3ff2-bddc-61c32ce15209",
                                "text": "Les femmes ont tendance à s’autosélectionner pour ne pas en bénéficier - on peut le voir dans la façon dont elles sont retirées de l'école."
