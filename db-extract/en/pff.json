                        "glosses": [
                            "An expression of annoyance or disappointment."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "19cdcdda-9c84-30e3-bf62-b1ebe24f9d4d",
                        "entry_id": "a1fef006-aa83-35e7-8fce-3bb7b3e5fb5d",
                        "glosses": [
                            "A dismissive response to a ridiculous comment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd39c75f-d7c9-4916-8f64-eb881c72526c",
                                "sense_id": "19cdcdda-9c84-30e3-bf62-b1ebe24f9d4d",
                                "text": "My doctor advised me to drink less. Pff, if only it were so easy."
                            }
                        ]
                    },
                    {
                        "sense_id": "df760571-c547-3ffe-b7a6-9bac041b9ee3",
                        "entry_id": "a1fef006-aa83-35e7-8fce-3bb7b3e5fb5d",
