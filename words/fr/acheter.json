    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e04cb6d5-27b1-3e01-8d40-4da266beaed0",
                    "sense_definition": "Acquérir un bien ou un service en échange d'une somme d'argent.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais au supermarché pour <w>acheter</w> du pain et des légumes."
                        },
                        {
                            "text": "Elle a <w>acheté</w> un nouveau manteau chaud pour l'hiver."
                        }
                    ],
                    "synonyms": [
                        "acquérir"
                    ],
                    "antonyms": [
                        "vendre",
                        "céder"
                    ],
                    "common_phrases": [
                        "acheter du pain",
                        "acheter en ligne"
                    ]
                },
                {
                    "sense_id": "5562e4c7-2b88-3060-af6e-675868357629",
                    "sense_definition": "Obtenir la complicité, le silence ou les faveurs de quelqu'un par l'argent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a vainement essayé d'<w>acheter</w> les jurés pendant le procès."
                        },
                        {
                            "text": "L'entreprise a voulu <w>acheter</w> le silence de ses employés après l'accident."
                        }
                    ],
                    "synonyms": [
                        "soudoyer",
                        "corrompre"
                    ],
                    "common_phrases": [
                        "acheter le silence"
                    ]
                },
                {
                    "sense_id": "9693c53f-eea1-3aba-baf5-e15fe80499c2",
                    "sense_definition": "Accepter une idée, une histoire ou une explication comme étant vraie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes n'<w>achètent</w> pas du tout sa version des faits."
                        },
                        {
                            "text": "Personne dans la direction n'<w>achète</w> cette explication peu convaincante."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "calque de l'anglais, fréquent au Québec"
                        }
                    ]
                },
                {
                    "sense_id": "73df0ef0-1bf2-3bf2-b011-12cd18a41a63",
                    "sense_definition": "Mettre un enfant au monde.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette région, on disait autrefois qu'elle avait <w>acheté</w> la nuit dernière."
                        },
                        {
                            "text": "La vieille femme racontait qu'elle allait bientôt <w>acheter</w> son premier enfant."
                        }
                    ],
                    "traits": [
