                                        "entry_id": "ced5dbb2-8a7d-3be4-a265-1e28f8d509ae",
                                        "glosses": [
                                            "Higher in the same page; earlier in the order as far as writing products go."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93971feb-50b2-46c9-86de-2892cd56bada",
                                                "sense_id": "b923b220-859e-35f6-bf82-449964a77f6e",
                                                "text": "Nobody has lived in it since the summer of 1879, and it is fast going to pieces. For some three years before the date mentioned above, it was occupied by the family of Charles May"
                                            },
                                            {
                                                "example_id": "0f1812b3-2c94-435e-aaa6-15a4fbf0e47d",
                                                "sense_id": "b923b220-859e-35f6-bf82-449964a77f6e",
                                                "text": "That angels are men in the most complete form, and enjoy every sense, may be seen above (n. 73-77); and that the light in heaven is far brighter than the light in the world (n. 126-132)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49c168e-9c1b-3f3f-bba9-19d92712a867",
                                        "entry_id": "ced5dbb2-8a7d-3be4-a265-1e28f8d509ae",
                                        "glosses": [
                                            "Into or from heaven; in the sky."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52cfb910-c6a5-4bd8-9601-a2abf2464e00",
                                                "sense_id": "c49c168e-9c1b-3f3f-bba9-19d92712a867",
                                                "text": "He’s in a better place now, floating free as the clouds above."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1df87280-2cd3-3593-bd41-d890b90ab0e7",
