                        "entry_id": "92298aac-51f6-326b-a340-ddfac34c04f1",
                        "glosses": [
                            "A one-pound note."
                        ],
                        "tags": [
                            "historical",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c1a87997-3180-425b-a576-e57a549831a6",
                                "sense_id": "faa82edb-9014-3f41-8f30-30af1bbcea17",
                                "text": "On whatever point Jane’s eyes rested, through whichever line her gaze ran, she saw cheques being signed, credit-card counterfoils being scrawled across, standing orders being arranged, and cash – wholesome dosh, ponies, monkies, oncers, coins of the realm – flowing around like mercury, like some element."
                            }
                        ]
                    },
                    {
                        "sense_id": "deaa1946-e69b-3034-8fe8-dc9a6fed3601",
                        "entry_id": "92298aac-51f6-326b-a340-ddfac34c04f1",
                        "glosses": [
                            "A person who does something once."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "33cf2d78-b3f5-4d31-9a5a-945873888f79",
                                "sense_id": "deaa1946-e69b-3034-8fe8-dc9a6fed3601",
                                "text": "Could he but once see Nature as / In truth she is for ever, / What oncer would not fall in love?"
                            }
                        ]
                    },
                    {
                        "sense_id": "20a1b816-1f0b-3be5-b143-3c9615fca3f0",
                        "entry_id": "92298aac-51f6-326b-a340-ddfac34c04f1",
