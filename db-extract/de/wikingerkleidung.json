                "senses": [
                    {
                        "sense_id": "1db3c706-b55e-385b-8c7a-cd4257541210",
                        "entry_id": "8359df3e-b0e1-3065-848b-86b01361131c",
                        "glosses": [
                            "Gesamtheit der Kleider von Wikingern; Wikingermode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6f09ea-b652-4767-91a6-64455234496d",
                                "sense_id": "1db3c706-b55e-385b-8c7a-cd4257541210",
                                "text": "„Die Textilforscherin untersuchte für ihre Doktorarbeit zahlreiche Stofffunde aus der Gegend um Uppsala und um den Mälarsee in der Nähe von Stockholm und fand dabei heraus, dass das konservative Bild von der Wikingerkleidung ganz und gar nicht stimmt.“"
                            },
                            {
                                "example_id": "aebb0e26-984a-437e-a156-0ad68834f3a8",
                                "sense_id": "1db3c706-b55e-385b-8c7a-cd4257541210",
                                "text": "„Das Center erweitert ständig die Zahl der Aktivitätsangebote, bei denen das Publikum selbst mitmachen kann, und es wurde historisch korrekte Wikingerkleidung in Kindergrößen hergestellt, so dass unsere jüngsten Gäste sich noch besser in die Geschichte hineinversetzen können.“"
                            },
                            {
                                "example_id": "5c8a287a-c5dd-44fa-8793-2e29a6a4734a",
                                "sense_id": "1db3c706-b55e-385b-8c7a-cd4257541210",
                                "text": "„Auf dem Wikingermarkt gibt es Wikingerkleidung, einzigartige handgenähte Ledertaschen und nach Wikingerart gefertigte Futterale für Messer zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
