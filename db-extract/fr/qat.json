                "senses": [
                    {
                        "sense_id": "97852f07-963e-3482-859a-25d06cac8bed",
                        "entry_id": "07bdef54-84a4-3baf-bf43-9c747bbd7638",
                        "glosses": [
                            "Arbuste (Catha edulis) de l’Afrique orientale et de la péninsule arabique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adabf003-98af-4562-898a-4fb9f8a5146a",
                                "sense_id": "97852f07-963e-3482-859a-25d06cac8bed",
                                "text": "Le qat est un arbuste originaire d'Afrique orientale et australe, importé au Yémen au XIVᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "76143453-b090-3f02-8763-bae30ee7a09b",
                        "entry_id": "07bdef54-84a4-3baf-bf43-9c747bbd7638",
                        "glosses": [
                            "Feuilles de cet arbuste, mâchées pour leur effet stimulant et euphorisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a668ac96-9140-40fc-947e-5f33e1def16e",
                                "sense_id": "76143453-b090-3f02-8763-bae30ee7a09b",
                                "text": "Même s'il est connu depuis longtemps la consommation du qat s'est développée depuis une vingtaine d'années après la révolution de 1962 au nord et depuis la réunification au sud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea8aa94f-0583-46b2-b4e7-433b927915e4",
                        "source_entry_id": "07bdef54-84a4-3baf-bf43-9c747bbd7638",
                        "target_lang_word": "quat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "244b3f4f-8404-3aee-aaaa-482cf3404887",
                                        "entry_id": "c72c0bca-fb6e-347c-bd33-a0e798d953ce",
                                        "glosses": [
                                            "A pustule."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97d78985-e2a8-3c9a-8a7a-b12ac818401e",
                                        "entry_id": "c72c0bca-fb6e-347c-bd33-a0e798d953ce",
                                        "glosses": [
                                            "An annoying, worthless person."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "692a4f25-5ddc-409c-a1c3-fb3a005ffadd",
                                                "sense_id": "97d78985-e2a8-3c9a-8a7a-b12ac818401e",
                                                "text": "I have rubb'd this young quat almost to the sense, And he grows angry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13e89993-32ec-3eb9-a100-f9086c61a9a7",
                                        "entry_id": "a5ca42b7-603d-3d5a-b444-ed361a239192",
                                        "glosses": [
                                            "To satiate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168eff94-05cf-4837-84a4-0ec49684e36a",
                                                "sense_id": "13e89993-32ec-3eb9-a100-f9086c61a9a7",
                                                "text": "1757, Samuel Foote, The Author, Act II, Scene ii, 1765, The Dramatic Works, Volume 1, page 28,\nMrs. Cad. Well, come, begin and ſtart me, that I may come the ſooner to quatting——Huſh ! here′s Siſter ; what the deuce brought her !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99c882a-3449-326f-a0bd-9c3cbe0e7ae5",
                                        "entry_id": "a5ca42b7-603d-3d5a-b444-ed361a239192",
                                        "glosses": [
                                            "To relinquish, forsake, give up."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "dialectal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d9415c4-cf4d-4f9a-9b8e-d2851bbe4abd",
                                                "sense_id": "b99c882a-3449-326f-a0bd-9c3cbe0e7ae5",
                                                "text": "Ye hae grown proud since ye quatted the begging. — Scottish proverb, said satirically."
                                            },
                                            {
                                                "example_id": "bfeee81f-b35d-4be4-a45e-b6180aa859b9",
                                                "sense_id": "b99c882a-3449-326f-a0bd-9c3cbe0e7ae5",
                                                "text": "'Mang mis'ry's posts, whar I did sit, My tongue took sic a faltrin' fit, I thought the wee remains o' wit I had, was quat me"
                                            },
                                            {
                                                "example_id": "751bbe15-e560-4b5c-8c0f-bc18db2dc2c1",
                                                "sense_id": "b99c882a-3449-326f-a0bd-9c3cbe0e7ae5",
                                                "text": "They seem to our ears indeed to have \"quat their roaring play.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2348beb-b8db-38e8-b561-033c104e435f",
                                        "entry_id": "a5ca42b7-603d-3d5a-b444-ed361a239192",
                                        "glosses": [
                                            "To squat or crouch down."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e94d204-de1e-4f93-ba3a-1ad79aa1ab49",
                                                "sense_id": "c2348beb-b8db-38e8-b561-033c104e435f",
                                                "text": "Tho' B-lt-n, quatted in the hall, Her jolly r-mpfs display'd, The size of it amaz'd them all, and Hector quite dismay'd."
                                            },
                                            {
                                                "example_id": "bfcb6e35-e9f4-4d16-adf5-c924eeb4bac1",
                                                "sense_id": "c2348beb-b8db-38e8-b561-033c104e435f",
                                                "text": "This cows' courant so excited the tinners' curiosity that they went up the hill till they saw the two men wrestling, with the women looking on; then they quatted (stooped) down in a brake of furze to watch the play without being seen."
                                            },
                                            {
                                                "example_id": "b5e18078-1a20-41c0-8886-3aba6120b5a0",
                                                "sense_id": "c2348beb-b8db-38e8-b561-033c104e435f",
                                                "text": "Tarka quatted on the ledge ; he knew that Deadlock would follow hiin wherever he swam in water."
                                            },
                                            {
                                                "example_id": "24fe8e88-c14b-4e48-a393-7fb333014be3",
                                                "sense_id": "c2348beb-b8db-38e8-b561-033c104e435f",
                                                "text": "She quatted down next to him and rubbed his shoulder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da886f2e-3786-325e-b7e3-9cb25b21c8d2",
                                        "entry_id": "16749ddc-4e46-3a6f-a774-a2a5ff432f26",
                                        "glosses": [
                                            "Free; no longer involved with; quit."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b938b349-90a2-4a4b-a957-6bc29704f5e4",
                                                "sense_id": "da886f2e-3786-325e-b7e3-9cb25b21c8d2",
                                                "text": "My word, I gie him nae encouragement ! I canna bide the sicht o' him, and wad gie the best gown I hae to be quat o' him.\""
                                            },
                                            {
                                                "example_id": "b35fc52b-62cb-4fed-b1cc-dd545d60b609",
                                                "sense_id": "da886f2e-3786-325e-b7e3-9cb25b21c8d2",
                                                "text": "There it is, sir—Im blythe to be quat of it; pitch it from ye furder than I can see."
                                            },
                                            {
                                                "example_id": "88fd934d-97b1-4db2-96d2-a5302e844bff",
                                                "sense_id": "da886f2e-3786-325e-b7e3-9cb25b21c8d2",
                                                "text": "HECH me, but I'm weary, I'm heart-sick and sad ; O' my kinsfolk I've got quite a wamefu', I wush I was quat o' the d — nable squad — Forgi'e me for sweerin' sae shamefu'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cca5476-27e0-3f2b-a4bd-d857b0077667",
                                        "entry_id": "6eb82a36-fec7-314e-9363-9e388516df72",
                                        "glosses": [
                                            "A quaternary ammonium cation or compound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992ebc47-78a8-4a81-9086-776f60c15d59",
                                                "sense_id": "1cca5476-27e0-3f2b-a4bd-d857b0077667",
                                                "text": "“Because quats are positively charged, and skin proteins have a slightly negative charge, quats like to attach themselves to skin,” said Greg Nole, a manager at Unilever, the parent company of Vaseline and Dove."
                                            }
                                        ]
                                    }
                                ]
                            },
