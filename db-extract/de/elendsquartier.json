                "senses": [
                    {
                        "sense_id": "37c1c96d-4010-3198-83e0-ffffcff5889c",
                        "entry_id": "7ab0686b-b957-3311-89f7-0e53dc0131ec",
                        "glosses": [
                            "Quartier, das sich völlig unzureichenden Lebensumständen betroffener Personen verdankt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fee3ff14-3b9d-43cc-9be6-8af08adca786",
                                "sense_id": "37c1c96d-4010-3198-83e0-ffffcff5889c",
                                "text": "„Eine Stufe höher als diese Elendsquartiere standen die privaten Pensionen, zu denen auch die in der Virginia Street gehörte, in der Mary Anderson gestohlen hatte.“"
                            },
                            {
                                "example_id": "600ada65-1ae6-48c5-a3e5-55345070bbdd",
                                "sense_id": "37c1c96d-4010-3198-83e0-ffffcff5889c",
                                "text": "„Viele andere Siedler kommen dagegen freiwillig, auch aus anderen Nationen, denn die Industrialisierung und das Bevölkerungswachstum in Europa lassen die Not in den Elendsquartieren der Städte wachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
