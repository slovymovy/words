                {
                    "sense_id": "253e1956-493a-3438-8d6c-9adfa6c34da6",
                    "sense_definition": "Сдержанный в обнаружении своих достоинств и заслуг, не любящий хвастаться и выставлять себя напоказ.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он очень <w>скромный</w> человек и никогда не говорит о своих победах.",
                            "target_lang_translations": {
                                "en": "He is a very <w>modest</w> person and never talks about his victories.",
                                "pl": "Jest bardzo <w>skromnym</w> człowiekiem i nigdy nie mówi o swoich zwycięstwach."
                            }
                        },
                        {
                            "text": "Эта тихая и <w>скромная</w> девушка сразу понравилась его родителям.",
                            "target_lang_translations": {
                                "en": "His parents immediately liked this quiet and <w>modest</w> girl.",
                                "pl": "Ta cicha i <w>skromna</w> dziewczyna od razu spodobała się jego rodzicom."
                            }
                        }
                    ],
                    "antonyms": [
                        "нескромный",
                        "хвастливый",
                        "заносчивый",
                        "наглый",
                        "тщеславный"
                    ],
                    "common_phrases": [
                        "очень скромный",
                        "скромный парень",
                        "слишком скромный",
                        "тихий и скромный"
                    ],
                    "target_lang_definitions": {
                        "en": "Restrained in showing one's merits; not inclined to brag or show off.",
                        "pl": "Powściągliwy w okazywaniu swoich zalet i osiągnięć, nielubiący się przechwalać ani popisywać."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "modest",
                                "target_lang_sense_clarification": "about character"
                            },
                            {
                                "target_lang_word": "humble",
                                "target_lang_sense_clarification": "not proud or haughty"
                            },
                            {
                                "target_lang_word": "unpretentious",
                                "target_lang_sense_clarification": "not attempting to impress"
                            }
                        ],
                        "pl": [
