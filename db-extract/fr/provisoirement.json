        "fr-extract.jsonl": [
            {
                "entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                "word": "provisoirement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfde0cba-bb35-30bd-b77b-ca82c1dd20d1",
                        "entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                        "glosses": [
                            "D’une manière provisoire, en attendant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd28b087-a842-47a9-a68d-35b3238252ef",
                                "sense_id": "dfde0cba-bb35-30bd-b77b-ca82c1dd20d1",
                                "text": "Parfois, l'ampleur des travaux est telle que la route doit être provisoirement fermée et interdite à toute circulation. Un itinéraire de déviation est alors provisoirement mis en place."
                            }
                        ]
                    },
                    {
                        "sense_id": "f523179d-5390-3a0e-89e1-2b57989ad671",
                        "entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                        "glosses": [
                            "Par provision."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "65b0ee78-bf50-4b2e-b517-2a9d23f2d7e5",
                                "sense_id": "f523179d-5390-3a0e-89e1-2b57989ad671",
                                "text": "Cela n'a été jugé que provisoirement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2108d703-1628-408a-a9c5-c10cf5ab5a2e",
                        "source_entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                        "target_lang_word": "vorläufig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                        "entry_id": "1e32a1d8-0b52-3b52-ac0d-2621fd31694f",
                                        "glosses": [
                                            "nicht endgültig, bis zu einer späteren Festlegung gültig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e662726-e720-484f-8df3-a090647b81be",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "Das hier soll nur eine vorläufige Lösung sein."
                                            },
                                            {
                                                "example_id": "0e709f96-84a0-4734-ab89-857d72f31f04",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "„Mit diesem Zitat gelang es mir, ihn nicht grundsätzlich umzustimmen, aber doch sein vorläufiges Einverständnis zur Fortsetzung meiner Arbeit zu bekommen.“"
                                            },
                                            {
                                                "example_id": "f78c568c-d9e7-4bd7-bf7e-608727c43be7",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "„Allein von den für Permanentmagnete wichtigen und als knappe Ressource eingestuften Elementen Neodym und Praseodym könnten aus dem Fen Carbonatite Complex mindestens 1,5 Millionen Tonnen gefördert werden, so die vorläufige Abschätzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "vorläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ccaac0bf-a45a-352c-935d-70a5ad393ea6",
                                        "entry_id": "79c35e8a-7bf5-374a-b885-cfd3bf0b821e",
                                        "glosses": [
                                            "fürs Erste, bis auf Weiteres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b7c8de-be16-4a42-a61f-3b784d138505",
                                                "sense_id": "ccaac0bf-a45a-352c-935d-70a5ad393ea6",
                                                "text": "Wir müssen uns vorläufig mit einer kleinen Wohnung zufrieden geben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10093722-fba4-4097-b86d-f878b5da9088",
                        "source_entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                        "target_lang_word": "for the time being",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for the time being",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                        "entry_id": "b03ac985-242f-3b07-8068-45936b45a76d",
                                        "glosses": [
                                            "Temporarily; for now; until later; until the situation changes; in an indefinite period of time."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecedfb8-3c39-4e49-a4a9-eaaa12d5eb5b",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "I think I will ignore the problem for the time being."
                                            },
                                            {
                                                "example_id": "5a6323b0-9e1e-4155-92f8-18d1bf22eb04",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "And so, unfortunately, this great and spreading network of railways, that recently showed such promise as a major instrument in the modern development of China, must be left for the time being in the melting-pot of Armageddon."
                                            },
                                            {
                                                "example_id": "8889eef2-b73b-4e9c-a677-281a78634428",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "Neither Aracil nor his five friends have the money to pay for the costs of the demolition, which, they say, are punitively over-inflated. For the time being, their hopes rest on legal appeals, and should those fail, on a crowdfunding campaign."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
