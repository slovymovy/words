                                "target_senses": [
                                    {
                                        "sense_id": "05cc98dd-c3dc-3b16-941e-c4bd30ef9565",
                                        "entry_id": "b15625d2-a289-3328-918a-57fa0c388563",
                                        "glosses": [
                                            "Ville portuaire de Corée du Sud"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0d2faa-93c8-41c5-8bb6-3a48bb1e7494",
                                                "sense_id": "05cc98dd-c3dc-3b16-941e-c4bd30ef9565",
                                                "text": "Deux protestataires s’y sont même immolés, des activistes étant allés jusqu’à faire irruption dans le consulat nippon de Busan, la deuxième plus grande ville du pays."
                                            },
                                            {
                                                "example_id": "2a2c3d3e-6d5d-461e-bc4e-d5df895a52aa",
                                                "sense_id": "05cc98dd-c3dc-3b16-941e-c4bd30ef9565",
                                                "text": "Il y a là comme une volonté de se distinguer des alentours, de la séduisante Busan, métropole fière de ses plages, de ses temples bouddhistes, de son festival de film et de son activité maritime."
                                            },
                                            {
                                                "example_id": "9c144106-2e36-44a7-9b66-924fcb940bde",
                                                "sense_id": "05cc98dd-c3dc-3b16-941e-c4bd30ef9565",
                                                "text": "Tous deux étaient nés dans le village de Yeongdo - un îlot de huit kilomètres au large de la ville portuaire de Busan - et ne l’avaient jamais quitté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
