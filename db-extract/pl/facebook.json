                "translations": [
                    {
                        "translation_id": "4f0d1c43-b4b6-4cc9-a199-e03b2e8c3d0a",
                        "source_entry_id": "6a9462ce-494d-353f-951f-1b160ee62fad",
                        "source_sense_id": "0de29e07-4150-301e-8adf-63072f3d2ba9",
                        "target_lang_word": "Facebook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Facebook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07653696-ae76-300d-a369-714803d248f8",
                                        "entry_id": "ee0d69dc-2afc-3701-b3c4-931e77299e3b",
                                        "glosses": [
                                            "A social-networking website where users can find acquaintances or friends, exchange messages, and post updates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d1d68b-fe37-4f86-8ecd-33bda2d815a2",
                                                "sense_id": "07653696-ae76-300d-a369-714803d248f8",
                                                "text": "Mia was just seeing a reel on Facebook that her friend had posted."
                                            },
                                            {
                                                "example_id": "94b8a315-cea1-4408-abb5-31e85cbf8003",
                                                "sense_id": "07653696-ae76-300d-a369-714803d248f8",
                                                "text": "Google is one of several Big Tech firms that has made an aggressive push into gaming in recent years, along with Amazon (AMZN), Apple (AAPL) and Facebook (FB)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Facebook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f580809b-1cf7-30a7-b2e3-b72dae0c5af5",
                                        "entry_id": "c650ad1a-18e6-3534-a905-777aa51ccbd2",
                                        "glosses": [
                                            "A personal web profile on the social-networking site Facebook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c10be7c-a8f3-4d61-9ebf-4ac640dab977",
                                                "sense_id": "f580809b-1cf7-30a7-b2e3-b72dae0c5af5",
                                                "text": "You might have a Facebook. So do I. And so does my mom and my grandma and all of her friends. But you know who doesn’t have a Facebook? Your kid’s friends."
                                            },
                                            {
                                                "example_id": "5eaccf34-a560-4bd6-b0ed-e756f8672243",
                                                "sense_id": "f580809b-1cf7-30a7-b2e3-b72dae0c5af5",
                                                "text": "'An intimate photo has been posted on your cloned Facebook page,' says Greg. 'What, of me in the nuddy?' Nick snorts a note of laughter. 'No, of you and a woman.' 'What woman? Show me,' he says holding his hand out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Facebook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db36b789-b6e8-3501-b9b6-7c5fa1aaae2a",
                                        "entry_id": "cbdb6e82-3830-369d-b531-2c8c94cc768f",
                                        "glosses": [
                                            "To use the social-networking site Facebook."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b243a1e-bac7-3cc1-a10c-f1d8ae97f3c0",
                                        "entry_id": "cbdb6e82-3830-369d-b531-2c8c94cc768f",
                                        "glosses": [
                                            "To send a message or leave a comment on Facebook."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d929adf7-5805-4820-9ef8-6fd2ef659f13",
                                                "sense_id": "6b243a1e-bac7-3cc1-a10c-f1d8ae97f3c0",
                                                "text": "Facebook me the details later."
                                            },
                                            {
                                                "example_id": "cf8d7260-57ca-4e7c-b507-09e1f0f20ec5",
                                                "sense_id": "6b243a1e-bac7-3cc1-a10c-f1d8ae97f3c0",
                                                "text": "Corinthia’s bathroom was never discussed with the Lugo Memorial student body, but when it (the bathroom) materialized, it was Facebooked, Instagrammed, Tweeted, Foursquared, WordPressed, Tumblred, Snapchatted, and so thoroughly digitally disseminated that it was as if pictures of Rinna Buss’s breasts had been leaked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff0e0ccb-078c-4065-9b7c-c9b5b3edcedd",
                        "source_entry_id": "6a9462ce-494d-353f-951f-1b160ee62fad",
                        "source_sense_id": "0de29e07-4150-301e-8adf-63072f3d2ba9",
                        "target_lang_word": "Facebook",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Facebook",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c641a956-eb83-3ead-a5d6-78d2e45a592e",
                                        "entry_id": "c2b8dc32-abc6-314a-b071-dc619ab3d4fd",
                                        "glosses": [
                                            "Cuenta o perfil en dicha red social."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcbaa403-49ac-437b-85fc-a7ff681f26e3",
                                                "sense_id": "c641a956-eb83-3ead-a5d6-78d2e45a592e",
                                                "text": "No sabe que mis maestros en la escuela también tienen y suben sus fotos, y que en lugar de preparar la clase se pasan las horas frente a su Facebook."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79c72b3c-44d8-4d8c-bd56-e1335e1aaa6d",
                        "source_entry_id": "6a9462ce-494d-353f-951f-1b160ee62fad",
                        "source_sense_id": "0de29e07-4150-301e-8adf-63072f3d2ba9",
                        "target_lang_word": "Facebook",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Facebook",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                        "entry_id": "dc005cb8-9297-37ce-becb-bdfaf7a3ddfe",
                                        "glosses": [
                                            "soziales Netzwerk, das für Kommunikation und die Darstellung der eigenen Person benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0276ca-3a67-4368-82f5-c2df510b06df",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "Sie hat sich bei Facebook angemeldet."
                                            },
                                            {
                                                "example_id": "0e89351c-67a3-4d71-89f5-9c7ca67b06d9",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "Er hat ein Urlaubsfoto auf Facebook gepostet."
                                            },
                                            {
                                                "example_id": "93ec425c-89c0-4938-aa8c-db075e086c16",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "Sie hat mir bei Facebook geschrieben, dass sie krank sei."
                                            },
                                            {
                                                "example_id": "5dcc5912-2f04-4807-81f0-92b601aa60fa",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "„Auf Facebook trudeln Nachrichten in meinem Postfach ein.“"
                                            },
                                            {
                                                "example_id": "f0559756-a4c3-4b55-990f-79195c4bc212",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "„Gleich nach unserer Ankunft hat Facebook mir die Tochter meiner Cousine Litsa als Freundin vorgeschlagen […].“"
                                            },
                                            {
                                                "example_id": "f4a91c7a-53ed-4f26-9d85-d54e0a2e8caf",
                                                "sense_id": "f92c18ff-e8e3-3894-8b9f-bd17d275e82e",
                                                "text": "„Deswegen hatte ihr Herz bei seiner Freundschaftsanfrage auf Facebook einen Sprung gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
