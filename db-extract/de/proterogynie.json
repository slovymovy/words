                "senses": [
                    {
                        "sense_id": "630264ce-d26f-3388-a2b4-8a128db8cc93",
                        "entry_id": "63e969be-9307-3ca3-821b-53d4c1af9487",
                        "glosses": [
                            "die Reifung der weiblichen vor den männlichen Geschlechtsorganen zur Verhinderung der Selbstbestäubung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07b9f76-7868-4a3b-a16b-06068162e1ce",
                                "sense_id": "630264ce-d26f-3388-a2b4-8a128db8cc93",
                                "text": "Von Protogynie (auch Proterogynie oder Vorweiblichkeit) spricht man, wenn die weiblichen Geschlechtsorgane (Fruchtblättern) vor den männlichen (den Staubbeuteln) reifen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4eb5ea2-13aa-3481-b976-19fb06fb297f",
                        "entry_id": "63e969be-9307-3ca3-821b-53d4c1af9487",
                        "glosses": [
                            "Phänomen, bei dem zuerst weibliche Tiere männlich werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed867287-6cd0-4f07-86f4-dff9dc5b2918",
                                "sense_id": "a4eb5ea2-13aa-3481-b976-19fb06fb297f",
                                "text": "Bei Lippfischen i.e.S. und Papageifischen unterscheiden sich Jungfische, Weibchen und Männchen oft ganz erheblich in der Färbung, weshalb sie manchmal als eigene Arten beschrieben worden sind; zudem wandeln sich bei vielen Arten die zunächst weiblichen Tiere in sekundäre Männchen um (Proterogynie), die dann neben den sich direkt entwickelnden primären Männchen vorkommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
