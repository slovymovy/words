                        "tags": [],
                        "form": "Färöer : schrijfwijze die vroeger wel gebruikt werd"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "034e6539-07a3-38af-b93d-3beb689149b0",
                        "entry_id": "4e92b091-e045-3c87-afbd-78dad63dd154",
                        "glosses": [
                            "eilandengroep in de Atlantische Oceaan ten noordwesten van Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00289e7a-6c25-403f-bdec-0b461c0c4e28",
                                "sense_id": "034e6539-07a3-38af-b93d-3beb689149b0",
                                "text": "Op de Faeröer groeien planten die bij het klimaat passen."
                            }
                        ]
                    },
                    {
                        "sense_id": "29cb1eab-2dea-3a7a-b2a3-8c0329f536a1",
                        "entry_id": "4e92b091-e045-3c87-afbd-78dad63dd154",
                        "glosses": [
                            "een land met zelfbestuur binnen het koninkrijk Denemarken dat bestaat uit de onder 1. genoemde eilandengroep (Faeröers: Føroyar; Deens: Færøerne)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e159514d-3712-4828-a8fa-6be0edc91007",
                                "sense_id": "29cb1eab-2dea-3a7a-b2a3-8c0329f536a1",
                                "text": "De Faeröer zijn geen lid van de Verenigde Naties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5e1342e-8696-47d2-b411-e17408cb71be",
                        "source_entry_id": "4e92b091-e045-3c87-afbd-78dad63dd154",
                        "source_sense_id": "034e6539-07a3-38af-b93d-3beb689149b0",
                        "source_sense_description": "en 2., eilandengroep, land",
                        "target_lang_word": "Färöer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Färöer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                        "entry_id": "43a5c721-0929-32a9-abc5-1563f3db5f8f",
                                        "glosses": [
                                            "autonome, zu Dänemark gehörende, Inselgruppe im Nordatlantik (Landesname Føroyar)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c37260-d890-4d0c-af3f-55f8732b1815",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "Die Färöer sind eine Inselgruppe im Nordatlantik."
                                            },
                                            {
                                                "example_id": "3d5d8b46-efda-4b94-9195-4fbafcc6ae44",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "Die Färöer haben rund 48.000 Einwohner."
                                            },
                                            {
                                                "example_id": "85ff99cd-c140-4b29-8e5e-bb761f47492a",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "Seit 1948 genießen die Färöer weitgehende Autonomie."
                                            },
                                            {
                                                "example_id": "a9e18569-e804-4693-abe4-c40a09bad2c0",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "Die Einwohner der Färöer nennt man Färinger."
                                            },
                                            {
                                                "example_id": "0620e9be-1478-43d8-b5ab-1bfa87ec9aaf",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "Auf den Färöern spricht man Färöisch."
                                            },
                                            {
                                                "example_id": "3c514a88-f765-47ca-a084-a049e17249cd",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "Wir erreichten die Färöer im Morgengrauen."
                                            },
                                            {
                                                "example_id": "eee0f1d3-7bc5-4992-8ac6-fb5582f5e11f",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "„Auf dem Tisch vor Pløyen hatte die Landkarte der Färöer gelegen, die Kommandant Born gezeichnet hatte.“"
                                            },
                                            {
                                                "example_id": "418fe7cb-96c2-4f0c-8f6c-5f9b8eae9365",
                                                "sense_id": "fad4938c-5cbd-3760-9b14-4f6229b97dcf",
                                                "text": "„Die Färöer hatten für mich etwas Geheimnisvolles und waren so ganz anders als die Touristeninseln im Mittelmeer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Färöer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "088009c5-0bcb-3ec7-b6fc-c19ce22b51b5",
                                        "entry_id": "d3752f19-5e03-3957-be7b-6a0ccf82c34f",
                                        "glosses": [
                                            "einheimischer Bewohner der Färöer-Inseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325eddd1-ecd5-45b8-aab7-748c3fdec84a",
                                                "sense_id": "088009c5-0bcb-3ec7-b6fc-c19ce22b51b5",
                                                "text": "„‚Ja‘, sagt der Färöer zu uns, ‚wir haben das Blut der Wikinger in den Adern und das Fernweh, das uns forttreibt auf See, fern ab vom Weib und den Kindern.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
