                ],
                "senses": [
                    {
                        "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                        "entry_id": "b4b73f91-63e9-38b1-8b51-8a380c8b6b54",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4a945e-11d9-4cb4-8a41-561410d88bc2",
                                "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                                "text": "Frau Reiff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2b07e75f-14b3-445d-a5da-19efa643261b",
                                "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                                "text": "Herr Reiff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "11043941-99a7-4f32-a8d4-b349641af170",
                                "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                                "text": "Die Reiffs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0c1c2eca-66b9-46bc-8012-96ac01b1cc75",
                                "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                                "text": "Der Reiff trägt nie die Schals, die die Reiff ihm strickt."
                            },
                            {
                                "example_id": "4b977a48-35e2-4356-bded-cf972ea12c73",
                                "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reiff kommt, geht der Herr Reiff.“"
                            },
                            {
                                "example_id": "afd81c65-8520-4d58-b3fa-a24f0857b143",
                                "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                                "text": "Reiff kommt und geht."
                            },
                            {
                                "example_id": "9a7d3897-0f49-4374-847d-0f5cbdf9ab1f",
                                "sense_id": "ea42f27c-2e53-30e1-bb16-cb63e42e536e",
                                "text": "Reiffs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
