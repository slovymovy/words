                "senses": [
                    {
                        "sense_id": "99a2eca2-28cc-3461-ac46-cdc25a8736ec",
                        "entry_id": "b9a33de9-8a4d-3b13-b032-2f449fe05337",
                        "glosses": [
                            "Angriff mit Nuklearwaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "340747f6-5939-432b-9f4c-b75f03cdf648",
                                "sense_id": "99a2eca2-28cc-3461-ac46-cdc25a8736ec",
                                "text": "„Sobald die Kämpfer ihre Stellungen an der Front eingenommen hätten, würde ein Nuklearschlag alle Beteiligten auslöschen.“"
                            },
                            {
                                "example_id": "7fbb72bb-ab4e-4a3a-bbbf-b07865afb82f",
                                "sense_id": "99a2eca2-28cc-3461-ac46-cdc25a8736ec",
                                "text": "„Die Gefahr eines Nuklearschlages auf dem indischen Subkontinent hat zugenommen.“"
                            },
                            {
                                "example_id": "dea14118-bc6f-43af-b828-f3bbfc85de32",
                                "sense_id": "99a2eca2-28cc-3461-ac46-cdc25a8736ec",
                                "text": "„Jungdiktator Kim könnte, so irrwitzig das ist, eines Tages geneigt sein, tatsächlich zu einem Nuklearschlag auszuholen.“"
                            },
                            {
                                "example_id": "8afae5d3-9f16-4c24-956f-71eb64313ef7",
                                "sense_id": "99a2eca2-28cc-3461-ac46-cdc25a8736ec",
                                "text": "„Sie verpflichteten sich für ein vollständiges Verbot von Entwicklung, Lagerung, Transfer und Einsatz von Atomwaffen, auch der Drohung mit Nuklearschlägen.“"
                            },
                            {
                                "example_id": "4dd8c322-82fb-4f5f-b718-b86afe97fc64",
                                "sense_id": "99a2eca2-28cc-3461-ac46-cdc25a8736ec",
                                "text": "„Die Bunker unter dem Stab sollen einen Nuklearschlag aushalten.“"
                            },
                            {
                                "example_id": "8a212847-7a24-491b-a63d-657ff741548f",
                                "sense_id": "99a2eca2-28cc-3461-ac46-cdc25a8736ec",
                                "text": "„Der Regierungschef ist Vorsitzender der für den Nuklearschlag zuständigen Behörde und hat somit das Recht, über einen Atomschlag zu entscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
