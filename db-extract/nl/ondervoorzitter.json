                "senses": [
                    {
                        "sense_id": "c16f03ab-ca83-3267-9930-51e6f1ff3176",
                        "entry_id": "dda41f28-5200-360f-8022-428e1da19c61",
                        "glosses": [
                            "assistent van de voorzitter die de voorzitter in bepaalde situaties ook kan vervangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a93db7-2a84-4c8f-8e37-63319efd9190",
                                "sense_id": "c16f03ab-ca83-3267-9930-51e6f1ff3176",
                                "text": "Tegen Zuma lopen meer dan 700 aanklachten wegens corruptie en witwassen. Eind december werd de door hem aangewezen opvolger als ANC-leider, zijn ex-vrouw Nkosazana Dlamini-Zuma, op het partijcongres verslagen door ondervoorzitter Cyril Ramaphosa. Hij is een rijke zakenman die het land wil hervormen en corruptie bestrijden."
                            },
                            {
                                "example_id": "96c65cb6-2261-42e9-be1e-c25b326a97be",
                                "sense_id": "c16f03ab-ca83-3267-9930-51e6f1ff3176",
                                "text": "Arib is sinds januari vorig jaar voorzitter. Ze volgde toen VVD'er Van Miltenburg op, die opstapte in de nasleep van de Teevendeal. Arib, die daarvoor al ondervoorzitter was, verwierf in korte tijd veel gezag binnen en buiten de Tweede Kamer. Ze krijgt van veel kanten lof voor haar stijl van voorzitten."
                            }
                        ]
                    }
