                "senses": [
                    {
                        "sense_id": "58812d9b-824e-3fa8-acd9-29f9d6c4c7e4",
                        "entry_id": "8eb5333d-0d6d-31e0-a110-4b9b0755e1b4",
                        "glosses": [
                            "die Quintessenz, das tiefere Wesen von etwas betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67d2c2bc-851a-42bd-8b96-7385de5f7776",
                                "sense_id": "58812d9b-824e-3fa8-acd9-29f9d6c4c7e4",
                                "text": "„Wie sind Sie, der Mann, der quintessenzielle Los-Angeles-Bilder wie ‚A Bigger Splash‘ gemalt hat, hier im Herzen der Normandie gelandet?“"
                            },
                            {
                                "example_id": "b31bb20f-48fa-47a0-a9c0-3ef1d09b7476",
                                "sense_id": "58812d9b-824e-3fa8-acd9-29f9d6c4c7e4",
                                "text": "„Das Design des vor zehn Jahren vorgestellten iPhones war aber nur deshalb so revolutionär, weil es das revolutionäre Innenleben so quintessenziell nach außen transformierte.“"
                            },
                            {
                                "example_id": "7b125b72-dd80-407b-ac8d-2485739d1b3b",
                                "sense_id": "58812d9b-824e-3fa8-acd9-29f9d6c4c7e4",
                                "text": "„Ungeachtet ihres zweifelsohne peinlichen (nicht truen) Gehabes überzeugen mich MANOWAR bis heute auch musikalisch, steht ihr quintessenzieller Metal in seiner Einfachheit doch für alles, was den traditionellen Heavy Metal in seiner Urform ausmacht.“"
                            },
                            {
                                "example_id": "0b3c5769-6f09-4a37-a7f3-abdd2644d4cb",
                                "sense_id": "58812d9b-824e-3fa8-acd9-29f9d6c4c7e4",
                                "text": "„Neben den Werten von Lancôme, die sie so großartig und quintessenziell repräsentiert, verkörpert Isabella die Idee einer vollendeten Schönheit, die synonym auch für Wohlbefinden steht“"
                            },
                            {
                                "example_id": "84d5aeae-2ca7-4f1b-81d1-abc7392ec61f",
                                "sense_id": "58812d9b-824e-3fa8-acd9-29f9d6c4c7e4",
                                "text": "„Tortilla, das quintessenziell iberische Erdäpfel-Zwiebel-Omelett, wird mit saftigem, leicht flüssigem Kern serviert – ideal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
