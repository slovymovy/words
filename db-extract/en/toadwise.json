                        "glosses": [
                            "In the manner of a toad."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e5e9f72-b7e3-4345-8d57-73ce9464d3f4",
                                "sense_id": "da8e0fa0-3359-3971-a056-38907bdee972",
                                "text": "O dainty dew, O morning dew / That gleamed in the world's first dawn, did you / And the sweet grass and manful oaks / Give lair and rest / To him who toadwise sits and croaks / His death-behest?"
                            },
                            {
                                "example_id": "62038f03-8f9f-4aa3-bbfe-80a5b6f7a692",
                                "sense_id": "da8e0fa0-3359-3971-a056-38907bdee972",
                                "text": "When she moved the book the ancient toad hopped off silently, toadwise."
                            },
                            {
                                "example_id": "e2fb6402-ac1e-4f7f-b265-739486b55828",
                                "sense_id": "da8e0fa0-3359-3971-a056-38907bdee972",
                                "text": "To ask whether something on the kitchen counter is the same toad that was in the garden this morning is to ask whether the object in the garden this morning that was modified toadwise is still modified toadwise."
                            }
                        ]
                    }
