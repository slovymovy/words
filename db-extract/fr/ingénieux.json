                                        "entry_id": "01d22852-28a4-30d6-8ddc-341bc61f60da",
                                        "glosses": [
                                            "Displaying genius or brilliance; inventive."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ae1e4c-ae90-4241-b0b4-0bad56c971ff",
                                                "sense_id": "7f0af872-c4f8-33d4-8566-028c24f99a06",
                                                "text": "This fellow is ingenious; he fixed a problem I didn’t even know I had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "270f3a53-65e5-336f-ae08-9d2870b46327",
                                        "entry_id": "01d22852-28a4-30d6-8ddc-341bc61f60da",
                                        "glosses": [
                                            "Characterized by genius; cleverly contrived or done."
                                        ],
                                        "tags": [
                                            "of a thing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b5ec51c-8b03-41f4-b5d7-ebd084ee65de",
                                                "sense_id": "270f3a53-65e5-336f-ae08-9d2870b46327",
                                                "text": "That is an ingenious model of the atom."
                                            },
                                            {
                                                "example_id": "bfaf7630-8ae1-4b49-9a15-580f9788e49c",
                                                "sense_id": "270f3a53-65e5-336f-ae08-9d2870b46327",
                                                "text": "Many ingenious lovely things are gone / That seemed sheer miracle to the multitude, / protected from the circle of the moon / That pitches common things about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a4838cd-1710-3dff-9766-79343ea7dfb9",
                                        "entry_id": "01d22852-28a4-30d6-8ddc-341bc61f60da",
                                        "glosses": [
                                            "Showing originality or sagacity; witty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f48e7276-57a2-4ab2-baee-cebae1ac5503",
                                                "sense_id": "5a4838cd-1710-3dff-9766-79343ea7dfb9",
                                                "text": "He sent me an ingenious reply to an email."
                                            },
                                            {
                                                "example_id": "594fb585-9720-447c-80fb-a66b90fdca62",
                                                "sense_id": "5a4838cd-1710-3dff-9766-79343ea7dfb9",
                                                "text": "I have scarcely recovered the surprise of the ingenious question, before I meet another surprise in the still more ingenious answer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
