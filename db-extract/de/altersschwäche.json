                                        "sense_id": "48ca4485-e485-3f18-be88-200c0a07dae2",
                                        "entry_id": "7b3fa14f-eaa8-3386-920e-4338adb286e2",
                                        "glosses": [
                                            "The latter part of life, when one is an older adult; especially, the years from age 65 onward."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c93fc586-9621-4b97-8088-dbf31a5a515c",
                                                "sense_id": "48ca4485-e485-3f18-be88-200c0a07dae2",
                                                "text": "People often become hard of hearing in old age."
                                            },
                                            {
                                                "example_id": "a707892a-96fb-4fb9-bf6b-229b5dc2e60e",
                                                "sense_id": "48ca4485-e485-3f18-be88-200c0a07dae2",
                                                "text": "A ripe old age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9665db3-4913-3b21-86d2-1c2cd898fcfb",
                                        "entry_id": "7b3fa14f-eaa8-3386-920e-4338adb286e2",
                                        "glosses": [
                                            "A cause of death representing natural death through the expected accumulation of health problems in advanced age."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcccec87-750e-4ed1-b9f1-9ca8d4673e3a",
                        "source_entry_id": "7180b68a-713e-3671-aed0-c770a1364e4b",
                        "source_sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                        "source_sense_description": "körperlicher und/oder geistiger Mangel, der sich mit zunehmendem Alter einstellt",
                        "target_lang_word": "décrépitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décrépitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e404ba3f-95f5-3248-93b9-ca8c28e2417c",
                                        "entry_id": "33dc0447-4598-392c-b685-e2633e6525b9",
                                        "glosses": [
                                            "Déchéance physique qui provient d’un état de vieillesse extrême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbef43ac-0c3e-4e99-9333-66d684275d32",
                                                "sense_id": "e404ba3f-95f5-3248-93b9-ca8c28e2417c",
                                                "text": "II y a six degrés d’âges ; savoir : l’enfance proprement dite, infantia ; la seconde enfance, pueritia; l’adolescence, la virilité, la vieillesse et la décrépitude."
                                            },
                                            {
                                                "example_id": "afa32dd0-5599-4429-96a0-354c761529e4",
                                                "sense_id": "e404ba3f-95f5-3248-93b9-ca8c28e2417c",
                                                "text": "Cependant, malgré les soins prodigieux que le seigneur don Juan Belvidéro donnait à sa personne, les jours de la décrépitude arrivèrent ; avec cet âge de douleur, vinrent les cris de l’impuissance, cris d’autant plus déchirants que plus riches étaient les souvenirs de sa bouillante jeunesse et de sa voluptueuse maturité."
                                            },
                                            {
                                                "example_id": "2eb45f7a-a3e1-40b5-8711-23bcad18c60c",
                                                "sense_id": "e404ba3f-95f5-3248-93b9-ca8c28e2417c",
                                                "text": "[…] mais, au bout de trente ans, il ne fut point rare de voir des vieillards de cent dix et cent vingt ans, ce qui est d’ordinaire l’âge de la dernière décrépitude."
                                            },
                                            {
                                                "example_id": "cb46b991-1978-4272-8855-08734dfce59b",
                                                "sense_id": "e404ba3f-95f5-3248-93b9-ca8c28e2417c",
                                                "text": "[…] ; le singe, le tigre, le lion éloignés de leur patrie et enfermés dans nos ménageries ne tardent pas à tomber dans un état de décrépitude complet et sont presque toujours enlevés par la phthisie."
                                            },
                                            {
                                                "example_id": "77446841-392d-4153-8fa6-76e9e27100f2",
                                                "sense_id": "e404ba3f-95f5-3248-93b9-ca8c28e2417c",
                                                "text": "Elle […] riait des plaisanteries qu'un ivrogne adressait à une très vieille et très innocente prostituée dont la décrépitude s'adornait de perles, d'opales, de brillants, de saphirs, d'émeraudes et de rubis faux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4add1dc4-dec8-3f48-96ca-0a517a8dbc08",
                                        "entry_id": "33dc0447-4598-392c-b685-e2633e6525b9",
                                        "glosses": [
                                            "Déchéance morale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9203505-8591-467d-afb7-2de2001c3502",
                                                "sense_id": "4add1dc4-dec8-3f48-96ca-0a517a8dbc08",
                                                "text": "Décrépitude morale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f042b4f5-9b9e-4ac3-961a-c47e81b31877",
                        "source_entry_id": "7180b68a-713e-3671-aed0-c770a1364e4b",
                        "source_sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                        "source_sense_description": "körperlicher und/oder geistiger Mangel, der sich mit zunehmendem Alter einstellt",
                        "target_lang_word": "vieillesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vieillesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5097825c-2b57-309e-b38b-38c452eb3842",
                                        "entry_id": "28882ffa-803c-3277-9dac-e939003d1531",
                                        "glosses": [
                                            "Âge avancé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df9b841-554a-4bed-aa83-5cbd4868d11d",
                                                "sense_id": "5097825c-2b57-309e-b38b-38c452eb3842",
                                                "text": "II y a six degrés d’âges ; savoir : l’enfance proprement dite, infantia ; la seconde enfance, pueritia; l’adolescence, la virilité, la vieillesse et la décrépitude."
                                            },
                                            {
                                                "example_id": "a1d2e9f3-2340-4f91-befa-6861f17e019c",
                                                "sense_id": "5097825c-2b57-309e-b38b-38c452eb3842",
                                                "text": "C’était elle qui assumait dans la maison les travaux de l’homme que sa vieillesse lui eût rendus difficiles. Combien de ménagères auraient, d’elles-mêmes, pris cette initiative généreuse !"
                                            },
                                            {
                                                "example_id": "0b66fd77-a160-4cbd-90d0-e80f40a9f9eb",
                                                "sense_id": "5097825c-2b57-309e-b38b-38c452eb3842",
                                                "text": "Il portait un costume gris foncé, devait avoir dans les 60 ans, mais restait vif et musclé. Les rides qu'il avait au coin des yeux rayaient de vieillesse son visage dur et impénétrable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcab4ff0-36a2-35f4-9c62-04f328c6d719",
                                        "entry_id": "28882ffa-803c-3277-9dac-e939003d1531",
                                        "glosses": [
                                            "Vétusté, ancienneté, en parlant de choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baee1fe2-95a3-4ccc-8e0f-bee1df8febb3",
                                                "sense_id": "dcab4ff0-36a2-35f4-9c62-04f328c6d719",
                                                "text": "Cette maison, ce bâtiment tombe de vieillesse."
                                            },
                                            {
                                                "example_id": "cf4f9545-57a2-4fe8-90d2-c8dcb2a407fc",
                                                "sense_id": "dcab4ff0-36a2-35f4-9c62-04f328c6d719",
                                                "text": "La vieillesse de ces chênes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9aa25ff-a002-3acb-aefe-d47f2c8e6ee5",
                                        "entry_id": "28882ffa-803c-3277-9dac-e939003d1531",
                                        "glosses": [
                                            "Personnes âgées en général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46cfafb4-6944-4568-b1af-06187928d6f2",
                                                "sense_id": "a9aa25ff-a002-3acb-aefe-d47f2c8e6ee5",
                                                "text": "La vieillesse est chagrine, est avare, est soupçonneuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
