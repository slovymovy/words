                        "glosses": [
                            "Qui a rapport à une sous-préfecture, à un sous-préfet."
                        ],
                        "tags": [
                            "Administration",
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "04f7bfdc-8242-402b-8f1b-8a057ec6d479",
                                "sense_id": "9ad353eb-5ed8-3ca6-a593-51638605fee9",
                                "text": "Sans conclusion nette, le visiteur retenait que le doigt « ministériel » s’était arrêté sur une ou deux sous-préfectures correspondant à un vœu secret du couple sous-préfectoral."
                            },
                            {
                                "example_id": "16f77fbe-b0b4-40cc-9a94-f3a2b998549e",
                                "sense_id": "9ad353eb-5ed8-3ca6-a593-51638605fee9",
                                "text": "On a parfois utilisé les expressions de corps préfectoral et corps sous-préfectoral, mais nous avons évité ce dernier terme car il n’existe pas de corps sous-préfectoral distinct — en tant que corps — des préfets."
                            }
                        ]
