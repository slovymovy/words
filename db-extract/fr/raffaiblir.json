                "senses": [
                    {
                        "sense_id": "938b666d-06e9-336f-a220-7b81c9eb1e15",
                        "entry_id": "c6cf54af-cfa3-31a7-8d35-4be82e708743",
                        "glosses": [
                            "Affaiblir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab1732b0-d1b9-4107-8fe0-ed5100766a9d",
                                "sense_id": "938b666d-06e9-336f-a220-7b81c9eb1e15",
                                "text": "de manière que l'enfant excité aux observations puisse trouver sans cesse, et se plaire toujours davantage, même long-temps après sa sortie de l'école, à chercher, dans la campagne, et dans les travaux dont il est coopérateur ou témoin, une étude et des faits qui tiennent son esprit en haleine, et ne le laissent pas raffaiblir."
                            },
                            {
                                "example_id": "e5fe6134-3bd6-46ea-8ef3-fc3493608b24",
                                "sense_id": "938b666d-06e9-336f-a220-7b81c9eb1e15",
                                "text": "Oui et tu as eu une bonne idée parce que tu lui éviteras de s'raffaiblir."
                            }
                        ]
                    }
                ],
