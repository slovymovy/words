                    },
                    {
                        "translation_id": "9ed2b58d-0eaf-4e2b-8df5-82ae1f7c6e1d",
                        "source_entry_id": "385c27e2-1726-3824-89f9-3f748e1cc66f",
                        "source_sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                        "target_lang_word": "Dorothée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dorothée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                                        "entry_id": "26c8620a-5d01-3df2-b16f-e93826e3a6fd",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e89583b-cb46-45c8-b730-f418882a319f",
                                                "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                                                "text": "Certains jours, Marthe emportait son ouvrage chez la vieille Dorothée, sa voisine.\nUne vieille paysanne, affable, cérémonieuse, affectionnant les façons de parler révérencieuses, particulières aux paysans de bonne famille."
                                            },
                                            {
                                                "example_id": "82c535fa-1038-4901-98d5-c6c09cc19a2b",
                                                "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                                                "text": "Le village dormait. De la lumière aux vitres du Café de la route ; chez le maire ; chez Dorothée. Cette fille était matinale !"
                                            },
                                            {
                                                "example_id": "e28bef98-387a-48a9-a4cd-f87e8f2f4385",
                                                "sense_id": "7ebbb534-7b51-32c1-bb4a-332f512d8def",
                                                "text": "La semaine dernière, quinze enfants du Ticket jeune (sept Taulésiens, accompagnés de Dorothée et Élodie, et huit jeunes Carantécois) ont participé à un camp de quatre jours et trois nuits, à Plouarzel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d63bef-42be-3f30-83fe-3e159ca2a380",
                                        "entry_id": "26c8620a-5d01-3df2-b16f-e93826e3a6fd",
                                        "glosses": [
                                            "Nom masculin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27bd866b-f533-4248-a659-334380c2b3ec",
                                                "sense_id": "61d63bef-42be-3f30-83fe-3e159ca2a380",
                                                "text": "Dorothée de Gaza, né vers 500 et mort entre 565 et 580, est un père du désert palestinien, dont l'influence spirituelle a été considérable."
                                            },
                                            {
                                                "example_id": "5daacacc-4ee1-4a72-b4cb-468a30e41a4c",
                                                "sense_id": "61d63bef-42be-3f30-83fe-3e159ca2a380",
                                                "text": "Au deuxième chapitre de ce texte, on trouve le récit de la rencontre avec Dorothée, un ascète de la région de Thèbes qui passe sa soixantième année dans une grotte …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
