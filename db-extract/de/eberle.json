                ],
                "senses": [
                    {
                        "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                        "entry_id": "dc7d9aa9-b71c-32a0-be45-587ef900fd6e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f191a11-1ba2-418c-ab7a-d39814ac167f",
                                "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                                "text": "Frau Eberle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7c02e37c-8d28-4934-83a1-dd9396d59c7a",
                                "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                                "text": "Herr Eberle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "de404f72-8c4a-434b-aa89-9ebcbf2dd29e",
                                "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                                "text": "Die Eberles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "d7d2b334-f35b-403e-9d80-66e9c7771d52",
                                "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                                "text": "Der Eberle trägt nie die Pullover, die die Eberle ihm strickt."
                            },
                            {
                                "example_id": "ad57b54a-34e4-4584-8c57-5c0b2c380bc2",
                                "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eberle kommt, geht der Herr Eberle.“"
                            },
                            {
                                "example_id": "87683574-a81f-43ae-9f27-a9715f6ea003",
                                "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                                "text": "Eberle kommt und geht."
                            },
                            {
                                "example_id": "e01a70f9-fd29-4b7e-af69-7e3a53bf2ee7",
                                "sense_id": "559c4784-d271-3bb2-b3d6-b899b4f5e7e7",
                                "text": "Eberles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
