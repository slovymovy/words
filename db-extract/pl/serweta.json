                                    {
                                        "sense_id": "dc8631cf-9ab3-3378-964c-707b679350be",
                                        "entry_id": "c77a3346-7d46-3b37-ad0e-2737d5eab3e4",
                                        "glosses": [
                                            "A cloth used to cover and protect a table, especially for a dining table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47642dbf-c117-497b-bbfe-6b699c0977e0",
                                                "sense_id": "dc8631cf-9ab3-3378-964c-707b679350be",
                                                "text": "Just across the field stood a small house. In the yard the week's washing was hung out. Among the articles was a red tablecloth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f305bef5-2849-47b9-926c-5bf087489874",
                        "source_entry_id": "19e1ba3b-ca2d-3800-972d-542819639c1b",
                        "source_sense_id": "fa4b6d71-0a1f-3c5a-bc58-49ca595668e6",
                        "target_lang_word": "napperon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "napperon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91c46357-c36e-36b7-86b9-43a526b9f15c",
                                        "entry_id": "d2728009-7d40-3cb7-8aa7-406f568134c1",
                                        "glosses": [
                                            "Petite nappe, généralement ornée de broderie ou de dentelle, dont on garnit le milieu de la table, un plateau à thé, à liqueurs, etc."
                                        ],
                                        "tags": [
                                            "Ornement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01b98309-5d14-4984-b9eb-22b17c6f6f83",
                                                "sense_id": "91c46357-c36e-36b7-86b9-43a526b9f15c",
                                                "text": "Tout y sent la pauvreté et la tristesse : les napperons de l’autel élimés et troués qu’on sort ce jour-là des tiroirs de la sacristie, les flambeaux de bois dédoré, rongé des vers."
                                            },
                                            {
                                                "example_id": "1b2b89f5-35c6-4c31-a67d-57eaf879d845",
                                                "sense_id": "91c46357-c36e-36b7-86b9-43a526b9f15c",
                                                "text": "De la nappe, passons au napperon, comme celui brodé main qui trônait sur le guéridon de grand-maman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d8ee30-f603-3c4e-b2ee-bc3577118224",
                                        "entry_id": "d2728009-7d40-3cb7-8aa7-406f568134c1",
                                        "glosses": [
                                            "Mince nappe, généralement rectangulaire et faite de tissu ou de plastique, habituellement utilisée sur une table à manger, principalement pour la protéger des ustensiles et des aliments déposés dessus."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "note": "À l'extérieur du Québec, un ensemble de napperons est généralement appelé « set de table » en français. Cet anglicisme est déconseillé par l’Office québécois de la langue française",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43e3efec-ba6d-37b1-b657-f75c36716ab5",
                                        "entry_id": "d2728009-7d40-3cb7-8aa7-406f568134c1",
                                        "glosses": [
                                            "Document succinct résumant l'état d'un projet à l'intention des décideurs."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "note": "Ce terme a été interdit d'utilisation par le gouvernement du Québec à l'automne 2025 en raison de la connotation péjorative qu'il a acquise auprès du grand public dans la foulée de la Commission Gallant",
                                        "examples": [
                                            {
                                                "example_id": "7bc618e5-e040-4059-bea2-d45e5ff2173c",
                                                "sense_id": "43e3efec-ba6d-37b1-b657-f75c36716ab5",
                                                "text": "Conséquence directe de la commission Gallant : le gouvernement du Québec a émis une directive officielle interdisant l’utilisation du terme « napperon », cette fameuse feuille sur laquelle sont présentés les projets importants.\nDes fonctionnaires ont reçu l’ordre de ne plus utiliser le mot « napperon » et de le remplacer par « feuillet d’information » uniquement, a appris notre Bureau parlementaire. … Depuis des années, sur ces documents, les fonctionnaires résument l’avancement des projets, incluant les risques, les échéanciers, les dépenses et les coûts.\nCes napperons sont présentés aux ministres et aux hauts fonctionnaires lors des importantes rencontres de suivi. …\nLe commissaire Denis Gallant a, à plusieurs reprises, critiqué l’utilisation des napperons pour présenter l’évolution des projets aux décideurs.\nIl a rabroué certains employés politiques, pestant qu’ils se soient « contentés d’un napperon », alors qu’il s’agissait de la plus grosse transformation numérique de l’histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
