                "senses": [
                    {
                        "sense_id": "c949ebba-1806-38b6-9c59-317b418d1483",
                        "entry_id": "b6bbe4ce-25d0-317a-91b3-9d81147486c1",
                        "glosses": [
                            "een doek of net dat aan de uiteinden opgehangen wordt en waarin personen kunnen liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343ee865-7057-41c1-b194-ca982307e966",
                                "sense_id": "c949ebba-1806-38b6-9c59-317b418d1483",
                                "text": "Hij was zo zwaar dat hij door de hangmat heen zakte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc6297ee-f175-4622-8c71-e6c312fa420d",
                        "source_entry_id": "b6bbe4ce-25d0-317a-91b3-9d81147486c1",
                        "source_sense_id": "c949ebba-1806-38b6-9c59-317b418d1483",
                        "source_sense_description": "een doek dat aan de uiteinden opgehangen wordt en waarin personen kunnen liggen",
                        "target_lang_word": "Hängematte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hängematte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                        "entry_id": "61c57f52-f797-3107-831f-e6e6fe0dc3eb",
                                        "glosses": [
                                            "als Ruhe- oder Schlaflager dienende, aus einem länglichen Stück Tuch oder einem kräftigen Netz bestehende Unterlage mit Schnüren an beiden kurzen Enden, mit denen diese zwischen zwei Befestigungspunkten aufgespannt wird, um sich darin hineinzulegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659be729-1e80-4539-9990-7a6951f117ec",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Der feine Baron hatte eine Geliebte, die ſich auf eine Hängematte legte und dabei ihre Beine ſenkrecht nach oben ſtreckte. […] Der Baron hatte ſie allein gelaſſen, jetzt kippte ſie aus der Hängematte und flog ins Gras, lag lang da.“"
                                            },
                                            {
                                                "example_id": "d5bfb103-8ce0-4b5d-8b1e-fb57fc005b13",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Wir hingen in Hängematten, allzeit ein Bier in greifbarer Nähe, schwitzend, als wäre Schwitzen unser Lebenszweck, unfähig zu irgendeinem Entschluß, eigentlich ganz zufrieden, denn das Bier ist ausgezeichnet, Yucateca, besser als das Bier im Hochland, wir hingen in unseren Hängematten und tranken, um weiter schwitzen zu können, und ich wußte nicht, was wir eigentlich wollten.“"
                                            },
                                            {
                                                "example_id": "91b4fdba-db13-4c6d-9fc0-8c5244439bfe",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Doch wollen die Frauen noch lange nicht in die Hängematten.“"
                                            },
                                            {
                                                "example_id": "ff76244c-0183-40b6-917e-191304ba0a16",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Man sagte mir, dass er wieder an Bord sei und gerade im Achterdeck seine Hängematte befestige.“"
                                            },
                                            {
                                                "example_id": "c3def745-af32-409f-9afe-8103864655ad",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Mit schwerer Last in Brust und Bauch schaukelte er seine Erschöpfung in Reginas Hängematte zur Ruhe, ohne daß genug Schlaf zu ihm kam, um die Bilder in seinem Kopf auszubrennen.“"
                                            },
                                            {
                                                "example_id": "5562e3ab-c67a-4770-b2ca-2523db612d6d",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Hängematten waren schon vor der Entdeckung durch die Europäer in Lateinamerika in Gebrauch und wurden später in der Schifffahrt als platzsparende Schlafgelegenheit eingesetzt.“"
                                            },
                                            {
                                                "example_id": "b64e48d0-7dff-4aac-9b65-66400b659875",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Seine erste Nacht in der Hängematte, im Bauch eines Schiffes, das noch im Hafen lag, schlief er tief und traumlos.“"
                                            },
                                            {
                                                "example_id": "1278bbf6-703d-4673-9b4c-4668a6023601",
                                                "sense_id": "87bf5f6a-0b3e-32e0-814c-6293e3b768ea",
                                                "text": "„Mein idealer Ort ist eine Erinnerung: An das Aufwachen nach dem Mittagsschlaf in der Hängematte im Garten meiner Großmutter und ihres Freundes ([…]) in der Greifswalder Obstbausiedlung am ersten Tag der Sommerferien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dde378d-4a67-45df-9a54-7821726135de",
                        "source_entry_id": "b6bbe4ce-25d0-317a-91b3-9d81147486c1",
                        "source_sense_id": "c949ebba-1806-38b6-9c59-317b418d1483",
                        "source_sense_description": "een doek dat aan de uiteinden opgehangen wordt en waarin personen kunnen liggen",
                        "target_lang_word": "hammock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hammock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d82291d9-7436-3075-9cf4-741d965f95e5",
                                        "entry_id": "fba20c91-4645-332f-8884-2394f248c56f",
                                        "glosses": [
                                            "A swinging couch or bed, usually made of netting or canvas about six feet (1.8 meters) wide, suspended by clews or cords at the ends."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee6dac7-b5eb-49ba-9c5d-05c74dd690a7",
                                                "sense_id": "d82291d9-7436-3075-9cf4-741d965f95e5",
                                                "text": "[…] the poore ſaylers, who […] commonly get forthwith into their beds (or hamackoes) reſting their tyred bodies […]"
                                            },
                                            {
                                                "example_id": "424aca05-373e-4d56-85c8-9ec7a4647e66",
                                                "sense_id": "d82291d9-7436-3075-9cf4-741d965f95e5",
                                                "text": "[W]ho vvould not rather Sleep Quietly upon a Hammock, vvithout either Cares in his Head, or Crudities in his Stomach, then lye Carking upon a Bed of State, vvith the Qualms and Tvvinges that accompany Surfeits and Exceſs?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764adea5-547e-3ccc-b759-8dc4ef942b3e",
                                        "entry_id": "fba20c91-4645-332f-8884-2394f248c56f",
                                        "glosses": [
                                            "A piece of land thickly wooded, and usually covered with bushes and vines."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hammock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a817a8c-dafb-3e40-baa9-906ba0870074",
                                        "entry_id": "a844c7eb-50f3-3e12-a4e2-2bfa9faf3771",
                                        "glosses": [
                                            "To lie in a hammock."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dab733d-2d03-4b10-bfa8-c2bc9671c8c7",
                                                "sense_id": "7a817a8c-dafb-3e40-baa9-906ba0870074",
                                                "text": "\"I fancied that we — I and who? — hammocked among the summer breezes.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b546163-ba21-3bd4-bd95-5baad3116c95",
                                        "entry_id": "a844c7eb-50f3-3e12-a4e2-2bfa9faf3771",
                                        "glosses": [
                                            "To hang in a way that resembles a hammock."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dae349d-0ccb-4cb9-b9a1-05a1a4ae2ca1",
                                                "sense_id": "0b546163-ba21-3bd4-bd95-5baad3116c95",
                                                "text": "\"She hammocked their plaids between the table and the bed, then edged her way past Kenneth as she approached the central hearth.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e801a1-5524-3878-af30-6447fd7b7d28",
                                        "entry_id": "a844c7eb-50f3-3e12-a4e2-2bfa9faf3771",
                                        "glosses": [
                                            "To make something be wrapped tight, like in a hammock."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b216e91b-60d2-44d5-8419-41fbd0fe51be",
                                                "sense_id": "05e801a1-5524-3878-af30-6447fd7b7d28",
                                                "text": "\"She hammocked her breasts into her bra, snapped it, hitched at it, and gave herself a profile glance in the mirror.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a80378c7-1467-3992-bda8-df613153c577",
                                        "entry_id": "a844c7eb-50f3-3e12-a4e2-2bfa9faf3771",
                                        "glosses": [
                                            "To schedule (a new or unpopular programme) between two popular ones in the hope that viewers will watch it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68e4a5ab-db6e-41c4-9d69-42bde7f0d736",
                        "source_entry_id": "b6bbe4ce-25d0-317a-91b3-9d81147486c1",
                        "source_sense_id": "c949ebba-1806-38b6-9c59-317b418d1483",
                        "source_sense_description": "een doek dat aan de uiteinden opgehangen wordt en waarin personen kunnen liggen",
                        "target_lang_word": "hamac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hamac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "715d57f5-5639-36f4-9207-40dd03e6d2cc",
                                        "entry_id": "fd2ffef9-78fb-3945-8064-ca778d1b8281",
                                        "glosses": [
                                            "Lit formé d’un morceau de toile ou d’un filet, suspendu horizontalement à deux points fixes par ses extrémités, de manière à pouvoir se balancer, dormir ou se reposer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f72cdd9-ddb2-4b33-96a4-40a3c4b2cbe5",
                                                "sense_id": "715d57f5-5639-36f4-9207-40dd03e6d2cc",
                                                "text": "Un cadre pendu au plafond par quatre cordes, garni de quelques poignées de paille et d’un matelas des plus minces, allait me servir de hamac."
                                            },
                                            {
                                                "example_id": "b064743e-687b-4069-a249-ea300b34e9b4",
                                                "sense_id": "715d57f5-5639-36f4-9207-40dd03e6d2cc",
                                                "text": "[…] elle avait aperçu quelques vêtements jetés en désordre dans un hamac et pendant au-dehors."
                                            },
                                            {
                                                "example_id": "60e59b11-5f08-44b2-9712-6711a0fa6a00",
                                                "sense_id": "715d57f5-5639-36f4-9207-40dd03e6d2cc",
                                                "text": "Il comprenait pourquoi il y a des escarpolettes, des hamacs, et projetait de s’en monter un avec des filets de pêcheur, qu’un de ses gardes avait saisis parce qu’ils n’avaient pas la largeur de maille."
                                            },
                                            {
                                                "example_id": "29e3954b-2f7d-4761-b387-6a0f25f3a288",
                                                "sense_id": "715d57f5-5639-36f4-9207-40dd03e6d2cc",
                                                "text": "J’avais vu des hamacs, dans des illustrations de Jules Verne ; ils étaient faits de toile rude, et suspendus sous le pont d’un navire par des crochets de fer. J’avais compris que l’inventeur de ces lits, mollement balancés par la houle, avait eu pour but de bercer les petits matelots, pour faire entrer leur mère dans leurs rêves."
                                            },
                                            {
                                                "example_id": "e0071cdd-9ab4-47ae-866b-46f74b90a5bc",
                                                "sense_id": "715d57f5-5639-36f4-9207-40dd03e6d2cc",
                                                "text": "Le hamac que j’avais sous les yeux était digne d’un amiral. C’était un vaste filet de soie mordorée, accroché à deux baguettes en bois de meuble, et garni de coussins d’un rouge brillant. Il était tendu entre deux acacias, dans une ombre bleue grêlée de grains de soleil que la brise faisait bouger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f20d298-5d3e-4d5e-9a05-950a37be1789",
                        "source_entry_id": "b6bbe4ce-25d0-317a-91b3-9d81147486c1",
                        "source_sense_id": "c949ebba-1806-38b6-9c59-317b418d1483",
