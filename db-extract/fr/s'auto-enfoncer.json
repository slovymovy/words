                        "glosses": [
                            "S’enfoncer soi-même, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1773cd38-bc6c-4649-a5ff-f1694841e6b7",
                                "sense_id": "846f361d-dcbe-3657-9795-cb8786cf0cc2",
                                "text": "Tu viens de t'auto-enfoncer, là, non ?"
                            },
                            {
                                "example_id": "9c460283-4d84-44ec-a31d-37e4fc199e39",
                                "sense_id": "846f361d-dcbe-3657-9795-cb8786cf0cc2",
                                "text": "Cultiver l'humilité et la modestie c'est bien, s'auto-enfoncer dans l'humiliation miséreuse c'est pas nécessaire."
                            },
                            {
                                "example_id": "5d43b91e-e096-463f-bbce-e06f9a9545d5",
                                "sense_id": "846f361d-dcbe-3657-9795-cb8786cf0cc2",
                                "text": "La moitié du futur pont de 4 000 tonnes sous la RN 147 près de Poitiers n'a pas pu s'auto-enfoncer correctement comme prévu."
                            }
                        ]
