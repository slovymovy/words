                "senses": [
                    {
                        "sense_id": "2ce381ab-5dde-3f6b-a60a-121ff9d916a0",
                        "entry_id": "b6a864dd-3f25-3b81-a414-b61eac7c9f43",
                        "glosses": [
                            "Academy-Award, als Filmpreis verliehene Statuette"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "82be1d53-adbb-40e3-a1dc-3226ff80f33c",
                                "sense_id": "2ce381ab-5dde-3f6b-a60a-121ff9d916a0",
                                "text": "Viele Schauspieler warten vergebens auf den Gewinn eines Oscars."
                            },
                            {
                                "example_id": "3252ab72-8db4-4021-8258-2777c6a7c312",
                                "sense_id": "2ce381ab-5dde-3f6b-a60a-121ff9d916a0",
                                "text": "„Die findet immer vier Wochen vor den Oscars statt.“"
                            },
                            {
                                "example_id": "33d136b8-672a-4160-a886-0169aad44496",
                                "sense_id": "2ce381ab-5dde-3f6b-a60a-121ff9d916a0",
                                "text": "„Er läuft monatelang, wird ein Publikumsrenner und bringt dem Produzenten und dem Regisseur den damals noch neuen, aber bereits begehrten Oscar ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69f31a63-8cfe-46f0-83cb-2161f72e66ad",
                        "source_entry_id": "b6a864dd-3f25-3b81-a414-b61eac7c9f43",
                        "source_sense_id": "2ce381ab-5dde-3f6b-a60a-121ff9d916a0",
                        "source_sense_description": "umgangssprachlich: Academy-Award, als Filmpreis verliehene Statuette",
                        "target_lang_word": "Oscar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oscar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe9d17d-4521-3cb2-9572-54073b96a527",
                                        "entry_id": "b9583a42-af22-362b-8a31-65f4ec011c3f",
                                        "glosses": [
                                            "A male given name from Irish or Old English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0806046-64e2-44ab-96d9-75aa1d093d25",
                                                "sense_id": "6fe9d17d-4521-3cb2-9572-54073b96a527",
                                                "text": "My son, though alone, is brave. Oscar is like a beam of the sky: he turns around, and the people fall."
                                            },
                                            {
                                                "example_id": "f921b18f-56fd-40f0-92d6-2aaa139372e4",
                                                "sense_id": "6fe9d17d-4521-3cb2-9572-54073b96a527",
                                                "text": "Had a funny first name, like Oscar or maybe - no! I remember now. It was Felix. Felix Tanner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b25f1320-db35-3f91-88e5-9e943bf5eab3",
                                        "entry_id": "b9583a42-af22-362b-8a31-65f4ec011c3f",
                                        "glosses": [
                                            "A surname from Irish [in turn originating as a patronymic], a rare anglicization of Mac Oscair (“son of Oscar”) (McCusker)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "520f259f-153a-366c-9de4-125b0eab2378",
