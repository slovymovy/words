                                                "sense_id": "b71075e5-11fd-31d7-a8b9-ce7d8afbf633",
                                                "text": "Nach dem Waschen musst du dein Auto trocken ledern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9dd3b1d4-507b-362c-9eed-0d4cc8541ccc",
                                        "entry_id": "cacb2f44-e493-324e-baa6-9dfefd81c060",
                                        "glosses": [
                                            "wiederholt mit den Fäusten auf jemanden einschlagen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a0c328-3586-4632-ba22-004675bb58d1",
                                                "sense_id": "9dd3b1d4-507b-362c-9eed-0d4cc8541ccc",
                                                "text": "Er hatte das Gefühl, als ob es ihn erleichtern müsste, wenn er jetzt jemanden mit aller Kraft „ledern“ würde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c6b84347-3235-32ab-b1e1-fdcfe92ce049",
                                        "entry_id": "cacb2f44-e493-324e-baa6-9dfefd81c060",
                                        "glosses": [
                                            "Leder gerben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
