            "pos": "noun",
            "senses": [
                {
                    "sense_id": "859cb994-17af-3729-9178-8f3493ac9d4a",
                    "sense_definition": "mannelijke geüniformeerde bediende, vooral aan een vorstelijk hof of in een voornaam huishouden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bediende",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>lakei</w> opende plechtig de deuren voor de gasten van de koning.",
                            "target_lang_translations": {
                                "en": "The <w>footman</w> solemnly opened the doors for the king's guests."
                            }
                        },
                        {
                            "text": "In het kasteel liep een <w>lakei</w> rond in traditionele kleding.",
                            "target_lang_translations": {
                                "en": "In the castle, a <w>footman</w> walked around in traditional attire."
                            }
                        }
                    ],
                    "synonyms": [
                        "livreibediende",
                        "livreiknecht"
                    ],
                    "common_phrases": [
                        "als een lakei bedienen"
                    ],
                    "target_lang_definitions": {
                        "en": "a male uniformed servant, especially at a royal court or in a grand household"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "footman",
                                "target_lang_sense_clarification": "liveried male servant"
                            },
                            {
                                "target_lang_word": "lackey",
                                "target_lang_sense_clarification": "liveried servant"
                            },
                            {
                                "target_lang_word": "flunkey",
                                "target_lang_sense_clarification": "liveried manservant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a41c936b-b2d4-32b3-b31a-65055f9588de",
                    "sense_definition": "iemand die zich slaafs en onderdanig gedraagt tegenover een meerdere",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onderdanig persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij weigerde de <w>lakei</w> van de corrupte directeur te zijn.",
                            "target_lang_translations": {
                                "en": "He refused to be the corrupt director's <w>lackey</w>."
                            }
                        },
                        {
                            "text": "Zijn tegenstanders zagen hem slechts als een gehoorzame <w>lakei</w> van het regime.",
                            "target_lang_translations": {
                                "en": "His opponents saw him merely as an obedient <w>lackey</w> of the regime."
                            }
                        }
                    ],
                    "synonyms": [
                        "slaafje",
                        "voetveeg"
                    ],
                    "target_lang_definitions": {
                        "en": "a person who behaves in a servile and submissive manner towards a superior"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lackey",
                                "target_lang_sense_clarification": "servile follower"
                            },
                            {
                                "target_lang_word": "toady",
                                "target_lang_sense_clarification": "sycophantic person"
                            },
                            {
                                "target_lang_word": "minion",
                                "target_lang_sense_clarification": "servile subordinate"
                            },
                            {
                                "target_lang_word": "flunkey",
                                "target_lang_sense_clarification": "subservient person"
                            }
                        ]
                    }
                }
            ]
        },
        {
