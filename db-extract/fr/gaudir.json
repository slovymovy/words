            {
                "entry_id": "37e39074-4205-3e21-ac79-4a245388c652",
                "word": "gaudir",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abc9c20e-f35f-422f-9452-58baf380e4ff",
                        "entry_id": "37e39074-4205-3e21-ac79-4a245388c652",
                        "tags": [
                            "pronominal"
                        ],
                        "form": "se gaudir"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82786cac-95e1-3e22-920d-8b8efd05cb7f",
                        "entry_id": "37e39074-4205-3e21-ac79-4a245388c652",
                        "glosses": [
                            "Se réjouir, manifester sa joie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "33b8aac1-6721-44b6-9fb5-78cce64bb62a",
                                "sense_id": "82786cac-95e1-3e22-920d-8b8efd05cb7f",
                                "text": "Le banquier vint donc interroger ce petit usurier pour savoir par quel hasard il se gaudissait."
                            },
                            {
                                "example_id": "70a8c9d7-cf79-4385-8c11-f046f69ad31b",
                                "sense_id": "82786cac-95e1-3e22-920d-8b8efd05cb7f",
                                "text": "Même quand il était mélancolique, c'était « d'une mélancolie douce… ». Il se remettait, au moindre propos, à sauter, à badiner, à gaudir et à rire"
                            },
                            {
                                "example_id": "204ba1b6-94fa-4164-b2e2-947bb020d5ae",
                                "sense_id": "82786cac-95e1-3e22-920d-8b8efd05cb7f",
                                "text": "Aujourd’hui en fleur, demain en pleur. Tu ne voulais pas me croire, tu ne pensais qu’à te gaudir. Tu as bu le bon, tu bois la lie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
