                "senses": [
                    {
                        "sense_id": "3b5265ac-626d-39e5-bf26-addb49f77df5",
                        "entry_id": "6bd19763-f4d5-30df-a7ad-b9419984db99",
                        "glosses": [
                            "A party to celebrate moving into a new home."
                        ],
                        "tags": [
                            "idiomatic"
                        ],
                        "examples": [
                            {
                                "example_id": "59bb5cbe-8c64-4aa4-af46-a856625d6e0e",
                                "sense_id": "3b5265ac-626d-39e5-bf26-addb49f77df5",
                                "text": "In the eyes of Mr. Farquhar Fenelon Cooke the apotheosis of the Celebrity was complete. The people of Asquith were not only willing to attend the house-warming, but had been worked up to the pitch of eagerness."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd409906-2b36-3f3f-b34e-fe3868af2c53",
                        "entry_id": "6bd19763-f4d5-30df-a7ad-b9419984db99",
                        "glosses": [
                            "The act of welcoming a person/family to their newly purchased or newly rented home."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8c6ed9-5948-4839-9c48-f22bf8099255",
                                "sense_id": "cd409906-2b36-3f3f-b34e-fe3868af2c53",
                                "text": "a housewarming gift"
                            },
                            {
                                "example_id": "fa4276fe-2e6f-40d0-80da-482f6c3eccfb",
                                "sense_id": "cd409906-2b36-3f3f-b34e-fe3868af2c53",
                                "text": "They had their first argument on the evening Gadney moved in, their housewarming spat, he later called it."
                            },
                            {
                                "example_id": "1200755d-67c1-4c24-ac2e-25628a562b1a",
                                "sense_id": "cd409906-2b36-3f3f-b34e-fe3868af2c53",
                                "text": "Fortunately, Dave had left them a packet of rollie tobacco and papers for a housewarming"
                            }
                        ]
                    }
                ],
