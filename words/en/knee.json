                },
                {
                    "sense_id": "aecfcc95-974c-3ea0-b302-ba9a35df1304",
                    "sense_definition": "The place beside a parent or elder where a young child sits and learns.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He learned many of his values at his mother's <w>knee</w> when he was a boy.",
                            "target_lang_translations": {
                                "ru": "Он усвоил многие свои ценности, сидя у <w>ног</w> матери, когда был мальчиком.",
                                "zh": "他小时候在母亲<w>膝前</w>学到了许多价值观。"
                            }
                        },
                        {
                            "text": "Stories told at a grandfather's <w>knee</w> are often remembered for a lifetime.",
                            "target_lang_translations": {
                                "ru": "Истории, рассказанные на <w>коленях</w> у дедушки, часто запоминаются на всю жизнь.",
                                "zh": "在祖父<w>膝前</w>听来的故事，往往会让人记一辈子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "at someone's knee"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic"
                        }
