        "pl-extract.jsonl": [
            {
                "entry_id": "49b6a7fb-5f91-3767-8051-d04698d8a329",
                "word": "leniwie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ad2c570d-dc18-32a0-a9d3-6e2d60589b15",
                        "entry_id": "49b6a7fb-5f91-3767-8051-d04698d8a329",
                        "glosses": [
                            "w sposób leniwy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2689864c-86a7-4381-bb2c-eb048b9ab5e5",
                                "sense_id": "ad2c570d-dc18-32a0-a9d3-6e2d60589b15",
                                "text": "Wylegujący się leniwie pod ścianą domu pies, ulubieniec młodego Zgrzebskiego, ujrzawszy u progu swego pana, skoczył do niego z radosnym skowytem pomachując zwiniętym w znak zapytania ogonem, rzucił mu się do nóg"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a274f487-359a-4e78-93b7-21ad2b572eea",
                        "source_entry_id": "49b6a7fb-5f91-3767-8051-d04698d8a329",
                        "source_sense_id": "ad2c570d-dc18-32a0-a9d3-6e2d60589b15",
                        "target_lang_word": "lazily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7436754b-e513-3c3c-b038-afa2d3d9cdb8",
                                        "entry_id": "1ace8064-b5b2-3805-a868-15127edfb3a6",
                                        "glosses": [
                                            "In a lazy manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3e936f3-a9ed-428e-bcf8-7997428dd85a",
                                                "sense_id": "7436754b-e513-3c3c-b038-afa2d3d9cdb8",
                                                "text": "She lazily scrubbed the pot, but without some real elbow grease it wasn't going to get clean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3797bdbb-bc82-3d05-978b-3e70805ef4b3",
                                        "entry_id": "1ace8064-b5b2-3805-a868-15127edfb3a6",
                                        "glosses": [
                                            "In a slow manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "197237c7-2e88-45a2-ae08-d491dd673b58",
                                                "sense_id": "3797bdbb-bc82-3d05-978b-3e70805ef4b3",
                                                "text": "Her ensign dropped limp like a rag; the muzzles of the long eight-inch guns stuck out all over the low hull; the greasy, slimy swell swung her up lazily and let her down, swaying her thin masts."
                                            },
                                            {
                                                "example_id": "ce27f081-fa6b-4c46-b258-b5c4c50cb7a4",
                                                "sense_id": "3797bdbb-bc82-3d05-978b-3e70805ef4b3",
                                                "text": "Disembarkation seemed a slow business. From the deck one watched a \"Merchant Navy\" Pacific drift lazily along the track beside the wall of the Marine Station, and little South Eastern tanks go snorting fussily about."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5852cd2a-dbd6-4da4-92ed-ad887cf5e20c",
                        "source_entry_id": "49b6a7fb-5f91-3767-8051-d04698d8a329",
                        "source_sense_id": "ad2c570d-dc18-32a0-a9d3-6e2d60589b15",
                        "target_lang_word": "languidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                        "entry_id": "63dca619-e523-3d40-9d25-1ba3bbec3228",
                                        "glosses": [
                                            "In a languid manner, without force or effort, in a manner requiring little energy or exertion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cb5828e-1a37-4fad-bd0b-c905da4aff5a",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "He languidly waved his limp wrist, glad to see us, but not wanting to expend the energy to let us know that."
                                            },
                                            {
                                                "example_id": "c656122d-86b5-4e15-a071-128cf96ac1fe",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "Under the strain of this continually impending doom and by the sleeplessness to which I now condemned myself, ay, even beyond what I had thought possible to man, I became, in my own person, a creature eaten up and emptied by fever, languidly weak both in body and mind, and solely occupied by one thought: the horror of my other self."
                                            },
                                            {
                                                "example_id": "a91621e0-5e48-4969-b799-32eed81591fc",
                                                "sense_id": "04303ffe-ea2f-3b9c-8f31-1c06900663b3",
                                                "text": "“It is your best work, Basil, the best thing you have ever done,” said Lord Henry, languidly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78a19690-341a-499e-93e2-b899760b3418",
                        "source_entry_id": "49b6a7fb-5f91-3767-8051-d04698d8a329",
                        "source_sense_id": "ad2c570d-dc18-32a0-a9d3-6e2d60589b15",
                        "target_lang_word": "languorously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languorously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                        "entry_id": "a5c76311-f45c-3dd5-b080-8d38c85252f6",
                                        "glosses": [
                                            "In a languorous manner; without exertion; lazily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d699f0-9f37-41eb-a6fc-b5fceb83c183",
                                                "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                                "text": "I stretched languorously, and then remained in bed."
                                            },
                                            {
                                                "example_id": "8c21985f-3f6a-46b6-98fb-81977ac63742",
                                                "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                                "text": "\"I did!\" She had reached the barricades, and leaned over them languorously. \"I can't take all the credit, though, just, you know, most of it.\" She folded her arms over the edge, and kicked back both of her feet again and again. \"Somebody once told me I have a mind like a steel trap.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9f9bbed-bb1d-45e1-a78f-5ddd2655e917",
                        "source_entry_id": "49b6a7fb-5f91-3767-8051-d04698d8a329",
                        "source_sense_id": "ad2c570d-dc18-32a0-a9d3-6e2d60589b15",
