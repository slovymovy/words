                        "examples": [
                            {
                                "example_id": "86d3d56b-e29e-486d-82a6-ff6af9455f0e",
                                "sense_id": "f757f7f0-6c97-38b8-8d93-af0234c09d7d",
                                "text": "Terwijl zijn collega’s een liefdadigheidsbal bijwoonden, kookte hij thuis spaghetti, en dan niet de verse, biologische variant, maar de goedkoopste, een vierkilopak gekocht in een winkel waar niemand anders naartoe ging."
                            },
                            {
                                "example_id": "95240666-e4ee-433d-b8de-9c2d4cb9f3a7",
                                "sense_id": "f757f7f0-6c97-38b8-8d93-af0234c09d7d",
                                "text": "Sylvie Meis voelt zich fris en fruitig na een ontspannende douche in een vijfsterrenhotel in Berlijn. La Meis bereidt zich - wachtend op haar goede vriendin en sterrenstyliste Serena Goldenbaum - daar voor op het zogenoemde Dreamball: een liefdadigheidsbal waarvan de opbrengst naar onder andere kankeronderzoek gaat."
                            }
                        ]
