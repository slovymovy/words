                "senses": [
                    {
                        "sense_id": "71c8d02f-cb08-3749-812a-807f95bdd41e",
                        "entry_id": "fc105046-a782-3902-a056-5ccac0d38811",
                        "glosses": [
                            "Acide ascorbique (vitamine C)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ae8730-0e52-4abc-ad6d-708bf5aa0424",
                                "sense_id": "71c8d02f-cb08-3749-812a-807f95bdd41e",
                                "text": "Die vorliegende Erfindung bezieht sich auf Silicium enthaltende Reaktionsprodukte aus Ascorbinsäure und substituierten Ascorbinsäuren."
                            },
                            {
                                "example_id": "2b828bc8-7ae1-463b-9a98-bc9abbad2686",
                                "sense_id": "71c8d02f-cb08-3749-812a-807f95bdd41e",
                                "text": "Drei Dimensionale Stereo Darstellung von Ascorbinsäuren"
                            },
                            {
                                "example_id": "62e42105-8ed4-4b7b-809f-66ce3033b3c6",
                                "sense_id": "71c8d02f-cb08-3749-812a-807f95bdd41e",
                                "text": "Die Droge enthält ferner Sesquiterpenlacton-Bitterstoffe wie Absinthin, Anabsinthin, Artabsin, Anabsin; außerdem Flavone, Ascorbinsäuren und Gerbstoffe."
                            }
                        ]
                    }
