                                        "sense_id": "258edf59-adfe-34b1-adb7-15b3c0a98997",
                                        "entry_id": "deec54ae-2a19-327c-aa13-99c86ff1169f",
                                        "glosses": [
                                            "The act by which someone complains; a complaint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d9c3ee9-976d-49c4-9689-3d444edd7432",
                                                "sense_id": "258edf59-adfe-34b1-adb7-15b3c0a98997",
                                                "text": "Elizabeth […] wished he were beside her, and was so glad to think he would soon be beside her always, with all his humours and weaknesses, all his little crossnesses and complainings[…]"
