                    {
                        "sense_id": "b99438a6-2dc8-381a-a7d1-aa979ee49839",
                        "entry_id": "5f058f20-41c6-3352-8213-d5b7b1e38455",
                        "glosses": [
                            "Pays d’Asie, entouré de l’Afghanistan, de l’Iran, de la mer Caspienne, du Kazakhstan et de l’Ouzbékistan. Sa capitale est Achgabat."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "e86e8424-3ecf-4a8f-bf17-7934e81de2a8",
                                "sense_id": "b99438a6-2dc8-381a-a7d1-aa979ee49839",
                                "text": "Les incidents au Kazakhstan, en Ouzbékistan, au Tadjikistan, au Turkménistan ou au Kirghizstan se sont produits à l'échelle locale, dans les installations nucléaires des pays en question."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60bd5ed9-7ca6-4c5a-9137-7c2db77c2753",
                        "source_entry_id": "5f058f20-41c6-3352-8213-d5b7b1e38455",
                        "source_sense_id": "b99438a6-2dc8-381a-a7d1-aa979ee49839",
