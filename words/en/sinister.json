{
    "word_family": [
        "sinisterly",
        "sinisterness",
        "sinistral",
        "sinistrality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "946712c4-570a-34cb-87c1-056ad4a1db30",
                    "sense_definition": "Giving the impression that something evil or harmful is happening or will happen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "evil_and_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house had a <w>sinister</w> atmosphere that made everyone feel very uncomfortable.",
                            "target_lang_translations": {
                                "ru": "У старого дома была <w>зловещая</w> атмосфера, из-за которой все чувствовали себя очень неуютно."
                            }
                        },
                        {
                            "text": "He noticed a <w>sinister</w> figure lurking in the shadows behind the building.",
                            "target_lang_translations": {
                                "ru": "Он заметил <w>зловещую</w> фигуру, притаившуюся в тенях за зданием."
                            }
                        }
                    ],
                    "synonyms": [
                        "evil",
                        "menacing",
                        "threatening",
                        "dark",
                        "wicked"
                    ],
                    "common_phrases": [
                        "sinister figure",
                        "sinister atmosphere",
                        "sinister laugh",
                        "sinister plot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создающий впечатление, что происходит или произойдет что-то злое или вредное; пугающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "внушающий страх или предчувствие беды"
                            },
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "создающий гнетущую, пугающую атмосферу"
                            },
                            {
                                "target_lang_word": "угрожающий",
                                "target_lang_sense_clarification": "предвещающий опасность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c024cbf-41f7-39ac-9b3c-caab8d325e36",
                    "sense_definition": "Suggesting bad luck or being a sign of future trouble; inauspicious.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "evil_and_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden silence in the forest felt like a <w>sinister</w> omen to the travelers.",
                            "target_lang_translations": {
                                "ru": "Внезапная тишина в лесу показалась путешественникам <w>зловещим</w> предзнаменованием."
                            }
                        },
                        {
                            "text": "There was something <w>sinister</w> about the way the clouds gathered before the storm.",
                            "target_lang_translations": {
                                "ru": "Было что-то <w>недоброе</w> в том, как собирались тучи перед бурей."
                            }
                        }
                    ],
                    "synonyms": [
                        "ominous",
                        "inauspicious",
                        "foreboding",
                        "portentous",
                        "ill-omened"
                    ],
                    "common_phrases": [
                        "sinister omen",
                        "sinister sign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывающий на неудачу или являющийся признаком будущих неприятностей; неблагоприятный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "служащий плохим предзнаменованием"
                            },
                            {
                                "target_lang_word": "недобрый",
                                "target_lang_sense_clarification": "предвещающий беду или неудачу"
                            },
                            {
                                "target_lang_word": "злополучный",
                                "target_lang_sense_clarification": "связанный с несчастьем или бедой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee21855-0b45-39be-9f40-0cc2f38995e8",
                    "sense_definition": "Dishonest or corrupt, especially in a way that is not immediately obvious.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigator uncovered a <w>sinister</w> motive behind the businessman's charitable donations.",
                            "target_lang_translations": {
                                "ru": "Следователь раскрыл <w>злой</w> умысел, стоящий за благотворительными пожертвованиями бизнесмена."
                            }
                        },
                        {
                            "text": "She suspected that her rivals had <w>sinister</w> intentions for the company's future.",
                            "target_lang_translations": {
                                "ru": "Она подозревала, что у её конкурентов были <w>дурные</w> намерения относительно будущего компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "dishonest",
                        "corrupt",
                        "devious",
                        "underhanded"
                    ],
                    "common_phrases": [
                        "sinister motive",
                        "sinister intentions",
                        "sinister purpose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честный или коррумпированный, особенно скрытым или неочевидным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурной",
                                "target_lang_sense_clarification": "скрывающий злой умысел"
                            },
                            {
                                "target_lang_word": "злой",
                                "target_lang_sense_clarification": "направленный на причинение вреда"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "скрыто злонамеренный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "175f9395-bf93-3a96-ad3d-91b2a235c15f",
                    "sense_definition": "Relating to the left side of a shield from the perspective of the person carrying it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family crest features a silver lion on the <w>sinister</w> side of the shield.",
                            "target_lang_translations": {
                                "ru": "На семейном гербе изображен серебряный лев на <w>левой</w> стороне щита."
                            }
                        },
                        {
                            "text": "In heraldry, the <w>sinister</w> side is actually the right side from the viewer's point of view.",
                            "target_lang_translations": {
                                "ru": "В геральдике <w>левая</w> сторона на самом деле является правой с точки зрения зрителя."
                            }
                        }
                    ],
                    "synonyms": [
                        "left"
                    ],
                    "antonyms": [
                        "dexter"
                    ],
                    "common_phrases": [
                        "sinister side",
                        "bend sinister"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к левой стороне щита с точки зрения того, кто его несет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "левый",
                                "target_lang_sense_clarification": "в геральдике: расположенный слева от владельца щита"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e1507f4-6305-368c-81d9-039455a26603",
                    "sense_definition": "Located on or relating to the left side.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon noted a small scar on the patient's <w>sinister</w> cheek during the examination.",
                            "target_lang_translations": {
                                "ru": "Во время осмотра хирург отметил небольшой шрам на <w>левой</w> щеке пациента."
                            }
                        },
                        {
                            "text": "He held the ancient scroll in his <w>sinister</w> hand while reading aloud.",
                            "target_lang_translations": {
                                "ru": "Он держал древний свиток в <w>левой</w> руке, читая вслух."
                            }
                        }
                    ],
                    "synonyms": [
                        "left",
                        "left-hand"
                    ],
                    "antonyms": [
                        "dexter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean simply 'left'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный на левой стороне или относящийся к ней (устаревшее или медицинское)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "находящийся слева",
                                "target_lang_sense_clarification": "расположенный с левой стороны"
                            },
                            {
                                "target_lang_word": "левый",
                                "target_lang_sense_clarification": "относящийся к левой стороне"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}