                                                "sense_id": "01564525-12ac-37ad-8a86-a85fdbb0b632",
                                                "text": "„Wo das Optimum zwischen Anomie und Erziehungsdiktatur liegt, darüber kann und sollte man diskutieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
