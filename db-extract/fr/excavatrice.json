                        ],
                        "form": "excavatrices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fcc33e93-4786-3f28-9d3e-0d013025d343",
                        "entry_id": "73321c94-9f1b-3494-ae7e-26c8d0fbf45a",
                        "glosses": [
                            "Pelleteuse."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "examples": [
                            {
                                "example_id": "10129d52-b829-47bf-87ad-c66ba6e14223",
                                "sense_id": "fcc33e93-4786-3f28-9d3e-0d013025d343",
                                "text": "On a cherché à vous faire porter le chapeau des trous constatés dans les coffres. Mais il s’agissait de cent vingt millions de dollars. Un cratère de ce genre ne pouvait être que l’ouvrage d’une excavatrice géante, et vous êtes si frêle."
                            },
                            {
                                "example_id": "fe2238ce-bdc2-4f00-9671-b72d313f32e3",
                                "sense_id": "fcc33e93-4786-3f28-9d3e-0d013025d343",
                                "text": "Alors qu'ils retournaient à la maison en voiture, il avait vu les excavatrices fourrer leurs bras mécaniques dans le fleuve pour en tirer de gros paquets de terre trempée et sombre, les laisser retomber lourdement sur la rive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dfe5cff-619f-40e7-961d-a602d60a7641",
                        "source_entry_id": "73321c94-9f1b-3494-ae7e-26c8d0fbf45a",
                        "source_sense_id": "fcc33e93-4786-3f28-9d3e-0d013025d343",
                        "target_lang_word": "Bagger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bagger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                        "entry_id": "769a7197-5020-3470-88e1-e86b9a0157f4",
                                        "glosses": [
                                            "eine Maschine zum Abgraben oder Wegschaffen von Erdreich oder Schutt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c6a404-9ef5-4a45-bf8c-2019f4ed9b3a",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "Man setzte mehrere Bagger in dem verschlammten Hafen ein."
                                            },
                                            {
                                                "example_id": "7d0c45d3-6a9e-419e-962d-4f9ea148f471",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "„Auf Laxnes standen noch in meinen ersten Sommern alte Mauerreste, aber ich befürchte gleichwohl, das Fortschrittsdenken, das wir mitbrachten, habe sich in der Gestalt eines Baggers durchgesetzt.“"
                                            },
                                            {
                                                "example_id": "7d1e50fd-88d1-43c2-bf15-b885761b2005",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "„Schwarz ragten die Bagger an der Kiesgrube in den heißen Himmel, ein junges Paar machte sich auf einer Luftmatratze zu schaffen.“"
                                            },
                                            {
                                                "example_id": "6297eb87-ecd5-47f4-b816-db078849ba45",
                                                "sense_id": "803c64ac-15c7-309b-8ca5-d39f977ec2fd",
                                                "text": "„Am Ende des Strandes ruhten die Bagger mit gesenkten Köpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
