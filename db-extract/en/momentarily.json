                    },
                    {
                        "translation_id": "6b04d506-1130-4506-be2f-af6ef42bd301",
                        "source_entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                        "source_sense_description": "In a moment or very soon",
                        "target_lang_word": "zo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef75741-eda1-36e4-b0e0-e24407f8a6c7",
                                        "entry_id": "d4eb49c0-1b52-372b-a317-30421720b674",
                                        "glosses": [
                                            "op die manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be4953d-0d79-4eb3-b402-9e905d661320",
                                                "sense_id": "3ef75741-eda1-36e4-b0e0-e24407f8a6c7",
                                                "text": "We zijn zo door dat gat naar de overkant gekropen."
                                            },
                                            {
                                                "example_id": "fff30648-185d-4f0e-b8ed-3f2a8b84d556",
                                                "sense_id": "3ef75741-eda1-36e4-b0e0-e24407f8a6c7",
                                                "text": "De Chinese autofabrikanten weten auto's op de markt te krijgen met een vaak hogere actieradius tegen een voordeligere prijs dan de Europese concurrenten. \"De innovaties waar Tesla zich de afgelopen tijd op heeft gericht zijn bijvoorbeeld robotisering en zelfrijdende auto's, maar dat is voor Europa voorlopig nog niet zo interessant\", zegt Luman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "761c6916-3103-3093-9fb8-48268fa9904f",
                                        "entry_id": "d4eb49c0-1b52-372b-a317-30421720b674",
                                        "glosses": [
                                            "over niet al te lange tijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4327c33f-a971-4850-9dbd-3c5adefeb53e",
                                                "sense_id": "761c6916-3103-3093-9fb8-48268fa9904f",
                                                "text": "Heb je zo even tijd om naar mijn document te kijken?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c9c829cf-9f42-30be-ba2f-2a7c2093abed",
                                        "entry_id": "2cc71a95-6f46-31de-9944-c76c27d26ece",
                                        "glosses": [
                                            "uiting van verbazing en/of misnoegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a760cdfd-bf84-480f-a193-203dfd2a9716",
                                                "sense_id": "c9c829cf-9f42-30be-ba2f-2a7c2093abed",
                                                "text": "\"Zo, ben je daar eindelijk, waar bleef je nou?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cc8ce99c-8e30-3e18-a211-521a55a6dac1",
                                        "entry_id": "8d859160-05bf-3646-a92d-7e7b7543f439",
                                        "glosses": [
                                            "zondag, de tweede dag van het weekeinde"
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d9f4140-13d1-471a-ad61-c1024053f931",
                                                "sense_id": "cc8ce99c-8e30-3e18-a211-521a55a6dac1",
                                                "text": "Open: di, wo, do, vr; dicht: za, zo, ma.",
                                                "translation": "Geopend op dinsdag, woensdag, donderdag en vrijdag; gesloten op zaterdag, zondag en maandag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
