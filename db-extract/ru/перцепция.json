                    },
                    {
                        "translation_id": "f118dc43-8c73-4b3d-a6eb-62285c6f4fce",
                        "source_entry_id": "ae85c615-f800-3d10-88af-f3203e4b83f4",
                        "source_sense_id": "2970361c-80d0-3058-a36f-4ae725b10834",
                        "target_lang_word": "Wahrnehmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrnehmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                        "entry_id": "19c8219c-3ae6-3ba1-9a40-978db9faad45",
                                        "glosses": [
                                            "Aufnahme und Verarbeitung physikalischer und psychischer Reize durch Sinneszellen oder -organe; Sinneserfahrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b36fbc-cbb2-4b54-9c8c-84f299b749be",
                                                "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                                "text": "Eine verzerrte Wahrnehmung führt zwangsläufig zu ungeeignetem Handeln."
                                            },
                                            {
                                                "example_id": "512f25cf-0e58-4bb7-ad12-9a0ee83dad8c",
                                                "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                                "text": "Ihre Wahrnehmung war durch den Alkoholkonsum getrübt."
                                            },
                                            {
                                                "example_id": "cd2c20f3-d0dc-4b2e-8290-51a464ce9431",
                                                "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                                "text": "„Das ! macht aus dem Internet einen wärmeren, persönlicheren Ort der Zugehörigkeit und strukturiert unsere visuelle Wahrnehmung dieses Ortes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d300cfee-ca2b-372f-95f5-28f7cbd355c8",
                                        "entry_id": "19c8219c-3ae6-3ba1-9a40-978db9faad45",
                                        "glosses": [
                                            "Vertretung, Ausübung, Realisierung von etwas; das sich Kümmern um eine Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d659ece-e6f7-4686-979c-c25d27f9c712",
                                                "sense_id": "d300cfee-ca2b-372f-95f5-28f7cbd355c8",
                                                "text": "Ich habe einen Rechtsanwalt mit der Wahrnehmung meiner Interessen beauftragt."
                                            },
                                            {
                                                "example_id": "0901c589-b106-4514-a6b7-af1aab88b150",
                                                "sense_id": "d300cfee-ca2b-372f-95f5-28f7cbd355c8",
                                                "text": "Er hat viel Zeit auf die Wahrnehmung seines Aufsichtsratsmandates verwendet."
                                            },
                                            {
                                                "example_id": "764a3911-2443-4ee5-ad87-68d0a0886a4d",
                                                "sense_id": "d300cfee-ca2b-372f-95f5-28f7cbd355c8",
                                                "text": "Von der Wahrnehmung dieses Termins muss ich Ihnen dringend abraten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f381446d-6d53-462b-b84f-777d502c91e2",
                        "source_entry_id": "ae85c615-f800-3d10-88af-f3203e4b83f4",
                        "source_sense_id": "2970361c-80d0-3058-a36f-4ae725b10834",
                        "target_lang_word": "Perzeption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perzeption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                        "entry_id": "8be0900f-3f8f-3340-9c2a-f8a4f4112ad3",
                                        "glosses": [
                                            "sinnliche Wahrnehmung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402ec703-4618-4355-954a-ea64924ed67c",
                                                "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                                "text": "„Dies ist nahezu einzigartig in allen 25 EU-Mitgliedstaaten und, gelinde gesagt, in der ausländischen Perzeption undemokratisch für ein europäisches Kernland.“"
                                            },
                                            {
                                                "example_id": "6a28b035-e394-4c6e-a835-71f5ef64fa07",
                                                "sense_id": "58aecc37-ef7f-37c4-8218-2ae2eb6b7202",
                                                "text": "„Die ganze Kunstgeschichte ist letzlich die Geschichte der verschiedenen Arten visueller Perzeption, also eine Geschichte der sich wandelnden Art und Weise, wie der Mensch die Welt gesehen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2323420d-c25f-3ecd-bd7d-f6d05cbea252",
                                        "entry_id": "8be0900f-3f8f-3340-9c2a-f8a4f4112ad3",
                                        "glosses": [
                                            "Wahrnehmung und Verarbeitung sprachlicher Äußerungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df911faf-fbf3-45e6-9091-08b8b583ad4a",
                                                "sense_id": "2323420d-c25f-3ecd-bd7d-f6d05cbea252",
                                                "text": "„Wenn das aber so ist, dann ist die Unfähigkeit Erwachsener, bestimmte distinktive Laute in anderen Sprachen zu unterscheiden, einfach auf ihre automatisierte Perzeption zurückzuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3272ad8-53dd-479a-8c4d-4d506a50c79f",
                        "source_entry_id": "ae85c615-f800-3d10-88af-f3203e4b83f4",
                        "source_sense_id": "2970361c-80d0-3058-a36f-4ae725b10834",
                        "target_lang_word": "perception",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perception",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "889ee2e7-3fdf-3e69-8a0c-5b7777b37261",
                                        "entry_id": "05ce0a83-b8f3-3bb3-9976-e708bf0459e6",
                                        "glosses": [
                                            "Acte par lequel le sujet prend connaissance des objets qui ont fait impression sur ses sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e52593-7902-4e90-979a-2b0cc1cf8259",
                                                "sense_id": "889ee2e7-3fdf-3e69-8a0c-5b7777b37261",
                                                "text": "Étymologiquement, le mot perception vient de percipere, qui signifie « saisir par les sens », mais aussi de perceptio, qui veut dire « action de recevoir »."
                                            },
                                            {
                                                "example_id": "626d1907-de97-48da-898b-173a71ec0b73",
                                                "sense_id": "889ee2e7-3fdf-3e69-8a0c-5b7777b37261",
                                                "text": "Toutefois, les perceptions populaires de la version, plus mythique, de l'histoire islamique, sont solidement ancrées dans les masses."
                                            },
                                            {
                                                "example_id": "774ab51f-f2e9-4eb1-a0fd-a75aa4491f23",
                                                "sense_id": "889ee2e7-3fdf-3e69-8a0c-5b7777b37261",
                                                "text": "Le sens haptique résulte de l'activité simultanée et coordonnée des récepteurs tactiles et kinesthésiques qui fournissent de l'objet une perception unique en trois dimensions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d3975e1-9829-35b1-ba4d-3afea60dc641",
                                        "entry_id": "05ce0a83-b8f3-3bb3-9976-e708bf0459e6",
                                        "glosses": [
                                            "Connaissance que prend le sujet de ses états de conscience."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837fbc97-8b59-4b82-9728-e744016048ad",
                                                "sense_id": "5d3975e1-9829-35b1-ba4d-3afea60dc641",
                                                "text": "La perception interne ou intérieure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a122e8c-de1e-3818-8f82-32e38aa34b1b",
                                        "entry_id": "05ce0a83-b8f3-3bb3-9976-e708bf0459e6",
                                        "glosses": [
                                            "Ce que l’esprit perçoit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9f402d5-fa05-4a84-ade6-477f35c67cc1",
                                                "sense_id": "5a122e8c-de1e-3818-8f82-32e38aa34b1b",
                                                "text": "Les perceptions sensibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6511ac8d-5946-3b40-b577-4e8f69532575",
                                        "entry_id": "05ce0a83-b8f3-3bb3-9976-e708bf0459e6",
                                        "glosses": [
                                            "Recette, recouvrement des impositions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89afca20-2943-40c6-ba64-8de488d78c8f",
                                                "sense_id": "6511ac8d-5946-3b40-b577-4e8f69532575",
                                                "text": "Il faudrait, avant tout, un système de perception mieux approprié à nos besoins et à nos ressources; il faudrait une administration qui fût basée sur les véritables intérêts du Brésil. Notre système d’impôts est barbare; tout le monde le sait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd729d41-9519-3ebf-84f7-a0f51770e535",
                                        "entry_id": "05ce0a83-b8f3-3bb3-9976-e708bf0459e6",
                                        "glosses": [
                                            "Recette, recouvrement des impositions.",
                                            "Emploi de percepteur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e70a7dc6-c7a3-4525-a282-2f1d4c32db35",
                                                "sense_id": "fd729d41-9519-3ebf-84f7-a0f51770e535",
                                                "text": "Le sieur Holleaux, percepteur, dont la place venait d'être supprimée, dénonça par une pétition au ministre de la guerre le sieur Lambert, aussi percepteur et à la perception duquel celle du sieur Holleaux avait été réunie, lui imputant d'avoir, en 1815, fait connaitre au commandant des troupes ennemies un projet de résistance et d'armement de la part des habitans de Vaux-Montreuil, […]."
                                            },
                                            {
                                                "example_id": "95ef6da1-937b-44a4-a15c-133bf4d0a81e",
                                                "sense_id": "fd729d41-9519-3ebf-84f7-a0f51770e535",
                                                "text": "Il a obtenu une perception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed32ea41-b5d4-3a20-8f33-59a3e4fc8413",
                                        "entry_id": "05ce0a83-b8f3-3bb3-9976-e708bf0459e6",
                                        "glosses": [
                                            "Recette, recouvrement des impositions.",
                                            "Bureau du percepteur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10680f3e-088c-41a0-bb21-2ac976534aa7",
                                                "sense_id": "ed32ea41-b5d4-3a20-8f33-59a3e4fc8413",
                                                "text": "La commune de Belval-Bois-des-Dames est disjointe de la perception de Brieulles-sur-Bar et rattachée à la perception de Buzancy."
                                            },
                                            {
                                                "example_id": "b184d72b-912e-444d-97d4-ebd9e09cd597",
                                                "sense_id": "ed32ea41-b5d4-3a20-8f33-59a3e4fc8413",
                                                "text": "Pas question de toucher à la perception de Santa-Maria-Siché, qui gère 65 budgets de collectivités et est considérée comme une excellente agence, lui ont-ils affirmé. Mais le 1ᵉʳ février, un poste a été supprimé et la perception ne traite plus le service des impôts aux particuliers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
