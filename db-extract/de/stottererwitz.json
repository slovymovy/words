                "senses": [
                    {
                        "sense_id": "1e43c845-5d54-34b6-b16a-de6c0a84c720",
                        "entry_id": "0df3e9a4-37f3-334c-8f6c-ac88f8a9b553",
                        "glosses": [
                            "kleine, lustige Geschichte, deren Protagonist eine Person ist, die stottert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3f43b5-4be7-40e5-9b5c-23e005c4734a",
                                "sense_id": "1e43c845-5d54-34b6-b16a-de6c0a84c720",
                                "text": "„Ein anderer Stottererwitz handelt von der Tücke des falschen Helfers.“"
                            },
                            {
                                "example_id": "f15f8c3f-0804-4e30-bb06-e21521926c9d",
                                "sense_id": "1e43c845-5d54-34b6-b16a-de6c0a84c720",
                                "text": "„Man erzählt einem Hörgeschädigten auch nicht gerade einen Schwerhörigenwitz, einem Sprachbehinderten keinen Stottererwitz.“"
                            },
                            {
                                "example_id": "c9e15cc6-e190-4b25-8572-897abdd66a4b",
                                "sense_id": "1e43c845-5d54-34b6-b16a-de6c0a84c720",
                                "text": "„Kürzlich erzählte mir ein Geschäftsmann, dass er bei abendlichen Treffen an der Bar, wenn das Witzeerzählen losgeht, immer einen langen Stottererwitz erzählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
