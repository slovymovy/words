                "senses": [
                    {
                        "sense_id": "4c355e6a-57cd-3955-8cba-50e3f508ca9c",
                        "entry_id": "92039cd1-ad51-3f5b-8871-dcd03812265c",
                        "glosses": [
                            "Sorte d’étoffe à chaîne de soie, à trame de laine de mérinos et qui venait d'Alep avant d'être au XIXᵉ siècle fabriquée, entre autre, dans le nord de la France."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7126a315-3e98-4d9c-9c15-405ee57a6134",
                                "sense_id": "4c355e6a-57cd-3955-8cba-50e3f508ca9c",
                                "text": "Sa robe d’alépine brune, beaucoup trop large, laissait deviner une taille fine, souple et ronde comme un jonc."
                            },
                            {
                                "example_id": "2beee647-c80d-4ed6-8c03-960e0417f74f",
                                "sense_id": "4c355e6a-57cd-3955-8cba-50e3f508ca9c",
                                "text": "La robe de chambre, en alépine noire, devenue luisante, portait la date de l’émigration polonaise."
                            }
                        ]
                    },
                    {
                        "sense_id": "909a5b6f-b300-3301-9ff4-147904c11528",
                        "entry_id": "92039cd1-ad51-3f5b-8871-dcd03812265c",
                        "glosses": [
                            "Noix de galle d’Alep."
