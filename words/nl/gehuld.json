                {
                    "sense_id": "450c2731-8a5f-35d3-b13f-045615138074",
                    "sense_definition": "Omgeven door iets of gekleed in een bepaald kledingstuk of materiaal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De acteur verscheen op het podium, <w>gehuld</w> in een traditioneel kostuum.",
                            "target_lang_translations": {
                                "fr": "L'acteur est apparu sur scène, <w>vêtu</w> d'un costume traditionnel."
                            }
                        },
                        {
                            "text": "De toppen van de bergen waren volledig <w>gehuld</w> in dikke mist.",
                            "target_lang_translations": {
                                "fr": "Les sommets des montagnes étaient entièrement <w>enveloppés</w> d'un épais brouillard."
                            }
                        }
                    ],
                    "synonyms": [
                        "gekleed",
                        "omgeven"
                    ],
                    "common_phrases": [
                        "in nevelen gehuld",
                        "in duisternis gehuld",
                        "in stilzwijgen gehuld"
                    ],
                    "target_lang_definitions": {
                        "fr": "Entouré ou recouvert par quelque chose, ou vêtu d'un vêtement ou d'une matière spécifique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "drapé",
                                "target_lang_sense_clarification": "vêtu élégamment ou recouvert d'une étoffe"
                            },
                            {
                                "target_lang_word": "vêtu",
                                "target_lang_sense_clarification": "habillé d'un vêtement"
                            },
                            {
                                "target_lang_word": "enveloppé",
                                "target_lang_sense_clarification": "entouré (de brouillard, de mystère, etc.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cec1544-ab2a-306b-9f87-acd2d42bc08d",
                    "sense_definition": "Voltooid deelwoord van <w>hullen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft zich voor het feest in een prachtige jurk <w>gehuld</w>.",
