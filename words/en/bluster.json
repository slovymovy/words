{
    "word_family": [
        "blustery",
        "blusterer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7107170e-8a03-3d84-854c-cfea7868b1c6",
                    "sense_definition": "Loud, aggressive, or indignant talk with little effect or meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His threats turned out to be mere <w>bluster</w> and nothing happened.",
                            "target_lang_translations": {
                                "ru": "Его угрозы оказались лишь <w>пустым звуком</w>, и ничего не произошло.",
                                "es": "Sus amenazas resultaron ser meras <w>bravuconadas</w> y no pasó nada."
                            }
                        },
                        {
                            "text": "Despite all the <w>bluster</w> from the opposition, the law was passed easily.",
                            "target_lang_translations": {
                                "ru": "Несмотря на всю <w>шумиху</w> со стороны оппозиции, закон был принят легко.",
                                "es": "A pesar de toda la <w>bravata</w> de la oposición, la ley fue aprobada fácilmente."
                            }
                        }
                    ],
                    "synonyms": [
                        "bombast"
                    ],
                    "common_phrases": [
                        "mere bluster",
                        "all bluster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкие, агрессивные или возмущенные речи, не имеющие реального веса или смысла.",
                        "es": "Discurso ruidoso, arrogante o amenazante que carece de sustancia, peso o intención real."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустые угрозы",
                                "target_lang_sense_clarification": "слова, не подкрепленные действиями"
                            },
                            {
                                "target_lang_word": "бравада",
                                "target_lang_sense_clarification": "показная смелость"
                            },
                            {
                                "target_lang_word": "шумиха",
                                "target_lang_sense_clarification": "громкое обсуждение, суета"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fanfarronadas",
                                "target_lang_sense_clarification": "dichos arrogantes o jactanciosos sin fundamento"
                            },
                            {
                                "target_lang_word": "bravuconadas",
                                "target_lang_sense_clarification": "amenazas o alardes vacíos de valentía"
                            },
                            {
                                "target_lang_word": "bravatas",
                                "target_lang_sense_clarification": "amenazas para amedrentar que no se cumplen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f03de6c-9044-3b7c-ab36-3e304effeb29",
                    "sense_definition": "A violent or strong gust of wind.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the <w>bluster</w> of the storm outside the cabin.",
                            "target_lang_translations": {
                                "ru": "Мы слышали <w>рёв</w> бури снаружи хижины.",
                                "es": "Podíamos oír el <w>bramido</w> de la tormenta fuera de la cabaña."
                            }
                        },
                        {
                            "text": "A sudden <w>bluster</w> knocked the hat right off his head.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>порыв ветра</w> сбил шляпу прямо с его головы.",
                                "es": "Una repentina <w>ráfaga</w> le quitó el sombrero directamente de la cabeza."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный порыв ветра или шум бури.",
                        "es": "Ráfaga violenta, ruidosa y repentina de viento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порыв ветра",
                                "target_lang_sense_clarification": "резкое усиление ветра"
                            },
                            {
                                "target_lang_word": "рёв",
                                "target_lang_sense_clarification": "громкий шум бури"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ráfaga",
                                "target_lang_sense_clarification": "golpe repentino y fuerte de viento"
                            },
                            {
                                "target_lang_word": "bocanada de viento",
                                "target_lang_sense_clarification": "golpe impetuoso de viento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e03673f8-3f84-3bd9-8b88-32f3572c32b5",
                    "sense_definition": "To speak in a loud, arrogant, or threatening way, often to hide a lack of confidence or authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>bluster</w> his way out of the awkward situation.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>нахрапом</w> выпутаться из неловкой ситуации.",
                                "es": "Intentó salir de la incómoda situación a base de <w>fanfarronear</w>."
                            }
                        },
                        {
                            "text": "The manager <w>blustered</w> about the mistake, but everyone knew it was his fault.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>кипятился</w> по поводу ошибки, но все знали, что это его вина.",
                                "es": "El gerente <w>bravuconeó</w> sobre el error, pero todos sabían que era su culpa."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bluster and threaten",
                        "bluster through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить громко, высокомерно или угрожающе, часто чтобы скрыть неуверенность.",
                        "es": "Hablar de forma ruidosa, arrogante o amenazante, a menudo para ocultar inseguridad o falta de autoridad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кипятиться",
                                "target_lang_sense_clarification": "горячиться, возмущаться"
                            },
                            {
                                "target_lang_word": "шуметь",
                                "target_lang_sense_clarification": "громко выражать недовольство"
                            },
                            {
                                "target_lang_word": "бравировать",
                                "target_lang_sense_clarification": "показывать напускную смелость"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fanfarronear",
                                "target_lang_sense_clarification": "hablar con arrogancia y hacer alardes vacíos"
                            },
                            {
                                "target_lang_word": "bravuconear",
                                "target_lang_sense_clarification": "actuar o hablar con amenazas para intimidar"
                            },
                            {
                                "target_lang_word": "hacer aspavientos",
                                "target_lang_sense_clarification": "mostrarse agitado o amenazante ruidosamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec1ff14a-ef28-398a-8cad-de2614501f58",
                    "sense_definition": "To blow in strong, noisy gusts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn wind <w>blustered</w> through the empty streets.",
                            "target_lang_translations": {
                                "ru": "Осенний ветер <w>бушевал</w> на пустынных улицах.",
                                "es": "El viento de otoño <w>soplaba con furia</w> por las calles vacías."
                            }
                        },
                        {
                            "text": "Outside, the storm <w>blustered</w> against the walls of the house.",
                            "target_lang_translations": {
                                "ru": "Снаружи буря <w>ревела</w>, ударяясь о стены дома.",
                                "es": "Afuera, la tormenta <w>bramaba</w> contra las paredes de la casa."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дуть сильными, шумными порывами (о ветре).",
                        "es": "Soplar el viento con ráfagas fuertes, ruidosas y tempestuosas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бушевать",
                                "target_lang_sense_clarification": "проявлять себя с необычайной силой (о стихии)"
                            },
                            {
                                "target_lang_word": "реветь",
                                "target_lang_sense_clarification": "издавать громкий гул (о ветре, буре)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "soplar con furia",
                                "target_lang_sense_clarification": "soplar el viento de manera violenta y ruidosa"
                            },
                            {
                                "target_lang_word": "bramar",
                                "target_lang_sense_clarification": "hacer un ruido fuerte y continuo el viento o la tempestad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}