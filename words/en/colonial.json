                            }
                        },
                        {
                            "text": "We studied the trade routes of <w>colonial</w> Virginia in history class.",
                            "target_lang_translations": {
                                "ru": "На уроке истории мы изучали торговые пути <w>колониальной</w> Вирджинии.",
                                "zh": "我们在历史课上研究了<w>殖民地</w>时期弗吉尼亚州的贸易路线。"
                            }
                        }
                    ],
