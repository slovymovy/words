                        "cross_references": [
                            {
                                "target_word": "pulsation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7389f081-5c15-3d4a-937c-6a5078688d78",
                                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                                        "glosses": [
                                            "The regular throbbing of the heart, an artery etc. in a living body; the pulse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33f9445-4d12-47d0-b469-e4f88266e1ce",
                                                "sense_id": "7389f081-5c15-3d4a-937c-6a5078688d78",
                                                "text": "Pulsation had ceased. For three days the body was preserved unburied, during which it had acquired a stony rigidity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c4f23ae-a307-3e67-b939-da6afdf93a06",
                                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                                        "glosses": [
                                            "Any rhythmic beating, throbbing etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0ed2c79-12c3-41ca-95cc-6d34a9ee610e",
                                                "sense_id": "1c4f23ae-a307-3e67-b939-da6afdf93a06",
                                                "text": "Lo! as a dove when up she springs\n⁠To bear thro’ Heaven a tale of woe,\n⁠Some dolorous message knit below\nThe wild pulsation of her wings;\nLike her I go; I cannot stay;\n⁠I leave this mortal ark behind […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8648d0e6-acbd-3fdb-8f10-9baab90eb6b5",
                                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                                        "glosses": [
                                            "The rhythmic increase and decrease of size in naked zoospores and plasmodia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2091119-9961-31e1-b7b5-cc6b84e31646",
                                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                                        "glosses": [
                                            "Physical striking; a blow."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd9bb4b9-81c9-4c0d-ab00-08b496e40c33",
                                                "sense_id": "c2091119-9961-31e1-b7b5-cc6b84e31646",
                                                "text": "By the Cornelian law, pulsation as well as verberation is prohibited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9afc3b7e-35cb-3ddc-b093-c728a758ce9f",
                                        "entry_id": "df0844af-50d6-3bc6-a022-3c463ecfb16a",
                                        "glosses": [
                                            "A single beat, throb or vibration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6a5a87a-6d69-48ec-8152-4922144e50c8",
                        "source_entry_id": "aff738f9-c6aa-3b9d-b229-dcf6136f2015",
                        "source_sense_id": "c9d0d350-9c3c-32f6-9a25-8fe93cb42bf8",
                        "source_sense_description": "een klopping",
                        "target_lang_word": "pulsation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulsation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c1539f-cf99-370e-81e3-bc84750b3af7",
                                        "entry_id": "059068e1-797e-3120-aa8f-d4b4a1210cdc",
                                        "glosses": [
                                            "Battement du cœur, d’une artère ou de tout autre organe naturellement contractile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa5da7e3-d0bf-4939-891e-e3756bfffb79",
                                                "sense_id": "e0c1539f-cf99-370e-81e3-bc84750b3af7",
                                                "text": "Son pouls fait tant de pulsations par minute."
                                            },
                                            {
                                                "example_id": "aafc1549-51dd-4d6b-a295-76081f3d8cfd",
                                                "sense_id": "e0c1539f-cf99-370e-81e3-bc84750b3af7",
                                                "text": "…le bruit des 650 CV, qui emplit les oreilles, frappe le creux de l'estomac, est comme les pulsations du cœur que l'on se plaît à entendre à la suite d'un effort athlétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21426b77-bee5-31e7-aa2f-c20c88997555",
                                        "entry_id": "059068e1-797e-3120-aa8f-d4b4a1210cdc",
                                        "glosses": [
                                            "Battement régulier marquant le début de chaque temps, qui peut être rendu perceptible par l'utilisation d'un métronome ou être intériorisée par le musicien, et dont la vitesse détermine le tempo d’une pièce."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f52968d1-3f5f-4215-b2aa-2ccbe67e8eec",
                                                "sense_id": "21426b77-bee5-31e7-aa2f-c20c88997555",
                                                "text": "La plupart des partitions ont une indication chiffrée au début. C’est l’indication « métronomique ». Elle indique le nombre de pulsations par minute. Par exemple, « 72 » indique qu’il y aura 72 pulsations par minute."
                                            },
                                            {
                                                "example_id": "53176223-251f-4717-bf9e-b49dcf6d3e9b",
                                                "sense_id": "21426b77-bee5-31e7-aa2f-c20c88997555",
                                                "text": "L’oreille hésite… on ne sait où va aboutir ce mystère d’harmonie… quand les sourdes pulsations des timbales augmentant peu à peu d’intensité arrivent avec les violons qui ont repris part au mouvement et changé l’harmonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae0c6b6-92b0-365e-b672-1b212db9e5c5",
                                        "entry_id": "059068e1-797e-3120-aa8f-d4b4a1210cdc",
                                        "glosses": [
                                            "Changement de luminosité d’une étoile variable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388615f9-f249-4671-801c-f86fc9b12a51",
                                                "sense_id": "4ae0c6b6-92b0-365e-b672-1b212db9e5c5",
                                                "text": "Ces étoiles [les céphéides]; sont très intéressantes car il existe une forte corrélation entre la période de pulsation, la luminosité et la distance. En mesurant la période de pulsation d’une Céphéide, on en déduit sa luminosité et donc sa distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
