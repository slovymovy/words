                    {
                        "translation_id": "10d11f88-9345-4dd6-85e8-96ecf202c965",
                        "source_entry_id": "b880e697-17ad-3199-9ffc-35404f6f29d1",
                        "source_sense_description": "pre-arranged",
                        "target_lang_word": "manipuliert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manipuliert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57a8dea3-4226-3da6-94f4-6dd16547c17d",
                                        "entry_id": "cbb50805-91b4-3cbb-a810-6d605be994a9",
                                        "glosses": [
                                            "unerlaubt an geänderte Gegebenheiten angepasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e74ff85-6cc5-4b78-a7b2-c984b08b67f0",
                                                "sense_id": "57a8dea3-4226-3da6-94f4-6dd16547c17d",
                                                "text": "„In Albanien kommt die Regierung durch manipulierte Wahlen und Verhaftungen von Oppositionspolitikern zustande, in Ungarn wird auf sowjetischen Druck eine Koalitionsregierung unter Mitwirkung der kommunistischen Parteien gebildet, obwohl der rechte Flügel bei den Wahlen im November die absolute Mehrheit errungen hatte.“"
                                            },
                                            {
                                                "example_id": "f2169e74-7c9f-48bd-9483-d98eea1c7c31",
                                                "sense_id": "57a8dea3-4226-3da6-94f4-6dd16547c17d",
                                                "text": "„Fälschungsskandale, manipulierte Studiendaten und als Zufallsbefunde enttarnte Ergebnisse haben die psychologische Forschung in eine Glaubwürdigkeitskrise geführt.“"
                                            },
                                            {
                                                "example_id": "f64660c0-45a2-4533-a548-805862b0c0dd",
                                                "sense_id": "57a8dea3-4226-3da6-94f4-6dd16547c17d",
                                                "text": "„Aus Sicht des Bundesrechnungshofes sind Maßnahmen gegen Steuerbetrug mit manipulierten Ladenkassen längst überfällig.“"
                                            },
                                            {
                                                "example_id": "5b0920ab-b937-4c20-bf03-8c1e4901c072",
                                                "sense_id": "57a8dea3-4226-3da6-94f4-6dd16547c17d",
                                                "text": "„Das Landgericht Düsseldorf hat die Klage eines Autokäufers abgelehnt, der sein manipuliertes Fahrzeug zurückgeben wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c94ced9f-d9c6-3f82-9706-6881bc941ff3",
                                        "entry_id": "cbb50805-91b4-3cbb-a810-6d605be994a9",
                                        "glosses": [
                                            "durch gezielte Eingriffe in das Erbgut abgewandelt, um bessere Ergebnisse zu erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256173ec-2975-45ea-82d8-adbf0d152e4c",
                                                "sense_id": "c94ced9f-d9c6-3f82-9706-6881bc941ff3",
                                                "text": "„Derzeit ist Mon 810 der einzige in Europa für den kommerziellen Anbau zugelassene gentechnisch manipulierte Organismus.“"
                                            },
                                            {
                                                "example_id": "7bcc83f9-9934-4a11-8848-14ccff53d744",
                                                "sense_id": "c94ced9f-d9c6-3f82-9706-6881bc941ff3",
                                                "text": "„Es gibt immer Befürchtungen, daß modifizierte Gene aus genetisch manipulierten Getreidepflanzen durch Outcrossing, das heißt Kreuzung mit verwandten Spezies, \"entkommen\" könnten.“"
                                            },
                                            {
                                                "example_id": "f22654be-4b9f-4c45-ba1b-6a9b4558c0b0",
                                                "sense_id": "c94ced9f-d9c6-3f82-9706-6881bc941ff3",
                                                "text": "„Obwohl gentechnisch manipulierte Lebensmittel zum Alltag gehören, ist vielen Amerikanern das Geschäftsprinzip Monsantos nicht geheuer: Der Konzern lässt sich Eingriffe in das Erbgut seiner auf Widerstandsfähigkeit getrimmten Pflanzen für die Landwirtschaft patentieren und erhebt dafür später hohe Lizenzgebühren.“"
                                            },
                                            {
                                                "example_id": "3a04b98f-8cd6-470e-9604-3fd1b7b144f8",
                                                "sense_id": "c94ced9f-d9c6-3f82-9706-6881bc941ff3",
                                                "text": "„Ob weitere Knollensorten, ob Mais oder Tomaten - künftig dürfte mehr genetisch manipuliertes Gemüse und Getreide auf den Tellern der Verbraucher landen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
