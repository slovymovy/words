                        "cross_references": [
                            {
                                "target_word": "pastille",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc8da7a6-dcca-3776-8eef-1393662f8e48",
                                        "entry_id": "76c005de-5b3e-33be-85af-4252d5fa3c42",
                                        "glosses": [
                                            "An often round and somewhat flat flavoured candy or sweet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9503cf0-9cc7-325e-b774-0bd04588f58e",
                                        "entry_id": "76c005de-5b3e-33be-85af-4252d5fa3c42",
                                        "glosses": [
                                            "Any small, usually round and somewhat flat, granular piece of material; a tablet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3903a340-a8f0-40c9-bc3b-1123b8fe4d67",
                                                "sense_id": "e9503cf0-9cc7-325e-b774-0bd04588f58e",
                                                "text": "Watercolors of professional quality come in small pastilles of dry pigment, in pans of semi-moist paint, or in tubes or bottles of liquid watercolor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "441eb663-cd85-3e7a-8446-c99a92d6dd00",
                                        "entry_id": "76c005de-5b3e-33be-85af-4252d5fa3c42",
                                        "glosses": [
                                            "Any small, usually round and somewhat flat, granular piece of material; a tablet.",
                                            "A small pellet containing aromatic substances, burned to diffuse a fragrance or to disinfect or fumigate."
                                        ],
                                        "tags": [
                                            "historical",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e3f4399-72cf-4cf2-9e1a-a8e60b9c0ad3",
                                                "sense_id": "441eb663-cd85-3e7a-8446-c99a92d6dd00",
                                                "text": "At the end he felt faint and sick, and having lit some Algerian pastilles in a pierced copper brazier, he bathed his hands and forehead with a cool musk-scented vinegar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e291ac2-817a-34f1-a8aa-d5ae1f78c17d",
                                        "entry_id": "76c005de-5b3e-33be-85af-4252d5fa3c42",
                                        "glosses": [
                                            "A medicinal pill, originally made of compressed herbs."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a306725-49cb-4434-8013-df2c66ae4dbb",
                                                "sense_id": "0e291ac2-817a-34f1-a8aa-d5ae1f78c17d",
                                                "text": "In the desperate search for amatory satisfactions, the most monstrous ingredients have throughout the ages, been sought and compounded into electuaries and pastilles, philtres and ointments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad2945e-1220-3a5f-9119-7a983ebd07af",
                                        "entry_id": "76c005de-5b3e-33be-85af-4252d5fa3c42",
                                        "glosses": [
                                            "A candy- or sweet-like lozenge, which, when sucked, releases substances that soothe a sore throat, and sometimes vapours to help unblock the nose or sinuses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pastille",
                                "target_lang_code": "en",
                                "target_senses": [
