                    {
                        "translation_id": "89ac7c5a-1ab3-4a19-b78a-83d4c70c2357",
                        "source_entry_id": "4eae064c-8074-39cf-8cfc-e9e4f01a4ee3",
                        "source_sense_id": "b731118e-2b3c-3c92-9d21-d04cfd649ef3",
                        "source_sense_description": "een Japanse vechtsport",
                        "target_lang_word": "дзюдо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дзюдо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bb75878b-aa6e-3919-b55e-960d614d0a77",
                                        "entry_id": "7d2618e8-3487-359d-bd85-aec71ef9313c",
                                        "glosses": [
                                            "спорт. японская борьба, произошедшая из джиу-джитсу, олимпийский вид спорта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df7f02b5-a32f-4070-a779-6aa949fe4e37",
                                                "sense_id": "bb75878b-aa6e-3919-b55e-960d614d0a77",
                                                "text": "И разговоры в доме велись мужские: о приёмах дзюдо, о боксе, о стрельбе."
                                            },
                                            {
                                                "example_id": "8192a846-80e6-4116-8161-f2d8e38c91ef",
                                                "sense_id": "bb75878b-aa6e-3919-b55e-960d614d0a77",
                                                "text": "Он упёрся коленом в живот противника, сообразив, что наконец-то настал час, когда можно применить известный ему приём японской борьбы дзюдо."
                                            },
                                            {
                                                "example_id": "3909273e-fc37-407e-bd6e-c8794d86fa7a",
                                                "sense_id": "bb75878b-aa6e-3919-b55e-960d614d0a77",
                                                "text": "Растёт число курсов, где безусые парни и седые матроны с одинаковым усердием изучают искусство карате и дзюдо."
                                            },
                                            {
                                                "example_id": "a2217f08-b2bb-44ed-8e5a-9b0798af59c5",
                                                "sense_id": "bb75878b-aa6e-3919-b55e-960d614d0a77",
                                                "text": "Следует отметить также, что именно на основе изучения и анализа техник Айки Дзюцу в начале XX века начали формироваться популярные в настоящее время Дзюдо и Айкидо. Однако Дзюдо после Второй мировой войны всё более превращается из эффективного метода борьбы (формы Будо) просто в спорт, малоэффективный в реальном поединке, для победы в котором основными факторами становятся грубая сила и хитрости в пределах правил соревнований."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
