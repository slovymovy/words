                    {
                        "sense_id": "272838a9-c62b-33b8-bcb7-00bcc9af46c1",
                        "entry_id": "7018f753-7049-3654-b013-8f21a8629018",
                        "glosses": [
                            "krankhafte Einlagerung von Cholesterinester und anderen Fetten in die innere Wandschicht arterieller Blutgefäße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f10044c-bd83-481d-a834-09b16225edae",
                                "sense_id": "272838a9-c62b-33b8-bcb7-00bcc9af46c1",
                                "text": "„Schließlich entwickelt sich beispielsweise eine Arterienverkalkung über 30 bis 40 Jahre.“"
                            },
                            {
                                "example_id": "dd289855-05cd-4850-a391-353d9e5ef7e6",
                                "sense_id": "272838a9-c62b-33b8-bcb7-00bcc9af46c1",
                                "text": "„Zwischen dem Auftreten einer Arterienverkalkung und Depressionen könnte es einen Zusammenhang geben.“"
                            },
                            {
                                "example_id": "8cc696a7-e12a-4150-9355-2f6df411f672",
                                "sense_id": "272838a9-c62b-33b8-bcb7-00bcc9af46c1",
                                "text": "Mindestens 4,5 Millionen Menschen sind in Deutschland akut von Arterienverkalkung betroffen, von der sogenannten peripheren arteriellen Verschlusskrankheit, kurz PAVK."
                            }
                        ],
