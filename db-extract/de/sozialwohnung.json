                "senses": [
                    {
                        "sense_id": "c0b1bf24-6a54-3707-b7c2-1f6ced244040",
                        "entry_id": "8f67a504-f647-34ef-b2fb-fc3381735c4a",
                        "glosses": [
                            "geförderte Wohnung für sozial Bedürftige, die sich keine Wohnung vom freien Wohnungsmarkt leisten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d9ba561-2e25-4e5d-9d4e-af168596aa65",
                                "sense_id": "c0b1bf24-6a54-3707-b7c2-1f6ced244040",
                                "text": "Eine Sozialwohnung sollte nur Berechtigten zugewiesen werden."
                            },
                            {
                                "example_id": "d885b890-3595-4bd1-8c7a-31f2ad273acf",
                                "sense_id": "c0b1bf24-6a54-3707-b7c2-1f6ced244040",
                                "text": "„Weil der Nachschub ausblieb, sank die Zahl der Sozialwohnungen dramatisch.“"
                            },
                            {
                                "example_id": "16690365-7da2-45b2-b588-bbea93862ed1",
                                "sense_id": "c0b1bf24-6a54-3707-b7c2-1f6ced244040",
                                "text": "„[…] zum Jahresende 2018 [gab es] fast 42.500 Sozialwohnungen weniger als ein Jahr zuvor.“"
                            },
                            {
                                "example_id": "456a53a4-bc99-4cf3-aa5a-21ecebff4410",
                                "sense_id": "c0b1bf24-6a54-3707-b7c2-1f6ced244040",
                                "text": "„Die Zahl der Sozialwohnungen in Deutschland ist im vergangenen Jahr weiter gesunken.“"
                            },
                            {
                                "example_id": "5b4bb3ea-58b7-4f45-94a3-54ec34a1b8df",
                                "sense_id": "c0b1bf24-6a54-3707-b7c2-1f6ced244040",
                                "text": "[Salzburg/Österreich:] „Sozialwohnungen, die für Mieter mit wenig Geld gebaut wurden, werden nun kommerziell über Airbnb als Feriendomizile für Urlauber im Internet angeboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
