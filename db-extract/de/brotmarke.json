                "senses": [
                    {
                        "sense_id": "9d1680f3-2af1-3dda-9c4c-4cdbbeabcf52",
                        "entry_id": "ac6869ff-d4ef-3287-8921-19e147fd3d89",
                        "glosses": [
                            "spezielle Marke, die zum Bezug rationierten Brotes berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9a2532-7b50-4822-b138-16faec0ac336",
                                "sense_id": "9d1680f3-2af1-3dda-9c4c-4cdbbeabcf52",
                                "text": "„Der wurde gerade von seiner Mutter durchgekitzelt, der hatte Brotmarken versaubeutelt.“"
                            },
                            {
                                "example_id": "444c3360-9abe-4ae9-b16f-2a5c9882a358",
                                "sense_id": "9d1680f3-2af1-3dda-9c4c-4cdbbeabcf52",
                                "text": "„Sie kam gerade aus dem Bäckerladen heraus, mit dem Körbchen am Arm und ein paar Brotmarken in der Hand.“"
                            },
                            {
                                "example_id": "9b765f23-db3e-4731-b710-195a65b1c8bb",
                                "sense_id": "9d1680f3-2af1-3dda-9c4c-4cdbbeabcf52",
                                "text": "„Eher Theorie blieb die Bitte des jeweiligen Magistrats, nicht verbrauchte Brotmarken wieder abzugeben, um sie Bedürftigen zu spenden - die wenigsten Familien kamen mit den offiziellen Rationen zurecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
