                                        "sense_id": "2468fbd9-1b92-33c9-b80a-69e5dab834ef",
                                        "entry_id": "bda3d51b-946d-325e-bc60-ebb1e0540f0d",
                                        "glosses": [
                                            "Methode, die ein nicht mehr benötigtes Objekt zerstört und die durch das Objekt belegten Ressourcen wieder freigibt"
                                        ],
                                        "tags": [
                                            "objektorientierte Programmierung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887c6056-b18c-4977-b97a-44e44283f872",
                                                "sense_id": "2468fbd9-1b92-33c9-b80a-69e5dab834ef",
                                                "text": "Sobald ein Objekt nicht mehr benötigt wird, sollte sein Destruktor aufgerufen werden, um den durch das Objekt verbrauchten Speicherplatz wieder freizugeben."
                                            },
                                            {
                                                "example_id": "526bab15-3395-44e8-99dc-c7675b357dd4",
                                                "sense_id": "2468fbd9-1b92-33c9-b80a-69e5dab834ef",
                                                "text": "Bei der Implementierung des Destruktors muss darauf geachtet werden, dass auch tatsächlich alle Ressourcen, die das Objekt belegt hat, wieder freigegeben werden."
                                            },
                                            {
                                                "example_id": "9bcddbbe-9729-43d7-901e-1142cd96723f",
                                                "sense_id": "2468fbd9-1b92-33c9-b80a-69e5dab834ef",
                                                "text": "Einige Programmiersprachen wie Java kennen keine Destruktoren, hier sorgt das System selbst dafür, dass der Speicher nicht mehr genutzter Objekte freigegeben wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
