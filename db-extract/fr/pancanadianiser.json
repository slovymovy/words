                        "glosses": [
                            "Donner un caractère pancanadien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e6ad65-3c4b-4abb-b27d-c40470c285fc",
                                "sense_id": "807e1b29-827f-3d17-b07c-b96bc4d2252a",
                                "text": "Comité editorial 7 et d'autres historiens auraient exercé des pressions pour pancanadianiser le récit."
                            },
                            {
                                "example_id": "98ac7f58-7d40-4b96-b054-5d801002f014",
                                "sense_id": "807e1b29-827f-3d17-b07c-b96bc4d2252a",
                                "text": "Si vous ne le faites pas, des gens comme John Saul et d’autres à leur suite, des Canadiens comme des Québécois, se feront les porte-parole d’un Canada qui ne vit pas de ce passé là et qui pancanadianise tous les Canadiens au point où un Trudeau n’a vu pour le Canada que des individus canadiens."
                            }
                        ]
                    }
