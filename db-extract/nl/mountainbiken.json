                "senses": [
                    {
                        "sense_id": "15f94c51-ee6a-3152-b47e-6319584181fe",
                        "entry_id": "a02103ea-346e-30ca-9eeb-ea7c217cf627",
                        "glosses": [
                            "fietsen op een sportieve fiets met minimaal 24 versnellingen en brede banden met noppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1e10d7-8448-4c07-a923-e2150fdefbd3",
                                "sense_id": "15f94c51-ee6a-3152-b47e-6319584181fe",
                                "text": "Mountainbiken maakt wandelpaden geschikt om op te fietsen, met alle mogelijke problemen van dien."
                            },
                            {
                                "example_id": "1716d9d6-4f99-4ba6-a91e-257a39720e1a",
                                "sense_id": "15f94c51-ee6a-3152-b47e-6319584181fe",
                                "text": "In Utrecht, dé fietsstad van Nederland, peddelen vrijwel alle fietsers nog rustig zonder helm door de straten. Ook ouderen, kinderen en hun ouders. Willem (63) is onderweg met een ov-fiets en denkt er \"wel eens over na\", maar gebruikt tot nu toe alleen een helm met mountainbiken."
                            }
                        ]
                    }
