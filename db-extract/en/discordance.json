                        "entry_id": "bd8bcffc-391f-39e3-af3a-e50804d94e39",
                        "glosses": [
                            "Meinungsverschiedenheit, Streit, Unstimmigkeit, Uneinigkeit, Dissonanz, Zwietracht"
