                            {
                                "example_id": "ea90b140-bd99-4d37-83b3-f89f75a7056f",
                                "sense_id": "4cc300e2-5ebb-30b4-a28b-cb3db36a25ec",
                                "text": "Einige Leute verzichten auf ihr Dosenpfand und werfen ihre Dosen achtlos weg."
                            },
                            {
                                "example_id": "c050a600-3123-41a6-8f6a-9ff3204572a2",
                                "sense_id": "4cc300e2-5ebb-30b4-a28b-cb3db36a25ec",
                                "text": "„Die barocke Verordnung über das Dosenpfand kostet mich heute noch schlaflose Nächte.“"
                            }
                        ],
