                "senses": [
                    {
                        "sense_id": "5bab3b4c-f4ec-3b0d-8784-35936192daa2",
                        "entry_id": "69f777a5-b432-307e-a300-3ef734b64dff",
                        "glosses": [
                            "Enzyme digestive présente dans la salive et le suc pancréatique, qui catalyse l’hydrolyse des liaisons α-1,4 glycosidiques de l’amidon et du glycogène, produisant des maltoses et dextrines."
                        ],
                        "tags": [
                            "Gastro-entérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "33d211cf-beef-4d39-a713-0afa3e1eb100",
                                "sense_id": "5bab3b4c-f4ec-3b0d-8784-35936192daa2",
                                "text": "L’amylase est également synthétisée dans les fruits de beaucoup de plantes durant leur maturation et aussi pendant la germination des graines, propriété qui, entre autres, est utilisée pour produire le malt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0850e236-bd4a-459a-ae7d-e2dfa30ba9ac",
                        "source_entry_id": "69f777a5-b432-307e-a300-3ef734b64dff",
                        "source_sense_id": "5bab3b4c-f4ec-3b0d-8784-35936192daa2",
