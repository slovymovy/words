                ],
                "senses": [
                    {
                        "sense_id": "410552b4-14d1-361c-b590-41aa3e1ccea6",
                        "entry_id": "2b1329a0-fd74-3e4a-9ec6-5c014c3adde5",
                        "glosses": [
                            "Faire perdre son caractère factuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29de6a4f-dd40-4fc8-b4c4-cd5b091cc1cf",
                                "sense_id": "410552b4-14d1-361c-b590-41aa3e1ccea6",
                                "text": "Cette attente est d’autant plus justifiée que, comme dit plus haut, le propre du discours scientifique est précisément de limiter au maximum la part de symbolique pour ne pas « défactualiser » la description des faits que l’on étudie."
                            },
                            {
                                "example_id": "4f7a7c89-93c5-4632-a579-75c1599169f5",
                                "sense_id": "410552b4-14d1-361c-b590-41aa3e1ccea6",
                                "text": "L’opérativité philosophique défactualise, et elle défactualise si bien qu’elle fait surgir à elle seule tout un monde – celui des enchaînements démonstratifs – où il n’y a plus de défaillance, de fatigue, de maladie, de mort."
                            },
                            {
                                "example_id": "d923cd0c-b6bf-466f-839d-413091eb07f8",
                                "sense_id": "410552b4-14d1-361c-b590-41aa3e1ccea6",
                                "text": "Belle construction idéologique mais défactualisée donc de peu de valeur."
                            }
                        ]
                    }
                ],
