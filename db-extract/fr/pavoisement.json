                        "entry_id": "64f743fb-8fb1-30cf-807a-81661661fc11",
                        "glosses": [
                            "Action de pavoiser ou résultat de cette action, notamment en marine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf18e1dd-cdc2-4193-96d0-77863c7f4b35",
                                "sense_id": "afcf73ff-9afd-30fa-82d9-e59facf77a8d",
                                "text": "Le pavoisement des navires."
                            },
                            {
                                "example_id": "aae13162-0915-4444-ad87-a41d3c40afd1",
                                "sense_id": "afcf73ff-9afd-30fa-82d9-e59facf77a8d",
                                "text": "S’agirait-il alors d’un ballon d’essai arc-en-ciel destiné à préparer les esprits à un pavoisement permanent ?"
                            },
                            {
                                "example_id": "77f4c30e-f447-4ad7-8e8d-caa305f14462",
                                "sense_id": "afcf73ff-9afd-30fa-82d9-e59facf77a8d",
                                "text": "« Aucune loi ne réglemente le pavoisement de nos mairies. C’est dans les us et coutumes de pouvoir le faire. Et nous ne nous interdisons pas de le faire encore demain », a plaidé le maire PS de Saint-Denis Mathieu Hanotin lundi, sur le parvis de son hôtel de ville."
                            }
                        ]
                    }
