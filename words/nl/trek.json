            "senses": [
                {
                    "sense_id": "aa6ed66c-5773-3e82-bcd6-3e42686970fe",
                    "sense_definition": "Een verlangen naar eten of een licht gevoel van honger.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "desire_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb ontzettende <w>trek</w> in een broodje kaas.",
                            "target_lang_translations": {
                                "en": "I have a huge <w>appetite</w> for a cheese sandwich.",
                                "ru": "Мне ужасно <w>хочется</w> бутерброд с сыром.",
                                "de": "Ich habe schrecklichen <w>Appetit</w> auf ein Käsebrötchen."
                            }
                        },
                        {
                            "text": "Heb jij al <w>trek</w> in het avondeten of wachten we nog even?",
                            "target_lang_translations": {
                                "en": "Do you already have an <w>appetite</w> for dinner or shall we wait a bit?",
                                "ru": "Ты уже <w>хочешь</w> ужинать или мы еще подождем?",
                                "de": "Hast du schon <w>Hunger</w> auf das Abendessen oder warten wir noch kurz?"
                            }
                        }
                    ],
                    "synonyms": [
                        "honger",
                        "eetlust",
                        "appetijt"
                    ],
                    "common_phrases": [
                        "trek hebben",
                        "trek krijgen",
                        "lekkere trek"
                    ],
                    "target_lang_definitions": {
                        "en": "A desire for food or a slight feeling of hunger.",
                        "ru": "Желание поесть или легкое чувство голода.",
                        "de": "Ein Verlangen nach Essen oder ein leichtes Hungergefühl."
                    },
                    "translations": {
