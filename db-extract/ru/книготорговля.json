                    {
                        "translation_id": "ade08122-5f3f-4653-b3ae-0855a6c1de17",
                        "source_entry_id": "212fe751-5ad3-3bb9-8468-ce4eed2a35f7",
                        "source_sense_id": "e22fab07-2e0f-36bf-8e44-b746441a31db",
                        "target_lang_word": "Buchhandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchhandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11ef369a-88b0-31ad-a1b8-d0e4e24e0d05",
                                        "entry_id": "ce9e4b83-48d0-3aaa-980f-0b6064acd1ed",
                                        "glosses": [
                                            "Handelssparte; Handel mit Büchern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "960d8978-156b-460b-b7a3-7f22f4536158",
                                                "sense_id": "11ef369a-88b0-31ad-a1b8-d0e4e24e0d05",
                                                "text": "Für den Buchhandel sind die Buchmessen in jedem Jahr wichtige Ereignisse."
                                            },
                                            {
                                                "example_id": "1effc017-0ff2-41de-9e91-cf21a1c60be3",
                                                "sense_id": "11ef369a-88b0-31ad-a1b8-d0e4e24e0d05",
                                                "text": "„Buchhandel war früher in Österreich ein geschütztes Gewerbe, nur ausgebildete Buch- und Musikalienhändler konnten ein eigenes Geschäft eröffnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d7c427b-4453-40a7-a311-d2d7f164d1ad",
                        "source_entry_id": "212fe751-5ad3-3bb9-8468-ce4eed2a35f7",
                        "source_sense_id": "e22fab07-2e0f-36bf-8e44-b746441a31db",
                        "target_lang_word": "boekhandel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boekhandel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4d33f453-ddeb-351d-b20d-744aeadf92cb",
                                        "entry_id": "cf16df15-0fdb-3b6f-a486-ea531d7a8c03",
                                        "glosses": [
                                            "boekwinkel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969188f9-4787-4c97-8fb4-a0b19406d78f",
                                                "sense_id": "4d33f453-ddeb-351d-b20d-744aeadf92cb",
                                                "text": "Na mijn ontslag bleven we elkaar in Leiden tegenkomen – vooral bij de boekhandel, we lazen allebei veel."
                                            },
                                            {
                                                "example_id": "87b6031f-aab3-4f10-abd3-8fbb1974b157",
                                                "sense_id": "4d33f453-ddeb-351d-b20d-744aeadf92cb",
                                                "text": "De boekenredactie laat zich, bij het samenstellen van haar top-10, leiden door de verkoopcijfers van een aantal door haarzelf geselecteerde Nederlandse literaire boekwinkels. Specifieker, gaat het om de volgende 12 boekhandels: Athenaeum (Amsterdam) Schimmelpennink (Amsterdam) De Groene Waterman (Antwerpen) Van Kemenade & Hollaers (Breda) Paagman (Den Haag) Verkaaik (Gouda) Godert Walter (Groningen) H. de Vries (Haarlem) De Tribune (Maastricht) De Drvkkerij (Middelburg) Roelants (Nijmegen) Van Gennep (Rotterdam)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab11778e-49ed-3412-b4e0-f4ddb187a65c",
                                        "entry_id": "cf16df15-0fdb-3b6f-a486-ea531d7a8c03",
                                        "glosses": [
                                            "verkoop van leesstof aan consumenten"
                                        ],
                                        "tags": [
                                            "bedrijfstak"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0106108-4bd6-4a06-8f28-cffbd22f62db",
                                                "sense_id": "ab11778e-49ed-3412-b4e0-f4ddb187a65c",
                                                "text": "Verder wist ze door haar achtergrond van vertegenwoordiger voor de boekhandel als geen ander welke boekenpakketten commercieel aantrekkelijk waren."
                                            },
                                            {
                                                "example_id": "0ac0c6d8-d039-4068-a16f-4ca82165d334",
                                                "sense_id": "ab11778e-49ed-3412-b4e0-f4ddb187a65c",
                                                "text": "Daar vind je bijna alle uitgevers met hun titels. Voor één keer verkopen ze hun boeken rechtstreeks aan het publiek, dus buiten de boekhandel om. Eigenlijk geven ze, om ruzie met de boekhandel te voorkomen, geen korting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
