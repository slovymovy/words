                "senses": [
                    {
                        "sense_id": "a43ea34f-c83c-3275-9a85-f4f3c7bd9cf9",
                        "entry_id": "80a7e15e-7d39-310f-93cd-6ba305faca62",
                        "glosses": [
                            "Modifier en faisant penser aux troubadours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563eda60-a425-41ec-b43c-1bee01ca517a",
                                "sense_id": "a43ea34f-c83c-3275-9a85-f4f3c7bd9cf9",
                                "text": "Pourquoi vouloir « troubadouriser » un square typiquement haussmannien qui s'inscrit parfaitement dans son environnement Second Empire ?"
                            },
                            {
                                "example_id": "ed79be4f-edb6-42ff-b3a5-ab33a2f65521",
                                "sense_id": "a43ea34f-c83c-3275-9a85-f4f3c7bd9cf9",
                                "text": "Mais vouloir « troubadouriser » le demi-hectare qui s'étend au pied du Musée de Cluny relèverait de la gageure ou du contre-sens."
                            }
                        ]
                    },
                    {
                        "sense_id": "599ed24f-ed3c-3d97-a85a-5d971959dac0",
                        "entry_id": "80a7e15e-7d39-310f-93cd-6ba305faca62",
                        "glosses": [
                            "Se livrer à une activité de troubadour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65853fa1-08e1-4050-a1f5-776fe8440a77",
                                "sense_id": "599ed24f-ed3c-3d97-a85a-5d971959dac0",
                                "text": "Les lorrains \"Lobo et Mie\" viennent troubadouriser quelquefois : leur chanson sur l'inévitable Sarkozy fait un tabac."
                            }
                        ]
                    }
