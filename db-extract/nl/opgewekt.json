        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "18ef3c47-5e84-3625-b223-2b4a9023a38a",
                "word": "opgewekt",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "95486a99-53bb-3753-a217-a281dc7e9567",
                        "entry_id": "18ef3c47-5e84-3625-b223-2b4a9023a38a",
                        "glosses": [
                            "in een actieve en positieve stemming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6758ba0f-be78-4505-ae69-ce4b731ae107",
                                "sense_id": "95486a99-53bb-3753-a217-a281dc7e9567",
                                "text": "Een van de andere obers komt opgewekt aanlopen met een kristallen karaf en zes glaasjes."
                            },
                            {
                                "example_id": "dcfa1441-a962-4f43-aeeb-c9fb4359d323",
                                "sense_id": "95486a99-53bb-3753-a217-a281dc7e9567",
                                "text": "Uit de aangrenzende keuken klinkt opgewekt gepraat."
                            },
                            {
                                "example_id": "12fd47a2-1c6c-4f63-b4c2-d389b004a70e",
                                "sense_id": "95486a99-53bb-3753-a217-a281dc7e9567",
                                "text": "De sfeer was altijd opgewekt, maar al snel ging iedereen over tot de orde van de dag en vertrok naar zijn of haar kamer om huiswerk te maken en ‘écht’ belangrijke mensen te bellen over de laatste drama’s op school."
                            },
                            {
                                "example_id": "9ac62da9-5459-4be4-abc1-2b3a58857f48",
                                "sense_id": "95486a99-53bb-3753-a217-a281dc7e9567",
                                "text": "Zodoende kwam Plinius weer uit mijn kast, een opgewekt verteld avonturenverhaal over een pinguïn die al op zijn derde depressief is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d95f6c8-fab8-4791-ba6c-7b8314653d2a",
                        "source_entry_id": "18ef3c47-5e84-3625-b223-2b4a9023a38a",
                        "source_sense_id": "95486a99-53bb-3753-a217-a281dc7e9567",
                        "source_sense_description": "in een actieve en positieve stemming",
                        "target_lang_word": "cheerful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                        "entry_id": "258f8a75-8e57-3ae5-80b9-c92bdf972bb2",
                                        "glosses": [
                                            "Noticeably happy and optimistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e27d3084-012e-4ead-849c-ec598847accd",
                                                "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                                "text": "Ever in cheerfullest mood art thou, when others are filled with\nGloomy forebodings of illl, and see only ruin before them."
                                            },
                                            {
                                                "example_id": "edba85a1-e713-4f9a-bf6a-479d5484e97b",
                                                "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                                "text": "He moped, she felt, as the time went by, and he was cheerfuler only when some letter, full of hope without expectation, came from Dick."
                                            },
                                            {
                                                "example_id": "d3c8c042-edf2-434d-8c03-55257d4ed8f8",
                                                "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                                "text": "The Eskimo is a nobler, cheerfuller and easy-goinger person than we smug civilized citizens have always imagined. Rockwell Kent, the noted Eskimophile, claims they are a polite and happy race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a9621b-981b-324c-9f23-0fc39553505f",
                                        "entry_id": "258f8a75-8e57-3ae5-80b9-c92bdf972bb2",
                                        "glosses": [
                                            "Bright and pleasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a8b5e5-c145-4393-ad46-4cd91892a341",
                                                "sense_id": "a7a9621b-981b-324c-9f23-0fc39553505f",
                                                "text": "They enjoyed a cheerful room."
                                            },
                                            {
                                                "example_id": "8b92395a-39a8-4167-b81f-15ba8f6b35b5",
                                                "sense_id": "a7a9621b-981b-324c-9f23-0fc39553505f",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "8a86f7a4-edb9-46fe-9d3a-58070213765e",
                        "source_entry_id": "18ef3c47-5e84-3625-b223-2b4a9023a38a",
