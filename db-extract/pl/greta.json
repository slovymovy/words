                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67218311-7945-4dbd-8f88-13ff3a9059d1",
                                                "sense_id": "02e7cfb1-aa2f-386b-9195-769ec0435cd4",
                                                "text": "Herb and Greta poured through “name” books and the only name they could agree on was “Rosalie.” Greta told Herb that she didn't want her daughter's name to end in a “lie,” and so they named her Rosalee."
                                            }
