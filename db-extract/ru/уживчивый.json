                                        "sense_id": "ecd396d0-0c6f-3cc6-9ccb-9224176f323c",
                                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                                        "glosses": [
                                            "Tending to socialize or be social."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81952557-2f84-45d1-80a7-292fb78ae087",
                                                "sense_id": "ecd396d0-0c6f-3cc6-9ccb-9224176f323c",
                                                "text": "He's normally pretty quiet, but he gets much more sociable around women."
                                            },
                                            {
                                                "example_id": "1eec6999-f39c-4035-9982-d5be0ebf5156",
                                                "sense_id": "ecd396d0-0c6f-3cc6-9ccb-9224176f323c",
                                                "text": "Society is no comfort to one not sociable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46a9aa1-601c-3731-8781-de7cb241a8b2",
                                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                                        "glosses": [
                                            "Offering opportunities for conversation; characterized by much conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d151ed-97c4-4e28-bbd4-9c0157f41c5f",
                                                "sense_id": "a46a9aa1-601c-3731-8781-de7cb241a8b2",
                                                "text": "a sociable party"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab4bf18-9e5a-3816-bb09-5602c83c9815",
                                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                                        "glosses": [
                                            "Capable of being, or fit to be, united in one body or company; associable."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f9fdc9-8a66-4ee1-85fa-eee81b464fdb",
                                                "sense_id": "eab4bf18-9e5a-3816-bb09-5602c83c9815",
                                                "text": "They are sociable parts united into one body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b34f8c4-1905-311e-b4a2-3baae20efb14",
                                        "entry_id": "d8c52f2e-d947-3975-8d55-cb1fff89ee77",
                                        "glosses": [
                                            "No longer hostile; friendly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
