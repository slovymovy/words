                ],
                "senses": [
                    {
                        "sense_id": "9d262579-ba4a-3350-a0d2-40c3563c648f",
                        "entry_id": "b847d44f-5fd7-35ae-a575-04530cef1eb4",
                        "glosses": [
                            "Ehegatte oder Partner einer prominenten Sportlerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79606135-c6e6-4134-8bff-ae7f6954605f",
                                "sense_id": "9d262579-ba4a-3350-a0d2-40c3563c648f",
                                "text": "„Weil 2011 die WM der Frauen in Deutschland stattfinden wird, ist damit zu rechnen, dass der Spielerinnenmann in den Fokus rückt, der vergleichsweise unterkühlt rüberkommen dürfte, wie man es von Joachim Sauer kennt, dem Spielerinnenmann der Kanzlerin.“"
                            },
                            {
                                "example_id": "d4f275e2-414e-4731-a77f-a50c6a2d498b",
                                "sense_id": "9d262579-ba4a-3350-a0d2-40c3563c648f",
                                "text": "„Spielerinnenmann: Bastian Schweinsteiger sieht den Sieg von Ana Ivanovic“"
                            },
                            {
                                "example_id": "612deba6-9ba3-4f04-af11-43b6788d1cb7",
                                "sense_id": "9d262579-ba4a-3350-a0d2-40c3563c648f",
                                "text": "„Bisher sind drei Spielerinnenmänner der DFB-Frauen bekannt.“"
                            },
                            {
                                "example_id": "2e537ed3-94c8-4aeb-84c5-fe2e58b0b23a",
                                "sense_id": "9d262579-ba4a-3350-a0d2-40c3563c648f",
                                "text": "„Aber bei anderen Länderspielen schauen Sie schon zu, wenn Ihre Freundin spielt, das gehört sich doch so für einen Spielerinnenmann!“"
                            },
                            {
                                "example_id": "e8e6153b-2fb4-4c16-a3ba-5b06f3b7db95",
                                "sense_id": "9d262579-ba4a-3350-a0d2-40c3563c648f",
                                "text": "„Lediglich 3 des 21 Spielerinnen umfassenden Kaders haben einen Spielerinnenmann?“"
                            },
                            {
                                "example_id": "66dd0d74-635f-4ace-860c-30293584d348",
                                "sense_id": "9d262579-ba4a-3350-a0d2-40c3563c648f",
                                "text": "„Einer der wesentlichen Unterschiede zwischen Männer- und Frauenfußball ist die Tatsache, dass im Frauenfußball die Spielerinnenmänner im Gegensatz zu den Spielerfrauen im Männerfußball keine Rolle spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
