                                "target_senses": [
                                    {
                                        "sense_id": "9de62e57-b3d8-3acf-ac17-48c7e37a0776",
                                        "entry_id": "7094cb5d-1717-385f-906a-e08e07ed645d",
                                        "glosses": [
                                            "One who tows."
                                        ],
