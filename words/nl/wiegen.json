                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winkel stonden verschillende houten <w>wiegen</w> voor baby's uitgestald.",
                            "target_lang_translations": {
                                "en": "Various wooden <w>cradles</w> for babies were on display in the shop."
