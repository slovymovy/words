                    },
                    {
                        "translation_id": "29833b91-3af4-4709-8560-27d9bb95ae12",
                        "source_entry_id": "9ece4285-eab0-3c35-8193-70145d634621",
                        "source_sense_id": "d7126229-878a-3fa8-92c0-f11f37f47d2e",
                        "source_sense_description": "vluchteling",
                        "target_lang_word": "refugee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refugee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                        "entry_id": "c9b92b0c-f91e-39c9-9b5c-aafd9fe73d01",
                                        "glosses": [
                                            "A person seeking refuge (as for shelter or protection), especially in a foreign country, out of fear or prospect of political, religious persecution, war, natural disaster, etc."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc7c14d8-a311-4607-b1d6-c91d0d12afe3",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "In 1962 a special law had to be passed to permit the immigration of several thousand Chinese refugees who had escaped from Communist China to Hong Kong."
                                            },
                                            {
                                                "example_id": "f8ed0251-87c6-46f8-b401-bfde485526ef",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "The eight military bases being used to house Afghan refugees have a total capacity of 50,000 to house evacuees. […] The nine refugee resettlement agencies who work in coordination with the federal government will ultimately determine where Afghans are relocated, based on whether they have US ties or where their local affiliates have capacity to take them in."
                                            },
                                            {
                                                "example_id": "1b36d134-2c2f-4ee4-9a9a-76bba6ab84e5",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "While thousands of refugees were evacuated from the New Orleans convention center, chaos continued at the airport, thousands were still trapped in homes and hotels, fires raged virtually unchecked in parts of the city, the power was out, and vast sections were still under water."
                                            },
                                            {
                                                "example_id": "85aa3499-bc7e-4bfc-b4e5-ef733132c710",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "Why did the SDP dream eventually fade? Partly because it succeeded far better inside parliament than out. It might attract some inner-city Catholic traditionalist Labour refugees from Labour's left, but many of those were already gentrifying."
                                            },
                                            {
                                                "example_id": "fd33a82c-1bd0-4a46-882d-6a49946d8183",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "Alluding to the regional consequences of a war in the Taiwan Strait, Zelensky pointed out that there could be millions of refugees, similar to the result of the Russian invasion of Ukraine."
                                            },
                                            {
                                                "example_id": "a407fd92-70da-489f-8ed9-57eb3789ff85",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
