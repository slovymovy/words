        "fr-extract.jsonl": [
            {
                "entry_id": "18606614-85ba-39ad-9da0-5ed37c77f5e7",
                "word": "sempiternellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c805808-c754-338b-9f08-0b5bd7d8ea48",
                        "entry_id": "18606614-85ba-39ad-9da0-5ed37c77f5e7",
                        "glosses": [
                            "D’une manière sempiternelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5cd052-66b2-4fa3-8e0e-58a9a99723af",
                                "sense_id": "1c805808-c754-338b-9f08-0b5bd7d8ea48",
                                "text": "Voulez-vous montrer […]\nQue tout, même la mort, nous ment,\nEt que sempiternellement\nHélas ! il nous faudra peut-être,\nDans quelque pays inconnu,\nÉcorcher la terre revêche,\nEt pousser une lourde bêche\nSous notre pied sanglant et nu ?"
                            },
                            {
                                "example_id": "f723edf0-7e05-48b4-baac-95aa181f6de2",
                                "sense_id": "1c805808-c754-338b-9f08-0b5bd7d8ea48",
                                "text": "[…] si les paroles changent, le fond est sempiternellement pareil."
                            },
                            {
                                "example_id": "f2c8d3c1-35a1-4ba5-aea0-60fa15dc7bc5",
                                "sense_id": "1c805808-c754-338b-9f08-0b5bd7d8ea48",
                                "text": "« L’autorégulation » et la « bonne conduite », sempiternellement mises en avant par la Commission européenne quand il s’est agi de réguler l’internet, sont, pour ainsi dire, prises en défaut par construction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a927b38b-1bd9-4d60-bf89-4c4d3b35d66e",
                        "source_entry_id": "18606614-85ba-39ad-9da0-5ed37c77f5e7",
                        "source_sense_id": "1c805808-c754-338b-9f08-0b5bd7d8ea48",
                        "target_lang_word": "for ever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for ever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f99630e-b753-3401-8c4b-a9af8457f542",
                                        "entry_id": "1f87df93-46ef-3a6d-ad1e-bb80e8d49ac1",
                                        "glosses": [
                                            "Alternative form of forever."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3d593b-943b-4d39-9e5a-a362eb1b3d80",
                                                "sense_id": "7f99630e-b753-3401-8c4b-a9af8457f542",
                                                "text": "The death of my ſon betiding while my ſoul was under this anxiety, I thought of nothing but reſigning my dominions, and retiring for ever from the ſight of mankind."
                                            },
                                            {
                                                "example_id": "41e6bb8b-7498-4214-9cae-49b40fb7428f",
                                                "sense_id": "7f99630e-b753-3401-8c4b-a9af8457f542",
                                                "text": "'You probably won't understand what he's talking about at first, but don't ever say so, or he'll go on and on for ever, and you still won't understand any better.'"
                                            },
                                            {
                                                "example_id": "1e3ee3c9-a86e-4834-b7ab-536aca36ac6d",
                                                "sense_id": "7f99630e-b753-3401-8c4b-a9af8457f542",
                                                "text": "That Mr Stink had saved up all his pennies to buy her something meant the whole world to her. “I will treasure this for ever, I promise.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
