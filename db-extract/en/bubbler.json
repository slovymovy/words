                    }
                ],
                "senses": [
                    {
                        "sense_id": "043bbc21-4211-3835-9ec3-d565b8b85519",
                        "entry_id": "d3f917d3-797b-3302-bc00-f808f093c0e4",
                        "glosses": [
                            "Something that emits bubbles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de8c9c96-671c-42d0-b6d3-5492cfb91e1a",
                                "sense_id": "043bbc21-4211-3835-9ec3-d565b8b85519",
                                "text": "In proof of this I can assert my success in extinguishing a youthful bubbler near Reykholt church."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a3cbba3-e931-340f-823b-0be94fa2744f",
                        "entry_id": "d3f917d3-797b-3302-bc00-f808f093c0e4",
                        "glosses": [
                            "An airstone for an aquarium."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e6aa959a-a1d8-3344-ae8b-1a93c25af11a",
                        "entry_id": "d3f917d3-797b-3302-bc00-f808f093c0e4",
                        "glosses": [
                            "A drinking fountain."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "e4c99703-2292-4787-a768-bdd987caad82",
                                "sense_id": "e6aa959a-a1d8-3344-ae8b-1a93c25af11a",
                                "text": "There are many types of fountain from which persons may drink by taking the nozzle of the bubbler into the mouth, and this practice is common; furthermore, there are many types in the use of which water from the lips of the consumer falls back onto the bubbler at the point of outlet."
                            },
                            {
                                "example_id": "94a4245f-0186-4e08-b4fc-e826011ae08a",
                                "sense_id": "e6aa959a-a1d8-3344-ae8b-1a93c25af11a",
                                "text": "1939 June, Ella Gardner, Short-Time Camps: A Manual for 4-H Leaders, United States Department of Agriculture, Miscellaneous Publication No. 346, page 11,\nPlans for an inexpensive bubbler or drinking fountain that have been worked out by the 4-H Club department in Massachusetts are shown in figure 4."
                            },
                            {
                                "example_id": "78d071f2-9506-4d06-ae34-c56de205a490",
                                "sense_id": "e6aa959a-a1d8-3344-ae8b-1a93c25af11a",
                                "text": "1962 February, Repairs and Utilities: Refrigeration, Air Conditioning, Mechanical Ventilation, and Evaporative Cooling, United States Department of the Army, Technical Manual TM 5-670, page 82,\nSmall self-contained water coolers have a limited capacity of cooled water. They are equipped with one bubbler or drinking fountain and have a capacity of about 5 gallons of cooled water per hour or less."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7d5db8d-f708-3213-8b91-8a8f54082556",
                        "entry_id": "d3f917d3-797b-3302-bc00-f808f093c0e4",
                        "glosses": [
                            "A device used for smoking marijuana, similar to a cannabis pipe but with a section that holds water, like a bong"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1c2f378e-7e1d-3f14-8b39-ca7f3530d0e6",
                        "entry_id": "d3f917d3-797b-3302-bc00-f808f093c0e4",
                        "glosses": [
                            "One who cheats."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ae8ce632-b1ed-4636-b635-a5b9152a5eae",
                                "sense_id": "1c2f378e-7e1d-3f14-8b39-ca7f3530d0e6",
                                "text": "...above all the Jews, jobbers, bubblers, ſubſcribers, projectors, directors, governors, treaſurers, &c."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab27b8dc-aba0-3c0c-8cfc-b680fbdd1a1f",
                        "entry_id": "d3f917d3-797b-3302-bc00-f808f093c0e4",
