                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in context van waterbeheer en polders"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a piece of land that is no longer protected by dikes after a flood"
                    },
                    "translations": {
                        "en": [
