                    },
                    {
                        "translation_id": "ec4f4b72-0777-4f93-84f8-8a255ac31901",
                        "source_entry_id": "c05423bf-681d-31aa-8994-d6be5a8e28ba",
                        "source_sense_id": "1976296d-c1a8-3f13-a72f-656449ce61c2",
                        "target_lang_word": "langue sifflée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langue sifflée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17c946f2-3367-3c0c-a647-4d7b13786c8a",
                                        "entry_id": "53883e35-619a-36d8-b7dd-ce1b963cf4d8",
                                        "glosses": [
                                            "Version sifflée de certaines langues parlées, utilisée en particulier dans des zones montagneuses pour porter le message assez loin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4027aeda-bcf2-4a2d-a756-55d3f2a4d7be",
                                                "sense_id": "17c946f2-3367-3c0c-a647-4d7b13786c8a",
                                                "text": "On peut noter enfin des efforts en France pour la préservation de la langue sifflée d’Aas, essentiellement utilisée dans la vallée d’Ossau."
                                            },
                                            {
                                                "example_id": "626546f0-2d50-45ff-8356-7c097bde4956",
                                                "sense_id": "17c946f2-3367-3c0c-a647-4d7b13786c8a",
                                                "text": "Le silbo gomero est l’unique langue sifflée au monde à avoir été classée au patrimoine de l’Unesco sur la liste représentative du patrimoine culturel immatériel de l’humanité."
                                            },
                                            {
                                                "example_id": "c5d2eb96-2587-4d7f-aca1-c125a2a15b18",
                                                "sense_id": "17c946f2-3367-3c0c-a647-4d7b13786c8a",
                                                "text": "La langue sifflée est un mode de communication consistant à siffler pour communiquer sur de longues distances. Plus précisément, il s’agit d’une expression sifflée du dialecte local."
                                            },
                                            {
                                                "example_id": "fb43aa99-92ef-4fe2-82f9-22550ad262d5",
                                                "sense_id": "17c946f2-3367-3c0c-a647-4d7b13786c8a",
                                                "text": "Dans ce petit établissement de 103 collégiens, on apprend la langue sifflée des Pyrénées, à raison de deux heures par mois. Il faut imaginer cette langue, née dans le village voisin d’Aas et sa centaine d’habitants, comme une «version de la parole, comme peut l’être le chuchotement», explique Philippe Biu, professeur de lettres et d’occitan à l’Université de Pau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
