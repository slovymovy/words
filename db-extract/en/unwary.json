                                            {
                                                "example_id": "6285bf18-baac-46fe-b6ab-9c02c42a93a7",
                                                "sense_id": "89b641ee-66e2-359f-8d6f-d0a648d1aa94",
                                                "text": "Er ist noch ein recht unbedarfter Junge."
                                            },
                                            {
                                                "example_id": "5d780998-97f7-41d1-bf2d-02d6315963d8",
                                                "sense_id": "89b641ee-66e2-359f-8d6f-d0a648d1aa94",
                                                "text": "„Die beschwerdeführende Gesellschaft macht geltend, dass »die rechtlich unbedarfte und nicht vertretene Geschäftsführerin der Beschwerdeführerin C GmbH entgegen der Manuduktionspflicht der belangten Behörde nicht belehrt« worden sei, »alles für sie sachlich und rechtlich Entlastende vorzubringen, […].«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
