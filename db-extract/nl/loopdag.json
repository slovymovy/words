                            {
                                "example_id": "dc11b387-6f89-4047-8b05-f99319bf9953",
                                "sense_id": "e3a1d252-5903-31a2-a505-4871aefcbbc3",
                                "text": "Wat een hitte! Voor wandelaars was deze eerste loopdag behoorlijk zwoegen. Sommige deelnemers vonden dat ze onderweg te weinig water kregen. Hopelijk gaat het morgen beter met de watervoorziening."
                            },
                            {
                                "example_id": "6d917192-d979-4439-a1b4-f7e7838d382b",
                                "sense_id": "e3a1d252-5903-31a2-a505-4871aefcbbc3",
                                "text": "Ze doet volgend jaar zeker weer mee aan de loopdag van de stichting Wandelnet, maar pakt in de tussentijd wel weer de fiets. \"Ik liep nu door woonwijken, maar ik heb toch liever bos en hei.\""
                            }
                        ]
                    }
