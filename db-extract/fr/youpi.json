                                        "entry_id": "9b27717e-39d7-3f29-bc7e-b2946ac6e5ec",
                                        "glosses": [
                                            "To behave exuberantly; to make whoopee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0510e358-437e-4324-b983-7db7c38bff7e",
                                                "sense_id": "ff086323-305f-358e-b8d0-f9dd5e7be88b",
                                                "text": "\"If the 'twenties,\" said the stage-hand, who was a politician, \"had done a bit more thinking and a bit less whoopeeing, we mightn't be where we are today."
                                            }
                                        ]
                                    }
                                ]
                            }
