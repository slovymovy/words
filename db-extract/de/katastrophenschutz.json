                ],
                "senses": [
                    {
                        "sense_id": "902d166b-b71a-3ee6-b52d-8ed2f98e4e77",
                        "entry_id": "2262706b-d935-3065-bd6f-f3a4d3b3af37",
                        "glosses": [
                            "Protection contre les catastrophes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe913ade-70d6-4785-b70d-c061b9d1f280",
                                "sense_id": "902d166b-b71a-3ee6-b52d-8ed2f98e4e77",
                                "text": "Nach dem Grundgesetz ist der Kastrophenschutz eine hoheitliche Aufgabe der Länder zum Schutz der Bevölkerung im Katastrophenfall."
                            },
                            {
                                "example_id": "9fac752c-6313-4de8-82a4-a6f644b3e19e",
                                "sense_id": "902d166b-b71a-3ee6-b52d-8ed2f98e4e77",
                                "text": "Die Ampel-Regierung will dem Bund mehr Kompetenzen im Katastrophenschutz geben, aber laut Grundgesetz sind hierfür die Länder zuständig. Ist eine Reform möglich?",
                                "translation": "Le gouvernement de l'Ampel veut donner plus de compétences à l'Etat fédéral en matière de gestion des catastrophes, mais selon la loi fondamentale, ce sont les Länder qui sont compétents en la matière. Une réforme est-elle possible ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
