                ],
                "senses": [
                    {
                        "sense_id": "3956ccf8-22fb-3d3f-bdde-8ec67f9021cd",
                        "entry_id": "13a1e7a2-0c84-3b83-8e7e-f18fd7727e14",
                        "glosses": [
                            "ktoś, kto lubi się bawić i robić żarty"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "148a7ed2-2839-47aa-84b9-cc64d4aa7aea",
                                "sense_id": "3956ccf8-22fb-3d3f-bdde-8ec67f9021cd",
                                "text": "Molnara.] Wybrana grupa swawolników nadaje ton klasie, płata mocne figle „belfrom“, [ma swoją tajemniczą skrytkę, w której odbywa narady, swego zdolnego, wesołego herszta i umie odpowiednio użytkować talenty członków.]"
                            },
                            {
                                "example_id": "a8d28454-f99d-4b3e-a300-b395cd539b5a",
                                "sense_id": "3956ccf8-22fb-3d3f-bdde-8ec67f9021cd",
                                "text": "Burza śmiechów wstrząsa cichym sadem, / Wiatr swawolnik spódniczki rozwiewa, / Skrzypią sznury i rubinów gradem / Lecą wiśnie otrzęsione z drzewa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "173815d2-10fb-36ff-bc07-0e1ef4f63519",
                        "entry_id": "13a1e7a2-0c84-3b83-8e7e-f18fd7727e14",
                        "glosses": [
                            "awanturnik, warchoł, rozpustnik"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a2ef803b-0a8c-47d5-98f1-71d5cc90d54c",
                                "sense_id": "173815d2-10fb-36ff-bc07-0e1ef4f63519",
                                "text": "[Chwała Bogu!… niech-no już jegomość nie umiera… rychło ich tu patrzeć…] my do Zamościa uciekli… i tam ksiądz oddał pannę pani Witowskiej… dla przystojności… że to w wojsku swawolnicy bywają…"
                            },
                            {
                                "example_id": "ef68040f-cb8e-441e-9991-a14fd248c5ed",
                                "sense_id": "173815d2-10fb-36ff-bc07-0e1ef4f63519",
                                "text": "Jerlicz mówi, że swawolnicy miejscowi wzniecili pożar dla łupieztwa"
                            },
                            {
                                "example_id": "0df4536e-255c-4c86-a6d5-df26db07fc40",
                                "sense_id": "173815d2-10fb-36ff-bc07-0e1ef4f63519",
                                "text": "[Za ich przyzwoleniem] będzie król mocen takowych swawolników za nieprzyjaciół ojczyzny, [wywołańców (bannitów) i bezecnych (infames)] ogłosić, [i zaraz bez dołożenia się sejmowego wszelkie środki ku ich ukaraniu, zniesieniu i wygubieniu przedsiębrać.]"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4cce589-99e8-4d70-b334-fad96cdc8e3a",
                        "source_entry_id": "13a1e7a2-0c84-3b83-8e7e-f18fd7727e14",
                        "source_sense_id": "3956ccf8-22fb-3d3f-bdde-8ec67f9021cd",
