                "senses": [
                    {
                        "sense_id": "45160320-1953-3e5e-bb2d-df7ea139372a",
                        "entry_id": "d35cddd8-05d8-36ad-b3af-0daf802abc33",
                        "glosses": [
                            "natürlicher Drang zum Stuhlgang"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "8bc48fd4-451f-44e8-a8b5-e711f921a42a",
                                "sense_id": "45160320-1953-3e5e-bb2d-df7ea139372a",
                                "text": "„Über eine Aktivierung des dort lokalisierten Darm-Nervensystems (enterisches Nervensystem) erschlafft der innere Schließmuskel, der Tonus des äußeren Schließmuskels wird erhöht und der Stuhldrang ausgelöst.“"
                            },
                            {
                                "example_id": "6bfc1b75-49ed-4cdb-a251-98b2ab8a7d33",
                                "sense_id": "45160320-1953-3e5e-bb2d-df7ea139372a",
                                "text": "„Der Stuhldrang kann willentlich unterdrückt werden; der Stuhl (Faeces) verbleibt im Rectum, das sich dem größeren Volumen anpasst (bis ca. 2 l).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
