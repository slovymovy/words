{
    "word_family": [
        "голосовать",
        "голосование",
        "отголосок",
        "безголосый",
        "голосистый",
        "многоголосие",
        "согласие",
        "разногласие",
        "гласный",
        "согласный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd1c8b9a-7144-31bb-b449-063e578bcc99",
                    "sense_definition": "Звуки, которые человек издаёт ртом при разговоре, крике, смехе или плаче.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sound_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я услышал знакомый <w>голос</w> в соседней комнате.",
                            "target_lang_translations": {
                                "en": "I heard a familiar <w>voice</w> in the next room.",
                                "zh": "我听见隔壁房间里有一个熟悉的<w>声音</w>。"
                            }
                        },
                        {
                            "text": "Учитель попросил ученика не повышать <w>голос</w> во время урока.",
                            "target_lang_translations": {
                                "en": "The teacher asked the student not to raise his <w>voice</w> during the lesson.",
                                "zh": "老师让那个学生上课时不要提高<w>声音</w>。"
                            }
                        },
                        {
                            "text": "Её тихий <w>голос</w> успокоил плачущего ребёнка.",
                            "target_lang_translations": {
                                "en": "Her quiet <w>voice</w> calmed the crying child.",
                                "zh": "她轻柔的<w>声音</w>让哭泣的孩子平静了下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "глас"
                    ],
                    "common_phrases": [
                        "громкий голос",
                        "тихий голос",
                        "повысить голос",
                        "потерять голос",
                        "знакомый голос"
                    ],
                    "target_lang_definitions": {
                        "en": "Sounds produced by a person's mouth when speaking, shouting, laughing, or crying.",
                        "zh": "人说话、喊叫、笑或哭时从口中发出的声音。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "sound produced by a person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声音",
                                "target_lang_sense_clarification": "人说话、喊叫、哭笑时发出的声音"
                            },
                            {
                                "target_lang_word": "嗓音",
                                "target_lang_sense_clarification": "人的嗓子发出的声音，偏重音质音色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b50efc6-7d8e-350e-9b03-832f0d1d1816",
                    "sense_definition": "Способность петь чисто, красиво и сильно; качество звучания при пении.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этой певицы удивительно сильный и красивый <w>голос</w>.",
                            "target_lang_translations": {
                                "en": "This singer has a surprisingly strong and beautiful <w>voice</w>.",
                                "zh": "这位歌手的<w>嗓音</w>强劲又优美。"
                            }
                        },
                        {
                            "text": "Он очень любит петь в караоке, хотя у него совсем нет <w>голоса</w>.",
                            "target_lang_translations": {
                                "en": "He loves singing karaoke, even though he has no <w>voice</w> at all.",
                                "zh": "他很喜欢唱卡拉OK，虽然他根本没有<w>歌喉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "красивый голос",
                        "нет голоса",
                        "поставить голос",
                        "сорвать голос"
                    ],
                    "target_lang_definitions": {
                        "en": "The ability to sing clearly, beautifully, and strongly; the quality of sound when singing.",
                        "zh": "指清晰、优美、有力地唱歌的能力，或歌唱时声音的质量。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "singing ability"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嗓音",
                                "target_lang_sense_clarification": "歌唱时的声音条件或音质"
                            },
                            {
                                "target_lang_word": "歌喉",
                                "target_lang_sense_clarification": "指唱歌的能力，常用于“有/没有歌喉”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bebd378c-9f36-3c42-a06d-ae824d27f841",
                    "sense_definition": "Мнение или решение участника выборов или собрания; право участвовать в таком решении.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "political",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На выборах новый президент получил большинство <w>голосов</w>.",
                            "target_lang_translations": {
                                "en": "In the election, the new president received the majority of <w>votes</w>.",
                                "zh": "新总统在选举中获得了多数<w>选票</w>。"
                            }
                        },
                        {
                            "text": "Каждый гражданин страны старше восемнадцати лет имеет право <w>голоса</w>.",
                            "target_lang_translations": {
                                "en": "Every citizen of the country over eighteen has the right to <w>vote</w>.",
                                "zh": "年满十八岁的每个公民都享有<w>投票权</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "право голоса",
                        "отдать свой голос",
                        "подсчёт голосов",
                        "большинство голосов"
                    ],
                    "target_lang_definitions": {
                        "en": "An opinion or decision of a participant in an election or meeting; the right to participate in such a decision.",
                        "zh": "选举或会议参加者表示意见的一票，或参与这种决定的权利。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vote",
                                "target_lang_sense_clarification": "in an election"
                            },
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "right to express an opinion"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选票",
                                "target_lang_sense_clarification": "选举或表决中的一票、票数"
                            },
                            {
                                "target_lang_word": "投票权",
                                "target_lang_sense_clarification": "参加投票或表决的权利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9f0f491-0930-3438-a335-04a810475f76",
                    "sense_definition": "Внутреннее чувство или убеждение, которое подсказывает человеку, как поступить.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В трудной ситуации нужно успокоиться и слушать <w>голос</w> разума.",
                            "target_lang_translations": {
                                "en": "In a difficult situation, you need to calm down and listen to the <w>voice</w> of reason.",
                                "zh": "在困难的时候，需要冷静下来，听从理智的<w>声音</w>。"
                            }
                        },
                        {
                            "text": "Его мучил <w>голос</w> совести после того, как он обманул своего друга.",
                            "target_lang_translations": {
                                "en": "The <w>voice</w> of conscience tormented him after he deceived his friend.",
                                "zh": "欺骗朋友之后，良心的<w>声音</w>一直折磨着他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "голос совести",
                        "голос разума",
                        "внутренний голос",
                        "голос сердца"
                    ],
                    "target_lang_definitions": {
                        "en": "An inner feeling or conviction that tells a person how to act.",
                        "zh": "指引人如何行动的内在感觉、理智或信念。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "internal guidance or feeling"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声音",
                                "target_lang_sense_clarification": "比喻内心在指引自己该怎么做的“声音”"
                            },
                            {
                                "target_lang_word": "心声",
                                "target_lang_sense_clarification": "内心真实的想法或感受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a29643a4-1dad-3156-b12d-75945b92d60b",
                    "sense_definition": "Высказанное мнение, суждение или требование группы людей.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Политики должны внимательно слушать <w>голос</w> народа.",
                            "target_lang_translations": {
                                "en": "Politicians must listen carefully to the <w>voice</w> of the people.",
                                "zh": "政治人物必须认真倾听人民的<w>声音</w>。"
                            }
                        },
                        {
                            "text": "Критики в один <w>голос</w> хвалили новый фильм режиссёра.",
                            "target_lang_translations": {
                                "en": "Critics praised the director's new film with one <w>voice</w>.",
                                "zh": "评论家们的<w>一致意见</w>是称赞这位导演的新电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мне́ние"
                    ],
                    "common_phrases": [
                        "в один голос",
                        "голос народа",
                        "голос критики"
                    ],
                    "target_lang_definitions": {
                        "en": "The expressed opinion, judgment, or demand of a group of people.",
                        "zh": "一个群体公开表达出来的意见、判断或要求。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "collective opinion"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声音",
                                "target_lang_sense_clarification": "群体表达出的意见、诉求或立场"
                            },
                            {
                                "target_lang_word": "一致意见",
                                "target_lang_sense_clarification": "大家一致表达的看法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "858162f4-43f8-37fe-9e30-b9f2588550b2",
                    "sense_definition": "Звук, который издают природные явления, музыкальные инструменты или механизмы.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В ночной тишине был слышен только таинственный <w>голос</w> ветра.",
                            "target_lang_translations": {
                                "en": "In the silence of the night, only the mysterious <w>voice</w> of the wind could be heard.",
                                "zh": "在夜晚的寂静中，只听得见风神秘的<w>声音</w>。"
                            }
                        },
                        {
                            "text": "Старая скрипка имела свой неповторимый и живой <w>голос</w>.",
                            "target_lang_translations": {
                                "en": "The old violin had its own unique and lively <w>voice</w>.",
                                "zh": "那把老小提琴有着独特而鲜活的<w>音色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "голос природы",
                        "голос моря"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A sound produced by natural phenomena, musical instruments, or mechanisms.",
                        "zh": "自然现象、乐器或机械发出的声音，常用于文学性表达。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "sound of nature or objects"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声音",
                                "target_lang_sense_clarification": "自然现象或事物发出的声音，常带文学色彩"
                            },
                            {
                                "target_lang_word": "音色",
                                "target_lang_sense_clarification": "乐器等发出的独特音质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "412657af-4034-364d-b2e7-ef7db95fd2d9",
                    "sense_definition": "Отдельная мелодическая линия или партия в музыкальном произведении.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В школьном хоре мне поручили вести второй <w>голос</w>.",
                            "target_lang_translations": {
                                "en": "In the school choir, I was assigned to sing the second <w>voice</w>.",
                                "zh": "在学校合唱团里，我被安排唱第二<w>声部</w>。"
                            }
                        },
                        {
                            "text": "Композитор написал сложную фугу для четырёх <w>голосов</w>.",
                            "target_lang_translations": {
                                "en": "The composer wrote a complex fugue for four <w>voices</w>.",
                                "zh": "作曲家写了一首复杂的四<w>声部</w>赋格曲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "вести голос",
                        "первый голос",
                        "второй голос"
                    ],
                    "target_lang_definitions": {
                        "en": "A separate melodic line or part in a musical work.",
                        "zh": "音乐作品中单独的一条旋律线或演唱、演奏部分。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "musical line"
                            },
                            {
                                "target_lang_word": "part",
                                "target_lang_sense_clarification": "in a musical composition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声部",
                                "target_lang_sense_clarification": "音乐作品中独立的一条旋律线或一个部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c4ca863-1de1-31d3-967c-333ebe6c7072",
                    "sense_definition": "Западные радиостанции, вещавшие на территорию СССР.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_radio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По вечерам отец настраивал приёмник, чтобы слушать вражеские <w>голоса</w>.",
                            "target_lang_translations": {
                                "en": "In the evenings, father tuned the receiver to listen to enemy <w>voices</w>.",
                                "zh": "傍晚父亲会调收音机，听所谓的<w>敌台</w>。"
                            }
                        },
                        {
                            "text": "В то время новости узнавали, слушая сквозь помехи различные <w>голоса</w>.",
                            "target_lang_translations": {
                                "en": "At that time, people learned the news by listening to various <w>voices</w> through the static.",
                                "zh": "那时候，人们常在杂音干扰中收听各种<w>境外电台</w>来了解新闻。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "слушать голоса",
                        "вражеские голоса"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Soviet era context"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Western radio stations that broadcasted to the territory of the USSR.",
                        "zh": "指曾向苏联境内广播的西方电台，是苏联时期的说法。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voice",
                                "target_lang_sense_clarification": "foreign radio broadcast"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "境外电台",
                                "target_lang_sense_clarification": "指向苏联境内播送节目的外国广播电台"
                            },
                            {
                                "target_lang_word": "敌台",
                                "target_lang_sense_clarification": "苏联语境中的俗称，指“敌对”的外国广播电台"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}