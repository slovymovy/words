                        "examples": [
                            {
                                "example_id": "d7348281-264b-4f8e-9e55-e965b56c60ab",
                                "sense_id": "48ad9d88-4a36-3150-a37f-62e8743ca0a9",
                                "text": "Een kwarteeuw geleden was dat nog niet zo."
                            },
                            {
                                "example_id": "7e2d6b62-ef2c-4adf-98e1-b401a38a1ed0",
                                "sense_id": "48ad9d88-4a36-3150-a37f-62e8743ca0a9",
                                "text": "Op 21 mei maakte de krant 'de beste Amerikaanse roman' van de afgelopen kwarteeuw bekend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b797dc14-736b-400d-8f62-32e048d0a592",
                        "source_entry_id": "b8291c48-b3f1-32c0-8560-16284b6e16f3",
                        "source_sense_id": "48ad9d88-4a36-3150-a37f-62e8743ca0a9",
                        "source_sense_description": "een tijdsperiode van 25 jaar",
                        "target_lang_word": "Vierteljahrhundert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vierteljahrhundert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d57c17c1-0e69-3f41-b601-f8f685e9c204",
                                        "entry_id": "bf7c68a4-a1bf-37b5-aa92-f2f795cf4d14",
                                        "glosses": [
                                            "Zeitraum von 25 Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148490e8-0418-4aec-9492-6325699bb6fe",
                                                "sense_id": "d57c17c1-0e69-3f41-b601-f8f685e9c204",
                                                "text": "„In seinem vollen Umfang blieb der Bericht bis ins Jahr 2001 geheim; sein Vorwort jedoch wurde bereits ein Vierteljahrhundert früher veröffentlicht.“"
                                            },
                                            {
                                                "example_id": "1255fd95-8e83-4e59-974f-75885a285807",
                                                "sense_id": "d57c17c1-0e69-3f41-b601-f8f685e9c204",
                                                "text": "„Er war seit einem Vierteljahrhundert ein persönlicher Gegner des Kaisers und seiner Regierung, hatte sich aber in den ersten Kriegswochen zunächst mit Verve für einen Siegfrieden eingesetzt.“"
                                            },
                                            {
                                                "example_id": "78327c4f-f471-4474-b09c-2a66de333de2",
                                                "sense_id": "d57c17c1-0e69-3f41-b601-f8f685e9c204",
                                                "text": "„Damals war Tóvó ein verwahrloster Bursche gewesen, und seit 1857 oder 1858 war er, soweit Obram wusste, ein Vierteljahrhundert nicht mehr auf den Färöern gewesen.“"
                                            },
                                            {
                                                "example_id": "b0b7ebd7-75c5-41a9-9746-9176c2394026",
                                                "sense_id": "d57c17c1-0e69-3f41-b601-f8f685e9c204",
                                                "text": "„Das lähmt sie, weil es nämlich ein Vierteljahrhundert her ist, seit sie sich zuletzt ganz in einem Spiegel gesehen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
