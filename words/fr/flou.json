                },
                {
                    "sense_id": "3dcefdf0-92cb-3338-bd6d-e24604b923b5",
                    "sense_definition": "Qui manque de clarté ou de précision, difficile à cerner par l'esprit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les explications données par le directeur restent très <w>floues</w> pour l'ensemble du personnel.",
                            "target_lang_translations": {
                                "en": "The director's explanations remain very <w>vague</w> to the entire staff.",
                                "ru": "Объяснения директора для всего персонала так и остаются очень <w>неясными</w>.",
                                "de": "Die Erklärungen des Direktors bleiben für die gesamte Belegschaft sehr <w>unklar</w>.",
                                "es": "Las explicaciones que dio el director siguen siendo muy <w>confusas</w> para todo el personal.",
                                "zh": "经理的解释对全体员工来说仍然很<w>含糊</w>。"
                            }
                        },
                        {
                            "text": "J'ai un souvenir assez <w>flou</w> de cette fête qui a eu lieu il y a dix ans.",
                            "target_lang_translations": {
                                "en": "I have a rather <w>hazy</w> memory of that party, which took place ten years ago.",
                                "ru": "У меня довольно <w>смутное</w> воспоминание о той вечеринке, которая состоялась десять лет назад.",
                                "de": "Ich habe eine ziemlich <w>verschwommene</w> Erinnerung an diese Feier, die vor zehn Jahren stattfand.",
                                "es": "Tengo un recuerdo bastante <w>vago</w> de esa fiesta, que tuvo lugar hace diez años.",
                                "zh": "我对十年前那场聚会的记忆有些<w>模糊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confus",
                        "imprécis",
                        "incertain",
                        "nébuleux",
                        "vague"
                    ],
                    "antonyms": [
                        "clair",
                        "net",
                        "précis"
                    ],
                    "common_phrases": [
                        "idées floues",
                        "souvenir flou",
                        "réponse floue"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking clarity or precision, hard for the mind to grasp.",
                        "ru": "Лишённый ясности или точности, с трудом поддающийся осмыслению.",
                        "de": "Ohne Klarheit oder Präzision, vom Verstand kaum zu erfassen.",
                        "es": "Que carece de claridad o precisión y resulta difícil de entender.",
                        "zh": "不够清楚或不够准确，让人难以理解或把握的。"
                    },
