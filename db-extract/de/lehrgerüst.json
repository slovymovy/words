                "senses": [
                    {
                        "sense_id": "b372525e-2393-3924-862e-4270bc4c0cc9",
                        "entry_id": "eea39be2-d172-3f17-a609-a5fcbb38ffe8",
                        "glosses": [
                            "ein stützendes Hilfsgerüst beim Bau von Bogen und Gewölben, das nach Fertigstellung des Bauwerkes entfernt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2cbe33-8d02-48c4-92c8-33b7262684ea",
                                "sense_id": "b372525e-2393-3924-862e-4270bc4c0cc9",
                                "text": "„Bei der Errichtung eines Kreuzrippengewölbes werden die Rippensteine auf das Lehrgerüst aufgesetzt und die Fugen mit Mörtel verstrichen.“"
                            },
                            {
                                "example_id": "3fbb472b-226e-47f8-9405-669e09f2fb7a",
                                "sense_id": "b372525e-2393-3924-862e-4270bc4c0cc9",
                                "text": "„Das Lehrgerüst legt die Form des zu konstruierenden Bauteils fest, es wird nach Fertigstellung desselben abgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
