    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c1dcdee9-7b85-3aba-9722-cf7ec11f7a2c",
                "word": "Antarctica",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                        "entry_id": "c1dcdee9-7b85-3aba-9722-cf7ec11f7a2c",
                        "glosses": [
                            "The southernmost continent, south of the Southern Ocean, containing the South Pole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463a2e0a-12b2-4d67-ba4f-bd1e4070cbed",
                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                "text": "The five largest islands or peninsulas in which the crests of the World Ridges break through the uniform covering of the hydrosphere are termed continents, and designated by the names Eurasia, Africa, North America, South America, and Australia. They are distinguished from other islands and peninsulas by size alone, Australia being ten times larger than New Guinea, and Africa ten times larger than Arabia, these being the greatest island and peninsula not called continents. The elevated region round the South Pole is crowned by the unexplored and scarcely discovered continent of Antarctica."
                            },
                            {
                                "example_id": "849f3fa2-96e6-445b-8293-c562edaca63c",
                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                "text": "Dr. Murray believes that Alexander I. Land is a part of the west coast of Graham's Land, and that this landmass, which Biscoe and Larsen proved to widen rapidly toward the south, is only a peninsula of the continent of Antarctica."
                            },
                            {
                                "example_id": "61972939-c339-49ea-acf3-329fa6aaaff7",
                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                            },
                            {
                                "example_id": "1d562633-f521-4b92-99a3-1b4993abc3fb",
                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                "text": "The project poses exceptional challenges, given that Antarctica is the coldest, windiest and driest continent on Earth, as well as the most remote and inaccessible, being almost totally covered by a vast ice sheet."
                            }
                        ]
                    },
