                                        "entry_id": "1df0a50f-4ac3-3f1c-8109-ea1cbdd21c3d",
                                        "glosses": [
                                            "Discipline qui étudie le devenir du principe actif d'un médicament dans l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa577e6f-2243-4d1b-99a4-8444b1026390",
                                                "sense_id": "2b883406-7237-3f61-9c91-20c623bba7b2",
                                                "text": "La pharmacocinétique des médicaments est l’étude de leur absorption, de leur distribution, de leur métabolisme et de leur excrétion dans l’organisme."
                                            }
                                        ]
                                    }
                                ]
                            },
