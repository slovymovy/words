{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "597e26f2-814a-311b-b28d-a6911a4484f8",
                    "sense_definition": "To cause continuing anger, irritation, or bitterness in someone's mind",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His rude comment continued to <w>rankle</w> in my mind long after the meeting ended. ",
                            "target_lang_translations": {
                                "de": "Sein unhöflicher Kommentar <w>wurmte</w> mich noch lange nach dem Ende des Treffens."
                            }
                        },
                        {
                            "text": "Her unfair remark about my work continues to <w>rankle</w> with me.",
                            "target_lang_translations": {
                                "de": "Ihre ungerechte Bemerkung über meine Arbeit <w>nagst</w> weiterhin an mir."
                            }
                        }
                    ],
                    "synonyms": [
                        "embitter",
                        "irritate"
                    ],
                    "common_phrases": [
                        "rankle with me",
                        "rankle in my mind"
                    ],
                    "target_lang_definitions": {
                        "de": "Anhaltenden Ärger, Reizung oder Bitterkeit bei jemandem hervorrufen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wurmen",
                                "target_lang_sense_clarification": "anhaltend im Gedächtnis schmerzen oder ärgern"
                            },
                            {
                                "target_lang_word": "kränken",
                                "target_lang_sense_clarification": "emotional verletzen und Bitterkeit zurücklassen"
                            },
                            {
                                "target_lang_word": "nagen",
                                "target_lang_sense_clarification": "gefühlsam schmerzen oder belasten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b5bc8c-b41a-3e1c-8822-5453c6517727",
                    "sense_definition": "To become inflamed, sore, or festered (of a physical wound or condition)",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper care, the deep cut began to <w>rankle</w> and inflame.",
                            "target_lang_translations": {
                                "de": "Ohne angemessene Pflege begann der tiefe Schnitt zu <w>eitern</w> und sich zu entzünden."
                            }
                        },
                        {
                            "text": "The splinter was left untreated and started to <w>rankle</w> in his finger.",
                            "target_lang_translations": {
                                "de": "Der Splitter wurde unbehandelt gelassen und begann sich in seinem Finger zu <w>entzünden</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to physical festering of wounds"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich entzünden, eitern oder schmerzen (von einer körperlichen Wunde)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "eitern",
                                "target_lang_sense_clarification": "eine Infektion entwickeln"
                            },
                            {
                                "target_lang_word": "sich entzünden",
                                "target_lang_sense_clarification": "schmerzhaft anschwellen und rot werden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe139dd0-d061-3a5e-8aba-48268dfb6122",
                    "sense_definition": "A source of persistent bitterness or irritation; a festering soreness or resentment",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old feud left a deep <w>rankle</w> in his heart that never fully healed.",
                            "target_lang_translations": {
                                "de": "Die alte Fehde hinterließ einen tiefen <w>Groll</w> in seinem Herzen, der nie vollständig heilte."
                            }
                        },
                        {
                            "text": "His harsh words left a lasting <w>rankle</w> that damaged their friendship for years.",
                            "target_lang_translations": {
                                "de": "Seine harten Worte hinterließen einen bleibenden <w>Stachel</w>, der ihre Freundschaft jahrelang schädigte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare noun usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Quelle anhaltender Bitterkeit oder Verbitterung; eine schwärende Groll"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Groll",
                                "target_lang_sense_clarification": "tief sitzender, anhaltender Ärger"
                            },
                            {
                                "target_lang_word": "Stachel",
                                "target_lang_sense_clarification": "anhaltend schmerzende Verletzung im übertragenen Sinne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}