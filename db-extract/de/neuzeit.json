                        "form": "der Neuzeit"
                    },
                    {
                        "form_id": "bd894288-978d-4405-864a-fada48ccc227",
                        "entry_id": "380080e8-9c4b-3fb2-ad2d-067f277bc175",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Neuzeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2b60008-e14c-377e-9fdf-fef4a8e0f3f0",
                        "entry_id": "380080e8-9c4b-3fb2-ad2d-067f277bc175",
                        "glosses": [
                            "geschichtliche Epoche, die im 16. Jahrhundert begann und bis heute andauert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d452d61f-f4ae-4aec-a157-aeea567a341d",
                                "sense_id": "c2b60008-e14c-377e-9fdf-fef4a8e0f3f0",
                                "text": "Die Geschichte wird in die drei Epochen Antike, Mittelalter und Neuzeit eingeteilt."
                            },
                            {
                                "example_id": "7adbb616-09a4-4b7e-b55d-5ca7a4f76d66",
                                "sense_id": "c2b60008-e14c-377e-9fdf-fef4a8e0f3f0",
                                "text": "Die Reformation war in der frühen Neuzeit."
                            },
                            {
                                "example_id": "72a0161f-a04f-409d-8281-366af930df31",
                                "sense_id": "c2b60008-e14c-377e-9fdf-fef4a8e0f3f0",
                                "text": "„Beide Bergnamen sind auch in der Neuzeit als Symbolbegriffe hochgesteckter Ziele und Erwartungen geläufig geblieben.“"
                            },
                            {
                                "example_id": "e3992b92-cd7c-4d02-abd4-65a97e7d9ace",
                                "sense_id": "c2b60008-e14c-377e-9fdf-fef4a8e0f3f0",
                                "text": "„Als Essbesteck kommt sie erst in der frühen Neuzeit auf, wo man am französischen Hof gern klebriges Obst aß.“"
                            },
                            {
                                "example_id": "8a43f744-adcb-4236-a7a5-6ede28f14f2f",
                                "sense_id": "c2b60008-e14c-377e-9fdf-fef4a8e0f3f0",
                                "text": "„Der junge Studiosus wagte es, sich in eine Diskussion einzuschalten, die die größten Metaphysiker der Neuzeit, Descartes und Leibniz, entzweit hatte.“"
                            },
                            {
                                "example_id": "ef99d671-6ce9-452c-b4a1-9b4ef4c63d9d",
                                "sense_id": "c2b60008-e14c-377e-9fdf-fef4a8e0f3f0",
                                "text": "„Zu Beginn der Neuzeit, also im ausgehenden 14. Jahrhundert, entwickelte sich aus dem Mittelhochdeutschen nun die Frühphase des Neuhochdeutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
