                        "examples": [
                            {
                                "example_id": "cc0177e0-67f5-485e-859e-0fb4c613a9ec",
                                "sense_id": "c6d0b557-fd80-3504-9902-8b70789bf387",
                                "text": "Another alternative for dealing with customers who want an earlier promise date is to repromise existing customer orders. Say, for example, that the necessary material or capacity is not available to allow a change to the Master Production Schedule. One option is to take a customer order promised in, say, Week 3 and move it to Week 6, then promise the new customer order in Week 3."
                            },
                            {
                                "example_id": "524cc9bc-4d6e-4f11-9ec9-c080aaa148f1",
                                "sense_id": "c6d0b557-fd80-3504-9902-8b70789bf387",
                                "text": "Since there is no specific previous promise to repromise, de Vogüé proposed that it must refer to the earlier assurances by the novice that he was ready to observe the rule […]"
                            }
                        ]
