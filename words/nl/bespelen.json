                    "sense_definition": "muziek maken op een muziekinstrument",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn oma <w>bespeelt</w> elke dag de piano in de woonkamer.",
                            "target_lang_translations": {
