                "senses": [
                    {
                        "sense_id": "5d074392-4c46-3253-bf70-6fc8fb207359",
                        "entry_id": "45bd2569-124f-3572-b1e7-57ebf29063bd",
                        "glosses": [
                            "Qui peut vieillir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7eccc85-762c-4e5d-8c48-9c4aa85dcff7",
                                "sense_id": "5d074392-4c46-3253-bf70-6fc8fb207359",
                                "text": "M. Barbet estime que cette situation d'inégalité disparaîtrait du jour où les vins du Midi seront fermentés traditionnellement, c'est-à-dire seront, devenus « vieillissables »."
                            },
                            {
                                "example_id": "79e352f8-8755-44d7-ab59-0410f74a8ba0",
                                "sense_id": "5d074392-4c46-3253-bf70-6fc8fb207359",
                                "text": "Le vin blanc profitera encore de tous les avantages de la fermentation pure, continue de jour et de nuit, à température constante, et par conséquent lui aussi sera conservable, vieillissable et de grande qualité."
                            },
                            {
                                "example_id": "44235dd5-25db-4305-8239-65e222a2f1cd",
                                "sense_id": "5d074392-4c46-3253-bf70-6fc8fb207359",
                                "text": "[…] sa non-vieillissable enfance."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1680f02-e45f-3935-b900-66f168c9f386",
                        "entry_id": "45bd2569-124f-3572-b1e7-57ebf29063bd",
                        "glosses": [
                            "Qui perd ses caractéristiques mécaniques"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61223933-109f-4357-a15a-4e6a34af7417",
                                "sense_id": "c1680f02-e45f-3935-b900-66f168c9f386",
                                "text": "Mais encore faudrait-il s'entendre sur les conséquences d’un écrouissage sur un acier vieillissable et voir l’usage auquel il est destiné."
                            },
                            {
                                "example_id": "f575d512-fc56-489e-a805-ffa4b062028f",
                                "sense_id": "c1680f02-e45f-3935-b900-66f168c9f386",
                                "text": "Enfin, des aciers à très basse teneur en carbone, stabilisés au titane ou au niobium, non vieillissables, sont particulièrement bien adaptés à la galvanisation en continu avec skin-pass en ligne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1288912e-e1a0-46ec-b05f-0c097f36d6e6",
                        "source_entry_id": "45bd2569-124f-3572-b1e7-57ebf29063bd",
                        "target_lang_word": "ageable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ageable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11629f37-f828-3d29-b633-4e93fdd20231",
                                        "entry_id": "25749413-3afa-388a-b0af-ddd40eb5ce4d",
                                        "glosses": [
                                            "Capable of being aged; suitable for ageing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad4c899-1790-4dfc-b86f-4683dd2e9ec5",
                                                "sense_id": "11629f37-f828-3d29-b633-4e93fdd20231",
                                                "text": "An ageable wine with great character and poise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33cf2db4-0bc9-30b7-b311-632efd4dbdb6",
                                        "entry_id": "25749413-3afa-388a-b0af-ddd40eb5ce4d",
                                        "glosses": [
                                            "Getting on in years; fairly old."
                                        ],
                                        "tags": [
                                            "dated",
                                            "dialectal",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14247fb3-2b52-4b3f-9229-a13eca74b32e",
                                                "sense_id": "33cf2db4-0bc9-30b7-b311-632efd4dbdb6",
                                                "text": "They had no children, and they were getting to be up in years—“ageable” as Took described it."
                                            },
                                            {
                                                "example_id": "a649de65-7e15-437d-9be9-22f5a99341bc",
                                                "sense_id": "33cf2db4-0bc9-30b7-b311-632efd4dbdb6",
                                                "text": "She looked like an ageable woman but Wes was young and supple as a boy."
                                            },
                                            {
                                                "example_id": "7ff26f0b-4f3b-4247-87ea-5d7654fbda6d",
                                                "sense_id": "33cf2db4-0bc9-30b7-b311-632efd4dbdb6",
                                                "text": "I received your letter by the bearer, and in reply to it I have to state that my father is an ageable man now, and not able to attend to the time appointed by your Honour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
