                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfc16e7-7102-499b-b260-7e3236b81981",
                                                "sense_id": "c8847195-d07e-3992-a7d8-b6265cac9f83",
                                                "text": "In one of the Greek satirist Lucian's Dialogues of Courtesans, a conversation takes place between the hetaira Tryphaena and a young client named Charmides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "962c4249-d8c4-4e0a-ba4e-cdb02664012d",
                        "source_entry_id": "e4e01efd-c608-3f3b-a8c6-55f4739f52e3",
                        "source_sense_id": "df5478eb-6731-3c38-8a0a-c5adf6c2f0cd",
