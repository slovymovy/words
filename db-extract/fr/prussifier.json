                "senses": [
                    {
                        "sense_id": "497c26d8-fa13-3b4e-ae87-d2c666b7a72d",
                        "entry_id": "db34b31a-659c-3c6a-83b8-12f44663a543",
                        "glosses": [
                            "Rendre prussien, ou plus prussien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e5e48e4-f1e3-41b8-bbe7-f32e358e0859",
                                "sense_id": "497c26d8-fa13-3b4e-ae87-d2c666b7a72d",
                                "text": "En politique intérieure, il voudrait, dit-on, des auxiliaires plus « nationaux-libéraux », pour mieux prussifier l'empire allemand."
                            },
                            {
                                "example_id": "742d609d-ca07-49c3-a7b2-cabeb3e4d845",
                                "sense_id": "497c26d8-fa13-3b4e-ae87-d2c666b7a72d",
                                "text": "N'écoutez pas les mauvaises langues qui nous accusent de vous prussifier; vous ne serez pas des Prussiens, nous médiatiserons la Prusse, nous serons tous des Allemands."
                            }
                        ]
                    }
