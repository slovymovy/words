                            {
                                "example_id": "dd2298f1-2553-4be1-82e6-e57a05e46a44",
                                "sense_id": "d113106a-5103-36c4-b466-4211b42b1a13",
                                "text": "„In der nördlichen Nadel- und winterkahlen Laubwaldregion fand im Zug der Intensivierung der Forste eine Verschiebung der Waldflächen zugunsten des Nadelholzes statt.“"
                            },
                            {
                                "example_id": "6eb03236-df74-43d8-9db2-f24bfd784f78",
                                "sense_id": "d113106a-5103-36c4-b466-4211b42b1a13",
                                "text": "„Allein zwischen Anfang 2018 und 2021 ist die Waldfläche in Deutschland um fast fünf Prozent (501.000 Hektar) zurückgegangen, deutlich mehr als bislang angenommen.“"
                            }
                        ],
