                    {
                        "sense_id": "695e81c3-d68c-31ad-932a-98ec229ded96",
                        "entry_id": "da228f2d-adc6-3585-9e53-bfcc8debba44",
                        "glosses": [
                            "het behandelen van lucht om deze geschikter te maken voor een binnenklimaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc39fae9-7907-48c3-a749-f6c33a7dd528",
                                "sense_id": "695e81c3-d68c-31ad-932a-98ec229ded96",
                                "text": "Energiezuinige luchtbehandeling wordt gerealiseerd middels een warmtewiel, wat een rendement geeft van 85 procent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2471227-fd1e-41b1-ae3b-9814768ab01e",
                        "source_entry_id": "da228f2d-adc6-3585-9e53-bfcc8debba44",
                        "source_sense_id": "695e81c3-d68c-31ad-932a-98ec229ded96",
                        "target_lang_word": "Luftbehandlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftbehandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                        "entry_id": "4ec910d4-b4b5-3359-bf24-f6dd3c7a85d3",
                                        "glosses": [
                                            "technische Aufbereitung von belasteter Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36775345-033d-46a2-8672-e3e8c04cb5bf",
                                                "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                                "text": "„Je nach Luftbehandlung, wie Heizen, Kühlen, Be- oder Entfeuchtung wird unterschieden: lüftungstechnische Anlagen mit oder ohne zusätzliche Luftbehandlung, Teilklimaanlage, Klimaanlage.“"
                                            },
                                            {
                                                "example_id": "d51e25b9-e382-4ed0-8374-186547eb06b8",
                                                "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                                "text": "„Erstmalig mit einem eigenen Stand vertreten ist die spektakuläre Luftbehandlung plasmaNorm, die Fachleute der Spitzengastronomie kürzlich mit dem \"Innovationspreis in Gold\" auszeichneten.“"
                                            },
                                            {
                                                "example_id": "f4e82905-64ab-48e1-bed3-959ac3af1b8a",
                                                "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                                "text": "„Im Zusammenhang mit der Reihe DIN EN 14750 gibt es zwei weitere Normenreihen über Luftbehandlung in Schienenfahrzeugen, DIN EN 13129 bezüglich Fernverkehr und DIN EN 14813 über Führerräume.“"
                                            },
                                            {
                                                "example_id": "9fe66a4d-dad0-4a1b-913b-c37844cdfb32",
                                                "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                                "text": "„Im Falle von Pharmadule besteht eine typische Gerätekombination zur Luftbehandlung aus Bereichen mit Filtern (F7-F9- HEPA 13/14 im Spezialrahmen), Kühl- und Heizwärmetauschern, Ventilatoren und Dampfbefeuchtern.“"
                                            },
                                            {
                                                "example_id": "12e0a9e0-80c2-46ad-aee5-2bec60c25fe3",
                                                "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                                "text": "„Dezentrale Luftbehandlung ist vielfältig und bedeutet weit mehr als das einfache Beheizen eines Raumes: Heizen, Kühlen, Lüften, Fortführung der Abluft, Filtern der Zuluft: Edel ausgestattete Shops, Lebensmittelmärkte, Tennishallen oder Industriegebäude mit unterschiedlichsten Anforderungen - GEA MultiMAXX bietet Ihnen jeweils eine individuelle, optimierte Lösung.“"
                                            },
                                            {
                                                "example_id": "cd997baf-5a34-4ec4-98b9-ee23e84e9a2c",
                                                "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                                "text": "„Heraeus Noblelight hat zur ISH die Luftbehandlung mit Ozon erzeugenden UV-Lampen in Küchenablufthauben vorgestellt.“"
                                            },
                                            {
                                                "example_id": "fb20fc98-8537-4ee1-ab87-e62e23829eaa",
                                                "sense_id": "9de9fa4a-b70e-33ba-b3a4-f7854fe20d1e",
                                                "text": "„DIN EN 13129-1 Bahnanwendungen - Luftbehandlung in Schienenfahrzeugen des Fernverkehrs - Teil 1: Behaglichkeitsparameter; Deutsche Fassung EN 13129-1:2002“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
