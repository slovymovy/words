        "fr-extract.jsonl": [
            {
                "entry_id": "d7ade4ed-a240-3923-a7a5-5188355d3082",
                "word": "inobservation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4bcd5268-f358-4ba1-a710-5c90855e46a7",
                        "entry_id": "d7ade4ed-a240-3923-a7a5-5188355d3082",
                        "tags": [
                            "plural"
                        ],
                        "form": "inobservations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98c418de-2504-37c5-8725-3b39302d9a24",
                        "entry_id": "d7ade4ed-a240-3923-a7a5-5188355d3082",
                        "glosses": [
                            "Manque d’obéissance aux lois, aux règlements, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c2ce07-ebf2-4850-a1f1-2c166ff44875",
                                "sense_id": "98c418de-2504-37c5-8725-3b39302d9a24",
                                "text": "Quant au Feldwebel Franzën, c’était sa première faute, mais il lui promis le front russe à la prochaine inobservation du règlement, car il aurait dû en avertir la direction de la Gestapo au lieu de prendre sur lui de faire promener dans Lyon un détenu."
                            },
                            {
                                "example_id": "d50730a6-c19c-470a-8274-8b2a47d52c07",
                                "sense_id": "98c418de-2504-37c5-8725-3b39302d9a24",
                                "text": "L’inobservation de ces prescriptions étant punie de peines d’amende."
                            },
                            {
                                "example_id": "60dfbcd6-02f5-456e-b339-b21df9b48977",
                                "sense_id": "98c418de-2504-37c5-8725-3b39302d9a24",
                                "text": "L’inobservation des règles détruit la discipline."
                            },
                            {
                                "example_id": "41eaba72-c99d-4c7f-9e0a-6a4a7b606b8e",
                                "sense_id": "98c418de-2504-37c5-8725-3b39302d9a24",
                                "text": "L’inobservation des lois."
                            }
                        ]
                    },
                    {
                        "sense_id": "2680a929-eaa9-3ebe-995c-4a16b29a74bd",
                        "entry_id": "d7ade4ed-a240-3923-a7a5-5188355d3082",
                        "glosses": [
                            "Inexécution des promesses qu’on a faites, des engagements qu’on a contractés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f6ed2fd-3232-4d76-ae65-d842e25eb408",
                                "sense_id": "2680a929-eaa9-3ebe-995c-4a16b29a74bd",
                                "text": "L’inobservation des traités, d’une convention, d’un contrat."
                            },
                            {
                                "example_id": "14f8452e-e311-45f7-88f0-9d35ea743915",
                                "sense_id": "2680a929-eaa9-3ebe-995c-4a16b29a74bd",
                                "text": "L’inobservation d’une condition, d’une clause."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74d6c391-2fae-417c-909e-4c46532b009d",
                        "source_entry_id": "d7ade4ed-a240-3923-a7a5-5188355d3082",
                        "source_sense_description": "Manque d’obéissance aux lois, aux règlements, etc.",
                        "target_lang_word": "Nichtbeachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtbeachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81404f28-880e-3249-98ad-307bd801fa3f",
                                        "entry_id": "8bedad75-582c-3c81-9f6c-17b5382588c3",
                                        "glosses": [
                                            "das absichtsvolle Übergehen/ nicht Befolgen eines Vorschlags, einer Regel oder dergleichen oder einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4601ea5-f039-416c-a0ad-fdd2de9f07a3",
                                                "sense_id": "81404f28-880e-3249-98ad-307bd801fa3f",
                                                "text": "„Die Gemeinsame Geschäftsordnung der Bundesministerien sieht zwar vor, dass Gesetzentwürfe »grundsätzlich« dem Redaktionsstab Rechtssprache zur Prüfung vorzulegen sind, doch Sanktionen für die Nichtbeachtung dieser Vorschrift gibt es nicht.“"
                                            },
                                            {
                                                "example_id": "518e5ab6-3ac8-40c8-888d-fc4509e7d2d8",
                                                "sense_id": "81404f28-880e-3249-98ad-307bd801fa3f",
                                                "text": "„Bei Nichtbeachtung der AGB kann der betreffende Teilnehmer vom Kurs ausgeschlossen werden.“"
                                            },
                                            {
                                                "example_id": "be2fd330-81bb-4b96-afd5-7083f51f6fb1",
                                                "sense_id": "81404f28-880e-3249-98ad-307bd801fa3f",
                                                "text": "„Die Sprachwissenschaft hat sich, und das gilt bis heute, nicht nur selbst sprachkritischer Bekundungen weitgehend enthalten, sie steht diesen auch, wo immer sie von anderen geäußert werden, in kühler Distanziertheit bis snobistischer Nichtbeachtung gegenüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1358c278-c40c-4d48-80cd-6300d3edd181",
                        "source_entry_id": "d7ade4ed-a240-3923-a7a5-5188355d3082",
                        "source_sense_description": "Manque d’obéissance aux lois, aux règlements, etc.",
                        "target_lang_word": "Ignoranz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ignoranz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4777856-0c66-3448-840e-d28aaf1070c7",
                                        "entry_id": "7446d984-d54b-3d90-bb9f-94e5b36a49a2",
                                        "glosses": [
                                            "selbstverschuldete Unwissenheit, Beschränktheit"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9abb43d9-84e4-4ff1-b08f-285cf5887b31",
                                                "sense_id": "e4777856-0c66-3448-840e-d28aaf1070c7",
                                                "text": "„Ist das schon ein Zeichen von Demenz oder lediglich Ignoranz?“"
                                            },
                                            {
                                                "example_id": "5e015cc5-2bc8-49d3-af1f-4014c9890d2a",
                                                "sense_id": "e4777856-0c66-3448-840e-d28aaf1070c7",
                                                "text": "Diese Ignoranz ist nicht zu ertragen."
                                            },
                                            {
                                                "example_id": "e2a67cd8-9fa5-4a53-9b85-c4417013a907",
                                                "sense_id": "e4777856-0c66-3448-840e-d28aaf1070c7",
                                                "text": "„Da wird bei Mord an Wehrlosen das Motiv Rassismus ignoriert, und die Behörden agieren zwischen Ignoranz und Strafvereitelung im Amt.“"
                                            },
                                            {
                                                "example_id": "e452af9a-88c7-42d5-90e5-5023b728f17f",
                                                "sense_id": "e4777856-0c66-3448-840e-d28aaf1070c7",
                                                "text": "„Diese Form der Ignoranz – was ich nicht hören will, das höre ich auch nicht – konnte der Psychologe Drew Weston im Jahr 2004 sogar neurologisch nachweisen.“"
                                            },
                                            {
                                                "example_id": "f6446a69-b18c-44c1-81a9-8dbc526ce452",
                                                "sense_id": "e4777856-0c66-3448-840e-d28aaf1070c7",
                                                "text": "„Ich hatte es sozusagen gelernt, wie man Ignoranz mit Anmaßung aufzäumt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9e6015a-587b-3c08-90fa-cd509e4b0f95",
                                        "entry_id": "7446d984-d54b-3d90-bb9f-94e5b36a49a2",
                                        "glosses": [
                                            "das Ignorieren"
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
