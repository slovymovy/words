                ],
                "senses": [
                    {
                        "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                        "entry_id": "ab4800a4-512d-3946-a80d-600c36c508f2",
                        "glosses": [
                            "staatliche Maßnahmen, die überschuldete Kreditinstitute (= Banken) vor der Pleite, d.h. der Zahlungsunfähigkeit, bewahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a85d55c-2a20-47c0-935e-367d9287dc47",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Dabei wäre genug Geld [für gute Grundschulen] da. Nur fließt vieles eben in irgendwelche Bankenrettungen oder wird am Hindukusch verpulvert."
                            },
                            {
                                "example_id": "8dcd9bcc-857c-4085-a1fb-18ea39bbb777",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Ungewohnte Eintracht bei den deutschen Parteien: Von der FDP bis zur Linken reicht das Befürworter-Spektrum für das Milliardenpaket zur Bankenrettung."
                            },
                            {
                                "example_id": "30e8217c-cdc6-48f6-9c19-d15c69b94f92",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Im ganzen Land stagnierten viele Jahre lang die Einkommen. Im Westen fehlte Geld in den Kommunen und für Straßen. Geld zu finden zur Bankenrettung in der Eurokrise war dann aber kein Problem."
                            },
                            {
                                "example_id": "681dfe3f-8d35-4c09-8df9-1313a552135e",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Dass Bankenrettungen für den Steuerzahler teuer sind, dürfte in Europa allen klar sein. Das Transnational Institute (TNI) weist darauf hin, dass allein zwischen 2008 und 2015 die EU-Mitgliedsstaaten »mit Zustimmung und auf Anregung der europäischen Institutionen 747 Milliarden Euro« dafür ausgegeben haben."
                            },
                            {
                                "example_id": "736e5a48-e85c-4ddf-98ea-a03195c97dca",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Nach dem Crash 2008 wurden über eine Billion Euro in die Bankenrettung gesteckt."
                            },
                            {
                                "example_id": "372dfa11-f539-4abb-b5e0-b4a7fe914a1b",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Ohne Bail-in wird der Gläubiger in einer solchen Bankenrettung vor den Verlusten einer Insolvenz geschützt."
                            },
                            {
                                "example_id": "bd42f0be-4343-4030-9cf5-5689bfc9d9ba",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Nach dieser Erfahrung ist es mehr als vernünftig, wenn die Regierungen einen Plan entwerfen, wie Banken weitgehend ohne Steuergeld abgewickelt werden könnten. Ein solcher Plan ist auch ökonomisch richtig. Denn der Folgeschaden der letzten Bankenrettung wird schon bald sichtbar werden, und er besteht darin, dass die Investoren und Banken gelernt haben, dass der Staat am Ende einspringt, wenn eine Bankpleite droht."
                            },
                            {
                                "example_id": "7f8d042c-f89a-4813-8dc4-b9af38be40d2",
                                "sense_id": "b33abcb9-70ed-391b-8c5a-e5f4983d0259",
                                "text": "Wir müssen dafür sorgen, dass Bankenpleiten keine Finanzkrise auslösen und Bankenrettungen damit überflüssig werden. Banken müssen pleitegehen können!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
