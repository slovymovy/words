                ],
                "senses": [
                    {
                        "sense_id": "4c48d0df-5e2a-3f5b-a41e-e39afd2be849",
                        "entry_id": "56d75546-b45a-3de1-91ae-f312393b7ed5",
                        "glosses": [
                            "тонкий металлический (или стеклянный) лист с загнутыми краями для жарки или запекания чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ebf47c-5c11-455d-8a5d-54c1fd2e00b2",
                                "sense_id": "4c48d0df-5e2a-3f5b-a41e-e39afd2be849",
                                "text": "Один потрошит каплуна, другой делает из морковки звёздочки, третий, красный как кумач, суёт в печь противень."
                            },
                            {
                                "example_id": "801ac955-3aff-4512-88bd-2e254ec563ad",
                                "sense_id": "4c48d0df-5e2a-3f5b-a41e-e39afd2be849",
                                "text": "Также и жаркое, обмазав маслом и подлив 2-3 ложки воды, надо ставить его на противне сразу в горячую печь, чтобы обжарилось кругом."
                            }
                        ]
                    }
                ],
