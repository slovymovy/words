                                            {
                                                "example_id": "1d3b768f-8a3d-44fe-9281-36c8f5c91328",
                                                "sense_id": "34662298-6c33-384a-91e7-cab074196724",
                                                "text": "En revanche, si l’oisillon est malade, il peut être volontairement abandonné pour ne pas mettre le reste de la progéniture en danger."
                                            },
                                            {
                                                "example_id": "e346c740-2321-4cb1-9bd2-58a06b25c4ce",
                                                "sense_id": "34662298-6c33-384a-91e7-cab074196724",
                                                "text": "[…] : beaucoup de ses oisillons, privés des soins maternels, périssaient ; […]."
                                            }
                                        ]
                                    },
