                        "translation_id": "7ffe051e-be49-416c-809d-72f729f99442",
                        "source_entry_id": "878b75c8-4a2c-3631-a383-ec8d22a437a7",
                        "source_sense_id": "1c90edd3-7682-3cc4-b3b9-c7c2c6fbbbbb",
                        "source_sense_description": "van het weer dat het koud en vriezend is",
                        "target_lang_word": "frosty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frosty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9adc47b8-47aa-3d10-b753-5559b5221bfd",
                                        "entry_id": "f350221c-2f52-329b-84fc-168a3bd83f56",
                                        "glosses": [
                                            "Cold, chilly; icy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e2d58ca-3a58-446f-8518-fdc92022ef73",
                                                "sense_id": "9adc47b8-47aa-3d10-b753-5559b5221bfd",
                                                "text": "The air was frosty; I could see my breath and walked quickly with my hands in my pockets."
                                            },
                                            {
                                                "example_id": "3669024d-12bc-49b1-90e0-da4c68a63ea1",
                                                "sense_id": "9adc47b8-47aa-3d10-b753-5559b5221bfd",
                                                "text": "I'd like a frosty milkshake."
                                            },
                                            {
                                                "example_id": "007e8568-65f9-4f8f-a767-acacc7a33c2d",
                                                "sense_id": "9adc47b8-47aa-3d10-b753-5559b5221bfd",
                                                "text": "It was late at night and frosty[.]"
                                            },
                                            {
                                                "example_id": "36c1f432-34fd-4ea3-aa22-3695748bdf4f",
                                                "sense_id": "9adc47b8-47aa-3d10-b753-5559b5221bfd",
                                                "text": "During the frostiest days of the Cold War, avoiding the Soviet Bloc meant flying north around Greenland to Alaska, refueling in Anchorage, and then around the Bering Straits to reach Japan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fe7291a-39e5-37f2-ad8c-47ecc48331e0",
                                        "entry_id": "f350221c-2f52-329b-84fc-168a3bd83f56",
                                        "glosses": [
                                            "Having frost on it or in it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203d7ccc-5a27-485a-ba94-e70c505f7b8d",
                                                "sense_id": "5fe7291a-39e5-37f2-ad8c-47ecc48331e0",
                                                "text": "The frosty pumpkin is the sign of the end of the growing season, soon the greenery will wither and harvest end for the year."
                                            },
                                            {
                                                "example_id": "f34f14b7-11c2-41ae-a9d1-cc8aaa18b96a",
                                                "sense_id": "5fe7291a-39e5-37f2-ad8c-47ecc48331e0",
                                                "text": "The frosty beverage gave him a brain freeze."
                                            },
                                            {
                                                "example_id": "4e174f6d-dee7-449a-a5db-ac02c050cd89",
                                                "sense_id": "5fe7291a-39e5-37f2-ad8c-47ecc48331e0",
                                                "text": "In scented, frilly boutiques that she seemed to find by instinct, they exchanged her battered wardrobe for fur capes and Anna Karenina riding boots that slithered on the frosty cobble, and Pym's dismal school habit for a leather jacket and trousers without buttons for his braces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad8ec5b-6bd2-3477-a0a7-fa5343962073",
                                        "entry_id": "f350221c-2f52-329b-84fc-168a3bd83f56",
                                        "glosses": [
                                            "Having an aloof or inhospitable manner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "640f1df1-c8aa-4f85-8d3d-9dab00bc8714",
                                                "sense_id": "0ad8ec5b-6bd2-3477-a0a7-fa5343962073",
                                                "text": "After the divorce, she was civil but frosty to her ex."
                                            },
                                            {
                                                "example_id": "d82eb7a2-b159-4185-8765-9ccf8d29e7c6",
                                                "sense_id": "0ad8ec5b-6bd2-3477-a0a7-fa5343962073",
                                                "text": "Chilly from the start, she grows ever frostier as the book proceeds, partly because Mr. Martin has difficulty translating her sexual abandon to anything beyond “sexual due process.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
