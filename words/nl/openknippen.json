{
    "word_family": [
        "knippen",
        "openen",
        "inknippen",
        "afknippen",
        "uitknippen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c48d524-7b35-338e-be41-91b54e74d1d5",
                    "sense_definition": "Met een schaar of tang openmaken door te knippen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "openmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweer moest de auto <w>openknippen</w> om het slachtoffer te bevrijden.",
                            "target_lang_translations": {
                                "en": "The fire brigade had to <w>cut open</w> the car to rescue the victim."
                            }
                        },
                        {
                            "text": "Kun je de verpakking van de melk even voor mij <w>openknippen</w>?",
                            "target_lang_translations": {
                                "en": "Could you <w>cut open</w> the milk carton for me?"
                            }
                        }
                    ],
                    "synonyms": [
                        "openknippen"
                    ],
                    "antonyms": [
                        "dichtplakken"
                    ],
                    "common_phrases": [
                        "een verpakking openknippen",
                        "een auto openknippen"
                    ],
                    "target_lang_definitions": {
                        "en": "To open something by cutting it with scissors, shears, or cutters"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to cut open",
                                "target_lang_sense_clarification": "using scissors or cutters"
                            },
                            {
                                "target_lang_word": "to shear open",
                                "target_lang_sense_clarification": "using heavy-duty cutting tools, e.g., for vehicles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4f0bc68-5f92-3a96-b137-8740519df3bd",
                    "sense_definition": "Met een klikkend geluid plotseling openmaken of openspringen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "openmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>knipte</w> plechtig het slot van haar aktetas <w>open</w> om de documenten te pakken.",
                            "target_lang_translations": {
                                "en": "She solemnly <w>clicked open</w> the lock of her briefcase to get the documents."
                            }
                        },
                        {
                            "text": "Met een luide klik <w>knipte</w> de sluiting van de koffer <w>open</w>.",
                            "target_lang_translations": {
                                "en": "With a loud click, the clasp of the suitcase <w>snapped open</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het slot openknippen"
                    ],
                    "target_lang_definitions": {
                        "en": "To open or snap open with a clicking sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to click open",
                                "target_lang_sense_clarification": "making a clicking sound"
                            },
                            {
                                "target_lang_word": "to snap open",
                                "target_lang_sense_clarification": "opening suddenly with a sharp sound"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}