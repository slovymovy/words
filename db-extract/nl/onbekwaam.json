                "senses": [
                    {
                        "sense_id": "4a67221b-606f-3563-a15f-66d85b6d7d0f",
                        "entry_id": "ca4ce4e2-a673-3999-a718-861a22ca447e",
                        "glosses": [
                            "niet in staat om bepaalde taken of functies goed uit te voeren"
                        ],
                        "tags": [
                            "van een persoon"
                        ],
                        "examples": [
                            {
                                "example_id": "270eb8af-dfd2-4c77-ae77-2b1881a346d4",
                                "sense_id": "4a67221b-606f-3563-a15f-66d85b6d7d0f",
                                "text": "Maar zoals het er nu voor stond, moesten ze dus wachten tot die onbekwame zakenman zijn schaapjes op het droge had? Dan liepen ze het risico dat ze lang moesten wachten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b4d5b15-14a5-4b40-baa2-1701cbfe9ab0",
                        "source_entry_id": "ca4ce4e2-a673-3999-a718-861a22ca447e",
                        "source_sense_id": "4a67221b-606f-3563-a15f-66d85b6d7d0f",
                        "target_lang_word": "incompetent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incompetent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3cf8ecc-f431-3bb0-897f-82e687570ff4",
                                        "entry_id": "ca5d4bec-d301-3d34-a252-23b70833b303",
                                        "glosses": [
                                            "Lacking the degree of ability and responsibility necessary to do a task successfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59da3ba9-c425-4196-b69f-7680cc14fcb2",
                                                "sense_id": "b3cf8ecc-f431-3bb0-897f-82e687570ff4",
                                                "text": "Near-synonyms: incapable, inable, unable"
                                            },
                                            {
                                                "example_id": "23a42762-faed-4375-89ef-40e6ef54e930",
                                                "sense_id": "b3cf8ecc-f431-3bb0-897f-82e687570ff4",
                                                "text": "Having an incompetent lawyer may be grounds for a retrial, but the lawyer in question probably doesn't know that."
                                            },
                                            {
                                                "example_id": "387fb129-0bd4-4786-bbcb-088c2cb0ac6d",
                                                "sense_id": "b3cf8ecc-f431-3bb0-897f-82e687570ff4",
                                                "text": "Many Gazans scorn Fatah as corrupt and incompetent, and they dislike Hamas's overzealousness and repression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6343bd88-0ba0-3e68-b656-4b86ca902540",
                                        "entry_id": "ca5d4bec-d301-3d34-a252-23b70833b303",
                                        "glosses": [
                                            "Lacking the degree of ability and responsibility necessary to do a task successfully.",
                                            "Unable to make rational decisions; insane or otherwise cognitively impaired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ab71b9-8e39-4831-893c-11787e92fe97",
                                                "sense_id": "6343bd88-0ba0-3e68-b656-4b86ca902540",
                                                "text": "The charged was judged incompetent to stand trial, at least until his medication started working."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9761c069-b3b6-3aa5-8e3c-963baeb579f8",
                                        "entry_id": "ca5d4bec-d301-3d34-a252-23b70833b303",
                                        "glosses": [
                                            "Lacking the degree of ability and responsibility necessary to do a task successfully.",
                                            "Opening too early during pregnancy, resulting in miscarriage or premature birth."
                                        ],
                                        "tags": [
                                            "of the cervix"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccebd98a-7874-48ce-b5d4-0bdb8d9b1666",
                                                "sense_id": "9761c069-b3b6-3aa5-8e3c-963baeb579f8",
                                                "text": "Near-synonyms: dysfunctional, nonfunctioning"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6a0871-c983-35f6-bd6c-0ef0cfe08ed8",
                                        "entry_id": "ca5d4bec-d301-3d34-a252-23b70833b303",
                                        "glosses": [
                                            "Lacking the degree of ability and responsibility necessary to do a task successfully.",
                                            "Not resistant to deformation or flow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "incompetent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a942ba-d37d-32e3-97cc-a080794a81fc",
                                        "entry_id": "eb331ab8-d46e-3f4f-9f09-0513778b1608",
                                        "glosses": [
                                            "A person who is incompetent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12dc58f-c9c6-4728-9f6b-f8210de3bc3a",
                                                "sense_id": "e0a942ba-d37d-32e3-97cc-a080794a81fc",
                                                "text": "But besides these incompetents, there was always a train of camp followers, —women who followed the camp, beggars, and criminals, whose number was often greater than the number of fighting soldiers."
                                            },
                                            {
                                                "example_id": "54a07805-aabf-47a0-a1cf-0c7aa336aa80",
                                                "sense_id": "e0a942ba-d37d-32e3-97cc-a080794a81fc",
                                                "text": "\"Lies!\" said the tallest of the sons of Ivaldi. \"I wouldn't trust those fumble-fingered incompetents to shoe a horse.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
