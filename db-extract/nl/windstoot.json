                "senses": [
                    {
                        "sense_id": "5e735cdb-445e-3768-bf6e-b11cca544c23",
                        "entry_id": "253dd4d1-febe-3204-a5f2-11abed653c66",
                        "glosses": [
                            "een plotselinge harde wind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bbe9960-3492-4922-9705-ad819b793ad2",
                                "sense_id": "5e735cdb-445e-3768-bf6e-b11cca544c23",
                                "text": "slagregens tijdens buien gaans soms samen met windstoten."
                            },
                            {
                                "example_id": "18ef2eb4-0c5b-4b15-8d91-4d8e267bb563",
                                "sense_id": "5e735cdb-445e-3768-bf6e-b11cca544c23",
                                "text": "Vanwege zware regen- en onweersbuien geldt voor Noord-Brabant, Limburg en Gelderland code tot 16.00 uur oranje. Het KNMI zegt dat er hier kans is op zware windstoten tussen de 75 en 100 kilometer per uur en hagelstenen van twee centimeter."
                            },
                            {
                                "example_id": "c3e97406-8d76-4ab8-8c28-85830233b478",
                                "sense_id": "5e735cdb-445e-3768-bf6e-b11cca544c23",
                                "text": "Het KNMI heeft voor morgenmiddag en -avond code oranje afgegeven voor het oosten en zuidoosten van het land. In Overijssel, Gelderland, Noord-Brabant en Limburg verwacht het weerinstituut in de middag zware onweersbuien. Daarbij is kans op zware windstoten van 75 tot 100 kilometer per uur en grote hagelstenen van 2 centimeter of groter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a734457-9239-483e-a3d7-399e48a4dfee",
                        "source_entry_id": "253dd4d1-febe-3204-a5f2-11abed653c66",
                        "source_sense_id": "5e735cdb-445e-3768-bf6e-b11cca544c23",
                        "target_lang_word": "Bö",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bö",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e2434e7-7388-3670-bc63-9a8640f7cfe0",
                                        "entry_id": "949d66be-d6f8-3bb1-8338-a4906d2c1c8b",
                                        "glosses": [
                                            "heftiger Windstoß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b021e6f-6c60-4d1b-9f8b-a5f347685b85",
                                                "sense_id": "2e2434e7-7388-3670-bc63-9a8640f7cfe0",
                                                "text": "Eine unvermutete Bö ließ ihre Jolle beinahe kentern."
                                            },
                                            {
                                                "example_id": "b68b5ba2-08a7-4748-b387-c992eb37f45b",
                                                "sense_id": "2e2434e7-7388-3670-bc63-9a8640f7cfe0",
                                                "text": "„Ab und zu kommt der Wind in Böen zurück, der Regen fällt schräg, schlägt an die Fensterscheiben wie Sand.“"
                                            },
                                            {
                                                "example_id": "6b966989-5edd-435e-8275-86db5ef2ac4b",
                                                "sense_id": "2e2434e7-7388-3670-bc63-9a8640f7cfe0",
                                                "text": "„In winzigen Böen, kaum erkennbar, kräuselte sich das Wasser und verlor seinen Spiegel, diesen tödlich-unbeweglichen Beispiegel.“"
                                            },
                                            {
                                                "example_id": "83dc5b3f-9949-40e2-a56d-02b6f1ea71b0",
                                                "sense_id": "2e2434e7-7388-3670-bc63-9a8640f7cfe0",
                                                "text": "„Ununterbrochen prasselte der Platzregen gegen die Felswand und Böen heulten um die Felsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b16819a3-88a9-4a84-af4d-aeee46c21908",
                        "source_entry_id": "253dd4d1-febe-3204-a5f2-11abed653c66",
                        "source_sense_id": "5e735cdb-445e-3768-bf6e-b11cca544c23",
                        "target_lang_word": "windflaw",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
