                "senses": [
                    {
                        "sense_id": "4056c349-7d24-314f-b80a-a310eb235e08",
                        "entry_id": "f2d1e2c1-8d94-3bcc-8c07-c0f626b53a3e",
                        "glosses": [
                            "устар. одежда из грубой, толстой ткани"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c52eb0-9715-482b-8331-386ab3f9989f",
                                "sense_id": "4056c349-7d24-314f-b80a-a310eb235e08",
                                "text": "А в окно ко мне вошёл босой старик, в белом рубище и с бородой седой."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fa0faa4-13d3-3899-b0ee-fac3695a8378",
                        "entry_id": "f2d1e2c1-8d94-3bcc-8c07-c0f626b53a3e",
                        "glosses": [
                            "перен. изношенная, ветхая одежда"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b8d7f8-791b-4a77-bbf3-503c222912c3",
                                "sense_id": "3fa0faa4-13d3-3899-b0ee-fac3695a8378",
                                "text": "Через пятнадцать лет я потащусь за ним в рубище, нищим, когда меня выпустят из острога."
                            }
                        ]
                    }
                ],
