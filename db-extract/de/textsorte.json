                "senses": [
                    {
                        "sense_id": "1c732c7f-39f3-374a-a6c7-29e573300660",
                        "entry_id": "b333fc3f-b1c5-3762-ab9e-4b77ce1448e6",
                        "glosses": [
                            "Menge von Texten, die in gleichartigen Situationen zustande kommen, gleiche Funktionen haben und gemeinsame Merkmale aufweisen"
                        ],
                        "tags": [
                            "Textlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "a754b10b-3add-4283-837b-7e71a64e05cc",
                                "sense_id": "1c732c7f-39f3-374a-a6c7-29e573300660",
                                "text": "Textsorten werden unter anderem danach definiert, unter welchen Situationsbedingungen sie zustande kommen. Die Textsorte „privates Telefonat“ lässt sich etwa mit den folgenden Situationsmerkmalen bestimmen: mündlich, gleichzeitig, kein Blickkontakt, örtlich getrennt, 2 Partner, nicht öffentlich."
                            },
                            {
                                "example_id": "a330faa5-2d19-4fcc-a68f-fcdb5c72e9e6",
                                "sense_id": "1c732c7f-39f3-374a-a6c7-29e573300660",
                                "text": "„Die Nominalisierung gehört zu den auffälligsten Entwicklungstendenzen der deutschen Gegenwartssprache; die einzelnen Textsorten haben daran unterschiedlichen Anteil.“"
                            },
                            {
                                "example_id": "03fe5bbf-d2e9-4265-89d3-2007f908b265",
                                "sense_id": "1c732c7f-39f3-374a-a6c7-29e573300660",
                                "text": "„Tatsache ist, dass unser aller Wissen über die Textsorte Wörterbuch diesem ein hohes Maß an Orientierungsleistung und Normativität zuschreibt.“"
                            },
                            {
                                "example_id": "05487f69-514e-433e-a536-e6b4f3f4c605",
                                "sense_id": "1c732c7f-39f3-374a-a6c7-29e573300660",
                                "text": "„Da die Texte von ihren Textsorten her stark variieren, soll hier eine kurze Textsortenbeschreibung erfolgen.“"
                            },
                            {
                                "example_id": "b9787356-63af-4263-b277-7bd4b0b58a46",
                                "sense_id": "1c732c7f-39f3-374a-a6c7-29e573300660",
                                "text": "„Es ist daher nicht mehr so gut nach Textsorten balanciert, liefert aber ein breiteres Bild von den tatsächlich genutzten Wörtern.“"
                            },
                            {
                                "example_id": "a11c153b-fb94-49d1-b343-ba02f71eb07e",
                                "sense_id": "1c732c7f-39f3-374a-a6c7-29e573300660",
                                "text": "„Im Anschluß an eine kommunikationsorientierte Text-Konzeption lassen sich die Textsorten als Sprachhandlungsschemata auffassen, die mit bestimmten Textmustern und -strategien jeweils spezifische Vermittlungsaufgaben erfüllen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
