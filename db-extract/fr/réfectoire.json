                        "translation_id": "5a4cd270-bdab-4e49-ad28-89dc37846ac5",
                        "source_entry_id": "a62cd4a5-f022-323f-9a24-2100ea9124bb",
                        "source_sense_id": "8423aff2-8502-3928-8230-3d3ef66fb734",
                        "source_sense_description": "Speisesaal, Speisezimmer",
                        "target_lang_word": "Speisesaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speisesaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c73dc4c4-72ef-3cfd-982b-545ea94e6468",
                                        "entry_id": "48b45527-ea93-34ae-a62b-8729f456aa79",
                                        "glosses": [
                                            "Raum, in dem eine größere Zahl Menschen speisen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2ad70d-b1fa-402c-9184-43ea4f381647",
                                                "sense_id": "c73dc4c4-72ef-3cfd-982b-545ea94e6468",
                                                "text": "„Im Speisesaal treffe ich einen jungen Deutschen, der in die Fremdenlegion eintreten will.“"
                                            },
                                            {
                                                "example_id": "4d6dfa06-38b0-4473-806e-bc35a4d7a2fa",
                                                "sense_id": "c73dc4c4-72ef-3cfd-982b-545ea94e6468",
                                                "text": "„Eine Weile stand sie unentschlossen an dem Fenster des Speisesaals und sah auf die regenfeuchte Wilhelmstraße hinaus.“"
                                            },
                                            {
                                                "example_id": "5f8e54da-5cc8-4d3f-86ce-723fa7a38137",
                                                "sense_id": "c73dc4c4-72ef-3cfd-982b-545ea94e6468",
                                                "text": "„Der Speisesaal wirkte eher wie eine Cafeteria.“"
                                            },
                                            {
                                                "example_id": "c50af71a-b9b4-4b95-9f89-ab18490c9aa7",
                                                "sense_id": "c73dc4c4-72ef-3cfd-982b-545ea94e6468",
                                                "text": "„Immer noch ein bißchen humpelnd betrat er den eleganten Speisesaal mit den glitzernden Kronleuchtern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "058f8fd3-63b7-4b7b-a42d-24776cef4e51",
                        "source_entry_id": "a62cd4a5-f022-323f-9a24-2100ea9124bb",
                        "source_sense_id": "8423aff2-8502-3928-8230-3d3ef66fb734",
                        "source_sense_description": "Speisesaal, Speisezimmer",
                        "target_lang_word": "Speisezimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speisezimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8f531e-bc15-3115-bd48-345e591b6677",
                                        "entry_id": "cfd3659d-527b-35b0-92ac-1122302f15c6",
                                        "glosses": [
                                            "mittelgroßer Raum, der vor allem für die Mahlzeiten vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de36c053-3c5e-4e4d-944d-ed42c9d7c78f",
                                                "sense_id": "ef8f531e-bc15-3115-bd48-345e591b6677",
                                                "text": "„Als er das Speisezimmer betrat, stand die ganze Gesellschaft an einem kleinen, mit Vorspeisen besetzten Tisch zwischen zwei Fenstern.“"
                                            },
                                            {
                                                "example_id": "751e0910-cf7e-4596-9dc8-f652bd7db286",
                                                "sense_id": "ef8f531e-bc15-3115-bd48-345e591b6677",
                                                "text": "„Sie drehte in einem düsteren Speisezimmer das Licht an und gab jedem ein Glas Whisky mit Soda.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
