                        "examples": [
                            {
                                "example_id": "9bb0f264-f09d-4b2f-8204-2e6eacb81b9f",
                                "sense_id": "90e8624c-78ae-32c7-bc70-929f48ec66aa",
                                "text": "Bij ons thuis ben ik de echte poetser die bij elk vuiltje direct de stofzuiger pakt."
                            },
                            {
                                "example_id": "dfa63f05-9d0f-4363-87fe-670e5e1727df",
                                "sense_id": "90e8624c-78ae-32c7-bc70-929f48ec66aa",
                                "text": "Weer verbaast de gewone poetslipvis, Labroides dimidiatus. Het kleine zeevisje is bekend van zijn servicestations waar allerlei vissen langskomen om vuil en parasieten te laten verwijderen uit hun bek en van hun kieuwen. Ook geven poetsvisjes massages met strelende vinnen. Bij stations met rijen wachtenden doet de poetser minder aan klantenbinding. Dan neemt hij tijdens het poetsen soms hapjes slijmvlies of kieuw."
                            }
                        ]
                    }
