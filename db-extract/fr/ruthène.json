                    {
                        "sense_id": "ff694b4c-e741-3ced-8f35-c4c726318bc1",
                        "entry_id": "db92135e-1264-3c3c-9889-1b66839a413e",
                        "glosses": [
                            "peuple celte de Gaule de l’Antiquité situés sur les actuels départements du Tarn et de l'Aveyron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f7b81e0-a7ce-410d-b783-e04a6793f7d9",
                                "sense_id": "ff694b4c-e741-3ced-8f35-c4c726318bc1",
                                "text": "Je raconte ailleurs ce que furent mon arrivée dans la capitale des Ruthènes et mon dépaysement à cette altitude que la neige venait de tapisser d’une épaisse couche blanche."
                            },
                            {
                                "example_id": "302f2243-c1e9-48b9-81f9-9483b2bf9c01",
                                "sense_id": "ff694b4c-e741-3ced-8f35-c4c726318bc1",
                                "text": "Au milieu des populations du centre de la France, généralement de petite taille, à la chevelure de couleur foncée, les descendants des anciens Ruthènes, Ρ̓ουτηνοὶ, Rutheni, Ruteni, doivent encore se faire remarquer par la blonde chevelure que Lucain signale chez leur ancêtres."
                            }
                        ]
                    }
