                "senses": [
                    {
                        "sense_id": "4e806ab2-8383-3d3c-b244-55563156430a",
                        "entry_id": "6f0440b1-1985-34c4-9b22-ac9cd6745153",
                        "glosses": [
                            "Woche im August"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b016c60e-6571-4f15-a3fa-8f5e0618618c",
                                "sense_id": "4e806ab2-8383-3d3c-b244-55563156430a",
                                "text": "„In der ersten Augustwoche beruhigte sich das Wetter zwar wieder, dafür sanken die Temperaturen bis auf 22° unter Null.“"
                            },
                            {
                                "example_id": "f7364f51-2a32-4a91-a9b6-125dc1dad93e",
                                "sense_id": "4e806ab2-8383-3d3c-b244-55563156430a",
                                "text": "Danella kam in der vierten Augustwoche und blieb bis Weihnachten."
                            },
                            {
                                "example_id": "61ccc35e-01e9-4798-b00e-eb42e791d3e6",
                                "sense_id": "4e806ab2-8383-3d3c-b244-55563156430a",
                                "text": "„Diese Radikalisierungen machten die einzelnen Kommandos nicht zu einem bestimmten Zeitpunkt gemeinsam mit, sondern zeitlich unterschiedlich von den ersten Augustwochen bis in die ersten Oktoberwochen 1941.“"
                            },
                            {
                                "example_id": "502d0841-f84a-4c92-bc61-90465bb250f9",
                                "sense_id": "4e806ab2-8383-3d3c-b244-55563156430a",
                                "text": "„In der zweiten Augustwoche, in der nach den Sommerferien die Schule anfing, wurden alle Oberprimaner, die sich kriegsfreiwillig gemeldet hatten, von ihrem Truppenteil für einen halben Tag beurlaubt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
