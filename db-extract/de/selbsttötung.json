                        "target_lang_word": "самоубийство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "самоубийство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "66e2419e-10d1-37ab-a9c2-7ca541b45a42",
                                        "entry_id": "162650e6-ddde-375a-8d00-495cf32dcfd3",
                                        "glosses": [
                                            "намеренное лишение себя жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb1ff46-5423-4169-a17e-59b50dc5b491",
                                                "sense_id": "66e2419e-10d1-37ab-a9c2-7ca541b45a42",
                                                "text": "15-го июля в Петропавловской крепости кончил жизнь самоубийством политический арестант Григорий Гольденберг, удушившись полотенцем."
                                            },
                                            {
                                                "example_id": "85bfeee4-6d49-4d8b-b325-8567086346ff",
                                                "sense_id": "66e2419e-10d1-37ab-a9c2-7ca541b45a42",
                                                "text": "Толик Т. покончил жизнь самоубийством, застрелившись из ружья."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e41a0e34-21b3-3012-821b-5610b54c0bfd",
                                        "entry_id": "162650e6-ddde-375a-8d00-495cf32dcfd3",
                                        "glosses": [
                                            "перен., разг. поступок, ведущий к прекращению какой-либо деятельности того, кто этот поступок совершил"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4da4d0-1268-4c11-872d-a9e0c1e9f419",
                                                "sense_id": "e41a0e34-21b3-3012-821b-5610b54c0bfd",
                                                "text": "А из партии не выйдешь, это самоубийство ― выходить из партии."
                                            },
                                            {
                                                "example_id": "03b1cb41-429a-4313-a2db-662632250b7c",
                                                "sense_id": "e41a0e34-21b3-3012-821b-5610b54c0bfd",
                                                "text": "Сократить «социалку» по китайскому образцу ― глупо, сократить оборону ― самоубийство."
                                            }
                                        ]
                                    }
                                ]
                            }
