                                    },
                                    {
                                        "sense_id": "2404f52c-3a28-381f-8dca-83cdab880697",
                                        "entry_id": "3db890bb-26e2-3072-a523-0b61b6461e86",
                                        "glosses": [
                                            "To incinerate a dead body (as an alternative to burial)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0101702-da60-4243-9eef-b6f37033b0e0",
                                                "sense_id": "2404f52c-3a28-381f-8dca-83cdab880697",
                                                "text": "I want to be cremated when I die."
                                            },
                                            {
                                                "example_id": "989c9f19-7469-4018-8c73-59104b2e4a4f",
                                                "sense_id": "2404f52c-3a28-381f-8dca-83cdab880697",
                                                "text": "“You didn’t bury Dad. You burned him.”\n“We cremated him, Benny. For humans, the word is cremated. And we chose to do that because that’s what they do in Japan.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2912a3f9-642e-43df-9891-b141f527a8d8",
                        "source_entry_id": "d1b6c254-d30c-33d3-8688-0fb60f0e3127",
                        "source_sense_id": "cdb6f9e7-d4d6-3422-b6bc-a27d64119017",
