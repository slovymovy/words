        "nl-extract.jsonl": [
            {
                "entry_id": "24dec3d8-dc9f-364c-8364-83882e1a34ab",
                "word": "verscheurend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "011b1d2c-615a-3614-9151-6f09369b7d76",
                        "entry_id": "24dec3d8-dc9f-364c-8364-83882e1a34ab",
                        "glosses": [
                            "alles vernietigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7451d0-00fc-4135-b75c-59339201633a",
                                "sense_id": "011b1d2c-615a-3614-9151-6f09369b7d76",
                                "text": "Een verscheurende krokodil die 164 miljoen jaar geleden de ondiepe zeeën onveilig maakte, is vernoemd naar de soms al even woeste Ian 'Lemmy' Kilmister, de overleden zanger van de Britse heavymetalband Motörhead."
                            },
                            {
                                "example_id": "8232db3b-bd30-4741-8233-1471f3ccbf56",
                                "sense_id": "011b1d2c-615a-3614-9151-6f09369b7d76",
                                "text": "We schrijven 1950. Spanje likt zijn wonden na een verscheurende burgeroorlog."
                            },
                            {
                                "example_id": "da1229aa-c575-4432-bfef-d7574794ca4b",
                                "sense_id": "011b1d2c-615a-3614-9151-6f09369b7d76",
                                "text": "Macrons eigen aversie tegen extreemrechts is onverminderd groot. Politieke groeperingen die haat en woede zaaien en de uitbouw van de Europese democratie in de weg staan, zei hij, ‘moeten we wijzen op de verscheurende gevolgen van het nationalisme uit het verleden’."
                            }
                        ]
                    }
                ],
