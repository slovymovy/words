                "senses": [
                    {
                        "sense_id": "da0233a9-84cf-32ce-9a40-9a1bacb20898",
                        "entry_id": "d0f6a159-6bf3-3adb-b952-8af0389c7e5d",
                        "glosses": [
                            "Donner un caractère définitif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc0f357-6b8a-443c-b0c9-62587cb45e08",
                                "sense_id": "da0233a9-84cf-32ce-9a40-9a1bacb20898",
                                "text": "Dans les défauts de la présente sous-catégorie, on ne peut pas définitiviser des GN dans un but de reprise, car ils n’ont pas d’antécédent accessible dans le contexte arrière."
                            },
                            {
                                "example_id": "8b3751fd-c1ec-4409-9084-f6826407b3d1",
                                "sense_id": "da0233a9-84cf-32ce-9a40-9a1bacb20898",
                                "text": "Le succès fut tel que l'on tente de \"définitiviser\" ce projet."
                            },
                            {
                                "example_id": "5ee6c0e2-7c11-4e3e-bc04-bdc69dffaab5",
                                "sense_id": "da0233a9-84cf-32ce-9a40-9a1bacb20898",
                                "text": "Le nom de le « team » est provisoire pour le moment, il pourra se définitiviser (oui, c'est très français) plus tard si je l'aime toujours bien et ne trouve pas mieux."
                            }
                        ]
                    }
