                                    },
                                    {
                                        "sense_id": "aab20bb1-76f1-3311-9489-9b692814616d",
                                        "entry_id": "f9604424-7cac-363f-bc6a-c51b3c92acd7",
                                        "glosses": [
                                            "atto da ipocrita"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb00ac70-6771-46e4-b630-211495ede9f7",
                                                "sense_id": "aab20bb1-76f1-3311-9489-9b692814616d",
                                                "text": "è una relazione caratterizzata dalle loro reciproche ipocrisie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f6d841-f267-3cac-9826-76c75dd69aff",
                                        "entry_id": "f9604424-7cac-363f-bc6a-c51b3c92acd7",
                                        "glosses": [
                                            "comportamento insincero con “presunti amici” o conoscenti che, spesso con motivazioni ostili o addirittura per invidia ed odio, si manifesta con toni di voce artefatti e sofisticati lasciando comunque trasparire “lievi acuti” dovuti alla falsità, con oggetto del discorso che vuole apparire “elevato secondo le pretese dell’ipocrita e di chi ascolta”, talvolta fingendo rettitudine, ricchezza, successo, virtù e doti particolari, talento, capacità rare ed uniche, qualità comunemente apprezzabili quando reali e vere"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
