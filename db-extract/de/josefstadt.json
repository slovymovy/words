                "senses": [
                    {
                        "sense_id": "88f96429-ec66-3ad0-90ac-521ac05e695a",
                        "entry_id": "107904e1-434c-3abc-a0a7-662997cb93bb",
                        "glosses": [
                            "achter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a526b2c7-01bf-409e-b8a7-7105de3a4e7a",
                                "sense_id": "88f96429-ec66-3ad0-90ac-521ac05e695a",
                                "text": "Die Josefstadt ist der kleinste Bezirk Wiens; sie ist ein Sitz des Bürgertums und noch heute geprägt von kleinen, biedermeierzeitlichen Häusern."
                            },
                            {
                                "example_id": "a9117eff-237e-496f-bd68-72c2270b7202",
                                "sense_id": "88f96429-ec66-3ad0-90ac-521ac05e695a",
                                "text": "Während Bezirke wie Penzing quasi aus Wald und Wiese bestehen, ist die Josefstadt dicht verbaut – ein neuer Park soll helfen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6a80b89-e669-3946-9c93-2883379b2285",
                        "entry_id": "107904e1-434c-3abc-a0a7-662997cb93bb",
                        "glosses": [
                            "ehemalige Vorstadt, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c16fb028-373b-40f3-a7c6-170764ddfb9f",
                                "sense_id": "e6a80b89-e669-3946-9c93-2883379b2285",
                                "text": "Im Bezirkswappen steht der heilige Josef für die Josefstadt."
                            },
                            {
                                "example_id": "f79eea5f-e6c8-4a95-8291-d3e433e3982d",
                                "sense_id": "e6a80b89-e669-3946-9c93-2883379b2285",
                                "text": "Die Vorstadt Josefstadt ging aus dem Landgut Rottenhof hervor."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
