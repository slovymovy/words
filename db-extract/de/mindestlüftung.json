                "senses": [
                    {
                        "sense_id": "c393ba67-6a18-39ac-bb76-b957b89f2c92",
                        "entry_id": "715b1ee3-702a-38a8-b638-b0b84d89c033",
                        "glosses": [
                            "minimalster Luftaustausch für einen Raum oder ein Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f759b7b2-2d24-485b-b95c-adff894a7ec1",
                                "sense_id": "c393ba67-6a18-39ac-bb76-b957b89f2c92",
                                "text": "„Sofern Gebäude nach Mai 2009 über einen expliziten Nachweis der nutzungsunabhängigen Mindestlüftung verfügen müssen, steht die Frage, warum dies bei einem Gebäude, das 2005 unter gleichen Bedingungen errichtet wurde, nicht erforderlich ist.“"
                            },
                            {
                                "example_id": "c71ff11d-8187-48ef-b3d6-c08d47004c1a",
                                "sense_id": "c393ba67-6a18-39ac-bb76-b957b89f2c92",
                                "text": "„Bisher blieb offen, wie diese Mindestlüftung erfolgen muss: manuell durch den Nutzer oder durch eine Lüftungsanlage?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e82e7a4f-69ff-336e-9c4c-ecfc3aaebdbb",
                        "entry_id": "715b1ee3-702a-38a8-b638-b0b84d89c033",
                        "glosses": [
                            "nutzerunabhängiger Luftaustausch bei kleinster Schaltstufe der Lüftungstechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d859e921-54a8-4bbd-9b88-ce9e50305370",
                                "sense_id": "e82e7a4f-69ff-336e-9c4c-ecfc3aaebdbb",
                                "text": "„Sofern Gebäude nach Mai 2009 über einen expliziten Nachweis der nutzungsunabhängigen Mindestlüftung verfügen müssen, steht die Frage, warum dies bei einem Gebäude, das 2005 unter gleichen Bedingungen errichtet wurde, nicht erforderlich ist.“"
                            },
                            {
                                "example_id": "93a3d9da-381a-4d6f-a21a-b8bf317f70e2",
                                "sense_id": "e82e7a4f-69ff-336e-9c4c-ecfc3aaebdbb",
                                "text": "„Bisher blieb offen, wie diese Mindestlüftung erfolgen muss: manuell durch den Nutzer oder durch eine Lüftungsanlage?“"
                            },
                            {
                                "example_id": "403c182d-2d1e-4743-8657-20c552f8ef3c",
                                "sense_id": "e82e7a4f-69ff-336e-9c4c-ecfc3aaebdbb",
                                "text": "„Wird nur die Lüftung zum Feuchteschutz nutzerunabhängig erbracht, muss im Lüftungskonzept als Nachweis der Mindestlüftung nach EnEV für die restlichen Lüftungsstufen das Lüftungssystem Fensterlüftung - mit der dementsprechenden Nutzerabhängigkeit - aufgeführt werden.“"
                            },
                            {
                                "example_id": "ae01faf2-e555-49c8-95a6-d60c19b97bff",
                                "sense_id": "e82e7a4f-69ff-336e-9c4c-ecfc3aaebdbb",
                                "text": "„Korrekte Mindestlüftung ist für die Produktivität und Heizkosten entscheidend.“"
                            },
                            {
                                "example_id": "f9ca6739-290c-4e6d-a74a-c5aebdc6743d",
                                "sense_id": "e82e7a4f-69ff-336e-9c4c-ecfc3aaebdbb",
                                "text": "„Um dabei die Lüftungswärmeverluste so gering wie möglich zu halten, können moderne Steuerungen des Abluftsystems intelligent mit dem Heizungssystem verknüpft und so programmiert werden, dass sie den ganzen Tag über nur eine bestimmte Mindestlüftung sicherstellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
