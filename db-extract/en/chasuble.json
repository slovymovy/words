    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "87505349-4fbf-3301-a378-8563f4cfb8f2",
                "word": "chasuble",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d0bb4b9a-fdb1-48c9-b78d-6a15b5c438fb",
                        "entry_id": "87505349-4fbf-3301-a378-8563f4cfb8f2",
                        "tags": [
                            "plural"
                        ],
                        "form": "chasubles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "528de6b5-535c-3f17-a0f8-ce2574f33f5e",
                        "entry_id": "87505349-4fbf-3301-a378-8563f4cfb8f2",
                        "glosses": [
                            "The outermost liturgical vestment worn by clergy for celebrating Eucharist or Mass."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab7c5f3-a1c4-4dcc-ac8a-e19166923337",
                                "sense_id": "528de6b5-535c-3f17-a0f8-ce2574f33f5e",
                                "text": "Day broke. He saw three black hens asleep in a tree. He shuddered, horrified at this omen. Then he promised the Holy Virgin three chasubles for the church, and that he would go barefooted from the cemetery at Bertaux to the chapel of Vassonville."
                            },
                            {
                                "example_id": "8c2a9771-9f6c-42c4-97d3-196b339a76e5",
                                "sense_id": "528de6b5-535c-3f17-a0f8-ce2574f33f5e",
                                "text": "He has magenta eyes, like old-fashioned vest buttons; he’s mowsy and glaubrous, brown like arnica and then green as the Nile; he’s quaky and qualmy and queasy and teasy; he chews chasubles and ripples rasubly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4f7c1b2-63a6-4b48-85c2-702e4f39ddac",
                        "source_entry_id": "87505349-4fbf-3301-a378-8563f4cfb8f2",
                        "source_sense_id": "528de6b5-535c-3f17-a0f8-ce2574f33f5e",
                        "source_sense_description": "liturgical vestment",
                        "target_lang_word": "kazuifel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kazuifel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "27d9fc66-24c1-3b7a-8c83-7eba4fd899e5",
                                        "entry_id": "0a0a6c07-6b4e-30e6-b64b-67ec0a52f518",
                                        "glosses": [
                                            "mouwloos opperkleed dat door een priester gedragen wordt bij het lezen van de mis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24062540-90fa-411d-901a-dd9299324ebf",
                                                "sense_id": "27d9fc66-24c1-3b7a-8c83-7eba4fd899e5",
                                                "text": "Het kazuifel dat de priester daaroverheen aantrekt, betekent de naastenliefde die elke priester in zo volmaakt mogelijke vorm moet bezitten, dat hij andere mensen overtreft in deugden, net zoals dit gewaad over de andere kleren heen gaat. Naastenliefde is immers de moeder van alle deugden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b447b8f-cbc4-3dc7-8b5b-775c8a1b6c85",
                                        "entry_id": "0a0a6c07-6b4e-30e6-b64b-67ec0a52f518",
                                        "glosses": [
                                            "hesje dat over de kleren wordt gedragen, bijvoorbeeld om beter zichtbaar te zijn in het verkeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7040ef-50fb-4fce-b723-9dd45e2db7a1",
                                                "sense_id": "1b447b8f-cbc4-3dc7-8b5b-775c8a1b6c85",
                                                "text": "De personen die een specifieke functie uitoefenen in de (medische) hulpverleningsketen, zijn herkenbaar via een gele kazuifel, met functievermelding in een fluorescente rechthoek omgeven door een boord bestaande uit een dubbele rij vierkante blokken die afwisselend reflecterend grijs en groen zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f856013-e17b-4e20-9153-d59b1cb4f369",
                        "source_entry_id": "87505349-4fbf-3301-a378-8563f4cfb8f2",
                        "source_sense_id": "528de6b5-535c-3f17-a0f8-ce2574f33f5e",
                        "source_sense_description": "liturgical vestment",
                        "target_lang_word": "chasuble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chasuble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "632481bb-a3b0-3e48-982b-e2985c3b3b81",
                                        "entry_id": "fa40e272-e8e4-30cf-b49e-93e7b75d800e",
                                        "glosses": [
                                            "Vêtement que le prêtre revêt par-dessus l’aube et l’étole pour célébrer la messe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ccd2b64-e366-415c-9831-19489b47efde",
                                                "sense_id": "632481bb-a3b0-3e48-982b-e2985c3b3b81",
                                                "text": "Elle avait dix-sept chasubles galonnées, outre les ornements de deuil"
                                            },
                                            {
                                                "example_id": "c4165ea3-ef3c-4d60-b95b-096f67b8a822",
                                                "sense_id": "632481bb-a3b0-3e48-982b-e2985c3b3b81",
                                                "text": "Le chapelain s’affuble du brocart radieux de la lourde chasuble."
                                            },
                                            {
                                                "example_id": "72877a67-ed52-48f6-a02d-55ae829bb29e",
                                                "sense_id": "632481bb-a3b0-3e48-982b-e2985c3b3b81",
                                                "text": "Pour chanter Veni Creator\nIl faut avoir chasuble d’or. ⁽ᵇⁱˢ⁾\nNous en tissons pour vous\nGens de l’Église,\nMais nous pauvres canuts,\nN’avons point de chemise."
                                            },
                                            {
                                                "example_id": "1d597197-8357-4aa2-b4cb-755e99484b87",
                                                "sense_id": "632481bb-a3b0-3e48-982b-e2985c3b3b81",
                                                "text": "Faut-il vous rappeler maintenant que la liturgie assigne à tous les vêtements, à tous les ornements de l’Église, un sens différent, selon leur usage et selon leur forme ?\nC’est ainsi, par exemple, que le surplis et l’aube signalent l’innocence […] la chasuble ou planète : l’unité de la foi et son intégrité et aussi le joug du Christ…"
                                            },
                                            {
                                                "example_id": "23ae38a2-65d5-42d7-a3de-ecb76fc19612",
                                                "sense_id": "632481bb-a3b0-3e48-982b-e2985c3b3b81",
                                                "text": "Le prêtre se répand en génuflexions. Le voilà qui élève le calice, très haut, figé dans sa chasuble […]"
                                            },
                                            {
                                                "example_id": "1dc1094c-e97a-4adc-a327-44858e557eb9",
                                                "sense_id": "632481bb-a3b0-3e48-982b-e2985c3b3b81",
                                                "text": "Dans le tohu-bohu de la sacristie m’échoyait l’honneur d’aider le prêtre à se vêtir des ornements. Je présentais l’amict, l’aube, l’étole. Je veillais à la pose de la chasuble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16d913bb-7576-3a0d-b2ac-d1eca91770cd",
                                        "entry_id": "fa40e272-e8e4-30cf-b49e-93e7b75d800e",
                                        "glosses": [
                                            "Vêtement que chaque joueur d’une des deux équipes enfile par-dessus son maillot dans le cas où la tenue des deux équipes se ressemble trop, afin de bien distinguer les équipes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83902b29-f6b8-48ab-ab42-724bd3818fc4",
                                                "sense_id": "16d913bb-7576-3a0d-b2ac-d1eca91770cd",
                                                "text": "Quand il vient à l'entraînement, il y a toujours quelqu'un dans l'équipe pour l'aider à porter les filets des buts, les ballons et les chasubles."
                                            },
                                            {
                                                "example_id": "119848db-cae5-439f-8184-2f1c69092c1d",
                                                "sense_id": "16d913bb-7576-3a0d-b2ac-d1eca91770cd",
                                                "text": "On prend le matériel au passage, le sac des ballons (au moins un ballon par joueur), des coupelles et les « chasubles », petits dossards de couleur qui se mettent sur le maillot pour distinguer deux équipes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38cf1f4-a69f-3899-b71e-ff5b7b64c2c4",
                                        "entry_id": "fa40e272-e8e4-30cf-b49e-93e7b75d800e",
                                        "glosses": [
                                            "Vêtement de couleur vive enfilé par-dessus un vêtement afin d’être plus facilement visible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eac00ad-10fe-4114-9260-4e80c133f9dd",
                                                "sense_id": "a38cf1f4-a69f-3899-b71e-ff5b7b64c2c4",
                                                "text": "Au loin, un sanglier factice roule sur une rampe, en direction d’une silhouette affublée d’un chasuble orange."
                                            },
                                            {
                                                "example_id": "e7ebc32b-10cb-407b-b9bd-cd08e87a8d66",
                                                "sense_id": "a38cf1f4-a69f-3899-b71e-ff5b7b64c2c4",
                                                "text": "La municipalité espère le meilleur accueil possible pour les agents recenseurs dotés d’une carte tricolore et d’une chasuble « Ville de Figeac » qui se présentent chez les particuliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4711c3b4-a85e-39d7-9aeb-6c999f8117e1",
                                        "entry_id": "fa40e272-e8e4-30cf-b49e-93e7b75d800e",
                                        "glosses": [
                                            "Chemise courte portée par certains malades en milieu hospitalier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536cf19f-9ea0-4a2e-927a-4e4c66aa2e66",
                                                "sense_id": "4711c3b4-a85e-39d7-9aeb-6c999f8117e1",
                                                "text": "Partir pour une opération, ce n’est pas agréable, mais quitter sa chambre à poil sous une chasuble en fibres non tissées, informe et trop courte, coiffé d’un béret en nylon, c’est épouvantable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
