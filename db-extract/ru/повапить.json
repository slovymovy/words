                                    {
                                        "sense_id": "5d3a2b0d-1c3a-3aa6-9f62-3029e1b07bab",
                                        "entry_id": "8e7ec8c2-4c5c-3436-aa0d-779cfb0fbc79",
                                        "glosses": [
                                            "Opération ayant pour but d’enlever la matière colorante du lin, du chanvre, du coton, de la cire brute, du suif, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26b6b7c2-9348-4cff-ab88-dd34f3ae6a49",
                                                "sense_id": "5d3a2b0d-1c3a-3aa6-9f62-3029e1b07bab",
                                                "text": "[…] : celles-ci sont, ou d’un blanc pur, ou présentent des traces de coloration qui leur avait été donnée une première fois et qu’un blanchiment subséquent a fait disparaître."
                                            }
                                        ]
                                    },
