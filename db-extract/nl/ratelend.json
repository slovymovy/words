                        "examples": [
                            {
                                "example_id": "03feb8ec-ec64-48bc-916d-a51fc2b5fe4f",
                                "sense_id": "b65c4f81-555b-3dd3-936c-b0318efa72c2",
                                "text": "Explosies, ratelende machinegeweren, straaljagers die bombarderen, IS-sluipschutters."
                            },
                            {
                                "example_id": "5b1f5c90-e2ca-43f2-b426-5fecda371551",
                                "sense_id": "b65c4f81-555b-3dd3-936c-b0318efa72c2",
                                "text": "Hoewel de subtiliteit bij C&S heel ver te zoeken was, gingen de beukende bassen en ratelende drums van het duo erin als koek bij het uitzinnige publiek."
                            },
                            {
                                "example_id": "ed18da52-e94a-4707-a7cb-ad4b650a7073",
                                "sense_id": "b65c4f81-555b-3dd3-936c-b0318efa72c2",
                                "text": "Tot groot verdriet van veel reizigers verdwenen de iconische, blauwe borden met ratelende lamellen uit de stationshallen. Utrecht bijvoorbeeld moet het sinds 2011 zonder dat bord stellen omdat het informatiepaneel volgens NS sterk was verouderd."
                            }
                        ]
                    }
