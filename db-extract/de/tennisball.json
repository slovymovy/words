                        "entry_id": "95ab402e-aecc-344d-b038-0db93e3342fd",
                        "glosses": [
                            "Gegenstand: ein Spielgerät, mit dem Tennis gespielt wird. Er wird mit Hilfe der Tennisschläger getroffen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc4e39f-5d7f-4ffd-bb54-2728d554dd35",
                                "sense_id": "6b3f479f-0f06-3095-85e4-6b5fc5977dd0",
                                "text": "Defekte Tennisbälle werden während eines Tennisspiels ausgewechselt."
                            },
                            {
                                "example_id": "f1047265-8ccb-4d29-9a5a-c009b232fb0b",
                                "sense_id": "6b3f479f-0f06-3095-85e4-6b5fc5977dd0",
                                "text": "„Während des Tennisspiels kommt es vor, daß aufgrund von Fehlschlägen Tennisbälle über den Maschendrahtzaun auf die benachbarten Grundstücke der Kläger (manchmal bis zu den Wohnhäusern, Gartenmöbeln oder Autos) fliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
