                                        "examples": [
                                            {
                                                "example_id": "484b35f1-e4ec-40f3-a3f3-d4bc002f65ff",
                                                "sense_id": "ac497b23-6a96-31d4-9d34-f63e59e1c001",
                                                "text": "Can you tell me where the toilets are? I'm bursting."
                                            },
