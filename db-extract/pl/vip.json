                    {
                        "sense_id": "b6751faa-c159-3881-b3a2-9cca38d0b82a",
                        "entry_id": "96d302c9-bcf5-34b3-bc20-6b07c772e02d",
                        "glosses": [
                            "ktoś bardzo ważny, najczęściej ze świata polityki lub biznesu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7a026e-9e5a-4682-8dda-6d82e50149d0",
                                "sense_id": "b6751faa-c159-3881-b3a2-9cca38d0b82a",
                                "text": "To była poważna impreza, na sali było pełno VIP-ów, prezydent miasta, wojewoda, kilku posłów i inne szychy."
                            },
                            {
                                "example_id": "2e4e2608-5746-4582-b37a-95d6fa2362bf",
                                "sense_id": "b6751faa-c159-3881-b3a2-9cca38d0b82a",
                                "text": "W nowym projekcie stadionu zrezygnowano z części ekskluzywnych pomieszczeń dla VIP-ów, dzięki czemu będzie ich więcej dla zwykłych kibiców"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
