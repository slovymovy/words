            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05288590-190e-30b7-823a-7e02e6a402cb",
                    "sense_definition": "Een dom of onhandig persoon.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat ben je toch een <w>sukkel</w> dat je je sleutels bent vergeten!",
                            "target_lang_translations": {
                                "en": "What a <w>fool</w> you are for forgetting your keys!",
                                "ru": "Какой же ты <w>растяпа</w>, что забыл свои ключи!",
                                "zh": "你真是个<w>笨蛋</w>，竟然把钥匙忘了！"
                            }
                        },
                        {
                            "text": "Die arme <w>sukkel</w> heeft geen idee hoe de computer werkt.",
                            "target_lang_translations": {
                                "en": "That poor <w>fool</w> has no idea how the computer works.",
                                "ru": "Этот бедный <w>неудачник</w> понятия не имеет, как работает компьютер.",
                                "zh": "那个可怜的<w>笨蛋</w>根本不知道电脑怎么用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sufferd",
                        "oen",
                        "kluns",
                        "domoor",
                        "sul",
                        "oelewapper",
                        "domkop",
                        "kneus",
                        "dwaas"
                    ],
                    "common_phrases": [
                        "arme sukkel",
                        "wat een sukkel",
                        "stomme sukkel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "wordt vaak gebruikt in informele spreektaal"
                        }
