{
    "word_family": [
        "divide",
        "division",
        "divisor",
        "divisiveness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fdb38887-8ce1-30c4-90f8-3be0d78ca414",
                    "sense_definition": "Having a quality that causes disagreement or separation among people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's <w>divisive</w> rhetoric split the community into two hostile camps.",
                            "target_lang_translations": {
                                "ru": "<w>Раскольническая</w> риторика политика расколола общество на два враждебных лагеря.",
                                "zh": "这位政客<w>引起分歧的</w>言论将社区分裂成了两个敌对阵营。"
                            }
                        },
                        {
                            "text": "They tried to avoid <w>divisive</w> topics during the family dinner.",
                            "target_lang_translations": {
                                "ru": "Они старались избегать <w>вызывающих разногласия</w> тем во время семейного ужина.",
                                "zh": "他们在家庭聚餐时尽量避免谈论那些<w>容易引起分歧的</w>话题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "polarizing"
                    ],
                    "antonyms": [
                        "unifying"
                    ],
                    "common_phrases": [
                        "divisive issue",
                        "divisive effect",
                        "divisive rhetoric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий качеством, которое вызывает разногласия или разделение среди людей.",
                        "zh": "指具有导致人们之间产生分歧或分裂性质的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскольнический",
                                "target_lang_sense_clarification": "способствующий расколу, создающий разделение в группе или организации"
                            },
                            {
                                "target_lang_word": "вызывающий разногласия",
                                "target_lang_sense_clarification": "описывает тему или действие, которое провоцирует споры"
                            },
                            {
                                "target_lang_word": "поляризующий",
                                "target_lang_sense_clarification": "разделяющий людей на две противоположные группы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引起分歧的",
                                "target_lang_sense_clarification": "形容容易引发争议或导致意见不合的话题或行为"
                            },
                            {
                                "target_lang_word": "造成分裂的",
                                "target_lang_sense_clarification": "形容导致群体或社会产生隔阂、对立的性质"
                            },
                            {
                                "target_lang_word": "两极分化的",
                                "target_lang_sense_clarification": "形容使人们立场走向极端对立的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
