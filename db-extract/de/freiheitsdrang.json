                "senses": [
                    {
                        "sense_id": "f3db1c2d-1343-3b24-bafa-a05a32642f9e",
                        "entry_id": "a0234663-8db3-3293-9211-5deeea19c0ec",
                        "glosses": [
                            "Wille, sich zu befreien, sich in seinem Tun nicht (mehr) einengen zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14271c45-c672-4555-94db-947c1a7c2a79",
                                "sense_id": "f3db1c2d-1343-3b24-bafa-a05a32642f9e",
                                "text": "Für meine Person kann ich leider nur sagen, daß ich einen Freiheitsdrang verspüre, der kaum mehr auszuhalten ist."
                            },
                            {
                                "example_id": "f91afdf5-c00b-414d-9c07-f52a8f2f443d",
                                "sense_id": "f3db1c2d-1343-3b24-bafa-a05a32642f9e",
                                "text": "China fürchtet Freiheitsdrang im eigenen Land"
                            },
                            {
                                "example_id": "e959bd22-cf79-44de-8c5e-5a3144744154",
                                "sense_id": "f3db1c2d-1343-3b24-bafa-a05a32642f9e",
                                "text": "Katzen haben einen großen Freiheitsdrang"
                            },
                            {
                                "example_id": "83d83a94-6901-4e3a-ba16-02cce1db0a34",
                                "sense_id": "f3db1c2d-1343-3b24-bafa-a05a32642f9e",
                                "text": "„Einer dieser Glückritter war der französische Dichter Arthur Rimbaud, berüchtigt für hemmungslosen Freiheitsdrang, Drogenkonsum und sexuelle Eskapaden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
