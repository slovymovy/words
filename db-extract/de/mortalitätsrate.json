                "senses": [
                    {
                        "sense_id": "7f241d38-31f3-337f-afc5-b4c151164ec1",
                        "entry_id": "a00aaa8f-8186-3ed2-ad56-b18cbf5714ae",
                        "glosses": [
                            "Todesfälle (Anzahl der gestorbenen Personen) in der untersuchten Gruppe (oft bezogen auf 1 Jahr und 1.000/100.000 Personen, Rate)"
                        ],
                        "tags": [
                            "Demografie"
                        ],
                        "examples": [
                            {
                                "example_id": "57f931aa-569e-4439-895d-39141c087e36",
                                "sense_id": "7f241d38-31f3-337f-afc5-b4c151164ec1",
                                "text": "Die für eine Altersgruppe der beobachteten Population errechnete Mortalitätsrate heißt altersspezifische Mortalitätsrate."
                            },
                            {
                                "example_id": "27ff1161-4248-4a49-a723-c7b7e4025a53",
                                "sense_id": "7f241d38-31f3-337f-afc5-b4c151164ec1",
                                "text": "Die rohe Mortalitätsrate liegt in diesem Bundesland bei 46,09 je 100.000."
                            },
                            {
                                "example_id": "e3a03db1-4d59-46de-8c74-b364d5b6a316",
                                "sense_id": "7f241d38-31f3-337f-afc5-b4c151164ec1",
                                "text": "Im Gegensatz zur Mortalitätsrate bezieht sich die Letalitätsrate auf die Todesfälle unter den erkrankten Personen."
                            },
                            {
                                "example_id": "e62bcb2f-5e44-420e-b04a-665ec0c82a95",
                                "sense_id": "7f241d38-31f3-337f-afc5-b4c151164ec1",
                                "text": "Die krankheitsbedingte Mortalitätsrate zur Influenza gibt an, wie viele von 1000 Personen in einem bestimmten Zeitraum an Influenza verstarben."
                            },
                            {
                                "example_id": "c80e37aa-c35a-4cea-a280-6759822e6eff",
                                "sense_id": "7f241d38-31f3-337f-afc5-b4c151164ec1",
                                "text": "„Ein leichter Rückgang der Brustkrebssterblichkeit wird sichtbar, vergleicht man die Rohe Mortalitätsrate der Jahre 1997 und 1999 des Saarlandes in Tabelle 5 miteinander.“"
                            },
                            {
                                "example_id": "a54627a4-aae1-4178-8204-2fd9488ea7cb",
                                "sense_id": "7f241d38-31f3-337f-afc5-b4c151164ec1",
                                "text": "1964/1965 lag die Mortalitätsrate (pro 1.000) in Pakistan bei 118."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
