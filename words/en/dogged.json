                                "target_lang_sense_clarification": "чрезвычайно настойчивый, иногда до навязчивости"
                            },
                            {
                                "target_lang_word": "упёртый",
                                "target_lang_sense_clarification": "разговорное, о человеке, который твердо стоит на своем"
                            },
                            {
                                "target_lang_word": "неотступный",
                                "target_lang_sense_clarification": "о преследовании или поиске"
                            }
