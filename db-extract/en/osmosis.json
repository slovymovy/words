                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b2c8b747-acc8-4385-bf87-98f16ca4ba79",
                        "entry_id": "0553338f-e088-31fd-88a8-b8d297c31a76",
                        "tags": [
