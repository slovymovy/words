                "senses": [
                    {
                        "sense_id": "5d536714-b48d-3fc0-b172-a95890098b35",
                        "entry_id": "cd5a5c45-f0f8-385e-91ca-42e819b284ae",
                        "glosses": [
                            "aus Mais zubereitete Grütze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8743e0-7f19-4e25-97d2-549587a4d334",
                                "sense_id": "5d536714-b48d-3fc0-b172-a95890098b35",
                                "text": "„Lottie Mae ging in die Küche, bereitete Big Joes Frühstück zu - vier Spiegeleier, Maisbrot-Muffins, Schinken und Maisgrütze - und brachte es in sein Zimmer.“"
                            },
                            {
                                "example_id": "922b2bdb-aade-4b26-80ba-c9b51933c1cf",
                                "sense_id": "5d536714-b48d-3fc0-b172-a95890098b35",
                                "text": "„Er hinkte leicht, was man aber nur von hinten sehen konnte, und kehrte mit einem Tablett zurück, darauf ein großer Teller mit Bohnen und Maisgrütze sowie ein Becher mit dampfendem Kaffee.“"
                            },
                            {
                                "example_id": "5b2535fd-bdca-470a-a186-182e8380ddae",
                                "sense_id": "5d536714-b48d-3fc0-b172-a95890098b35",
                                "text": "„Sie hockten auf dem Fußboden eines länglichen Zimmers mit hoher Decke und rußfleckigen Vigas; eine Frau und ein Mädchen brachten Schüsseln mit Guisado aus Ziegenfleisch, eine mit blauen Tortillas belegte Tonplatte, dazu Näpfe mit Bohnen, Schalen mit Kaffee und eine mit kleinen Brocken rohen braunen Peloncillozuckers garnierte Maisgrütze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
