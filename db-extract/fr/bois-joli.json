                "senses": [
                    {
                        "sense_id": "95f911fc-7332-350b-aca0-287c984b36cb",
                        "entry_id": "c5bb5d8d-c4a6-36b3-8954-3fa3cc297dff",
                        "glosses": [
                            "Un des noms usuels de Daphne mezereum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4250e07-ec22-43f6-9891-89493e5be571",
                                "sense_id": "95f911fc-7332-350b-aca0-287c984b36cb",
                                "text": "Le bois-joli est très toxique."
                            },
                            {
                                "example_id": "714daff9-e5b0-449f-accf-df67c50d3192",
                                "sense_id": "95f911fc-7332-350b-aca0-287c984b36cb",
                                "text": "Plus petit que la daphné parfumé, puisqu’il ne dépasse pas le mètre, le bois joli se garnit de la fin février à mars de manchons de fleurs rose lilacé."
                            }
                        ]
                    }
                ],
