                    "frequency": "VeryLow",
                    "semantic_group_id": "jagd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Jäger ging frühmorgens hinaus, um im Neuschnee nach Wild zu <w>spüren</w>."
                        },
                        {
                            "text": "Mit seinem Hund <w>spürte</w> der Jäger im Neuschnee nach dem angeschossenen Reh."
