                                                "text": "De wachten werden volledig overrompeld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdfb4838-396c-32d8-a3a0-7e6cad4288d9",
                                        "entry_id": "1a852f66-83aa-3547-b355-6b0f7a3a29c9",
