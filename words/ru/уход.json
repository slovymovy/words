{
    "word_family": [
        "уходить",
        "ухаживать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80330c4f-e542-3fae-87ee-127fc8d82bef",
                    "sense_definition": "Действие по глаголу «уходить»; покидание какого-либо места, удаление откуда-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его внезапный <w>уход</w> удивил всех.",
                            "target_lang_translations": {
                                "en": "His sudden <w>departure</w> surprised everyone.",
                                "nl": "Zijn plotselinge <w>vertrek</w> verraste iedereen."
                            }
                        },
                        {
                            "text": "Ранний <w>уход</w> гостей расстроил хозяйку.",
                            "target_lang_translations": {
                                "en": "The guests' early <w>departure</w> upset the hostess.",
                                "nl": "Het vroege <w>vertrek</w> van de gasten stelde de gastvrouw teleur."
                            }
                        }
                    ],
                    "synonyms": [
                        "отбытие"
                    ],
                    "antonyms": [
                        "приход"
                    ],
                    "common_phrases": [
                        "уход из дома",
                        "быстрый уход"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of leaving a place; departure.",
                        "nl": "De handeling van het verlaten van een plaats; vertrek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "departure",
                                "target_lang_sense_clarification": "act of leaving"
                            },
                            {
                                "target_lang_word": "leaving",
                                "target_lang_sense_clarification": "act of going away"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vertrek",
                                "target_lang_sense_clarification": "het weggaan van een plaats"
                            },
                            {
                                "target_lang_word": "heengaan",
                                "target_lang_sense_clarification": "het weggaan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "348fff43-0414-3915-9c74-14f72e3a7e6b",
                    "sense_definition": "Забота о ком-либо или чём-либо, обслуживание и поддержание в порядке.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Правильный <w>уход</w> за кожей очень важен для здоровья.",
                            "target_lang_translations": {
                                "en": "Proper skin <w>care</w> is very important for health.",
                                "nl": "Een goede <w>verzorging</w> van de huid is erg belangrijk voor de gezondheid."
                            }
                        },
                        {
                            "text": "Больному требуется постоянный медицинский <w>уход</w>.",
                            "target_lang_translations": {
                                "en": "The patient requires constant medical <w>care</w>.",
                                "nl": "De patiënt heeft constante medische <w>zorg</w> nodig."
                            }
                        }
                    ],
                    "synonyms": [
                        "забота",
                        "ухаживание"
                    ],
                    "antonyms": [
                        "невнимание",
                        "безразличие"
                    ],
                    "common_phrases": [
                        "уход за кожей",
                        "уход за больным",
                        "медицинский уход"
                    ],
                    "target_lang_definitions": {
                        "en": "The provision of what is necessary for the health, welfare, maintenance, and protection of someone or something.",
                        "nl": "De zorg voor iemand of iets, het onderhouden en in goede staat houden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "care",
                                "target_lang_sense_clarification": "looking after someone or something"
                            },
                            {
                                "target_lang_word": "maintenance",
                                "target_lang_sense_clarification": "keeping something in good condition"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verzorging",
                                "target_lang_sense_clarification": "het zorgen voor het lichaam of uiterlijk"
                            },
                            {
                                "target_lang_word": "zorg",
                                "target_lang_sense_clarification": "hulp en ondersteuning voor zieken of behoeftigen"
                            },
                            {
                                "target_lang_word": "onderhoud",
                                "target_lang_sense_clarification": "het in goede staat houden van objecten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94567fee-3ec4-35b4-a8e2-7b756dbf19a0",
                    "sense_definition": "Оставление должности, прекращение служебной или профессиональной деятельности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор объявил про свой <w>уход</w> на собрании.",
                            "target_lang_translations": {
                                "en": "The director announced his <w>resignation</w> at the meeting.",
                                "nl": "De directeur kondigde zijn <w>vertrek</w> aan tijdens de vergadering."
                            }
                        },
                        {
                            "text": "Его <w>уход</w> с поста был добровольным.",
                            "target_lang_translations": {
                                "en": "His <w>departure</w> from the post was voluntary.",
                                "nl": "Zijn <w>aftreden</w> was vrijwillig."
                            }
                        }
                    ],
                    "common_phrases": [
                        "уход с работы",
                        "уход в отставку"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of leaving a job, position, or professional activity.",
                        "nl": "Het verlaten van een functie, het beëindigen van een baan of professionele activiteit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resignation",
                                "target_lang_sense_clarification": "act of quitting a job"
                            },
                            {
                                "target_lang_word": "retirement",
                                "target_lang_sense_clarification": "leaving one's job permanently, usually due to age"
                            },
                            {
                                "target_lang_word": "departure",
                                "target_lang_sense_clarification": "leaving a specific role"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vertrek",
                                "target_lang_sense_clarification": "het neerleggen van een functie"
                            },
                            {
                                "target_lang_word": "aftreden",
                                "target_lang_sense_clarification": "het vrijwillig verlaten van een hoge functie"
                            },
                            {
                                "target_lang_word": "ontslag",
                                "target_lang_sense_clarification": "het beëindigen van een dienstverband"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb8a38eb-1a42-31a1-98dc-97fcbe78bdc7",
                    "sense_definition": "Смерть, кончина (обычно употребляется как смягчающее выражение).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тяжёлая болезнь ускорила его <w>уход</w>.",
                            "target_lang_translations": {
                                "en": "A severe illness hastened his <w>passing</w>.",
                                "nl": "Een ernstige ziekte versnelde zijn <w>heengaan</w>."
                            }
                        },
                        {
                            "text": "Её безвременный <w>уход</w> из жизни стал трагедией для семьи.",
                            "target_lang_translations": {
                                "en": "Her untimely <w>passing</w> was a tragedy for the family.",
                                "nl": "Haar ontijdige <w>heengaan</w> was een tragedie voor de familie."
                            }
                        }
                    ],
                    "synonyms": [
                        "смерть",
                        "кончина",
                        "уход из жизни"
                    ],
                    "antonyms": [
                        "воскрешение"
                    ],
                    "common_phrases": [
                        "безвременный уход",
                        "скорый уход"
                    ],
                    "target_lang_definitions": {
                        "en": "Death or passing away (often used euphemistically).",
                        "nl": "De dood, het overlijden (meestal eufemistisch gebruikt)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passing",
                                "target_lang_sense_clarification": "euphemism for death"
                            },
                            {
                                "target_lang_word": "death",
                                "target_lang_sense_clarification": "end of life"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "heengaan",
                                "target_lang_sense_clarification": "eufemisme voor overlijden"
                            },
                            {
                                "target_lang_word": "verscheiden",
                                "target_lang_sense_clarification": "het overlijden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}