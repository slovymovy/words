                        "glosses": [
                            "funkcja wyrażająca dla argumentów α z przedziału 0 ≤ α < π/2 stosunek długości przyprostokątnej naprzeciw danego kąta do długości przyprostokątnej przyległej do kąta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ad49f9-d569-4ef0-92f5-1225efd1f4bb",
