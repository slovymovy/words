                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef96055-120c-4fe0-a642-76ece04332bf",
                                "sense_id": "6f430c9c-9cd8-313c-94ae-c257a9da7aca",
                                "text": "Naturschützer protestieren gegen den Bau der Autobahn 94 durch das Isental."
                            },
                            {
                                "example_id": "a4e91a58-b1bb-4f97-b4c4-3f5bf2aa5f3b",
                                "sense_id": "6f430c9c-9cd8-313c-94ae-c257a9da7aca",
                                "text": "Die Auflagen für den Bau des Kohlekraftwerks gehen den Naturschützern nicht weit genug."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6224b56-1697-489f-b780-6739c29f5b3b",
