                    {
                        "translation_id": "30bd329b-d890-4681-9a81-64f3081ff4b4",
                        "source_entry_id": "1e88bce7-056e-3005-98d2-b55e7ab92969",
                        "source_sense_id": "4043e2d6-4fa5-372b-bf49-fa9f5241267b",
                        "source_sense_description": "Christentum: weißer Stehkragen am Hals, der von Klerikern getragen wird",
                        "target_lang_word": "col romain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "col romain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73c5cca6-62c0-3860-9d45-ffa405c22198",
                                        "entry_id": "7bb7f917-718d-3e7b-950d-6aecc9052e91",
                                        "glosses": [
                                            "Col en tissu blanc amidonné porté par les prêtres de l’église catholique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9186d8-fcc1-459b-b32b-2f482352d475",
                                                "sense_id": "73c5cca6-62c0-3860-9d45-ffa405c22198",
                                                "text": "Par l’austérité et le refus des modes vestimentaires qu’il manifeste, le port du col romain accompagné d’habits de couleurs sombres, participe de l'ascèse sacerdotale."
                                            },
                                            {
                                                "example_id": "a1772030-aad0-4294-9b5d-07e15b237c74",
                                                "sense_id": "73c5cca6-62c0-3860-9d45-ffa405c22198",
                                                "text": "Le col romain s’impose à l’ensemble du clergé sous le pontificat de Pie XII."
                                            },
                                            {
                                                "example_id": "3abbeead-7bd3-4720-8322-74233307f5a0",
                                                "sense_id": "73c5cca6-62c0-3860-9d45-ffa405c22198",
                                                "text": "– Crois-moi ou pas, mon p’tit, mais ça me fait bizarre à moi aussi. Quoique, pour dire toute la vérité, je ne regrette pas ce foutu col romain, tout amidonné, qui me serrait le kiki toute la sainte journée ! On aurait dit qu’il voulait m’étrangler, ce col de malheur..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
