                "senses": [
                    {
                        "sense_id": "ab56bc07-bbe6-3acc-84dc-546f7e3c2860",
                        "entry_id": "24e30686-1e43-382b-b2a2-4e6204e003b1",
                        "glosses": [
                            "Variante orthographique tombée en désuétude de rouvrir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "157e30a0-8ca6-44cb-9d7d-51f68e3e94f5",
                                "sense_id": "ab56bc07-bbe6-3acc-84dc-546f7e3c2860",
                                "text": "sur le besoin de panser rarement les playes où l’on examine deux questions ; la première, s’il est plus à propos de les r’ouvrir tous les jours ou de les laisser plusieurs jours sans y toucher."
                            },
                            {
                                "example_id": "89860b5a-5426-4e46-b759-29957b74a4f1",
                                "sense_id": "ab56bc07-bbe6-3acc-84dc-546f7e3c2860",
                                "text": "Il faut donc r’ouvrir ces canaux, si l’on veut redonner la vie à la fabrication et au commerce des fers ; […]."
                            }
                        ]
                    }
                ],
