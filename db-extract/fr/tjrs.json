                                            {
                                                "example_id": "f2733d80-010e-49fc-9628-38d95769d154",
                                                "sense_id": "85c4ee66-4e0d-3b9d-95ce-491774774164",
                                                "text": "Lily chewed her cheek and pondered a message carved into the wood that said: Johnny loves Rosie 4Ever."
                                            },
                                            {
                                                "example_id": "035839f4-f7c1-43ca-8655-1093a7dda036",
                                                "sense_id": "85c4ee66-4e0d-3b9d-95ce-491774774164",
                                                "text": "How do “best friends 4ever\" fight each other over a diminishing number of college slots?"
                                            },
                                            {
                                                "example_id": "7409eccf-d53c-46d2-9c79-1f71ef2199fd",
                                                "sense_id": "85c4ee66-4e0d-3b9d-95ce-491774774164",
                                                "text": "[…] I wiped my nose for the last time and turned off the \"Dylan-N-Asher 4ever\" playlist I had going on my iPod."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f7ee788-f648-4674-9b89-a22fd800ba32",
