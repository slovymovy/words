                                                "sense_id": "6643cd9c-1ddd-3aac-a1c1-a733cf0beff5",
                                                "text": "Bianca reichte es nicht, ein halbes Jahr in London zu studieren, es musste auch noch Vientiane sein."
                                            },
                                            {
                                                "example_id": "892d72c0-02a1-40e7-802e-44b55bffcebd",
                                                "sense_id": "6643cd9c-1ddd-3aac-a1c1-a733cf0beff5",
                                                "text": "„Vientiane erstreckt sich inmitten einer üppigen Landschaft über mehrere Kilometer am Ufer des Mekong, der die Landesgrenze zu Thailand bildet.“"
                                            }
                                        ],
