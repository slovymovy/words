                    {
                        "sense_id": "794e0f41-dd66-36bc-97fd-6fddf30ec163",
                        "entry_id": "428016ba-8aad-355e-b50b-bd0db90410cb",
                        "glosses": [
                            "een tegel van steen, kunststof etc. om een vloer mee te bedekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "866946d6-0d08-4c70-b668-dcc10b20a547",
                                "sense_id": "794e0f41-dd66-36bc-97fd-6fddf30ec163",
                                "text": "Hij liet de plavuizen van schrik uit zijn hand vallen."
                            },
                            {
                                "example_id": "879fd020-bca8-40a0-a910-5d32026a20b5",
                                "sense_id": "794e0f41-dd66-36bc-97fd-6fddf30ec163",
                                "text": "Terwijl we door de smalle gangen liepen met hun gebarsten plavuizen die ruw aanvoelden als oude koeienhuid, viel me op dat de kamerheer zich vreemd voortbewoog. De zool van zijn linkerschoen was stukken dikker dan die van de rechter, en de stompe neus ervan stond scheef Wat voor groteske misvorming zou er onder dat ingevette leer schuilgaan?"
                            }
                        ]
                    }
