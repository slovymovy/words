                                        "sense_id": "a5c19d27-640d-3227-acf1-a52436f0a978",
                                        "entry_id": "8eb7bd52-17c4-3aff-a83b-3c81121b9530",
                                        "glosses": [
                                            "Considéré dans la trinité, pour les chrétiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eaa0099-62b4-4838-8ec3-5958338b6384",
                                                "sense_id": "a5c19d27-640d-3227-acf1-a52436f0a978",
                                                "text": "Confessez donc tous trois une trine unité\n Qui, devant tous les temps, dans son éternité,\n Confond de tous les temps en un seul la durée."
                                            },
                                            {
                                                "example_id": "5220d1a7-1aec-4a6f-b089-d24b1ac5aa2a",
                                                "sense_id": "a5c19d27-640d-3227-acf1-a52436f0a978",
                                                "text": "Jésus a-t-il dit qu’il était trin et consubstantiel ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f94c75d9-24bd-305a-af6b-7614f73aa7fa",
                                        "entry_id": "8eb7bd52-17c4-3aff-a83b-3c81121b9530",
                                        "glosses": [
                                            "Qualifie l’aspect de la position de deux planètes éloignées l’une de l’autre du tiers du zodiaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1b759f-8b59-4b12-842d-1163bdcde543",
                                                "sense_id": "f94c75d9-24bd-305a-af6b-7614f73aa7fa",
                                                "text": "Si deux planètes apparaissent sur l'horizon, c'est le double aspect ; si trois, le trin aspect ; si quatre, l’aspect carré ; le trin aspect n'est guère bon, l’aspect carré est presque toujours funeste."
                                            }
                                        ]
                                    }
                                ]
