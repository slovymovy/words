                                        "glosses": [
                                            "Qualificatif donné aux Églises métropolitaines non soumises directement à l’autorité d’un patriarcat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f96edd-4939-49ca-8544-59f522d606c2",
                                                "sense_id": "486002af-6ec8-356d-801d-164c7dea5d6f",
                                                "text": "Ainsi L’Église serbe a déclaré son autonomie en 1832 ; en 1879 elle s’est déclarée autocéphale"
                                            },
                                            {
                                                "example_id": "ae36aa79-29b2-412f-9cf5-bebc9924b2fd",
                                                "sense_id": "486002af-6ec8-356d-801d-164c7dea5d6f",
                                                "text": "Commencèrent les lentes litanies de l'office des morts de l'Église géorgienne autocéphale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
