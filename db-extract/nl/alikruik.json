                    {
                        "sense_id": "a92f2e22-b49f-3d04-9259-15bb8b7c26ce",
                        "entry_id": "a2900d15-8ed4-3350-aa97-2711a3d68516",
                        "glosses": [
                            "Bigorneau, mollusque dont le nom scientifique est Littorina littorea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ce8308-4b9f-4f15-b031-95e7e85dedcc",
                                "sense_id": "a92f2e22-b49f-3d04-9259-15bb8b7c26ce",
                                "text": "Alikruiken zijn in Engeland nog steeds gewild, hoewel ze niet meer zo populair zijn als in de tijd van koningin Victoria, toen tienduizenden tonnen werden verorberd."
                            },
                            {
                                "example_id": "bea60f46-d877-4ef3-9a23-b6fd98ead0de",
                                "sense_id": "a92f2e22-b49f-3d04-9259-15bb8b7c26ce",
                                "text": "Alikruiken vind je niet op het strand, maar op palen, golfbrekers en dijken. Daar schrapen ze met hun ruwe tong algen van de stenen af."
                            }
                        ]
                    }
