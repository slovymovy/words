                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1469a8da-9551-4631-bf7a-d883ef6a7a01",
                                "sense_id": "7956a50f-7049-3f48-92a7-6d9525ecd458",
                                "text": "Il n'est nullement question de la...champagniser, de l'ardenniser ou de la lorrainiser."
                            },
                            {
                                "example_id": "853922e3-ff4a-4919-a96f-2e6a359adf84",
                                "sense_id": "7956a50f-7049-3f48-92a7-6d9525ecd458",
                                "text": "Je me suis acheté dernièrement un pot de confiture de bergamote, j'ai même fait des calissons à la bergamote pour \"lorrainiser\" cette fameuse gourmandise."
                            },
                            {
                                "example_id": "008aa441-37fe-48d5-8707-7ceda60a9589",
                                "sense_id": "7956a50f-7049-3f48-92a7-6d9525ecd458",
                                "text": "Bon je propose de lorrainiser un peu plus cette version alors"
                            }
                        ]
                    }
