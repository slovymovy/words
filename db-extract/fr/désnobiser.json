                "senses": [
                    {
                        "sense_id": "64e49b62-2ec5-3c0f-bf32-893e524e40aa",
                        "entry_id": "6ea038ed-0976-3f98-b7e9-097cb691189c",
                        "glosses": [
                            "Enlever son caractère snob à quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed93835-db15-4118-a413-8c1f91e14241",
                                "sense_id": "64e49b62-2ec5-3c0f-bf32-893e524e40aa",
                                "text": "Tout comme Stéphane Laforest, le pianiste a énormément travaillé pour \"désnobiser\" la musique classique."
                            },
                            {
                                "example_id": "ff518537-2025-4b9f-862a-a14bf05cf027",
                                "sense_id": "64e49b62-2ec5-3c0f-bf32-893e524e40aa",
                                "text": "Ce coup assomme notre snob, mais toutefois sans le « désnobiser »."
                            },
                            {
                                "example_id": "1a9d7183-1600-4462-af0a-d867109f6a9c",
                                "sense_id": "64e49b62-2ec5-3c0f-bf32-893e524e40aa",
                                "text": "En gros, l'auteur essaie de désnobiser le monde du vin avec beaucoup d'humour et de sarcasme."
                            }
                        ]
                    }
