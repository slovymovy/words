                    {
                        "sense_id": "9701b649-8815-3421-bafb-7b1903139392",
                        "entry_id": "8bc7f52b-88eb-3c34-b37c-b2b16368fed4",
                        "glosses": [
                            "Genre de plantes de la famille des apiacées, dont une espèce est commune dans les Alpes et les Pyrénées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63026d1d-1164-4f53-ad38-d60b4e4e9ac9",
                                "sense_id": "9701b649-8815-3421-bafb-7b1903139392",
                                "text": "Herbacée vivace de la famille des Apiacées, l’astrance séduit par la finesse de ses fleurs. Celles-ci poussent en ombelle, entourées de bractées pareil à des pétales, pourpres ou blanches selon les cultivars."
                            },
                            {
                                "example_id": "3bc7b780-7f9d-4504-bfe9-c56452a74c2d",
                                "sense_id": "9701b649-8815-3421-bafb-7b1903139392",
                                "text": "Plante très à la mode ces dernières années, l’astrance est appréciée pour sa longue floraison estivale et ses inflorescences originales qui apportent une note sauvage dans les jardins ombragés."
                            }
                        ]
                    }
                ],
