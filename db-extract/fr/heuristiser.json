                "senses": [
                    {
                        "sense_id": "88c9239e-0be1-3cc8-9229-405848b556da",
                        "entry_id": "8721fe3a-f340-348e-8578-0a66bde1ecba",
                        "glosses": [
                            "Utiliser une méthode heuristique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1ad987a-e2d0-4fd1-b326-c2d537bff1c9",
                                "sense_id": "88c9239e-0be1-3cc8-9229-405848b556da",
                                "text": "Quand on \"heuristise\" on est dans la création, la réflexion, on suit le cheminement de sa pensée."
                            },
                            {
                                "example_id": "2c46152b-3822-4192-b2c4-ec9cfbd7dbc7",
                                "sense_id": "88c9239e-0be1-3cc8-9229-405848b556da",
                                "text": "On peut d’ores et déjà disparaître : les gentilles entités pétulantes dûment auto-programmées engrangent, synthétisent, comparent, croisent, heuristisent comme des bougresses."
                            },
                            {
                                "example_id": "d4e6624e-2782-4e50-bff4-7912167ded52",
                                "sense_id": "88c9239e-0be1-3cc8-9229-405848b556da",
                                "text": "J'ai malheureusement d'autres chats à heuristiser, mais ça va venir, t'inquiète."
                            }
                        ]
                    }
