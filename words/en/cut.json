    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b58bff39-6d42-3fe1-b7de-77b28657bdf9",
                    "sense_definition": "To divide or separate something into pieces using a sharp tool like a knife or scissors.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>cut</w> the cake into eight equal slices for the guests.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>разрежьте</w> торт на восемь равных частей для гостей."
                            }
                        },
                        {
                            "text": "You should <w>cut</w> the paper along the dotted line to make it fit.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>разрезать</w> бумагу по пунктирной линии, чтобы она подошла по размеру."
                            }
                        }
                    ],
                    "synonyms": [
                        "divide",
                        "slice",
                        "sever"
                    ],
                    "common_phrases": [
                        "cut the cake",
                        "cut into pieces",
                        "cut with scissors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять или отделять что-либо на части с помощью острого инструмента, такого как нож или ножницы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ре́зать",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "разреза́ть",
                                "target_lang_sense_clarification": "на части"
                            },
                            {
                                "target_lang_word": "поре́зать",
                                "target_lang_sense_clarification": "измельчить или ранить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d6ee712-ff49-3832-b7ca-60b8e1e801a0",
                    "sense_definition": "To reduce the amount, size, or number of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>cut</w> costs by reducing travel expenses this year.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>сократить</w> расходы, уменьшив траты на командировки в этом году."
                            }
                        },
                        {
                            "text": "If you want to lose weight, you should <w>cut</w> calories and exercise more.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите похудеть, вам следует <w>снизить</w> потребление калорий и больше заниматься спортом."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduce",
                        "decrease",
                        "lower"
                    ],
                    "common_phrases": [
                        "cut costs",
                        "cut prices",
                        "cut taxes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшать количество, размер или число чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокраща́ть",
                                "target_lang_sense_clarification": "расходы, количество"
                            },
                            {
                                "target_lang_word": "снижа́ть",
                                "target_lang_sense_clarification": "цены, налоги"
                            },
                            {
                                "target_lang_word": "уре́зать",
                                "target_lang_sense_clarification": "бюджет, выплаты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3391a3ab-80d1-36e8-b0e0-b7edbae038bd",
                    "sense_definition": "To stop or interrupt an action, sound, or power supply.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher told the students to <w>cut</w> the noise and listen to the instructions.",
                            "target_lang_translations": {
                                "ru": "Учитель велел ученикам <w>прекратить</w> шум и выслушать инструкции."
                            }
                        },
                        {
                            "text": "The pilot had to <w>cut</w> the engines immediately after the plane landed safely.",
                            "target_lang_translations": {
                                "ru": "Пилоту пришлось <w>заглушить</w> двигатели сразу после того, как самолет благополучно приземлился."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "cease",
                        "discontinue"
                    ],
                    "common_phrases": [
                        "cut the noise",
                        "cut the power",
                        "cut the engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращать или прерывать действие, звук или подачу энергии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекраща́ть",
                                "target_lang_sense_clarification": "шум, действие"
                            },
                            {
                                "target_lang_word": "отключа́ть",
                                "target_lang_sense_clarification": "питание, двигатель"
                            },
                            {
                                "target_lang_word": "глуши́ть",
                                "target_lang_sense_clarification": "мотор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc7d0215-d1fc-3197-ba85-f45e78862ad3",
                    "sense_definition": "To intentionally not attend a scheduled event, such as a class or meeting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>cut</w> class to go to the cinema with his friends.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>прогулять</w> урок, чтобы пойти в кино с друзьями."
                            }
                        },
                        {
                            "text": "If you <w>cut</w> too many lectures, you might fail the final exam.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>пропустишь</w> слишком много лекций, ты можешь провалить финальный экзамен."
                            }
                        }
                    ],
                    "synonyms": [
                        "skip",
                        "ditch"
                    ],
                    "common_phrases": [
                        "cut class",
                        "cut school"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used by students"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно не посещать запланированное мероприятие, например, урок или встречу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогу́ливать",
                                "target_lang_sense_clarification": "уроки, занятия"
                            },
                            {
                                "target_lang_word": "пропуска́ть",
                                "target_lang_sense_clarification": "лекции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a100e283-5002-38b9-a894-667aac6362b8",
                    "sense_definition": "To reach an agreement or finalize a business arrangement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies managed to <w>cut</w> a deal after weeks of difficult negotiations.",
                            "target_lang_translations": {
                                "ru": "Двум компаниям удалось <w>заключить</w> сделку после недель трудных переговоров."
                            }
                        },
                        {
                            "text": "I'll <w>cut</w> a check for the full amount as soon as the contract is signed.",
                            "target_lang_translations": {
                                "ru": "Я <w>выпишу</w> чек на полную сумму, как только контракт будет подписан."
                            }
                        }
                    ],
                    "synonyms": [
                        "negotiate",
                        "finalize"
                    ],
                    "common_phrases": [
                        "cut a deal",
                        "cut a check"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достичь соглашения или завершить деловую договоренность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключа́ть",
                                "target_lang_sense_clarification": "сделку"
                            },
                            {
                                "target_lang_word": "вы́писать",
                                "target_lang_sense_clarification": "чек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f2bf886-1296-3ab6-a501-e159e202682c",
                    "sense_definition": "To dilute or weaken a substance by adding something else to it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dilution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender was accused of trying to <w>cut</w> the whiskey with water to save money.",
                            "target_lang_translations": {
                                "ru": "Бармена обвинили в попытке <w>разбавить</w> виски водой, чтобы сэкономить деньги."
                            }
                        },
                        {
                            "text": "The quality of the product was poor because they <w>cut</w> it with cheap fillers.",
                            "target_lang_translations": {
                                "ru": "Качество продукта было плохим, потому что его <w>разбавляли</w> дешевыми наполнителями."
                            }
                        }
                    ],
                    "synonyms": [
                        "dilute",
                        "adulterate"
                    ],
                    "common_phrases": [
                        "cut with water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбавлять или ослаблять вещество, добавляя в него что-то другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбавля́ть",
                                "target_lang_sense_clarification": "жидкость"
                            },
                            {
                                "target_lang_word": "бодя́жить",
                                "target_lang_sense_clarification": "сленг, о некачественных смесях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
