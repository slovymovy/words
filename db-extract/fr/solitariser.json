                        "glosses": [
                            "Donner un caractère solitaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e804eb09-7372-4a78-a14a-f362cfbe9545",
                                "sense_id": "129ccefa-a9e0-3dbd-9141-8c1b85a23059",
                                "text": "Je pense que toute la substance du RPA est dans le \"give me\", qu'il faut \"solitariser\"."
                            },
                            {
                                "example_id": "3a81c1d1-f896-4846-80d7-8f5fdf47114a",
                                "sense_id": "129ccefa-a9e0-3dbd-9141-8c1b85a23059",
                                "text": "Je me solitarise de plus en plus vous allez me dire, mais bon..."
                            },
                            {
                                "example_id": "acbe1474-3e90-4408-87ee-7db984120754",
                                "sense_id": "129ccefa-a9e0-3dbd-9141-8c1b85a23059",
                                "text": "C'est au collège que j'ai par la suite commencé à me solitariser."
                            }
                        ]
                    }
