                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a18c09c-d2a7-4039-ae4b-bdca38204cde",
                                "sense_id": "1b1894f6-a5aa-334e-a723-d90003a6ee90",
                                "text": "Un club comme Valence est passé en janvier sous le contrôle de la Generalitat, le gouvernement régional, la puissance publique supplantant une fondation inapte à éponger les dettes."
                            },
                            {
                                "example_id": "ca8b9015-9162-454b-83ce-2e05dd257aa1",
                                "sense_id": "1b1894f6-a5aa-334e-a723-d90003a6ee90",
                                "text": "Dans l’après-midi, le pape a rendu une «visite de courtoisie» au souverain espagnol et à sa famille au palais de la Generalitat, le gouvernement régional de Valence."
                            }
                        ]
