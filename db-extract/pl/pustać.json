                                            {
                                                "example_id": "0c9896a7-abb5-4c5a-af00-a8d1489b1bfb",
                                                "sense_id": "c27d5678-0042-3724-9f19-fa46f018a0a6",
                                                "text": "Als er das Grundstück erwarb, war alles Brachland."
                                            },
                                            {
                                                "example_id": "3674d835-93a1-4a90-975b-41a178ba44fe",
                                                "sense_id": "c27d5678-0042-3724-9f19-fa46f018a0a6",
                                                "text": "„Das Brachland gehört seit der Ruhrbesetzung der französischen Armee.“"
                                            },
                                            {
                                                "example_id": "cd950995-7321-4e3f-a01b-1c7aa50b1755",
                                                "sense_id": "c27d5678-0042-3724-9f19-fa46f018a0a6",
                                                "text": "„Der Oberbau, zu dem das Kellergewölbe einst gehört hatte, war eingestürzt und zu Brachland geworden.“"
                                            }
                                        ],
