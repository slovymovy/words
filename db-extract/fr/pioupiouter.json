                "senses": [
                    {
                        "sense_id": "6e9befbf-8f5c-3681-aec2-732dcf0026bd",
                        "entry_id": "f3e7f803-4c95-3ec4-a604-ce773151ee25",
                        "glosses": [
                            "Faire un bruit analogue à celui des poussins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b4dc3cf-fae8-412a-a3fa-95d6861bc0f8",
                                "sense_id": "6e9befbf-8f5c-3681-aec2-732dcf0026bd",
                                "text": "Non, il mange bien, il boit bien... il fait ses petites fientes... il pioupioute sur son perchoir... hein, Michette ?"
                            },
                            {
                                "example_id": "13d5729f-3e48-4c68-9aa5-61279f2ff9d7",
                                "sense_id": "6e9befbf-8f5c-3681-aec2-732dcf0026bd",
                                "text": "Il ne paie peut-être pas de mine quand on le voit marcher, mais derrière une batterie il s'appelle encore Sam Woodyard, même si ce n'est plus le même athlète qu'a connu le petit garçon Gillespie autorisé jadis à venir pioupiouter dans le plus grand orchestre du monde !!!"
                            },
                            {
                                "example_id": "6b47db21-bf70-462e-92e9-85f9c4c4404e",
                                "sense_id": "6e9befbf-8f5c-3681-aec2-732dcf0026bd",
                                "text": "Agathe qui pioupioute plus qu'elle ne parle et fait de mon enfer son paradis ;"
                            }
                        ]
                    }
                ],
