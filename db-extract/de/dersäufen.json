                "senses": [
                    {
                        "sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                        "entry_id": "2d44aa1b-4ee8-36be-99ad-e1ed6af47915",
                        "glosses": [
                            "ertränken, ersäufen"
                        ],
                        "tags": [
                            "Bavarian",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6dcdf998-f055-4aa8-8677-c4be1615a5e7",
                                "sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                                "text": "„Das Schreiberpack muß man in Braunbier dersaufen!“"
                            },
                            {
                                "example_id": "3aba8da9-9722-403a-9ca6-c304a37e6c08",
                                "sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                                "text": "„‚Bist halt ein dummes Seppele‘, sagte die Mutter. ‚Hast nie ghört, junge Katzen dersäuft man!‘“"
                            },
                            {
                                "example_id": "721013c5-5b27-4895-82d3-7e6372966b20",
                                "sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                                "text": "„Ja, warum jammerst denn dann so wia a Katzerl, des was grad dersäuft wird?“"
                            },
                            {
                                "example_id": "da3a7040-675a-4732-bc50-860873b6e713",
                                "sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                                "text": "„[…] dersaufen will ich euch wie die jungen Hund!“"
                            },
                            {
                                "example_id": "79b4b13e-af35-44ff-8611-0710e99a2336",
                                "sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                                "text": "„[…], die muß man im Bier dersaufen, dann bin ich dabei.“"
                            },
                            {
                                "example_id": "617ffd87-0908-47ba-9fa7-ffb5cf0d1e25",
                                "sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                                "text": "„[…] es ist ja schon richtig die Kinder soll man gleich beim ersten Bad dersäufen weils Euch gar so im Wege sind […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75963e4e-25fa-417a-8171-fbcc11ce27df",
                        "source_entry_id": "2d44aa1b-4ee8-36be-99ad-e1ed6af47915",
                        "source_sense_id": "7c8a417c-e075-337b-885b-53bd7f64b8e2",
                        "source_sense_description": "bairisch, transitiv: ertränken, ersäufen",
                        "target_lang_word": "ertränken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ertränken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16c51a2a-9314-3e78-8817-86b3710194e8",
                                        "entry_id": "b1afa9b1-01b2-36a3-b20b-d97440b89682",
                                        "glosses": [
                                            "jemanden oder etwas töten, indem man die Atmungsorgane unter Wasser hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83749b0c-7ad0-472c-903d-2c06b0424423",
                                                "sense_id": "16c51a2a-9314-3e78-8817-86b3710194e8",
                                                "text": "Er hat versucht seine Frau in einem nahe gelegenen Badesee zu ertränken."
                                            },
                                            {
                                                "example_id": "da0f05ca-0053-4f8c-b0fd-c81986ad30e3",
                                                "sense_id": "16c51a2a-9314-3e78-8817-86b3710194e8",
                                                "text": "Er ertränkte die kleinen Katzen, indem er sie zusammen mit einem Stein in einen Sack steckte und in den Bach warf."
                                            },
                                            {
                                                "example_id": "c2aa0217-4361-4b35-9a6b-085ad9b00ee6",
                                                "sense_id": "16c51a2a-9314-3e78-8817-86b3710194e8",
                                                "text": "Hör auf die Pflanze zu gießen, du ertränkst sie ja!"
                                            },
                                            {
                                                "example_id": "3c7baaf1-3c39-48bd-8a7a-e9bdfbca2251",
                                                "sense_id": "16c51a2a-9314-3e78-8817-86b3710194e8",
                                                "text": "„Unterwegs traf er auf das Mädchen, vergewaltigte es und versuchte es anschließend in einem nahegelegenen Bach zu ertränken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
