                "translations": [
                    {
                        "translation_id": "9d031c4c-16f6-4a44-9a5e-766b27a08a15",
                        "source_entry_id": "898f7516-8ef8-31e5-bc72-3bf45be7d524",
                        "target_lang_word": "Eckpfeiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eckpfeiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3cdcf85-dc0b-3888-821a-cd5ee85bfecb",
                                        "entry_id": "5ef0a2ec-8426-3b1b-88d2-70a119c87eea",
                                        "glosses": [
                                            "Säule, die an der Ecke eines Gebäudes steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29fecd0-25a0-4d19-b777-7e81622f1797",
                                                "sense_id": "b3cdcf85-dc0b-3888-821a-cd5ee85bfecb",
                                                "text": "Die hohen Eckpfeiler stützen das Gebäude."
                                            },
                                            {
                                                "example_id": "e77a1041-904c-423c-9d30-13444107d8d6",
                                                "sense_id": "b3cdcf85-dc0b-3888-821a-cd5ee85bfecb",
                                                "text": "„Vorik näherte sich dem im Schatten liegenden Ende des Gebäudes und lehnte sich an einen Eckpfeiler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b830fec-b9b2-3262-8707-9e592eeaff0d",
                                        "entry_id": "5ef0a2ec-8426-3b1b-88d2-70a119c87eea",
                                        "glosses": [
                                            "wichtige Grundlage, Basis von etwas"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e56e6710-5b0a-4464-b9a0-6a0623dc8767",
                                                "sense_id": "6b830fec-b9b2-3262-8707-9e592eeaff0d",
                                                "text": "„Die Vogel-Strauß-Politik war der Eckpfeiler der belgischen Politik und Kultur jener Zeit.“"
                                            },
                                            {
                                                "example_id": "c7b0f977-2dcc-4794-a84f-9d9c6726b6f8",
                                                "sense_id": "6b830fec-b9b2-3262-8707-9e592eeaff0d",
                                                "text": "„Die wesentlichen Eckpfeiler des heutigen Urheberrechts wurden Anfang der 1990er Jahre auf internationaler Ebene verhandelt.“"
                                            },
                                            {
                                                "example_id": "49d53393-f5d3-4c93-9e4e-7bb45dcccd71",
                                                "sense_id": "6b830fec-b9b2-3262-8707-9e592eeaff0d",
                                                "text": "„Das Karfreitagsabkommen von 1998 hat Institutionen geschaffen, die eine Selbstverwaltung Nordirlands ermöglichen sollen. Sie bilden die Eckpfeiler des Friedensabkommens und basieren auf dem Modell der Machtbeteiligung aller Konfliktparteien, dem Power-Sharing.“"
                                            },
                                            {
                                                "example_id": "75a8b252-b19b-4dcc-85a3-4cc8917b5f8d",
                                                "sense_id": "6b830fec-b9b2-3262-8707-9e592eeaff0d",
                                                "text": "„‚Man muss kein Mathe-Genie sein, um zu wissen, dass die Rettung eines Eckpfeilers der britischen Wirtschaft billiger und kostengünstiger gewesen wäre‘, sagte Cortes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
