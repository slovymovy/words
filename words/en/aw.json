{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4c1bef7a-3155-30a4-9764-9f192027a668",
                    "sense_definition": "Used to express affection, adoration, or the feeling that something is cute.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_positive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Aw</w>, look at that tiny puppy sleeping on the rug.",
                            "target_lang_translations": {
                                "ru": "<w>Ой</w>, посмотри на этого крошечного щенка, спящего на коврике.",
                                "de": "<w>Oh</w>, sieh dir diesen winzigen Welpen an, der auf dem Teppich schläft."
                            }
                        },
                        {
                            "text": "<w>Aw</w>, she wrote such a sweet letter to her grandmother.",
                            "target_lang_translations": {
                                "ru": "<w>О</w>, она написала такое милое письмо своей бабушке.",
                                "de": "<w>Och</w>, sie hat ihrer Großmutter so einen süßen Brief geschrieben."
                            }
                        }
                    ],
                    "synonyms": [
                        "ooh",
                        "ah"
                    ],
                    "common_phrases": [
                        "aw how cute",
                        "aw so sweet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражает умиление, обожание или чувство, что что-то является милым.",
                        "de": "Wird verwendet, um Entzücken, Zuneigung oder Rührung auszudrücken, wenn etwas süß oder niedlich ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ой",
                                "target_lang_sense_clarification": "умиление"
                            },
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "обожание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "Ausruf des Entzückens"
                            },
                            {
                                "target_lang_word": "och",
                                "target_lang_sense_clarification": "Ausruf der Rührung"
                            },
                            {
                                "target_lang_word": "oi",
                                "target_lang_sense_clarification": "Ausruf bei Niedlichkeit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f898c234-e10b-37b5-9a2f-05ed11831178",
                    "sense_definition": "Used to express disappointment, sympathy, or dismay.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_negative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Aw</w>, I really wanted to go to the concert tonight.",
                            "target_lang_translations": {
                                "ru": "<w>Эх</w>, я так хотел пойти на концерт сегодня вечером.",
                                "de": "<w>Och</w>, ich wollte heute Abend wirklich gerne zum Konzert gehen."
                            }
                        },
                        {
                            "text": "<w>Aw</w>, that is such a shame about your lost phone.",
                            "target_lang_translations": {
                                "ru": "<w>Ох</w>, как жаль, что ты потерял телефон.",
                                "de": "<w>Oh</w>, das ist so schade mit deinem verlorenen Telefon."
                            }
                        }
                    ],
                    "synonyms": [
                        "oh",
                        "oh no"
                    ],
                    "common_phrases": [
                        "aw man",
                        "aw no",
                        "aw shucks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражает разочарование, сочувствие или смятение.",
                        "de": "Wird verwendet, um Enttäuschung, Bedauern oder Mitgefühl auszudrücken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эх",
                                "target_lang_sense_clarification": "разочарование"
                            },
                            {
                                "target_lang_word": "ох",
                                "target_lang_sense_clarification": "сочувствие"
                            },
                            {
                                "target_lang_word": "жаль",
                                "target_lang_sense_clarification": "сожаление"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "och",
                                "target_lang_sense_clarification": "Ausdruck von Enttäuschung oder Mitgefühl"
                            },
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "Ausdruck von Bedauern"
                            },
                            {
                                "target_lang_word": "schade",
                                "target_lang_sense_clarification": "Bedauern über ein Ereignis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ce5f600-ba54-3d6e-8763-2d2e120de559",
                    "sense_definition": "Used to express mild protest, entreaty, consternation, or disapproval.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Aw</w>, come on, let us stay up a little longer.",
                            "target_lang_translations": {
                                "ru": "<w>Ну</w> давай же, разреши нам не спать еще немного.",
                                "de": "<w>Ach</w>, komm schon, lass uns noch ein bisschen länger aufbleiben."
                            }
                        },
                        {
                            "text": "<w>Aw</w>, Mom, do I really have to clean my room right now?",
                            "target_lang_translations": {
                                "ru": "<w>Ну</w>, мам, мне правда нужно убирать комнату прямо сейчас?",
                                "de": "<w>Och</w>, Mama, muss ich mein Zimmer wirklich jetzt sofort aufräumen?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "aw come on",
                        "aw please"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражает мягкий протест, мольбу, испуг или неодобрение.",
                        "de": "Wird verwendet, um leichten Protest, flehentliches Bitten oder Missbilligung auszudrücken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ну",
                                "target_lang_sense_clarification": "мольба или упрек"
                            },
                            {
                                "target_lang_word": "да ладно",
                                "target_lang_sense_clarification": "недоверие или протест"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ach",
                                "target_lang_sense_clarification": "leichter Protest oder Einwand"
                            },
                            {
                                "target_lang_word": "och",
                                "target_lang_sense_clarification": "flehentliches Bitten"
                            },
                            {
                                "target_lang_word": "mensch",
                                "target_lang_sense_clarification": "Ausruf des Protests oder Unmuts"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4360e9ff-c8ca-3546-9de7-e2d0a205628d",
                    "sense_definition": "Initialism of <w>autumn</w>/<w>winter</w>; often followed by a year to denote a fashion season.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fashion_season",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brand launched its new <w>AW</w> collection during the fashion show.",
                            "target_lang_translations": {
                                "ru": "Бренд представил свою новую коллекцию <w>осень-зима</w> во время показа мод.",
                                "de": "Die Marke hat ihre neue <w>H/W</w>-Kollektion während der Modenschau vorgestellt."
                            }
                        },
                        {
                            "text": "We are preparing the inventory for the upcoming <w>AW</w> season.",
                            "target_lang_translations": {
                                "ru": "Мы готовим инвентарь к предстоящему сезону <w>осень-зима</w>.",
                                "de": "Wir bereiten das Inventar für die bevorstehende <w>Herbst/Winter</w>-Saison vor."
                            }
                        }
                    ],
                    "synonyms": [
                        "FW"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от «осень/зима»; часто используется с указанием года для обозначения модного сезона.",
                        "de": "Abkürzung für Herbst/Winter (autumn/winter); häufig zur Kennzeichnung einer Modesaison verwendet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осень-зима",
                                "target_lang_sense_clarification": "сезон моды"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "H/W",
                                "target_lang_sense_clarification": "Abkürzung für Herbst/Winter"
                            },
                            {
                                "target_lang_word": "Herbst/Winter",
                                "target_lang_sense_clarification": "Modesaison"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59277da1-9a16-3f90-b116-cc1a757c35ed",
                    "sense_definition": "An instance of the interjection 'aw', often expressing amazement or affection.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "utterance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd let out loud <w>aws</w> when the fireworks started.",
                            "target_lang_translations": {
                                "ru": "Толпа издала громкие <w>возгласы восхищения</w>, когда начался фейерверк.",
                                "de": "Die Menge stieß laute <w>Oh-Rufe</w> aus, als das Feuerwerk begann."
                            }
                        },
                        {
                            "text": "There were many oohs and <w>aws</w> from the audience during the magic trick.",
                            "target_lang_translations": {
                                "ru": "Во время фокуса из зрительного зала доносилось много охов и <w>ахов</w>.",
                                "de": "Während des Zaubertricks gab es viele Oohs und <w>Ahs</w> aus dem Publikum."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oohs and aws"
                    ],
                    "target_lang_definitions": {
                        "ru": "Употребление междометия «aw», часто выражающее изумление или умиление.",
                        "de": "Eine Äußerung des Ausrufs 'aw', oft zum Ausdruck von Staunen, Bewunderung oder Rührung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "возглас"
                            },
                            {
                                "target_lang_word": "возглас восхищения",
                                "target_lang_sense_clarification": "описание звука"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ah",
                                "target_lang_sense_clarification": "Ausruf des Staunens"
                            },
                            {
                                "target_lang_word": "Oh-Ruf",
                                "target_lang_sense_clarification": "Ausruf der Bewunderung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2fb170a5-d7ee-30f8-8f62-7725d14c4454",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We met Mr. <w>Aw</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции мы встретили господина <w>Ау</w>.",
                                "de": "Wir haben gestern Herrn <w>Aw</w> auf der Konferenz getroffen."
                            }
                        },
                        {
                            "text": "Is <w>Aw</w> a common family name in this region?",
                            "target_lang_translations": {
