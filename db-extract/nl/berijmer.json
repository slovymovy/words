                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01c6fb6d-e67d-472c-a6e3-a6f766da5b8f",
                                "sense_id": "cbcc3dac-6249-3ca3-9691-daa630a81e39",
                                "text": "Niet iedere lezer en zanger kan zich even makkelijk inleven: sommige mensen hebben wat extra hulp en extra beelden nodig om bij de juiste emotie uit te komen. Dat betekent dat een berijmer de vrijheid heeft om soms te kiezen voor wat mooi klinkt, wat mensen raakt of wat verduidelijkend werkt – zolang hij de strekking van de Bijbeltekst maar geen geweld aandoet."
                            },
                            {
                                "example_id": "5a0fdace-51b7-4d7b-9250-25ab9b912829",
                                "sense_id": "cbcc3dac-6249-3ca3-9691-daa630a81e39",
                                "text": "Marnix van Sint-Aldegonde is de eerste gereformeerde berijmer die daar grondig mee aan de slag gaat."
                            }
                        ]
                    }
