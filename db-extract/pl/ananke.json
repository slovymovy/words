                                "target_senses": [
                                    {
                                        "sense_id": "4fc8a837-3ad5-3f9e-8abe-fd44fbd9e34a",
                                        "entry_id": "6f4e23be-9686-3f29-8ea6-ef38f9911ada",
                                        "glosses": [
                                            "A Greek goddess, personification of destiny, necessity and fate, depicted as holding a spindle."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a3b209-56de-40d1-965b-1afa534a2ad5",
                                                "sense_id": "4fc8a837-3ad5-3f9e-8abe-fd44fbd9e34a",
                                                "text": "“‘To tell you that the eternities beget chaos, and that the immensities are at the mercy of the divine ananke. Infinitude crouches before a personality. The mercurial essence is the prime mover in spirituality, and the thinker is powerless before the pulsating inanity. The cosmical procession is terminated only by the unknowable and unpronounceable’——"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c1e224f-5168-36d7-9369-070066fc4596",
                                        "entry_id": "6f4e23be-9686-3f29-8ea6-ef38f9911ada",
                                        "glosses": [
                                            "A moon of Jupiter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
