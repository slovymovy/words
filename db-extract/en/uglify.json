                    },
                    {
                        "form_id": "91480855-642d-451e-b82e-2adaf38e20d3",
                        "entry_id": "99b6b9c2-cb33-3de1-9c20-8970e241b01b",
                        "tags": [
                            "past"
                        ],
                        "form": "uglified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52f3868d-6d98-31c6-af0a-699ca7cc6946",
                        "entry_id": "99b6b9c2-cb33-3de1-9c20-8970e241b01b",
                        "glosses": [
                            "To make ugly; to destroy or worsen the appearance or attractiveness of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "433ac140-3c14-4b15-a64c-2d0b2b9df30b",
                                "sense_id": "52f3868d-6d98-31c6-af0a-699ca7cc6946",
                                "text": "These guys around that block had this thing about how I was uglifying the neighborhood."
                            },
                            {
                                "example_id": "3c90af93-61a2-4095-a4a5-8eee97b22332",
                                "sense_id": "52f3868d-6d98-31c6-af0a-699ca7cc6946",
                                "text": "She uglifies every thing near her."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4adccca-33c9-347d-bd29-916fa15b5eb3",
                        "entry_id": "99b6b9c2-cb33-3de1-9c20-8970e241b01b",
                        "glosses": [
                            "To become ugly."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fd48ca71-52cb-44a3-b9dd-2d1702112b69",
                                "sense_id": "b4adccca-33c9-347d-bd29-916fa15b5eb3",
                                "text": "Inevitably those bodies age and uglify under her influence, but if they are outstandingly beautiful at the outset, that process takes longer."
                            }
                        ]
                    },
                    {
                        "sense_id": "56eb424a-1103-3726-bb81-f877175a9004",
                        "entry_id": "99b6b9c2-cb33-3de1-9c20-8970e241b01b",
                        "glosses": [
                            "Synonym of minify."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a32ba196-2527-4fd1-ae38-7aa17800f1a0",
                        "source_entry_id": "99b6b9c2-cb33-3de1-9c20-8970e241b01b",
                        "source_sense_description": "to make ugly",
                        "target_lang_word": "enlaidir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enlaidir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d8f9b2b-86a0-3726-ada8-b9d7a6a3a5e9",
                                        "entry_id": "e269fa3a-82df-33f5-9a64-b61bd4ba3126",
                                        "glosses": [
                                            "Rendre laid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3276b0b1-d23d-45a2-9e9e-a75e183b7aac",
                                                "sense_id": "2d8f9b2b-86a0-3726-ada8-b9d7a6a3a5e9",
                                                "text": "Le soudain tutoiement, la violence des mots, enlaidissent Hugues aussitôt. Ce n'est plus qu'un petit voyou, plein de haine."
                                            },
                                            {
                                                "example_id": "50e74627-8ab1-409c-9337-e5228eb6b6da",
                                                "sense_id": "2d8f9b2b-86a0-3726-ada8-b9d7a6a3a5e9",
                                                "text": "[…]; c'est sur cette même place où son union avec Marie-Antoinette d'Autriche fut célébrée par une fête qu’enlaidirent des présages sinistres."
                                            },
                                            {
                                                "example_id": "05a7de69-48d5-453d-ab86-67367e61c3b7",
                                                "sense_id": "2d8f9b2b-86a0-3726-ada8-b9d7a6a3a5e9",
                                                "text": "Alors que Denny se demandait comment Mitch avait pu lui mettre le grappin dessus, elle découvrit qui se tenait sur son perron et ses traits s’enlaidirent aussitôt d'une expression mauvaise."
                                            },
                                            {
                                                "example_id": "ba0751df-1cc9-4500-b7e9-790c3f07a329",
                                                "sense_id": "2d8f9b2b-86a0-3726-ada8-b9d7a6a3a5e9",
                                                "text": "Telle fut la légende de sainte Énimie, fille de Clotaire II et sœur de Dagobert : Sollicitée au mariage, bien qu'ayant fait vœu de chasteté, cette fervente Mérovingienne avait prié Dieu de l’enlaidir pour écarter les prétendants. Dieu l'exauça : une lèpre horrible dévora son corps, rongea son visage."
                                            },
                                            {
                                                "example_id": "16b2ab68-e146-442a-b238-d23c513e39c1",
                                                "sense_id": "2d8f9b2b-86a0-3726-ada8-b9d7a6a3a5e9",
                                                "text": "Elles sont toutes là, soupeuses de Montmartre ou de la rue Royale, avec leurs aigrettes fausses ou vraies, et ces mèches canailles — appelez-les des tanguettes, car on ne dit plus des guiches — qui ne parviennent pas à enlaidir leurs délicieux visages à la pulpe de fleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a9b4d9-39d0-3660-84e4-4b3c82d5f794",
                                        "entry_id": "e269fa3a-82df-33f5-9a64-b61bd4ba3126",
                                        "glosses": [
                                            "Devenir laid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d783255-eac5-4b92-9cc9-614d3b467039",
                                                "sense_id": "e8a9b4d9-39d0-3660-84e4-4b3c82d5f794",
                                                "text": "Choisir un roi jeune, beau et bien portant n'empêchait pas qu'il vieillît, enlaidît, tombât malade, ni qu'il perdît ses vertus, ses qualités morales – bref, qu'il changeât et cessât d'être adéquat."
                                            },
                                            {
                                                "example_id": "c0fb4d81-95ce-420e-94bf-37e0d3c43ef1",
                                                "sense_id": "e8a9b4d9-39d0-3660-84e4-4b3c82d5f794",
                                                "text": "Parfois, on rencontre une fille dont le teint noisette et les yeux de baies sauvages sont séduisants, mais leurs traits sont rarement beaux, et elles enlaidissent vite, dès que la première fraîcheur de la jeunesse est passée..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
