                        "examples": [
                            {
                                "example_id": "f9c3d58b-2ee8-429e-9ac9-ef6c2014deae",
                                "sense_id": "7e46fcb7-debc-3304-91c7-1367188d01c9",
                                "text": "Certains systèmes de fichiers en cours de développement ont pour objectif de rendre la recherche des fichiers plus simple et plus intuitive, et les métadonnées permettent d'y arriver. Tous les fichiers seront donc pourvus de métadonnées permettant de savoir ce qu'ils contiennent.",
                                "translation": "Certain filesystems under development have the objective of making file searching simpler and more intuitive, and metadata allow [one] to reach [this objective]. All files will thus be provided with metadata allowing [one] to know what they contain.",
                                "english": "Certain filesystems under development have the objective of making file searching simpler and more intuitive, and metadata allow [one] to reach [this objective]. All files will thus be provided with metadata allowing [one] to know what they contain."
                            }
                        ]
