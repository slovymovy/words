                "senses": [
                    {
                        "sense_id": "818325b0-e00e-3238-b922-a0809c5e2c4d",
                        "entry_id": "70953358-1fbc-3481-9f7c-e6087d3dffa7",
                        "glosses": [
                            "(meist verbilligter) Verkauf von Waren, um die Lager zu leeren"
                        ],
                        "tags": [
                            "besonders österreichisch"
                        ],
                        "examples": [
                            {
                                "example_id": "210330e0-3423-4b97-ba1b-be9d721c751b",
                                "sense_id": "818325b0-e00e-3238-b922-a0809c5e2c4d",
                                "text": "„Jacques-Antoine Granjon, Gründer und Chef des französischen Onlinehändlers Vente-Privee, hat es mit dem Abverkauf von Restposten zu einem Vermögen gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85fdbf6a-0247-32cd-8662-a122a813d94e",
                        "entry_id": "70953358-1fbc-3481-9f7c-e6087d3dffa7",
                        "glosses": [
                            "Verkauf in größerer Anzahl, bedeutendem Umfang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d60e264-5bd0-4a9b-9256-dbbfe9beb5fe",
                                "sense_id": "85fdbf6a-0247-32cd-8662-a122a813d94e",
                                "text": "„Bei einer Hyperinflation ist der Abverkauf der Währung so stark, dass die gesamte Geldmenge im Vergleich zu stabiler Währung sinkt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
