                "senses": [
                    {
                        "sense_id": "460ee689-9437-3ad5-a612-ace216ebd544",
                        "entry_id": "a03be2cc-6168-3bc6-8709-e82feefd6098",
                        "glosses": [
                            "муз. последовательное воспроизведение, извлечение звуков аккорда (обычно начиная с нижнего тона)"
                        ],
                        "tags": [],
