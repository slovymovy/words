                                    }
                                ]
                            },
                            {
                                "target_word": "ravage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb9ef41-52e9-3cd5-b351-cbd1710cfc7c",
                                        "entry_id": "6ec6d481-4d56-3f39-831f-9f109acd3019",
                                        "glosses": [
                                            "Grievous damage or havoc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a629430a-f89f-4084-9031-4eb4a64af488",
                                                "sense_id": "cbb9ef41-52e9-3cd5-b351-cbd1710cfc7c",
                                                "text": "Would one think 'twere possible for love / To make such ravage in a noble soul!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                                        "entry_id": "6ec6d481-4d56-3f39-831f-9f109acd3019",
                                        "glosses": [
                                            "Depredation or devastation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461bd3fa-0130-40e1-86b4-784509903b50",
                                                "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                                                "text": "the ravages of fire or tempest"
                                            },
                                            {
                                                "example_id": "dd7b8f47-a20d-4ae1-a380-c86dbb33b673",
                                                "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                                                "text": "the ravages of an army"
                                            },
                                            {
                                                "example_id": "3fad1820-2e28-4014-b700-78140a995a40",
                                                "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                                                "text": "the ravages of time"
                                            },
                                            {
                                                "example_id": "62a1b935-01cd-466e-900b-9c16d173fef0",
                                                "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                                                "text": "the ravage of a lion"
                                            },
                                            {
                                                "example_id": "6c17ae6b-eabc-4f50-8738-d3e49dee15e0",
                                                "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                                                "text": "The villages on either side of the Meyn, which were plentifully stored with corn and cattle, felt the ravages of an invading army."
                                            },
                                            {
                                                "example_id": "6b608e6f-348b-4972-8388-d9c770b62136",
                                                "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                                                "text": "[…]and another Swedish naturalist remarks, that so great are the powers of propagation of a single species, even of the smallest insects, that each can commit, when required, more ravages than the elephant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a598c22-6ff7-43a3-9a56-daa097f2f51c",
                        "source_entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                        "source_sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                        "source_sense_description": "vollkommene Zerstörung",
                        "target_lang_word": "dévastation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dévastation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b87188cb-1a51-3120-8852-9fd2dff652ae",
                                        "entry_id": "80d12b3a-cd54-3b79-a4f2-af38db1e4137",
                                        "glosses": [
                                            "Action de dévaster ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7705925f-a74f-40de-884d-5dda4270a820",
                                                "sense_id": "b87188cb-1a51-3120-8852-9fd2dff652ae",
                                                "text": "L’historien d’Attigny pense que ce changement fut occasionné par la dévastation de la paroisse de Montmarin à l'époque de l’invasion du Comte de Bar en Champagne, en 1297."
                                            },
                                            {
                                                "example_id": "115fb281-0da2-4c79-899d-fd27ba79b79b",
                                                "sense_id": "b87188cb-1a51-3120-8852-9fd2dff652ae",
                                                "text": "Cependant, après les dévastations mongoles, l'islam s'embarqua dans une nouvelle phase d’expansion qui dura quatre cents ans (1300 - 1700), ère de conquête et d'empire, de la Hongrie à l'Indonésie."
                                            },
                                            {
                                                "example_id": "9500eda8-8d6e-40be-96f5-c255f64cc4af",
                                                "sense_id": "b87188cb-1a51-3120-8852-9fd2dff652ae",
                                                "text": "Cette invention pédagogique m'inquiéta un peu, car je craignais qu'elle ne fût expérimentée aux dépens de mes jeux. Mais je fus rassuré par la pensée que mon père paraissait trop enflammé par sa nouvelle passion pour sacrifier ses vacances à la dévastation des miennes, et la suite me prouva que j'avais raisonné juste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
