                    "frequency": "High",
                    "semantic_group_id": "obligation_prevision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu es <w>censé</w> ranger ta chambre avant de partir jouer dehors."
                        },
                        {
                            "text": "Le train est <w>censé</w> arriver à la gare dans une dizaine de minutes."
                        }
                    ],
                    "synonyms": [
                        "supposé"
                    ],
                    "common_phrases": [
                        "être censé faire"
                    ]
                },
                {
                    "sense_id": "c0e86aef-b244-30d5-b88a-4a0d586b434e",
                    "sense_definition": "Considéré ou réputé comme tel selon une convention, une règle ou la loi.",
