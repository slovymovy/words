                        "examples": [
                            {
                                "example_id": "6d272f55-d231-4cec-9afc-2481a50aa7b5",
                                "sense_id": "ab640385-4146-3820-9f02-333c24c35300",
                                "text": "„Er träumte von einer Polrasse mit Hundeschlitten aus Walrosshäuten, gebogenen Hörnern und Stoßzähnen, gespickt mit Harpunen und Lanzen, die Jäger in Pelze gehüllt, langsame Karawanen wischelten vormittags über den blauen Schnee, die Schlitten beladen mit Fleisch, Häuten und Eingeweiden, im Hintergrund die untergehende Wintersonne, der Rand der Welt.“"
                            }
                        ],
