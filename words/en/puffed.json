{
    "word_family": [
        "puff",
        "puffy",
        "puffiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ad232f3-ec7e-3a33-9405-07172c3aa4a0",
                    "sense_definition": "Inflated or swollen in appearance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "swollen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His face looked <w>puffed</w> after he woke up from a long nap.",
                            "target_lang_translations": {
                                "ru": "Его лицо выглядело <w>опухшим</w> после того, как он проснулся от долгого сна."
                            }
                        },
                        {
                            "text": "The <w>puffed</w> pastry was light and airy.",
                            "target_lang_translations": {
                                "ru": "<w>Слоеное</w> тесто было легким и воздушным."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядящий раздутым или опухшим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опухший",
                                "target_lang_sense_clarification": "о частях тела, которые увеличились в объеме"
                            },
                            {
                                "target_lang_word": "раздутый",
                                "target_lang_sense_clarification": "о предметах или частях тела, наполненных воздухом или жидкостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43e5b1f0-bc07-3061-af81-ddb31742e2e9",
                    "sense_definition": "Gathered into rounded, voluminous folds or ridges.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "swollen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vintage dress featured elegant <w>puffed</w> sleeves.",
                            "target_lang_translations": {
                                "ru": "Винтажное платье было украшено элегантными <w>пышными</w> рукавами."
                            }
                        },
                        {
                            "text": "She wore a blouse with <w>puffed</w> shoulders for the party.",
                            "target_lang_translations": {
                                "ru": "На вечеринку она надела блузку с <w>пышными</w> плечами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собранный в округлые, объемные складки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "о рукавах или одежде, имеющей объемную форму"
                            },
                            {
                                "target_lang_word": "буф",
                                "target_lang_sense_clarification": "о фасоне рукавов, собранных в складки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7613bbec-9bbb-37b1-a80e-5c8b67295ba5",
                    "sense_definition": "Breathing heavily due to physical exertion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "panting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>puffed</w> after running up the long flight of stairs.",
                            "target_lang_translations": {
                                "ru": "Он <w>запыхался</w>, взбежав по длинной лестнице."
                            }
                        },
                        {
                            "text": "The athlete felt quite <w>puffed</w> following the intense training session.",
                            "target_lang_translations": {
                                "ru": "Спортсмен чувствовал себя очень <w>запыхавшимся</w> после интенсивной тренировки."
                            }
                        }
                    ],
                    "synonyms": [
                        "puffed out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело дышащий из-за физической нагрузки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запыхавшийся",
                                "target_lang_sense_clarification": "о человеке, который тяжело дышит после бега или нагрузки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce5c524f-91ca-3913-b8f6-e4167a7c2770",
                    "sense_definition": "Simple past and past participle of <w>puff</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine <w>puffed</w> smoke as it climbed the steep hill.",
                            "target_lang_translations": {
                                "ru": "Двигатель <w>пыхтел</w> дымом, поднимаясь на крутой холм."
                            }
                        },
                        {
                            "text": "She <w>puffed</w> on her cigarette while waiting for the bus.",
                            "target_lang_translations": {
                                "ru": "Она <w>затягивалась</w> сигаретой, ожидая автобус."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb puff."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие глагола puff (выпускать дым, пыхтеть)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыхтел",
                                "target_lang_sense_clarification": "издавал звуки при дыхании или работе механизма"
                            },
                            {
                                "target_lang_word": "выпускал дым",
                                "target_lang_sense_clarification": "о процессе курения или работе двигателя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}