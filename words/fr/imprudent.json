                },
                {
                    "sense_id": "aa6a38fa-db8e-3d7d-b2ff-babb0effea2d",
                    "sense_definition": "Qui dénote un manque de prudence ou comporte des risques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_prudence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est particulièrement <w>imprudent</w> de s'aventurer sur ce sentier escarpé en pleine nuit.",
                            "target_lang_translations": {
                                "en": "It is particularly <w>unwise</w> to venture onto this steep path in the middle of the night.",
                                "ru": "Крайне <w>опрометчиво</w> пускаться в путь по этой крутой тропе посреди ночи.",
                                "de": "Es ist besonders <w>unklug</w>, sich mitten in der Nacht auf diesen steilen Pfad zu begeben.",
                                "es": "Es especialmente <w>imprudente</w> aventurarse por este sendero escarpado en plena noche.",
                                "zh": "在深夜走上这条陡峭的小路，实在太<w>不明智</w>了。"
                            }
                        },
                        {
                            "text": "Investir toutes ses économies dans un projet incertain est une décision <w>imprudente</w>.",
                            "target_lang_translations": {
                                "en": "Investing all one's savings in an uncertain project is an <w>unwise</w> decision.",
                                "ru": "Вложить все сбережения в сомнительный проект — <w>опрометчивое</w> решение.",
                                "de": "Alle seine Ersparnisse in ein unsicheres Projekt zu investieren, ist eine <w>unkluge</w> Entscheidung.",
                                "es": "Invertir todos sus ahorros en un proyecto incierto es una decisión <w>imprudente</w>.",
                                "zh": "把全部积蓄投入一个前景不明的项目，是一个<w>不明智</w>的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hasardeux",
                        "risqué",
                        "dangereux"
                    ],
                    "antonyms": [
                        "prudent"
                    ],
                    "common_phrases": [
                        "décision imprudente",
                        "geste imprudent",
                        "parole imprudente"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing a lack of caution or involving risks.",
                        "ru": "Свидетельствующий о недостатке осторожности или связанный с риском.",
                        "de": "Von fehlender Vorsicht zeugend oder mit Risiken verbunden. Betrifft besonders Entscheidungen, Handlungen und Äußerungen.",
                        "es": "Que muestra falta de prudencia o implica riesgos. Se aplica a decisiones, acciones y palabras.",
                        "zh": "表现出缺乏谨慎，或含有风险。多用于决定、行为和言语。"
                    },
