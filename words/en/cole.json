            "senses": [
                {
                    "sense_id": "cfbfea43-8dd5-3e34-a7a7-6400f49b18b3",
                    "sense_definition": "A male given name.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My brother <w>Cole</w> is coming to visit us this weekend.",
                            "target_lang_translations": {
                                "ru": "Мой брат <w>Коул</w> приедет навестить нас в эти выходные.",
                                "fr": "Mon frère <w>Cole</w> vient nous rendre visite ce week-end."
                            }
                        },
                        {
                            "text": "They decided to name their newborn son <w>Cole</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать своего новорожденного сына <w>Коулом</w>.",
                                "fr": "Ils ont décidé d'appeler leur fils nouveau-né <w>Cole</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя.",
                        "fr": "Un prénom masculin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Коул",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "Cole",
                                "target_lang_sense_clarification": "prénom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1001324-07bb-386c-bce5-be4e25a23971",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cole</w> has been teaching history at the school for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Коул</w> преподает историю в школе уже двадцать лет.",
                                "fr": "M. <w>Cole</w> enseigne l'histoire dans cette école depuis vingt ans."
                            }
                        },
                        {
                            "text": "The package was addressed to the <w>Cole</w> family.",
                            "target_lang_translations": {
                                "ru": "Посылка была адресована семье <w>Коул</w>.",
                                "fr": "Le colis était adressé à la famille <w>Cole</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "fr": "Un nom de famille."
                    },
                    "translations": {
