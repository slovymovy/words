                "translations": [
                    {
                        "translation_id": "d289d2c8-300b-4eb1-aa71-557d0f32a8e5",
                        "source_entry_id": "781dc695-ad09-3cf2-b526-0397387c7e9b",
                        "target_lang_word": "disappear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disappear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c688a981-c783-3632-a8b5-bc9ee33ae704",
                                        "entry_id": "a4915ac7-1a63-312e-9860-a83680a8ba82",
                                        "glosses": [
                                            "To vanish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61911690-34f0-3b3c-86a6-84183c5cf5c6",
                                        "entry_id": "a4915ac7-1a63-312e-9860-a83680a8ba82",
                                        "glosses": [
                                            "To go missing; to become a missing person."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5db9b6d-ebd9-45b0-a845-e37513d79514",
                                                "sense_id": "61911690-34f0-3b3c-86a6-84183c5cf5c6",
                                                "text": "Eighteen years after Jaycee Dugard disappeared in 1991, she was found alive in the summer of 2009."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbcf7905-c3e3-3216-a87e-57a7ee3cfd12",
                                        "entry_id": "a4915ac7-1a63-312e-9860-a83680a8ba82",
                                        "glosses": [
                                            "To go away; to become lost."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34586f82-5ff9-45fe-b03c-2aa1c0d41ab3",
                                                "sense_id": "bbcf7905-c3e3-3216-a87e-57a7ee3cfd12",
                                                "text": "I corralled the judge, and we started off across the fields[…]. And thus we came by a circuitous route to Mohair,[…]. My client welcomed the judge […] and they disappeared together into the Ethiopian card-room, which was filled with the assegais and exclamation point shields Mr. Cooke had had made at the sawmill at Beaverton."
                                            },
                                            {
                                                "example_id": "d178ee2f-c94a-407e-b8ba-c6b5c5d5dd48",
                                                "sense_id": "bbcf7905-c3e3-3216-a87e-57a7ee3cfd12",
                                                "text": "A turban and loincloth soaked in blood had been found; also a staff. These properties were known to have belonged to a toddy drawer. He had disappeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                                        "entry_id": "a4915ac7-1a63-312e-9860-a83680a8ba82",
                                        "glosses": [
                                            "To make vanish; especially, to abduct or murder for political reasons."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76c61c19-e412-4021-b0cd-8aa7b3399aef",
                                                "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                                                "text": "The Chinese government is well-known for disappearing particularly vocal political dissidents."
                                            },
                                            {
                                                "example_id": "9fc3e7bd-6432-4f99-9e2a-d2b2d86f0977",
                                                "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                                                "text": "\"Did they disappear him?\"\n \"I don’t know.\"\n \"What will you do if they decide to disappear you?\""
                                            },
                                            {
                                                "example_id": "7126e805-3ee6-4374-9f18-68e06717e9dc",
                                                "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                                                "text": "Now a new hunt is under way to find a grave believed to contain the remains of some of those who were “disappeared” at Colonia Dignidad."
                                            },
                                            {
                                                "example_id": "36b3cace-cb72-434d-a05d-46e3ee6b5f10",
                                                "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                                                "text": "\"It's such an honoring for Native people in this country, when we've been so disappeared and disregarded,\" Harjo says."
                                            },
                                            {
                                                "example_id": "d4469dd6-af0d-459f-a882-6e45f3b3f9c1",
                                                "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                                                "text": "The book centres on Eilish Stack, a scientist, mother of four and wife to a teacher trade unionist who has been disappeared by the secret police."
                                            },
                                            {
                                                "example_id": "5957e12e-e556-457e-9c4e-0c15f58e65e4",
                                                "sense_id": "6f18f511-2bb0-34a9-91f7-2fbbc801e46b",
                                                "text": "Yet after her brother was detained and disappeared by Israeli forces at a checkpoint as he evacuated south months ago, Ms. Nabil, like others, fears moving south."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
