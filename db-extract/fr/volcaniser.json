                "senses": [
                    {
                        "sense_id": "3b998fee-a942-36b8-bd1c-1ab378ca6c08",
                        "entry_id": "fee38958-7c8f-3ed9-becb-bbbed5e9e224",
                        "glosses": [
                            "Animer, exalter."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "030eb7eb-7af0-41cf-b529-741249782b44",
                                "sense_id": "3b998fee-a942-36b8-bd1c-1ab378ca6c08",
                                "text": "Et puis, lancez vos feux, volcanisez mes chants !\nLibre enfant du désert, il me faut pour patrie,\nUn ciel toujours d'airain, et des sables brûlants."
                            },
                            {
                                "example_id": "55993331-009c-4c3d-b3dd-699df4535214",
                                "sense_id": "3b998fee-a942-36b8-bd1c-1ab378ca6c08",
                                "text": "L’action des sociétés de la Croix-Rouge est donc de volcaniser les forces du bien dans toutes les sociétés humaines et exploser la nouvelle génération qui fera naître l’homme nouveau et l’homme société, attendu du 20ème siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "54b8fab3-ba39-337f-bdca-c7460d252c08",
                        "entry_id": "fee38958-7c8f-3ed9-becb-bbbed5e9e224",
                        "glosses": [
                            "Exciter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f056c12-03c2-457a-9f4f-7a668d45dc13",
                                "sense_id": "54b8fab3-ba39-337f-bdca-c7460d252c08",
                                "text": "J'ai envie de me volcaniser les neurones, de m’exploser la tête."
                            }
                        ]
                    }
