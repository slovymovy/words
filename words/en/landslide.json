{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db886f06-e8ed-3d1f-b159-24d6790ae16f",
                    "sense_definition": "A mass of rock, earth, or debris moving down a steep slope, often caused by heavy rain or earthquakes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geological_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rains triggered a massive <w>landslide</w> that blocked the main road into the mountain village.",
                            "target_lang_translations": {
                                "zh": "暴雨引发了一场巨大的<w>山体滑坡</w>，阻断了通往山村的主路。"
                            }
                        },
                        {
                            "text": "Rescue teams worked through the night to clear debris left by the unexpected <w>landslide</w>.",
                            "target_lang_translations": {
                                "zh": "救援队连夜清理突发<w>滑坡</w>留下的废墟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "earthfall",
                        "landslip"
                    ],
                    "common_phrases": [
                        "massive landslide",
                        "trigger a landslide"
                    ],
                    "target_lang_definitions": {
                        "zh": "大量岩石、泥土或碎屑从陡坡上滑落的现象（通常由暴雨或地震引起）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "山体滑坡",
                                "target_lang_sense_clarification": "最常用、最明确的地质灾害称呼"
                            },
                            {
                                "target_lang_word": "滑坡",
                                "target_lang_sense_clarification": "通用简称，指斜坡岩土滑落"
                            },
                            {
                                "target_lang_word": "塌方",
                                "target_lang_sense_clarification": "多指山坡或工程土石坍塌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c87f5e32-ca26-368d-b97b-5144b6868e32",
                    "sense_definition": "An overwhelming victory in an election, won by a very large margin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electoral_victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mayor was re-elected in a <w>landslide</w>, securing more than seventy percent of the total votes.",
                            "target_lang_translations": {
                                "zh": "市长以<w>压倒性胜利</w>成功连任，赢得了超过百分之七十的总选票。"
                            }
                        },
                        {
                            "text": "Political analysts had predicted a close race, but it turned into a complete <w>landslide</w>.",
                            "target_lang_translations": {
                                "zh": "政治分析人士此前曾预测竞争会很激烈，但结果却成了一场彻底的<w>大胜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "landslide victory"
                    ],
                    "common_phrases": [
                        "landslide victory",
                        "win in a landslide"
                    ],
                    "target_lang_definitions": {
                        "zh": "（选举中的）压倒性胜利，以绝对优势获胜。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "压倒性胜利",
                                "target_lang_sense_clarification": "选举中以极大优势获胜"
                            },
                            {
                                "target_lang_word": "大胜",
                                "target_lang_sense_clarification": "大幅领先的胜利"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f16dd6ac-3d87-36e5-8bd1-961ef83ad1ec",
                    "sense_definition": "To slide down a slope in the manner of a landslide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geological_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saturated hillside suddenly began to <w>landslide</w> toward the valley below.",
                            "target_lang_translations": {
                                "zh": "吸饱水分的山坡突然开始向下面的山谷<w>滑坡</w>。"
                            }
                        },
                        {
                            "text": "Engineers warned that the weakened cliff face could <w>landslide</w> after another storm.",
                            "target_lang_translations": {
                                "zh": "工程师警告称，松动的悬崖表面在经历另一场暴风雨后可能会发生<w>塌方</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（土石或山体）发生滑坡、崩塌。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑坡",
                                "target_lang_sense_clarification": "岩土体沿斜坡向下滑动"
                            },
                            {
                                "target_lang_word": "塌方",
                                "target_lang_sense_clarification": "土石崩落、坍塌"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}