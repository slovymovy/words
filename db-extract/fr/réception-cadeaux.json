                                    },
                                    {
                                        "sense_id": "9b9e7722-82b2-3df8-b402-ed2fd84b175b",
                                        "entry_id": "8fc73226-ea39-3ea0-a32d-938c3b06e575",
                                        "glosses": [
                                            "To bestow liberally, to give or distribute in abundance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a6ae0a-c2e4-4361-b970-0ea647560527",
                                                "sense_id": "9b9e7722-82b2-3df8-b402-ed2fd84b175b",
                                                "text": "The individual in the army becomes used to holding human life in contempt, in fact the greater the slaughter, the greater is his merit; and the more medals, ribbons, and honors of hero-worship are showered on him, the more he becomes, after a time, indifferent to all sorts of human suffering and loss of human life."
                                            },
                                            {
                                                "example_id": "5f6f5806-c6af-4a14-b10c-39d5085e0202",
                                                "sense_id": "9b9e7722-82b2-3df8-b402-ed2fd84b175b",
                                                "text": "Shower the people you love with love / Show them the way that you feel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "876d1ce5-425f-3b46-a3c1-d9c3bea19111",
                                        "entry_id": "8fc73226-ea39-3ea0-a32d-938c3b06e575",
                                        "glosses": [
                                            "To rain in a shower; to cascade down."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a60aa58-7cf4-3d75-895b-1c599b38d519",
                                        "entry_id": "bbe644bd-dc34-3d45-9b03-46cf5fddfb67",
                                        "glosses": [
                                            "One who shows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a2c846-aa41-4e41-be78-6e80cb077888",
                                                "sense_id": "4a60aa58-7cf4-3d75-895b-1c599b38d519",
                                                "text": "When you show a credential there's a protocol whereby the showee has assurance that the shower possesses a credential of the particular type without actually seeing the bit string."
                                            },
                                            {
                                                "example_id": "a7e28bdd-49be-4904-8226-116915267a23",
                                                "sense_id": "4a60aa58-7cf4-3d75-895b-1c599b38d519",
                                                "text": "Once the showee looks at the object, the shower removes his or her gaze from the showee and gazes back at the object (see below and Fig. 5.2)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17646d25-8c53-3e83-9179-fd8376a39453",
                                        "entry_id": "bbe644bd-dc34-3d45-9b03-46cf5fddfb67",
                                        "glosses": [
                                            "An object or activity that is shown in a contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447ae567-1517-41fe-b0d3-0d50e896a648",
                                                "sense_id": "17646d25-8c53-3e83-9179-fd8376a39453",
                                                "text": "That calf is going to be a great shower at the fair this year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9eac530-97f4-3eed-933f-543f86693be5",
                                        "entry_id": "bbe644bd-dc34-3d45-9b03-46cf5fddfb67",
                                        "glosses": [
                                            "A man whose penis is close to its full (erect) size when flaccid, or the penis itself."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a334c6c1-3420-4ab3-879b-fa986e4524b9",
                                                "sense_id": "e9eac530-97f4-3eed-933f-543f86693be5",
                                                "text": "As a man who can best be described as a \"grower not a shower\", I helped Brent realize that many people in the gay community are concerned in a very adolescent way with their dick size, including me."
                                            },
                                            {
                                                "example_id": "03f93964-61e6-4883-8649-99dc2b97cd5e",
                                                "sense_id": "e9eac530-97f4-3eed-933f-543f86693be5",
                                                "text": "\"Growers\" are guys whose penises tend to contract a lot lengthwise when flaccid, while \"show-ers\" are guys whose penises could be said to merely \"deflate\" without contracting much in length."
                                            },
                                            {
                                                "example_id": "ae942108-81b0-4e98-b6f5-a2310666098b",
                                                "sense_id": "e9eac530-97f4-3eed-933f-543f86693be5",
                                                "text": "His dick, if I remember correctly, is more of a shower than a grower[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
