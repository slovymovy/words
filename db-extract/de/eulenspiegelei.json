                        "entry_id": "89074a12-d41f-3216-99cc-4c17fcb43115",
                        "glosses": [
                            "Streich, den einer einem anderen spielt, indem er dessen Anweisungen wörtlich nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59be60e2-92f0-41a3-9e78-c7841bcbdcff",
                                "sense_id": "40a35e56-e378-3b62-a4f6-dc4fe3ab7fab",
