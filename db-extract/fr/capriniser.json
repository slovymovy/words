                "senses": [
                    {
                        "sense_id": "812f9ad7-975b-310e-88fb-b29cbb54408e",
                        "entry_id": "a516f9aa-28fb-3a20-a19c-d422b7da9ac3",
                        "glosses": [
                            "Faire passer (un virus) par la chèvre au cours du processus visant à produire un vaccin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af9a67b-6dbe-4817-b29c-9d96561bb0c1",
                                "sense_id": "812f9ad7-975b-310e-88fb-b29cbb54408e",
                                "text": "Comme Muktesar ne pouvait fournir tout le virus atténué nécessaire (on employait à l’époque le virus non desséché) beaucoup de provinces entreprirent de « capriniser » des souches."
                            },
                            {
                                "example_id": "6bc999a8-9613-47a0-bc8a-47c2ed8a7a8c",
                                "sense_id": "812f9ad7-975b-310e-88fb-b29cbb54408e",
                                "text": "De plus en plus, le vaccin V.G.A. est abandonné au profit des virus vaccins caprinisés et lapinisés."
                            },
                            {
                                "example_id": "d1406431-a9f5-478e-819a-0d13f566082c",
                                "sense_id": "812f9ad7-975b-310e-88fb-b29cbb54408e",
                                "text": "Dans les zones reculées du Tchad ou de la République centrafricaine, il était encore possible il y a quelques années, de rencontrer des éleveurs se souvenant avoir vu des vétérinaires français et leurs chèvres servant à vacciner le bétail contre la peste bovine par le vaccin « caprinisé »."
                            }
                        ]
                    }
                ],
