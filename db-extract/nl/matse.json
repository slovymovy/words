                                            {
                                                "example_id": "b25585ed-bb65-4b3c-9f47-498177ca2aa1",
                                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                                "text": "Matzo is eaten by Jews on Passover."
                                            },
                                            {
                                                "example_id": "3b9d667e-9da5-4e6f-bd96-208552279f76",
                                                "sense_id": "228a8ea0-acdc-36cc-b27b-22a5d0b2a4b0",
                                                "text": "Like the Kopelmans, they have a Christmas tree with dreidel ornaments and a menorah, which they light each night. Pham learned to cook matzo ball soup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9966bc04-b6a8-350b-a8ae-e238d3847118",
