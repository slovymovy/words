                        "entry_id": "3966a327-d2a0-361b-bb74-9a38b0cd9efb",
                        "glosses": [
                            "eine Art des Betruges, bei der die Unkenntnis oder das Unvermögen des Opfers ausgenutzt wird"
                        ],
