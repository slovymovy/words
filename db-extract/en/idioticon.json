                    {
                        "translation_id": "cacce6f0-9365-4a02-b7ed-ea4df33144f4",
                        "source_entry_id": "fc0eea17-5bed-37b1-9c26-e1d1ba6d3bee",
                        "source_sense_id": "88fea120-4783-3212-a364-345130b007b2",
                        "source_sense_description": "dictionary of a specific dialect",
                        "target_lang_word": "glossaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glossaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                        "entry_id": "e69fd13c-f3de-3a2b-909a-911e54454507",
                                        "glosses": [
                                            "Dictionnaire spécialisé servant à expliquer le vocabulaire d'un domaine technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2af0ca-8193-47ef-bd92-ec80bd79541c",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "Mon glossaire jmoude était très riche ; mais le sens d'un certain nombre de mots appris de la bouche de paysans grossiers demeurait encore pour moi enveloppé d'une obscurité relative."
                                            },
                                            {
                                                "example_id": "a4ce7745-00ea-437c-a116-be6925c94c35",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "[…]; au premier abord, le lecteur pourra se sentir un peu dérouté, mais qu'il veuille bien se donner la peine, sans être obligé de se reporter au glossaire, de lire quelques lignes à haute voix ; […]."
                                            },
                                            {
                                                "example_id": "cd5937c4-4afa-4c61-914b-da95ede635cd",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "Cela suppose un vocabulaire commun. Ce glossaire répond au défi de la Babel humaine selon un tempo à deux temps :\n— Au présent, le glossaire, donne des définitions et introduit des réflexions. […].\n— Au futur le glossaire s'enrichira de votre contribution. […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d5c04b4-35ad-483d-8b59-b8caf33e4601",
                        "source_entry_id": "fc0eea17-5bed-37b1-9c26-e1d1ba6d3bee",
                        "source_sense_id": "88fea120-4783-3212-a364-345130b007b2",
                        "source_sense_description": "dictionary of a specific dialect",
                        "target_lang_word": "lexique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96d82428-b6c3-370b-b885-4a60cead4b9e",
                                        "entry_id": "33d6f3f1-ba2a-340a-8b27-0ac38cb63ed5",
                                        "glosses": [
                                            "Dictionnaire des locutions et formes propres à certains auteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20c75ad-d8dd-4228-ab98-af6b7d94018f",
                                                "sense_id": "96d82428-b6c3-370b-b885-4a60cead4b9e",
                                                "text": "Le lexique de Platon."
                                            },
                                            {
                                                "example_id": "2905e377-5cda-4f85-9f62-17b2e1698e82",
                                                "sense_id": "96d82428-b6c3-370b-b885-4a60cead4b9e",
                                                "text": "Le lexique de Cicéron."
                                            },
                                            {
                                                "example_id": "d351d4e4-d8b9-49a8-94c5-e7e8dfde86a5",
                                                "sense_id": "96d82428-b6c3-370b-b885-4a60cead4b9e",
                                                "text": "Le lexique de Corneille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef590b0-6800-3ac9-a4b6-362c514e18b3",
                                        "entry_id": "33d6f3f1-ba2a-340a-8b27-0ac38cb63ed5",
                                        "glosses": [
                                            "Ensemble des lexies (lexèmes, locutions, proverbes) d’une langue, sans distinction flexionnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2c50dc-6ae5-4468-8d7e-74129e127e09",
                                                "sense_id": "fef590b0-6800-3ac9-a4b6-362c514e18b3",
                                                "text": "- Qu'est-ce que ça veut dire : apicole ?\nPapa répondait, d'une voix nette, précise. Nous n'étions pas étonnés : c'était sa fonction. Il savait tout et l'expliquait clairement. Il était notre vivant lexique. J'ai compris, par la suite, qu'il avait fait un effort immense et naïf pour apprendre les mots et leur sens et que, dans ses calculs, c'était bien là le commencement de tout, l'échelon initial, le premier grade nécessaire à l’ascension d’une tribu."
                                            },
                                            {
                                                "example_id": "af8a0d24-f583-495a-b783-1d6933f96726",
                                                "sense_id": "fef590b0-6800-3ac9-a4b6-362c514e18b3",
                                                "text": "L’anti-monte-lait étonne d’abord en tant que mot : c’est un nom composé, mais composé de trois bouts. Il n’y en a pas des masses dans notre lexique, et on ne sait pas trop bien s’il faut des traits d’union, combien, et où."
                                            },
                                            {
                                                "example_id": "c548f6ea-005d-4480-94a1-3e72b2171ffe",
                                                "sense_id": "fef590b0-6800-3ac9-a4b6-362c514e18b3",
                                                "text": "Les cinquante titres récupèrent et déroutent, avec un zeste d’ironie et, parfois, avec un léger effet captieux, le lexique sur la pandémie de COVID-19, le vocabulaire et les syntagmes titrés dans les journaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1febceda-bdd2-35a3-8fef-1284ce47bf61",
                                        "entry_id": "33d6f3f1-ba2a-340a-8b27-0ac38cb63ed5",
                                        "glosses": [
                                            "Groupe de mots ayant un point commun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adbb44d9-6311-4e5e-a5a8-62562311e878",
                        "source_entry_id": "fc0eea17-5bed-37b1-9c26-e1d1ba6d3bee",
                        "source_sense_id": "88fea120-4783-3212-a364-345130b007b2",
                        "source_sense_description": "dictionary of a specific dialect",
                        "target_lang_word": "Idiotikon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idiotikon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ca4814-1725-3077-bd8e-788e3d77baf4",
                                        "entry_id": "b8185953-b0f9-3678-a2ff-2b0e716fafdb",
                                        "glosses": [
                                            "Wörterbuch für mundartliche und regionale Ausdrücke"
                                        ],
                                        "tags": [
                                            "linguistische Wissenschaftsgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac05fa51-b22c-4343-b719-4f8bb72edb4c",
                                                "sense_id": "f8ca4814-1725-3077-bd8e-788e3d77baf4",
                                                "text": "„Diese Reime und noch viel mehr finden Sie im holsteinischen Idiotikon.“"
                                            },
                                            {
                                                "example_id": "d33f3fd8-1735-436d-82fd-8808b165a90e",
                                                "sense_id": "f8ca4814-1725-3077-bd8e-788e3d77baf4",
                                                "text": "„Damit werden auch die Mundartwörterbücher beziehungsweise Idiotiken zu Instrumenten, die die deutsche Sprache insgesamt fördern, indem sie sie bereichern.“"
                                            },
                                            {
                                                "example_id": "25f07689-ffd1-4e0a-b25f-762dfdc9d77e",
                                                "sense_id": "f8ca4814-1725-3077-bd8e-788e3d77baf4",
                                                "text": "„Einen Bruch mit der bisherigen Tradition [der Mundartwörterbücher] bedeutete es aber, daß Bachmann schließlich die Idee des ‚Idiotikons‘ als einer Sammlung eigentümlichen Sprachmaterials aufgab. Sie war für ihn wissenschaftlich gesehen ‚ein Überbleibsel aus vergangenen Tagen‘, denn: ‚Wir haben kein Recht, guten Schweizerwörtern ihren Platz im schweizerdeutschen Wörterbuch zu verweigern, bloß deswegen, weil die Wörter — zufällig, möchte man sagen — auch schriftsprachlich sind. […] Der Standpunkt des Idiotikons ist also abzulehnen‘. […] Indem Bachmann sich diese Maxime zu eigen machte, setzte er sich nichts weniger zum Ziel, als aus dem ‚Idiotikon‘ einen ‚Thesaurus‘ zu machen, der den Wortschatz des Schweizerdeutschen möglichst vollständig umfassen sollte.“"
                                            },
                                            {
                                                "example_id": "1d55680c-5bba-40fd-a129-1c4d18fbce28",
                                                "sense_id": "f8ca4814-1725-3077-bd8e-788e3d77baf4",
                                                "text": "„Da das Jenische fast ausnahmslos gesprochensprachlich existiert, päsentieren die publizierten Wörterbücher (Idiotika) üblicherweise immer sämtliche belegten Schreibvarianten, die versuchen, die dialektale (selten eine standarddeutsche) Aussprache der sondersprachlichen Wörter mit den orthographischen Mitteln des Deutschen wiederzugeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b68a388-1570-37f2-ad4b-4326522be5d1",
                                        "entry_id": "b8185953-b0f9-3678-a2ff-2b0e716fafdb",
                                        "glosses": [
                                            "kurz für Schweizerisches Idiotikon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b6a8db-ec04-4770-be7b-d20e15cbcf23",
                                                "sense_id": "0b68a388-1570-37f2-ad4b-4326522be5d1",
                                                "text": "„Sie stellten dabei die von Christoph Landolt erarbeitete Machbarkeitsstudie zum Projekt eines Kurz- oder Volkswörterbuchs des Idiotikons vor.“"
                                            },
                                            {
                                                "example_id": "c0499b7d-52c2-4723-8491-eeffdb4e907a",
                                                "sense_id": "0b68a388-1570-37f2-ad4b-4326522be5d1",
                                                "text": "„Die Kartoffel – und warum man im Idiotikon den Kochherd nicht findet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
