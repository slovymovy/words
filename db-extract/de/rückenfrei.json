                "senses": [
                    {
                        "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                        "entry_id": "1cfbb7af-c345-3b6a-885a-665bf3c780cb",
                        "glosses": [
                            "den größten Teil des Rückens unbedeckt lassend"
                        ],
                        "tags": [
                            "Mode",
                            "Bekleidung",
                            "von Kleidern"
                        ],
                        "examples": [
                            {
                                "example_id": "09d0f0ef-2c2b-48c6-8df0-9cc100cd919d",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "Noch etwas unbeholfen legt der Gewerkschafter seinen Arm um die Schulter der neuen Partnerin, tastet unsicher über ihre Haut, sie trägt das blaue T-Shirt rückenfrei."
                            },
                            {
                                "example_id": "cdd6ebc9-0085-43d6-bebd-b12422971fe4",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "Die meisten gläubigen Muslimas würden weder ein langes Kleid mit Schlitz noch rückenfreie oder ärmellose Oberteile tragen."
                            },
                            {
                                "example_id": "3b54afc5-04cd-4033-bca9-1a8ca39604f3",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "Trotz eisiger Temperaturen kam Model Jourdan Dunn arm- und rückenfrei."
                            },
                            {
                                "example_id": "0fcbea49-79fb-447e-8658-1bc4ccb033d0",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "Als zu freizügig [für den Besuch von Ankor Wat] werden nach Angaben eines Sprechers sehr kurze Hosen und Röcke oder rückenfreie T-Shirts gewertet."
                            },
                            {
                                "example_id": "0e47fffd-e93b-4c78-bd58-03d72da88446",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "In dem Film „Der große Blonde mit dem schwarzen Schuh“ aus dem Jahr 1972 trug die Hauptdarstellerin Mireille Darc ein inzwischen ikonisches rückenfreies Kleid."
                            },
                            {
                                "example_id": "a652dff7-b987-4b8a-b5f2-8699bf1a5067",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "Ein weiteres landestypisches Kleidungsstück ist das Áo Yếm […], ein von einem Nackenband gehaltenes rückenfreies Oberteil, welches von Frauen aller Klassen meist als Untergewand getragen wurde."
                            },
                            {
                                "example_id": "b5759d1a-6942-43b4-a292-82e8cad1f639",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "[Er ist] verblüfft, als sich herausstellt, dass Jan die attraktive Blondine ist, die eines Abends in einem sehr rückenfreien Kleid auf der Tanzfläche eines Nachtclubs an ihm vorbeischwebt."
                            },
                            {
                                "example_id": "057ee0c1-2a6d-4fdd-a7dd-dab93c72f3fd",
                                "sense_id": "bf82dcf4-a3e3-35a1-b95c-42048f19a947",
                                "text": "Zwischen 1920 und 1930 präsentierte sich eine neue, zumeist als frech oder gar als unmoralisch angesehene Bademode mit rückenfreier Badekleidung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
