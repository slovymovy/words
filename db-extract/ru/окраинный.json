                            "short-form"
                        ],
                        "form": "окра́инны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a35309f3-37de-3d5d-9adf-f04880b1470d",
                        "entry_id": "853170e5-2a7f-3275-9f5b-6cd80c4e510f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным окраина; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "417f1e51-a358-4cc8-b2b9-23fb95d3ef0b",
                                "sense_id": "a35309f3-37de-3d5d-9adf-f04880b1470d",
                                "text": "Притоны, вероятно, и тут были, но чаще там просто окраинная беднота за копейки пускала на ночлег〈…〉"
                            }
                        ]
                    },
                    {
                        "sense_id": "f95acc80-17c4-3213-82e9-572cda73b08c",
                        "entry_id": "853170e5-2a7f-3275-9f5b-6cd80c4e510f",
                        "glosses": [
                            "находящийся на окраине, окраинах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deabe520-1fce-4a55-a6eb-857203c66179",
                                "sense_id": "f95acc80-17c4-3213-82e9-572cda73b08c",
                                "text": "Как город новый и окраинный, Москва досталась одной из младших линий Всеволодова племени."
                            },
                            {
                                "example_id": "48d4a63b-ff0b-4398-aae5-ffbf755b5d5e",
                                "sense_id": "f95acc80-17c4-3213-82e9-572cda73b08c",
                                "text": "Иду я вдоль длинного забора по окраинной улице, поросшей зеленой травой."
                            },
                            {
                                "example_id": "c41f7cb5-a0c8-49d2-bd7a-bbdecd868833",
                                "sense_id": "f95acc80-17c4-3213-82e9-572cda73b08c",
                                "text": "За поляной снова пошёл лес, который тянулся, постепенно редея и мельчая, почти до подножия окраинного обрыва."
                            },
                            {
                                "example_id": "ed3bfd88-4483-42f2-b78c-35568f6e3360",
                                "sense_id": "f95acc80-17c4-3213-82e9-572cda73b08c",
                                "text": "Его отчислили от гвардии, лишили флигель-адъютантства и перевели с тем же чином в окраинную армию."
                            }
                        ]
                    }
                ],
