                {
                    "sense_id": "0e1ccc7b-b7ac-3425-a915-215d26e93db1",
                    "sense_definition": "Een fysieke of denkbeeldige grens die twee gebieden van elkaar scheidt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er loopt een duidelijke <w>scheidslijn</w> tussen de twee landen.",
                            "target_lang_translations": {
                                "en": "There is a clear <w>dividing line</w> between the two countries."
                            }
                        },
                        {
                            "text": "Ze spreken af vlak bij de <w>scheidslijn</w> om de problemen te bespreken.",
                            "target_lang_translations": {
                                "en": "They agree to meet near the <w>borderline</w> to discuss the problems."
                            }
                        }
                    ],
                    "synonyms": [
