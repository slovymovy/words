        "nl-extract.jsonl": [
            {
                "entry_id": "b6780fc5-daad-390e-8afa-8d9c8cf9ba91",
                "word": "windenergie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c79b413a-6b15-398d-a346-28e3d5960561",
                        "entry_id": "b6780fc5-daad-390e-8afa-8d9c8cf9ba91",
                        "glosses": [
                            "in de meest algemene betekenis is windenergie de energie die gewonnen wordt door de bewegingsenergie van de wind om te zetten in een bruikbare vorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac443462-7ed4-428d-8e4c-eb652f5f4bbb",
                                "sense_id": "c79b413a-6b15-398d-a346-28e3d5960561",
                                "text": "In het regeerakkoord en het Klimaatakkoord (2019) is afgesproken om het beleid van windenergie op zee door te zetten. In 2030 moet er daardoor 11 GW aan windparken op zee staan. Deze leveren dan 8,5% van alle energie in Nederland en 40% van het HUIDIGE elektriciteitsverbruik (in 2019)."
                            },
                            {
                                "example_id": "01b4ce55-7486-4d19-82f3-5ce475c4cc36",
                                "sense_id": "c79b413a-6b15-398d-a346-28e3d5960561",
                                "text": "Voor de Nederlandse kust staan nu al 462 windmolens. Tot 2030 komen daar nog zeker 750 bij en daarna mogelijk nog meer. In 2030 komt 70 procent van het Nederlandse elektriciteitsverbruik uit wind- en zonne-energie. Meer dan de helft daarvan zal van windenergie op zee komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51f7a44e-4382-4ccd-b2b2-2d7ede32d631",
                        "source_entry_id": "b6780fc5-daad-390e-8afa-8d9c8cf9ba91",
                        "source_sense_id": "c79b413a-6b15-398d-a346-28e3d5960561",
