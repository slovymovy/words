                "senses": [
                    {
                        "sense_id": "8f7cfce1-2408-331a-9013-a893eb01f776",
                        "entry_id": "021ffee9-5d7c-3e34-b9d8-d301becdca3b",
                        "glosses": [
                            "zeitlicher Abschnitt in der Entwicklung einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8767d7f0-e960-479c-ad49-e79c3ec71c8a",
                                "sense_id": "8f7cfce1-2408-331a-9013-a893eb01f776",
                                "text": "„Der genannte große Silbenschwund im Übergang zu der altnordischen Sprachperiode erklärt es auch, daß so gut wie alle älteren Verse damals ihre Form verlieren mußten und höchstens solche die große Wandlung überdauern konnten, in denen die Silbenzahl von geringer Bedeutung war.“"
                            },
                            {
                                "example_id": "e9582051-867c-47d6-9f79-f503e435016f",
                                "sense_id": "8f7cfce1-2408-331a-9013-a893eb01f776",
                                "text": "„Diese Abschwächung begann bereits gegen Ende der althochdeutschen Sprachperiode, setzte sich aber erst im folgenden Sprachzeitraum voll durch.“"
                            },
                            {
                                "example_id": "e95edadd-2287-472c-b3ab-615878f6c73b",
                                "sense_id": "8f7cfce1-2408-331a-9013-a893eb01f776",
                                "text": "„Bei allen Periodisierungen ist zu bedenken, dass sich sprachliche Veränderungen nicht einheitlich und schlagartig vollziehen und dass dementsprechend die Grenzen zwischen den Sprachperioden fließend sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
