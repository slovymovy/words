                                    {
                                        "sense_id": "0a51c6b8-344f-30dd-91aa-a1ebfbeb2b40",
                                        "entry_id": "457577fc-bb38-38ff-b19a-6a4c40dbc17e",
                                        "glosses": [
                                            "Année qui se termine par 70, par exemple 1970."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ced1ec-310f-4d55-8811-0e3aed0a45b6",
                                                "sense_id": "0a51c6b8-344f-30dd-91aa-a1ebfbeb2b40",
                                                "text": "Ce film musical nous baigne dans les années soixante-dix avec tout ce qu'il y a de plus kitch ; mais comme souvent, certains films comme celui-ci, qualifiés de « nanards » par les critiques, deviennent incontournables après leur sortie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa8f4c86-cdd6-4071-af1e-5a6cf903bc46",
                        "source_entry_id": "cd54192f-443e-338a-a96f-c9243d6c03ca",
                        "source_sense_id": "a5f2e5da-e734-340d-8ae8-aa704c6654ca",
