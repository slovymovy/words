                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48949a79-606a-485c-85e9-f8f524ed1403",
                                "sense_id": "dcb45212-4cdd-318b-a4d8-e3ef7c06c53c",
                                "text": "But there can be no doubt that John Scarborough and Ada Sneyd were married at Rummelsburg, and that it will be found to be impossible to unmarry them."
                            },
                            {
                                "example_id": "961000b8-983f-45f9-a3c3-a2a997d85ef9",
                                "sense_id": "dcb45212-4cdd-318b-a4d8-e3ef7c06c53c",
                                "text": "If you like to exercise your authority I'll run away and you can't unmarry me."
                            }
                        ]
                    }
