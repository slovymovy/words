    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f350095c-a2d9-3154-8252-0a8db5d907ee",
                "word": "Sahel",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "522c0730-c9cc-3308-b66a-c2f2fd6b4391",
                        "entry_id": "f350095c-a2d9-3154-8252-0a8db5d907ee",
                        "glosses": [
                            "A region of Africa, between the Sahara to the north and a more humid zone (Sudan) to the south."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3270b8b2-fec4-430c-b92b-55ffa7205a9b",
                                "sense_id": "522c0730-c9cc-3308-b66a-c2f2fd6b4391",
                                "text": "As Russia’s foothold in Africa expands – notably in the mineral-rich Sahel region that is beset by recurring coups, armed rebellion and extremist insurgency – anti-Western sentiments, partly fueled by Russian propaganda, are engineering the exit of Western troops from swathes of territory."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b49bac1-ccbd-3911-bd1c-cf2a0c35abf1",
                        "entry_id": "f350095c-a2d9-3154-8252-0a8db5d907ee",
                        "glosses": [
                            "An administrative region of Tunisia, in the central east part of the country."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7c261a2-5113-4319-ad47-cb21a3f1069d",
                        "source_entry_id": "f350095c-a2d9-3154-8252-0a8db5d907ee",
                        "source_sense_description": "A region in Africa",
                        "target_lang_word": "Sahelzone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sahelzone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c817553e-ba42-39a3-bb65-c2c35cf29757",
                                        "entry_id": "4bec0828-f13c-3ffb-8822-f0ac60c5e52c",
                                        "glosses": [
                                            "Gebiet, das sich von West nach Ost südlich der Sahara erstreckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1fa2cf-af2d-45c6-8783-138c88b5c849",
                                                "sense_id": "c817553e-ba42-39a3-bb65-c2c35cf29757",
                                                "text": "„Französische Streitkräfte unterstützen regionale Truppen in der Sahelzone, einschließlich Burkina Faso, gegen islamistische extremistische Gruppen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daa9f6de-0bf0-4310-a1bc-7053b50b8686",
                        "source_entry_id": "f350095c-a2d9-3154-8252-0a8db5d907ee",
                        "source_sense_description": "A region in Africa",
                        "target_lang_word": "Sahel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sahel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2518e03-7da0-3032-a7eb-9ec058ccf081",
                                        "entry_id": "ea84eb30-98de-3123-bf3d-a9d901825165",
                                        "glosses": [
                                            "dünnbesiedelter, breiter Randbereich von West- nach Ostafrika südlich der Sahara"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d63559-38a2-450f-9b7a-5304ed54c19c",
                                                "sense_id": "a2518e03-7da0-3032-a7eb-9ec058ccf081",
                                                "text": "„Ein rettendes Ufer, das war der Sahel für die Wüstenbewohner, denn dort gab es Wasser, Hirse, Weiden, dort begegneten sich hellhäutige, nomadische Viehzüchter und negride Bauern und Städter, dort trafen moslemische auf uralte schwarzafrikanische Glaubensvorstellungen.“"
                                            },
                                            {
                                                "example_id": "32bb0d40-1f5c-4947-90a9-26adea4d6aa4",
                                                "sense_id": "a2518e03-7da0-3032-a7eb-9ec058ccf081",
                                                "text": "„Der Tourismus, der einzige nennenswerte Wirtschaftszweig im dünn besiedelten Sahel, ist längst eingebrochen.“"
                                            },
                                            {
                                                "example_id": "5a1cff7f-8bdc-485a-96b0-b425a426df2a",
                                                "sense_id": "a2518e03-7da0-3032-a7eb-9ec058ccf081",
                                                "text": "„Nachdem die dschihadistischen Gruppen aus ihren Entstehungsgebieten in Algerien weitgehend vertrieben worden waren, verbreiteten sie sich im Sahel und formten militärische Strukturen nach dem Muster der somalischen al-Shabaab oder des Islamischen Staats (IS) in Syrien und im Irak.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b1be8b9-8f43-3ce3-a315-9220889f3f8a",
                                        "entry_id": "ea84eb30-98de-3123-bf3d-a9d901825165",
                                        "glosses": [
                                            "dichtbesiedelte, östliche Küstenlandschaft von Tunesien (im engeren Sinne ist damit nur das Hinterland des Golfes von Hammamet gemeint)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6729d1d-1f28-4cfd-b9fc-870594e8b416",
                                                "sense_id": "8b1be8b9-8f43-3ce3-a315-9220889f3f8a",
                                                "text": "„Solche Ostlagen (‚Chergui‘-Lagen, die sehr häufig dem östlichen Zentraltunesien, besonders dem Sahel, Niederschläge bringen) gehören zum typischen Wettergeschehen Tunesiens und wurden als solche vielfach beschrieben (…).“"
                                            },
                                            {
                                                "example_id": "d51e7871-584d-4448-b91b-ee7a155efbf5",
                                                "sense_id": "8b1be8b9-8f43-3ce3-a315-9220889f3f8a",
                                                "text": "„Wohnhöhlen im Fels sollten einst vor Überfällen schützen Jenseits der Zentraltunesischen Steppe und des Sahel von Sfax beginnen die Weiten des Grand Sud.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "578d29ef-9469-3a41-90b3-99075bedf944",
                                        "entry_id": "ea84eb30-98de-3123-bf3d-a9d901825165",
                                        "glosses": [
                                            "Algeriens zentrale Küstenlandschaft samt deren Hinterland, besonders im Bereich der Kabylei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c4fa22-bf27-4fa3-b287-5acb3ed52ac5",
                                                "sense_id": "578d29ef-9469-3a41-90b3-99075bedf944",
                                                "text": "„Amphitheatralisch steigt die Hauptstadt Algeriens aus einer riesigen, halbmondförmigen Bucht an den Hängen des Sahels empor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
