        "fr-extract.jsonl": [
            {
                "entry_id": "3864a895-8fc1-3bb8-a871-0a1afe4e8c8e",
                "word": "hétéroside",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "424a7338-69ea-4329-8010-f43622d8a3c4",
