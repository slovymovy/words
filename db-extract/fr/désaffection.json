                                        "examples": [
                                            {
                                                "example_id": "759906ff-e239-4518-b8fb-67cc8df1ab5c",
                                                "sense_id": "4da1b673-1ffe-37df-906b-f817d7fb27f9",
                                                "text": "Hij keek met volledige desinteresse naar het curlen want hij begreep er helemaal niets van."
                                            },
                                            {
                                                "example_id": "0072e6aa-6f03-45db-834c-3e693762a148",
                                                "sense_id": "4da1b673-1ffe-37df-906b-f817d7fb27f9",
                                                "text": "'Pieter schrok zich dood toen ik hem vertelde dat ik zijn e-mail had gelezen,' ging Heleen op een toon verder waaruit eerder desinteresse dan passie klonk."
                                            },
                                            {
                                                "example_id": "00ba9e43-6516-44b2-a089-333118feeaad",
                                                "sense_id": "4da1b673-1ffe-37df-906b-f817d7fb27f9",
                                                "text": "Daardoor kwam de verantwoordelijkheid voor het huis en het land ook grotendeels neer op de schouders van de kamerheer. Geoffrey Poke had zich al stevig geïnstalleerd aan de top van de hiërarchie van de bedienden toen Emont lord werd, en de combinatie van Geoffreys zucht naar macht en Emonts desinteresse gaf hem de gelegenheid om zijn positie verder uit te breiden."
                                            }
                                        ]
