                "translations": [
                    {
                        "translation_id": "1a334116-0c51-4e0c-9c2b-18c3e88bf0c0",
                        "source_entry_id": "db212358-7b77-398d-a0ba-cf3d42e5dbaa",
                        "source_sense_id": "625b3d14-5f88-34d7-b9f2-d56b7b94989b",
                        "target_lang_word": "Schatulle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schatulle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2316e81a-db2f-3faa-b148-122192b5e00d",
                                        "entry_id": "a8dd2bd4-52fe-316e-9375-591b1bd091d8",
                                        "glosses": [
                                            "kleiner verschließbarer Kasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93ffc92-c501-4ed6-abd1-67f918207ec2",
                                                "sense_id": "2316e81a-db2f-3faa-b148-122192b5e00d",
                                                "text": "Sie hatte aus der Schatulle ein kleines Holzbüchschen mit weißer Salbe und frische Watte ausgekramt."
                                            },
                                            {
                                                "example_id": "bd4d84bf-6e86-4167-9867-2b21e4ab12a6",
                                                "sense_id": "2316e81a-db2f-3faa-b148-122192b5e00d",
                                                "text": "„Vor allem mit Kaffee und Zucker füllten eine halbe Million Schwarze, neun Zehntel der Bevölkerung, die Schatullen der fernen Kolonialmacht Frankreich.“"
                                            },
                                            {
                                                "example_id": "0dc67768-6c50-4e3d-8997-41354df5a80a",
                                                "sense_id": "2316e81a-db2f-3faa-b148-122192b5e00d",
                                                "text": "„Da hab ich meine alte Uniform aus dem Mottenschrank geholt und den verjährten Marschbefehl aus der Schatulle.“"
                                            },
                                            {
                                                "example_id": "fa49c2c9-ac06-4fa6-a705-aabb0b9d6b03",
                                                "sense_id": "2316e81a-db2f-3faa-b148-122192b5e00d",
                                                "text": "„Er lud die Staffelei, die Mappe mit den Bildern und die Schatulle mit den Malutensilien auf den Fahrradanhänger, den er aus Brettern und Rädern von einem Kinderfahrrad zusammengebaut hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
