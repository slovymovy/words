                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578eb93b-b677-32cc-8e22-a01414be3acd",
                                        "entry_id": "a56f169f-efaf-31f5-8d36-726caeec702b",
                                        "glosses": [
                                            "A washing, especially of the skin for the purpose of beautification."
                                        ],
                                        "tags": [
                                            "archaic",
