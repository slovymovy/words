                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a324c10-1ce2-321e-908a-ff55a7652af3",
                        "entry_id": "88060a3b-ba68-37dc-94c6-3c956fc2717f",
                        "glosses": [
                            "denkbeeldige ernstige aandoening"
                        ],
                        "tags": [
                            "Jiddisch-Hebreeuws",
                            "gebruikt om werkwoorden kracht bij te zetten of in een verwensing"
                        ],
                        "examples": [
                            {
                                "example_id": "6424ec94-db93-4a9d-b716-86bd30d167bf",
                                "sense_id": "4a324c10-1ce2-321e-908a-ff55a7652af3",
                                "text": "Maar op een kwaaie dag schrikt Neeson zich het rambam wanneer hij routineus de hotelkamer binnendringt met zijn camera: het te 'betrappen' paar, waarvan zijn eega de vrouwelijke rol dus speelt, blijkt gruwelijk vermoord te zijn."
                            },
                            {
                                "example_id": "50a9c3b3-9cf7-4323-8ca5-b8a1a4df3a61",
                                "sense_id": "4a324c10-1ce2-321e-908a-ff55a7652af3",
                                "text": "De spelers hebben zich voor de Olympische Spelen werkelijk de rambam getraind."
                            },
                            {
                                "example_id": "ba8bc426-18c6-4387-8f6d-6ef3affcb902",
                                "sense_id": "4a324c10-1ce2-321e-908a-ff55a7652af3",
                                "text": "De rambam voor 'm met z'n tuintje d'rbij,’ vloekte Scheeltje, (…)"
                            },
                            {
                                "example_id": "2da346ad-f4c2-4528-b58d-7535c2fc6af4",
                                "sense_id": "4a324c10-1ce2-321e-908a-ff55a7652af3",
                                "text": "Tante Kee blij, lachte zich het rambam."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8d29817-c5a3-3a67-8812-abd373decd1c",
                        "entry_id": "88060a3b-ba68-37dc-94c6-3c956fc2717f",
                        "glosses": [
                            "verzameling van zaken waaraan weinig waarde wordt gehecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce8f016-07f1-4dd4-816f-51ea72d6d222",
                                "sense_id": "b8d29817-c5a3-3a67-8812-abd373decd1c",
                                "text": "Het lijkt er zo'n beetje op dat iedere auteur zo langzamerhand niet zonder een hoeveelheid vaak overbodige statistische rambam kan als hij zijn onderzoeksresultaten publiceert."
                            },
                            {
                                "example_id": "86fa8b91-ffb8-44fb-ae42-08b6f954a6ae",
                                "sense_id": "b8d29817-c5a3-3a67-8812-abd373decd1c",
                                "text": "Je kunt niet zomaar je cultuurei kwijt; je moet geld hebben, je moet een kantoor hebben, een zaal, de hele rambam."
                            }
                        ]
                    }
