                "senses": [
                    {
                        "sense_id": "2e01c658-3a2c-3d33-b8af-ead2326f934b",
                        "entry_id": "791ecec5-bb7f-34dc-a969-fca05fb95891",
                        "glosses": [
                            "разг. вещевой рынок; место на рынке, где торгуют барахлом"
