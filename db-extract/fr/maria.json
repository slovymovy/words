                        "glosses": [
                            "Prénom féminin, version « latine » de Marie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134c30d4-ebb1-4c3c-ba0c-9d978829b803",
                                "sense_id": "4b03cbcc-cbf0-3b95-a5c3-0f38a4e8e4a6",
                                "text": "Toi la servante toi la Maria\n Vaudrait p'têt' mieux changer nos draps\n Mathilde est revenue."
                            },
                            {
                                "example_id": "1aa9cc98-aa71-4225-83aa-741da7d72fa3",
                                "sense_id": "4b03cbcc-cbf0-3b95-a5c3-0f38a4e8e4a6",
                                "text": "Maria, une rouquine du Berry, vint adoucir mon chagrin, sans l’effacer."
                            },
                            {
                                "example_id": "a6d5b371-a2b1-4445-a030-7ce10d91324e",
                                "sense_id": "4b03cbcc-cbf0-3b95-a5c3-0f38a4e8e4a6",
                                "text": "Journaliste depuis près de quarante ans, récompensée du prix Nobel de la paix en 2021, Maria Ressa a été une des premières voix à dénoncer sans relâche le manque de transparence des réseaux sociaux, les manipulations qui s’y jouent et leur impact sur la démocratie et les électeurs."
                            }
                        ]
                    }
                ],
