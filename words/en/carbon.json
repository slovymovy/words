                {
                    "sense_id": "e9be00ea-b324-3bc0-82e0-9f2c56d7355a",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Carbon</w> has been working at the firm for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Карбон</w> работает в фирме уже более двадцати лет.",
                                "zh": "卡本先生在这家公司工作已经超过二十年了。"
                            }
                        },
                        {
                            "text": "We are looking for a file belonging to a patient named <w>Carbon</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем карту пациента по фамилии <w>Карбон</w>.",
                                "zh": "我们正在寻找一份属于一位名叫卡本的病人的档案。"
                            }
                        }
