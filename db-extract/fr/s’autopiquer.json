                "senses": [
                    {
                        "sense_id": "c60d2462-206f-3d61-b70a-a97637cf32d5",
                        "entry_id": "998eeebd-e4d2-306d-854c-d04aa0d6c666",
                        "glosses": [
                            "Se piquer soi-même (avec une seringue, ou autrement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b55fcc-f83f-49bf-a91d-2fe15e0d84dc",
                                "sense_id": "c60d2462-206f-3d61-b70a-a97637cf32d5",
                                "text": "C'est quand même pas lui qui s'est autopiqué avec ce produit ?"
                            },
                            {
                                "example_id": "56e844e3-94c6-417f-afa5-07f03a7592bd",
                                "sense_id": "c60d2462-206f-3d61-b70a-a97637cf32d5",
                                "text": "Piqure qui a laissé une marque tellement je semble douée pour m'autopiquer..."
                            },
                            {
                                "example_id": "78edcbe4-1bba-4233-b0df-fabd0323e03e",
                                "sense_id": "c60d2462-206f-3d61-b70a-a97637cf32d5",
                                "text": "Et bien, vous connaissez la seule maladroite qui s'autopique comme une débile ?!"
                            },
                            {
                                "example_id": "f0260e47-753b-4aee-817e-703c6d5c61e4",
                                "sense_id": "c60d2462-206f-3d61-b70a-a97637cf32d5",
                                "text": "Mais ces oiseaux ont la mauvaise habitude de se piquer voir de s'autopiquer."
                            }
                        ]
                    }
                ],
