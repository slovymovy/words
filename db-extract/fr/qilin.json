                    },
                    {
                        "translation_id": "9cefe59c-266d-4e1a-a840-f7f38086afbe",
                        "source_entry_id": "54ffe108-a556-3329-aea2-a3028efe08e2",
                        "source_sense_id": "5dd45ea3-5dfd-33f3-a0f1-e77f7f8ccdfb",
                        "target_lang_word": "麒麟",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "麒麟",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "66b7419f-e195-388e-b2d3-c736dcb0ca48",
                                        "entry_id": "9e2f225a-f058-3f39-a55f-210285a8875f",
                                        "glosses": [
                                            "中國古代傳說中的一種動物。麒為雄獸，麟為雌獸；泛稱麒麟。亦單稱麟。形似獐，獨角，身上有鱗甲，尾似牛。古時被作為吉祥的象徵，四靈之一。"
                                        ],
                                        "tags": [
                                            "中國神話"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd65b0c-7535-40a6-8a3b-62514c7dd119",
                                                "sense_id": "66b7419f-e195-388e-b2d3-c736dcb0ca48",
                                                "text": "《管子‧封禪》：“今鳳凰麒麟不來，嘉穀不生，而蓬蒿藜莠茂，鴟梟數至，而欲封禪，毋乃不可乎，於是桓公乃止。”"
                                            },
                                            {
                                                "example_id": "6f431b08-ab45-40d3-887e-b1360a16d6f0",
                                                "sense_id": "66b7419f-e195-388e-b2d3-c736dcb0ca48",
                                                "text": "豈惟民哉？麒麟之於走獸，鳳凰之於飛鳥，太山之於丘垤，河海之於行潦，類也。",
                                                "translation": "豈止是人類才有這樣的不同？麒麟對於走獸，鳳凰對於飛鳥，泰山對於土丘，河海對於水溝，都是同類的。"
                                            },
                                            {
                                                "example_id": "15a36297-14b6-43f1-ba14-1e705284b7f7",
                                                "sense_id": "66b7419f-e195-388e-b2d3-c736dcb0ca48",
                                                "text": "岂惟民哉？麒麟之于走兽，凤凰之于飞鸟，太山之于丘垤，河海之于行潦，类也。",
                                                "translation": "豈止是人類才有這樣的不同？麒麟對於走獸，鳳凰對於飛鳥，泰山對於土丘，河海對於水溝，都是同類的。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa53bdb-f7f1-3f76-a2b2-5cac2a0e157d",
                                        "entry_id": "9e2f225a-f058-3f39-a55f-210285a8875f",
                                        "glosses": [
                                            "豪傑"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b49255b9-c016-4199-95fe-9f6f3ffb4cf8",
                                                "sense_id": "5aa53bdb-f7f1-3f76-a2b2-5cac2a0e157d",
                                                "text": "《晉書‧顧和傳》：“和二歲喪父，總角便有清操，族叔榮雅重之，曰：‘此吾家麒麟，興吾宗者，必此人也。’”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48b18e5e-a141-3577-8c30-d5cba21a171b",
                                        "entry_id": "9e2f225a-f058-3f39-a55f-210285a8875f",
                                        "glosses": [
                                            "長頸鹿"
                                        ],
                                        "tags": [
                                            "Taiwanese",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26d5b5e0-6edb-4b33-b1c5-d06131f3cfc3",
                                                "sense_id": "48b18e5e-a141-3577-8c30-d5cba21a171b",
                                                "text": "《明史·榜葛剌傳》：“永樂六年，其王靄牙思丁遣使來朝，貢方物，齎賜有差。七年，其使凡再至，攜從者二百三十餘人。帝方招徠絕域，頒賜甚厚。自是比年入貢。十年，貢使將至，遣官宴之於鎮江。既將事，使者告其王之喪，遣官往祭，封次子賽勿丁為王。十二年，嗣王遣使奉表來謝，貢麒麟及名馬方物。”"
                                            },
                                            {
                                                "example_id": "0ba370ac-20b1-4e31-8760-10de12e009df",
                                                "sense_id": "48b18e5e-a141-3577-8c30-d5cba21a171b",
                                                "text": "夏原吉《麒麟賦·序文》：“永樂十二年秋，榜葛剌國來朝，獻麒麟。今年秋麻林國復以麒麟來獻，其形色與古之傳記所載及前所獻者無異。……今兩歲之間而茲瑞載至，則盛德之隆，天眷之至，實前古未之有也。”"
                                            },
                                            {
                                                "example_id": "22e4c35b-a2fb-4317-b402-1a8b615ffcbf",
                                                "sense_id": "48b18e5e-a141-3577-8c30-d5cba21a171b",
                                                "text": "馬歡《瀛涯勝覽·忽魯謨廝》：“國王亦將船隻載獅子、麒麟、馬疋、珠子、寶石等物，并金葉表文，差其頭目人等，跟隨欽差西洋回還寶船，赴闕進貢。”"
                                            }
                                        ]
                                    }
                                ]
                            },
