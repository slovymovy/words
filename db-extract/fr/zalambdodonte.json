                        "examples": [
                            {
                                "example_id": "c59abe70-8e1f-4ce5-b9aa-8e799f812c36",
                                "sense_id": "3ab7965d-91d7-3e9a-9fc8-92d7f455a7c2",
                                "text": "À la molaire supérieure, le mésiocône, l'anticône et l'anticrête ne jouent pas de rôle essentiel, sinon, pour les deux derniers, à la molaire zalambdodonte, où ils donnent lieu à un véritable phénomène de symétrisation."
                            }
