                ],
                "senses": [
                    {
                        "sense_id": "a9266f3f-4791-3303-a566-4887f2bafaa7",
                        "entry_id": "1024d0f1-3267-3cdb-a72d-54c883eb44d2",
                        "glosses": [
                            "sportlicher Wettkampf zweier Spitzenmannschaften"
                        ],
                        "tags": [
                            "emotional verstärkend"
                        ],
                        "examples": [
                            {
                                "example_id": "b4a59b2a-4ebd-40a0-9a52-d9265a78c6dc",
                                "sense_id": "a9266f3f-4791-3303-a566-4887f2bafaa7",
                                "text": "„Die Partie zwischen PSG und den Monegassen hatte sich das Prädikat Spitzenspiel von Beginn an verdient. Es ging reichlich hin und her, temporeiche Vorstöße inklusive.“"
                            },
                            {
                                "example_id": "fba84d81-65d6-4487-9580-aa015bd6a6f0",
                                "sense_id": "a9266f3f-4791-3303-a566-4887f2bafaa7",
                                "text": "„Das Spiel zwischen den Bayern und dem BVB am Samstagabend ist nach wie vor unbestreitbar ein Spitzenspiel, was man nicht zuletzt daran merkt, dass es in 208 von 209 FIFA-Ländern übertragen wird.“"
                            },
                            {
                                "example_id": "6217918a-dd77-466c-8005-f26d561f8e99",
                                "sense_id": "a9266f3f-4791-3303-a566-4887f2bafaa7",
                                "text": "„Der FC Bayern München hat das Spitzenspiel gegen Werder Bremen mit 3:1 für sich entschieden und bleibt somit weiterhin das Maß aller Dinge in der Bundesliga.“"
                            },
                            {
                                "example_id": "70794bc9-8df7-417c-9b87-68aa0048732d",
                                "sense_id": "a9266f3f-4791-3303-a566-4887f2bafaa7",
                                "text": "„Nach dem abgebrochenen Spitzenspiel der höchsten türkischen Fußball-Liga gegen Tabellenführer Fenerbahce Istanbul ist Gastgeber Trabzonspor zu sechs ›Geisterspielen‹ verurteilt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4bc9380-8a7e-3dd1-a289-577dbd71f056",
                        "entry_id": "1024d0f1-3267-3cdb-a72d-54c883eb44d2",
                        "glosses": [
                            "Spalt (mechanisches Spiel [6]) der Spitzen von in- beziehungsweise nebeneinander laufenden Maschinenelementen"
                        ],
                        "tags": [
                            "Beispiel: Zahnrad, Rotor, Drehkolben"
                        ],
                        "examples": [
                            {
                                "example_id": "ca4a1b68-2c6c-46e3-b759-d561712bd79e",
                                "sense_id": "a4bc9380-8a7e-3dd1-a289-577dbd71f056",
                                "text": "„Die beiden häufigsten Quellen für interne Leckagen in Drehkolbenpumpen sind das Spitzenspiel und das Stirnflächenspiel.“"
                            },
                            {
                                "example_id": "69682c09-9c69-481a-8c9c-2b3453ae1632",
                                "sense_id": "a4bc9380-8a7e-3dd1-a289-577dbd71f056",
                                "text": "„Spitzenspiel: Wenn zwei Zähne eingerückt sind, der Spalt zwischen dem oberen Kreis eines Ganges und dem unteren des anderen Ganges.“"
                            },
                            {
                                "example_id": "68a77a6f-7e29-4ec3-97b4-6b0abef217fc",
                                "sense_id": "a4bc9380-8a7e-3dd1-a289-577dbd71f056",
                                "text": "„Das Withworth-Gewinde erhält durch diese Vergrößerung des Kernloches ein bisher für das metrische Gewinde bereits vorgeschriebenes Spitzenspiel, wodurch eine gegenüber dem voll ausgeschnittenen Gewinde verbesserte Flankenanlage bewirkt wird.“"
                            },
                            {
                                "example_id": "3ef29842-490f-4ede-8cc4-c36f4e75c81b",
                                "sense_id": "a4bc9380-8a7e-3dd1-a289-577dbd71f056",
                                "text": "„Bei Gewinde mit Spitzenspiel, DIN 260, ist Dichtmittel im Gewinde erforderlich.“"
                            },
                            {
                                "example_id": "89c3afde-49ee-42e9-98f7-b3e68f5908ca",
                                "sense_id": "a4bc9380-8a7e-3dd1-a289-577dbd71f056",
                                "text": "„Unter Spitzenspielen versteht man die Spalte zwischen den Spitzen der Rotorschaufeln und den Gehäusen bzw. zwischen den Leitschaufelspitzen und den Abstandsringen (engl. spacer) des Rotors […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
