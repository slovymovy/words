                                "target_senses": [
                                    {
                                        "sense_id": "2c2e4fea-c44a-3de8-955e-7b6804425452",
                                        "entry_id": "c9af40db-e06c-3abe-b052-df451abd18b7",
                                        "glosses": [
                                            "wijze waarop verschillende personen bij een spel elkaar steunen of een geheel vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285c36a3-0bf1-49d9-b625-b4cb8adc5037",
                                                "sense_id": "2c2e4fea-c44a-3de8-955e-7b6804425452",
                                                "text": "Hij deed mee met het samenspel van die jongens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e69ea975-9b39-4cc0-bb9e-6a1eee263db6",
                        "source_entry_id": "86a14e11-1bd0-30bd-bff6-6f3cfda1d75b",
                        "source_sense_description": "a blowing or fusing together",
                        "target_lang_word": "samensmelting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samensmelting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fe6ceb35-01c2-3985-b29b-75bc4d946238",
                                        "entry_id": "7f90884a-15e0-3764-a56a-b9f8a5910c62",
                                        "glosses": [
                                            "het ineenvloeien van twee of meer zaken tot een zaak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4e3742-46cd-4d47-8cea-1892cd26f60b",
                                                "sense_id": "fe6ceb35-01c2-3985-b29b-75bc4d946238",
                                                "text": "„Deze opstelling oogt knusser. We merkten de laatste jaren dat steeds meer mensen in de open lucht gingen staan. Bleven er 500 man in de tent over. Dat is niet gezellig”, zegt Akkermans. „In de nieuwe opzet mix je meer met elkaar.” Die samensmelting komt vrijdag tijdens het bedrijvenborreluurtje wel heel goed van pas. Daar vieren ondernemers met personeel een eigen feestje."
                                            },
                                            {
                                                "example_id": "0f2bfcdf-8192-4bc0-9747-5d2653dbc4ef",
                                                "sense_id": "fe6ceb35-01c2-3985-b29b-75bc4d946238",
                                                "text": "De onthulling van het logo, vrijdag in aanwezigheid van de leerlingen en ouders, sluit het fusieproces af van de basisschool in de Bornse wijk Stroom Esch. Het betekent de definitieve samensmelting van Het Kompas en ’t Iemnschelf, die verder gaan onder de naam De Optimist. „Nu kunnen we echt gaan bouwen aan de nieuwe school”, zegt Ottink."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
