                                        "entry_id": "0f111147-801b-3918-b32c-bf502ce686d6",
                                        "glosses": [
                                            "To explore, investigate, question, test, or prove."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48c19f7-6796-4d16-b99d-550d0be949d7",
                                                "sense_id": "725472fb-869f-3aa3-a4dd-30fdf859b1a3",
                                                "text": "If you probe further, you may discover different reasons."
                                            },
                                            {
                                                "example_id": "1c24ae6d-cdeb-49ee-9448-f20474d9b563",
                                                "sense_id": "725472fb-869f-3aa3-a4dd-30fdf859b1a3",
                                                "text": "the growing disposition to probe the legality of all acts of the crown"
                                            },
                                            {
                                                "example_id": "1191e34c-bfd8-4429-95cd-9f03c1a6eebe",
                                                "sense_id": "725472fb-869f-3aa3-a4dd-30fdf859b1a3",
                                                "text": "It was exhilarating to watch him share a meal and then probe deeper into the cultures, the politics, and the heartbeat of the people of the city or country he was in. He seemed so learned, but not in any pretentious way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4057a946-86e8-3989-9683-89935b96ac21",
                                        "entry_id": "0f111147-801b-3918-b32c-bf502ce686d6",
                                        "glosses": [
                                            "To insert a probe into."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8622120-dee7-4e54-bbaf-552fed904b1c",
                        "source_entry_id": "358aa327-245a-3c3b-bab7-f3aba3ab5b62",
                        "source_sense_id": "1247db1f-a125-3e7b-96a2-719baf7b52c5",
                        "target_lang_word": "Umfrage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umfrage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2292c558-4155-350c-b1c1-367cac602fbe",
                                        "entry_id": "1eeb051f-ac7e-3f36-b25a-9c6f3d59d949",
                                        "glosses": [
                                            "Befragung einer bestimmten Anzahl von Personen, um einen allgemeinen Meinungsquerschnitt zu erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8003400f-3f62-436e-bab5-92a9bab849cb",
                                                "sense_id": "2292c558-4155-350c-b1c1-367cac602fbe",
                                                "text": "Eine Umfrage ergab, dass 40 % der Befragten keine Marmelade mögen."
                                            },
                                            {
                                                "example_id": "5fc8262a-34c8-48e1-9a10-4ed25403c515",
                                                "sense_id": "2292c558-4155-350c-b1c1-367cac602fbe",
                                                "text": "„In aktuellen Umfragen liegt er in der Beliebtheit der Berlin-Politiker nur noch auf Rang zehn.“"
                                            },
                                            {
                                                "example_id": "dcc747c5-6b1c-40ad-bead-58a0a5604169",
                                                "sense_id": "2292c558-4155-350c-b1c1-367cac602fbe",
                                                "text": "„Nur: Gabriels Erfolge liegen über ein Jahr zurück, und die Umfragen sind seither nicht besser geworden.“"
                                            },
                                            {
                                                "example_id": "8618a47b-0ce7-4fa9-ba5b-1baf79b5b9a5",
                                                "sense_id": "2292c558-4155-350c-b1c1-367cac602fbe",
                                                "text": "„Die Partei verliert zur Zeit in den Umfragen deutlich.“"
                                            },
                                            {
                                                "example_id": "9b301754-4792-45cf-8477-4ef965e8930e",
                                                "sense_id": "2292c558-4155-350c-b1c1-367cac602fbe",
                                                "text": "„Bei neueren Umfragen bestätigen immerhin ein Viertel der Hundehalter, den Hund ins Bett zu lassen bzw. ihn dorthin auch des Nachts mitzunehmen.“"
                                            },
                                            {
                                                "example_id": "b80b0c87-2a58-4027-9b8e-196470c066c4",
                                                "sense_id": "2292c558-4155-350c-b1c1-367cac602fbe",
                                                "text": "„In Umfragen geben über 80 Prozent an, dass sie einen weiteren Ausbau der Windenergie begrüßen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "354443b0-372d-4e01-a2fe-f2a1ac64873e",
