                ],
                "senses": [
                    {
                        "sense_id": "1fc20c73-762d-3501-b86d-a1bddebe787e",
                        "entry_id": "a737a803-844f-3ba9-b697-484902054eb0",
                        "glosses": [
                            "ou Boire (du vin)."
                        ],
                        "tags": [
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "dc5df908-cbc3-48b8-a800-1deb652dcb4d",
                                "sense_id": "1fc20c73-762d-3501-b86d-a1bddebe787e",
                                "text": "Une nouvelle occasion de raisiner quoa !"
                            },
                            {
                                "example_id": "52164d12-87f3-4ff0-8b9d-d5af37e20d10",
                                "sense_id": "1fc20c73-762d-3501-b86d-a1bddebe787e",
                                "text": "Ben moi, si mon portable devait tomber en panne, ben il me resterait que mes yeux pour pleurer et je serais obligé d'aller me raisiner tous les soirs au bar."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7cd36f1-9c5e-3090-b1fb-d99757c951aa",
                        "entry_id": "a737a803-844f-3ba9-b697-484902054eb0",
                        "glosses": [
                            "Saigner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0ec283e2-fd1a-43ae-a7d4-981c8fc89ac0",
                                "sense_id": "c7cd36f1-9c5e-3090-b1fb-d99757c951aa",
                                "text": "Son sang se mit à raisiner à la pointe de son menton, puis une dernière ruade monumentale fit s’écrouler définitivement son édifice carcéral."
                            },
                            {
                                "example_id": "09fa823a-055e-413d-88b0-8aca230f7108",
                                "sense_id": "c7cd36f1-9c5e-3090-b1fb-d99757c951aa",
                                "text": "Je connais au moins un joueur qui parvient à s’ouvrir le cuir chevelu et à raisiner abondamment comme ça, tout seul, sur commande."
                            },
                            {
                                "example_id": "b4149eb5-4bb9-4d02-900b-a7e6c2f78e55",
                                "sense_id": "c7cd36f1-9c5e-3090-b1fb-d99757c951aa",
                                "text": "Le Gros commence à raisiner du blair sur sa belle limouille violine."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd478fec-e3d3-3097-a321-dffe7660b9ed",
                        "entry_id": "a737a803-844f-3ba9-b697-484902054eb0",
                        "glosses": [
                            "Mettre des raisins dans (une préparation culinaire)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3f91d5-2451-4147-8a10-bd2e2102ad03",
                                "sense_id": "bd478fec-e3d3-3097-a321-dffe7660b9ed",
                                "text": "Elle trouva le thé exquis, le cake fondant, beurré, raisiné, fruit-confisé à point."
                            }
                        ]
                    }
