                        "entry_id": "b5ceeeac-392d-3e62-b162-ea3c349ea805",
                        "glosses": [
                            "außerirdische Lebensform, die im Aussehen einer Echse ähnlich sieht"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fa1f1676-69ff-4c57-8847-7329ebbc864c",
                                "sense_id": "528a6268-502e-366a-8ec9-ee9d4b411048",
                                "text": "„Auch sie waren alle Reptiloiden in menschlicher Gestalt, die Missionen wie diese sehr oft übernahmen und alle mit Erfolg beendeten.“"
                            },
                            {
                                "example_id": "81cdf928-f6b7-4aa7-b2f2-c26c6d2614cd",
                                "sense_id": "528a6268-502e-366a-8ec9-ee9d4b411048",
                                "text": "„Nur eine kleine Gruppe von Menschen war David Oak zufolge in der Lage, die Reptiloiden zu durchschauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
