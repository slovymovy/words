                "senses": [
                    {
                        "sense_id": "90b9f518-582c-3a6e-8850-d2d5908c073d",
                        "entry_id": "c61e77cf-98a9-354a-ae79-5f7758335e6e",
                        "glosses": [
                            "искусств. стенная живопись по сырой штукатурке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe63f94-cbcf-460a-97f1-1504b5833123",
                                "sense_id": "90b9f518-582c-3a6e-8850-d2d5908c073d",
                                "text": "Palazzo Pitti стоит на холме; дом не весьма большой, но великолепно меблированный, и две залы росписаны альфреско с удивительным искусством."
                            },
                            {
                                "example_id": "7df5f3d3-ed61-4bb6-82d6-25412cdefbdb",
                                "sense_id": "90b9f518-582c-3a6e-8850-d2d5908c073d",
                                "text": "На черной неподвижной массе, составляющей готовую стену для наших альфреско ― пишите, что хотите ― все сделается страшно резко, страшно впечатлительно, однакож это не настоящая драма и отличается от нее как убийство от поединка или торговая казнь от турнира."
                            }
                        ]
                    }
