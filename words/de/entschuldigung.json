    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50c036a4-6967-32d2-9402-0c53f4341aa4",
                    "sense_definition": "Mündliche oder schriftliche Erklärung des Bedauerns über einen begangenen Fehler",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er bat aufrichtig um <w>Entschuldigung</w> für seine unbedachten Worte."
                        },
                        {
                            "text": "Sie hat seine höfliche <w>Entschuldigung</w> ohne jedes Zögern angenommen."
                        }
                    ],
                    "common_phrases": [
                        "um Entschuldigung bitten",
                        "eine Entschuldigung annehmen"
                    ]
                },
                {
                    "sense_id": "f00660bd-3193-3c72-a4f5-e235c52c54e5",
                    "sense_definition": "Begründung oder Rechtfertigung, die das eigene Fehlverhalten erklären oder mildern soll",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für ein solch unfreundliches Verhalten gibt es wirklich keine <w>Entschuldigung</w>."
                        },
                        {
                            "text": "Das ist doch wieder nur eine faule <w>Entschuldigung</w> von dir."
                        }
                    ],
                    "common_phrases": [
                        "eine faule Entschuldigung"
                    ]
                },
                {
                    "sense_id": "e6c6cb61-38bb-3b0a-a1de-c5b39742df3b",
                    "sense_definition": "Schriftliche Mitteilung über ein begründetes Fehlen, insbesondere in der Schule",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach seiner langen Krankheit reichte er eine ärztliche <w>Entschuldigung</w> ein."
                        },
                        {
                            "text": "Der Schüler muss bis morgen eine schriftliche <w>Entschuldigung</w> der Eltern abgeben."
                        }
                    ],
                    "common_phrases": [
                        "eine schriftliche Entschuldigung"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f8331914-51fa-3632-b3f6-486714271469",
                    "sense_definition": "Ausruf, mit dem man sein Bedauern über ein Missgeschick oder einen eigenen Fehler ausdrückt",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Entschuldigung</w>, das war wirklich ein Versehen von mir."
                        },
                        {
                            "text": "Oh, <w>Entschuldigung</w>, ich wollte dir nicht auf den Fuß treten."
                        }
                    ],
                    "synonyms": [
                        "Verzeihung",
                        "pardon",
                        "sorry"
                    ]
                },
                {
                    "sense_id": "accefe60-58d7-3464-99dc-d356cd7b02bf",
                    "sense_definition": "Höfliche Formel, um die Aufmerksamkeit einer fremden Person auf sich zu lenken",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Entschuldigung</w>, wissen Sie vielleicht, wo die nächste U-Bahn-Station ist?"
                        },
                        {
                            "text": "<w>Entschuldigung</w>, könnten Sie mir bitte kurz den Weg zum Bahnhof erklären?"
                        }
                    ],
                    "synonyms": [
                        "Verzeihung"
                    ]
                }
            ]
        }
    ]
}