                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b77d38d-4523-49c5-8a0e-5d34be52f717",
                                                "sense_id": "45abd059-f5f7-33d3-ac92-ee2cece6f131",
                                                "text": "Tune a deploring dump […]"
