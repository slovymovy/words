    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "304b474e-a3e1-32ff-86c4-432569244032",
                    "sense_definition": "overleg plegen of grondig nadenken alvorens een beslissing te nemen (wederkerend: zich beraden)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overwegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bestuur zal zich morgen over de nieuwe plannen <w>beraden</w>.",
                            "target_lang_translations": {
                                "en": "The board will <w>deliberate</w> on the new plans tomorrow."
                            }
                        },
                        {
                            "text": "Na de onverwachte uitspraak <w>beraadt</w> de advocaat zich op mogelijke vervolgstappen.",
                            "target_lang_translations": {
                                "en": "Following the unexpected ruling, the lawyer is <w>considering</w> possible next steps."
                            }
                        }
                    ],
                    "synonyms": [
                        "overleggen",
                        "overpeinzen"
                    ],
                    "common_phrases": [
                        "zich ergens over beraden",
                        "zich op vervolgstappen beraden"
                    ],
                    "target_lang_definitions": {
                        "en": "to deliberate, confer, or consider carefully before taking a decision (reflexive: zich beraden)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deliberate",
                                "target_lang_sense_clarification": "to engage in careful consideration or discussion"
                            },
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "to reflect carefully on options"
                            },
                            {
                                "target_lang_word": "confer",
                                "target_lang_sense_clarification": "to consult or discuss together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9fae001-c9f3-39e7-aa6f-42c1839bca06",
                    "sense_definition": "voltooid deelwoord van <w>beraden</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechters hebben zich langdurig over het vonnis <w>beraden</w>.",
                            "target_lang_translations": {
                                "en": "The judges have <w>deliberated</w> extensively on the verdict."
                            }
                        },
                        {
                            "text": "Nadat de ministers zich urenlang hadden <w>beraden</w>, kwamen ze eindelijk met een verklaring.",
                            "target_lang_translations": {
                                "en": "After the ministers had <w>conferred</w> for hours, they finally issued a statement."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of beraden (deliberated, consulted)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deliberated",
                                "target_lang_sense_clarification": "past participle"
                            },
                            {
                                "target_lang_word": "conferred",
                                "target_lang_sense_clarification": "past participle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c3ddf70-4f99-3636-97c3-167957cc9044",
                    "sense_definition": "na rijp overleg handelend; bedachtzaam en bezonnen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bedachtzaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij nam een weloverwogen en <w>beraden</w> besluit over de toekomst van het bedrijf.",
                            "target_lang_translations": {
                                "en": "She made a well-considered and <w>deliberate</w> decision about the company's future."
                            }
                        },
                        {
                            "text": "Zijn <w>beraden</w> optreden bracht direct rust onder de aanwezigen.",
                            "target_lang_translations": {
                                "en": "His <w>prudent</w> conduct immediately brought calm to those present."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedachtzaam",
                        "bezonnen"
                    ],
                    "antonyms": [
                        "onberaden"
                    ],
                    "common_phrases": [
                        "een beraden besluit"
                    ],
                    "target_lang_definitions": {
                        "en": "acting after careful consideration; deliberate, prudent, well-considered"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deliberate",
                                "target_lang_sense_clarification": "done with careful thought and intention"
                            },
                            {
                                "target_lang_word": "prudent",
                                "target_lang_sense_clarification": "acting with or showing care and thought"
                            },
                            {
                                "target_lang_word": "circumspect",
                                "target_lang_sense_clarification": "wary and unwilling to take risks"
                            }
                        ]
                    }
                }
            ]
        },
        {
