                ],
                "senses": [
                    {
                        "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                        "entry_id": "13e0ed5d-5b12-3d22-90d9-c8f1bcdd5292",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a1ae2a-4696-4df1-8263-bcaf60a6cf8c",
                                "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                                "text": "Frau Böllinger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cb30aa26-7f28-446b-80c4-15c1fb7e8b96",
                                "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                                "text": "Herr Böllinger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7e9f71f8-8644-4c04-ad1f-4dfc4b17caa2",
                                "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                                "text": "Die Böllingers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "93cabce0-2df8-4f92-9ba6-998318427224",
                                "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                                "text": "Der Böllinger trägt nie die Schals, die die Böllinger ihm strickt."
                            },
                            {
                                "example_id": "2862a678-32f9-477c-a244-4d6602bc588c",
                                "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Böllinger kommt, geht der Herr Böllinger.“"
                            },
                            {
                                "example_id": "5937b1bf-8796-437e-bca8-7be00e2f4a5c",
                                "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                                "text": "Böllinger kommt und geht."
                            },
                            {
                                "example_id": "637eecea-b0f5-4b3b-ac8d-e31a922b01b5",
                                "sense_id": "2b128900-37e7-32c6-b535-481e1ca931c2",
                                "text": "Böllingers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
