                                "example_id": "dac3b998-367a-4e1e-9189-4dbb23702883",
                                "sense_id": "26cf534f-6e68-343a-b8d7-90b6ae8ac7ab",
                                "text": "Warum möchtest Du nicht ein Auslandssemester in Nouméa verbringen?"
                            },
                            {
                                "example_id": "37561595-6997-484a-b1da-139373bab4b7",
                                "sense_id": "26cf534f-6e68-343a-b8d7-90b6ae8ac7ab",
                                "text": "Fast jeder zweite Bewohner Neukaledoniens wohnt in Nouméa."
                            }
