                },
                {
                    "sense_id": "252af173-6a1e-3a6e-a61f-ce5d2166bf1b",
                    "sense_definition": "Very narrow in all diameters; having a cross section that is small in all directions.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler used a <w>thin</w> wire to string the delicate pearls together.",
                            "target_lang_translations": {
                                "ru": "Ювелир использовал <w>тонкую</w> проволоку, чтобы нанизать нежный жемчуг.",
                                "nl": "De juwelier gebruikte een <w>dunne</w> draad om de delicate parels aan elkaar te rijgen."
                            }
                        },
                        {
                            "text": "A <w>thin</w> string was all that held the heavy sign in place.",
                            "target_lang_translations": {
                                "ru": "<w>Тонкая</w> бечевка — это все, что удерживало тяжелую вывеску на месте.",
                                "nl": "Een <w>dun</w> touwtje was het enige dat het zware bord op zijn plaats hield."
                            }
                        }
                    ],
                    "synonyms": [
