                ],
                "senses": [
                    {
                        "sense_id": "0d6deb79-ac80-32f5-a16a-72d1067393bb",
                        "entry_id": "2abff0f3-7924-3da1-8cee-d677196be213",
                        "glosses": [
                            "Qui n’est pas assouvi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8206214c-6d89-467f-a372-8c0a6996f3a4",
                                "sense_id": "0d6deb79-ac80-32f5-a16a-72d1067393bb",
                                "text": "Une faim inassouvie."
                            },
                            {
                                "example_id": "e3807a2d-79ef-4cfe-baff-4fb01f9a922c",
                                "sense_id": "0d6deb79-ac80-32f5-a16a-72d1067393bb",
                                "text": "Une haine inassouvie."
                            },
                            {
                                "example_id": "b8261c2a-7789-4157-bf63-2676fac02bf4",
                                "sense_id": "0d6deb79-ac80-32f5-a16a-72d1067393bb",
                                "text": "Ce fut pour lui un temps de souffrances indicibles : son orgueil saignait, ses ardeurs inassouvies le fouettaient furieusement."
                            },
                            {
                                "example_id": "a96eb002-5ffe-4a41-b98f-966d3034885a",
                                "sense_id": "0d6deb79-ac80-32f5-a16a-72d1067393bb",
                                "text": "De tels signes, pensai-je, n’exprimaient pas seulement la joie de contenter un penchant puéril. Ils montraient une profonde exigence et que l’enfant acceptait mal de voir toujours inassouvie."
                            },
                            {
                                "example_id": "41663d1d-ee41-42fc-8154-58641bdfe510",
                                "sense_id": "0d6deb79-ac80-32f5-a16a-72d1067393bb",
                                "text": "Vous ne savez pas si vous aimez les animaux mais vous en voulez absolument un, vous voulez une bête. C'est l'une des premières manifestations de votre désir, un désir d'autant plus puissant qu'il reste inassouvi."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "645ac116-6ad1-35aa-a009-69e31b915298",
                "word": "inassouvi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f7118ea-630f-4869-baca-c3f0e71d61ff",
