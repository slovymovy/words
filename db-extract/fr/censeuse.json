                                        "entry_id": "f0d09667-d5af-3674-8ca3-7bdc1ef190f2",
                                        "glosses": [
                                            "weibliche Person, die in staatlichem Auftrag Informationskontrolle (Zensur) ausübt"
                                        ],
                                        "tags": [],
