                        ],
                        "form": "босоно́жках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69e7b366-6f55-31ff-8585-b6654d13bab3",
                        "entry_id": "94de29bf-064f-3351-84d6-ed9951a75f60",
                        "glosses": [
                            "вид женской летней обуви"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f42700-2f4c-4902-b645-c76b6daa9100",
                                "sense_id": "69e7b366-6f55-31ff-8585-b6654d13bab3",
                                "text": "Только четвёртое место в нашем рейтинге занимают летние обновки ― женские босоножки на танкетке от французского дизайнера обуви Стефана Келиана, купленные за 500 долларов в Петровском Пассаже."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d1db3b0-28a2-36ce-a230-3f44586c2de6",
                        "entry_id": "94de29bf-064f-3351-84d6-ed9951a75f60",
                        "glosses": [
                            "девочка, девушка с босыми ногами"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "021fc4af-209a-44a1-91c3-d42906557029",
                        "source_entry_id": "94de29bf-064f-3351-84d6-ed9951a75f60",
                        "target_lang_word": "mule",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "700f1684-63a8-3528-8359-0def78619258",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "The generally sterile male or female hybrid offspring of a male donkey and a female horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06799de0-9c65-4a1d-812d-9791b2d897d1",
                                                "sense_id": "700f1684-63a8-3528-8359-0def78619258",
                                                "text": "One day he ran into a herd of a half dozen elk, so he rode his mule down the canyon three or four miles, leaving the sheep alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c5ec99-985e-3b04-b310-f453238389ba",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "The generally sterile hybrid offspring of any two species of animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb229eab-801a-4fc1-9923-8a00bb980696",
                                                "sense_id": "34c5ec99-985e-3b04-b310-f453238389ba",
                                                "text": "It would be exceedingly interesting to know if the hybrid would reproduce, a matter I deem exceedingly doubtful, for the chances are it would prove a \"mule\" (infertile)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f3ee8c3-84a1-310a-9859-795ba13e348a",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "A hybrid plant."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9741d36-cb21-4dad-909c-1267f74332b6",
                                                "sense_id": "6f3ee8c3-84a1-310a-9859-795ba13e348a",
                                                "text": "Vegetable mules supply an irrefragable argument in favour of the sexual system of botany."
                                            },
                                            {
                                                "example_id": "28cf631b-8958-4e77-a9e8-712211eac4e1",
                                                "sense_id": "6f3ee8c3-84a1-310a-9859-795ba13e348a",
                                                "text": "The most extraordinary mule, however, that is asserted to have been produced on the Continent, is a cross between the cabbage and horse-radish, which Monsieur Sageret reports that he has obtained […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24abb1ae-169b-3b1e-ae8a-9d764ae1e5dc",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "A stubborn person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "723d5f46-9424-40c6-b353-f38fb90151fe",
                                                "sense_id": "24abb1ae-169b-3b1e-ae8a-9d764ae1e5dc",
                                                "text": "\"Where in the hell do you think I learned to be such a mule?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81be7c05-db17-399d-991d-8bacfa2b65ca",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "A person paid to smuggle drugs."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f3b1ae-6c69-4b38-a9a6-be32fee241d9",
                                                "sense_id": "81be7c05-db17-399d-991d-8bacfa2b65ca",
                                                "text": "Cocaine packet ingestion (these patients referred to as “mules”) may warrant surgery, Golytely or expectant passage."
                                            },
                                            {
                                                "example_id": "0d3c5355-10ec-4c31-b56d-9a6d9467c513",
                                                "sense_id": "81be7c05-db17-399d-991d-8bacfa2b65ca",
                                                "text": "“Yeah, in Denver, we know about Uriarte's involvement in meth. Our Las Cruces office seized over six hundred pounds of methamphetamine from two of his mules last year.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2650db2-ea24-3797-937a-6a5fc0e7ac42",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "A coin or medal minted with obverse and reverse designs not normally seen on the same piece, either intentionally or in error."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbceb1ef-ed94-4424-81b6-fe7ee59b8b4d",
                                                "sense_id": "e2650db2-ea24-3797-937a-6a5fc0e7ac42",
                                                "text": "What is less clear, however, is why mint workers should have chosen to produce mules, if they were making forgeries […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea917f67-551e-37a1-8930-523e73f56cc5",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "A MMORPG character, or NPC companion in a tabletop RPG, used mainly to store extra inventory for the owner's primary character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40e318e-6224-46b6-b973-bb2002bc9e51",
                                                "sense_id": "ea917f67-551e-37a1-8930-523e73f56cc5",
                                                "text": "He was in the middle of organizing his massive stash of rare and exquisite bounty, all kept safely in the inventory cache of a mule, an entirely separate character which he paid a monthly fee to maintain exclusively for that purpose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e992f1-3f8e-3ee1-b0da-3eddb6a3ea7b",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "Any of a group of cocktails involving ginger ale or ginger beer, citrus juice, and various liquors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eead0947-d1e8-3156-a69c-ac7564fa7235",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "A kind of triangular sail for a yacht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "410160f5-f5aa-4f67-a0df-f679b0b7da82",
                                                "sense_id": "eead0947-d1e8-3156-a69c-ac7564fa7235",
                                                "text": "In heavier seas where a boat must sail a course dictated by waves, or where wave action makes power more important than pointing, the mule will prove the faster sail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b90c68ad-1dc6-32b6-a6c9-774b4cd9903e",
                                        "entry_id": "9a8882f1-0d6a-3674-a272-3ef5b442de07",
                                        "glosses": [
                                            "A kind of cotton-spinning machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b867d9eb-4e15-3b1b-af2c-cc9228ad0568",
                                        "entry_id": "531b7ebf-5b2a-30dc-a9d4-56812305f7c9",
                                        "glosses": [
                                            "To smuggle (illegal drugs)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f07903-06cc-4231-ac30-0871b44b4cc4",
                                                "sense_id": "b867d9eb-4e15-3b1b-af2c-cc9228ad0568",
                                                "text": "There are many drug lords, each with his own corridor (think of it as a franchise of sorts) funneling narcotics into Texas. There are multifold methods of transport. The old, and still viable, way is to \"mule\" it across the Rio Grande in a small boat."
                                            },
                                            {
                                                "example_id": "d69b1821-c734-4b47-937b-b1f0bd7c843d",
                                                "sense_id": "b867d9eb-4e15-3b1b-af2c-cc9228ad0568",
                                                "text": "Thornton was supposed to mule it back to the States from one of the ports he stopped in, give it to Maxwell and Ames, and get the second half of a quarter-million."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83ac8528-2de7-3c71-a03a-06dc6b6b1772",
                                        "entry_id": "97178125-9cac-3ddc-8852-d33f1764e566",
                                        "glosses": [
                                            "Any shoe with an upper covering the front of the foot but without a back flap or strap, leaving the heel exposed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d72873d-fc67-4cbe-b746-4801dd9c6f35",
                                                "sense_id": "83ac8528-2de7-3c71-a03a-06dc6b6b1772",
                                                "text": "The bride was a shocking housekeeper and dragged round all day in boudoir cap, frowsy negligee and mules—slip, slop, slip, slop."
                                            },
                                            {
                                                "example_id": "b290ed7b-4e5a-4abf-b119-f85a14f18c8c",
                                                "sense_id": "83ac8528-2de7-3c71-a03a-06dc6b6b1772",
                                                "text": "Routine dress for Tuesday will be bra and panties with high-heel satin mules."
                                            },
                                            {
                                                "example_id": "e7cebe09-7e07-4a8b-89fb-d92d1ac38633",
