                            "feminine"
                        ],
                        "form": "soumissionnaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07d0c09b-7ae9-3709-bb75-51cff98ec8c8",
                        "entry_id": "3334be2a-c2f2-3ef8-b57b-0e37f60fd92f",
                        "glosses": [
                            "Personne qui fait une soumission pour une entreprise, pour une fourniture."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "ab2753d6-9367-461c-a5ca-281af8468d72",
                                "sense_id": "07d0c09b-7ae9-3709-bb75-51cff98ec8c8",
                                "text": "[…] ; ce devait être un fripon, car une fois déjà, un autre acheteur de duvet et soumissionnaire de saindoux avait fait nombre de dupes et extorqué plus de cent roubles à l’archiprêtresse."
                            },
                            {
                                "example_id": "bf3fa81b-9373-4ef4-9701-0f768ab01f71",
                                "sense_id": "07d0c09b-7ae9-3709-bb75-51cff98ec8c8",
                                "text": "A la date fixée, les soumissions étaient ouvertes en audience publique et le bien était adjugé provisoirement au soumissionnaire qui avait fait l'offre la plus élevée, si toutefois sa soumission dépassait la mise à prix ; puis la vente était renvoyée à quinzaine pour adjudication au feu des enchères."
                            },
                            {
                                "example_id": "af2f36a5-401c-4ea7-8de1-2c44b3e33724",
                                "sense_id": "07d0c09b-7ae9-3709-bb75-51cff98ec8c8",
                                "text": "Le père d’Adeline et son jeune frère étaient alors soumissionnaires des fourrages en Alsace."
                            },
                            {
                                "example_id": "bf8cfdf8-1b89-4a10-8117-4bcd90e5a670",
                                "sense_id": "07d0c09b-7ae9-3709-bb75-51cff98ec8c8",
                                "text": "Le garant s’engage à verser une somme déterminée au bénéficiaire si le soumissionnaire refuse de signer le marché ou de mettre en place les garanties prévues par le marché."
                            }
                        ]
                    }
                ],
