                        "examples": [
                            {
                                "example_id": "9fc69dce-0a5b-43b3-8664-c4e4cd417030",
                                "sense_id": "894ccf1b-5131-3540-aee5-c420fe1706a6",
                                "text": "Ils passèrent les jours suivants ainsi, dans un semi-confort puisqu’ils étaient nourris et abreuvés régulièrement à l’abri sous leur tente artisanale."
                            },
                            {
                                "example_id": "4c82329a-73cb-42a7-9ff8-25183c19053b",
                                "sense_id": "894ccf1b-5131-3540-aee5-c420fe1706a6",
                                "text": "Elle utilisait seulement pour y bivouaquer, dans un semi-confort de nomade soldat, l’espace de pierres, de plage et de flaques que la route et les deux tours de garde protégeaient des incursions."
                            },
                            {
                                "example_id": "2e98adc3-cde6-4eaf-828f-b409b9beac9e",
                                "sense_id": "894ccf1b-5131-3540-aee5-c420fe1706a6",
                                "text": "Si une fille n’avait pas pu l’arracher à son semi-confort, ce n’était certes pas un radariste qui accomplirait ce prodige."
                            }
                        ]
                    }
