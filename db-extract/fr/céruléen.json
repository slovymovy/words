                "entry_id": "32418c9b-cc90-3915-b5aa-cae0c87b2b4b",
                "word": "céruléen",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "14fca0aa-7965-4c97-b7dd-75f818d5eb43",
                        "entry_id": "32418c9b-cc90-3915-b5aa-cae0c87b2b4b",
                        "tags": [
