                "senses": [
                    {
                        "sense_id": "f2cfaa7c-6c58-3666-a561-af59f3e9d36d",
                        "entry_id": "1fc9943b-e1a1-348d-996a-442ab8058b5a",
                        "glosses": [
                            "unterdrückerisches Regime"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81702086-7bce-4334-9a04-a85423a1897f",
                                "sense_id": "f2cfaa7c-6c58-3666-a561-af59f3e9d36d",
                                "text": "„Einen kurzen Augenblick lang sah ich die Wahrheit in ihren Augen aufblitzen, und die Wahrheit war, dass sie mich hasste für das, was ich ihrer Meinung nach darstellte, den Agenten eines Unterdrückerregimes.“"
                            },
                            {
                                "example_id": "2b03fd86-38b8-4f36-bb08-1cd9511da863",
                                "sense_id": "f2cfaa7c-6c58-3666-a561-af59f3e9d36d",
                                "text": "„Und dann ließen sie Guillaume du Toit zusehen, wie eine neue Bewegung, eine Revolution, die all das verkörperte, wovon er leidenschaftlich überzeugt war, die südafrikanische Weinbranche tiefgreifend und für alle Zeiten veränderte - während er auf einer Stelle festsaß, die er hasste, als Teil des Unterdrückerregimes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
