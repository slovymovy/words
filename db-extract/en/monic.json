                "senses": [
                    {
                        "sense_id": "d542140a-f00d-3c41-a365-78d697a90a97",
                        "entry_id": "b7d58fed-a734-342a-a91f-79254bfdee39",
                        "glosses": [
                            "Of a polynomial whose leading coefficient is one."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
