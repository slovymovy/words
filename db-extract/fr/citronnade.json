                    }
                ],
                "senses": [
                    {
                        "sense_id": "101b5d95-1372-3c31-aa94-97a16828104f",
                        "entry_id": "575f65f9-249a-35c0-b77c-e14118cb382a",
                        "glosses": [
                            "Boisson à base de sucre, de jus de citron et d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b4e5f3-538d-4fcb-a738-8c60aa8b00ca",
                                "sense_id": "101b5d95-1372-3c31-aa94-97a16828104f",
                                "text": "Et tu me feras des citronnades glacées…"
                            },
                            {
                                "example_id": "06ddb74e-0495-46fe-a11b-e50c94344223",
                                "sense_id": "101b5d95-1372-3c31-aa94-97a16828104f",
                                "text": "À deux heures de l’après-midi, Zaza et Pradelle vinrent me chercher ; après avoir bu une citronnade au Café de Flore, qui n’était alors qu’un petit café de quartier, nous nous promenâmes longtemps dans le Luxembourg pavoisé de grands iris jaunes et mauves."
                            },
                            {
                                "example_id": "e32ad6a8-8d59-4fcf-aa51-96ad8ddde3fd",
                                "sense_id": "101b5d95-1372-3c31-aa94-97a16828104f",
                                "text": "Louisa l’observait, assise sur une chaise à l’abri d’une ombrelle, tout en dégustant un verre de citronnade."
                            },
                            {
                                "example_id": "9e5ce7a2-c32a-411e-9136-8fe7f42e713f",
                                "sense_id": "101b5d95-1372-3c31-aa94-97a16828104f",
                                "text": "Les marchands de glaces proposaient des verres de citronnade hauts comme des tours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1740378d-c2e2-4be0-8df6-063b1f49c510",
                        "source_entry_id": "575f65f9-249a-35c0-b77c-e14118cb382a",
                        "source_sense_id": "101b5d95-1372-3c31-aa94-97a16828104f",
                        "target_lang_word": "lemonade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemonade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29817c9e-9448-3113-b47d-dbb2759f2396",
                                        "entry_id": "dfc382a5-cd91-30c1-b94e-0684cd6cdcef",
                                        "glosses": [
                                            "A flavoured beverage consisting of water, lemon, and sweetener, sometimes ice, served mainly as a refreshment."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "India",
                                            "Philippines",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545cba71-1fa6-48be-8013-a63cdaeef6a0",
                                                "sense_id": "29817c9e-9448-3113-b47d-dbb2759f2396",
                                                "text": "Mrs. Murphy, who had […] stopped for a few minutes, at Mrs. Loring's invitation, to rest and enjoy the cool glass of lemonade that was very refreshing after her long walk."
                                            },
                                            {
                                                "example_id": "9cd54c40-c7ad-40bf-b1c4-3808d00e1727",
                                                "sense_id": "29817c9e-9448-3113-b47d-dbb2759f2396",
                                                "text": "The tiny flowers on the long skirt and sleeveless halter-top made her look like she belonged in some Southern porch handing out lemonade and sweet tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ba90c75-3763-3e45-98cf-ab82ce80e581",
                                        "entry_id": "dfc382a5-cd91-30c1-b94e-0684cd6cdcef",
                                        "glosses": [
                                            "A clear, usually carbonated, beverage made from lemon or artificial lemon flavouring, water, and sugar."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07c5f226-c785-35f1-93a5-c9eada609298",
                                        "entry_id": "dfc382a5-cd91-30c1-b94e-0684cd6cdcef",
                                        "glosses": [
                                            "Recreational drugs of poor or weak quality, especially heroin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ccae8b-111e-4fff-92a5-52ee5fd80965",
                                                "sense_id": "07c5f226-c785-35f1-93a5-c9eada609298",
                                                "text": "In fact, a recent report from Denver shows it [street heroin] was about 1 to 2 percent and the addicts that are receiving this in many cases refer to it as lemonade, because it is so weak."
                                            },
                                            {
                                                "example_id": "f04893d3-5cd3-477d-8af9-d1db97c7119e",
                                                "sense_id": "07c5f226-c785-35f1-93a5-c9eada609298",
                                                "text": "Lemonade — heroin; poor quality drugs"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
