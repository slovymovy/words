                            {
                                "example_id": "5d99fb43-c4b4-4fb3-976c-b8e5e60b99b5",
                                "sense_id": "042bf9e8-bae4-3eb9-a146-9941a8326fdb",
                                "text": "Ceci impose de faire sortir l’Histoire de son instrumentalisation destinée à la construction d’une mythologie nationale et à l’entretien d’un souvenir collectif."
                            },
                            {
                                "example_id": "12251b83-6c15-45b5-bab5-c3b59f293f4a",
                                "sense_id": "042bf9e8-bae4-3eb9-a146-9941a8326fdb",
                                "text": "On peut donc s’inquiéter de retrouver cette instrumentalisation de l’histoire jusque dans les discours présidentiels, […]."
                            }
                        ]
                    }
                ],
