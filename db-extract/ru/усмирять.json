                        "cross_references": [
                            {
                                "target_word": "réprimer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e87000a-fec1-3087-b5d0-53b5b3fffaab",
                                        "entry_id": "73e7a1df-62b8-3116-8ae5-5f777ab2ad89",
                                        "glosses": [
                                            "Empêcher quelque chose de se développer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9231017f-8605-44c1-ae5c-104bf9de67b9",
                                                "sense_id": "9e87000a-fec1-3087-b5d0-53b5b3fffaab",
                                                "text": "Le législateur qui établit cette peine renonce à ce principe salutaire, que le moyen le plus efficace de réprimer les crimes est d'adapter les peines au caractère des différentes passions qui les produisent, et de les punir, pour ainsi dire, par elles-mêmes."
                                            },
                                            {
                                                "example_id": "2b7176e2-8fa3-4792-b096-a23bfda620f4",
                                                "sense_id": "9e87000a-fec1-3087-b5d0-53b5b3fffaab",
                                                "text": "…puis je parlerai des hommes qui l’habitent, et des moyens, sinon d’empêcher, du moins d’y réprimer facilement une guerre civile."
                                            },
                                            {
                                                "example_id": "76822519-5025-4872-9d5e-4ddbd6e67628",
                                                "sense_id": "9e87000a-fec1-3087-b5d0-53b5b3fffaab",
                                                "text": "Quand Djahane réprime un hoquet, manquant de s’étrangler, la cour entière, monarque en tête, part d’un rire franc."
                                            },
                                            {
                                                "example_id": "a142fa82-9144-4ae7-bd2f-e7750d2e7ac9",
                                                "sense_id": "9e87000a-fec1-3087-b5d0-53b5b3fffaab",
                                                "text": "Au moment où le Kremlin réprime toute critique, la superstar de la chanson russe Alla Pougatcheva a dénoncé, dimanche, le conflit en Ukraine, évoquant la mort de soldats « pour des objectifs illusoires »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d72cae-2cf8-32f8-9cc5-b05c34e6cd47",
                                        "entry_id": "73e7a1df-62b8-3116-8ae5-5f777ab2ad89",
                                        "glosses": [
                                            "Calmer ce que l'on considère comme un mal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9924119-00be-42c5-8558-b8c0339ff241",
                                                "sense_id": "b0d72cae-2cf8-32f8-9cc5-b05c34e6cd47",
                                                "text": "Le législateur canonique intervient aussi pour réprimer le rapt ; le Concile de Chalcédoine de 451 (canon 27) dépose les clercs coupables de complicité de rapt et excommunie les laïques dans ces cas."
                                            },
                                            {
                                                "example_id": "07b83252-5356-4b41-a321-659d34937154",
                                                "sense_id": "b0d72cae-2cf8-32f8-9cc5-b05c34e6cd47",
                                                "text": "Réprimer les progrès du mal. - Réprimer les abus, la licence. - Réprimer l’insolence, l’orgueil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598d5851-72e3-36d0-a057-9bba60ad2141",
                                        "entry_id": "73e7a1df-62b8-3116-8ae5-5f777ab2ad89",
                                        "glosses": [
                                            "Contenir, dépasser un sentiment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b1f99f-9545-4ee9-b41a-e001a2546565",
                                                "sense_id": "598d5851-72e3-36d0-a057-9bba60ad2141",
                                                "text": "Réprimer sa colère."
                                            },
                                            {
                                                "example_id": "0edc4a7a-a9dc-4321-9515-66928c4ccae0",
                                                "sense_id": "598d5851-72e3-36d0-a057-9bba60ad2141",
                                                "text": "Il faut réprimer ses passions."
                                            },
                                            {
                                                "example_id": "e3f96226-ec22-4335-a9f8-31fdacbeff01",
                                                "sense_id": "598d5851-72e3-36d0-a057-9bba60ad2141",
                                                "text": "Réprimer ses désirs, son ardeur, son impétuosité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
