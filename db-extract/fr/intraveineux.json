                                                "sense_id": "3cfe0db5-500d-3918-a312-4941ac14f024",
                                                "text": "Ikenna had typhoid and had been admitted at the hospital, receiving intravenous injections."
                                            },
                                            {
                                                "example_id": "3f6e6821-672d-4899-ad55-d9a8248da064",
                                                "sense_id": "3cfe0db5-500d-3918-a312-4941ac14f024",
                                                "text": "The inside of the vehicle is pretty sparse and there are no oxygen tanks, intravenous drips or machines that go \"ping.\""
                                            }
