                        "source_entry_id": "a14969de-8113-3fc3-addb-b041829aef00",
                        "source_sense_id": "68dbe955-ed32-30dc-a51a-43014efeafa5",
                        "source_sense_description": "amtlich, offiziell: Autobahn in Deutschland und Österreich",
                        "target_lang_word": "autobahn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autobahn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8f51fb-5389-351d-87cd-6b1671841f12",
                                        "entry_id": "9ba91ed0-bffc-3b99-a337-9d530d51a44b",
                                        "glosses": [
                                            "The high-speed intercity highways of Germany and Austria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77dc967b-2a17-4df0-8b64-ac32d2227c48",
                                                "sense_id": "1c8f51fb-5389-351d-87cd-6b1671841f12",
                                                "text": "On a recent afternoon a work crew and crane were affixing the tall lettering to the side of the team’s new stadium, just off the autobahn in Sinsheim, a few miles from Hoffenheim."
                                            },
                                            {
                                                "example_id": "90de8b36-c022-4b95-b35d-829ac449b407",
                                                "sense_id": "1c8f51fb-5389-351d-87cd-6b1671841f12",
                                                "text": "Confusion reigned on German autobahns and highways at the start of one of the busiest holiday breaks of the year on Thursday after Google Maps wrongly indicated that vast swathes of them were closed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb43d29e-7463-37ef-9b96-4d8e1ca447c2",
                                        "entry_id": "9ba91ed0-bffc-3b99-a337-9d530d51a44b",
                                        "glosses": [
                                            "Any wide, high-speed road."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd791ac6-ca7c-40a3-a867-c1424c9d25c6",
                                                "sense_id": "eb43d29e-7463-37ef-9b96-4d8e1ca447c2",
                                                "text": "These ant autobahns function much the same as human highways to speed transport of goods and to reduce bumps and potholes in the path."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "133bed1e-ecd8-46bb-b512-13dd2ead00c1",
                        "source_entry_id": "a14969de-8113-3fc3-addb-b041829aef00",
                        "source_sense_id": "68dbe955-ed32-30dc-a51a-43014efeafa5",
                        "source_sense_description": "amtlich, offiziell: Autobahn in Deutschland und Österreich",
                        "target_lang_word": "highway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89cc84cb-3a91-364d-9dbe-b1df765e8171",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A road that is higher than the surrounding land and has drainage ditches at the sides."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c3a3063-75a0-3686-9b97-d2cbd5ecf5d5",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A main public road, especially a multi-lane, high-speed thoroughfare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6a6b89-8150-4357-8cdf-189adb8e47cf",
                                                "sense_id": "3c3a3063-75a0-3686-9b97-d2cbd5ecf5d5",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "A way; a path that leads to a certain destiny"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f985562-8887-420a-a01b-a7b0d500ba6e",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "You're on a highway to greatness."
                                            },
                                            {
                                                "example_id": "e8be166e-cbcf-403d-89f1-74ebaf6b0563",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "I'm on the highway to hell"
                                            },
                                            {
                                                "example_id": "2ce8c4ac-dda4-472a-91c2-d36de9264e4e",
                                                "sense_id": "fdf5a7e5-4150-399f-9458-ba38188a31cf",
                                                "text": "So how do the scientists cope with their work being ignored for decades, and living in a world their findings indicate is on a “highway to hell”?."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf40a018-b88d-3f26-a62a-625f5e80c0ed",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "Any public road for vehicular traffic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a9c39a5-a840-3202-9ae2-4f1b18a7a308",
                                        "entry_id": "8df69f0a-a056-3c00-af7a-a240985d166a",
                                        "glosses": [
                                            "Synonym of bus (“common connection for two or more circuits or components”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
