    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0920d1f-a3c3-3432-ba3e-bda0c41593de",
                    "sense_definition": "Remettre debout quelqu'un ou quelque chose qui est tombé, ou se remettre sur ses pieds.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est tombé dans la cour mais il a vite réussi à se <w>relever</w>."
                        },
                        {
                            "text": "Elle s'est approchée de la vieille dame pour l'aider à se <w>relever</w>."
                        }
                    ],
                    "synonyms": [
                        "redresser"
                    ],
                    "antonyms": [
                        "renverser",
                        "abattre"
                    ],
                    "common_phrases": [
                        "se relever"
                    ]
                },
                {
                    "sense_id": "f4f1e5cf-aae2-3c22-86b7-f8ef4be29246",
                    "sense_definition": "Retrousser, remonter vers le haut un vêtement ou une partie du corps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>relevé</w> ses manches avant de commencer à nettoyer toute la cuisine."
                        },
                        {
                            "text": "Le médecin lui a demandé de <w>relever</w> la tête pour examiner sa gorge."
                        }
                    ],
                    "synonyms": [
