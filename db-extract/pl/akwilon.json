                                    {
                                        "sense_id": "56da7061-15ee-3d9c-a09a-b3215cdbb965",
                                        "entry_id": "78f0e7b0-b95a-31e4-a06c-ab3351957745",
                                        "glosses": [
                                            "Vent du nord."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "752bac2f-8155-46cf-9ea2-367ef7e8f458",
                                                "sense_id": "56da7061-15ee-3d9c-a09a-b3215cdbb965",
                                                "text": "L’aquilon s’est levé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fd906fb-f72a-3b29-a291-1862bd14b998",
                                        "entry_id": "78f0e7b0-b95a-31e4-a06c-ab3351957745",
                                        "glosses": [
                                            "Tout vent violent et froid."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a66c96-1ebe-4690-aa7f-ca80fdebdfc6",
                                                "sense_id": "9fd906fb-f72a-3b29-a291-1862bd14b998",
                                                "text": "D’un souffle l’aquilon écarte les nuages.\nEt chasse au loin la foudre et les orages."
                                            },
                                            {
                                                "example_id": "764fa3d9-cbe9-418c-a30d-22df4b45e815",
                                                "sense_id": "9fd906fb-f72a-3b29-a291-1862bd14b998",
                                                "text": "[Il] eut grand soin de l’entourer d’un papier transparent pour prévenir les malices des aquilons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d52d723-f07d-3a17-adb3-3081500e3727",
                                        "entry_id": "78f0e7b0-b95a-31e4-a06c-ab3351957745",
                                        "glosses": [
                                            "Le Nord."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed48c64-5557-4dd7-addd-68b108b9718a",
                                                "sense_id": "0d52d723-f07d-3a17-adb3-3081500e3727",
                                                "text": "Du sud à l’aquilon, de l’aurore au couchant […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff839af-243e-394e-8ad0-b8581f587291",
                                        "entry_id": "78f0e7b0-b95a-31e4-a06c-ab3351957745",
                                        "glosses": [
                                            "Meuble représentant un visage soufflant dans les armoiries. À rapprocher de borée et Éole."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "765e2752-7746-453c-9783-d471bfc5e2f8",
                                                "sense_id": "2ff839af-243e-394e-8ad0-b8581f587291",
                                                "text": "De sinople au chevron renversé d’argent accompagné en chef d’une croisette recroisetée au pied fiché d’or ; au chef cousu d’azur chargé d’un épi de blé accosté de deux aquilons du même mouvants du chef, qui est de Villers-aux-Vents → voir illustration « armoiries avec aquilons »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
