                        "examples": [
                            {
                                "example_id": "8645ed21-6d60-40e2-bbfe-95a38af46d12",
                                "sense_id": "4dbbdfa8-edfd-31b5-a099-8d8e68093e19",
                                "text": "\"Veendam heeft de ruimte om te bouwen en te groeien\", zegt Harrie Buurlage van Shine en kartrekker van het project in Europa. \"De ontsluiting richting Duitsland, de stad Groningen en de Randstad vinden we perfect.\" Ook de nabijheid van Groningen Airport Eelde en de aanwezigheid van kennisinstellingen als het UMCG en de RUG met zijn Kernfysisch Versnellersinstituut speelden een rol bij de vestigingsbeslissing."
                            },
                            {
                                "example_id": "b36c73eb-67f8-4986-b4aa-fdd8a3ede6a7",
                                "sense_id": "4dbbdfa8-edfd-31b5-a099-8d8e68093e19",
                                "text": "Hij werd op 28 maart 1946 geboren in Almelo en studeerde wiskunde en natuurkunde in Groningen. Daarna werd hij onderzoeker aan het Kernfysisch Versneller Instituut in dezelfde stad. Hij werd astronaut nadat hij in 1977 had gereageerd op een advertentie met de kop: 'astronaut gezocht'."
                            }
                        ]
                    }
