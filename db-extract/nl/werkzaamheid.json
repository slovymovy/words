                        ],
                        "examples": [
                            {
                                "example_id": "6b2d9707-a218-4e14-b9f1-f3355261e533",
                                "sense_id": "e518b405-e3f3-37e3-8a6b-e6f8b525da9d",
                                "text": "Er werden veel werkzaamheden langs de weg uitgevoerd."
                            },
                            {
                                "example_id": "56cbccce-79bb-4a77-8f5d-080f1196fab6",
                                "sense_id": "e518b405-e3f3-37e3-8a6b-e6f8b525da9d",
                                "text": "Het begin van de renovatie van Museum Boijmans Van Beuningen ging niet zonder slag of stoot. De werkzaamheden begonnen in 2019 en zouden aanvankelijk tot 2026 duren. Dat werd al snel 2029. Tot die tijd is het museum gesloten."
                            }
                        ]
                    }
                ],
