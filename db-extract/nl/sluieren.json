        "nl-extract.jsonl": [
            {
                "entry_id": "f64bc707-a522-3ba6-b859-8bbf31099153",
                "word": "sluieren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1210964b-3154-30ea-821e-cf5a09dd49a1",
                        "entry_id": "f64bc707-a522-3ba6-b859-8bbf31099153",
                        "glosses": [
                            "dragen van een dunne doek die (een gedeelte van) het haar en het gezicht bedekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d09df3a-5379-4ec2-9eed-d34084c59887",
                                "sense_id": "1210964b-3154-30ea-821e-cf5a09dd49a1",
                                "text": "We beginnen in Iran, dat een lange traditie heeft in het voorschrijven hoe vrouwen zich moeten kleden. In 1936 werd het hen verboden om de chador te dragen – een verhullend zwart gewaad dat door de Sjah als ouderwets en on-Europees werd beschouwd. Het resultaat was dat vrouwen die zich wilden sluieren thuis bleven of een andere kledingstijl aannamen die weliswaar minder traditioneel was, maar toch het hoofd en het grootste deel van het lichaam bedekte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79dd964-b9af-4f70-8363-c009c73d5502",
                        "source_entry_id": "f64bc707-a522-3ba6-b859-8bbf31099153",
                        "source_sense_id": "1210964b-3154-30ea-821e-cf5a09dd49a1",
                        "target_lang_word": "veil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c1d78c3-f368-35b7-aad4-6c37473b1e6a",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "Something hung up or spread out to hide or protect the face, or hide an object from view; usually of gauze, crepe, or similar diaphanous material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa887eef-48d6-4eb3-aeb1-9673755089fa",
                                                "sense_id": "5c1d78c3-f368-35b7-aad4-6c37473b1e6a",
                                                "text": "The veil of the temple was rent in twain."
                                            },
                                            {
                                                "example_id": "4523d28a-10b2-45e2-b7ca-cb69bc9714b0",
                                                "sense_id": "5c1d78c3-f368-35b7-aad4-6c37473b1e6a",
                                                "text": "She, as a veil down to the slender waist, / Her unadorned golden tresses wore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d91db2fa-7296-3953-9ff3-b473cc1eaee5",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "Anything that partially obscures a clear view."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21989f33-2e0f-4225-99b2-9e3b6505c108",
                                                "sense_id": "d91db2fa-7296-3953-9ff3-b473cc1eaee5",
                                                "text": "Above the smoky veil over the town rose Akerhus fort, with its towers standing out in sharp relief against the mirror of the fjord, beyond where the Nœs point loomed as a black shadow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8b02c92-3a51-39b4-9b05-bf9b51f62549",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "A cover; disguise; a mask; a pretense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda39ed3-a0bd-4a17-bb11-cc64188f32cd",
                                                "sense_id": "a8b02c92-3a51-39b4-9b05-bf9b51f62549",
                                                "text": "[I will] pluck the borrowed veil of modesty from the so seeming Mistress Page."
                                            },
                                            {
                                                "example_id": "4dd2b1d5-4222-45ed-820f-0105cb0a674a",
                                                "sense_id": "a8b02c92-3a51-39b4-9b05-bf9b51f62549",
                                                "text": "Beckett complains that \"in the forest of symbols\" there is never quiet, and longs to break through the veil of language to silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "859b78d8-2dcb-34ce-aefd-ac25d8707bbd",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "A covering for a person or thing; as, a caul (especially over the head)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d94dcef4-eed4-4478-9b11-18eb68833b0f",
                                                "sense_id": "859b78d8-2dcb-34ce-aefd-ac25d8707bbd",
                                                "text": "a nun's veil"
                                            },
                                            {
                                                "example_id": "1174148a-8e99-4476-adf7-2dc16defea37",
                                                "sense_id": "859b78d8-2dcb-34ce-aefd-ac25d8707bbd",
                                                "text": "a paten veil"
                                            },
                                            {
                                                "example_id": "d42ea908-c982-43cd-968a-b16a4dd8176f",
                                                "sense_id": "859b78d8-2dcb-34ce-aefd-ac25d8707bbd",
                                                "text": "an altar veil"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a081a59-75f7-3b7a-a75b-55c3588ae6be",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "The calyptra of mosses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a2aca99-3994-31e9-ac6c-51d92dee4293",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "velum (A circular membrane round the cap of a medusa)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a0c4d88-9292-3746-ba2d-fcfef59236cc",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "A thin layer of tissue which is attached to or covers a mushroom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b9c7c29-7a6a-3bdb-b991-32a5585e4725",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "A membrane connecting the margin of the pileus of a mushroom with the stalk; a velum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57e6f8b-564f-4919-a10d-b03b3d592f45",
                                                "sense_id": "5b9c7c29-7a6a-3bdb-b991-32a5585e4725",
                                                "text": "The genus Amanita has both a volva and a veil; the spores are white, and the stem is easily separable from the cap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6389bc06-7b56-3575-af37-b337745596f3",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "An obscuration of the clearness of the tones in pronunciation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e28d67e-3cb2-3b58-b0c4-503e9cfd3c0b",
                                        "entry_id": "ada01c06-75ea-312d-9b88-b1fceae29a80",
                                        "glosses": [
                                            "That which separates the living and the spirit world."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b012d3ea-1f8a-444b-9ad7-34bca10970b9",
                                                "sense_id": "8e28d67e-3cb2-3b58-b0c4-503e9cfd3c0b",
                                                "text": "\"I have heard most furious bigots talking through the veil.\" \"So have I, for that matter,\" said Malone, \"and in this very room.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "veil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aec1b8c4-0e36-3c68-a62b-40152267a076",
                                        "entry_id": "2781947d-f77b-3d36-a83e-e87ae5aacd2c",
                                        "glosses": [
                                            "To dress in, or decorate with, a veil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a53dbd-1124-4a0c-89cf-ecd2dd2eb85f",
                                                "sense_id": "aec1b8c4-0e36-3c68-a62b-40152267a076",
                                                "text": "I'm under surface\nTowers veiled in silk\nI guess I'm not welcome\nIn this house they built"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95053376-5f28-395c-809d-bf6538176c60",
                                        "entry_id": "2781947d-f77b-3d36-a83e-e87ae5aacd2c",
                                        "glosses": [
                                            "To conceal as with a veil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfedd56d-91a0-4378-b206-342734a8398e",
                                                "sense_id": "95053376-5f28-395c-809d-bf6538176c60",
                                                "text": "The forest fire was veiled by smoke, but I could hear it clearly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
