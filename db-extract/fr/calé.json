                        "sense_id": "d76fea3a-1969-372f-8157-81ebb24b14d0",
                        "entry_id": "29eed423-aad5-389c-ab88-3bf2283081a5",
                        "glosses": [
                            "Dans l’aisance, riche."
                        ],
                        "tags": [
                            "colloquial",
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "198809b6-0e3b-44f4-84d3-817ec35219e9",
                                "sense_id": "d76fea3a-1969-372f-8157-81ebb24b14d0",
                                "text": "Ce pauvre M. Germain, qu’était pas bien calé non plus, faisait semblant de recevoir de temps en temps quelques bonnes bouteilles de vin de chez lui"
                            },
                            {
                                "example_id": "e5f77f16-1b72-4bf7-996f-0c7bd90a29fd",
                                "sense_id": "d76fea3a-1969-372f-8157-81ebb24b14d0",
                                "text": "Le comble était que les Gouin voulaient continuer de faire bonne figure dans le monde des hobereaux calés du pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca022c21-f054-3643-905d-abffc2031d44",
                        "entry_id": "29eed423-aad5-389c-ab88-3bf2283081a5",
                        "glosses": [
                            "Doué d’un grand savoir."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "92f52470-bd88-4a6c-ad26-2546ebfdf1fc",
                                "sense_id": "ca022c21-f054-3643-905d-abffc2031d44",
                                "text": "En algèbre, sentant mon interlocuteur plus calé que je ne le suis, je reprends mon rôle de disciple attentif."
                            }
                        ]
                    }
                ],
