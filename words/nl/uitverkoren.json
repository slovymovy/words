                {
                    "sense_id": "3f5a2597-607a-33ec-89fc-3a4837f498e8",
                    "sense_definition": "Bijzonder geliefd of geselecteerd boven alle anderen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "elect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Slechts enkelen voelden zich het <w>uitverkoren</w> volk in deze historische beweging.",
                            "target_lang_translations": {
                                "pl": "Tylko nieliczni czuli się narodem <w>wybranym</w> w tym historycznym ruchu."
                            }
                        },
                        {
                            "text": "Zij werd gezien als de <w>uitverkoren</w> opvolger van de vertrekkende directeur.",
                            "target_lang_translations": {
                                "pl": "Była postrzegana jako <w>wybrana</w> następczyni odchodzącego dyrektora."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitverkozen"
                    ],
                    "common_phrases": [
