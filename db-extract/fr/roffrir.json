                "senses": [
                    {
                        "sense_id": "01cd064f-5463-3cd5-af9f-e614bb81236d",
                        "entry_id": "4aa272af-9322-3b41-b1d0-446f2a6a43fa",
                        "glosses": [
                            "Offrir de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5badf7f-c65d-4591-9d31-3702b9634897",
                                "sense_id": "01cd064f-5463-3cd5-af9f-e614bb81236d",
                                "text": "Vivement que j'arrive à 80 kg pour me roffrir une séance"
                            },
                            {
                                "example_id": "559d8a37-c2e4-406b-b7bb-2642797b0155",
                                "sense_id": "01cd064f-5463-3cd5-af9f-e614bb81236d",
                                "text": "Mon fils de 10 ans, attend son cadeau de Noël de décembre 2008, et nous n'avons pas les moyens de lui roffrir à nouveau ce cadeau de 362€70 qui ont été débités le soir même de la commande."
                            },
                            {
                                "example_id": "b4493c54-493d-49ee-b854-ddd3aa92cc21",
                                "sense_id": "01cd064f-5463-3cd5-af9f-e614bb81236d",
                                "text": "Dites-nous quels cadeaux vous avez aimés et lesquels vous aimeriez roffrir."
                            }
                        ]
                    }
