                "translations": [
                    {
                        "translation_id": "cb79bc30-9529-4e84-b553-e865398ad43d",
                        "source_entry_id": "02b98942-0c70-3556-b599-a9f544b2816f",
                        "source_sense_id": "e3867d06-ddda-3cda-bf3d-67780d0e2e59",
                        "target_lang_word": "retail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3236ad-269b-3b55-92ce-0dd837edf44f",
                                        "entry_id": "028353cd-7a54-35ac-a9d2-d9b9cebfd625",
                                        "glosses": [
                                            "The sale of goods directly to the consumer, encompassing the storefronts, mail-order, websites, etc., and the corporate mechanisms, branding, advertising, etc. that support them."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21498b61-bf57-4653-9a98-f90e3547f1ba",
                                                "sense_id": "4d3236ad-269b-3b55-92ce-0dd837edf44f",
                                                "text": "She works in retail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee054d36-29c5-3dc9-ae0f-5c8feb594a80",
                                        "entry_id": "028353cd-7a54-35ac-a9d2-d9b9cebfd625",
                                        "glosses": [
                                            "Retail price; full price; an abbreviated expression, meaning the full suggested price of a particular good or service, before any sale, discount, or other deal."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49ff4dd2-7143-4780-897d-644fc3544dfb",
                                                "sense_id": "ee054d36-29c5-3dc9-ae0f-5c8feb594a80",
                                                "text": "I never pay retail for clothes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be58d8f1-37ca-3f22-85bb-7b635c938dcd",
                                        "entry_id": "c71770da-8595-3e89-bd5d-fcb18217981d",
                                        "glosses": [
                                            "Of or relating to the (actual or figurative) sale of goods or services directly to individuals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95796386-65d8-4e84-b604-28ffe67cc901",
                                                "sense_id": "be58d8f1-37ca-3f22-85bb-7b635c938dcd",
                                                "text": "\"This is a very retail approach for us,\" Czerw said. \"But when you buy one out of every six home loans in the US, you are going to have a constant flow ...\""
                                            },
                                            {
                                                "example_id": "2126033a-a3e0-4daa-bf75-023cd31b26ce",
                                                "sense_id": "be58d8f1-37ca-3f22-85bb-7b635c938dcd",
                                                "text": "The future for Bradley International Airport near Hartford, Conn., also looks very retail. Plans call for $156 million to expand the main terminal,"
                                            },
                                            {
                                                "example_id": "e417128c-d477-4e42-b4c9-f407c5e2edfb",
                                                "sense_id": "be58d8f1-37ca-3f22-85bb-7b635c938dcd",
                                                "text": "But even with her level of celebrity, it would be very hard to win a race without engaging voters in a very retail way."
                                            },
                                            {
                                                "example_id": "7a88a3b5-01ee-4133-a61f-75a453947893",
                                                "sense_id": "be58d8f1-37ca-3f22-85bb-7b635c938dcd",
                                                "text": "When the New York Post branded Ron DeSantis “DeFuture” in 2022[…], it had not reckoned on the Florida governor being astonishingly awkward with the basics of retail politics: smiling, shaking hands, interacting with other people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23223a6e-b463-3937-8069-05208a7f4c9c",
                                        "entry_id": "258bfcb3-7bb4-3bd5-bd2c-fe5202ba309d",
                                        "glosses": [
                                            "Direct to consumers, in retail quantities, or at retail prices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b407ecac-3703-478d-b554-26969c38a2ec",
                                                "sense_id": "23223a6e-b463-3937-8069-05208a7f4c9c",
                                                "text": "We've shut shown our reseller unit. We're only selling retail now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f38c5a3-8890-376c-8023-ce6cf35d99d6",
                                        "entry_id": "6e8da720-7b68-305d-a46f-b56b3b28bfb1",
                                        "glosses": [
                                            "To sell at retail, or in small quantities directly to customers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff91ff9-0257-40ed-be60-9cff204368f8",
                                                "sense_id": "9f38c5a3-8890-376c-8023-ce6cf35d99d6",
                                                "text": "a half part of this purveying is carried on within the city and is called retailing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64edb04c-daae-3beb-b322-575dad093003",
                                        "entry_id": "6e8da720-7b68-305d-a46f-b56b3b28bfb1",
                                        "glosses": [
                                            "To sell secondhand, or in broken parts."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70a34049-d0d9-3a7c-abf4-9fee80bb3b18",
                                        "entry_id": "6e8da720-7b68-305d-a46f-b56b3b28bfb1",
                                        "glosses": [
                                            "To repeat or circulate (news or rumours) to others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5da16d-8ac2-488f-8ca6-8994c8fd3020",
                                                "sense_id": "70a34049-d0d9-3a7c-abf4-9fee80bb3b18",
                                                "text": "He retailed to them the curious interchange of phrases he had overheard on the journey from Aleppo."
                                            },
                                            {
                                                "example_id": "6a299f45-b39d-40ff-a15f-814657b84788",
                                                "sense_id": "70a34049-d0d9-3a7c-abf4-9fee80bb3b18",
                                                "text": "He became quite pale as he retailed these stories to Constance."
                                            },
                                            {
                                                "example_id": "572624cb-4f30-4d58-91f6-c672dfcb4f8e",
                                                "sense_id": "70a34049-d0d9-3a7c-abf4-9fee80bb3b18",
                                                "text": "The fantasies of blood libel that Bosnian Serbs retailed about Bosnian Muslims were the fantasies that Rhinelanders had centuries earlier retailed about the Jews they had murdered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
