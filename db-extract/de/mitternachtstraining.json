                "senses": [
                    {
                        "sense_id": "91532476-3f3c-38b6-a2ab-b131ea40a694",
                        "entry_id": "68a660ea-afcc-31f1-8d6c-53f83098f258",
                        "glosses": [
                            "Training um Mitternacht"
