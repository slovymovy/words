                                                "example_id": "498da3cf-fd5e-497d-848f-d80dbbf45fa3",
                                                "sense_id": "bd87ee97-0944-368f-ad70-02dcc4833661",
                                                "text": "She had never seen Frank Churchill so silent and stupid. He said nothing worth hearing—looked without seeing—admired without intelligence—listened without knowing what she said."
                                            }
                                        ]
                                    },
