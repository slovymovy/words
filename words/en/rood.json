{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e412cad-e989-32de-b315-831cc68f52b0",
                    "sense_definition": "A crucifix or cross, especially a large one displayed in a Christian church.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval church featured an intricately carved wooden <w>rood</w> suspended high above the entrance to the choir.",
                            "target_lang_translations": {
                                "ru": "В средневековой церкви над входом в хор висело деревянное <w>распятие</w> с искусной резьбой."
                            }
                        },
                        {
                            "text": "During the Reformation, many traditional rood screens and their accompanying statues were removed or destroyed.",
                            "target_lang_translations": {
                                "ru": "Во время Реформации многие традиционные алтарные перегородки с <w>распятиями</w> и сопутствующие им статуи были убраны или уничтожены."
                            }
                        }
                    ],
                    "common_phrases": [
                        "holy rood",
                        "rood screen",
                        "by the rood"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "commonly encountered in historical or religious architecture contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распятие или крест, особенно крупный, установленный в христианской церкви."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распятие",
                                "target_lang_sense_clarification": "большой крест в храме"
                            },
                            {
                                "target_lang_word": "крест",
                                "target_lang_sense_clarification": "церковный крест"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bff04f75-5897-3de4-ae87-42ecca6fc4d5",
                    "sense_definition": "An old traditional unit of land area equal to one quarter of an acre or forty perches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unit_of_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old property deed stated that the farm included three acres and one <w>rood</w> of fertile land.",
                            "target_lang_translations": {
                                "ru": "В старом документе на собственность указывалось, что ферма включает три акра и один <w>руд</w> плодородной земли."
                            }
                        },
                        {
                            "text": "He purchased a small <w>rood</w> of earth situated behind the village churchyard.",
                            "target_lang_translations": {
                                "ru": "Он приобрёл небольшой <w>руд</w> земли, расположенный за деревенским церковным кладбищем."
                            }
                        }
                    ],
                    "synonyms": [
                        "farthingdale",
                        "farthingdeal"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "traditional unit of area"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная английская мера площади земельных участков, равная четверти акра (40 квадратным родам или около 1012 кв. м)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руд",
                                "target_lang_sense_clarification": "мера площади, 1/4 акра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1a8a510-c9ae-3d36-86a0-e7282f981f6e",
                    "sense_definition": "An obsolete linear measure equal to five and a half yards, equivalent to a rod or perch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unit_of_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveyor measured the ditch by the <w>rood</w> rather than in modern feet.",
                            "target_lang_translations": {
                                "ru": "Землемер измерял ров в <w>рудах</w>, а не в современных футах."
                            }
                        },
                        {
                            "text": "The ancient ditch was several <w>roods</w> long and bordered the estate.",
                            "target_lang_translations": {
                                "ru": "Древний ров тянулся на несколько <w>рудов</w> и окаймлял поместье."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "archaic linear unit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая английская мера длины, равная 5,5 ярдам (около 5,03 метра); эквивалентна роду или перчу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руд",
                                "target_lang_sense_clarification": "линейная мера, 5,5 ярдов"
                            },
                            {
                                "target_lang_word": "род",
                                "target_lang_sense_clarification": "линейная мера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48cdca51-499b-33fc-aab6-918586160e84",
                    "sense_definition": "A traditional surface area measurement equal to sixty-four square yards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unit_of_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local records described the small quarry as occupying a single <w>rood</w>.",
                            "target_lang_translations": {
                                "ru": "В местных записях указывалось, что небольшая каменоломня занимает ровно один <w>руд</w>."
                            }
                        },
                        {
                            "text": "They marked out another <w>rood</w> of stone to be excavated before winter.",
                            "target_lang_translations": {
                                "ru": "Они разметили ещё один <w>руд</w> камня для выемки до наступления зимы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "regional area measure"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная мера площади поверхности, равная 64 квадратным ярдам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руд",
                                "target_lang_sense_clarification": "мера площади, 64 кв. ярда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a531786d-4fe9-3668-a1d5-63c222b6d871",
                    "sense_definition": "The face or countenance of a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript praised the maiden for her fair <w>rood</w> and gentle eyes.",
                            "target_lang_translations": {
                                "ru": "В древней рукописи девушку восхваляли за прекрасный <w>лик</w> и кроткие глаза."
                            }
                        },
                        {
                            "text": "Grief seemed to wash all color from her sweet <w>rood</w>.",
                            "target_lang_translations": {
                                "ru": "Казалось, горе согнало все краски с её милого <w>лица</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "variant of rode"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или облик человека (устаревший вариант слова rode)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "облик человека"
                            },
                            {
                                "target_lang_word": "лик",
                                "target_lang_sense_clarification": "лицо, высок./устар."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0ad434cc-c3b6-3d2b-97ae-418dc95d979e",
                    "sense_definition": "A surname of English origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Rood</w> delivered an insightful guest lecture on nineteenth-century optical physics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Руд</w> прочитал содержательную гостевую лекцию по оптической физике девятнадцатого века."
                            }
                        },
                        {
                            "text": "Records indicate that the <w>Rood</w> family resided in this valley for generations.",
                            "target_lang_translations": {
                                "ru": "Записи указывают на то, что семья <w>Руд</w> жила в этой долине на протяжении многих поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Руд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
