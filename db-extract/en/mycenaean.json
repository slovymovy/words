                                            {
                                                "example_id": "b48b28ec-cfd4-4716-bbce-68735e0f677e",
                                                "sense_id": "36e60dca-60b7-335a-a494-96615c404d9a",
                                                "text": "„Von mykenischer Zeit bis ins römische Kaiserreich vertrauten die Soldaten vorrangig auf den Speer als Angriffswaffe.“"
                                            },
                                            {
                                                "example_id": "f1236579-70dc-45b4-b982-c7a4f6e008c5",
                                                "sense_id": "36e60dca-60b7-335a-a494-96615c404d9a",
                                                "text": "„Insgesamt zeichnete ein hoher Qualitätsstandard die mykenische Keramikproduktion aus.“"
                                            },
                                            {
                                                "example_id": "71510f4c-14b0-49bb-a844-0f68912117f5",
                                                "sense_id": "36e60dca-60b7-335a-a494-96615c404d9a",
                                                "text": "„Mykenische Waffen, Schmuck und Keramik sind dagegen weniger ausdrucksvoll, stilistisch einfacher und von geringerer Farbqualität.“"
                                            }
                                        ],
