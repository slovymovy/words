                        ],
                        "examples": [
                            {
                                "example_id": "4c1188cf-0bf8-4350-bd49-570ab64bc726",
                                "sense_id": "f4b03e8f-80ba-34db-8295-6532b7fa6861",
                                "text": "En dehors des Donjons comme le Minotoboule, Nowel accueillera dans ses Taïga un nouveau mini-Boss de niveau 200 ! Celui-ci permettra d’obtenir un Cadeau Dofusien ainsi qu'un coffre contenant une ressource exclusive nécessaire à des recettes détaillées plus bas !"
                            },
                            {
                                "example_id": "e5ab5bdd-a408-431c-86ce-f7fe6a7882f0",
                                "sense_id": "f4b03e8f-80ba-34db-8295-6532b7fa6861",
                                "text": "Il s’agit d’un pack comprenant un chèque cinéma universel et un accès en avant-première à la classe Huppermage (pour plus d’explications sur ce concept dofusien)."
                            },
                            {
                                "example_id": "13cd69c6-782c-4395-8037-6fe7915911e0",
                                "sense_id": "f4b03e8f-80ba-34db-8295-6532b7fa6861",
                                "text": "Tous les équipements du jeu qui bénéficient d’une recette peuvent s’obtenir en combattant les nombreux monstres qui composent le bestiaire Dofusien."
                            }
                        ]
                    }
