                ],
                "senses": [
                    {
                        "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                        "entry_id": "83110318-e7af-3729-857d-b94ad24c1b88",
                        "glosses": [
                            "Stadt innerhalb des Bundeslandes Bremen, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c3f6d6a-d45a-4c1c-aead-75b5645b5f55",
                                "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                                "text": "Bremerhaven liegt an der unteren Weser."
                            },
                            {
                                "example_id": "0603160c-a3b5-44b6-afb9-c638141c5386",
                                "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                                "text": "Ich bin in Bremerhaven geboren."
                            },
                            {
                                "example_id": "24ecb65c-fc1f-4762-ac9e-46cc1ccb7a1d",
                                "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                                "text": "Wir haben in Bremerhaven unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "a2650d8b-5002-4b8e-925b-e2a797f80151",
                                "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                                "text": "Nach Bremerhaven führen viele Wege."
                            },
                            {
                                "example_id": "bd9d03d5-1c1f-49fb-af66-cbe85b13ec2e",
                                "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                                "text": "Bremerhaven liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "070e6168-0fe5-484e-b502-5bbf81b27784",
                                "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                                "text": "Das Bremerhaven des 18. Jahrhunderts war auf keiner Karte zu finden, weil es noch nicht existierte."
                            },
                            {
                                "example_id": "ec560525-2837-4559-b304-764ca996304d",
                                "sense_id": "55e7b747-6507-3095-b104-38ccefa219b7",
                                "text": "„Wer es sich leisten konnte, war an Bord des ausgebuchten Ozeanriesen, als dieser am 16. Juli 1929 unter Kapitän Leopold Ziegenbein in Bremerhaven ablegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
