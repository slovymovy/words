                        "glosses": [
                            "Buch, mit dessen Hilfe Codes entschlüsselt werden können, das Informationen zur Codierung von Mitteilungen enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2694cb2-56bc-470e-967b-9c30251d0ed6",
                                "sense_id": "be65a5a3-b7ef-3325-a681-9333300a8784",
                                "text": "„White solle dann bitte nicht vergessen, seine Codebücher zu verbrennen.“"
                            }
