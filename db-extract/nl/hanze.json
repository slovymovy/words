                "translations": [
                    {
                        "translation_id": "8397b960-ae0e-4c40-a53a-d51b035edc6e",
                        "source_entry_id": "816468a1-3a31-3d5b-aaf9-6e5597cda2aa",
                        "source_sense_id": "ef87636a-ed15-33f2-973a-7cf11a116aa0",
