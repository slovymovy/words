                ],
                "senses": [
                    {
                        "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                        "entry_id": "f6b8b633-2fc8-380d-876a-97aa99d860da",
                        "glosses": [
                            "Musikrichtung, für die Rap, Sampling und Scratchen charakteristisch sind und zu deren Subkultur Breakdance und Beatboxing gehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f919c84-7071-43c2-833a-56f4711a8796",
                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                "text": "Hip-Hop ist eine der populärsten Musikrichtungen der Welt."
                            },
                            {
                                "example_id": "132ec980-2592-4d2b-9a3a-8ef6d08cbefc",
                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                "text": "Es gab eine Zeit, da trafen sich die Freunde des Hip-Hop auf Jams."
                            },
                            {
                                "example_id": "20fa2666-6bcd-4dff-be49-b73b719b2a7f",
                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                "text": "„Auch Techno und Hip-Hop gehen in Teilen darauf zurück.“"
                            },
                            {
                                "example_id": "18002daf-15a5-46a8-8ac8-3be9c2935ac1",
                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                "text": "„Rap und Hip-Hop geben in der afrikanischen Popmusik jetzt den Ton an.“"
                            },
                            {
                                "example_id": "4e1773af-05a9-41bc-bc78-30811648e923",
                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                "text": "„Es ist kein Zufall, dass der kulturelle Siegeszug der schwarzen Musik, des Jazz, des Blues, des Hip-Hop und Rap den Schwarzen die ersten Türen zur High Society öffnete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3138da19-5a9e-4f62-80fe-2c33c1b51e8b",
                        "source_entry_id": "f6b8b633-2fc8-380d-876a-97aa99d860da",
                        "source_sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                        "target_lang_word": "hip-hop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hip-hop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae07eb4a-c24a-3200-b782-5c6c26b1b922",
                                        "entry_id": "1d1c553f-4cf4-3ec4-b30c-8cad7c0ab39f",
                                        "glosses": [
                                            "An African-American urban youth culture based on rap music, breakdancing etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e372834-0f72-48d2-9dbc-69bccd02b9a5",
                                                "sense_id": "ae07eb4a-c24a-3200-b782-5c6c26b1b922",
                                                "text": "2007, James McBide, Hip-Hop Planet, National Geographic (April 2007), 106,\n\"...not knowning as they strolled through the doors of the community center near Bambaataa's mother's apartment that they were writing musical history. Among them was an MC named Lovebug Starski, who was said to utter the phrase 'hip-hop' between breaks in time.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d49458d3-e5ac-35d9-81f3-67a0dad7f35b",
                                        "entry_id": "1d1c553f-4cf4-3ec4-b30c-8cad7c0ab39f",
                                        "glosses": [
                                            "A form of popular and dance music featuring strong percussion and a powerful rhythm, usually accompanied by rapping."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb1ecda-4caf-4b8a-a62b-ee5242e6adc4",
                                                "sense_id": "d49458d3-e5ac-35d9-81f3-67a0dad7f35b",
                                                "text": "Even though Houston’s moment was already fading by the late 2000s, the city’s hip-hop culture proved to be endlessly portable and disseminatable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hip-hop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                        "entry_id": "f434e87e-d642-3914-8363-575a874bcd24",
                                        "glosses": [
                                            "To move by hopping or with a hopping motion."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89fb6515-cf3b-40ef-bc2e-cfcbff8e529f",
                                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                                "text": "Placing the hoops in this position makes skirts hip hop with a swirl."
                                            },
                                            {
                                                "example_id": "edc6efe1-6060-45d4-b0ed-d9c8e29f59d1",
                                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                                "text": "I have a bunny and he goes hip hop, I often wonder if he cannot stop."
                                            },
                                            {
                                                "example_id": "8e7c33b4-3eb1-482c-b0ae-0ce7d9a48946",
                                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                                "text": "Like magic, the frog hip-hopped out of her thoughts and the starlings came fluttering back and Sammy was there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b63f4736-e8f2-3934-92fb-80de58a2432d",
                                        "entry_id": "f434e87e-d642-3914-8363-575a874bcd24",
                                        "glosses": [
                                            "To perform hip-hop music."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfff164e-f0f5-4586-bc8f-3494fd3ac55e",
                                                "sense_id": "b63f4736-e8f2-3934-92fb-80de58a2432d",
                                                "text": "I'm not entirely sure who in WCW felt like a bunch of hip-hopping rappers would get cheered in a company based mainly in the south (especially with a country band stable on the other side), but everything's a good idea in theory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb196ad6-345c-4b27-a2b2-ddcc6d08f25b",
                        "source_entry_id": "f6b8b633-2fc8-380d-876a-97aa99d860da",
                        "source_sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                        "target_lang_word": "hip-hop",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hip-hop",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c11a770b-c012-3034-b179-5f6470f70650",
                                        "entry_id": "2a0a5ffa-473b-31d8-aab3-a2fceb7114ef",
                                        "glosses": [
                                            "Variante orthographique de hip hop."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b09b3274-4ae8-4f7c-b8fa-2189703e3635",
                                                "sense_id": "c11a770b-c012-3034-b179-5f6470f70650",
                                                "text": "Ils étaient dans la lignée de beaucoup de rappeurs et rappeuses qui véhiculaient des textes engagés. Parmi eux, il y avait la pionnière du rap féminin, Queen Latifah, qui créa une véritable révolution dans le monde machiste du hip-hop."
                                            },
                                            {
                                                "example_id": "0a46f2f3-5e5f-4175-b4c2-bdf1c768526f",
                                                "sense_id": "c11a770b-c012-3034-b179-5f6470f70650",
                                                "text": "35 professeurs spécialisés en salsa, bachata, dancehall ou hip-hop venant du monde entier dispensent en journée des cours aux adultes, aux enfants et pour la première fois cette année, aux seniors."
                                            },
                                            {
                                                "example_id": "258fc6b8-85d5-4898-91f8-4b478620d4de",
                                                "sense_id": "c11a770b-c012-3034-b179-5f6470f70650",
                                                "text": "« Le hip-hop inonde toute la culture française et elle (sic) est très peu représentée dans les instances, dans les institutions », a-t-elle conclu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hip-hop",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a12085e-e691-31a7-b04f-573b4e3961b3",
                                        "entry_id": "3b032ebe-82f4-39e0-8a8b-b342436af9ec",
                                        "glosses": [
                                            "Caractéristique des modes et du monde entourant la musique hip-hop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2efad3b7-7478-4fbb-9cc7-dd6fa7d09258",
                                                "sense_id": "2a12085e-e691-31a7-b04f-573b4e3961b3",
                                                "text": "… l'artiste a joué un rôle non négligeable dans l'évolution des bijoux hip-hop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
