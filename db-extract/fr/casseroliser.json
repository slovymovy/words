                "senses": [
                    {
                        "sense_id": "81843c05-2916-3255-ba8d-5f73b667bb1f",
                        "entry_id": "8d76070b-9aaf-3087-9974-6bc7c0b20fd8",
                        "glosses": [
                            "Frapper sur des casseroles pour faire du bruit, pour exprimer son mécontentement (ou, parfois, pour exprimer son admiration)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f89aa6-fb53-4647-af06-da8e53795b6e",
                                "sense_id": "81843c05-2916-3255-ba8d-5f73b667bb1f",
                                "text": "C’est le temps de crier ou de \"casseroliser\" contre le PLQ."
                            },
                            {
                                "example_id": "d19bffcd-d11f-406a-a67f-87a3eb95b8fe",
                                "sense_id": "81843c05-2916-3255-ba8d-5f73b667bb1f",
                                "text": "Il a inventé le concert de casseroles et aujourd’hui il est casserolisé par les étudiants devant la mairie à Ziguinchor."
                            },
                            {
                                "example_id": "2cf03832-6dd8-4602-bb20-adc725e495d0",
                                "sense_id": "81843c05-2916-3255-ba8d-5f73b667bb1f",
                                "text": "Et ceux qui le casserolisent, qui le tuent à tue-tête et qui s’indignent à la face du monde, sont-ils si dignes de leur indignation ?"
                            }
                        ]
                    }
