                    {
                        "sense_id": "3b51cbef-f1af-36bc-bb1a-222e9d18327f",
                        "entry_id": "fbc1dfdc-117f-3ec0-bd0f-a7d27ed89766",
                        "glosses": [
                            "Titre d’honneur donné à certains patriarches des églises orientales."
                        ],
