                        "examples": [
                            {
                                "example_id": "6b75101b-4d4f-40da-bd1a-befe0c580cd0",
                                "sense_id": "c98b42ca-c413-3f3f-909c-108fc8906cf0",
                                "text": "Autrement dit, le palais est un ensemble d’espaces conçu en principe pour le bien et le beau, une eutopie."
                            },
                            {
                                "example_id": "260bc15a-e3e8-45d8-bad1-740244ee79d9",
                                "sense_id": "c98b42ca-c413-3f3f-909c-108fc8906cf0",
                                "text": "Là où son père avait fait du domaine le lieu de la gabegie et de la faiblesse, Montès aspire à réaliser une eutopie, un des ces lieux idéals « où dans une sorte de non-temps s’étire la douce rêverie de l’être-bien […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ace2d53-fe54-4db7-ae52-f7d4914884bd",
                        "source_entry_id": "eaf5efc5-8c95-3daa-bcbc-81360319cddd",
                        "source_sense_id": "c98b42ca-c413-3f3f-909c-108fc8906cf0",
                        "target_lang_word": "Eutopie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eutopie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1dca973-a83d-3649-8d41-626e6dab84f6",
                                        "entry_id": "82f533aa-5ca4-3c8a-9969-eacd5ffb5aa4",
                                        "glosses": [
                                            "die normale Lage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6064f497-39f0-42b9-83d5-ded83c666f65",
                                                "sense_id": "d1dca973-a83d-3649-8d41-626e6dab84f6",
                                                "text": "Da die körperliche Anspannung nicht nur die Lage, Ruhe und damit Funktionstüchtigkeit der Organe betrifft, sondern auch die Gedanken der Person (in der Klarheit ihrer grundlegenden Annahmen) von dieser beeinflusst werden, spiegelt sich die grundlegende Einstellung bzgl. der individuellen Vorstellung dessen, was die Gesellschaft sei in dem Grad des veräusserten Vertrauens bei jeder Kommunikation mit Mitmenschen wieder und drückt sich gleichzeitig innerlich, vermittels der Angst aus mangelndem Vertrauen in der Anspannung und somit Lage der Organe aus. Eutopie bezeichnet nun beiderlei wohlwollende Ordnung, die synergetisch (physisch und psychologisch) aus dem Vertrauen in das gesunde Umfeld entsteht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b219a9f-c525-3fbf-a9bc-3dd27d6d7909",
                                        "entry_id": "82f533aa-5ca4-3c8a-9969-eacd5ffb5aa4",
                                        "glosses": [
                                            "die normale Lage von Organen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb27bd6-cd50-4987-9999-bf03fb0f3b83",
                                                "sense_id": "4b219a9f-c525-3fbf-a9bc-3dd27d6d7909",
                                                "text": "Auch nach der Obduktion können wir die Eutopie nur bestätigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a8514a09-03b6-399d-9ca7-d81b557ab0f0",
                                        "entry_id": "82f533aa-5ca4-3c8a-9969-eacd5ffb5aa4",
                                        "glosses": [
                                            "die Idealgesellschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a102173f-c148-4d21-bad6-0e252e480e77",
                                                "sense_id": "a8514a09-03b6-399d-9ca7-d81b557ab0f0",
                                                "text": "Eine Utopie schildert einen Zustand, den wir in der Realität nicht haben. Sie läßt sich in verschiedene Klassen aufteilen und eine dieser Klassen ist die Eutopie, die von „guten Orten“ handelt."
                                            },
                                            {
                                                "example_id": "6b2e8e81-9337-4f41-8c13-3c4204863ba2",
                                                "sense_id": "a8514a09-03b6-399d-9ca7-d81b557ab0f0",
                                                "text": "Es gibt wohl mehr kritische Utopien als Eutopien."
                                            },
                                            {
                                                "example_id": "04b47ab9-100a-40a3-89c1-c286aab3ede9",
                                                "sense_id": "a8514a09-03b6-399d-9ca7-d81b557ab0f0",
                                                "text": "Ich will hier wenigstens im gröbsten Umriss und prinzipiell zeigen, dass eine Gesellschaft ohne systematische Verletzung des Selbsteigentums und des Eigentums keine Utopie ist, keine Fata Morgana und Denkunmöglichkeit, kein „Nicht-Ort“ des Thomas Morus, sondern eine Eutopie, ein schöner, weil richtiger Ort, geradezu eine Denknotwendigkeit, ungeachtet der Tatsache, dass sie noch kein real existierender Ort ist und war . . ."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
