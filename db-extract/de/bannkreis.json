                "senses": [
                    {
                        "sense_id": "0842c547-bac0-3877-9721-c149fd2edc0e",
                        "entry_id": "3d82cb75-2f40-3153-8bac-1f33fc86ffff",
                        "glosses": [
                            "Bereich mit Möglichkeit auf jemand oder etwas einzuwirken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a6f74b-bb76-414e-90b3-4b207670d028",
                                "sense_id": "0842c547-bac0-3877-9721-c149fd2edc0e",
                                "text": "„Jung-Jackson geriet in den Bannkreis einer Chicano-Gang, bewaffnet mit Vaters Rasiermesser und einer Hundekette.“"
                            },
                            {
                                "example_id": "ccd226ce-190a-4bdf-bfc0-3a7dcebef46a",
                                "sense_id": "0842c547-bac0-3877-9721-c149fd2edc0e",
                                "text": "„Die Daten seiner Biographie, an sich belanglos, werden dadurch, daß sie im Bannkreise zweier Kriege und in der uneingeschränkten Machtentfaltung der größten Verbrecherorganisation aller Zeiten ihre Beziehung finden, in eine allgemeine Ebene gehoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "22945ff2-ed3c-3668-b452-54d91d5c4d49",
                        "entry_id": "3d82cb75-2f40-3153-8bac-1f33fc86ffff",
                        "glosses": [
                            "gesondert gekennzeichneter räumlicher Bereich, in dem bestimmte Tätigkeiten oder Versammlungen verboten sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f0f672b-aa6d-4e76-82b5-2db144b6e017",
                                "sense_id": "22945ff2-ed3c-3668-b452-54d91d5c4d49",
                                "text": "„Dramatischste Neuigkeit: verbotene Parteienwerbung im 30-Meter-Bannkreis um ein Wahllokal.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
