                                        "glosses": [
                                            "An SI/MKS unit of measure, the length of ¹⁄₁₀₀₀ of a metre. Symbol: mm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ccba76-4810-4158-bbc9-7a2715b7dcdf",
                                                "sense_id": "d4caaa91-c840-332b-9837-37054fbb9e2b",
                                                "text": "Holonyms: centimetre < decimetre < metre < kilometre < megametre < gigametre < terametre < petametre"
                                            },
                                            {
                                                "example_id": "8027a3c2-97ce-420e-96a1-91b169870903",
                                                "sense_id": "d4caaa91-c840-332b-9837-37054fbb9e2b",
                                                "text": "Meronyms: picometre < nanometre < micrometre"
                                            }
                                        ]
