                                        "glosses": [
                                            "Alkohol mit 12 C-Atomen und einer Hydroxyl-Gruppe, Strukturformel C₁₂H₂₅-OH"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11aee166-6dd4-434f-a3c5-0fc30048acd1",
                                                "sense_id": "d68fb54c-a0de-3f39-8fda-5165b0b3318c",
                                                "text": "Dodecanol reagiert mit Essigsäure zu Essigsäuredodecylester."
                                            },
                                            {
                                                "example_id": "6626ecc5-18bc-488e-a1f0-46c87a31b878",
                                                "sense_id": "d68fb54c-a0de-3f39-8fda-5165b0b3318c",
                                                "text": "„Zum Vergleich wurden die Bildungsenthalpien fuer alle unverzweigten Dodecanole und deren Acetate, Benzoate und (Trichlor)acetat berechnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
