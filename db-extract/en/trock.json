                    {
                        "sense_id": "a96d137d-e2d0-3318-bbac-f73734c9d07f",
                        "entry_id": "0346e5d3-190e-3bbf-913a-6d54268b74f5",
                        "glosses": [
                            "A genre of music produced by fans of the British science-fiction television series Doctor Who, characterized by lyrics about its characters, settings, and plot elements."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aba566bd-21a0-431c-ba03-268a3455caa3",
                                "sense_id": "a96d137d-e2d0-3318-bbac-f73734c9d07f",
                                "text": "One of the more interesting activities is the writing of “Trock,” or Timelord rock, a genre of music well known among the show's fans that celebrates the show and its characters."
                            },
                            {
                                "example_id": "1f8aa7c5-4fcb-4ca0-beca-6c6b0cf12486",
                                "sense_id": "a96d137d-e2d0-3318-bbac-f73734c9d07f",
                                "text": "Allegra is more of an indie upstart, \"though (she's) one of the people who always comes up when you talk about Trock,\" says Perry Michael Simon, who edits \"The Nerdist,\" comedian Chris Hardwick's popular, geek-centric website."
                            },
                            {
                                "example_id": "390a00cf-0b73-4c01-9074-eee819ff6108",
                                "sense_id": "a96d137d-e2d0-3318-bbac-f73734c9d07f",
                                "text": "The originators of the Trock phenomenon, Chameleon Circuit's ode to the TARDIS is a delightfully retro-eighties-sounding jaunt, Gary Numan with an even more one-track mind than the original."
                            }
                        ]
                    }
