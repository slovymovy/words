                    {
                        "translation_id": "89badbec-6295-4fd4-9af0-6acd6ff4c7a7",
                        "source_entry_id": "6b058b7c-2065-330f-aecb-2eb7dffdaacb",
                        "source_sense_id": "6c15f8f7-8bec-3d9e-9281-5b87f818f22c",
