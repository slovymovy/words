                "senses": [
                    {
                        "sense_id": "106db50d-f0e6-3303-b6b0-3be8d131f065",
                        "entry_id": "292219e6-2f20-33d4-a91d-f2177f96c288",
                        "glosses": [
                            "Qui présente ou qui est parsemé de falaises."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "66953e37-5a9b-405d-9bde-e40dfbe7d423",
                                "sense_id": "106db50d-f0e6-3303-b6b0-3be8d131f065",
                                "text": "Parmi mes favoris, le rognon boursouflé, falaiseux et jouxté d’une épaule herbeuse caractéristique du Maja e Proshit à 2412 mètres ne laisse pas indifférent."
                            },
                            {
                                "example_id": "7792b242-5e25-4583-a3ad-5dbcb0f9dc5e",
                                "sense_id": "106db50d-f0e6-3303-b6b0-3be8d131f065",
                                "text": "Cette très grande île, qu’est Anticosti, a deux visages. Son versant Nord est un front abrupt, falaiseux, entrecoupé de plusieurs caps, près desquels la mer est croisée."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ed0a4a7-0d8e-3789-b70a-b35b8f4d9781",
                        "entry_id": "292219e6-2f20-33d4-a91d-f2177f96c288",
                        "glosses": [
                            "Qui évoque l’aspect abrupt d’une falaise."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "96e66f1f-9e7b-48ee-b5ac-a4c4cb29915b",
                                "sense_id": "9ed0a4a7-0d8e-3789-b70a-b35b8f4d9781",
                                "text": "Leur amitié est devenue falaiseuse : un instant de chaleur humaine, puis un silence abrupt, sans le moindre appel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16b12158-b0e7-4c1c-bb31-e1041289fa91",
                        "source_entry_id": "292219e6-2f20-33d4-a91d-f2177f96c288",
                        "target_lang_word": "cliffy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cliffy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25c0d92b-3501-3ec7-a3c1-d5009b516d38",
                                        "entry_id": "5b28a3e8-3d80-33cb-b763-1a14ef53328c",
                                        "glosses": [
                                            "Abounding in cliffs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5da821b-2030-4f1f-93ae-47bb764ba28d",
                                                "sense_id": "25c0d92b-3501-3ec7-a3c1-d5009b516d38",
                                                "text": "1865, Henry David Thoreau, Cape Cod, Chapter IX. \"The Sea and the Desert\", page 176.\nThere is naked Nature,—inhumanly sincere, wasting no thought on man, nibbling at the cliffy shore where gulls wheel amid the spray."
                                            },
                                            {
                                                "example_id": "d5caa43c-2e60-424e-90dc-ccb3fde6a860",
                                                "sense_id": "25c0d92b-3501-3ec7-a3c1-d5009b516d38",
                                                "text": "Where did they all live? I wondered. My curiosity was soon destined to be gratified. Turning to the left the string of litters followed the cliffy sides of the crater for a distance of about half a mile, or perhaps a little less, and then halted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0b194f-72e5-31f0-9497-f1367850286b",
                                        "entry_id": "5b28a3e8-3d80-33cb-b763-1a14ef53328c",
                                        "glosses": [
                                            "Characteristic of a cliff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1070cb2c-5af6-47f4-9788-2482543b3209",
                                                "sense_id": "9c0b194f-72e5-31f0-9497-f1367850286b",
                                                "text": "HAG [...] 1. A rock or cliff; an abrupt, cliffy prominence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cliffy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0321324d-6548-32b2-aa2f-e31c4de7e7b2",
                                        "entry_id": "b4ae51bc-54d1-3aae-9369-5fb408ee763f",
                                        "glosses": [
                                            "A cliffhanger (dramatic stopping point in a story)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60789ad3-9ef2-4e41-a23d-ac01280b1a72",
                                                "sense_id": "0321324d-6548-32b2-aa2f-e31c4de7e7b2",
                                                "text": "All your questions won't be answered in the first book. It may end on a cliffhanger that leads into book 2. It's a mild cliffy, but it's there none the less."
                                            }
