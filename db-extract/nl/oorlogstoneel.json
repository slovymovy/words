                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65518e5-1dc4-4ba9-9c7e-5cf9026d5b18",
                                "sense_id": "b73e5183-0692-36b7-bb71-cc6819216294",
                                "text": "Maar de laatste tijd, sinds er van het oorlogstoneel steeds meer alarmerende berichten kwamen, en Natasja's gezondheid vooruitging en zij niet langer in hem het vroegere gevoel van zorgzaam medelijden wekte, begon een onverklaarbare rusteloosheid zich van hem meester te maken."
                            },
                            {
                                "example_id": "f265e18e-4121-4bf5-9839-478666a44e37",
                                "sense_id": "b73e5183-0692-36b7-bb71-cc6819216294",
                                "text": "Hij gaat de online-verslaggeving van de wereldwijd gevolgde BBC op gezette tijden helpen met steeds geactualiseerde kaarten van het oorlogstoneel in onder meer Syrië, Irak en Afghanistan. En Franse documentairemakers lopen net de deur uit. Ze kwamen speciaal voor hem naar Amsterdam: of hij ook voor hen weer zo'n duidende kaart wil maken."
                            }
                        ]
                    }
