                {
                    "sense_id": "9bd0a47d-d8d0-3a8e-a5c0-18a687383971",
                    "sense_definition": "Любимый человек, объект романтических чувств.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Прощай, моя <w>любовь</w>, я скоро вернусь.",
                            "target_lang_translations": {
                                "en": "Goodbye, my <w>love</w>, I will return soon.",
                                "nl": "Vaarwel, mijn <w>liefde</w>, ik kom snel terug.",
                                "pl": "Żegnaj, moja <w>miłości</w>, niedługo wrócę.",
                                "fr": "Adieu, mon <w>amour</w>, je reviendrai bientôt.",
                                "de": "Leb wohl, meine <w>Liebe</w>, ich komme bald zurück.",
                                "es": "Adiós, mi <w>amor</w>, volveré pronto.",
                                "it": "Addio, <w>amore</w> mio, tornerò presto.",
                                "tr": "Elveda <w>aşkım</w>, yakında döneceğim.",
                                "cs": "Sbohem, moje <w>lásko</w>, brzy se vrátím.",
                                "zh": "再见，我的<w>爱人</w>，我很快就会回来。"
                            }
                        },
                        {
                            "text": "Это была его школьная <w>любовь</w>, которую он встретил спустя много лет.",
                            "target_lang_translations": {
                                "en": "It was his high school <w>love</w>, whom he met many years later.",
                                "nl": "Het was zijn school<w>liefde</w> die hij na vele jaren weer ontmoette.",
                                "pl": "To była jego szkolna <w>miłość</w>, którą spotkał po wielu latach.",
                                "fr": "C'était son <w>amour</w> de jeunesse, qu'il a retrouvé bien des années plus tard.",
                                "de": "Es war seine Schul<w>liebe</w>, die er nach vielen Jahren wiedergetroffen hat.",
                                "es": "Era su <w>amor</w> de la escuela, a quien conoció muchos años después.",
                                "it": "Era il suo <w>amore</w> di scuola, che ha incontrato di nuovo dopo molti anni.",
                                "tr": "Bu, yıllar sonra karşılaştığı okul <w>aşkıydı</w>.",
                                "cs": "Byla to jeho školní <w>láska</w>, kterou potkal po mnoha letech.",
                                "zh": "那是他的校园<w>恋人</w>，多年后他又遇见了她。"
                            }
                        }
