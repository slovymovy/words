                "senses": [
                    {
                        "sense_id": "007202b1-3b73-334f-b994-4ec41a91d1b7",
                        "entry_id": "ecf5dd5a-ecb4-3280-bf85-e09fe5695db2",
                        "glosses": [
                            "Ort im US-Bundesstaat Colorado"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0378aaa4-b3c1-4f8a-841d-edd41786c965",
                                "sense_id": "007202b1-3b73-334f-b994-4ec41a91d1b7",
                                "text": "„Denn es stimmt auch, dass er mindestens dreimal angeklagt und freigesprochen worden ist, darunter einmal wegen Mordes, und dass er, soviel ich weiß, nach wie vor in Aspen, Colorado, lebt, in sagenhaftem Reichtum und so sicher vor den Strafverfolgungsbehörden, wie es die Verfassung der Vereinigten Staaten nur erlaubt.“"
                            },
                            {
                                "example_id": "95e24849-27de-49f5-b79d-490c966f2aea",
                                "sense_id": "007202b1-3b73-334f-b994-4ec41a91d1b7",
                                "text": "„Marks lud Anson und dessen Frau Annie sogar fürs Wochenende in seine Skihütte nach Aspen ein.“"
                            },
                            {
                                "example_id": "293f8502-f005-4682-8a95-5574315f06e7",
                                "sense_id": "007202b1-3b73-334f-b994-4ec41a91d1b7",
                                "text": "„Geneigter Twitterer, in Athen oder Aspen oder Adelaide hatten meine Eltern und ich immer eine Familie dargestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
