                ],
                "senses": [
                    {
                        "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                        "entry_id": "61b57d66-f1ef-371e-9a44-7b59ac74591a",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "debd2b19-61ed-467e-acd4-8f1ea56cda82",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "Frau Abramowski ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "77104113-d1ba-4adf-9793-4516808e9f68",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "Herr Abramowski wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c94748d8-02c1-4dae-ba75-762295ecc845",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "Die Abramowskis kommen heute aus Koblenz."
                            },
                            {
                                "example_id": "b8ff704e-25cc-4c18-9b5d-31f7a1dd7d07",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "Der Abramowski trägt nie die Schals, die die Abramowski ihm strickt."
                            },
                            {
                                "example_id": "27a6f83f-0ba3-44ae-8fe8-2188858e9c96",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Abramowski kommt, geht der Herr Abramowski.“"
                            },
                            {
                                "example_id": "22701f7b-1579-4b8d-8b5c-f4015214e375",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "Abramowski kommt und geht."
                            },
                            {
                                "example_id": "063cff74-a7ec-4587-b440-6f3ac4712194",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "Abramowskis kamen, sahen und siegten."
                            },
                            {
                                "example_id": "9ea1c950-cfc4-4844-8d0e-2ff1ec1c5aac",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "An verregneten Herbsttagen ist Familie Abramowskis liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "b756c5e1-8f10-4ecd-9b2c-96b42c0fca46",
                                "sense_id": "0130d789-b001-39e4-bf69-2158f3e82cf7",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Abramowski das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
