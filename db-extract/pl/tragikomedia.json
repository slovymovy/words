                                "target_senses": [
                                    {
                                        "sense_id": "9f7c8c0e-ff48-3287-a56b-b57d206d62f9",
                                        "entry_id": "f7a4a123-1a39-31e4-afa6-48d816562b96",
                                        "glosses": [
                                            "The genre of drama that combines elements of tragedy and comedy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dc3b8c6-7209-3a6d-aaea-d720187afeb7",
                                        "entry_id": "f7a4a123-1a39-31e4-afa6-48d816562b96",
                                        "glosses": [
                                            "A drama that combines elements of tragedy and comedy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b5a5e28-5936-4bbb-bfcb-7e1073d6f8cd",
                                                "sense_id": "9dc3b8c6-7209-3a6d-aaea-d720187afeb7",
                                                "text": "This matters because after the tragicomedies of Brexit and Grexit, the world has been enjoying the spectacle of “Orkxit”. This month it was suggested that the Orkney Islands might like to secede from Britain and become a self-governing territory of Norway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89d5bec1-c852-403f-a93e-9100b4a48994",
                        "source_entry_id": "50ef2758-6a9e-347c-88b5-613227865732",
                        "source_sense_id": "a9a131a4-6b88-3490-9614-5a85644c68fa",
                        "target_lang_word": "tragi-comédie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragi-comédie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7cae58-c772-3d80-8ea5-3118494a1fb9",
                                        "entry_id": "c0969fa5-01c7-313e-b470-b6eed324c275",
                                        "glosses": [
                                            "Pièce de théâtre, dans laquelle les personnages sont de haute condition sociale et où l’action est sérieuse mais où apparaissent des incidents et de personnages qui peuvent appartenir à la comédie. Le dénouement n’en est pas tragique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa0f8af-0831-41da-a5eb-32dc8091a1b5",
                                                "sense_id": "0e7cae58-c772-3d80-8ea5-3118494a1fb9",
                                                "text": "L’Amphitryon de Plaute et le Cid de Corneille ont été appelées par leurs auteurs des tragi-comédies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960156b5-0015-3816-817d-932b99234f08",
                                        "entry_id": "c0969fa5-01c7-313e-b470-b6eed324c275",
                                        "glosses": [
                                            "Mélange d’événements graves et d’événements comiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f1d5fb-cce4-4e3b-938d-b1e9714fa6a6",
                                                "sense_id": "960156b5-0015-3816-817d-932b99234f08",
                                                "text": "Marat vint à la Convention, monta à la tribune, et pistolet sur la tempe menaça de se tuer si la calomnie l’accusant de la « septembrisade » ne cessait pas. Danton écourta la tragi-comédie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
