                                        "sense_id": "dc631110-917f-3cc9-9cd5-6a9728621eac",
                                        "entry_id": "08ed622e-2738-3324-afa9-8b1766bee81f",
                                        "glosses": [
                                            "bei Kernreaktoren entsprechender Bauweise das Überhitzen und Zusammenschmelzen der Brennstäbe beim Ausfall der Reaktorkühlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372d0789-85ce-445b-b760-57e6347f0d00",
                                                "sense_id": "dc631110-917f-3cc9-9cd5-6a9728621eac",
                                                "text": "Die Kernschmelze in Tschernobyl führte 1986 zu einer Katastrophe."
                                            },
                                            {
                                                "example_id": "8988a52f-9145-41bf-8e25-15d6becb02a6",
                                                "sense_id": "dc631110-917f-3cc9-9cd5-6a9728621eac",
                                                "text": "„Seit AKWs betrieben werden, ist es bereits mehrfach zu Kernschmelzen gekommen.“"
                                            },
                                            {
                                                "example_id": "31be6211-21d2-4e43-9e61-6f6954ccb443",
                                                "sense_id": "dc631110-917f-3cc9-9cd5-6a9728621eac",
                                                "text": "[Kernkraftwerk Fukushima/Japan 2011:] „Das Kühlsystem des Kraftwerks fiel aus; in drei der sechs Reaktoren kam es zur Kernschmelze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8776da7-78e5-47cc-8c8d-ccda3fcfd536",
                        "source_entry_id": "8b9bd505-dec2-390c-9ca1-f97edf01b96b",
                        "source_sense_id": "c1bf228d-7902-3f65-a338-ac648c025a3c",
                        "source_sense_description": "een rampzalige gebeurtenis waarbij de brandstof van een kernreactor smelt door het wegvallen van de koeling",
                        "target_lang_word": "meltdown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meltdown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc2370af-8d1a-30fc-b31f-f40696d84546",
                                        "entry_id": "45b0532a-a13f-3533-a5b8-cd022172a08a",
                                        "glosses": [
                                            "Severe overheating of the core of a nuclear reactor resulting in the core melting and potentially in radiation escaping."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f55c06-076a-472b-9aa7-d84f968f5780",
                                                "sense_id": "fc2370af-8d1a-30fc-b31f-f40696d84546",
                                                "text": "Four years have passed since the meltdown at the Chernobyl nuclear plant, but the grim legacy of the Soviet catastrophe is still unfolding. https://web.archive.org/web/20041130094534/http://www.time.com/time/daily/chernobyl/chernobyl.index.html"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a8d2e2-ad19-340c-a30a-e234945e86ae",
                                        "entry_id": "45b0532a-a13f-3533-a5b8-cd022172a08a",
                                        "glosses": [
                                            "A situation being likened to a nuclear meltdown; a crisis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15dfb7e0-fcba-4245-a250-ab05627ea97f",
                                                "sense_id": "91a8d2e2-ad19-340c-a30a-e234945e86ae",
                                                "text": "Channel 4 switchboards went into meltdown this week when viewers called to complain about a Brass Eye programme on child sex."
                                            },
                                            {
                                                "example_id": "0dfb498e-9fe4-4031-bbf3-5425772dc4cf",
                                                "sense_id": "91a8d2e2-ad19-340c-a30a-e234945e86ae",
                                                "text": "Computer engineers were at a loss last night to explain why the Government had been hit by arguably the worst electronic meltdown in the history of Whitehall. https://web.archive.org/web/20041209011615/http://news.independent.co.uk/uk/politics/story.jsp?story=587262"
                                            },
                                            {
                                                "example_id": "c6809a29-385a-4dee-9f76-a23e9e587519",
                                                "sense_id": "91a8d2e2-ad19-340c-a30a-e234945e86ae",
                                                "text": "Not only that, but wishcycling is playing a big role in the current global recycling meltdown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e05507e7-97ae-3bab-bfca-b88fa8ecb282",
                                        "entry_id": "45b0532a-a13f-3533-a5b8-cd022172a08a",
                                        "glosses": [
                                            "A tantrum or emotional outburst."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9d2c585-66e6-416d-9fd6-50b33b501c6e",
                                                "sense_id": "e05507e7-97ae-3bab-bfca-b88fa8ecb282",
                                                "text": "I had a major meltdown at work today. After being instructed one more time about additional work that I was to delegate to my direct reports, I snapped, but in a very polite manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ba17d6-0cb1-3f43-8a8a-b83b9deb1feb",
                                        "entry_id": "45b0532a-a13f-3533-a5b8-cd022172a08a",
                                        "glosses": [
                                            "An autistic response to stress or sensory overload, in which the person is overwhelmed by intense, seemingly disproportionate emotions, behaving erratically and becoming unable to mask."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68303c10-3332-43cc-b25a-eda0696ac29c",
                                                "sense_id": "a8ba17d6-0cb1-3f43-8a8a-b83b9deb1feb",
                                                "text": "Now if I am really anxious, I can take a moment to think about what is making me anxious and what to do about it; before I would just spiral into a meltdown really quickly, with no understanding of why."
                                            },
                                            {
                                                "example_id": "d6f5ec06-25e1-46fd-b1b6-cec64d532321",
                                                "sense_id": "a8ba17d6-0cb1-3f43-8a8a-b83b9deb1feb",
                                                "text": "However, if the accumulation of stress chemicals, stimulation and/or demands are occurring too fast or are too intense to block out, then a meltdown is probable."
                                            },
                                            {
                                                "example_id": "3a0a75b1-5083-48b6-9db8-4b6c3d1d308d",
                                                "sense_id": "a8ba17d6-0cb1-3f43-8a8a-b83b9deb1feb",
                                                "text": "If you're experiencing challenges that are extremely stressful and may lead you to being overwhelmed, or set off a meltdown in the workplace, this may be very concerning to your work colleagues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
