                                        "sense_id": "deb559db-d077-3298-afb8-75a7c743ef24",
                                        "entry_id": "84b95df0-a381-3594-ad86-58f18ce78d96",
                                        "glosses": [
                                            "Feeling desire; eagerly wishing; eager to obtain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d78b08-abee-4a0f-b49b-5469b9b7eea2",
                                                "sense_id": "deb559db-d077-3298-afb8-75a7c743ef24",
                                                "text": "More significantly, rigid deference to [Justin] Bieber’s still-young core fan base keeps things resolutely PG, with any acknowledgement of sex either couched in vague “touch your body” workarounds or downgraded to desirous hand-holding and eye-gazing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3a078be-2428-4765-98fe-5c3fc023ec17",
                        "source_entry_id": "a3426c69-15e0-3954-8fc0-f2d5339d06f9",
                        "source_sense_id": "ba03f1b0-aee2-3143-94ce-281c6bc2298c",
                        "target_lang_word": "wishful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wishful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89f6d21b-5f0d-3ea7-aca0-940c4e399b5e",
                                        "entry_id": "6097238b-bc25-3035-bf40-5c0376160dac",
                                        "glosses": [
                                            "Wished-for; desired, wanted."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ba4c8d-d39e-4e7c-9520-1d6243c7825a",
                                                "sense_id": "89f6d21b-5f0d-3ea7-aca0-940c4e399b5e",
                                                "text": "The cry whereof entring the hollow cave / Eftsoones brought forth the villaine, as they ment, / With hope of her some wishfull boot to have."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d511c70-e7d5-329c-8707-1214eb55189f",
                                        "entry_id": "6097238b-bc25-3035-bf40-5c0376160dac",
                                        "glosses": [
                                            "Expressing a wish or longing for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6fc009-4d78-4c1f-bd10-371caee2703b",
                                                "sense_id": "1d511c70-e7d5-329c-8707-1214eb55189f",
                                                "text": "When she weighed anchor I went to the waterside and looked at her with a very wishful and aching heart, and followed her with my eyes and tears until she was totally out of sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f65b88-fed5-3a9d-97ce-413ca267049b",
                                        "entry_id": "6097238b-bc25-3035-bf40-5c0376160dac",
                                        "glosses": [
                                            "Aspiring, or seeking advancement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daeccff6-a054-4a19-a5ba-cbedc4bac8ed",
                        "source_entry_id": "a3426c69-15e0-3954-8fc0-f2d5339d06f9",
                        "source_sense_id": "ba03f1b0-aee2-3143-94ce-281c6bc2298c",
                        "target_lang_word": "solicitous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solicitous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4650a10b-df75-3630-bbec-bd1baa99b983",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Disposed to solicit; eager to obtain something desirable, or to avoid anything evil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10f4504-4060-4202-af15-e8d3436e636c",
                                                "sense_id": "4650a10b-df75-3630-bbec-bd1baa99b983",
                                                "text": "To that end, the then Biſhop of London, Dʳ Laud, attended on his Majeſty throughout that whole journey[…]to accompliſh which he was no leſs ſollicitous than the King himſelf, nor the King the leſs ſollicitous for his Advice."
                                            },
                                            {
                                                "example_id": "744f9048-199d-4033-a218-9ecdf1f80d59",
                                                "sense_id": "4650a10b-df75-3630-bbec-bd1baa99b983",
                                                "text": "Where pain is most severe and sorrow most bitter, there love is most solicitous and untiring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Showing care, concern, or attention, in any of several ways; thus:",
                                            "In a conscientious way, often with kindness."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9e05a4-44dc-4562-bdfd-9a273aff38f8",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "solicitous about a person's health"
                                            },
                                            {
                                                "example_id": "f92977a6-57b3-4cd2-8293-2f03b6e3f7db",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "solicitous inquiries, asking after her husband and children"
                                            },
                                            {
                                                "example_id": "01698b82-08f0-4f0d-8a30-1eaf3c09658f",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "You have not only been careful of my fortune, which was the effect of your nobleneſs, but you have been ſolicitous of my reputation, which is that of your kindneſs."
                                            },
                                            {
                                                "example_id": "0f3f74f1-5aee-46a0-b1bb-f3cb4f32b17a",
                                                "sense_id": "951da6cb-88b3-36a6-976c-572fd1750b36",
                                                "text": "The more solicitous of the two was Nurse Cramer, a shapely, pretty, sexless girl with a wholesome unattractive face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae38510-9201-3027-b01c-1bb560ab2474",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Showing care, concern, or attention, in any of several ways; thus:",
                                            "In an eager way."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61024da6-49dc-36eb-8a51-b7f583086d2b",
                                        "entry_id": "130ae7fe-ad2f-3778-919d-fbe92ce636b9",
                                        "glosses": [
                                            "Showing care, concern, or attention, in any of several ways; thus:",
                                            "In an anxious or distressed way."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016c3ab1-6ba2-42e3-ab8d-047892b060f8",
                                                "sense_id": "61024da6-49dc-36eb-8a51-b7f583086d2b",
                                                "text": "Enjoy the preſent whatſoever it be, and be not ſollicitous for the future : for if you take your foot from the preſent ſtanding, and thruſt it forward toward to morrow’s even, you are in a reſtleſs condition, it is like refuſing to quench your preſent thirſt by fearing you ſhall want to drink the next day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be7cee6a-de6a-423d-be34-3f8f92e49aae",
                        "source_entry_id": "a3426c69-15e0-3954-8fc0-f2d5339d06f9",
                        "source_sense_id": "ba03f1b0-aee2-3143-94ce-281c6bc2298c",
                        "target_lang_word": "anxious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anxious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c79f97a-dd45-3b30-9f59-60190c1e68b5",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Nervous and worried."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Having a feeling of anxiety or disquietude; extremely concerned, especially about something that will happen in the future or that is unknown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a37c49d-81a6-4cec-ad2f-f67d617f56d5",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "She was anxious to hear how her test results were."
                                            },
                                            {
                                                "example_id": "f0388583-6d84-42f0-a85c-da60cb6ccc6a",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "I could tell she was anxious as she was biting her nails."
                                            },
                                            {
                                                "example_id": "c9df8372-268f-45e4-8420-492485864765",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "a6791298-93a1-4086-9689-62bc211b87da",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            },
                                            {
                                                "example_id": "307c2a28-7953-4acc-80bf-409bbf9a2326",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "But, with United fans in celebratory mood as it appeared their team might snatch glory, they faced an anxious wait as City equalised in stoppage time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Accompanied with, or causing, anxiety; worrying."
                                        ],
                                        "tags": [
                                            "of things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d14c0e5-c9db-4f8a-b5a1-4ae4512d9cd5",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "anxious labor"
                                            },
                                            {
                                                "example_id": "998cb87e-a83e-4a34-9518-5bd0c3629465",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "There was an anxious wait before the results were revealed."
                                            },
                                            {
                                                "example_id": "29cb31ee-eb48-413e-beea-6f9b05484ef2",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "The sweet of life, from which God hath bid dwell far off all anxious cares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Earnestly desirous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cad06ef-b5fa-4a82-9fd6-0c92c9fae370",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "He is anxious to please, so you can count on him."
                                            },
                                            {
                                                "example_id": "d1b46214-811f-42e9-bc6e-6c17792fc98e",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "All the voters were anxious to hear the election result."
                                            },
                                            {
                                                "example_id": "ef7a99d4-ee8b-4712-9b34-7f6b661b3fe0",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "He sneers alike at those who are anxious to preserve and at those who are eager for reform."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccb0eb56-9f13-4ed0-8ffd-7778c35c89bc",
                        "source_entry_id": "a3426c69-15e0-3954-8fc0-f2d5339d06f9",
