                "senses": [
                    {
                        "sense_id": "959c38d5-c08a-32d4-9083-073d90163695",
                        "entry_id": "d55eca6e-82dd-368d-a492-142af5275aab",
                        "glosses": [
                            "Débarrasser du gluten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6c6558-a15f-4a55-b804-21e5b7f676e4",
                                "sense_id": "959c38d5-c08a-32d4-9083-073d90163695",
                                "text": "Brassée à partir de malts et de houblons bio, la bière est ensuite déglutinisée, grâce à une méthode innovante."
                            },
                            {
                                "example_id": "99b2a4e8-5959-4e8e-800a-379689d3f8cd",
                                "sense_id": "959c38d5-c08a-32d4-9083-073d90163695",
                                "text": "Vous pouvez également \"déglutiniser\" de la farine complète, mais c'est plus compliqué."
                            },
                            {
                                "example_id": "1c96ebc3-fe8c-46f2-ab15-a8471ce0d1cc",
                                "sense_id": "959c38d5-c08a-32d4-9083-073d90163695",
                                "text": "Pour mon plus grand bonheur, Elsa, fondatrice et cuisinière, qui en plus est très sympathique (!), peut “déglutiniser” tout le menu."
                            }
                        ]
                    }
