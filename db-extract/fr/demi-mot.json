                        ],
                        "form": "demi-mots"
                    },
                    {
                        "form_id": "8c2625c0-a47b-4387-ab13-5203bc6dcf7d",
                        "entry_id": "52174662-5757-395e-b989-33503831aca0",
                        "tags": [],
                        "form": "mi-mot"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "221bf5f5-f150-323c-8e19-323b77d3a9bc",
                        "entry_id": "52174662-5757-395e-b989-33503831aca0",
                        "glosses": [
                            "Expression qui atténue ou masque la pensée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b96a25-d46d-41cc-be13-2a1f7f1bdb92",
                                "sense_id": "221bf5f5-f150-323c-8e19-323b77d3a9bc",
                                "text": "Saisir les demi-mots, les insinuations d’un personnage médisant."
                            },
                            {
                                "example_id": "f0fc99ec-1179-4899-811d-d20e3d83c1d0",
                                "sense_id": "221bf5f5-f150-323c-8e19-323b77d3a9bc",
                                "text": "Les demi-mots qu’il avait surpris un jour chez madame de Serpierre étaient fort indirects."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0428267c-cdc5-4ae4-bf8e-c493ae6eae9a",
                        "source_entry_id": "52174662-5757-395e-b989-33503831aca0",
                        "source_sense_id": "221bf5f5-f150-323c-8e19-323b77d3a9bc",
                        "target_lang_word": "hint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc38938-9f31-3185-811a-3a549fe417d2",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "A clue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b54b2398-d2fa-46e9-84b2-1e95cee6f7ee",
                                                "sense_id": "6dc38938-9f31-3185-811a-3a549fe417d2",
                                                "text": "I needed a hint to complete the crossword."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6825c80-83be-3fc9-b3bd-502800485356",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "An implicit suggestion that avoids a direct statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17661c8-37d7-43cc-a28d-931c1b338b40",
                                                "sense_id": "e6825c80-83be-3fc9-b3bd-502800485356",
                                                "text": "He gave me a hint that my breath smelt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "A small, barely detectable amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c663b0d-e6ad-4e15-b864-0e0497083427",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "There was a hint of irony in his voice."
                                            },
                                            {
                                                "example_id": "97ac672c-88d8-4abb-ae0d-39b596fe82f6",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "I could taste a hint of lemon in my iced water."
                                            },
                                            {
                                                "example_id": "5b15a3c3-96b5-4ddf-b7be-90dfe6e27317",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "And I perceived no touch of change,\n⁠No hint of death in all his frame,\n⁠But found him all in all the same, […]"
                                            },
                                            {
                                                "example_id": "baed4055-6df7-4b71-bb8c-ff2b64514aab",
                                                "sense_id": "b6a294e8-912e-3c6e-b011-15cdc94543df",
                                                "text": "Mother very rightly resented the slightest hint of condescension. She considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45756485-3365-3668-9345-294ff2695301",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "Information in a computer-based font that suggests how the outlines of the font's glyphs should be distorted in order to produce, at specific sizes, a visually appealing pixel-based rendering; an instance of hinting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6c7a934-58a2-45f2-bdbb-7b4bbc98af8b",
                                                "sense_id": "45756485-3365-3668-9345-294ff2695301",
                                                "text": "This font does not scale well to small sizes; the hints for the 10-point letter 'g' still need work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "119eb8cb-35e2-30ac-8181-f45407aa9434",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "An instruction to the database engine as to how a query should be executed, for example whether to use an index or not."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2470a45f-35ef-33c3-b3b6-c49161b9d5ef",
                                        "entry_id": "2bdbe965-a031-35db-9502-253862728dba",
                                        "glosses": [
                                            "An opportunity; occasion; fit time."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39af65d7-9996-4d42-a182-f72b52d1f27d",
                                                "sense_id": "2470a45f-35ef-33c3-b3b6-c49161b9d5ef",
                                                "text": "I, not remembering how I cried out then, / Will cry it o'er again: it is a hint / That wrings mine eyes to't."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "373e2e34-c5b0-3988-832b-3c22b022416f",
                                        "entry_id": "cc072674-9603-31aa-8b59-cd21ccfe6b2c",
                                        "glosses": [
                                            "To imply without a direct statement; to provide a clue."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23a634f-0382-4258-907d-213b62e1b70c",
                                                "sense_id": "373e2e34-c5b0-3988-832b-3c22b022416f",
                                                "text": "I have tried, as I hinted, to enlist the co-operation of other capitalists, but experience has taught me that any appeal is futile that does not impinge directly upon cupidity."
                                            },
                                            {
                                                "example_id": "3419be90-6760-4fe6-8ea6-18cf160a03fd",
                                                "sense_id": "373e2e34-c5b0-3988-832b-3c22b022416f",
                                                "text": "She hinted at the possibility of a recount of the votes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                        "entry_id": "cc072674-9603-31aa-8b59-cd21ccfe6b2c",
                                        "glosses": [
                                            "To bring to mind by a slight mention or remote allusion; to suggest in an indirect manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca90c359-e591-4bef-a006-1191b4f18bf0",
                                                "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                                "text": "to hint a suspicion"
                                            },
                                            {
                                                "example_id": "44e961c4-1279-48e4-ae44-f99833f20fe0",
                                                "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                                "text": "VVilling to vvound, and yet afraid to ſtrike, / Juſt hint a fault and heſitate diſlike; […]"
                                            },
                                            {
                                                "example_id": "8c3617fa-a4eb-468b-a398-88d55a2b17fa",
                                                "sense_id": "ae4eb02b-6f83-339c-a0ae-e4058af4513c",
                                                "text": "We shall not describe this tragical scene too fully; but we thought ourselves obliged, by that historic integrity which we profess, shortly to hint a matter which we would otherwise have been glad to have spared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98e3326-b234-3147-ad84-9c900deaa4a0",
                                        "entry_id": "cc072674-9603-31aa-8b59-cd21ccfe6b2c",
                                        "glosses": [
                                            "To develop and add hints to a font."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89150376-227f-4f69-9493-8691e400a841",
                                                "sense_id": "a98e3326-b234-3147-ad84-9c900deaa4a0",
                                                "text": "The typographer worked all day on hinting her new font so it would look good on computer screens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b9dab46-324f-3d15-a1de-48a12d0a2e5f",
                                        "entry_id": "1cb6ca61-915a-3896-80bc-84a64c9a4fa2",
                                        "glosses": [
                                            "Signifies that something previously said should be taken as a hint or heeded closely."
                                        ],
                                        "tags": [
                                            "often",
                                            "reduplication"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10859fb9-d532-4836-a0a0-e41a5f2e3e31",
                                                "sense_id": "7b9dab46-324f-3d15-a1de-48a12d0a2e5f",
                                                "text": "And yes, as long as you are being a good coder and engaging in safe practices, nothing should go wrong. (Hint, hint.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3248af8c-edd6-43d7-9648-af51fbe6e96b",
                        "source_entry_id": "52174662-5757-395e-b989-33503831aca0",
                        "source_sense_id": "221bf5f5-f150-323c-8e19-323b77d3a9bc",
                        "target_lang_word": "shorthand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shorthand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                        "entry_id": "502e4875-dabe-3ea9-828a-86266e917a0f",
                                        "glosses": [
                                            "A rough and rapid method of writing by substituting symbols for letters, words, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92166f18-8b23-4fde-811f-028547389938",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "There is a Notion prevails among many People, to yͤ prejudice of all kinds of Short-hand; which is this. That when a Person sets down a Memorandum in his pocket Book in Short-hand, it is lost, in caſe of Death or any other accident, to yͤ rest of yͤ World, though it may contain things of great Consequence to other People. [...] I affirm, [...] that if any Person makes use of my long Short hand, which he will certainly do, in caſe he deſigns that what he writes should be read by another Person, it will be as legible to any one acquainted with this Art, as if it was writ in Round Hand."
                                            },
                                            {
                                                "example_id": "6fa5fe9e-141d-4fcd-834d-a2ec35a684be",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "All ſhort Hands are ſubject to Ambiguity; for there being but 8 Marks to repreſent 24 Letters, and thoſe 8 being uſed for 8 of them in the Short Hand Alphabets, the other Letters muſt be deſcribed by Characters compounded of theſe 8."
                                            },
                                            {
                                                "example_id": "1e25ae1d-91ab-4a81-bac9-a51bf3ac47f8",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "A is denoted by a dot at the top of the Short-hand line; [...] The vowel a, in Short-hand, is used for the article a, or ah; [...]"
                                            },
                                            {
                                                "example_id": "79c32296-0cad-4721-97b7-c0d3a0bd5abf",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "[...] I was soon convinced, that our articles a an the should also be omitted: especially as the two former are comparatively infrequent, and the latter a perpetual incumbrance in other Short-hands."
                                            },
                                            {
                                                "example_id": "68305b33-b0dd-44d1-b22c-cb3bbb275b14",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "In writing shorthand words are always to be spelled as they are sounded, and without any regard to orthography."
                                            },
                                            {
                                                "example_id": "284039ac-8982-4e3d-b50f-6158c819510f",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "A good Short-hand must be easy, swift, and legible."
                                            },
                                            {
                                                "example_id": "20a60e1d-07b9-45c5-a4ad-7453651fa668",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "Now, if you are wise, and would shorthand acquire, / Just throw your old text-books straight into the fire. / Then take up Light-Line—in the matter of speed, / There's nothing can beat it—of this take good heed. / 'Tis most easy to learn, to read and in fine— / No shorthand can equal GREGG'S MODERN LIGHT-LINE."
                                            },
                                            {
                                                "example_id": "0f7e6219-be9c-45d4-95a6-d8a224d60bc3",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "The origin of shorthand writing has been variously attributed to the Egyptians, the Greeks and the Romans. It is not unlikely that some form of stenography, or method of (comparatively) rapid writing by means of signs or characters briefer than those of the script ordinarily in use, was developed independently among the penmen or scribes of many early nations. [...] But the natural eagerness of stenographers to claim great antiquity for their art has sometimes tempted them to cite as references to shorthand passages which do not necessarily bear any such meaning."
                                            },
                                            {
                                                "example_id": "dbe78c33-f910-4099-9b02-7204f163526e",
                                                "sense_id": "1b496a42-76a9-38e5-a1b6-168009fe21c2",
                                                "text": "Right away you say that nobody learns how to read shorthand. People who want to know shorthand learn how to write it; the reading of it comes by the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71906a8d-679f-3e29-b367-4be81d65de00",
                                        "entry_id": "502e4875-dabe-3ea9-828a-86266e917a0f",
                                        "glosses": [
                                            "Any brief or shortened way of saying or doing something."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1c8cad-1ce8-48da-bdad-02685ddc530a",
                                                "sense_id": "71906a8d-679f-3e29-b367-4be81d65de00",
                                                "text": "The jargon becomes a shorthand for these advanced concepts."
                                            },
                                            {
                                                "example_id": "3ba767ae-6a13-46f0-9caf-949484075cec",
                                                "sense_id": "71906a8d-679f-3e29-b367-4be81d65de00",
                                                "text": "It is important to recall that the European construct of \"the Indian\" and the abstraction designated as \"Native American religion\" are both artificial labels suggesting a unity that is nowhere to be found. When we borrow such shorthands, we are really referring to the Arapaho, Blackfeet, Chumash, Delaware, Eskimo, Flathead, Ghost Dancers, Hopi, Iowa—and so on through the rest of the alphabet right to the Yuma and Zuni."
                                            },
                                            {
                                                "example_id": "999ed6af-6c61-4257-89b5-2701bc46e2d8",
                                                "sense_id": "71906a8d-679f-3e29-b367-4be81d65de00",
                                                "text": "Trust me, he's Pakistani, because that's the average numpty's shorthand for Muslim."
                                            },
                                            {
                                                "example_id": "2a50a117-cf29-4e4f-98eb-27d3f58cbc0d",
                                                "sense_id": "71906a8d-679f-3e29-b367-4be81d65de00",
                                                "text": "You shouldn't use the shorthand PHP tags (<? ?>) in your code. The reason for this is that shorthand PHP tags must be enabled on your server before they will function. Many hosting configurations have this feature disabled by default, which means your plugin would immediately break when activated in WordPress."
                                            },
                                            {
                                                "example_id": "b1c82c2c-9fcb-40d1-b626-ad224609207f",
                                                "sense_id": "71906a8d-679f-3e29-b367-4be81d65de00",
                                                "text": "Her [Kate Spade's] name became a shorthand for the cute, clever bags that were an instant hit with cosmopolitan women in the early stages of their careers and, later, young girls – status symbols of a more attainable, all-American sort than a Fendi clutch or Chanel bag."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shorthand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07dd0e6d-6009-3c31-bffb-eb4d77366d19",
                                        "entry_id": "766e78d5-6a46-33e2-8540-5576cc7c7c1d",
                                        "glosses": [
                                            "To render (spoken or written words) into shorthand."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9225e5-7c73-4dd3-b56a-1034ed8f45ce",
                                                "sense_id": "07dd0e6d-6009-3c31-bffb-eb4d77366d19",
                                                "text": "All the time she'd pretended to be fiddling with her purse over there behind the man, she'd been shorthanding him down—every word, every quotation, every date, every name."
                                            },
                                            {
                                                "example_id": "265db5a3-3e32-40ab-ab2a-0ba565691ab3",
                                                "sense_id": "07dd0e6d-6009-3c31-bffb-eb4d77366d19",
                                                "text": "Most everything is in the safe on digital media, but there were some sessions he didn't record. He'd just shorthanded his notes during and after the sessions. I never learned shorthand, so there's no way I could decipher most of it, if you know what I mean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c2213e-2c03-3340-a7b1-df863565fc4a",
                                        "entry_id": "766e78d5-6a46-33e2-8540-5576cc7c7c1d",
                                        "glosses": [
                                            "To use a brief or shortened way of saying or doing something."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a244ecab-7d68-4fc1-8ed2-5dd68cd7bd76",
                                                "sense_id": "f7c2213e-2c03-3340-a7b1-df863565fc4a",
                                                "text": "It seems to me, however one looks at it—and I am torpedoing, \"shorthanding\", my arguments, though they can be developed at great length—that there is no military case for a large standing Army, and I pick out three arguments that I think are tremendously important which I should like the Minister to answer, even though he may reject them."
                                            },
                                            {
                                                "example_id": "29928f1a-9143-4124-b00b-384b6390fa78",
                                                "sense_id": "f7c2213e-2c03-3340-a7b1-df863565fc4a",
                                                "text": "By \"home video\" I mean to shorthand the practice of viewing at home texts that come to us via a range of sources and formats, such as cable/satellite and pay-per-view television, mail order services (that send in the mail gay-related videotapes to far-flung subscribers), Web-based media, videotapes, laser discs, and dvds."
                                            },
                                            {
                                                "example_id": "3b3db2cd-a58e-4ed8-86d8-8b094149f442",
                                                "sense_id": "f7c2213e-2c03-3340-a7b1-df863565fc4a",
                                                "text": "He liked [John Dann] MacDonald's books: You could always tell who the villainesses were because the narrator made a point of noting they had fat asses. It was as good a way as any to shorthand the world, he thought."
                                            },
                                            {
                                                "example_id": "2911cb0a-ddc8-4a7a-a9f4-23c81d65ace0",
                                                "sense_id": "f7c2213e-2c03-3340-a7b1-df863565fc4a",
                                                "text": "[Dan] Brown shorthands the argument that Freemasonry really is inclusive through the personas and characters of Katherine Solomon and Warren Bellamy."
                                            },
                                            {
                                                "example_id": "ee1a8bba-8133-40f5-85ec-7005307076c3",
                                                "sense_id": "f7c2213e-2c03-3340-a7b1-df863565fc4a",
                                                "text": "She watched as Trooper pulled out a pack of cigarettes and fumbled in his pocket for a lighter, an expensive-looking Zippo with the number 88 engraved on the front plate – each eight standing for the eighth letter of the alphabet, the two Hs together shorthanding the phrase 'Heil Hitler'."
                                            },
                                            {
                                                "example_id": "7d5e4087-827b-43fa-b5b3-808f87695dd9",
                                                "sense_id": "f7c2213e-2c03-3340-a7b1-df863565fc4a",
                                                "text": "I refer to processes of deterritorialization and reterritorialization across the globe at various levels, such as decentralized business, frontier fluidity, increased and multifarious transnational movement, recast urban space and blended cultures, in short all that is often shorthanded in the term globalization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f74b472-58ae-3e3c-b015-3ba5ed47bca9",
                                        "entry_id": "766e78d5-6a46-33e2-8540-5576cc7c7c1d",
                                        "glosses": [
                                            "To write in shorthand."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fc688b5-ca78-4a70-b837-32b825e598a3",
                                                "sense_id": "0f74b472-58ae-3e3c-b015-3ba5ed47bca9",
                                                "text": "Steele nodded and settled on the chesterfield. He regarded Betty seriously, her notebook poised on the table beside her as she reclined in her chair. [...] \"I remember,\" Betty acknowledged, and went on shorthanding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
