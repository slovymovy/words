                                "target_senses": [
                                    {
                                        "sense_id": "bebc1481-8fcf-3def-abf3-87515cba1082",
                                        "entry_id": "38862ed5-5942-3fd4-a48b-59f2ee7a125b",
                                        "glosses": [
                                            "jemand, der Falschgeld herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38707b99-d09c-4ae5-a7dd-28a39edb0b78",
                                                "sense_id": "bebc1481-8fcf-3def-abf3-87515cba1082",
                                                "text": "Die Polizei konnte den Falschmünzer ausfindig machen und verhaften."
                                            },
                                            {
                                                "example_id": "6941b80f-dbc6-4f85-996f-0d0a2d41ccf5",
                                                "sense_id": "bebc1481-8fcf-3def-abf3-87515cba1082",
                                                "text": "„Die Polizisten hatten einen Hinweis bekommen, dass dort Falschmünzer am Werk seien.“"
                                            },
                                            {
                                                "example_id": "fbb02832-835e-47ad-a098-2da9298e0bf0",
                                                "sense_id": "bebc1481-8fcf-3def-abf3-87515cba1082",
                                                "text": "„Als müsste man mehr als nur Grenzgänger sein, nämlich auch Glücksritter und Idealist, Falschmünzer und Abenteurer.“<"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2eb40831-b8f5-42d7-9d1f-dc2bfd071cdc",
                        "source_entry_id": "8d4a0a50-bb87-327d-b7c8-ddc1accd0262",
                        "source_sense_id": "d0d664f6-7bb4-32d6-9081-751eefcebf96",
                        "target_lang_word": "Geldfälscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geldfälscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c11f48cd-2504-31ba-a0f5-2d1a09752f42",
                                        "entry_id": "ae0a3c2c-118d-3957-8747-d6830b2bed82",
                                        "glosses": [
                                            "jemand, der Falschgeld herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c07002b-1ed3-45a9-a712-1cda9b495f8a",
                                                "sense_id": "c11f48cd-2504-31ba-a0f5-2d1a09752f42",
                                                "text": "Die Polizei konnte den Geldfälscher ausfindig machen und verhaften."
                                            },
                                            {
                                                "example_id": "20f263b9-401c-43e1-a0c9-36007281faf9",
                                                "sense_id": "c11f48cd-2504-31ba-a0f5-2d1a09752f42",
                                                "text": "„Einer der bekanntesten österreichischen Geldfälscher war Peter Ritter von Bohr, seines Zeichens Mitbegründer der Ersten österreichischen Spar-Casse.“"
                                            },
                                            {
                                                "example_id": "6f14450f-d9af-4036-8e13-78289ac9ba84",
                                                "sense_id": "c11f48cd-2504-31ba-a0f5-2d1a09752f42",
                                                "text": "„Vor allem ein Porträtfenster, das es sowohl beim überarbeiteten 20- als auch beim 50-Euro-Schein gibt, stellt Geldfälscher vor Probleme: Dieses wird durchsichtig, wenn man den Schein gegen das Licht hält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce5baa59-bd6e-48e8-a617-4aba38f469a1",
                        "source_entry_id": "8d4a0a50-bb87-327d-b7c8-ddc1accd0262",
