                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f512d7b-1324-40ef-bab4-44a8c66d5d35",
                                "sense_id": "45d3f151-053d-3b35-a950-29952bcd21c4",
                                "text": "„Gerade dadurch, dass die Versuchsanordnung so klein war, sich meine Unfähigkeit auf fünf Dominosteinchen fokussierte, bekam die Situation etwas Paranoides.“"
                            },
                            {
                                "example_id": "2faabd27-0653-49af-90b4-28db1ef22783",
                                "sense_id": "45d3f151-053d-3b35-a950-29952bcd21c4",
                                "text": "„Eine über der ganzen Versuchsanordnung montierte Industriekamera, die im Infrarotbereich arbeitet, und speziell entwickelte Software wurden verwendet, um die Position des Tieres, seine Blickrichtung und seine Laufrichtung zu bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
