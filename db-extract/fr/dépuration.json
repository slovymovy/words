                "senses": [
                    {
                        "sense_id": "bf5bbbc2-fe99-3c11-8b9d-136900d4516a",
                        "entry_id": "fac5ae8a-99f2-3365-b547-5d9fd3b6bb56",
                        "glosses": [
                            "Action de dépurer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a75ff6-6754-4746-9113-255f8534bcdb",
                                "sense_id": "bf5bbbc2-fe99-3c11-8b9d-136900d4516a",
                                "text": "[…] ensuite les eaux continuant à tomber toujours avec plus d'abondance jusqu'à l'entière dépuration de l'atmosphère, elles ont gagné successivement du terrain et sont arrivées aux contrées de l'équateur, et enfin elles ont couvert toute la surface du globe à deux mille toises de hauteur au-dessus du niveau de nos mers actuelles."
                            },
                            {
                                "example_id": "0fafec79-2258-4b66-a8ca-1d10990fb404",
                                "sense_id": "bf5bbbc2-fe99-3c11-8b9d-136900d4516a",
                                "text": "— La dépuration d’un métal, d’une liqueur."
                            },
                            {
                                "example_id": "8affabde-7b9b-4a6e-9571-20732da00275",
                                "sense_id": "bf5bbbc2-fe99-3c11-8b9d-136900d4516a",
                                "text": "— La dépuration du sang."
                            },
                            {
                                "example_id": "3db04c5b-0adf-4715-87d8-ab74c67785dc",
                                "sense_id": "bf5bbbc2-fe99-3c11-8b9d-136900d4516a",
                                "text": "Ce n’est pas parce que les reins laissent passer tous les jours quelques centigrammes ou quelques grammes d’albumine qu’il y a danger, le danger vient de ce que les reins malades ne laissent plus passer en quantité voulue les éléments de dépuration qui constituent la sécrétion urinaire normale."
                            }
                        ]
                    }
                ],
