                "senses": [
                    {
                        "sense_id": "5c46f409-dd7d-30d6-afa8-fb29f534f5bc",
                        "entry_id": "9224cf84-e55e-3c8c-88b6-14c981c347c1",
                        "glosses": [
                            "Suggestionner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b262f52-85ef-484b-b78b-c739019cea82",
                                "sense_id": "5c46f409-dd7d-30d6-afa8-fb29f534f5bc",
                                "text": "C'est là pourtant où le concept de « folie à plusieurs », où les pseudo-confirmations cliniques des uns alimentent les folles spéculations des autres, qui resuggestionnent les premiers, etc., trouve sa limite."
                            },
                            {
                                "example_id": "89d3a97d-2e30-40a4-b296-1be2d75de4d8",
                                "sense_id": "5c46f409-dd7d-30d6-afa8-fb29f534f5bc",
                                "text": "Ainsi suggestionné par ses antécédents, resuggestionné par son confesseur, poussé par ses intérêts de carrière en même temps que par sa conception particulière du devoir, comment le prêtre passera-t-il sa journée ?"
                            }
                        ]
                    }
                ],
