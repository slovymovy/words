                "senses": [
                    {
                        "sense_id": "16852e66-78b8-3ba7-b773-503dce18d65c",
                        "entry_id": "d5a72ddd-3ed8-351c-bf67-12d5f37e7d13",
                        "glosses": [
                            "Gesamtheit aller wechselseitigen Beziehungen, Verbindungen zwischen Teilen, bei der eine Veränderung des einen Teils durch eine Veränderung auf dem anderen Teil begleitet wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a00ae52-6dc2-49a1-9379-e10e19247a91",
                                "sense_id": "16852e66-78b8-3ba7-b773-503dce18d65c",
                                "text": "„Über den Befangenheitsantrag hatte nun ein anderer Senat des Oberlandesgerichts zu entscheiden. Dieser sah keine Voreingenommenheit der Richter. Es komme weniger auf eine einzelne Formulierung, als vielmehr auf den Gesamtzusammenhang an.“"
                            }
                        ],
