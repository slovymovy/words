{
    "word_family": [
        "reversibel",
        "reversie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce3b64d1-095c-34e1-b3e5-90c723d95131",
                    "sense_definition": "een op- of omslag aan de voorzijde van een jas of vest",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doordat hij zijn koffie morste, is zijn hele <w>revers</w> vies geworden.",
                            "target_lang_translations": {
                                "en": "Because he spilled his coffee, his entire <w>lapel</w> got dirty."
                            }
                        },
                        {
                            "text": "Hij droeg een prachtige rode bloem op de <w>revers</w> van zijn colbert.",
                            "target_lang_translations": {
                                "en": "He wore a beautiful red flower on the <w>lapel</w> of his jacket."
                            }
                        }
                    ],
                    "synonyms": [
                        "lapel",
                        "omslag"
                    ],
                    "common_phrases": [
                        "brede revers",
                        "revers van een jas"
                    ],
                    "target_lang_definitions": {
                        "en": "a fold or turnover at the front of a jacket or vest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lapel",
                                "target_lang_sense_clarification": "the part on each side of a coat or jacket immediately below the collar"
                            },
                            {
                                "target_lang_word": "revers",
                                "target_lang_sense_clarification": "a garment part (such as a lapel) turned back to show the reverse side"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f2bdbb6-328c-331c-be23-329bc6699612",
                    "sense_definition": "de keerzijde van munten of waardepapier",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "numismatiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de <w>revers</w> van een munt is een afbeelding te zien.",
                            "target_lang_translations": {
                                "en": "An image can be seen on the <w>reverse</w> of a coin."
                            }
                        },
                        {
                            "text": "De verzamelaar bekeek de <w>revers</w> van de zilveren munt met een vergrootglas.",
                            "target_lang_translations": {
                                "en": "The collector examined the <w>reverse</w> of the silver coin with a magnifying glass."
                            }
                        }
                    ],
                    "synonyms": [
                        "keerzijde",
                        "muntzijde"
                    ],
                    "antonyms": [
                        "avers",
                        "voorzijde"
                    ],
                    "common_phrases": [
                        "revers van een munt"
                    ],
                    "target_lang_definitions": {
                        "en": "the back side of coins or securities"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reverse",
                                "target_lang_sense_clarification": "the back side of a coin or medal"
                            },
                            {
                                "target_lang_word": "tails",
                                "target_lang_sense_clarification": "the side of a coin opposite to the head"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}