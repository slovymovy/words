                "senses": [
                    {
                        "sense_id": "d03bff21-cef7-3307-8a1e-11318cbc15ba",
                        "entry_id": "fbccc3e4-47e8-307c-906c-11f1a500c71e",
                        "glosses": [
                            "Hühnervogel, der ein rotbraunes Sommerkleid mit weißen Beinen und Unterseite hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da82980-62b1-4c18-affc-38bcf89f33dd",
                                "sense_id": "d03bff21-cef7-3307-8a1e-11318cbc15ba",
                                "text": "„Er saß an diesem Samstagmorgen schon im Büro, denn er hatte widerwillig seinen geplanten Wochenendtrip nach Schottland abgesagt, wo er eigentlich Moorhühner jagen wollte.“"
                            },
                            {
                                "example_id": "3e8046e2-582d-4312-9762-13108e73b6fa",
                                "sense_id": "d03bff21-cef7-3307-8a1e-11318cbc15ba",
                                "text": "„Und während die restlichen kräftig gebauten Männer in dem Raum so angezogen waren, dass sie guten grauen Moorhühnern ähnelten, war der hochgewachsene Mann, der hinter dem Oberkellner durch den Raum glitt, angezogen wie ein Vogel mit prächtigem Gefieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
