                                "target_senses": [
                                    {
                                        "sense_id": "84678652-3d30-3069-af9d-34a9aeb20a22",
                                        "entry_id": "799950c6-87b0-3c8a-94e7-9020b0e540a8",
                                        "glosses": [
                                            "opstijgende warme luchtbellen in de atmosfeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f599ca-3370-40f9-8ab9-acd98723ca3b",
                                                "sense_id": "84678652-3d30-3069-af9d-34a9aeb20a22",
                                                "text": "Hoog in de lucht laat een roofvogel zich drijven op de golven van de thermiek."
                                            },
                                            {
                                                "example_id": "9c5c9bf8-1e1a-4e4d-aaab-0840b32301e3",
                                                "sense_id": "84678652-3d30-3069-af9d-34a9aeb20a22",
                                                "text": "WK Zeilvliegen: \"Het is hier, ondanks 30 graden, winter en dus zijn de dagen kort. Dat betekent dat de thermiek vroeg zwak wordt. Je moet dus snel schakelen en veel gokken. Het weer is de laatste dagen slechter geworden en dat maakt de wedstrijd zwaar. Maar de top blijft wel continue presenteren\", vertelt hij vol bewondering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd8359fd-7218-41a4-bdbc-3442e61908d5",
                        "source_entry_id": "c86cdcc5-f2de-3bb0-9217-725e334f30d9",
                        "source_sense_id": "77a83389-7240-3f80-8f3c-a0943ba05e2b",
                        "source_sense_description": "aufsteigende Luftbewegung",
