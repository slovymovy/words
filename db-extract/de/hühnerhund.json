                    {
                        "sense_id": "ebb87eb1-5b06-369f-83a3-6e3d34bc3033",
                        "entry_id": "7145deb4-60ff-3237-8202-4c4e1c1bf12e",
                        "glosses": [
                            "ein auf die Geflügeljagd spezialisierter Hund"
                        ],
                        "tags": [
                            "Jagd"
                        ],
                        "examples": [
                            {
                                "example_id": "0ae503d4-eef9-44c1-9a19-51a3425308d2",
                                "sense_id": "ebb87eb1-5b06-369f-83a3-6e3d34bc3033",
                                "text": "„Zu letzter Meldung muss angemerkt werden, dass es sich bei Gammel Dansk nicht um die gleichnamige Hunderasse, den altdänischen Hühnerhund, handelt, sondern um einen bitteren Kräuterschnaps.“"
                            },
                            {
                                "example_id": "0154ca40-141c-4296-ad3b-8fb40f731a0d",
                                "sense_id": "ebb87eb1-5b06-369f-83a3-6e3d34bc3033",
                                "text": "„Da kam ein Hund herein, halb Dogge, halb Hühnerhund, mit gelbem, räudigem Fell und heraushängender Zunge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
