                "senses": [
                    {
                        "sense_id": "24533cb5-47a4-3029-a04d-35e586010bde",
                        "entry_id": "d8ac1fa6-6074-3424-875e-8c25496da194",
                        "glosses": [
                            "Enlever de son bec, de sa bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "709d0a60-396f-4a6e-846b-13e46f2f8230",
                                "sense_id": "24533cb5-47a4-3029-a04d-35e586010bde",
                                "text": "Et Henrion répondre, calmement, sans débecquer sa pipe : […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "10eb826d-d2d7-3aa9-a738-16067e0437d2",
                        "entry_id": "d8ac1fa6-6074-3424-875e-8c25496da194",
                        "glosses": [
                            "Raccourcir, tronquer le bec à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2738740d-4cdc-4407-b526-69a9bbd449d4",
                                "sense_id": "10eb826d-d2d7-3aa9-a738-16067e0437d2",
                                "text": "La technologie a fait de grands progrès en la matière : il existe des machines capables de débecquer, dégriffer et de vacciner mille quatre cents canetons à l’heure…"
                            },
                            {
                                "example_id": "d5eb2cec-4d18-4bdd-adf4-8123db6fc25f",
                                "sense_id": "10eb826d-d2d7-3aa9-a738-16067e0437d2",
                                "text": "Pour qu’une exploitation de cages de ponte marche bien, nos spécialistes nous suggèrent d’écrêter les oiseaux dès leur éclosion et de les débecquer soigneusement."
                            },
                            {
                                "example_id": "748005b7-21fc-44bd-95c1-6f13807b35ad",
                                "sense_id": "10eb826d-d2d7-3aa9-a738-16067e0437d2",
                                "text": "Figure 5.2. Débecquage des canetons de Barbarie a : emplacement b : incurvation nécessaire à la lame d’une machine à débecquer"
                            }
                        ]
                    },
                    {
                        "sense_id": "b8942cdb-88b3-384b-9aee-e60cf77800af",
                        "entry_id": "d8ac1fa6-6074-3424-875e-8c25496da194",
                        "glosses": [
                            "Dégoûter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b8a6df-e6ad-4862-9d1c-d4bc93fc10b4",
                                "sense_id": "b8942cdb-88b3-384b-9aee-e60cf77800af",
                                "text": "Ton corps est mort, tu as encore dû faire la sieste, ta tête est vide, elle te débecque."
                            }
                        ]
                    }
                ],
