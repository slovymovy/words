                            {
                                "example_id": "d43b8ce7-b22a-4643-ba7b-1bbfc5ee618c",
                                "sense_id": "cc52ecd4-86aa-3d4b-a8d3-8aed85de92e7",
                                "text": "Pendu à son téléphone, le directeur de campagne de François Fillon multiplie les coups de fil et les SMS pour sonder les juppéistes, comprendre leurs envies et envisager avec eux leur recasage en fillonie."
                            },
                            {
                                "example_id": "fa04c3b5-52a5-43f7-bb43-ed79b214006f",
                                "sense_id": "cc52ecd4-86aa-3d4b-a8d3-8aed85de92e7",
                                "text": "Tour de contrôle de la fillonie, ce dernier a démissionné lundi de son poste de directeur général des services de la région Ile-de-France."
                            }
                        ]
                    }
