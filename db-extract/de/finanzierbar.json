                ],
                "senses": [
                    {
                        "sense_id": "2c967b49-6e61-3db3-833b-bb048b4b40f9",
                        "entry_id": "eac2a547-e323-3bfb-b545-b246bac58172",
                        "glosses": [
                            "so, dass es finanziert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738f3b40-d882-4084-abff-bc4e5ca63a12",
                                "sense_id": "2c967b49-6e61-3db3-833b-bb048b4b40f9",
                                "text": "„Auch andere Experten, etwa vom ifo-Institut, und die Bundesvereinigung der Deutschen Arbeitgeberverbände (BDA) schließen sich der Auffassung an, dass die gesetzliche Rentenversicherung ohne eine Anpassung der Lebensarbeitszeit an die zunehmende Lebenserwartung auf Dauer nicht finanzierbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f8bd770-4e04-44c0-b34a-923cd26490e7",
                        "source_entry_id": "eac2a547-e323-3bfb-b545-b246bac58172",
                        "source_sense_id": "2c967b49-6e61-3db3-833b-bb048b4b40f9",
                        "source_sense_description": "so, dass es finanziert werden kann",
                        "target_lang_word": "financeable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "financeable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5859f86d-b1ac-3e06-8767-cf57a22bd166",
                                        "entry_id": "51207dc5-992f-324e-b398-80bbf95bbad2",
                                        "glosses": [
                                            "Capable of being financed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aae8f98-a8e3-4b4c-b013-0700a564fc66",
                                                "sense_id": "5859f86d-b1ac-3e06-8767-cf57a22bd166",
                                                "text": "“So we had to figure out something we could do to get this project going that was financeable and workable in today’s market.”"
                                            },
                                            {
                                                "example_id": "7ba10eb3-dd0c-4a65-9504-13d174dfc9a0",
                                                "sense_id": "5859f86d-b1ac-3e06-8767-cf57a22bd166",
                                                "text": "Despite these uncertainties, Clarke told MPs he was convinced of the need to order trains powered by batteries. He said: \"We're calling for a 'no regrets' order of battery trains because we see them always having a future. We see them being fundable, financeable, similar cost to diesel trains, and we know that however much electrification we would aspire to do, there's always going to be at least a third of the network that isn't electrified."
                                            }
                                        ]
                                    }
                                ]
                            }
