                                "target_lang_word": "indistinct",
                                "target_lang_sense_clarification": "referring to sounds, shapes, or appearances that cannot be clearly made out"
                            },
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "referring to impressions or perceptions lacking clarity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c11fafe5-7012-3afd-834a-360aadc6dfc7",
                    "sense_definition": "Zonder duidelijke grenzen of beperkingen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het getal is <w>onbepaald</w> in deze wiskundige context.",
                            "target_lang_translations": {
                                "it": "Il numero è <w>indeterminato</w> in questo contesto matematico.",
                                "ru": "Это число является <w>неопределенным</w> в данном математическом контексте.",
                                "en": "The number is <w>indeterminate</w> in this mathematical context."
                            }
                        },
                        {
                            "text": "De ruimte leek <w>onbepaald</w> door de mist.",
                            "target_lang_translations": {
                                "it": "Lo spazio sembrava <w>illimitato</w> a causa della nebbia.",
                                "ru": "Из-за тумана пространство казалось <w>безграничным</w>.",
                                "en": "The space seemed <w>boundless</w> because of the mist."
                            }
                        }
                    ],
                    "synonyms": [
