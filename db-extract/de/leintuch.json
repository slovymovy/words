                "senses": [
                    {
                        "sense_id": "3129ee7d-9014-3e57-b643-91ada5c2b14e",
                        "entry_id": "076cffb4-a3f4-3cd9-92f7-2279f1e00bc3",
                        "glosses": [
                            "Matratzenüberzug im Bett"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e26b9628-fba2-433c-8610-e49fe2e93189",
                                "sense_id": "3129ee7d-9014-3e57-b643-91ada5c2b14e",
                                "text": "Das zerschlissene blassblaue Leintuch passte nicht zur knallroten Bettwäsche aus Satin, die sie ihm geschenkt hatte."
                            },
                            {
                                "example_id": "d4cac565-7de6-4aa0-b44f-2855d37b34fa",
                                "sense_id": "3129ee7d-9014-3e57-b643-91ada5c2b14e",
                                "text": "„Dann erscheint eine sehr gut gekleidete Frau, gefolgt von einer Magd, die Leintücher bringt und nach einem untertänigen Knicks mein Bett bezieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
