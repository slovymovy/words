                        "examples": [
                            {
                                "example_id": "8285e1a8-91e2-40d7-b644-668a0bc28789",
                                "sense_id": "6bf22864-65ef-3e99-bfd3-71c4a69c7671",
                                "text": "Bij een bomaanslag in Teheran is een kerngeleerde om het leven gekomen. Twee mensen raakten gewond. Volgens een Iraans persbureau werkte de geleerde bij de uraniumverrijkingsfabriek in Natanz. Correspondent Thomas Erdbrink over de vraag of dit de relatie met het Westen verder onder druk zet."
                            },
                            {
                                "example_id": "392c31d6-097f-478b-b692-5c641c61050c",
                                "sense_id": "6bf22864-65ef-3e99-bfd3-71c4a69c7671",
                                "text": "In zijn woonplaats Bilthoven is de kernfysicus Jacob Kistemaker overleden. Hij geldt als de beroemdse kerngeleerde van Nederland en is 93 jaar geworden."
                            }
                        ]
                    }
