        "ru-extract.jsonl": [
            {
                "entry_id": "90ce99ec-8e7c-3f71-9f61-9e17556a2b3c",
                "word": "ну-ну",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a2d1a7e-6a49-3ca0-88db-635304a220b7",
                        "entry_id": "90ce99ec-8e7c-3f71-9f61-9e17556a2b3c",
                        "glosses": [
                            "разг. возглас, выражающий удивление, негодование, иронию, восхищение и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06092700-d24c-402b-a6a4-49f1db1acc72",
                                "sense_id": "9a2d1a7e-6a49-3ca0-88db-635304a220b7",
                                "text": "Ну-ну, — подумал я, — вот те и «рассудка француз не имеет»…"
                            },
                            {
                                "example_id": "de559155-3379-4868-9771-2153d4a9e44a",
                                "sense_id": "9a2d1a7e-6a49-3ca0-88db-635304a220b7",
                                "text": "Говорили о Восточной Магистрали, вспоминали своих редакторов и секретарей, рассказывали о смешных газетных ляпсусах и всем скопом журили Ухудшанского за отсутствие в его характере журналистской жилки. Ухудшанский высоко поднимал голову и с превосходством отвечал: — \"Треплетесь? Ну-ну.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "8e6af97f-983f-315d-b248-2cc4b0fc0006",
                        "entry_id": "90ce99ec-8e7c-3f71-9f61-9e17556a2b3c",
                        "glosses": [
                            "разг. возглас, выражающий согласие с собеседником, желание успокоить его"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c21100-3e2f-4919-9c14-abe2a651f790",
                                "sense_id": "8e6af97f-983f-315d-b248-2cc4b0fc0006",
                                "text": "— Это действительная правда, — сорвалось у Лужина. — Ну-ну, что же дальше? — торопила Дунечка."
                            },
                            {
                                "example_id": "e49146ac-6fe1-419d-8540-722fb5da666d",
                                "sense_id": "8e6af97f-983f-315d-b248-2cc4b0fc0006",
                                "text": "— Говорил я тебе? — торжествовал папочка. — Ну-ну, не сердись! — отвечала мамочка, как бы винясь, что она чересчур поторопилась папочку осрамить."
                            },
                            {
                                "example_id": "c9673824-4a86-4901-89f5-a701e32f61b1",
                                "sense_id": "8e6af97f-983f-315d-b248-2cc4b0fc0006",
                                "text": "Войдя в комнату, Максим взял его за руку и ласково погладил ее. — Ну-ну, мой мальчик, — сказал он. — Я, кажется, должен просить у тебя прощения…"
                            }
                        ]
                    },
                    {
                        "sense_id": "db301201-cf35-3463-966b-c9b166857c39",
                        "entry_id": "90ce99ec-8e7c-3f71-9f61-9e17556a2b3c",
                        "glosses": [
                            "разг. употребляется при выражении запрещения, соответствуя по значению словам: не тронь! не смей! ни-ни!"
                        ],
                        "tags": [
                            "част."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dd87b243-ec50-3c5d-8638-9f053a5c2398",
                        "entry_id": "90ce99ec-8e7c-3f71-9f61-9e17556a2b3c",
                        "glosses": [
                            "предик. разг. обозначение побуждения к чему-либо как действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0fd421-697b-4d8d-8940-d6f94bbec879",
                                "sense_id": "dd87b243-ec50-3c5d-8638-9f053a5c2398",
                                "text": "И, говоря так, горожане искоса поглядывали на суетившегося среди них Прахова. А он, возбуждённый и энергичный, властно и ласково покрикивал на них: — Ну-ну, ребятушки, дружно-о! Дружнее бери, православные! Для господа бога трудитесь."
                            },
                            {
                                "example_id": "66712738-c9b3-455a-8fa1-cb679c4eb969",
                                "sense_id": "dd87b243-ec50-3c5d-8638-9f053a5c2398",
                                "text": "Его рука скользнула по левому боку Корейко и на некую долю секунды задержалась над парусиновым карманом миллионера-конторщика. — Ну-ну, — шептал Балаганов. — Давай, старик, давай!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "722915c6-b4de-45f4-9269-8a414b4024c5",
                        "source_entry_id": "90ce99ec-8e7c-3f71-9f61-9e17556a2b3c",
                        "source_sense_description": "возглас, выражающий удивление, негодование, иронию, восхищение и т. п.",
                        "target_lang_word": "all right",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all right",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69e3731e-1b27-326e-85dd-2975d6a3ec85",
                                        "entry_id": "462c6659-3096-34d3-bf17-b8eaa27ddf47",
                                        "glosses": [
                                            "Good; in acceptable, if not excellent condition."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935c0f1e-7b78-415b-977a-c505498c57e4",
                                                "sense_id": "69e3731e-1b27-326e-85dd-2975d6a3ec85",
                                                "text": "The car is all right. It gets me there, anyway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6220bedd-870e-3d6e-881b-64a4523d50a0",
                                        "entry_id": "462c6659-3096-34d3-bf17-b8eaa27ddf47",
                                        "glosses": [
                                            "In good health, unharmed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c86657e-ec06-4828-82ce-f4aa00d25d55",
                                                "sense_id": "6220bedd-870e-3d6e-881b-64a4523d50a0",
                                                "text": "I had a headache earlier, but now I'm all right."
                                            },
                                            {
                                                "example_id": "931496ef-1b86-4555-b22d-7d4a4d0050bc",
                                                "sense_id": "6220bedd-870e-3d6e-881b-64a4523d50a0",
                                                "text": "The dread of most etherizers is a quiet breather who may stop breathing without his notice, and requires the almost constant presence of his ear at the patient's mouth to be sure he or she is all right."
                                            },
                                            {
                                                "example_id": "57216cb4-35ba-492d-91e8-f52412d82dec",
                                                "sense_id": "6220bedd-870e-3d6e-881b-64a4523d50a0",
                                                "text": "‘No. I only opened the door a foot and put my head in. The street lamps shine into that room. I could see him. He was all right. Sleeping like a great grampus. Poor, poor chap.’"
                                            },
                                            {
                                                "example_id": "5ab5820c-4e3e-4fa4-ac81-61a9e99f70a6",
                                                "sense_id": "6220bedd-870e-3d6e-881b-64a4523d50a0",
                                                "text": "Next I called my dear friend Nellie Connally in Dallas. We had been close to Nellie and John for many years, sharing moments of sorrow and happiness alike. She reported that the surgeon had just finished operating and that John was going to be all right."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all right",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb3ba65-6501-31c7-bcaf-332eb440434b",
                                        "entry_id": "1379b5fd-a5bd-3a3e-b058-41e9d6c7264c",
                                        "glosses": [
                                            "Fairly well."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "730eac34-e515-4502-9d02-66109913fe97",
                                                "sense_id": "5cb3ba65-6501-31c7-bcaf-332eb440434b",
                                                "text": "It went all right because my old drill still works all right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ffd54d6-3438-3011-8d07-d33290052f67",
                                        "entry_id": "1379b5fd-a5bd-3a3e-b058-41e9d6c7264c",
                                        "glosses": [
                                            "Most certainly; for sure."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98e88188-a65d-4645-9841-8117d7f4bfa3",
                                                "sense_id": "0ffd54d6-3438-3011-8d07-d33290052f67",
                                                "text": "You taught them a lesson all right! They won't be back."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all right",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fca06d6-d426-3853-b894-f38fbfb6b325",
                                        "entry_id": "eada726b-479b-3f25-81bc-068cea3c3e30",
                                        "glosses": [
                                            "Used to affirm, indicate agreement, or consent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d23fa746-70ad-4fb8-bcf2-efa04f7eed09",
                                                "sense_id": "7fca06d6-d426-3853-b894-f38fbfb6b325",
                                                "text": "All right, let's go then."
                                            },
                                            {
                                                "example_id": "2e5839e6-11f2-4d9c-9000-c04dfe62b96e",
                                                "sense_id": "7fca06d6-d426-3853-b894-f38fbfb6b325",
                                                "text": "Presently there came a loud ring, then a decided voice, asking for 'Mr. Laurie', and a surprised-looking servant came running up to announce a young lady. \"All right, show her up, it's Miss Jo,\" said Laurie, going to the door of his little parlor to meet Jo, who appeared, looking rosy and quite at her ease, with a covered dish in one hand and Beth's three kittens in the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c7b7f14-eec2-3ed4-a737-981c0ade5899",
                                        "entry_id": "eada726b-479b-3f25-81bc-068cea3c3e30",
                                        "glosses": [
                                            "Used to indicate support, favor or encouragement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c7411c-bab9-429e-95ad-31e01918eb00",
                                                "sense_id": "4c7b7f14-eec2-3ed4-a737-981c0ade5899",
                                                "text": "All right! They scored!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23375d1f-cdc6-3011-994b-758ebce24aa9",
                                        "entry_id": "eada726b-479b-3f25-81bc-068cea3c3e30",
                                        "glosses": [
                                            "Used to fill space or pauses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde5f485-fb3a-42b2-9481-978c1b364090",
                                                "sense_id": "23375d1f-cdc6-3011-994b-758ebce24aa9",
                                                "text": "All right, so what you suggest we do next?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e2758f1-d9eb-3f92-8b11-51406d816e41",
                                        "entry_id": "eada726b-479b-3f25-81bc-068cea3c3e30",
                                        "glosses": [
                                            "Used as a general lead-in or beginning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "988f6a4c-7902-4fe5-886c-1a23efd4f8f5",
                                                "sense_id": "4e2758f1-d9eb-3f92-8b11-51406d816e41",
                                                "text": "All right, let's get started."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b2d6d80-985a-3551-a4e4-a817db690428",
                                        "entry_id": "eada726b-479b-3f25-81bc-068cea3c3e30",
                                        "glosses": [
                                            "Used to express exasperation or frustration, often reduplicated or with already."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e198073-b67e-4e2a-8768-ce8b714fdc24",
                                                "sense_id": "9b2d6d80-985a-3551-a4e4-a817db690428",
                                                "text": "All right, already! Let me finish what I was doing first, and then we can talk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46915e7c-8461-3a05-9986-2e4ef7753283",
                                        "entry_id": "eada726b-479b-3f25-81bc-068cea3c3e30",
                                        "glosses": [
                                            "Term of greeting, equivalent to how are you or hello."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62f379a-7d72-4191-b33b-30bea8a89fbf",
                                                "sense_id": "46915e7c-8461-3a05-9986-2e4ef7753283",
                                                "text": "All right, mate, how are things with you and the missus?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
