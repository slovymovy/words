                "senses": [
                    {
                        "sense_id": "1de67aed-74d9-3a76-903f-9c610449ec27",
                        "entry_id": "8f68c8f9-076a-3109-ab65-5e6377e18326",
                        "glosses": [
                            "(sens du préfixe : retour au point de départ) Revenir à un endroit où on a déjà été plusieurs fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20475b06-2d0c-491f-9c88-449edcf81a47",
                                "sense_id": "1de67aed-74d9-3a76-903f-9c610449ec27",
                                "text": "Ce film m’a tellement plu que je vais reretourner le voir."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cd27e20-1aab-3dfd-b224-8b95789ffb47",
                        "entry_id": "8f68c8f9-076a-3109-ab65-5e6377e18326",
                        "glosses": [
                            "(sens du préfixe : augmentatif) Tourner encore, une nouvelle fois."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f41eaab8-ba13-462b-8ad0-b141b876548c",
                                "sense_id": "2cd27e20-1aab-3dfd-b224-8b95789ffb47",
                                "text": "À force de retourner et reretourner la terre, il avait fini par ne plus avoir aucune motte ni aucun caillou."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d4b3185-897c-3273-a0ec-b7c4d4497f0b",
                        "entry_id": "8f68c8f9-076a-3109-ab65-5e6377e18326",
                        "glosses": [
                            "(sens du préfixe : répétition) Se retourner encore une fois."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "96178015-fa91-4744-82cc-ed2b3c68c0e4",
                                "sense_id": "2d4b3185-897c-3273-a0ec-b7c4d4497f0b",
                                "text": "J’ai très mal dormi cette nuit, je n’arrêtais pas de me reretourner sans cesse tellement j’avais chaud."
                            }
                        ]
                    }
