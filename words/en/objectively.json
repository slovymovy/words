{
    "word_family": [
        "object",
        "objective",
        "objectiveness",
        "objectivism",
        "objectivity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e28f18f9-6f52-3b9e-b181-718c74de0e61",
                    "sense_definition": "In an impartial, neutral, or unbiased manner, without being influenced by personal feelings.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "impartiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee tried to assess the candidates <w>objectively</w> based solely on their qualifications.",
                            "target_lang_translations": {
                                "ru": "Комиссия старалась оценивать кандидатов <w>объективно</w>, основываясь исключительно на их квалификации."
                            }
                        },
                        {
                            "text": "It is hard to view the situation <w>objectively</w> when your own family is involved.",
                            "target_lang_translations": {
                                "ru": "Трудно смотреть на ситуацию <w>объективно</w>, когда в неё вовлечена собственная семья."
                            }
                        }
                    ],
                    "synonyms": [
                        "impartially",
                        "neutrally",
                        "unbiasedly"
                    ],
                    "antonyms": [
                        "subjectively"
                    ],
                    "common_phrases": [
                        "look at objectively",
                        "assess objectively"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспристрастно, нейтрально или непредвзято, без влияния личных чувств и предпочтений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объективно",
                                "target_lang_sense_clarification": "непредвзято, беспристрастно"
                            },
                            {
                                "target_lang_word": "непредвзято",
                                "target_lang_sense_clarification": "без предубеждения и предвзятости"
                            },
                            {
                                "target_lang_word": "беспристрастно",
                                "target_lang_sense_clarification": "справедливо и независимо от личных чувств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c668b3-0baf-3cfd-9c7a-d6eb61c0f465",
                    "sense_definition": "Indisputably or without question, treated as an undeniable fact rather than a matter of opinion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By any standard measure, this is <w>objectively</w> the worst movie released this year.",
                            "target_lang_translations": {
                                "ru": "По любым общепринятым меркам это <w>объективно</w> худший фильм, вышедший в этом году."
                            }
                        },
                        {
                            "text": "The team produced an <w>objectively</w> superior product that outperformed all competitors.",
                            "target_lang_translations": {
                                "ru": "Команда создала <w>объективно</w> превосходящий продукт, который опередил всех конкурентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "indisputably",
                        "undeniably"
                    ],
                    "common_phrases": [
                        "objectively true",
                        "objectively better",
                        "objectively worse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесспорно или несомненно, как доказанный факт, а не просто личное мнение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объективно",
                                "target_lang_sense_clarification": "согласно фактам, вне зависимости от мнений"
                            },
                            {
                                "target_lang_word": "фактически",
                                "target_lang_sense_clarification": "на самом деле, неоспоримо"
                            },
                            {
                                "target_lang_word": "бесспорно",
                                "target_lang_sense_clarification": "не подлежит сомнению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}