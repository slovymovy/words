                "senses": [
                    {
                        "sense_id": "e6562126-ee0f-399a-997a-d74806bea6a9",
                        "entry_id": "f6047f98-f792-3210-92d3-69f668942edc",
                        "glosses": [
                            "Homme ou garçon qui professe des idées politiques relevant du droitisme."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "93ff5ad9-1497-455b-be2a-9472ec0315d5",
                                "sense_id": "e6562126-ee0f-399a-997a-d74806bea6a9",
                                "text": "Le seul ennemi, c’est celui qui divise le monde entre amis et ennemis – le fasciste, le droitard, le populiste – et qui n’adhère pas au récit médiatique unanimiste propagé par les « déni-oui-oui» qui répètent ad nauseam avec leur moulin à prières: « Ils n’auront pas ma haine», « Pas d’amalgame», « Unité nationale», « Je suis en terrasse» – alors ils qu’ils sont terrassés."
                            },
                            {
                                "example_id": "9d94eeb7-4091-4a2a-9dde-50ade7baed4f",
                                "sense_id": "e6562126-ee0f-399a-997a-d74806bea6a9",
                                "text": "Les droitards assimilationnistes, qui ne parlent que de culture et de langue, sont inaudibles quand ils évoquent le grand remplacement car ils n’intègrent pas la dimension raciale."
                            }
                        ]
                    }
                ],
