                        "glosses": [
                            "Saisir sur un clavier sans lever le doigt du clavier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ba1969-88d4-44a2-93c1-41442b12b06a",
                                "sense_id": "ba42552d-cb0e-3d06-94e8-7a8c1c0462a1",
                                "text": "Le nouvel iOS intègre même les claviers alternatifs, qui permettent de « swyper » (écrire en faisant glisser son doigt sans le lever)."
                            },
                            {
                                "example_id": "dd503406-b142-4a79-a8f4-e6e76556386a",
                                "sense_id": "ba42552d-cb0e-3d06-94e8-7a8c1c0462a1",
                                "text": "Une tite remarque puis une question aux détenteurs de la bête : avec le streak j’ai pris l’habitude de ne plus «taper» mes textes, mais plutôt de les «swyper»."
                            },
                            {
                                "example_id": "f4aa1eb0-b303-4cde-a27a-9045e5b44b01",
                                "sense_id": "ba42552d-cb0e-3d06-94e8-7a8c1c0462a1",
                                "text": "Keymonk, LE clavier Android pour swyper à 2 doigts"
                            }
                        ]
