                "senses": [
                    {
                        "sense_id": "43df7f55-83ab-3ca6-b3aa-68bac95eb3b1",
                        "entry_id": "bfdbe2e1-d9fd-366a-be37-ac9bff3bfb69",
                        "glosses": [
                            "ingreep met de bedoeling een bestemming onbereikbaar te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e1b0b6f-5647-44c5-9bdd-a201e7fddc65",
                                "sense_id": "43df7f55-83ab-3ca6-b3aa-68bac95eb3b1",
                                "text": "Een rechter in Brazilië heeft opdracht gegeven om een landelijke blokkade van Whatsapp op te heffen, zo meldt Reuters. Maandag bepaalde een andere rechter nog dat vijf telecomproviders de berichtendienst gedurende 72 uur moesten blokkeren."
                            },
                            {
                                "example_id": "6d27741e-710e-4b6e-8b45-aa17b57e433f",
                                "sense_id": "43df7f55-83ab-3ca6-b3aa-68bac95eb3b1",
                                "text": "Volgens Rico Luman, sectoreconoom transport en automotive van ING, moeten de heffingen ook niet gezien worden als een middel om Chinese auto's van de Europese markt te weren. \"In het Verenigd Koninkrijk zijn er geen heffingen op Chinese auto's en daar zie je een nog grotere groei van Chinese auto's. Het werkt eerder als een kleine rem dan als een blokkade.\""
                            },
                            {
                                "example_id": "f00683e5-e80a-4b40-8a9a-15988fbeb92f",
                                "sense_id": "43df7f55-83ab-3ca6-b3aa-68bac95eb3b1",
                                "text": "De supermarkten hebben al \"tientallen miljoenen\" aan schade geleden door blokkade van distributiecentra door boeren. Het gaat over omzet die de winkels mislopen vanwege leveringen die niet kunnen plaatsvinden of producten die bederven, zegt een woordvoerder van branchevereniging CBL tegen NU.nl."
                            }
                        ]
                    },
                    {
                        "sense_id": "09509768-0e85-38e7-a048-e738db142933",
                        "entry_id": "bfdbe2e1-d9fd-366a-be37-ac9bff3bfb69",
                        "glosses": [
                            "drukverdeling waarbij een groot hogedrukgebied de weg blokkeert voor depressies"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "137a172b-2d66-309f-bc57-6e33ee463ec0",
                        "entry_id": "bfdbe2e1-d9fd-366a-be37-ac9bff3bfb69",
                        "glosses": [
                            "militaire strategie bestaand uit het van de buitenwereld afsluiten van een gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef8dbb7-370c-4adb-b5ed-6339ce533f6d",
                                "sense_id": "137a172b-2d66-309f-bc57-6e33ee463ec0",
                                "text": "Volgens de actievoerders voert ook Israël in de bezette gebieden momenteel een apartheidsbewind: onder meer de muur op Palestijns gebied, de economische blokkade van de bezette gebieden en de sloop van woningen daar worden ‘immorele en onwettige praktijken’ van Israël tegen de Palestijnen genoemd door de actievoerders."
                            }
                        ]
                    },
                    {
                        "sense_id": "7dcc63ec-379f-3566-8ecd-ad1b61b08c77",
                        "entry_id": "bfdbe2e1-d9fd-366a-be37-ac9bff3bfb69",
                        "glosses": [
                            "maatregel waarbij iemand na eerdere ongewenste bewerkingen geheel of gedeeltelijk wordt beperkt in zijn mogelijkheden om een wiki te bewerken"
                        ],
                        "tags": [
                            "wikitaal"
                        ],
                        "examples": [
                            {
                                "example_id": "69136cde-0808-4273-a334-b8cbe1b57005",
                                "sense_id": "7dcc63ec-379f-3566-8ecd-ad1b61b08c77",
                                "text": "De moderator ergerde zich zo aan het gebrek aan strenge regels, dat hij vorig jaar demonstratief de blokkade ophief van 35 van die vandalen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ca1605b-9ea9-4d26-9657-89de862eb704",
                        "source_entry_id": "bfdbe2e1-d9fd-366a-be37-ac9bff3bfb69",
                        "target_lang_word": "Blockade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blockade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8237946-47c5-35ce-8bdd-9c10e7d91126",
                                        "entry_id": "ac187db6-17a3-3e59-8541-f5b43ee2c976",
                                        "glosses": [
                                            "Sperrung von Zufahrtswegen, zum Beispiel um die Güterversorgung zu erschweren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdc420ff-6b46-485c-afa7-82c45f0f8ec5",
                                                "sense_id": "d8237946-47c5-35ce-8bdd-9c10e7d91126",
                                                "text": "Bei Atommülltransporten gibt es oft Blockaden von Demonstranten."
                                            },
                                            {
                                                "example_id": "50edbef1-e4ca-40ad-a407-e549e981d190",
                                                "sense_id": "d8237946-47c5-35ce-8bdd-9c10e7d91126",
                                                "text": "„Mitteleuropa wurde so weitgehend abgeschnitten von Lieferungen aus neutralen Ländern; jeder Durchbruch der Blockade wurde zum lebensgefährlichen Abenteuer, das immer weniger Kapitäne der Handelsmarine auf sich nahmen.“"
                                            },
                                            {
                                                "example_id": "7d8144aa-7151-4a0c-9ac7-02a914d458bd",
                                                "sense_id": "d8237946-47c5-35ce-8bdd-9c10e7d91126",
                                                "text": "Mehr als 13.000 Menschen sind von der Blockade Katars durch Saudi-Arabien, die Vereinigten Arabischen Emirate und Bahrain betroffen, wie der Kommissionsvorsitzende Ali bin Schmaich al-Marri vor Journalisten in Genf mitteilte."
                                            },
                                            {
                                                "example_id": "8c0b5ebf-701a-4484-bdb4-4de45759888c",
                                                "sense_id": "d8237946-47c5-35ce-8bdd-9c10e7d91126",
                                                "text": "Von der Belagerung Leningrads …, der \"tödlichsten Blockade einer Stadt seit Menschengedenken\" wissen nur die Wenigsten. Dabei ist diese 900 Tage dauernde Blockade, der etwa anderthalb Millionen Zivilisten durch Hunger, Kälte, Bombenangriffe und Artilleriebeschuss zum Opfer gefallen sind, eines der schlimmsten Verbrechen der deutschen Wehrmacht überhaupt."
                                            },
                                            {
                                                "example_id": "4fc823b5-2f5c-41d4-9c6b-2197f51488fa",
                                                "sense_id": "d8237946-47c5-35ce-8bdd-9c10e7d91126",
                                                "text": "1948 kam es zur ersten Blockade durch die Sowjetunion: Alle Land- und Wasserwege zur Versorgung von Westberlin wurden geschlossen. Daraufhin errichteten die Westalliierten eine Luftbrücke, über die Westberlin versorgt wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b99a1da-c18a-37e7-9320-2d8a11a04d67",
                                        "entry_id": "ac187db6-17a3-3e59-8541-f5b43ee2c976",
                                        "glosses": [
                                            "auffällige Markierung, zum Beispiel ein schwarzes Viereck, die der Setzer an Stellen einfügt, die noch unklar sind"
                                        ],
                                        "tags": [
                                            "Drucktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84eda12d-e449-40f0-b4f9-f750681e1d3f",
                                                "sense_id": "6b99a1da-c18a-37e7-9320-2d8a11a04d67",
                                                "text": "Absichtlich verkehrt eingesetzte Lettern bezeichnet man in der Druckersprache nicht als Fliegenkopf, sondern als Blockade."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "070641fe-426d-3502-89e2-286f4492658b",
                                        "entry_id": "ac187db6-17a3-3e59-8541-f5b43ee2c976",
                                        "glosses": [
                                            "reversible Bewegungseinschränkung eines Gelenkes"
                                        ],
                                        "tags": [
                                            "Orthopädie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2288215b-d485-44c6-b8c2-41faf12ae2ac",
                                                "sense_id": "070641fe-426d-3502-89e2-286f4492658b",
                                                "text": "Einfache regelmäßige Rückenübungen beugen einer Blockade des Iliosakralgelenk vor."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f0f68ebe-24f9-3b38-8875-72565cfd2125",
                                        "entry_id": "ac187db6-17a3-3e59-8541-f5b43ee2c976",
                                        "glosses": [
                                            "Unterbrechung der Reizweiterleitung"
                                        ],
                                        "tags": [
                                            "Neurophysiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "411bb30b-2d6f-4a74-84b7-40dcc9b03b8c",
                                                "sense_id": "f0f68ebe-24f9-3b38-8875-72565cfd2125",
                                                "text": "Bei der Matheklausur hatte er eine Blockade."
                                            },
                                            {
                                                "example_id": "a08893d0-4c87-4f61-b9ab-801b94cae555",
                                                "sense_id": "f0f68ebe-24f9-3b38-8875-72565cfd2125",
                                                "text": "Blockade im Gehirn [Überschrift] - Warum kiffen vergesslich macht."
                                            },
                                            {
                                                "example_id": "6cf9ba88-06e4-4d45-9cad-104f08374709",
                                                "sense_id": "f0f68ebe-24f9-3b38-8875-72565cfd2125",
                                                "text": "„Die Psychologie weiß, dass Verdrängtes im Verborgenen weiterlebt und unter Umständen wiederkehrt, in Form von Verhaltensstörungen oder Blockaden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "954ba554-8cf4-488f-b276-b14f8d062882",
