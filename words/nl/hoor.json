                                "target_lang_word": "слышу",
                                "target_lang_sense_clarification": "восприятие звука"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sento",
                                "target_lang_sense_clarification": "percezione uditiva"
                            },
                            {
                                "target_lang_word": "odo",
                                "target_lang_sense_clarification": "percezione uditiva (più formale)"
                            }
                        ]
