{
    "word_family": [
        "nightmarish",
        "nightmarishly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68dd55c7-41d1-3322-a573-0e951191c685",
                    "sense_definition": "A very unpleasant or frightening dream.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dream_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I woke up sweating because I had a terrible <w>nightmare</w>.",
                            "target_lang_translations": {
                                "ru": "Я проснулся в холодном поту, потому что мне приснился ужасный <w>кошмар</w>.",
                                "zh": "我惊醒时满身大汗，因为我做了一个可怕的<w>噩梦</w>。"
                            }
                        },
                        {
                            "text": "She often has a recurring <w>nightmare</w> about being chased by a bear.",
                            "target_lang_translations": {
                                "ru": "Ей часто снится повторяющийся <w>кошмар</w> о том, что за ней гонится медведь.",
                                "zh": "她经常做一个被熊追赶的重复性<w>噩梦</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a nightmare",
                        "recurring nightmare",
                        "wake from a nightmare",
                        "worst nightmare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень неприятный или пугающий сон.",
                        "zh": "非常令人不快或可怕的梦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошмар",
                                "target_lang_sense_clarification": "сновидение"
                            },
                            {
                                "target_lang_word": "страшный сон",
                                "target_lang_sense_clarification": "сновидение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "噩梦",
                                "target_lang_sense_clarification": "指可怕的梦境"
                            },
                            {
                                "target_lang_word": "梦魇",
                                "target_lang_sense_clarification": "指令人恐惧的梦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a86de30-8e99-380d-833d-69f3f1631b49",
                    "sense_definition": "Any bad, miserable, difficult, or terrifying situation or experience that causes anxiety or great displeasure.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_bad_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trying to get home through the heavy traffic was an absolute <w>nightmare</w>.",
                            "target_lang_translations": {
                                "ru": "Попытка добраться домой через сильные пробки была сущим <w>кошмаром</w>.",
                                "zh": "在拥堵的交通中试图回家简直是一场<w>噩梦</w>。"
                            }
                        },
                        {
                            "text": "The renovation project turned into a logistical <w>nightmare</w> due to rising costs.",
                            "target_lang_translations": {
                                "ru": "Проект реконструкции превратился в логистический <w>кошмар</w> из-за роста расходов.",
                                "zh": "由于成本上升，翻新工程变成了一场后勤方面的<w>噩梦</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "logistical nightmare",
                        "absolute nightmare",
                        "living nightmare",
                        "administrative nightmare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая плохая, мучительная, трудная или ужасающая ситуация, вызывающая тревогу или сильное недовольство.",
                        "zh": "任何导致焦虑或极大不满的糟糕、痛苦、困难或可怕的情况或经历。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кошмар",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "ситуация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "噩梦",
                                "target_lang_sense_clarification": "比喻极其糟糕的境遇"
                            },
                            {
                                "target_lang_word": "灾难",
                                "target_lang_sense_clarification": "比喻极度困难的局面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e89833a5-c40d-3d52-b63b-93895438010b",
                    "sense_definition": "A demon or monster in folklore believed to sit on sleeping people's chests, causing suffocation and bad dreams.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "folklore_entity",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "In medieval legends, a <w>nightmare</w> would torment sleepers by pressing down on them.",
                            "target_lang_translations": {
                                "ru": "В средневековых легендах <w>мара</w> мучила спящих, наваливаясь на них.",
                                "zh": "在中世纪传说中，<w>梦魇</w>会通过压在熟睡者身上来折磨他们。"
                            }
                        },
                        {
                            "text": "The painting depicts a <w>nightmare</w> perched atop a sleeping woman.",
                            "target_lang_translations": {
                                "ru": "На картине изображен <w>инкуб</w>, сидящий на спящей женщине.",
                                "zh": "这幅画描绘了一个栖息在熟睡女子身上的<w>梦魔</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incubus",
                        "succubus",
                        "night hag"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to the historical folklore usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Демон или чудовище в фольклоре, которое, как считается, садится на грудь спящим людям, вызывая удушье и дурные сны.",
                        "zh": "民间传说中被认为会坐在熟睡者胸口，导致窒息和噩梦的恶魔或怪物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мара",
                                "target_lang_sense_clarification": "фольклор"
                            },
                            {
                                "target_lang_word": "инкуб",
                                "target_lang_sense_clarification": "мифология"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梦魇",
                                "target_lang_sense_clarification": "民间传说中的鬼怪"
                            },
                            {
                                "target_lang_word": "梦魔",
                                "target_lang_sense_clarification": "神话中的恶魔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd582b58-c633-3c5d-bbac-d3e2abc97f69",
                    "sense_definition": "A feeling of extreme anxiety or suffocation experienced during sleep; sleep paralysis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that his inability to move was a symptom of the <w>nightmare</w>.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что его неспособность двигаться была симптомом <w>сонного паралича</w>.",
                                "zh": "医生解释说，他无法动弹是<w>鬼压床</w>的一种症状。"
                            }
                        },
                        {
                            "text": "He suffered from the <w>nightmare</w>, feeling a heavy weight on his chest while awake but paralyzed.",
                            "target_lang_translations": {
                                "ru": "Он страдал от <w>удушья во сне</w>, чувствуя тяжесть в груди, находясь в сознании, но будучи парализованным.",
                                "zh": "他深受<w>睡眠瘫痪</w>之苦，清醒时感到胸口有重物压迫，却无法动弹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep paralysis"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical medical term for sleep paralysis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильной тревоги или удушья во время сна; сонный паралич.",
                        "zh": "睡眠中经历的极度焦虑或窒息感；睡眠瘫痪症。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сонный паралич",
                                "target_lang_sense_clarification": "медицина"
                            },
                            {
                                "target_lang_word": "удушье",
                                "target_lang_sense_clarification": "симптом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鬼压床",
                                "target_lang_sense_clarification": "俗称，指睡眠瘫痪"
                            },
                            {
                                "target_lang_word": "睡眠瘫痪症",
                                "target_lang_sense_clarification": "医学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f063dbeb-999e-37ba-b4d2-ac4d12cff14d",
                    "sense_definition": "To experience a nightmare.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was <w>nightmaring</w> and tossing in his sleep.",
                            "target_lang_translations": {
                                "ru": "Ребенку <w>снились кошмары</w>, и он ворочался во сне.",
                                "zh": "孩子在睡梦中<w>做噩梦</w>，翻来覆去。"
                            }
                        },
                        {
                            "text": "I spent the whole night <w>nightmaring</w> about the upcoming exam.",
                            "target_lang_translations": {
                                "ru": "Я всю ночь <w>видел кошмары</w> о предстоящем экзамене.",
                                "zh": "我整晚都在为即将到来的考试<w>做噩梦</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Видеть кошмарный сон.",
                        "zh": "做噩梦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "видеть кошмары",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "мучиться кошмарами",
                                "target_lang_sense_clarification": "состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做噩梦",
                                "target_lang_sense_clarification": "指经历噩梦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1575b5c5-64ca-3709-85bf-54ac91387be6",
                    "sense_definition": "To trouble or haunt someone, as if by a nightmare.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Guilt <w>nightmared</w> him for years after the tragic accident.",
                            "target_lang_translations": {
                                "ru": "Чувство вины <w>мучило</w> его годами после трагической аварии.",
                                "zh": "那场悲剧发生后，负罪感多年来一直<w>折磨</w>着他。"
                            }
                        },
                        {
                            "text": "She was <w>nightmared</w> by visions of what could have happened.",
                            "target_lang_translations": {
                                "ru": "Её <w>преследовали</w> видения того, что могло бы случиться.",
                                "zh": "她被那些可能发生之事的幻象所<w>困扰</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or rare usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тревожить или преследовать кого-либо, подобно кошмару.",
                        "zh": "像噩梦一样困扰或折磨某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "терзать"
                            },
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "не давать покоя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "指精神上的痛苦"
                            },
                            {
                                "target_lang_word": "困扰",
                                "target_lang_sense_clarification": "指挥之不去的阴影"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e305ff43-049a-346e-a0e8-8d1b8a5ca0e0",
                    "sense_definition": "To imagine someone or something as if in a nightmare.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_imagine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>nightmared</w> a scenario where everything went wrong at once.",
                            "target_lang_translations": {
                                "ru": "Он <w>нарисовал в воображении</w> сценарий, где всё сразу пошло не так.",
                                "zh": "他<w>臆想</w>出了一个所有事情同时出错的场景。"
                            }
                        },
                        {
                            "text": "The author <w>nightmared</w> terrible creatures into existence on the page.",
                            "target_lang_translations": {
                                "ru": "Автор <w>создал</w> на страницах книги ужасных существ, словно из ночного кошмара.",
                                "zh": "作者在书页中<w>臆想</w>出了可怕的生物。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять кого-либо или что-либо как в кошмаре.",
                        "zh": "将某人或某事想象得如同噩梦一般。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представлять в кошмарном свете",
                                "target_lang_sense_clarification": "воображение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "臆想",
                                "target_lang_sense_clarification": "指主观的恐怖想象"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}