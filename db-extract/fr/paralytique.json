                        "entry_id": "68f3130c-cf98-3c00-b750-f624add91413",
                        "glosses": [
                            "Personne atteinte de paralysie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a05ac9-d028-4560-9724-e2237b62aaff",
                                "sense_id": "5d363a81-ffdc-33a8-9a94-95cbd3e3c11f",
                                "text": "De tous les pays circonvoisins, des campagnes et des villes, malades et infirmes, paralytiques, culs-de-jatte et pieds-bots accouraient dans des carrioles, dans des calèches, sur des ânes, sur leurs moignons calleux."
                            },
                            {
                                "example_id": "8809f27d-39af-4476-ab08-18b17db38ac7",
                                "sense_id": "5d363a81-ffdc-33a8-9a94-95cbd3e3c11f",
                                "text": "Le lieutenant Souchier a reçu de sa femme la nouvelle qu'il y a quarante prisonniers à Roanne! Pas un enfant, pas une vieille paralytique, sur la route de Charlieu, qui ne les ait déjà vus."
                            }
                        ]
                    }
