                                                "sense_id": "3a87bb8b-bfe4-3124-8666-949d1c99579b",
                                                "text": "Основание горы."
                                            },
                                            {
                                                "example_id": "ecdcf990-b16e-4b79-926b-c890d82f30db",
                                                "sense_id": "3a87bb8b-bfe4-3124-8666-949d1c99579b",
                                                "text": "У основания телескопа имеется целая система колес и винтов, с помощью которых астроном его регулирует."
                                            }
                                        ]
                                    },
