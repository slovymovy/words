                                        "entry_id": "47a05f18-d21f-3833-b97e-0d12982fe84f",
                                        "glosses": [
                                            "Widerspiegelung, Zurückgeworfenwerden, zum Beispiel von Licht im Spiegel oder Schall von einer Fläche"
                                        ],
                                        "tags": [
                                            "Optik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d8e1a88-c1a9-4dbd-b70e-727f11ccec4f",
                                                "sense_id": "6a366ff6-115c-3f4f-97ca-aa11b1dea8d6",
                                                "text": "Durch die Reflexion in der Fensterscheibe konnte ich den Mann hinter mir erkennen."
                                            },
                                            {
                                                "example_id": "eb879b4b-35c9-4ba6-8f3d-39361834613a",
                                                "sense_id": "6a366ff6-115c-3f4f-97ca-aa11b1dea8d6",
                                                "text": "Die Reflexion von Schallwellen hängt auch von der Isolierung des Raumes ab."
                                            },
                                            {
                                                "example_id": "8edd57cc-ded0-476a-be39-f3e02d7e5334",
                                                "sense_id": "6a366ff6-115c-3f4f-97ca-aa11b1dea8d6",
                                                "text": "Es gibt sehr anschauliche physikalische Versuche zur Reflexion einer Welle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b90b0a7-1473-3f7f-913b-9cecbfb2fe58",
                                        "entry_id": "47a05f18-d21f-3833-b97e-0d12982fe84f",
                                        "glosses": [
                                            "vertieftes Nachdenken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c25b10-05d1-44d7-b457-51a7db5fe222",
                                                "sense_id": "2b90b0a7-1473-3f7f-913b-9cecbfb2fe58",
                                                "text": "Bevor Sie Ihr Erlebnis richtig einordnen können, bedarf es noch weiterer Reflexion."
                                            },
                                            {
                                                "example_id": "6239b8c6-b9da-4bfc-9d6e-16d506f29adf",
                                                "sense_id": "2b90b0a7-1473-3f7f-913b-9cecbfb2fe58",
                                                "text": "Meine Tante hat ein Buch geschrieben: „Reflexionen über das Leben.“"
                                            },
                                            {
                                                "example_id": "9241db79-4fcd-462b-9da2-5f9d99944ee1",
                                                "sense_id": "2b90b0a7-1473-3f7f-913b-9cecbfb2fe58",
                                                "text": "Ab und zu sollte man eine Pause für die Reflexion des eigenen Handelns einlegen."
                                            },
                                            {
                                                "example_id": "76e8263b-e38d-4616-aafa-92abac0840cd",
                                                "sense_id": "2b90b0a7-1473-3f7f-913b-9cecbfb2fe58",
                                                "text": "„Nicht weniger entschieden verurteilt er die Einbindung von Reflexion und von Konzepten in die Kunst.“"
                                            },
                                            {
                                                "example_id": "dc3646f3-b4d5-4a58-b1f9-04bdd1e74e66",
                                                "sense_id": "2b90b0a7-1473-3f7f-913b-9cecbfb2fe58",
                                                "text": "„Einerseits sollte die schulische Wagniserziehung die Bedürfnisse der Wagenden berücksichtigen, und andererseits sollte sie Impulse zur Reflexion des gewagten Handelns setzen, um ein Bewusstsein für Selbstwirksamkeit, der Hilfsbedürftigkeit und Verantwortungsübernahme zu ermöglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
