                "senses": [
                    {
                        "sense_id": "e422d8f0-d82d-3ae9-9de2-e31e11c75465",
                        "entry_id": "af4ceaea-784c-3d59-b3e3-d73dbdc0568a",
                        "glosses": [
                            "Charger (quelqu’un) (de faire quelque chose)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9b2a8630-6676-4a05-b742-e40d393c1ed9",
                                "sense_id": "e422d8f0-d82d-3ae9-9de2-e31e11c75465",
                                "text": "C’étaient des bêtes que ma mère avait élevées, et qu’elle m’avait bien enchargée de soigner pour le mieux."
                            },
                            {
                                "example_id": "c649f948-e802-452b-88c7-0e4ed0cb4c20",
                                "sense_id": "e422d8f0-d82d-3ae9-9de2-e31e11c75465",
                                "text": "S’il prenait du mal, je n’oserais point rentrer à la maison ; et comme il ne pense jamais à ce qu’il fait, elle m’a tant enchargée de penser pour deux, que je tâche de n’y point manquer. — (George Sand, Les Maîtres sonneurs, George Bell and sons, 1908, page 5)"
                            }
                        ]
                    }
                ],
