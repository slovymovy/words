                        "translation_id": "fd01141e-c85f-4a90-9238-bec7d367166b",
                        "source_entry_id": "77c92242-afad-3bc9-be1a-ef67f6ff0397",
                        "source_sense_id": "af04b972-ec11-3d99-a6fc-b75d4c3263a3",
                        "source_sense_description": "Medizin: die Unterentwicklung eines Gewebes oder eines Organs durch unzureichende Zellbildung",
                        "target_lang_word": "hypoplasia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypoplasia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d0ce44a-41e2-3ba0-ab25-def954d03fac",
                                        "entry_id": "985d0d4a-e8b5-3495-9c01-7f23023a1d6e",
                                        "glosses": [
                                            "Underdevelopment or incomplete development of a tissue or organ, especially when caused by an inadequate or below-normal number of cells."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b4d67bf-fc43-492f-850e-1225e08c7a5f",
                                                "sense_id": "6d0ce44a-41e2-3ba0-ab25-def954d03fac",
                                                "text": "1995, William M. Thurlbeck, 2. Lung Growth and Development, William M. Thurlbeck, Andrew Churg (editors), 2nd edition, Thieme Medical Publishers, Pathology of the Lung, page 56,\nSince the renal system and the lung develop at the same time, there has been repeated speculation that pulmonary hypoplasia and renal anomalies may be linked by a common developmental defect."
                                            },
                                            {
                                                "example_id": "c7388f6b-07e5-4039-8e85-50e8dc52fc7d",
                                                "sense_id": "6d0ce44a-41e2-3ba0-ab25-def954d03fac",
                                                "text": "2022, Robert A. Foster, Christopher Premanandan, Chapter 19: Male Reproductive System, James F. Zachary (editor), Pathologic Basis of Veterinary Disease, 7th edition, Elsevier, page 1320,\nHypoplasia of the testes is a common condition and DSD."
                                            },
                                            {
                                                "example_id": "54b00677-4c3a-48e8-b8b1-b7572090ac84",
                                                "sense_id": "6d0ce44a-41e2-3ba0-ab25-def954d03fac",
                                                "text": "This complex etiology suggests that individual life histories should be interpreted carefully since enamel hypoplasias could reflect stressors experienced by an individual's parents and individual genetic susceptibility. Additionally, enamel hypoplasias may be more indicative of acute episodes of stress instead of long, chronic periods of stress."
                                            }
                                        ]
                                    }
