    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce7bb652-bf36-36fb-8049-ffa000807ec9",
                    "sense_definition": "Faire sortir des personnes d'un lieu menacé ou dangereux pour assurer leur sécurité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "évacuation_lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont décidé d'<w>évacuer</w> immédiatement tous les habitants de cet immeuble en feu."
                        },
                        {
                            "text": "L'armée a réussi à <w>évacuer</w> les blessés vers l'hôpital le plus proche."
                        }
                    ],
                    "synonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "faire évacuer les lieux",
                        "évacuer les blessés",
                        "évacuer les résidents"
                    ]
                },
                {
                    "sense_id": "7a484bfb-fa53-3cec-987b-bc54e1ed2efd",
                    "sense_definition": "Quitter un lieu ou un bâtiment menacé pour se mettre en sécurité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "évacuation_lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que l'alarme a retenti, tout le monde a dû <w>évacuer</w> les lieux dans le calme."
                        },
                        {
                            "text": "Les riverains ont commencé à <w>évacuer</w> le village avant l'arrivée des flammes."
                        }
                    ],
                    "synonyms": [
                        "vider"
                    ],
                    "common_phrases": [
                        "évacuer le bâtiment",
                        "évacuer la zone",
                        "évacuer les lieux"
                    ]
                },
                {
                    "sense_id": "63ae37a8-4bc1-37d3-8d72-447642041094",
                    "sense_definition": "Écarter délibérément une question, un problème ou un sentiment d'une réflexion ou d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il pratique régulièrement la course à pied afin d'<w>évacuer</w> son stress après le travail."
                        },
                        {
                            "text": "Le directeur a tenté d'<w>évacuer</w> le problème sans répondre aux inquiétudes réelles des employés."
                        }
                    ],
                    "synonyms": [
                        "éliminer"
                    ],
                    "common_phrases": [
                        "évacuer le stress",
                        "évacuer une question",
                        "évacuer un problème"
                    ]
                },
                {
                    "sense_id": "aa738349-8614-3ea4-acda-dd7cbb401bdd",
                    "sense_definition": "Rejeter ou expulser hors de l'organisme une substance, un liquide ou des toxines.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Boire suffisamment d'eau permet aux reins d'<w>évacuer</w> les toxines accumulées par le corps."
                        },
                        {
                            "text": "Cette plante utilise ses feuilles pour <w>évacuer</w> l'excédent d'humidité durant la nuit."
                        }
                    ],
                    "synonyms": [
                        "éliminer",
                        "excréter"
                    ],
                    "common_phrases": [
                        "évacuer les toxines",
                        "évacuer l'eau"
                    ]
                }
            ]
        }
    ]
}