                "senses": [
                    {
                        "sense_id": "022a506c-5f50-3beb-82c9-84457515d0e6",
                        "entry_id": "3e57d93e-023b-3ca1-8b4c-d44cf6ae67f8",
                        "glosses": [
                            "Eigenschaft, durchlässig (permeabel), statt undurchlässig (impermeabel) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b9fe9b-50de-441a-85cd-f71c6590b14d",
                                "sense_id": "022a506c-5f50-3beb-82c9-84457515d0e6",
                                "text": "„Sobald sich aber mikroskopisch zelluläre Änderungen erkennen lassen, ist an dem Bestehen einer Störung der gerichteten Permeabilität wohl kaum mehr zu zweifeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "931d46a7-7604-3422-a98c-c97b7f1718d4",
                        "entry_id": "3e57d93e-023b-3ca1-8b4c-d44cf6ae67f8",
                        "glosses": [
                            "Maß der Magnetisierbarkeit"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "414c97da-71c6-42a4-8868-0b3ef44cc787",
                                "sense_id": "931d46a7-7604-3422-a98c-c97b7f1718d4",
                                "text": "„Die Frage der magnetischen Permeabilität der Nickelstahle ist noch nicht genügend geklärt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b17fd659-7418-379d-bfa7-3f7462229601",
                        "entry_id": "3e57d93e-023b-3ca1-8b4c-d44cf6ae67f8",
                        "glosses": [
                            "der Prozentteil eines Raumes, der durch Wasser eingenommen werden kann (zum Beispiel des Maschinenraumes, wenn es im Schiffskörper zu einem Leck kommt)"
                        ],
                        "tags": [
                            "Schiffbau"
                        ],
                        "examples": [
                            {
                                "example_id": "4f35ca2e-037e-4c91-a8fb-b49c282df086",
                                "sense_id": "b17fd659-7418-379d-bfa7-3f7462229601",
                                "text": "„Größere Körper, die die Permeabilität des eindringenden Wassers vermindern, lassen sich natürlich in den lecken Abteilungen beliebig anbringen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
