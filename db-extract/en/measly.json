                                        "glosses": [
                                            "(člověk) špatných lidských vlastností."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5edb74a-a997-4d57-a59b-cbfa85408c54",
                                                "sense_id": "e665eb7d-4b80-3392-88dc-7a662588984d",
                                                "text": "Jestliže lžeš i vlastní ženě, tak to jsi tedy dost ubohý."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "750945ac-1497-3927-b924-9493fbe558b8",
