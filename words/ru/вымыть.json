            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c38a3152-6da7-3435-8354-8aedacd3c18d",
                    "sense_definition": "сделать чистым с помощью воды или моющего средства",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "очищение водой",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед едой нужно обязательно тщательно <w>вымыть</w> руки с мылом.",
                            "target_lang_translations": {
                                "de": "Vor dem Essen muss man sich unbedingt gründlich die Hände mit Seife <w>waschen</w>."
                            }
                        },
                        {
                            "text": "После вкусного семейного обеда брат помог мне аккуратно <w>вымыть</w> всю посуду.",
                            "target_lang_translations": {
                                "de": "Nach dem leckeren Familienessen half mir mein Bruder, das gesamte Geschirr sorgfältig <w>abzuwaschen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "помыть",
                        "отмыть"
                    ],
                    "antonyms": [
                        "испачкать",
                        "загрязнить"
                    ],
                    "common_phrases": [
                        "вымыть руки",
                        "вымыть посуду",
                        "вымыть пол",
                        "вымыть голову"
                    ],
                    "target_lang_definitions": {
                        "de": "etwas mit Wasser oder Reinigungsmitteln sauber machen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "waschen",
                                "target_lang_sense_clarification": "Hände, Haare, Körper"
                            },
                            {
                                "target_lang_word": "abwaschen",
                                "target_lang_sense_clarification": "Geschirr"
                            },
                            {
                                "target_lang_word": "spülen",
                                "target_lang_sense_clarification": "Geschirr reinigen"
                            },
                            {
                                "target_lang_word": "wischen",
                                "target_lang_sense_clarification": "Boden feucht reinigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a43e7541-51ae-3a97-a4d8-d637f3c0cbd9",
                    "sense_definition": "подвергнуть стирке предметы из ткани; выстирать",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "очищение водой",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она решила быстро <w>вымыть</w> испачканную рубашку в тёплой мыльной воде.",
                            "target_lang_translations": {
                                "de": "Sie beschloss, das schmutzige Hemd schnell in warmem Seifenwasser <w>auszuwaschen</w>."
                            }
                        },
                        {
                            "text": "Мама аккуратно <w>вымыла</w> бельё в тазу и затем вывесила его сушиться во двор.",
                            "target_lang_translations": {
                                "de": "Mama hat die Wäsche vorsichtig im Waschzuber <w>gewaschen</w> und sie dann zum Trocknen im Hof aufgehängt."
                            }
                        }
                    ],
                    "synonyms": [
                        "выстирать"
                    ],
                    "common_phrases": [
                        "вымыть бельё",
                        "вымыть рубашку"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "о стирке одежды и белья"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Kleidung oder Textilien waschen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "waschen",
                                "target_lang_sense_clarification": "Wäsche, Kleidung"
                            },
                            {
                                "target_lang_word": "auswaschen",
                                "target_lang_sense_clarification": "Textilien mit der Hand auswaschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c0c7082-a702-371e-93b4-64dfdc34a2eb",
                    "sense_definition": "потоком воды образовать углубление, яму в почве или грунте",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "действие потока воды",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчерашний сильный ливень быстро <w>вымыл</w> на грунтовой дороге глубокую яму.",
                            "target_lang_translations": {
                                "de": "Der gestrige starke Wolkenbruch hat schnell ein tiefes Loch in den Feldweg <w>gespült</w>."
                            }
                        },
                        {
                            "text": "Бурный весенний ручей постепенно <w>вымыл</w> просторный овраг прямо на краю леса.",
                            "target_lang_translations": {
                                "de": "Der reißende Frühlingsbach hat allmählich eine breite Schlucht direkt am Waldrand <w>ausgewaschen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вымыть яму",
                        "вымыть овраг"
                    ],
                    "target_lang_definitions": {
                        "de": "durch fließendes Wasser eine Vertiefung oder Grube im Boden bilden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auswaschen",
                                "target_lang_sense_clarification": "Boden oder Gestein aushöhlen"
                            },
                            {
                                "target_lang_word": "ausspülen",
                                "target_lang_sense_clarification": "durch Strömung freilegen oder aushöhlen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "794e8698-b01d-304b-90a9-2da47031578e",
                    "sense_definition": "струёй или проточной жидкостью извлечь и унести наружу какие-либо частицы или вещества",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "действие потока воды",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Слишком сильный напор воды может случайно <w>вымыть</w> свежий раствор из швов плитки.",
                            "target_lang_translations": {
                                "de": "Ein zu starker Wasserdruck kann versehentlich den frischen Mörtel aus den Fliesenfugen <w>ausspülen</w>."
                            }
                        },
                        {
                            "text": "Обильный полив рискует быстро <w>вымыть</w> полезные минеральные вещества из верхнего слоя почвы.",
                            "target_lang_translations": {
                                "de": "Reichliches Gießen birgt die Gefahr, nützliche Mineralstoffe schnell aus der oberen Bodenschicht <w>auszuwaschen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "промыть"
                    ],
                    "common_phrases": [
                        "вымыть минералы",
                        "вымыть песок"
                    ],
                    "target_lang_definitions": {
                        "de": "durch eine Strömung oder Flüssigkeit Teilchen oder Stoffe herauslösen und wegtragen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auswaschen",
                                "target_lang_sense_clarification": "Stoffe, Mineralien herauslösen"
                            },
                            {
                                "target_lang_word": "ausspülen",
                                "target_lang_sense_clarification": "Partikel oder Mörtel fortschwemmen"
                            }
                        ]
                    }
                }
            ]
        }
