                    {
                        "sense_id": "43646eb0-a25a-300e-9108-513a2fcbf563",
                        "entry_id": "fb7d2af3-92f4-342c-aaca-c86100bb9ebd",
                        "glosses": [
                            "Of or pertaining to a sort, or kind."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "30fa9545-0dae-4784-845c-4c260eb3e1c5",
                                "sense_id": "43646eb0-a25a-300e-9108-513a2fcbf563",
                                "text": "But, it being evident that things are ranked under names into sorts or species, only as they agree to certain abstract ideas, to which we have annexed those names, the essence of each genus, or sort, comes to be nothing but that abstract idea which the general, or sortal (if I may have leave so to call it from sort, as I do general from genus), name stands for."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbc84bc8-d535-3dd5-8d5e-a0f1cf9b2501",
                        "entry_id": "fb7d2af3-92f4-342c-aaca-c86100bb9ebd",
                        "glosses": [
                            "Having the character of a sortal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9c9fc070-550c-4a64-8e08-16d469058781",
                                "sense_id": "bbc84bc8-d535-3dd5-8d5e-a0f1cf9b2501",
                                "text": "The possession of sortal concepts is a prerequisite for philosophers like Wiggins or Lowe in determining the nature and extent of our referential capacities."
                            }
                        ]
                    }
