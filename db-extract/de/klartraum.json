                        "form": "den Klartraum"
                    },
                    {
                        "form_id": "1434d1ff-10d1-4dcd-829b-331babb70321",
                        "entry_id": "02096a43-d970-352c-b753-30f44de3ca46",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Klarträume"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                        "entry_id": "02096a43-d970-352c-b753-30f44de3ca46",
                        "glosses": [
                            "Traum, bei dem die träumende Person weiß, dass sie träumt und den Traum steuern kann"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "26fb81ad-6314-4747-bb85-3bb5e06267ac",
                                "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                                "text": "„Bislang weiß man nur wenig über Klarträume.“"
                            },
                            {
                                "example_id": "8fbf81db-ba63-48dc-821e-b9fae315da29",
                                "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                                "text": "„Und siehe da: ‚In Klarträumen erwacht der präfrontale Cortex‘, sagt Voss, ‚sonst sind die Aktivitätsmuster ziemlich die gleichen wie in normalen REM-Träumen.‘“"
                            },
                            {
                                "example_id": "9b562197-7c04-4a8c-a3a6-f47837fbacf6",
                                "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                                "text": "„Eine britische Studie zeigt nun, dass Personen, die regelmässig Klarträume erleben, in Realität besser Probleme lösen können als gewöhnliche Träumer («Dreaming», Bd. 24, S. 152).“"
                            },
                            {
                                "example_id": "6147fa63-a5f7-418c-a3db-995975d19b28",
                                "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                                "text": "„Darüber hinaus gebe es Berichte von Sportlern, die mithilfe des Klartraums ihre Bewegungsabläufe übten und sich dadurch steigern konnten, sagt Schädlich.“"
                            },
                            {
                                "example_id": "fc51d22a-a871-4bad-926a-44a48b95c738",
                                "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                                "text": "„Im Klartraum befinden wir uns in der REM-Phase (Rapid Eye Movement, ein Schlafstadium, das durch schnelle Augenbewegung gekennzeichnet ist), schlafen tief und fest, doch ein Teil unseres Gehirns wird während des Traums reaktiviert, sodass wir das Traumgeschehen mit allen Sinnen erleben.“"
                            },
                            {
                                "example_id": "c5d8b3af-f49f-415a-980d-193e42fdecd7",
                                "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                                "text": "„Wissenschaftler nennen diese Art von nächtlichen Erlebnissen ‚luzide Träume‘ oder auch ‚Klarträume‘. Die meisten Menschen, die diese Kunst beherrschen, erleben nicht mehr als ein paar Mal im Jahr einen Klartraum, doch einige wenige geübte Klarträumer haben fast jede Nacht einen bewussten Traum.“"
                            },
                            {
                                "example_id": "017a925e-92bd-4a6f-95a9-8a1e18240b8a",
                                "sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                                "text": "„Während eines Klartraumes ist es möglich, sich aus einer anderen Perspektive zu sehen oder alles in Zeitlupe zu erleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10c4c7af-8b95-4589-8b90-20073ce00f72",
                        "source_entry_id": "02096a43-d970-352c-b753-30f44de3ca46",
                        "source_sense_id": "df866715-d08d-3e72-a43e-4bfd55d6b283",
                        "target_lang_word": "lucid dream",
