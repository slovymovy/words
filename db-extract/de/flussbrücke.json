                "senses": [
                    {
                        "sense_id": "c4868a3c-8e55-3757-8822-40ed46115e81",
                        "entry_id": "23aa9065-94d0-319b-95c1-419197b8b791",
                        "glosses": [
                            "Brücke über einen Fluss"
