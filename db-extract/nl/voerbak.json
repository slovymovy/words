                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617811dd-f003-3454-9fa1-247efd6c501f",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "One who feeds, or gives food to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10daa8b5-98d1-3e18-8477-cd763a32be8e",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "One who feeds, or gives food to another.",
                                            "The participant in feederism who feeds the other (the feedee)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d0cd5b-88f8-4757-9691-14a1d4ec1f6d",
                                                "sense_id": "10daa8b5-98d1-3e18-8477-cd763a32be8e",
                                                "text": "Often similes such as 'soft as velvet' or 'fluffy like a cloud' will be employed and the feeder will describe how he feels he can be lost in the enveloping folds of soft flesh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e281b71b-1f51-3a50-a248-8369d991c509",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "One who feeds, or takes in food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a986b5-2e66-4464-9d2e-44ff9ea21d31",
                                                "sense_id": "e281b71b-1f51-3a50-a248-8369d991c509",
                                                "text": "The patch is kind enough, but a huge feeder,\nSnail-slow in profit, and he sleeps by day\nMore than the wild-cat; […]"
                                            },
                                            {
                                                "example_id": "454b7c02-4dae-4000-a893-483878c3926d",
                                                "sense_id": "e281b71b-1f51-3a50-a248-8369d991c509",
                                                "text": "There are many who are dietarians in theory, but liberal feeders in practice. They suppose or maintain that it is a duty to deny oneself of all luxuries at the table, but practically they take the best that they can get."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91675c72-640c-3956-a220-482682a85c8a",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "One who, or that which, feeds material into something (especially a machine)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91df910d-0002-49cf-8b55-ba2dc2f9a740",
                                                "sense_id": "91675c72-640c-3956-a220-482682a85c8a",
                                                "text": "When the claxon sounded they immediately stopped what they were doing and uncovered the Oerlikon. Paddy, who was ammunition feeder, stood by while Jock trained the 20mm gun around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c4a747-9a93-3557-9e46-8621b1fe8283",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "That which is used to feed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957e8d65-cf18-4da8-b358-66ded0e461bb",
                                                "sense_id": "a8c4a747-9a93-3557-9e46-8621b1fe8283",
                                                "text": "a bird feeder"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baf7d497-4428-35c3-8898-ba5a3680f294",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "A tributary stream, especially of a canal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630e7166-747e-4547-8780-eb05a2fa9d1e",
                                                "sense_id": "baf7d497-4428-35c3-8898-ba5a3680f294",
                                                "text": "The surface of the Balaton and the surrounding marshes is not less than 24 German square miles, or 384 English square miles; its principal feeder is the Szala, but all the water it receives appears inconsiderable relatively to its superficial extent, and the quantity lost in evaporation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dce6548-ae8b-3c39-a45b-dca002a95155",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "A branch line of a railway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f8730ae-d4af-4e17-9dd7-b3f8835cda0a",
                                                "sense_id": "8dce6548-ae8b-3c39-a45b-dca002a95155",
                                                "text": "This line, described as a valuable feeder to the Newcastle & Carlisle Railway, was opened on July 8, 1836, and superseded the older wagonway."
                                            },
                                            {
                                                "example_id": "69fc8010-0579-48e2-a5c9-75e98645ec6f",
                                                "sense_id": "8dce6548-ae8b-3c39-a45b-dca002a95155",
                                                "text": "Another factor to be allowed for in establishing the remunerativeness of a service was its value as a feeder to the rest of the system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc5dd3a-d5eb-3142-acb1-01c8bc64b213",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "A transmission line that feeds the electricity for an electricity substation, or for a transmitter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6c55aab-5700-3910-821a-0755f0e62073",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "Ellipsis of feeder school."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c94d16c7-5593-334e-8f77-2fca31214fef",
                                        "entry_id": "6687dc69-81b5-3d12-a080-dca6bd4704b0",
                                        "glosses": [
                                            "A feeder ship."
                                        ],
                                        "tags": [],
