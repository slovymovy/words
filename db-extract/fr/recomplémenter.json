                "senses": [
                    {
                        "sense_id": "7fd0ef6e-64ea-3a58-936d-f9fd7611527c",
                        "entry_id": "a97c6131-3ae9-3d49-bac6-f978075e0107",
                        "glosses": [
                            "Complémenter de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf13a5a-5ae5-4bb9-b6b4-836ef9701f53",
                                "sense_id": "7fd0ef6e-64ea-3a58-936d-f9fd7611527c",
                                "text": "C'est pourquoi nous avons cherché à recomplémenter de tels sérums après chauffage."
                            },
                            {
                                "example_id": "a9b63891-8acd-4ac1-891d-97093c0c48ef",
                                "sense_id": "7fd0ef6e-64ea-3a58-936d-f9fd7611527c",
                                "text": "Est ce que je peux la recomplémenter avec mon propre mélange et si oui en quelle quantité?"
                            },
                            {
                                "example_id": "651a515e-cf24-4d38-9383-396bf1108e25",
                                "sense_id": "7fd0ef6e-64ea-3a58-936d-f9fd7611527c",
                                "text": "Dès que tu t'aperçois qu'il commence à perdre tu le recomplémentes pour qu'il reste en état cet hiver."
                            },
                            {
                                "example_id": "503ea9df-0676-4b09-bcec-5de4d1aab3a9",
                                "sense_id": "7fd0ef6e-64ea-3a58-936d-f9fd7611527c",
                                "text": "On vérifie que c'est cohérent, donc on recomplémente a 2 pour trouver 2 (si tout va bien) 0000 0001+1=0000 0010 tout va bien."
                            }
                        ]
                    }
