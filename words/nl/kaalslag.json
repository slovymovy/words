    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e915ee6-1a8c-3676-8072-258421a43dcd",
                    "sense_definition": "Het volledig kappen of vellen van alle bomen op een bepaald stuk bosgrond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bosbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De milieuorganisatie protesteerde fel tegen de <w>kaalslag</w> in het oerbos.",
                            "target_lang_translations": {
                                "en": "The environmental organization protested fiercely against the <w>clear-cutting</w> in the primeval forest."
                            }
                        },
                        {
                            "text": "Na de <w>kaalslag</w> bleef er een troosteloos landschap achter zonder bomen.",
                            "target_lang_translations": {
                                "en": "After the <w>clear-felling</w>, a desolate landscape without trees was left behind."
                            }
                        }
                    ],
                    "synonyms": [
                        "boskap",
                        "ontbossing"
                    ],
                    "antonyms": [
                        "herbebossing"
                    ],
                    "common_phrases": [
                        "kaalslag in het bos"
                    ],
                    "target_lang_definitions": {
                        "en": "The complete cutting down or felling of all trees in a specific area of forest land."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear-cutting",
                                "target_lang_sense_clarification": "forestry practice of removing all trees"
                            },
                            {
                                "target_lang_word": "deforestation",
                                "target_lang_sense_clarification": "clearing of forest land"
                            },
                            {
                                "target_lang_word": "clear-felling",
                                "target_lang_sense_clarification": "cutting down all trees in an area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3e111b7-de5a-3bb7-8f78-49888e9afdb4",
                    "sense_definition": "Grootschalige afbraak, vernietiging of drastische bezuiniging die leidt tot het verdwijnen van voorzieningen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "afbraak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe begroting zorgt voor een enorme <w>kaalslag</w> in de culturele sector.",
                            "target_lang_translations": {
                                "en": "The new budget causes <w>devastation</w> in the cultural sector."
                            }
                        },
                        {
                            "text": "Critici vrezen een <w>kaalslag</w> op de sociale zekerheid door de voorgestelde maatregelen.",
                            "target_lang_translations": {
                                "en": "Critics fear <w>drastic cuts</w> to social security due to the proposed measures."
                            }
                        }
                    ],
                    "synonyms": [
                        "afbraak",
                        "sanering",
                        "vernietiging"
                    ],
                    "antonyms": [
                        "opbouw",
                        "investering"
                    ],
                    "common_phrases": [
                        "kaalslag in de cultuursector",
                        "sociale kaalslag"
                    ],
                    "target_lang_definitions": {
                        "en": "Large-scale demolition, destruction, or drastic budget cuts leading to the disappearance of services or facilities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "devastation",
                                "target_lang_sense_clarification": "severe destruction or damage"
                            },
                            {
                                "target_lang_word": "drastic cuts",
                                "target_lang_sense_clarification": "severe reduction in funding or services"
                            },
                            {
                                "target_lang_word": "decimation",
                                "target_lang_sense_clarification": "the destruction of a large proportion of something"
                            },
                            {
                                "target_lang_word": "slashing",
                                "target_lang_sense_clarification": "severe reduction of budgets or services"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}