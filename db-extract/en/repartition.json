                                "target_senses": [
                                    {
                                        "sense_id": "4bc93cc8-88e2-3d25-9fd1-3f6896a75f1b",
                                        "entry_id": "79669563-24b2-3fe2-a058-1806df378a2d",
                                        "glosses": [
                                            "Découper en une partition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "344c76c3-0043-4d80-b08b-0d57a8703865",
                                                "sense_id": "4bc93cc8-88e2-3d25-9fd1-3f6896a75f1b",
                                                "text": "L'algorithme de McCluskey partitionne les monômes ayant un même nombre de variables en classes ou sous-ensembles de monômes de même rang (ou nombre de variables directes)."
                                            },
                                            {
                                                "example_id": "45fe71f7-d6e8-417c-8c95-0edc4a79ccd3",
                                                "sense_id": "4bc93cc8-88e2-3d25-9fd1-3f6896a75f1b",
                                                "text": "Dans le spout, les données sont transformées en tuples, l'équivalent Storm des lignes d'une table. Ces tuples sont partitionnés en lots et chaque lot est envoyé à un ou plusieurs bolts répartis sur le cluster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
