                        ]
                    },
                    {
                        "translation_id": "b7d96c77-ecb7-4852-9e91-a67cc089adb3",
                        "source_entry_id": "601eda5a-ab41-31da-bf82-a0c698360ba2",
                        "source_sense_id": "96aab56e-a38a-3852-b1c4-d57f1dc7f191",
                        "target_lang_word": "Toulon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Toulon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b04c1bfe-6952-306b-a58e-46f520aaa4a3",
                                        "entry_id": "831cdd37-a9ee-3893-8a32-eddb4272a069",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département du Var."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63667080-dc03-4ba2-8be1-4eff085a55c5",
                                                "sense_id": "b04c1bfe-6952-306b-a58e-46f520aaa4a3",
                                                "text": "TOULON est noyé comme dans un rêve d’opium. C’est une honte et une tragédie. Il n’y a pas de souvenirs qui tiennent…"
                                            },
                                            {
                                                "example_id": "7d0df591-8566-4e78-ad09-6d5cb641c035",
                                                "sense_id": "b04c1bfe-6952-306b-a58e-46f520aaa4a3",
                                                "text": "Nous arrivons au siège de Toulon : ici s’ouvre la carrière militaire de Bonaparte."
                                            },
                                            {
                                                "example_id": "43d97292-e737-4ef0-99ab-464e1fb217d9",
                                                "sense_id": "b04c1bfe-6952-306b-a58e-46f520aaa4a3",
                                                "text": "Toulon est dix fois supérieur [à Marseille] à cause des officiers de marine, gens bien élevés et qui ont voyagé. Ici, rien que de la grosse joie ; quelques juges de paix retirés font de l’archéologie locale."
                                            },
                                            {
                                                "example_id": "8fc31abc-4ce9-4857-848c-f3f5e0de3ef3",
                                                "sense_id": "b04c1bfe-6952-306b-a58e-46f520aaa4a3",
                                                "text": "Toulon, en réalité, n’appartient, en propre, à aucune de nos provinces, c’est le Brest de la Méditerranée, à moins que Brest ne soit le Toulon de l’Océan."
                                            },
                                            {
                                                "example_id": "a6c40d81-8359-4e88-926e-a71ebd114900",
                                                "sense_id": "b04c1bfe-6952-306b-a58e-46f520aaa4a3",
                                                "text": "Vint l’heure du noble devoir patriotique. Fagerolle tira ses mois d’embastillement militaire sans trop de dommages, dans un régiment de marsouins, à Toulon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
