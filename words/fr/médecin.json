    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9314e847-cc55-35f6-83de-06a2e91d1b7e",
                    "sense_definition": "Personne titulaire d'un diplôme de docteur en médecine, habilitée à soigner les maladies et les blessures.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "profession_sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand on a de la fièvre, il faut aller chez le <w>médecin</w>."
                        },
                        {
                            "text": "Mon <w>médecin</w> généraliste m'a conseillé de faire une prise de sang."
                        }
                    ],
                    "synonyms": [
                        "docteur",
                        "praticien",
                        "toubib"
                    ],
                    "common_phrases": [
                        "médecin traitant",
                        "médecin généraliste",
                        "aller chez le médecin"
                    ]
                },
                {
                    "sense_id": "b031bd26-9de0-3f4e-abdf-274efe88e924",
                    "sense_definition": "Ce qui apporte un apaisement ou un remède moral au sens figuré.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "guerison_figuree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On dit souvent que le temps est un grand <w>médecin</w> pour les cœurs brisés."
                        },
                        {
                            "text": "Pour lui, la lecture est un excellent <w>médecin</w> contre la solitude."
                        }
                    ],
                    "common_phrases": [
                        "le temps est un grand médecin"
                    ]
                },
                {
                    "sense_id": "5be52269-7644-3d31-ae1b-a12dca0184f4",
                    "sense_definition": "Premier grade militaire conféré aux officiers du corps de santé des armées françaises à l'issue de leur internat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grade_militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son internat, le sous-lieutenant a été nommé au grade de <w>médecin</w>."
                        },
                        {
                            "text": "Fraîchement promue au grade de <w>médecin</w>, elle a rejoint un hôpital d'instruction des armées."
                        }
                    ]
                }
            ]
        },
        {
