                                                "sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                                                "text": "Auf Verkehrsschildern wird beispielsweise angegeben, wer Vorfahrt hat oder welche Geschwindigkeit maximal gefahren werden darf."
                                            },
                                            {
                                                "example_id": "bb19aeeb-ebb9-4716-ac22-87b58d2656e5",
                                                "sense_id": "4fdc3fbe-a69f-37b3-9a83-3cd7b3a0eb67",
                                                "text": "„Wenn man sich die Verkehrsschilder genau anschaut und sie analysiert, kann einem einiges auffallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
