                                    {
                                        "sense_id": "c0d30889-0f78-32dd-b77d-dc4483821bd6",
                                        "entry_id": "0182001f-93e6-377a-9d15-0dbb98f62c78",
                                        "glosses": [
                                            "Celui qui fait partie de l’équipage manœuvrier d’un bâtiment de mer."
                                        ],
                                        "tags": [],
                                        "note": "On dit plutôt aujourd’hui marin, et le féminin est rare, le mot matelote désignant aussi une spécialité culinaire",
                                        "examples": [
                                            {
                                                "example_id": "284287aa-a5dc-49f8-ae04-f802249c510a",
                                                "sense_id": "c0d30889-0f78-32dd-b77d-dc4483821bd6",
                                                "text": "Sur le pont, en tenue légère, étaient des matelots américains, tous abondamment tatoués."
                                            },
                                            {
                                                "example_id": "8b173237-85b9-4d76-a778-6a2741b166cc",
                                                "sense_id": "c0d30889-0f78-32dd-b77d-dc4483821bd6",
                                                "text": "Le mot « matelot », qui signifie dans la vieille langue hollandaise « compagnon de couche », évoque ainsi une situation propre à inspirer un trouble pouvant conduire jusqu'aux privautés les plus poussées."
                                            },
                                            {
                                                "example_id": "be20d23d-7190-4d0c-8641-9abbeda1f4b6",
                                                "sense_id": "c0d30889-0f78-32dd-b77d-dc4483821bd6",
                                                "text": "Dans la pénombre des couchettes où dorment les matelots, on devine une photo de famille et une niche remplie de bondieuseries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2c35647-6740-3126-910c-b5ce5b9095ab",
                                        "entry_id": "0182001f-93e6-377a-9d15-0dbb98f62c78",
                                        "glosses": [
                                            "Grade ou fonction de matelot."
                                        ],
                                        "tags": [
                                            "Marine militaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd2e0738-2f3a-4390-82c1-5a670013727e",
                                                "sense_id": "f2c35647-6740-3126-910c-b5ce5b9095ab",
                                                "text": "Matelot de première classe, de deuxième classe."
                                            },
                                            {
                                                "example_id": "4a498333-3d6f-47cd-80fd-3e01c848499b",
                                                "sense_id": "f2c35647-6740-3126-910c-b5ce5b9095ab",
                                                "text": "Matelot timonier, matelot torpilleur, matelot de pont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769b79c5-432a-3448-b7c0-13d3300a45ad",
                                        "entry_id": "0182001f-93e6-377a-9d15-0dbb98f62c78",
                                        "glosses": [
                                            "Matelot spécialisé dans la conduite nautique d’un navire."
                                        ],
                                        "tags": [
                                            "Marine marchande"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5175bf94-b68f-43b0-bd41-64bba9569698",
                                                "sense_id": "769b79c5-432a-3448-b7c0-13d3300a45ad",
                                                "text": "Ce paquebot comprend deux cents hommes d’équipage dont cinquante matelots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6494fe1a-2245-32a0-a727-d5c97fb1fbe2",
                                        "entry_id": "0182001f-93e6-377a-9d15-0dbb98f62c78",
                                        "glosses": [
                                            "Chacun des vaisseaux d’une ligne considéré par rapport à celui qu’il précède ou qu’il suit immédiatement."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36fefbef-f523-4d25-877f-c64d60563462",
                                                "sense_id": "6494fe1a-2245-32a0-a727-d5c97fb1fbe2",
                                                "text": "Matelot d’avant, matelot d’arrière."
                                            },
                                            {
                                                "example_id": "1ee8ac29-9fc4-47f3-9e64-844ce4bf3443",
                                                "sense_id": "6494fe1a-2245-32a0-a727-d5c97fb1fbe2",
                                                "text": "Chaque unité doit serrer sur son matelot d’avant."
                                            }
                                        ]
                                    }
                                ]
                            },
