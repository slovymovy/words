                                    },
                                    {
                                        "sense_id": "8da4bce9-2aaf-35b1-b548-cd688a5ed892",
                                        "entry_id": "b734607f-1c98-33eb-851d-95ec8cd4fbad",
                                        "glosses": [
                                            "Using an italic style; italic."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8b0a679-a175-4831-8f2f-8e28b265d82b",
                                                "sense_id": "8da4bce9-2aaf-35b1-b548-cd688a5ed892",
                                                "text": "It has been shown that there was a great disposition on the part of some German printers, especially Albert Durer, to adopt the rounded Italian type; others preferring the crisp angularity of the Gothic black-letter, even for general purposes; while for books of devotion it appears to have been deemed the more orthodox; the Italian style of type being deemed an innovation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Italian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdc35f37-8ada-3606-b03c-92db4d177661",
                                        "entry_id": "90b69a1e-1ccd-3836-9e03-f0acdc2771d3",
                                        "glosses": [
                                            "An inhabitant of Italy, or a person of Italian descent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32705801-da5c-4560-b7fb-01e926519a81",
                                                "sense_id": "fdc35f37-8ada-3606-b03c-92db4d177661",
                                                "text": "As Di Matteo celebrated and captain John Terry raised the trophy for the fourth time, the Italian increased his claims to become the permanent successor to Andre Villas-Boas by landing a trophy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ec9932-1a5e-3943-b3f8-052e6277cb50",
                                        "entry_id": "90b69a1e-1ccd-3836-9e03-f0acdc2771d3",
                                        "glosses": [
                                            "The official language of Italy, also spoken in San Marino, the Vatican, and parts of Argentina, Slovenia and Switzerland."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc63d85c-3f6b-47a4-9bb0-adf300153ef1",
                                                "sense_id": "10ec9932-1a5e-3943-b3f8-052e6277cb50",
                                                "text": "In Occitan a stroll, una passejada, is close to the Italian passeggiata, and a reminder of what a public business it is to amble these streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06202029-327b-3624-b2ba-3713fbe64996",
                                        "entry_id": "90b69a1e-1ccd-3836-9e03-f0acdc2771d3",
                                        "glosses": [
                                            "A style of cuisine or individual dishes of or associated with Italy or Italian people."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1654b75-b867-4eef-ac59-32b0bb329be6",
                                                "sense_id": "06202029-327b-3624-b2ba-3713fbe64996",
                                                "text": "Simple Cannoli, Lemon Ice, or a delicious Tira Mi Su. With so many wonderful recipes, you can eat Italian anytime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce91e7f-33a2-3d6c-bef4-07370ddd9df7",
                                        "entry_id": "90b69a1e-1ccd-3836-9e03-f0acdc2771d3",
                                        "glosses": [
                                            "Ellipsis of Italian cloth."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a94433a0-ca00-3dde-9a71-326b117ffdbb",
                                        "entry_id": "90b69a1e-1ccd-3836-9e03-f0acdc2771d3",
                                        "glosses": [
                                            "Ellipsis of Italian vermouth, a dark-colored sweet or mildly bitter vermouth."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a181333e-c4d2-48b5-b2bc-707d3939ea41",
                                                "sense_id": "a94433a0-ca00-3dde-9a71-326b117ffdbb",
                                                "text": "gin and Italian"
                                            },
                                            {
                                                "example_id": "14c5f59b-81b3-4073-b8ce-df0539cd9ed4",
                                                "sense_id": "a94433a0-ca00-3dde-9a71-326b117ffdbb",
                                                "text": "So the English women would have been interested in American drinks, and in came the gin-and-Italian, for example."
