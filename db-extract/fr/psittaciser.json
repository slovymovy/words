                "senses": [
                    {
                        "sense_id": "94843f58-a2ca-3e07-937e-382d8af30aae",
                        "entry_id": "b3e48e09-cd02-34e7-8987-c8bb406d4de6",
                        "glosses": [
                            "Parler comme un perroquet, en répétant sans bien comprendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6242c720-1445-493f-88b7-70a46de97304",
                                "sense_id": "94843f58-a2ca-3e07-937e-382d8af30aae",
                                "text": "Employer des termes qu’on serait incapable de définir, et qu’on n’entend pas, alors qu’on les emploie bien, c’est psittaciser sans doute."
                            },
                            {
                                "example_id": "734c0ee9-290a-4aa2-bb82-bc97b808cd01",
                                "sense_id": "94843f58-a2ca-3e07-937e-382d8af30aae",
                                "text": "Le Français, avait-on coutume de « psittaciser » en deçà et au delà du Rhin ou des Alpes, n’est pas colonisateur."
                            }
                        ]
                    }
                ],
