                    "semantic_group_id": "elevation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par sa modestie et son dévouement, elle cherchait à <w>édifier</w> par son exemple ses proches."
                        },
                        {
                            "text": "Le discours du prêtre a profondément <w>édifié</w> les fidèles rassemblés pour la cérémonie."
