                ],
                "senses": [
                    {
                        "sense_id": "4d2ccd16-968d-318d-b35e-a641e90655a3",
                        "entry_id": "46d44e9c-724f-3637-905e-303ea79b8134",
                        "glosses": [
                            "An indigenous Australian, especially one from Queensland or northern New South Wales."
                        ],
                        "tags": [
                            "New-South-Wales"
                        ],
                        "examples": [
                            {
                                "example_id": "a38c1ecd-7a81-45ed-a887-25d8f759c243",
                                "sense_id": "4d2ccd16-968d-318d-b35e-a641e90655a3",
                                "text": "[O]n the veranda a fight started round the dart-board and two of the Murris threw punches until the barman thumped them apart."
                            },
                            {
                                "example_id": "75a96550-dd56-430a-8328-91213f3d7d32",
                                "sense_id": "4d2ccd16-968d-318d-b35e-a641e90655a3",
                                "text": "The local council wanted the Murries to live in town. (The council didn't care too much what the Murries themselves thought of this idea.)"
                            },
                            {
                                "example_id": "2b9eb208-789e-4fcd-8d74-185a1dc08b9a",
                                "sense_id": "4d2ccd16-968d-318d-b35e-a641e90655a3",
                                "text": "1998, Margaret Henderson, Subdivisions of Suburbia, Andrew McCann (editor), Writing the Everyday, Australian Literary Studies, Volume 18, No. 4, University of Queensland Press, page 78,\nShe can confidently walk through the mall, and make the politico-spatial connections between what she sees (Murries sitting and begging, crowds of Chinese-Australians, police lurking), what she has experienced in Eagleby (dispossessed whites, Murries unaware of their heritage), and what she has learnt from Roger, Kerry, and the 'Anyday Story'."
                            },
                            {
                                "example_id": "1c9ffcb9-8c92-46aa-b7b7-2d77043eaeee",
                                "sense_id": "4d2ccd16-968d-318d-b35e-a641e90655a3",
                                "text": "‘The Murris don't work to whitefeller schedules. That's not the way it is.’"
                            },
                            {
                                "example_id": "95c8e3a0-f2f6-4ad8-b336-0a9644fbb34e",
                                "sense_id": "4d2ccd16-968d-318d-b35e-a641e90655a3",
                                "text": "The immediate background to the event was several massacres, the killings of Murries at Teewah beach, and the \"clearing\" of the Dawson Valley where other Murries had been fighting a sort of guerilla^([sic]) war against the white invasion of the grasslands."
                            }
                        ]
                    }
