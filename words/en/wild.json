                            {
                                "target_lang_word": "куда попало",
                                "target_lang_sense_clarification": "не целясь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "681f0646-5819-328b-8ff9-d356e24fb2c9",
                    "sense_definition": "To act in an erratic, crazy, or unexpected way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>wilding</w> and just sit down so we can talk about this calmly.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>беситься</w>, просто сядь, и мы спокойно все обсудим."
                            }
                        },
                        {
                            "text": "The fans were <w>wilding</w> after the referee made that controversial call.",
                            "target_lang_translations": {
                                "ru": "Фанаты <w>неистовствовали</w> после того, как судья принял это спорное решение."
                            }
                        }
