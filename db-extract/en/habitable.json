                "senses": [
                    {
                        "sense_id": "ef44c388-dfa1-3ca4-be25-ddb173c681c2",
                        "entry_id": "04ea7668-f2b8-3aeb-a782-d264a833cf04",
                        "glosses": [
                            "Safe and comfortable, where humans, or other animals, can live; fit for habitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff644724-246f-419e-b759-9d35a931b268",
                                "sense_id": "ef44c388-dfa1-3ca4-be25-ddb173c681c2",
                                "text": "Humankind has never found any other habitable planets apart from Earth."
                            },
                            {
                                "example_id": "5d34d834-e178-4915-a934-cec4c37bd692",
                                "sense_id": "ef44c388-dfa1-3ca4-be25-ddb173c681c2",
                                "text": "After we found the freshwater spring we were more confident that the place was habitable."
                            },
                            {
                                "example_id": "cd1a2292-91b1-4af0-adc8-2e97cdeb9ed7",
                                "sense_id": "ef44c388-dfa1-3ca4-be25-ddb173c681c2",
                                "text": "Feros is a habitable world in the Attican Beta cluster. Two-thirds of the habitable surface is covered with the ruins of a crumbling Prothean megatropolis."
                            }
                        ]
                    },
                    {
                        "sense_id": "58529a8d-a269-3ca1-97e9-0f7ded57b297",
                        "entry_id": "04ea7668-f2b8-3aeb-a782-d264a833cf04",
                        "glosses": [
                            "Of an astronomical object: capable of supporting, or giving rise to, life."
                        ],
                        "tags": [],
                        "examples": []
                    }
