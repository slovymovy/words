                    {
                        "translation_id": "09bf158d-e9db-466e-a386-5a5070ce750e",
                        "source_entry_id": "756bc8d1-8393-3798-9fe4-556322d4f7ec",
                        "source_sense_id": "b848d78b-0713-3684-94f5-adba5ab30564",
                        "source_sense_description": "een continent dat ten zuiden van Noord-Amerika ligt, tussen de Grote en de Atlantische Oceaan",
                        "target_lang_word": "Südamerika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Südamerika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9b7100-395e-3d90-898d-9962bef87364",
                                        "entry_id": "b939b3f1-c98e-378c-a97e-a4d39dcc0a36",
                                        "glosses": [
                                            "Kontinent, südlicher Teil des Doppelkontinents Amerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecff250b-ecb8-4771-839c-be0716ad474c",
                                                "sense_id": "6b9b7100-395e-3d90-898d-9962bef87364",
                                                "text": "Bolivien liegt in Südamerika."
                                            },
                                            {
                                                "example_id": "ea22a056-ee36-40da-8f98-7014fb326232",
                                                "sense_id": "6b9b7100-395e-3d90-898d-9962bef87364",
                                                "text": "Französisch-Guayana gehört trotz seiner Lage in Südamerika zu Frankreich."
                                            },
                                            {
                                                "example_id": "d1ea9908-0416-4963-9ea3-a050beb3a60e",
                                                "sense_id": "6b9b7100-395e-3d90-898d-9962bef87364",
                                                "text": "„Boyacá war bis 1863 ein Teil von Kolumbien gewesen, das als erste konstitutionelle Republik Südamerikas bereits 1821 gegründet worden war.“"
                                            },
                                            {
                                                "example_id": "fc0724f2-043b-43c7-9c6e-bac0c5e7aaad",
                                                "sense_id": "6b9b7100-395e-3d90-898d-9962bef87364",
                                                "text": "„Die Tabakpflanze, die in Süd- und Mittelamerika bereits vor unserer Zeitrechnung angepflanzt und zu religiösen sowie medizinischen Zwecken verwendet wurde, kam durch die spanischen Eroberer nach Europa.“"
                                            },
                                            {
                                                "example_id": "cbfbb5e8-58b4-414e-8f5f-7be40b4c8d5f",
                                                "sense_id": "6b9b7100-395e-3d90-898d-9962bef87364",
                                                "text": "„Die amerikanische Unterstützung der Militärjuntas in Südamerika war Imperialismus, weil wir damit zu unserem Vorteil die Ausbreitung des Kommunismus verhindern wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "094d1b31-485c-426d-9a14-533161eba2c7",
                        "source_entry_id": "756bc8d1-8393-3798-9fe4-556322d4f7ec",
