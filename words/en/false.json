    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9cef1d8f-a6ee-3a3e-bbd1-cacf285f77a2",
                    "sense_definition": "Not true or correct; not based on facts.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "incorrectness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness gave a <w>false</w> statement to the police during the investigation.",
                            "target_lang_translations": {
                                "ru": "Свидетель дал <w>ложные</w> показания полиции во время расследования.",
                                "zh": "证人在调查期间向警方提供了<w>虚假</w>陈述。"
                            }
                        },
                        {
                            "text": "It is a <w>false</w> assumption to think that everyone likes chocolate.",
                            "target_lang_translations": {
                                "ru": "Это <w>ошибочное</w> предположение — думать, что все любят шоколад.",
                                "zh": "认为每个人都喜欢巧克力是一个<w>错误</w>的假设。"
                            }
                        }
                    ],
                    "antonyms": [
                        "true",
                        "real"
                    ],
                    "common_phrases": [
                        "false assumption",
                        "false statement",
                        "false information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не соответствующий истине или фактам; неправильный.",
                        "zh": "不符合事实或真理的；错误的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "не соответствующий действительности"
                            },
                            {
                                "target_lang_word": "неправильный",
                                "target_lang_sense_clarification": "ошибочный"
                            },
                            {
                                "target_lang_word": "неверный",
                                "target_lang_sense_clarification": "не соответствующий истине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错误的",
                                "target_lang_sense_clarification": "不正确，不符合事实"
                            },
                            {
                                "target_lang_word": "虚假的",
                                "target_lang_sense_clarification": "不真实，伪造的"
                            },
                            {
                                "target_lang_word": "不实的",
                                "target_lang_sense_clarification": "与事实不符"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6a1cc89-27fa-398d-b1bc-5f8adcf80a43",
                    "sense_definition": "Not natural or real; artificial or fake.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "artificiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly man had to get <w>false</w> teeth after his accident.",
                            "target_lang_translations": {
                                "ru": "Пожилому мужчине пришлось вставить <w>искусственные</w> зубы после аварии.",
                                "zh": "那位老人在事故后不得不装上<w>假</w>牙。"
                            }
                        },
                        {
                            "text": "She wore <w>false</w> eyelashes to the party to make her eyes look bigger.",
                            "target_lang_translations": {
                                "ru": "Она наклеила <w>накладные</w> ресницы на вечеринку, чтобы глаза казались больше.",
                                "zh": "她戴了<w>假</w>睫毛去参加聚会，让眼睛看起来更大。"
                            }
                        }
                    ],
                    "antonyms": [
                        "real",
                        "true"
                    ],
                    "common_phrases": [
                        "false teeth",
                        "false eyelashes",
                        "false floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не натуральный или не настоящий; искусственный или поддельный.",
                        "zh": "非天然或非真实的；人造的或伪造的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусственный",
                                "target_lang_sense_clarification": "сделанный человеком, не природный"
                            },
                            {
                                "target_lang_word": "вставной",
                                "target_lang_sense_clarification": "о зубах"
                            },
                            {
                                "target_lang_word": "накладной",
                                "target_lang_sense_clarification": "о ресницах, волосах"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "поддельный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "假",
                                "target_lang_sense_clarification": "非真实的，人造的"
                            },
                            {
                                "target_lang_word": "人造的",
                                "target_lang_sense_clarification": "人工制造的"
                            },
                            {
                                "target_lang_word": "伪造的",
                                "target_lang_sense_clarification": "冒充真品的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "857414e9-c804-345b-8cab-01dfcc017c65",
                    "sense_definition": "Intentionally deceitful or dishonest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of being a <w>false</w> witness in the court case.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он был <w>лжесвидетелем</w> в судебном деле.",
                                "zh": "他被指控在法庭案件中作<w>伪</w>证。"
                            }
                        },
                        {
                            "text": "The company made <w>false</w> promises about the benefits of their new product.",
                            "target_lang_translations": {
                                "ru": "Компания давала <w>лживые</w> обещания о преимуществах своего нового продукта.",
                                "zh": "该公司对新产品的功效做出了<w>虚假</w>承诺。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "false witness",
                        "false promises",
                        "false advertising"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно вводящий в заблуждение или нечестный.",
                        "zh": "蓄意欺骗或不诚实的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лживый",
                                "target_lang_sense_clarification": "склонный ко лжи"
                            },
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "намеренно искаженный"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "неискренний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚伪的",
                                "target_lang_sense_clarification": "不真诚，欺骗性的"
                            },
                            {
                                "target_lang_word": "欺诈的",
                                "target_lang_sense_clarification": "带有欺骗意图的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2e9affc-fe70-39b3-97d0-c49a6492c77e",
                    "sense_definition": "Not loyal or faithful; treacherous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disloyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He turned out to be a <w>false</w> friend who shared all my secrets.",
                            "target_lang_translations": {
                                "ru": "Он оказался <w>ложным</w> другом, который разболтал все мои секреты.",
                                "zh": "他原来是个<w>虚伪</w>的朋友，把我的秘密全说了出去。"
                            }
                        },
                        {
                            "text": "She felt betrayed when her partner proved <w>false</w> to their vows.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала себя преданной, когда её партнер <w>нарушил</w> их клятвы.",
                                "zh": "当她的伴侣<w>背叛</w>了他们的誓言时，她感到被出卖了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "false friend",
                        "prove false"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in literary or dramatic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не преданный или не верный; вероломный.",
                        "zh": "不忠诚或不守信的；背信弃义的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неверный",
                                "target_lang_sense_clarification": "предательский"
                            },
                            {
                                "target_lang_word": "вероломный",
                                "target_lang_sense_clarification": "нарушающий обязательства"
                            },
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "притворный (о друге)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不忠的",
                                "target_lang_sense_clarification": "背叛的"
                            },
                            {
                                "target_lang_word": "背信弃义的",
                                "target_lang_sense_clarification": "违背诺言的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8527bef4-224a-304f-86ec-c1baa4a3c747",
                    "sense_definition": "Relating to a logic state that represents a negative or zero result.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function returns <w>false</w> if the user is not logged into the system.",
                            "target_lang_translations": {
                                "ru": "Функция возвращает <w>ложь</w>, если пользователь не вошел в систему.",
                                "zh": "如果用户未登录系统，该函数将返回<w>假</w>。"
                            }
                        },
                        {
                            "text": "In Boolean logic, the opposite of true is <w>false</w>.",
                            "target_lang_translations": {
                                "ru": "В булевой логике противоположностью истины является <w>ложь</w>.",
                                "zh": "在布尔逻辑中，真的反面是<w>假</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "true"
                    ],
                    "common_phrases": [
                        "true or false",
                        "false value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к логическому состоянию, представляющему отрицательный или нулевой результат.",
                        "zh": "指逻辑状态中代表否定或零的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложь",
                                "target_lang_sense_clarification": "логическое значение"
                            },
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "о логическом значении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "假",
                                "target_lang_sense_clarification": "逻辑值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f54dd454-5a7c-3e9c-808d-417026ff3f6f",
                    "sense_definition": "Used in biological names for species that resemble another species but are not closely related.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taxonomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>false</w> killer whale is actually a large species of oceanic dolphin.",
                            "target_lang_translations": {
                                "ru": "<w>Малая</w> косатка на самом деле является крупным видом океанических дельфинов.",
                                "zh": "<w>伪</w>虎鲸实际上是一种大型海洋海豚。"
                            }
                        },
                        {
                            "text": "Gardeners should be careful not to confuse the <w>false</w> acacia with the real one.",
                            "target_lang_translations": {
                                "ru": "Садоводам следует быть осторожными, чтобы не перепутать <w>лжеакацию</w> с настоящей.",
                                "zh": "园丁们应小心，不要把<w>假</w>刺槐和真刺槐弄混了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "false killer whale",
                        "false acacia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в биологических названиях видов, которые напоминают другой вид, но не являются близкородственными.",
                        "zh": "用于生物名称中，指外形相似但亲缘关系较远的物种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "в биологической классификации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "假",
                                "target_lang_sense_clarification": "生物分类学前缀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "715d93a0-baf5-3d83-a4ce-f5585e38b57c",
                    "sense_definition": "Musically out of tune or incorrect in pitch.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer hit a <w>false</w> note during the climax of the opera.",
                            "target_lang_translations": {
                                "ru": "Певец взял <w>фальшивую</w> ноту во время кульминации оперы.",
                                "zh": "歌手在歌剧高潮时唱出了一个<w>走调</w>的音符。"
                            }
                        },
                        {
                            "text": "The piano sounded <w>false</w> because it had not been tuned in years.",
                            "target_lang_translations": {
                                "ru": "Пианино звучало <w>фальшиво</w>, потому что его не настраивали много лет.",
                                "zh": "钢琴听起来<w>音不准</w>，因为它已经好几年没调音了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "false note"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкально расстроенный или неверный по высоте звука.",
                        "zh": "音乐上音准不正确或走调的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "немузыкальный, не в тон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走调的",
                                "target_lang_sense_clarification": "音准不对"
                            },
                            {
                                "target_lang_word": "不准的",
                                "target_lang_sense_clarification": "音高错误的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6773d9ff-e934-34ec-9767-23412054fa24",
                    "sense_definition": "An answer or option in a test that indicates a statement is incorrect.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "testing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student marked a <w>false</w> for the third question on the exam.",
                            "target_lang_translations": {
                                "ru": "Студент отметил <w>«ложь»</w> в третьем вопросе на экзамене.",
                                "zh": "学生在考试的第三题上标记了<w>错误</w>。"
                            }
                        },
                        {
                            "text": "You need to decide between a true and a <w>false</w> for each sentence.",
                            "target_lang_translations": {
                                "ru": "Вам нужно выбрать между «истиной» и <w>«ложью»</w> для каждого предложения.",
                                "zh": "你需要为每个句子判断是对还是<w>错</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "true and false"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответ или вариант в тесте, указывающий на то, что утверждение неверно.",
                        "zh": "考试中表示陈述不正确的选项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложь",
                                "target_lang_sense_clarification": "вариант ответа в тесте"
                            },
                            {
                                "target_lang_word": "неверно",
                                "target_lang_sense_clarification": "отметка о неправильности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错误",
                                "target_lang_sense_clarification": "判断题选项"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e919802f-0b75-3daf-8812-3223eec2727b",
                    "sense_definition": "To perform a start in a race before the official signal is given.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sprinter was disqualified after he <w>falsed</w> his start for the second time.",
                            "target_lang_translations": {
                                "ru": "Спринтер был дисквалифицирован после того, как во второй раз совершил <w>фальстарт</w>.",
                                "zh": "那位短跑运动员因第二次<w>抢跑</w>而被取消了比赛资格。"
                            }
                        },
                        {
                            "text": "It is rare to see a professional athlete who <w>falses</w> during such a major event.",
                            "target_lang_translations": {
                                "ru": "Редко можно увидеть профессионального атлета, который делает <w>фальстарт</w> на таком крупном мероприятии.",
                                "zh": "在如此重大的赛事中，很少见到职业运动员<w>抢跑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "falsed the start"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить старт в гонке до официального сигнала.",
                        "zh": "在比赛中于正式信号发出前起跑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать фальстарт",
                                "target_lang_sense_clarification": "начать движение раньше времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抢跑",
                                "target_lang_sense_clarification": "违规提前起跑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "783d7711-2196-3988-aeb4-b826dcaf323e",
                    "sense_definition": "To betray or violate a promise or agreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "betrayal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>false</w> his faith to the king in exchange for gold.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>предать</w> свою верность королю в обмен на золото.",
                                "zh": "他选择为了黄金而<w>背叛</w>对国王的忠诚。"
                            }
                        },
                        {
                            "text": "To <w>false</w> a solemn oath was considered a grave sin in those times.",
                            "target_lang_translations": {
                                "ru": "<w>Нарушение</w> торжественной клятвы считалось в те времена тяжким грехом.",
                                "zh": "在那个时代，<w>违背</w>庄严的誓言被视为重罪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "false his faith"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предать или нарушить обещание или соглашение.",
                        "zh": "背叛或违背诺言、协议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "нарушать верность"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "о клятве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背叛",
                                "target_lang_sense_clarification": "违背忠诚"
                            },
                            {
                                "target_lang_word": "违背",
                                "target_lang_sense_clarification": "不遵守誓言"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5ccfecbc-82a4-3a81-a9d5-d826e0b11309",
                    "sense_definition": "In a dishonest, treacherous, or disloyal manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
