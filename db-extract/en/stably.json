                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                        "entry_id": "50fc11dd-2d0f-3602-880f-18c1f3b170ee",
                                        "glosses": [
                                            "belastungsfähig, standhaft, (von Werten) ständig, gleichbleibend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06197148-36a6-468b-be7d-f9889725e28e",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "„Ich habe mir diesen stabilen Hammer gekauft, der wird lange halten.“"
                                            },
                                            {
                                                "example_id": "21b9d190-4d0f-4f05-a66f-9fecba0ec9f0",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "Der Bereitschaftsarzt wurde gerufen, und zu dem Zeitpunkt war der Patient noch relativ stabil."
                                            },
                                            {
                                                "example_id": "1a5d309e-0fdb-404f-83db-698d5bf0f227",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "Der Euro zeigt einen stabilen Aufwärtstrend."
                                            },
                                            {
                                                "example_id": "057b6001-ac45-4a31-8f3c-77e83f3a02e2",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "Für die Kneipentür brauchen wir einen stabilen Griff."
                                            },
                                            {
                                                "example_id": "d99932fb-7c79-4141-944c-00f7e5fd3bff",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "Viele Menschen hatten Angst davor, dass die stabile D-Mark durch eine Währung ersetzt werden könnte, die hohe Inflationsraten nach sich zieht."
                                            },
                                            {
                                                "example_id": "cecf8c1e-7d05-45f7-9780-87d6ce6d8dfe",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "Die US-Ratingagentur Fitch hat […] ihren Ausblick für die Deutsche Bank von \"stabil\" auf \"negativ\" gesenkt."
                                            },
                                            {
                                                "example_id": "9fd2c3ad-2732-4443-9d5b-3bb9974f03f1",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "Saubere Energie aus Wind und Sonne steht bereit, den Kohlestrom zu ersetzen. Die technischen Anforderungen, aus schwankender Einspeisung eine stabile Stromversorgung zu machen, sind lösbar […]"
                                            },
                                            {
                                                "example_id": "8b081788-f917-4189-a899-2b40516ed7ec",
                                                "sense_id": "a6ed2248-7286-35bd-a894-f873ab0e4d53",
                                                "text": "Europa hat ein fundamentales Interesse an einer stabilen und weltoffenen Türkei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
