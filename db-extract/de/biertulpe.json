                "senses": [
                    {
                        "sense_id": "f357ab5e-3a4b-3518-a0b9-7c28bacc76bb",
                        "entry_id": "67df08bc-22f2-31b2-87ba-7cd308006144",
                        "glosses": [
                            "Stielglas, dessen Form der einer Tulpenblüte ähnelt und aus dem insbesondere Bier (Pils), Wein oder Sekt getrunken wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e35497-42cb-4b6f-8508-a5a57945760d",
                                "sense_id": "f357ab5e-3a4b-3518-a0b9-7c28bacc76bb",
                                "text": "„Aber Eric stieß eine Biertulpe um, die laut klirrend auf dem gläsernen Couchtisch zerbrach.“"
                            },
                            {
                                "example_id": "4b437eb2-b82a-445c-bbd1-e510bd54a4ae",
                                "sense_id": "f357ab5e-3a4b-3518-a0b9-7c28bacc76bb",
                                "text": "„Jetzt mache ich mir ein Glas Sekt und zwar schenke ich ihn in eine Biertulpe ein.“"
                            },
                            {
                                "example_id": "5d1203b6-fbc4-4ba6-abf8-7be290abd513",
                                "sense_id": "f357ab5e-3a4b-3518-a0b9-7c28bacc76bb",
                                "text": "„Diese Gläser gleichen einer Miniaturvariante der klassischen Biertulpen, sind unten bauchig und laufen oben flach zu.“"
                            },
                            {
                                "example_id": "84d820b4-fcf4-44c2-a619-6c562aeffce4",
                                "sense_id": "f357ab5e-3a4b-3518-a0b9-7c28bacc76bb",
                                "text": "„Die Gastwirtin betätigte den Zapfhahn, nachdem sie eine kleine Biertulpe darunter gestellt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
