                ],
                "senses": [
                    {
                        "sense_id": "14401ecf-f2b1-3d6c-86a7-0d94e8870ebc",
                        "entry_id": "f36f749a-ada7-32f9-b68b-244d3a5c5fbb",
                        "glosses": [
                            "Étui à lunettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2703e0ec-75d5-42b3-bc1d-0dfbfd666661",
                                "sense_id": "14401ecf-f2b1-3d6c-86a7-0d94e8870ebc",
                                "text": "Ein Antrag wurde laut dem Kurznachrichtendienst Twitter beispielsweise von einem Industriellen eingereicht, der unter anderem Waagen, Feuerlöscher und Brillenetuis\" herstellt.",
                                "translation": "Selon le service de messages courts Twitter, une proposition a été faite par un industriel fabricant entre autres des échelles, des extincteurs et des étuis à lunettes."
                            },
                            {
                                "example_id": "99f7c3d0-c4de-402d-9721-2e8ff40678ae",
                                "sense_id": "14401ecf-f2b1-3d6c-86a7-0d94e8870ebc",
                                "text": "Der \"Tele-Art Fax Sender\", nicht größer als ein flaches Brillenetui, funktioniert an fast allen Fernsprechern, ohne daß ein spezieller Anschluß erforderlich wäre.",
                                "translation": "L’émetteur de fax, qui n’est pas plus grand qu’un étui à lunettes plat, fonctionne sur presque tous les téléphones, sans lesquels une connexion spéciale serait nécessaire."
                            }
                        ]
                    }
                ],
