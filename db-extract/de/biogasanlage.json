                "senses": [
                    {
                        "sense_id": "579ccf2c-d092-32f0-996f-742f336071aa",
                        "entry_id": "dc9c607d-3d70-3ba7-8180-bf5e2d6502d5",
                        "glosses": [
                            "technische Einrichtung zur Biogaserzeugung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4cbe1f-adc1-4e77-b588-c68051aebf5e",
                                "sense_id": "579ccf2c-d092-32f0-996f-742f336071aa",
                                "text": "„Eine Biogasanlage stellt ein Kreislaufsystem dar.“"
                            },
                            {
                                "example_id": "007e1f38-592c-4542-8bf6-a41921bb217d",
                                "sense_id": "579ccf2c-d092-32f0-996f-742f336071aa",
                                "text": "„Anfang Juni 2013 ging am Standort Ruhleben die neue Biogasanlage der BSR in Betrieb.“"
                            },
                            {
                                "example_id": "4d3fc004-1f86-43d6-ba78-807ae6bd62d6",
                                "sense_id": "579ccf2c-d092-32f0-996f-742f336071aa",
                                "text": "„Die Reste aus den 630 Biogasanlagen entsprechen dem Mist von zusätzlich 150.000 Kühen – ein Viertel des gesamten Gülle-Aufkommens in Deutschland.“"
                            },
                            {
                                "example_id": "4184d8e0-a58b-4839-96ca-75b11d8a56a9",
                                "sense_id": "579ccf2c-d092-32f0-996f-742f336071aa",
                                "text": "„Abhängig von Ihrer Größe können Biogasanlagen in die Zuständigkeit des Bauamts, der Unteren Immissionsschutzbehörde (UIB) bei der Kreisverwaltung oder der Bezirksregierung fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
