                "senses": [
                    {
                        "sense_id": "d232ee2c-1dea-3dda-ad00-bce725315f20",
                        "entry_id": "3bfa18be-5c2a-3247-9905-52c75a65eaac",
                        "glosses": [
                            "all, one and all, all together"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "35cb7af9-f233-477e-844a-1a7afd69539a",
                                "sense_id": "d232ee2c-1dea-3dda-ad00-bce725315f20",
                                "text": "1912, Martin Luther, Lutherbibel von 1912, Galatians 3:28 (with KJV translation)",
                                "translation": "There is neither Jew nor Greek, there is neither bond nor free, there is neither male nor female: for ye are all one in Christ Jesus.",
                                "english": "There is neither Jew nor Greek, there is neither bond nor free, there is neither male nor female: for ye are all one in Christ Jesus."
                            },
                            {
                                "example_id": "fb990656-ff02-44f9-a585-54aff7fa2a39",
                                "sense_id": "d232ee2c-1dea-3dda-ad00-bce725315f20",
                                "text": "Wahrlich vermisst wird Achilleus hinfort von den Söhnen Achaias\nAllzumal; dann suchst du umsonst, wie sehr du dich härmest,\nRettung, wenn sie in Scharen, vom männermordenden Hector",
                                "translation": "Surely some day a longing for Achilles will come upon the sons of the Achaeans\none and all, and on that day you will not be able to help them at all, for all your grief,\nwhen many shall fall dying before man-slaying Hector.",
                                "english": "Surely some day a longing for Achilles will come upon the sons of the Achaeans\none and all, and on that day you will not be able to help them at all, for all your grief,\nwhen many shall fall dying before man-slaying Hector."
                            },
                            {
                                "example_id": "2727a613-7cfc-4e9e-88c4-eb497e4061b5",
                                "sense_id": "d232ee2c-1dea-3dda-ad00-bce725315f20",
                                "text": "1860, A. v. Winterfeld, Wenn ros'ger Mai mit Blumen naht. A loose translation, into German, of the song \"The gard'ner wi' his paidle\", written by Robert Burns.\nLiebhaber sind die Vöglein all',\nDie Blumen grüßen allzumal,\nDen Gärtner mit der Hacke.\nUnd wenn der Morgensonne Strahl,\nDas Häschen stört bei'm frühen Mahl,",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "4b4b11ef-52ab-48cf-b23a-977979e6b405",
                                "sense_id": "d232ee2c-1dea-3dda-ad00-bce725315f20",
                                "text": "Ihr Brüder allzumal,\nHeut' seht ihr mich zum letztenmal;\nDer Hirtenbub ist nur Schuld daran,\nDas Alphorn hat mir solches angetan,",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    },
