                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "455f23e6-c517-4b64-a910-c5b9dd7619d1",
                        "source_entry_id": "1e8fb440-4117-3be6-bf10-95d84271135c",
                        "source_sense_id": "af0daab9-4239-3643-bfd7-08ff9425fa20",
                        "target_lang_word": "Biotechnik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biotechnik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "665f6eb1-8f78-3b2e-a22a-d1669345997c",
                                        "entry_id": "de6d210b-0422-3a88-b46f-cab19d81e0a1",
                                        "glosses": [
                                            "die technische Nutzbarmachung biologischer Vorgänge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0868d001-0cd2-4336-803e-5e260dd81885",
                                                "sense_id": "665f6eb1-8f78-3b2e-a22a-d1669345997c",
                                                "text": "Die Biotechnik gewinnt in der Nahrungsmittelproduktion heutzutage einen immer größeren Einfluss."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1a9e80-b907-4385-b0cc-a52e9ece45a1",
                        "source_entry_id": "1e8fb440-4117-3be6-bf10-95d84271135c",
                        "source_sense_id": "af0daab9-4239-3643-bfd7-08ff9425fa20",
                        "target_lang_word": "Biotechnologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biotechnologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e71e36b-e6c7-3163-9560-20c540573595",
                                        "entry_id": "d3493342-328a-39ed-837f-4bad14126ad6",
                                        "glosses": [
                                            "Wissenschaft des technischen Einsatzes von Mikroorganismen, pflanzlichen oder tierischen Zellkulturen oder Enzymen zur Produktgewinnung oder zum Stoffabbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cebf665-7d30-40f4-aa2a-af98500a2aa6",
                                                "sense_id": "3e71e36b-e6c7-3163-9560-20c540573595",
                                                "text": "Mittels der modernen Methoden der Biotechnologie werden heute vielerlei Arzneistoffe gewonnen."
                                            },
                                            {
                                                "example_id": "56d2168f-c7b8-48c6-99e7-a2ebef748770",
                                                "sense_id": "3e71e36b-e6c7-3163-9560-20c540573595",
                                                "text": "Die meisten Biotech-Unternehmen sind in der medizinischen Biotechnologie aktiv."
                                            },
                                            {
                                                "example_id": "c02ac6c4-3441-4a86-a51c-f7e52de2500b",
                                                "sense_id": "3e71e36b-e6c7-3163-9560-20c540573595",
                                                "text": "„Im Bereich der industriellen Biotechnologie liegt ein Schwerpunkt auf umweltfreundlicheren Verfahren und Produkten, zum Beispiel durch Entwicklung von Biochemikalien, Ersatz von konventionellen Kunststoffen oder Einsatz von Enzymen und Mikroorganismen bei der Produktion oder zum Schadstoffabbau.“"
                                            },
                                            {
                                                "example_id": "83a7ffa5-2906-476c-b2e7-5053c2c72aab",
                                                "sense_id": "3e71e36b-e6c7-3163-9560-20c540573595",
                                                "text": "„Zu dieser Kollision wird es mit Sicherheit an der Nahtstelle zwischen Nanotechnologie, Biotechnologie und Computertechnologie kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
