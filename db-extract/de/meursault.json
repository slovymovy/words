                "senses": [
                    {
                        "sense_id": "a873503d-7d53-3477-9c7d-90cd8b328e35",
                        "entry_id": "4845ab8b-ddb4-3749-af00-aee2709c2c7f",
                        "glosses": [
                            "hochwertiger Weißwein der Rebsorte Chardonnay der burgundischen Appellation Meursault"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d58ee53-d333-4732-ab8c-9d7294403cf3",
                                "sense_id": "a873503d-7d53-3477-9c7d-90cd8b328e35",
                                "text": "„Zu magerem, gedünstetem oder gekochtem Süßwasserfisch passen recht gut ein fruchtiger, blumiger Wein aus Baden, Württemberg oder von der Mosel, ein Petit Chablis oder ein elsässischer Riesling. Karpfen oder Lachs verlangen vollere Weine, z.B. einen Frankenwein, Riesling, Wein aus dem Rheingau oder Rheinhessen, auch Wein aus der Rheinpfalz, einen Meursault oder Chassagne-Montrachet. Würzige und herbe Weine, wie weißen Burgunder oder Pfälzer Riesling, sollten Sie zu Salzwasserfischen anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
