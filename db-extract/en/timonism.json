                                "sense_id": "2c60858a-1e59-3668-b8a9-52e44a2bd553",
                                "text": "This most cruel betrayal led him to Timonism."
                            }
                        ]
                    },
                    {
                        "sense_id": "37ad1555-949b-3f3a-9268-908643a3d1bf",
                        "entry_id": "f220c515-c9b8-36c6-ac39-b5280aa2d3b7",
                        "glosses": [
                            "A bitter or cynical utterance or behavior, in the manner of Timon of Athens."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b4a83b4a-5413-4a94-9970-b72e10bf4605",
                                "sense_id": "37ad1555-949b-3f3a-9268-908643a3d1bf",
                                "text": "Pay no attention to his Timonisms, it's a pose."
