                                        "glosses": [
                                            "die für Hunde typischen stimmhaften Töne von sich geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248295d9-0c28-43b1-85e9-c77e2870f5c5",
                                                "sense_id": "bd0c885f-bbdd-38d7-b65a-68974ab3eaad",
                                                "text": "Der Spitz bellt bei jeder Gelegenheit. Einen Fuchs bellen zu hören, ist ein seltenes Erlebnis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2737c4a2-b769-394f-a0e5-51fd1d22095a",
                                        "entry_id": "e85338b5-c0bb-31c8-88f9-4e7221fbd428",
                                        "glosses": [
                                            "kurze, wütige Befehle ausstoßen"
                                        ],
                                        "tags": [
                                            "metaphorisch",
                                            "absprechend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c31155-b0d1-4dce-8fee-d16d2be708a4",
                                                "sense_id": "2737c4a2-b769-394f-a0e5-51fd1d22095a",
                                                "text": "„An der Gepäckausgabe standen Hafenarbeiter, bellten Kommandos, händigten Koffer und Säcke aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "766952bc-c219-38e7-ae29-db60622b1410",
                                        "entry_id": "e85338b5-c0bb-31c8-88f9-4e7221fbd428",
                                        "glosses": [
                                            "laut husten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5ccc62-753d-4401-b0b3-81802af53dbd",
                                                "sense_id": "766952bc-c219-38e7-ae29-db60622b1410",
                                                "text": "Plötzlich begann der Alte zu bellen, und wir wussten, dass es um unsre Nachtruhe geschehen war."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
