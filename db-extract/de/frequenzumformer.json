                "senses": [
                    {
                        "sense_id": "992dcb74-900b-3642-9eab-38af73c5b532",
                        "entry_id": "90836f36-9898-3172-a1e5-3b9051ede906",
                        "glosses": [
                            "rotierende elektrische Maschine, welche die auf der Eingangsseite anliegende elektrische Energie mit Netzfrequenz in eine Ausgangsspannung mit anderer Frequenz umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e0fcc1-177f-4aa8-9978-a040fe9f77c3",
                                "sense_id": "992dcb74-900b-3642-9eab-38af73c5b532",
                                "text": "„Bei Team-Industries ließ er bereits Mitte der siebziger Jahre 31 Frequenzumformer besorgen: hochempfindliche Geräte, die für die Stromversorgung der Uranzentrifugen gebraucht werden.“"
                            },
                            {
                                "example_id": "5df54d37-39b3-44ff-add3-1529f12f793f",
                                "sense_id": "992dcb74-900b-3642-9eab-38af73c5b532",
                                "text": "„Auf dem Kontinent wird aber mit der zunehmenden Bahnelektrisierung und der Speisung aus den großen Fernkraftübertragungsanlagen auch der Frequenzumformer mehr und mehr zur Anwendung kommen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
