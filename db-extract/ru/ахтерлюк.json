                    {
                        "translation_id": "6c6a90e9-c6ea-45f4-9d5c-e6c1ea739d89",
                        "source_entry_id": "727d46b2-f86c-30d1-995b-a802e0ca8e15",
                        "target_lang_word": "wine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                                        "entry_id": "8f99d96a-460d-37a3-80b3-137661af5cc3",
                                        "glosses": [
                                            "An alcoholic beverage made by fermenting grape juice, with an ABV ranging from 5.5–16%."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a88f9d89-f799-4533-b0f5-c8375a86b125",
                                                "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                                                "text": "Wine is usually stronger than beer."
                                            },
                                            {
                                                "example_id": "0d7ba53b-bf60-4177-abea-e68b225f6c48",
                                                "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                                                "text": "\"Wine improves with age but I improve with wine,\" she slurred as she slid gracefully beneath the table."
                                            },
                                            {
                                                "example_id": "62741beb-e811-4113-a2d8-c8a6ff5dca61",
                                                "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                                                "text": "And David's Lips are lock't; but in divine\nHigh piping Péhlevi, with \"Wine! Wine! Wine!\nRed Wine!\" — the Nightingale cries to the Rose\nThat yellow Cheek of her's to'incarnadine."
                                            },
                                            {
                                                "example_id": "02dd99df-0d79-4b2e-9dea-3a263414d231",
                                                "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                                                "text": "In Europe then [1925] we thought of wine as something as healthy and normal as food and also as a great giver of happiness and well being and delight. Drinking wine was not a snobbism nor a sign of sophistication nor a cult; it was as natural as eating and to me as necessary, and I would not have thought of eating a meal without drinking either wine or cider or beer."
                                            },
                                            {
                                                "example_id": "6d92d316-17c6-4ed6-b8d8-2b7e76b3ecff",
                                                "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                                                "text": "Admirers of Israel’s kosher and nonkosher wines need the 2007 edition of “Rogov’s Guide to Israeli Wines” (Toby Press, $19.95)."
                                            },
                                            {
                                                "example_id": "0b8ec79e-7542-4978-a215-b0be549bafbb",
                                                "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                                                "text": "The ancient Greek physician Hippocrates promoted wine for various purposes, including reducing fevers and dressing wounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5d24194-0da7-306c-9aac-cbcbe6222220",
                                        "entry_id": "8f99d96a-460d-37a3-80b3-137661af5cc3",
                                        "glosses": [
                                            "An alcoholic beverage made by fermenting other substances, producing a similar ABV."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7fb82a7-1350-44bf-a0cb-3610d1356365",
                                                "sense_id": "d5d24194-0da7-306c-9aac-cbcbe6222220",
                                                "text": "...dandelion wine, rice wine, plum wine..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1bf47b7-d5d5-30da-bc13-d19a05b3fcf1",
                                        "entry_id": "8f99d96a-460d-37a3-80b3-137661af5cc3",
                                        "glosses": [
                                            "A serving of wine."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb615e36-7c4c-4a07-97a4-ce2e9b256ecf",
                                                "sense_id": "a1bf47b7-d5d5-30da-bc13-d19a05b3fcf1",
                                                "text": "I'd like three beers and two wines, please. My friend will have the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e5218dc-b1ee-33eb-ad5a-6a63c1ed214e",
                                        "entry_id": "8f99d96a-460d-37a3-80b3-137661af5cc3",
                                        "glosses": [
                                            "The color of red wine, a deep reddish purple."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f169c7fd-5b54-3ebc-a896-ab09c32e69d4",
                                        "entry_id": "ea22a939-e853-38b3-9bee-33bf027a04f9",
                                        "glosses": [
                                            "To entertain (someone) with wine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a901a40-d63b-455f-8a04-7c106eec8e75",
                                                "sense_id": "f169c7fd-5b54-3ebc-a896-ab09c32e69d4",
                                                "text": "Neither Major Wadhams nor I is accustomed to being wined and dined by perfect strangers who do not even present themselves, but leave servants to do the honors, consequently to both of us our present situation smacks of romance and adventure;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b018b0d-9b38-343d-a7b9-a14d3a8367c2",
                                        "entry_id": "ea22a939-e853-38b3-9bee-33bf027a04f9",
                                        "glosses": [
                                            "To drink wine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "984f2195-3e05-4e06-be7c-5d1084f4b7a4",
                                                "sense_id": "7b018b0d-9b38-343d-a7b9-a14d3a8367c2",
                                                "text": "I rushed into my cabin, coffeed, wined, and went to bed sobbing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df771a6c-352b-35c8-bf37-ec602d6fe08f",
                                        "entry_id": "2a367ac5-d882-3220-a6ea-6357c547865b",
                                        "glosses": [
                                            "Wind."
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceea1abd-185a-48d4-9ae1-c2524193b279",
                                                "sense_id": "df771a6c-352b-35c8-bf37-ec602d6fe08f",
                                                "text": "Vor voices rawze upon tha wine"
                                            },
                                            {
                                                "example_id": "c86a7c5f-c8eb-4573-960e-7e0deb2602ec",
                                                "sense_id": "df771a6c-352b-35c8-bf37-ec602d6fe08f",
                                                "text": "Aw how sholl I tell o’m—vor âll pirty maidens / When I pass’d ’em look’d back—ther smill rawze on tha wine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7a10f07-6eb2-3d8f-845a-fb2cf9db412e",
                                        "entry_id": "597e4374-d98f-3c18-a584-c7f0bc6f05e4",
                                        "glosses": [
                                            "To perform a Jamaican dance, such as the Dutty Wine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "343897e8-a5bd-45e8-975a-824f166695aa",
                                                "sense_id": "f7a10f07-6eb2-3d8f-845a-fb2cf9db412e",
                                                "text": "Carolina come wine 'pon me / Oh watch how di gyal groove"
                                            },
                                            {
                                                "example_id": "b3c8831d-3302-4088-afa3-2ded00873f59",
                                                "sense_id": "f7a10f07-6eb2-3d8f-845a-fb2cf9db412e",
                                                "text": "Even when there are positive comments, as in the responses to “white boy wines to dancehall,” the origin of the white boy's ability to dance is attributed to skills derived from others: […]."
                                            }
                                        ]
