                        "form": "die Sprechgesänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00e77844-2e43-316b-8a4a-7881e71ea509",
                        "entry_id": "fb8e4c7c-6bd1-311b-9af6-83225823c943",
                        "glosses": [
                            "rhythmischer, dem Singen ähnlicher gesprochener, musikalischer Vortrag"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f5df10ac-8e99-4ced-bf42-12826f491a55",
                                "sense_id": "00e77844-2e43-316b-8a4a-7881e71ea509",
                                "text": "Sprechgesänge sind in vielen Musikrichtungen und religiösen Kontexten vertreten."
                            },
                            {
                                "example_id": "b84d04d9-03d0-4f88-b414-9f63247c8148",
                                "sense_id": "00e77844-2e43-316b-8a4a-7881e71ea509",
                                "text": "„Dazu intonierte ein Mann mit schriller Stimme einen rasenden Sprechgesang – fremd, eindringlich, fast hypnotisch.“"
                            },
                            {
                                "example_id": "c4318bc5-819e-4e81-9737-42dd6634daaf",
                                "sense_id": "00e77844-2e43-316b-8a4a-7881e71ea509",
                                "text": "„Jener Wisperton, der immer wiederkehrende raunende und kaum vernehmbare Sprechgesang, hat als Stilmittel zeitweilig seinen Reiz. Nur lotet die Stockholmerin weder im Studio noch auf der Bühne die Möglichkeiten ihres Organs aus.“"
                            },
                            {
                                "example_id": "c2f9b2ce-f1a3-45a5-a41d-7b093bba9546",
                                "sense_id": "00e77844-2e43-316b-8a4a-7881e71ea509",
                                "text": "„Der Sprechgesang ersetzt nach Meinung der Franzosen sowohl den griechischen Chor wie auch unser Rezitativ, das sie verachten, aber nicht verachten würden, wenn sie unsere Sprache verstünden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76104f0e-bfb7-492a-aaa9-0f5360e53867",
                        "source_entry_id": "fb8e4c7c-6bd1-311b-9af6-83225823c943",
                        "source_sense_id": "00e77844-2e43-316b-8a4a-7881e71ea509",
