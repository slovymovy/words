                "senses": [
                    {
                        "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                        "entry_id": "3537d508-1261-3872-b894-9f2f0c70772c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a8e6524-f189-4226-8bf3-c08054330890",
                                "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                                "text": "Herr Buchholz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2ed515e2-537d-4893-9c44-8f50c108ba55",
                                "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                                "text": "Die Buchholzens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "09490d2a-49f9-4818-9f9e-4a12f6c97345",
                                "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                                "text": "Frau Buchholz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "27a9789b-47ea-481c-ac8c-8b47dae8b7e7",
                                "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                                "text": "Der Buchholz trägt nie die Schals, die die Buchholz ihm strickt."
                            },
                            {
                                "example_id": "8fb353e6-8cd2-48c9-bdbe-af9c73e46c29",
                                "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buchholz kommt, geht der Herr Buchholz.“"
                            },
                            {
                                "example_id": "913e692b-9812-426c-beef-3b3a35320900",
                                "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                                "text": "Buchholz kommt und geht."
                            },
                            {
                                "example_id": "2ebf032c-777a-40f4-a455-3c8b706a6fb9",
                                "sense_id": "6c8ae00b-91e3-357f-a9a4-a8e71f601280",
                                "text": "Buchholz’ kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
