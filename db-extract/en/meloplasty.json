                    {
                        "sense_id": "b0bf0d2b-12eb-36df-81b9-a504400dcda4",
                        "entry_id": "9090bd4c-68c9-35ab-a3c7-e0271ef1a3b1",
                        "glosses": [
                            "The operation of restoring or repairing a cheek which has been wholly or partially destroyed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc7aed87-e67e-4cdd-ac65-60a3f2e9c267",
                                "sense_id": "b0bf0d2b-12eb-36df-81b9-a504400dcda4",
                                "text": "Acquired macrostoma, from defects following noma, for instance, is remedied according to the rules for cheiloplasty (see § 31) or meloplasty (see § 33) ."
                            }
                        ]
                    },
                    {
                        "sense_id": "78ab917b-3c51-31cb-8af4-c715a3da8664",
                        "entry_id": "9090bd4c-68c9-35ab-a3c7-e0271ef1a3b1",
                        "glosses": [
                            "The surgical lifting and repositioning the tissues in the cheeks and lower eyelids to create a more youthful appearance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14adba4e-216f-4e8c-a2b6-1889200dc8bd",
                                "sense_id": "78ab917b-3c51-31cb-8af4-c715a3da8664",
                                "text": "In secondary meloplasty, it is presumed that the patient is several years older than at the time of the primary meloplasty, at least for the routine secondary procedures."
                            },
                            {
                                "example_id": "32b350d1-5591-4191-b4a4-41249db13d13",
                                "sense_id": "78ab917b-3c51-31cb-8af4-c715a3da8664",
                                "text": "When the original face-lift has been performed and it pulls down on the earlobe, a tight, tapered lobe often follows. It is unsightly and makes difficult a secondary meloplasty without an obvious scar below the lobe."
                            }
                        ]
                    }
                ],
