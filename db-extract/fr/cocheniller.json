                        "sense_id": "330d6773-11f5-3108-b7d0-f09532521b8b",
                        "entry_id": "8b4c64cd-2f98-3c75-94b8-3cb1909f4b83",
                        "glosses": [
                            "Récolter la cochenille."
                        ],
