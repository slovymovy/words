                                "target_senses": [
                                    {
                                        "sense_id": "6c52cc6a-cc6b-31d8-b6f4-a1d2b06d8a5a",
                                        "entry_id": "58175795-14fd-3875-bee2-604946b41554",
                                        "glosses": [
                                            "bezeichnet die Identität mit einem vorausgegangenen oder bekannten Ding im Gegensatz zu einem anderen Ding derselben Art, für das \\\"der gleiche\\\" zu verwenden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b57d1cd-bdaf-422e-91bf-9fd4585a9a0c",
                                                "sense_id": "6c52cc6a-cc6b-31d8-b6f4-a1d2b06d8a5a",
                                                "text": "Es ist genau derselbe Mann, den wir vorhin schon einmal gesehen haben."
                                            },
                                            {
                                                "example_id": "98a4a50e-b5b5-4efa-8b0a-784f9a429afe",
                                                "sense_id": "6c52cc6a-cc6b-31d8-b6f4-a1d2b06d8a5a",
                                                "text": "Es ist genau dieselbe Frau, die wir vorhin schon einmal gesehen haben."
                                            },
                                            {
                                                "example_id": "eac60c0c-a6a6-4859-9d53-6cb0204e44b0",
                                                "sense_id": "6c52cc6a-cc6b-31d8-b6f4-a1d2b06d8a5a",
                                                "text": "Ein Freund von mir besitzt den gleichen Regenschirm wie ich. Mein Lebenspartner verwendet denselben Regenschirm wie ich, da wir zusammen nur einen einzigen besitzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "128273b8-ccd9-3674-9518-62c55ef7b89f",
                                        "entry_id": "58175795-14fd-3875-bee2-604946b41554",
                                        "glosses": [
                                            "weist substantivisch auf ein vorausgegangenes Ding zurück und steht statt \\\"er\\\", \\\"sein\\\" oder \\\"dieser\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eef4017-036a-46f2-af28-708a121187b3",
                                                "sense_id": "128273b8-ccd9-3674-9518-62c55ef7b89f",
                                                "text": "Da wir in unserer Wohngemeinschaft nur eine einzige Waschmaschine besitzen, verwenden mein Mitbewohner und ich dieselbe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
