                                "target_senses": [
                                    {
                                        "sense_id": "1efb2f8b-b95e-3bd2-aade-fca052d3a114",
                                        "entry_id": "bd78ef8f-9154-3597-9b9d-2d4affe67d7d",
                                        "glosses": [
                                            "Technique ayant pour objet l’exécution, l’exploitation et le contrôle des observations concernant l’identification, la position planimétrique et altimétrique, la forme et les dimensions des éléments concrets, fixes et durables existant à la surface du sol à un moment donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db56f5a-a52e-456f-adf9-4993aa3cff0b",
                                                "sense_id": "1efb2f8b-b95e-3bd2-aade-fca052d3a114",
                                                "text": "La topographie nécessite l’emploi d’outils tels que le niveau de chantier, le théodolite ou le tachéomètre qui permettent de mesurer les angles horizontaux et verticaux, ainsi que les distances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1186a66b-655f-3e30-8e4b-a8604554615b",
                                        "entry_id": "bd78ef8f-9154-3597-9b9d-2d4affe67d7d",
                                        "glosses": [
                                            "Représentation graphique d'un terrain, d'une portion de territoire, avec l’indication de son relief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b860f3-a47f-4869-b2e5-36b19e5c4933",
                                                "sense_id": "1186a66b-655f-3e30-8e4b-a8604554615b",
                                                "text": "Cette carte avec les courbes de niveau permet de visualiser la topographie du terrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae1f9fd-7ee0-3e04-ac64-b6d060625312",
                                        "entry_id": "bd78ef8f-9154-3597-9b9d-2d4affe67d7d",
                                        "glosses": [
                                            "Forme et relief du terrain."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03788aa9-0233-4e37-b63c-8d7728d49432",
                                                "sense_id": "bae1f9fd-7ee0-3e04-ac64-b6d060625312",
                                                "text": "Tout en rêvant, elle jetait les yeux autour d’elle et classait dans sa tête la topographie du jardin."
                                            },
                                            {
                                                "example_id": "52297b51-dbb0-4851-ae1e-2645603cd3f8",
                                                "sense_id": "bae1f9fd-7ee0-3e04-ac64-b6d060625312",
                                                "text": "Si la topographie l’exige, le préfet peut imposer sur certaines voies l’obligation de munir tout véhicule d’un frein ou d’un dispositif d’enrayage."
                                            },
                                            {
                                                "example_id": "b4a3d558-c5d4-43e6-aa7c-3c68578b379e",
                                                "sense_id": "bae1f9fd-7ee0-3e04-ac64-b6d060625312",
                                                "text": "A l’aide de relevés par satellite, de robots sous-marins et d’une batterie d’instruments – courantomètre, sondes – déposés au fond des mers, ces scientifiques parviennent peu à peu à traquer, cartographier et analyser ces reliefs à la topographie complexe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd866a47-f8ce-3af2-b09e-851357610496",
                                        "entry_id": "bd78ef8f-9154-3597-9b9d-2d4affe67d7d",
                                        "glosses": [
                                            "Cartographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b53b01-1218-4bfb-9d6b-2507d23ffbcd",
                                                "sense_id": "dd866a47-f8ce-3af2-b09e-851357610496",
                                                "text": "C’est à elle seule que l’on doit d’avoir pu retrouver et rétablir à peu près complétement l’ensemble de la topographie politique."
                                            },
                                            {
                                                "example_id": "f0302f9d-f046-4c41-be7e-ac605381b3fd",
                                                "sense_id": "dd866a47-f8ce-3af2-b09e-851357610496",
                                                "text": "Messieurs, J’ai hésité longtemps avant d’entreprendre de tracer la topographie médicale de la ville et de la commune d’Autun."
                                            }
                                        ]
                                    }
                                ]
                            },
