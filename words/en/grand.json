    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f9128ebc-49fe-3c0c-a92d-b74b77a07d12",
                    "sense_definition": "Great in size, and fine or imposing in appearance or impression; magnificent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "magnificent_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace has a <w>grand</w> entrance hall decorated with gold.",
                            "target_lang_translations": {
                                "ru": "Дворец имеет <w>величественный</w> вестибюль, украшенный золотом.",
                                "zh": "这座宫殿有一个用黄金装饰的<w>宏伟</w>门厅。"
                            }
                        },
                        {
                            "text": "From the top of the hill, we had a <w>grand</w> view of the entire valley.",
                            "target_lang_translations": {
                                "ru": "С вершины холма нам открылся <w>великолепный</w> вид на всю долину.",
                                "zh": "从山顶望去，整个山谷的景色尽收眼底，十分<w>壮丽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "great",
                        "large",
                        "magnificent",
                        "impressive"
                    ],
                    "common_phrases": [
                        "grand scale",
                        "grand design",
                        "grand finale",
                        "grand total"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огромный по размеру, прекрасный или внушительный по внешнему виду или впечатлению; величественный.",
                        "zh": "规模宏大，外观或印象上显得壮丽、宏伟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грандиозный",
                                "target_lang_sense_clarification": "о планах, событиях или сооружениях"
                            },
                            {
                                "target_lang_word": "величественный",
                                "target_lang_sense_clarification": "производящий сильное впечатление внешним видом"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "очень красивый, роскошный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏伟",
                                "target_lang_sense_clarification": "形容建筑或规模巨大壮观"
                            },
                            {
                                "target_lang_word": "壮丽",
                                "target_lang_sense_clarification": "形容景色或场面雄伟美丽"
                            },
                            {
                                "target_lang_word": "辉煌",
                                "target_lang_sense_clarification": "形容光彩夺目或成就巨大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c35e411-eeec-38e1-ac8a-6e103a86766c",
                    "sense_definition": "Having higher rank, dignity, or importance than others of the same category.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rank_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>grand</w> duke hosted a lavish dinner for the visiting diplomats.",
                            "target_lang_translations": {
                                "ru": "<w>Великий</w> князь устроил пышный ужин для приезжих дипломатов.",
                                "zh": "<w>大</w>公为到访的外交官们举办了一场盛大的晚宴。"
                            }
                        },
                        {
                            "text": "He achieved the title of <w>grand</w> master after years of playing chess.",
                            "target_lang_translations": {
                                "ru": "Он получил титул <w>гроссмейстера</w> после многих лет игры в шахматы.",
                                "zh": "经过多年的下棋，他获得了国际象棋<w>特级大师</w>的称号。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arch-"
                    ],
                    "common_phrases": [
                        "grand master",
                        "grand jury",
                        "grand prix",
                        "grand slam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий более высокий ранг, титул или важность по сравнению с другими в той же категории.",
                        "zh": "在同类中地位、级别或重要性更高。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великий",
                                "target_lang_sense_clarification": "в титулах (напр. Великий князь)"
                            },
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "основной, важнейший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大",
                                "target_lang_sense_clarification": "用于头衔或称号，表示尊贵"
                            },
                            {
                                "target_lang_word": "首席",
                                "target_lang_sense_clarification": "表示职位最高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9516a99c-53d2-3db9-ac77-3ac9fadeaa89",
                    "sense_definition": "Fine, lovely, or very good.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "colloquial_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry about the arrangements, everything will be <w>grand</w>.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся об организации, всё будет <w>отлично</w>.",
                                "zh": "别担心安排，一切都会很<w>棒</w>的。"
                            }
                        },
                        {
                            "text": "We had a <w>grand</w> time catching up with old friends yesterday.",
                            "target_lang_translations": {
                                "ru": "Мы <w>замечательно</w> провели время, общаясь со старыми друзьями вчера.",
                                "zh": "昨天我们和老朋友叙旧，过得非常<w>愉快</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "great"
                    ],
                    "common_phrases": [
                        "be grand",
                        "grand job"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in Irish and British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекрасный, милый или очень хороший.",
                        "zh": "美好的、极好的（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличный",
                                "target_lang_sense_clarification": "разговорное выражение одобрения"
                            },
                            {
                                "target_lang_word": "замечательный",
                                "target_lang_sense_clarification": "приятный, хороший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "棒",
                                "target_lang_sense_clarification": "口语中表示非常好"
                            },
                            {
                                "target_lang_word": "极好",
                                "target_lang_sense_clarification": "表示程度很高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12c32b21-5b9d-3d65-b720-22a68391195c",
                    "sense_definition": "Standing in the second degree of parentage or descent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "family_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is my <w>grand</w> uncle on my mother's side of the family.",
                            "target_lang_translations": {
                                "ru": "Он мой <w>двоюродный</w> дедушка по материнской линии.",
                                "zh": "他是我母亲那边的<w>外</w>叔祖父。"
                            }
                        },
                        {
                            "text": "The family gathered to celebrate the birth of the first <w>grand</w> nephew.",
                            "target_lang_translations": {
                                "ru": "Семья собралась, чтобы отпраздновать рождение первого <w>внучатого</w> племянника.",
                                "zh": "全家人聚在一起庆祝第一个<w>侄孙</w>的出生。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначает родство через одно поколение (обычно используется как часть составных слов).",
                        "zh": "表示隔代亲属关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внучатый",
                                "target_lang_sense_clarification": "о племянниках"
                            },
                            {
                                "target_lang_word": "двоюродный",
                                "target_lang_sense_clarification": "о дедушках/бабушках (в значении grand uncle)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外",
                                "target_lang_sense_clarification": "用于母系亲属，如外祖父"
                            },
                            {
                                "target_lang_word": "曾",
                                "target_lang_sense_clarification": "用于隔代，如曾孙"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba709e8d-cd66-3a25-83d6-1da864d32a8f",
                    "sense_definition": "A thousand units of currency, such as dollars or pounds.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "currency_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The repairs to the car ended up costing me over a <w>grand</w>.",
                            "target_lang_translations": {
                                "ru": "Ремонт машины в итоге обошелся мне больше чем в <w>штуку</w>.",
                                "zh": "修车最终花了我一<w>千</w>多块。"
                            }
                        },
                        {
                            "text": "He managed to save fifty <w>grand</w> for a down payment on a house.",
                            "target_lang_translations": {
                                "ru": "Ему удалось накопить пятьдесят <w>штук</w> для первоначального взноса за дом.",
                                "zh": "他设法存了五万<w>千</w>块作为买房的首付。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "five grand",
                        "ten grand"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тысяча единиц валюты, например, долларов или фунтов.",
                        "zh": "一千单位的货币（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штука",
                                "target_lang_sense_clarification": "сленг, тысяча рублей или долларов"
                            },
                            {
                                "target_lang_word": "косарь",
                                "target_lang_sense_clarification": "жаргон, тысяча"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "千",
                                "target_lang_sense_clarification": "指代一千元"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc98474f-ff86-31e9-8a43-147069267c76",
                    "sense_definition": "A grand piano.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "piano_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat down at the <w>grand</w> and began to play a beautiful melody.",
                            "target_lang_translations": {
                                "ru": "Она села за <w>рояль</w> и начала играть красивую мелодию.",
                                "zh": "她坐在<w>三角钢琴</w>前，开始弹奏一首优美的旋律。"
                            }
                        },
                        {
                            "text": "The concert hall features a magnificent Steinway <w>grand</w> on stage.",
                            "target_lang_translations": {
                                "ru": "В концертном зале на сцене стоит великолепный <w>рояль</w> Стейнвей.",
                                "zh": "音乐厅的舞台上摆放着一架华丽的施坦威<w>三角钢琴</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "baby grand",
                        "concert grand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рояль.",
                        "zh": "一种大型钢琴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рояль",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "三角钢琴",
                                "target_lang_sense_clarification": "乐器名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8c0a9bb-465b-3ddd-b823-493fda12cc66",
                    "sense_definition": "A grandparent or a grandchild.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "family_noun_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves spending the summer holidays with her <w>grands</w>.",
                            "target_lang_translations": {
                                "ru": "Она любит проводить летние каникулы со своими <w>бабушкой и дедушкой</w>.",
                                "zh": "她喜欢和<w>祖父母</w>一起度过暑假。"
                            }
                        },
                        {
                            "text": "The reunion included parents, <w>grands</w>, and great-grandchildren.",
                            "target_lang_translations": {
                                "ru": "На встрече присутствовали родители, <w>бабушки и дедушки</w> и правнуки.",
                                "zh": "聚会的人包括父母、<w>祖父母</w>和曾孙辈。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дедушка, бабушка или внук, внучка (разговорное).",
                        "zh": "祖父母或孙辈（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабушки и дедушки",
                                "target_lang_sense_clarification": "старшее поколение"
                            },
                            {
                                "target_lang_word": "внуки",
                                "target_lang_sense_clarification": "младшее поколение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祖辈",
                                "target_lang_sense_clarification": "指代祖父母"
                            },
                            {
                                "target_lang_word": "孙辈",
                                "target_lang_sense_clarification": "指代孙子孙女"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "035ef9a3-06c2-3d7c-aecc-06f2e4cc7641",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Grand</w> to speak at the conference.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Гранда</w> выступить на конференции.",
                                "zh": "我们邀请了<w>格兰德</w>先生在会议上发言。"
                            }
                        },
                        {
                            "text": "The letter was addressed to a Sarah <w>Grand</w>.",
                            "target_lang_translations": {
                                "ru": "Письмо было адресовано Саре <w>Гранд</w>.",
                                "zh": "这封信是寄给萨拉·<w>格兰德</w>的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гранд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格兰德",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}