                                                "sense_id": "36df9eef-e75e-3ad8-b6d7-1319f77505f6",
                                                "text": "Ich heiße Maria."
                                            },
                                            {
                                                "example_id": "26069c72-181a-4181-beb6-77730b24d594",
                                                "sense_id": "36df9eef-e75e-3ad8-b6d7-1319f77505f6",
                                                "text": "„Das Bungeespringen, das zutreffender ‚Bungeefallen’ heißen müsste, stellt eine Steigerung des beschriebenen Fallerlebens dar.“"
                                            },
                                            {
                                                "example_id": "10641f37-095d-4d13-a8ad-7793a5ed7c71",
                                                "sense_id": "36df9eef-e75e-3ad8-b6d7-1319f77505f6",
                                                "text": "„Und die Redakteure bildeten sich im Kunstfliegen aus, und je jüdischer einer hieß, desto raußerer flog er raus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c289f744-b504-303b-9d8f-c278d4606633",
                                        "entry_id": "323ac3db-e019-3132-94c8-a80186c1ad6e",
                                        "glosses": [
                                            "jemanden als etwas bezeichnen"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d88ec17-cfd1-4d3d-b87b-b111e8085e82",
                                                "sense_id": "c289f744-b504-303b-9d8f-c278d4606633",
                                                "text": "Er hieß mich einen Dummkopf."
                                            },
                                            {
                                                "example_id": "d682079f-cfa4-40c5-8e91-bb21129defab",
                                                "sense_id": "c289f744-b504-303b-9d8f-c278d4606633",
                                                "text": "Einen in aller Öffentlichkeit Dummbatz geheißenen Ehemann kann man nur bedauern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "117d5d5a-b58b-3079-93cc-cf05dd0dafd1",
                                        "entry_id": "323ac3db-e019-3132-94c8-a80186c1ad6e",
                                        "glosses": [
                                            "jemanden anweisen, etwas zu tun"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55dd8d5a-78e8-4fa8-9ebc-1fa840b25717",
                                                "sense_id": "117d5d5a-b58b-3079-93cc-cf05dd0dafd1",
                                                "text": "Sie wurde geheißen, ihre Hausaufgaben zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "94389410-dab7-3232-bf25-7fc438804f4f",
                                        "entry_id": "323ac3db-e019-3132-94c8-a80186c1ad6e",
                                        "glosses": [
                                            "einen bestimmten Sinn haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845a9240-71ad-40d0-bfde-bbc5531a187e",
                                                "sense_id": "94389410-dab7-3232-bf25-7fc438804f4f",
                                                "text": "Was soll das heißen?"
                                            },
                                            {
                                                "example_id": "44c468cb-de84-46d6-85e4-96b069741521",
                                                "sense_id": "94389410-dab7-3232-bf25-7fc438804f4f",
                                                "text": "Heißt das, du kommst nicht?"
                                            },
                                            {
                                                "example_id": "6ddda62f-2ccb-481b-a3ad-3a48f793d871",
                                                "sense_id": "94389410-dab7-3232-bf25-7fc438804f4f",
                                                "text": "„Die goldene Regel des Drachenfliegens heißt, möglichst viel Umsicht walten lassen.“"
                                            },
                                            {
                                                "example_id": "b8cc3f92-6683-4c49-9076-ece2ebab431e",
                                                "sense_id": "94389410-dab7-3232-bf25-7fc438804f4f",
                                                "text": "[Kreuzigung Jesus Christus:] „Und um die neunte Stunde schrie Jesus laut: Eli, Eli, lama asabtani? Das heißt: Mein Gott, mein Gott, warum hast du mich verlassen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1aac4753-d805-325f-a07f-a6cadba31d40",
                                        "entry_id": "323ac3db-e019-3132-94c8-a80186c1ad6e",
                                        "glosses": [
                                            "es wird erzählt"
                                        ],
                                        "tags": [
                                            "es heißt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2018ff70-ff67-4b04-8936-587b587bdc4e",
                                                "sense_id": "1aac4753-d805-325f-a07f-a6cadba31d40",
                                                "text": "Es heißt, er hätte im Lotto gewonnen."
                                            },
                                            {
                                                "example_id": "c4863557-3a36-40f1-a2fa-3320c7dbeef2",
                                                "sense_id": "1aac4753-d805-325f-a07f-a6cadba31d40",
                                                "text": "„Einen Umsturzversuch der USA und Südkoreas in Nordkorea werde China aber verhindern, hieß es in der chinesischen Zeitung \"Global Times\".“"
                                            },
                                            {
                                                "example_id": "1d7b64c9-4283-4521-a566-718c47795b19",
                                                "sense_id": "1aac4753-d805-325f-a07f-a6cadba31d40",
                                                "text": "„Letzlich entscheidet sich in den Städten, Landkreisen und Gemeinden, ob der Wandel zu einer nachhaltigen Gesellschaft gelingt, heißt es in der Fachliteratur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "45354ba8-61e7-335f-8f59-3dfccdc6408f",
                                        "entry_id": "323ac3db-e019-3132-94c8-a80186c1ad6e",
                                        "glosses": [
                                            "es gilt"
                                        ],
                                        "tags": [
                                            "es heißt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa7eb215-2d5c-46d7-ab67-0a122eb3dbec",
                                                "sense_id": "45354ba8-61e7-335f-8f59-3dfccdc6408f",
                                                "text": "Jetzt heißt es aufpassen!"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "heißen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37884ef2-f7e4-3797-95fd-86ba180c8735",
                                        "entry_id": "b5347302-80d6-383c-8817-477e01b36cc2",
                                        "glosses": [
                                            "Fahne oder Segel hissen, hochziehen"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf4856a2-7832-46f6-be74-0975ff343c29",
                                                "sense_id": "37884ef2-f7e4-3797-95fd-86ba180c8735",
                                                "text": "„heißen der Flaggen im Topp: kleiner Flaggenschmuck. Neben Dienstflagge und Gösch wird die Staatsflagge im Großtopp gesetzt.“"
                                            },
                                            {
                                                "example_id": "0750f6cb-2713-47cb-bf8c-9dc464d9dccf",
                                                "sense_id": "37884ef2-f7e4-3797-95fd-86ba180c8735",
                                                "text": "Wenn Wind aufkommt, werden wir die Segel heißen."
                                            },
                                            {
                                                "example_id": "aacbd5cc-a6de-4fae-924f-45f8992db128",
                                                "sense_id": "37884ef2-f7e4-3797-95fd-86ba180c8735",
                                                "text": "„Leinen los und heiß die Segel! / Fahr mit uns auf unsern Wegen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
