                ],
                "senses": [
                    {
                        "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                        "entry_id": "b7f04768-2a6b-3c2c-aae9-77aa777346ab",
                        "glosses": [
                            "Raum, der zur Ausübung eines Gewerbes (also für Handel, Dienstleistungen oder Handwerk zur Erzielung von Einkünften) verwendet wird"
                        ],
                        "tags": [
                            "Immobilienmarkt",
                            "oft im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "22ccee3f-5be1-4fd2-8617-7a9aaba3e275",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Stefanie Ott hat für ihr Geschäft lange vergebens Gewerberäume gesucht.“"
                            },
                            {
                                "example_id": "0d5403f4-5cf7-4ce3-b904-6c993f93b30e",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Andererseits war es für kleinere Unternehmen schwierig, Gewerberäume zu finden.“"
                            },
                            {
                                "example_id": "a8d09ef8-bab3-4078-9b28-ea20c5fc6028",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Die Preise für Wohn- und Gewerberäume sind rasant gestiegen,“ […]."
                            },
                            {
                                "example_id": "b4f74a93-d039-49e5-a1e6-1fff01b47922",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "Es gibt in Weißensee viele Gewerberäume, die leer stehen."
                            },
                            {
                                "example_id": "1a07ffbf-b8a3-4a68-a167-2684fdcc54d2",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "Es wurden 73 Gewerberäume eingerichtet, […]."
                            },
                            {
                                "example_id": "e9961498-5cd6-44a5-858e-35b2a70091e1",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Im Jahr 1983 mieteten die ersten Künstler zu günstigen Konditionen Gewerberäume und bauten sie nach ihren Bedürfnissen zu Ateliers um.“"
                            },
                            {
                                "example_id": "3321066b-d7dd-4c83-8677-435788b18a61",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Oft werden Gewerberäume bzw. -etagen, die meist im Erdgeschoss liegen, an Gewerbemieter vermietet.“"
                            },
                            {
                                "example_id": "a76c92f0-fecd-48dc-8eb8-3125745b874f",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Es gibt eine massive Verdrängung, wenn aus ehemaligen Fabriketagen, Produktionshallen oder Gewerberäumen Büros und Loftwohnungen werden.“"
                            },
                            {
                                "example_id": "34b7df40-ec69-467d-8328-bb5bb3001558",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Durch aufwendige Sanierung und Modernisierung entstanden daraus im Laufe der 1970er und 1980er Jahre begehrte und teure Wohn- und Gewerberäume, deren Mietpreise heute zu den höchsten in New York gehören.“"
                            },
                            {
                                "example_id": "8c70e842-c701-4dc5-a7c2-ec709fedc846",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Im Falle der Kündigungen der Wohnungen und Gewerberäume am Burgweg im Kleinbasler Wettsteinquartier blitzt der Mieterverband vor dem Appellationsgericht ab.“"
                            },
                            {
                                "example_id": "0ae327ce-1b7b-434e-b57d-e2d1183cc1c8",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Die Stadt plant dort ein neues Quartier - mit günstigen Wohnungen für 2000 Personen, Gewerberäumen, einem Schulhaus und einem öffentlichen Park.“"
                            },
                            {
                                "example_id": "cc68e0c6-524f-4f9a-9c5c-6265e73893c3",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„In einem Gewerberaum in Kloten wurde am Freitagvormittag ein toter Mann entdeckt.“"
                            },
                            {
                                "example_id": "aadbc0d7-6063-42f7-a215-4e936d6adba2",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Alle Städte leiden an denselben Problem: Sie verlieren durch die wirtschaftliche Entwicklung und den demografischen Wandel Einwohner. Die Folge: Wohn- und Gewerberäume stehen leer,“ […]."
                            },
                            {
                                "example_id": "ebfdfc16-7709-4683-a69b-16c985a6792c",
                                "sense_id": "6fcac5e2-7d44-3005-8526-ab43fb8eb745",
                                "text": "„Nach Angaben der Polizei waren 450 Beamte im Einsatz. Sie durchsuchten 19 Wohnungen und Gewerberäume in den Berliner Stadtbezirken Reinickendorf, Charlottenburg-Wilmersdorf, Friedrichshain-Kreuzberg sowie Tempelhof-Schöneberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
