                        "examples": [
                            {
                                "example_id": "36c164d9-c54a-419a-b4f3-57fba50b0eb6",
                                "sense_id": "1f396bc6-7d86-369f-8bdc-e6eeed84ad5d",
                                "text": "In mercy ye skies to my woes,\nLet your thunders avengingly roll,\nAnd death kindly hush to repose\nThe Etna that bursts on my soul."
                            },
                            {
                                "example_id": "21f15dba-7a32-492f-9e10-604b0fb63eda",
                                "sense_id": "1f396bc6-7d86-369f-8bdc-e6eeed84ad5d",
                                "text": "The remembrance of the engagement that I had broken came back on me avengingly […]"
                            },
                            {
                                "example_id": "f2e19f6a-5e4b-45f4-a5fa-e1947ee39b7e",
                                "sense_id": "1f396bc6-7d86-369f-8bdc-e6eeed84ad5d",
                                "text": "His cheeks grew tight with fury at the thought that he had just been duped into humiliation by a man who was almost the same age as he was and still only a captain, and he swung upon the chaplain avengingly with a look of such murderous antagonism that the chaplain began to tremble."
                            }
                        ]
