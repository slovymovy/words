                                "example_id": "fa4df270-b9ac-43ac-9f39-8be45fae9dce",
                                "sense_id": "e291169a-8027-3a6f-b998-6a3e79d28690",
                                "text": "Ce sont plusieurs applications malicielles qui ont été découvertes sur l’Androïd Market."
                            },
                            {
                                "example_id": "0f39bd6b-d637-4ea9-a09b-ad625631478b",
                                "sense_id": "e291169a-8027-3a6f-b998-6a3e79d28690",
                                "text": "[…] le filtrage de contenu avec prévention intégrée contre la menace de virus, les pourriels, les logiciels espions, le hameçonnage, la cybercriminalité et les attaques malicielles […]"
                            }
                        ]
                    }
