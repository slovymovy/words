                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "da14ed10-cf19-42d9-8be0-18fa15f07bfc",
                                "sense_id": "a5e35710-dc60-34a5-b143-9afd4d952908",
                                "text": "It is often necessary to tole a big stag, to induce him to leave the hind ..."
                            },
                            {
                                "example_id": "5f146ae2-6877-4efb-a7a1-d2dc3f3f386a",
                                "sense_id": "a5e35710-dc60-34a5-b143-9afd4d952908",
                                "text": "And thus the young Soldier is to be train’d on to the Warfare of Life ; wherein Care is to be taken that more things be not repreſented as dangerous than really are ſo ; and then, that whatever you obſerve him to be more frighted at than he ſhould, you be ſure to tole him on to by inſenſible Degrees, till he at laſt, quitting his Fears, maſters the Difficulty, and comes off with Applauſe."
                            }
                        ]
                    }
