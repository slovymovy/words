                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "89d0cb5c-3eb5-4a5a-bf68-e3f0f5feb934",
                                "sense_id": "fc466631-9832-30c4-a673-a86c2454556a",
                                "text": "Sich vor dem Biß der Schlangen, der Hünde hüten, schützen.",
                                "translation": "Se protéger, se préserver contre la morsure des serpents, des chiens."
                            },
                            {
                                "example_id": "7908da6a-c453-4775-a475-57fc109ac21d",
                                "sense_id": "fc466631-9832-30c4-a673-a86c2454556a",
                                "text": "Er hat einen gefährlichen Biß am Bein, an der Hand.",
                                "translation": "Il a une morsure grave à la jambe, à la main."
                            }
                        ]
                    }
