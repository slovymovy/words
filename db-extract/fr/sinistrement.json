        "fr-extract.jsonl": [
            {
                "entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                "word": "sinistrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                        "entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                        "glosses": [
                            "D’une manière sinistre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1359152-9ee3-4a1b-8969-d97c0fa14687",
                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                "text": "Leurs yeux sinistrement étincellent dans l’ombre,"
                            },
                            {
                                "example_id": "ddf7cc9d-c6e7-4017-b7cd-4e50d8cba8b7",
                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                "text": "La chaloupe démarrée, on hissa les voiles dont les drisses crièrent sinistrement au long des mâts, […]."
                            },
                            {
                                "example_id": "063e9ba6-2e11-4e12-b0f6-54476c3b79fe",
                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                "text": "Le chantier, cette nuit-là, ne se creusait pas sinistrement comme par les nuits pluvieuses ; éclairé de larges nappes de lumière blanche, il s’étendait, dans le silence et l’immobilité du froid, avec une mélancolie douce."
                            }
                        ]
                    },
                    {
                        "sense_id": "6acbbb1b-fcbd-3455-ba24-1fa296bacce4",
                        "entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                        "glosses": [
                            "D'une manière pessimiste."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "80bd2024-1b02-4405-8bb3-de3c140c7e36",
                                "sense_id": "6acbbb1b-fcbd-3455-ba24-1fa296bacce4",
                                "text": "En interprétant sinistrement de certaines actions…."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c96049e7-67de-48d8-a9dc-747cbb6e704a",
                        "source_entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                        "target_lang_word": "ominously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ominously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10685b53-eb8c-3213-b1d1-67306505510d",
                                        "entry_id": "7dd9dca6-22b6-3463-9353-5c67ce71120d",
                                        "glosses": [
                                            "In an ominous manner; with sinister foreboding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5293e8-5b4b-497a-bbb1-d1486db236f8",
                                                "sense_id": "10685b53-eb8c-3213-b1d1-67306505510d",
                                                "text": "From first to last he was ominously polite, and ominously silent."
                                            },
                                            {
                                                "example_id": "0210da99-1ab9-4fca-a87d-0123aa9513d9",
                                                "sense_id": "10685b53-eb8c-3213-b1d1-67306505510d",
                                                "text": "His nostrils flared ominously and his fists opened and closed at his sides."
                                            },
                                            {
                                                "example_id": "0d05b720-b9ab-445f-960b-e7e3faf07ab2",
                                                "sense_id": "10685b53-eb8c-3213-b1d1-67306505510d",
                                                "text": "However, the next day dawned ominously with an overcast sky and we postponed our start till 8 o'clock."
                                            },
                                            {
                                                "example_id": "c3dcf8df-a9f0-4cbe-b136-1043aa4c6ca6",
                                                "sense_id": "10685b53-eb8c-3213-b1d1-67306505510d",
                                                "text": "Just as the Census Bureau forecasts growing racial diversity under any future level of immigration, it likewise projects ominously slow growth in America’s working-age population without more immigration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
