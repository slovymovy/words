                ],
                "senses": [
                    {
                        "sense_id": "47d2eb60-ff8f-3636-b615-de56238ee095",
                        "entry_id": "342c8030-035c-3b73-9240-2efc2853608a",
                        "glosses": [
                            "faktischer Zustand, Sachlage des Verkehrsbereichs beziehungsweise des Verkehrsgeschehens mit seinen Abläufen, Gefährdungen, Möglichkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5fac256-8edb-4228-a06a-76642b23c56d",
                                "sense_id": "47d2eb60-ff8f-3636-b615-de56238ee095",
                                "text": "„Die Ampel schalte anschließend automatisch auf Grün und passe sich den aktuellen Verkehrsgegebenheiten optimal an.“"
                            },
                            {
                                "example_id": "17773daf-75be-4067-85b8-69148ea96a00",
                                "sense_id": "47d2eb60-ff8f-3636-b615-de56238ee095",
                                "text": "„Ein anschauliches allgemeines Beispiel für regelbasierte Rechtsetzung ist das Verbot, auf einer bestimmten Straße nicht schneller als 30 Stundenkilometer zu fahren, prinzipienbasiert ist dagegen das Gebot, mit einer den Verkehrsgegebenheiten angepassten Geschwindigkeit zu fahren.“"
                            },
                            {
                                "example_id": "e2c03a6a-bab1-42bc-8c00-4f4d9bda46ff",
                                "sense_id": "47d2eb60-ff8f-3636-b615-de56238ee095",
                                "text": "„Gerade im Verkehrsbereich ist eine zunehmende Vernunftsteuerung des Kindes notwendig, da die Verkehrsgegebenheiten mit ihren Regelungen und Gefährdungen am ehesten Vernunftregelungen zugänglich sind und nur durch sie beherrschbar werden.“"
                            },
                            {
                                "example_id": "617fa17e-80f1-4513-8868-057d6dc73eff",
                                "sense_id": "47d2eb60-ff8f-3636-b615-de56238ee095",
                                "text": "„Die im vorhergehenden Abschnitt für Hannover gekennzeichnete Entwicklung infolge des frühzeitigen Ausbaus des Straßenbahnnetzes ist im ganzen gesehen den günstigen Verkehrsgegebenheiten nicht in dem Maße gefolgt, wie man hätte erwarten können.“"
                            },
                            {
                                "example_id": "b23b5a6b-d600-478a-bf31-4f315f0bf985",
                                "sense_id": "47d2eb60-ff8f-3636-b615-de56238ee095",
                                "text": "„Sie kennen nicht nur die Verkehrsgegebenheiten auf dem Schulweg, sondern auch ihr Kind, sein Temperament und sein Verhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
