                                        "glosses": [
                                            "vztahující se k bitvě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf1d53f-ed9a-48ba-961b-cfd3ca020c6b",
                                                "sense_id": "4d145882-6317-303a-8c79-a4e1e8eedc17",
                                                "text": "Představte si, že by historik napsal: Pan Napoleon sehrál výstižně, nenapodobitelně svou vynikající roli v dějinách světových; bitevní scény podal se strhující vervou, jeho maska císaře byla znamenitá, avšak na Svaté Heleně hrál mdle a bez tempa."
                                            }
                                        ]
