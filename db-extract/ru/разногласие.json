                "translations": [
                    {
                        "translation_id": "c0e4dc57-2ebe-4206-9c2a-2e99367e8d3d",
                        "source_entry_id": "aebe8193-1b61-3f72-99e5-a66fe92ee0c4",
                        "source_sense_description": "отсутствие единства во мнениях, взглядах; множественность мнений",
                        "target_lang_word": "disagreement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disagreement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9432c4c-0873-3952-9117-89dfe6b37a9d",
                                        "entry_id": "d9149ee4-5167-3fd7-84c5-45bc5412ef60",
                                        "glosses": [
                                            "An argument or debate."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00eab32-b70c-4b37-a533-ae67805227a8",
                                                "sense_id": "c9432c4c-0873-3952-9117-89dfe6b37a9d",
                                                "text": "They had a bit of a disagreement about what color to paint the bedroom, but they have reached a compromise."
                                            },
                                            {
                                                "example_id": "599b9db2-fd7e-450c-a7a5-1b2430d68c89",
                                                "sense_id": "c9432c4c-0873-3952-9117-89dfe6b37a9d",
                                                "text": "In any event, agreement or disagreement, joke or no joke, in my 28 years on the court I did not hear a voice raised in anger in that conference, nor were snide or personal remarks ever made. The discussion was professional, disagreements reflected legal differences on the merits, and the justices tried to find ways to reach court agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ba2aa5-80d9-3742-adf5-8fdc506665fb",
                                        "entry_id": "d9149ee4-5167-3fd7-84c5-45bc5412ef60",
                                        "glosses": [
                                            "A condition of not agreeing or concurring."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac2f4d0-b3f3-4e0d-9608-fd19d88f06c9",
                                                "sense_id": "12ba2aa5-80d9-3742-adf5-8fdc506665fb",
                                                "text": "The theory shows considerable disagreement with the data."
                                            },
                                            {
                                                "example_id": "e58f5727-565d-4973-a9bd-422aaedcb038",
                                                "sense_id": "12ba2aa5-80d9-3742-adf5-8fdc506665fb",
                                                "text": "The two sides were in disagreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9cfb302-0d0b-44b1-b7b6-fddcb897b337",
                        "source_entry_id": "aebe8193-1b61-3f72-99e5-a66fe92ee0c4",
                        "source_sense_description": "отсутствие единства во мнениях, взглядах; множественность мнений",
                        "target_lang_word": "Meinungsverschiedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meinungsverschiedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "unterschiedliche Beurteilung, Einschätzung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2145cd9e-7287-4880-ad99-15519fc2ad8f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Im Herbst 1919 startete die Weiße Armee eine Großoffensive auf Moskau, die aber unter anderem wegen Meinungsverschiedenheiten zwischen den Generälen scheiterte.“"
                                            },
                                            {
                                                "example_id": "420da42d-1914-484a-81fa-3eb616401c62",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Am Ende erwiesen sich die alliierten Meinungsverschiedenheiten in der Reparationsfrage als unüberbrückbar.“"
                                            },
                                            {
                                                "example_id": "23279758-86e2-44d5-ab89-71ec04931b71",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Während er zu irgendeinem Gegenstand geführt wurde, merkte er, dass unter seinen Führern Meinungsverschiedenheiten und eine gewisse Verwirrung entstanden waren.“"
                                            },
                                            {
                                                "example_id": "38ef3c91-4edf-448b-acb2-a8d2a4fea93f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„In den meisten Fällen herrscht ein Geist von Kooperation und gegenseitigem Verstehen, und es hat sich eine Art guter Beziehung entwickelt, die gewöhnlich gravierende Meinungsverschiedenheiten verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "verbale Auseinandersetzung, Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad229162-e4f1-4d42-8624-ee5b91e2b449",
                                                "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                                "text": "Nach dieser Meinungsverschiedenheit war die Stimmung vorübergehend etwas getrübt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a705b35-e97e-48e8-834a-e210ac043630",
                        "source_entry_id": "aebe8193-1b61-3f72-99e5-a66fe92ee0c4",
                        "source_sense_description": "отсутствие единства во мнениях, взглядах; множественность мнений",
                        "target_lang_word": "différend",
                        "target_lang_code": "fr",
