                        "passer un linge"
                    ]
                },
                {
                    "sense_id": "cc204eed-eb12-3314-b0f2-dd5e9e329e3d",
                    "sense_definition": "Vêtements portés directement sur la peau, sous-vêtements.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a emporté suffisamment de <w>linge</w> de corps pour son déplacement de quelques jours."
                        },
                        {
                            "text": "Dans cette boutique ancienne, on vendait du <w>linge</w> fin brodé à la main."
