                                    {
                                        "sense_id": "3071929d-b33a-30fa-91f6-4ccc8545a8f8",
                                        "entry_id": "101c4a9e-240d-34f7-b2c6-2a1f6bd65dfb",
                                        "glosses": [
                                            "Absence de réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e0e8a4a-04b1-476d-97ca-c3a157b32e17",
                                                "sense_id": "3071929d-b33a-30fa-91f6-4ccc8545a8f8",
                                                "text": "Il a fait cette bévue dans un moment d’irréflexion."
                                            },
                                            {
                                                "example_id": "4613b2dc-5c53-44d8-9d52-3da1ff015d53",
                                                "sense_id": "3071929d-b33a-30fa-91f6-4ccc8545a8f8",
                                                "text": "D’ordinaire, en effet, toutes les fois qu’un écrivain s’est laissé aller par crédulité ou irréflexion à une opinion contestée, il n’est pas de raisons, il n’est pas de subtilités qu’il n’emploie pour nous amener à son sentiment. (1628, René Descartes, Règles pour la direction de l'esprit)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7926d9e0-eaa6-41fd-bdee-3743bc7ef693",
