                "senses": [
                    {
                        "sense_id": "599702fc-f7c7-3bba-93ef-bed9e27ddb26",
                        "entry_id": "d1bd6e3b-3343-3560-9469-088bb9bda5c0",
                        "glosses": [
                            "Remplacer un acronyme (ou un sigle, des initiales…) par sa signification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2274e9bb-52a8-4ab8-95c6-dddfd18140b4",
                                "sense_id": "599702fc-f7c7-3bba-93ef-bed9e27ddb26",
                                "text": "En réalité, il en existe d’autres et en particulier les fameux BCAA. Mais de quoi s’agit-il ? Désacronymisé, cela correspond aux Branched-Chain Amino Acids ou autrement traduit : Acides Aminés Ramifiés."
                            },
                            {
                                "example_id": "077031d2-97da-43e2-bab7-9e9ab8a41420",
                                "sense_id": "599702fc-f7c7-3bba-93ef-bed9e27ddb26",
                                "text": "JPU : Merci beaucoup de me désacronymiser."
                            },
                            {
                                "example_id": "3cae9aed-335c-436d-b29e-2a04f91ab89d",
