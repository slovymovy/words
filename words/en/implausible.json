                            },
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "в который трудно поверить"
                            },
                            {
                                "target_lang_word": "маловероятный",
                                "target_lang_sense_clarification": "имеющий мало шансов на истинность"
                            }
                        ]
                    }
                }
            ]
