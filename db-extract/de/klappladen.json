                    },
                    {
                        "translation_id": "01d73e05-5dc8-455e-8aa0-a595491ac3ab",
                        "source_entry_id": "84f03308-34c1-3af0-870a-ef4c1283a6b6",
                        "source_sense_id": "d002bb8e-af8b-328c-9d07-a802c932648b",
                        "source_sense_description": "Laden (an der Außen- oder Innenseite eines Fensters), der sich aufklappen lässt",
                        "target_lang_word": "volet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b343ddcf-64b0-3a0c-a4c9-82fbc7e70b7e",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Tablette utilisée pour trier les petits objets, comme les grains, les cailloux, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faec969b-0e30-491a-afca-aadf1c5941f8",
                                                "sense_id": "b343ddcf-64b0-3a0c-a4c9-82fbc7e70b7e",
                                                "text": "Il trie son grain avec un volet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82045140-5fbf-3590-8b73-7fabe65cfd09",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Petit réduit servant à faire nicher des pigeons."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de49f9b0-13d0-460f-81b0-ba1dc78cdb86",
                                                "sense_id": "82045140-5fbf-3590-8b73-7fabe65cfd09",
                                                "text": "Volets. Ce ſont de petits réduits, qui n’ont qu’une médiocre ouverture, fermée avec une jalouſie ou un ais […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Panneau, en bois ou en métal, ou battant qui protège une fenêtre, le plus souvent à l’extérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662f94e2-f4b0-4c62-b5ae-c0632b44c598",
                                                "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                                "text": "Les volets, grossièrement faits, se recommandaient par une solide peinture vert dragon."
                                            },
                                            {
                                                "example_id": "05c559fa-7a6d-4b75-b695-5765fdf5ed8c",
                                                "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                                "text": "Ils avaient une maison à eux […] Oh ! une vraie cabane ! couverte de chaume, bâtie en pisé, fermée par des volets qui claquaient au vent."
                                            },
                                            {
                                                "example_id": "4f409219-8836-409a-863b-be3a6c4355c1",
                                                "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                                "text": "Ses rues, dans le silence d’un lieu désert, attendent le claquement des volets, l’ouverture des portes, le hennissement des chevaux, l’essor d’une marmaille."
                                            },
                                            {
                                                "example_id": "744766b5-5ab1-439c-8137-3b9b4547185d",
                                                "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                                "text": "Une seule boutique restait fermée. On avait enlevé simplement le volet de la porte et écarté à l’intérieur le rideau de satinette rose."
                                            },
                                            {
                                                "example_id": "c030d152-a8ee-42a0-afb6-84c580911a63",
                                                "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                                "text": "Et la boutique était là, étroite, dans l’aile d’une vieille maison, avec des volets à l’ancienne mode qu’il fallait venir accrocher du trottoir."
                                            },
                                            {
                                                "example_id": "216f8587-bcfc-4f1e-84cf-6e50ee6ee555",
                                                "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                                "text": "J’eus la tentation d’examiner, avant d’entrer, la vitrine du Salon. Un réflexe de Pyrénéen me retint. Dans mon village natal, les volets restent presque toujours clos. De l’intérieur, les femmes les manœuvrent. Elles les entrebâillent insensiblement, avec un doigté de virtuose. Du fond de leurs ténèbres, comme d’une loge de théâtre, elles se donnent le spectacle de la rue."
                                            },
                                            {
                                                "example_id": "93f6577c-f6ff-4f2b-ba8e-b4690e40e1a0",
                                                "sense_id": "dd782899-bdb3-3e03-a78d-f31bc44e5751",
                                                "text": "[…] il y a encore la fuye qui est une petite volière ». Le terme de fuie s’applique donc jusqu’à l’orée du XVIIᵉ siècle à des ensembles de boulins de façades ou à des petites volières fermées par des volets avec peu de pigeons. « Ce tourillon avoit plus tost façon d’une fuye que d’une forteresse » (Carloix, VII, 12)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1377bca-f14d-3333-8034-20808203993f",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Vantail, aile ou partie d’un objet qui se replie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56c7536-b928-4715-a7e4-2a4face2a00c",
                                                "sense_id": "b1377bca-f14d-3333-8034-20808203993f",
                                                "text": "Un triptyque est composé d'un tableau central et de deux volets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32950eb2-e6c0-34a5-a62a-9000a9f9356b",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Partie mobile de l’aile d’un avion dont l’orientation permet de diriger l’appareil."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c281cf-81a3-4669-a843-6963b9e815a3",
                                                "sense_id": "32950eb2-e6c0-34a5-a62a-9000a9f9356b",
                                                "text": "Si les commandes des volets de l’avion ne répondent plus, celui-ci est en très grand danger d’accident, c’est pourquoi les commandes électroniques sont parfois doublées de commandes mécaniques pour faire face aux pannes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5473890-371b-328a-9cd6-c36f6cd403f9",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Meuble représentant un disque de couleur verte dans les armoiries. Il s’agit d’un ancien nom utilisé pour le tourteau de sinople. À rapprocher de besant, besant-tourteau, gulpe, guse, heurte, œil de faucon, ogoesse, plate, pomme, somme, tourteau et tourteau-besant."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c349069-4564-4cf6-86ff-bde7ed4d848c",
                                                "sense_id": "a5473890-371b-328a-9cd6-c36f6cd403f9",
                                                "text": "D’argent à trois tourteaux de sinople (volets) mal-ordonnés, qui est du Hundred Vemmenhög en Suède → voir illustration « armoiries avec 3 volets »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a17c738-cd2d-355c-a04b-6e77eb5cba60",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Partie solidaire d'une construction intellectuelle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c719ba90-fed3-40a7-980d-e0967a027775",
                                                "sense_id": "9a17c738-cd2d-355c-a04b-6e77eb5cba60",
                                                "text": "Les activités de ce premier volet de recherche porteront ainsi sur l’élaboration d'une vision, d’un construit et d’une mesure multidimensionnels et systémiques de la performance de l’entreprise."
                                            },
                                            {
                                                "example_id": "39d27f35-a158-48f9-82bd-a7c0a844548e",
                                                "sense_id": "9a17c738-cd2d-355c-a04b-6e77eb5cba60",
                                                "text": "Cet article comporte deux volets : l’accès aux informations relatives à l’environnement détenues par les autorités publiques et la participation du public à l’élaboration des décisions ayant une incidence sur l’environnement. Seul ce second volet est traité ici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e341043-cdd9-3b38-b993-55471c1aecc5",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Partie d’un programme, d’une stratégie, d'une série."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b02f83-18f2-4834-9c47-5aabbff492c7",
                                                "sense_id": "6e341043-cdd9-3b38-b993-55471c1aecc5",
                                                "text": "Alors est-ce que Capcom est-il parvenu à reproduire l'exploit de World en livrant un volet inédit capable de ravir autant les nouveaux joueurs que les vétérans ? C'est ce qu'on va voir."
                                            },
                                            {
                                                "example_id": "a9b02405-5444-42c8-97d8-20f45684f105",
                                                "sense_id": "6e341043-cdd9-3b38-b993-55471c1aecc5",
                                                "text": "La Chine poursuit patiemment un programme d’exploration spatiale, dont le ­volet humain passe par la Lune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db00d3c7-9458-31ef-8cac-43e2b9c1476a",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Nénuphar."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38e6cee-c4b5-4eb3-bfe7-ce5109f99fdd",
                                                "sense_id": "db00d3c7-9458-31ef-8cac-43e2b9c1476a",
                                                "text": "C'est sous les « soupées » et au milieu des volets, qu'il fait le meilleur."
                                            },
                                            {
                                                "example_id": "962709c8-f786-4551-91a2-b71a71b3e6eb",
                                                "sense_id": "db00d3c7-9458-31ef-8cac-43e2b9c1476a",
                                                "text": "Tu connais ben les volets, ça quia de grandes feilles piates qui reviennent toujou sus l'eau et que le pied pousse des barattes après les fleûrs jaunes?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5694807d-47bb-30c5-8708-3de7d0657b31",
                                        "entry_id": "0ed7aeee-11b7-3308-a49a-edb79d713932",
                                        "glosses": [
                                            "Partie amovible d'un barndoor/coupe-flux permettant de laisser passer plus ou moins de lumières sur les côtés de la projection."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772a5ca0-7aeb-4f0f-bcd5-5a8db569aa9f",
                                                "sense_id": "5694807d-47bb-30c5-8708-3de7d0657b31",
                                                "text": "La troisième torche est destinée à travailler le fond et à y créer une zone claire, aux bords découpés, flous, travaillés au moyen des volets du coupe-flux dont le réflecteur a été équipé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
