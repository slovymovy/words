                "senses": [
                    {
                        "sense_id": "ecaa1179-049c-34d7-a1f3-b41eac83c1ca",
                        "entry_id": "9828d166-8044-3124-8f67-851153c00ae3",
                        "glosses": [
                            "vorübergehend zurückbleibende Partnerin in einer Lebensgemeinschaft, deren Partner oder Partnerin kurzzeitig abwesend ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a276209-f2b7-4bdb-8ba1-d850338dc71e",
                                "sense_id": "ecaa1179-049c-34d7-a1f3-b41eac83c1ca",
                                "text": "„Himmlisch kannst du sprechen, Herzkind, und einer jungen Strohwitwe, die noch dazu das Unglück hat, selbst in ihren Landläufer von Gemahl verliebt zu sein, den Kopf schon verdrehen; aber kennst du die Welt, das taube, hartmäulige Tier?“"
                            },
                            {
                                "example_id": "32c495ed-dab9-4f09-b1bd-450f40f8b12e",
                                "sense_id": "ecaa1179-049c-34d7-a1f3-b41eac83c1ca",
                                "text": "„Liduschka, die Schwiegertochter des alten Richters, die junge Strohwitwe, wie man sie im Dorfe nannte, weil ihr die Kaiserlichen ihren Mann kurze Zeit nach der Hochzeit als Soldaten weggeführt hatten, Liduschka hatte hinter dem Ofen alles gesehen und gehört, was in der Stube vorging.“"
                            },
                            {
                                "example_id": "3f4b7711-528b-43cf-ba0a-7edad183ab06",
                                "sense_id": "ecaa1179-049c-34d7-a1f3-b41eac83c1ca",
                                "text": "„Am folgenden Tage übernahm ein gutmütiger Kollege unsere Praxis und trug leicht an der Last; am zweiten Tage nach Empfang des Briefes, morgens um siebenundeinhalb Uhr, war ich zum erstenmal zu einer jungen betrübten Strohwitwe geworden, welcher von allen Vergnügungen des Daseins nichts weiter übriggeblieben war, als nach dem notdürftigsten Versiegen der Trennungstränen erst die Wohnung von hinten und vorn zu scheuern, dann die große Wäsche anzustellen und zuletzt matt, weich und wehmütig bei den Eltern Trost und Schutz zu suchen.“"
                            },
                            {
                                "example_id": "b8389ee5-e1ab-4810-a4a2-71abd562df6a",
                                "sense_id": "ecaa1179-049c-34d7-a1f3-b41eac83c1ca",
                                "text": "„Da standen nun die drei trauernden Strohwitwen den lieben langen Tag vor der verschlossenen Pforte, ergingen sich in beweglichen Klagen und forderten laut und stürmisch das ›Diebesgut‹ zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b37f9aa1-b6db-45de-9c82-cc926b7afac9",
                        "source_entry_id": "9828d166-8044-3124-8f67-851153c00ae3",
                        "source_sense_id": "ecaa1179-049c-34d7-a1f3-b41eac83c1ca",
                        "target_lang_word": "grass widow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grass widow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "765c39ce-45b2-3e93-8df0-6a65e2c30196",
                                        "entry_id": "ba635ae5-c778-3e5a-83f3-dcc9dd6f178f",
                                        "glosses": [
                                            "A married woman whose spouse is away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa585219-6056-4b95-8688-d31780ec2d1d",
                                                "sense_id": "765c39ce-45b2-3e93-8df0-6a65e2c30196",
                                                "text": "\"Can't help it. I'm a lone, lorn grass-widow, dear, but I will not sleep in my stays.\""
                                            },
                                            {
                                                "example_id": "3a336d08-874d-40bf-95c1-0dd860f65ade",
                                                "sense_id": "765c39ce-45b2-3e93-8df0-6a65e2c30196",
                                                "text": "Then Mrs. Gessler shook her head. \"Well, you've joined the biggest army on earth. You're the great American institution that never gets mentioned on Fourth of July -- a grass widow with two small children to support. The dirty bastards.\""
                                            },
                                            {
                                                "example_id": "dd82b7ab-6af7-46a7-98d7-e7309279f7fd",
                                                "sense_id": "765c39ce-45b2-3e93-8df0-6a65e2c30196",
                                                "text": "And who ever heard of a demon sending his wife a divorce? When a demon marries a daughter of mortals,he usually lets her remain a grass widow."
                                            },
                                            {
                                                "example_id": "9b8cae16-1184-4456-bd40-2466f18664fe",
                                                "sense_id": "765c39ce-45b2-3e93-8df0-6a65e2c30196",
                                                "text": "I was disappointed when it was her who opened the door and said, ‘Ah, I had a feeling you were thinking about me! Come in, come in, do! I am a grass widow.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2429c98b-b8d5-3c7e-bf29-103f4f144728",
                                        "entry_id": "ba635ae5-c778-3e5a-83f3-dcc9dd6f178f",
                                        "glosses": [
                                            "An unmarried woman who has had premarital sexual relations; a former mistress."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
