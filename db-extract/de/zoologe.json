                "senses": [
                    {
                        "sense_id": "ab5fd647-4cc6-3958-8cfd-0e2ae509d1e5",
                        "entry_id": "7a94120d-1bf5-31aa-a044-ab489d6dbfd6",
                        "glosses": [
                            "Wissenschaftler, der sich mit der Anatomie, der Physiologie und dem Verhalten der Tiere also mit der Zoologie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4db228f-9208-4258-be53-358cf395002c",
                                "sense_id": "ab5fd647-4cc6-3958-8cfd-0e2ae509d1e5",
                                "text": "Ich würde gerne als Zoologe arbeiten."
                            },
                            {
                                "example_id": "4694df21-3683-443b-aff3-6c1ed0f246f4",
                                "sense_id": "ab5fd647-4cc6-3958-8cfd-0e2ae509d1e5",
                                "text": "„Er entdeckte bzw. beschrieb erstmals etliche Pflanzenarten, untersuchte Tiere und Pflanzen auf dem Balkan, dem Kaukasus, in Südrussland und war in seinen späteren Jahren als Zoologe und Naturgeschichtler an der Universität Helsinki.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08148466-0077-401c-a7ab-ceb643175dcf",
