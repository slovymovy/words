{
    "word_family": [
        "exclusion",
        "exclusif",
        "exclusivité",
        "exclusivement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da5b7245-c320-3249-a27f-b08eea423039",
                    "sense_definition": "Renvoyer ou chasser définitivement une personne d'un groupe, d'une école ou d'une organisation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le proviseur a décidé d'<w>exclure</w> cet élève après plusieurs avertissements graves."
                        },
                        {
                            "text": "Le joueur a été <w>exclu</w> du match par l'arbitre après avoir commis une faute violente."
                        }
                    ],
                    "synonyms": [
                        "expulser",
                        "renvoyer",
                        "bannir"
                    ],
                    "antonyms": [
                        "inclure"
                    ],
                    "common_phrases": [
                        "exclure du groupe",
                        "exclure de l'école"
                    ]
                },
                {
                    "sense_id": "7b99342e-5783-3786-beed-a0e3b91f9361",
                    "sense_definition": "Écarter, éliminer ou refuser d'admettre une chose, une option ou une hypothèse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "elimination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs ne peuvent pas encore <w>exclure</w> la possibilité d'un accident technique."
                        },
                        {
                            "text": "Nous devons <w>exclure</w> cette option car elle dépasse largement notre budget actuel."
                        }
                    ],
                    "synonyms": [
                        "écarter",
                        "éliminer",
                        "rejeter"
                    ],
                    "antonyms": [
                        "inclure"
                    ],
                    "common_phrases": [
                        "exclure une hypothèse",
                        "exclure toute possibilité"
                    ]
                },
                {
                    "sense_id": "b95b7875-afcd-3847-92b0-08108455288d",
                    "sense_definition": "Être incompatible avec quelque chose au point de le rendre impossible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incompatibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux propositions s'<w>excluent</w> totalement et ne peuvent pas être acceptées ensemble."
                        },
                        {
                            "text": "La recherche du profit n'<w>exclut</w> pas le respect strict de l'environnement."
                        }
                    ],
                    "common_phrases": [
                        "s'exclure mutuellement"
                    ]
                }
            ]
        }
    ]
}