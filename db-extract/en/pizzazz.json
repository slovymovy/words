                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd14103-2958-4f46-8cc6-65102e626266",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Trotz Vollbremsung donnerte das Auto mit Schwung gegen die Wand."
                                            },
                                            {
                                                "example_id": "60623c30-ac22-4e2e-bf18-57ab3ab2efd0",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Wenn du das Seil auf die andere Seite werfen willst, musst du das mit Schwung machen."
                                            },
                                            {
                                                "example_id": "68623deb-2b84-48f6-9fae-61d3e6977c3f",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Dieser Tänzer hat einen wunderbaren Schwung in den Hüften."
                                            },
                                            {
                                                "example_id": "c7e0dc3f-db6d-427b-a820-59f10f96ccb2",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "„Er rief den Kosaken, der sein Pferd hielt, befahl ihm, die Tasche und die Flasche an sich zu nehmen, und warf seinen schweren Körper mit einem leichten Schwung in den Sattel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a46b6b7-e4fc-3181-bcb1-22e0207f9bc9",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "einen Bogen beschreibende Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e04d1b-8c1f-4be6-9845-0c3f778f6115",
                                                "sense_id": "2a46b6b7-e4fc-3181-bcb1-22e0207f9bc9",
                                                "text": "Mit einem eleganten Schwung bremste sie vor der Skihütte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
