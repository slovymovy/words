                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6e2f74e2-0b88-3911-be2e-7abc29031b83",
                        "entry_id": "ef8ad37d-bb40-3159-a029-f3171f5ed78f",
                        "glosses": [
                            "Participe présent de dévorer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "10711401-504e-4ef4-a3fc-7966b6341b16",
                                "sense_id": "6e2f74e2-0b88-3911-be2e-7abc29031b83",
                                "text": "Je m’assis cependant: je mentis l’allégresse\nPour ne pas nous trahir, dévorant ma tristesse,\nJ’ai souri, quand pleurer m’aurait été si doux !"
                            }
                        ]
                    }
