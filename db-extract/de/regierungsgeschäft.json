                "senses": [
                    {
                        "sense_id": "faf91524-7261-35f1-a76b-3c837a59b353",
                        "entry_id": "27745a6f-078f-3f17-adef-b355901b7eb3",
                        "glosses": [
                            "Gesamtheit der Aufgaben/Tätigkeiten, die von einer Regierung zu bewältigen sind"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "23eef139-b8da-437a-be71-4a2fda6e2798",
                                "sense_id": "faf91524-7261-35f1-a76b-3c837a59b353",
                                "text": "„Der Junge übernimmt noch während Meneliks langer Krankheit einen Teil der Regierungsgeschäfte und wird nach dessen Tod 1913 Kaiser – mit nur 16 Jahren und zunächst ungekrönt.“"
                            },
                            {
                                "example_id": "868ee0e9-86fa-4f54-8d95-581600a8d845",
                                "sense_id": "faf91524-7261-35f1-a76b-3c837a59b353",
                                "text": "„Die Regierungsgeschäfte sollen jetzt junge Akademiker übernehmen, die in Belgien studiert haben.“"
                            },
                            {
                                "example_id": "c79b8793-ec50-4805-8341-dab2d65c6d97",
                                "sense_id": "faf91524-7261-35f1-a76b-3c837a59b353",
                                "text": "„Schon in jungen Jahren musste der Sohn des Landgrafen Philipp I. von Hessen die Regierungsgeschäfte mit übernehmen, als sein Vater plötzlich in Gefangenschaft geriet.“"
                            },
                            {
                                "example_id": "3179fbd8-0665-4cb9-b813-fb6f31dcf9f0",
                                "sense_id": "faf91524-7261-35f1-a76b-3c837a59b353",
                                "text": "„Die Regierungsgeschäfte überließ er einem fähigen Majordomus (Peshwa), dem Brahmanen Balaji Viswanath, dessen Familie in der Folgezeit ähnlich wie die Shogune in Japan die eigentliche Macht im Staate hatte.“"
                            },
                            {
                                "example_id": "71e95536-d897-4682-b529-5b2eeb8146e5",
                                "sense_id": "faf91524-7261-35f1-a76b-3c837a59b353",
                                "text": "„Von Beruf war er Chirurg, der einzige im ganzen Land. Er musste seine Regierungsgeschäfte in den Zeiten erledigen, in denen er nicht operierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
