                "senses": [
                    {
                        "sense_id": "bb286bc7-4bca-36bf-90dc-e0cc4e5410db",
                        "entry_id": "0c37c347-2609-3275-9c19-3ce24117d83d",
                        "glosses": [
                            "Spray zur Bekämpfung von Körpergeruch (insbesondere unter den Achseln)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06bdb1e-5d3d-46f3-80ba-f3e9c2bbc775",
                                "sense_id": "bb286bc7-4bca-36bf-90dc-e0cc4e5410db",
                                "text": "„Er hantierte mit jeder Menge Rollen Küchentuch, Desinfektionsmitteln und Deodorantspray.“"
                            },
                            {
                                "example_id": "e34fb422-274d-4d22-8fa1-2fc3747cfb9d",
                                "sense_id": "bb286bc7-4bca-36bf-90dc-e0cc4e5410db",
                                "text": "„Auf der Ablage vorm Spiegel stand ein Deodorantspray, das sprühte ich in das Innere, bis die Dose alle war.“"
                            },
                            {
                                "example_id": "01640e81-0f61-4c11-967e-3c234ee05dea",
                                "sense_id": "bb286bc7-4bca-36bf-90dc-e0cc4e5410db",
                                "text": "„Bevor sie zur Sprechstunde aufbricht, geht sie ins Badezimmer, macht sich frisch und benutzt das Deodorantspray ihrer Freundin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
