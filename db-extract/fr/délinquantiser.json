                "senses": [
                    {
                        "sense_id": "babe876e-a6e2-38fb-83bd-07394cd76e4e",
                        "entry_id": "61717081-85fd-37a2-92d6-e2025ad9fb05",
                        "glosses": [
                            "Considérer comme délinquant, ou donner un caractère délinquant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "586d56a3-7eb1-40e5-9d39-8d193be2ef6b",
                                "sense_id": "babe876e-a6e2-38fb-83bd-07394cd76e4e",
                                "text": "Dites la vérité, faites de la prévention sur les méfaits (et bienfaits) de cette substance, et arrêtez systématiquement de \"délinquantiser\" les consommateurs."
                            },
                            {
                                "example_id": "c28a0306-f25e-4a8a-9f00-348ec80d700c",
                                "sense_id": "babe876e-a6e2-38fb-83bd-07394cd76e4e",
                                "text": "MS a tendance à oublier le jeu (cf : TV,TV,Spoytse,TV,Spoytse,TV,COD,Wouf...) et à \"délinquantiser\" son public en plus."
                            },
                            {
                                "example_id": "dee79d65-8039-4078-8711-55f7f583b093",
                                "sense_id": "babe876e-a6e2-38fb-83bd-07394cd76e4e",
                                "text": "Le 92 & le 78 le coin des riches mais qui commence à se délinquantiser"
                            }
                        ]
