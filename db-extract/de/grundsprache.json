                                        "sense_id": "9198af98-57ef-3585-ac4c-e48eec6f5a6b",
                                        "entry_id": "54fb4866-97a7-3829-89f3-0aeb9d38e3a2",
                                        "glosses": [
                                            "A language which is reconstructed by examining similarities in existing languages in order to deduce the form and aspects of a common ancestor language that is no longer known."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
