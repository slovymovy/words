                                "sense_id": "1d81984e-e2dc-36bc-8caa-8fd7e2d3e6ee",
                                "text": "Gloria is enormously pleased with our progress."
                            },
                            {
                                "example_id": "ccf1bce5-b432-4b3a-83b4-e6fbaa7bca4d",
                                "sense_id": "1d81984e-e2dc-36bc-8caa-8fd7e2d3e6ee",
