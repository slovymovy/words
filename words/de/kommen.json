                    "sense_definition": "einen sexuellen Höhepunkt oder Orgasmus erleben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sexualitaet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie spürte eine intensive Erregung und <w>kam</w> nach wenigen Momenten."
                        },
                        {
                            "text": "Er flüsterte ihr leise ins Ohr, dass er gleich <w>komme</w>."
                        }
                    ],
                    "common_phrases": [
                        "zu früh kommen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlicher Ausdruck für das Erreichen des Orgasmus"
