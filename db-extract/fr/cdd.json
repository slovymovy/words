        "fr-extract.jsonl": [
            {
                "entry_id": "8cd97a0f-5f0f-3af6-b133-705bc8aba2e5",
                "word": "CDD",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eaff3e3f-3fd1-3db9-92bd-7eebf4b79080",
                        "entry_id": "8cd97a0f-5f0f-3af6-b133-705bc8aba2e5",
                        "glosses": [
                            "Contrat à durée déterminée, type de contrat de travail en France."
                        ],
                        "tags": [
                            "Droit du travail",
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "9da28cee-befd-4aab-9f70-47ef38afb43f",
                                "sense_id": "eaff3e3f-3fd1-3db9-92bd-7eebf4b79080",
                                "text": "Chaque village du club étant une société à part, (avec nᵒ de Siret, etc.) le nombre de CDD est ainsi illimité. Entre deux saisons, les GO peuvent s'inscrire aux Assedic."
                            },
                            {
                                "example_id": "298a70c8-4784-4390-b6be-9c34e764b65b",
                                "sense_id": "eaff3e3f-3fd1-3db9-92bd-7eebf4b79080",
                                "text": "Cette plainte n’aura pas de suite mais je resterai en arrêt-maladie jusqu’à la fin de mon CDD."
                            },
                            {
                                "example_id": "19d29ed8-4bd5-4a1d-b16b-50c83a33a53a",
                                "sense_id": "eaff3e3f-3fd1-3db9-92bd-7eebf4b79080",
                                "text": "En y arrivant, j’avais découvert la règle : on pouvait faire deux cents jours de travail annuel, ensuite on dégageait, sinon la boîte risquait les prud’hommes et la requalification des CDD en CDI."
                            }
                        ]
                    }
