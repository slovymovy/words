                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a157e3c-85f9-3797-b0ca-82502ecd3470",
                        "entry_id": "29f31d95-4c6d-3e7a-bc85-7a5e49b5b17d",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4775e6-cd18-4266-97d9-7d6d7d3f2dc1",
                                "sense_id": "5a157e3c-85f9-3797-b0ca-82502ecd3470",
                                "text": "Dans Et l’amour dans tout ça, de Shekhar Kapur, Emma Thompson incarne la maman un peu fofolle d’une documentariste jouée par Lily James."
                            },
                            {
                                "example_id": "25b6fb94-01d6-497c-b93e-27977204f08d",
                                "sense_id": "5a157e3c-85f9-3797-b0ca-82502ecd3470",
                                "text": "Quatre ans plus tard, en voici la suite : Spider-Man, Across the Spider-Versed, de Joaquim Dos Santos, Kemp Powers et Justin Thompson."
                            },
                            {
                                "example_id": "a83a3c68-6916-46fb-8bd6-cbced60d3fbd",
                                "sense_id": "5a157e3c-85f9-3797-b0ca-82502ecd3470",
                                "text": "Battu il y a huit jours, lors du dernier match de préparation des deux équipes à Lacanau (32-21), Pau n’alignera que trois recrues dans son 15 de départ : le pilier gauche Thompson-Stringer (ex-La Rochelle), l’ailier-centre Samuel Ezeala et Joe Simmonds (Exeter)."
                            }
                        ]
                    }
                ],
