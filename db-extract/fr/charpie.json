                                "target_senses": [
                                    {
                                        "sense_id": "64942e18-e59f-35b0-aa06-f2abcb1ca1a0",
                                        "entry_id": "4ca18a14-aec0-3f97-9988-5c914c7505cb",
                                        "glosses": [
                                            "устар. растеребленная ветошь, нащипанные из старой льняной ткани нитки, употреблявшиеся как перевязочный материал"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0037099-3799-474e-9cef-464c94633822",
                                                "sense_id": "64942e18-e59f-35b0-aa06-f2abcb1ca1a0",
                                                "text": "У княгини сегодня вместо обыкновенного приёма будут с двух часов щипать корпию в пользу раненых…"
                                            },
                                            {
                                                "example_id": "78e0b5b7-025b-4bee-a630-7e87b85e23ba",
                                                "sense_id": "64942e18-e59f-35b0-aa06-f2abcb1ca1a0",
                                                "text": "Здесь его накормили, обмыли израненные ноги, обложив их корпиею с арникой, дали 5 гран хины и уложили спать."
                                            }
                                        ]
                                    }
