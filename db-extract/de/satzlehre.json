                "senses": [
                    {
                        "sense_id": "6e810e28-d389-3bc4-bcdc-7e5bf226ebe0",
                        "entry_id": "4a035d38-60cd-3f0f-8538-6b1162f04d93",
                        "glosses": [
                            "deutscher Terminus für Syntax"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c564230-9fb1-4dae-bd3c-35f1a7b003be",
                                "sense_id": "6e810e28-d389-3bc4-bcdc-7e5bf226ebe0",
                                "text": "„Die Syntax oder, wie man früher allgemein und heute in den Schulgrammatiken sagt, Satzlehre, ist jener Teil einer Sprachbeschreibung, der sich mit der Ordnung der sprachlichen Teile in größeren Gebilden befaßt.“"
                            },
                            {
                                "example_id": "9b92234b-afdd-4a3b-a1b4-ac3632296eef",
                                "sense_id": "6e810e28-d389-3bc4-bcdc-7e5bf226ebe0",
                                "text": "In Sütterlins Grammatik gibt es einen dritten Teil: Satzlehre."
                            },
                            {
                                "example_id": "04898b09-bc22-4e15-9688-b2890a67c752",
                                "sense_id": "6e810e28-d389-3bc4-bcdc-7e5bf226ebe0",
                                "text": "„Sowohl in der Wortlehre als auch in der Satzlehre lassen sich bestimmte Eigenschaften der untersuchten Elemente besser erkennen, wenn man mit Proben arbeitet.“"
                            },
                            {
                                "example_id": "0a1717db-ad46-4052-9889-0131b6a19f9c",
                                "sense_id": "6e810e28-d389-3bc4-bcdc-7e5bf226ebe0",
                                "text": "„Die Bausteine der Sätze sind die Satzglieder, die nach den Regeln der Satzlehre die Satzmuster bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65c6f762-2d13-33ab-bcb3-0e8db94e0825",
                        "entry_id": "4a035d38-60cd-3f0f-8538-6b1162f04d93",
