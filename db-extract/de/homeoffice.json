                "senses": [
                    {
                        "sense_id": "bdeb423a-a033-3c48-a502-1b222049e047",
                        "entry_id": "1a02759c-159f-31e5-bd03-26ebf5f0e617",
                        "glosses": [
                            "home office, praca zdalna z domu"
                        ],
                        "tags": [
                            "professional"
                        ],
                        "examples": [
                            {
                                "example_id": "f4217ceb-6292-4248-b094-430961f3c9fa",
                                "sense_id": "bdeb423a-a033-3c48-a502-1b222049e047",
                                "text": "Das Homeoffice ist mittlerweile fester Bestandteil der Arbeitswelt",
                                "translation": "Praca z domu to obecnie integralna częścią świata pracy."
                            },
                            {
                                "example_id": "dd8d0fea-5fa1-4e09-a8fb-8c388dbfe71e",
                                "sense_id": "bdeb423a-a033-3c48-a502-1b222049e047",
                                "text": "Für das Arbeiten im Homeoffice gilt das Gleiche wie für das Arbeiten vor Ort",
                                "translation": "Dla pracy z domu obowiązuje to samo, co dla pracy na miejscu."
                            },
                            {
                                "example_id": "3dfd8979-4824-4341-b6f1-58f694fa0e02",
                                "sense_id": "bdeb423a-a033-3c48-a502-1b222049e047",
                                "text": "Viele Deutsche arbeiten aus dem Homeoffice, wenn sie krank sind",
                                "translation": "Wielu Niemców pracuje z domu, gdy są chorzy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
