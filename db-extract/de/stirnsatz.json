                "senses": [
                    {
                        "sense_id": "cbbc50fa-e39d-3472-a809-3e7ba59e2d94",
                        "entry_id": "5b534bf7-6d48-328f-b0c4-51ff42596bf6",
                        "glosses": [
                            "Begriff aus der Syntax des Deutschen: Satz, bei dem das finite Verb die erste Satzgliedposition einnimmt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1288b33f-17ee-451a-b82a-c5a037ede56c",
                                "sense_id": "cbbc50fa-e39d-3472-a809-3e7ba59e2d94",
                                "text": "\"Spielt der Junge gerne Fußball\" hat das finite Verb \"spielt\" an erster Satzgliedposition und ist deshalb ein Stirnsatz."
                            },
                            {
                                "example_id": "92dd5f41-4013-416a-bb26-2db8a0216521",
                                "sense_id": "cbbc50fa-e39d-3472-a809-3e7ba59e2d94",
                                "text": "„Beim Stirnsatz steht das Finitum am Anfang des Satzes, beim Kernsatz nach dem ersten Satzglied und beim Spannsatz am Ende des Satzes.“"
                            },
                            {
                                "example_id": "27a70ebb-51ba-44b8-91a3-a46d90b69003",
                                "sense_id": "cbbc50fa-e39d-3472-a809-3e7ba59e2d94",
                                "text": "„Wie steht es nun mit der Feldeinteilung bei den beiden anderen Satztypen, dem Stirnsatz und dem Spannsatz?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
