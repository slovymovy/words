                    {
                        "sense_id": "41ae7432-d01f-3504-8b00-5cab30837517",
                        "entry_id": "d60df02b-eae2-3e8c-aea0-cdf7edfd843f",
                        "glosses": [
                            "jemand oder etwas fortdauernd beschießen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe2947a-f75d-41aa-90c3-e972f5ea5e00",
                                "sense_id": "41ae7432-d01f-3504-8b00-5cab30837517",
                                "text": "The artillery cannonaded the enemy encampment all night.",
                                "translation": "Die Artillerie beschoss das feindliche Lager die ganze Nacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30dc93fa-957e-4264-814b-08b52fb0de8a",
                        "source_entry_id": "d60df02b-eae2-3e8c-aea0-cdf7edfd843f",
                        "source_sense_id": "41ae7432-d01f-3504-8b00-5cab30837517",
                        "source_sense_description": "jemand oder etwas fortdauernd beschießen",
                        "target_lang_word": "beschießen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beschießen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bee8ea8-7e07-39b7-acf1-89770c71f79e",
                                        "entry_id": "7111a14b-1269-336f-8bd7-2439f116e90f",
                                        "glosses": [
                                            "mit einer Waffe (Schusswaffe) auf jemanden feuern (schießen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ac3783-2f3b-4daa-ad98-4652ede27d5f",
                                                "sense_id": "9bee8ea8-7e07-39b7-acf1-89770c71f79e",
                                                "text": "„Inzwischen beschießt die deutsche Artillerie die Franzosen mit ihren 21 cm Kanonen, und diese antworten mit Schrapnellfeuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "12debcb7-df50-3dc6-90c6-38e9bd99d7d0",
                                        "entry_id": "7111a14b-1269-336f-8bd7-2439f116e90f",
                                        "glosses": [
                                            "etwas, zum Beispiel Elektronen, mit hoher Geschwindigkeit abfeuern und gegen etwas anderes lenken, wo sie dann aufprallen und eine Reaktion auslösen"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74078c13-966a-4dac-b379-bb9577ad37bc",
                                                "sense_id": "12debcb7-df50-3dc6-90c6-38e9bd99d7d0",
                                                "text": "„Er brachte dazu Ammoniakmoleküle durch Hitze oder Elektrizität auf ein hohes Energieniveau und beschoss sie dann mit einem schwachen Mikrowellenstrahl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "26871c3e-16d6-3bae-8b5b-682444929eef",
                                        "entry_id": "7111a14b-1269-336f-8bd7-2439f116e90f",
                                        "glosses": [
                                            "in schneller Folge Argumente oder auch Vorwürfen äußern"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e75607-ee04-4e4f-9b6f-3189598fd087",
                                                "sense_id": "26871c3e-16d6-3bae-8b5b-682444929eef",
                                                "text": "„Sie beschossen sich mit Argumenten und Gegenargumenten, rangen um Formeln, um Redewendungen und Lehrtexte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b5fb7a72-7362-3fc7-abf9-3c041efcfd15",
                                        "entry_id": "7111a14b-1269-336f-8bd7-2439f116e90f",
                                        "glosses": [
                                            "zum Prüfen von Waffe oder Patrone mit einer Schusswaffe kontrolliert feuern"
                                        ],
                                        "tags": [
                                            "jargon",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5425379e-718c-45f8-92d5-febb11b234ca",
                                                "sense_id": "b5fb7a72-7362-3fc7-abf9-3c041efcfd15",
                                                "text": "„Eine aus bereits beschossenen höchstbeanspruchten Teilen zusammengesetzte Feuerwaffe ist zu beschießen, wenn Nacharbeiten an diesen Teilen erfolgt sind […].“"
                                            },
                                            {
                                                "example_id": "48e9e6d4-e322-4e18-9920-41fcfd4468c2",
                                                "sense_id": "b5fb7a72-7362-3fc7-abf9-3c041efcfd15",
                                                "text": "„Der Hersteller von Feuerwaffen muss diese grundsätzlich von einer zuständigen deutschen Behörde amtlich beschießen lassen, bevor er sie in Deutschland in Verkehr bringt […].“"
                                            },
                                            {
                                                "example_id": "fa1f7e34-b0cd-4d48-ac2b-3cb4daabca03",
                                                "sense_id": "b5fb7a72-7362-3fc7-abf9-3c041efcfd15",
                                                "text": "„Richard hat die Pistole beschießen lassen. Sie ist bislang noch nicht aufgefallen, dass heißt, nicht in der Datenbank. Aber der Techniker hat sofort gesehen, dass sie von [der Volkspolizei oder NVA] ist, […].“"
                                            },
                                            {
                                                "example_id": "69a09af1-0fe2-42c4-9fca-1e53de60f811",
                                                "sense_id": "b5fb7a72-7362-3fc7-abf9-3c041efcfd15",
                                                "text": "„Wenn Sie eine Waffe, die der Beschusspflicht entsprechend des Beschussgesetzes unterliegt, haben und diese beschießen lassen möchten, müssen Sie dies beantragen.“"
                                            },
                                            {
                                                "example_id": "c1a6059f-d502-4e6f-911a-f9937e26b754",
                                                "sense_id": "b5fb7a72-7362-3fc7-abf9-3c041efcfd15",
                                                "text": "„‚Die Waffe werde ich jetzt beschießen.‘ / Nils: ‚Was heißt das genau?‘ / ‚Ich werde einen kontrollierten Schuss im Waffenkanal abgeben, damit wir ein Projektil und eine Hülse von dieser Pistole haben.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
