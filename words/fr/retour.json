    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c762a54-2633-355e-b645-043ce96768f2",
                    "sense_definition": "Action de revenir ou de retourner à l'endroit d'où l'on était parti ; moment où l'on arrive de nouveau chez soi ou à son point de départ.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retour_action_de_revenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur le chemin du <w>retour</w>, nous nous sommes arrêtés pour acheter du pain."
                        },
                        {
                            "text": "Le <w>retour</w> en voiture a duré trois heures à cause des embouteillages."
                        },
                        {
                            "text": "Elle a déjà acheté son billet de <w>retour</w> pour dimanche soir."
                        }
                    ],
                    "antonyms": [
                        "départ"
                    ],
                    "common_phrases": [
                        "sur le chemin du retour",
                        "billet de retour",
                        "voyage de retour",
                        "de retour à la maison"
                    ]
                },
                {
                    "sense_id": "cec2dced-e110-315f-8712-9d9e65e967bb",
                    "sense_definition": "Réapparition d'une personne, d'une activité ou d'une situation après une absence ou une interruption ; reprise de ses fonctions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "retour_action_de_revenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>retour</w> du joueur après sa blessure a redonné de l'énergie à toute l'équipe."
                        },
                        {
                            "text": "Son <w>retour</w> aux affaires a surpris tout le monde."
                        },
                        {
                            "text": "On attend un <w>retour</w> à la normale dans les trains d'ici demain."
                        }
                    ],
                    "common_phrases": [
                        "retour en force",
                        "retour à la normale",
                        "retour aux affaires"
                    ]
                },
                {
                    "sense_id": "8328d439-22ec-341b-b8b4-e422e67634b4",
                    "sense_definition": "Réapparition d'un phénomène, d'une saison ou d'une chose qui revient après avoir disparu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retour_action_de_revenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>retour</w> du printemps rend tout le monde de bonne humeur."
                        },
                        {
                            "text": "Beaucoup de gens souhaitent le <w>retour</w> des beaux jours."
                        }
                    ],
                    "synonyms": [
                        "réapparition"
                    ],
                    "antonyms": [
                        "disparition"
                    ],
                    "common_phrases": [
                        "retour du printemps",
                        "retour des beaux jours"
                    ]
                },
                {
                    "sense_id": "e1090fc2-0447-318c-8da7-133bb032be07",
                    "sense_definition": "Réaction, avis ou commentaire donné en réponse à une action, à un produit ou à un travail.",
