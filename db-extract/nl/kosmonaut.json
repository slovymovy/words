                        "entry_id": "2166e07f-6242-3d19-a9ff-befc6e4685e6",
                        "glosses": [
                            "a (male) cosmonaut (astronaut, usually a Russian or Soviet one)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "dd9931d8-182e-4412-b9cc-8d2b842225a9",
                                "sense_id": "4a255795-69df-3a6f-b663-b6538194d0bd",
                                "text": "De eerste kosmonaut in de ruimte was Yuri Gagarin.",
                                "translation": "The first cosmonaut in space was Yuri Gagarin.",
                                "english": "The first cosmonaut in space was Yuri Gagarin."
                            },
                            {
                                "example_id": "bb3ef799-f46d-4f81-9be7-19d39e02e5f9",
                                "sense_id": "4a255795-69df-3a6f-b663-b6538194d0bd",
                                "text": "Tijdens de Koude Oorlog waren kosmonauten helden in de Sovjet-Unie.",
                                "translation": "During the Cold War, cosmonauts were heroes in the Soviet Union.",
                                "english": "During the Cold War, cosmonauts were heroes in the Soviet Union."
                            },
                            {
                                "example_id": "b3a3a04a-7210-46e0-859b-88499e81ba0c",
                                "sense_id": "4a255795-69df-3a6f-b663-b6538194d0bd",
                                "text": "De training van een kosmonaut verschilt enigszins van die van een westerse astronaut.",
                                "translation": "The training of a cosmonaut differs somewhat from that of a western astronaut.",
                                "english": "The training of a cosmonaut differs somewhat from that of a western astronaut."
                            }
                        ]
                    }
