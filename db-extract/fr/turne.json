        "fr-extract.jsonl": [
            {
                "entry_id": "29310ce8-e1d2-3701-a84a-db55796b8367",
                "word": "turne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1011ccb1-fd73-4f6e-b5ff-2d097f752d72",
                        "entry_id": "29310ce8-e1d2-3701-a84a-db55796b8367",
                        "tags": [
                            "plural"
                        ],
                        "form": "turnes"
                    },
                    {
                        "form_id": "ffcabb09-dee4-47ca-a42e-60c55ef4ef66",
                        "entry_id": "29310ce8-e1d2-3701-a84a-db55796b8367",
                        "tags": [],
                        "form": "thurne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9458b718-2973-3cde-8b44-7a5a11a3da8b",
                        "entry_id": "29310ce8-e1d2-3701-a84a-db55796b8367",
                        "glosses": [
                            "Maison, chambre, dans l’argot scolaire et universitaire."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "33e5c63a-063e-4ff9-9f5e-d0b013415faf",
                                "sense_id": "9458b718-2973-3cde-8b44-7a5a11a3da8b",
                                "text": "Lorsque nous rentrions en classe, nous les voyions se glisser hors des « turnes » où étaient les pianos, et se cacher dans nos rangs avec la démarche lourde de gens à demi sommeillant."
                            },
                            {
                                "example_id": "0c05655e-3da1-49b3-a180-4075e06dc285",
                                "sense_id": "9458b718-2973-3cde-8b44-7a5a11a3da8b",
                                "text": "Je visitai les dortoirs et les turnes de l’École normale, je grimpai rituellement sur les toits."
                            },
                            {
                                "example_id": "ee11f32a-36d3-4a82-ada5-2b95b90e7796",
                                "sense_id": "9458b718-2973-3cde-8b44-7a5a11a3da8b",
                                "text": "Et alors vous allez me libérer les locaux avant ce soir, vous entendez ? J’veux les turnes impeccables, les draps en tas dans le couloir et les clefs sur la porte ! Vous retournez crécher dans vos pays de débiles, et vous foutez le camp de ma salle de bain !"
                            }
                        ]
                    },
                    {
                        "sense_id": "592f793a-42e4-3a4d-8a11-618f951f73c6",
                        "entry_id": "29310ce8-e1d2-3701-a84a-db55796b8367",
                        "glosses": [
                            "Chambre inconfortable."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "917bc6cd-1493-486c-b611-1c76b650c7fe",
                                "sense_id": "592f793a-42e4-3a4d-8a11-618f951f73c6",
                                "text": "Voyez-vous, madame, reprit-il, un peu embarrassé, vous ne pouvez pas éternellement moisir dans cette turne."
                            },
                            {
                                "example_id": "3474e217-01c8-49d5-b383-b74625351c04",
                                "sense_id": "592f793a-42e4-3a4d-8a11-618f951f73c6",
                                "text": "« Rien qu'avec tes billets perdants, » dit Lola Albright à Gig Young, « on pourrait retapisser toute cette sale turne ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "0962b12d-9c18-3c68-aeab-f26a6b645c84",
                        "entry_id": "29310ce8-e1d2-3701-a84a-db55796b8367",
                        "glosses": [
                            "Bistrot populaire parfois mal fréquenté."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "442d1d59-40d5-4664-bac9-97491eac1556",
                                "sense_id": "0962b12d-9c18-3c68-aeab-f26a6b645c84",
                                "text": "Et tu sais pas ? — C’est Evelyn qui parle, là — six mois qu’elle bosse ici dans cette turne infâme, la pauvre petite Vivian, et pas une fois c’est arrivé qu’un de ces salauds lui paye le champagne."
                            }
                        ]
                    }
                ],
