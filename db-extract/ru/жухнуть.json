                                            },
                                            {
                                                "example_id": "306ce3ae-c806-4a9e-b3ba-e58939168935",
                                                "sense_id": "a3bbba1d-420c-3160-b98b-b95aefd3b94b",
                                                "text": "Last summer the lake completely dried up."
                                            },
