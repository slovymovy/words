                    "sense_definition": "Meervoud van <w>tand</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik poets mijn <w>tanden</w> elke ochtend en avond.",
                            "target_lang_translations": {
                                "ru": "Я чищу <w>зубы</w> каждое утро и каждый вечер.",
                                "en": "I brush my <w>teeth</w> every morning and evening.",
                                "it": "Mi lavo i <w>denti</w> ogni mattina e ogni sera."
                            }
                        },
                        {
                            "text": "De hond liet zijn scherpe <w>tanden</w> zien.",
                            "target_lang_translations": {
                                "ru": "Собака показала свои острые <w>зубы</w>.",
                                "en": "The dog showed its sharp <w>teeth</w>.",
                                "it": "Il cane ha mostrato i suoi <w>denti</w> affilati."
                            }
                        }
                    ],
                    "common_phrases": [
