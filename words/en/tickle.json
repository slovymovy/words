                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history book mentions a family named <w>Tickle</w> living in the village.",
                            "target_lang_translations": {
                                "ru": "В книге по местной истории упоминается семья по фамилии <w>Тикл</w>, жившая в этой деревне."
