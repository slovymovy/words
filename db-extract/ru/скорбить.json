                "senses": [
                    {
                        "sense_id": "608c989a-05d7-3a3d-9d94-614e8aee088d",
                        "entry_id": "7f598f56-e03c-320c-9d01-4cf5950ad4cc",
                        "glosses": [
                            "устар. скорбеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80290a92-aae8-411f-a458-8faf0b01d76d",
                                "sense_id": "608c989a-05d7-3a3d-9d94-614e8aee088d",
                                "text": "Весь флот скорбил по заместителю и радовался, что утонул князь."
                            },
                            {
                                "example_id": "dac0a08c-13b2-4b83-a62c-413ab3adcc20",
                                "sense_id": "608c989a-05d7-3a3d-9d94-614e8aee088d",
                                "text": "Как не встать рядом с тобой и не вскричать от боли, познав язвы твои, нанесённые неумелой, а тем паче злой рукой. Как не скорбить о потере рек твоих."
                            }
                        ]
                    }
                ],
