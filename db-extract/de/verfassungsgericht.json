                "senses": [
                    {
                        "sense_id": "7e417991-6249-32cc-9525-d28f4488aa1a",
                        "entry_id": "f68eb607-aa29-3885-824d-6238ef98ba96",
                        "glosses": [
                            "Gericht, das die Vereinbarkeit von Hoheitsakten mit der Verfassung überprüfen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbad0519-7be6-4883-a434-4488e8cc838e",
                                "sense_id": "7e417991-6249-32cc-9525-d28f4488aa1a",
                                "text": "In Deutschland gibt es neben dem Bundesverfassungsgericht noch die Verfassungsgerichte der Länder."
                            },
                            {
                                "example_id": "8aef89ed-091c-4438-ad1e-315ea285436e",
                                "sense_id": "7e417991-6249-32cc-9525-d28f4488aa1a",
                                "text": "In den vereinigten Staaten ist das oberste Bundesgericht zugleich auch Verfassungsgericht."
                            },
                            {
                                "example_id": "46ffde84-ff4b-4361-a917-bf7ab73ba0b1",
                                "sense_id": "7e417991-6249-32cc-9525-d28f4488aa1a",
                                "text": "„Am Verfassungsgericht streiten sie nach wie vor über die rechtmäßige Berufung der Richter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5d8e461-0d57-4852-9600-1d9904d2ddff",
