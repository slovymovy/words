        "fr-extract.jsonl": [
            {
                "entry_id": "5144c348-b531-3059-aed4-4caf6d3987db",
                "word": "merlette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd5dd47d-5431-4dbe-a3e1-9724d663f1bf",
                        "entry_id": "5144c348-b531-3059-aed4-4caf6d3987db",
                        "tags": [
                            "plural"
                        ],
                        "form": "merlettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f2a8b65-7087-33ac-85b7-aa337254c774",
                        "entry_id": "5144c348-b531-3059-aed4-4caf6d3987db",
                        "glosses": [
                            "Meuble représentant un petit oiseau morné (sans bec ni pattes) imaginaire dans les armoiries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f27f1d6-62dd-4274-8e25-486b39ba6c32",
                                "sense_id": "2f2a8b65-7087-33ac-85b7-aa337254c774",
                                "text": "d’azur, au cygne d’argent, becqué et membré de gueules, au chef d’or, chargé de trois merlettes de sable."
                            },
                            {
                                "example_id": "1b899557-e9f1-4a16-a177-5de76a1aff8b",
                                "sense_id": "2f2a8b65-7087-33ac-85b7-aa337254c774",
                                "text": "Sont-ce des aigles déployés, des merlettes ou des alérions, ou des ailettes attachées à des foudres ?"
                            },
                            {
                                "example_id": "1fb6f043-d260-4724-9bab-28953ff28ada",
                                "sense_id": "2f2a8b65-7087-33ac-85b7-aa337254c774",
                                "text": "la canette représente la cane ou le canard ; si elle est dépourvue du bec et des pattes, elle devient une merlette."
                            },
                            {
                                "example_id": "ac95bccf-7cbc-4dec-b00e-4f8f70ecad3e",
                                "sense_id": "2f2a8b65-7087-33ac-85b7-aa337254c774",
                                "text": "Dans mon enfance, de vieilles parentes m’assuraient que les merlettes, évocatrices d’oiseaux migrateurs, signifiaient les pèlerinages et les croisades."
                            }
                        ]
                    },
                    {
                        "sense_id": "7dcebf3f-5b83-39cb-b1fa-25a490241c76",
                        "entry_id": "5144c348-b531-3059-aed4-4caf6d3987db",
                        "glosses": [
                            "Merle femelle, merlesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54a19e1b-7e02-4b8a-9154-f974d9b65d5c",
                                "sense_id": "7dcebf3f-5b83-39cb-b1fa-25a490241c76",
                                "text": "Même le merle s’envole vers le ciel une merlette à ses côtés."
                            },
                            {
                                "example_id": "3301a3f9-f750-47a8-b8a8-855308383f7b",
                                "sense_id": "7dcebf3f-5b83-39cb-b1fa-25a490241c76",
                                "text": "Il est plus jeune que Nanette pour respirer, avec elle, le chèvrefeuille et le bleuet ; tous les deux basculent et roulent hors du chemin ; une merlette leur fait, depuis la haie, des frout-frout de plumes et de feuilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "46663e06-728e-3d8a-9ce7-3d50d28cd4ce",
                        "entry_id": "5144c348-b531-3059-aed4-4caf6d3987db",
                        "glosses": [
                            "Ancienne armure de tête."
                        ],
                        "tags": [],
                        "examples": []
                    }
