                                                "example_id": "69bb3c47-a115-47bc-884c-aed2ad81d230",
                                                "sense_id": "ecd6a47d-f13f-3635-b496-24a32bbefff8",
                                                "text": "He was charged with two felonies, for possession of Xanax and wax."
                                            }
