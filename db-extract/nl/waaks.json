                                        "glosses": [
                                            "Paying attention; noticing, watching, listening, or attending closely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "139f99c1-09d1-4228-b8b6-a082b4e244bb",
                                                "sense_id": "f7e0c40c-2f89-3a7a-a05e-62cbdbfcc941",
                                                "text": "She is an attentive listener, but does not like to talk much."
                                            },
                                            {
                                                "example_id": "2a1e3a0b-4449-47a2-be99-4c37c8ca2587",
                                                "sense_id": "f7e0c40c-2f89-3a7a-a05e-62cbdbfcc941",
                                                "text": "King-of-the-Sky was sitting alone in the Leeward Village meeting-house, gesticulating to the attentive shades of night, roaring out the genealogy of his ancestors, telling the sleeping world of his greatness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88887250-126a-3bbc-976e-584f3eb5b36b",
                                        "entry_id": "265f81ca-68ca-3e1a-80e5-e9a257db3c19",
                                        "glosses": [
                                            "Courteous; mindful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffcbdeff-1932-41a2-ab26-1481246c3486",
                                                "sense_id": "88887250-126a-3bbc-976e-584f3eb5b36b",
                                                "text": "a husband attentive to his wife’s needs"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
