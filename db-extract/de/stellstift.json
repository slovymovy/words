                    {
                        "sense_id": "a32edd41-b100-3bd1-a7df-bbaa02da8554",
                        "entry_id": "e8d7070b-4001-3b03-953c-6cf2c2d2791a",
                        "glosses": [
                            "Teil eines Heizkörperventils zu Regulierung des Durchflusses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299c92d7-f59e-4a5c-879f-598a8cf6e929",
                                "sense_id": "a32edd41-b100-3bd1-a7df-bbaa02da8554",
                                "text": "In Ihrem Fall ist entweder die Stellschraube des Stellantriebs nicht in der Lage den Stellstift des Heizkörperventils komplett einzudrücken, so dass das Ventil nicht komplett geschlossen wird oder aber die Gummidichtung des Ventils ist alterungsbedingt \"ausgehärtet\", so dass die \"Schließkraft\" des Stellantriebes nicht ausreicht das Ventil komplett zu schließen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f8fef548-1845-35c4-89f6-24eb9e635183",
                        "entry_id": "e8d7070b-4001-3b03-953c-6cf2c2d2791a",
                        "glosses": [
                            "Teil eines Bücherregals, auf dem ein Regalbrett aufliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b613fa31-fbc4-4bfc-9e7a-8b477b50892f",
                                "sense_id": "f8fef548-1845-35c4-89f6-24eb9e635183",
                                "text": "Endlos sind die Diskussionen über Stellstifte für Regalbretter, Achsbreiten für die Regale selbst, Höhenbegrenzungen für die Bücherstöcke, Bücherwagengänge und -parkplätze, sowie Licht und Wärme in den Magazinen."
                            }
                        ],
