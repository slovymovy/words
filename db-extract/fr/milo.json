                        "examples": [
                            {
                                "example_id": "29a1f6dc-c91d-495f-a360-e08714f58b08",
                                "sense_id": "009e2553-59ac-3920-9785-af6a7e21e49d",
                                "text": "La Vénus de Milo est une célèbre sculpture grecque de la fin de l’époque hellénistique (vers 130-100 av. J.-C.) qui pourrait représenter la déesse Aphrodite (Vénus pour les Romains). Découverte en 1820 sur l’île de Milo, d’où son nom, elle a d’abord été attribuée à Praxitèle mais une inscription sur le socle montre qu’elle pourrait être l’œuvre d’Alexandre d’Antioche."
                            }
                        ]
                    }
