                ],
                "senses": [
                    {
                        "sense_id": "6a8939ad-82de-3c97-967d-421bbcd977e7",
                        "entry_id": "7de97db2-f318-39f1-be96-02afcef70f75",
                        "glosses": [
                            "Piquer, faire une piqure à."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b402621a-7ea8-40fc-828c-a887351a3019",
                                "sense_id": "6a8939ad-82de-3c97-967d-421bbcd977e7",
                                "text": "Ils ont alors estimé qu'ils devaient le piquouser."
                            },
                            {
                                "example_id": "a4493d73-65fd-4b48-844a-ff5111ba648e",
                                "sense_id": "6a8939ad-82de-3c97-967d-421bbcd977e7",
                                "text": "Le garçon n'est pas, comme nous avons pu le croire, en train d'embrasser sa compagne, il est en train de se faire piquouser par elle."
                            },
                            {
                                "example_id": "dc12a554-4144-495a-9fd8-e8e17c1116f5",
                                "sense_id": "6a8939ad-82de-3c97-967d-421bbcd977e7",
                                "text": "Le docteur était aux petits soins, et aux gros médocs. Tous les jours, son sbire en blouse blanche me piquousait et me faisait avaler des cachetons pour faire bonne mesure. Camisole chimique, que ça s'appelle. La camisole de force emprisonne le corps, la chimique enchaîne l'esprit."
                            }
                        ]
                    }
