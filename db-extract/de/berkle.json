                "senses": [
                    {
                        "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                        "entry_id": "0b5fdfde-e4d2-3cb0-8848-981f48866ca1",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e604c64-7e8c-4aed-82b4-0b9a6b91bd3b",
                                "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                                "text": "Frau Berkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "70548030-4b5a-4d54-9dbe-78e9be5af890",
                                "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                                "text": "Herr Berkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fa0165c7-9c85-419f-82dd-da0ccf3db3df",
                                "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                                "text": "Die Berkles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "242d6491-5990-476b-9e9c-d21ec9ae1f2a",
                                "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                                "text": "Der Berkle trägt nie die Pullover, die die Berkle ihm strickt."
                            },
                            {
                                "example_id": "db49631e-916b-48e1-bf0d-e8e44da87bab",
                                "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Berkle kommt, geht der Herr Berkle.“"
                            },
                            {
                                "example_id": "dd76a9a3-85f2-4a90-ba8b-5a7690615dc0",
                                "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                                "text": "Berkle kommt und geht."
                            },
                            {
                                "example_id": "68e83a90-4eaa-4247-bd12-a520cd2a37d7",
                                "sense_id": "7c16a225-9e53-38b2-a094-dc396ec5a2d4",
                                "text": "Berkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
