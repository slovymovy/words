                                "target_senses": [
                                    {
                                        "sense_id": "77358483-3de3-3d39-afa8-1439a2e26756",
                                        "entry_id": "a1180f3b-e1db-3c4f-86d2-5d79ef68e614",
                                        "glosses": [
                                            "A craftsperson who works metal into desired forms using a hammer and other tools, sometimes heating the metal to make it more workable, especially a blacksmith."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23986109-e798-478c-8f80-cccf49c2e207",
                                                "sense_id": "77358483-3de3-3d39-afa8-1439a2e26756",
                                                "text": "The smiths themselves were a grand lot of fellows, full of a robust, and sometimes Rabelaisian sense of humour, and between \"heats,\" they could be most entertaining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae6ee518-7758-361a-8570-2d7ac412b4dc",
                                        "entry_id": "a1180f3b-e1db-3c4f-86d2-5d79ef68e614",
                                        "glosses": [
                                            "One who makes anything; wright."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f6ef196-8eec-337e-b48f-82688949b012",
                                        "entry_id": "a1180f3b-e1db-3c4f-86d2-5d79ef68e614",
                                        "glosses": [
                                            "An artist."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "smith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "499f8ac2-f0cb-3c44-bfce-8de0fbfad078",
                                        "entry_id": "4e8f509e-2325-32a1-9652-7efa47a656d4",
                                        "glosses": [
                                            "To forge, to form, usually on an anvil; by heating and pounding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c8baa5a-f110-475e-ae02-8024c748e868",
                                                "sense_id": "499f8ac2-f0cb-3c44-bfce-8de0fbfad078",
                                                "text": "Sigurd took the very best sword\nThat the Dwarfs had ever smithed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a61ddcd5-25ee-4ee0-b3ad-f3b946eacb8e",
                        "source_entry_id": "41c99d6e-be97-38c2-841b-359aa6844243",
                        "source_sense_id": "e9767165-2377-3d6a-980b-16cee751a104",
                        "source_sense_description": "iemand die gloeiend metaal bewerkt met een hamer op een aambeeld",
                        "target_lang_word": "blacksmith",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blacksmith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                        "entry_id": "da3e2202-c3ca-3927-af89-247fb44f1322",
                                        "glosses": [
                                            "A person who forges iron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3639645-6cc1-4a08-b0f8-fb47eec6a4ec",
                                                "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                                "text": "The blacksmith may forge what Religion he pleases."
                                            },
                                            {
                                                "example_id": "8bc2279f-b644-4e99-ab0e-b57bcc51bef8",
                                                "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            },
                                            {
                                                "example_id": "1a8105e1-54ca-456a-8e9c-d5c7c8be17fb",
                                                "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                                "text": "Close to the hump-backed bridge on the lane leading into the Hambleden Valley is a mid-19th-century smithy, its inside walls hung with tools of the blacksmith's trade, though decorative wrought-ironwork is now the main product from its glowing forge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33afd6f0-b5f2-363f-8323-8e4778d96e6d",
                                        "entry_id": "da3e2202-c3ca-3927-af89-247fb44f1322",
                                        "glosses": [
                                            "A person who shoes horses."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0481bb3a-1a39-3550-9832-2c8a79fe51ad",
                                        "entry_id": "da3e2202-c3ca-3927-af89-247fb44f1322",
                                        "glosses": [
                                            "A blackish fish of the Pacific coast (Chromis punctipinnis)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blacksmith",
