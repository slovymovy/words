                        "cross_references": [
                            {
                                "target_word": "RPG",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebbfce2f-02d3-3317-9f05-e1c9eff1bd9f",
                                        "entry_id": "4d500af8-fb62-3287-92d8-e7edfb23ea91",
