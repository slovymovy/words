                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42e844d7-6d5c-307f-b360-b0c57c3a881f",
                    "sense_definition": "The act of sharing rumors or discussing other people's private lives.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant <w>gossiping</w> can easily damage trust among team members.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>сплетничанье</w> может легко разрушить доверие между членами команды."
                            }
                        },
                        {
                            "text": "She was tired of all the idle <w>gossiping</w> that took place in the office.",
                            "target_lang_translations": {
                                "ru": "Она устала от всех этих пустых <w>пересудов</w>, которые велись в офисе."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip",
                        "tittle-tattle",
                        "rumormongering"
                    ],
                    "common_phrases": [
                        "idle gossiping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по распространению слухов или обсуждению личной жизни других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетничанье",
                                "target_lang_sense_clarification": "процесс распространения сплетен"
                            },
                            {
                                "target_lang_word": "сплетни",
                                "target_lang_sense_clarification": "слухи или пересуды"
                            },
                            {
                                "target_lang_word": "судачество",
                                "target_lang_sense_clarification": "пустые пересуды"
                            },
                            {
                                "target_lang_word": "пересуды",
                                "target_lang_sense_clarification": "разговоры за спиной"
                            }
                        ]
                    }
                },
                {
