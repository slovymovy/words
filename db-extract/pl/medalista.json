                                "target_senses": [
                                    {
                                        "sense_id": "4e347084-a39c-35f3-9aff-028a3b3540c0",
                                        "entry_id": "ea25dacb-6f58-38d2-89ce-6d00d6194dae",
                                        "glosses": [
                                            "тот, кто получил медаль, награждён медалью за отличные успехи, какие-либо достижения в чём-либо или в память о чём-либо"
