                    {
                        "sense_id": "fff99c81-be2e-3b64-8100-b8036222b7f8",
                        "entry_id": "890be8b6-68ab-39e6-8892-4e5ed9fa8ada",
                        "glosses": [
                            "ξεπληρώνω χρήματα (χρέος, υποχρέωση)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c3ab2b-fc1c-4e5e-87a3-2a0810621ce5",
                                "sense_id": "fff99c81-be2e-3b64-8100-b8036222b7f8",
                                "text": "I will work hard and repay you.",
                                "translation": "Θα δουλέψω σκληρά και θα σε ξεπληρώσω."
                            }
                        ]
                    },
                    {
                        "sense_id": "289dfd46-97c4-3bdc-b735-3f54d050abc3",
                        "entry_id": "890be8b6-68ab-39e6-8892-4e5ed9fa8ada",
                        "glosses": [
                            "ανταποδίδω, ξεπληρώνω, κάνω το ίδιο ή κάτι ανάλογο προς κάτι που μου έκανε κάποιος άλλος"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43029687-0f3e-4829-8305-0156a76a1b48",
                                "sense_id": "289dfd46-97c4-3bdc-b735-3f54d050abc3",
                                "text": "I repay the favor.",
                                "translation": "Ανταποδίδω την εξυπηρέτηση."
                            },
                            {
                                "example_id": "b45e735b-8dd0-4eaf-b4a3-bbc0bc654c7e",
                                "sense_id": "289dfd46-97c4-3bdc-b735-3f54d050abc3",
                                "text": "Some day I will repay you for the good you have done for me.",
                                "translation": "Kάποια μέρα θα σου ξεπληρώσω το καλό που μου έκανες."
                            }
                        ]
                    }
                ],
