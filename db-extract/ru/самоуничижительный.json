                "senses": [
                    {
                        "sense_id": "96ee3048-6a98-3f5f-9bb2-012876ceb0ef",
                        "entry_id": "8addde53-fa90-3caf-b8db-43cbade5dc42",
                        "glosses": [
                            "книжн. проявляющий или выражающий самоуничижение; обусловленный или вызванный самоуничижением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd44af6d-7187-4730-8143-b3843f3a7761",
                                "sense_id": "96ee3048-6a98-3f5f-9bb2-012876ceb0ef",
                                "text": "Короче, устройте праздник, — этим вы избавите себя от сочувственных взглядов и самоуничижительных размышлений."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7259e81-caaf-4a7a-a90d-5e0ee106b892",
                        "source_entry_id": "8addde53-fa90-3caf-b8db-43cbade5dc42",
                        "source_sense_id": "96ee3048-6a98-3f5f-9bb2-012876ceb0ef",
                        "target_lang_word": "self-deprecating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-deprecating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5fe1f1d-c846-317b-8769-c04dae43a5f7",
                                        "entry_id": "ccfec7d4-9bac-3baa-9476-d707493ef8d3",
                                        "glosses": [
                                            "Expressing disapproval of oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a1d4680-1773-46b4-850f-8f24af5b9398",
                                                "sense_id": "c5fe1f1d-c846-317b-8769-c04dae43a5f7",
                                                "text": "Mention sex, and the English humour reflex kicks in. And we all know that self-deprecating jokes are the most effective, the most widely appreciated form of humour."
                                            },
                                            {
                                                "example_id": "e93354a1-a46b-461f-bab9-204d01726085",
                                                "sense_id": "c5fe1f1d-c846-317b-8769-c04dae43a5f7",
                                                "text": "One of the most defining outcomes of the study was the acknowledgement that the use of self-deprecating humour doesn’t necessarily have negative connotations, as previously thought."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cafb8102-9da5-30d8-86a3-6bb0d5410939",
                                        "entry_id": "ccfec7d4-9bac-3baa-9476-d707493ef8d3",
                                        "glosses": [
                                            "unassuming, modest"
                                        ],
