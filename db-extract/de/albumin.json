                                    {
                                        "sense_id": "50d3b9f3-3dcc-3bb9-a00c-f3da3c957111",
                                        "entry_id": "d1e04e32-ba0a-3e73-831c-80d68425e53e",
                                        "glosses": [
                                            "The white part of an egg; being mostly the protein albumin and water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88bca13-6614-442c-a7f3-bd0ad7b5c6a7",
                                                "sense_id": "50d3b9f3-3dcc-3bb9-a00c-f3da3c957111",
                                                "text": "The various elements found in food are the following: Starch, sugar, fats, albumen, mineral substances, indigestible substances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95a7378-7a59-3d53-9052-e73cca51b6e3",
                                        "entry_id": "d1e04e32-ba0a-3e73-831c-80d68425e53e",
