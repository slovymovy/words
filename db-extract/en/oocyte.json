                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f0f30a4-080a-4a89-823d-56e966d90fb2",
                        "source_entry_id": "e44222ce-ec71-3f8b-ab20-ba3a6c6f877b",
                        "source_sense_id": "8dbfbdc2-8488-357b-b1e8-8989acf5620f",
                        "source_sense_description": "cell that develops into egg or ovum",
                        "target_lang_word": "ovocyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovocyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3fbec33-481d-388c-ac55-02cf7114d51c",
                                        "entry_id": "cb7bc083-498c-3735-b31f-5b6e130a4e58",
                                        "glosses": [
                                            "Cellule germinale femelle située dans l’épaisseur du parenchyme ovarien et dont la maturation nucléaire et cytoplasmique l’amène à l’état d’ovule fécondable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd0e7a67-40b9-4a3e-9692-d875e98da3e7",
                                                "sense_id": "c3fbec33-481d-388c-ac55-02cf7114d51c",
                                                "text": "Que se passe-t-il lors d’une reproduction sexuée naturelle? Chez l’homme et les mammifères, la reproduction sexuée ordinaire nécessite la rencontre entre deux cellules sexuelles, le gamète mâle ou spermatozoïde, et le gamète femelle, l'ovocyte souvent appelé par abus de langage ovule."
                                            },
                                            {
                                                "example_id": "25f84d8e-6416-409f-843b-de7f48fede56",
                                                "sense_id": "c3fbec33-481d-388c-ac55-02cf7114d51c",
                                                "text": "Une variante de la technique consiste à microinjecter le noyau du spermatozoïde directement dans l’ovocyte de hamster afin de vérifier si la décondensation a lieu directement après les traitements de séparation."
                                            },
                                            {
                                                "example_id": "2cbf1122-4282-49e3-8ed7-0dd960af5054",
                                                "sense_id": "c3fbec33-481d-388c-ac55-02cf7114d51c",
                                                "text": "Chaque ovocyte primaire s'entoure d'une couche unique de cellules épithéliales aplaties, les cellules folliculaires, qui dérivent des cellules des cordons sexuels."
                                            },
                                            {
                                                "example_id": "ce41fc97-5640-48f8-9661-b4bff0abbbb8",
                                                "sense_id": "c3fbec33-481d-388c-ac55-02cf7114d51c",
                                                "text": "Mais la vitrification des ovocytes, c’est surtout, comme l’écrit Bouvet, la porte ouverte à la « congélation du désir d’enfant », c’est-à-dire mettre au congélateur ses bons ovocytes produits à 20 ans pour les ressortir dix, vingt, trente ans plus tard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46e15391-b3ed-496b-8f82-5cc9affbfa58",
                        "source_entry_id": "e44222ce-ec71-3f8b-ab20-ba3a6c6f877b",
                        "source_sense_id": "8dbfbdc2-8488-357b-b1e8-8989acf5620f",
                        "source_sense_description": "cell that develops into egg or ovum",
                        "target_lang_word": "Eizelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eizelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c526b8fb-a19b-306a-aa45-4532cfa0603b",
                                        "entry_id": "7ac62e0c-862d-366e-a315-e1514dc23c0a",
                                        "glosses": [
                                            "weibliche Keimzelle zweigeschlechtlicher Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6969c777-4f29-48c8-af53-ac9b6f41c0bb",
                                                "sense_id": "c526b8fb-a19b-306a-aa45-4532cfa0603b",
                                                "text": "Unter dem Mikroskop sehen wir eine Eizelle."
                                            },
                                            {
                                                "example_id": "d4a1cfec-b653-481a-a097-1a77101d4e4a",
                                                "sense_id": "c526b8fb-a19b-306a-aa45-4532cfa0603b",
                                                "text": "„Der Eierstock […] produziert die weiblichen Hormone und die Eizellen, die vom Eileiter […] aufgefangen werden, wo die Befruchtung stattfindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "140d17ff-c81f-4319-a00e-1fc661f4d778",
                        "source_entry_id": "e44222ce-ec71-3f8b-ab20-ba3a6c6f877b",
                        "source_sense_id": "8dbfbdc2-8488-357b-b1e8-8989acf5620f",
                        "source_sense_description": "cell that develops into egg or ovum",
                        "target_lang_word": "Ei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c631bd9-225f-3372-ab6f-26ce9a31d81b",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "eine Keimzelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0cb9b3e-3af0-491f-ac3e-406dcd293904",
                                                "sense_id": "3c631bd9-225f-3372-ab6f-26ce9a31d81b",
                                                "text": "Nur eine Spermazelle kann ein Ei befruchten."
                                            },
                                            {
                                                "example_id": "ac454862-4c4c-4340-bd69-9a8c798db932",
                                                "sense_id": "3c631bd9-225f-3372-ab6f-26ce9a31d81b",
                                                "text": "„Bei der Jungfernzeugung (Parthogenese) entwickeln sich auch unbefruchtete Eier (z.B. bei den Bienen und Blattläusen).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66a8d177-1500-32c0-a53a-785240662c11",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "ein Schalengebilde, in dem sich der Embryo oviparer Tierarten (zum Beispiel Vögel) bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c4a86d-44f0-427a-b34b-7b6fb2812ad7",
                                                "sense_id": "66a8d177-1500-32c0-a53a-785240662c11",
                                                "text": "Die Henne legt ein Ei."
                                            },
                                            {
                                                "example_id": "060d2368-affa-4c42-857c-416e6df1b5eb",
                                                "sense_id": "66a8d177-1500-32c0-a53a-785240662c11",
                                                "text": "Um ein Ei als faul zu erkennen, muss man nicht selbst Eier legen können."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "Inneres von Eiern^([2]) als Nahrungsmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aab402d-ee64-45c8-bbca-bd13dc31c5d7",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "Das weiß ein jeder, wer's auch sei, / gesund und stärkend ist das Ei. (Wilhelm Busch)"
                                            },
                                            {
                                                "example_id": "3dad6dd2-e9d8-49a5-bc96-3bb772ae32b7",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "Die Suppe wird mit geschlagenem Ei gebunden."
                                            },
                                            {
                                                "example_id": "59f8fd06-d671-4335-929d-4bb81da4f3d0",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "Kommt Ei in den Kuchen?"
                                            },
                                            {
                                                "example_id": "5f20b94a-5ab3-4286-b882-19c574a63e77",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Ich erhalte nach der Messe von den Schwestern der Anstalt ein Frühstück aus Eiern, Aufschnitt, Bouillon, Brot und Honig.“"
                                            },
                                            {
                                                "example_id": "826cca5a-d541-4abf-9c0e-3c127cf2d393",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Eier sollten Sie am besten im Kühlschrank lagern.“"
                                            },
                                            {
                                                "example_id": "2d26a651-a870-4af6-a014-f999d37dae64",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Eier haben ein vorgeschriebenes Mindesthaltbarkeitsdatum von 28 Tagen nach dem Legen.“"
                                            },
                                            {
                                                "example_id": "44e7596f-fef1-4494-82b2-9e00d98aaf68",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Eier in der Schale sind bis zu sechs Wochen im Kühlschrank haltbar.“"
                                            },
                                            {
                                                "example_id": "4edd9718-34ca-455f-b055-1a7514c39040",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Wenn Eier beim Aufschlagen faulig riechen, dürfen Sie sie nicht mehr verzehren.“"
                                            },
                                            {
                                                "example_id": "068cf6af-296a-42a7-98c1-f693d8d7697f",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Für Gerichte mit rohen Eiern verwenden Sie am besten möglichst frische Eier.“"
                                            },
                                            {
                                                "example_id": "23485991-9169-46c0-b9d1-bdff9228815e",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Da Eier Fremdgerüche annehmen, bewahren Sie Eier nicht neben stark riechenden Lebensmitteln auf.“"
                                            },
                                            {
                                                "example_id": "df6ccf03-6073-48bd-9b03-cfccec01a45f",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "„Eier lassen sich in vier Gewichtsgrößen der Güteklasse A einteilen:“ […]."
                                            },
                                            {
                                                "example_id": "4d9681c8-0dd5-492d-a83a-17cb2dab2676",
                                                "sense_id": "24b95079-9966-3bb5-bd70-6ae853fdc64f",
                                                "text": "Wirf mal das Ei her!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d9cae729-4095-3a3e-899d-fd3a1eb10601",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "ovales, dreidimensionales und entlang einer Achse symmetrisches Gebilde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0e034d1-765b-4b5c-b71d-89900bb41d81",
                                                "sense_id": "d9cae729-4095-3a3e-899d-fd3a1eb10601",
                                                "text": "Welches Ei enthält etwas Spannendes, was zum Spielen und Schokolade?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "cbaf80e4-fbaf-3718-a178-484dc9b1c19f",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "Spielball und andere rundliche Gegenstände in annähernder Eiform, die sich zum Spielen eignen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f71f60f9-db29-485f-b885-51c9715fba05",
                                                "sense_id": "cbaf80e4-fbaf-3718-a178-484dc9b1c19f",
                                                "text": "Wirf mal das Ei her!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f5c94072-59a7-3f33-81b1-64d8d0b10d6c",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "die Hoden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd15aaf2-9776-480a-b22f-989a8939f4a0",
                                                "sense_id": "f5c94072-59a7-3f33-81b1-64d8d0b10d6c",
                                                "text": "„Er hat sich die Hoden auf den Boden des Roten Platzes genagelt, um zu zeigen, dass der Kreml alle Bürger an den Eiern gepackt hat.“"
                                            },
                                            {
                                                "example_id": "12a2bd23-e998-4871-9fe3-6ce2597ad398",
                                                "sense_id": "f5c94072-59a7-3f33-81b1-64d8d0b10d6c",
                                                "text": "„Sie greift hinter sich, um seine Eier mit den Fingerspitzen zu streicheln.“"
                                            },
                                            {
                                                "example_id": "059b86d9-bd8d-42af-b04c-cae7a39ef26f",
                                                "sense_id": "f5c94072-59a7-3f33-81b1-64d8d0b10d6c",
                                                "text": "„Der andere griff vorne in seine Hose und kratzte sich an den Eiern.“"
                                            },
                                            {
                                                "example_id": "c751428d-3ad7-41fc-ad39-807702c1ab55",
                                                "sense_id": "f5c94072-59a7-3f33-81b1-64d8d0b10d6c",
                                                "text": "„Ich wollte nur noch nach Hause, dort die Kataloge der Ferienclubs durchblättern und mir dabei die Eier kraulen.“"
                                            },
                                            {
                                                "example_id": "bdb5c177-8076-4d0b-bbfc-5a7969fe0227",
                                                "sense_id": "f5c94072-59a7-3f33-81b1-64d8d0b10d6c",
                                                "text": "„Wehe, du lässt was verlauten! Ich schneide dir die Eier ab und schieb sie dir ins Maul!“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "348e02fc-ff60-368d-8532-a363ca0f1537",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "das Ei des Kolumbus, realisierbarer Gedanke, realisierbare Idee, brauchbare Erfindung, Höhepunkt, Kern, Kerngedanke"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "477b82b9-2a30-4e04-8eb6-a4a980020ad4",
                                                "sense_id": "348e02fc-ff60-368d-8532-a363ca0f1537",
                                                "text": "Mensch, deine Erfindung ist das Ei auf der Messe!"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "024db2ed-18ab-3e31-9add-bd025b48e542",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "Ausrede, Erfindung, Frechheit, Höhepunkt, Scheinargument, Sinnlosigkeit, Spitzfindigkeit, Unverfrorenheit, Unverschämtheit"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe985011-754e-4dc5-85c1-e0fa92b35888",
                                                "sense_id": "024db2ed-18ab-3e31-9add-bd025b48e542",
                                                "text": "Das war ja wohl nichts weiter als ein Ei!"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "dea3a342-04f6-3c68-80ea-70884c8eb40a",
                                        "entry_id": "e007a19f-cab9-3dd3-87e8-c05ce7810bf7",
                                        "glosses": [
                                            "für Währungseinheit, Deutsche Mark, Euro, Franken und Ähnliches"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6961167-0415-46dc-8db4-634376e9bcf0",
                                                "sense_id": "dea3a342-04f6-3c68-80ea-70884c8eb40a",
                                                "text": "Da musst du eben die zwanzig Eier für das Knöllchen abdrücken."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            }
                        ]
