                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454dea0a-5ed5-4988-8da0-4dfe3ae64543",
                                "sense_id": "6d1030ac-0292-35ce-a4f7-01acc55c523f",
                                "text": "Die Bibel verbietet nur den Genuß des Tierbluts; und zwar des Blutes warmblütiger Tiere; zumal der Opfertiere."
                            },
                            {
                                "example_id": "4850b1f0-fa28-4cc6-849f-ca7a898adc1b",
                                "sense_id": "6d1030ac-0292-35ce-a4f7-01acc55c523f",
                                "text": "Da der Test für menschliches Blut spezifisch ist, kann damit zugleich Menschen- von Tierblut unterschieden werden."
                            },
                            {
                                "example_id": "4d8092d3-11c9-426c-a636-00f8b1446dea",
                                "sense_id": "6d1030ac-0292-35ce-a4f7-01acc55c523f",
                                "text": "„Viele bedecken sich mit Ziegenhaut und lassen Flaschenkürbisse voll mit Tierblut kreisen, aus denen sie dann trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
