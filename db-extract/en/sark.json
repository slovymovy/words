                        "sense_id": "c982fc44-7745-34cf-b7b5-da027dd28837",
                        "entry_id": "3c4735fe-c57a-3572-bd4a-f612cade6b00",
                        "glosses": [
                            "A shirt or smock."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "da0a960d-1cc4-4353-9352-22fe072a7cc8",
                                "sense_id": "c982fc44-7745-34cf-b7b5-da027dd28837",
                                "text": "The next thing the watchers saw was the laird struggling up the far bank and casting his coat from him, so that he rode in his sark."
                            },
                            {
                                "example_id": "019f8769-6311-4ee9-9f33-565c5e84e302",
                                "sense_id": "c982fc44-7745-34cf-b7b5-da027dd28837",
                                "text": "Then lorek's rear claws dug into the links of Iofur's chain-mail sark and ripped downward. The whole front came away, and Iofur lurched sideways to look at the damage, leaving lorek to scramble upright again."
                            }
                        ]
                    }
