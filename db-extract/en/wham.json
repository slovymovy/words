                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d7d3fa57-e48d-355a-93db-8ae1ca24d71a",
                                        "entry_id": "9b05cb23-8848-3e95-9c3a-23ef21ac43d1",
                                        "glosses": [
                                            "gwałtownie upaść, uderzyć/walnąć (się/kogoś/o coś); ogólniej wykonać gwałtownie jakąś inną czynność"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed25910-627f-4fef-b89f-5bb23819218d",
                                                "sense_id": "d7d3fa57-e48d-355a-93db-8ae1ca24d71a",
                                                "text": "… wszystkie diabły bach do torby!"
                                            },
                                            {
                                                "example_id": "c35e4c01-343e-4ee8-9c8f-70f637c2de4e",
                                                "sense_id": "d7d3fa57-e48d-355a-93db-8ae1ca24d71a",
                                                "text": "Który chłopom mąci w łbach, tego drągiem po łbie - bach!"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
                            }
                        ]
