                                    },
                                    {
                                        "sense_id": "9ab29ac5-cc52-355f-8eff-d998bfaa307b",
                                        "entry_id": "88a464fd-82a4-3d71-aa69-6660a5e759db",
                                        "glosses": [
                                            "Rich; well-to-do."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb920e64-4c64-46a0-b94c-6fb60ac2eae3",
                                                "sense_id": "9ab29ac5-cc52-355f-8eff-d998bfaa307b",
                                                "text": "He was born to an able family."
                                            }
