                                    },
                                    {
                                        "sense_id": "016c580d-1f17-388a-b95b-6f1b5e009b9b",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "a contraption built like a mount, strong enough to support one's weight"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e94a2d90-b1be-3a54-b916-60131f97fdc8",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "A small serving of an alcoholic beverage, especially beer."
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659c59bf-2826-422d-b254-4f70aea9829f",
                                                "sense_id": "e94a2d90-b1be-3a54-b916-60131f97fdc8",
                                                "text": "1879, “Some Queer Interviews: Interview with a Pony of Beer”, Puck, Vol. 5–6, p. 435"
                                            },
                                            {
                                                "example_id": "20202ae7-8bd3-43a7-93e2-d3ac653e5b0f",
                                                "sense_id": "e94a2d90-b1be-3a54-b916-60131f97fdc8",
                                                "text": "‘I’m on the inside track,’ said a pony of beer as it went galloping down a man’s throat."
                                            },
                                            {
                                                "example_id": "0d0f23c1-2a8a-476d-84e1-2954e9675bb4",
                                                "sense_id": "e94a2d90-b1be-3a54-b916-60131f97fdc8",
                                                "text": "Demon popped into his mouth a last morsel of black bread with elastic samlet, gulped down a last pony of vodka and took his place at the table with Marina facing him across its oblong length."
                                            },
                                            {
                                                "example_id": "0864b080-b4e0-48d8-bf06-266f6fbe0f1d",
                                                "sense_id": "e94a2d90-b1be-3a54-b916-60131f97fdc8",
                                                "text": "I did not even know what a ‘pony’, a small chaser of beer, was. But of course I could not admit that. So putting on an air of nonchalance, and a deep voice, I strolled into a pub with one of the other equally naive guys and we ordered two ponies of beer.\n‘McEwans?’ asked the barman.\n‘Naw - ponies’ said I."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34b1a98f-c3d7-3903-ab00-8d0a2c6b6ecb",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "A serving of 140 millilitres of beer (formerly 5 fl oz); a quarter pint."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-South-Wales",
                                            "Western"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f7af559-38e5-355b-8f16-a22b407eefae",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "Twenty-five pounds (money)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "affd55a0-2fe8-488d-ad66-073c68a2c6b2",
                                                "sense_id": "3f7af559-38e5-355b-8f16-a22b407eefae",
                                                "text": "“You said a pony,” interposed Clavering; “my dear fellow, you said a pony, and I’ll be eternally obliged to you; and I’ll not take it as a gift—only as a loan, and pay you back in six months. I take my oath, I will.”\n“Well—well—there’s the money, Sir Francis Clavering. […] Here’s five-and-twenty for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f3f8658-871b-3a9e-bdc5-d13fcd9f44d5",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "A translation used as a study aid; loosely, a crib, a cheat-sheet."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "839aac8a-1886-4f40-97af-70882f087d02",
                                                "sense_id": "9f3f8658-871b-3a9e-bdc5-d13fcd9f44d5",
                                                "text": "She kept the dates written down in her Latin 'pony', so she didn't have to bother about who it was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a6c7b7-a089-3f2f-bc27-a95b88389376",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "A ponytail hairstyle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ad1464a-3f70-429c-a981-7e9a70f0af14",
                                                "sense_id": "32a6c7b7-a089-3f2f-bc27-a95b88389376",
                                                "text": "His hair is a semilong dull red and pulled back in a sloppy pony at the base of his neck, and his face is riddled with small freckles and grease, but out here I can see personal hygiene isn't exactly at the top of the priority list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1990ef51-ca42-321e-afe0-9105bc2d24b4",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "One horsepower."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7ef62e0-bebc-4f2d-8ec3-16fd0873be8c",
                                                "sense_id": "1990ef51-ca42-321e-afe0-9105bc2d24b4",
                                                "text": "How many ponies are under the hood?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89eef9bf-3a05-3ad5-995f-71e98bb42807",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "A dance from the 1960s in which the dancer mimics the high-stepping prance of a pony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad80d85b-9c17-48d9-ad49-3f22645c5184",
                                                "sense_id": "89eef9bf-3a05-3ad5-995f-71e98bb42807",
                                                "text": "Do the monkey, do the pony / Do the slop, do the boogaloo twist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4142c274-36d2-3897-8259-e5258c87cbfa",
                                        "entry_id": "08208aa5-846c-34d1-8658-c12b84956f0b",
                                        "glosses": [
                                            "A chorus girl of small stature."
                                        ],
