                    {
                        "translation_id": "7af77af2-83dd-4454-81ef-c16b0607c4f6",
                        "source_entry_id": "f37535f3-3955-3adf-b673-f64a542cfd2d",
                        "source_sense_id": "684fb807-4687-358f-9ea5-cbdb55005cdd",
                        "target_lang_word": "Geologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23402de4-e336-38cc-b313-23dda6918a86",
                                        "entry_id": "0b68a2b9-bb2c-3b52-8bae-385b83ccb977",
                                        "glosses": [
                                            "in der Geologie tätiger Wissenschaftler"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c828f14b-a19b-4eb0-8525-fe0bf9b474f3",
                                                "sense_id": "23402de4-e336-38cc-b313-23dda6918a86",
                                                "text": "Geologen haben im Vergleich mit Archäologen größere Chancen, in der Privatwirtschaft unterzukommen."
                                            },
                                            {
                                                "example_id": "1922ef8e-d941-4131-be66-fb7c2463bafc",
                                                "sense_id": "23402de4-e336-38cc-b313-23dda6918a86",
                                                "text": "„Meine Schwiegermutter heiratete und fuhr mit ihrem Mann zusammen nach Sachalin, wo die beiden fünfundzwanzig Jahre lang als Geologen nach Öl und anderen Bodenschätzen suchten.“"
                                            },
                                            {
                                                "example_id": "c5afdc8b-4f00-44fd-a264-36cc43f0e59f",
                                                "sense_id": "23402de4-e336-38cc-b313-23dda6918a86",
                                                "text": "„Auf der 43-tägigen Forschungsreise, die drei Teams — Mikrobiologen, Geologen und Geochemiker — von Costa Rica über die Galapagos-Inseln bis nach Hawaii führte, haben sich die Geoforscher aus Potsdam das Leben im Meeresboden genauer angeschaut.“"
                                            },
                                            {
                                                "example_id": "72db1447-19fc-4693-bfe3-1f3cf5948155",
                                                "sense_id": "23402de4-e336-38cc-b313-23dda6918a86",
                                                "text": "„Hainstock, dieser Geologe und Spezialist für Verstecke, hat die Höhle nicht durch Zufall gefunden, sondern durch einen Hinweis im Werk der Herren Happel und Reuling.“"
                                            },
                                            {
                                                "example_id": "d63ec11c-f706-4fac-ad18-51fe3d543abc",
                                                "sense_id": "23402de4-e336-38cc-b313-23dda6918a86",
                                                "text": "„Bouvard berief sich sogleich darauf, daß sie als Geologen das Recht hätten, über religiöse Fragen zu diskutieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
