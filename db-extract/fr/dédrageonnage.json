                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c27428-219f-4a73-b6c3-b75b08372349",
                                "sense_id": "06f6c9ef-40e1-3487-8a9c-cbaf841673e0",
                                "text": "Il faut donc procéder au dédrageonnage ou au bouturage."
                            },
                            {
                                "example_id": "2af8804a-4748-41bd-b14c-12940925ac15",
                                "sense_id": "06f6c9ef-40e1-3487-8a9c-cbaf841673e0",
                                "text": "Une journée de démonstration fera la part belle à la réduction de la pénibilité en cultures légumières, grâce à la mécanisation du dédrageonnage et de la récolte des plants d’artichauts."
                            },
                            {
                                "example_id": "585dcdf3-115d-4243-b9df-2801d825327d",
                                "sense_id": "06f6c9ef-40e1-3487-8a9c-cbaf841673e0",
                                "text": "Plante bisannuelle voir trisannuelle, elle est nettoyée de ses repousses en fin d’hiver (ce que l’on appelle la technique du dédrageonnage) afin de lui redonner de la vigueur pour sa prochaine production. Les drageons ainsi obtenus pourront servir à la plantation d’une nouvelle parcelle."
                            }
                        ]
                    }
