                                                "sense_id": "49c447ca-b95b-3308-8949-541f58142441",
                                                "text": "Sie kommt nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5963c6af-9beb-3e80-a08c-1877c192cf8d",
                                        "entry_id": "ad6ec583-a673-3b88-b3a5-ff38aaa8d079",
                                        "glosses": [
                                            "Negation, Negator"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d996ecc0-c399-4289-8d2d-0b7bc6dcab78",
                                                "sense_id": "5963c6af-9beb-3e80-a08c-1877c192cf8d",
                                                "text": "„A und nicht A“ ist falsch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
