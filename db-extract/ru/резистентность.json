                "translations": [
                    {
                        "translation_id": "fdf686df-d6b8-4f9b-b04e-4b74b16d2515",
                        "source_entry_id": "9082fc47-a7c6-394c-bd21-b4edca1fc60f",
                        "source_sense_id": "b0775da9-8474-3394-a67b-f2503cb192fd",
                        "target_lang_word": "resistance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resistance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d383010c-e8b7-31f8-b612-22339e6c1580",
                                        "entry_id": "d454fa4f-33b2-343a-a70e-ea1332663615",
                                        "glosses": [
                                            "The act of resisting, or the capacity to resist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3380c724-0ca3-4fbd-aa96-6dba56a69ff2",
                                                "sense_id": "d383010c-e8b7-31f8-b612-22339e6c1580",
                                                "text": "[…]this Autority of his Perſon, doth notwithſtanding lay on us an Obligation, of keeping under his Obedience, and making no warlike Reſiſtance."
                                            },
                                            {
                                                "example_id": "81083daa-f3b8-4b3c-a01d-4f34eabdc4bb",
                                                "sense_id": "d383010c-e8b7-31f8-b612-22339e6c1580",
                                                "text": "So that there can be no possible misunderstanding, both Germany and Japan can be certain beyond any shadow of a doubt that America will continue to fight for freedom until no vestige of resistance remains. Our demand has been and it remains unconditional surrender."
                                            },
                                            {
                                                "example_id": "3f574ec4-d155-44ac-a7aa-44064482e62a",
                                                "sense_id": "d383010c-e8b7-31f8-b612-22339e6c1580",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him.[…]. The captive made no resistance and came not only quietly but in a series of eager little rushes like a timid dog on a choke chain."
                                            },
                                            {
                                                "example_id": "785e796d-c099-4a7c-9875-3064385f5076",
                                                "sense_id": "d383010c-e8b7-31f8-b612-22339e6c1580",
                                                "text": "widespread resistance to the new urban development plans"
                                            },
                                            {
                                                "example_id": "c1b754d6-8fed-4040-9d33-aac7adace0ce",
                                                "sense_id": "d383010c-e8b7-31f8-b612-22339e6c1580",
                                                "text": "the resistance of bacteria to certain antibiotics"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f209ebf1-f4dd-33fe-b89e-277bf9c741d7",
                                        "entry_id": "d454fa4f-33b2-343a-a70e-ea1332663615",
                                        "glosses": [
                                            "A force that tends to oppose motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fd09be2-0589-306e-81f5-ac7f93ed0755",
                                        "entry_id": "d454fa4f-33b2-343a-a70e-ea1332663615",
                                        "glosses": [
                                            "Electrical resistance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfd272c1-d367-32d5-b05b-f21d015fe161",
                                        "entry_id": "d454fa4f-33b2-343a-a70e-ea1332663615",
                                        "glosses": [
                                            "A resistor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9d4f328-f1ed-4753-8146-b2817ea9a30a",
                                                "sense_id": "dfd272c1-d367-32d5-b05b-f21d015fe161",
                                                "text": "In our study of simple electrical circuits, we have considered a single source of E.M.F. for each individual circuit but we have learned that any number of resistances may be connected in parallel […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6b87d3-3242-35a1-9361-155917dc8ba1",
                                        "entry_id": "d454fa4f-33b2-343a-a70e-ea1332663615",
                                        "glosses": [
                                            "An underground organisation engaged in a struggle for liberation from forceful occupation; a resistance movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "099eea6b-0e6f-4932-a485-0e5e791c8b15",
                                                "sense_id": "0d6b87d3-3242-35a1-9361-155917dc8ba1",
                                                "text": "Alliance forces are stretched too thin right now to attempt to liberate the colony, but we've been doing what we can to covertly aid the local resistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c54d62c3-fdd0-4de4-84ca-dc43998b3c2b",
                        "source_entry_id": "9082fc47-a7c6-394c-bd21-b4edca1fc60f",
                        "source_sense_id": "b0775da9-8474-3394-a67b-f2503cb192fd",
                        "target_lang_word": "Resistenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Resistenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd658b05-786f-304e-82ba-ed90d1763723",
                                        "entry_id": "63a29146-2fdc-3768-8e19-f297a480c1e4",
                                        "glosses": [
                                            "Widerstandsfähigkeit einfacher Organismen (besonders: Krankheitserreger) gegen bestimmte Substanzen (besonders: Medikamente) und Einflüsse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b3e290-f2e8-46f7-aa84-aae86ffb6032",
                                                "sense_id": "bd658b05-786f-304e-82ba-ed90d1763723",
                                                "text": "Viele gram-positive Bakterien haben eine Resistenz gegen Penicillin ausgebildet."
                                            },
                                            {
                                                "example_id": "5f9bf4a2-7dce-4e9e-854a-51ea5ca15514",
                                                "sense_id": "bd658b05-786f-304e-82ba-ed90d1763723",
                                                "text": "„Seit den 1960er Jahren wurde Triticale vielerorts als Futtergetreide angebaut und zeigte eine hohe Resistenz gegen Befall durch sogenannten Mehltau – eine Reihe von Pflanzenkrankheiten, die auf Pilze als Erreger zurückgehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40c04c7e-c5f8-3d9f-84d5-89b43a730215",
                                        "entry_id": "63a29146-2fdc-3768-8e19-f297a480c1e4",
                                        "glosses": [
                                            "Widerstand"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb896cef-de0f-4051-8289-49e31286892a",
                                                "sense_id": "40c04c7e-c5f8-3d9f-84d5-89b43a730215",
                                                "text": "„… Grünzeug essen ansonsten nur Rinder. 'Gemüse ist das, was Essen isst' – in solchen Sätzen manifestiert sich die Mooksche Weltanschauung, die ihre Resistenz gegenüber kulinarischen Gesundheitstrends stolz kultiviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ff580cf-47f1-45d8-977f-842e38fc6672",
                        "source_entry_id": "9082fc47-a7c6-394c-bd21-b4edca1fc60f",
                        "source_sense_id": "b0775da9-8474-3394-a67b-f2503cb192fd",
                        "target_lang_word": "Widerstandsfähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerstandsfähigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13832d4f-b83d-3591-b5b3-40e99feb440b",
                                        "entry_id": "077335ab-f28d-3c4e-8e34-dacb84d5df95",
                                        "glosses": [
                                            "Eigenschaft, bedrohlichen Verhältnissen sich wehren zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7907d21f-3cd8-4342-af01-69e9314a7984",
                                                "sense_id": "13832d4f-b83d-3591-b5b3-40e99feb440b",
                                                "text": "„Seine Leber soll der Pathologie Beweise über eine ans Wunderbare grenzende Widerstandfähigkeit gegenüber dem Alkohol geliefert haben.“"
                                            },
                                            {
                                                "example_id": "c18d089f-b337-4e16-8a88-d2db24c95b29",
                                                "sense_id": "13832d4f-b83d-3591-b5b3-40e99feb440b",
                                                "text": "„Orissa hatte ebenfalls eine erstaunliche Widerstandsfähigkeit gezeigt, obwohl es den Zentren muslimischer Macht in Nordindien viel näher lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
