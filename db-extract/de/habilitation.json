                ],
                "senses": [
                    {
                        "sense_id": "b1d33bf8-a20b-302e-a16f-3eea88445445",
                        "entry_id": "b46f24d7-27a4-34f1-8452-9a86f18655fe",
                        "glosses": [
                            "höchstrangige Hochschulprüfung, mit der die Lehrbefähigung (Facultas Docendi) in einem wissenschaftlichen Fach festgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b95192-f5b9-491e-ab5e-44d3a4d28e0c",
                                "sense_id": "b1d33bf8-a20b-302e-a16f-3eea88445445",
                                "text": "„Eine Habilitation ist im Lebenslauf von Schavans Doktorvater nicht vermerkt.“"
                            },
                            {
                                "example_id": "97e1650f-33fe-467c-bc61-5aa3d9df6245",
                                "sense_id": "b1d33bf8-a20b-302e-a16f-3eea88445445",
                                "text": "„Die Fakultät befürwortete die Habilitation, und im Wintersemester 1908/09 erhielt Einstein die venia legendi.“"
                            },
                            {
                                "example_id": "ce8c756f-837b-4b9b-855f-5284b3cd887b",
                                "sense_id": "b1d33bf8-a20b-302e-a16f-3eea88445445",
                                "text": "„Auch darüber, wieweit diese Jahre sein Wissen vertieft, ihn mit den wichtigsten philosophischen Schriften seiner Zeit intensiver bekannt gemacht und seiner Absicht, nämlich der Habilitation, näher gebracht haben, gibt es keine konkreten historischen Hinweise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd9aea9d-4ebd-4a95-a96b-b969d50e1e11",
                        "source_entry_id": "b46f24d7-27a4-34f1-8452-9a86f18655fe",
                        "source_sense_id": "b1d33bf8-a20b-302e-a16f-3eea88445445",
                        "target_lang_word": "habilitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habilitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa991d46-3ddf-3c95-8b25-eb6a1ef1921b",
                                        "entry_id": "c77f72e3-21bd-3286-8dc9-57839af6b3b1",
                                        "glosses": [
                                            "Equipment; qualification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d7e2e67-1c67-49c3-9ccd-301f533370a9",
                                                "sense_id": "aa991d46-3ddf-3c95-8b25-eb6a1ef1921b",
                                                "text": "For the things which we formerly have spoken of, are but habilitation arms: and what is habilitation without intention and act?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc4c060-dfdf-3419-99a1-713c5d9b9fe2",
                                        "entry_id": "c77f72e3-21bd-3286-8dc9-57839af6b3b1",
                                        "glosses": [
                                            "An act of habilitating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e1292be-dae3-3c98-82cf-7064cc2bdd49",
                                        "entry_id": "c77f72e3-21bd-3286-8dc9-57839af6b3b1",
                                        "glosses": [
                                            "An academic qualification, prerequiring a PhD, required in order to gain tenure as a professor in some European universities; a thesis or dissertation presented to achieve the qualification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda19413-61a5-4874-a7d2-9decaee3e250",
                                                "sense_id": "6e1292be-dae3-3c98-82cf-7064cc2bdd49",
                                                "text": "At this same time Gadamer was at work on his habilitation with Heidegger. His habilitation, Plato's Dialectical Ethics, concerned Plato's understanding of the good, and its two leading concepts were dialogue and dialectic."
                                            },
                                            {
                                                "example_id": "a111fe63-9ec8-444e-ae47-5707b7fc2bcb",
                                                "sense_id": "6e1292be-dae3-3c98-82cf-7064cc2bdd49",
                                                "text": "For one year it had been occupied by Otfried Müller, a priest from Silesia, who was trying simultaneously to advance the work for his habilitation—truly a difficult undertaking, considering the demands of teaching two core theological courses."
                                            },
                                            {
                                                "example_id": "cc600a2b-b0c4-48bf-8703-9b0dc6444c5d",
                                                "sense_id": "6e1292be-dae3-3c98-82cf-7064cc2bdd49",
                                                "text": "In 1892 his^([Kazimierz Twardowski's]) dissertation on Descartes, Idee und Perception, appeared and was followed in 1894 by his habilitation thesis, Zur Lehre vom Inhalt und Gegenstand der Vorstellungen."
                                            },
                                            {
                                                "example_id": "b822082c-6c6b-484a-9895-ffed142cfaad",
                                                "sense_id": "6e1292be-dae3-3c98-82cf-7064cc2bdd49",
                                                "text": "In the period from 1803 to 1932 as a whole, professors of law were on average the youngest to complete their Habilitation (28.5 years), trailed by theologians (29.8 years) and natural scientists (29.8 years)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b746421f-c13f-3431-8343-4106286fde9c",
                                        "entry_id": "c77f72e3-21bd-3286-8dc9-57839af6b3b1",
                                        "glosses": [
                                            "The act of supplying money to work a mine."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
