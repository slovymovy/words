                        ]
                    },
                    {
                        "translation_id": "31b79e8b-71dc-431e-91cd-c238fcdc8bd2",
                        "source_entry_id": "19f79347-efd9-3cde-bd08-3a7de421efdc",
                        "source_sense_id": "123ba2b9-b5c6-3ae1-b976-1113f1f8b43e",
                        "source_sense_description": "device used to gather water",
                        "target_lang_word": "жура́вль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жура́вль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b4cac353-3b9f-3a53-b542-45600009d63b",
                                        "entry_id": "f159b92e-15b6-3c66-9b68-d3a338cae1d2",
                                        "glosses": [
                                            "орнитол. крупная болотная перелётная птица семейства журавлеобразных, с длинным прямым клювом и с длинными ногами и шеей (Grus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ec9e41-e9a9-4b75-80c3-30260f9c2735",
                                                "sense_id": "b4cac353-3b9f-3a53-b542-45600009d63b",
                                                "text": "Белый сибирский журавль — птица настолько редкая, что за последние сто лет сохранилось лишь два упоминания о его появлении в Башкирии."
                                            },
                                            {
                                                "example_id": "43a0cb9e-13c6-4883-949a-8be75362cca9",
                                                "sense_id": "b4cac353-3b9f-3a53-b542-45600009d63b",
                                                "text": "Журавль очень высок на ногах, шея его также очень длинна, и если б нос соответствовал другим членам, как это бывает у куликов, то ему следовало бы быть в пол-аршина длиною, но его нос, крепкий и острый к концу, тёмно-зеленоватого костяного цвета, не длиннее трёх вершков, голова небольшая."
                                            },
                                            {
                                                "example_id": "4e222843-4417-4e8e-9937-f806da3ac6c8",
                                                "sense_id": "b4cac353-3b9f-3a53-b542-45600009d63b",
                                                "text": "Не переставая победоносно рассекать пространство, журавли изредка перекликались с передовым товарищем, с вожаком, и было что-то гордое, важное, что-то несокрушимо-самоуверенное в этих громких возгласах, в этом подоблачном разговоре."
                                            },
                                            {
                                                "example_id": "dca5fbcb-1d98-4196-a2b1-eaefa4b1ee2b",
                                                "sense_id": "b4cac353-3b9f-3a53-b542-45600009d63b",
                                                "text": "И вдруг из кустов, с лесного болотца, краем которого ехал великий государь, опасливо курлыкая, поднялся с разбегу тяжёлый серый журавль."
                                            },
                                            {
                                                "example_id": "41d71489-148f-425d-b00a-b76d8721d6ae",
                                                "sense_id": "b4cac353-3b9f-3a53-b542-45600009d63b",
                                                "text": "В просторной вышине слышались печальные клики журавлей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7dda546-4eb5-38fe-a598-5dfbe837120f",
                                        "entry_id": "f159b92e-15b6-3c66-9b68-d3a338cae1d2",
                                        "glosses": [
                                            "перен. то же, что журавль в небе; нечто заманчивое, но труднодостижимое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d09375-c5b8-48d3-ad95-1e228bad3e01",
                                                "sense_id": "f7dda546-4eb5-38fe-a598-5dfbe837120f",
                                                "text": "Довольно многие люди, ещё не поймав синицу (оставив пустыми два первых «ведра»), начинают охотится за журавлём (инвестируют доходно, с заметным риском)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "жура́вль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5b732c-aba6-3cc9-9372-5db4549dd925",
                                        "entry_id": "03cf1efc-bc68-3320-af78-321f489e24a3",
                                        "glosses": [
                                            "длинный шест с противовесом, служащий рычагом для подъёма ведра с водой из колодца; колодезный журавль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df9cff9-e844-44e1-bb6c-725213ab8881",
                                                "sense_id": "5a5b732c-aba6-3cc9-9372-5db4549dd925",
                                                "text": "Так мила сердцу Натальи была установившаяся после орудийного гула тишина, что она, не шевелясь, с жадностью вслушивалась и в бесхитростные песни жаворонков, и в скрип колодезного журавля, и в шелест напитанного полынной горечью ветра."
                                            },
                                            {
                                                "example_id": "fda404da-1235-455e-a2ee-0b5c9af6b0aa",
                                                "sense_id": "5a5b732c-aba6-3cc9-9372-5db4549dd925",
                                                "text": "Изредка далеко-далеко, сквозь пелену дождя, виднелась деревенька и как будто слышалось мычание коров, лай собак, скрипение журавля на колодце — те отдалённые звуки, что слышатся в шуме дождя, когда далеко в вечернем тумане путник видит селение."
                                            },
                                            {
                                                "example_id": "d3034345-4eda-4fea-ba7d-9a0d5956b19c",
                                                "sense_id": "5a5b732c-aba6-3cc9-9372-5db4549dd925",
                                                "text": "Лет восемь назад вместо неуклюжего журавля Петрок поставил на сруб бревенчатый во́рот с цепью и узенькой двухскатной крышей от дождя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b6f1d7-002f-3d87-89f8-b1d32d015536",
                                        "entry_id": "03cf1efc-bc68-3320-af78-321f489e24a3",
                                        "glosses": [
                                            "фотогр. стойка с наклонной верхней частью"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdb86f94-ea08-3ca1-999a-f0e35bebb66d",
                                        "entry_id": "03cf1efc-bc68-3320-af78-321f489e24a3",
                                        "glosses": [
                                            "украинская плясовая песня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d149f01-df2e-4805-84d7-ebc6c044a2ba",
                                                "sense_id": "bdb86f94-ea08-3ca1-999a-f0e35bebb66d",
                                                "text": "Старый капрал, в день свадьбы доброй своей панянки, одевшись по-праздничному, бодро притопывал здоровою своею ногою под весёлую музыку мятелицы, журавля и других плясовых малороссийских песен…"
                                            },
                                            {
                                                "example_id": "d50cce29-4635-496d-b3de-29cd13adaa6f",
                                                "sense_id": "bdb86f94-ea08-3ca1-999a-f0e35bebb66d",
                                                "text": "Там плывёт лебёдкою русская дева, и около неё увивается соколом её товарищ; за ними ломаются, как одержимые духом, в шайтанской пляске; далее пристукивают казачка́ или выкидывают журавля."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
