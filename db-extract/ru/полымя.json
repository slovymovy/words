                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1852a5b-f651-4263-8083-00c0b412fe7b",
                                "sense_id": "f80069b3-a30e-3149-8fa9-dcb3e4df4400",
                                "text": "Но дымилась тихая дорога // В незакатном полыме озер (Есенин.)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83ba93f5-8e9c-40d9-ac41-d7adff074d70",
                        "source_entry_id": "aeaaf001-0530-3f93-96f1-fb0ee6c8c46b",
                        "target_lang_word": "flamme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flamme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49409072-4cdc-3da6-ac38-1eacb619d8e6",
                                        "entry_id": "0fd42586-dfe9-3356-9185-71f743dfb876",
                                        "glosses": [
                                            "Qui a de l’éclat, de l’allant, en parlant d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6faf66f4-08de-44cb-82ee-039f0ce03df8",
                                                "sense_id": "49409072-4cdc-3da6-ac38-1eacb619d8e6",
                                                "text": "Il n’est pas flamme. Il respire bien trop court."
                                            },
                                            {
                                                "example_id": "f272fde2-d66c-448c-b1d1-73e6dffae7ed",
                                                "sense_id": "49409072-4cdc-3da6-ac38-1eacb619d8e6",
                                                "text": "un brin de mimosa , qui n'est pas flamme quand elle le sort de son sac"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flamme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd07b340-5803-3494-a463-04ca576e94f7",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Lumière ascendante et mobile qui se dégage d’une matière qui brûle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "311db11e-ee0e-45bf-b394-ed389d1521df",
                                                "sense_id": "bd07b340-5803-3494-a463-04ca576e94f7",
                                                "text": "Hurtaud alluma un cigare à la flamme d’une bougie qu’on lui tendit, et se rassit lourdement."
                                            },
                                            {
                                                "example_id": "915d3faf-1f85-4edf-a2fa-b1e19b313777",
                                                "sense_id": "bd07b340-5803-3494-a463-04ca576e94f7",
                                                "text": "Les quatre façades de la maison close brûlaient en même temps et celle qui bordait le pont Saint-Michel vomissait des flammes par toutes les ouvertures."
                                            },
                                            {
                                                "example_id": "6c798a33-6d40-44dc-84d9-5979778de035",
                                                "sense_id": "bd07b340-5803-3494-a463-04ca576e94f7",
                                                "text": "Pour le gazage, on emploie les bobinoirs à broches horizontales avec tringles de tension, réglant la hauteur du passage du fil dans la flamme."
                                            },
                                            {
                                                "example_id": "0bb863f6-54d1-4336-998e-2b0b68bf7468",
                                                "sense_id": "bd07b340-5803-3494-a463-04ca576e94f7",
                                                "text": "Alors des flammes aveuglantes jaillirent dans toutes les directions autour du point où le projectile toucha terre, et l’homme qui avait sauté devint, pendant quelques secondes, un éclat de feu et disparut… entièrement."
                                            },
                                            {
                                                "example_id": "4e45f876-027e-4588-b321-02888c7268c2",
                                                "sense_id": "bd07b340-5803-3494-a463-04ca576e94f7",
                                                "text": "Nulle main laborieuse ne relèvera les toitures enfoncées ; nulle flamme ne brûlera plus aux âtres désertés."
                                            },
                                            {
                                                "example_id": "fb00c321-d564-4322-8bf0-6ccf2b4935dd",
                                                "sense_id": "bd07b340-5803-3494-a463-04ca576e94f7",
                                                "text": "Tyler présenta le briquet au gamin, qui amena sa cigarette au contact de la flamme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1df0630d-05ea-3e63-a773-9ecedaf98bf6",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Sentiment, nature, talent où il y a de la chaleur et de la générosité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a154da7-ced7-49b1-8813-3d4e94c63b30",
                                                "sense_id": "1df0630d-05ea-3e63-a773-9ecedaf98bf6",
                                                "text": "Confucius fut un sage ; s’il lui manqua un élan et une flamme refusés peut-être à sa race, sa tentative fut élevée et son but honorable."
                                            },
                                            {
                                                "example_id": "13eb47dc-19f3-49e3-9fa0-463b4b8c3c01",
                                                "sense_id": "1df0630d-05ea-3e63-a773-9ecedaf98bf6",
                                                "text": "Il disait à ce moment avoir retrouvé la flamme, après de longs moments de doute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2de4c0cc-c4a0-35b4-b37c-88dd77adccf1",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Éclat vif et passager."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f87d10-6dcc-4e09-8356-28c3f7cfb5b3",
                                                "sense_id": "2de4c0cc-c4a0-35b4-b37c-88dd77adccf1",
                                                "text": "Elle rougit positivement et une flamme brilla dans ses grands yeux bleus.\nLa rougeur passa vite et la flamme s'éteignit aussitôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfd6276b-11bc-3aeb-b074-f4f7a01210b4",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Amour."
                                        ],
                                        "tags": [
                                            "poetic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa8c7206-1891-4f47-be2d-75150a665bf4",
                                                "sense_id": "dfd6276b-11bc-3aeb-b074-f4f7a01210b4",
                                                "text": "Derik Wayne Bowers, 44 ans, a été arrêté et accusé de cyberharcèlement après avoir essayé de contacter et d’intimider son ancienne flamme par téléphone, par textos et sur Facebook."
                                            },
                                            {
                                                "example_id": "c3725efa-f181-472c-aa8d-5ffa6aa56cc8",
                                                "sense_id": "dfd6276b-11bc-3aeb-b074-f4f7a01210b4",
                                                "text": "Une amoureuse flamme. Brûler d’une flamme secrète. Déclarer sa flamme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e75239f-cb7e-3816-82ed-d16d05fdf281",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Banderole longue et étroite qui va en diminuant en pointe jusqu’à son extrémité, et qu’on attache aux mâts et aux vergues des navires."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e42d1279-297a-4b72-8082-0fd5bf603d67",
                                                "sense_id": "9e75239f-cb7e-3816-82ed-d16d05fdf281",
                                                "text": "Ils arborèrent des flammes le long de la perche aux signaux, tirèrent des coups de fusil et de pistolet, crièrent à se rompre la poitrine : Vive le gouverneur!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e795144-e650-32c1-ac14-3c7b70c5076d",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Bande d’étoffe longue et taillée en pointe qui flotte au sommet de la lance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "140488e1-11c2-3be6-b6c3-cf03034baaa4",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Ornement en forme de flamme qui termine des vases, des candélabres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbb5da08-546d-3ae5-ab00-c06212089520",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Marque appliquée sur les enveloppes postales de façon mécanique, en même temps que le cachet donnant le lieu et la date, et servant souvent à communiquer (publicité touristique, annonce d’un événement, etc.)."
                                        ],
                                        "tags": [
                                            "Poste"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3e0bb0e-cdab-36bb-9fd8-167566d58226",
                                        "entry_id": "bb335516-31fe-31c4-921a-92f2b4947290",
                                        "glosses": [
                                            "Meuble représentant la combustion d’une matière (non visible) dans les armoiries. Elle est généralement représentée à 3 pointes ondoyantes réunies à la base ; laquelle base est arrondie. Elle est souvent confondue avec le feu. Flamme peut également faire référence à un sous-ensemble d’un autre meuble (grill par exemple) soit pour qualifier la couleur de cet élément dont la couleur diffère du reste du meuble (au volcan de sable crachant des flammes de gueules), soit pour les dénombrer (dragon soufflant cinq flammes), soit pour qualifier un meuble qui d’ordinaire n’en a pas (à une tour sommée de flammes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31d847bc-d0dc-41f1-a610-236ff904c3a4",
                                                "sense_id": "a3e0bb0e-cdab-36bb-9fd8-167566d58226",
                                                "text": "D’argent, aux trois flammes de gueules, qui est de la commune de Trôo du Loir-et-Cher → voir illustration « armoiries avec 3 flammes »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flamme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb5dc72-9ed5-359a-af26-aa254867b2cb",
