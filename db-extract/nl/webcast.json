                        "glosses": [
                            "een uitzending die - in tegenstelling tot een webvideo - live wordt uitgezonden via het internet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb6c407c-694c-4fe0-80a2-2fd856f6627a",
                                "sense_id": "b7b44baa-fc26-337b-b715-1060d8f1e413",
                                "text": "Op het deeltjeslab Nikhef in Amsterdam volgden honderden fysici via een webcast de presentaties op CERN. In Genève was onder meer de Nederlandse Nobelprijswinnaar Gerard t Hooft bij de presentaties aanwezig."
                            },
                            {
                                "example_id": "cea87b59-e31b-4bf6-91dd-998be17ca881",
                                "sense_id": "b7b44baa-fc26-337b-b715-1060d8f1e413",
                                "text": "De webcast van CBS '60 Minutes Overtime' meldt dat Clinton ingeschakeld werd om de Britse legendarische rockband te vragen om eind vorig jaar eenmalig terug samen te komen voor het benefietconcert."
                            },
                            {
                                "example_id": "f02e52ab-d4a8-431b-b5fd-d09bc9ea4d18",
                                "sense_id": "b7b44baa-fc26-337b-b715-1060d8f1e413",
                                "text": "Apple-fans kunnen op donderdag 16 oktober meekijken met het media-event dat de techgigant dan houdt op de eigen campus in Cupertino. De beelden worden, net als eerder, via een webcast en een app op de Apple TV uitgezonden."
                            }
                        ]
