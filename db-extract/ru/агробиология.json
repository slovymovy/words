                ],
                "senses": [
                    {
                        "sense_id": "de5e4b6a-f7ff-30b3-b5b8-fc348f069c64",
                        "entry_id": "e6fb158d-3d2c-35cb-8f41-0f65c7bd462c",
                        "glosses": [
                            "ботан., биол. научная дисциплина, исследующая используемые в растениеводстве и животноводстве биологические закономерности, характерные для культурных растений и домашних животных"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39a0b8a0-fe71-4aa0-bf63-be85b7942aad",
                        "source_entry_id": "e6fb158d-3d2c-35cb-8f41-0f65c7bd462c",
                        "source_sense_id": "de5e4b6a-f7ff-30b3-b5b8-fc348f069c64",
                        "target_lang_word": "agrobiologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agrobiologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1869176-3383-322b-9d82-f89bf6d429db",
                                        "entry_id": "954f1b8f-b450-34e1-8452-2da6aafaf8ba",
                                        "glosses": [
                                            "Ensemble de sciences et de techniques agronomiques qui appliquent les recherches biologiques à l'agriculture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e926e34a-02eb-4c5b-ae68-688187a22e4f",
                                                "sense_id": "b1869176-3383-322b-9d82-f89bf6d429db",
                                                "text": "Pour les chercheurs de l’INRA ou des Instituts Techniques, l’agrobiologie ne semble pas en mesure de remplir les objectifs fixés par la Politique Agricole Commune jusqu'en 1992 : assurer l'autosuffisance alimentaire de la France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bcaa01-044b-33fe-aa8b-a0c83fc0a472",
                                        "entry_id": "954f1b8f-b450-34e1-8452-2da6aafaf8ba",
                                        "glosses": [
                                            "Théorie et pratique agronomique développée par Trofim Lyssenko."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15a983c4-033d-4017-9ec5-116acfaa187f",
                                                "sense_id": "c6bcaa01-044b-33fe-aa8b-a0c83fc0a472",
                                                "text": "Les kolkhoziens soviétiques ont-ils assimilé les découvertes faites dans le domaine de l’agrobiologie, et notamment les enseignements de Mitchourine et de Lyssenko ?"
                                            },
                                            {
                                                "example_id": "fbf5f3f9-f8bc-4fbc-8482-810d8229d8a3",
                                                "sense_id": "c6bcaa01-044b-33fe-aa8b-a0c83fc0a472",
                                                "text": "Les spécialistes qui l'ont vraiment voulu ont su forcer le mur de silence officiel et découvrir dans certaines bibliothèques les multiples revues soviétiques d’agrobiologie, zoologie, botanique, biologie, horticulture, sélection, élevage qui y parviennent malgré les obstacles douaniers ou policiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
