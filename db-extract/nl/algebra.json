                    {
                        "translation_id": "2ef02446-44c4-4cc3-b86f-f7b2ce4847ae",
                        "source_entry_id": "b2893040-cdd4-386f-a0f2-5638f5d8329a",
                        "source_sense_id": "cb716b1d-7024-380d-85d7-2d163e21106c",
                        "source_sense_description": "deel van de wiskunde dat zich bezighoudt met de betrekkingen van door letters...",
                        "target_lang_word": "algebra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "algebra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f7acd4b-6cfc-329c-be04-8d1d9f622454",
                                        "entry_id": "0603ca50-723f-35fd-b56f-ae521b7b0807",
                                        "glosses": [
                                            "Elementary algebra: A system for representing and manipulating unknown quantities (variables) in equations."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7612cf7-0f91-4ec2-9a8f-e9804d2a9a82",
                                                "sense_id": "7f7acd4b-6cfc-329c-be04-8d1d9f622454",
                                                "text": "Also the rule of false position, with dyuers examples not only vulgar, but some appertaynyng to the rule of Algeber."
                                            },
                                            {
                                                "example_id": "e1b8bf93-bd65-4219-8364-1a647ef117d4",
                                                "sense_id": "7f7acd4b-6cfc-329c-be04-8d1d9f622454",
                                                "text": "Let us conceive, then, of an Algebra in which the symbols x, y, z, &c. admit indifferently of the values 0 and 1, and of these values alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3dd8f44-aa81-3cd0-8236-281b44c2e360",
                                        "entry_id": "0603ca50-723f-35fd-b56f-ae521b7b0807",
                                        "glosses": [
                                            "Abstract algebra: A broad field of study in modern mathematics (often mentioned alongside analysis) loosely characterized by its concern for abstraction and symmetry, dealing with the behavior, classification, and application of a large class of objects (called algebraic structures) and the maps between them (called, most generally, morphisms)."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73376696-93e5-3ffc-a961-dbf175fdefa2",
                                        "entry_id": "0603ca50-723f-35fd-b56f-ae521b7b0807",
                                        "glosses": [
                                            "Any of several objects of study in Algebra",
                                            "A universal algebra."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d9d4a92-1c44-37ca-afb4-977d984ace70",
                                        "entry_id": "0603ca50-723f-35fd-b56f-ae521b7b0807",
                                        "glosses": [
                                            "Any of several objects of study in Algebra",
                                            "An algebraic structure consisting of a module over a commutative ring (or a vector space over a field) along with an additional binary operation that is bilinear over module (or vector) addition and scalar multiplication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8bb43e6-1786-3339-a50a-32326aa45761",
                                        "entry_id": "0603ca50-723f-35fd-b56f-ae521b7b0807",
                                        "glosses": [
                                            "A collection of subsets of a given set, such that this collection contains the empty set, and the collection is closed under unions and complements (and thereby also under intersections and differences)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14a7ef5f-8acf-3f8a-870d-1f1dc3db5a7f",
                                        "entry_id": "0603ca50-723f-35fd-b56f-ae521b7b0807",
                                        "glosses": [
                                            "A system or process (especially one that is complex or convoluted) that substitutes one thing for another, or uses signs or symbols to represent concepts or ideas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc37347b-7ace-49ff-a3a7-e27b58ed202e",
                                                "sense_id": "14a7ef5f-8acf-3f8a-870d-1f1dc3db5a7f",
                                                "text": "Fly ! Fly ! avaunt with that base cowardly gibbrish ; That Algebra of honour ; which had never Been nam'd, if all had equal courage—what?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "196ab83e-25d1-32fc-9a47-2ad464e1d39d",
                                        "entry_id": "0603ca50-723f-35fd-b56f-ae521b7b0807",
                                        "glosses": [
                                            "The surgical treatment of a dislocated or fractured bone. Also (countable): a dislocation or fracture."
                                        ],
                                        "tags": [
                                            "historical",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84fc05ff-ae57-405c-9591-671dd957cf46",
                                                "sense_id": "196ab83e-25d1-32fc-9a47-2ad464e1d39d",
                                                "text": "Ne take noon hede to brynge togidere þe parties of þe boon þat is to-broken or dislocate, til viij. daies ben goon in þe wyntir, & v. in þe somer; for þanne it schal make quytture, and be sikir from swellynge; & þanne brynge togidere þe brynkis eiþer þe disiuncture after þe techynge þat schal be seid in þe chapitle of algebra."
                                            },
                                            {
                                                "example_id": "6885bde4-1c7a-475e-9146-24c81514cbb1",
                                                "sense_id": "196ab83e-25d1-32fc-9a47-2ad464e1d39d",
                                                "text": "Algebra is used today by surgeons to mean bone-setting, i.e. the restoration of bones, and the idea of restoration is present in the mathematical context, too."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a216cb70-8cc3-44eb-b55c-43c76dcdbadc",
                        "source_entry_id": "b2893040-cdd4-386f-a0f2-5638f5d8329a",
                        "source_sense_id": "cb716b1d-7024-380d-85d7-2d163e21106c",
                        "source_sense_description": "deel van de wiskunde dat zich bezighoudt met de betrekkingen van door letters...",
                        "target_lang_word": "algèbre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "algèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5a1723a-d127-34a7-929d-f1d7cde83e5a",
                                        "entry_id": "7c86ca7c-e289-31f3-a5ff-9cec76aa7c45",
                                        "glosses": [
                                            "Branche des mathématiques qui étudie les structures algébriques, hors des notions de limite (rattachée à l’analyse) et de représentation graphique (concernant la géométrie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4b1b91c-a534-4ac5-9846-526be0c69582",
                                                "sense_id": "c5a1723a-d127-34a7-929d-f1d7cde83e5a",
                                                "text": "La Giralda, qui sert de campanile à la cathédrale et domine tous les clochers de la ville, est une ancienne tour moresque élevée par un architecte arabe nommé Geber ou Guever, inventeur de l’algèbre, à laquelle il a donné son nom."
                                            },
                                            {
                                                "example_id": "18ababc1-a078-43e3-9d9c-47936b816af2",
                                                "sense_id": "c5a1723a-d127-34a7-929d-f1d7cde83e5a",
                                                "text": "En algèbre, sentant mon interlocuteur plus calé que je ne le suis, je reprends mon rôle de disciple attentif."
                                            },
                                            {
                                                "example_id": "4f2a6c40-9327-470e-b09a-2bc532e9d6bd",
                                                "sense_id": "c5a1723a-d127-34a7-929d-f1d7cde83e5a",
                                                "text": "Je me charge de l’occuper en lui demandant un tuyau pour un problème d’algèbre…"
                                            },
                                            {
                                                "example_id": "e18f1b10-ad7c-48b5-a661-5585ceb3d1e7",
                                                "sense_id": "c5a1723a-d127-34a7-929d-f1d7cde83e5a",
                                                "text": "J’avais beau essayer de me rappeler comment il fallait raisonner, je ne parvenais pas à trouver le nombre de litres d’eau que déversaient des robinets ou ces terribles heures d’arrivée des trains qui se croisent… Mon père trouvait ces nombres en un instant par le mystérieux, miraculeux procédé de l’algèbre…"
                                            },
                                            {
                                                "example_id": "27fa6f9d-261e-45aa-8960-9082dd90bee1",
                                                "sense_id": "c5a1723a-d127-34a7-929d-f1d7cde83e5a",
                                                "text": "L’étude de ces nombres est une branche importante de l’algèbre, l’algèbre linéaire."
                                            },
                                            {
                                                "example_id": "253baf7c-84a9-4487-9f83-f2d7d0080010",
                                                "sense_id": "c5a1723a-d127-34a7-929d-f1d7cde83e5a",
                                                "text": "L’arithmétique et l’algèbre ont toujours mêlé deux traditions, théorique et pratique, que l’on peut symboliser par les noms d’Eudoxe et de Diophante, bien que leurs origines soient sans doute antérieures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ceb76c1-5923-3a36-bc74-320f56432fdb",
                                        "entry_id": "7c86ca7c-e289-31f3-a5ff-9cec76aa7c45",
                                        "glosses": [
                                            "Traité d’algèbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8669e72-78f6-457e-80f0-1955bc4f18cb",
                                                "sense_id": "9ceb76c1-5923-3a36-bc74-320f56432fdb",
                                                "text": "Acheter une algèbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5079cb0-b8a5-3997-ab9a-80dff1cb49af",
                                        "entry_id": "7c86ca7c-e289-31f3-a5ff-9cec76aa7c45",
                                        "glosses": [
                                            "Ensemble d’objets mathématiques muni de certaines propriétés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3f11938-7441-3f36-b2c0-7a6c987ada54",
                                        "entry_id": "7c86ca7c-e289-31f3-a5ff-9cec76aa7c45",
                                        "glosses": [
                                            "Se dit en parlant de quelque chose difficile à comprendre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2636c4d4-1917-4e3e-a2c0-8b5f3479d262",
                                                "sense_id": "f3f11938-7441-3f36-b2c0-7a6c987ada54",
                                                "text": "C’est de l’algèbre pour lui."
                                            },
                                            {
                                                "example_id": "589294a1-6cef-4eb4-8985-b0170e04dea8",
                                                "sense_id": "f3f11938-7441-3f36-b2c0-7a6c987ada54",
                                                "text": "Pour qui sait le déchiffrer, le blason est une algèbre, le blason est une langue."
                                            },
                                            {
                                                "example_id": "ada9eeb7-3c96-4687-84f7-867e599d27b0",
                                                "sense_id": "f3f11938-7441-3f36-b2c0-7a6c987ada54",
                                                "text": "Et puis, il y a les rapports de pouvoir entre les hommes et les femmes. Cette algèbre complexe qui a toujours favorisé le premier au détriment de la deuxième."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
