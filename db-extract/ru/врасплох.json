                        "source_sense_id": "69c409c4-d588-3221-9afc-fa9d609c0fad",
                        "target_lang_word": "unawares",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unawares",
