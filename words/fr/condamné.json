                    ]
                },
                {
                    "sense_id": "13daf6e9-f2a7-3652-88fb-870960e7dece",
                    "sense_definition": "Fermé de façon permanente ou rendu inaccessible, en parlant d'un passage ou d'une ouverture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fermeture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont emprunté un vieil escalier dont l'accès était pourtant <w>condamné</w>."
                        },
                        {
                            "text": "Nous n'avons pas pu entrer par la porte de secours car elle était entièrement <w>condamnée</w>."
                        }
                    ],
                    "common_phrases": [
                        "porte condamnée"
                    ]
                }
            ]
        },
