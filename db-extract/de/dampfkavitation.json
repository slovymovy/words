                ],
                "senses": [
                    {
                        "sense_id": "a3608c53-5c8c-36e9-9ede-fe75d9cea7d3",
                        "entry_id": "79b669c6-e75f-38b3-9be7-c1567f8ef9f7",
                        "glosses": [
                            "die unerwünschte Bildung von Hohlräumen, in Flüssigkeiten unter örtlichen Druckschwankungen (Kavitation), bei der die Hohlräume mit Dampfblasen der Umgebungsflüssigkeit gefüllt sind"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "d4e36314-1804-4c2a-815e-9af2570f10f3",
                                "sense_id": "a3608c53-5c8c-36e9-9ede-fe75d9cea7d3",
                                "text": "Liegt keine Gaskavitation, sondern nur Dampfkavitation vor, so entsteht dadurch aber keinerlei Förderstromverlust."
                            },
                            {
                                "example_id": "e2d807f7-dda9-4685-a260-1028acde8477",
                                "sense_id": "a3608c53-5c8c-36e9-9ede-fe75d9cea7d3",
                                "text": "Im Falle einer Dampfkavitation ist bei einem Aufreißen des Flüssigkeitstromes die Gefahr gegeben, dass mit Druckanstieg die ursprünglich getrennten Flüssigkeitssäulen wieder zusammenschlagen, der entstandene Hohlraum wieder geschlossen wird und hierbei es zu heftigen Druckstößen kommt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
