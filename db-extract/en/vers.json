                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a577b47-7bc5-41f2-b97c-1209069eb754",
                                                "sense_id": "6c162186-93a3-36da-9851-8882f45ac5db",
                                                "text": "Le duc d’Orléans était leur garant, leur pavillon, leur espoir. Ils le savaient futile, versatile, influençable, capable de se jeter à l’étourdie dans les entreprises les plus folles, docile à toutes les flagorneries."
                                            },
                                            {
                                                "example_id": "bff5eeb7-4c6b-40e2-b75e-7aba6291e1a4",
                                                "sense_id": "6c162186-93a3-36da-9851-8882f45ac5db",
                                                "text": "Patrick Pouyanné est décrit aussi bien par ses amis que par ses détracteurs comme un gestionnaire compétent quoique versatile de tempérament, et adepte d’un management vertical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e83e3f-4ce8-332a-a152-a18a8202a11d",
                                        "entry_id": "125fdc64-93f3-31d9-ab59-4a68c6c20542",
                                        "glosses": [
                                            "Pour des objets, qualifie l'adaptabilité à un grand nombre de situations ou d'usages, polyvalent."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c9adde2-7267-3cd9-8def-440463257031",
                                        "entry_id": "125fdc64-93f3-31d9-ab59-4a68c6c20542",
                                        "glosses": [
                                            "Dans l’armement, qualifie un vecteur capable d’effectuer plusieurs types de missions simultanément grâce à l’emport d’une grande variété d’équipements."
                                        ],
