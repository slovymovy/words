                                        "entry_id": "1cac49ee-e376-3871-bbba-ef1d2f988640",
                                        "glosses": [
                                            "in eine lateinische Sprachform bringen, dem Latein angleichen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2fecffe-33e5-4ef0-afae-aca56392469c",
                                                "sense_id": "601477af-5446-312f-97b2-93c7ca20f8f3",
                                                "text": "An den Grenzen latinisierten die Legionen, aber im Binnenlande lagen sehr wenig oder gar keine Truppen; …"
                                            },
                                            {
                                                "example_id": "53f7d500-dfdd-4b2c-8f23-44470351dc47",
                                                "sense_id": "601477af-5446-312f-97b2-93c7ca20f8f3",
                                                "text": "Die große Mehrzahl der heute gebräuchlichen (offiziellen) Namen ist der lateinischen Sprache entlehnt, nicht wenige stammen aus dem Griechischen und wurden von den Anatomen der Römerzeit (Kaiserreich) mehr oder weniger latinisiert."
                                            },
                                            {
                                                "example_id": "f0868298-7f89-4178-805c-da832db7c166",
                                                "sense_id": "601477af-5446-312f-97b2-93c7ca20f8f3",
                                                "text": "Die Verfasser sind in der Regel unter ihrem bürgerlichen Namen angeführt, auch wenn dieser im Titel des Buches latinisiert wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
