                                "sense_id": "e1244aa3-723f-3946-b615-a000a3694526",
                                "text": "Filipiny graniczą z Morzem Południowochińskim, które w ostatnich latach było epicentrum wielu napięć geopolitycznych."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6061fd72-ee3b-49de-9632-0641d6e1c6ce",
                        "source_entry_id": "363518fd-85ce-38d2-b14c-c294d916728d",
                        "source_sense_id": "8eb5e30a-c288-334a-a5e2-0ff18f3c77a4",
                        "target_lang_word": "epicentre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epicentre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbe00b6-3f6d-3d97-a288-8adf50e98460",
                                        "entry_id": "7ff76e79-3552-3cbd-bc7b-e35563ce0888",
                                        "glosses": [
                                            "The point on the land or water surface directly above the focus, or hypocentre, of an earthquake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc28a46-e2c1-4593-8238-7d9780f4eef0",
                                                "sense_id": "3cbe00b6-3f6d-3d97-a288-8adf50e98460",
                                                "text": "The epicentre isn't always the point of heaviest damage. Faults can be many kilometres long and seismic waves shake areas all along the fault."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1355883b-7723-3ca7-9cc6-f4d4c31bd524",
                                        "entry_id": "7ff76e79-3552-3cbd-bc7b-e35563ce0888",
                                        "glosses": [
                                            "The point on the surface of the earth directly above an underground explosion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03dd1e0a-562c-371f-a09b-b5b9bc6141cf",
                                        "entry_id": "7ff76e79-3552-3cbd-bc7b-e35563ce0888",
                                        "glosses": [
                                            "The focal point of any activity, especially if dangerous or destructive."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dbd8578-5b4f-44c5-a2d6-31a564040163",
                                                "sense_id": "03dd1e0a-562c-371f-a09b-b5b9bc6141cf",
                                                "text": "Eleven months after Moscow launched its full-scale invasion, Bakhmut and surrounding areas have become an epicenter of fighting, their importance growing as both sides have added forces to the battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "067daf1b-b3a0-3db5-85ce-253a409d12a7",
                                        "entry_id": "7ff76e79-3552-3cbd-bc7b-e35563ce0888",
                                        "glosses": [
                                            "The geographical area in which an ongoing disaster, illness, crisis, or other destructive event is currently most severe."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3bda1e1-bfb5-4a04-b684-0931c4110f42",
                                                "sense_id": "067daf1b-b3a0-3db5-85ce-253a409d12a7",
                                                "text": "Yan Cheng had cerebral palsy and died on January 29 while in the care of officials in Huajiahe township, Hongan county, more than 100 kilometres (62 miles) from Wuhan, the epicentre of the outbreak."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "epicentre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1088ed5e-c69d-3943-bb74-a3957ff8d1cd",
                                        "entry_id": "adf4fa49-69dd-31de-93ce-6ac65b9ba60d",
                                        "glosses": [
                                            "Of an earthquake: to have its epicentre (at a specified location)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dce24fb-aa81-4098-963e-212734c6dc77",
                                                "sense_id": "1088ed5e-c69d-3943-bb74-a3957ff8d1cd",
                                                "text": "The records of disturbances epicentering closer to the station, notably those of 1914 in Los Santos Province of the Republic of Panama, about 120 miles from Balboa Heights, have usually been less satisfactory than this record […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
