                        "examples": [
                            {
                                "example_id": "478bba53-e030-4b67-90f7-3c572d44bbbc",
                                "sense_id": "6f9f26f3-39a7-3aad-b3e0-483b6456e861",
                                "text": "Je ne compte pas m'auto-arnaquer de suite, ni tenter de vous arnaquer sans l'avoir voulu, merci."
                            },
                            {
                                "example_id": "24d490b4-c88a-40f2-a094-3a225c8a6923",
                                "sense_id": "6f9f26f3-39a7-3aad-b3e0-483b6456e861",
                                "text": "Si ça se trouve, je pourrais bien m'auto-arnaquer."
                            },
                            {
                                "example_id": "981b9f35-5994-4e5f-8a36-27593d35d055",
                                "sense_id": "6f9f26f3-39a7-3aad-b3e0-483b6456e861",
                                "text": "Libre à chacun de se faire arnaquer (et même… de s'auto-arnaquer!)"
