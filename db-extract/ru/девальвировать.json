                                        "glosses": [
                                            "To devalue, reduce in value."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "167be859-6fe1-4b0a-93a7-2000a0b931fd",
                                                "sense_id": "ef330030-dc8d-35f5-88ec-2833da166d21",
                                                "text": "Discomfort was built into the evening, as central to it as the Pirandello script, written in 1917, and which, as one critic noted, toys with how the social role built up by one character for himself is continually destroyed by another, devaluated into a sick sham existence that outsiders accept as real only out of pity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c75df0d8-0352-4592-80a8-8d759e7c5817",
                        "source_entry_id": "6dbe6d11-24d5-3eda-8577-9fcb08ad706b",
