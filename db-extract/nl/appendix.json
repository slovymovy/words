                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd05968-a209-4d34-b8e1-af9e14905247",
                                                "sense_id": "6e3eb93c-9a83-3f0b-ad05-301e6c56f0ae",
                                                "text": "Die Datentabellen stecke ich in einen Appendix am Ende des Buches."
                                            },
                                            {
                                                "example_id": "f5f9e2cf-728b-453b-8f4f-7bdd9c5e1cf4",
                                                "sense_id": "6e3eb93c-9a83-3f0b-ad05-301e6c56f0ae",
                                                "text": "„Zwei ausführliche Appendizes, A und B, mit separater Paginierung im Anhang veranschaulichen die Ergebnisse der Befragung und dienen als nützliches Hilfsmittel.“"
                                            }
                                        ],
