                        "examples": [
                            {
                                "example_id": "63cddd72-7536-4367-84eb-218fe992d665",
                                "sense_id": "e50e67b7-6f5c-3d42-971f-fd50d85dee4a",
                                "text": "Le rhénate de sodium vert formé par la fusion alcaline précédente n’est pas du tout stable; la masse fondue noircit après quelques jours, même sous vide."
                            },
                            {
                                "example_id": "51685c15-9c61-4710-bad0-5524bbf69860",
                                "sense_id": "e50e67b7-6f5c-3d42-971f-fd50d85dee4a",
                                "text": "Le mécanisme de la réaction serait analogue à celui proposé par Noddack pour la formation des rhénates en milieu alcalin."
                            }
                        ]
                    }
                ],
