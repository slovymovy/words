                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arrange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were <w>ranged</w> for inspection.",
                            "target_lang_translations": {
                                "ru": "Солдаты были <w>выстроены</w> для смотра.",
                                "tr": "Askerler denetim için <w>sıralandı</w>."
                            }
                        },
                        {
                            "text": "Books were <w>ranged</w> neatly along the wall.",
                            "target_lang_translations": {
                                "ru": "Книги были аккуратно <w>расставлены</w> вдоль стены.",
                                "tr": "Kitaplar duvar boyunca düzgünce <w>dizilmişti</w>."
                            }
                        }
                    ],
