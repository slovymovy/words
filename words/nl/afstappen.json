                            "target_lang_translations": {
                                "en": "At the next stop, we have to <w>get off</w> the bus to catch the train."
                            }
                        },
                        {
                            "text": "De passagiers konden veilig <w>afstappen</w> nadat de trein volledig tot stilstand was gekomen.",
                            "target_lang_translations": {
                                "en": "The passengers were able to <w>alight</w> safely after the train had come to a complete standstill."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstappen"
                    ],
                    "antonyms": [
                        "instappen"
                    ],
                    "common_phrases": [
