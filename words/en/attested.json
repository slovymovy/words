{
    "word_family": [
        "attest",
        "attestation",
        "attestor",
        "unattested"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45577d5f-279b-3778-8a00-86b5c22cacc4",
                    "sense_definition": "simple past and past participle of <w>attest</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness <w>attested</w> to the honesty and integrity of the accused.",
                            "target_lang_translations": {
                                "pl": "Świadek <w>zaświadczył o</w> uczciwości i prawości oskarżonego."
                            }
                        },
                        {
                            "text": "Several documents <w>attested</w> the transfer of the historic property to the city.",
                            "target_lang_translations": {
                                "pl": "Kilka dokumentów <w>poświadczało</w> przekazanie zabytkowej nieruchomości miastu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "attested to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "forma czasu przeszłego (past simple) i imiesłowu czasu przeszłego (past participle) czasownika attest; poświadczył, zaświadczył, poświadczony"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poświadczyć",
                                "target_lang_sense_clarification": "w formie przeszłej"
                            },
                            {
                                "target_lang_word": "zaświadczyć",
                                "target_lang_sense_clarification": "w formie przeszłej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d69cf6bc-b313-384d-8636-d233f4a46609",
                    "sense_definition": "Proven to be true or authentic by evidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The benefits of regular exercise are well <w>attested</w> by modern medical research.",
                            "target_lang_translations": {
                                "pl": "Korzyści z regularnych ćwiczeń są dobrze <w>potwierdzone</w> przez współczesne badania medyczne."
                            }
                        },
                        {
                            "text": "It is an <w>attested</w> fact that global temperatures have steadily increased.",
                            "target_lang_translations": {
                                "pl": "Jest <w>dowiedzionym</w> faktem, że globalne temperatury stale rosną."
                            }
                        }
                    ],
                    "synonyms": [
                        "confirmed",
                        "proven",
                        "verified"
                    ],
                    "antonyms": [
                        "unattested",
                        "unproven"
                    ],
                    "common_phrases": [
                        "well attested",
                        "attested fact"
                    ],
                    "target_lang_definitions": {
                        "pl": "udowodniony lub potwierdzony jako prawdziwy na podstawie dowodów"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "potwierdzony",
                                "target_lang_sense_clarification": "dowodami, faktami"
                            },
                            {
                                "target_lang_word": "dowiedziony",
                                "target_lang_sense_clarification": "poparty dowodami"
                            },
                            {
                                "target_lang_word": "poświadczony",
                                "target_lang_sense_clarification": "udokumentowany"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1a44d9c-ddf7-3ed6-b642-7cfd630d69e5",
                    "sense_definition": "Formally certified, verified, or confirmed as authentic or accurate, often by signature or seal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please bring an <w>attested</w> copy of your birth certificate to the appointment.",
                            "target_lang_translations": {
                                "pl": "Proszę przynieść na spotkanie <w>uwierzytelniony</w> odpis aktu urodzenia."
                            }
                        },
                        {
                            "text": "The legal department requires an <w>attested</w> document before releasing the funds.",
                            "target_lang_translations": {
                                "pl": "Dział prawny wymaga <w>poświadczonego</w> dokumentu przed wypłatą środków."
                            }
                        }
                    ],
                    "synonyms": [
                        "certified",
                        "authenticated"
                    ],
                    "common_phrases": [
                        "attested copy"
                    ],
                    "target_lang_definitions": {
                        "pl": "formalnie uwierzytelniony, poświadczony urzędowo (np. podpisem lub pieczęcią)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poświadczony",
                                "target_lang_sense_clarification": "notarialnie, urzędowo"
                            },
                            {
                                "target_lang_word": "uwierzytelniony",
                                "target_lang_sense_clarification": "dokument, odpis"
                            },
                            {
                                "target_lang_word": "zaświadczony",
                                "target_lang_sense_clarification": "oficjalnie potwierdzony"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6a7d952-d2c7-38a5-9d77-ed0fdd80f4c1",
                    "sense_definition": "Supported or confirmed by testimony or personal witness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His courageous actions during the disaster were widely <w>attested</w> by survivors.",
                            "target_lang_translations": {
                                "pl": "Jego odważne czyny podczas katastrofy zostały powszechnie <w>zaświadczone</w> przez ocalałych."
                            }
                        },
                        {
                            "text": "The writer shared an <w>attested</w> account of the events from eyewitnesses.",
                            "target_lang_translations": {
                                "pl": "Pisarz przedstawił <w>poświadczoną</w> przez naocznych świadków relację z tych wydarzeń."
                            }
                        }
                    ],
                    "synonyms": [
                        "vouched for"
                    ],
                    "target_lang_definitions": {
                        "pl": "potwierdzony zeznaniem lub relacją naocznych świadków"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zaświadczony",
                                "target_lang_sense_clarification": "przez świadków"
                            },
                            {
                                "target_lang_word": "poświadczony",
                                "target_lang_sense_clarification": "zeznaniami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3dbf23b-e7a4-311f-9387-b5e8444e65bc",
                    "sense_definition": "Proven to have occurred or existed by appearing in surviving historical records or texts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word is first <w>attested</w> in an Old English manuscript from the tenth century.",
                            "target_lang_translations": {
                                "pl": "Słowo to jest po raz pierwszy <w>poświadczone</w> w staroangielskim rękopisie z dziesiątego wieku."
                            }
                        },
                        {
                            "text": "Linguists mark reconstructed words with an asterisk when they are not directly <w>attested</w>.",
                            "target_lang_translations": {
                                "pl": "Językoznawcy oznaczają rekonstruowane słowa gwiazdką, gdy nie są one bezpośrednio <w>odnotowane w źródłach</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "recorded",
                        "documented"
                    ],
                    "antonyms": [
                        "unattested"
                    ],
                    "common_phrases": [
                        "first attested"
                    ],
                    "target_lang_definitions": {
                        "pl": "udokumentowany w zachowanych źródłach historycznych lub tekstach pisanych"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poświadczony",
                                "target_lang_sense_clarification": "w źródłach, tekstach"
                            },
                            {
                                "target_lang_word": "udokumentowany",
                                "target_lang_sense_clarification": "w źródłach historycznych"
                            },
                            {
                                "target_lang_word": "odnotowany",
                                "target_lang_sense_clarification": "w źródłach pisanych"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}