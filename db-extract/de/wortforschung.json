                "senses": [
                    {
                        "sense_id": "e47f5d7d-8c79-32a2-b969-ce80d98f1501",
                        "entry_id": "4151c8f0-de4c-39c7-98dd-c48343b6779d",
                        "glosses": [
                            "wissenschaftliche Untersuchung des Wortschatzes oder einzelner Wörter im Hinblick auf ihre Entwicklung oder ihren gegenwärtigen Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738b6fcf-569b-4707-98de-185071c32013",
                                "sense_id": "e47f5d7d-8c79-32a2-b969-ce80d98f1501",
                                "text": "„Sanders' Wörterbuch trug nicht zur Durchsetzung der historisch-vergleichenden Wortforschung bei, sondern folgte den Sprachinteressen seiner gebildeten Zeitgenossen.“"
                            },
                            {
                                "example_id": "3d03b373-f30f-4b81-a01f-a2cb5029e1f9",
                                "sense_id": "e47f5d7d-8c79-32a2-b969-ce80d98f1501",
                                "text": "„Die Ergebnisse der (Einzel-)Wortforschung sind für eine Darstellung der Wortschatzentwicklung und die historische Lexikographie unentbehrlich.“"
                            },
                            {
                                "example_id": "fc0fc97a-c980-41fc-8b04-d0df7d4d4f70",
                                "sense_id": "e47f5d7d-8c79-32a2-b969-ce80d98f1501",
                                "text": "„Die Ergebnisse ihrer Untersuchungen legt die Wortforschung herkömmlicherweise (seit der Spätantike) in alphabetisch geordneten Wörterbüchern vor…“"
                            },
                            {
                                "example_id": "cdc0ff0e-7663-43af-a64b-b90e5b81fdf3",
                                "sense_id": "e47f5d7d-8c79-32a2-b969-ce80d98f1501",
                                "text": "„Auch die im Strukturalismus und der erkenntnistheoretisch orientierten Wortforschung immer wieder betonte Relevanz des Bedeutungsbegriffs für die Erkenntnis läßt sich im Sinne der Pragmalinguistik neu interpretieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
