                "senses": [
                    {
                        "sense_id": "77edec8f-8073-3491-8231-b58df4372c44",
                        "entry_id": "ad208131-64c1-3687-8505-d8221271a27d",
                        "glosses": [
                            "Faire des roulades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6418524b-1db2-4896-9ca0-38fec82a85dc",
                                "sense_id": "77edec8f-8073-3491-8231-b58df4372c44",
                                "text": "D'autrefois, il composait lui-même des mélodies, exécutait des pastorales avec le bénin cassis qui lui faisait roulader, dans la gorge, des chants emperlés de rossignol ;"
                            },
                            {
                                "example_id": "52ae6df6-1c99-4565-b0fe-41ddc15c912e",
                                "sense_id": "77edec8f-8073-3491-8231-b58df4372c44",
                                "text": "Je veux encore comme avant. Roulader, siffloter gaiement un peu."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b888b70-2185-36a9-bfdc-d2ee11fb7491",
                        "entry_id": "ad208131-64c1-3687-8505-d8221271a27d",
                        "glosses": [
                            "Faire des roulades."
                        ],
                        "tags": [
                            "Gymnastique"
                        ],
                        "examples": [
                            {
                                "example_id": "a12fcb28-8ad5-4665-b99c-b6151613031f",
                                "sense_id": "1b888b70-2185-36a9-bfdc-d2ee11fb7491",
                                "text": "Une heure à sautiller, roulader dans le chateau gonflable de la boite du campus hier soir, c'est un scandale comme on s'est trop marrés."
                            }
                        ]
                    }
