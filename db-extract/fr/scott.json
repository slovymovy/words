                                                "example_id": "8c8c117c-270e-4d12-aad2-dbb43405225a",
                                                "sense_id": "b39673d3-46a8-3552-bb16-d0c7ca84f7c0",
                                                "text": "Renee Walters and Ashley Scott started the campaign to buy Freedom after Walters saw a viral post about buying a town “for the price of a New York apartment.”"
                                            }
