                        "target_lang_word": "мулат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мулат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e67b561a-b205-3476-8e84-bfe51bfa8d64",
                                        "entry_id": "a62c0223-798d-3e32-b954-d769ac6492af",
                                        "glosses": [
                                            "потомок от браков представителей европеоидной расы с неграми"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7bd07c-87f4-4013-bd38-bb4428a5c06a",
                                                "sense_id": "e67b561a-b205-3476-8e84-bfe51bfa8d64",
                                                "text": "Приветственно взмахивая черным кулаком и улыбаясь, проходит мулат из сенегальской пехоты."
                                            },
                                            {
                                                "example_id": "9bd99c6a-b1e2-4084-9a85-81d6b465b45e",
                                                "sense_id": "e67b561a-b205-3476-8e84-bfe51bfa8d64",
                                                "text": "Рядом с растрепанной русской шевелюрой Рудина просовывалась иногда шерстистая и курчавая голова мулата."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
