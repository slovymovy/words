                "senses": [
                    {
                        "sense_id": "9867918d-d4d5-3446-9816-7e0113d896d1",
                        "entry_id": "833ba6e4-452f-33c6-a4f3-9e911ba99e17",
                        "glosses": [
                            "Besuch eines Gottesdienstes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c282c18-507e-413a-862c-42964858ee23",
                                "sense_id": "9867918d-d4d5-3446-9816-7e0113d896d1",
                                "text": "„Dem Kirchgang am Weihnachtsmorgen konnte ich nicht ausweichen.“"
                            },
                            {
                                "example_id": "6736a651-4b6b-4adb-90a2-93d20d0f28d5",
                                "sense_id": "9867918d-d4d5-3446-9816-7e0113d896d1",
                                "text": "„Nach dem Kirchgang half ich ihr in den Wagen von Signor D. R., den wir zufällig trafen.“"
                            },
                            {
                                "example_id": "8e01e9af-2c1c-49b5-9565-a6b385e9a12d",
                                "sense_id": "9867918d-d4d5-3446-9816-7e0113d896d1",
                                "text": "„An einem Sonntagmorgen wollte er beim Kirchgang sie auflauern, aber sie kam nicht den Weg, obgleich er lange auf dem Fußsteig gewartet hatte.“"
                            },
                            {
                                "example_id": "7c61ee8a-5db8-4c10-9268-22040aa9b193",
                                "sense_id": "9867918d-d4d5-3446-9816-7e0113d896d1",
                                "text": "„Auf der hoffartigen Seite ist auch der Sturtz zu sehen, die traditionelle Kopfbedeckung beim Kirchgang der Frauen der alten, reformationsfeindlichen Nürnberger Ratsfamilien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
