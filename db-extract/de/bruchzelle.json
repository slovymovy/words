                "senses": [
                    {
                        "sense_id": "30fe27cc-9ace-33d9-981b-0fcc6fbc60cb",
                        "entry_id": "49224fe4-d5d8-33b9-8fc7-b42f43b8455a",
                        "glosses": [
                            "Flugzeugzelle, an der verschiedene statische Versuche durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf5f64d-85e8-4955-b27d-996db953e179",
                                "sense_id": "30fe27cc-9ace-33d9-981b-0fcc6fbc60cb",
                                "text": "„In einer Testhalle in Toulouse überstand eine A350-Bruchzelle die Überlastung mit dem 1,5-fachen der jemals praktisch zu erwartenden Spitzenbelastung.“"
                            },
                            {
                                "example_id": "e0af7821-fb33-4337-9a1f-82feca1300a7",
                                "sense_id": "30fe27cc-9ace-33d9-981b-0fcc6fbc60cb",
                                "text": "„Den […] Flug aus dem 4500 Kilometer entfernten Produktionsstandort Irkutsk in Sibirien absolvierte die MS-21-Bruchzelle im Frachtraum einer Antonow 124 der Volga-Dnepr Airlines. Spezialisten […] nahmen den Testrumpf in Schukowski in Empfang. Dort wird er nun für eine Reihe spezieller Belastungstests vorbereitet, die mindestens 180.000 Flüge simulieren sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
