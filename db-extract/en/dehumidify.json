                                    {
                                        "sense_id": "cc81ee55-357d-34ad-b930-62da112cbfbc",
                                        "entry_id": "67edf120-52b3-3040-85a7-9a3cb9b84d27",
                                        "glosses": [
                                            "Diminuer l’humidité de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e72363-9899-4940-a1a4-919d9d93c999",
                                                "sense_id": "cc81ee55-357d-34ad-b930-62da112cbfbc",
                                                "text": "La Nasa pourrait facilement déshumidifier la station avant de la quitter, évitant ainsi les gros soucis de corrosion."
                                            },
                                            {
                                                "example_id": "522f66d5-9971-4cc9-8b24-da3f4bac0ada",
                                                "sense_id": "cc81ee55-357d-34ad-b930-62da112cbfbc",
                                                "text": "Pour un bon bol d’air, voici une sélection d’appareils qui ventilent, rafraîchissent, purifient, humidifient et déshumidifient, ionisent sans vous ruiner."
                                            },
                                            {
                                                "example_id": "924d7464-4b10-48c8-9425-491581597b4e",
                                                "sense_id": "cc81ee55-357d-34ad-b930-62da112cbfbc",
                                                "text": "On peut prévenir la corrosion interne dans les réseaux sous aire en déshumidifiant l’air ou en utilisant un gaz inerte come l’azote pour emplir la tuyauterie, au lieu de l’air ambiant compressé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
