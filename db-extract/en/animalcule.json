    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5827e552-8008-3658-be81-0c1b230c9f5c",
                "word": "animalcule",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "980c8eac-dabe-4e5d-8631-20873fb915f0",
                        "entry_id": "5827e552-8008-3658-be81-0c1b230c9f5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "animalcules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49011dd6-0ce3-39d9-8a03-79f6054d1f0a",
                        "entry_id": "5827e552-8008-3658-be81-0c1b230c9f5c",
                        "glosses": [
                            "A sperm cell or spermatozoon; also, the embryo that was formerly thought to be contained inside a spermatozoon in a fully developed state."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "baa972a7-d510-4a90-974f-364ae3ae98d8",
                                "sense_id": "49011dd6-0ce3-39d9-8a03-79f6054d1f0a",
                                "text": "[Antonie van] Leeuwenhoek's most mysterious finding was yet to come, however. Inside the animalcules in the thickest part of the semen he saw / all manner of great and small vessels, so various and so numerous that I do not doubt that they be nerves, arteries and veins. …"
                            }
                        ]
                    },
                    {
                        "sense_id": "8c0107bc-8997-3b5d-9c87-b690b8ad48cc",
                        "entry_id": "5827e552-8008-3658-be81-0c1b230c9f5c",
                        "glosses": [
                            "A microscopic aquatic animal, including protozoa and rotifers."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "ec132ac4-4d53-480b-a4e0-a2f589b73ea2",
                                "sense_id": "8c0107bc-8997-3b5d-9c87-b690b8ad48cc",
                                "text": "If we are part of nature, then we are synonymous with it at the metaphysical level, every bit as much as the first all-but-inorganic animalcules that ever formed a chain of themselves in the blow hole of a primordial sea vent."
                            }
                        ]
                    },
                    {
                        "sense_id": "3428dc12-d873-3ea6-b413-bc4952048005",
                        "entry_id": "5827e552-8008-3658-be81-0c1b230c9f5c",
                        "glosses": [
                            "A small animal."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7c080985-8a17-4963-9a9d-069d77198f84",
                                "sense_id": "3428dc12-d873-3ea6-b413-bc4952048005",
                                "text": "Why, there is not a Man, or a Thing, now alive but has tools. The basest of created animalcules, the Spider itself, has a spinning-jenny, and warping-mill, and power-loom within its head: […]"
                            },
                            {
                                "example_id": "a59283e2-7f25-4cd7-a597-26f162041dc5",
                                "sense_id": "3428dc12-d873-3ea6-b413-bc4952048005",
                                "text": "Is it not evident that if a parasitic animalcule desired to call its attention it would sink a hole in its shell and so stimulate its sensory apparatus?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "352150f8-cbda-4a2e-b6a9-91a34bf8bbb2",
                        "source_entry_id": "5827e552-8008-3658-be81-0c1b230c9f5c",
                        "source_sense_description": "embryo that was formerly thought to be contained inside a spermatozoon in a fully developed state",
                        "target_lang_word": "żyjątko",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "żyjątko",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d76698b2-b37e-3283-ae91-6810d1161db8",
                                        "entry_id": "2d3928de-cf6b-31d3-9ba8-2e1ecdf5c321",
                                        "glosses": [
                                            "niewielkie stworzenie, organizm mikroskopijnych rozmiarów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514c2913-a2dd-4dac-af8e-9d975eddcda9",
                                                "sense_id": "d76698b2-b37e-3283-ae91-6810d1161db8",
                                                "text": "W wodzie akwarium unosiły się jakieś żyjątka."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c475b2e3-a360-44ec-baf1-0287ee95a9e6",
                        "source_entry_id": "5827e552-8008-3658-be81-0c1b230c9f5c",
                        "source_sense_description": "microscopic aquatic animal, including protozoa and rotifers",
                        "target_lang_word": "animalcule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animalcule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21259416-0a7f-375d-ba09-694661f27888",
                                        "entry_id": "4be7636f-2b76-3a00-bd82-377b28122632",
                                        "glosses": [
                                            "Petit animal qu’on ne peut voir qu’à l’aide du microscope dans certains liquides."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca65bb67-e31e-422e-8f83-1b79a9edd40a",
                                                "sense_id": "21259416-0a7f-375d-ba09-694661f27888",
                                                "text": "La solitude de l’Océan n’était troublée que par le passage de quelques souffleurs, qui fréquentaient les eaux vertes où pullulent ces myriades d’animalcules microscopiques dont ils font leur unique nourriture."
                                            },
                                            {
                                                "example_id": "5b883b4b-f8b7-4688-9cbd-b457b677e5d8",
                                                "sense_id": "21259416-0a7f-375d-ba09-694661f27888",
                                                "text": "Sous forme de reproductions, les animalcules, spectres et autres créatures étranges emprisonnées dans son viseur en cuivre ont bientôt orné des livres animés à colorier, des décalcomanies à appliquer sur la peau […]."
                                            },
                                            {
                                                "example_id": "b4a466df-58b6-49b4-a4c2-55c9fe2f7553",
                                                "sense_id": "21259416-0a7f-375d-ba09-694661f27888",
                                                "text": "Bien plus tard, selon Gintrac, Pelletier et Bousquet, puis Donné et Fiard, ayant examiné au microscope le virus vaccin, n’y reconnurent ni globules ni globulins, ni animalcules, ni œufs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
