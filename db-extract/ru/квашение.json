                "senses": [
                    {
                        "sense_id": "b381b4cf-d1d3-30d1-af1d-63f8dacdbcda",
                        "entry_id": "a099a59c-19cb-3599-ac56-d9ebdf601a4d",
                        "glosses": [
                            "действие по значению гл. квасить, кваситься I 2."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f364fde-896b-4d8b-bdf1-eb888598a71b",
                                "sense_id": "b381b4cf-d1d3-30d1-af1d-63f8dacdbcda",
                                "text": "Квашение, мочение и маринование — .. стариннейшие способы приготовления пищи впрок. При квашении и мочении в результате жизнедеятельности молочнокислых бактерий образуется большое количество молочной кислоты .."
                            },
                            {
                                "example_id": "ad18ed52-8dfc-4655-99f5-4bc6a0ca7145",
                                "sense_id": "b381b4cf-d1d3-30d1-af1d-63f8dacdbcda",
                                "text": "Рыжики были крепкого посола, по-моему, их даже коснулся процесс квашения."
                            },
                            {
                                "example_id": "a8234e2c-c0fe-4a8a-bc78-979f1cdd692c",
                                "sense_id": "b381b4cf-d1d3-30d1-af1d-63f8dacdbcda",
                                "text": "Для квашения используют капусту поздних сортов, созревшую, с плотными крупными кочанами."
                            }
                        ]
                    },
                    {
                        "sense_id": "68fb00d1-2df7-381a-9ac0-f72746c99479",
                        "entry_id": "a099a59c-19cb-3599-ac56-d9ebdf601a4d",
                        "glosses": [
                            "результат такого действия; квашеный продукт"
                        ],
