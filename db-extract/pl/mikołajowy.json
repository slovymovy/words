                        "examples": [
                            {
                                "example_id": "2ba484e3-eac8-4473-8705-4f03010fa3b7",
                                "sense_id": "53400132-6b6b-3646-8363-66c1c33e3ae7",
                                "text": "Przed Mikołajowym domem rosną rosochate kasztany."
                            },
                            {
                                "example_id": "af64f2a6-e084-4010-865c-08c1e8fde381",
                                "sense_id": "53400132-6b6b-3646-8363-66c1c33e3ae7",
                                "text": "Sąsiadował z Mikołajową zagrodą z jednej strony i z Maciejowym polem z drugiej."
                            },
                            {
                                "example_id": "ec6570cf-274e-4878-9847-06f3ab75cd82",
                                "sense_id": "53400132-6b6b-3646-8363-66c1c33e3ae7",
                                "text": "Mikołajowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
