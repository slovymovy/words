                        ],
                        "form": "auditoriums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5fd181c-5ca0-3a97-a0d0-fa5f0c3e5aa8",
                        "entry_id": "5a6d6b00-8baf-37df-88cf-c215a7178a42",
                        "glosses": [
                            "Salle spécialement aménagée pour les auditions musicales et théâtrales, et notamment pour les enregistrements, les émissions de radio et la télévision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b240feb7-b870-4383-8c1c-86ddeae77b87",
                                "sense_id": "c5fd181c-5ca0-3a97-a0d0-fa5f0c3e5aa8",
                                "text": "Dans l’auditorium de l’université de Drexel à Philadelphie, ce 30 octobre 2007, huit cents étudiants et invités triés sur le volet, debout et la main posée surle cœur, reprennent à l’unisson le «Amen !» du pasteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e73b84b2-fb79-4079-b9b1-896be3585953",
                        "source_entry_id": "5a6d6b00-8baf-37df-88cf-c215a7178a42",
                        "source_sense_id": "c5fd181c-5ca0-3a97-a0d0-fa5f0c3e5aa8",
                        "target_lang_word": "Auditorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auditorium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "836dfd53-ee8a-3701-bd13-31863e6a904a",
                                        "entry_id": "3f8aa5aa-fc16-38b0-b3e2-c3a42a497b21",
                                        "glosses": [
                                            "Gruppe von Zuhörern"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "806ae93a-a777-41bb-ae52-f8c1e3297e4b",
                                                "sense_id": "836dfd53-ee8a-3701-bd13-31863e6a904a",
                                                "text": "Das Auditorium verfolgte den Vortrag mit großem Interesse."
                                            },
                                            {
                                                "example_id": "9df88032-66f8-4564-9ec0-fd526424a8e4",
                                                "sense_id": "836dfd53-ee8a-3701-bd13-31863e6a904a",
                                                "text": "„Aber er spricht grade recht für sein Auditorium, das Eile nicht liebt.“"
                                            },
                                            {
                                                "example_id": "4bfbec1e-1d0a-4a41-83a0-17f07166afa5",
                                                "sense_id": "836dfd53-ee8a-3701-bd13-31863e6a904a",
                                                "text": "„Wie durch Zauberkraft sank das Selbstbewußtsein der Zuhörer, machte sich Unsicherheit im Auditorium geltend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21bd29d8-3c99-3fa6-96a8-ce9cf3a9ab57",
                                        "entry_id": "3f8aa5aa-fc16-38b0-b3e2-c3a42a497b21",
                                        "glosses": [
                                            "Raum, in dem sich ein Auditorium [1] aufhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbce2d8-9e0f-42aa-9e38-5c4c9494973c",
                                                "sense_id": "21bd29d8-3c99-3fa6-96a8-ce9cf3a9ab57",
                                                "text": "Das Auditorium der Universität war bis auf den letzten Platz gefüllt."
                                            },
                                            {
                                                "example_id": "1669d3b6-ad49-40ae-b519-ca8f22b5e767",
                                                "sense_id": "21bd29d8-3c99-3fa6-96a8-ce9cf3a9ab57",
                                                "text": "„Kurz bevor man dann ins Auditorium reinging, kam man an einem Eskimo vorbei.“"
                                            },
                                            {
                                                "example_id": "7e562efc-2b57-477c-95f2-b1ce02ee5ff5",
                                                "sense_id": "21bd29d8-3c99-3fa6-96a8-ce9cf3a9ab57",
                                                "text": "„Am Abend des 10. Mai 1933 geht es los: Kundgebung im Auditorium der jeweiligen Universität, 22:00 Fackelzug zum Verbrennungsort, 23:00 bis 24:00 Bücherverbrennung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
