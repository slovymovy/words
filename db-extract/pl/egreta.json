                        "sense_id": "fccbddc3-54b7-340e-873b-57fe30b58d87",
                        "entry_id": "2979e65f-519a-38ed-b2a6-215454dac466",
                        "glosses": [
                            "Egretta alba, duży śnieżnobiały ptak; czapla biała"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "450b04b9-3409-32ca-8ec2-17fe34618326",
                        "entry_id": "2979e65f-519a-38ed-b2a6-215454dac466",
                        "glosses": [
                            "długie, ozdobne pióra czapli wyrastające na ich grzbietach w okresie godowym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
