{
    "word_family": [
        "practical",
        "practically",
        "practitioner",
        "impractical",
        "practicable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c1b1d86-9896-3e37-a9b8-c2c761cf690d",
                    "sense_definition": "Repetition of an activity to improve a skill.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skill_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He will need lots of <w>practice</w> with the lines before he performs them.",
                            "target_lang_translations": {
                                "ru": "Ему понадобится много <w>практики</w> с текстом, прежде чем он выступит.",
                                "zh": "在表演之前，他需要对台词进行大量的<w>练习</w>。"
                            }
                        },
                        {
                            "text": "It takes years of daily <w>practice</w> to master a musical instrument.",
                            "target_lang_translations": {
                                "ru": "Требуются годы ежедневной <w>практики</w>, чтобы овладеть музыкальным инструментом.",
                                "zh": "掌握一种乐器需要多年的日常<w>练习</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drill",
                        "exercise",
                        "training"
                    ],
                    "common_phrases": [
                        "target practice",
                        "daily practice",
                        "practice makes perfect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторение действий для улучшения навыка.",
                        "zh": "为了提高技能而进行的重复性活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практика",
                                "target_lang_sense_clarification": "опыт, применение навыков"
                            },
                            {
                                "target_lang_word": "тренировка",
                                "target_lang_sense_clarification": "отработка навыка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "练习",
                                "target_lang_sense_clarification": "通过重复来提高技能"
                            },
                            {
                                "target_lang_word": "训练",
                                "target_lang_sense_clarification": "系统性的技能培养"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21c93272-beea-312b-8536-856d26f6fee3",
                    "sense_definition": "An organized event for the purpose of performing such repetition.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skill_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have choir <w>practice</w> every Sunday after church.",
                            "target_lang_translations": {
                                "ru": "У меня <w>репетиция</w> хора каждое воскресенье после церкви.",
                                "zh": "我每周日礼拜后都有合唱团的<w>排练</w>。"
                            }
                        },
                        {
                            "text": "The team was tired after a long football <w>practice</w> in the rain.",
                            "target_lang_translations": {
                                "ru": "Команда устала после долгой футбольной <w>тренировки</w> под дождем.",
                                "zh": "在雨中进行长时间的足球<w>训练</w>后，队员们都累了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rehearsal",
                        "workout",
                        "training"
                    ],
                    "common_phrases": [
                        "choir practice",
                        "football practice",
                        "band practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованное мероприятие для отработки навыков.",
                        "zh": "为进行上述重复性活动而组织的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репетиция",
                                "target_lang_sense_clarification": "музыка, театр"
                            },
                            {
                                "target_lang_word": "тренировка",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排练",
                                "target_lang_sense_clarification": "音乐、戏剧等艺术表演的准备"
                            },
                            {
                                "target_lang_word": "训练",
                                "target_lang_sense_clarification": "体育或团队活动的练习"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "214a550d-71da-374a-80e9-f93a1b03fe60",
                    "sense_definition": "A customary action, habit, or behaviour; a manner or routine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "habit_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is good <w>practice</w> to check each door and window before leaving.",
                            "target_lang_translations": {
                                "ru": "Это полезная <w>привычка</w> — проверять каждую дверь и окно перед уходом.",
                                "zh": "离开前检查每一扇门窗是一个好<w>习惯</w>。"
                            }
                        },
                        {
                            "text": "The usual <w>practice</w> in this company is to dress casually on Fridays.",
                            "target_lang_translations": {
                                "ru": "Обычная <w>практика</w> в этой компании — одеваться повседневно по пятницам.",
                                "zh": "这家公司通常的<w>惯例</w>是周五可以穿便装。"
                            }
                        }
                    ],
                    "synonyms": [
                        "custom",
                        "habit",
                        "routine",
                        "pattern",
                        "tradition",
                        "convention"
                    ],
                    "common_phrases": [
                        "common practice",
                        "standard practice",
                        "best practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычное действие, привычка или установленный порядок.",
                        "zh": "习惯性的行为、惯例或常规做法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практика",
                                "target_lang_sense_clarification": "установленный порядок"
                            },
                            {
                                "target_lang_word": "обычай",
                                "target_lang_sense_clarification": "традиция"
                            },
                            {
                                "target_lang_word": "привычка",
                                "target_lang_sense_clarification": "поведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惯例",
                                "target_lang_sense_clarification": "通常的做法"
                            },
                            {
                                "target_lang_word": "习惯",
                                "target_lang_sense_clarification": "个人的行为模式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77938b19-70f5-37f0-b4ef-dc8bec86db8f",
                    "sense_definition": "Actual operation or experiment, in contrast to theory.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That may work in theory, but will it work in <w>practice</w>?",
                            "target_lang_translations": {
                                "ru": "Это может сработать в теории, но сработает ли на <w>практике</w>?",
                                "zh": "这在理论上可能行得通，但在<w>实践</w>中能行吗？"
                            }
                        },
                        {
                            "text": "Putting these new ideas into <w>practice</w> proved more difficult than expected.",
                            "target_lang_translations": {
                                "ru": "Воплощение этих новых идей на <w>практике</w> оказалось сложнее, чем ожидалось.",
                                "zh": "将这些新想法付诸<w>实践</w>比预想的要困难。"
                            }
                        }
                    ],
                    "antonyms": [
                        "theory"
                    ],
                    "common_phrases": [
                        "in practice",
                        "put into practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Реальное применение или действие в противовес теории.",
                        "zh": "与理论相对的实际操作或实验。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практика",
                                "target_lang_sense_clarification": "реальность, не теория"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实践",
                                "target_lang_sense_clarification": "实际应用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c97f6ae-fc84-3c9a-905d-d7ea352e6b30",
                    "sense_definition": "The ongoing pursuit of a craft or profession, particularly in medicine or the fine arts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She retired from medical <w>practice</w> after thirty years of service.",
                            "target_lang_translations": {
                                "ru": "Она ушла из медицинской <w>практики</w> после тридцати лет службы.",
                                "zh": "她行医三十年后退休了，不再从事医疗<w>执业</w>。"
                            }
                        },
                        {
                            "text": "He established a private <w>practice</w> shortly after graduating from law school.",
                            "target_lang_translations": {
                                "ru": "Он открыл частную <w>практику</w> вскоре после окончания юридического факультета.",
                                "zh": "他从法学院毕业后不久就开设了自己的私人<w>事务所</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "private practice",
                        "medical practice",
                        "legal practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональная деятельность, особенно в медицине или юриспруденции.",
                        "zh": "从事某种职业（特别是医学或法律）的专业活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практика",
                                "target_lang_sense_clarification": "профессиональная деятельность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "执业",
                                "target_lang_sense_clarification": "从事专业工作"
                            },
                            {
                                "target_lang_word": "业务",
                                "target_lang_sense_clarification": "专业服务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fb7018d-576b-342f-9024-6b1879e217b6",
                    "sense_definition": "A place where a professional service is provided, such as a general practice.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ran a thriving medical <w>practice</w> in the center of town.",
                            "target_lang_translations": {
                                "ru": "Она руководила процветающей медицинской <w>практикой</w> в центре города.",
                                "zh": "她在市中心经营着一家生意兴隆的医疗<w>诊所</w>。"
                            }
                        },
                        {
                            "text": "The dental <w>practice</w> is closed for renovations this week.",
                            "target_lang_translations": {
                                "ru": "Стоматологическая <w>клиника</w> закрыта на ремонт на этой неделе.",
                                "zh": "这家牙科<w>诊所</w>本周因装修而关闭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "general practice"
                    ],
                    "common_phrases": [
                        "group practice",
                        "dental practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где предоставляются профессиональные услуги (например, кабинет врача).",
                        "zh": "提供专业服务的地方，如诊所或事务所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиника",
                                "target_lang_sense_clarification": "медучреждение"
                            },
                            {
                                "target_lang_word": "кабинет",
                                "target_lang_sense_clarification": "помещение врача"
                            },
                            {
                                "target_lang_word": "практика",
                                "target_lang_sense_clarification": "бизнес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诊所",
                                "target_lang_sense_clarification": "医疗机构"
                            },
                            {
                                "target_lang_word": "事务所",
                                "target_lang_sense_clarification": "法律或会计等专业机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "495cb0f9-d262-3383-8c4e-70da5422899a",
                    "sense_definition": "The observance of religious duties that a church requires of its members.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "habit_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular prayer is an essential part of their religious <w>practice</w>.",
                            "target_lang_translations": {
                                "ru": "Регулярная молитва — неотъемлемая часть их религиозной <w>практики</w>.",
                                "zh": "定期祈祷是他们宗教<w>修行</w>的重要组成部分。"
                            }
                        },
                        {
                            "text": "The scholar studied the history of Christian <w>practice</w> in the Middle Ages.",
                            "target_lang_translations": {
                                "ru": "Ученый изучал историю христианской <w>практики</w> в Средние века.",
                                "zh": "这位学者研究了中世纪基督教的<w>仪式</w>历史。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "religious practice",
                        "spiritual practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соблюдение религиозных обрядов и обязанностей.",
                        "zh": "宗教信仰中要求的仪式或修行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практика",
                                "target_lang_sense_clarification": "духовная"
                            },
                            {
                                "target_lang_word": "обряд",
                                "target_lang_sense_clarification": "ритуал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "修行",
                                "target_lang_sense_clarification": "宗教实践"
                            },
                            {
                                "target_lang_word": "仪式",
                                "target_lang_sense_clarification": "宗教礼仪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef94dcaa-fe66-3b35-93e1-d503e807d611",
                    "sense_definition": "The form, manner, and order of conducting and carrying on suits and prosecutions through their various stages.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This firm of solicitors is involved in family law <w>practice</w>.",
                            "target_lang_translations": {
                                "ru": "Эта фирма адвокатов занимается <w>практикой</w> семейного права.",
                                "zh": "这家律师事务所专门从事家庭法<w>诉讼程序</w>。"
                            }
                        },
                        {
                            "text": "Students must learn the codes of civil <w>practice</w> before taking the bar exam.",
                            "target_lang_translations": {
                                "ru": "Студенты должны изучить кодексы гражданского <w>судопроизводства</w> перед сдачей экзамена на адвоката.",
                                "zh": "学生在参加律师资格考试前必须学习民事<w>诉讼程序</w>法典。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "code of practice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Порядок ведения судебных дел и процессов.",
                        "zh": "进行法律诉讼的程序和规则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судопроизводство",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "практика",
                                "target_lang_sense_clarification": "юридическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诉讼程序",
                                "target_lang_sense_clarification": "法律执行过程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c07af44b-6a97-3cc1-8bd2-e2bff89830dc",
                    "sense_definition": "To perform an activity repeatedly in order to improve one's proficiency.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skill_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>practice</w> every day if you want to learn the piano.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>заниматься</w> каждый день, если хочешь научиться играть на пианино.",
                                "zh": "如果你想学钢琴，就必须每天<w>练习</w>。"
                            }
                        },
                        {
                            "text": "She <w>practices</w> her French by talking to native speakers online.",
                            "target_lang_translations": {
                                "ru": "Она <w>практикует</w> свой французский, разговаривая с носителями языка онлайн.",
                                "zh": "她通过在网上与母语人士交谈来<w>练习</w>法语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drill",
                        "exercise",
                        "train",
                        "rehearse"
                    ],
                    "common_phrases": [
                        "practice hard",
                        "practice daily"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять действие регулярно для улучшения навыков.",
                        "zh": "反复进行某项活动以提高熟练度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практиковаться",
                                "target_lang_sense_clarification": "упражняться"
                            },
                            {
                                "target_lang_word": "тренироваться",
                                "target_lang_sense_clarification": "развивать навык"
                            },
                            {
                                "target_lang_word": "заниматься",
                                "target_lang_sense_clarification": "учить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "练习",
                                "target_lang_sense_clarification": "通过重复来学习"
                            },
                            {
                                "target_lang_word": "训练",
                                "target_lang_sense_clarification": "通过锻炼来提高"
                            }
                        ]
                    }
                }
            ]
        }
    ]
