                    },
                    {
                        "translation_id": "007b1af1-e796-4158-bba5-7e18951200ce",
                        "source_entry_id": "3d3eee17-9998-3e1b-9cd3-656573ebcff3",
                        "source_sense_id": "3fcb3480-5d80-3e97-a654-d6c7d6f77a8e",
                        "source_sense_description": "verzamelplaats, zaal voor de verpozing (bijvoorbeeld in een hotel of schouwburg)",
                        "target_lang_word": "foyer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foyer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3857faf6-0f21-361f-a2d2-ba198cbbd01b",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "(Selon certains auteurs) Partie d’une cheminée se trouvant au devant de l’âtre (on brûle le bois), Il se trouve donc en dehors des jambages de la cheminée. Il est souvent constitué de pierres ou de briques si le sol de la pièce est en parquet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a84f6a-42a7-47ad-b8da-106db37c74d4",
                                                "sense_id": "3857faf6-0f21-361f-a2d2-ba198cbbd01b",
                                                "text": "Foyer : C’est la partie de l'âtre qui est au devant des jambages d’une cheminée & qu’on pave ordinairement de grand carreau de terre cuite. — (Augustin-Charles d’Aviler, Dictionnaire d'architecture civile et hydraulique, Éd. Jombert, Paris 1755)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a155984c-4f82-3464-995b-6519908b977f",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "(Selon d’autres auteurs) Synonyme d’âtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4489ca4c-7965-481f-8bb7-a15397e13216",
                                                "sense_id": "a155984c-4f82-3464-995b-6519908b977f",
                                                "text": "Le foyer ou âtre : Le feu de bois est au niveau du sol , contre le mur , une grande cheminée recueillant les fumées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb16704a-1fe4-3cd2-a716-78b5361d746f",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Partie d’un poêle, d’un fourneau où se fait le feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9755a2-d951-41ad-ba09-53956a9be78c",
                                                "sense_id": "cb16704a-1fe4-3cd2-a716-78b5361d746f",
                                                "text": "Le foyer d’un fourneau : La partie d’un fourneau où se place le feu et dont le fond est garni d’une petite grille à travers laquelle la cendre tombe."
                                            },
                                            {
                                                "example_id": "a99ee694-ac53-41a4-88ad-a607308eb460",
                                                "sense_id": "cb16704a-1fe4-3cd2-a716-78b5361d746f",
                                                "text": "Pierre de foyer, marbre de foyer, et par abréviation foyer : Dalle de pierre ou de marbre que l’on met au-devant d’une cheminée pour éloigner du feu le plancher et les parquets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6aaaa6-e7f4-3ee3-af04-cd157cf4bcef",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Partie d’un poêle, d’un fourneau où se fait le feu.",
                                            "À l’intérieur de la chambre de combustion, zone où les ergols entrent en réaction."
                                        ],
                                        "tags": [
                                            "Propulsion spatiale"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6149512d-bcb4-32fb-8b55-75e99d29e767",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Feu qui brûle dans le foyer."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f0c176-3a5c-40b1-b6c8-a9ae934d6d54",
                                                "sense_id": "6149512d-bcb4-32fb-8b55-75e99d29e767",
                                                "text": "Il se réchauffa au foyer qu’on venait d’allumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2778d984-1b69-38e3-9db3-254af82cce26",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Salle commune d’un théâtre, d’une salle de spectacle où se rassemblent les acteurs et celle où les spectateurs peuvent se rendre pour passer le temps des entractes, pour converser et où ils se rendaient autrefois pour se chauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531da0dc-8745-4a31-b746-50ed8633f5dd",
                                                "sense_id": "2778d984-1b69-38e3-9db3-254af82cce26",
                                                "text": "Le foyer des artistes, de la danse, du public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8e7323-0057-3dc3-a183-f8db8260cadf",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Maison, demeure familiale, pays natal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1444703-a208-44a0-9728-7141b11fc04f",
                                                "sense_id": "be8e7323-0057-3dc3-a183-f8db8260cadf",
                                                "text": "Il peut avoir lieu chez vous, mais aussi hors de votre lieu de vie et de vos habitudes, où il est plus facile de prendre conscience de soi, sans votre quotidien ultrarempli par les distractions et les obligations du foyer."
                                            },
                                            {
                                                "example_id": "2b586263-b7ac-4c0d-a96d-4e5f053ea8b4",
                                                "sense_id": "be8e7323-0057-3dc3-a183-f8db8260cadf",
                                                "text": "Entre le travail en usine, le ramendage des filets, l’entretien des vêtements de pêche, la tenue du foyer et les maternités, les femmes de Douarnenez sont des battantes avant la lettre !"
                                            },
                                            {
                                                "example_id": "ace676c3-92b0-418c-afbb-fe1a8984a495",
                                                "sense_id": "be8e7323-0057-3dc3-a183-f8db8260cadf",
                                                "text": "Homme de foyer : Homme qui aime son foyer, sa famille, la vie domestique."
                                            },
                                            {
                                                "example_id": "372cdb02-2946-4fa7-90e1-6f50e41b4bba",
                                                "sense_id": "be8e7323-0057-3dc3-a183-f8db8260cadf",
                                                "text": "Célibataire, vous rêvez de fonder un foyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abbbe01b-83eb-3634-9752-91e625b802d2",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Centre, source."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fca0bf92-cc19-4578-a8b3-aaa7bfbfa663",
                                                "sense_id": "abbbe01b-83eb-3634-9752-91e625b802d2",
                                                "text": "Foyer de lumière ou de chaleur : Se dit d’un corps émettant de la lumière ou de la chaleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3591d39f-f798-3b59-bb37-1ad956f4347a",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Point possédant des propriétés particulières pour l’étude de certaines courbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a1ea4ad-2a39-49f9-8129-4642976fd450",
                                                "sense_id": "3591d39f-f798-3b59-bb37-1ad956f4347a",
                                                "text": "La somme des distances d’un point d’une parabole au foyer de celle-ci et à une droite quelconque perpendiculaire à l’axe de la parabole est constante."
                                            },
                                            {
                                                "example_id": "20b4c023-2032-4744-8548-e561573d75bb",
                                                "sense_id": "3591d39f-f798-3b59-bb37-1ad956f4347a",
                                                "text": "Une ellipse a deux foyers, et la somme des distances de tout point de cette courbe à ses deux foyers est constante."
                                            },
                                            {
                                                "example_id": "4765d9b8-a6f3-43ef-9849-8ae24c12afff",
                                                "sense_id": "3591d39f-f798-3b59-bb37-1ad956f4347a",
                                                "text": "Une hyperbole a deux foyers, et la différence des distances entre les points de l’hyperbole et les foyers est constante."
                                            },
                                            {
                                                "example_id": "b79b918e-6b82-4054-9089-b63f2c67b2ea",
                                                "sense_id": "3591d39f-f798-3b59-bb37-1ad956f4347a",
                                                "text": "Le souvenir que je garde de cette traversée est celui de ces jours de plénitude où la flamme chaude de joie qui brûle en nous dévore et résume en elle paisiblement toutes choses, semble s’allumer, comme au foyer d’une immense lentille, à la seule transparence du ciel et de la mer."
                                            },
                                            {
                                                "example_id": "c7ce3e5e-02a1-45b6-abac-8c9daa34f985",
                                                "sense_id": "3591d39f-f798-3b59-bb37-1ad956f4347a",
                                                "text": "Les planètes décrivent des ellipses dont le soleil occupe un des foyers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5b6336-9440-39ae-b56f-bb692f50117f",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Point commun à tous les rayons sortant d’un système optique lorsque tous les rayons entrants sont parallèles à l’axe optique du système."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d2a332a-cfa0-42a2-83e6-fd6a7fc7d3eb",
                                                "sense_id": "3d5b6336-9440-39ae-b56f-bb692f50117f",
                                                "text": "Dans un miroir sphérique de petite dimension, un foyer est un point par lequel passent après réflexion les rayons lumineux ou calorifiques entrés parallèlement à l’axe de ce miroir."
                                            },
                                            {
                                                "example_id": "175109bc-c668-4ae3-829b-80524bbd9ada",
                                                "sense_id": "3d5b6336-9440-39ae-b56f-bb692f50117f",
                                                "text": "Les lentilles simples anastigmatiques qui forment les éléments des anastigmats symétriques offrent le grand avantage de pouvoir s'associer pour constituer des objectifs à foyers multiples : […]."
                                            },
                                            {
                                                "example_id": "57063cca-f638-4b18-bccb-346354c4ed47",
                                                "sense_id": "3d5b6336-9440-39ae-b56f-bb692f50117f",
                                                "text": "Le souvenir que je garde de cette traversée est celui de ces jours de plénitude où la flamme chaude de joie qui brûle en nous dévore et résume en elle paisiblement toutes choses, semble s’allumer, comme au foyer d’une immense lentille, à la seule transparence du ciel et de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1d2ce1-af41-3732-9cf2-f4b84c8bb663",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Siège principal d’une maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ada931-bac4-41ab-85e6-a9a5f8bf8b21",
                                                "sense_id": "eb1d2ce1-af41-3732-9cf2-f4b84c8bb663",
                                                "text": "Les autorités dénombrent vingt-trois foyers sur treize communes et cinquante bêtes mortes, (bovins, ovins et équins)."
                                            },
                                            {
                                                "example_id": "ab0ee7f1-d45f-47b6-acba-c4306198ce10",
                                                "sense_id": "eb1d2ce1-af41-3732-9cf2-f4b84c8bb663",
                                                "text": "Suspectant un foyer de grippe aviaire dans un élevage de canards, la préfecture des Landes a mis en place un périmètre de contrôle temporaire autour de cette exploitation qui est en cours de dépeuplement à titre préventif."
                                            },
                                            {
                                                "example_id": "ba76d1e9-cf59-4417-a0a3-e9d75a695a41",
                                                "sense_id": "eb1d2ce1-af41-3732-9cf2-f4b84c8bb663",
                                                "text": "Dès l'arrivée de la pandémie du coronavirus, le Québec a été de loin le foyer le plus important au Canada en termes de transmission de la maladie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc510545-4c18-32f7-8e6e-80e15c3b9b80",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Se dit d’un lieu d’où rayonne, un problème ou un danger."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ddd7c4-231c-45b8-8d1f-68ed95a7f8bb",
                                                "sense_id": "bc510545-4c18-32f7-8e6e-80e15c3b9b80",
                                                "text": "La Russie a commencé à allumer des foyers de guerre un peu partout à travers le monde pour déstabiliser les démocraties, avec la bénédiction active de la Chine."
                                            },
                                            {
                                                "example_id": "34198975-9fd7-4dff-a6a9-3fed7cd7343b",
                                                "sense_id": "bc510545-4c18-32f7-8e6e-80e15c3b9b80",
                                                "text": "Le foyer de la rébellion, de la sédition."
                                            },
                                            {
                                                "example_id": "976701f9-4e5e-4588-a5a4-627be07cffc4",
                                                "sense_id": "bc510545-4c18-32f7-8e6e-80e15c3b9b80",
                                                "text": "foyer d’un incendie : point central ou point le plus actif du feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80aa2a3b-7b9c-3495-ae27-5b05651a7b16",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Centre ; lieu principal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a8f6ab6-9c00-4e84-bb72-ad09985a4058",
                                                "sense_id": "80aa2a3b-7b9c-3495-ae27-5b05651a7b16",
                                                "text": "La création d’une chaire des dialectes et patois comparés rendrait les plus grands services aux romanistes en leur fournissant le foyer central qui leur manque encore dans notre pays."
                                            },
                                            {
                                                "example_id": "ec469a53-874d-4ebf-b661-c5f1786d52c4",
                                                "sense_id": "80aa2a3b-7b9c-3495-ae27-5b05651a7b16",
                                                "text": "Il y a encore une autre région frontière orificielle qui est un foyer sexuel tactile de haute importance : le bout des seins."
                                            },
                                            {
                                                "example_id": "5d4eacf9-9e01-4c09-928e-66c3c307d4f0",
                                                "sense_id": "80aa2a3b-7b9c-3495-ae27-5b05651a7b16",
                                                "text": "Tandis que le Midi, qui a, de tout temps, été un foyer de vie intellectuelle très intense et où les juifs cultivaient toutes les sciences, a été le point de départ d’une agitation antiphilosophique et antiscientifique […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d42389f2-3034-3d88-a70d-0efe6e2e70b2",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Salle, dans un lycée, où les élèves peuvent se détendre ; un même type de salle pour les enseignants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e271f18d-f75c-49b3-822f-fe3be12a03c6",
                                                "sense_id": "d42389f2-3034-3d88-a70d-0efe6e2e70b2",
                                                "text": "Tu viens, on va faire un baby-foot au foyer !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6852ed55-98cb-379e-b987-fc7d68f191da",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Focus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "479afc0c-b1e6-3bfd-a7ef-d693d856e8c7",
                                        "entry_id": "710b9c6a-7cb5-35ba-acc4-f45ec42fcafd",
                                        "glosses": [
                                            "Résidence pour personnes âgées."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfa0a20e-66b8-4368-9c76-25e959e31c45",
                        "source_entry_id": "3d3eee17-9998-3e1b-9cd3-656573ebcff3",
                        "source_sense_id": "3fcb3480-5d80-3e97-a654-d6c7d6f77a8e",
                        "source_sense_description": "verzamelplaats, zaal voor de verpozing (bijvoorbeeld in een hotel of schouwburg)",
                        "target_lang_word": "lobby",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lobby",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39d6f3ad-3140-3f31-b0ae-4c0bc16beeae",
                                        "entry_id": "33841bf7-08cb-38ea-9e74-eab38d7fcecd",
                                        "glosses": [
                                            "Groupe ayant des intérêts convergents et réalisant des activités ayant pour but d’influencer la prise de décisions dans une orientation favorable à ses intérêts économiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a8f7d0-e49b-40ab-8573-475bfecc8e8e",
                                                "sense_id": "39d6f3ad-3140-3f31-b0ae-4c0bc16beeae",
                                                "text": "Pour complaire à un lobby, on n’hésite pas à prendre le risque de provoquer des dégâts considérables sur le plan diplomatique et économique."
                                            },
                                            {
                                                "example_id": "24f87f62-1df5-4f3d-bb9f-90b9c1d8d25c",
                                                "sense_id": "39d6f3ad-3140-3f31-b0ae-4c0bc16beeae",
                                                "text": "J’avais tenté de trouver quelques études indépendantes sur le sujet, elles ne sont pas légion car dépendant trop souvent du lobby thermaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                        "entry_id": "33841bf7-08cb-38ea-9e74-eab38d7fcecd",
                                        "glosses": [
                                            "Hall d’accueil d’un hôtel."
                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5f4bf18-fb4d-4ee3-882e-e4e657e0280c",
                                                "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                                "text": "Allez vous rassembler dans le lobby de l’hôtel, là je vais vous remettre vos clés."
                                            },
                                            {
                                                "example_id": "25592ff2-e8cb-4b7b-87ed-657dca335304",
                                                "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                                "text": "Il y avait beaucoup de monde dans le lobby. Protégé par l’anonymat de son uniforme, il a pu se glisser discrètement vers une sortie de service."
                                            },
                                            {
                                                "example_id": "553ee74e-7779-45e4-9e2d-afd825ca0f68",
                                                "sense_id": "dd69a8bf-f9c5-3658-8097-75b468976b9a",
                                                "text": "Soudain amis pour la vie, nous étions ensuite restés des heures dans le lobby de l’hôtel, à discuter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
