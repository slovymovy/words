                        "cross_references": [
                            {
                                "target_word": "Hosenträger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a85e70f4-b151-37cc-a115-df0b43e68813",
                                        "entry_id": "3dbe8975-4833-30f9-8a0d-10602f05d775",
                                        "glosses": [
                                            "dehnbare Träger, die über die Schultern geführt werden und am Hosenbund befestigt sind, um das Herunterrutschen der Hose zu verhindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cf8ccd-eaf3-496a-9de7-874bbca9db79",
                                                "sense_id": "a85e70f4-b151-37cc-a115-df0b43e68813",
                                                "text": "„Lieber Hosenträger als gar keinen Halt.“ (Zitat)"
                                            },
                                            {
                                                "example_id": "5e9915bc-b5a6-4e63-a240-b8f51d02eae1",
                                                "sense_id": "a85e70f4-b151-37cc-a115-df0b43e68813",
                                                "text": "„Die Hosenträger hingen hinten runter.“"
                                            },
                                            {
                                                "example_id": "ff77208f-7671-4b21-8d22-24258f090348",
                                                "sense_id": "a85e70f4-b151-37cc-a115-df0b43e68813",
                                                "text": "„Man bindet ihm mit seinem Hosenträger den Arm ab.“"
                                            },
                                            {
                                                "example_id": "df916a23-86b4-4ef9-b40c-1381524d05ec",
                                                "sense_id": "a85e70f4-b151-37cc-a115-df0b43e68813",
                                                "text": "„Er zog einen Hosenträger zurück über die Schulter, der sofort wieder herunterfiel.“"
                                            },
                                            {
                                                "example_id": "a31309b7-4b64-4138-ab51-b7335aefe3d6",
                                                "sense_id": "a85e70f4-b151-37cc-a115-df0b43e68813",
                                                "text": "„Die Hose wurde von Hosenträgern gehalten, die nur mit Müh und Not auf den schmalen Schultern liegen blieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
