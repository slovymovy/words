                        "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                        "entry_id": "33314275-32c0-3622-9d4b-966f9bbd374f",
                        "glosses": [
                            "Élément ordinal correspondant à un nombre indéterminé dans une série."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dcb2c43-0030-40db-9b70-a37f1e9727f7",
                                "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                                "text": "Tu es la ixième à me le dire."
                            },
                            {
                                "example_id": "c63eaf4e-fdbc-48a5-9b4a-a941beb4aaea",
                                "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                                "text": "L’on demande un responsable électrobidule à la caisse ixième de l’ixième issue payante."
                            },
                            {
                                "example_id": "42c32ac0-e1ad-446c-be35-cba8c3af514b",
                                "sense_id": "10384ffb-5a76-3fa8-aec5-ae5488de9083",
                                "text": "Dans une interview-portrait à paraître samedi dans Le Figaro-Magazine, le ministre de l’Éducation nationale Xavier Darcos assure : « Je ne serai pas le ixième ministre [de l’Éducation] à céder ! Je serai le premier ministre à tenir bon le cap de la réforme »."
                            }
                        ]
                    }
