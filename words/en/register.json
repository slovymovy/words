                            {
                                "target_lang_word": "заслонка",
                                "target_lang_sense_clarification": "регулятор потока воздуха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通风口",
                                "target_lang_sense_clarification": "空气出口"
                            },
                            {
                                "target_lang_word": "风门",
                                "target_lang_sense_clarification": "调节装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5391a00b-bd85-39d0-b0cd-8fb17c7a8894",
                    "sense_definition": "A small unit of very fast memory within a computer processor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The processor loads the data into a <w>register</w> for quick access.",
                            "target_lang_translations": {
                                "ru": "Процессор загружает данные в <w>регистр</w> для быстрого доступа.",
