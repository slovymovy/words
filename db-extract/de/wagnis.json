                        "form": "das Wagnis"
                    },
                    {
                        "form_id": "28d5a440-e529-4a0f-8f55-9cfeab529f55",
                        "entry_id": "e25b5265-916a-385e-a3cf-c7b4f1129a8a",
                        "tags": [
                            "accusative",
