                        "source_entry_id": "67a42ab0-4d72-3f0e-9440-51be300bf429",
                        "source_sense_id": "ad85e0f9-d4e4-3f53-9b47-413fc51e9d31",
                        "target_lang_word": "trapezohedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trapezohedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db7508bc-f25f-3fc5-8321-974cf9a678f7",
                                        "entry_id": "5c8eee6c-0784-377c-a9db-c1e4c1538361",
                                        "glosses": [
                                            "Any of a class of polyhedra that have kite-shaped faces and are dual polyhedra of antiprisms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f877961f-c054-4287-970c-f52ad6205dab",
                                                "sense_id": "db7508bc-f25f-3fc5-8321-974cf9a678f7",
                                                "text": "The general form is called the tetragonal trapezohedron. In this case also there are both left- (Fig. 97) and right-handed (Fig. 98) forms."
                                            },
                                            {
                                                "example_id": "ad8df307-fa4f-49bc-84c7-f43b52aeed83",
                                                "sense_id": "db7508bc-f25f-3fc5-8321-974cf9a678f7",
                                                "text": "This trapezohedron, or antidiamond, is composed of ten quadrilaterals. In each quadrilateral, three of the angles are 108° and one is 36°."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9372ecd2-f360-346b-a62b-32cfe743c0c5",
                                        "entry_id": "5c8eee6c-0784-377c-a9db-c1e4c1538361",
                                        "glosses": [
                                            "A deltoidal icositetrahedron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9928ca-a922-44fd-90da-c5967f6c7028",
                                                "sense_id": "9372ecd2-f360-346b-a62b-32cfe743c0c5",
                                                "text": "A trapezohedron has 24 equal faces, each a four-sided figure or trapezium. Unlike the forms already described, which are always the same, there are several different trapezohedrons, all having the same number of faces but differing in the angles between the faces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
