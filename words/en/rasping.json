{
    "word_family": [
        "rasp",
        "raspy",
        "rasper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "461c303e-c66d-39f9-9ae0-cf9293746c2a",
                    "sense_definition": "Harsh, grating, and rough in sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient answered each question in a dry, <w>rasping</w> cough.",
                            "target_lang_translations": {
                                "ru": "Пациент отвечал на каждый вопрос с сухим, <w>хриплым</w> кашлем."
                            }
                        },
                        {
                            "text": "He spoke in a low, <w>rasping</w> voice after talking for hours.",
                            "target_lang_translations": {
                                "ru": "После многочасового разговора он говорил тихим, <w>хриплым</w> голосом."
                            }
                        }
                    ],
                    "synonyms": [
                        "grating",
                        "hoarse",
                        "raspy",
                        "harsh"
                    ],
                    "antonyms": [
                        "smooth",
                        "melodic"
                    ],
                    "common_phrases": [
                        "rasping voice",
                        "rasping cough",
                        "rasping sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий, скрежещущий или хриплый по звучанию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хриплый",
                                "target_lang_sense_clarification": "о голосе или кашле"
                            },
                            {
                                "target_lang_word": "скрежещущий",
                                "target_lang_sense_clarification": "о резком звуке"
                            },
                            {
                                "target_lang_word": "сиплый",
                                "target_lang_sense_clarification": "о голосе или дыхании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cb5271d-53ec-3231-bfe3-1ea175073c53",
                    "sense_definition": "Struck or driven with great power and speed, especially in sports.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forceful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker unleashed a <w>rasping</w> drive from thirty yards out.",
                            "target_lang_translations": {
                                "ru": "Нападающий нанёс <w>пушечный</w> удар с тридцати ярдов."
                            }
                        },
                        {
                            "text": "The goalkeeper barely deflected the <w>rasping</w> shot over the bar.",
                            "target_lang_translations": {
                                "ru": "Вратарь едва перевёл этот <w>мощнейший</w> удар через перекладину."
                            }
                        }
                    ],
                    "synonyms": [
                        "blistering",
                        "thumping",
                        "ferocious"
                    ],
                    "antonyms": [
                        "tame",
                        "weak"
                    ],
                    "common_phrases": [
                        "rasping drive",
                        "rasping shot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанесённый с огромной силой и скоростью (особенно в спорте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушечный",
                                "target_lang_sense_clarification": "об ударе в спорте"
                            },
                            {
                                "target_lang_word": "мощнейший",
                                "target_lang_sense_clarification": "об ударе мяча"
                            },
                            {
                                "target_lang_word": "сокрушительный",
                                "target_lang_sense_clarification": "о сильном выстреле или ударе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc2b724-cf08-34f5-a754-baa5a5a8c1be",
                    "sense_definition": "Extremely irritating, annoying, or exasperating to the nerves.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "irritating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant interruptions had a <w>rasping</w> effect on her patience.",
                            "target_lang_translations": {
                                "ru": "Его постоянные перебивания оказывали <w>раздражающее</w> действие на её терпение."
                            }
                        },
                        {
                            "text": "The continuous squeak of the broken fan created a <w>rasping</w> irritation.",
                            "target_lang_translations": {
                                "ru": "Непрерывный писк сломанного вентилятора вызывал <w>изводящее</w> раздражение."
                            }
                        }
                    ],
                    "synonyms": [
                        "exasperating",
                        "infuriating",
                        "irritating"
                    ],
                    "antonyms": [
                        "soothing",
                        "calming"
                    ],
                    "common_phrases": [
                        "rasping effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне раздражающий, выводящий из себя или действующий на нервы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражающий",
                                "target_lang_sense_clarification": "действующий на нервы"
                            },
                            {
                                "target_lang_word": "терзающий",
                                "target_lang_sense_clarification": "испытывающий терпение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "052e65b0-6255-3686-8b5a-8cb2f2b10738",
                    "sense_definition": "present participle and gerund of <w>rasp</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter was carefully <w>rasping</w> the rough edges of the wooden frame.",
                            "target_lang_translations": {
                                "ru": "Плотник аккуратно <w>обрабатывал рашпилем</w> неровные края деревянной рамы."
                            }
                        },
                        {
                            "text": "She could hear the cold wind <w>rasping</w> against the dry branches.",
                            "target_lang_translations": {
                                "ru": "Она слышала, как холодный ветер со <w>скрежетом</w> тёрся о сухие ветви."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола rasp (обтачивать рашпилем; скрежетать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрабатывающий рашпилем",
                                "target_lang_sense_clarification": "об инструменте или мастере"
                            },
                            {
                                "target_lang_word": "скребущий",
                                "target_lang_sense_clarification": "издающий скрежет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59653073-0c89-30d4-8fed-57f0878a58e1",
                    "sense_definition": "A harsh, scraping, or grating noise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden metallic <w>rasping</w> broke the silence of the night.",
                            "target_lang_translations": {
                                "ru": "Внезапный металлический <w>скрежет</w> нарушил ночную тишину."
                            }
                        },
                        {
                            "text": "We listened closely to the steady <w>rasping</w> of heavy breathing.",
                            "target_lang_translations": {
                                "ru": "Мы внимательно прислушивались к ровным <w>хрипам</w> тяжёлого дыхания."
                            }
                        }
                    ],
                    "synonyms": [
                        "scraping",
                        "grating"
                    ],
                    "common_phrases": [
                        "metallic rasping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий, скребущий или скрежещущий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрежет",
                                "target_lang_sense_clarification": "резкий звук трения"
                            },
                            {
                                "target_lang_word": "хрип",
                                "target_lang_sense_clarification": "тяжёлый звук дыхания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d860333b-e1e2-3e5d-b7c6-b561affc9b64",
                    "sense_definition": "The action of scraping or abrading an object with a file or coarse tool.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rasping</w> of the metal pipe smoothed down all the dangerous edges.",
                            "target_lang_translations": {
                                "ru": "<w>Опиливание</w> металлической трубы сгладило все опасные края."
                            }
                        },
                        {
                            "text": "Careful <w>rasping</w> ensured the joint fit seamlessly into the socket.",
                            "target_lang_translations": {
                                "ru": "Тщательная <w>зачистка рашпилем</w> позволила детали плотно войти в паз."
                            }
                        }
                    ],
                    "synonyms": [
                        "filing",
                        "scraping",
                        "abrading"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по зачистке или опиливанию предмета рашпилем либо грубым инструментом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опиливание",
                                "target_lang_sense_clarification": "обработка рашпилем или напильником"
                            },
                            {
                                "target_lang_word": "зачистка",
                                "target_lang_sense_clarification": "снятие неровностей рашпилем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}