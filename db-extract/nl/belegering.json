                "senses": [
                    {
                        "sense_id": "a86f84a4-d61c-3dfe-b455-865fa739955d",
                        "entry_id": "ca77564f-02e0-3f80-bf76-9d6e1d135037",
                        "glosses": [
                            "een langdurige militaire blokkade en aanval op een stad of fort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c173b00e-7e60-4fb3-bf75-6866a8eae9bf",
                                "sense_id": "a86f84a4-d61c-3dfe-b455-865fa739955d",
                                "text": "Met een belegering wordt een stad zo mogelijk volledig omsloten en afgesloten van de buitenwereld."
                            },
                            {
                                "example_id": "39b8078d-f0af-418a-a9b6-e7d41130a445",
                                "sense_id": "a86f84a4-d61c-3dfe-b455-865fa739955d",
                                "text": "Nu zat de hele wereld achter me aan. Zo’n batterij wagens voor het huis en voor het restaurant van mijn vriend. Een belegering, ik werd paranoïde. Om de paar minuten ging er een telefoon. Ik durfde niet op te nemen, rende het balkon op als er een overging. En daar stonden dan weer al die camera’s op me gericht. Een biefstuk in een arena vol leeuwen. Trekken ze dat valhek open en stormen al die leeuwen op je af."
                            }
                        ]
                    }
                ],
