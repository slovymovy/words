                "senses": [
                    {
                        "sense_id": "70cf1b3a-1c02-395a-82cf-e9e68e74f1c1",
                        "entry_id": "505dc0aa-2256-33d3-99af-41c627b3b692",
                        "glosses": [
                            "устар. поездка, путешествие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d50155-6794-4b87-80cb-ede31a8f7172",
                                "sense_id": "70cf1b3a-1c02-395a-82cf-e9e68e74f1c1",
                                "text": "Я думаю, после столицы вояжировка вам показалась очень неприятною."
                            },
                            {
                                "example_id": "d5ae737d-35e3-4aa0-8f33-fea61c8096a0",
                                "sense_id": "70cf1b3a-1c02-395a-82cf-e9e68e74f1c1",
                                "text": "Во всё время нашей вояжировки стояла тёплая, ясная погода, хотя дело уже близилось к осени."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c01b997f-73d0-4658-96a1-69915ea36517",
                        "source_entry_id": "505dc0aa-2256-33d3-99af-41c627b3b692",
                        "source_sense_id": "70cf1b3a-1c02-395a-82cf-e9e68e74f1c1",
                        "target_lang_word": "voyage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voyage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c672fa06-6d7e-3269-acd1-da2ae13ee774",
                                        "entry_id": "bc47129a-3a5f-339a-b822-e3bd08b44b4a",
                                        "glosses": [
                                            "A long journey, especially by ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701dd278-cf9c-41b7-a943-84e083088b9e",
                                                "sense_id": "c672fa06-6d7e-3269-acd1-da2ae13ee774",
                                                "text": "He went on a voyage to France."
                                            },
                                            {
                                                "example_id": "2fd067a1-d459-4fb2-b838-28a061dc7ead",
                                                "sense_id": "c672fa06-6d7e-3269-acd1-da2ae13ee774",
                                                "text": "There is a Tide in the affayres of men, / Which taken at the Flood, leades on to Fortune: / Omitted, all the voyage of their life, / Is bound in Shallowes, and in Miſeries."
                                            },
                                            {
                                                "example_id": "1f4bc805-b23b-4a82-a285-4ab28f080f3b",
                                                "sense_id": "c672fa06-6d7e-3269-acd1-da2ae13ee774",
                                                "text": "I love a Sea voyage and a bluſtring tempeſt; [...]"
                                            },
                                            {
                                                "example_id": "4ceca2f7-2cce-4263-a963-0730ad0a5ef6",
                                                "sense_id": "c672fa06-6d7e-3269-acd1-da2ae13ee774",
                                                "text": "\"And as their valour, so you trow, defied\non aspe'rous voyage cruel harm and sore,\nso many changing skies their manhood tried,\nsuch climes where storm-winds blow and billows roar[.]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f92cc84e-e251-3aba-8169-7e2324c439bb",
                                        "entry_id": "bc47129a-3a5f-339a-b822-e3bd08b44b4a",
                                        "glosses": [
                                            "A written account of a journey or travel."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c603b8e4-ce4a-4c03-9fe5-68d2cb1e5ed4",
                                                "sense_id": "f92cc84e-e251-3aba-8169-7e2324c439bb",
                                                "text": "I cannot learn what his Name was, unleſs by the Inſcription of the Letters he ſent to the Pope, and to the French King in the Year 1688, mentioned in the ſecond Voyage of Father Tachard […]"
                                            },
                                            {
                                                "example_id": "79789c80-2b07-4a85-9bbc-aa02c8b6adec",
                                                "sense_id": "f92cc84e-e251-3aba-8169-7e2324c439bb",
                                                "text": "By the various Relations, Embaſſies and Voyages of Siam that have been publiſht within theſe laſt Four Years […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86784393-4a07-3e76-9f2a-4dfa3a346225",
                                        "entry_id": "bc47129a-3a5f-339a-b822-e3bd08b44b4a",
                                        "glosses": [
                                            "The act or practice of travelling."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32efea93-b255-49a1-9536-9e967116b4e3",
                                                "sense_id": "86784393-4a07-3e76-9f2a-4dfa3a346225",
                                                "text": "[...] [A]ll Nations haue Enterknowledge one of another, either by Voyage into Forreine Parts, or by Strangers that come to them: [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voyage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8685ae00-6e2b-34bf-8296-a05c112def21",
                                        "entry_id": "0efcdfc2-05ed-30bd-acce-20af5d08cb40",
                                        "glosses": [
                                            "To go on a long journey."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e457e5-feff-478e-9181-7ef03f0f2de3",
                                                "sense_id": "8685ae00-6e2b-34bf-8296-a05c112def21",
                                                "text": "A mind forever voyaging through strange seas of thought alone."
                                            },
                                            {
                                                "example_id": "408d02ca-6161-427f-a8ea-4a9b708c4570",
                                                "sense_id": "8685ae00-6e2b-34bf-8296-a05c112def21",
                                                "text": "O soul, voyagest thou indeed on voyages like those? / Disportest thou on waters such as those?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
