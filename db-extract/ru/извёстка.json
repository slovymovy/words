                    {
                        "translation_id": "58933aa2-125e-4c5b-8dec-203009928068",
                        "source_entry_id": "59abeae1-5fd9-3a82-ace8-e35e06f9a0d1",
                        "source_sense_description": "известь",
                        "target_lang_word": "Kalk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2686f1f-d0fe-3211-abad-0c1cf89a930e",
                                        "entry_id": "ce9a21c5-be58-3058-944d-6d1ff556e742",
                                        "glosses": [
                                            "Rohstoff im Baugewerbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcd9dd7-6266-4477-8eb4-aacfb803f579",
                                                "sense_id": "e2686f1f-d0fe-3211-abad-0c1cf89a930e",
                                                "text": "War Anhydrit nicht die Vorstufe zu Kalk?"
                                            },
                                            {
                                                "example_id": "ca893ccb-eb77-4610-935b-ba4c7d1d4493",
                                                "sense_id": "e2686f1f-d0fe-3211-abad-0c1cf89a930e",
                                                "text": "Der Sack mit Kalk wiegt einen Zentner."
                                            },
                                            {
                                                "example_id": "e5e31f62-0b79-4f67-a5ed-4f7eb985d47f",
                                                "sense_id": "e2686f1f-d0fe-3211-abad-0c1cf89a930e",
                                                "text": "„Die Wände waren gekalkt, doch unter dem Kalk erkannte man dort, wo der Anstrich abgeblättert war, wieder die hellblaue Farbe von Kuźnice.“"
                                            },
                                            {
                                                "example_id": "7c31861f-954d-4ec5-82ca-0e9d1f61b14e",
                                                "sense_id": "e2686f1f-d0fe-3211-abad-0c1cf89a930e",
                                                "text": "„Je nach Region variieren die Materialien von gebrannten Tonen, Kalken und Marmoren.“"
                                            },
                                            {
                                                "example_id": "c45dd3f1-2c71-4438-9f02-a677b4defb56",
                                                "sense_id": "e2686f1f-d0fe-3211-abad-0c1cf89a930e",
                                                "text": "„Ursprünglich umgab wohl nur eine Hecke den Kultbezirk, nach der römischen Eroberung wurde er aber als modernes Gebäude aus Mauerwerk und gebranntem Kalk aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
