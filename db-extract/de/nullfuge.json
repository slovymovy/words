                "senses": [
                    {
                        "sense_id": "5b1ab17a-80a0-3a78-bbe2-f58a4a90a3eb",
                        "entry_id": "6b3c18b8-9eb2-3dde-899e-d7860ae955a7",
                        "glosses": [
                            "nicht vorhandenes Fugenelement in einem komplexen Wort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de43935f-a9b5-4cd8-aada-b797a3214451",
                                "sense_id": "5b1ab17a-80a0-3a78-bbe2-f58a4a90a3eb",
                                "text": "„Ganz verbreitet ist schließlich das Reden von einer Nullfuge (…).“"
                            },
                            {
                                "example_id": "85735c66-5cbe-4422-a5c8-86024e44aec9",
                                "sense_id": "5b1ab17a-80a0-3a78-bbe2-f58a4a90a3eb",
                                "text": "„Demnach ist ein leichter Rückgang des Anteils der Nullfuge am Gesamtvorkommen vom Frühneuhochdeutschen zum Neuhochdeutschen zu konstatieren.“"
                            },
                            {
                                "example_id": "ecb5e245-2436-4356-b70b-a444779a1e56",
                                "sense_id": "5b1ab17a-80a0-3a78-bbe2-f58a4a90a3eb",
                                "text": "„In beiden Sprachen ist es vor allem die -s-Fuge, die neben der Nullfuge hohe Frequenz aufweist.“"
                            },
                            {
                                "example_id": "b7574cdb-371d-496a-ab6b-3b12011c988d",
                                "sense_id": "5b1ab17a-80a0-3a78-bbe2-f58a4a90a3eb",
                                "text": "„Sie stützt sich dabei auf die Tatsache, dass die eigentlichen Komposita mit einer Nullfuge im Althochdeutschen nicht von den uneigentlichen Komposita unterschieden werden können (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
