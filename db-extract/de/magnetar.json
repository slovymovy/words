                        "cross_references": [
                            {
                                "target_word": "magnetar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e43aa64d-1f20-3f89-bb5b-f4519e2d14ee",
                                        "entry_id": "8479d172-c0df-337d-9345-762ee3b032d4",
                                        "glosses": [
                                            "neutronenster met een uitzonderlijk krachtig magnetisch veld, dat vele malen sterker is dan dat van een gewone neutronenster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebb8cfbd-e929-4e0d-b00a-cc699231377e",
                                                "sense_id": "e43aa64d-1f20-3f89-bb5b-f4519e2d14ee",
                                                "text": "Een magnetar is een bijzonder soort neutronenster - het stoffelijk overschot van een zware ster die aan het eind van zijn leven is geëxplodeerd."
                                            },
                                            {
                                                "example_id": "d310dc3d-376f-4f7b-9f6f-89e7dd29fc03",
                                                "sense_id": "e43aa64d-1f20-3f89-bb5b-f4519e2d14ee",
                                                "text": "Dat valt met een solitaire magnetar niet eenvoudig te verklaren, aldus Hessels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2c2b040-afa0-44e8-8afc-a5d762c803f5",
                        "source_entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "source_sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
