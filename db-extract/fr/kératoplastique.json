                ],
                "senses": [
                    {
                        "sense_id": "1f1430a0-3a91-3860-86a9-9834fa5e1329",
                        "entry_id": "6c75fe6c-bc80-33a3-bde1-5f902adf9ccf",
                        "glosses": [
                            "Qui concerne les greffes de cornée, la kératoplastie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8150b31-3afa-412c-b150-752ebe9609f6",
                                "sense_id": "1f1430a0-3a91-3860-86a9-9834fa5e1329",
                                "text": "En 1831, M. Diffenbach communiquait les résultats des expériences kératoplastiques qu’il avait faites en grand nombre, mais sans succès."
                            },
                            {
                                "example_id": "72df35c5-b3fb-4d30-b95b-12a9afe07663",
                                "sense_id": "1f1430a0-3a91-3860-86a9-9834fa5e1329",
                                "text": "La présence d’un astigmatisme irrégulier après chirurgie cornéenne (réfractive, kératoplastique, post-traumatique) impose de recourir à une lentille rigide perméable aux gaz afin de restaurer un dioptre antérieur régulier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f711d709-d3c4-386c-95b6-135ab2a5fc94",
                        "entry_id": "6c75fe6c-bc80-33a3-bde1-5f902adf9ccf",
                        "glosses": [
                            "Qui facilite la régénération de l’épiderme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9809ec1e-99ff-438f-8163-9b8d4f7c57af",
                                "sense_id": "f711d709-d3c4-386c-95b6-135ab2a5fc94",
                                "text": "Sa forte teneur en soufre lui confère une propriété kératoplastique, c’est-à-dire qu’elle facilite la régénération de l’épiderme."
                            },
                            {
                                "example_id": "22a6feef-97f8-45ad-998f-ee55ca49bacf",
                                "sense_id": "f711d709-d3c4-386c-95b6-135ab2a5fc94",
                                "text": "Le coaltar est un goudron obtenu à partir de la houille (une qualité spécifique de charbon). Il a des propriétés kératolytiques et kératoplastiques mais aussi de nombreux effets indésirables et présente un risque cancérigène."
                            },
                            {
                                "example_id": "a94934a3-e402-4de5-bc7a-f2de6c800fa3",
                                "sense_id": "f711d709-d3c4-386c-95b6-135ab2a5fc94",
                                "text": "Les acides de fruits doux ont un effet antibactérien et kératoplastique."
                            }
                        ]
                    }
                ],
