                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b0014b-2cc6-4a00-bbf5-a214652ad86b",
                                "sense_id": "22af1f9a-d396-31a7-a36a-3125652e7251",
                                "text": "Marie Loke bezat een zeker flegma en relativeringsvermogen. Ze besefte dat het vrouwenkiesrecht er ook zonder haar inspanningen zou komen, omdat het volgens haar een onafwijsbare eisch des tijds was. Toch vond ze dat ze er in haar positie als lector niet onderuit kwam in het plaatselijk bestuur zitting te nemen, meent De Wilde."
                            }
                        ]
                    }
