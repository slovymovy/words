                "senses": [
                    {
                        "sense_id": "d0fe7a0e-346b-34fa-b56a-eee7d64c8f0c",
                        "entry_id": "8285ebc6-9514-3ce3-af8f-9c714b248f47",
                        "glosses": [
                            "any flowering plant having (a) starlike, star-shaped flower(s) in bloom (e.g. Aster, Astrantia major)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "78f923e0-80c0-4e1e-8171-432e0bf97b9d",
                                "sense_id": "d0fe7a0e-346b-34fa-b56a-eee7d64c8f0c",
                                "text": "An den Abhaͤngen bluͤhten schon die weißen Sternblumen und die Weidenzweige hingen tief herunter.",
                                "translation": "The white star-shaped flowers were already blooming on the slopes and the willow branches hung low.",
                                "english": "The white star-shaped flowers were already blooming on the slopes and the willow branches hung low."
                            },
                            {
                                "example_id": "1dff85e5-f892-4002-b85e-9f227f4f4e80",
                                "sense_id": "d0fe7a0e-346b-34fa-b56a-eee7d64c8f0c",
                                "text": "Das dunkle Goldgelb und Violett der Stiefmütterchen, welche die Wege säumten, floß in dem Schmelztiegel eines Demiurgen wie Gold und Eisen zusammen; Sternblumen traten in das Gestein, das sie entlassen hatte, zurück und glänzten wie Bergkristalle; […]",
                                "translation": "The dark golden-yellow and violet of the pansies that lined the paths coalesced in the demiurge’s melting pot like gold and iron; star-shaped flowers receded from the rocks that released them and sparkled like rock crystals; […]",
                                "english": "The dark golden-yellow and violet of the pansies that lined the paths coalesced in the demiurge’s melting pot like gold and iron; star-shaped flowers receded from the rocks that released them and sparkled like rock crystals; […]"
                            }
                        ]
                    }
