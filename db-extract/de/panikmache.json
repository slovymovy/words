                                    {
                                        "sense_id": "ae2a28ee-1d34-37fe-9c26-d24492d34845",
                                        "entry_id": "17b5ecad-c9fa-3855-a374-ec94242d7cab",
                                        "glosses": [
                                            "The raising of needless alarms."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dfd54e4-d060-43e2-954e-dcb94e00fbaa",
                                                "sense_id": "ae2a28ee-1d34-37fe-9c26-d24492d34845",
                                                "text": "Even as the White House highlighted what it considers alarmism in reporting of the surge in cases of the Delta coronavirus variant across the US, reports in the same national media suggested vaccinations are increasing in hotspot areas."
                                            },
                                            {
                                                "example_id": "3516425b-ab43-49ca-96af-8bcf9b2a8404",
                                                "sense_id": "ae2a28ee-1d34-37fe-9c26-d24492d34845",
                                                "text": "Rees-Mogg has claimed that “climate alarmism” is responsible for high energy prices and that it is unrealistic for scientists to project future changes to the climate because meteorologists struggle to correctly predict the weather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b5144eb-8025-4a3f-92fb-4cfa60632585",
                        "source_entry_id": "3e193afe-7d55-3592-a57e-febb42d1ba2d",
                        "source_sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                        "source_sense_description": "umgangssprachlich abwertend: Versuch, künstlich Panik zu verursachen",
