                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3aac31c9-7133-46e3-ac20-2279425c2097",
                        "source_entry_id": "eafce060-51e2-3722-a8f5-770ada97665b",
                        "source_sense_id": "dae4930c-a231-3d07-87de-98ff538288e1",
