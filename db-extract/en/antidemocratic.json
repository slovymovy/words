                        "cross_references": [
                            {
                                "target_word": "antidemocratisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "79a9c2ae-34da-3f26-bb06-e3fa85ea05d6",
                                        "entry_id": "27fecb66-0353-3893-8beb-d4d1e3bc06fd",
                                        "glosses": [
                                            "gericht tegen de democratie en voor de een of andere vorm van dictatuur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebfe49e-6fd6-4ee5-b7ba-b5963af4b86c",
                                                "sense_id": "79a9c2ae-34da-3f26-bb06-e3fa85ea05d6",
                                                "text": "Ook de Volkskrant kwam tijdens meer dan tien bezoeken en tientallen gesprekken met de schoolleiding, docenten, medewerkers, ouders, vrijwilligers en externen geen bewijzen tegen van salafistische invloeden of antidemocratisch onderwijs."
                                            },
                                            {
                                                "example_id": "b981965a-67dd-4136-a6cb-5d533d7757cb",
                                                "sense_id": "79a9c2ae-34da-3f26-bb06-e3fa85ea05d6",
                                                "text": "Kaplan streefde het ideaal van een eigen islamitische staat na, zo’n staat zou volgens hem via democratische weg nooit mogelijk zijn. De beweging is anti-Amerikaans, antisemitisch en antidemocratisch"
                                            },
                                            {
                                                "example_id": "a4a5684b-b1a1-4abe-9630-d90531d4b927",
                                                "sense_id": "79a9c2ae-34da-3f26-bb06-e3fa85ea05d6",
                                                "text": "Philips en Ahold doneerden geld aan antidemocratische politici in de VS."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f6178b4-4cb4-4760-92b5-96b5e3e977a5",
                        "source_entry_id": "d64444da-6d11-314c-872e-855e6b9425d0",
                        "source_sense_id": "fc68df52-14e5-394d-bb5d-dff82e784fad",
                        "source_sense_description": "opposed to the tenets of democracy",
                        "target_lang_word": "antidémocratique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidémocratique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e38a51b5-df3d-3568-8d98-fa85277348b7",
                                        "entry_id": "fa42f509-b22f-37ed-b7b3-6870b64c0d0a",
                                        "glosses": [
                                            "Opposé à la démocratie ; qui est non démocratique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e50d8fc-4dda-43aa-be15-a6e7cef790c2",
                                                "sense_id": "e38a51b5-df3d-3568-8d98-fa85277348b7",
                                                "text": "Le régime algérien reste foncièrement antidémocratique, convaincu que toutes les forces de revendication sont ses ennemies."
                                            },
                                            {
                                                "example_id": "b79d68d1-488c-4f45-b678-01cca2681d94",
                                                "sense_id": "e38a51b5-df3d-3568-8d98-fa85277348b7",
                                                "text": "Il faut compter sur le bon sens et sur le courage des futurs dirigeants de la France pour écarter d'emblée la perspective de créer aujourd'hui, à partir de l'euro, une Fédération européenne qui serait à la fois antidémocratique et ruineuse."
                                            },
                                            {
                                                "example_id": "e79da46b-8bbb-4b96-be76-1bbc3b9239a6",
                                                "sense_id": "e38a51b5-df3d-3568-8d98-fa85277348b7",
                                                "text": "De nombreux chercheurs et penseurs se sont penchés sur l'origine des sociétés antidémocratiques qui ont émergé tout au long du vingtième siècle. Certains ont, ainsi, voulu rendre compte de la montée du fascisme européen à travers le rapport individuel au pouvoir."
                                            },
                                            {
                                                "example_id": "d74b4fe4-4e1d-45d9-972a-8573ddf2db86",
                                                "sense_id": "e38a51b5-df3d-3568-8d98-fa85277348b7",
                                                "text": "\"Nous assistons à une nouvelle dimension de la violence antidémocratique\", a déclaré Mme Faeser."
                                            },
                                            {
                                                "example_id": "589d540a-0016-40c9-b34d-13b4bb0aa64c",
                                                "sense_id": "e38a51b5-df3d-3568-8d98-fa85277348b7",
                                                "text": "Le 5 avril 2024, le Mouvement socialiste russe (RSM) a été déclaré « agent étranger ». Cela a constitué le premier précédent lorsque les autorités russes ont interdit de facto une organisation de gauche : il est évident que la loi oppressive et antidémocratique de Poutine élimine toute possibilité d’activité politique sous ce nom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "492608f3-f216-46c7-af41-d6c9e58f102d",
                        "source_entry_id": "d64444da-6d11-314c-872e-855e6b9425d0",
                        "source_sense_id": "fc68df52-14e5-394d-bb5d-dff82e784fad",
                        "source_sense_description": "opposed to the tenets of democracy",
                        "target_lang_word": "antidemokratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidemokratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "949d5c30-e971-3648-b07d-f7314cbbe9f4",
                                        "entry_id": "19efdad5-e671-3fb7-be0b-0cfa0700dabd",
                                        "glosses": [
                                            "gegen die Demokratie gerichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584ac7bf-dd0b-43e2-a0c9-5490799340c6",
                                                "sense_id": "949d5c30-e971-3648-b07d-f7314cbbe9f4",
                                                "text": "„Der deutsche Konservatismus jener Jahre hatte sich nicht begnügt mit seinen sittlichen Klageliedern, sondern hatte sich eingehüllt in antidemokratische Gesinnung, Führerkult und historisch absurde germanisierende Mythenbildung bis hin zum elenden Rassismus und Antisemitismus der dreißiger und vierziger Jahre.“"
                                            },
                                            {
                                                "example_id": "8a6182e0-7c7c-4215-80aa-b8221823b197",
                                                "sense_id": "949d5c30-e971-3648-b07d-f7314cbbe9f4",
                                                "text": "„Die Regierungserfolge populistischer Bewegungen und antidemokratischer Parteien sind zwar dürftig, aber die Wähler scheint dies nicht zu stören.“"
                                            },
                                            {
                                                "example_id": "8712e93b-5685-4b38-81d9-76ce273d0c8c",
                                                "sense_id": "949d5c30-e971-3648-b07d-f7314cbbe9f4",
                                                "text": "„Die CDU-Vertreter im Rundfunkrat schrieben deshalb vergangene Woche einen Brief an Buhrow: ‚Antidemokratische Hassbotschaften‘ von Mitarbeitern seien nicht akzeptabel, die Anstalt müsse sich von Kindler trennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b356ea12-a489-4666-a88f-8feb658e902a",
