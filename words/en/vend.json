{
    "word_family": [
        "vendor",
        "vending"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6020f89e-5903-3cc9-ac0a-fc3da74889ed",
                    "sense_definition": "To sell goods, especially through an automated machine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "selling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>vend</w> healthy snacks through new machines in schools.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf is van plan om gezonde snacks via nieuwe automaten op scholen te <w>verkopen</w>."
                            }
                        },
                        {
                            "text": "Local farmers often <w>vend</w> their fresh produce at the weekend market.",
                            "target_lang_translations": {
                                "nl": "Lokale boeren <w>verkopen</w> hun verse producten vaak op de weekendmarkt."
                            }
                        }
                    ],
                    "synonyms": [
                        "sell"
                    ],
                    "common_phrases": [
                        "vend snacks",
                        "vend drinks"
                    ],
                    "target_lang_definitions": {
                        "nl": "Goederen verkopen, met name via een automaat of op straat."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verkopen",
                                "target_lang_sense_clarification": "algemeen"
                            },
                            {
                                "target_lang_word": "slijten",
                                "target_lang_sense_clarification": "aan de man brengen"
                            },
                            {
                                "target_lang_word": "venten",
                                "target_lang_sense_clarification": "op straat verkopen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d06f7045-c53d-32b5-864a-1751775e5a8e",
                    "sense_definition": "To provide or export digital functionality or data, often via an API.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "selling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server is configured to <w>vend</w> JSON data to authorized client applications.",
                            "target_lang_translations": {
                                "nl": "De server is geconfigureerd om JSON-gegevens aan geautoriseerde clienttoepassingen te <w>leveren</w>."
                            }
                        },
                        {
                            "text": "Developers use this interface to <w>vend</w> specific services to external partners.",
                            "target_lang_translations": {
                                "nl": "Ontwikkelaars gebruiken deze interface om specifieke diensten <w>beschikbaar te stellen</w> aan externe partners."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Digitale functionaliteit of gegevens beschikbaar stellen of leveren, vaak via een API."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "leveren",
                                "target_lang_sense_clarification": "van data of diensten"
                            },
                            {
                                "target_lang_word": "beschikbaar stellen",
                                "target_lang_sense_clarification": "aanbieden via een interface"
                            },
                            {
                                "target_lang_word": "uitgeven",
                                "target_lang_sense_clarification": "verstrekken van tokens of gegevens"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98b5cce9-5d94-335f-a9a7-e27be7db42e7",
                    "sense_definition": "The act of selling something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "selling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old market records note the <w>vend</w> of cattle and wool at the annual fair.",
                            "target_lang_translations": {
                                "nl": "Oude marktarchieven vermelden de <w>verkoop</w> van vee en wol op de jaarlijkse jaarmarkt."
                            }
                        },
                        {
                            "text": "Strict regulations govern the <w>vend</w> of alcohol in this district.",
                            "target_lang_translations": {
                                "nl": "Strenge regels bepalen de <w>verkoop</w> van alcohol in dit district."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "obsolete; 'sale' is used"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het verkopen van iets (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verkoop",
                                "target_lang_sense_clarification": "de handeling van het verkopen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c570ae4c-4a1b-36cc-9c15-93e0143d8b94",
                    "sense_definition": "The total quantity of coal sold from a mine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical records show a significant increase in the annual <w>vend</w> from the northern collieries.",
                            "target_lang_translations": {
                                "nl": "Historische gegevens tonen een aanzienlijke stijging in de jaarlijkse <w>steenkoolafzet</w> van de noordelijke mijnen."
                            }
                        },
                        {
                            "text": "The mine manager carefully tracked the daily <w>vend</w> to ensure production targets were met.",
                            "target_lang_translations": {
                                "nl": "De mijnbeheerder hield de dagelijkse <w>kolenverkoop</w> nauwlettend in de gaten om ervoor te zorgen dat de productiedoelen werden gehaald."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in historical contexts regarding coal mining."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De totale hoeveelheid steenkool die vanuit een mijn wordt verkocht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "steenkoolafzet",
                                "target_lang_sense_clarification": "verkochte hoeveelheid steenkool"
                            },
                            {
                                "target_lang_word": "kolenverkoop",
                                "target_lang_sense_clarification": "totale verkoop van kolen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "287e6fc8-8a65-39d6-92cf-6833599e0ecd",
                    "sense_definition": "A member of a historical Balto-Finnic people from the region of Wenden in Latvia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Vends</w> were an influential group in the Baltic region during the Middle Ages.",
                            "target_lang_translations": {
                                "nl": "De <w>Wenden</w> waren tijdens de middeleeuwen een invloedrijke groep in het Baltische gebied."
                            }
                        },
                        {
                            "text": "Archaeological evidence provides insight into the daily lives of the <w>Vends</w>.",
                            "target_lang_translations": {
                                "nl": "Archeologisch bewijs biedt inzicht in het dagelijks leven van de <w>Wenden</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een lid van een historisch Balto-Fins volk uit de regio Wenden in Letland."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Wend",
                                "target_lang_sense_clarification": "historisch volk in Letland"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}