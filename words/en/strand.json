                                "target_lang_word": "缕",
                                "target_lang_sense_clarification": "细长物的一根，如头发、面条"
                            },
                            {
                                "target_lang_word": "根",
                                "target_lang_sense_clarification": "细长条状物的一根"
                            },
                            {
                                "target_lang_word": "丝",
                                "target_lang_sense_clarification": "单独的一丝或一条"
                            }
                        ]
