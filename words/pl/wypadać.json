{
    "word_family": [
        "wypadek",
        "wypadkowy",
        "wypadnięcie",
        "wypad"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4fc63d4-b55b-31fb-b5f2-57af9f93d81a",
                    "sense_definition": "poruszać się w dół z wnętrza lub ze środka czegoś pod wpływem grawitacji",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy biegłem do autobusu, telefon zaczął mi <w>wypadać</w> z kieszeni.",
                            "target_lang_translations": {
                                "ru": "Когда я бежал к автобусу, телефон начал <w>выпадать</w> у меня из кармана."
                            }
                        },
                        {
                            "text": "Zniszczona książka była tak stara, że powoli <w>wypadały</w> z niej kolejne kartki.",
                            "target_lang_translations": {
                                "ru": "Потрёпанная книга была такой старой, что из неё постепенно <w>выпадали</w> очередные страницы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wypadać z kieszeni",
                        "wypadać z rąk"
                    ],
                    "target_lang_definitions": {
                        "ru": "падать наружу, валиться изнутри или из середины чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпадать",
                                "target_lang_sense_clarification": "падать наружу, из чего-либо"
                            },
                            {
                                "target_lang_word": "вываливаться",
                                "target_lang_sense_clarification": "падать наружу с усилием или массой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76e9a3cf-1cc4-34f4-bd6f-bb87547e6ad8",
                    "sense_definition": "być zgodnym z przyjętymi normami zachowania lub etykietą",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stosowność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W towarzystwie starszych osób zupełnie nie <w>wypada</w> głośno przeklinać.",
                            "target_lang_translations": {
                                "ru": "В обществе пожилых людей совершенно не <w>подобает</w> громко ругаться матом."
                            }
                        },
                        {
                            "text": "Czy naprawdę <w>wypada</w> pójść na tak eleganckie przyjęcie w zwykłych dżinsach?",
                            "target_lang_translations": {
                                "ru": "Неужели правда <w>прилично</w> пойти на столь элегантный приём в обычных джинсах?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nie wypada",
                        "tak nie wypada"
                    ],
                    "target_lang_definitions": {
                        "ru": "соответствовать принятым нормам поведения, приличиям или этикету (в безличном употреблении)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобает",
                                "target_lang_sense_clarification": "соответствует правилам приличия"
                            },
                            {
                                "target_lang_word": "прилично",
                                "target_lang_sense_clarification": "согласно правилам этикета"
                            },
                            {
                                "target_lang_word": "следует",
                                "target_lang_sense_clarification": "принято так поступать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e73facd-8d22-39d5-a63d-37461e28c6c6",
                    "sense_definition": "mieć wyznaczony termin lub przypadać na określony dzień",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moje urodziny zazwyczaj <w>wypadają</w> w środku tygodnia roboczego.",
                            "target_lang_translations": {
                                "ru": "Мой день рождения обычно <w>выпадает</w> на середину рабочей недели."
                            }
                        },
                        {
                            "text": "W tym roku to ważne święto państwowe <w>wypada</w> w niedzielę.",
                            "target_lang_translations": {
                                "ru": "В этом году этот важный государственный праздник <w>приходится</w> на воскресенье."
                            }
                        }
                    ],
                    "synonyms": [
                        "przypadać"
                    ],
                    "common_phrases": [
                        "wypadać w niedzielę",
                        "wypadać w święto"
                    ],
                    "target_lang_definitions": {
                        "ru": "приходиться на определённый день или дату"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпадать",
                                "target_lang_sense_clarification": "о датах, днях недели, праздниках"
                            },
                            {
                                "target_lang_word": "приходиться",
                                "target_lang_sense_clarification": "о сроках или днях календаря"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6836797-32c9-3153-99f3-af5519097b3a",
                    "sense_definition": "zaprezentować się w określony sposób lub wywrzeć jakieś wrażenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ocena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody muzyk zawsze bardzo dobrze <w>wypada</w> przed wymagającą publicznością.",
                            "target_lang_translations": {
                                "ru": "Молодой музыкант всегда очень хорошо <w>выглядит</w> перед требовательной публикой."
                            }
                        },
                        {
                            "text": "Podczas rozmowy o pracę starał się nie <w>wypadać</w> zbyt pewnie siebie.",
                            "target_lang_translations": {
                                "ru": "Во время собеседования он старался не <w>смотреться</w> чересчур самоуверенным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dobrze wypadać",
                        "słabo wypadać"
                    ],
                    "target_lang_definitions": {
                        "ru": "показывать себя определённым образом, производить впечатление при оценке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выглядеть",
                                "target_lang_sense_clarification": "производить впечатление со стороны"
                            },
                            {
                                "target_lang_word": "показывать себя",
                                "target_lang_sense_clarification": "проявлять себя в чьих-либо глазах"
                            },
                            {
                                "target_lang_word": "смотреться",
                                "target_lang_sense_clarification": "восприниматься окружающими"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}