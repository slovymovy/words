                    },
                    {
                        "translation_id": "e913d21a-431e-4b6f-bb49-3de3ff246780",
                        "source_entry_id": "7a37dff0-7fc9-318f-991d-f6cc33cdcf5d",
                        "source_sense_id": "c195a439-ed59-3534-b39f-f1bd4f0a6ee9",
                        "target_lang_word": "ноутбук",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ноутбук",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd1d35f-d7c3-38b7-8fdb-2b6b2e7f2444",
                                        "entry_id": "fd969e7d-8980-3de1-aee2-bb74c78ba002",
                                        "glosses": [
                                            "комп. переносной компьютер, выполненный в виде вертикально раскрывающейся книжки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e036573-6410-4e2c-ac31-88e19d087c3f",
                                                "sense_id": "2bd1d35f-d7c3-38b7-8fdb-2b6b2e7f2444",
                                                "text": "Тамаре Владиславовне удалось вызволить переносной компьютер от уволившейся сотрудницы. Шеф разрешил ей забрать ноутбук домой. Чтобы она могла работать вечерами, возвращаясь домой пораньше, и в выходные, не тратя время на дорогу до офиса."
                                            },
                                            {
                                                "example_id": "c8d4c170-4549-487f-824f-482d4e44c5f0",
                                                "sense_id": "2bd1d35f-d7c3-38b7-8fdb-2b6b2e7f2444",
                                                "text": "Ярик отвёл взгляд от монитора и перестал стучать по клавиатуре стоящего на коленях ноутбука."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
