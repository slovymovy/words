            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5cb42185-08a3-3654-b794-05bdcd909426",
                    "sense_definition": "At any time; whenever one desires.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can call me <w>anytime</w> if you have questions about the project.",
                            "target_lang_translations": {
                                "ru": "Ты можешь звонить мне <w>в любое время</w>, если у тебя есть вопросы по проекту.",
                                "zh": "如果你对项目有疑问，可以<w>随时</w>给我打电话。"
                            }
                        },
                        {
                            "text": "I do not expect the package to arrive <w>anytime</w> soon.",
                            "target_lang_translations": {
                                "ru": "Я не ожидаю, что посылка придет <w>в ближайшее время</w>.",
                                "zh": "我不指望包裹很快就能送到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whenever"
                    ],
                    "antonyms": [
                        "never"
                    ],
                    "common_phrases": [
                        "anytime soon",
                        "available anytime"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любой момент; когда захочется.",
                        "zh": "在任何时候；无论何时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в любое время",
                                "target_lang_sense_clarification": "общий перевод"
                            },
                            {
                                "target_lang_word": "когда угодно",
                                "target_lang_sense_clarification": "по желанию"
                            },
                            {
                                "target_lang_word": "в любой момент",
                                "target_lang_sense_clarification": "синоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随时",
                                "target_lang_sense_clarification": "表示在任何时间都可以"
                            },
                            {
                                "target_lang_word": "任何时候",
                                "target_lang_sense_clarification": "强调时间上的不限"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "8eb75fed-d82d-3b7a-b2db-ad5e57230354",
                    "sense_definition": "Used as a polite response to thanks, meaning one was happy to help.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thank you for the ride home. — <w>Anytime</w>!",
                            "target_lang_translations": {
                                "ru": "Спасибо, что подвез домой. — <w>Обращайся</w>!",
                                "zh": "谢谢你送我回家。——<w>别客气</w>！"
                            }
                        },
                        {
                            "text": "Thanks for listening to me. — <w>Anytime</w>, that is what friends are for.",
                            "target_lang_translations": {
                                "ru": "Спасибо, что выслушал меня. — <w>Всегда пожалуйста</w>, для этого и нужны друзья.",
                                "zh": "谢谢你听我倾诉。——<w>随时效劳</w>，朋友就是用来互相支持的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "you're welcome",
                        "no problem",
                        "my pleasure",
                        "Don't mention it",
                        "Not at all"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in casual conversation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый ответ на благодарность, означающий радость помочь.",
                        "zh": "用于礼貌地回应感谢，表示乐于助人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращайся",
                                "target_lang_sense_clarification": "разговорное, дружеское"
                            },
                            {
                                "target_lang_word": "всегда пожалуйста",
                                "target_lang_sense_clarification": "вежливое"
                            },
                            {
                                "target_lang_word": "не за что",
                                "target_lang_sense_clarification": "стандартный ответ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "别客气",
                                "target_lang_sense_clarification": "常用的礼貌回应"
                            },
                            {
                                "target_lang_word": "随时效劳",
                                "target_lang_sense_clarification": "表示乐意再次提供帮助"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae25a7e3-19be-302d-ab65-16a19d78cfb0",
                    "sense_definition": "Suitable for or available at any time; not restricted to a specific schedule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This bank account offers <w>anytime</w> access to your money online.",
                            "target_lang_translations": {
                                "ru": "Этот банковский счет предлагает <w>круглосуточный</w> доступ к вашим деньгам онлайн.",
                                "zh": "这个银行账户提供<w>全天候</w>在线存取款服务。"
                            }
                        },
                        {
                            "text": "Nuts and dried fruit make a great <w>anytime</w> snack.",
                            "target_lang_translations": {
                                "ru": "Орехи и сухофрукты — отличная закуска <w>в любое время</w>.",
                                "zh": "坚果和干果是<w>随时</w>都可以吃的零食。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "anytime access",
                        "anytime snack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий или доступный в любое время; круглосуточный.",
                        "zh": "适合或可在任何时间使用；不受特定时间限制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круглосуточный",
