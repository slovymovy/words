                        ]
                    },
                    {
                        "translation_id": "13bbd280-e278-4835-bc9e-b9fd6015f302",
                        "source_entry_id": "a35aa32d-6c16-3979-89a6-448e96e21780",
                        "source_sense_id": "7166d11a-5927-3fdc-8840-75c5cc452694",
                        "source_sense_description": "Prêtresse de Vesta",
                        "target_lang_word": "весталка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "весталка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                        "entry_id": "8adc5ec1-8274-3bf6-aa21-57f14fcb524e",
                                        "glosses": [
                                            "истор., : жрица Весты, богини домашнего очага, давшая обет целомудрия"
                                        ],
                                        "tags": [
                                            "в Древнем Риме"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc10405-9f0e-4bd6-b961-4d610546dd11",
                                                "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                                "text": "Потом она простилась со своими подругами, и подруги её, все в белом, оплакивали её, как весталки ту неосторожную, у которой потух священный огонь…"
                                            },
                                            {
                                                "example_id": "5fd8df60-9cc4-4864-bf6b-c0be84a6a348",
                                                "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                                "text": "Она не говорила ни с кем, не поднимала покрова с лица перед мужами и была целомудренна, как весталка."
                                            },
                                            {
                                                "example_id": "7859ac25-9568-4057-a5bf-f44e6e4e1d1a",
                                                "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                                "text": "Среди её предков были легендарная дева-весталка Квинта Клавдия, которая, по преданию, силой молитвы сняла с мели и провела вверх по Тибру корабль со святынями богини Кибелы, и не менее легендарный консул Аппий Клавдий Слепой, при котором были построены первый римский водопровод, названный его именем, и дорога от Рима до Капуи ― знаменитая Аппиева дорога."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                        "entry_id": "8adc5ec1-8274-3bf6-aa21-57f14fcb524e",
                                        "glosses": [
                                            "перен., устар., книжн., целомудренная девушка, женщина; девственница"
                                        ],
                                        "tags": [
                                            "часто ирон."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba18e125-d39b-4009-bfee-c5768ad17f17",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Маруха ― Людмила, Марфа ― Мария Николаевна, весталка Дуничка, старые девы: фрейлина, Лидия."
                                            },
                                            {
                                                "example_id": "8f562413-598f-4faa-b6c3-6b4e7e11d16a",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Его теперешнюю жену нельзя узнать, что он из неё сделал в четыре месяца, а была совсем весталка."
                                            },
                                            {
                                                "example_id": "244c2528-ac28-4361-98a7-9de2d0ef69cf",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Даже весталку можно соблазнить лестью."
                                            },
                                            {
                                                "example_id": "b8302e9a-07df-47cd-a110-7045f8d786b5",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Вот потеха! Беременная весталка. И, как он сам говорит, что беременность именно и заставила его жениться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
