                "senses": [
                    {
                        "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                        "entry_id": "ca51e31d-524a-3536-b4d6-d5c204f64831",
                        "glosses": [
                            "Elternteil, der sein Kind oder seine Kinder allein großzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "814845ee-0a54-4f33-96ec-f2ffaefbc4c5",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„Luisa lebt nun zunehmend bei ihrem Vater. Doch Elmar hadert sehr mit seiner Rolle als Alleinerziehender.“"
                            },
                            {
                                "example_id": "8e38362f-e337-45f4-ab44-4d7c235ba8f8",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„»Da gehst Du die Stunde für zwei Euro arbeiten. Aber das ist mir egal. Als Alleinerziehender brauche ich jeden Pfennig. Damit ich 240 Euro mehr im Monat habe.«“"
                            },
                            {
                                "example_id": "efc10b0f-091b-4f19-b1d9-a307991bc58b",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„Die Stellung als Alleinerziehender ist ein Umstand, der sowohl im Sozialrecht auch als im Steuerrecht berücksichtigt wird.“"
                            },
                            {
                                "example_id": "1815241b-0a1d-44f7-a2e1-4c1dce3f77ab",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„Sobald das Kind 3 Jahre alt ist, kann es in den Kindergarten gehen und der Alleinerziehende hat die Möglichkeit wieder einer gewerblichen Tätigkeit nachzugehen.“"
                            },
                            {
                                "example_id": "d5b164d8-d7ac-423c-883a-49936cab68fe",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„Vor allem finanziell sind Alleinerziehende aber immer noch stark benachteiligt; das zeigen neue Zahlen des Statistischen Bundesamtes.“"
                            },
                            {
                                "example_id": "e74d1c6e-9d71-4708-9397-5d3535ce00c2",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„Drei von vier Alleinerziehenden in Deutschland bekommen von ihren ehemaligen Partnern keinen oder zu wenig Unterhalt.“"
                            },
                            {
                                "example_id": "e37a2647-ff78-4c1e-a9a9-f79276b3187d",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„Laut statistischem Bundesamt sind zehn Prozent der Alleinerziehenden in Deutschland Väter.“"
                            },
                            {
                                "example_id": "494501d5-637d-49a5-99fd-61bda9269c48",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„Die Zahl der Alleinerziehenden in Deutschland steigt, die meisten von ihnen sind Frauen.“"
                            },
                            {
                                "example_id": "38d35ba4-d2c4-4ccc-a07b-4d69103527f1",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "[Coronapandemie 2020:] „Wie ein Brennglas zeigt die Krise, welche besondere Belastung Alleinerziehende haben.“"
                            },
                            {
                                "example_id": "f59aea01-9a3d-4301-899e-043454a88867",
                                "sense_id": "c5dd6294-5696-3d80-91a1-c0303f499b20",
                                "text": "„»Alleinerziehende brauchen besondere Unterstützung vor allem bei der Kinderbetreuung, damit sie erwerbstätig sein und auf eigenen Füßen stehen können.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6e4eee4-07d9-4fac-9dbe-f0029b82b703",
