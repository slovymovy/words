                ],
                "senses": [
                    {
                        "sense_id": "09bbbeaf-aa16-367d-88bf-66898993e1d5",
                        "entry_id": "649b24fc-ad0c-360c-b275-5b185c118ffc",
                        "glosses": [
                            "aangetast door metaaloxide vooral bij ijzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "848d2f84-0c5b-4932-b2ca-d3eaf27da7b3",
                                "sense_id": "09bbbeaf-aa16-367d-88bf-66898993e1d5",
                                "text": "De roestige spijkers waren niet meer te gebruiken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90f62696-32ff-400d-a958-a2e8fe2d3bfb",
                        "source_entry_id": "649b24fc-ad0c-360c-b275-5b185c118ffc",
                        "source_sense_id": "09bbbeaf-aa16-367d-88bf-66898993e1d5",
                        "target_lang_word": "rostig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rostig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                        "entry_id": "2deb6e16-ef48-3120-9386-21da815e16ed",
                                        "glosses": [
                                            "von Rost belegt, verrostet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f1549a-51b9-4619-ae7a-af5f9d3af7cb",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "Der Wagen ist schon älter und ist ziemlich rostig."
                                            },
                                            {
                                                "example_id": "b1b0daa4-8ff3-4315-af4d-ca47d4418360",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "Auf den Klippen liegen rostige Wracks."
                                            },
                                            {
                                                "example_id": "d6959c27-8302-4d82-bab9-59801a1b0c56",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "Rostige Metallteile kann man durch Sandstrahlen entrosten."
                                            },
                                            {
                                                "example_id": "deff7b42-3202-4ee7-89c3-006da8f44438",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "Wenn man in einen rostigen Nagel tritt, muss man zum Arzt."
                                            },
                                            {
                                                "example_id": "483c1fd3-9a0f-4918-ba9c-6a475df50f7e",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Was macht Nägel rostig?“"
                                            },
                                            {
                                                "example_id": "4efb3432-2dfd-4652-ac85-e7c48b07bde4",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Rostige Panzer, alte syrische Militärposten und verfallene Häuser erinnern an die bewegte Geschichte der Golanhöhen, über die Israel und Syrien Krieg geführt haben.“"
                                            },
                                            {
                                                "example_id": "e2da8032-835f-42c6-9c8a-e0dd2e4fed67",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Vom Parkplatz am Ende der Straße sieht man einige rostige Metallskulpturen. Geschaffen wurden sie aus dem Schrott syrischer Panzer von dem Kibbuz-Bewohner Johannes de Jong.“"
                                            },
                                            {
                                                "example_id": "1750b352-a327-43b7-a401-5ddff8e6a923",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Unbeschichtetes Eisen wird durch Korrosion rostig und rau, wenn es nass wird und dann Luftsauerstoff dazu kommt und weitere Oxidation bewirkt.“"
                                            },
                                            {
                                                "example_id": "70a28000-97cb-4570-88d8-07617c0e7ec4",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "[Atommüll:] „Seit seiner Errichtung galt Gorleben als favorisiertes Endlager - darüber gab es jedoch andauernd Streit und immer wieder Berichte über rostige Fässer.“"
                                            },
                                            {
                                                "example_id": "70d196c6-d97d-41be-9b41-1873a50010eb",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Die rostige Treppe an der Hauswand in dem unscheinbaren Innenhof ist wackelig und führt fast senkrecht nach oben:“ […]."
                                            },
                                            {
                                                "example_id": "fc7ef9d0-dba2-40e8-9d07-f57013e5f375",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "[Migration aus Afrika:] „Es werden sich weiter Menschen auf den Weg machen, in Schlauchbooten, in rostigen Kähnen.“"
                                            },
                                            {
                                                "example_id": "7cb1c9ed-320c-4ad7-80a5-076115f48e8a",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Hier liegt das rostige Wrack des gestrandeten Frachters Demetrios.“"
                                            },
                                            {
                                                "example_id": "59213eaf-c458-4163-9590-c77e13b4aa7d",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Diese tückische Strömung ist aber nicht nur eine Gefahr für die großen Meeressäuger, sie wurde auch so manchem Schiff zum Verhängnis, wie etliche rostige Wracks belegen.“"
                                            },
                                            {
                                                "example_id": "a166e9a3-96df-4056-9949-ca755f59b696",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Zentimeter um Zentimeter hat sich das rostige Wrack der «Costa Concordia» aus dem Meer gehoben. Dann konnte der Chefingenieur der Bergungsmannschaft einen ersten Teilerfolg bekannt geben: «Das Schiff schwimmt.»“"
                                            },
                                            {
                                                "example_id": "1b76ab45-ecd5-4da3-9750-35904d52992b",
                                                "sense_id": "a5494d1d-95e2-36b5-9493-0de7574555be",
                                                "text": "„Nicht nur die ehemaligen Bahnhöfe, heute meist Wohnhäuser oder verfallende Gebäude, erinnern an die alte Eisenbahnstrecke, in manchen Abschnitten liegen auch noch die rostigen Gleise, zugewuchert von einer üppigen Vegetation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                        "entry_id": "2deb6e16-ef48-3120-9386-21da815e16ed",
                                        "glosses": [
                                            "gealtert, Anzeichen der Alterung aufweisend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d785dd57-c590-4fd8-89df-132773bb688a",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "Er erhob seine rostigen Knochen und streckte sich."
                                            },
                                            {
                                                "example_id": "2ef2a8e4-6c57-444c-a399-778374d6906f",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "Yoga hilft gegen rostige Knochen."
                                            },
                                            {
                                                "example_id": "5b993bcc-21b1-4e40-a58f-47254205da34",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "[…] „ein Schnupperkurs, der die Lust zum Tanzen wieder wach rüttelt und rostige Knochen wieder geschmeidig werden lässt.“"
                                            },
                                            {
                                                "example_id": "0bd65a05-26f8-4cbe-9f44-6729804ddd7a",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "„Und plötzlich ertönte seine rostige Stimme. Seltsamerweise sprach er in Reimen.“"
                                            },
                                            {
                                                "example_id": "fc1a53bb-5fa8-4b5b-834d-74b489005d5f",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "„»Hintz, was ist los?«, fragte die rostige Stimme des Sergeanten.“"
                                            },
                                            {
                                                "example_id": "12b054ec-6ee9-4819-83e4-244ad8f944ae",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "„»Ja.« Jetzt klang ihre Stimme rostig und trocken.“"
                                            },
                                            {
                                                "example_id": "51f75539-7838-436e-a600-84f2bf8969ae",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "„Agnes Möller trank einen Schluck Wasser, um ihre rostige Stimme zu glätten.“"
                                            },
                                            {
                                                "example_id": "a8e78985-3654-4981-856d-797eae2bcbea",
                                                "sense_id": "d49760ad-df27-31b3-9cd2-2980255e9052",
                                                "text": "„Der Widerspruchsgeist ist ein prägendes Merkmal Europas. Er richtet sich gegen Macht, Willkür und rostige Denkmuster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c1a576d0-2d1d-3f8a-b490-b7b65affe5b7",
                                        "entry_id": "2deb6e16-ef48-3120-9386-21da815e16ed",
                                        "glosses": [
                                            "in der Farbe von Rost"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0d9fc6f-7d8b-4200-ad41-bc2521368a03",
                                                "sense_id": "c1a576d0-2d1d-3f8a-b490-b7b65affe5b7",
                                                "text": "„Der rostig behaarte Blütenstiel ist 2 bis 8 Millimeter lang.“"
                                            },
                                            {
                                                "example_id": "ffeadc17-8b9d-4de0-8b99-2dac8a6fd1e3",
                                                "sense_id": "c1a576d0-2d1d-3f8a-b490-b7b65affe5b7",
                                                "text": "[Blätter des Sternapfels:] „Die Unterseite ist anfänglich, sehr kurz und dicht rostig bis kupferfarben, seidig behaart, verkahlt später und wird dann fahlgrün, die Oberseite ist glänzend und kahl.“"
                                            },
                                            {
                                                "example_id": "1fb630fc-6ffb-486b-98d1-2c3e0df8e854",
                                                "sense_id": "c1a576d0-2d1d-3f8a-b490-b7b65affe5b7",
                                                "text": "„Sattgrüne Moospolster im rostigen Rot des Buchenlaubs sorgen für Farbtupfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cdc1c95-26a1-45f2-96b6-c0f049eafaad",
