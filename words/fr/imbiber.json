                    "sense_definition": "Pénétrer un corps poreux d'un liquide de manière à l'en remplir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>imbiber</w> légèrement ce morceau de tissu avec de l'eau tiède."
                        },
                        {
                            "text": "Le cuisinier <w>imbibe</w> les génoises d'un sirop parfumé avant de monter le gâteau."
                        }
                    ],
                    "synonyms": [
