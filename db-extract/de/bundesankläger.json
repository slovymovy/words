                "senses": [
                    {
                        "sense_id": "914dd701-01c9-362c-a31e-c1b450bf336b",
                        "entry_id": "64dbf514-39a7-3e4a-9088-657a711ba728",
                        "glosses": [
                            "Person/Institution, die in gewissen Fällen (auf Bundesebene) die Strafverfolgung übernimmt"
                        ],
                        "tags": [
                            "Rechtswesen",
                            "USA und andere Staaten"
                        ],
                        "examples": [
                            {
                                "example_id": "8af2c33f-ddd3-40af-b46a-87b42cfda65a",
                                "sense_id": "914dd701-01c9-362c-a31e-c1b450bf336b",
                                "text": "„Mueller schien nicht gut zu hören, konnte sich an Zitate nicht erinnern und musste sich von einem Abgeordneten korrigieren lassen, weil er nicht mehr wusste, welcher Präsident ihn zum obersten Bundesankläger von Massachusetts ernannt hatte.“"
                            },
                            {
                                "example_id": "e7dbc362-5cbd-4a30-86b5-6395639f14ff",
                                "sense_id": "914dd701-01c9-362c-a31e-c1b450bf336b",
                                "text": "„Der Öffentliche Bundesankläger ist zuständig für die Einlegung von Rechtsmitteln in den Fällen, in denen das Bundesgericht Jugoslawiens zuständig ist […].“"
                            },
                            {
                                "example_id": "9efb7f40-6dee-4640-b036-db32c408958f",
                                "sense_id": "914dd701-01c9-362c-a31e-c1b450bf336b",
                                "text": "„Wenn die SEC erst mal angefangen hat, die Bundesankläger, dann wird dein Kumpel Artie deinen Arsch so schnell verkaufen, dass du's nicht mal mitkriegst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
