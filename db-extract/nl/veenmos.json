                "senses": [
                    {
                        "sense_id": "21a2b5cd-d5b7-3f66-bc59-4c6a675b3a4f",
                        "entry_id": "716b6877-d9fc-39c5-8fd3-64dc25e56ef1",
                        "glosses": [
                            "benaming voor planten uit het geslacht Sphagnum, met meer dan honderd verschillende soorten mossen"
                        ],
                        "tags": [
                            "mossen"
                        ],
                        "examples": [
                            {
                                "example_id": "1d22038a-d143-42d4-a75f-227e93da5a4c",
                                "sense_id": "21a2b5cd-d5b7-3f66-bc59-4c6a675b3a4f",
                                "text": "Het doel van het Mohrmannstipendium is om jonge getalenteerde vrouwen in de wetenschap aan te moedigen om na hun promotie in de wetenschap werkzaam te blijven. Martine onderzoekt de interactie tussen methaan-oxiderende en stikstof-fixerende micro-organismen met het veenmos Sphagnum in onder andere het Dwingelderveld."
                            },
                            {
                                "example_id": "88833bd2-e972-440a-8153-a857a298d18e",
                                "sense_id": "21a2b5cd-d5b7-3f66-bc59-4c6a675b3a4f",
                                "text": "Even buiten het dorp wandel ik het Bargerveen in, een restant van het Bourtangermoeras. Vanaf 1992 wordt dit unieke gebied beheerd door Staatsbosbeheer. Er leven inmiddels 220 vogelsoorten, meer dan 30 soorten libellen en 25 soorten dagvlinders. Om het veenmos weer te laten groeien haalde men de sloten, greppels en drainage weg waardoor het regenwater nu op het veld blijft staan."
                            }
                        ]
                    }
                ],
