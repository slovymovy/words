                                                "sense_id": "4cc1a561-8c6d-3b3e-b9df-798ed62cd35a",
                                                "text": "Die Askese bekam ihnen nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                        "entry_id": "a6fc3779-9c96-306b-92bc-e0baeec35b6c",
                                        "glosses": [
                                            "streng enthaltsames Leben verbunden mit dem Ziel des Seelenheils"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d01be3d-6399-4c58-89c0-5e0fe549c699",
                                                "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                                "text": "Der Mönch verbrachte sein gesamtes Leben in Askese."
                                            },
                                            {
                                                "example_id": "14962960-1a9b-42d3-9e8e-3d5582e41f7e",
                                                "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                                "text": "„Der biedere Küan fand bei dem heiligen Einsiedler tatsächlich Aufnahme und gelangte in zwanzig Jahren harter Askese zur Vollendung.“"
                                            },
                                            {
                                                "example_id": "774354a1-f435-4ad4-8406-c07627fccc06",
                                                "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                                "text": "„Mit der Vergeblichkeit der Askese hat sich Busch immer wieder beschäftigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b0d87d7-3c29-463c-bc92-05a37f067fe0",
                        "source_entry_id": "60d18b60-105c-3e91-980d-f3c54be1434a",
