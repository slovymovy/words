        "fr-extract.jsonl": [
            {
                "entry_id": "3c8b22c7-8b2a-3e7c-be38-eda69ff2d6d4",
                "word": "atropine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c129f029-b4b3-4a6c-8e5a-33b74baadd11",
                        "entry_id": "3c8b22c7-8b2a-3e7c-be38-eda69ff2d6d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "atropines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                        "entry_id": "3c8b22c7-8b2a-3e7c-be38-eda69ff2d6d4",
                        "glosses": [
                            "Alcaloïde à noyau tropane, très toxique, tiré, entre autre, de la belladone. C'est un antagoniste cholinergique muscarinique qui provoque la dilatation des pupilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e870c7c0-79d6-4eac-93e7-d457837d9326",
                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                "text": "Un cobaye de 300 grammes ou une souris de 20 grammes supportent plus d’un centigramme d’atropine injecté sous la peau."
                            },
                            {
                                "example_id": "38de1a8d-2d0f-41a3-b473-ee3ebb33584d",
                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                "text": "La physostigmine, agoniste muscarinique (qui stimule l’action de l’acétylcholine), déclenche des bâillements, alors que l’atropine, antagoniste de l’acétylcholine, les inhibe."
                            },
                            {
                                "example_id": "5d64d7a8-8bf8-46e5-b27f-5731c4d7424c",
                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                "text": "On retrouve de l’atropine en unidose dans les collyres pour les yeux ou dans des injections pour stimuler le cœur."
                            },
                            {
                                "example_id": "421dbc11-68f9-4b45-b1fb-42006ea29b35",
                                "sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                                "text": "Difficile donc de tricher… Sauf à s’injecter de l’atropine, comme le faisaient les femmes italiennes au XVIIᵉ siècle pour s’embellir, ou à se dessiner de larges pupilles comme Bambi ou d’autres personnages des studios Disney, dont les dessinateurs ont compris depuis bien longtemps à quel point les pupilles dilatées étaient appréciées !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "101a0ff7-673c-4989-b235-f24adbab046d",
                        "source_entry_id": "3c8b22c7-8b2a-3e7c-be38-eda69ff2d6d4",
                        "source_sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
                        "target_lang_word": "Atropin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atropin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                        "entry_id": "f63bc2b6-f56f-3ae7-81cd-cda3442bfd24",
                                        "glosses": [
                                            "hochgiftiges Alkaloid oder krampflösendes Arzneimittel, das in Nachtschattengewächsen, besonders in der Tollkirsche Atropa belladonna, vorkommt"
                                        ],
                                        "tags": [
                                            "Pharmazeutische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42df721c-2ecb-477b-9071-dfb34a649a9f",
                                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                                "text": "„Die Kinder haben Probleme mit den Augen, ich träufle ihnen alle vier Stunden Atropin in die Augen.“"
                                            },
                                            {
                                                "example_id": "af9190d3-b880-4e36-b25c-b80c38bc46ae",
                                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                                "text": "„Ein altbekannter Antagonist an diesen Rezeptoren ist Atropin, das Gift der Tollkirsche.“"
                                            },
                                            {
                                                "example_id": "1f20eea2-9c71-4f04-95cc-6b6a6891a0cd",
                                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                                "text": "„In der Drogenszene in Bern und Biel ist Kokain im Umlauf, das mit giftigem Atropin verunreinigt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb96e400-70d0-4a8e-914d-d59103e39d90",
                        "source_entry_id": "3c8b22c7-8b2a-3e7c-be38-eda69ff2d6d4",
                        "source_sense_id": "18a140c3-6629-38f1-90e6-0f747e32bfea",
