                "senses": [
                    {
                        "sense_id": "0fb6f83e-74ff-35f9-ad5d-7e5fcb570d07",
                        "entry_id": "04779de3-8d70-3029-b9c6-e5d8bc0b2614",
                        "glosses": [
                            "Numerus in einigen Sprachen, der eine kleine Anzahl ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "483308ae-d5ec-4d9e-b1a0-dde82a54edaf",
                                "sense_id": "0fb6f83e-74ff-35f9-ad5d-7e5fcb570d07",
                                "text": "„Meine Ausführungen zur semantischen … Verwandtschaft der Kategorien »Trial« und »Paukal« implizieren allerdings nicht die Behauptung, dass jeder »Trial« zwangsläufig ein »Paukal« sein muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62cb12d8-101e-4217-af89-fa1530250dae",
                        "source_entry_id": "04779de3-8d70-3029-b9c6-e5d8bc0b2614",
                        "source_sense_id": "0fb6f83e-74ff-35f9-ad5d-7e5fcb570d07",
                        "source_sense_description": "Linguistik: Numerus in einigen Sprachen, der eine kleine Anzahl ausdrückt",
                        "target_lang_word": "paucal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paucal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c476793-d083-3627-b921-24c4a9c44091",
                                        "entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                                        "glosses": [
                                            "Characterized by having a small number, greater than two, of (usually equivalent) components."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                                        "entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                                        "glosses": [
                                            "Pertaining to a language form referring to a few or a couple of something (typically three to around ten), e.g. a small group of people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "480a3b90-c9a4-4b33-8687-3af141dbf60e",
                                                "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                                                "text": "first-person paucal"
                                            },
                                            {
                                                "example_id": "68c2275b-6815-433f-bccc-632e64c40667",
                                                "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                                                "text": "paucal number"
                                            },
                                            {
                                                "example_id": "84559a0b-b2da-46ec-96fc-ab72a0236fac",
                                                "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                                                "text": "paucal and plural pronouns"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f066cc-99e2-3ca7-9a05-76f3725bef8c",
                                        "entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                                        "glosses": [
                                            "Expressing a relatively small quantity or degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b21cea2-d54b-440c-837a-3ee12c40fbb8",
                                                "sense_id": "b0f066cc-99e2-3ca7-9a05-76f3725bef8c",
                                                "text": "But too much can occur in the negative with a paucal meaning when there is no explicit or implicit infinitival complement: I didn't enjoy it too much is simply an informal alterant of I didn't enjoy it very much."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paucal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7161846-041e-317b-9a20-0d70912a2709",
                                        "entry_id": "5ea9c16e-c3ac-35c2-9b85-b45c1a018b64",
                                        "glosses": [
                                            "A language form referring to a few of something (three to around ten), as a small group of people; contrast singular, dual, trial, and plural."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ec37320-e146-4ad4-b34b-44a256103538",
                        "source_entry_id": "04779de3-8d70-3029-b9c6-e5d8bc0b2614",
                        "source_sense_id": "0fb6f83e-74ff-35f9-ad5d-7e5fcb570d07",
                        "source_sense_description": "Linguistik: Numerus in einigen Sprachen, der eine kleine Anzahl ausdrückt",
                        "target_lang_word": "paucal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paucal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95758897-d145-336e-bc5b-a2e28fdbbe47",
                                        "entry_id": "cc59cbb0-7567-3736-a172-f104d8e28bde",
                                        "glosses": [
                                            "Forme grammaticale indiquant un petit nombre d’unités (trois ou plus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aca3e7b6-d1ff-4456-b317-acfaf73cc50e",
                                                "sense_id": "95758897-d145-336e-bc5b-a2e28fdbbe47",
                                                "text": "… il existe en Mélanésie et en Nouvelle-Guinée des langues qui distinguent un duel, un « paucal » et un pluriel proprement dit : ainsi, en motuna, on distingue nommai, « une personne », nommaikaro, « deux personnes », nommainaa, « quelques personnes » et nommaingung, « des gens » (en grand nombre). Le mussau, langue austronésienne, connaît les mêmes distinctions, plus un triel."
                                            },
                                            {
                                                "example_id": "87c7c231-8f1a-4be2-9b6e-56ce883b90c5",
                                                "sense_id": "95758897-d145-336e-bc5b-a2e28fdbbe47",
                                                "text": "Les noms denses et les noms génériques et denses admettent un paucal pluriel, avec -xi, qui a un effet certain de discrétisation :\ndense (213) tahetabo-xi « peu de/quelques effleurements de sable »\ngénérique à singulatif et dense (214) hana-xi « peu de/quelques gouttes de sang »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
