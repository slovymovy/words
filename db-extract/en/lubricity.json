                "senses": [
                    {
                        "sense_id": "27a05915-e04b-3567-8009-c73635b50f97",
                        "entry_id": "3d90a8b8-c836-364c-9d21-9daf17917676",
                        "glosses": [
                            "Degree of ability to lubricate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a63e6671-8ae2-4d35-99cb-9b10a8385ba1",
                                "sense_id": "27a05915-e04b-3567-8009-c73635b50f97",
                                "text": "Near-synonyms: slipperiness, slickness, oiliness"
                            },
                            {
                                "example_id": "9ef47351-9167-4112-a3ef-c2655365c6b7",
                                "sense_id": "27a05915-e04b-3567-8009-c73635b50f97",
                                "text": "Though her lubricity made it redundant, Anthea passed him the oil to caress her thighs."
                            }
                        ]
                    },
                    {
                        "sense_id": "833cfd06-5041-3dae-adb0-2b1b337ab1d1",
                        "entry_id": "3d90a8b8-c836-364c-9d21-9daf17917676",
                        "glosses": [
                            "Evasiveness; shiftiness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c5737abe-d2e0-4a9a-a5a9-9e6dd55138d6",
                                "sense_id": "833cfd06-5041-3dae-adb0-2b1b337ab1d1",
                                "text": "Near-synonyms: slipperiness, slickness, oiliness"
                            }
                        ]
                    },
                    {
                        "sense_id": "5188ea07-1560-316f-810c-26e9115cb008",
                        "entry_id": "3d90a8b8-c836-364c-9d21-9daf17917676",
                        "glosses": [
                            "Lasciviousness; propensity to lewdness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f60d13d-ad22-45a1-9fbd-290a29a47e94",
                                "sense_id": "5188ea07-1560-316f-810c-26e9115cb008",
                                "text": "all the outrageous lubricities of Phallic worship (III, xvi)"
                            },
                            {
                                "example_id": "12e36836-76bb-4b2f-afc5-4468cf7a37f6",
                                "sense_id": "5188ea07-1560-316f-810c-26e9115cb008",
                                "text": "1906, Hilaire Belloc, , introduction to Essays in Literature and History by James Anthony Froude\nIn one epoch lubricity, in another fanaticism, in a third dulness and a dead-alive copying of the past, are the faults which criticism finds to attack."
                            },
                            {
                                "example_id": "b29627c6-81de-497e-a9b3-615b71d722d9",
                                "sense_id": "5188ea07-1560-316f-810c-26e9115cb008",
                                "text": "Apart from the bull and the serpent, which were so universally worshipped as to call for consideration in other sections of this work, the goat ranked as one of the most popular, this animal's excessive lubricity marking it as an especially suitable representative of any generative or reproductive deity."
                            },
                            {
                                "example_id": "7c4c69c6-3ba8-4c09-8ae0-7ce3e99ce14e",
                                "sense_id": "5188ea07-1560-316f-810c-26e9115cb008",
                                "text": "Among the large number of characters are [...] young boys and old knowledgeable beldames familiar with every lubricity, every love charm and potion."
                            }
                        ]
                    }
                ],
