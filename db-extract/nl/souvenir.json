                        "target_lang_word": "Souvenir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Souvenir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a369430-3531-39c0-894b-6710092440d5",
                                        "entry_id": "2875a68b-b67e-379c-8aa7-618e8d4209db",
                                        "glosses": [
                                            "ein Erinnerungsstück an ein Ereignis, eine Person oder einen Ort, meist aber an eine Reise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23311ff-0a9b-4734-915f-e1665699cb5c",
                                                "sense_id": "6a369430-3531-39c0-894b-6710092440d5",
                                                "text": "Ich bringe aus jedem Urlaub ein Souvenir mit."
                                            },
                                            {
                                                "example_id": "4f8f9f43-986c-43d6-8152-443c58833af8",
                                                "sense_id": "6a369430-3531-39c0-894b-6710092440d5",
                                                "text": "„Ein Gestell, mit Schmuck behängt, lädt zum Kauf von Souvenirs ein.“"
                                            },
                                            {
                                                "example_id": "893821ee-be13-4aa8-991e-a2e7ad0d1f4d",
                                                "sense_id": "6a369430-3531-39c0-894b-6710092440d5",
                                                "text": "„Man konnte Souvenirs erstehen oder das Restaurant aufsuchen, um die internationale Küche zu genießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb86610a-1ceb-420c-a961-b1ad43d44d9e",
                        "source_entry_id": "9717efef-9dc8-3c5b-bcc6-5329b11c8bc2",
                        "source_sense_id": "37c1233c-0468-32f4-bfae-03b78e61470e",
                        "source_sense_description": "klein voorwerp dat helpt om aan een prettige ervaring met een plaats of persoon terug te denken",
                        "target_lang_word": "Andenken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andenken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcfbc641-1357-3dbd-9a41-dc2577c7d1c3",
                                        "entry_id": "3a5cb958-9c96-313f-9b75-cf92f7231f5b",
                                        "glosses": [
                                            "ein kleiner Gegenstand, der Erinnerungen an ein bestimmtes Ereignis oder eine bestimmte Person hervorrufen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff907e83-48f5-4214-86b8-1e259a116dcb",
                                                "sense_id": "bcfbc641-1357-3dbd-9a41-dc2577c7d1c3",
                                                "text": "Wenn du nach Japan fährst, bringe viele Andenken mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                        "entry_id": "3a5cb958-9c96-313f-9b75-cf92f7231f5b",
                                        "glosses": [
                                            "bewusstes Erinnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62535b8c-c084-4114-87c1-b038136387de",
                                                "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                                "text": "Im Andenken an die Verstorbenen treffen wir uns einmal im Jahr."
                                            },
                                            {
                                                "example_id": "2d620c2e-2bf2-4c96-8d5f-a8916d1ed196",
                                                "sense_id": "fd4d0679-d6e0-3d97-ab3b-c70295282173",
                                                "text": "„In der Abteilung »Neuzeit« ist von der Ansbacher Polizei ein Zimmer dem Andenken des armen Findlings Kaspar Hauser geweiht; man sieht seine Uhr, seine Kleider und Wäsche mit den Stichmarken des Mordinstrumentes und die ganze Literatur über diesen geheimnisvollen Unbekannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd8e007a-b4f1-45f7-95da-73a62161006c",
                        "source_entry_id": "9717efef-9dc8-3c5b-bcc6-5329b11c8bc2",
                        "source_sense_id": "37c1233c-0468-32f4-bfae-03b78e61470e",
                        "source_sense_description": "klein voorwerp dat helpt om aan een prettige ervaring met een plaats of persoon terug te denken",
                        "target_lang_word": "souvenir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souvenir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d5fa41d-455b-31fa-9728-ab25a23eaef7",
                                        "entry_id": "c50a5dbd-a6da-3d3a-9f6e-0f82f555af9f",
                                        "glosses": [
                                            "An item of sentimental value, that is given or kept to remember an event or location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4030749e-7830-4a1e-84a6-b07cf4e0677a",
                                                "sense_id": "0d5fa41d-455b-31fa-9728-ab25a23eaef7",
                                                "text": "Back then, nobody knew in the schoolyard\nNow then, you have grown up to be this hard\nGo then, walk through this world with your heart scarred\nYou're the souvenir of sadness"
                                            },
                                            {
                                                "example_id": "d38152a5-271e-4db3-8574-f930913e386a",
                                                "sense_id": "0d5fa41d-455b-31fa-9728-ab25a23eaef7",
                                                "text": "The tourists stuck to the safe confines of the gift shop, where they bought souvenir combs, shot glasses, oversize pencils, and blocks of cedar painted with rhyming poems and shellacked to a high gloss."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "souvenir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3850255a-9903-3c6b-95ae-babc7651bed5",
                                        "entry_id": "062c9f42-4333-3c3a-8917-3ffd956c2cd0",
                                        "glosses": [
                                            "To take (something) as a souvenir, especially illicitly, for example during wartime."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a52744a0-fb0e-478e-b178-8d7975b6cf18",
                                                "sense_id": "3850255a-9903-3c6b-95ae-babc7651bed5",
                                                "text": "\"Doubletime up to the ville and souvenir me one cute orphan, man, but be sure you get a dirty one, a really skuzzy one.\""
                                            },
                                            {
                                                "example_id": "879ec57d-821f-4780-acb9-5b3d8caa0029",
                                                "sense_id": "3850255a-9903-3c6b-95ae-babc7651bed5",
                                                "text": "The word is they're waiting for some blokes who had gone off souveniring before the order was announced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "733b1378-a6f3-484f-a0dc-aa0d5efb9cc1",
                        "source_entry_id": "9717efef-9dc8-3c5b-bcc6-5329b11c8bc2",
                        "source_sense_id": "37c1233c-0468-32f4-bfae-03b78e61470e",
                        "source_sense_description": "klein voorwerp dat helpt om aan een prettige ervaring met een plaats of persoon terug te denken",
                        "target_lang_word": "souvenir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souvenir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56041b25-c2da-3331-a642-405082b8340b",
                                        "entry_id": "6fef7a84-0628-357e-8746-fe5c937e490d",
                                        "glosses": [
                                            "Avoir mémoire de quelque chose ; rappeler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac5d58b-c3c4-4729-8a7e-3cc2584aba70",
                                                "sense_id": "56041b25-c2da-3331-a642-405082b8340b",
                                                "text": "Ils me font toujours souvenir du ciel gris de chaleur, de la poussière qui portait l’empreinte de pieds nus et des touffes immobiles des hauts papayers lisses qui émergeaient d'une étonnante végétation."
                                            },
                                            {
                                                "example_id": "bcc92686-6396-4534-8899-5ec8b6dadb44",
                                                "sense_id": "56041b25-c2da-3331-a642-405082b8340b",
                                                "text": "— Oh toi, ronchonne-t-elle, tu joues l’esprit fort, n’empêche que tu dormais mal, souviens-toi. Et que t'as été bien content de rhabiter Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                        "entry_id": "6fef7a84-0628-357e-8746-fe5c937e490d",
                                        "glosses": [
                                            "Se remémorer, se revenir, se mémoriser."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f98cf487-a65a-4c47-85f0-10d9c80d925d",
                                                "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                                "text": "Ma foi, s’il m’en souvient, il ne m’en souvient guère !"
                                            },
                                            {
                                                "example_id": "7f37cb7a-dd7b-4db0-a218-22b9298f00c5",
                                                "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                                "text": "Il lui souvint à propos que saint Jérôme avait eu pour compagnons de route, dans le désert, des satyres et des centaures qui avaient confessé la vérité."
                                            },
                                            {
                                                "example_id": "9d60e7cd-3fb7-4e92-86b6-b661f7b8f98b",
                                                "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                                "text": "Il me souvint, précisément, à ce bal de la Java, d'une de ces créatures qu'un jeune voyou ne quittait pas des yeux."
                                            },
                                            {
                                                "example_id": "5e53ea37-d2a9-4c70-9199-d86780c6e367",
                                                "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                                "text": "Il ne me souvient pas au lycée, d’avoir trouvé le moindre plaisir à étudier Virgile ou Racine."
                                            },
                                            {
                                                "example_id": "8009f09f-3d71-44a1-8084-7e84d459f3d8",
                                                "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                                "text": "Il lui en souviendra toute sa vie."
                                            },
                                            {
                                                "example_id": "20607bf2-742d-4a2c-a170-750fdb6de314",
                                                "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                                "text": "C’était, il m’en souvient, une belle journée de printemps."
                                            },
                                            {
                                                "example_id": "b15b623c-85b7-4cea-a87a-a72566a68466",
                                                "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                                                "text": "et C’est du plus loin qu’il me souvienne, se dit d’une chose, d’un événement qui date de loin.",
                                                "translation": "Note : ces formes impersonnelles (employées plutôt dans un registre de langue soutenu) sont toujours transitives indirectes, avec un premier complément d’objet indirect obligatoire (souvenir à quelqu’un), le plus souvent pronominal (par exemple, il me souvient) et avec habituellement un second complément d’objet indirect (souvenir à quelqu’un de quelque chose), lui aussi le plus souvent pronominal (par exemple, il m’en souvient) ou propositionnel (par exemple, il me souvient que...). Dans un registre de langue moins soutenu, on utilise plutôt la forme pronominale réfléchie se souvenir qui se conjugue alors de façon personnelle à toutes les personnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b3559e4-1140-36f3-9c03-41e81dc16cfc",
                                        "entry_id": "6fef7a84-0628-357e-8746-fe5c937e490d",
                                        "glosses": [
                                            "(Utilisé uniquement dans se souvenir) Garder la mémoire, soit d’un bienfait pour le reconnaître, soit d’une injure pour s’en venger."
                                        ],
                                        "tags": [
                                            "Transitif avec le complément d’objet introduit par de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16584b87-e354-4068-8117-9a4b2b9a346a",
                                                "sense_id": "7b3559e4-1140-36f3-9c03-41e81dc16cfc",
                                                "text": "Un grand jeune blondin, que je me souviens de n'avoir point vu durant l'éclipse de la belle, rentra en catimini."
                                            },
                                            {
                                                "example_id": "5161f86c-6661-49b4-9af9-f85959b23c75",
                                                "sense_id": "7b3559e4-1140-36f3-9c03-41e81dc16cfc",
                                                "text": "Jacques s’était bien souvenu de ce qu'il appelait maintenant «son idylle bédouine» et en avait même parlé à sa femme..."
                                            },
                                            {
                                                "example_id": "b7dfa57a-5ce0-48fc-9f06-2c4d724e09e8",
                                                "sense_id": "7b3559e4-1140-36f3-9c03-41e81dc16cfc",
                                                "text": "Tu ne te souviens sans doute pas de moi, m’écrivait-il, mais il est impossible que tu aies complètement oublié nos petites aventures guerrières de l’été 1914, l’entrée en Belgique par Trelon, la rentrée en France, dare-dare, par Solre-le-Château, et cette sinistre nuit de Zorées, et cette traversée du bois du Nouvion […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd179b79-3efe-3145-af5e-6e4db7efb97c",
                                        "entry_id": "6fef7a84-0628-357e-8746-fe5c937e490d",
                                        "glosses": [
                                            "(Utilisé uniquement dans se souvenir) Avoir du ressentiment."
                                        ],
                                        "tags": [
                                            "Transitif avec le complément d’objet introduit par de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c8c0d7a-f6b9-4646-b598-36dfef8bf20c",
                                                "sense_id": "cd179b79-3efe-3145-af5e-6e4db7efb97c",
                                                "text": "Je m’en souviendrai !"
                                            },
                                            {
                                                "example_id": "4df011bc-18f3-4815-803b-a040de4ef09d",
                                                "sense_id": "cd179b79-3efe-3145-af5e-6e4db7efb97c",
                                                "text": "Souvenez-vous-en."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e50d05ed-f0a7-345b-86b5-9c3141025c65",
                                        "entry_id": "6fef7a84-0628-357e-8746-fe5c937e490d",
                                        "glosses": [
                                            "(Utilisé uniquement dans se souvenir) Avoir soin, s’occuper de quelque chose."
                                        ],
                                        "tags": [
                                            "Transitif avec le complément d’objet introduit par de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad46f32b-2d32-4408-af8b-407c8283e7f9",
                                                "sense_id": "e50d05ed-f0a7-345b-86b5-9c3141025c65",
                                                "text": "Je me souviendrai de votre recommandation."
                                            },
                                            {
                                                "example_id": "a6435b54-0844-492a-927c-a8a5b21832cd",
                                                "sense_id": "e50d05ed-f0a7-345b-86b5-9c3141025c65",
                                                "text": "Souvenez-vous de mon affaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "souvenir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                        "entry_id": "c676d398-dce2-3357-bf50-22dd3d3786fd",
                                        "glosses": [
                                            "Impression que la mémoire conserve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31369ca9-d28b-4bfe-9094-73fd93970dcc",
                                                "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                                "text": "Ce qu'il y a de bien aux souvenirs, c'est que personne ne peut vous les enlever."
                                            },
                                            {
                                                "example_id": "0b17dc3d-3f1a-4a9d-89b8-3c8023487856",
                                                "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                                "text": "— Serais-je assez heureux, madame, pour être encore logé dans un coin de votre souvenir ?"
                                            },
                                            {
                                                "example_id": "b5661045-05a5-4de1-99dd-e4dcba22a4c5",
                                                "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                                "text": "Les premiers souvenirs de Louis Pasteur dataient de cette époque. Il se revoyait enfant, heureux de courir sur la route qui conduit au village d’Aiglepierre."
                                            },
                                            {
                                                "example_id": "6da75427-fd81-419e-9727-8f69282e06c6",
                                                "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                                "text": "Rien entre nous, que des souvenirs assez pitoyables, le tas lugubre des dèches quotidiennes, des privations et des désespérances."
                                            },
                                            {
                                                "example_id": "e555ca00-af13-4beb-9f06-3130752515e6",
                                                "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                                "text": "Des souvenirs lui revenaient par bribes. Il se remémorait le bonheur qu'il avait découvert à marcher dans les champs ou à travers les bois."
                                            },
                                            {
                                                "example_id": "37bde704-a5e8-458f-83a0-c04421d723db",
                                                "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                                "text": "Oui, mon père à peine en terre, j'étais coupable, oubliant mon deuil, trahissant mon chagrin et son souvenir."
                                            },
                                            {
                                                "example_id": "c9de7a1c-70d3-4058-a98f-f3ff0434a6bd",
                                                "sense_id": "428a9560-06f4-3bb6-ad8e-d177d65a3355",
                                                "text": "Deux ans plus tard, Deslauriers et Frédéric reconnaissent, dans une conversation, qu’ils ont, comme leurs amis, tout raté, sauf leurs souvenirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e73cb25-9110-32b9-8c26-bf0e7c356507",
                                        "entry_id": "c676d398-dce2-3357-bf50-22dd3d3786fd",
                                        "glosses": [
                                            "Faculté même de la mémoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2850d59-165c-43d5-b491-20f544358869",
                                                "sense_id": "3e73cb25-9110-32b9-8c26-bf0e7c356507",
                                                "text": "Je ne saurais effacer cette action de mon souvenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e6b20a-a774-3741-9aaf-91f1d01355e6",
                                        "entry_id": "c676d398-dce2-3357-bf50-22dd3d3786fd",
                                        "glosses": [
                                            "Objet acquis dans le but de se rappeler un lieu, quelque chose ou quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c5aaa2-cc44-42bb-87e4-5d02a00341ee",
                                                "sense_id": "38e6b20a-a774-3741-9aaf-91f1d01355e6",
                                                "text": "J'avais acheté des malles. Elles étaient remplies de souvenirs : coffrets, tapis d'aloès, cannes en bois d’amourette, écaille travaillée par Belon, de Marseille."
                                            },
                                            {
                                                "example_id": "2060eb80-2577-4ca3-9d44-7bfb6bf4a5b9",
                                                "sense_id": "38e6b20a-a774-3741-9aaf-91f1d01355e6",
                                                "text": "Un souvenir est prévu sous la forme, belgissime, d'un speculoos frappé du logo de Petrofina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff21739f-ba0f-3f1c-9638-8d854df51c31",
                                        "entry_id": "c676d398-dce2-3357-bf50-22dd3d3786fd",
                                        "glosses": [
                                            "Cadeau de remerciement ou d'adieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2164019-c2a2-4efa-862b-09a1a30da32f",
                                                "sense_id": "ff21739f-ba0f-3f1c-9638-8d854df51c31",
                                                "text": "Il m'a laissé ce souvenir avant de partir."
                                            },
                                            {
                                                "example_id": "d260bdec-428a-4e85-977e-4a77f3c3342d",
                                                "sense_id": "ff21739f-ba0f-3f1c-9638-8d854df51c31",
                                                "text": "Les femmes du bourg s’empressaient, le long des convois, les bras chargés de victuailles. « Souvenir, souvenir », réclamaient-elles ; et les soldats leur donnaient des boutons de capote, des douilles de cartouches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea7b1af-6dc2-3ce6-9454-399ebf9c39b9",
                                        "entry_id": "c676d398-dce2-3357-bf50-22dd3d3786fd",
                                        "glosses": [
                                            "Ce qui reste du passé et qui le remémore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010c67fc-37a2-4d0f-b000-b2b838b29ed6",
                                                "sense_id": "cea7b1af-6dc2-3ce6-9454-399ebf9c39b9",
                                                "text": "Friesach mérite mieux qu'un coup d’œil en passant.[…]. La petite ville carinthienne possède un beau site, des souvenirs et des ruines."
                                            },
                                            {
                                                "example_id": "5f5c5d00-6d30-401a-9632-b1264ba673cf",
                                                "sense_id": "cea7b1af-6dc2-3ce6-9454-399ebf9c39b9",
                                                "text": "Les murailles sont criblées de trous, souvenir des biscaïens suédois."
                                            },
                                            {
                                                "example_id": "b237bb09-209b-444c-a3e3-9112e04055ed",
                                                "sense_id": "cea7b1af-6dc2-3ce6-9454-399ebf9c39b9",
                                                "text": "À Rochechouard, « Médrano », a rajeuni le cirque Fernando, et dans le souvenir du clown Boum-Boum, a trouvé un heureux déroulement de spectacle."
                                            },
                                            {
                                                "example_id": "f40469ed-0a7a-48dc-a348-6faa69bd40cc",
                                                "sense_id": "cea7b1af-6dc2-3ce6-9454-399ebf9c39b9",
                                                "text": "Accroche-cœur –\nAux larmes de cendre,\nelle regarda\nla rouflaquette de l’écrin,\nsouvenir\nd’une époque crépusculaire,\npeu avant le début\n…\nde sa chimiothérapie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3c6dce-cd72-3bf2-a18d-aeaafff7a91e",
                                        "entry_id": "c676d398-dce2-3357-bf50-22dd3d3786fd",
                                        "glosses": [
                                            "Autobiographie, mémoires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70c4095-5750-412b-8104-29669476d0ea",
                                                "sense_id": "7a3c6dce-cd72-3bf2-a18d-aeaafff7a91e",
                                                "text": "Il publie ses souvenirs le mois prochain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bac5627-78d4-38e0-a33b-3b518b4c8cd6",
                                        "entry_id": "c676d398-dce2-3357-bf50-22dd3d3786fd",
                                        "glosses": [
                                            "Commémoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "275295b4-0321-42ed-aca2-41edf3df282e",
                                                "sense_id": "2bac5627-78d4-38e0-a33b-3b518b4c8cd6",
                                                "text": "Le souvenir des morts pour la patrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
