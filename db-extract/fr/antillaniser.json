                "senses": [
                    {
                        "sense_id": "42a6d592-d386-357f-9546-d2c91e4c0f41",
                        "entry_id": "d835ee8b-e919-3782-b298-c0628070c7e1",
                        "glosses": [
                            "Donner un caractère antillais à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78fa0a38-4da8-49cf-bb5b-d71468e02dba",
                                "sense_id": "42a6d592-d386-357f-9546-d2c91e4c0f41",
                                "text": "Autre point étonnant, mis à part l’affrontement à froid avec le pouvoir français : la volonté d’antillaniser, de caribéaniser le combat."
                            },
                            {
                                "example_id": "3a7666e9-a432-4da8-81f0-f68347f4b155",
                                "sense_id": "42a6d592-d386-357f-9546-d2c91e4c0f41",
                                "text": "La quête est frustrante du fait de l’épais silence des livres, et l’ignorance conduit Pythagore à « antillaniser » son Afrique lorsqu’il ne se limite pas à quelques stéréotypes."
                            }
                        ]
                    }
