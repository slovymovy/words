                "senses": [
                    {
                        "sense_id": "18efc3fb-2156-3800-be4b-2e2062b7f1d1",
                        "entry_id": "bd97b616-0452-38e5-866e-2334e4328aab",
                        "glosses": [
                            "Manière de distribuer, de disposer les ornements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d70465f-7a92-4ba2-8f44-33aa37fb9f2c",
                                "sense_id": "18efc3fb-2156-3800-be4b-2e2062b7f1d1",
                                "text": "Contrairement à ce que nous voyons à Narbonne, où la sculpture fait complètement défaut, l’ornementation est prodiguée dans l’église de Saint-Nazaire."
                            },
                            {
                                "example_id": "10520b67-7bfa-4831-9f62-95d0bb4f0223",
                                "sense_id": "18efc3fb-2156-3800-be4b-2e2062b7f1d1",
                                "text": "De style ogival flamboyant, à ornementation très fouillée, surtout dans la façade et les tours, ses arcs-boutants, ses clochetons, ses pinacles gothiques sont remarquables."
                            },
                            {
                                "example_id": "da462b25-0d33-4981-a7d1-b4842eda3a26",
                                "sense_id": "18efc3fb-2156-3800-be4b-2e2062b7f1d1",
                                "text": "Tout ce qu’ils aimaient de l’Italie, les grandes fenêtres ouvertes sur la lumière, les colonnades torses des balcons, l’ornementation à l’antique des façades, était acquis comme de grasses prébendes à cet ignoble de Griffes."
                            }
                        ]
                    },
