                "senses": [
                    {
                        "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                        "entry_id": "1ed30621-4d52-34a5-86a2-a6eb9ee78886",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f77074-31eb-4423-aa72-0873bb56bbfc",
                                "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                                "text": "Frau Schwärzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ffad1cd3-1442-48f0-9edd-3e78893c158e",
                                "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                                "text": "Herr Schwärzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9170e130-171d-4aa1-b882-896ba8051f2d",
                                "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                                "text": "Die Schwärzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "91cfdb1d-af2b-44a1-a118-bb9f11e9e64a",
                                "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                                "text": "Der Schwärzle trägt nie die Schals, die die Schwärzle ihm strickt."
                            },
                            {
                                "example_id": "3033d451-4586-447d-9390-2804e8df67e2",
                                "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schwärzle kommt, geht der Herr Schwärzle.“"
                            },
                            {
                                "example_id": "a1ce562c-1b01-459d-a944-16ebef18ff73",
                                "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                                "text": "Schwärzle kommt und geht."
                            },
                            {
                                "example_id": "f8ebc580-9ea8-4a93-84d0-f665877436de",
                                "sense_id": "20ef302e-628a-384c-a8d9-c24c5bee7024",
                                "text": "Schwärzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
