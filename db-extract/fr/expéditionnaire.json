                                "target_senses": [
                                    {
                                        "sense_id": "bc0bd6b2-706e-3cd8-bb0a-3be67190ea51",
                                        "entry_id": "f459e306-9d94-340d-bb06-2109b9ee3363",
                                        "glosses": [
                                            "One who goes on expeditions, especially one who is a member of an expeditionary military force."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed6a8f4-8c1b-410e-bc14-fcf0efa9e4f4",
                                                "sense_id": "bc0bd6b2-706e-3cd8-bb0a-3be67190ea51",
                                                "text": "[...] turned out in its best attire to receive the Brazilian expeditionaries and the group of soldiers representing the gallant U.S. 10th Mountain Division."
                                            },
                                            {
                                                "example_id": "cd02abfa-b636-423f-aa69-bb7c36f9f14f",
                                                "sense_id": "bc0bd6b2-706e-3cd8-bb0a-3be67190ea51",
                                                "text": "He who had been left for dead, rose again in three days to become the leader of the expeditionaries and, in a very real way (albeit not exclusively), [...]. Antonio “ Tintin” Vizintin was brave and strong, qualities that made him a good expeditionary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
