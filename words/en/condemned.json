                        "doomed"
                    ],
                    "antonyms": [
                        "blessed",
                        "saved"
                    ],
                    "common_phrases": [
                        "condemned soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проклятый, обречённый на вечные страдания.",
                        "de": "Verflucht oder zu ewigem Leid bestimmt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "преданный проклятию"
                            },
                            {
                                "target_lang_word": "обречённый",
                                "target_lang_sense_clarification": "неминуемо идущий к гибели"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verdammt",
                                "target_lang_sense_clarification": "zu ewigem Leid verurteilt"
                            },
                            {
                                "target_lang_word": "verflucht",
                                "target_lang_sense_clarification": "mit einem Fluch belegt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b1609de-ca4e-31ee-9770-0643b6544cbd",
                    "sense_definition": "A person sentenced to death.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest visited the prison to offer comfort to the <w>condemned</w>.",
                            "target_lang_translations": {
                                "ru": "Священник посетил тюрьму, чтобы утешить <w>приговорённых</w>.",
                                "de": "Der Priester besuchte das Gefängnis, um den <w>Todeskandidaten</w> Trost zu spenden."
                            }
                        },
                        {
                            "text": "A special meal was prepared for the <w>condemned</w> before the execution.",
                            "target_lang_translations": {
                                "ru": "Для <w>смертника</w> перед казнью была приготовлена особая трапеза.",
                                "de": "Für den <w>Todeskandidaten</w> wurde vor der Hinrichtung eine besondere Mahlzeit zubereitet."
                            }
                        }
