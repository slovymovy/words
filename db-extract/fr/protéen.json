                            {
                                "example_id": "7e6a61dd-7a15-49a4-ad41-89a2e742a763",
                                "sense_id": "f0fec598-9ddc-3204-8243-9a67afd9a1d0",
                                "text": "Au pays du trimard, la vie a des traits protéens."
                            },
                            {
                                "example_id": "a09652e0-222c-4c8f-b247-9698a319e096",
                                "sense_id": "f0fec598-9ddc-3204-8243-9a67afd9a1d0",
                                "text": "Merlin L'enchanteur était protéen."
