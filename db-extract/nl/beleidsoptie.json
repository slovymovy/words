                        "examples": [
                            {
                                "example_id": "b48f062c-cf3c-41e1-a349-3fb5fd6fd3de",
                                "sense_id": "af8b2291-36b9-367c-9227-360fdc000479",
                                "text": "Bij de vorige doorrekening in 2017 liet het CDA de plannen niet doorlichten door het PBL. Dit keer ziet de VVD af van het aanbod van het PBL om het programma door te rekenen op milieueffecten, onder andere omdat het PBL kernenergie niet meerekent als beleidsoptie."
                            },
                            {
