        "fr-extract.jsonl": [
            {
                "entry_id": "58b6f4c9-a016-34f1-9fcf-002595b050ab",
                "word": "unicité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "af37460b-d591-45ec-bd54-7fff77c95459",
                        "entry_id": "58b6f4c9-a016-34f1-9fcf-002595b050ab",
                        "tags": [
