                                                "sense_id": "a972dc35-32db-3d30-b803-71be8c3c3e54",
                                                "text": "Plodem maliníku je malina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21df6ea-a37b-307c-9272-35f082f48161",
                                        "entry_id": "634a9f46-ed2a-32b8-b71d-e2f82df9f017",
                                        "glosses": [
                                            "vyvíjející se zárodek zvířete nebo člověka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0844b9e-028c-4680-9873-6b8dcf8c3b94",
                                                "sense_id": "a21df6ea-a37b-307c-9272-35f082f48161",
                                                "text": "Doktor oznámil nastávající matce, že plod se vyvíjí správně, a dítě tedy nejspíše bude zdravé."
