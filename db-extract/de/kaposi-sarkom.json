                        "entry_id": "34e10238-ba71-3c9a-8c31-daca85484486",
                        "glosses": [
                            "bei Immunschwäche auftretende Krebserkrankung, die sich durch das Auftreten von braun-bläulichen Tumorknoten vor allem im Bereich der Haut, von Schleimhäuten und im Darm äußert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6336bd3b-356c-4fc1-b1ae-9317df00b96a",
                                "sense_id": "32d2f791-0f1e-3607-ac15-ceb2b095539f",
                                "text": "„Seine Finger sind fleckig schwarz, sein Bizeps, sein Musculus latissimus, seine schrägen Bauchmuskeln sind blauschwarz gefleckt, ähnlich wie die Hautveränderungen, die man bekommt, wenn man das Kaposi-Sarkom hat, den Krebs der Schwulen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
