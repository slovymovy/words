                        "examples": [
                            {
                                "example_id": "86dd9ed4-09bc-4190-a935-8160ba2f3610",
                                "sense_id": "76d4f074-8898-3215-b375-93f5cd9bb5c3",
                                "text": "“Ik wou de wedstrijd hard maken, kreeg vrij snel tien seconden voorsprong, maar toen kwam mijn steekas in mijn voorwiel los. Ik besloot om niet te wisselen, want dan zou Eli snel terugkeren. Een risico dat ik beter niet genomen had, want mijn voorwiel zat los, ik schoof soms weg in de bochten en Eli kon terugkeren.”"
                            }
                        ]
                    }
