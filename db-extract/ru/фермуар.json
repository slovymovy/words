                "translations": [
                    {
                        "translation_id": "862e777a-ff63-4c69-93bd-27b6cdff5969",
                        "source_entry_id": "1b32bb90-1795-35f3-9750-ace9a1332039",
                        "source_sense_description": "застёжка",
                        "target_lang_word": "clasp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clasp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6360852-f5f9-3b5a-820b-c2a2a98b8545",
                                        "entry_id": "1548ef56-3359-3860-82a8-918fd764249e",
                                        "glosses": [
                                            "A device with interlocking parts used for fastening things together, such as a fastener or a holder."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dccf85c-cf77-426d-8366-f9fff74eeec3",
                                                "sense_id": "a6360852-f5f9-3b5a-820b-c2a2a98b8545",
                                                "text": "I always have a hard time working the clasp on this necklace!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d666e86b-bfb7-35aa-962e-1f11a737ba74",
                                        "entry_id": "1548ef56-3359-3860-82a8-918fd764249e",
                                        "glosses": [
                                            "A bar or insignia on a medal ribbon, to either indicate an additional award of the medal, or the action or service for which it was awarded."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0d09a5b-28db-3297-9d93-31d5f2b8e08d",
                                        "entry_id": "1548ef56-3359-3860-82a8-918fd764249e",
                                        "glosses": [
                                            "An embrace, a grasp, or handshake."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c894d903-89fa-4595-93e6-7640e47fbe1f",
                                                "sense_id": "a0d09a5b-28db-3297-9d93-31d5f2b8e08d",
                                                "text": "He took her hand in a firm clasp."
                                            },
                                            {
                                                "example_id": "3110bb49-6210-4694-8d79-e442530fc232",
                                                "sense_id": "a0d09a5b-28db-3297-9d93-31d5f2b8e08d",
                                                "text": "How few! yet how they creep / Through my fingers to the deep, / While I weep—while I weep! / O God! can I not grasp / Them with a tighter clasp?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clasp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                        "entry_id": "377bce19-5388-30a7-8cc8-d7f845a4e5ec",
                                        "glosses": [
                                            "To take hold of; to grasp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a541633a-b1fc-41a2-a07d-0a5acfa02d5a",
                                                "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                                "text": "They clasped hands and parted as friends."
                                            },
                                            {
                                                "example_id": "4b4244fe-b2a3-48de-b97f-b7d76f123cff",
                                                "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                                "text": "And when the Boy dropped off to sleep, the Rabbit would snuggle down close under his little warm chin and dream, with the Boy's hands clasped close round him all night long."
                                            },
                                            {
                                                "example_id": "2b1d8f62-2be9-42f3-8658-09573f90b5da",
                                                "sense_id": "f439d99a-f80b-384f-9f23-1290f28de380",
                                                "text": "The poor dear lady shivered, and I could see the tension of her nerves as she clasped her husband closer to her and bent her head lower and lower still on his breast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1af081-3cf6-37ce-bfd2-4b69ca9bca48",
                                        "entry_id": "377bce19-5388-30a7-8cc8-d7f845a4e5ec",
                                        "glosses": [
                                            "To shut or fasten together with, or as if with, a clasp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3677e1d6-bf2d-38ff-a930-8fe95d8c3472",
                                        "entry_id": "377bce19-5388-30a7-8cc8-d7f845a4e5ec",
                                        "glosses": [
                                            "To cling."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "298fff2d-6200-4b4a-823a-95dfe5363907",
                        "source_entry_id": "1b32bb90-1795-35f3-9750-ace9a1332039",
                        "source_sense_description": "застёжка",
                        "target_lang_word": "fermoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fermoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                        "entry_id": "9f4c6e21-2f03-37fb-9116-119b19734f3e",
                                        "glosses": [
                                            "Sorte de fermeture, serrure ou ressort s’appliquant à certains objets, tels que livres, colliers, bracelets, médaillons, coffrets, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d2f7424-d715-4b0e-b33f-aed29a091f43",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Mettre des fermoirs à un in-folio."
                                            },
                                            {
                                                "example_id": "37503d75-3d29-4fbf-8e30-78a4def4e78e",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Des fermoirs d’or."
                                            },
                                            {
                                                "example_id": "8ef9e28c-bf9f-4341-bcdd-46b7adcf9721",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Des fermoirs d’argent."
                                            },
                                            {
                                                "example_id": "5dd86cbd-5ed8-48a4-93e7-766e09731935",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Le fermoir de ce collier, de ce bracelet est usé, risque de s’ouvrir."
                                            },
                                            {
                                                "example_id": "82808287-c770-4d38-a1c4-ccdbf594b7f8",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Sur un fauteuil, devant lui, était posé un vieux coffret recouvert en peau et fermé de fermoirs en cuivre brillant."
                                            },
                                            {
                                                "example_id": "c219acfb-67d8-43c6-8128-d8af2b9acab9",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Dorothée se signait à tour de bras, ses grosses besicles penchées sur un antique missel à fermoir de cuivre, marmottant les paroles latines avec ferveur."
                                            },
                                            {
                                                "example_id": "d60651ea-e6ec-4f12-8f6b-5aa05daddbb3",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Il tenait à la main un petit sac de voyage en toile cirée. Ses mains tremblantes en cherchaient le fermoir, comme s’il eût voulu l’ouvrir."
                                            },
                                            {
                                                "example_id": "1a849df9-62eb-4157-83f0-48e3be100e76",
                                                "sense_id": "944ea3fc-f906-3d56-91a3-130021ac9bb4",
                                                "text": "Noémi n’est plus la Doña Sol des familles : correcte et quelconque dans sa robe de taffetas à corsage montant, ses lèvres sèchement closes comme le fermoir d’un sac de dame nous renseignent seules sur son manque de bonté."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fermoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "580971f2-0654-3b73-8566-46b031f74bd4",
                                        "entry_id": "c67c117c-2b9b-3326-b423-cf0c2f6a2375",
                                        "glosses": [
                                            "Outil dont les sculpteurs, les bourreliers, les charrons, les menuisiers, les ébénistes, les charpentiers se servent pour différents ouvrages. Le fermoir est un ciseau, qui a deux biseaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
