                                        "glosses": [
                                            "sichelförmige Vorrichtung zum Halten der Hostie"
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee23f4ff-2357-40e0-a973-32db07ca554e",
                                                "sense_id": "3536353c-9b87-3371-8d43-598b9f64d1c6",
                                                "text": "Die Lunula wird in der Monstranz oder der Custodia verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f912143f-8ca8-30f1-b271-6396e67c6bc7",
