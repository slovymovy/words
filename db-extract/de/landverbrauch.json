                "senses": [
                    {
                        "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                        "entry_id": "0e0d968a-3238-3b7b-9bcf-d3cada00442a",
                        "glosses": [
                            "(menschliche) Nutzung dann nicht mehr naturbelassener Flächen, beispielsweise als Siedlungsfläche, Verkehrsfläche, im Tagebau, in der Landwirtschaft"
                        ],
                        "tags": [
                            "Stadtplanung",
                            "Raumordnung",
                            "Umwelt",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "bf1edc8b-5d2e-4a25-8f5c-fc4f3787a715",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "[Monarchfalter:] „Einige Überwinterungsplätze in Kalifornien sind durch den Landverbrauch gefährdet, andere im Staat, den Countys und öffentlichen Parks sind geschützt.“"
                            },
                            {
                                "example_id": "775c1792-20a1-4308-b3dc-bbf12e6ca7d5",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„Ebenso sind Landverbräuche und Beeinträchtigungen von Lebensräumen für Tiere und Pflanzen und der Biodiversität relevant.“"
                            },
                            {
                                "example_id": "f3da7c62-c296-4c62-98c6-79910d471809",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "[Rhein-Maas-Delta:] „Der zunehmende Landverbrauch hat die verbliebenen Überschwemmungsflächen der Flüsse gefährlich dezimiert,“ […]."
                            },
                            {
                                "example_id": "001370a9-d9a5-43ba-b770-6ff8fea95968",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„Unbestritten ist aber, dass die Umweltbilanz von Hafer- und Sojadrinks besser ausfällt, weil bei ihrer Produktion u.a. weniger CO2 anfällt und der Landverbrauch geringer ist.“"
                            },
                            {
                                "example_id": "08d510d9-7e69-4dbb-8086-4f0b4fe0e2be",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„»Und ein sehr großes Problem bei Aquakultur-Fisch ist die Futtermittelherstellung. Die verbraucht viel Energie. Und vor allem – was der entscheidende Faktor ist – sie hat einen hohen Landverbrauch.«“"
                            },
                            {
                                "example_id": "f590788f-ce0a-40fc-aa19-675a3466bc3f",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "[Einfamilienhäuser:] „Durch die lockere Bebauung in ein- oder zweigeschossiger Bauweise steigt der Landverbrauch im Vergleich zur Zeilenbau- und Blockrandbebauung und zu mehr- oder vielgeschossigen Bauweisen deutlich an.“"
                            },
                            {
                                "example_id": "02c4b476-0451-4e18-9a68-6e90544b8598",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„Allein in Indonesien hat sich der Landverbrauch für Ölpalmen seit 1990 verzehnfacht.“"
                            },
                            {
                                "example_id": "ae7c6aaa-9c57-499d-93eb-c23c8cefa539",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„Wie ist das eigentlich in Deutschland mit dem Landverbrauch, wie viel Boden wird hier laufend umgenutzt? Jeden Tag werden in Deutschland 52 Hektar Land als Siedlungs- und Verkehrsfläche neu ausgewiesen, heißt es auf der Homepage des Bundesministeriums für Umwelt. Das sind, um es sich vorzustellen, umgerechnet etwa 73 Fußballfelder.“"
                            },
                            {
                                "example_id": "e0582d04-eee4-4abb-ada0-f9992d9c0f77",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„Über 40 Prozent des Landverbrauchs wurden also vom WWF fälschlicherweise nicht erfasst.“"
                            },
                            {
                                "example_id": "cbca0904-c2bf-4cd0-b4ff-af6c935b51c5",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„Im Kanton Obwalden soll die Regierung bei der Beurteilung der Steuerstrategie künftig den Landverbrauch und die Entwicklung der Wohnpreise mitberücksichtigen.“"
                            },
                            {
                                "example_id": "8659b135-8c9b-481c-9ff9-cb01df0e6882",
                                "sense_id": "cb29b527-9879-3c0e-9d43-959a844143dc",
                                "text": "„Außerdem soll der Landverbrauch sinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
