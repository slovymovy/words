                                        "glosses": [
                                            "Qui donne le bonheur, où l’on trouve le bonheur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36e0729e-212b-4b7e-a5ce-df5f831f1da8",
                                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                                                "text": "Ils touchaient au moment fortuné qui allait les unir, lorsque, se promenant ensemble vers une porte de Babylone, … ils virent venir à eux des hommes armés de sabres et de flèches."
                                            },
                                            {
                                                "example_id": "be1a99e8-0b3d-42e5-ac08-6c8d9309f97c",
                                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
