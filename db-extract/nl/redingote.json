                        "sense_id": "9f896afd-fae1-35bd-937e-ddd9cb502b67",
                        "entry_id": "2865e17c-c208-3031-a937-b7c37fa33515",
                        "glosses": [
                            "ruim vallende geklede herenjas die tot de knieën reikt, met brede schouders en smalle taille, zoals die in de 18e eeuw in de mode kwam en dat tot de tweede helft van de 19e eeuw bleef"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aea4128-cd5d-4276-99a8-29d06890bf39",
                                "sense_id": "9f896afd-fae1-35bd-937e-ddd9cb502b67",
                                "text": "De oude burger draagt een jas zonder opsmuksels, aan de lengte en de hoge split te zien een redingote, een kledingstuk dat heel kenmerkend voor de democratiserende tendens in de mode die de burgerij vanaf de jaren 1780 ging volgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "37ea0eb9-1348-3dfb-8a0e-503154e0b1ad",
                        "entry_id": "2865e17c-c208-3031-a937-b7c37fa33515",
                        "glosses": [
                            "jurk met een model dat aan de gelijknamige herenjas doet denken"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0aa4d99e-2654-4ae1-b09f-d67fecf8ed2e",
                                "sense_id": "37ea0eb9-1348-3dfb-8a0e-503154e0b1ad",
                                "text": "⧖ Op dit oogenblik is de strooming ten gunste der zijde al zeer sterk; redingote, panneaux en empire-model, die groote gladde oppervlakten aanbieden, vereischen fraaie stoffen, en de fabrieken te Lyon, aan de eischen van den tijd tegemoet komende, leveren prachtiger, — maar ook kostbaarder — werk, dan zij misschien ooit geleverd hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebba006d-6734-3ad4-ae4c-c3dd890c7152",
                        "entry_id": "2865e17c-c208-3031-a937-b7c37fa33515",
                        "glosses": [
                            "damesmantel met een model dat aan de gelijknamige herenjas doet denken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8854ae9e-9f06-4c8c-91f1-824d25890fcc",
                                "sense_id": "ebba006d-6734-3ad4-ae4c-c3dd890c7152",
                                "text": "Een armelijk geklede man, waarschijnlijk de echtgenoot van de zittende vrouw, houdt zijn hand op voor een paar duiten die een in modieuze redingote geklede vrouw aan hem wil geven."
                            }
                        ]
                    }
