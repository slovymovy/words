                                "target_senses": [
                                    {
                                        "sense_id": "fb97f110-8f1a-3723-8ad4-c9580753c215",
                                        "entry_id": "227c6dda-bd3f-3085-ab7d-9916ba9ebda3",
                                        "glosses": [
                                            "A contract specifying terms and conditions of employment between one or more labor unions and employers' organizations legally binding for employers organized in these and the employees if they are unionized in them or their employment contract incorporates them by referral."
