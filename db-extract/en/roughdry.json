                "senses": [
                    {
                        "sense_id": "a221c822-5289-3b94-94b2-cc8d5f134d92",
                        "entry_id": "f2fbef62-cc06-393a-b8d0-353e8a24a3f1",
                        "glosses": [
                            "In laundry work, to dry without smoothing or ironing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aa41bf21-4a08-49d4-a6cd-bbcefa091814",
                                "sense_id": "a221c822-5289-3b94-94b2-cc8d5f134d92",
                                "text": "Mr. Seeders was thin and had light hair, and appeared to have been recently roughdried and starched."
                            },
                            {
                                "example_id": "cce640a4-4849-48d1-ba9c-7e52ad382f22",
                                "sense_id": "a221c822-5289-3b94-94b2-cc8d5f134d92",
                                "text": "From Miss Purchase— who nearly killed herself over his shirts, starching and ironing them, and nearly drove me crazy because she roughdried my clothes — down to the blacksmith's where Stephen took his riding horse to be shod, my husband was a general favorite ."
                            },
                            {
                                "example_id": "923268a1-80d7-494a-8eac-c9f7f11f3475",
                                "sense_id": "a221c822-5289-3b94-94b2-cc8d5f134d92",
                                "text": "This includes looading, unloading, and operating controls of machines to wash, dye, starch, roughdry, or condition items for pressing."
                            }
                        ]
                    },
                    {
                        "sense_id": "29b1c88c-1908-3a92-8f00-f10088b857ae",
                        "entry_id": "f2fbef62-cc06-393a-b8d0-353e8a24a3f1",
                        "glosses": [
                            "To dry shaped bricks before they are fired in a kiln."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fdc75f6-d584-4120-9ec6-1164281b3724",
                                "sense_id": "29b1c88c-1908-3a92-8f00-f10088b857ae",
                                "text": "He had a cough which spoke sometimes of roughdried bricks in a builder's yard, and his calf muscles spoiled the particoloured set of his stockings."
                            }
                        ]
                    }
