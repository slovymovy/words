                        "target_lang_word": "Jagd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jagd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76961ff0-5318-386e-90a4-8f6b30070c24",
                                        "entry_id": "27c1d41d-d173-34b4-aa21-9a1172cbd702",
                                        "glosses": [
                                            "das Aufsuchen, Nachstellen, Fangen, Erlegen und Aneignen von Wild durch Jäger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bde59f8-4eb6-4517-a5fa-23fc7888fd44",
                                                "sense_id": "76961ff0-5318-386e-90a4-8f6b30070c24",
                                                "text": "Eine Jagd wird nach ganz strengen Regeln durchgeführt."
                                            },
                                            {
                                                "example_id": "20a2ab1a-50a7-494c-be44-ab5afdf3b7d3",
                                                "sense_id": "76961ff0-5318-386e-90a4-8f6b30070c24",
                                                "text": "Morgen gehe ich auf die Jagd."
                                            },
                                            {
                                                "example_id": "72b5dbf0-a452-4167-b1ec-7e193563a90a",
                                                "sense_id": "76961ff0-5318-386e-90a4-8f6b30070c24",
                                                "text": "„Forstrat Bertram, Meixner durch die gemeinsame Jagd verbunden, hatte einen Film über die seit längerem beobachteten Baumschäden gedreht, den er gern in dieser Runde gezeigt hätte.“"
                                            },
                                            {
                                                "example_id": "3c926c32-c05d-4416-b670-eeaa63f64b69",
                                                "sense_id": "76961ff0-5318-386e-90a4-8f6b30070c24",
                                                "text": "„Man kultivierte die nobleren Beschäftigungen, nicht nur das Tennisspiel, sondern vor allem die Jagd und die Zucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af8c27f3-14b7-3fbb-919b-c5028d9f53e6",
                                        "entry_id": "27c1d41d-d173-34b4-aa21-9a1172cbd702",
                                        "glosses": [
                                            "die Verfolgung, Aufklärung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56fc9b4b-2a17-4af1-b563-a200c82abf5d",
                                                "sense_id": "af8c27f3-14b7-3fbb-919b-c5028d9f53e6",
                                                "text": "Die Jagd nach dem Mörder verlief erfolglos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "49d704ac-2794-3493-8f8a-453f685c14ff",
                                        "entry_id": "27c1d41d-d173-34b4-aa21-9a1172cbd702",
                                        "glosses": [
                                            "Jagdrevier"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd552ab-6628-4834-b1bb-359d8f7add7b",
                                                "sense_id": "49d704ac-2794-3493-8f8a-453f685c14ff",
                                                "text": "Unser Nachbar hat eine Jagd im Sachsenwald."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
