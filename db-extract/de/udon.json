                                        "glosses": [
                                            "Variété de nouilles épaisses japonaises à la farine de blé tendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92586596-41a2-4b0a-aee1-07a877601a85",
                                                "sense_id": "0ca31518-4e5e-300d-8b2b-987f3d8b37ac",
                                                "text": "Elle n’avait rien avalé depuis la veille.\nIsak commanda deux bols de udon.\n– C’est comme du kalguksu, mais le bouillon est différent."
                                            },
                                            {
                                                "example_id": "609ae0a2-501f-4726-828c-ab6c3f01089b",
                                                "sense_id": "0ca31518-4e5e-300d-8b2b-987f3d8b37ac",
                                                "text": "À l’aide d'une écumoire, récupérer les nouilles udon et les placer au fond du bol."
                                            },
                                            {
                                                "example_id": "ac1fafb8-236f-4689-b324-944e6ef3a7c9",
                                                "sense_id": "0ca31518-4e5e-300d-8b2b-987f3d8b37ac",
                                                "text": "Vous pouvez trouver les udon et le sésame moulu dans les épiceries japonaises."
                                            }
                                        ]
                                    }
