                "senses": [
                    {
                        "sense_id": "8c592fd0-43ae-35a8-a05b-b6a4df5305ef",
                        "entry_id": "51c85ade-374c-3bb0-99a5-e1ad0f518f39",
                        "glosses": [
                            "Christentum „östlicher“ beziehungsweise orthodoxer Tradition im Gegensatz zur römisch-katholischen Kirche der lateinisch-westlichen Tradition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7644b49a-8fd3-4d6f-9a41-d50664d1afab",
                                "sense_id": "8c592fd0-43ae-35a8-a05b-b6a4df5305ef",
                                "text": "Zur Ostkirche gehören die Gebiete in der Tradition der altkirchlichen Patriarchate Konstantinopel, Alexandrien, Antiochien und Jerusalem."
                            },
                            {
                                "example_id": "c6129d57-4bf2-40a8-8597-70a85e2839b2",
                                "sense_id": "8c592fd0-43ae-35a8-a05b-b6a4df5305ef",
                                "text": "Als katholische Ostkirchen werden die 23 Teilkirchen eigenen Rechts der römisch-katholischen Kirche bezeichnet, die in ostkirchlicher Tradition stehen."
                            },
                            {
                                "example_id": "5f3d72c4-876a-4d75-aaa9-4abf5487e42c",
                                "sense_id": "8c592fd0-43ae-35a8-a05b-b6a4df5305ef",
                                "text": "„Im Gegensatz zur Westkirche vermochte sich ein großer Teil der Ostkirche kaum gegen kaiserliche Interventionen zu wehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
