                },
                {
                    "sense_id": "626c2cfc-9114-3d12-bca4-f88fa7beb34b",
                    "sense_definition": "A specific region of the Earth, often distinguished by its weather conditions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_environment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many birds migrate to warmer <w>climates</w> during the winter months.",
                            "target_lang_translations": {
                                "ru": "Многие птицы мигрируют в более тёплые <w>края</w> в зимние месяцы.",
                                "zh": "许多鸟类在冬季会迁徙到更温暖的<w>地区</w>。"
                            }
                        },
                        {
                            "text": "He dreamed of traveling to foreign <w>climates</w> far away from home.",
                            "target_lang_translations": {
                                "ru": "Он мечтал о путешествиях в чужеземные <w>края</w>, далеко от дома.",
                                "zh": "他梦想着去远离家乡的异国<w>地方</w>旅行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "region",
                        "clime"
                    ],
                    "common_phrases": [
