                "translations": [
                    {
                        "translation_id": "0077538c-f764-4d73-971c-16962bf3f35b",
                        "source_entry_id": "ab0136da-44cb-3360-918c-ceb75237cd49",
                        "source_sense_id": "5fa6bb39-e050-34b1-af62-fac14b4de7be",
                        "target_lang_word": "ежи́ха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ежи́ха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fdaf4425-35e6-3f0a-bd6a-9d007083a2cf",
                                        "entry_id": "e2e77563-cbe8-3dfd-b6c3-ad956781deed",
                                        "glosses": [
                                            "самка ежа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c941a920-8c08-417e-b824-8f64095646d5",
                                                "sense_id": "fdaf4425-35e6-3f0a-bd6a-9d007083a2cf",
                                                "text": ".. известно уж, что ежа по виду не отличишь от ежихи .."
                                            },
                                            {
                                                "example_id": "9ef80880-05f6-45a6-b487-b362520049ab",
                                                "sense_id": "fdaf4425-35e6-3f0a-bd6a-9d007083a2cf",
                                                "text": "Я вышел на крыльцо. Внук показал мне на спокойно прогуливавшееся по утоптанной дорожке целое семейство ежей. Впереди шёл старый большой ёж, за ним шла ежиха и маленькими комочками катились крохотные ежата."
                                            },
                                            {
                                                "example_id": "87bf814c-5f99-447a-bcee-723c748b302a",
                                                "sense_id": "fdaf4425-35e6-3f0a-bd6a-9d007083a2cf",
                                                "text": "В тихую, лунную ночь ежиха осторожно вывела свою семейку из гнезда и повела её по лесу."
                                            },
                                            {
                                                "example_id": "ce9aad4f-914d-42f1-b89a-8d5ac6e12cb7",
                                                "sense_id": "fdaf4425-35e6-3f0a-bd6a-9d007083a2cf",
                                                "text": "«Ну, ну, скорей! Скорей!» ― наклоняется он над ними, подойдя ближе. И ежиха сворачивается в клубок. А вслед за ней сворачиваются клубочком и малыши."
                                            },
                                            {
                                                "example_id": "2a44cfdf-786f-4359-a304-ceca1877b4f1",
                                                "sense_id": "fdaf4425-35e6-3f0a-bd6a-9d007083a2cf",
                                                "text": "Сегодня ночью ежиха родила 3 ежат."
                                            },
                                            {
                                                "example_id": "4a3028af-5cd1-4f93-a84e-5196e49b1839",
                                                "sense_id": "fdaf4425-35e6-3f0a-bd6a-9d007083a2cf",
                                                "text": "Ежиха первые дни ни на минуту не отходит от ежат. Кормит их молоком. А ежата слепые ещё и глухие .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
