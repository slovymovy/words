                        "entry_id": "872710b3-ca3e-3708-9fd8-5d37b8e0abc1",
                        "glosses": [
                            "kleine luidspreker speciaal geschikt voor het weergeven van de hoge tonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f068f59c-b6d1-40a2-94c2-67bfedf0f6e1",
                                "sense_id": "769c4cc9-6b7f-3c7d-9669-9e2a4d53f2a9",
                                "text": "Volgens techwebsite The Verge heeft Sonos wel prijsgegeven dat beide speakers voorzien zijn van twee digitale klasse D-versterkers, een tweeter en een midwoofer. De producten zijn vanaf augustus beschikbaar."
                            }
                        ]
