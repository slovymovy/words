                        "examples": [
                            {
                                "example_id": "b01c9457-9390-4106-a4d7-e88ad85aae94",
                                "sense_id": "06e67da3-31d7-3e0b-a4c9-078a87f4933e",
                                "text": "„Er spürte Rothstein in einem Nobelrestaurant an der 5. Avenue auf.“"
                            },
                            {
                                "example_id": "de4a73db-e6cc-45f7-9c7b-09e8c17da887",
                                "sense_id": "06e67da3-31d7-3e0b-a4c9-078a87f4933e",
                                "text": "„Mamas Ankleidekammer war voll von solchen Ausgehkleidungsstücken, dünnen Kleidern und Seidenblusen, Wickelkleidern aus Viskose, selbst für ein Essen im Søilen, Mos Nobelrestaurant, kamen sie mir zu fein vor.“"
                            }
                        ],
