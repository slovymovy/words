            {
                "entry_id": "9baca689-00fb-3942-a1cc-1afb0413d3a6",
                "word": "Zonzon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86283702-b1f8-310f-b0da-ffbef350bd67",
                        "entry_id": "9baca689-00fb-3942-a1cc-1afb0413d3a6",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d8490e-18a6-4b71-b3c6-61c8cdbfd529",
                                "sense_id": "86283702-b1f8-310f-b0da-ffbef350bd67",
                                "text": "Jacqueline Zonzon, enseignante en retraite, ancien professeur-relais du service éducatif des Archives départementales de la Guyane, est agrégée d’histoire-géographie, et présidente de l’Association des professeurs d’histoire-géographie de Guyane."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "32541187-9078-334f-a858-b71e8db12c03",
                "word": "zonzon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4894a70d-c701-4986-beed-8a74c1d41c95",
                        "entry_id": "32541187-9078-334f-a858-b71e8db12c03",
                        "tags": [
                            "plural"
                        ],
                        "form": "zonzons"
                    },
                    {
                        "form_id": "6497262f-ab9a-4e1a-bb11-45382cbc3c79",
                        "entry_id": "32541187-9078-334f-a858-b71e8db12c03",
                        "tags": [],
                        "form": "zonz"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f827b0b2-2a57-370f-a87f-9745bea1ab5e",
                        "entry_id": "32541187-9078-334f-a858-b71e8db12c03",
                        "glosses": [
                            "Prison, cachot."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b4bc630b-6db3-40d8-b760-a5f04cdbdb75",
                                "sense_id": "f827b0b2-2a57-370f-a87f-9745bea1ab5e",
                                "text": "Malgré des casiers judiciaires aussi volumineux qu’un Bottin mondain, à eux deux ils ne totalisaient en tout et pour tout que cinq années de zonzon."
                            },
                            {
                                "example_id": "41e0caf4-d698-4191-9f8a-5af39bbdc97e",
                                "sense_id": "f827b0b2-2a57-370f-a87f-9745bea1ab5e",
                                "text": "J’ai fermé ma gueule, mais je vous l’affirme, inspecteur, quand il est monté dans l’autocar, ce n’était plus ce vieux marqué par trente ans de zonzon, mais un mec tout neuf."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7837d3c9-ea89-3aa7-a6c2-0bc469909bf0",
                "word": "zonzon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "88f932f9-ad0e-463b-b1e9-058ad69d08aa",
                        "entry_id": "7837d3c9-ea89-3aa7-a6c2-0bc469909bf0",
                        "tags": [
                            "plural"
                        ],
                        "form": "zonzons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c906555d-3792-3272-a06b-be27a18e5762",
                        "entry_id": "7837d3c9-ea89-3aa7-a6c2-0bc469909bf0",
                        "glosses": [
                            "Bourdonnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5be3196-c691-4576-a8e9-3a646e3ef176",
                                "sense_id": "c906555d-3792-3272-a06b-be27a18e5762",
                                "text": "C’était ça, et c’était chanté par une femme. Ça je vous jure, et ça disait beaucoup, ce petit zonzon au fond de la nuit."
                            },
                            {
                                "example_id": "e2072733-9e7b-4e07-9d67-191338e568fe",
                                "sense_id": "c906555d-3792-3272-a06b-be27a18e5762",
                                "text": "Il me semble en effet percevoir un zonzon plus feutré qu’une enculade de mouches dans de la crème chantilly."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f390024-7d53-3dc6-bdbd-834c5bc0152c",
                        "entry_id": "7837d3c9-ea89-3aa7-a6c2-0bc469909bf0",
                        "glosses": [
                            "Petit gadget à l’usage de ceux qui veulent espionner (par exemple, micro miniature)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7ef86c-da09-42e1-80e9-52231d2c15ee",
                                "sense_id": "0f390024-7d53-3dc6-bdbd-834c5bc0152c",
                                "text": "C’est un zonzon, invention du Mossad, c’est génial, ça brouille l’écoute."
                            },
                            {
                                "example_id": "6498ef36-ef95-4dd4-8bce-2f6a2abd2eb8",
                                "sense_id": "0f390024-7d53-3dc6-bdbd-834c5bc0152c",
                                "text": "Je veux savoir laquelle. Et connaître le nom du juge qui a ordonné les zonzons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
