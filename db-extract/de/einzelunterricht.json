                        "source_sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                        "source_sense_description": "Unterricht, die Weitergabe von Wissen, Information und Fähigkeiten, für einen einzigen Schüler",
                        "target_lang_word": "cours particulier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cours particulier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1cb08c3-bc36-3ee4-a668-7920e2728ce6",
                                        "entry_id": "480ed62d-65c9-3068-ad09-e5a48f541593",
                                        "glosses": [
                                            "Leçon donnée à une personne ou un petit groupe de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7cab55-24c8-48e9-a498-8487e2ebdfbb",
                                                "sense_id": "a1cb08c3-bc36-3ee4-a668-7920e2728ce6",
                                                "text": "Je dois donner un cours particulier. Les yeux verts de Robbie se firent inquisiteurs. — Un cours particulier ? A qui ? Mon cœur se mit à battre un peu plus fort, et je me retins de sourire bêtement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c897aaba-8656-3759-bc57-4c3c86c8f012",
                                        "entry_id": "480ed62d-65c9-3068-ad09-e5a48f541593",
                                        "glosses": [
                                            "Enseignement supplémentaire spécial d’une matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc873fe-4f63-43da-b7ed-d35c182dffde",
                                                "sense_id": "c897aaba-8656-3759-bc57-4c3c86c8f012",
                                                "text": "Cet ouvrage est un « cours particulier », ce qui signifie qu’il ne s'adresse pas à tous, mais à chacun, et qu’il n’est pas systématique, encore moins exhaustif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
