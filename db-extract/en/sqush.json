                    {
                        "sense_id": "a299c2ba-f6df-3ff9-a691-40b03dae4d74",
                        "entry_id": "b67fd3a3-213c-3ce7-a177-a7c82bffe818",
                        "glosses": [
                            "To squash or squish."
                        ],
                        "tags": [
                            "US",
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e71fadd8-13eb-4baa-a15d-74be9a219ff5",
                                "sense_id": "a299c2ba-f6df-3ff9-a691-40b03dae4d74",
                                "text": "Blamed if the king didn't have to brace up mighty quick, or he'd a squshed down like a bluff bank that the river has cut under, it took him so sudden."
                            },
                            {
                                "example_id": "6a226123-72de-4fb6-8643-dead0e6a65bb",
                                "sense_id": "a299c2ba-f6df-3ff9-a691-40b03dae4d74",
                                "text": "[…] it was little better than a swamp, and at every step their shoes went sqush […]"
                            },
                            {
                                "example_id": "c6a9c8fa-3bf0-4e99-8c93-d293d26108db",
                                "sense_id": "a299c2ba-f6df-3ff9-a691-40b03dae4d74",
                                "text": "His feet squshed in the water as he went […] He tip-toed upstairs his wet shoes still squshing a little."
                            },
                            {
                                "example_id": "040b5bb3-0f8a-43c4-a86f-dcaaa2261084",
                                "sense_id": "a299c2ba-f6df-3ff9-a691-40b03dae4d74",
                                "text": "[…] a \"throne\", something God can sit on without having it sqush […]"
                            }
                        ]
                    }
