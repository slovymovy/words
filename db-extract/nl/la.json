                    {
                        "translation_id": "4ba6c340-b827-496f-a3f8-6e5db484207b",
                        "source_entry_id": "94308f8e-d4e1-367f-bb1f-3e6902a47f68",
                        "source_sense_id": "96763f72-63dc-3c6e-b532-978202d6da08",
