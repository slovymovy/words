                        "source_sense_id": "cf312047-4d6d-37d3-b538-e29c993e9500",
                        "source_sense_description": "voorwerp bestemd om personen of goederen naar een andere plaats te brengen",
                        "target_lang_word": "Verkehrsmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkehrsmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b92efb7-9b73-3eda-8bee-763df7ac068e",
                                        "entry_id": "27560883-531f-36f4-b30a-122aab7ae954",
                                        "glosses": [
                                            "Gerät zur Fortbewegung beziehungsweise zur Beförderung von Personen oder Gütern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4b774b9-4029-4e2b-9c90-9755fdc61984",
                                                "sense_id": "3b92efb7-9b73-3eda-8bee-763df7ac068e",
                                                "text": "Das Flugzeug ist eines der schnellsten Verkehrsmittel."
                                            },
                                            {
                                                "example_id": "0d2569a2-2297-4b3f-b4d9-7d16fdc0aa7e",
                                                "sense_id": "3b92efb7-9b73-3eda-8bee-763df7ac068e",
                                                "text": "Ich finde, die Abgase der Verkehrsmittel sind sehr schädlich für unsere Umwelt."
                                            },
                                            {
                                                "example_id": "ccc9ec8f-f40c-4bfb-9876-4c3d4f558534",
                                                "sense_id": "3b92efb7-9b73-3eda-8bee-763df7ac068e",
                                                "text": "„Das schnellste Verkehrsmittel ist die Straßenbahn.“"
                                            },
                                            {
                                                "example_id": "7c7add99-872a-4f9e-830a-cf9f185b7fac",
                                                "sense_id": "3b92efb7-9b73-3eda-8bee-763df7ac068e",
                                                "text": "„An der Bushaltestelle unterhielt man sich mit ihr über die Vorteile öffentlicher Verkehrsmittel.“"
                                            },
                                            {
                                                "example_id": "0f393a90-5a9e-44f4-9120-5e1c91492f89",
                                                "sense_id": "3b92efb7-9b73-3eda-8bee-763df7ac068e",
                                                "text": "„Ein interessanter Aspekt beim Fliegen ist ja auch, dass es das Verkehrsmittel ist, bei dem die Ungleichheit am größten ist: 80 Prozent der Menschheit haben noch nie im Flugzeug gesessen, und selbst in Deutschland sind im vergangenen Jahr 55 Millionen Menschen mindestens zwölf Monate gar nicht geflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
