                    {
                        "translation_id": "8680a902-7047-4cf3-ac6b-ad2da1693caa",
                        "source_entry_id": "71d59958-dcdd-347a-89b7-0713b0b0e427",
                        "source_sense_id": "238e2861-2894-33de-ba73-7cf8501c75af",
                        "target_lang_word": "émotivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "émotivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03c70eff-b7a7-3fdd-89bc-ee1b9c9f8965",
                                        "entry_id": "7d77b96d-bfca-3509-81d9-096226f8e2f7",
                                        "glosses": [
                                            "Faculté de s’émouvoir ou disposition à s’émouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0099a15-50e8-4718-91d3-4d4011d0c9b7",
                                                "sense_id": "03c70eff-b7a7-3fdd-89bc-ee1b9c9f8965",
                                                "text": "La première partie de ce guide traite de l’émotivité, de chaque type d’émotif et propose les moyens qui permettent à l’émotif, non seulement de retrouver la paix intérieure, mais aussi de réaliser son épanouissement total."
                                            },
                                            {
                                                "example_id": "5c5183ba-5bee-4ada-8794-205331ee86e8",
                                                "sense_id": "03c70eff-b7a7-3fdd-89bc-ee1b9c9f8965",
                                                "text": "Envisagez les choses sans émotivité avant de vous engager dans un projet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed2192f1-1fc3-4a6c-8d3a-71760e9a0fda",
                        "source_entry_id": "71d59958-dcdd-347a-89b7-0713b0b0e427",
                        "source_sense_id": "238e2861-2894-33de-ba73-7cf8501c75af",
                        "target_lang_word": "sensibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                        "entry_id": "7ed9d2ae-392f-3d05-8790-be80ef1e3384",
                                        "glosses": [
                                            "Qualité par laquelle un sujet est sensible aux impressions physiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de10a69-efbd-4cbe-ad4f-eb4193e10bd9",
                                                "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                                "text": "Avec l’utilisation d’antigènes de tréponèmes pâles tués, les réactions sérologiques ont vu leur sensibilité et leur spécificité nettement améliorées."
                                            },
                                            {
                                                "example_id": "92504996-3089-4a66-9787-9b98c7836c40",
                                                "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                                "text": "Il est d’une grande sensibilité à toutes les impressions de l’air."
                                            },
                                            {
                                                "example_id": "c9ea10f4-a426-45a0-a2e2-bb2d32f9146f",
                                                "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                                "text": "Avoir une égale sensibilité pour le froid et pour le chaud."
                                            },
                                            {
                                                "example_id": "22f42bff-fdb8-4513-a918-afc0650334df",
                                                "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                                "text": "La sensibilité des parties nerveuses."
                                            },
                                            {
                                                "example_id": "15f8806b-4c8b-4475-8970-05508c193046",
                                                "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                                "text": "La sensibilité de l’œil, de l’oreille."
                                            },
                                            {
                                                "example_id": "2681d332-533f-4cff-a027-2885b83ee5f8",
                                                "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                                "text": "Cet organe est d’une extrême sensibilité."
                                            },
                                            {
                                                "example_id": "801c51de-0854-4d3f-bb51-0b5fff957ae1",
                                                "sense_id": "62c1e1ad-96b4-3d7e-b51f-de5cd131a254",
                                                "text": "Les espèces montrent des sensibilités différentes à ces deux voies d’accès, comme l’ont montré des expériences effectuées avec le métolachlor et le norflurazon (Walsh et al., 1991)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464c4480-3be7-30ad-b767-1b063ff33b10",
                                        "entry_id": "7ed9d2ae-392f-3d05-8790-be80ef1e3384",
                                        "glosses": [
                                            "De même en parlant des impressions morales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d60e66af-52ca-4b70-a404-611482f042e3",
                                                "sense_id": "464c4480-3be7-30ad-b767-1b063ff33b10",
                                                "text": "Tous les états de la sensibilité sont moteurs. Le langage lui-même en contient la preuve. Il les appelle des émotions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "959f45ad-e04f-3b1a-ab48-b5a9040f822e",
                                        "entry_id": "7ed9d2ae-392f-3d05-8790-be80ef1e3384",
                                        "glosses": [
                                            "Ce à quoi l'on est sensible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac843b1d-070e-4905-be36-6f7a9e130568",
                                                "sense_id": "959f45ad-e04f-3b1a-ab48-b5a9040f822e",
                                                "text": "Il faut aussi bénéficier d'une relation de confiance et celle-ci s'établit avec la population quand le candidat à la députation a su démontrer sa compétence comme élu local en étant tout à la fois l'élu de tous, mais aussi l'expression d'une fraction d'entre eux ; sa sensibilité politique est aussi un des facteurs de sa légitimité à court terme et à moyen terme."
                                            },
                                            {
                                                "example_id": "e12ec97d-8dfe-4492-83d9-f577f9e95697",
                                                "sense_id": "959f45ad-e04f-3b1a-ab48-b5a9040f822e",
                                                "text": "Les juifs originaires d’Algérie, qui ont très tôt bénéficié du décret Crémieux, sont donc tous français depuis des générations et ont une sensibilité très nettement consistoriale (cf. p.315) agrémentée d’un esprit autant yekke (cf. p. 76) que méditerranéen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b025ec15-b3aa-3e25-bec7-35345bb8567f",
                                        "entry_id": "7ed9d2ae-392f-3d05-8790-be80ef1e3384",
                                        "glosses": [
                                            "Sentiment d’humanité, de pitié, de tendresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8178492-1d39-42db-8bef-908dbf734d72",
                                                "sense_id": "b025ec15-b3aa-3e25-bec7-35345bb8567f",
                                                "text": "Il a beaucoup de sensibilité, une grande sensibilité."
                                            },
                                            {
                                                "example_id": "3301ac60-2141-441d-a40f-91468fa91864",
                                                "sense_id": "b025ec15-b3aa-3e25-bec7-35345bb8567f",
                                                "text": "Il est d’une extrême sensibilité."
                                            },
                                            {
                                                "example_id": "d3482bf1-772a-4e4c-b0db-2eda677fd653",
                                                "sense_id": "b025ec15-b3aa-3e25-bec7-35345bb8567f",
                                                "text": "Une fausse sensibilité."
                                            },
                                            {
                                                "example_id": "5306c400-79eb-4067-a5c7-f2755a66235e",
                                                "sense_id": "b025ec15-b3aa-3e25-bec7-35345bb8567f",
                                                "text": "Une sensibilité affectée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7916c547-6c51-3a17-abd5-b79825595173",
                                        "entry_id": "7ed9d2ae-392f-3d05-8790-be80ef1e3384",
                                        "glosses": [
                                            "Ensemble des opérations qui constituent la vie sensitive et la vie affective."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35ff4f85-1c4a-35f4-a052-3d83859f8d8b",
                                        "entry_id": "7ed9d2ae-392f-3d05-8790-be80ef1e3384",
                                        "glosses": [
                                            "Propriété de marquer les plus légères différences, les moindres variations."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b399011d-ed30-4863-8282-b184e92167f2",
                                                "sense_id": "35ff4f85-1c4a-35f4-a052-3d83859f8d8b",
                                                "text": "La sensibilité d’une balance, d’un thermomètre, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915abe43-46a5-3e4f-8f45-8706800e0769",
                                        "entry_id": "7ed9d2ae-392f-3d05-8790-be80ef1e3384",
                                        "glosses": [
                                            "Capacité d’un test à donner un résultat positif lorsqu’une hypothèse est vérifiée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
