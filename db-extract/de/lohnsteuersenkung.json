                    {
                        "sense_id": "8f944441-f71b-39a1-a3e0-e8d5c4a30442",
                        "entry_id": "60be7caa-2628-3e38-9435-7d13332c62f8",
                        "glosses": [
                            "Senkung der Lohnsteuer"
