{
    "word_family": [
        "rebut",
        "rebutter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98a700a5-a120-3fd6-b75f-a3eee5300479",
                    "sense_definition": "A statement or argument designed to prove that an opponent's claims are false or incorrect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician issued a detailed <w>rebuttal</w> to the accusations made by the press.",
                            "target_lang_translations": {
                                "ru": "Политик выступил с подробным <w>опровержением</w> обвинений, выдвинутых прессой."
                            }
                        },
                        {
                            "text": "After hearing the criticism, she prepared a strong <w>rebuttal</w> to defend her research findings.",
                            "target_lang_translations": {
                                "ru": "Выслушав критику, она подготовила веское <w>возражение</w>, чтобы защитить результаты своего исследования."
                            }
                        }
                    ],
                    "synonyms": [
                        "refutation",
                        "refutal",
                        "contradiction"
                    ],
                    "common_phrases": [
                        "strong rebuttal",
                        "detailed rebuttal",
                        "issue a rebuttal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или аргумент, предназначенный для доказательства ложности или неверности утверждений оппонента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровержение",
                                "target_lang_sense_clarification": "доказательство ложности"
                            },
                            {
                                "target_lang_word": "контраргумент",
                                "target_lang_sense_clarification": "встречный довод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1990221a-212f-3eab-b300-edcd7333965b",
                    "sense_definition": "The act of contradicting something by presenting contrary evidence or a counter-argument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The success of the new program serves as a <w>rebuttal</w> to those who said it would fail.",
                            "target_lang_translations": {
                                "ru": "Успех новой программы служит <w>опровержением</w> слов тех, кто предсказывал ей провал."
                            }
                        },
                        {
                            "text": "His latest book provides a point-by-point <w>rebuttal</w> of the previous theories.",
                            "target_lang_translations": {
                                "ru": "Его последняя книга представляет собой пошаговое <w>опровержение</w> предыдущих теорий."
                            }
                        }
                    ],
                    "synonyms": [
                        "confutation",
                        "refutation"
                    ],
                    "common_phrases": [
                        "point-by-point rebuttal",
                        "effective rebuttal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт противоречия чему-либо путем представления противоположных доказательств или встречных аргументов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровержение",
                                "target_lang_sense_clarification": "процесс доказывания обратного"
                            },
                            {
                                "target_lang_word": "возражение",
                                "target_lang_sense_clarification": "выражение несогласия с доводами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ce8ee82-62fa-3c98-a998-4310845f0eec",
                    "sense_definition": "A legal pleading or response by a defendant to address evidence presented by the prosecution or plaintiff.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_proceedings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney requested more time to prepare a formal <w>rebuttal</w> for the court.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты запросил больше времени для подготовки официального <w>опровержения</w> для суда."
                            }
                        },
                        {
                            "text": "During the <w>rebuttal</w> phase of the trial, the witness clarified the timeline of events.",
                            "target_lang_translations": {
                                "ru": "На этапе представления <w>контрдоказательств</w> свидетель уточнил хронологию событий."
                            }
                        }
                    ],
                    "synonyms": [
                        "refutation"
                    ],
                    "common_phrases": [
                        "formal rebuttal",
                        "rebuttal witness",
                        "rebuttal evidence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическое состязательное заявление или ответ ответчика на доказательства, представленные обвинением или истцом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровержение",
                                "target_lang_sense_clarification": "в судебном процессе"
                            },
                            {
                                "target_lang_word": "контрдоказательство",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}