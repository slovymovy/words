                        "examples": [
                            {
                                "example_id": "730f84ac-5189-4c7e-8195-527777a05360",
                                "sense_id": "bc73a11d-039f-3502-a152-95b2b73de6a6",
                                "text": "„Als er alles gehört hatte, was Georgina ihm zu sagen hatte, und zuletzt erfuhr, dass Alfred jeden Augenblick mit einer Morphiumspritze zurück sein konnte, beschloss er, lieber allein mit dem Arzt zu reden.“"
                            },
                            {
                                "example_id": "e580b0b9-d511-4ea4-8597-554f83f030be",
                                "sense_id": "bc73a11d-039f-3502-a152-95b2b73de6a6",
                                "text": "„Das Tourniquet war angelegt und stoppte das herausspritzende arterielle Blut, außerdem hatte sich Frodo eine Morphiumspritze gesetzt.“"
                            }
                        ],
