                "forms": [],
                "senses": [
                    {
                        "sense_id": "26dd3f2b-66e4-3cc0-acb8-bd34ef878e9a",
                        "entry_id": "dbfded9a-34ad-389e-b3dc-f6c1f78c94c4",
                        "glosses": [
                            "Moving with haste or zeal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1466d922-4b3f-4df4-8116-09e040cd2be1",
                                "sense_id": "26dd3f2b-66e4-3cc0-acb8-bd34ef878e9a",
                                "text": "Half the populace are idle, / Half are busy in a room; / All are gravebound from the cradle, / All are hotfoot for their doom."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
