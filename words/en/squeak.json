{
    "word_family": [
        "squeaky",
        "squeaker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36260d89-fd7d-37e7-ba05-141dcee2069c",
                    "sense_definition": "To emit a short, high-pitched sound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden floorboards began to <w>squeak</w> as I walked across the room.",
                            "target_lang_translations": {
                                "zh": "我走过房间时，旧木地板开始<w>嘎吱作响</w>。"
                            }
                        },
                        {
                            "text": "The mouse let out a tiny <w>squeak</w> and ran away.",
                            "target_lang_translations": {
                                "zh": "老鼠轻轻<w>吱</w>了一声就跑掉了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "floorboards squeak",
                        "door hinges squeak"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出短促而尖细的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吱吱叫",
                                "target_lang_sense_clarification": "指动物、人或物体发出短促而尖细的声音"
                            },
                            {
                                "target_lang_word": "嘎吱作响",
                                "target_lang_sense_clarification": "尤指木板、门轴等发出刺耳的摩擦声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9884e6f1-6d9c-3342-b27f-4267e9064f93",
                    "sense_definition": "To win or progress by a narrow margin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "win",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team managed to <w>squeak</w> into the playoffs after a very difficult season.",
                            "target_lang_translations": {
                                "zh": "这个队经历了一个非常艰难的赛季后，总算<w>勉强进入</w>了季后赛。"
                            }
                        },
                        {
                            "text": "They <w>squeaked</w> past their opponents with a final score of one to zero.",
                            "target_lang_translations": {
                                "zh": "他们以一比零的最终比分<w>险胜</w>对手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "squeak into",
                        "squeak past"
                    ],
                    "target_lang_definitions": {
                        "zh": "以微弱优势获胜或晋级。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "勉强进入",
                                "target_lang_sense_clarification": "指勉强获得资格或进入下一阶段"
                            },
                            {
                                "target_lang_word": "险胜",
                                "target_lang_sense_clarification": "指以很小优势获胜或通过"
                            },
                            {
                                "target_lang_word": "侥幸晋级",
                                "target_lang_sense_clarification": "强调运气成分地勉强晋级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b7f068c-4aa7-36e3-acd4-cc35aa557524",
                    "sense_definition": "To speak or sound in a high-pitched manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nervous student started to <w>squeak</w> during her presentation.",
                            "target_lang_translations": {
                                "zh": "那名紧张的学生在做展示时开始<w>尖声细气地说话</w>。"
                            }
                        },
                        {
                            "text": "He tried to <w>squeak</w> out a few words despite his sore throat.",
                            "target_lang_translations": {
                                "zh": "尽管喉咙疼，他还是努力<w>尖着嗓子</w>挤出了几句话。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用尖细的嗓音说话，或发出尖细的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖声说话",
                                "target_lang_sense_clarification": "指用尖细的声音说话"
                            },
                            {
                                "target_lang_word": "尖着嗓子说",
                                "target_lang_sense_clarification": "强调嗓音又高又细"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f664276-5d5d-3235-96f8-693d0769a806",
                    "sense_definition": "To inform on someone to the authorities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal decided to <w>squeak</w> on his partners to get a lighter sentence.",
                            "target_lang_translations": {
                                "zh": "那个罪犯决定向警方<w>告发</w>同伙，以换取较轻的刑罚。"
                            }
                        },
                        {
                            "text": "He was afraid that his accomplice would <w>squeak</w> to the police.",
                            "target_lang_translations": {
                                "zh": "他担心同案犯会向警察<w>告密</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "向当局告发某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "告密",
                                "target_lang_sense_clarification": "非正式，指向警方或当局揭发别人"
                            },
                            {
                                "target_lang_word": "告发",
                                "target_lang_sense_clarification": "指把同伙或他人的违法行为告诉当局"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ac1d8bd-5ca2-38d9-a9bb-bfcb26bf07a7",
                    "sense_definition": "To empty the pile of cards dealt to oneself in the card game Squeak.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>squeak</w> just before her opponent finished their own pile.",
                            "target_lang_translations": {
                                "zh": "她在对手出完自己那摞牌之前，成功<w>先出完了自己的牌</w>。"
                            }
                        },
                        {
                            "text": "You must <w>squeak</w> to end the round successfully.",
                            "target_lang_translations": {
                                "zh": "你必须<w>先出完自己的牌</w>，才能顺利结束这一轮。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在纸牌游戏 Squeak 中，把自己分到的一摞牌先出完。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "先出完自己的牌",
                                "target_lang_sense_clarification": "指在纸牌游戏 Squeak 中先把自己分到的牌出完"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4263262b-d761-3403-9393-9a789c1b440d",
                    "sense_definition": "A short, high-pitched sound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a faint <w>squeak</w> coming from the corner of the attic.",
                            "target_lang_translations": {
                                "zh": "我听到阁楼角落里传来一阵微弱的<w>吱吱声</w>。"
                            }
                        },
                        {
                            "text": "The <w>squeak</w> of the door hinge was very annoying.",
                            "target_lang_translations": {
                                "zh": "门铰链的<w>嘎吱声</w>很烦人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high-pitched squeak"
                    ],
                    "target_lang_definitions": {
                        "zh": "短促而尖细的声音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吱吱声",
                                "target_lang_sense_clarification": "短促而尖细的声音"
                            },
                            {
                                "target_lang_word": "嘎吱声",
                                "target_lang_sense_clarification": "多指门轴、地板等发出的刺耳声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfe82d0c-7a43-3073-9859-df53ad5ba86c",
                    "sense_definition": "A narrow escape from a difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a narrow <w>squeak</w>, but we managed to avoid the accident.",
                            "target_lang_translations": {
                                "zh": "那真是一次惊险的<w>脱险</w>，不过我们还是避免了事故。"
                            }
                        },
                        {
                            "text": "He had a narrow <w>squeak</w> when the police almost caught him.",
                            "target_lang_translations": {
                                "zh": "警察差点抓到他时，他有过一次侥幸的<w>脱险</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrow squeak"
                    ],
                    "target_lang_definitions": {
                        "zh": "险些陷入困境但最终逃过一劫的情况。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "侥幸脱险",
                                "target_lang_sense_clarification": "指差点出事但最后躲过去"
                            },
                            {
                                "target_lang_word": "惊险脱身",
                                "target_lang_sense_clarification": "强调情况十分危险但最终避开了"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6acffdd2-f9a9-3296-8f71-7fa0ae5312c3",
                    "sense_definition": "A card game similar to group solitaire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We played a few rounds of <w>squeak</w> during the rainy afternoon.",
                            "target_lang_translations": {
                                "zh": "在那个下雨的下午，我们玩了几局<w>Squeak纸牌游戏</w>。"
                            }
                        },
                        {
                            "text": "Learning the rules of <w>squeak</w> takes a little bit of practice.",
                            "target_lang_translations": {
                                "zh": "学习<w>Squeak纸牌游戏</w>的规则需要一点练习。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种类似集体接龙纸牌的游戏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "Squeak纸牌游戏",
                                "target_lang_sense_clarification": "一种类似集体接龙纸牌的游戏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a032d313-4f12-350c-8821-ca51318c9c1b",
                    "sense_definition": "The British War Medal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medal",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The veteran proudly displayed his <w>squeak</w> among his other military honors.",
                            "target_lang_translations": {
                                "zh": "那位老兵自豪地在其他军功章中展示了自己的<w>英国战争奖章</w>。"
                            }
                        },
                        {
                            "text": "Collectors often search for the <w>squeak</w> to complete their historical collection.",
                            "target_lang_translations": {
                                "zh": "收藏家常常寻找<w>英国战争奖章</w>来完善他们的历史收藏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Historical military slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "英国战争奖章。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "英国战争奖章",
                                "target_lang_sense_clarification": "英国的一种战争奖章；此处为历史军事俚语称呼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}