                        ]
                    },
                    {
                        "translation_id": "9008396a-ddda-4962-82e1-f9bf301d1bc7",
                        "source_entry_id": "2280d055-7052-3177-9750-70d65bfb7da5",
                        "source_sense_id": "8f728d7f-3127-38cf-94c1-b21978926fc1",
                        "target_lang_word": "Dielektrikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dielektrikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                        "entry_id": "ece3f3fb-c5c9-3270-8f99-09041de93b42",
                                        "glosses": [
                                            "elektrisch schwach- oder nichtleitende Substanz, in der die vorhandenen Ladungsträger nicht frei beweglich sind"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41dbfd60-0f00-4f55-9ae1-ac42d037b180",
                                                "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                                "text": "„Bei kapazitiven Sensoren wirkt die Feuchtigkeit auf das Dielektrikum und ändert so die Kapazität des Sensors, […]“"
                                            },
                                            {
                                                "example_id": "180fa54f-e90e-47ce-89b5-d765aa6a4dc3",
                                                "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                                "text": "„Metallisiert werden Kunststofffolien als Dielektrikum eingesetzt und zu Kondensatoren zusammengerollt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1762c3e0-46ab-4841-80eb-2e2efb324886",
                        "source_entry_id": "2280d055-7052-3177-9750-70d65bfb7da5",
                        "source_sense_id": "8f728d7f-3127-38cf-94c1-b21978926fc1",
                        "target_lang_word": "диэлектрик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "диэлектрик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "599854ab-368d-3bc5-a829-83d76b26ee3d",
                                        "entry_id": "69b689b3-337e-3408-a19f-c325cb4108b6",
                                        "glosses": [
                                            "физ. материал, обладающий малой электропроводностью; изолятор [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0aeda36-12d6-4127-a53d-e89b5c0cd78b",
                                                "sense_id": "599854ab-368d-3bc5-a829-83d76b26ee3d",
                                                "text": "Эффект-то существовал, но использовать его на практике было невозможно: чтобы диэлектрик в диэлектрике как следует раскрутился, нужно подать огромное напряжение — до 100 киловольт и более, при котором у диэлектрика начинают проявляться некоторые свойства проводника."
                                            },
                                            {
                                                "example_id": "98ea8d7c-5a4e-4372-93fe-2993cb269f3f",
                                                "sense_id": "599854ab-368d-3bc5-a829-83d76b26ee3d",
                                                "text": "Не исключено, что удастся получить полимеры с проводниковыми свойствами, и быть может, когда-нибудь токонесущие провода и кабели будут выглядеть так: полимер внутри полимера, причём первый из них — типичный проводник, а второй — наш старый знакомый диэлектрик."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
