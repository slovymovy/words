                        "glosses": [
                            "Féminin singulier de cadet."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "699a0c2a-1d49-4de0-8842-ba4e66339899",
                                "sense_id": "e1fb3db6-12fd-30d9-9fad-223b04bcb83a",
                                "text": "Quand la branche cadette eut marché, précédée du peuple parisien, sur la branche aînée, et se fut assise sur le trône, Maxime réexploita son attachement à Napoléon, de qui il se souciait comme de sa première amourette."
                            }
                        ]
                    }
                ],
