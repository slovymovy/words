                "senses": [
                    {
                        "sense_id": "520cdaf6-44f1-3c3f-87ec-b9cd62e60533",
                        "entry_id": "cd2b13c7-e2ff-3780-9c9c-85e759bb6446",
                        "glosses": [
                            "Teil (Stück) vom Schwanz (besonders vom Rind oder Fisch)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a9aa7f-0bd1-4c6a-8906-f6b214a1ac50",
                                "sense_id": "520cdaf6-44f1-3c3f-87ec-b9cd62e60533",
                                "text": "Das Schwanzstück des Hechts enthält weniger Gräten."
                            },
                            {
                                "example_id": "8fe17a41-f0be-4cf9-aec6-baf0ba179ffb",
                                "sense_id": "520cdaf6-44f1-3c3f-87ec-b9cd62e60533",
                                "text": "Aus dem Schwanzstück des Rindes kann man einen guten Schmorbraten machen."
                            },
                            {
                                "example_id": "da907ed8-8292-4da1-8bf2-c336113f0f3f",
                                "sense_id": "520cdaf6-44f1-3c3f-87ec-b9cd62e60533",
                                "text": "„Beide sind Peitschengeißeln, bestehen also aus einem langen, dicken Teil und einem dagegen abgesetzten dünnen Schwanzstück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
