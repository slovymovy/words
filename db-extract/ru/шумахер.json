                "senses": [
                    {
                        "sense_id": "8f30c1ac-0c26-35bb-88de-fb611b865560",
                        "entry_id": "309cb7ea-070e-3f66-8cbe-45f1ee66d2f5",
                        "glosses": [
                            "разг. ирон. гонщик; тот, кто слишком быстро/медленно едет, высококлассный/считающий себя высококлассным гонщиком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "118540da-22b7-412e-b853-d8683315e181",
                                "sense_id": "8f30c1ac-0c26-35bb-88de-fb611b865560",
                                "text": "Задрали, шумахеры хреновы, ни свою, ни чужую жизнь в грош не ставят."
                            },
                            {
                                "example_id": "91dc6b5c-f355-4ca2-872a-dea0a6522385",
                                "sense_id": "8f30c1ac-0c26-35bb-88de-fb611b865560",
                                "text": "Езжай быстрее, шумахер фигов!"
                            },
                            {
                                "example_id": "7019de4c-96df-4f54-84d0-4db01f13b577",
                                "sense_id": "8f30c1ac-0c26-35bb-88de-fb611b865560",
                                "text": "На словах он шумахер, а на деле — черепахер."
                            }
                        ]
                    }
                ],
                "translations": [],
