                                "target_senses": [
                                    {
                                        "sense_id": "d41db448-c4fa-3ef5-83d3-d3689eafcd1e",
                                        "entry_id": "d2f4b52d-e7a6-3c73-b87b-0b7e165f69db",
                                        "glosses": [
                                            "bylina rodu Anethum"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "085adad1-da77-37f6-9065-fbb2d7fcd2c7",
                                        "entry_id": "d2f4b52d-e7a6-3c73-b87b-0b7e165f69db",
                                        "glosses": [
                                            "koření z kopru (1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b7f051b-bafc-4c41-955b-4dfef9044154",
                                                "sense_id": "085adad1-da77-37f6-9065-fbb2d7fcd2c7",
                                                "text": "Co se týče kopru, ten se u nás dává hlavně do koprovky – a tím je to více méně odbytý. Ale Rusové ho dávají úplně do všeho – a když říkám do všeho, myslím vážně do všeho..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fca4eea-6679-3aa6-8882-c69e316837a7",
                                        "entry_id": "d2f4b52d-e7a6-3c73-b87b-0b7e165f69db",
                                        "glosses": [
                                            "kontrolní projekce"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00819162-99e2-4414-9a4d-7b8699d83feb",
                                                "sense_id": "3fca4eea-6679-3aa6-8882-c69e316837a7",
                                                "text": "Budu se dívat. Ale jinak mám strašně málo seriálů, které jsem viděl. Jedině Bylo nás pět. Já se totiž nemůžu vidět, já nechodím ani na kopr."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
