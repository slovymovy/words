                ],
                "senses": [
                    {
                        "sense_id": "964aed94-5d49-37ff-b6de-7c260b51bb8f",
                        "entry_id": "981a33bf-56aa-3524-a7b1-44fee7901784",
                        "glosses": [
                            "sprachliche Äußerung, die eine bestimmte Intention verfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b89a17e-b661-4d45-9c77-65654f4b3318",
                                "sense_id": "964aed94-5d49-37ff-b6de-7c260b51bb8f",
                                "text": "Mit der Äußerung „Es zieht“ kann man einen Sprechakt der Aufforderung vollziehen, diesen Zustand abzustellen. Sprechakte sind Handlungen."
                            },
                            {
                                "example_id": "45910c5b-e849-4118-8dd9-4fb077c3c992",
                                "sense_id": "964aed94-5d49-37ff-b6de-7c260b51bb8f",
                                "text": "„Unter den vielen Weisen, auf die man sagen kann, daß ein Sprecher mit der Äußerung eines sprachlichen Ausdrucks etwas tut, gibt es zweitens eine privilegierte Handlungsebene, die man den illokutionären Akt - oder einfacher, den Sprechakt nennen könnte.“"
                            },
                            {
                                "example_id": "91ff0316-f617-4f22-bcda-b7a489e8ae9e",
                                "sense_id": "964aed94-5d49-37ff-b6de-7c260b51bb8f",
                                "text": "„Der Sprechakt oder die Sprechakte, die mit der Äußerung eines Satzes vollzogen werden, bilden allgemein eine Funktion der Bedeutung des Satzes.“"
                            },
                            {
                                "example_id": "f8836c63-1bfb-456d-8805-466ca65d11c5",
                                "sense_id": "964aed94-5d49-37ff-b6de-7c260b51bb8f",
                                "text": "„Im Zusammenhang mit der Beschreibung der Bedingungen für Sprechakte wird die Rolle der Sprechaktsituation für das Verstehen der Äußerung besonders hervorgehoben, vor allem bei der Beschreibung indirekter Sprechakte.“"
                            },
                            {
                                "example_id": "7422ff14-a0b2-4372-93b2-03b695145060",
                                "sense_id": "964aed94-5d49-37ff-b6de-7c260b51bb8f",
                                "text": "„Bestimmte lexikalische Einheiten werden in Sprechakten verwendet, die durch eine besondere Sprecherkonstellation charakterisiert sind.“"
                            },
                            {
                                "example_id": "f5eb0dbe-d80b-43df-9473-2fd029fe5ea7",
                                "sense_id": "964aed94-5d49-37ff-b6de-7c260b51bb8f",
                                "text": "„Dieser Witz, sofern man ihn als einen solchen bezeichnen möchte, besteht aus nur einem Sprechakt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
