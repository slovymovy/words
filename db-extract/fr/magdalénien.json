                    {
                        "sense_id": "75d7b5b9-4e2b-35a2-9031-92fd3f0dc125",
                        "entry_id": "a7a1eb8b-9e14-3773-99ea-fef08d418d80",
                        "glosses": [
                            "Relatif à Marie de Magdala."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aaef4b79-7781-3116-a81f-7f80beec4814",
                        "entry_id": "a7a1eb8b-9e14-3773-99ea-fef08d418d80",
                        "glosses": [
                            "Relatif à La Madeleine-sur-Loing, commune de la Seine-et-Marne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aa482eb9-2205-3868-bb67-30567f4908ad",
                        "entry_id": "a7a1eb8b-9e14-3773-99ea-fef08d418d80",
                        "glosses": [
                            "Relatif à la dernière phase du Paléolithique supérieur européen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce97409a-80b6-44c7-b1a1-a831cc985f91",
                                "sense_id": "aa482eb9-2205-3868-bb67-30567f4908ad",
                                "text": "La découverte d’un crâne beaucoup plus récent, de type actuel, trouvé dépourvu de mandibule sur un amas de vestiges magdaléniens, est encore plus probante."
                            },
                            {
                                "example_id": "71100cac-4fed-4952-8974-46bc90107277",
                                "sense_id": "aa482eb9-2205-3868-bb67-30567f4908ad",
                                "text": "Il n’y avait pas fouilleur plus délicat que lui pour dégager les vestiges fugaces et les micro-burins des chasseurs magdaléniens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a83da8e-1dc2-4cda-a1b8-1ad14a964154",
                        "source_entry_id": "a7a1eb8b-9e14-3773-99ea-fef08d418d80",
                        "target_lang_word": "Magdalénien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magdalénien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01864b2c-826d-32b4-810d-e68503326d57",
                                        "entry_id": "e5fe3d83-98e8-3fa8-86b6-cad752b40a2f",
                                        "glosses": [
                                            "eine archäologische Kulturstufe des Menschen von etwa 19.000 bis 12.000 Jahren vor unserer Zeit in Mittel- und Westeuropa"
                                        ],
                                        "tags": [
                                            "Archäologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c16b1a1-3567-4496-b054-d6ea7e6bbd61",
                                                "sense_id": "01864b2c-826d-32b4-810d-e68503326d57",
                                                "text": "„Mit dem Magdalénien begann die große Zeit der Großwildjäger in Europa.“"
                                            },
                                            {
                                                "example_id": "8ffb38ba-c69a-4ad7-b3ac-cb9909a013f6",
                                                "sense_id": "01864b2c-826d-32b4-810d-e68503326d57",
                                                "text": "„Im Magdalénien erfolgte eine explosionsartige Zunahme der Höhlen mit Wandkunst.“"
                                            },
                                            {
                                                "example_id": "aca76244-8340-43c6-9d42-a63902f62b08",
                                                "sense_id": "01864b2c-826d-32b4-810d-e68503326d57",
                                                "text": "„Archäologen rekonstruierten bislang für die Zeit des Magdaléniens in Mitteleuropa ein anderes Szenario […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb7a016a-0195-44fe-9073-2d17fd6ef438",
                        "source_entry_id": "a7a1eb8b-9e14-3773-99ea-fef08d418d80",
                        "target_lang_word": "Magdalenian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magdalenian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef7cd047-529e-3e34-83b7-549617fd65f9",
                                        "entry_id": "6859050a-57ed-3ecb-a53e-d6717824bf3b",
                                        "glosses": [
                                            "Relating to the late Paleolithic culture typical of La Madeleine, c. 17000 to 12000 BCE."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be6292d6-f0bb-4361-a514-37efd6388519",
                                                "sense_id": "ef7cd047-529e-3e34-83b7-549617fd65f9",
                                                "text": "As the Sistine Chapel expresses the flowering of the culture of the Renaissance, so Lascaux expresses the flowering of the culture of the Magdalenians."
                                            },
                                            {
                                                "example_id": "239e32bf-4281-4d52-81bc-7a25db1241f7",
                                                "sense_id": "ef7cd047-529e-3e34-83b7-549617fd65f9",
                                                "text": "The Cave of Lascaux became the world's most celebrated museum of Magdalenian art and as much an icon of the Pleistocene as mammoths and Neanderthals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Magdalenian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cc5189b-531f-393f-8420-b32cd89b3a3f",
                                        "entry_id": "edde28e1-1195-34b6-bca1-1dd383ec5cbc",
                                        "glosses": [
                                            "A person of the Magdalenian culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4937520-45f9-4b4f-bf2d-24a6c0cd0e38",
                                                "sense_id": "1cc5189b-531f-393f-8420-b32cd89b3a3f",
                                                "text": "Whether or not we believe in astrology is irrelevant; the question is, did the Magdalenians?"
                                            },
                                            {
                                                "example_id": "085c8ea5-ed0e-47df-bc58-5b5eefae4695",
                                                "sense_id": "1cc5189b-531f-393f-8420-b32cd89b3a3f",
                                                "text": "The Magdalenians hunted a wide variety of prey, including horses, aurochs and fish, and are known for their highly sophisticated bone artefacts […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "6f09b9c4-df19-3a51-a3c7-3d088d076aba",
                "word": "Magdalénien",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "166c01b4-8300-3c9f-83e3-352a0cfcf10d",
                        "entry_id": "6f09b9c4-df19-3a51-a3c7-3d088d076aba",
                        "glosses": [
                            "Dernière phase du Paléolithique supérieur européen, comprise entre environ 17 000 et 10 000 ans avant le présent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7e9004-ce06-4657-a2f2-ed0ad9961f67",
                                "sense_id": "166c01b4-8300-3c9f-83e3-352a0cfcf10d",
                                "text": "Le paléolithique supérieur débute avec l’aurignacien (industrie d’Aurignac, Haute-Garonne), se continue par le solutréen (industrie de Solutré, Saône-et-Loire}, et s’achève par le Magdalénien (industrie de la Madeleine, Dordogne)."
                            }
                        ]
                    }
                ],
