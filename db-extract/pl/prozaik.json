                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f2a898a9-c49b-414e-a709-2421d39b8c61",
                        "source_entry_id": "81639782-acb1-3c44-9332-5ebd5aeff51b",
                        "source_sense_id": "4758db73-5412-34af-ae5b-9b843b2f3612",
                        "target_lang_word": "prosateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bdcfc23-f00a-3cab-9b81-4ea4c19197a9",
                                        "entry_id": "8937aab6-813b-37b0-8d5c-8204c639dfb0",
                                        "glosses": [
                                            "Auteur qui écrit en prose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a36e8d8-4b80-4e9e-8308-97e29d3990a1",
                                                "sense_id": "6bdcfc23-f00a-3cab-9b81-4ea4c19197a9",
                                                "text": "De tous les poètes de ce temps, trois seulement : Hugo, Théophile Gautier, de Vigny ont pu réunir la double gloire de poète et de prosateur que réunirent aussi Racine et Voltaire, Molière et Rabelais, une des plus rares distinctions de la littérature française et qui doit signaler un poète entre tous."
                                            },
                                            {
                                                "example_id": "b9391d1f-573d-4529-bc10-c3a951bf63fa",
                                                "sense_id": "6bdcfc23-f00a-3cab-9b81-4ea4c19197a9",
                                                "text": "Sans doute, en tant qu’écrivain, elle n’est pas inégalable et parfois la mendicité de son style secouru afflige, mais enfin, étant donné qu’elle vit au XVIIᵉ siècle, elle n’est pas au moins une bredouilleuse de pâles oraisons, ainsi que la plupart des prosateurs pieux de ce temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd41d655-a6ae-462b-ab19-6db329952b6f",
                        "source_entry_id": "81639782-acb1-3c44-9332-5ebd5aeff51b",
                        "source_sense_id": "4758db73-5412-34af-ae5b-9b843b2f3612",
                        "target_lang_word": "prosador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cde2d750-c5bf-4d8b-97a4-8d339a397574",
                        "source_entry_id": "81639782-acb1-3c44-9332-5ebd5aeff51b",
                        "source_sense_id": "4758db73-5412-34af-ae5b-9b843b2f3612",
                        "target_lang_word": "Prosaist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d0b95aa5-7ef2-48fa-bd7d-04dab70c0012",
                        "source_entry_id": "81639782-acb1-3c44-9332-5ebd5aeff51b",
                        "source_sense_id": "4758db73-5412-34af-ae5b-9b843b2f3612",
                        "target_lang_word": "Prosaschriftsteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prosaschriftsteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                        "entry_id": "e2319528-c181-342a-bc30-b7e9a727c971",
                                        "glosses": [
                                            "Schriftsteller, der seine Werke bevorzugt in Prosa verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd29eb0-0ad3-4e73-93d8-ff249482206a",
                                                "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                                "text": "„Pückler ist ein glänzender Beobachter, was ihn zum vorzüglichen Prosaschriftsteller macht.“"
                                            },
                                            {
                                                "example_id": "b38e9966-6a17-4e60-9ee2-d0a3cec1280a",
                                                "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                                "text": "„Im Prinzip gleich zu lesen sind die Kurvenbilder der Philosophen und der Prosaschriftsteller.“"
                                            },
                                            {
                                                "example_id": "ebaf8c61-342e-4c2e-a81d-248eb2ba7c89",
                                                "sense_id": "44f8c6cc-48eb-3b22-9630-ce17440eb9c1",
                                                "text": "„Immer wieder setzte er sich tatkräftig für Dichter, Maler, Bildhauer und Prosaschriftsteller ein, an die er glaubte, und half allen, die in Schwierigkeiten waren, ob er an sie glaubte oder nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
