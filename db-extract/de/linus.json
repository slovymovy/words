                "senses": [
                    {
                        "sense_id": "6a8bed38-24d0-32d6-bcf7-0428f46d8d22",
                        "entry_id": "e78be524-db76-3a6a-a896-ce4c6b3a8201",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a6257d9-35a5-4fde-901f-0d474e2b08ab",
                                "sense_id": "6a8bed38-24d0-32d6-bcf7-0428f46d8d22",
                                "text": "Linus macht in diesem Jahr Urlaub auf Mallorca."
                            },
                            {
                                "example_id": "fa8df83b-0db9-4e47-a3b9-cc9fd96fbbe8",
                                "sense_id": "6a8bed38-24d0-32d6-bcf7-0428f46d8d22",
                                "text": "Linus' Schwester ist nach Ägypten ausgewandert."
                            },
                            {
                                "example_id": "f3128949-2ce6-4096-9ad7-3f921b1fa57b",
                                "sense_id": "6a8bed38-24d0-32d6-bcf7-0428f46d8d22",
                                "text": "„»Ein System von 1000 Bots (automatische Roboter), die ein soziales Netzwerk wie Twitter mit Informationen fluten, kostet mich gerade einmal 30 Euro«, erläutert Linus Neumann vom Chaos Computer Club Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f7d3aec-b995-41f4-9e03-cfe7e366257d",
                        "source_entry_id": "e78be524-db76-3a6a-a896-ce4c6b3a8201",
                        "source_sense_id": "6a8bed38-24d0-32d6-bcf7-0428f46d8d22",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Linus",
