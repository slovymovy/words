                                    {
                                        "sense_id": "29748bb8-77ab-391d-8654-ee5c9d13169d",
                                        "entry_id": "38a3d922-1b31-340a-a4af-08ee8ae7c1fa",
                                        "glosses": [
                                            "An invasive malignant tumour derived from epithelial tissue that tends to metastasize to other areas of the body."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b02ca87e-599c-37a1-933a-055c08e9622e",
                                        "entry_id": "38a3d922-1b31-340a-a4af-08ee8ae7c1fa",
                                        "glosses": [
                                            "A form of cancer; (uncountable) cancer in general as a disease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b951482-80fa-4164-90e9-b65ff5e12115",
                                                "sense_id": "b02ca87e-599c-37a1-933a-055c08e9622e",
                                                "text": "Take the fatteſt and fulleſt Figs you can get, lay them upon the ugly and ill favored tumor called Carcinoma, i. the Canker, ſo it be not yet exulcerat, I aſſure you it is a ſoveraine remedie, and hardly can be matched againe: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a086b3ac-d7c7-4637-a0a3-c12ebcb4c0ad",
                        "source_entry_id": "adc83dbf-4565-3537-b378-b79c841795fb",
                        "source_sense_id": "d3f64b29-ba23-396c-8b34-5952b49e7506",
                        "source_sense_description": "Medizin: Krebserkrankung, die vom Epithel ausgeht",
                        "target_lang_word": "carcinome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carcinome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "957518fd-d4f5-3615-8925-c9b9536c6ca1",
                                        "entry_id": "305ba0e3-bf26-3c2d-a210-e7135870bbed",
                                        "glosses": [
                                            "Variété de cancer qui se développe à partir de l’épithélium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998d5e20-b2d0-4ce4-b6d4-9f5584fb1bfb",
                                                "sense_id": "957518fd-d4f5-3615-8925-c9b9536c6ca1",
                                                "text": "D’autres types de tumeurs oculaires (mélanome, carcinome ou lymphome) peuvent se développer dans la conjonctive, les paupières ou l’orbite."
                                            },
                                            {
                                                "example_id": "7dc77b2e-9a26-4ee5-9b46-17b2c9414e57",
                                                "sense_id": "957518fd-d4f5-3615-8925-c9b9536c6ca1",
                                                "text": "Finalement, l’exposition parvient à être captivante, alors qu’on nous parle d’IRM, de carcinome ou de lymphocytes T."
                                            },
                                            {
                                                "example_id": "b1a531d8-c0aa-48f8-ad22-14df0454877e",
                                                "sense_id": "957518fd-d4f5-3615-8925-c9b9536c6ca1",
                                                "text": "Le cisplastine présente un intérêt majeur dans traitement des carcinomes épidermoïdes, dans les sphères ORL, bronchique, digestive et urinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
