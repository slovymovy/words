                                    },
                                    {
                                        "sense_id": "1ce5676f-ad50-3094-9d12-d55da8b82e24",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "Clarity, transparency, mutual understanding; to be clear."
