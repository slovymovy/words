                            }
                        ]
                    },
                    {
                        "translation_id": "69cad52d-36bf-413a-857e-c641b28f69d5",
                        "source_entry_id": "b4ed1c44-3ded-3248-9eb3-689fd85165de",
                        "source_sense_id": "e4209d38-6e87-35b8-ab30-09237474b55a",
                        "target_lang_word": "hiperbóreo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiperbóreo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "eb84c57d-92da-373c-92a9-358bc8e96c16",
                                        "entry_id": "02af91ba-a110-39e2-91d7-6d9395e4ed17",
                                        "glosses": [
                                            "Extremadamente boreal."
                                        ],
                                        "tags": [
                                            "literary",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb65da7-603b-4638-8054-6f0f37d907de",
                                                "sense_id": "eb84c57d-92da-373c-92a9-358bc8e96c16",
                                                "text": "Los vientos boreales, que también corren y vientan en esta isla y proceden de debajo del polo Ártico que llamamos norte, y según Sant Isidro en el libro xiii, capítulo 11 y libro xiv, capítulo 8º, proceden de aquellos montes hiperbóreos que dejimos en el capítulo precedente."
                                            },
                                            {
                                                "example_id": "30945342-ba43-4f31-900b-b246f39719f2",
                                                "sense_id": "eb84c57d-92da-373c-92a9-358bc8e96c16",
                                                "text": "¡y allí donde los hielos dejan en reposo su superficie, así en el mar de las aguas, como en el océano de las humanas generaciones, esa quietud es la calma, es la muelle, es el frío, es el invierno polar, es la desolación hiperbórea y la noche eterna!"
                                            },
                                            {
                                                "example_id": "e84d9b27-8540-4bf8-a7e3-5189f8e1b3c9",
                                                "sense_id": "eb84c57d-92da-373c-92a9-358bc8e96c16",
                                                "text": "Fuerza es confesar que estos hiperbóreos saben vivir. Van á Italia y no sólo se traen sus artes á Rusia, sino hasta su clima y las producciones de su clima, que meten en sus palacios como por encanto."
                                            },
                                            {
                                                "example_id": "20195aeb-b3b7-4644-b737-db039507ac20",
                                                "sense_id": "eb84c57d-92da-373c-92a9-358bc8e96c16",
                                                "text": "El mundo germánico, desde las tierras hiperbóreas hasta las vecinas al Mediterráneo pobladas por visigodos, ostrogodos y lombardos, desde las estepas del este de Europa a las islas del Atlántico, vive dominado por la creencia en hechicerías y atemorizados por ellas en la época de sus grandes movimientos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db8cfef7-8693-4813-941a-ae4e9b7a3a92",
                        "source_entry_id": "b4ed1c44-3ded-3248-9eb3-689fd85165de",
