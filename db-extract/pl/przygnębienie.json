                        ],
                        "examples": [
                            {
                                "example_id": "de43b857-b6c8-4856-8975-ecf1df89375a",
                                "sense_id": "0384e889-c285-3320-b69e-899ec0772dbf",
                                "text": "Czy przygnębienie prowadzi do depresji, czy jest jej objawem?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4a446b5e-205c-3523-93be-cbc5dbdee88a",
