                        "glosses": [
                            "Zusammenballung von Nebel, die optisch wie eine Wand wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d27d54-9e37-4c00-ad6b-219dbc66057e",
                                "sense_id": "e6a91265-e89a-3ea2-bc8d-ee7a1580dda1",
                                "text": "„Am Morgen kroch Nebel aus den Wäldern und hinderte die Sonne am Aufgehen, sie marschierten in eine Nebelwand, ungewiss das Ziel, ungewiss das Ende.“"
                            },
                            {
                                "example_id": "f11cc3e2-c2a8-4dea-ba01-2a92ad68422c",
                                "sense_id": "e6a91265-e89a-3ea2-bc8d-ee7a1580dda1",
                                "text": "„Oft habe sie dort, die Nebelwand vor sich, fröstelnd im Wind gestanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
