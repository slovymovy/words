                "senses": [
                    {
                        "sense_id": "371e270a-40f4-36a9-878e-8188cfcabbea",
                        "entry_id": "fb37d068-1517-3455-8e6d-43518940273f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным кость"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0d15bbc1-72db-35fb-8337-0c94fe9e6c68",
                        "entry_id": "fb37d068-1517-3455-8e6d-43518940273f",
                        "glosses": [
                            "свойственный кости, содержащийся в кости, костях и т. п."
                        ],
                        "tags": [],
