                "senses": [
                    {
                        "sense_id": "8022dcda-7fb5-39cc-b1a6-b9f7b7fdf790",
                        "entry_id": "07ac58b6-b206-3be3-8199-56b63ea556e2",
                        "glosses": [
                            "Rendre parfait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b31958a7-c1f1-49bf-a5e7-0a95546a6a55",
                                "sense_id": "8022dcda-7fb5-39cc-b1a6-b9f7b7fdf790",
                                "text": "De plus, elle a tendance à vouloir «parfaitiser» à son image tout son entourage."
                            },
                            {
                                "example_id": "5c6cae1b-2cb6-45f9-85ae-95eb7b87d631",
                                "sense_id": "8022dcda-7fb5-39cc-b1a6-b9f7b7fdf790",
                                "text": "La seule façon de se « parfaitiser » (terme indiquant que l’on monte d’un niveau dans la société) est soit de provoquer une élection pour proposer sa candidature."
                            },
                            {
                                "example_id": "b110e5d6-4cd6-44f5-a494-15b3549d6bdb",
                                "sense_id": "8022dcda-7fb5-39cc-b1a6-b9f7b7fdf790",
                                "text": "Les filles ont raison, essaie de parfaitiser au mieux quand tu peux."
                            }
                        ]
                    }
