                "senses": [
                    {
                        "sense_id": "a5521ed3-d069-31e9-9f54-1407c0f56671",
                        "entry_id": "a42f08bb-c6c0-3ccd-8cc9-3c1543e40d76",
                        "glosses": [
                            "a plural form that indicates different sorts, kinds, types, usually of a mass noun"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "19a058d5-aa99-450a-9860-7749c6b608b6",
                                "sense_id": "a5521ed3-d069-31e9-9f54-1407c0f56671",
                                "text": "Sage ich „Öle“ und meine „Ölsorten“, so ist das ein Sortenplural.",
                                "translation": "When I say “oils” to mean “types of oil”, that’s a plural of types.",
                                "english": "When I say “oils” to mean “types of oil”, that’s a plural of types."
                            },
                            {
                                "example_id": "0cca292e-6176-4d85-b5cc-de19530f474c",
                                "sense_id": "a5521ed3-d069-31e9-9f54-1407c0f56671",
                                "text": "„Zwei Biere“ ist ein Sortenplural. Ansonsten sagt man „zwei Bier“.",
                                "translation": "“Zwei Biere” [two kinds of beer] is a plural of types. Otherwise you say “zwei Bier” [two servings of beer].",
                                "english": "“Zwei Biere” [two kinds of beer] is a plural of types. Otherwise you say “zwei Bier” [two servings of beer]."
                            }
                        ]
                    }
                ],
