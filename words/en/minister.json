{
    "word_family": [
        "ministry",
        "ministerial",
        "ministration",
        "ministrant",
        "administration",
        "administrator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9df6c811-0abe-3689-b059-0f8287f7250a",
                    "sense_definition": "A high-ranking politician who heads a government department or ministry.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime <w>minister</w> addressed the nation about the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Премьер-<w>министр</w> обратился к нации по поводу экономического кризиса.",
                                "zh": "总理就经济危机向全国发表了讲话。"
                            }
                        },
                        {
                            "text": "She was appointed as the <w>minister</w> of education last month.",
                            "target_lang_translations": {
                                "ru": "В прошлом месяце она была назначена <w>министром</w> образования.",
                                "zh": "她上个月被任命为教育<w>部长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "government minister"
                    ],
                    "common_phrases": [
                        "prime minister",
                        "foreign minister",
                        "cabinet minister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Политик высокого ранга, возглавляющий правительственное ведомство или министерство.",
                        "zh": "政府部门或部委的负责人，通常是高级政治家。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "министр",
                                "target_lang_sense_clarification": "член правительства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部长",
                                "target_lang_sense_clarification": "政府部门负责人"
                            },
                            {
                                "target_lang_word": "大臣",
                                "target_lang_sense_clarification": "君主制国家或古代政府的高级官员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b1554d4-d25c-315e-893f-09cfb7639804",
                    "sense_definition": "A person authorized to conduct religious worship, perform ceremonies, and provide spiritual care, especially in Protestant churches.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>minister</w> delivered an inspiring sermon to the congregation.",
                            "target_lang_translations": {
                                "ru": "<w>Священник</w> произнес вдохновляющую проповедь перед прихожанами.",
                                "zh": "<w>牧师</w>向会众发表了一篇鼓舞人心的布道。"
                            }
                        },
                        {
                            "text": "They asked their local <w>minister</w> to officiate at the wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Они попросили местного <w>священника</w> провести свадебную церемонию.",
                                "zh": "他们请当地的<w>牧师</w>主持婚礼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ordained minister",
                        "church minister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, уполномоченное проводить религиозные богослужения и обряды, особенно в протестантских церквях.",
                        "zh": "获准主持宗教仪式、进行礼拜并提供精神关怀的人，常见于新教教会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "священник",
                                "target_lang_sense_clarification": "священнослужитель"
                            },
                            {
                                "target_lang_word": "пастор",
                                "target_lang_sense_clarification": "в протестантской церкви"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牧师",
                                "target_lang_sense_clarification": "新教教会的宗教领袖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "052b1b4c-7fca-32f4-bf9f-871be582ef2c",
                    "sense_definition": "A diplomat with a rank lower than an ambassador but higher than a chargé d'affaires.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatic_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served as a <w>minister</w> at the embassy before being promoted to ambassador.",
                            "target_lang_translations": {
                                "ru": "Он служил <w>посланником</w> в посольстве до повышения до посла.",
                                "zh": "在升任大使之前，他曾在使馆担任<w>公使</w>。"
                            }
                        },
                        {
                            "text": "The foreign <w>minister</w> plenipotentiary signed the treaty on behalf of his government.",
                            "target_lang_translations": {
                                "ru": "Полномочный <w>посланник</w> подписал договор от имени своего правительства.",
                                "zh": "全权<w>公使</w>代表其政府签署了条约。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "minister plenipotentiary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дипломатический представитель рангом ниже посла, но выше поверенного в делах.",
                        "zh": "外交官，级别低于大使，高于代办。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посланник",
                                "target_lang_sense_clarification": "дипломатический ранг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公使",
                                "target_lang_sense_clarification": "外交代表级别"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd3ec65-518d-3c73-ba4a-92def306178b",
                    "sense_definition": "A servant, subordinate, or agent acting on behalf of a superior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sent his trusted <w>minister</w> to deliver the secret message.",
                            "target_lang_translations": {
                                "ru": "Король послал своего доверенного <w>слугу</w> доставить тайное послание.",
                                "zh": "国王派他信任的<w>随从</w>去传递秘密信息。"
                            }
                        },
                        {
                            "text": "He acted as a faithful <w>minister</w> of his master's will.",
                            "target_lang_translations": {
                                "ru": "Он действовал как верный <w>исполнитель</w> воли своего господина.",
                                "zh": "他作为主人意志的忠实<w>代理人</w>行事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слуга, подчиненный или агент, действующий от имени начальника.",
                        "zh": "代表上级行事的仆人、下属或代理人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнитель",
                                "target_lang_sense_clarification": "агент воли"
                            },
                            {
                                "target_lang_word": "слуга",
                                "target_lang_sense_clarification": "подчиненный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随从",
                                "target_lang_sense_clarification": "侍奉者"
                            },
                            {
                                "target_lang_word": "代理人",
                                "target_lang_sense_clarification": "受命行事者"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8730f58-3eb8-35bd-8501-ffd36f836823",
                    "sense_definition": "To attend to the needs of someone; to provide help, care, or service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nurses worked tirelessly to <w>minister</w> to the sick and injured.",
                            "target_lang_translations": {
                                "ru": "Медсестры неустанно работали, чтобы <w>ухаживать</w> за больными и ранеными.",
                                "zh": "护士们不知疲倦地<w>照料</w>着病人和伤员。"
                            }
                        },
                        {
                            "text": "He felt a calling to <w>minister</w> to the needs of the poor in his city.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал призвание <w>служить</w> нуждам бедных в своем городе.",
                                "zh": "他感到一种使命感，要去<w>服务</w>城市中贫困者的需求。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "minister to the sick",
                        "minister to needs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заботиться о чьих-либо нуждах; оказывать помощь, уход или услуги.",
                        "zh": "照顾某人的需求；提供帮助、护理或服务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухаживать",
                                "target_lang_sense_clarification": "заботиться о больных"
                            },
                            {
                                "target_lang_word": "помогать",
                                "target_lang_sense_clarification": "оказывать помощь"
                            },
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "быть полезным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "照料",
                                "target_lang_sense_clarification": "照顾病患"
                            },
                            {
                                "target_lang_word": "服务",
                                "target_lang_sense_clarification": "提供帮助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e1cd91e-7b89-37fb-9a09-e39e6de979cf",
                    "sense_definition": "To perform the duties of a clergy member, such as leading worship or performing sacraments.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was licensed to <w>minister</w> in the local parish after completing her studies.",
                            "target_lang_translations": {
                                "ru": "Она получила разрешение <w>служить</w> в местном приходе после завершения учебы.",
                                "zh": "她在完成学业后获得了在当地教区<w>传道</w>的许可。"
                            }
                        },
                        {
                            "text": "The priest continues to <w>minister</w> to his flock despite his advanced age.",
                            "target_lang_translations": {
                                "ru": "Священник продолжает <w>служить</w> своей пастве, несмотря на преклонный возраст.",
                                "zh": "尽管年事已高，这位神职人员仍继续为他的信众<w>主持</w>仪式。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять обязанности священнослужителя, такие как ведение богослужения или совершение таинств.",
                        "zh": "履行神职人员的职责，如主持礼拜或举行圣礼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "совершать богослужения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主持",
                                "target_lang_sense_clarification": "主持宗教仪式"
                            },
                            {
                                "target_lang_word": "传道",
                                "target_lang_sense_clarification": "履行牧师职责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "404dfa14-e074-33e7-964f-e091081ffac5",
                    "sense_definition": "To furnish, supply, or provide something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fertile valley did <w>minister</w> food for all the inhabitants.",
                            "target_lang_translations": {
                                "ru": "Плодородная долина <w>давала</w> пищу всем жителям.",
                                "zh": "肥沃的山谷为所有居民<w>提供</w>了食物。"
                            }
                        },
                        {
                            "text": "This event will <w>minister</w> occasion for much debate among the scholars.",
                            "target_lang_translations": {
                                "ru": "Это событие <w>даст</w> повод для долгих споров среди ученых.",
                                "zh": "这次活动将为学者们之间的激烈辩论<w>提供</w>契机。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать, предоставлять или обеспечивать что-либо.",
                        "zh": "提供、供应或供给某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "предоставлять"
                            },
                            {
                                "target_lang_word": "доставлять",
                                "target_lang_sense_clarification": "снабжать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提供",
                                "target_lang_sense_clarification": "供给"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}