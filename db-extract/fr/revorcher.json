                "senses": [
                    {
                        "sense_id": "c17f0db9-61fb-3d9d-a765-8abd7ba09579",
                        "entry_id": "29140e1c-b161-3d0a-848e-df1755ff708f",
                        "glosses": [
                            "Retourner, fouir."
                        ],
                        "tags": [
                            "Bourgogne"
                        ],
                        "examples": [
                            {
                                "example_id": "1c59caba-4ba0-48d4-adad-f40f7aa81d30",
                                "sense_id": "c17f0db9-61fb-3d9d-a765-8abd7ba09579",
                                "text": "Comme j’allais à l’école le lendemain, le Vieux me ramenait au village, mais je savais que le lendemain, il resterait coucher chez l’Ernest et avec lui irait à l’affût an sanglier, car j’avais entendu le fermier dire : « Y en a une bande qui vient revorcher mon sombre, faudra qu’on aille voir ça ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "09b18b60-3e90-3af0-8f52-8c89a4bf1d9b",
                        "entry_id": "29140e1c-b161-3d0a-848e-df1755ff708f",
                        "glosses": [
                            "Chavirer les sentiments."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d2028c12-5d86-4658-aa3f-e0abe7f76b9a",
                                "sense_id": "09b18b60-3e90-3af0-8f52-8c89a4bf1d9b",
                                "text": "Il ne fallait pas dire : « J’en suis revorché », mais : « J’en suis bouleversé », non pas « les salades trésissent », mais « les salades commencent à sortir de terre »."
                            }
                        ]
                    }
