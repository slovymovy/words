                                "target_senses": [
                                    {
                                        "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Having a secondary, supplementary or subordinate function by accompanying as a subordinate; aiding in a secondary way; being additional; contributing or being contributory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1f839e-e925-4c86-b950-eb7273dfb4e2",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "accessory garments"
                                            },
                                            {
                                                "example_id": "dab61d60-8305-43a7-b73c-dce172ea510b",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "Surprise parties succeed with the help of accessory neighbors or colleagues."
                                            },
                                            {
                                                "example_id": "0d35c4b1-30c9-4ded-a242-fe7ee3408cb8",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "Amongst many secondary, and accessory causes that support Monarchy, these are not of least reckning, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21ef40c6-9c50-31f5-9e59-9b6f9a3e0ea1",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Assisting a crime without actually participating in committing the crime itself; being connected as an incident or subordinate to a principal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d696f1-8780-4309-a54a-3f9c7aed4de0",
                                                "sense_id": "21ef40c6-9c50-31f5-9e59-9b6f9a3e0ea1",
                                                "text": "Her actions were clearly accessory because they helped him commit and probably also conceal the crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30dd0a98-f3bb-3a40-8c19-7c51dc73e202",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Present in a minor amount, and not essential."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c5781af-adb8-46f5-a7a6-16ee6e0ee9b2",
                                                "sense_id": "30dd0a98-f3bb-3a40-8c19-7c51dc73e202",
                                                "text": "accessory mineral"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accessory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "Something that belongs to part of another main thing; something additional and subordinate, an attachment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698af3dc-9d57-4e3e-a920-3adcf937f3c8",
                                                "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                                "text": "the accessories of a mobile phone"
                                            },
                                            {
                                                "example_id": "ba125a51-b0e4-4586-b69c-c922b241eb75",
                                                "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                                "text": "the aspect and accessories of a den of banditti"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "658bb524-9276-3bf5-a260-eaccc5e701a2",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "An article that completes one's basic outfit, such as a scarf or gloves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b902d524-a6d8-446a-921f-aebd95425b1e",
                                                "sense_id": "658bb524-9276-3bf5-a260-eaccc5e701a2",
                                                "text": "One of the first of a wave of American women contemporary designers who emerged in the 1990s, she [Kate Spade] built a brand on the appeal of clothes and accessories that made shoppers smile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "A person who is not present at a crime, but contributes to it as an assistant or instigator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ec0155-db11-46d7-bc71-61d212d30454",
                                                "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                                "text": "She was an accessory to the murder because she helped him commit and probably also conceal the crime."
                                            },
                                            {
                                                "example_id": "15044880-7a6f-495e-ba17-e3f6e3a66009",
                                                "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                                "text": "“You can be an accessory before the fact, or an accessory after the fact. It doesnʼt matter if itʼs before or after; either way youʼd be in for it.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc1751cc-c7e2-35d4-9104-1ade255b7699",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "Something in a work of art without being indispensably necessary, for example solely ornamental parts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddd28b36-9766-461a-b378-8df9d27f3fb1",
                        "source_entry_id": "7cb60ac6-6479-36c1-8546-0ee5d3793a72",
                        "source_sense_id": "29282149-afd1-3f3e-a506-c30db12bc129",
                        "source_sense_description": "een attribuut dat als aanvulling dient",
                        "target_lang_word": "accessoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accessoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f121fd92-8abc-3544-bf3e-4707daa7dd17",
                                        "entry_id": "f3ec8fd5-79eb-39b6-a16a-ea7b9888a4ef",
                                        "glosses": [
                                            "Dépendant de quelque chose de principal, annexe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6b281e-c2b2-4575-b15f-e8017ec4d5cb",
                                                "sense_id": "f121fd92-8abc-3544-bf3e-4707daa7dd17",
                                                "text": "La papille accessoire, ou petite caroncule, est située 1 à 2 cm au-dessus et en avant de la papille principale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91c09b58-6d35-3528-b8c2-0b9ac7e33fbe",
                                        "entry_id": "f3ec8fd5-79eb-39b6-a16a-ea7b9888a4ef",
                                        "glosses": [
                                            "Dépendant de quelque chose de principal, annexe.",
                                            "Qualifie certains nerfs ou muscles dont l’action fortifie ou corrige celle d’autres nerfs ou muscles qu’ils accompagnent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d2c9977-898c-4608-84e1-2b3ec014bb37",
                                                "sense_id": "91c09b58-6d35-3528-b8c2-0b9ac7e33fbe",
                                                "text": "Le nerf accessoire assure la mobilité de la tête et de l'épaule et il innerve les muscles du larynx."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34fd23d-937a-3ba8-b877-1c4c7b3fb342",
                                        "entry_id": "f3ec8fd5-79eb-39b6-a16a-ea7b9888a4ef",
                                        "glosses": [
                                            "Dépendant de quelque chose de principal, annexe.",
                                            "Secondaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8dfa34-9ddc-4f34-8d38-4ea439abd9f7",
                                                "sense_id": "f34fd23d-937a-3ba8-b877-1c4c7b3fb342",
                                                "text": "Et même, moins la cave était confortable, plus elle respectait les usages locaux. […]. L'aménagement et la décoration étaient accessoires; le contenu prévalant sur le contenant : tant et aussi longtemps qu'on y pichait à l'envi, l'endroit pouvait bien être sombre, humide, froid, glauque ou bien kitsch que cela n'y changeait rien."
                                            },
                                            {
                                                "example_id": "99526ee3-a058-4757-abe2-ba0098558e87",
                                                "sense_id": "f34fd23d-937a-3ba8-b877-1c4c7b3fb342",
                                                "text": "Dans les voies des gares et stations on distingue les voies principales…, et les voies accessoires qui servent aux garages, aux manœuvres, aux opérations de chargement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3899ccaa-d6ed-331d-8b09-fdd0443efac9",
                                        "entry_id": "f3ec8fd5-79eb-39b6-a16a-ea7b9888a4ef",
                                        "glosses": [
                                            "Dépendant de quelque chose de principal, annexe.",
                                            "Subsidiaire, additionnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaffc4a4-b6e6-44bb-8ae1-ff56ff650758",
                                                "sense_id": "3899ccaa-d6ed-331d-8b09-fdd0443efac9",
                                                "text": "La première classification […] consiste à diviser les peines en peines principales, accessoires, complémentaires. Les peines principales constituent les sanctions essentielles de l'infraction ; elles n'ont pas besoin de s'appuyer sur une autre peine. Les peines accessoires, au contraire, sont, comme leur nom l'indique l'accessoire d'une autre peine […]. Par cela seul que le juge a prononcé la peine principale à laquelle le législateur les a attachées, elles s'appliquent automatiquement, de plein droit, par la force de la loi, sans avoir besoin d'être prononcées, spécialement par les juges, qui ne peuvent par ailleurs les écarter. Les peines complémentaires, tout comme les peines accessoires, font suite à une peine principale […] mais doivent être prononcées expressément par les juges."
                                            },
                                            {
                                                "example_id": "bc3ad516-4cac-4b31-a251-0b66d666d273",
                                                "sense_id": "3899ccaa-d6ed-331d-8b09-fdd0443efac9",
                                                "text": "Les obligations accessoires cessent lorsque l’obligation principale est acquittée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02da494-f936-3612-96bb-d1201c317f15",
                                        "entry_id": "f3ec8fd5-79eb-39b6-a16a-ea7b9888a4ef",
                                        "glosses": [
                                            "Dépendant de quelque chose de principal, annexe.",
                                            "Supplémentaire, qui vient en renfort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0134e2f7-aff5-4e8c-b40a-15de8ed87208",
                                                "sense_id": "f02da494-f936-3612-96bb-d1201c317f15",
                                                "text": "Défenses accessoires, obstacles artificiels placés sur les abords d'un ouvrage de fortification, pour contraindre les assaillants à s'arrêter sous le feu des défenseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50de5829-9d24-3d3a-98fb-2b27cb7d411d",
                                        "entry_id": "f3ec8fd5-79eb-39b6-a16a-ea7b9888a4ef",
                                        "glosses": [
                                            "Ajouté mais inutile, marginal, superflu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6250bfd4-c1cd-4e11-a5b1-a9dce94bf576",
                                                "sense_id": "50de5829-9d24-3d3a-98fb-2b27cb7d411d",
                                                "text": "La bordure dorée et ondulante est un élément décoratif accessoire de l'étiquette et ne peut par conséquent faire l'objet d'une protection légale."
                                            },
                                            {
                                                "example_id": "11472979-13d6-4f0c-9608-d73d7abc225f",
                                                "sense_id": "50de5829-9d24-3d3a-98fb-2b27cb7d411d",
                                                "text": "Il est indispensable de se concentrer sur les plus petites choses, même sur celles qui paraissent totalement accessoires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accessoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c90f706-68da-3c8a-be88-35fe6b0696a9",
                                        "entry_id": "e8939690-f201-33f3-8d45-1b6cd3a5dc88",
                                        "glosses": [
                                            "Ce qui suit ou accompagne le principal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0ed2923-7133-438a-ae84-ae4f5eabfe40",
                                                "sense_id": "2c90f706-68da-3c8a-be88-35fe6b0696a9",
                                                "text": "Principal, (Jurisprud.) se dit de ce qui est le plus important & le plus considérable d’entre plusieurs personnes ou entre plusieurs choses. On distingue le principal de ce qui est accessoire. Ce principal peut être sans les accessoires ; mais les accessoires ne peuvent être sans le principal ; par exemple, dans un héritage le fond est le principal, les fruits sont l’accessoire."
                                            },
                                            {
                                                "example_id": "60ac02ec-b025-4b1e-94f8-49eafb0c9375",
                                                "sense_id": "2c90f706-68da-3c8a-be88-35fe6b0696a9",
                                                "text": "Le nom se compose tout d'abord du nom de famille, ensuite du prénom et, enfin, de ce que l'on appelle les accessoires du nom, pseudonyme, surnom et titres nobiliaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6abdd3d5-63dc-346c-8643-cbe7baeaed89",
                                        "entry_id": "e8939690-f201-33f3-8d45-1b6cd3a5dc88",
                                        "glosses": [
                                            "Partie qui n’est pas essentielles à la composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7327dc75-a02d-444e-8958-52dfaefb1ee5",
                                                "sense_id": "6abdd3d5-63dc-346c-8643-cbe7baeaed89",
                                                "text": "Les accessoires, dans ce tableau, sont parfaitement traités."
                                            },
                                            {
                                                "example_id": "41221860-6d04-4293-b7bf-36b70c32e9e5",
                                                "sense_id": "6abdd3d5-63dc-346c-8643-cbe7baeaed89",
                                                "text": "Cet accessoire nuit à l’effet du tableau."
                                            },
                                            {
                                                "example_id": "96f18b7f-281c-487a-af70-1e1e06f0f995",
                                                "sense_id": "6abdd3d5-63dc-346c-8643-cbe7baeaed89",
                                                "text": "Les costumes, les décors sont des accessoires dans un ouvrage dramatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f009330-77e8-32f0-981a-90f84ebc3b34",
                                        "entry_id": "e8939690-f201-33f3-8d45-1b6cd3a5dc88",
                                        "glosses": [
                                            "Objet qui peut être nécessaires à la représentation, tels que lettre, bourse d’argent, écritoire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d422edcf-95fe-44a6-8f98-6325098f6b6b",
                                                "sense_id": "0f009330-77e8-32f0-981a-90f84ebc3b34",
                                                "text": "Un accessoire efficace est la « boite à meuh », actionnée dès qu'une discussion sort du cadre de la réunion. On peut aussi utiliser le coucou pour signaler la fin du temps de parole."
                                            },
                                            {
                                                "example_id": "5987c62e-8b0b-46f1-820f-1eb7d5d727b5",
                                                "sense_id": "0f009330-77e8-32f0-981a-90f84ebc3b34",
                                                "text": "Le garçon de théâtre a oublié d’apporter les accessoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95979445-7d16-30e9-956b-b5d0d3aa69ee",
                                        "entry_id": "e8939690-f201-33f3-8d45-1b6cd3a5dc88",
                                        "glosses": [
                                            "Pièce complémentaire qui rentre dans l’utilisation ou l’amélioration d’un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef293a9b-2d43-4ae0-b537-fa3503214329",
                                                "sense_id": "95979445-7d16-30e9-956b-b5d0d3aa69ee",
                                                "text": "Je revenais dans l’auto des estafettes, portant des piles et d’autres accessoires lorsque nous offrîmes une place à une sorte d’ambulancier."
                                            },
                                            {
                                                "example_id": "4c86fe65-5d6a-4cf6-b64a-1a41509ba726",
                                                "sense_id": "95979445-7d16-30e9-956b-b5d0d3aa69ee",
                                                "text": "Il découvrit les installations et les accessoires d'un endroit où l'on pratiquait le SM. Il y avait là toutes sortes de portiques pour attacher dans toutes les positions, des cages que Louis XI n'eût pas reniées pour y condamner l'un de ses opposants; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
