    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2922374-4268-32bd-bce1-bc8bd093cf0b",
                    "sense_definition": "A distinctive visual symbol, such as a badge, logo, or crest, representing an idea, organization, or nation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medical trucks were emblazoned with the <w>emblem</w> of the Red Cross."
                        },
                        {
                            "text": "A golden eagle served as the imperial <w>emblem</w> of the dynasty."
                        }
                    ],
                    "synonyms": [
                        "symbol",
                        "token",
                        "ensign"
                    ],
                    "common_phrases": [
                        "national emblem",
                        "official emblem"
                    ]
                },
                {
                    "sense_id": "846a1ac2-73b5-3971-80f9-4eed6c4efc93",
                    "sense_definition": "A person, object, or situation that serves as a typical representation of a larger condition, movement, or whole.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The decaying factory became an <w>emblem</w> of the city's severe industrial decline."
                        },
                        {
                            "text": "She was widely seen as an <w>emblem</w> of hope for the entire generation."
                        }
                    ],
                    "synonyms": [
                        "symbol",
                        "token"
                    ],
                    "common_phrases": [
                        "an emblem of hope"
                    ]
                },
                {
                    "sense_id": "7765ae57-5e9f-3ba0-ad2b-19576d823db2",
                    "sense_definition": "An allegorical picture typically accompanied by a motto and explanatory verse, popular in the Renaissance as a moral lesson.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar wrote a thesis analyzing seventeenth-century Renaissance <w>emblem</w> books."
                        },
                        {
                            "text": "Each illustrated <w>emblem</w> in the volume was intended to teach a specific moral lesson."
                        }
                    ],
                    "common_phrases": [
                        "emblem book"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
