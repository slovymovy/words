                "word": "désexploser",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f74e231-dd39-3a26-9b5a-550dd652e3f6",
                        "entry_id": "c094535a-d030-3624-a08d-86a12e8103b1",
                        "glosses": [
                            "Revenir à l’état antérieur à une explosion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8963116d-f211-41cc-ac1f-e8356ad5d23c",
                                "sense_id": "6f74e231-dd39-3a26-9b5a-550dd652e3f6",
                                "text": "Une maison sur pilotis en train de s’embraser. Ou plutôt non, le défilement des images est inversé, le temps se met à reculer, la maison brûle mais le nuage de fumée retourne à sa source, et la maison « désexplose », en quelque sorte."
                            },
                            {
                                "example_id": "8853ec1d-4433-47fb-a522-c6333e8aae07",
                                "sense_id": "6f74e231-dd39-3a26-9b5a-550dd652e3f6",
                                "text": "Les immeubles explosent donc, puis désexplosent pour mieux réexploser."
                            },
                            {
                                "example_id": "c06d7362-c724-40a2-8b02-358dd2ad1bd7",
                                "sense_id": "6f74e231-dd39-3a26-9b5a-550dd652e3f6",
                                "text": "Si nous faisons toutes les « désexplosions », la boucle verte désexplose en un millier de boucles vertes dans la boîte des unités."
                            },
                            {
                                "example_id": "b4f7be34-e615-4e47-82a1-f3fd95df3e4c",
                                "sense_id": "6f74e231-dd39-3a26-9b5a-550dd652e3f6",
                                "text": "On ne peut pas faire désexploser le pétrole."
                            },
                            {
                                "example_id": "016af07e-b894-489b-bad6-2469ea7a5416",
                                "sense_id": "6f74e231-dd39-3a26-9b5a-550dd652e3f6",
                                "text": "Sur des patients maniaco-dépressifs comme ça c'est quand même intéressant de recentrer, de désexploser le truc quoi."
                            }
                        ]
                    }
                ],
