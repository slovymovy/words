                        "entry_id": "9efcae76-9de4-39fd-b74e-3b541430ed23",
                        "glosses": [
                            "A syenitic rock consisting of microperthite, arfvedsonite, aegirine and, possibly, nepheline."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "37b6c2e1-41f8-4786-90ff-497b2319afcc",
                                "sense_id": "3e7a22b9-28ef-3374-86a7-5b9e47eea653",
                                "text": "There Strauss & Truter record a gradual transition from the white umptekite (fenite) to a pulaskitic rock with nepheline."
                            },
                            {
                                "example_id": "e96d7c02-b727-4073-968b-8b06747e0ee0",
                                "sense_id": "3e7a22b9-28ef-3374-86a7-5b9e47eea653",
                                "text": "The rock-mass in which this umptekite form of hornblende occurs may therefore be called umptekite gabbro."
                            },
                            {
                                "example_id": "b58078d8-f705-4b96-a310-bdbef9fc3696",
                                "sense_id": "3e7a22b9-28ef-3374-86a7-5b9e47eea653",
                                "text": "The Beverly syenite includes the alkaline syenites of Beverly, Manchester, Salem, and Marblehead, comprising pulaskites and umptekites."
                            }
                        ]
                    }
