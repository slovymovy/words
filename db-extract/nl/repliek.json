                                "target_senses": [
                                    {
                                        "sense_id": "9fde5f8e-ba7d-32ca-ba3a-56499b3c5808",
                                        "entry_id": "0418884a-61b3-3649-9711-c364494f2c4a",
                                        "glosses": [
                                            "schnell ausgeführter Gegenangriff der in die Defensive geratenen Mannschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffc3ff1-be1a-46ee-b6b2-9b87e4dfc063",
                                                "sense_id": "9fde5f8e-ba7d-32ca-ba3a-56499b3c5808",
                                                "text": "Die Mannschaft überrascht in dieser Saison ihre Gegner immer wieder mit ihren schnellen Kontern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eed8005c-a0bf-35ca-86ce-ee513b6a0e5b",
                                        "entry_id": "0418884a-61b3-3649-9711-c364494f2c4a",
                                        "glosses": [
                                            "rasche entgegnende Antwort in einer Diskussion"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d5dcb32-e493-4b69-88ef-8e353e276f9c",
                        "source_entry_id": "57e0f401-ab3a-37d8-bba4-eb3af31351bf",
                        "source_sense_id": "5f12f72c-30fd-3520-9865-65254ae18431",
                        "target_lang_word": "repartee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repartee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                        "entry_id": "4ea5b384-95fe-32b9-a147-fe54c19a13c2",
                                        "glosses": [
                                            "A swift, witty reply, especially one that is amusing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe5410c0-fdb6-4833-883e-c57d93c63090",
                                                "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                                "text": "Many persons must laugh when a great person or an acknowledged wit says a clever thing, such as a smart repartee, or a really good pun."
                                            },
                                            {
                                                "example_id": "c916c7e7-2035-4b6a-830a-f37016830b2b",
                                                "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                                "text": "Yet habit—strange thing! what cannot habit accomplish?—Gayer sallies, more merry mirth, better jokes, and brighter repartees, you never heard over your mahogany[…]"
                                            },
                                            {
                                                "example_id": "a3faef20-5cd5-43ed-a658-bc67db426207",
                                                "sense_id": "5d8e507c-b97d-395c-9f87-c0b567366167",
                                                "text": "A slight smile broke on his lips. ¶ \"You are always prepared to sacrifice your principles for a repartee,\" he answered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46c5d07-9d98-3cbd-96d0-1bb494b43095",
                                        "entry_id": "4ea5b384-95fe-32b9-a147-fe54c19a13c2",
                                        "glosses": [
                                            "A conversation marked by a series of witty retorts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b45b1db-12f3-30df-8273-77c4f1e807ce",
                                        "entry_id": "4ea5b384-95fe-32b9-a147-fe54c19a13c2",
                                        "glosses": [
                                            "A skill in replying swiftly and wittily."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d69cfa8-3182-4ef3-bd08-09a603a37557",
                                                "sense_id": "3b45b1db-12f3-30df-8273-77c4f1e807ce",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            },
                                            {
                                                "example_id": "ba023e39-cafa-4da2-92a4-14d25102c063",
                                                "sense_id": "3b45b1db-12f3-30df-8273-77c4f1e807ce",
                                                "text": "Another millstone around the NDP’s neck was the relative lack of seasoned parliamentarians in the government front bench who were skilled enough at repartee to take on the Tory veterans across the floor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repartee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "079dab39-77c4-38db-996b-c6d6efbd1926",
                                        "entry_id": "bc3b5f05-aaa7-36e8-a82c-a2cae2610a19",
                                        "glosses": [
                                            "To reply with a repartee."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff22d98-78d1-49ad-ba1a-d240e2f3c4ee",
                                                "sense_id": "079dab39-77c4-38db-996b-c6d6efbd1926",
                                                "text": "Aubrey speaks of him as 'incomparable at reparteeing, the bull that was bayted, his witt beinge most sparkling, when most set on and provoked.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68cb5b92-6730-3fee-8713-bb59311589dd",
                                        "entry_id": "bc3b5f05-aaa7-36e8-a82c-a2cae2610a19",
                                        "glosses": [
                                            "To have a repartee (a conversation marked by witty retorts or replies)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ed8918-46c7-4109-922c-f4315add58e1",
                                                "sense_id": "68cb5b92-6730-3fee-8713-bb59311589dd",
                                                "text": "To see them together, friendly, reparteeing, chummy, would turn your stomach--Barbara so exquisite and high-born, and the man, his eyes full of evil fires, sitting like a great toad on the model's chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eebe123e-5e22-4a96-97b1-dec7b64c528f",
                        "source_entry_id": "57e0f401-ab3a-37d8-bba4-eb3af31351bf",
                        "source_sense_id": "5f12f72c-30fd-3520-9865-65254ae18431",
                        "target_lang_word": "retort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                        "entry_id": "d11e11d4-f3a3-3cb8-8343-8836282228b0",
                                        "glosses": [
                                            "A sharp or witty reply, or one which turns an argument against its originator; a comeback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82e37f2-9a50-4d3b-9ad3-e15771d8c180",
                                                "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                                "text": "He countered her insult with a clever retort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To say something sharp or witty in answer to a remark or accusation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5c0699d-c74d-4b31-b8bf-304c4a7b7dad",
                                                "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                                "text": "“It is a pity,” he retorted with aggravating meekness, “that they do not use a little common sense. The case resembles that of Columbus' egg, and is every bit as simple.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To make a remark which reverses an argument upon its originator; to return, as an argument, accusation, censure, or incivility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab29852a-22be-45ce-bd98-fdfe10114536",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "to retort the charge of vanity"
                                            },
                                            {
                                                "example_id": "12615b7a-dce6-4932-afb0-038280fcc94f",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "And with retorted scorn his back he turned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To bend or curve back."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fcfa779-28f5-4580-896a-22ff5a13cf42",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "a retorted line"
                                            },
                                            {
                                                "example_id": "06cd211c-7879-4318-8a28-5780e81a0a58",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "With retorted head, pruned themselves as they floated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To throw back; to reverberate; to reflect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb38f23d-1089-4776-9845-e77c265a0294",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "As when his virtues, shining upon others, / Heat them and they retort that heat again / To the first giver."
                                            },
                                            {
                                                "example_id": "a51b4be5-44cb-45de-8ef7-9aa15b1ab66d",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "Glasses were filled, arresting the trooper on a theme of passion; the pariahdom of the country cop, whose self-respect is to retort the law's blackmail for blackmail levied on his self-respect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A flask with a rounded base and a long neck that is bent down and tapered, used to heat a liquid for distillation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435383bd-6d9e-483c-a567-9d6071ea26bc",
                                                "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                                "text": "A large curved retort was boiling furiously in the bluish flame of a Bunsen burner, and the distilled drops were condensing into a two-litre measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86940d79-253c-33fd-9e57-c0ff054c3cd5",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "An airtight vessel in which material is subjected to high temperatures in the chemical industry or as part of an industrial manufacturing process, especially during the smelting and forging of metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A pressure cooker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98dc5a11-ec9c-49af-bd31-2d0e9a9040b6",
                                                "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                                "text": "The retort is above boiling water. Beneath is a furnace. To the right a man is removing the chips from which the camphor has been extracted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6381c185-86e7-3c80-bc14-b51d1bf2b41a",
