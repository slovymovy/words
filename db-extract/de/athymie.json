                "senses": [
                    {
                        "sense_id": "6faae5ac-69bf-3fe6-9141-009f16ab972b",
                        "entry_id": "c66890ba-a80d-346b-aa26-da12b273eefc",
                        "glosses": [
                            "verflachter Affekt, verringertes Gefühlsleben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b7d6f7-5ea3-4ddf-a8bc-8d71d6dc807b",
                                "sense_id": "6faae5ac-69bf-3fe6-9141-009f16ab972b",
                                "text": "„Hinter Verboten, Symbolen, Selbstdestruktivität und Ambivalenz läßt sich stets der rote Faden des Negativismus und des Selbstverlustes der Person verfolgen, deren Eklipse und Athymie jegliche Selbstverständlichkeit des Lebens aufhebt.“"
                            },
                            {
                                "example_id": "f1afdc76-e9c8-45fc-9be5-4c27562aca2e",
                                "sense_id": "6faae5ac-69bf-3fe6-9141-009f16ab972b",
                                "text": "„Ist die Melancholie die Hyperthymie, die Manie die Hypothymie, so ist der Stupor, der ächte wahre Stupor, die Athymie, wenigstens soweit als dies bei einem lebenden Wesen möglich ist.“ (1892)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
