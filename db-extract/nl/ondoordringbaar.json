                        "entry_id": "215c81be-746c-3f1a-b6c8-bc310aaf2c2e",
                        "glosses": [
                            "waar niets doorheen kan dringen, ondoorlatend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e286d12-973f-4946-ba10-d2fa32ce1580",
                                "sense_id": "6782e7dd-af5c-3adf-a3e0-5306cca0a121",
                                "text": "De vesting was ondoordringbaar."
                            },
                            {
                                "example_id": "605e496e-15f8-4041-8b4a-8f59980ce039",
                                "sense_id": "6782e7dd-af5c-3adf-a3e0-5306cca0a121",
                                "text": "Nemo keek in de aangewezen richting. Hij zag niets anders dan een zware, ondoordringbare nevel waarin de Stenen schenen te verdwijnen."
                            }
                        ]
                    }
                ],
