                    ],
                    "common_phrases": [
                        "bottomless brunch",
                        "bottomless coffee",
                        "bottomless drinks"
                    ],
                    "target_lang_definitions": {
                        "es": "Que ofrece recargas o raciones ilimitadas de comida o bebida por un precio fijo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ilimitado",
