                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "33ac9583-5bf0-4f65-88c3-73b3a3180de3",
                        "entry_id": "b223782f-e97a-329d-965d-95c029813368",
                        "tags": [
                            "nominative",
