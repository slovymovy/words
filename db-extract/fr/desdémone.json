                        "cross_references": [
                            {
                                "target_word": "Desdemona",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6b397b-6147-36c5-8427-ae80c79a5492",
                                        "entry_id": "93bdf4b1-2e9f-3eb3-8304-9957f9a10a4c",
                                        "glosses": [
                                            "Othello's wife in Shakespeare's play The Tragedy of Othello, the Moor of Venice, noted for being a victim of jealousy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c057ee3f-8023-4ae5-ba10-58284ccd0d2b",
                                                "sense_id": "1c6b397b-6147-36c5-8427-ae80c79a5492",
                                                "text": "Devastated by early losses, the narcissistic lover is unable to live with his Desdemona because he is unable to live without his idealization of her."
                                            },
                                            {
                                                "example_id": "dbb94f63-6319-49c1-bf30-8bfcf718004c",
                                                "sense_id": "1c6b397b-6147-36c5-8427-ae80c79a5492",
                                                "text": "As I looked out of the corner of my eye at this savagely picturesque fellow, wondering where was his Desdemona, a dainty and remarkably pretty piece of femininity entered the car, advanced to our table and sat herself beside Othello."
                                            },
                                            {
                                                "example_id": "2163d47d-bfb1-4a33-aa5e-b977d1f65226",
                                                "sense_id": "1c6b397b-6147-36c5-8427-ae80c79a5492",
                                                "text": "On the first of these days' amusements ( I know not what year ) Frank took offence at some attentions paid his Desdemona, and walked away next morning to London in wrath."
                                            },
                                            {
                                                "example_id": "2b4f773c-bb57-4d51-8169-9f9e21adc73e",
                                                "sense_id": "1c6b397b-6147-36c5-8427-ae80c79a5492",
                                                "text": "Luria, the Moor of Florence, is a sentimentally magnanimous Othello without his passions and without his Desdemona."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5111d5ce-6640-3861-836e-e2245912a22e",
                                        "entry_id": "93bdf4b1-2e9f-3eb3-8304-9957f9a10a4c",
                                        "glosses": [
                                            "An inner moon of the planet Uranus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae08f665-5713-3d1e-80a5-0a42bd5f1003",
                                        "entry_id": "93bdf4b1-2e9f-3eb3-8304-9957f9a10a4c",
                                        "glosses": [
                                            "666 Desdemona, a main-belt asteroid discovered in 1908."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
