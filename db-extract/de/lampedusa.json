                    {
                        "sense_id": "73e47341-bcf3-312e-a6a1-b766fe36e150",
                        "entry_id": "dbfe6f1c-6979-3513-93db-6e3fe29c1614",
                        "glosses": [
                            "Insel vor Italien, größte der Pelagischen Inseln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5772bf5f-2483-440e-ab8c-9cd21c05d429",
                                "sense_id": "73e47341-bcf3-312e-a6a1-b766fe36e150",
                                "text": "„Während die Flüchtlingsschiffe „Excelsior“ und „Catania“ ihre Fahrt ins apulische Taranto antraten, sollten noch am Donnerstag weitere 2000 Nordafrikaner in Lampedusa abgelegt haben.“"
                            },
                            {
                                "example_id": "dfaef0bc-97d7-4090-81b9-10e9a9c7974f",
                                "sense_id": "73e47341-bcf3-312e-a6a1-b766fe36e150",
                                "text": "„Schauplatz von »Klelia und Sinibald« ist das Palermo der Hochrenaissance (und dann noch ein wenig der nahe Orient), am Ende die Insel Lampedusa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
