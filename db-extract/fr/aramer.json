                        "sense_id": "599d2fd3-a38b-3a0f-998f-941779642f4d",
                        "entry_id": "e6d006d5-7087-36d9-bf11-cf65c5b9b91b",
                        "glosses": [
                            "Mettre le drap sur un rouleau appelé rame, pour l’allonger en l’étirant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0956dbb3-dcf4-4abc-96d6-36d2b03aa395",
                                "sense_id": "599d2fd3-a38b-3a0f-998f-941779642f4d",
                                "text": "D'après les réglements généraux de 1669, il était défendu de tirer, allonger, ni aramer aucune pièce de marchandise, de manière à en raccourcir la longueur ou étrécir la largeur, à peine de 100 livres et de confiscation pour la première fois, et de déchéance de la maîtrise, en cas de récidive. (Art. 52.)"
                            }
                        ]
                    }
