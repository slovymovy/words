                {
                    "sense_id": "e9c89888-595f-31f7-acc2-49648c6f6eef",
                    "sense_definition": "zich zeer snel en krachtig door iets heen bewegen, vaak gezegd van emoties of stoffen in het lichaam",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik voelde de adrenaline door mijn lichaam <w>gieren</w> voor de wedstrijd.",
                            "target_lang_translations": {
                                "en": "I felt the adrenaline <w>surging</w> through my body before the match.",
                                "fr": "Je sentais l'adrénaline <w>bouillonner</w> dans tout mon corps avant le match."
                            }
                        },
                        {
                            "text": "De zenuwen <w>gierden</w> door haar keel toen ze het podium opstapte.",
                            "target_lang_translations": {
