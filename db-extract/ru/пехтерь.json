                "senses": [
                    {
                        "sense_id": "4f8e559a-e079-3846-82b5-c9cf55f97160",
                        "entry_id": "941db9c3-9557-3694-aa46-fb9c924affcb",
                        "glosses": [
                            "устар., рег. корзина, кошель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d4e0c4-9358-4d6e-83b3-d5ce8a37631f",
                                "sense_id": "4f8e559a-e079-3846-82b5-c9cf55f97160",
                                "text": "Идеальная тара сборщика — плетеный из лыка пехтерь, который хорош для грибов и ягод"
                            }
                        ]
                    },
                    {
                        "sense_id": "7549230a-9fa3-3ac4-8d13-80ba7b705d21",
                        "entry_id": "941db9c3-9557-3694-aa46-fb9c924affcb",
                        "glosses": [
                            "одуш., бран. неуклюжий, неловкий или глупый человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81639f1c-613a-4c95-bbc5-c1f66dba0c88",
                                "sense_id": "7549230a-9fa3-3ac4-8d13-80ba7b705d21",
                                "text": "― А тебе какое дело, пехтерь? ― отвечал он, с презрением поглядев на бедного мужичонка."
                            }
                        ]
                    }
                ],
