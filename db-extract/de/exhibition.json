                                        "sense_id": "3ff80294-866f-3a3e-8e7f-67e4c3330cbf",
                                        "entry_id": "91714de2-51d1-3e84-8899-ec53a58b915c",
                                        "glosses": [
                                            "A large-scale public showing of objects or products."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "387e7a2a-f4f2-4861-8499-3f9e3ca30992",
                                                "sense_id": "3ff80294-866f-3a3e-8e7f-67e4c3330cbf",
                                                "text": "There was an art exhibition on in the town hall."
                                            },
                                            {
                                                "example_id": "0563e973-ab2b-4027-9549-c668c45368a6",
                                                "sense_id": "3ff80294-866f-3a3e-8e7f-67e4c3330cbf",
                                                "text": "a boat exhibition"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "958fbeb4-09e7-3ded-a236-dd2376fbdbdd",
                                        "entry_id": "91714de2-51d1-3e84-8899-ec53a58b915c",
                                        "glosses": [
                                            "A public display, intentional or otherwise, generally characterised as negative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8270b3e9-5939-412c-becb-d7f69aa2f315",
                                                "sense_id": "958fbeb4-09e7-3ded-a236-dd2376fbdbdd",
                                                "text": "a shameful exhibition"
                                            },
                                            {
                                                "example_id": "65e24f0b-1286-4923-a133-56a231cbc71a",
                                                "sense_id": "958fbeb4-09e7-3ded-a236-dd2376fbdbdd",
                                                "text": "a disgusting exhibition"
                                            },
                                            {
                                                "example_id": "3e6e0b82-5c94-479b-80fb-5be4b8d0760f",
                                                "sense_id": "958fbeb4-09e7-3ded-a236-dd2376fbdbdd",
                                                "text": "Well I made some exhibition, I lost my will to eat / The only thing that matters to me is to touch your lotus feet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c72d82-235b-3db2-8fde-565c3b913f95",
                                        "entry_id": "91714de2-51d1-3e84-8899-ec53a58b915c",
                                        "glosses": [
                                            "A demonstration of personal skill or feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "264da431-a3c9-4c09-8c03-57350bc37607",
                                                "sense_id": "90c72d82-235b-3db2-8fde-565c3b913f95",
                                                "text": "\"I could not have believed,\" remarked Francesca, \"had I not witnessed it since my residence in your country, how the reality and the affectation of feeling can exist together. Before I left our solitary home, the very exhibition of emotion would have tempted me to doubt its truth. Now, I observe that some affect, as others shun, display; yet the feeling is equally true in both.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68b6193-5b73-3588-af29-c271b9da9a8b",
                                        "entry_id": "91714de2-51d1-3e84-8899-ec53a58b915c",
                                        "glosses": [
                                            "A financial award or prize given to a student (who becomes an exhibitioner) by a school or university, usually on the basis of academic merit."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad505181-38a9-4814-9956-2426b3e9225d",
                                                "sense_id": "c68b6193-5b73-3588-af29-c271b9da9a8b",
                                                "text": "He was a scholarship boy who had won an Exhibition to Oxford, and then, like so many others, had found himself thrown upon the slave market of pedagogy."
                                            },
                                            {
                                                "example_id": "abf48de1-a9bb-4bc5-ac3a-efc6ecca746e",
                                                "sense_id": "c68b6193-5b73-3588-af29-c271b9da9a8b",
                                                "text": "Despite a couple of rustications, he gained an exhibition to Cambridge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d17acc61-187a-3b0f-aa50-2002533b1506",
                                        "entry_id": "91714de2-51d1-3e84-8899-ec53a58b915c",
                                        "glosses": [
                                            "A game which does not impact the standings for any major cup or competition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
