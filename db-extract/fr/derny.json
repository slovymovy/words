                        "entry_id": "6de9a6a9-0a85-3044-8538-d9a068f42c83",
                        "glosses": [
                            "Cyclomoteur qui entraine les coureurs cyclistes sur piste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccac3e35-9c03-4868-b59c-c9ff6671a58e",
                                "sense_id": "339b0451-8a9d-34f0-9877-c1d1f91acbee",
                                "text": "La Nouvelle République avait déclaré que cette rencontre promettait d’être « sensationnelle » et qu’elle verrait le premier face-à-face entre Anquetil et Merckx dans une course derrière derny."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55acb811-8e44-4a58-b4e9-4162e4cec23a",
                        "source_entry_id": "6de9a6a9-0a85-3044-8538-d9a068f42c83",
                        "source_sense_id": "339b0451-8a9d-34f0-9877-c1d1f91acbee",
