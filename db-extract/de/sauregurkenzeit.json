                "senses": [
                    {
                        "sense_id": "5fd8576b-608c-3f16-9c7a-fda7d38ca1f0",
                        "entry_id": "2a897080-7858-30c3-9796-c64d979ca258",
                        "glosses": [
                            "Zeit im Sommer, besonders in der hochsommerlichen Urlaubszeit, in der (saisonbedingt) keine rege geschäftliche, politische, kulturelle oder ähnliche Aktivität herrscht und es deshalb besonders der Presse an wichtigen, berichtenswerten Ereignissen mangelt"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "99838236-089e-4883-98da-63450f7ddd97",
                                "sense_id": "5fd8576b-608c-3f16-9c7a-fda7d38ca1f0",
                                "text": "Während die Politiker ihren Sommerurlaub verleben, müssen die Journalisten jedes Jahr aufs Neue die Sauregurkenzeit hinter sich bringen."
                            },
                            {
                                "example_id": "3fbd9119-de77-4308-aa46-020f7672e7cd",
                                "sense_id": "5fd8576b-608c-3f16-9c7a-fda7d38ca1f0",
                                "text": "„Jetzt sei ja Sauregurkenzeit, wenn er es jetzt nicht schaffe, Büsgen zu sprechen, in einem Monat sei es zu spät.“"
                            },
                            {
                                "example_id": "f336f39c-eebd-483e-a6d0-66318df3789c",
                                "sense_id": "5fd8576b-608c-3f16-9c7a-fda7d38ca1f0",
                                "text": "„Den vorigen Sommer gab es keine Sauregurkenzeit, und wie es scheint, gibt es diesmal wieder keine.“"
                            },
                            {
                                "example_id": "13e2c39f-cb07-432a-bf64-4c755803a921",
                                "sense_id": "5fd8576b-608c-3f16-9c7a-fda7d38ca1f0",
                                "text": "„In sommerlichen Sauregurkenzeiten, wenn wir uns am Anfang einer Woche telefonisch trafen und etwas Spannendes, Repräsentatives für die Sonntagsausgabe ausheckten.“"
                            },
                            {
                                "example_id": "717bae03-44df-4cc9-8c44-8ce05c1fc5ac",
                                "sense_id": "5fd8576b-608c-3f16-9c7a-fda7d38ca1f0",
                                "text": "„Ihm war, als könne »das alles« kein gutes Ende nehmen, als werde eine Katastrophe das Ende sein, eine Empörung der geduldigen Natur, ein Donnerwetter und aufräumender Sturmwind, der den Bann der Welt brechen, das Leben über den »toten Punkt« hinwegreißen und der »Sauregurkenzeit« einen schrecklichen Jüngsten Tag bereiten werde.“"
                            },
                            {
                                "example_id": "9a6697f6-b57f-40f2-b8cc-b3415401e339",
                                "sense_id": "5fd8576b-608c-3f16-9c7a-fda7d38ca1f0",
                                "text": "„Wir verstehen zwar nicht viel vom Pumpen und sind eher Spezialisten fürs Saugen, da wir uns in finsteren Sommerloch- und Sauregurkenzeiten unsere kleinen Geschichten selbst aus den Fingern saugen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
