                        "glosses": [
                            "Que l’on ne peut pas posséder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7b2c94-1067-474c-89df-8f616721f6e3",
                                "sense_id": "50069f5f-0b58-3382-843d-7263aff18942",
                                "text": "Mystérieuse splendeur des choses vitales. Beauté inimitable, inintelligible, impossédable. Aimer, c’est ne pas pouvoir posséder."
                            },
                            {
                                "example_id": "1172ab9f-4567-48c1-9651-23030219f0be",
                                "sense_id": "50069f5f-0b58-3382-843d-7263aff18942",
                                "text": "Les biens de l’esprit sont des biens « impossédables » et Dieu, qui est le souverain bien, est souverainement impossédable."
                            },
                            {
                                "example_id": "ff1bcf21-9e2f-4e61-bb5f-41f643074c7d",
                                "sense_id": "50069f5f-0b58-3382-843d-7263aff18942",
                                "text": "Je suis l’amoureuse indifférente\nIndéfectible\nMais impossédable"
                            }
                        ]
                    }
