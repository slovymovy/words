                        "cross_references": [
                            {
                                "target_word": "hypnotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85c7038f-e33c-3a0b-87ed-cc8c92f5e83c",
                                        "entry_id": "c7e6d8de-c932-3d27-81b9-7ce425d02442",
                                        "glosses": [
                                            "Qui provoque le sommeil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                        "entry_id": "c7e6d8de-c932-3d27-81b9-7ce425d02442",
                                        "glosses": [
                                            "Qui se rapporte à l’hypnose et à l’hypnotisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d177032-de00-4e7b-96e9-fcc0a93082e4",
                                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                                "text": "La voix du vieillard avait quelque chose d'hypnotique."
                                            },
                                            {
                                                "example_id": "703e1940-5365-49f6-af0d-f926f1974e65",
                                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                                "text": "Pour autant, il n'y a pas de signes physiologiques objectifs (fréquence respiratoire, tension artérielle, rythme cardiaque...) de l'état hypnotique ni de critères objectifs sur l'électroencéphalogramme (EEG)."
                                            },
                                            {
                                                "example_id": "b75fc225-1421-40b2-af36-889edbd3451f",
                                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                                "text": "Nous traversons, plusieurs fois par jour, des épisodes de dissociation spontanée, hypnose naturelle, qui possède une fonction « salvatrice », moments de rêverie spontanée : école, réunion ennuyeuse, voyage en train, émission ou film à la télévision, moment qui permet de se ressourcer, mais de s’évader aussi d’une mémoire traumatique envahissante, qui resurgit avec les émotions, notamment les « flashback », diurnes et nocturnes. Ces épisodes de dissociation spontanée sont autant d’états hypnotiques qui permettent au sujet de suspendre provisoirement la souffrance."
                                            },
                                            {
                                                "example_id": "8f06d510-0d80-429e-bc4d-28be7094c631",
                                                "sense_id": "319028d4-b7eb-31c7-862d-7630d3a8e1fd",
                                                "text": "Suggestion, sommeil, sujet hypnotique."
                                            }
                                        ]
                                    }
                                ]
                            },
