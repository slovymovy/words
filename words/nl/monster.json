    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3187ef0-d3ff-332f-8670-ec1537dbae4c",
                    "sense_definition": "Een angstaanjagend en gevaarlijk wezen, vaak uit sprookjes of films.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige kinderen zijn bang voor een <w>monster</w> onder hun bed.",
                            "target_lang_translations": {
                                "en": "Some children are afraid of a <w>monster</w> under their bed."
                            }
                        },
                        {
                            "text": "In die film vecht de held tegen een groot groen <w>monster</w>.",
                            "target_lang_translations": {
                                "en": "In that movie, the hero fights against a big green <w>monster</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gedrocht"
                    ],
                    "common_phrases": [
                        "eng monster"
                    ],
                    "target_lang_definitions": {
                        "en": "A terrifying and dangerous creature, often from fairy tales or movies."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monster",
                                "target_lang_sense_clarification": "a scary mythical creature"
                            },
                            {
                                "target_lang_word": "beast",
                                "target_lang_sense_clarification": "a large and dangerous animal or creature"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c00a114f-d860-321f-b62c-f256692906c9",
                    "sense_definition": "Een kleine hoeveelheid van een stof of materiaal die representatief is voor het geheel, bedoeld voor onderzoek.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "proefstuk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De inspectie nam een <w>monster</w> van het water om de kwaliteit te testen.",
                            "target_lang_translations": {
                                "en": "The inspection took a <w>sample</w> of the water to test the quality."
                            }
                        },
                        {
                            "text": "We hebben verschillende <w>monsters</w> van het behang mee naar huis genomen.",
                            "target_lang_translations": {
                                "en": "We took several <w>samples</w> of the wallpaper home with us."
                            }
                        }
                    ],
                    "synonyms": [
                        "steekproef"
                    ],
                    "common_phrases": [
                        "monster nemen"
                    ],
                    "target_lang_definitions": {
                        "en": "A small amount of a substance or material that is representative of the whole, intended for research or testing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sample",
                                "target_lang_sense_clarification": "a specimen for testing or inspection"
                            },
                            {
                                "target_lang_word": "specimen",
                                "target_lang_sense_clarification": "a scientific sample"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "452e776d-9b89-36ce-8529-266919ddb46f",
                    "sense_definition": "Een persoon die zich extreem slecht, wreed of antisociaal gedraagt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kranten noemden de moordenaar een harteloos <w>monster</w>.",
                            "target_lang_translations": {
                                "en": "The newspapers called the killer a heartless <w>monster</w>."
                            }
                        },
                        {
                            "text": "Hoe kan een mens veranderen in zo'n vreselijk <w>monster</w>?",
                            "target_lang_translations": {
                                "en": "How can a person turn into such a terrible <w>monster</w>?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who behaves in an extremely bad, cruel, or antisocial manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monster",
                                "target_lang_sense_clarification": "a cruel or heartless person"
                            },
                            {
                                "target_lang_word": "fiend",
                                "target_lang_sense_clarification": "an evil or cruel person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed821dbd-d4de-369d-b89b-4c6e1146d549",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>monsteren</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>monster</w> de nieuwe bemanning voordat we de haven verlaten.",
                            "target_lang_translations": {
                                "en": "I <w>inspect</w> the new crew before we leave the harbor."
                            }
                        },
                        {
                            "text": "Terwijl ik de schade <w>monster</w>, maak ik aantekeningen in mijn logboek.",
                            "target_lang_translations": {
                                "en": "While I <w>review</w> the damage, I make notes in my logbook."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'monsteren' (to inspect or review)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inspect",
                                "target_lang_sense_clarification": "to examine or review (first-person singular)"
                            },
                            {
                                "target_lang_word": "muster",
                                "target_lang_sense_clarification": "to assemble or inspect troops/crew"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64cf8791-0db9-3ac6-bcc4-71d68d13b3f2",
                    "sense_definition": "De gebiedende wijs van <w>monsteren</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Monster</w> die troepen onmiddellijk zodat we weten wie er aanwezig is.",
                            "target_lang_translations": {
                                "en": "<w>Muster</w> those troops immediately so we know who is present."
                            }
                        },
                        {
                            "text": "Kijk me aan en <w>monster</w> mijn gezicht goed voor je antwoord geeft.",
                            "target_lang_translations": {
                                "en": "Look at me and <w>examine</w> my face well before you give an answer."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'monsteren' (to inspect or review)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inspect",
                                "target_lang_sense_clarification": "to examine or review (command)"
                            },
                            {
                                "target_lang_word": "muster",
                                "target_lang_sense_clarification": "to assemble or inspect (command)"
                            }
                        ]
                    }
                }
            ]
        },
