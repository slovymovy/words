    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4942484f-166a-3e91-8731-051d0d673641",
                "word": "communicant",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "994c10a3-dacc-3d33-b62c-d60cc8bb28d4",
                        "entry_id": "4942484f-166a-3e91-8731-051d0d673641",
                        "glosses": [
                            "Communicating."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f93b276c-26d9-46ff-97ee-4d38bd7b473b",
                                "sense_id": "994c10a3-dacc-3d33-b62c-d60cc8bb28d4",
                                "text": "The co-eternal Son of the living God, incarnate, tempted, crucified, resurgent, communicant of his spirit, ascendant, and obtaining for his church the descent of the Holy Ghost."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                "word": "communicant",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0100063f-59d0-465c-bd72-f46cc16483ac",
                        "entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                        "tags": [
                            "plural"
                        ],
                        "form": "communicants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                        "entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                        "glosses": [
                            "A person who receives (or is allowed to receive) the elements (i.e., bread and wine) of the sacrament of Holy Communion. (Compare also these terms: communion, Communion, Lord's Supper, Mass, Eucharist, Divine Liturgy.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2289333a-5bb4-40f8-aacc-16febc116726",
                                "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                                "text": "1706 August 30, Francis Atterbury, a sermon preached at the funeral of Mr. Bennett\na never-failing monthly communicant"
                            },
                            {
                                "example_id": "a3c1152c-e8f4-4bbc-b11c-bac85e15893a",
                                "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                                "text": "Meanwhile, the lass grew up in the nurture and admonition of the Lord. I have heard Dr. Chrystal say that he never had a communicant more full of the things of the Spirit."
                            },
                            {
                                "example_id": "67509cce-e54d-4972-931d-1b0de86a540a",
                                "sense_id": "a792aec3-b9dc-3ca1-984b-3ff914221a81",
                                "text": "The folded hands and submissive posture of the orderly line of communicants."
                            }
                        ]
                    },
                    {
                        "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                        "entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                        "glosses": [
                            "One who communicates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff916ce-2107-4ef2-ae1a-b22939d3c7ef",
                                "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                                "text": "Each was a messenger and communicant with a special branch of knowledge."
                            },
                            {
                                "example_id": "36a89d33-593d-41b1-98be-b375949bea72",
                                "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                                "text": "partakers communicant with the bodie of Christ"
                            },
                            {
                                "example_id": "b9a3a236-d0e1-4db9-9008-6331f94991c8",
                                "sense_id": "b152ef62-668b-353d-b063-0f5c2063fd9c",
                                "text": "These cyberforums are asynchronous; that is, contributors post (i.e., publish a text message) without the need for fellow communicants to be online at the same time."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0704adca-9c1f-4d9e-86c2-b56244c2d052",
                        "source_entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                        "source_sense_description": "person who receives Communion",
                        "target_lang_word": "communiant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1910c0-8d40-3631-9527-3dee87fde5b0",
                                        "entry_id": "27b0f246-a4e8-3b34-bbb8-6d18f8103f1a",
                                        "glosses": [
                                            "Celui qui communie, dans l'Église catholique romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b835156-df21-48f1-bff6-d1c9dc6764a2",
                                                "sense_id": "dc1910c0-8d40-3631-9527-3dee87fde5b0",
                                                "text": "J’ai sur le cœur un jour de l’An où mes parents\n Pensant bien faire, m’avaient habillé en communiant\n Chez ma grand-mère, c’était mon père\n Qui s’déguisait en Père Noël pour faire accroire\n Que les cadeaux, ça v’nait pas tout’ de Dupuis Frères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c740a4db-6586-3b9c-8ac3-5cbd6647b266",
                                        "entry_id": "27b0f246-a4e8-3b34-bbb8-6d18f8103f1a",
                                        "glosses": [
                                            "Premier communiant."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "communiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8001b1cc-ab9c-3ce5-8d67-ac8a0158ea59",
                                        "entry_id": "ae210164-8a25-3a3b-abbd-24efc9284f92",
                                        "glosses": [
                                            "Participe présent de communier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ed56555-6dab-4094-a8e6-0709f20831fe",
                        "source_entry_id": "a9e28cc0-8278-3c2f-bbae-237dc4010f90",
                        "source_sense_description": "person who receives Communion",
                        "target_lang_word": "communiante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communiante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e93e994a-ee86-3d6c-af0e-ad5ace943699",
                                        "entry_id": "9a3c321c-641c-30a8-b61e-6577fc5302c1",
                                        "glosses": [
                                            "Celle qui communie, dans l'Église catholique romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fc53598-4180-42f0-891d-50c1b5504828",
                                                "sense_id": "e93e994a-ee86-3d6c-af0e-ad5ace943699",
                                                "text": "Elle croisa les bras sur sa poitrine, à la façon des communiantes au retour de la Sainte Table ; […]."
                                            },
                                            {
                                                "example_id": "9fd64dd4-b035-4f6e-a2d3-e857f33b1709",
                                                "sense_id": "e93e994a-ee86-3d6c-af0e-ad5ace943699",
                                                "text": "À côté de lui une communiante, sa nièce Denise, en longue robe blanche et dont on ne voit que le visage, encadré par le bonnet auquel s’attache le voile, et les chevilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e9beb0-d280-3708-84dd-9f2f9f214be4",
                                        "entry_id": "9a3c321c-641c-30a8-b61e-6577fc5302c1",
                                        "glosses": [
                                            "Première communiante."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa2cfc8d-c228-4110-9efa-89f9728c3b7c",
                                                "sense_id": "59e9beb0-d280-3708-84dd-9f2f9f214be4",
                                                "text": "Les communiantes, le nez en l'air, la bouche grande ouverte, envoyaient vers Dieu des cantiques, et une fillette habillée de blanc distribuait des petits pains chauds à la porte de l'église."
                                            },
                                            {
                                                "example_id": "43749b24-6964-48ec-9ed3-c2e4d28e74cd",
                                                "sense_id": "59e9beb0-d280-3708-84dd-9f2f9f214be4",
                                                "text": "Je naquis au temps où les cerisiers sont pareils à des communiantes, quand tout le pays n'est plus que blancheur à perte de vue, au long des chemins et des routes, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
