        "fr-extract.jsonl": [
            {
                "entry_id": "2a0a974b-d98f-3cac-8bd3-8c823d01806c",
                "word": "malencontreusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c41c2ad8-ef41-3e46-a3b3-2d4af4f7125d",
                        "entry_id": "2a0a974b-d98f-3cac-8bd3-8c823d01806c",
                        "glosses": [
                            "Par accident, à un mauvais moment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01ce1e7-fb7d-4d6a-b227-bcc5f8983d71",
                                "sense_id": "c41c2ad8-ef41-3e46-a3b3-2d4af4f7125d",
                                "text": "Sur une attaque de Francfort, c’est Valentin Rongier qui a malencontreusement offert une passe décisive à Jesper Lindstrøm en voulant intercepter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83d79eb6-81fa-4f16-8021-4291c8e09b31",
                        "source_entry_id": "2a0a974b-d98f-3cac-8bd3-8c823d01806c",
                        "source_sense_id": "c41c2ad8-ef41-3e46-a3b3-2d4af4f7125d",
                        "source_sense_description": "Par malchance",
                        "target_lang_word": "unfortunately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfortunately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bf31a51-c605-3352-82e9-c91eac358792",
                                        "entry_id": "521ce821-1ab0-307e-a1d8-c17328e7623a",
                                        "glosses": [
                                            "Happening through bad luck, or because of some unfortunate event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ce75ac-8f87-4bf9-8669-432f4c70b841",
                                                "sense_id": "8bf31a51-c605-3352-82e9-c91eac358792",
                                                "text": "He unfortunately placed his hand on a loose brick."
                                            },
                                            {
                                                "example_id": "47ae135d-ce12-4834-bcee-d6163467ddc3",
                                                "sense_id": "8bf31a51-c605-3352-82e9-c91eac358792",
                                                "text": "There were an unfortunately large number of misprints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                        "entry_id": "521ce821-1ab0-307e-a1d8-c17328e7623a",
                                        "glosses": [
                                            "Used (as a parenthetical word, often a sentence adverb) to express disappointment, compassion, sorrow, regret, or grief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba47605-dbd2-42dd-800e-e02ccae84587",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "The houses which burned down could have been saved. Unfortunately, the fire truck had broken down on the way."
                                            },
                                            {
                                                "example_id": "867e3970-a28e-46cf-bbb3-df76ad911b6f",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "Unfortunately, the uproar awoke Mr. Jones, who sprang out of bed, making sure that there was a fox in the yard."
                                            },
                                            {
                                                "example_id": "c73f7a54-4e8a-49f0-bdf3-31603aabaaf1",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "Unfortunately, even in the palmiest days of the old Cockermouth, Keswick & Penrith Railway Company, passengers were few and far between at Troutbeck, and since the advent of the motor bus road services they are rarer than ever, and never likely to increase."
                                            },
                                            {
                                                "example_id": "21c15e1c-0757-4f09-9a58-44cd513e358c",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "Informal techniques, if properly written, can be quite readable and comprehensible; unfortunately, it is easy to leave unsaid details that must be specified, or to misgeneralise and produce inconsistencies."
                                            },
                                            {
                                                "example_id": "8929fc68-45d5-4f44-9906-e05573808b17",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "The thing he unfortunately doesn't recognise is there is an 800-pound gorilla when it comes to major American motor sports. The 800-pound gorilla is Nascar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47a3d774-9777-472c-8fca-bfaf96b07feb",
                        "source_entry_id": "2a0a974b-d98f-3cac-8bd3-8c823d01806c",
                        "source_sense_id": "c41c2ad8-ef41-3e46-a3b3-2d4af4f7125d",
                        "source_sense_description": "Par malchance",
                        "target_lang_word": "at the wrong moment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b0c23a38-3f0d-4e87-9ad0-cbfd15fda041",
                        "source_entry_id": "2a0a974b-d98f-3cac-8bd3-8c823d01806c",
                        "source_sense_id": "c41c2ad8-ef41-3e46-a3b3-2d4af4f7125d",
                        "source_sense_description": "Par malchance",
                        "target_lang_word": "inadvertently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inadvertently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                        "entry_id": "f1758a9a-c536-367f-a001-714221579f06",
                                        "glosses": [
                                            "Unintentionally; because of an oversight."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c29052-9aa4-4215-9057-f8475f3fca36",
                                                "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                                "text": "'Dear me! I may have inadvertently touched the handle,' said he."
                                            },
                                            {
                                                "example_id": "42f7a729-0e98-4aef-babe-9bfdd1c01f4d",
                                                "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                                "text": "Neven Subotic hooked a volley wide after Ramsey inadvertently headed a Reus free-kick back into the danger zone, and Blaszczykowski was also off target when he met Kevin Grosskreutz's cross."
                                            },
                                            {
                                                "example_id": "e211a2f4-14fb-4867-8a96-d0015ac6e181",
                                                "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                                "text": "for the living human, who in grief may share deeply personal data with the commercial entity that owns the bot, but also for the ghost, which might inadvertently reveal a n old family secret from beyond the grave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c85e0b6-7f86-4f4b-838f-571f59e30a6a",
                        "source_entry_id": "2a0a974b-d98f-3cac-8bd3-8c823d01806c",
                        "source_sense_id": "c41c2ad8-ef41-3e46-a3b3-2d4af4f7125d",
                        "source_sense_description": "Par malchance",
                        "target_lang_word": "inconveniently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconveniently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22e77f34-1f34-3406-8a42-5b287925320d",
                                        "entry_id": "abf6198a-f856-3df5-98d3-d0ae9b4bc8e4",
                                        "glosses": [
                                            "In an inconvenient manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b166e2ba-ec7b-41cf-bbf1-5ae91feb28f1",
                                                "sense_id": "22e77f34-1f34-3406-8a42-5b287925320d",
                                                "text": "There are several reasons why the line's future is now dubious. With the exception of Horsmonden, the stations are most inconveniently sited. This is largely because the Wealden villages were built on ridges, and in fact most Wealden stations are badly placed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
