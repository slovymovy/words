        "fr-extract.jsonl": [
            {
                "entry_id": "26db7979-421d-3ada-b1bf-8a687b175a18",
                "word": "entrecuisse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aa84f526-e366-4795-9b9b-2cca4001ad06",
                        "entry_id": "26db7979-421d-3ada-b1bf-8a687b175a18",
                        "tags": [
                            "plural"
                        ],
                        "form": "entrecuisses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "724bb60c-f6eb-32e2-8cc0-fd0417de556f",
                        "entry_id": "26db7979-421d-3ada-b1bf-8a687b175a18",
                        "glosses": [
                            "Partie du corps située entre les cuisses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75575de-47d8-454d-88cc-50960849b6b7",
                                "sense_id": "724bb60c-f6eb-32e2-8cc0-fd0417de556f",
                                "text": "Ils ne se nourrissent absolument que de viande de vache rôtie, dont ils ne prennent que les côtes, l’entrecuisse, et la chair qui recouvre le ventre et l’estomac."
                            },
                            {
                                "example_id": "26e227fa-bc64-4789-a8ea-a7ca725fb0a1",
                                "sense_id": "724bb60c-f6eb-32e2-8cc0-fd0417de556f",
                                "text": "Yoya la Yeya était restée sur sa faim, d’autant plus que Pancho avait eu l’impolitesse de la planter là, l’entrecuisse en feu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef794aa6-6027-45de-a9fe-33c3d55cfa8d",
                        "source_entry_id": "26db7979-421d-3ada-b1bf-8a687b175a18",
                        "source_sense_id": "724bb60c-f6eb-32e2-8cc0-fd0417de556f",
                        "target_lang_word": "crotch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crotch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46d2240e-85d4-37b6-8e47-4352551c7dfd",
                                        "entry_id": "f15090a1-322c-3998-93b3-3909f09eade2",
                                        "glosses": [
                                            "The ventral area (very bottom) of the human body between where the legs fork from the torso, in the area of the genitals and anus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "789983ee-959e-4f89-9a4f-1648c918c9ba",
                                                "sense_id": "46d2240e-85d4-37b6-8e47-4352551c7dfd",
                                                "text": "Every mile they rode their crotches felt worse saddlepain."
                                            },
                                            {
                                                "example_id": "c21a9c7d-41e7-4da8-94c6-967197087812",
                                                "sense_id": "46d2240e-85d4-37b6-8e47-4352551c7dfd",
                                                "text": "We were turned at a slight angle to each other, our shoulders touching and I put my hand on his crotch. Miles seemed to be expecting it. He chuckled, took a pair of compasses and jammed them into the door above the latch. This was called ‘sporting the oak’ and was the recognized way of locking oneself in. Over the next eighteen months we sported our oaks with great frequency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce5b7bd-1edf-3dd1-b683-403f55ac50bf",
                                        "entry_id": "f15090a1-322c-3998-93b3-3909f09eade2",
                                        "glosses": [
                                            "Either the male or female genitalia."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42bcc83a-a169-4218-b803-53d1ee4b8e64",
                                                "sense_id": "bce5b7bd-1edf-3dd1-b683-403f55ac50bf",
                                                "text": "He cringed at being kicked in the crotch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a633e157-7ae0-3b08-9640-8e3a579c2d37",
                                        "entry_id": "f15090a1-322c-3998-93b3-3909f09eade2",
                                        "glosses": [
                                            "The area where something forks or branches: where a ramification takes place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc76873-f2e6-4a18-a2ae-0e3a7d1005d1",
                                                "sense_id": "a633e157-7ae0-3b08-9640-8e3a579c2d37",
                                                "text": "There is a child sitting in a crotch of that tree."
                                            },
                                            {
                                                "example_id": "f4180c47-0b93-4bc8-910f-38c5ca154561",
                                                "sense_id": "a633e157-7ae0-3b08-9640-8e3a579c2d37",
                                                "text": "In one crotch of the old peach-tree, just by the wall, sat a second cousin of the little eight-eyed fellow we had left up stairs, with her web spread on the most geometric model, and a young and promising family of spiders and spideresses practising gymnastics in the fairy rigging; […]"
                                            },
                                            {
                                                "example_id": "c3742f18-9531-4464-8ae7-d4394473089c",
                                                "sense_id": "a633e157-7ae0-3b08-9640-8e3a579c2d37",
                                                "text": "Tarzan wondered if he would stalk him to his cabin door. He hoped not, for that would mean a night’s sleep curled in the crotch of a tree, and he much preferred the bed of grasses within his own abode. But he knew just the tree and the most comfortable crotch, if necessity demanded that he sleep out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f76b92d4-7b3b-3330-9034-b3a576028de3",
                                        "entry_id": "f15090a1-322c-3998-93b3-3909f09eade2",
                                        "glosses": [
                                            "In the three-ball carom game, a small space at each corner of the table."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "071ae740-5aa3-36fa-8560-8ddbe2e68a3a",
                                        "entry_id": "f15090a1-322c-3998-93b3-3909f09eade2",
                                        "glosses": [
                                            "The open counter (negative space) formed by two downward strokes that meet at an internal acute angle, potentially above a vertex, as in the letters \\\"V\\\" and \\\"Y\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crotch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "253dfd30-8a1c-326b-b376-9d1cede14605",
                                        "entry_id": "9f2e2c6c-ec59-3763-839c-eaff58bed732",
                                        "glosses": [
                                            "To provide with a crotch; to give the form of a crotch to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cc5afde-7a5b-4f28-9023-d21d4c5b3c5c",
                                                "sense_id": "253dfd30-8a1c-326b-b376-9d1cede14605",
                                                "text": "to crotch the ends of ropes in splicing or tying knots"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e3f0d02-11ab-3177-b87f-6d4244a61c3e",
                                        "entry_id": "9f2e2c6c-ec59-3763-839c-eaff58bed732",
                                        "glosses": [
                                            "To notch (a log) on opposite sides to provide a grip for the dogs that will haul it."
                                        ],
                                        "tags": [
                                            "US",
                                            "Western",
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "573c97a6-b4f6-39a0-9916-53dbcc6c2ff4",
                                        "entry_id": "9f2e2c6c-ec59-3763-839c-eaff58bed732",
                                        "glosses": [
                                            "To shoplift or smuggle by hiding between one's thighs or in one's underwear."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3576dbb8-7ab7-43df-befe-5ea417b1838b",
                                                "sense_id": "573c97a6-b4f6-39a0-9916-53dbcc6c2ff4",
                                                "text": "I remember crotching a bottle of Corona out of a pub on Commercial Drive and nursing it with Cancer as we stumbled towards my car ."
                                            },
                                            {
                                                "example_id": "edba0aad-f8b1-46ff-a54f-08fee624c3b2",
                                                "sense_id": "573c97a6-b4f6-39a0-9916-53dbcc6c2ff4",
                                                "text": "I crotched them. I put them in my underwear."
                                            },
                                            {
                                                "example_id": "73df2b49-6229-45ba-a59d-874fffecede6",
                                                "sense_id": "573c97a6-b4f6-39a0-9916-53dbcc6c2ff4",
                                                "text": "Techniques used: the woman rolled four coats and crotched them (placed them under her dress and held them between her thighs), and each of the men wrapped three coats around his midsection"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d5f8dbc-ab0a-3797-8bc0-fa23746c022e",
                                        "entry_id": "9f2e2c6c-ec59-3763-839c-eaff58bed732",
                                        "glosses": [
                                            "To hit in the crotch (genital region)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99d41a33-636b-49b6-89aa-06b4c2f3ac73",
                                                "sense_id": "6d5f8dbc-ab0a-3797-8bc0-fa23746c022e",
                                                "text": "Flair and Paisley flirted until Daffney crotched David from behind with a baseball bat."
                                            },
                                            {
                                                "example_id": "5eca02ce-e0be-45bf-a14a-6c8fcf63a560",
                                                "sense_id": "6d5f8dbc-ab0a-3797-8bc0-fa23746c022e",
                                                "text": "Pillman gets crotched on the top rope and barely kicks out of a superplex."
                                            },
                                            {
                                                "example_id": "1f748430-e3bc-48b6-a4fb-843670f4d746",
                                                "sense_id": "6d5f8dbc-ab0a-3797-8bc0-fa23746c022e",
                                                "text": "Calhoun turns around and Leo is facing him and he crotched him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a5e5e25-9082-35ed-acd3-63f6f9fa6d16",
                                        "entry_id": "9f2e2c6c-ec59-3763-839c-eaff58bed732",
                                        "glosses": [
                                            "To secure (the boom) to the boom crotch (a forked pole)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e67986c-ffb9-472c-a440-9d5877708822",
                                                "sense_id": "0a5e5e25-9082-35ed-acd3-63f6f9fa6d16",
                                                "text": "[…] when she begins to go astern, let go the anchor, brail up the spanker, crotch the boom, haul taut the guys, light-to the cable, as fast as she will take it, until a sufficient scope is out, when stopper."
                                            },
                                            {
                                                "example_id": "61057729-4769-4af5-81ec-48405f48dbc9",
                                                "sense_id": "0a5e5e25-9082-35ed-acd3-63f6f9fa6d16",
                                                "text": "I always crotched the boom while reefing, and made an easy job of it, the boat, in the meantime, taking perfect care of herself on any point of sailing, under jib and jigger."
                                            },
                                            {
                                                "example_id": "bef2a7aa-3f4e-41f9-9644-33eacc042cf5",
                                                "sense_id": "0a5e5e25-9082-35ed-acd3-63f6f9fa6d16",
                                                "text": "The big coiled throat and peak halyards were made ready to run, and the mainsheet was put to the winch ready for crotching the boom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea68283c-8062-3c13-8be2-8de728728acf",
                                        "entry_id": "9f2e2c6c-ec59-3763-839c-eaff58bed732",
                                        "glosses": [
                                            "To hang (a rope) over a crotch in a tree so that the ends hang down from opposite sides."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3be13e-2808-4cc3-aff8-1ff103a5d8a3",
                                                "sense_id": "ea68283c-8062-3c13-8be2-8de728728acf",
                                                "text": "The safety sling should be tied immediately after the climber has crotched his rope as high and as close to the trunk as possible."
                                            },
                                            {
                                                "example_id": "7778b041-f846-465c-b147-bb9e714ada80",
                                                "sense_id": "ea68283c-8062-3c13-8be2-8de728728acf",
                                                "text": "If it is necessary, however, to climb directly onto the limb where the rope is crotched, the limb may be approached as shown in Figure 32."
                                            },
                                            {
                                                "example_id": "f2971789-bec1-43d5-ba9c-8b2db40a9580",
                                                "sense_id": "ea68283c-8062-3c13-8be2-8de728728acf",
                                                "text": "The climbing line shall be crotched as soon as practicable after the employee is aloft, and a taut-line hitch tied and checked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa34199d-bb3f-3a58-b712-a48b8e7fb56f",
                                        "entry_id": "9f2e2c6c-ec59-3763-839c-eaff58bed732",
                                        "glosses": [
                                            "To remove overgrown wool from around the eyes of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f764bdd5-3f69-4c82-a2e2-03ad0f1a9e9e",
                                                "sense_id": "aa34199d-bb3f-3a58-b712-a48b8e7fb56f",
                                                "text": "Cattle and sheep purchased by contract for a specific consignee at point of origin, and moving on through billing to points beyond Denver, may be stopped at Denver to be weighed, classified, sorted, inspected, delivered, tagged, faced, crotched, and/or diverted for a charge of $7.50 per car or per truck in lieu of yardage."
                                            },
                                            {
                                                "example_id": "782a1192-6c07-4c5d-8873-d524ee889a2a",
                                                "sense_id": "aa34199d-bb3f-3a58-b712-a48b8e7fb56f",
                                                "text": "My father crotched the ewes before they gave birth, and then played midwife to entire flocks once they started lambing in late April, often with the help of Rusyn peasants who knew just when to show up every year and who seemed fond of my tall, independent father."
                                            },
                                            {
                                                "example_id": "18c1c619-e207-4706-8502-d20b17bbef4d",
                                                "sense_id": "aa34199d-bb3f-3a58-b712-a48b8e7fb56f",
                                                "text": "He was meant to be crotching the sheep that day, and crotching, as is well known in rural circles, is very thirsty work."
                                            },
                                            {
                                                "example_id": "70052b0d-a2cb-46f9-bf60-20ecc32499b5",
                                                "sense_id": "aa34199d-bb3f-3a58-b712-a48b8e7fb56f",
                                                "text": "If you can get your mob marked, crotched and over to Wilga by then, they can be done with mine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8527f2c5-24a7-4127-810e-216775903c3f",
