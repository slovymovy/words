{
    "word_family": [
        "checker",
        "checkbook",
        "chequer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ceccaa7f-2298-3f17-b665-ef1f1d7b344e",
                    "sense_definition": "A written order directing a bank to pay a specific amount of money from a person's account to another person or entity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "banking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not have enough cash in my wallet, so I decided to write a <w>cheque</w> for the full amount.",
                            "target_lang_translations": {
                                "ru": "У меня не было с собой достаточно наличных, поэтому я решил выписать <w>чек</w> на всю сумму."
                            }
                        },
                        {
                            "text": "The shop assistant asked if I wanted to pay by blank <w>cheque</w> or credit card.",
                            "target_lang_translations": {
                                "ru": "Продавец спросил, хочу ли я расплатиться незаполненным <w>чеком</w> или кредитной картой."
                            }
                        }
                    ],
                    "synonyms": [
                        "check"
                    ],
                    "common_phrases": [
                        "blank cheque",
                        "write a cheque",
                        "pay by cheque",
                        "cheque book"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British, Australian, and Canadian spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменное распоряжение банку выплатить определенную сумму денег со счета одного лица другому лицу или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чек",
                                "target_lang_sense_clarification": "банковский документ"
                            },
                            {
                                "target_lang_word": "банковский чек",
                                "target_lang_sense_clarification": "финансовый инструмент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0073c46c-5588-3c37-a825-569308b3953a",
                    "sense_definition": "An obsolete form of <w>chequy</w>, referring to a pattern of alternating colored squares like a chessboard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "patterns",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient coat of arms featured a <w>cheque</w> pattern of red and gold squares.",
                            "target_lang_translations": {
                                "ru": "На древнем гербе был изображен <w>шахматный</w> узор из красных и золотых квадратов."
                            }
                        },
                        {
                            "text": "In the old manuscript, the knight's shield was described as having a <w>cheque</w> border.",
                            "target_lang_translations": {
                                "ru": "В старинной рукописи щит рыцаря описывался как имеющий <w>клетчатую</w> кайму."
                            }
                        }
                    ],
                    "synonyms": [
                        "chequy",
                        "checkered",
                        "checky"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used in historical heraldry"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "replaced by chequy or checkered"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма шахматного узора, состоящего из чередующихся цветных квадратов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шахматный",
                                "target_lang_sense_clarification": "в клетку"
                            },
                            {
                                "target_lang_word": "клетчатый",
                                "target_lang_sense_clarification": "узор"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}