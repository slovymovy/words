                        "examples": [
                            {
                                "example_id": "1a3d6d1b-af02-4361-9e53-9e872c621f87",
                                "sense_id": "08e19e0c-90ed-38cb-b36b-8ce0efce23a6",
                                "text": "Le président sud-coréen Moon Jae-in a confirmé, dans un communiqué, que le projectile lancé jeudi après-midi par Pyongyang en direction de la mer du Japon était un ICBM."
                            },
                            {
                                "example_id": "1697876b-0986-4888-93fc-01274f7f2696",
                                "sense_id": "08e19e0c-90ed-38cb-b36b-8ce0efce23a6",
                                "text": "Pyongyang a conduit une série record d’essais d’armements cette année, notamment de son ICBM le plus avancé."
                            }
                        ]
                    }
                ],
