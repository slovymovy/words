                                        "entry_id": "9eedddee-0ec0-3f3e-89b9-a5e16e5bfcf5",
                                        "glosses": [
                                            "Sénevé sauvage, moutarde des champs ou Sinapis arvensis. Mangé en grande quantité, elle est toxique pour le bétail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0d9318-9e26-432c-b398-4d769c08610e",
                                                "sense_id": "566f95f7-8dec-39bd-bcc9-bba6a9236ce5",
                                                "text": "Les champs d’avoine sont, certaines années, envahis par des plantes nuisibles telles que les chardons, les sanves, moutardes sauvages, ravenelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f8a13c-2855-3b90-9552-290e4f932d90",
                                        "entry_id": "9eedddee-0ec0-3f3e-89b9-a5e16e5bfcf5",
                                        "glosses": [
                                            "Désigne aussi parfois le moutarde blanche ou Sinapis alba."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
