                    }
                ],
                "senses": [
                    {
                        "sense_id": "11971c45-dfcf-35b3-933c-bdee05d9c1d2",
                        "entry_id": "7514b4b2-dc67-3cd7-aa11-df0af4a0f99e",
                        "glosses": [
                            "een sterke, stinkende geur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "886e2db5-61a2-4ff2-893d-8738f9c0ead5",
                                "sense_id": "11971c45-dfcf-35b3-933c-bdee05d9c1d2",
                                "text": "De stank was niet te harden."
                            },
                            {
                                "example_id": "3ffada34-831a-40e2-90ae-789adbd00db7",
                                "sense_id": "11971c45-dfcf-35b3-933c-bdee05d9c1d2",
                                "text": "Er hing een misselijkmakende stank van rottende kadavers in de lucht."
                            },
                            {
                                "example_id": "63e70425-19d4-47ce-a425-84ebc5a2476a",
                                "sense_id": "11971c45-dfcf-35b3-933c-bdee05d9c1d2",
                                "text": "De stank deed vermoeden dat er vroeger duidelijk te veel was gerookt in de kamer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23a7c5df-0637-4050-9f86-e8414a73c0f6",
                        "source_entry_id": "7514b4b2-dc67-3cd7-aa11-df0af4a0f99e",
                        "source_sense_id": "11971c45-dfcf-35b3-933c-bdee05d9c1d2",
                        "source_sense_description": "een sterke, stinkende geur",
                        "target_lang_word": "Gestank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gestank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                        "entry_id": "e0e50b74-15f9-3291-9c2a-60358311e237",
                                        "glosses": [
                                            "übler, unangenehmer Geruch; verstärktes stank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "767319d6-cefc-4d9d-9fad-aa30be9189e1",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "Dieser Gestank ist unausstehlich."
                                            },
                                            {
                                                "example_id": "8b6144a3-f7f9-4cbd-a23a-b63f52bb768c",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "Verfaulte Eier verströmen einen unerträglichen Gestank."
                                            },
                                            {
                                                "example_id": "c06773be-3d14-49fd-a329-ed0935321610",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Den Besuchern schlagen das Dröhnen der Schmieden und der Gestank von Tausend Misthaufen entgegen.“"
                                            },
                                            {
                                                "example_id": "2d719d90-57b1-4542-9c67-f73010517dcf",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Doch sie brauchten nicht lange, um der Armut, dem Gestank und dem Elend zu begegnen.“"
                                            },
                                            {
                                                "example_id": "d61365bd-037c-4a1d-87de-f54e2bf199a2",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Der Gestank allein könnte einen Plazebo-Effekt auslösen wie der Anblick eines Stethoskops.\""
                                            },
                                            {
                                                "example_id": "3901924c-59cc-4aa8-8624-3e9382b0a1ba",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Hier ist die frische Meeresluft mit dem Gestank von Abfällen vermischt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
