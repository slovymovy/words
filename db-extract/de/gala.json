                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "20679836-60ea-433c-9425-fc6a4719be72",
                                "sense_id": "246521c2-b715-37de-9749-9c2c30d0cb80",
                                "text": "Alle Gäste erschienen in Gala beim Empfang des Präsidenten."
                            },
                            {
                                "example_id": "60af1113-920a-4890-950a-739a477f51fd",
                                "sense_id": "246521c2-b715-37de-9749-9c2c30d0cb80",
                                "text": "„Miss Runcible war erschienen und stand in großer Gala in der Hall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f75293c-2007-382a-b4ac-946bc7c660d5",
                        "entry_id": "252f3121-2e33-3c2d-bb22-7691f18c8cbb",
                        "glosses": [
                            "festliche Veranstaltung (bei der man eine Gala^([1]) trägt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6bfdd33-b0e1-40d3-a31d-8e0e8ee54435",
                                "sense_id": "2f75293c-2007-382a-b4ac-946bc7c660d5",
                                "text": "Jedes Jahr veranstaltet sie eine große Gala zugunsten krebskranker Kinder."
                            },
                            {
                                "example_id": "01ec4667-6d5a-479d-8af1-14556f01a7ef",
                                "sense_id": "2f75293c-2007-382a-b4ac-946bc7c660d5",
                                "text": "„Während einer Gala saß er an einem Tisch mit Präsident Wladimir Putin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
