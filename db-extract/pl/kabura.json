                    {
                        "sense_id": "8e4ff290-42ab-33b7-b720-72b7c205c6d5",
                        "entry_id": "cc9c9031-4165-313f-a4c9-2b2df055831c",
                        "glosses": [
                            "futerał, pokrowiec na krótką broń palną, noszony zazwyczaj u pasa, mający zabezpieczenie przed wypadaniem broni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9152d39c-dea0-45c4-9ca6-b7b8b9f8fe8a",
                                "sense_id": "8e4ff290-42ab-33b7-b720-72b7c205c6d5",
                                "text": "Marcinkowski wyciągnął z kabury pod pachą swoją tetetkę i przeładował ją."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "926d0d35-3952-4466-bdf7-6b86d623ebef",
                        "source_entry_id": "cc9c9031-4165-313f-a4c9-2b2df055831c",
                        "source_sense_id": "8e4ff290-42ab-33b7-b720-72b7c205c6d5",
                        "target_lang_word": "holster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab877546-d07c-3813-99b6-a43233e401fd",
                                        "entry_id": "7b3bcc5a-37df-32ca-b7a2-30e69d1585e9",
                                        "glosses": [
                                            "A case for carrying a tool, particularly a gun, safely and accessibly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f11b4d-4183-4efe-a17a-3552666b5a46",
                                                "sense_id": "ab877546-d07c-3813-99b6-a43233e401fd",
                                                "text": "Goring, like himself, had sprang forwards, first snatching a pistol from his holsters, and discharging it at him who seemed to be the chief of the party,—the man reeled and fell; but his fall was instantly avenged."
                                            },
                                            {
                                                "example_id": "f64d86c7-2831-4e17-991b-42065627a588",
                                                "sense_id": "ab877546-d07c-3813-99b6-a43233e401fd",
                                                "text": "Marion Wheeler took the seat, brushing the hem of her suit jacket aside to reveal a concealed holster. \"You do know I carry a gun?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3c0eaf-5832-3779-b922-dd03066af9b7",
                                        "entry_id": "7b3bcc5a-37df-32ca-b7a2-30e69d1585e9",
                                        "glosses": [
                                            "A belt with loops or slots for carrying small tools or other equipment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "holster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8d329c-4aa1-319e-92e8-2a487693abd3",
                                        "entry_id": "75e5151b-5401-3a3e-b206-28cf337c0776",
                                        "glosses": [
                                            "To put something in a holster."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5762319-75cb-4904-b8d8-1061089445cf",
                        "source_entry_id": "cc9c9031-4165-313f-a4c9-2b2df055831c",
                        "source_sense_id": "8e4ff290-42ab-33b7-b720-72b7c205c6d5",
                        "target_lang_word": "holster",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holster",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d982e565-c8d8-387f-b226-416195a931b1",
                                        "entry_id": "d46d2bca-6156-38ae-8575-1d2f44558441",
                                        "glosses": [
                                            "Étui semi-rigide, fixé à la ceinture, près de l'épaule, ou à d'autres endroits, permettant de loger un revolver ou un pistolet et de le rendre facilement accessible par l'utilisateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11112458-7e2f-43e4-8e68-874899f5556a",
                                                "sense_id": "d982e565-c8d8-387f-b226-416195a931b1",
                                                "text": "Fait assez inhabituel, il avait gardé sur sa chemise le harnachement de son holster, ceinturage de cuir toujours un peu impressionnant, qui contrastait avec sa tenue négligée, la chemise fripée, le pantalon de toile fatigué, les pieds nus."
                                            },
                                            {
                                                "example_id": "fd427022-8f84-48d4-a4c6-a9adb688a17d",
                                                "sense_id": "d982e565-c8d8-387f-b226-416195a931b1",
                                                "text": "En même temps, il sortit d’un holster de hanche un pistolet automatique, hurlant : « Où allez-vous ? Que transportez-vous ? », et se mit à débâcher la remorque, à la fouiller en fauchant l’espace avec son arme."
                                            },
                                            {
                                                "example_id": "c3071a9d-ae56-4acb-ba7f-59f3d3f29383",
                                                "sense_id": "d982e565-c8d8-387f-b226-416195a931b1",
                                                "text": "À Berlin, Heinrich Knopf s’est emparé de son Walter PP, qu’il a aussitôt glissé dans son holster, sous sa veste de tergal."
                                            },
                                            {
                                                "example_id": "d79c2163-5fad-4eaa-8b71-85a2c87f63fc",
                                                "sense_id": "d982e565-c8d8-387f-b226-416195a931b1",
                                                "text": "Sous sa veste, un holster invisible gonfle le tissu côté gauche. Un droitier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1465c028-cd87-48ed-81d6-ce802693c507",
                        "source_entry_id": "cc9c9031-4165-313f-a4c9-2b2df055831c",
                        "source_sense_id": "8e4ff290-42ab-33b7-b720-72b7c205c6d5",
                        "target_lang_word": "étui",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étui",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0028e505-416b-395b-becb-11870ddf2df7",
                                        "entry_id": "c648fd34-adfb-39fb-a8db-15d186aa8579",
                                        "glosses": [
                                            "Contenant pour mettre, porter ou conserver un objet, et dont la forme varie selon les objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca64ac1-fd3b-44bd-bfda-72be257373b6",
                                                "sense_id": "0028e505-416b-395b-becb-11870ddf2df7",
                                                "text": "Étui à ciseaux, à couteaux, à aiguilles, à épingles, à lunettes."
                                            },
                                            {
                                                "example_id": "14df0e9a-3424-4a3e-babc-c72d3ff06e70",
                                                "sense_id": "0028e505-416b-395b-becb-11870ddf2df7",
                                                "text": "Étui de harpe."
                                            },
                                            {
                                                "example_id": "c351c286-f82e-4a36-b9ff-e81d169e0c42",
                                                "sense_id": "0028e505-416b-395b-becb-11870ddf2df7",
                                                "text": "Étui de bois, de carton, de cuir, d’or, d’argent, d’ivoire."
                                            },
                                            {
                                                "example_id": "dce1ca86-c786-4846-a087-c32cf1248e80",
                                                "sense_id": "0028e505-416b-395b-becb-11870ddf2df7",
                                                "text": "Amadieu s’esquiva, lorsqu’il eut payé vingt francs, à la princesse Rosemonde, un étui à cigarettes qui valait bien trente sous."
                                            },
                                            {
                                                "example_id": "3ca60d91-555d-47d8-963b-982e511a279a",
                                                "sense_id": "0028e505-416b-395b-becb-11870ddf2df7",
                                                "text": "La perte de cet étui à cigarettes fut la cause d’une nouvelle contrariété dans la vie de Lluís Frederic."
                                            },
                                            {
                                                "example_id": "3b3cee85-2d4a-4324-a1ff-fb8ca35302a0",
                                                "sense_id": "0028e505-416b-395b-becb-11870ddf2df7",
                                                "text": "sur l’étui en plastique de la barre chocolatée se trouvaient plusieurs éléments prouvant qu’il était vieux d’une trentaine d’années : un copyright de 1991, un logo de la Fédération internationale de football association (FIFA) de 1993, et une publicité pour la Coupe du monde de football de 1994, dont l’entreprise Mars était l’un des sponsors officiels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63088c9c-6978-31f9-93f9-388a89822e2b",
                                        "entry_id": "c648fd34-adfb-39fb-a8db-15d186aa8579",
                                        "glosses": [
                                            "Les deux élytres d’un coléoptère."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5850ce40-2132-314b-94df-dab857696b55",
                                        "entry_id": "c648fd34-adfb-39fb-a8db-15d186aa8579",
                                        "glosses": [
                                            "Douille."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64288483-5a92-490d-93b8-7f8a6c2fb2b2",
                                                "sense_id": "5850ce40-2132-314b-94df-dab857696b55",
                                                "text": "Parmi les deux blessés, l’un a été grièvement blessé à la tempe et l’autre, blessé aux jambes, a pris la fuite, a précisé cette source policière. Quatre étuis de 9 mm ont par ailleurs été découverts sur place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
