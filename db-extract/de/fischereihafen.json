                "senses": [
                    {
                        "sense_id": "1d184686-4dd5-33be-bb25-ac0b01e2e6c9",
                        "entry_id": "91dabedb-d0d5-3c74-9a7c-be99195432a5",
                        "glosses": [
                            "Hafen für Fischerboote"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e970a9-be15-44fc-873b-227f0b5b8e1e",
                                "sense_id": "1d184686-4dd5-33be-bb25-ac0b01e2e6c9",
                                "text": "„Spannend nicht nur für Kinder ist auch der Fischereihafen in Hanstholm - einer der größten in Dänemark.“"
                            },
                            {
                                "example_id": "1b1d1086-6b0a-4d7d-816e-19cd4047edc1",
                                "sense_id": "1d184686-4dd5-33be-bb25-ac0b01e2e6c9",
                                "text": "„Aus den deutschen Fischereihäfen Bremerhaven, Cuxhaven, Hamburg-Altona und Kiel laufen in diesen Tagen alle verfügbaren deutschen Fischdampfer – unterstützt von der Flotte der 90 Heringslogger – zur diesjährigen Heringssaison aus.“"
                            },
                            {
                                "example_id": "9f9d15b0-566b-459e-94ff-69cc5dbd7fb2",
                                "sense_id": "1d184686-4dd5-33be-bb25-ac0b01e2e6c9",
                                "text": "„Charakteristischer für den typischen Fischereihafen ist jedoch die Marktfunktion: Treffpunkt zu sein für Angebot und Nachfrage an Fischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
