                    {
                        "sense_id": "aaf3c2d7-cef4-3a73-b357-c666d2f9e60a",
                        "entry_id": "155195b8-f7dc-30fd-b486-a6855618fb8a",
                        "glosses": [
                            "Gesamtheit der Aktivitäten einer Kriegspartei"
