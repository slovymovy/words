                "senses": [
                    {
                        "sense_id": "0799858e-340a-3dcb-984b-706708abe873",
                        "entry_id": "09922fc6-280f-371a-bb04-72e1cbee1328",
                        "glosses": [
                            "Eigenschaft eines Wortes einer Sprache (Paronym), das einem Wort einer anderen Sprache lautlich (phonetisch) ähnlich ist und die gleiche Bedeutung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c23fa67-3e45-485c-9232-ce30baeb83ac",
                                "sense_id": "0799858e-340a-3dcb-984b-706708abe873",
                                "text": "„Sind zwei ursprungsverschiedene Wörter gleichlautend, so nennt man dies eine Homonymie (sind sie nicht ganz gleichlautend, eine Paronymie).“"
                            },
                            {
                                "example_id": "4cbbbd60-853d-4fcf-a2ef-9fdcb5045513",
                                "sense_id": "0799858e-340a-3dcb-984b-706708abe873",
                                "text": "„Von begrifflicher Seite ist die Paronymie definitorisch bislang nicht eindeutig festgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "71e7d647-6b12-37e1-99a4-7a5ad6a8f76a",
                        "entry_id": "09922fc6-280f-371a-bb04-72e1cbee1328",
                        "glosses": [
                            "Eigenschaft eines Wortes (Paronym), das morphologisch teilweise mit einem anderen übereinstimmt, aber eine andere Bedeutung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7ec2f2-e80b-4923-a2d2-0bad9ccfcd59",
                                "sense_id": "71e7d647-6b12-37e1-99a4-7a5ad6a8f76a",
                                "text": "„Sind zwei ursprungsverschiedene Wörter gleichlautend, so nennt man dies eine Homonymie (sind sie nicht ganz gleichlautend, eine Paronymie).“"
                            },
                            {
                                "example_id": "b4f5fb44-2fa6-4199-b791-0ee36dcd6144",
                                "sense_id": "71e7d647-6b12-37e1-99a4-7a5ad6a8f76a",
                                "text": "„Von begrifflicher Seite ist die Paronymie definitorisch bislang nicht eindeutig festgelegt.“"
                            },
                            {
                                "example_id": "29167ece-bf23-4895-9e1c-e0553ba3f6d2",
                                "sense_id": "71e7d647-6b12-37e1-99a4-7a5ad6a8f76a",
                                "text": "„Die gebrauchsorientierte Erforschung der Paronymie wirft neue Fragestellungen auf beziehungsweise beleuchtet einige lexikalisch-semantische Forschungsaspekte neu.“"
                            },
                            {
                                "example_id": "fb73137a-3534-47b1-ac6d-7f5bf297e3c5",
                                "sense_id": "71e7d647-6b12-37e1-99a4-7a5ad6a8f76a",
                                "text": "„Ziel dieses Projekts ist die linguistische und lexikografische Neubetrachtung der Paronymie, indem sie korpusanalytisch erforscht und theoretisch begründet wird, aber auch in einem elektronischen Nachschlagewerk mit kontrastiven Einträgen (innerhalb von OWID) dokumentiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
