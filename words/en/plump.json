{
    "word_family": [
        "plumpness",
        "plumper",
        "plumply"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b5251a56-d540-3698-850d-f2596092b538",
                    "sense_definition": "Having a full and rounded shape; pleasantly chubby or filled out.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "full_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby had delightfully <w>plump</w> cheeks that made everyone smile.",
                            "target_lang_translations": {
                                "pl": "Dziecko miało uroczo <w>pulchne</w> policzki, które wywoływały uśmiech u każdego."
                            }
                        },
                        {
                            "text": "We picked several sweet and <w>plump</w> berries from the bushes in the garden.",
                            "target_lang_translations": {
                                "pl": "Zerwaliśmy z krzaków w ogrodzie kilka słodkich i <w>dorodnych</w> jagód."
                            }
                        }
                    ],
                    "antonyms": [
                        "skinny",
                        "thin"
                    ],
                    "common_phrases": [
                        "plump cheeks",
                        "plump berries"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający pełny i zaokrąglony kształt; pulchny, dorodny lub soczysty."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pulchny",
                                "target_lang_sense_clarification": "o ciele, policzkach"
                            },
                            {
                                "target_lang_word": "dorodny",
                                "target_lang_sense_clarification": "o owocach, postaci"
                            },
                            {
                                "target_lang_word": "okrągły",
                                "target_lang_sense_clarification": "o kształtach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1145c90b-0ea2-325c-b907-8956a92b805f",
                    "sense_definition": "Direct, blunt, and without hesitation or reservation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He answered the difficult inquiry with a <w>plump</w> denial.",
                            "target_lang_translations": {
                                "pl": "Na trudne pytanie odpowiedział <w>kategorycznym</w> zaprzeczeniem."
                            }
                        },
                        {
                            "text": "She gave a <w>plump</w> refusal when asked to cooperate with the team.",
                            "target_lang_translations": {
                                "pl": "Udzieliła <w>stanowczej</w> odmowy, kiedy poproszono ją o współpracę z zespołem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used rarely in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bezpośredni, kategoryczny i pozbawiony wahania."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stanowczy",
                                "target_lang_sense_clarification": "o odmowie lub zaprzeczeniu"
                            },
                            {
                                "target_lang_word": "kategoryczny",
                                "target_lang_sense_clarification": "bez wahania"
                            },
                            {
                                "target_lang_word": "otwarty",
                                "target_lang_sense_clarification": "bezpośredni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fa8211e-6232-396a-b775-742f72452cef",
                    "sense_definition": "To make something rounded, fuller, or puffed up, frequently used with the particle 'up'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "make_plump",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a moment to <w>plump</w> the cushions before the guests arrived.",
                            "target_lang_translations": {
                                "pl": "Zanim nadeszli goście, poświęciła chwilę, by <w>roztrzepać</w> poduszki."
                            }
                        },
                        {
                            "text": "He shook the duvet vigorously to <w>plump</w> up the feathers inside.",
                            "target_lang_translations": {
                                "pl": "Mocno potrząsnął kołdrą, aby <w>spulchnić</w> znajdujące się w środku pierze."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plump up pillows",
                        "plump cushions"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nadawać czemuś bardziej zaokrąglony, pełny lub puszysty kształt (np. poduszce)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "roztrzepywać",
                                "target_lang_sense_clarification": "poduszki, pierzyny"
                            },
                            {
                                "target_lang_word": "spulchniać",
                                "target_lang_sense_clarification": "nadawać puszystość"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af812ae5-3a30-3690-8a6b-d4de6e62c622",
                    "sense_definition": "To choose or decide firmly in favor of someone or something, usually followed by 'for'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After looking at all the options, she decided to <w>plump</w> for the cheaper hotel.",
                            "target_lang_translations": {
                                "pl": "Po przeanalizowaniu wszystkich opcji postanowiła <w>zdecydować się na</w> tańszy hotel."
                            }
                        },
                        {
                            "text": "Most voters seem likely to <w>plump</w> for the independent candidate this time.",
                            "target_lang_translations": {
                                "pl": "Wygląda na to, że większość wyborców tym razem <w>opowie się za</w> niezależnym kandydatem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plump for"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zdecydować się na kogoś lub na coś, dokonać stanowczego wyboru (zazwyczaj z 'for')."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdecydować się na",
                                "target_lang_sense_clarification": "wybrać coś po namyśle"
                            },
                            {
                                "target_lang_word": "opowiedzieć się za",
                                "target_lang_sense_clarification": "poprzeć kandydata lub opcję"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f805b283-799c-3b81-bfd7-3aa7ac27f506",
                    "sense_definition": "To become rounder, fuller, or swollen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "make_plump",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dried raisins will gradually swell and <w>plump</w> when soaked in warm water.",
                            "target_lang_translations": {
                                "pl": "Suszone rodzynki stopniowo napęcznieją i <w>zaokrąglą się</w>, gdy namoczy się je w ciepłej wodzie."
                            }
                        },
                        {
                            "text": "Her cheeks began to <w>plump</w> after a few weeks of good nutrition.",
                            "target_lang_translations": {
                                "pl": "Po kilku tygodniach dobrego odżywiania jej policzki zaczęły <w>się zaokrąglać</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Stawać się bardziej okrągłym, pełnym lub nabrzmiewać."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zaokrąglać się",
                                "target_lang_sense_clarification": "np. o ciele, policzkach"
                            },
                            {
                                "target_lang_word": "pęcznieć",
                                "target_lang_sense_clarification": "np. o namoczonych owocach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fda0a7e-9236-3463-95b8-c0f15be31e72",
                    "sense_definition": "To drop, fall, or sit down heavily and suddenly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drop_heavily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Exhausted from the long journey, he collapsed and <w>plumped</w> into the armchair.",
                            "target_lang_translations": {
                                "pl": "Wycieńczony długą podróżą opadł z sił i <w>klapnął</w> w fotel."
                            }
                        },
                        {
                            "text": "The cat jumped off the table and <w>plumped</w> onto the soft rug below.",
                            "target_lang_translations": {
                                "pl": "Kot zeskoczył ze stołu i <w>wylądował ciężko</w> na miękkim dywanie poniżej."
                            }
                        }
                    ],
                    "synonyms": [
                        "slump"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used casually when describing falling heavily."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Upaść, osunąć się lub usiąść ciężko i gwałtownie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "klapnąć",
                                "target_lang_sense_clarification": "ciężko usiąść"
                            },
                            {
                                "target_lang_word": "runąć",
                                "target_lang_sense_clarification": "upaść bezwładnie"
                            },
                            {
                                "target_lang_word": "opadać",
                                "target_lang_sense_clarification": "bezwładnie opadać na coś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea10a94e-230a-3af0-b8cf-3ca3fca70e69",
                    "sense_definition": "To cast, set, or drop something down abruptly and with force.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drop_heavily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked over and <w>plumped</w> the heavy bag of groceries onto the counter.",
                            "target_lang_translations": {
                                "pl": "Podeszła i <w>rzuciła z impetem</w> ciężką torbę z zakupami na blat."
                            }
                        },
                        {
                            "text": "He took the documents and carelessly <w>plumped</w> them in front of the lawyer.",
                            "target_lang_translations": {
                                "pl": "Wziął dokumenty i niedbale <w>cisnął</w> je przed prawnikiem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rzucić lub postawić coś gwałtownie i z impetem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ciapnąć",
                                "target_lang_sense_clarification": "rzucić coś niedbale"
                            },
                            {
                                "target_lang_word": "rzucić z hukiem",
                                "target_lang_sense_clarification": "niedbale położyć z impetem"
                            },
                            {
                                "target_lang_word": "cisnąć",
                                "target_lang_sense_clarification": "gwałtownie rzucić"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3523a27-55ef-3ee5-9ac3-96603a4c2db8",
                    "sense_definition": "To cast all of one's available votes for a single candidate instead of dividing them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vote",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Electors were permitted to split their votes or <w>plump</w> for one favourite.",
                            "target_lang_translations": {
                                "pl": "Wyborcom wolno było podzielić swoje głosy lub <w>oddać wszystkie na</w> jednego faworyta."
                            }
                        },
                        {
                            "text": "Rather than dividing his support, the voter resolved to <w>plump</w>.",
                            "target_lang_translations": {
                                "pl": "Zamiast rozpraszać swoje poparcie, wyborca postanowił <w>skumulować wszystkie głosy na jednym kandydacie</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical voting procedures."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Oddać wszystkie przysługujące głosy na jednego kandydata zamiast je rozdzielić."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oddać wszystkie głosy na jednego kandydata",
                                "target_lang_sense_clarification": "w dawnym systemie wyborczym"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f00e9564-3e66-34fe-bf6d-740b575090d6",
                    "sense_definition": "A dull, heavy, or sudden sound made by a falling object.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book fell from the top shelf with a heavy <w>plump</w> onto the carpet.",
                            "target_lang_translations": {
                                "pl": "Książka spadła z najwyższej półki na dywan z głuchym <w>łupnięciem</w>."
                            }
                        },
                        {
                            "text": "A sudden <w>plump</w> was heard as the sack dropped into the mud.",
                            "target_lang_translations": {
                                "pl": "Usłyszano nagły <w>plask</w>, gdy worek wpadł w błoto."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Głuchy, ciężki odgłos upadku przedmiotu; plask lub łupnięcie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "plask",
                                "target_lang_sense_clarification": "odgłos uderzenia o miękką lub mokrą powierzchnię"
                            },
                            {
                                "target_lang_word": "łupnięcie",
                                "target_lang_sense_clarification": "głuchy odgłos upadku"
                            },
                            {
                                "target_lang_word": "pacnięcie",
                                "target_lang_sense_clarification": "dźwięk miękkiego upadku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4d92c0f-bce9-358a-8208-b5517f9e4e35",
                    "sense_definition": "A compact group, cluster, or crowd of people, animals, or objects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cluster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Through the dense fog, we could see a small <w>plump</w> of trees standing together.",
                            "target_lang_translations": {
                                "pl": "Przez gęstą mgłę dostrzegliśmy małą <w>kępę</w> rosnących razem drzew."
                            }
                        },
                        {
                            "text": "A dense <w>plump</w> of spears appeared on the hill as the soldiers advanced.",
                            "target_lang_translations": {
                                "pl": "Na wzgórzu pojawił się gęsty <w>las</w> włóczni, gdy żołnierze ruszyli do przodu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in contemporary English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zbita gromada, skupisko lub kępa ludzi, zwierząt bądź przedmiotów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kępa",
                                "target_lang_sense_clarification": "drzew, roślinności"
                            },
                            {
                                "target_lang_word": "gromada",
                                "target_lang_sense_clarification": "grupa ludzi lub zwierząt"
                            },
                            {
                                "target_lang_word": "skupisko",
                                "target_lang_sense_clarification": "grupa przedmiotów"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b997a78b-396a-3eaa-bb9d-d50eeac61e49",
                    "sense_definition": "Directly, abruptly, or with a sudden heavy impact.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball flew through the broken window and landed <w>plump</w> into the soup.",
                            "target_lang_translations": {
                                "pl": "Piłka wleciała przez rozbite okno i wpadła <w>prosto</w> do zupy."
                            }
                        },
                        {
                            "text": "He turned the dark corner quickly and ran <w>plump</w> into the headmaster.",
                            "target_lang_translations": {
                                "pl": "Szybko skręcił za ciemny róg i wpadł <w>wprost</w> na dyrektora."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used adverbially to emphasize direct impact."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Prosto, bezpośrednio i z impetem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prosto",
                                "target_lang_sense_clarification": "bezpośrednio w coś"
                            },
                            {
                                "target_lang_word": "wprost",
                                "target_lang_sense_clarification": "dokładnie na coś"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a6b80575-c800-3234-af82-5c77adcfd543",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Doctor <w>Plump</w> delivered an inspiring lecture on historical linguistics yesterday.",
                            "target_lang_translations": {
                                "pl": "Doktor <w>Plump</w> wygłosił wczoraj inspirujący wykład na temat językoznawstwa historycznego."
                            }
                        },
                        {
                            "text": "The library dedicated an entire wing to honour the generous donation from Mrs <w>Plump</w>.",
                            "target_lang_translations": {
                                "pl": "Biblioteka zadedykowała całe skrzydło, by upamiętnić hojną darowiznę od pani <w>Plump</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko pochodzenia niemieckiego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Plump",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}