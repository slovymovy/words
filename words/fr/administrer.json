            "pos": "verb",
            "senses": [
                {
                    "sense_id": "145e6a5c-cbcf-3765-9b8a-e5240b646dca",
                    "sense_definition": "Diriger, gérer les affaires publiques, une organisation ou des biens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau directeur doit <w>administrer</w> cette entreprise avec beaucoup de rigueur."
                        },
                        {
                            "text": "Elle a appris à <w>administrer</w> les biens de sa famille avec sagesse."
                        }
                    ],
                    "synonyms": [
                        "diriger",
                        "gérer",
                        "régir"
                    ],
                    "common_phrases": [
                        "administrer les biens",
                        "administrer un territoire"
                    ]
                },
                {
                    "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                    "sense_definition": "Faire prendre un médicament ou appliquer un traitement ; infliger un coup.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière va <w>administrer</w> un calmant au patient pour soulager sa douleur."
                        },
                        {
                            "text": "En colère, le joueur a voulu <w>administrer</w> une gifle à son adversaire."
                        }
                    ],
                    "synonyms": [
                        "appliquer",
                        "dispenser",
                        "infliger"
                    ],
                    "common_phrases": [
                        "administrer un traitement",
                        "administrer une dose",
                        "administrer une fessée"
                    ]
                },
                {
                    "sense_id": "57f3b4b2-4969-37bc-8d00-e7da783465a0",
                    "sense_definition": "Faire passer ou soumettre à un examen, un test ou un questionnaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur va <w>administrer</w> une épreuve écrite à tous les candidats."
                        },
                        {
                            "text": "Les chercheurs ont décidé d'<w>administrer</w> ce questionnaire à plusieurs groupes d'élèves."
                        }
                    ],
                    "synonyms": [
                        "faire passer"
                    ],
                    "common_phrases": [
                        "administrer une épreuve",
                        "administrer un questionnaire",
                        "administrer un test"
                    ]
                },
                {
                    "sense_id": "e5f54e84-d366-30f6-9a9e-b8486672ba1b",
                    "sense_definition": "Fournir ou produire un élément de preuve ou une justification en justice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat de la défense n'a pas réussi à <w>administrer</w> la preuve de son innocence."
                        },
                        {
                            "text": "Il est indispensable d'<w>administrer</w> des pièces convaincantes devant le tribunal."
                        }
                    ],
                    "synonyms": [
                        "apporter",
                        "fournir",
                        "produire"
                    ],
                    "common_phrases": [
                        "administrer la preuve",
                        "administrer des preuves"
                    ]
                },
                {
                    "sense_id": "84a7979c-ccd9-3185-b39b-7b55223d95cb",
                    "sense_definition": "Donner ou conférer les sacrements religieux à un fidèle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre est venu d'urgence pour <w>administrer</w> les derniers sacrements au mourant."
                        },
                        {
                            "text": "Seuls les membres du clergé ont le droit d'<w>administrer</w> ce sacrement."
                        }
                    ],
                    "synonyms": [
                        "conférer",
                        "donner"
                    ],
                    "common_phrases": [
                        "administrer les sacrements",
                        "administrer l'extrême-onction"
                    ]
                }
            ]
        }
    ]
