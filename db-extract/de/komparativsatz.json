                "senses": [
                    {
                        "sense_id": "5c1773b7-e5b4-35be-9c7e-3966460b5749",
                        "entry_id": "1856ceca-551b-334a-89ad-3956505fd4e9",
                        "glosses": [
                            "untergeordneter Teilsatz, Adverbialsatz, der einen Vergleich zu dem, was im übergeordneten Teilsatz ausgedrückt wird, herstellt und häufig durch als oder wie eingeleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5cdbce7-3eeb-4fef-9936-4f2bc09802c6",
                                "sense_id": "5c1773b7-e5b4-35be-9c7e-3966460b5749",
                                "text": "In dem Satz: „Er wurde empfangen, wie wenn ein verlorener Sohn nach langer Abwesenheit wieder in den Schoß der Familie zurückkehrt“ ist „wie wenn ein verlorener Sohn nach langer Abwesenheit wieder in den Schoß der Familie zurückkehrt“ ein Komparativsatz und „Er wurde empfangen“ der übergeordnete Teilsatz (Matrixsatz/Trägersatz)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
