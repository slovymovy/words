                "translations": [
                    {
                        "translation_id": "244499b9-3152-493c-86b4-3cf65825c479",
                        "source_entry_id": "609efc57-d35e-3ceb-9698-f20f78a4569b",
                        "source_sense_id": "b64d6c19-f611-3998-9d28-08cbea56c3a9",
                        "source_sense_description": "vlaskam",
                        "target_lang_word": "Riffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Riffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                        "entry_id": "9615e245-8ff5-3e9a-b191-be702ad19836",
                                        "glosses": [
                                            "in einer Oberfläche die abwechselnde Vertiefung und Erhöhung, oft in Reihen"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "693e1679-2a31-41cd-9c37-97c64213893c",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "„Doch beim rasanten Ausdehnen des Kosmos während der Inflationsphase sind Gravitationswellen entstanden, kleine Riffel in Raum und Zeit, die den Weltraum kurzzeitig etwas erbeben lassen.“"
                                            },
                                            {
                                                "example_id": "7a18d682-889e-4f59-9fbe-cfd3ce342d18",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "Riffel auf Schienen, auf denen ein Zug drüberfährt, erzeugen einen ungeheuren Lärm."
                                            },
                                            {
                                                "example_id": "85f6b1c9-06b0-4a24-a6ca-2e0eff16d3f2",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "„Kleine Unebenheiten in der Schiene, sogenannte Riffel, lassen die Waggons leicht ruckeln und schwanken […].“"
                                            },
                                            {
                                                "example_id": "643c09fb-4f48-412f-bc20-7c0fdfbde2ac",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "„Eine weiße Tagesdecke mit feinen Riffeln liegt über jedem der beiden Betten […].“"
                                            },
                                            {
                                                "example_id": "d418912d-dc30-4ddc-bb85-27d4f760756d",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "[In der Mühle] „zermahlen Walzen mit unzähligen Riffeln das Korn.“"
                                            },
                                            {
                                                "example_id": "c08d9386-b9c4-44e8-b659-273f27a489f7",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "„Warum sind fast alle Glasflaschen am unteren Rand geriffelt? Die Riffel verhindern , dass sich eine Flasche am Tisch quasi \"festsaugt\".“"
                                            },
                                            {
                                                "example_id": "3d83860a-5b73-4a43-b039-3088b132cc09",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "[Blindheit:] „[…] es [dauerte] Monate, bis auf den Marmorboden unauffällige, aber wunderbar tastbare gummierte Riffel geklebt wurden, die zum einzigen Aufzug mit Sprachansage führen.“"
                                            },
                                            {
                                                "example_id": "9c20b7b0-bb33-41ef-9965-2f048b260aec",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "„»[…] Unser Gold, das wir suchen, ist 19-mal schwerer als Wasser und wird unten an den Pfannenboden kommen. Jetzt schüttel‘ ich das nach vorn in die vordere Kante, um dann in einem späteren Schritt das leichte, große Material nach vorne über diese Riffel abzuwaschen.«“"
                                            },
                                            {
                                                "example_id": "f28f0085-929d-43fc-b7c6-ae0ae19db1b4",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "[Planet Mars:] „Auf den Bildern konnten die Forscher die Wanderung von Sandriffeln auf den Dünen analysieren. Demnach wandern die Riffel regelmäßig, auch über kurze Perioden von wenigen Tagen hinweg.“"
                                            },
                                            {
                                                "example_id": "2c9713f8-3e50-4cc8-8fcb-f290974dd0fe",
                                                "sense_id": "eb408998-b1f0-32dc-abe6-8f08228c1b39",
                                                "text": "„Die Astronomen träumen von neuartigen Teleskopen, die nicht Licht empfangen, sondern Gravitationswellen messen – kleine Riffel im Raum, die von massereichen kompakten Objekten wie Schwarzen Löchern ausgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db6220e2-bd61-31d6-9754-18b3b0a82ba5",
                                        "entry_id": "9615e245-8ff5-3e9a-b191-be702ad19836",
                                        "glosses": [
                                            "kammartiges Werkzeug zur Gewinnung von Flachs oder Früchten (beispielsweise Blaubeeren, Heidelbeeren, Preiselbeeren) an Sträuchern"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6492324-7176-41fb-9080-35d9aea0601b",
                        "source_entry_id": "609efc57-d35e-3ceb-9698-f20f78a4569b",
