                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "recintato",
                                "target_lang_sense_clarification": "riferito a un'area o uno spazio chiuso da una recinzione"
                            },
                            {
                                "target_lang_word": "chiuso",
                                "target_lang_sense_clarification": "riferito a uno spazio delimitato da barriere"
                            }
