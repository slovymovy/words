{
    "word_family": [
        "pest",
        "pesten",
        "verpester",
        "verpesting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c81cf28-2341-3f77-973a-af98270b51a8",
                    "sense_definition": "Ervoor zorgen dat iets niet leuk of gezellig meer is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verpesten_ruineren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn slechte humeur kon de hele sfeer op het feestje <w>verpesten</w>.",
                            "target_lang_translations": {
                                "en": "His bad mood could <w>ruin</w> the whole atmosphere at the party."
                            }
                        },
                        {
                            "text": "Laat die kleine ruzie de vakantie niet <w>verpesten</w>.",
                            "target_lang_translations": {
                                "en": "Don't let that little argument <w>spoil</w> the holiday."
                            }
                        }
                    ],
                    "synonyms": [
                        "verknoeien"
                    ],
                    "common_phrases": [
                        "de sfeer verpesten",
                        "het feestje verpesten"
                    ],
                    "target_lang_definitions": {
                        "en": "To ensure that something is no longer fun, pleasant, or enjoyable; to ruin the atmosphere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "to spoil an experience or atmosphere"
                            },
                            {
                                "target_lang_word": "spoil",
                                "target_lang_sense_clarification": "to make something less enjoyable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a367ce-91fb-3cfa-a948-ccd822fed22e",
                    "sense_definition": "Iets grondig beschadigen of onbruikbaar maken; vernielen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verpesten_ruineren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De harde regen heeft de hele oogst van de boer <w>verpest</w>.",
                            "target_lang_translations": {
                                "en": "The heavy rain has <w>ruined</w> the farmer's entire harvest."
                            }
                        },
                        {
                            "text": "Als je die instructies niet volgt, kun je de machine volledig <w>verpesten</w>.",
                            "target_lang_translations": {
                                "en": "If you don't follow those instructions, you could completely <w>wreck</w> the machine."
                            }
                        }
                    ],
                    "synonyms": [
                        "verknoeien"
                    ],
                    "common_phrases": [
                        "de oogst verpesten"
                    ],
                    "target_lang_definitions": {
                        "en": "To thoroughly damage or make unusable; to destroy or ruin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "to physically damage or destroy"
                            },
                            {
                                "target_lang_word": "wreck",
                                "target_lang_sense_clarification": "to severely damage or destroy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eab429e0-aaa5-3493-82a2-3ac2d53d44a5",
                    "sense_definition": "Een taak of situatie door onhandigheid of fouten volledig mislukken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verpesten_ruineren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik was zo zenuwachtig dat ik mijn hele presentatie heb <w>verpest</w>.",
                            "target_lang_translations": {
                                "en": "I was so nervous that I <w>screwed up</w> my entire presentation."
                            }
                        },
                        {
                            "text": "Hij was bang dat hij zijn kansen op de baan zou <w>verpesten</w>.",
                            "target_lang_translations": {
                                "en": "He was afraid he would <w>ruin</w> his chances of getting the job."
                            }
                        }
                    ],
                    "synonyms": [
                        "verknoeien"
                    ],
                    "common_phrases": [
                        "je kansen verpesten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal spoken language to mean screwing up."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To completely fail a task or situation due to clumsiness, mistakes, or poor performance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "screw up",
                                "target_lang_sense_clarification": "to make a mess of a situation or task"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "to spoil one's chances or performance"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "to fail an opportunity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49fcefff-7b5a-333b-a439-95a6ce715676",
                    "sense_definition": "Met ziektekiemen of gifstoffen besmetten of onzuiver maken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "besmetten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fabriek heeft met haar afvalwater de hele rivier <w>verpest</w>.",
                            "target_lang_translations": {
                                "en": "The factory has <w>polluted</w> the entire river with its wastewater."
                            }
                        },
                        {
                            "text": "De lucht in deze kamer is door de rook volledig <w>verpest</w>.",
                            "target_lang_translations": {
                                "en": "The air in this room is completely <w>ruined</w> by the smoke."
                            }
                        }
                    ],
                    "synonyms": [
                        "besmetten"
                    ],
                    "common_phrases": [
                        "de lucht verpesten"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "In the literal sense of infecting or poisoning, this word is somewhat dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To contaminate or pollute with germs, toxins, or impurities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pollute",
                                "target_lang_sense_clarification": "to contaminate water or air"
                            },
                            {
                                "target_lang_word": "contaminate",
                                "target_lang_sense_clarification": "to make impure by exposure to poison or germs"
                            },
                            {
                                "target_lang_word": "infect",
                                "target_lang_sense_clarification": "to contaminate with pathogens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}