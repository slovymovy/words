                        "glosses": [
                            "Soulager d’un handicap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8923fe-7b3c-42c1-a01a-f9e302345c73",
                                "sense_id": "e2cc8423-822d-3490-b63a-47760ffb44d3",
                                "text": "Il apparaissait enfin que le loisir, soit est banni, soit ne serait pas encore inventé, l’idée semblant n’être venue à personne que le loisir « déshandicape »."
                            },
                            {
                                "example_id": "c08d678d-03b4-4813-b841-c68370b1cf80",
                                "sense_id": "e2cc8423-822d-3490-b63a-47760ffb44d3",
                                "text": "Déshandicaper consiste à sortir le sujet amputé de la situation d’iniquité motrice qu’il subit pour le rendre plus actif et autonome en transformant son handicap en une situation nouvelle par l’équipement d’une prothèse qui va lui permettre de réunifier son schéma corporel."
                            },
                            {
                                "example_id": "0ef204b4-0eac-4d00-826b-efe7a02ad965",
                                "sense_id": "e2cc8423-822d-3490-b63a-47760ffb44d3",
                                "text": "Ce concept a pour but de « déshandicaper » la personne atteinte de cécité."
                            }
                        ]
                    }
