                                                "example_id": "fa278f4f-746b-4e4c-9863-42c063ea14ca",
                                                "sense_id": "c7de7d92-57e0-3b49-9593-6c3fb8c95b31",
                                                "text": "„Ein Glatzkopf und ein Stotterer begegnen sich auf der Straße."
                                            }
