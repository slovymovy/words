                        "glosses": [
                            "Taguer un message à l’aide d’un hashtag inclus dans le message lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a9f49c-bd14-49c0-82a2-b85e1545e6e3",
                                "sense_id": "44c034e3-2731-310f-9ef0-764ec042af03",
                                "text": "La story publiée sur Instagram le 18 novembre par une influenceuse dénonçant le refus qui lui aurait été fait d’entrer au Louvre à cause de sa tenue est l’occasion de rappeler que cette institution est le musée européen le plus « hastaggé »"
                            },
                            {
                                "example_id": "8d52f1e1-87ae-4ad6-997c-ec85e6bba3c7",
                                "sense_id": "44c034e3-2731-310f-9ef0-764ec042af03",
                                "text": "Moi j'aime bien hastagger, ça donne une certaine vivacité à mes posts."
                            },
                            {
                                "example_id": "2780a3e4-f5da-4308-9c0f-b0fb5ad4c983",
                                "sense_id": "44c034e3-2731-310f-9ef0-764ec042af03",
                                "text": "Ah mais si elle veut hastagger des trucs de foot, vais pas pouvoir faire grand chose!"
                            }
                        ]
