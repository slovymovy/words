                                        "sense_id": "0c34bda3-d1f4-3e63-a1c1-44cb16d5bfb8",
                                        "entry_id": "0d6def0e-a9da-3115-a0cc-17ef07ad9880",
                                        "glosses": [
                                            "allmählich, in voneinander getrennten, aufeinanderfolgenden Schritten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e91890-80f8-4557-9baa-1539d3b360a5",
                                                "sense_id": "0c34bda3-d1f4-3e63-a1c1-44cb16d5bfb8",
                                                "text": "„Wer länger arbeitet, erhält dafür aber auch einen höheren ZF. Achtung: Von 2012 an wird die Altersgrenze stufenweise angehoben. Wer 1947 geboren wurde, muss einen Monat länger arbeiten, wer 1948 geboren wurde, zwei Monate länger, und so weiter.“"
                                            },
                                            {
                                                "example_id": "979e7686-325c-4121-8677-f336505ca8f4",
                                                "sense_id": "0c34bda3-d1f4-3e63-a1c1-44cb16d5bfb8",
                                                "text": "Der Unterricht schreitet stufenweise fort."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "stufenweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab182087-d1f6-30f5-82d6-b7a18196fd02",
                                        "entry_id": "413d59f7-a207-3269-82a6-684596f6436e",
                                        "glosses": [
                                            "in Stufen vorgenommen, allmählich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d906e3-5089-4798-a8c8-fd474083ca75",
                                                "sense_id": "ab182087-d1f6-30f5-82d6-b7a18196fd02",
                                                "text": "Ein stufenweises Vorgehen ist angeraten."
                                            },
                                            {
                                                "example_id": "f6ec8e7a-3818-4177-b6d9-b8c2b066849c",
                                                "sense_id": "ab182087-d1f6-30f5-82d6-b7a18196fd02",
                                                "text": "„Sie weisen ferner eine stufenweise Struktur auf, die sowohl der Bestimmung der Prozessreife als auch der Planung der Prozessverbesserung dient.“"
                                            },
                                            {
                                                "example_id": "36d6d5c7-5e9a-4476-9c40-bc651ba2c867",
                                                "sense_id": "ab182087-d1f6-30f5-82d6-b7a18196fd02",
                                                "text": "„Sehr anschaulich stellt die Linie, welche von der Eisenbahnstastion [sic] Jewe (142') über Post Jewe, Eichenhain, Kurtna und Eddifer nach der Kapelle Bogorodiza (228') führt, das stufenweise Relief der Böschung dar, denn hier hat der Wellenschlag des alten Narwaschen Meerbusens weicheres Material zur Modellirung nach seiner Art angetroffen.“"
                                            },
                                            {
                                                "example_id": "67c5b157-eb08-4714-be62-be23780bfcf7",
                                                "sense_id": "ab182087-d1f6-30f5-82d6-b7a18196fd02",
                                                "text": "„Er plädiert für eine stufenweise Struktur der universitären Literaturversorgung: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
