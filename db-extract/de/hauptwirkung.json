                ],
                "senses": [
                    {
                        "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                        "entry_id": "25cfced6-ae6d-3b14-aa50-45a2db9adcb1",
                        "glosses": [
                            "größter, ausschlaggebendster Effekt von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1528acfc-e0ab-47bc-87bf-bda18ef7d75c",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Nach den allgemeinen Grundsätzen der Mechanik läßt sich hieraus allein schon auf eine Verminderung des beabsichtigten Effektes schließen; denn wenn unbeabsichtigte Nebenwirkungen entstehen, so geht an der Hauptwirkung verloren.“"
                            },
                            {
                                "example_id": "d1aae3de-97c6-4ae4-a4da-28c434add190",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Nebenwirkung[:] Hiermit werden alle weiteren Wirkungen neben der Hauptwirkung bezeichnet, die ein Medikament verursacht.“"
                            },
                            {
                                "example_id": "d28af04d-ac7c-48b5-9010-4f5e8638631c",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Anhand der bestimmungsgemäßen Hauptwirkung erfolgt Abgrenzung zwischen den Medizinprodukten und Arzneimitteln (vgl.“"
                            },
                            {
                                "example_id": "6b33a448-144f-4798-b2b4-b46c836c6ef6",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Antidepressiva haben wie die meisten Medikamente eine gewünschte Hauptwirkung und mögliche unerwünschte Nebenwirkungen.“"
                            },
                            {
                                "example_id": "3f720d2f-61e7-48c4-a496-811c0ed53fec",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Die Hauptwirkung wird noch nicht hinterfragt, denn aus Sicherheitsgründen erfolgt die Prüfung in dieser Phase an gesunden Freiwilligen.“"
                            },
                            {
                                "example_id": "25252ba6-64a6-4f75-b91b-733ffde6b845",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Nach den Anschauungen von Leonidas van Praag und Danilewsky besteht eine Hauptwirkung des Giftes auf das Gehirn und Rückenmark.“"
                            },
                            {
                                "example_id": "be41edff-615c-4b5b-a109-c502e6d4451c",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Jörg Timm, Leiter des Instituts für Virologie an der Uniklinik Düsseldorf, kommentierte den Ausbruch und das Wohlbefinden der Bewohner so: ‚Genau das ist die erhoffte Hauptwirkung von Impfstoffen, damit die Infektion medizinisch beherrschbar bleibt und Menschen nach einer Ansteckung nicht schwer erkranken.‘“"
                            },
                            {
                                "example_id": "fcb520cd-3dff-46b6-a2d2-85e50d173f51",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Die Hauptwirkung der Hagebutte beruht aber auf ihrem hohen Vitamin-C-Gehalt.“"
                            },
                            {
                                "example_id": "b1a1b820-001f-4c02-ae01-ded9da54cef2",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Die Hauptwirkung der Heilpflanze besteht in der Förderung und Anregung des Appetits.“"
                            },
                            {
                                "example_id": "a822c194-668d-4e2d-8d99-c3128b3100e6",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Cannabis hat im Wesentlichen vier psychische Hauptwirkungen sowie einige körperliche Auswirkungen, die in Tabelle 3-3 zusammengefasst sind.“"
                            },
                            {
                                "example_id": "8a2fc4c6-bc79-4bdf-858a-e0982776a9a7",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Entscheidend sei, auf welchem Rechtsgebiet die Hauptwirkungen des Vertrages liegen.“"
                            },
                            {
                                "example_id": "5b35b402-03d4-44ec-bda1-ad3c4034085b",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Der Therapeut erarbeitet mit der Gruppe Beispiele für erwünschte (angenehme) Hauptwirkungen und unangenehme Nachwirkungen von Alkohol.“"
                            },
                            {
                                "example_id": "ef8b8d16-08a0-4330-9f8e-94a6ba71cc19",
                                "sense_id": "df5ea2a1-6238-3d4c-a027-9c856d05ffc7",
                                "text": "„Wissenschaftler haben einen neuen Ansatz zur Behandlung von Depressionen entdeckt: Ein Begleiteffekt vieler gängiger Antidepressiva könnte für eine der Hauptwirkungen verantwortlich sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
