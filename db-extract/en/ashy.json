        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "463be3a6-d2f6-3435-9615-5353e168f6fc",
                "word": "ashy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "57ac5801-8875-458b-a396-324ba1682ce3",
                        "entry_id": "463be3a6-d2f6-3435-9615-5353e168f6fc",
                        "tags": [
                            "comparative"
                        ],
                        "form": "ashier"
                    },
                    {
                        "form_id": "58d10cff-501f-4317-8609-8e2b52e99e79",
                        "entry_id": "463be3a6-d2f6-3435-9615-5353e168f6fc",
                        "tags": [
                            "superlative"
                        ],
                        "form": "ashiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48e0f47f-8392-346a-9486-688f2b49a853",
                        "entry_id": "463be3a6-d2f6-3435-9615-5353e168f6fc",
                        "glosses": [
                            "Resembling ashes (especially in colour); (of a person’s complexion) unusually pale as a result of strong emotion, illness, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149aea14-e2e2-449f-88a1-2c38f7730fb1",
                                "sense_id": "48e0f47f-8392-346a-9486-688f2b49a853",
                                "text": "Still is he sullein, still he lowres and frets,\nTwixt crimson shame, and anger ashie pale,"
                            },
                            {
                                "example_id": "60753d3a-4bc6-4111-ac93-5a15621560d2",
                                "sense_id": "48e0f47f-8392-346a-9486-688f2b49a853",
                                "text": "Tell her that sicknesse, with her ashie hand,\nHath swept away the beauty from my cheekes,"
                            },
                            {
                                "example_id": "ea45b33f-0a9b-4f85-b76e-d36585b0fedf",
                                "sense_id": "48e0f47f-8392-346a-9486-688f2b49a853",
                                "text": "Again the operation; again the narcotic; again some return of colour to the ashy cheeks, and the regular breathing of healthy sleep."
                            },
                            {
                                "example_id": "74784f4c-abca-4927-a1d3-4678d6f7b8ed",
                                "sense_id": "48e0f47f-8392-346a-9486-688f2b49a853",
                                "text": "Beyond that black clot the sea lay, pale with last ashy gleam of day."
                            }
                        ]
                    },
                    {
                        "sense_id": "244b64a6-3aa4-354e-91bc-74f1e4ae9bc3",
                        "entry_id": "463be3a6-d2f6-3435-9615-5353e168f6fc",
                        "glosses": [
                            "Comprising, containing, or covered with ash."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da931654-59e4-41a0-93ce-d24744f527a4",
                                "sense_id": "244b64a6-3aa4-354e-91bc-74f1e4ae9bc3",
                                "text": "Ye heauenly spirites, whose ashie cinders lie\nVnder deep ruines, with huge walls opprest,"
                            },
                            {
                                "example_id": "10f08ead-ac24-4069-83cc-44623fd788a9",
                                "sense_id": "244b64a6-3aa4-354e-91bc-74f1e4ae9bc3",
                                "text": "[…] where yet the Embers glow,\nWide o’er the Pyle the sable Wine they throw,\nAnd deep subsides the ashy Heap below."
                            },
                            {
                                "example_id": "53a7e9d9-8a1d-4361-9d42-43204154a56a",
                                "sense_id": "244b64a6-3aa4-354e-91bc-74f1e4ae9bc3",
                                "text": "[…] I saw her sitting on the hearth in a ragged chair, close before, and lost in the contemplation of, the ashy fire."
                            },
                            {
                                "example_id": "1ce89c3c-d786-4388-8aed-9b558b62a937",
                                "sense_id": "244b64a6-3aa4-354e-91bc-74f1e4ae9bc3",
                                "text": "He lit the paper until it burned to an ashy film."
                            }
                        ]
                    },
                    {
                        "sense_id": "9473f03d-d923-3761-87d0-12e0910e455f",
                        "entry_id": "463be3a6-d2f6-3435-9615-5353e168f6fc",
                        "glosses": [
                            "Having dry or dead skin (therefore discolored)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7c92e0-0c64-4b32-b0e6-ae328fe7de92",
                                "sense_id": "9473f03d-d923-3761-87d0-12e0910e455f",
                                "text": "It was summer and his pants were short, so the pickle juice made clean streams down his ashy legs[…]"
                            },
                            {
                                "example_id": "2665daa2-2da8-4bbe-bce0-c73611431a65",
                                "sense_id": "9473f03d-d923-3761-87d0-12e0910e455f",
                                "text": "After passing it under her runny nose, a skinny chalk-colored girl raised a hand so disgustingly ashy, so white and dry-skinned, that it could only be black."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8181e00-e26b-4b2a-a579-3732f8aabd4c",
