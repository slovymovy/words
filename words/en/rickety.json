{
    "word_family": [
        "rickets"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3a1fcb21-a90d-3e38-990c-301d0d6de031",
                    "sense_definition": "Not strong or sturdy due to poor construction or age; likely to collapse or break.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "unstable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was afraid to climb the <w>rickety</w> wooden ladder.",
                            "target_lang_translations": {
                                "tr": "<w>Çürük</w> ahşap merdivene tırmanmaya korkuyordu."
                            }
                        },
                        {
                            "text": "The old house had a <w>rickety</w> staircase that creaked with every step.",
                            "target_lang_translations": {
                                "tr": "Eski evin her adımda gıcırdayan <w>sallantılı</w> bir merdiveni vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "flimsy",
                        "shaky",
                        "unstable",
                        "wobbly"
                    ],
                    "antonyms": [
                        "firm",
                        "solid",
                        "strong",
                        "sturdy"
                    ],
                    "common_phrases": [
                        "rickety chair",
                        "rickety table",
                        "rickety bridge"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kötü yapım veya yaşlılık nedeniyle sağlam olmayan, yıkılmaya veya kırılmaya meyilli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çürük",
                                "target_lang_sense_clarification": "Genel olarak sağlam olmayan, bozulmuş yapılar için kullanılır."
                            },
                            {
                                "target_lang_word": "sallantılı",
                                "target_lang_sense_clarification": "Dengesi bozuk, sallanan nesneler için kullanılır."
                            },
                            {
                                "target_lang_word": "döküntü",
                                "target_lang_sense_clarification": "Eski ve bakımsız durumdaki eşyalar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf828acf-0043-37f1-8b62-cf207073a28e",
                    "sense_definition": "Moving in an unsteady or shaky way, often due to weakness or old age.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "unstable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rickety</w> old man walked slowly across the park.",
                            "target_lang_translations": {
                                "tr": "<w>Titrek</w> adımlı yaşlı adam parkta yavaşça yürüdü."
                            }
                        },
                        {
                            "text": "After the long illness, his legs felt <w>rickety</w> and weak.",
                            "target_lang_translations": {
                                "tr": "Uzun süren hastalıktan sonra bacakları <w>titrek</w> ve güçsüz hissediyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "tottering",
                        "unsteady"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zayıflık veya yaşlılık nedeniyle dengesiz veya titrek bir şekilde hareket eden."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "titrek",
                                "target_lang_sense_clarification": "Zayıflıktan dolayı dengesini sağlayamayan hareketler için."
                            },
                            {
                                "target_lang_word": "paytak",
                                "target_lang_sense_clarification": "Dengesiz ve aksak yürüyüş tarzı için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de468dd7-e0e6-3183-81ed-014e605fb813",
                    "sense_definition": "Suffering from the medical condition rickets.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child showed signs of <w>rickety</w> bone development due to a lack of vitamin D.",
                            "target_lang_translations": {
                                "tr": "Çocuk, D vitamini eksikliği nedeniyle <w>raşitik</w> kemik gelişimi belirtileri gösteriyordu."
                            }
                        },
                        {
                            "text": "Historical records describe the <w>rickety</w> condition of children living in poor urban areas.",
                            "target_lang_translations": {
                                "tr": "Tarihi kayıtlar, yoksul kentsel bölgelerde yaşayan çocukların <w>raşitik</w> durumunu anlatır."
                            }
                        }
                    ],
                    "synonyms": [
                        "rachitic"
                    ],
                    "target_lang_definitions": {
                        "tr": "Raşitizm hastalığından muzdarip olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "raşitik",
                                "target_lang_sense_clarification": "Tıbbi olarak raşitizm hastalığı ile ilgili durumlar için."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}