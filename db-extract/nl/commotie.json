                "senses": [
                    {
                        "sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                        "entry_id": "53640660-846b-35c4-be9a-919c05e81ec4",
                        "glosses": [
                            "onrust bij een groep mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cddbc11b-6489-4137-8fd2-ebad5460a891",
                                "sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                                "text": "Er ontstond een commotie over het pittige gesprek met de directeur."
                            },
                            {
                                "example_id": "73682e93-0a43-44eb-bb69-b2308abee783",
                                "sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                                "text": "Midden in de nacht schrok ik wakker doordat de deur met een klap opensloeg. Twee jongens sprongen verschrikt de hut in, een hoop commotie veroorzakend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eec8dfce-f67b-4b4f-90c9-05482ec331e0",
                        "source_entry_id": "53640660-846b-35c4-be9a-919c05e81ec4",
                        "source_sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                        "source_sense_description": "onrust bij een groep mensen",
                        "target_lang_word": "Aufregung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufregung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "accdec1a-efab-3277-8518-c0f171080e03",
                                        "entry_id": "2f18cb90-914f-349e-a1c8-609c3116bd3d",
                                        "glosses": [
                                            "Gefühl der Anspannung und Unruhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0696de47-26e2-4574-8985-c3a04a9f58a3",
                                                "sense_id": "accdec1a-efab-3277-8518-c0f171080e03",
                                                "text": "Er konnte vor Aufregung nicht schlafen."
                                            },
                                            {
                                                "example_id": "57423086-479b-45cc-81d7-bd3145462218",
                                                "sense_id": "accdec1a-efab-3277-8518-c0f171080e03",
                                                "text": "„Vielleicht war es auch die Folge der verwirrenden Aufregung oder des schmerzlichen Bewußtseins, von jemand Abschied nehemen zu müssen, den man gern hatte.“"
                                            },
                                            {
                                                "example_id": "ed9ec9d3-1485-4b0a-b915-91c2f9d5497a",
                                                "sense_id": "accdec1a-efab-3277-8518-c0f171080e03",
                                                "text": "„Vor Aufregung schießt der Mann am Maschinengewehr auf den Turm, schwer rollt das Echo zurück.“"
                                            },
                                            {
                                                "example_id": "577fe961-dd12-4b02-af94-c9e9b7dd7047",
                                                "sense_id": "accdec1a-efab-3277-8518-c0f171080e03",
                                                "text": "„Zitternd vor Aufregung schnappte sich dann Hallows das Papier und überzeugte sich ebenfalls.“"
                                            },
                                            {
                                                "example_id": "bbff40b4-e8cc-4f39-ae28-4f7e855032e9",
                                                "sense_id": "accdec1a-efab-3277-8518-c0f171080e03",
                                                "text": "„Nach der zeitweiligen Aufregung über den Doppelmord in Sarajevo kehrten die meisten Deutschen zum Alltag zurück, und das hieß im Juli wie in jedem Jahr für viele: zum Urlaub.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db9cdf6e-823c-32a1-acad-35d83f1e152b",
                                        "entry_id": "2f18cb90-914f-349e-a1c8-609c3116bd3d",
                                        "glosses": [
                                            "verwirrendes, chaotisches Durcheinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8988941d-5ed8-43ab-aaea-afeef4d557a4",
                                                "sense_id": "db9cdf6e-823c-32a1-acad-35d83f1e152b",
                                                "text": "Ich verstehe die ganze Aufregung nicht, was dieses Thema betrifft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2dce1ef-5b5c-4f02-81ed-0eef8fee3a8f",
                        "source_entry_id": "53640660-846b-35c4-be9a-919c05e81ec4",
                        "source_sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                        "source_sense_description": "onrust bij een groep mensen",
                        "target_lang_word": "Erregung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erregung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                        "entry_id": "fabb55fd-382f-3b1f-9662-9da84bf86272",
                                        "glosses": [
                                            "eine Art seelischer Hochspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3e2221-07fa-4393-a47a-06821d22a590",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "Er konnte seine Erregung nicht mehr verbergen."
                                            },
                                            {
                                                "example_id": "6eeb3b63-94b2-4202-808a-b060b706f2ee",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Die Mutter hatte vor Erregung ihr Hochdeutsch vergessen, um das sie sich in der Gegenwart des Kirchenmannes sonst bemühte.“"
                                            },
                                            {
                                                "example_id": "c7eaf46a-7dde-45ce-ab69-ee99f44b5828",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Die Zeitungen druckten Extrablätter und trieben damit die Erregung fast überall im Land auf neue, ungekannte Höhen.“"
                                            },
                                            {
                                                "example_id": "f4cc2347-4afe-479d-ad03-29dd9648f4f2",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Die Prophezeiungen meiner Großmutter hatten mich in eine unschuldige Art von Erregung versetzt.“"
                                            },
                                            {
                                                "example_id": "40f306da-846c-4f44-85c8-06fc30b8bb61",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Sabina wußte, er würde sie rufen, wenn er Erregung wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ee83773-2914-3df1-9767-fe166b86e413",
                                        "entry_id": "fabb55fd-382f-3b1f-9662-9da84bf86272",
                                        "glosses": [
                                            "die Erzeugung von elektrischen und magnetischen Feldern durch elektrische Ströme und umgekehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a7993b-6863-4e40-8559-cee5ef2ef458",
                                                "sense_id": "9ee83773-2914-3df1-9767-fe166b86e413",
                                                "text": "„Die magnetische Erregung ist im Innern einer Spule der Länge l praktisch konstant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                        "entry_id": "fabb55fd-382f-3b1f-9662-9da84bf86272",
                                        "glosses": [
                                            "die Beeinflussung eines Lebensvorganges durch einen außerhalb oder innerhalb des Organismus liegenden Reiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ce36f21-d7aa-47f4-9b7e-35c38081f5bd",
                                                "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                                "text": "„Bei anderen Frauen ist das kein Thema; die Situation sorgt schon dafür, die Erregung ist groß genug, und der Orgasmus steht nie infrage.“"
                                            },
                                            {
                                                "example_id": "f7192d82-6ba3-485b-9548-33d6858cc782",
                                                "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                                "text": "„Die Erregung, die mich ergreift, ist Teil der Erregung, die in den Bildern eingeschlossen ist, und die Erregung in den Bildern ist so wirklich und echt, wie es die Erregung der beiden Aktricen gewesen ist, vor dem Auge der Kamera.“"
                                            },
                                            {
                                                "example_id": "55ebdaba-7844-420d-aca7-ff1801ce3003",
                                                "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                                "text": "„In den Greisenjahren hielt er sich durch Ersatzhandlungen, Beobachtungen fremder Erregung und Eintragungen schadlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26f0d7a2-284e-4650-972e-c91116347c42",
                        "source_entry_id": "53640660-846b-35c4-be9a-919c05e81ec4",
                        "source_sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                        "source_sense_description": "onrust bij een groep mensen",
                        "target_lang_word": "commotion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commotion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69155af0-99ea-3189-941e-b1de5c4cb90f",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "A state of turbulent motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "An agitated disturbance or a hubbub."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ccea11d-9845-4aef-8f7d-514f88bf72dc",
                                                "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                                "text": "It would seem as if calm were necessary to convulsion; for the tranquillity of the last few months was again to be disturbed by political commotion."
                                            },
                                            {
                                                "example_id": "50db1e12-5c7c-40f7-b23d-8aa572d32787",
                                                "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "530ed46a-d712-32d8-9006-e1fefa7c1e05",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "Sexual excitement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0ac015a-2f1c-43ff-9810-b1fa460f2008",
                                                "sense_id": "530ed46a-d712-32d8-9006-e1fefa7c1e05",
                                                "text": "and now, glancing my eyes towards that part of his dress which cover'd the essential object of enjoyment, I plainly discover'd the swell and commotion there",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e2af239-78e0-4325-8d87-432d91ca7d91",
                        "source_entry_id": "53640660-846b-35c4-be9a-919c05e81ec4",
                        "source_sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                        "source_sense_description": "onrust bij een groep mensen",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                        "entry_id": "c953c29d-b9c5-3f61-852f-825947492f3a",
                                        "glosses": [
                                            "Amazement or horror that confounds the faculties, and incapacitates for reflection; terror, combined with amazement; dismay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bfb65-8e1b-4454-bae9-e14445728e4d",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "\"Out!\" exclaimed her husband, with something like genuine consternation in his voice."
                                            },
                                            {
                                                "example_id": "602baf81-173e-4c3e-9592-ba81593c7eac",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "Their audience had been listening in increasing consternation."
                                            },
                                            {
                                                "example_id": "48b24c20-55c4-46c7-89d5-0265fe6cc51c",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "It was probably worth four millennia of consternation and regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c7a9fd9-3191-4488-9bca-e49b37e011ff",
                        "source_entry_id": "53640660-846b-35c4-be9a-919c05e81ec4",
                        "source_sense_id": "968aa166-2d42-35a2-a31e-99935016458d",
                        "source_sense_description": "onrust bij een groep mensen",
                        "target_lang_word": "agitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6578011-4f3e-3cac-9e23-16d9a3753aea",
                                        "entry_id": "7b6be11d-08c2-3a21-802e-30def8657611",
                                        "glosses": [
                                            "État de ce qui est agité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c75379b5-f0b0-3df5-8a96-be1ca8d2837b",
                                        "entry_id": "7b6be11d-08c2-3a21-802e-30def8657611",
                                        "glosses": [
                                            "Mouvement populaire d’opposition ou de rébellion."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63758f81-eaa2-47d8-a19f-ad11ccc1b53a",
                                                "sense_id": "c75379b5-f0b0-3df5-8a96-be1ca8d2837b",
                                                "text": "Jusque tout récemment, le Houz seul était resté calme. Mais l’agitation a fini par gagner cette région relativement soumise, d’où les sultans tiraient le plus clair de leurs revenus et où les commerçants européens de la côte ont des intérêts considérables."
                                            },
                                            {
                                                "example_id": "25220c20-50cc-4eaa-93bd-f3670494171c",
                                                "sense_id": "c75379b5-f0b0-3df5-8a96-be1ca8d2837b",
                                                "text": "En 1884, le gouvernement ne prévoyait nullement que les syndicats pussent participer à une grande agitation révolutionnaire […]."
                                            },
                                            {
                                                "example_id": "0b5ee8ec-6f8b-4d38-bc5c-368a9bebbf4e",
                                                "sense_id": "c75379b5-f0b0-3df5-8a96-be1ca8d2837b",
                                                "text": "Tandis que le Midi, qui a, de tout temps, été un foyer de vie intellectuelle très intense et où les juifs cultivaient toutes les sciences, a été le point de départ d'une agitation antiphilosophique et antiscientifique."
                                            },
                                            {
                                                "example_id": "53aa3ef4-39cc-4b16-ae52-82021d44f20e",
                                                "sense_id": "c75379b5-f0b0-3df5-8a96-be1ca8d2837b",
                                                "text": "Chez les possédants, l’agitation sociale réveille une vieille hantise particulièrement vivace chez les bourgeois français : la peur de l'ouvrier."
                                            },
                                            {
                                                "example_id": "de80dca5-7970-4992-8a76-fbbba4c46f08",
                                                "sense_id": "c75379b5-f0b0-3df5-8a96-be1ca8d2837b",
                                                "text": "Pour la première fois dans l’histoire de la Russie, l’antisémitisme et l’agitation pogromiste furent qualifiés officiellement de crimes, punissables par la mise hors la loi de leurs auteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7533bd29-0e51-3c41-b4ed-c90c3764e5c8",
                                        "entry_id": "7b6be11d-08c2-3a21-802e-30def8657611",
                                        "glosses": [
                                            "État d’un lieu, d’un milieu, d’une vie caractérisés par des mouvements nombreux et incessants."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cea221c-fe2a-4463-a000-50f9610441c9",
                                                "sense_id": "7533bd29-0e51-3c41-b4ed-c90c3764e5c8",
                                                "text": "On croit chercher sincèrement le repos, et l'on ne cherche en effet que l'agitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ea2172-36ae-3730-aa95-a1005575a48c",
