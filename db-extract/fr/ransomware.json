                "entry_id": "a0e02414-b44b-3776-bd59-803b55466762",
                "word": "ransomware",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "331ab8e2-e2b5-45db-a23e-fe4aae9b67cf",
                        "entry_id": "a0e02414-b44b-3776-bd59-803b55466762",
                        "tags": [
                            "plural"
                        ],
                        "form": "ransomwares"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64a9bd38-f79b-3806-b96f-a01c4a1e48ef",
                        "entry_id": "a0e02414-b44b-3776-bd59-803b55466762",
                        "glosses": [
                            "Logiciel malveillant qui empêche l’accès aux données stockées sur un ordinateur et propose leur récupération contre le paiement d’une rançon."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "7082e82f-c485-4240-a37c-791ea58f254a",
                                "sense_id": "64a9bd38-f79b-3806-b96f-a01c4a1e48ef",
                                "text": "Une cyberattaque au ransomware du groupe de pirates Play a touché la Fédération française de rugby (FFR), dans la nuit de mercredi à jeudi."
                            },
                            {
                                "example_id": "fcd39ea3-446d-4844-9c9d-4b065d2f34fa",
                                "sense_id": "64a9bd38-f79b-3806-b96f-a01c4a1e48ef",
                                "text": "Dès vendredi soir, une large attaque par phishing a provoqué une vague d'infections par un ransomware, WannaCrypt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "544ef8d6-47ba-4da8-b8fe-e528fba04e06",
                        "source_entry_id": "a0e02414-b44b-3776-bd59-803b55466762",
                        "source_sense_id": "64a9bd38-f79b-3806-b96f-a01c4a1e48ef",
                        "target_lang_word": "ransomware",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ransomware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                        "entry_id": "a1d8764a-c318-3f11-a2a7-b88609e38082",
                                        "glosses": [
                                            "Malware that holds the data of a computer user for ransom, usually requiring or claiming to require payment to restore access."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e219417-865c-4d7a-bfd9-e1c3bb8d4c45",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "The amount of money generated by ransomware schemes would appear to be quite small given their lack of popularity and the asking price in ransom notes […]"
                                            },
                                            {
                                                "example_id": "cc907eb9-0a12-49c3-87a9-86b7fd827dc6",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "Garmin has been forced to shut down its call centres, website and some other online services after a ransomware attack encrypted the smartwatch maker’s internal network and some production systems."
                                            },
                                            {
                                                "example_id": "b8f585de-1333-419b-a500-636b7a2efe53",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "Last March, Trenitalia, the Italian state-owned railway, suffered a major ransomware attack on its ticketing system, which disrupted sales at stations as well as passenger information screens."
                                            },
                                            {
                                                "example_id": "a25f70cf-66f0-4fa4-b7bd-2bb70686328d",
                                                "sense_id": "e8b28a3b-fc82-3c09-a8f6-4bb78b9d607a",
                                                "text": "Cybersecurity firm Semperis found that 86% of surveyed organizations in the United States, United Kingdom, France and Germany that faced ransomware attacks were targeted on a holiday or weekend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "660d1b73-ae30-3e56-a084-376b09b33650",
                                        "entry_id": "a1d8764a-c318-3f11-a2a7-b88609e38082",
                                        "glosses": [
                                            "Software that is released as open source only in exchange for payment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "294cce85-6f3c-4dcf-bd01-371ea9114056",
                                                "sense_id": "660d1b73-ae30-3e56-a084-376b09b33650",
                                                "text": "[I]n some situations, the source code of COTS may be escrowed and released under a free software or open source license when the original developer (or supplier) no longer continues to develop that software or if stipulated fundraising conditions are met. This model is referred to as the ransom model of software publishing and the software is known as ransomware."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca31c6ab-200f-4127-808d-7f3112abf150",
