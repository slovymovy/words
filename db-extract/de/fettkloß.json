                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "9c2b991a-7b78-4fa9-a622-1e6d59dc1451",
                                "sense_id": "57342610-ed3f-3e45-96f0-08038c326ae2",
                                "text": "„Die Zeit, in der Sänger ignorante Fettklöße waren, scheint zum Glück vorbei zu sein.“"
                            }
                        ],
