                ],
                "senses": [
                    {
                        "sense_id": "16c60651-6941-333b-a71d-aae7540f7143",
                        "entry_id": "1ecab0f4-bac5-3452-b1db-f6ec485702da",
                        "glosses": [
                            "die Region Baden betreffend, zu ihr gehörend, aus ihr stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a77acd-f808-4942-a48f-270a074ba972",
                                "sense_id": "16c60651-6941-333b-a71d-aae7540f7143",
                                "text": "„An den Neustädter Besprechungen, die zwölf Tage in Anspruch nahmen, beteiligten sich außer den früher Genannten salzburgische, bairische, badensische und mainzische Vertreter.“"
                            },
                            {
                                "example_id": "9379a02b-eff7-452c-9034-9e82ee907534",
                                "sense_id": "16c60651-6941-333b-a71d-aae7540f7143",
                                "text": "„Nach Basel tritt die Natur des Hochrheins zutage, badensischer Weisswein unter diesen blauen Netzen, welche die Vögel vom Mundraub abhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
