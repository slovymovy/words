                    {
                        "translation_id": "fe31d7bf-60f6-4d12-b487-3afce9cbccaf",
                        "source_entry_id": "36c51a86-5044-3023-b6a2-9782cdf1cabf",
                        "source_sense_id": "2013e394-55fa-3167-b3ee-fbfa0da88d92",
                        "target_lang_word": "yogee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yogee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d514393-1336-3ce8-968c-1d2b65e0efbb",
                                        "entry_id": "e157810a-56ca-34db-9faa-e095179b2204",
                                        "glosses": [
                                            "Archaic form of yogi."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bd2e268-629a-4aed-b9ea-16f58fdef550",
                                                "sense_id": "2d514393-1336-3ce8-968c-1d2b65e0efbb",
                                                "text": "The Yogee of a subdued mind thus employed in the exercise of his devotions is compared to a lamp, standing in a place without wind, which waveth not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f18bad3-0314-4d85-9ba3-fc203084d0fc",
                        "source_entry_id": "36c51a86-5044-3023-b6a2-9782cdf1cabf",
                        "source_sense_id": "2013e394-55fa-3167-b3ee-fbfa0da88d92",
                        "target_lang_word": "yogi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yogi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c458465-d6fd-3e07-b2d0-18b3347796ca",
                                        "entry_id": "7b03b62e-ee74-3214-8dde-928e014f3100",
                                        "glosses": [
                                            "Sage et ascète hindouiste qui a atteint un haut niveau spirituel, en particulier par la méditation et le yoga."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "992ab1f4-3657-4205-a3bf-030e4b801468",
                                                "sense_id": "3c458465-d6fd-3e07-b2d0-18b3347796ca",
                                                "text": "Je m'étais enveloppée de serviettes de bain pour avoir l'air plus hindou, j'avais posé mon pied droit sur ma cuisse gauche et je me regardais fixement dans la glace, non avec complaisance mais dans l'espoir d'atteindre l'état supérieur du yogi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45964c9e-8b4f-388a-bb1e-2047ab2a4e21",
