                    {
                        "translation_id": "f9b269b6-ef3d-4e68-97e4-678c41d4338e",
                        "source_entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                        "target_lang_word": "болезненно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "болезненно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0f85b900-f418-3fc4-a05b-629007bcf316",
                                        "entry_id": "5a3813ea-bceb-34e8-91ac-7afed2227597",
                                        "glosses": [
                                            "краткая форма среднего рода единственного числа прилагательного болезненный"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "болезненно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4db9c06a-5234-37e1-8bae-1aa3beca0ab0",
                                        "entry_id": "4153810b-dbf1-323a-9908-dcaf2dde6238",
                                        "glosses": [
                                            "ощущая, выражая, причиняя боль, физические или душевные страдания; свидетельствуя о болезни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d4ecd56-a5fd-4f2b-8cdd-63ffbcdc3cb1",
                                                "sense_id": "4db9c06a-5234-37e1-8bae-1aa3beca0ab0",
                                                "text": "Нет в мире человека, над которым прошедшее приобретало бы такую власть, как надо мною: всякое напоминание о минувшей печали или радости болезненно ударяет в мою душу и извлекает из неё всё те же звуки…"
                                            },
                                            {
                                                "example_id": "fb3858ec-d368-49bf-9fdb-84b5f915e2a2",
                                                "sense_id": "4db9c06a-5234-37e1-8bae-1aa3beca0ab0",
                                                "text": "Сердце его ныло, болезненно обливаясь кровью и не давая слез уязвленной душе его."
                                            },
                                            {
                                                "example_id": "3b875ec6-4b6c-419a-afb3-b2bc08c690f4",
                                                "sense_id": "4db9c06a-5234-37e1-8bae-1aa3beca0ab0",
                                                "text": "Не видали, чтоб он задумывался над чем-нибудь болезненно и мучительно; по-видимому, его не пожирали угрызения утомлённого сердца; не болел он душой, не терялся никогда в сложных, трудных или новых обстоятельствах, а подходил к ним, как к бывшим знакомым, как будто он жил вторично, проходил знакомые места."
                                            },
                                            {
                                                "example_id": "d61f4678-2248-4913-90bc-61e573085c6d",
                                                "sense_id": "4db9c06a-5234-37e1-8bae-1aa3beca0ab0",
                                                "text": "Помню, что тут мать наконец заплакала, ― села на скамейку возле брата и вдруг зарыдала, зажимая рот платком, отец же, болезненно сморщив лицо, махнул рукой и быстро пошёл прочь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfd4dcdc-0ce4-3376-a9d9-d7c41bc5709d",
                                        "entry_id": "4153810b-dbf1-323a-9908-dcaf2dde6238",
                                        "glosses": [
                                            "очень, чрезмерно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fdb86a5-5357-457e-ae01-61d3b026d508",
                                                "sense_id": "cfd4dcdc-0ce4-3376-a9d9-d7c41bc5709d",
                                                "text": "Когда Морель выпил водки и доел котелок каши, он вдруг болезненно развеселился и начал не переставая говорить что-то не понимавшим его солдатам."
                                            },
                                            {
                                                "example_id": "557fe6e6-d375-4712-bff8-0595b5595b32",
                                                "sense_id": "cfd4dcdc-0ce4-3376-a9d9-d7c41bc5709d",
                                                "text": "Тщеславная, болезненно самолюбивая Дашкова была потрясена пренебрежительным отношением к ней Екатерины."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
