                                                "sense_id": "cabd28da-4b1c-3bb0-894b-669d15c0f8fe",
                                                "text": "W tych szafkach jest tyle brudu, że aż mnie mdli."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "badeb214-a894-3e78-a5dd-1975a2722bc7",
                                        "entry_id": "e3732ef5-b46c-3076-99b8-49a5686709c5",
                                        "glosses": [
