{
    "word_family": [
        "immeasurability",
        "immeasurably",
        "measurable",
        "measure"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10ff63a0-67b6-3822-a2ff-080bf31d4239",
                    "sense_definition": "Impossible or difficult to measure because of extreme extent or depth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists looked out into the <w>immeasurable</w> depths of outer space.",
                            "target_lang_translations": {
                                "es": "Los científicos contemplaron las <w>inmensurables</w> profundidades del espacio exterior."
                            }
                        },
                        {
                            "text": "Living through the tragedy caused the entire family an <w>immeasurable</w> amount of sorrow.",
                            "target_lang_translations": {
                                "es": "Vivir esa tragedia le causó a toda la familia una cantidad <w>incalculable</w> de dolor."
                            }
                        }
                    ],
                    "synonyms": [
                        "immensurable",
                        "unmeasurable"
                    ],
                    "antonyms": [
                        "measurable"
                    ],
                    "common_phrases": [
                        "immeasurable depth",
                        "immeasurable distance"
                    ],
                    "target_lang_definitions": {
                        "es": "Imposible o muy difícil de medir debido a su enorme extensión, tamaño o profundidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "inconmensurable",
                                "target_lang_sense_clarification": "que no puede medirse por su gran magnitud"
                            },
                            {
                                "target_lang_word": "inmensurable",
                                "target_lang_sense_clarification": "que no puede medirse"
                            },
                            {
                                "target_lang_word": "inmedible",
                                "target_lang_sense_clarification": "imposible de medir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9550b0b3-3106-3cdb-a63f-ebbfeecdc09f",
                    "sense_definition": "Extremely large, valuable, or significant in degree; immense or vast.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hard work made an <w>immeasurable</w> difference to the success of the project.",
                            "target_lang_translations": {
                                "es": "Su arduo trabajo marcó una diferencia <w>incalculable</w> para el éxito del proyecto."
                            }
                        },
                        {
                            "text": "The company gained an <w>immeasurable</w> advantage by adopting modern technology early.",
                            "target_lang_translations": {
                                "es": "La empresa obtuvo una ventaja <w>inconmensurable</w> al adoptar la tecnología moderna desde el principio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "immeasurable value",
                        "immeasurable benefit",
                        "immeasurable contribution",
                        "immeasurable advantage"
                    ],
                    "target_lang_definitions": {
                        "es": "Extremadamente grande, valioso o significativo; inmenso o incalculable."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "incalculable",
                                "target_lang_sense_clarification": "de valor o importancia imposible de estimar"
                            },
                            {
                                "target_lang_word": "inmenso",
                                "target_lang_sense_clarification": "muy grande en grado o cantidad"
                            },
                            {
                                "target_lang_word": "inconmensurable",
                                "target_lang_sense_clarification": "de una magnitud enorme o ilimitada"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7b5b8e7-fc9c-3124-93a7-9744d40fe120",
                    "sense_definition": "Something that cannot be quantified, evaluated, or measured.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A manager should never ignore the <w>immeasurables</w> like team spirit and trust.",
                            "target_lang_translations": {
                                "es": "Un gerente nunca debería ignorar los <w>intangibles</w> como el espíritu de equipo y la confianza."
                            }
                        },
                        {
                            "text": "Success in education often depends on each <w>immeasurable</w> factor within the classroom.",
                            "target_lang_translations": {
                                "es": "El éxito en la educación a menudo depende de cada factor <w>inmedible</w> dentro del aula."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Algo que no se puede cuantificar, evaluar o medir."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "intangible",
                                "target_lang_sense_clarification": "factor o elemento no cuantificable"
                            },
                            {
                                "target_lang_word": "inconmensurable",
                                "target_lang_sense_clarification": "aquello que no se puede medir"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}