                        "source_sense_description": "act or the condition of being knocked down",
                        "target_lang_word": "нокда́ун",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нокда́ун",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8417eae8-f740-3942-836c-a1f8ab22203a",
                                        "entry_id": "aa7abf95-d4bd-32f3-9a90-cabb0aa93d76",
                                        "glosses": [
                                            "спорт. положение, при котором боксёр коснулся настила ринга коленом или рукой под воздействием удара либо уклоняясь от атаки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2548c51f-0fbd-4495-80fd-ba9e0ee5d34a",
                                                "sense_id": "8417eae8-f740-3942-836c-a1f8ab22203a",
                                                "text": "В отличие от спортивных единоборств здесь важны не очки и баллы, а конечный результат, выраженный в нокаутах, в количестве нокдаунов, болевых приёмах и удушениях, заставивших соперника сдаться."
                                            },
                                            {
                                                "example_id": "5c04110e-5cc5-4f6f-bf5e-757d20d42f27",
                                                "sense_id": "8417eae8-f740-3942-836c-a1f8ab22203a",
                                                "text": "В первом раунде нокдаун, во втором два ― а в середине третьего Гарик попал ему в веко, ещё в молодости надорванное и зашитое, кровь залила скулу, щеку, технический нокаут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8b90d8-9974-346d-8588-73ec90071abf",
                                        "entry_id": "aa7abf95-d4bd-32f3-9a90-cabb0aa93d76",
                                        "glosses": [
                                            "перен. сильное неожиданное потрясение; большая неприятность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416a82a3-fa67-4d0b-b975-b19b842536aa",
                                                "sense_id": "bb8b90d8-9974-346d-8588-73ec90071abf",
                                                "text": "Если в первой встрече северцы отправили «Мотор» в нокдаун, то вторая обернулась полным нокаутом."
                                            },
                                            {
                                                "example_id": "436301a3-2af8-4239-9b97-d1b945628058",
                                                "sense_id": "bb8b90d8-9974-346d-8588-73ec90071abf",
                                                "text": "Но уже к осени 1965 года Шелепин, видимо, получил сильный политический нокдаун."
                                            },
                                            {
                                                "example_id": "c5f204fa-9171-4818-8e71-fbe49ac7806f",
                                                "sense_id": "bb8b90d8-9974-346d-8588-73ec90071abf",
                                                "text": "Трубку бросили. Кирпичников оказался в самом банальном нокдауне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
