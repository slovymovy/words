                        "sense_id": "a3866285-a946-3ec9-a7aa-c4581b632a1c",
                        "entry_id": "e01f7f4e-dc5d-319e-9a50-06ecce6b90a0",
                        "glosses": [
                            "The state or process of being desiccated"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7022e46c-8553-3e68-80b6-0f870981bd05",
                        "entry_id": "e01f7f4e-dc5d-319e-9a50-06ecce6b90a0",
                        "glosses": [
                            "An act or occurrence of desiccating"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "910824f5-8c03-400e-a539-5db9c9b7c4b9",
                                "sense_id": "7022e46c-8553-3e68-80b6-0f870981bd05",
                                "text": "The most important mortality affecting the larval population was most probably caused by the repeated desiccations of the marsh in the summer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfadd795-6f44-4df8-85aa-14d255c99bf1",
                        "source_entry_id": "e01f7f4e-dc5d-319e-9a50-06ecce6b90a0",
                        "source_sense_description": "The state or process of being desiccated",
                        "target_lang_word": "dessiccation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dessiccation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf556da-491a-3a39-8b4e-91423592316b",
                                        "entry_id": "e9fb63be-debf-3276-a027-af824a66d6b4",
                                        "glosses": [
                                            "Action de dessécher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a029cf7-9179-4761-9a13-6aefe7aa5d11",
                                                "sense_id": "9cf556da-491a-3a39-8b4e-91423592316b",
                                                "text": "Quelques minutes seulement d’exposition du système racinaire au soleil ou au vent peuvent entraîner la mort des plants ou diminuer leur vitalité (dessiccation des racines)."
                                            },
                                            {
                                                "example_id": "ae8cc8a9-6e32-4cce-95ab-9fe9dab5dc5a",
                                                "sense_id": "9cf556da-491a-3a39-8b4e-91423592316b",
                                                "text": "Quand l'orge est bien germée, on la porte dans une étuve à courant d'air chaud, appelée touraille ; la chaleur arrête immédiatement la germination. En tamisant les grains, on en sépare les petites radicelles ou touraillons, que la dessiccation a rendues très-cassantes."
                                            },
                                            {
                                                "example_id": "56f66f9e-eb22-4255-b3ed-ec1742cebf7d",
                                                "sense_id": "9cf556da-491a-3a39-8b4e-91423592316b",
                                                "text": "La dessiccation détermine la disjonction des élatères (fig.61), tandis que l'action de l'humidité les ramène enroulées autour de la spore (fig.62), […]."
                                            },
                                            {
                                                "example_id": "9d87c1cf-f105-4236-a441-e3065e358839",
                                                "sense_id": "9cf556da-491a-3a39-8b4e-91423592316b",
                                                "text": "Allorge cite un type de phylum qui de la tourbière à Hypnacées passe à une Scirpaie à Schœnus, puis donne par dessiccation du milieu une prairie tourbeuse à Molinie, […]."
                                            },
                                            {
                                                "example_id": "5c80407a-d8be-4a5b-b662-edd606518abb",
                                                "sense_id": "9cf556da-491a-3a39-8b4e-91423592316b",
                                                "text": "Car ce qu'il avait considéré comme la sérénité avait été une sorte de glace. L'idée qu'il se faisait de la perfection avait été une espèce de dessiccation. Sa capacité à juger des choses d'une manière peu orthodoxe lui avait semblé n'être qu'un défaut de maturité, mais, à la vérité, il n'avait eu aucune idée de ce que signifiait la maturité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a91046-ab17-3764-98be-ef08f2ebc2ea",
                                        "entry_id": "e9fb63be-debf-3276-a027-af824a66d6b4",
                                        "glosses": [
                                            "Action de dessécher une plante par la pression ou autrement, pour la placer ensuite dans l’herbier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
