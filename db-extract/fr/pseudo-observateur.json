                        "glosses": [
                            "Observateur fictif ou personne qui se prétend simple observateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75f3f70-71cd-41c5-bd88-34949e1933ef",
                                "sense_id": "110f61d6-1fa4-368d-bb4b-70d68eb2f32d",
                                "text": "Des candidats complotistes, de pseudo-observateurs du scrutin armés, le mari de Nancy Pelosi, la présidente de la Chambre des représentants, attaqué…"
                            },
                            {
                                "example_id": "7083f508-a9ce-4faf-9dce-91b258754ae7",
                                "sense_id": "110f61d6-1fa4-368d-bb4b-70d68eb2f32d",
                                "text": "Ce pseudo-observateur ne résiste pas à l’investigation : dès qu’on s’approche de lui il disparaît."
                            },
                            {
                                "example_id": "01ed4836-fe73-45a6-8b1c-0df756633fe7",
                                "sense_id": "110f61d6-1fa4-368d-bb4b-70d68eb2f32d",
                                "text": "Soit on se place en pseudo-observateur extérieur (ce qui est en quelque part injustifiable, mais on peut quand-même tenter le coup et voir ce que cela donne…) et on fait de la théorie, soit on part du ressenti réel (qui sera toujours supérieur essentiellement, et existentiellement) et il faut voir directement tout ce que l’on introduit dans l’ordre d’apparition et dans l’ordre ontologique."
                            }
                        ]
                    }
