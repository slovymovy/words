                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marsh marigold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "404c6d2d-483d-3570-85f1-d227a947d9a3",
                                        "entry_id": "0fc279c2-63b6-317b-9b4b-feb536a51cf6",
                                        "glosses": [
                                            "Caltha palustris, a perennial plant with bright yellow flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b1b626-9d76-4284-8d57-f9e85581b51e",
                                                "sense_id": "404c6d2d-483d-3570-85f1-d227a947d9a3",
                                                "text": "Here is spring were celandine, marsh marigold, wind-flower, primrose, cowslip and dog's violet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5cb1054-bb58-4c45-99c9-76fafc9a7781",
                        "source_entry_id": "5201cabf-a4c6-34ab-868e-95ed8b83060b",
                        "source_sense_id": "34e02465-bbf7-3dca-9f8c-3d9bcf055472",
                        "source_sense_description": "gelb blühende Pflanze aus der Familie der Hahnenfußgewächse",
                        "target_lang_word": "populage des marais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "populage des marais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc60a416-a3c8-3ea8-83f1-db10351698d4",
                                        "entry_id": "bbc31c30-0e47-3c26-be70-488f5f8a914a",
                                        "glosses": [
                                            "Plante vivace à fleurs jaune d’or, commune dans les fossés et zones humides d’Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1318a81-1b20-495d-9da4-8b3f21778b59",
                                                "sense_id": "bc60a416-a3c8-3ea8-83f1-db10351698d4",
                                                "text": "Une herbe jeune et drue entourait les étangs qui reflétaient l'azur profond ; les populages des marais et les cardamines mettaient une tendre note dorée et mauve parmi ce bleu et ce vert."
                                            },
                                            {
                                                "example_id": "0728d9dd-e517-4e22-9073-e283763816d2",
                                                "sense_id": "bc60a416-a3c8-3ea8-83f1-db10351698d4",
                                                "text": "Le populage des marais teinte les zones humides de ses magnifiques fleurs jaunes."
                                            },
                                            {
                                                "example_id": "25505468-1c44-495e-b1ee-bca3885084e4",
                                                "sense_id": "bc60a416-a3c8-3ea8-83f1-db10351698d4",
                                                "text": "Attention les fleurs et les feuilles de populage des marais, comme pour toutes les renonculacées, sont toxiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7b15c34-924f-4bb7-bac3-701eaa41f42f",
                        "source_entry_id": "5201cabf-a4c6-34ab-868e-95ed8b83060b",
                        "source_sense_id": "34e02465-bbf7-3dca-9f8c-3d9bcf055472",
                        "source_sense_description": "gelb blühende Pflanze aus der Familie der Hahnenfußgewächse",
                        "target_lang_word": "caltha des marais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caltha des marais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a785897-2b22-37d9-b402-32c0b3f352f5",
                                        "entry_id": "136a115e-e9df-310c-9c48-20b68c19af55",
                                        "glosses": [
                                            "Espèce de plante vivace des zones humides européennes, à fleurs jaunes rappelant celles du bouton d’or."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bc04cdc-e21d-42e3-a330-fd671a444664",
                                                "sense_id": "4a785897-2b22-37d9-b402-32c0b3f352f5",
                                                "text": "Le caltha des marais est âcre et vénéneux, il est plus nuisible vert que sec ; heureusement, quand il est vert, les animaux l’évitent …."
                                            },
                                            {
                                                "example_id": "4ad09afb-bf80-4717-a75f-a706a3ab5bd0",
                                                "sense_id": "4a785897-2b22-37d9-b402-32c0b3f352f5",
                                                "text": "Avec transport ainsi j’appris la botanique :\nEn comparant le thym avec la véronique,\nLe caltha des marais, superbe bouton d’or,\nDes prés la cardamine et bien d’autres encore."
                                            },
                                            {
                                                "example_id": "17f2dc8b-0e8e-438e-9346-66a83bcaae64",
                                                "sense_id": "4a785897-2b22-37d9-b402-32c0b3f352f5",
                                                "text": "L’or du caltha des marais composait de merveilleux tapis dans lesquels les fillettes allaient composer de gros bouquets."
                                            }
                                        ]
                                    }
