                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0727f9-b3ef-49bc-b5f4-c2c2bdba96d6",
                                "sense_id": "aace44be-6500-3f44-a500-ec3540937f65",
                                "text": "„The cellarers have prepared for that and there are wines produced increasingly today, which are quickly ripe for drinking and do not have to be stored by the customer.“",
                                "translation": "„Die Kellermeister haben sich darauf eingestellt und es werden heute zunehmend Weine produziert, die schnell trinkreif sind und nicht mehr beim Käufer gelagert werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddef1b57-9eb4-4739-b4d5-fec85d20520c",
                        "source_entry_id": "5efb2ecc-030a-3105-a8b3-24b1eaa6ef88",
                        "source_sense_id": "aace44be-6500-3f44-a500-ec3540937f65",
                        "source_sense_description": "Kellermeister",
                        "target_lang_word": "Kellermeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
