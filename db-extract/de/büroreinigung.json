                ],
                "senses": [
                    {
                        "sense_id": "f73c47c7-a96b-3c35-915c-faf1f23fdb30",
                        "entry_id": "6104caf1-8cb2-3958-9636-cc36ca5f389c",
                        "glosses": [
                            "Maßnahmen, in einem Büro oder Bürogebäude die Verschmutzungen zu beseitigen (beispielsweise durch Staubsaugen, Fensterreinigung, Staubwischen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3155aa-6612-4406-b3fe-e2301e047220",
                                "sense_id": "f73c47c7-a96b-3c35-915c-faf1f23fdb30",
                                "text": "In den Betrieben, die Büroreinigungen durchführen, wird meist nur der Mindestlohn bezahlt - wenn überhaupt."
                            },
                            {
                                "example_id": "8361135f-5d88-4332-b481-b7bd68298bb7",
                                "sense_id": "f73c47c7-a96b-3c35-915c-faf1f23fdb30",
                                "text": "„Daraufhin reagieren acht von 14 Cost-Center-Leitern: »Wozu für Büroreinigung bezahlen? Unsere Schreibtische können wir auch selbst abstauben!« Also bestellt sie die Büroreinigung für die Büros ab.“"
                            },
                            {
                                "example_id": "f4222425-a513-4366-ad6c-9b1691fa9ef1",
                                "sense_id": "f73c47c7-a96b-3c35-915c-faf1f23fdb30",
                                "text": "„Kosten für einen Staubsauger zur Büroreinigung sind Betriebsausgaben.“"
                            },
                            {
                                "example_id": "133a54c7-5fde-4560-8975-f95794c72700",
                                "sense_id": "f73c47c7-a96b-3c35-915c-faf1f23fdb30",
                                "text": "„Zu den Geschäftsfeldern gehören dabei inzwischen auch alle möglichen Dienste jenseits der Schädlingsbekämpfung, von der Büroreinigung über die Vermietung tropischer Pflanzen bis hin zum Service von Büromaschinen.“"
                            },
                            {
                                "example_id": "320ff024-b963-4137-a5f7-fefb0ddfbd75",
                                "sense_id": "f73c47c7-a96b-3c35-915c-faf1f23fdb30",
                                "text": "„Der weitaus größte Teil des Umsatzes von 1,3 Milliarden Euro wird inzwischen mit dem Betrieb von Parkhäusern, Büroreinigung und Wachdiensten, unter anderem in Atomkraftwerken, erzielt.“"
                            },
                            {
                                "example_id": "1bd108a6-fc2e-4f5a-b010-984fe56a3edf",
                                "sense_id": "f73c47c7-a96b-3c35-915c-faf1f23fdb30",
                                "text": "„Wie das Nachrichtenportal […] unter Berufung auf Insider berichtet, stehen etwa die Dienste für Büroreinigung, Marketing und Gruppen-Netzwerke zum Verkauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
