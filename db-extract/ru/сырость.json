                "senses": [
                    {
                        "sense_id": "0e2bc4da-9c03-3cb6-b423-88ae4ef76502",
                        "entry_id": "2fcf398e-a3ff-3e8f-82b1-9b02a0ff8327",
                        "glosses": [
                            "dampness; moisture"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b5fbaa-f8e0-4861-adb9-d5188f5a97eb",
                                "sense_id": "0e2bc4da-9c03-3cb6-b423-88ae4ef76502",
                                "text": "О́кна на́шего подва́ла упира́лись в я́му, вы́рытую пред ни́ми и вы́ложенную кирпичо́м, зелё́ным от сы́рости; ра́мы бы́ли заграждены́ снару́жи ча́стой желе́зной се́ткой, и свет со́лнца не мог проби́ться к нам сквозь стё́кла, покры́тые мучно́й пы́лью.",
                                "translation": "The windows of our cellar looked out into a ditch, which was covered with bricks grown green from dampness, the window frames were obstructed from the outside by a dense iron netting, and the light of the sun could not peep in through the panes, which were covered with flour-dust.",
                                "english": "The windows of our cellar looked out into a ditch, which was covered with bricks grown green from dampness, the window frames were obstructed from the outside by a dense iron netting, and the light of the sun could not peep in through the panes, which were covered with flour-dust."
                            },
                            {
                                "example_id": "7e3606ef-7fd1-4bf9-adcc-565f8238322b",
                                "sense_id": "0e2bc4da-9c03-3cb6-b423-88ae4ef76502",
                                "text": "Пли́ты тротуа́ра и ка́мни мостово́й сла́бо мерца́ли сы́ростью неда́вно проше́дшего дождя́.",
                                "translation": "The paving-stones and the cobbles in the road shone faintly with the dampness of rain that had recently fallen.",
                                "english": "The paving-stones and the cobbles in the road shone faintly with the dampness of rain that had recently fallen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
