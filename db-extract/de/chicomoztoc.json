                "senses": [
                    {
                        "sense_id": "774c83d0-076e-3677-bcd8-fc7814d04f86",
                        "entry_id": "c51e3e6a-e03e-31ba-b09f-4c8e88aa49c9",
                        "glosses": [
                            "mythische Urheimat der Azteken und verwandter Völker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f236c560-0639-4cbd-a4ab-7e9984c86f16",
                                "sense_id": "774c83d0-076e-3677-bcd8-fc7814d04f86",
                                "text": "„Fast alle dieser Wanderer glaubten, sie kämen aus dem Nordwesten, aus Chicomoztoc, dem ›Ort der Sieben Höhlen‹.“"
                            },
                            {
                                "example_id": "09dca1f8-9949-4a83-81b6-9eaafb1af690",
                                "sense_id": "774c83d0-076e-3677-bcd8-fc7814d04f86",
                                "text": "„Nach den aztekischen Vorstellungen, die sich durch diese Quellen rekonstruieren lassen, lag der Ursprungsort in den mythischen sieben Höhlen (Chicomoztoc), aus denen je ein Stamm der Mexica entsprang, oder auf der Insel Aztlan, woraus sich die Bezeichnung ‹Azteken› ableitete.“"
                            },
                            {
                                "example_id": "e2c3cfa6-3b08-4153-aab5-1dbfaa9409ad",
                                "sense_id": "774c83d0-076e-3677-bcd8-fc7814d04f86",
                                "text": "„Ich war in den sieben Höhlen von Chicomoztoc, aber niemand wird es je erfahren!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
