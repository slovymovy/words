                        "glosses": [
                            "Lieu-dit de la commune française de Loperhet, dans le Finistère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2e3fa87-603d-4540-9202-c11cd831acff",
                                "sense_id": "978658d2-6d33-3620-92a6-e066e6537e3f",
                                "text": "Cette statue de la Vierge à l’enfant datant du XVIᵉ siècle, sculptée dans la pierre de Kersanton, avait souffert des affres du temps."
                            },
                            {
                                "example_id": "34ec8e32-752c-4152-adb0-da46dfb5a3ff",
                                "sense_id": "978658d2-6d33-3620-92a6-e066e6537e3f",
                                "text": "— Gisant de saint Renan, en granit bleu de Kersanton, dans l'église de Locronan (chapelle du Pénity)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
