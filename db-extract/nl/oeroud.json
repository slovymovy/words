                "senses": [
                    {
                        "sense_id": "b8fb9834-4393-3f19-87d7-8d708013d373",
                        "entry_id": "15203d6d-f820-30db-ac55-903a6bbdd22e",
                        "glosses": [
                            "heel erg oud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceccb8a8-6155-4cbd-99cc-7a435286a9cf",
                                "sense_id": "b8fb9834-4393-3f19-87d7-8d708013d373",
                                "text": "‘Die connectiviteit vergroot het comfort van de patiënt’, stelt Dave Singelée. ‘Maar de uitdaging om dat veilig te houden, wordt groter. Heel wat systemen in ziekenhuizen draaien nog op het “oeroude” Windows XP. Dat is niet meer verantwoord.’"
                            },
                            {
                                "example_id": "bda8dcd9-3491-43b8-b9ec-7ed5d28be806",
                                "sense_id": "b8fb9834-4393-3f19-87d7-8d708013d373",
                                "text": "In 2011 bakte Jaspers met collega-topkok Robert Kranenborg het Urker vistaartje in hun programma Topchef. Maar het oeroude recept heeft nooit bestaan. Het is dus een verzinsel van drie scholieren van het Kottenpark in Enschede, die het larieverhaal in 2009 op Wikipedia zette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43edf0d3-5d86-4ee8-8ae9-3f7222917572",
                        "source_entry_id": "15203d6d-f820-30db-ac55-903a6bbdd22e",
                        "source_sense_id": "b8fb9834-4393-3f19-87d7-8d708013d373",
