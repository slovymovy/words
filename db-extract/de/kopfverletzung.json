                ],
                "senses": [
                    {
                        "sense_id": "73015a36-0fb2-3d65-aa6e-b756126dbef2",
                        "entry_id": "db70b71c-48dd-3762-9328-ff40d318a585",
                        "glosses": [
                            "eine Verletzung am Kopf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb6ab9c5-43a3-46a7-b502-bf13279324b4",
                                "sense_id": "73015a36-0fb2-3d65-aa6e-b756126dbef2",
                                "text": "Das Opfer trug schwere Kopfverletzungen davon."
                            },
                            {
                                "example_id": "72e7e4a1-6eb7-48f1-90a6-1f544aa5f5a3",
                                "sense_id": "73015a36-0fb2-3d65-aa6e-b756126dbef2",
                                "text": "„Lucien Auguste Camus fiel 1914 im Ersten Weltkrieg durch eine tödliche Kopfverletzung in der Schlacht an der Marne.“"
                            },
                            {
                                "example_id": "1dea2969-af15-4e34-a0f1-092b5ab1cc52",
                                "sense_id": "73015a36-0fb2-3d65-aa6e-b756126dbef2",
                                "text": "„Er sollte siebzehn Jahre später, um einiges berühmter, an der Spanischen Grippe sterben, nachdem er im Ersten Weltkrieg im Jahr 1915 von einem Granatsplitter getroffen wurde und eine schwere Kopfverletzung erlitt, die zu seiner Entlassung aus dem Kriegsdienst geführt hatte.“"
                            },
                            {
                                "example_id": "349d7e8f-d7d9-46e7-9f6b-efa5904f3b94",
                                "sense_id": "73015a36-0fb2-3d65-aa6e-b756126dbef2",
                                "text": "„Der WDR teilt mit, dass der deutsche Journalist Marcus Bensmann am 20.1. bei einem Überfall in Astana schwere Kopfverletzungen und Erfrierungen erlitten hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
