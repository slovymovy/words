                ],
                "senses": [
                    {
                        "sense_id": "249c40d8-f31b-3de3-9901-0f946beeeb78",
                        "entry_id": "a5b2bc52-9b60-38f4-ab53-b0f041bc1a1b",
                        "glosses": [
                            "Wechsel der angebauten Nutzpflanzen; regelmäßig abwechselnder Anbau von Halm- und Blattfrüchten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f6fc65-eb52-4938-9ed5-a44ac5d7d917",
                                "sense_id": "249c40d8-f31b-3de3-9901-0f946beeeb78",
                                "text": "„Dagegen bedeutet der Fruchtwechsel den jährlichen Standortwechsel der einzelnen Gemüsesorten, in Anlehnung an die Vierfelderwirtschaft.“"
                            },
                            {
                                "example_id": "d5ec55e5-a4e5-4e9c-82cc-952979477b9a",
                                "sense_id": "249c40d8-f31b-3de3-9901-0f946beeeb78",
                                "text": "„Sehr ratsam ist der Fruchtwechsel auch für Arten und Familien, die aufgrund wuchshemmender Wurzelausscheidungen selbstunverträglich sind.“"
                            },
                            {
                                "example_id": "75510acf-5bb8-4099-aba3-6bd912a6f593",
                                "sense_id": "249c40d8-f31b-3de3-9901-0f946beeeb78",
                                "text": "„Eine verstärkte Viehhaltung war nötig, um einen besseren Fruchtwechsel und einen verstärkten Futterpflanzenbau einzuführen.“"
                            },
                            {
                                "example_id": "60aef020-8a96-452c-b5c0-0644dfd58926",
                                "sense_id": "249c40d8-f31b-3de3-9901-0f946beeeb78",
                                "text": "„Ein Fruchtwechsel hungert auf eine Gemüseart spezialisierte Schaderreger aus und bewahrt den Boden vor Auslaugung.“"
                            },
                            {
                                "example_id": "fe678a03-8bb2-4dce-b535-264efba04d9b",
                                "sense_id": "249c40d8-f31b-3de3-9901-0f946beeeb78",
                                "text": "„Beim Fruchtwechsel mit starkem Rübenbau war das Fünffache an Arbeitstagen erforderlich, als bei der alten Dreifelderwirtschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
