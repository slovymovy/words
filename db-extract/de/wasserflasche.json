                "senses": [
                    {
                        "sense_id": "51500705-5f7c-3f43-8ba5-ef05bc01d90a",
                        "entry_id": "dc41b7fa-ae86-30f0-bea6-2942f76a5207",
                        "glosses": [
                            "Flasche, in der Wasser ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61e21c6-d9ba-4d40-ad64-a28913f9a998",
                                "sense_id": "51500705-5f7c-3f43-8ba5-ef05bc01d90a",
                                "text": "Seine Wasserflasche war bereits nach einer halben Stunde im Fitnesscenter schon leer."
                            },
                            {
                                "example_id": "1e8c9192-5acf-4220-a557-2571fc692579",
                                "sense_id": "51500705-5f7c-3f43-8ba5-ef05bc01d90a",
                                "text": "„Rosa holte ein Stück Seife und eine Wasserflasche, und Joe wusch sich die Hände.“"
                            },
                            {
                                "example_id": "a37f404e-cad4-444b-b649-3b7e3ba98e4d",
                                "sense_id": "51500705-5f7c-3f43-8ba5-ef05bc01d90a",
                                "text": "„Ich nahm einen Schluck aus der Wasserflasche, während sich Moussa und Abou seitlich aus dem Boot hängten, um direkt aus dem Fluss zu trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5080bd60-5376-4a6e-95af-9b248f900cb9",
                        "source_entry_id": "dc41b7fa-ae86-30f0-bea6-2942f76a5207",
                        "source_sense_id": "51500705-5f7c-3f43-8ba5-ef05bc01d90a",
                        "source_sense_description": "Flasche, in der Wasser ist",
                        "target_lang_word": "water bottle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "water bottle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84c6b006-cee2-3aee-b282-a0c04cf75595",
                                        "entry_id": "23b3dbbf-6113-3cb9-98e6-6fd6409ffdaf",
                                        "glosses": [
                                            "A bottle used for carrying water or other drinks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40985494-71df-44e2-a2e1-702720ceef24",
                                                "sense_id": "84c6b006-cee2-3aee-b282-a0c04cf75595",
                                                "text": "The cyclist never left home without her water bottle."
                                            },
                                            {
                                                "example_id": "9d61684c-048e-4c83-bb35-990b81e4784a",
                                                "sense_id": "84c6b006-cee2-3aee-b282-a0c04cf75595",
                                                "text": "If you can understand why so many people would spend 50 bucks on a water bottle, you can understand a lot about America in 2019."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6769a6bb-4226-4ac8-a280-36d5d84b826f",
                        "source_entry_id": "dc41b7fa-ae86-30f0-bea6-2942f76a5207",
                        "source_sense_id": "51500705-5f7c-3f43-8ba5-ef05bc01d90a",
