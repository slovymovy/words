                ],
                "senses": [
                    {
                        "sense_id": "3cc7c7cb-b5b0-3a82-b140-d461a2e1e43f",
                        "entry_id": "c9b6cac8-3a15-3cf2-9ab9-3edee2244f16",
                        "glosses": [
                            "van het normale afwijkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02b8c8ed-651b-475b-8a7d-1af79bfe4f0a",
                                "sense_id": "3cc7c7cb-b5b0-3a82-b140-d461a2e1e43f",
                                "text": "Dit was echt een buitengewone actie."
                            },
                            {
                                "example_id": "e2ada232-d8a4-4e42-a7c2-722f071f6178",
                                "sense_id": "3cc7c7cb-b5b0-3a82-b140-d461a2e1e43f",
                                "text": "Ze had buitengewoon verlof gekregen van haar werk en de logeerkamer diende nu als tijdelijk onderkomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "54277795-e13f-3a2e-9d8d-2d6bde58d2d5",
                        "entry_id": "c9b6cac8-3a15-3cf2-9ab9-3edee2244f16",
                        "glosses": [
                            "in hoge mate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "152b8260-fc98-4923-a0f6-4867499f82ab",
                                "sense_id": "54277795-e13f-3a2e-9d8d-2d6bde58d2d5",
                                "text": "Er was buitengewone interesse voor."
                            },
                            {
                                "example_id": "444d9b4f-199c-4ca5-93cc-d7e0db7dd5e5",
                                "sense_id": "54277795-e13f-3a2e-9d8d-2d6bde58d2d5",
                                "text": "De moderne wereld heeft ons een reeks buitengewone voordelen en geneugten gebracht, waaronder technologie, medicijnen en entertainment."
                            },
                            {
                                "example_id": "0a43513c-c6df-45d6-a593-2d9c608b7005",
                                "sense_id": "54277795-e13f-3a2e-9d8d-2d6bde58d2d5",
                                "text": "Burgemeester Ron König zegt \"buitengewoon trots\" te zijn op het team. \"Go Ahead Eagles heeft echt voetbal laten zien zoals het hoort te zijn\", vindt hij. \"Heel Deventer is uitzinnig van blijdschap en terecht! We gaan woensdag het elftal groots onthalen en huldigen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98abe67f-74a1-4b3d-9142-743c7dfbbba1",
                        "source_entry_id": "c9b6cac8-3a15-3cf2-9ab9-3edee2244f16",
                        "source_sense_id": "3cc7c7cb-b5b0-3a82-b140-d461a2e1e43f",
                        "source_sense_description": "van het normale afwijkend",
                        "target_lang_word": "außergewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "außergewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb17eb96-9f94-364c-b028-914ecd008fcc",
                                        "entry_id": "09b28d88-dbda-3de5-9ac9-c443bd7bfb5d",
                                        "glosses": [
                                            "besonders; nicht dem Normalfall entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d2a9f6-6936-4fbf-bdaf-21247a3db29d",
                                                "sense_id": "eb17eb96-9f94-364c-b028-914ecd008fcc",
                                                "text": "Der neue Rennfahrer hat einen außergewöhnlichen Start hingelegt."
                                            },
                                            {
                                                "example_id": "37bd3a31-5a58-43ee-85ec-16aa713f40d4",
                                                "sense_id": "eb17eb96-9f94-364c-b028-914ecd008fcc",
                                                "text": "„Durch Vermittlung seines Klassenlehrers trat die Demonstrationsperson wiederholt im Kinderfunk des Senders Hamburg auf und hinterließ nach Meinung der Redakteurin einen außergewöhnlichen Eindruck …“"
                                            },
                                            {
                                                "example_id": "e8031285-df45-4e37-b8a3-ee4848361f0f",
                                                "sense_id": "eb17eb96-9f94-364c-b028-914ecd008fcc",
                                                "text": "„Bei Aristoteles und seiner Schule finden wir erstmals die Verknüpfung der Melancholie mit außergewöhnlichen, genialischen Leistungen des Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc123431-b1cc-42e8-905e-17d5ae19a85d",
                        "source_entry_id": "c9b6cac8-3a15-3cf2-9ab9-3edee2244f16",
                        "source_sense_id": "3cc7c7cb-b5b0-3a82-b140-d461a2e1e43f",
                        "source_sense_description": "van het normale afwijkend",
                        "target_lang_word": "ungewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                        "entry_id": "d558a056-9765-32fb-abcf-008daa80df73",
                                        "glosses": [
                                            "nicht gewöhnlich, nicht der Gewohnheit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddf01c-63b6-4531-acc4-ab87866ab722",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Ungewöhnliche Zeiten erfordern ungewöhnliches Handeln."
                                            },
                                            {
                                                "example_id": "8ee19457-0104-4db1-ba7b-f1bf4d5cf5ad",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "94b0dd82-a208-4b55-91a6-beb7480c5d26",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Am ungewöhnlichsten jedoch war ihre Art zu laufen."
                                            },
                                            {
                                                "example_id": "6b05cb6a-5499-45eb-9df7-7e1b876bc456",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Wie reagiert die Psyche des Straßenbahnkondukteurs auf ein Douceur von ungewöhnlichem Ausmaße, das zum Beispiel mehr als dreimal so groß ist als der Fahrpreis und siebenmal so groß als das Normaltrinkgeld!“"
                                            },
                                            {
                                                "example_id": "74dbb13f-c556-49ce-a05a-1667ff695ef4",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Auf einer Pressekonferenz erklärte der US-Präsident [Donald Trump], dass er ein Treffen mit dem kanadischen Premierminister Justin Trudeau […] ausgeschlagen habe. Ungewöhnlich ist, dass ein amtierender Präsident dies öffentlich sagt. Besonders ungewöhnlich ist, dass Kanada gar nicht um das Treffen gebeten hatte. Dies teilte Trudeaus Sprecherin im Anschluss mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
