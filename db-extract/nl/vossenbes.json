                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc5d9f7a-f7e9-307b-89a4-14c97930af98",
                                        "entry_id": "37710e3f-1327-3274-bb80-5f9119f53d03",
                                        "glosses": [
                                            "Fruit de ce sous-arbrisseau."
