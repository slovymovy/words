                                "target_word": "außerehelich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f593af13-6a05-32b7-afa6-f83c67395c97",
                                        "entry_id": "54fe7087-00f9-3451-ab43-2b19be662cce",
                                        "glosses": [
                                            "nicht ehelich, außerhalb der Ehe geboren oder stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcb736e5-da8c-4905-b131-7ad6176fdcae",
                                                "sense_id": "f593af13-6a05-32b7-afa6-f83c67395c97",
                                                "text": "Seit Jahren führt sie eine außereheliche Beziehung mit ihrem Kollegen."
                                            },
                                            {
                                                "example_id": "eae196ae-7c7d-4f74-b315-9b3247d419ec",
                                                "sense_id": "f593af13-6a05-32b7-afa6-f83c67395c97",
                                                "text": "Er wurde außerehelich geboren."
                                            },
                                            {
                                                "example_id": "2375c0c7-24f6-4e9d-83e7-c4b17fc18b90",
                                                "sense_id": "f593af13-6a05-32b7-afa6-f83c67395c97",
                                                "text": "Er hat drei außereheliche Kinder."
                                            },
                                            {
                                                "example_id": "dacc5a1a-6cec-4e27-8b15-9fade14c854f",
                                                "sense_id": "f593af13-6a05-32b7-afa6-f83c67395c97",
                                                "text": "„Ungeschickterweise verhedderte sich Hamilton fast zeitgleich in eine außereheliche Affäre.“"
                                            },
                                            {
                                                "example_id": "e220273f-e51d-43a0-b621-6dd8603c909d",
                                                "sense_id": "f593af13-6a05-32b7-afa6-f83c67395c97",
                                                "text": "„Die sogenannte Hudood-Gesetzgebung (1979), auf deren Grundlage Frauen im Falle von außerehelichem Sex bestraft werden und die doppelte Anzahl von Zeugen bei einer Vergewaltigung vorweisen müssen, bedeutete eine staatlich sanktionierte Diskriminierung, wie sie bis dahin lediglich im Volksbrauch - wenn auch weitreichend - praktiziert worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
