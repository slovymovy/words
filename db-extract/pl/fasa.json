                                                "example_id": "d669c45b-9cd3-46f3-bfa6-543f13ad0cb5",
                                                "sense_id": "577889ed-9b16-3092-b3ab-2481f5045cfe",
                                                "text": "Zur Silberhochzeit seiner Schwester kaufte er ein großes Fass Bier."
                                            },
                                            {
                                                "example_id": "66fffc95-2c8b-4d0c-bdf4-b054130e3207",
                                                "sense_id": "577889ed-9b16-3092-b3ab-2481f5045cfe",
                                                "text": "„Für den Fisch brauchte man Fässer, für die Fässer Dauben, für die Dauben Holz und gegen die Luft dazwischen Pech.“"
                                            },
                                            {
                                                "example_id": "894a3990-17c7-44b1-928a-abe1f8540ccf",
                                                "sense_id": "577889ed-9b16-3092-b3ab-2481f5045cfe",
                                                "text": "„Wissenschaftler haben im Nordostatlantik bereits mehr als 1.000 Fässer mit Atommüll entdeckt, die verschiedene Staaten dort vor Jahrzehnten entsorgt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
