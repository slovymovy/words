                        "cross_references": [
                            {
                                "target_word": "pandemonium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6942b88b-cf6d-3c99-8edb-9d3d07932323",
                                        "entry_id": "03a57d43-3ef8-36a7-a6f7-633d5a7818ea",
                                        "glosses": [
                                            "A loud, wild, tumultuous protest, disorder, or chaotic situation, usually of a crowd, often violent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aba42f4-f0ee-4833-bcda-1e0bfc319395",
                                                "sense_id": "6942b88b-cf6d-3c99-8edb-9d3d07932323",
                                                "text": "Whatever all this pandemonium means, I suppose the police station will help us."
                                            },
                                            {
                                                "example_id": "7af9ec8e-fe7c-40c5-a6b1-9f8539e6681e",
                                                "sense_id": "6942b88b-cf6d-3c99-8edb-9d3d07932323",
                                                "text": "Whenever you have violent pandemonium, there's the overwhelming possibility for panic and tragedy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1621edf-11f4-34c3-a606-15b92149e979",
                                        "entry_id": "03a57d43-3ef8-36a7-a6f7-633d5a7818ea",
                                        "glosses": [
                                            "An outburst; loud, riotous uproar, especially of a crowd."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a540253a-891d-434d-ab07-744a57e8fe64",
                                                "sense_id": "d1621edf-11f4-34c3-a606-15b92149e979",
                                                "text": "Riyad Mahrez flighted the free-kick that followed to the far post and Morgan, with not much finesse but plenty of desire, bundled the ball over the line. Cue pandemonium in the stands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
