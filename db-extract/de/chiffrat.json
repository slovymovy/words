                                "target_senses": [
                                    {
                                        "sense_id": "cb5f00bf-41bf-3a2f-ba3c-31c25ed7f62c",
                                        "entry_id": "0530815a-bf37-3054-bbfa-43e8a0449564",
                                        "glosses": [
                                            "Encoded or encrypted text."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a3b2ca-3c03-4205-b090-fd78af3cf8b6",
                                                "sense_id": "cb5f00bf-41bf-3a2f-ba3c-31c25ed7f62c",
                                                "text": "All ciphertexts look alike; that's how you know they're in code."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ae9bc0e-a7cc-476a-9f36-f504664570ef",
                        "source_entry_id": "2c460a6b-4024-3050-b093-bd99b19884c3",
                        "source_sense_id": "4f4d3e9b-5975-3d12-a10e-1c504a0ee10a",
                        "source_sense_description": "Kryptographie: mittels eines kryptographischen Verfahrens verschlüsselter Text",
                        "target_lang_word": "cyphertext",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyphertext",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8a90d68-1f5e-3cde-8bb1-c92d7a3b7471",
                                        "entry_id": "a42199df-681d-3310-bce5-27b14191ceb7",
                                        "glosses": [
                                            "Alternative spelling of ciphertext."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ab4313-d47a-4604-8c00-cb1bc181574f",
                                                "sense_id": "d8a90d68-1f5e-3cde-8bb1-c92d7a3b7471",
                                                "text": "To this goal Alice encrypts the plaintext into a cyphertext by mean of an encryption algorithm with the help of some secret additional information, called key."
                                            },
                                            {
                                                "example_id": "4a7300ec-b7e9-44d9-81af-26681055c76b",
                                                "sense_id": "d8a90d68-1f5e-3cde-8bb1-c92d7a3b7471",
                                                "text": "The cyphertext can be randomized by everyone, but the entity that performs the re-encryption can identify if the cyphertext is safe."
                                            },
                                            {
                                                "example_id": "20fe4b66-d7a9-4d0b-92bf-69452a6cab30",
                                                "sense_id": "d8a90d68-1f5e-3cde-8bb1-c92d7a3b7471",
                                                "text": "In simple terms, encryption is the process of converting plaintext, such as messages or information, into a data format that is unreadable by human or computer, known as cyphertext, using an encryption algorithm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0287c3cb-0abd-49b5-8185-7ab45c0f00f4",
                        "source_entry_id": "2c460a6b-4024-3050-b093-bd99b19884c3",
                        "source_sense_id": "4f4d3e9b-5975-3d12-a10e-1c504a0ee10a",
                        "source_sense_description": "Kryptographie: mittels eines kryptographischen Verfahrens verschlüsselter Text",
                        "target_lang_word": "cryptogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                        "entry_id": "663f447a-4852-307a-83d2-ddb9ec327132",
                                        "glosses": [
                                            "Message chiffré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0a261a-bc3c-4026-8ad3-e6e341944cf3",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Jules Verne utilise plusieurs fois les cryptogrammes dans ses romans. Dans La Jangada, un juge doit déchiffrer un message pour sauver un condamné. Dans Voyage au centre de la Terre, le professeur Lidenbrock doit résoudre le mystère d'un parchemin sur lequel est inscrit un message incompréhensible en signes runiques."
                                            },
                                            {
                                                "example_id": "4a00e3c3-a3ed-4d46-8200-9f3db2b03cb7",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "On soupçonna dès lors l’anagramme de Grosser d’être une pure coïncidence, et l’hypothèse chrétienne fut contestée par ceux qui jugeaient improbable, à cette date, la création d’un tel cryptogramme par des chrétiens, voire l’existence même d’une communauté chrétienne à Pompéi."
                                            },
                                            {
                                                "example_id": "f747de58-b47a-41a5-99ed-5ce60224d61c",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Il faut évoquer ici le thème récurrent du « cryptogramme ». Certains romans commencent par la découverte d’un document écrit – incomplet ou chiffré– dont le déchiffrement va jouer un rôle décisif dans l’affabulation."
                                            },
                                            {
                                                "example_id": "ca16393d-a32e-4ccf-829b-22f057a6a4d7",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Je supposai donc que le cryptogramme était anglais"
                                            },
                                            {
                                                "example_id": "92f9df37-43de-44ea-bf1a-ed7564192ac8",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Une autre mention intéressante est celle des nombres dont l’emploi dans les cryptogrammes nous rappelle les origines mathématiques du chiffrement."
                                            },
                                            {
                                                "example_id": "a7eaacf1-b14b-4772-9dc9-de06e4e93396",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Au terme du travail de déchiffrement, pas moins de 2 900 cryptogrammes soviétiques furent décodés, dont 49 avaient pour objet le projet Manhattan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986a7893-530f-34b5-ad14-61d70511d79a",
                                        "entry_id": "663f447a-4852-307a-83d2-ddb9ec327132",
                                        "glosses": [
                                            "Problème à résoudre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28e90e8-9f9b-427f-a043-f6725b564357",
                                                "sense_id": "986a7893-530f-34b5-ad14-61d70511d79a",
                                                "text": "Les passions sont toutes bonnes de leur nature disait Descartes. Il faut les comprendre, au vrai, affirme Fourier toutes « sans excepter celles que la morale fait passer pour les plus indignes égarements de l'esprit et des sens, constituent un cryptogramme indivisible que l'homme est appelé à déchiffrer»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
