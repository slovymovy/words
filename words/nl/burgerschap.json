            "senses": [
                {
                    "sense_id": "a619a390-b022-300d-8904-46fc53cce8c1",
                    "sense_definition": "De juridische status van een persoon als lid van een staat, met de bijbehorende rechten en plichten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridische status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na vijf jaar in Nederland te hebben gewoond, vroeg hij het Nederlandse <w>burgerschap</w> aan.",
                            "target_lang_translations": {
                                "en": "After living in the Netherlands for five years, he applied for Dutch <w>citizenship</w>."
                            }
                        },
                        {
                            "text": "Het verkrijgen van een dubbel <w>burgerschap</w> is in sommige landen wettelijk niet toegestaan.",
                            "target_lang_translations": {
                                "en": "Obtaining dual <w>citizenship</w> is not legally permitted in some countries."
                            }
                        }
                    ],
                    "synonyms": [
                        "nationaliteit",
                        "staatsburgerschap"
                    ],
                    "common_phrases": [
                        "Nederlands burgerschap",
                        "dubbel burgerschap",
                        "burgerschap aanvragen"
                    ],
                    "target_lang_definitions": {
                        "en": "The legal status of a person as a member of a state, including the associated rights and duties."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "citizenship",
                                "target_lang_sense_clarification": "legal status in a country"
                            },
                            {
                                "target_lang_word": "nationality",
                                "target_lang_sense_clarification": "legal membership of a nation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3091ad4-7052-3699-a571-787f0516ca18",
                    "sense_definition": "De actieve betrokkenheid en verantwoordelijkheid van een individu binnen een samenleving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maatschappelijke rol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholen besteden tegenwoordig veel aandacht aan actief <w>burgerschap</w> en democratische waarden.",
                            "target_lang_translations": {
                                "en": "Schools nowadays pay a lot of attention to active <w>citizenship</w> and democratic values."
                            }
                        },
                        {
                            "text": "Goed <w>burgerschap</w> betekent ook dat je respect toont voor de regels van de gemeenschap.",
                            "target_lang_translations": {
                                "en": "Good <w>citizenship</w> also means showing respect for the rules of the community."
                            }
                        }
                    ],
                    "synonyms": [
                        "medeverantwoordelijkheid"
