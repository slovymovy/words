                "senses": [
                    {
                        "sense_id": "bad89811-4bf7-3c25-9dc8-7fd2c3e4cf74",
                        "entry_id": "19d69858-9720-3766-b594-1b0bbe5e4bde",
                        "glosses": [
                            "разг. удобный, подходящий, легко исполняемый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da340cd3-ec47-4a29-a4c5-c5a077d37639",
                                "sense_id": "bad89811-4bf7-3c25-9dc8-7fd2c3e4cf74",
                                "text": "Поросёнка ж освежевать, сварить иль испечь — самое разлюбезное, самое сподручное дело."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86910a5b-52a0-4a54-8551-9343081d9481",
                        "source_entry_id": "19d69858-9720-3766-b594-1b0bbe5e4bde",
                        "source_sense_id": "bad89811-4bf7-3c25-9dc8-7fd2c3e4cf74",
                        "target_lang_word": "handy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee64ff21-73f5-3b0b-82b0-7b01d7ba616f",
                                        "entry_id": "4fae5765-cd69-3145-95f5-309046e4067b",
                                        "glosses": [
                                            "Easy to use, useful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40a143a-27ad-4ded-af2a-10eeb528e7fe",
                                                "sense_id": "ee64ff21-73f5-3b0b-82b0-7b01d7ba616f",
                                                "text": "Some people regard duct tape as a handy fix-all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7913c67d-2e1d-3234-bd85-903d926812c4",
                                        "entry_id": "4fae5765-cd69-3145-95f5-309046e4067b",
                                        "glosses": [
                                            "Nearby, within reach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebfb47bb-b52c-4b71-8958-097881683e26",
                                                "sense_id": "7913c67d-2e1d-3234-bd85-903d926812c4",
                                                "text": "You wouldn’t have a screwdriver handy, would you?"
                                            },
                                            {
                                                "example_id": "cdce11c1-a90c-4055-bc81-a112a226cbcb",
                                                "sense_id": "7913c67d-2e1d-3234-bd85-903d926812c4",
                                                "text": "I keep a first-aid kit handy in case of emergency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3c0c1b0-bd30-34f9-8769-0aaea537708a",
                                        "entry_id": "4fae5765-cd69-3145-95f5-309046e4067b",
                                        "glosses": [
                                            "Dexterous, skilful. (of a person)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c09c11-6265-488b-8180-ba6c629ea790",
                                                "sense_id": "e3c0c1b0-bd30-34f9-8769-0aaea537708a",
                                                "text": "She's very handy: she made all her own kitchen cupboards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b57dccf-0714-39da-9a22-11305a7d8a0a",
                                        "entry_id": "4fae5765-cd69-3145-95f5-309046e4067b",
                                        "glosses": [
                                            "Physically violent; tending to use one's fists."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09f3cbff-30c2-4e49-8ea2-7ce17b2cb0a5",
                                                "sense_id": "8b57dccf-0714-39da-9a22-11305a7d8a0a",
                                                "text": "We had a sergeant who was a bit handy with the rougher elements. He dealt with them a little bit differently to what I do."
                                            },
                                            {
                                                "example_id": "59edc1d6-5b5c-4241-aac8-f1524fb29499",
                                                "sense_id": "8b57dccf-0714-39da-9a22-11305a7d8a0a",
                                                "text": "The Sloanes said he had nothing on them, that he threatened them, made up a lot of lies. Tried to attack them, got a bit handy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd2d0ebe-e5d0-3c72-8c24-e05cb6bf3987",
                                        "entry_id": "4fae5765-cd69-3145-95f5-309046e4067b",
                                        "glosses": [
                                            "Of a freight ship: having a small cargo capacity (less than 40,000 DWT); belonging to the handysize class."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "handy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c2fce20-d722-32d1-8bb2-6bbc1c920219",
                                        "entry_id": "0d310343-f0fc-3588-8ea9-bc2954bc8fa3",
                                        "glosses": [
                                            "The hand."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1df5844-4613-45ce-ad23-7ed436c6a147",
                                                "sense_id": "7c2fce20-d722-32d1-8bb2-6bbc1c920219",
                                                "text": "Clap, clap handies\n Mammie's wee, wee ain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "handy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb52841-b16c-3e84-8268-84cbeff580a6",
                                        "entry_id": "382cd82f-9246-3315-b95c-689accb5e1da",
                                        "glosses": [
                                            "A handgun."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcb483d0-c305-42c0-9954-1bbbda9de40f",
                                                "sense_id": "4bb52841-b16c-3e84-8268-84cbeff580a6",
                                                "text": "Look left and right, when I cross these roads,\nI don’t wanna get fright\nWe got handies and shotties,\nwhich one should you decide?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd3bc18c-de8c-3e92-b66d-1506153abc72",
                                        "entry_id": "382cd82f-9246-3315-b95c-689accb5e1da",
                                        "glosses": [
                                            "A hand job."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "handy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd8ee4d9-c07f-313e-8a80-217351de5956",
                                        "entry_id": "8105218f-2f1a-369f-b085-bf044ac607b8",
                                        "glosses": [
                                            "Synonym of mobile phone."
                                        ],
                                        "tags": [
                                            "used by Germans"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1774fff-7596-4157-afc4-c53f72556ba9",
                                                "sense_id": "dd8ee4d9-c07f-313e-8a80-217351de5956",
                                                "text": "An important field of application for small rechargeable lithium ion batteries is that of the fast growing market of cellular phones or ‘handies’. 277,000,000 handies were sold worldwide in 1999."
                                            },
                                            {
                                                "example_id": "33a2b2d3-5b51-4d96-8229-e170cda0887b",
                                                "sense_id": "dd8ee4d9-c07f-313e-8a80-217351de5956",
                                                "text": "“I’m afraid Mister Franklyn is occupied until seven o’clock. He shall call when he breaks. I’ll take a handy to receive calls—”[…]The distance frees him to take phone calls on his handy."
                                            },
                                            {
                                                "example_id": "75045557-aba5-4b2c-9dc2-1cbc3d3e3d88",
                                                "sense_id": "dd8ee4d9-c07f-313e-8a80-217351de5956",
                                                "text": "Life was good and quiet until six weeks ago when he received a phone call on his handy from Unbekannt Nummer --Unknown Number."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e04e15aa-4d4e-453a-8e15-a31877594039",
                        "source_entry_id": "19d69858-9720-3766-b594-1b0bbe5e4bde",
                        "source_sense_id": "bad89811-4bf7-3c25-9dc8-7fd2c3e4cf74",
                        "target_lang_word": "convenient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convenient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "185971d0-899d-3131-84cd-6ef86e56f114",
                                        "entry_id": "e3782abd-a082-3914-abb3-50159bc9c9d4",
                                        "glosses": [
                                            "Serving to reduce a difficulty, or accessible with minimum difficulty; expedient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65f81cb3-7487-428a-9384-edac9d3cb181",
                                                "sense_id": "185971d0-899d-3131-84cd-6ef86e56f114",
                                                "text": "Fast food might be convenient, but it's also very unhealthy."
                                            },
                                            {
                                                "example_id": "293c3909-d6a8-42b2-825a-62b07641bcc3",
                                                "sense_id": "185971d0-899d-3131-84cd-6ef86e56f114",
                                                "text": "Some re-arrangement of equipment in the driving cars has produced a more convenient working space for the driver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9739976-ff2c-316c-90de-018476a1dc92",
                                        "entry_id": "e3782abd-a082-3914-abb3-50159bc9c9d4",
                                        "glosses": [
                                            "Suspicious due to suiting someone's purposes very well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16377b97-547d-4e8b-b9f3-7de496c96e7e",
                                                "sense_id": "d9739976-ff2c-316c-90de-018476a1dc92",
                                                "text": "How convenient that you caught a cold the night before your essay was due."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65da34b-f124-3b41-9dfb-3678afcc9538",
                                        "entry_id": "e3782abd-a082-3914-abb3-50159bc9c9d4",
                                        "glosses": [
                                            "Fit; suitable; appropriate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa9d0b42-2923-4dd4-9c07-31dd910cf305",
                                                "sense_id": "a65da34b-f124-3b41-9dfb-3678afcc9538",
                                                "text": "Feed me with food convenient for me."
                                            },
                                            {
                                                "example_id": "9b8b0278-c77a-45af-922e-26f89dad8eeb",
                                                "sense_id": "a65da34b-f124-3b41-9dfb-3678afcc9538",
                                                "text": "Neither filthiness, nor foolish talking, nor jesting, which are not convenient."
                                            },
                                            {
                                                "example_id": "c0af420d-4a10-40e1-8fc1-3ad42814c68b",
                                                "sense_id": "a65da34b-f124-3b41-9dfb-3678afcc9538",
                                                "text": "[…] continual drinking is most convenient to the distemper of an hydropick body, though most disconvenient to its present welfare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
