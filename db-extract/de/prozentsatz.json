                "senses": [
                    {
                        "sense_id": "315d5367-ce3e-309e-819d-ea06cf462977",
                        "entry_id": "e0d9f0e5-d342-3610-adcf-59761a45bca8",
                        "glosses": [
                            "in Hundertstel festgelegter, genannter Anteil eines Betrags, einer Größe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c07dad-6396-4ed5-adb7-d16446f555ec",
                                "sense_id": "315d5367-ce3e-309e-819d-ea06cf462977",
                                "text": "„Bei der degressiven AfA wird ein fester Prozentsatz in jedem Jahr erneut vom Buchwert des Vorjahres abgezogen.“"
                            },
                            {
                                "example_id": "91907918-295d-4bcd-a6bf-43f72927d23d",
                                "sense_id": "315d5367-ce3e-309e-819d-ea06cf462977",
                                "text": "„Ein nicht geringer Prozentsatz betuchter Männer besucht sogar regelmäßig eine Domina und lässt sich von ihr für zweihundertfünfzig Euro eine Stunde lang demütigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14f9a831-fcca-45b3-9dca-5dfc544cd6b8",
                        "source_entry_id": "e0d9f0e5-d342-3610-adcf-59761a45bca8",
                        "source_sense_id": "315d5367-ce3e-309e-819d-ea06cf462977",
                        "source_sense_description": "in Hundertstel festgelegter, genannter Anteil eines Betrags, einer Größe",
                        "target_lang_word": "percentage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percentage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                                        "entry_id": "9b147ca6-3dd2-310c-8de0-17f002cd8d24",
                                        "glosses": [
                                            "The amount, number or rate of something, regarded as part of a total of 100; a part of a whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a04a0e76-63d2-4526-b903-2ccab1d409a9",
                                                "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                                                "text": "A high percentage of secondary school leavers take a gap year."
                                            },
                                            {
                                                "example_id": "2b934f59-fc31-4e61-9f44-25439231d735",
                                                "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                                                "text": "The replacement percentages are based largely on household spending data from the Department of Labor's Consumer Expenditure Survey."
                                            },
                                            {
                                                "example_id": "85665076-b72d-466a-bd96-3c0501bc9446",
                                                "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                                                "text": "Kramer said California’s legislation is weak compared to the laws in Norway and other European countries, which require a certain percentage of women on boards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaa511b3-3d25-3b5a-98de-b276c1f1bc19",
                                        "entry_id": "9b147ca6-3dd2-310c-8de0-17f002cd8d24",
                                        "glosses": [
                                            "A share of the sales, profits, gross margin or similar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095aee75-e250-4f28-8724-4e04ff242138",
                                                "sense_id": "eaa511b3-3d25-3b5a-98de-b276c1f1bc19",
                                                "text": "She gets a percentage for every vacuum cleaner sold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3107a7f-4d5b-3b22-a6b7-0714d1fdb0db",
                                        "entry_id": "9b147ca6-3dd2-310c-8de0-17f002cd8d24",
                                        "glosses": [
                                            "Benefit or advantage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c80ec990-23cb-4fc9-ac71-b2653c59d11c",
                                                "sense_id": "f3107a7f-4d5b-3b22-a6b7-0714d1fdb0db",
                                                "text": "There was no percentage in staying at home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1125e22-9300-490c-8036-5e9b5b9e556b",
                        "source_entry_id": "e0d9f0e5-d342-3610-adcf-59761a45bca8",
                        "source_sense_id": "315d5367-ce3e-309e-819d-ea06cf462977",
