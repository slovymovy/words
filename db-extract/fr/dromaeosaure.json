                    {
                        "translation_id": "e78a5060-e24e-41a1-a7d3-489090a4fd84",
                        "source_entry_id": "9c31058e-2851-3f4a-b146-db3a5a7ceb95",
                        "source_sense_id": "35cdba3d-92d9-38c2-8166-3dbc3e33e983",
