                "senses": [
                    {
                        "sense_id": "c27e4d1f-76a5-3452-89d8-4d4ad9aa0f72",
                        "entry_id": "b27c5189-5852-30ab-881a-11bec06d0af2",
                        "glosses": [
                            "Troupe de soldats composée de dix hommes et formant le dixième de la centurie."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "e8e19c99-e55a-41c0-b2f0-2525948b6e5b",
                                "sense_id": "c27e4d1f-76a5-3452-89d8-4d4ad9aa0f72",
                                "text": "Enfin, les individus eux-mêmes étaient appariés, et chaque soldat d’une décurie avait son émule dans la décurie correspondante."
                            },
                            {
                                "example_id": "587e208b-38e8-41bd-a75b-1bc422a6f46c",
                                "sense_id": "c27e4d1f-76a5-3452-89d8-4d4ad9aa0f72",
                                "text": "Cette cavalerie se divisait en turmes. Une turme, ou décurie, comptait trente-deux cavaliers commandés par un décurion (decurio)"
                            }
                        ]
                    },
                    {
                        "sense_id": "daa53ed7-8157-323b-b511-1bba510bff0a",
                        "entry_id": "b27c5189-5852-30ab-881a-11bec06d0af2",
                        "glosses": [
                            "Division du peuple qui formait aussi le dixième d’une centurie, mais qui comprenait un nombre indéterminé de citoyens."
                        ],
