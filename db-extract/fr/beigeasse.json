                                            {
                                                "example_id": "07ea045b-0e39-495e-b7fb-0255524e79aa",
                                                "sense_id": "f42d8398-5b39-31df-a131-3d2b45b9f733",
                                                "text": "Die anfangs mondbleichen Farben werden von Bild zu Bild vielfältiger und kräftiger, wenngleich die meisten sich in Gegenwart von Grau am meisten wohlzufühlen scheinen: graublau, graugrün, graubraun, schwarzbraun, braungelb, graugelb, graubeige, weiß — je nach Szene mehr erdig oder mehr mondig."
                                            },
                                            {
                                                "example_id": "5ae85ca0-c99e-4a73-bc06-fe4d7c8b8316",
                                                "sense_id": "f42d8398-5b39-31df-a131-3d2b45b9f733",
                                                "text": "Da ist auch bald die erste „Weitung\" — eine hohe Halle mit rauhen Wänden, die bläulich, braungelb und türkisfarben schimmern."
                                            },
                                            {
                                                "example_id": "3a150bb4-d9f2-4250-89e4-89d1667d76d5",
                                                "sense_id": "f42d8398-5b39-31df-a131-3d2b45b9f733",
                                                "text": "Gelbbraun der Kopf, die Nakkenfedern blaßgrau, die Kehle ist schwarz und die Unterseite weiß, der Körper sonst, von den Schultern sich verfärbend, über grau bis braungelb."
                                            }
                                        ],
