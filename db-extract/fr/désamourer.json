                "senses": [
                    {
                        "sense_id": "c405bcee-a671-3570-b146-e768371342ba",
                        "entry_id": "b24186e5-0ba9-3926-9166-4546a71ea7a4",
                        "glosses": [
                            "Faire perdre son amour à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6432984c-ddb9-4a76-aece-797eedab8eb7",
                                "sense_id": "c405bcee-a671-3570-b146-e768371342ba",
                                "text": "Elles n’arrivaient pas à se désamourer."
                            },
                            {
                                "example_id": "b7d4839f-9af5-4871-8402-267cfa419081",
                                "sense_id": "c405bcee-a671-3570-b146-e768371342ba",
                                "text": "Marion suivait le manège de Jacques pour désamourer sa femme avec mélancolie."
                            },
                            {
                                "example_id": "86be9f71-0531-475d-a492-8ef9400a28e5",
                                "sense_id": "c405bcee-a671-3570-b146-e768371342ba",
                                "text": "Il incarne le désamouré, le drop-out, ce hobo cher à Jack Kerouac, son destin scellé depuis trois générations en bottes douze et cageots cachetés sur la dalle de Rungis."
                            }
                        ]
                    }
