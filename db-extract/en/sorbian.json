                    {
                        "translation_id": "01256dcd-b9ce-4069-8235-9aac9f6b5a78",
                        "source_entry_id": "f3a0d150-1741-37dd-99cf-f9b0da690af0",
                        "source_sense_id": "b5b8713b-fc10-3933-983f-60e046a315ce",
                        "source_sense_description": "of or pertaining to the Sorbs or to the Sorbian language",
                        "target_lang_word": "sorbisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorbisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f114d544-c766-33de-9b06-68cfd895d42a",
                                        "entry_id": "89478f76-d760-3394-8523-301b57b0b5cf",
                                        "glosses": [
                                            "zum Volk der Sorben gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9548d9a3-b6bd-45e7-ba43-780ba7fec446",
                                                "sense_id": "f114d544-c766-33de-9b06-68cfd895d42a",
                                                "text": "Er brachte seine sorbische Ehefrau mit."
                                            },
                                            {
                                                "example_id": "525e8e19-ca22-41aa-a2f1-39f6a82c1f52",
                                                "sense_id": "f114d544-c766-33de-9b06-68cfd895d42a",
                                                "text": "„Vielleicht ist die Definition dessen, was heute sorbisches Wesen ausmacht, nur aus dem Mund eines sorbischen Dichters zu erfahren.“"
                                            },
                                            {
                                                "example_id": "39449db0-190a-4a9e-a453-430703609e0d",
                                                "sense_id": "f114d544-c766-33de-9b06-68cfd895d42a",
                                                "text": "„Er kennt alle sorbischen Kutscher aus Grodk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8ca9501-d218-383a-92bd-3a9ffc271821",
                                        "entry_id": "89478f76-d760-3394-8523-301b57b0b5cf",
                                        "glosses": [
                                            "zu den sorbischen Sprachen (Sorbisch) gehörig"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17cfff7f-000a-4c4c-b36f-bb76d2c2d1d0",
                                                "sense_id": "b8ca9501-d218-383a-92bd-3a9ffc271821",
                                                "text": "Ich habe wieder ein paar sorbische Wörter gelernt."
                                            },
                                            {
                                                "example_id": "78fbccce-496f-4fb9-93f1-6d94291f4cf2",
                                                "sense_id": "b8ca9501-d218-383a-92bd-3a9ffc271821",
                                                "text": "„Biegt man vor Hochkirch in Steindörfel von der Straße rechterhand ab, gelangt man in das Dörchen Wuischke mit dem zungenbrecherischen sorbischen Namen Wujezk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fce2e4b-05da-4877-a21e-225aaf235c13",
                        "source_entry_id": "f3a0d150-1741-37dd-99cf-f9b0da690af0",
                        "source_sense_id": "b5b8713b-fc10-3933-983f-60e046a315ce",
                        "source_sense_description": "of or pertaining to the Sorbs or to the Sorbian language",
                        "target_lang_word": "wendisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wendisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a18bb9a-2c54-33b4-acc4-cac25b835548",
                                        "entry_id": "1dadc540-ab76-3990-bdd3-27782ff1da6b",
                                        "glosses": [
                                            "auf die Wenden bezogen, sie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126c7ad4-ed14-43df-9b5f-5d2fdf3356e6",
                                                "sense_id": "2a18bb9a-2c54-33b4-acc4-cac25b835548",
                                                "text": "„Die Freundschaft, die seitdem Albrecht mit dem wendischen Fürstenpaar verband, hat ersterem zu der späteren Herrschaft über das Havelland verholfen und zur Begründung der Mark Brandenburg geführt.“"
                                            },
                                            {
                                                "example_id": "bf8631d8-5fa2-4565-a4cf-4ec16d3f7fad",
                                                "sense_id": "2a18bb9a-2c54-33b4-acc4-cac25b835548",
                                                "text": "„Krabat, ein Junge von vierzehn Jahren damals, hatte sich mit zwei anderen wendischen Betteljungen zusammengetan, und obgleich Seine allerdurchlauchtigste Gnaden, der Kurfürst von Sachsen, das Betteln und Vagabundieren in Höchstderoselben Landen bei Strafe verboten hatten […], zogen sie als Dreikönige in der Gegend von Hoyerswerda von Dorf zu Dorf […]“"
                                            },
                                            {
                                                "example_id": "dfcd4620-0bb8-4805-a731-eaafc5496198",
                                                "sense_id": "2a18bb9a-2c54-33b4-acc4-cac25b835548",
                                                "text": "„Am Fuß des Berges wurde die Scipita Marata, die Mittagsfrau, vom Stolpener Scharfrichter zu Tode gebracht, nachdem sie versucht hatte, einen wendischen Knecht zu verführen.“"
                                            },
                                            {
                                                "example_id": "a00d4220-cb8d-4e47-a2c5-54ca966faf98",
                                                "sense_id": "2a18bb9a-2c54-33b4-acc4-cac25b835548",
                                                "text": "„Maika gehört zu den wendischen Weisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
