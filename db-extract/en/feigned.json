        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b2c2f97a-64fd-3eaf-a608-8129e0e69706",
                "word": "feigned",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ff16877-b433-38e1-b4ff-6cb7bb86c149",
                        "entry_id": "b2c2f97a-64fd-3eaf-a608-8129e0e69706",
                        "glosses": [
                            "Being a pretense, simulation, or counterfeit, or something false or fraudulent."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "68e75f4d-d34c-4865-abdf-447d10600bfc",
                                "sense_id": "6ff16877-b433-38e1-b4ff-6cb7bb86c149",
                                "text": "I have discovered that a feigned familiarity in great ones is a note of certain usurpation on the less. For great and popular men feign themselves to be servants to others to make those slaves to them. So the fisher provides bait for the trout, roach, dace, &c., that they may be food to him."
                            },
                            {
                                "example_id": "d147b293-ade8-442f-9d67-52e2b6b9e438",
                                "sense_id": "6ff16877-b433-38e1-b4ff-6cb7bb86c149",
                                "text": "\"I have passed my word,\" said Jowl with feigned reluctance, \"and I'll keep it. When does this match come off? I wish it was over. -- To-night?\""
                            },
                            {
                                "example_id": "df670419-e674-4dd5-bcaa-ca5cf2e5a05d",
                                "sense_id": "6ff16877-b433-38e1-b4ff-6cb7bb86c149",
                                "text": "And yet another marvel, the nether side of the canopy over the high seats was encrusted with lapis lazuli, and in that feigned dome of heaven burned the twelve signs of the zodiac, every star a diamond that shone with its own light."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2655da9-f9b1-41cd-b11a-45d2a844bd2a",
                        "source_entry_id": "b2c2f97a-64fd-3eaf-a608-8129e0e69706",
                        "source_sense_id": "6ff16877-b433-38e1-b4ff-6cb7bb86c149",
