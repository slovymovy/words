                        "examples": [
                            {
                                "example_id": "4d317b44-d4b7-4ef9-9900-268b1f3ddf14",
                                "sense_id": "db7f2e46-8bff-3d2f-bea6-f618ee8596cb",
                                "text": "„Eine Leistungskondiktion liegt vor, wenn jemand 1. etwas 2. durch eine Leistung erlangt hat, die 3. ohne Rechtsgrund erfolgt ist.“"
                            },
                            {
                                "example_id": "eb3d2c9d-1299-4fbd-810d-b9c9e6550506",
                                "sense_id": "db7f2e46-8bff-3d2f-bea6-f618ee8596cb",
                                "text": "„Die Meinung, daß eine Leistungskondiktion nach § 1431 ABGB nur möglich sei, wenn zwischen den Parteien überhaupt keine Rechtsbeziehungen bestünden, ist abzulehnen.“"
                            }
                        ],
