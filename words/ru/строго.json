            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2e316df5-b5a2-3b8d-8e6b-2c2032d52dbf",
                    "sense_definition": "Сурово, требовательно, не допуская снисхождения или поблажек.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель <w>строго</w> посмотрел на ученика, который опоздал на урок.",
                            "target_lang_translations": {
                                "en": "The teacher looked <w>sternly</w> at the student who was late for class.",
                                "de": "Der Lehrer sah den Schüler, der zu spät zum Unterricht kam, <w>streng</w> an.",
                                "es": "El profesor miró <w>con severidad</w> al alumno que llegó tarde a clase."
                            }
                        },
                        {
                            "text": "Здесь <w>строго</w> запрещено курить и шуметь.",
                            "target_lang_translations": {
                                "en": "It is <w>strictly</w> forbidden to smoke and make noise here.",
                                "de": "Hier ist es <w>strikt</w> verboten zu rauchen und Lärm zu machen.",
                                "es": "Aquí está <w>estrictamente</w> prohibido fumar y hacer ruido."
                            }
                        }
                    ],
                    "synonyms": [
                        "сурово",
                        "жёстко"
                    ],
                    "antonyms": [
                        "мягко",
                        "добродушно"
                    ],
                    "common_phrases": [
                        "строго запрещено",
                        "строго судить",
                        "смотреть строго",
                        "строго наказывать"
                    ],
                    "target_lang_definitions": {
                        "en": "Sternly, demandingly, without allowing leniency or indulgence.",
                        "de": "Streng, fordernd, ohne Nachsicht oder Zugeständnisse.",
                        "es": "De manera severa, exigente, sin permitir indulgencia o concesiones."
                    },
                    "translations": {
