                    {
                        "form_id": "7036775e-d09b-49fc-854c-51a10f8f716c",
                        "entry_id": "2425c7cf-71f7-3fd0-b393-831c7017c07e",
                        "tags": [
                            "past"
                        ],
                        "form": "quired"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25554fc6-a0d9-3295-90d8-2477b83a5645",
                        "entry_id": "2425c7cf-71f7-3fd0-b393-831c7017c07e",
                        "glosses": [
                            "Alternative form of choir (“to sing in concert”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "d978546e-a663-4f43-9fd8-1f88a02b0398",
                                "sense_id": "25554fc6-a0d9-3295-90d8-2477b83a5645",
                                "text": "Sit, Jessica. Look how the floor of heaven / Is thick inlaid with patines of bright gold: / There's not the smallest orb which thou behold'st / But in his motion like an angel sings, / Still quiring to the young-eyed cherubins; / Such harmony is in immortal souls; / But whilst this muddy vesture of decay / Doth grossly close it in, we cannot hear it."
                            },
                            {
                                "example_id": "9ebc1cc6-fc36-40db-90c1-c57ecc05cd18",
                                "sense_id": "25554fc6-a0d9-3295-90d8-2477b83a5645",
                                "text": "I saw the 'potamus take wing / Ascending from the damp savannas, / And quiring angels round him sing / The praise of God, in loud hosannas."
                            },
                            {
                                "example_id": "b3983e58-6b96-4d7f-9f62-c3fe1183d77b",
                                "sense_id": "25554fc6-a0d9-3295-90d8-2477b83a5645",
                                "text": "He went on down the hill, toward the dark woods within which the liquid silver voices of the birds called unceasing-the rapid and urgent beating of the urgent and quiring heart of the late spring night."
                            }
                        ]
                    }
                ],
