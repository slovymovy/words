                                    {
                                        "sense_id": "d60ab081-23a1-3c85-8567-abe9d8ff4583",
                                        "entry_id": "b226e1c4-b7a4-3d5c-a79e-d32eabd7fff6",
                                        "glosses": [
                                            "A figure composed of three interlocked spirals (or three bent human legs), with threefold rotational symmetry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60faef60-2b4a-4592-b801-77cf5c5e96f2",
                                                "sense_id": "d60ab081-23a1-3c85-8567-abe9d8ff4583",
                                                "text": "Sicily and the Isle of Man use triskelia as their emblems."
                                            },
                                            {
                                                "example_id": "aa924e14-944c-49b9-9dce-d54313f533b8",
                                                "sense_id": "d60ab081-23a1-3c85-8567-abe9d8ff4583",
                                                "text": "Coordinate term: tetraskelion"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fab1c147-915d-4edb-9ed3-a524c05c66b1",
                        "source_entry_id": "372713ca-abd0-329f-b537-cc341d780175",
                        "source_sense_id": "41d4cb27-78ba-3127-9a2f-d07d62c3bf65",
                        "target_lang_word": "triskeles",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
