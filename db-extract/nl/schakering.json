        "nl-extract.jsonl": [
            {
                "entry_id": "588601a4-ab95-31b0-9f62-ef336cacb098",
                "word": "schakering",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ed5f447a-3a81-439e-b146-60447789aaa0",
                        "entry_id": "588601a4-ab95-31b0-9f62-ef336cacb098",
                        "tags": [
                            "plural"
                        ],
                        "form": "schakeringen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2476bdf9-c9ee-31fb-8818-aa7d4fda1235",
                        "entry_id": "588601a4-ab95-31b0-9f62-ef336cacb098",
                        "glosses": [
                            "kleurnuance, verschillende tinten van één kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89f5b9c-1ade-4559-8b4f-d7d96e34915b",
                                "sense_id": "2476bdf9-c9ee-31fb-8818-aa7d4fda1235",
                                "text": "De eetzaal heeft een bordeaux tafel en in de tegelvloer zijn prachtige schakeringen van blauw en groen zichtbaar. ‘Het is een Indiase leisteen waarin heel wat tinten verwerkt zijn’, zegt Caroline Voet."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1a0cd37-ea94-323a-a5c4-9e6a6b686fdf",
                        "entry_id": "588601a4-ab95-31b0-9f62-ef336cacb098",
                        "glosses": [
                            "luidheidsverschillen in een muziekstuk"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5fbb701c-56ce-3e65-ada9-00e68b18afc5",
                        "entry_id": "588601a4-ab95-31b0-9f62-ef336cacb098",
                        "glosses": [
                            "variaties in gevoel, denkwijze, opvattingen of meningen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc663d7-7410-4464-8f0b-a55a953a7eb4",
                                "sense_id": "5fbb701c-56ce-3e65-ada9-00e68b18afc5",
                                "text": "Met fantasie en een zeldzame verfijning maken ze iedere emotionele schakering in het gemoed van de gekwelde Alceste voelbaar. De koorzangers van MusicAeterna uit Perm, links en rechts naast het orkest, leveren op sublieme wijze commentaar. Aanstichter van die weelde is de dirigent René Jacobs, die je bij de hand neemt door de partituur en je pas na de laatste noot weer loslaat."
                            },
                            {
                                "example_id": "371377de-018c-47fe-b90a-e84342dc3455",
                                "sense_id": "5fbb701c-56ce-3e65-ada9-00e68b18afc5",
                                "text": "Een non-Bildungsroman, een mengvorm van genres, maar vooral een schitterende vertelling over de vele belevenissen van een jongeman. In die schakeringen laat de Zwitserse schrijver zijn grootsheid zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c8bc13f-243b-4890-9f73-afa5e26d2bb9",
                        "source_entry_id": "588601a4-ab95-31b0-9f62-ef336cacb098",
                        "source_sense_id": "2476bdf9-c9ee-31fb-8818-aa7d4fda1235",
                        "source_sense_description": "kleurnuance, verschillende tinten van één kleur",
                        "target_lang_word": "Schattierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schattierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c952e97-e99d-3d5c-94b7-38c3234bf033",
                                        "entry_id": "cbcddfd6-d644-3321-8ce0-996da5779b4d",
                                        "glosses": [
                                            "geringe Abstufung in der Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aece50c1-e21f-4e11-8a73-643cfb54fa47",
                                                "sense_id": "1c952e97-e99d-3d5c-94b7-38c3234bf033",
                                                "text": "Hier gibt es rote Tischdecken in allen Schattierungen."
                                            },
                                            {
                                                "example_id": "997b649a-4ef0-478d-9b2e-19eba3e3534d",
                                                "sense_id": "1c952e97-e99d-3d5c-94b7-38c3234bf033",
                                                "text": "„Die letzten Kilometer in Tunesien führten mich über den außerirdisch anmutenden Chott el Jerid, einen riesigen Salzsee, der in allen denkbaren Schattierungen von Pink und Lila das Sonnenlicht reflektierte.“"
                                            },
                                            {
                                                "example_id": "0c3d3a63-91fc-4777-ac41-d0e15754577c",
                                                "sense_id": "1c952e97-e99d-3d5c-94b7-38c3234bf033",
                                                "text": "„Sowohl Männchen als auch Weibchen des Rebenstechers treten in allen Schattierungen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7afce70b-0c85-411c-a40f-017c9fa32535",
                        "source_entry_id": "588601a4-ab95-31b0-9f62-ef336cacb098",
                        "source_sense_id": "2476bdf9-c9ee-31fb-8818-aa7d4fda1235",
                        "source_sense_description": "kleurnuance, verschillende tinten van één kleur",
                        "target_lang_word": "shade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "Darkness where light, particularly sunlight, is blocked."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031f92f5-88f2-4ba1-9cf3-88b8310dfb40",
                                                "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                                "text": "The old oak tree gave shade in the heat of the day."
                                            },
                                            {
                                                "example_id": "70f31b5f-f925-4133-9ed5-1815c97e752a",
                                                "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                                "text": "Temps rose to a sweltering 40 degrees Celsius in the shade."
                                            },
                                            {
                                                "example_id": "ac24d5ad-e6ef-484d-b847-10ea0237212d",
                                                "sense_id": "71edcdc2-962b-39ce-b897-dd1ef4695f65",
                                                "text": "Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet:[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c999ad-4bb7-35a2-8993-ecda66de1753",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "Something that blocks light, particularly in a window."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac55076-e523-4e0b-ad74-5ae7cbc5fe0e",
                                                "sense_id": "e1c999ad-4bb7-35a2-8993-ecda66de1753",
                                                "text": "Close the shade, please: it's too bright in here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A variety of a color, in particular one obtained by adding black (compare tint)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8e866d-522c-46ed-9239-06fd411ca8c9",
                                                "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                                "text": "I've painted my room in five lovely shades of pink and chartreuse."
                                            },
                                            {
                                                "example_id": "ce435374-cff9-4adb-a832-1ff0d95c4ed1",
                                                "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                                "text": "Thus light and colours, as white, red, yellow, blue, with their several degrees or shades, and mixtures, as green, scarlet, purple, sea-green, and the rest, come in only by the eyes[…]"
                                            },
                                            {
                                                "example_id": "deb1f7b1-48f6-4152-bdb2-7c9fccf0e8bc",
                                                "sense_id": "a29c6bc8-c78f-37f9-8549-ceb0347d5934",
                                                "text": "Speaking of round sunglasses, these lightweight polarized ones and come in two shades of tortoiseshell as well as black and bronze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A subtle variation in a concept."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7443f505-efc6-4baf-8d5b-de5a52927e71",
                                                "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                                "text": "shades of meaning"
                                            },
                                            {
                                                "example_id": "f4651c05-f8de-4ca2-9323-6bbc3e8cd54e",
                                                "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                                "text": "new shades and combinations of thought"
                                            },
                                            {
                                                "example_id": "f29fd327-b867-42f4-b0fb-9734a9a8fbb0",
                                                "sense_id": "cef2214f-1e56-3283-b11a-6251e05487d8",
                                                "text": "Every shade of religious and political opinion had its own headquarters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc678a51-ebfd-3e9c-b120-8958d10e0dff",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "An aspect that is reminiscent of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "123f6497-bb40-4707-b245-cb6dc238adce",
                                                "sense_id": "dc678a51-ebfd-3e9c-b120-8958d10e0dff",
                                                "text": "shades of Groucho Marx"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A very small degree of a quantity, or variety of meaning"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8009be6d-629b-472a-985e-b39cb370e7ce",
                                                "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                                "text": "That is a shade too close."
                                            },
                                            {
                                                "example_id": "93c253bc-94d1-4eb6-89af-d9b35f6542b4",
                                                "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                                "text": "Mrs. Rhodes who (so I gathered from Mr. Petherick's careful language) was perhaps just a shade of a hypochondriac, had retired to bed immediately after dinner."
                                            },
                                            {
                                                "example_id": "6c958494-9a84-494c-ba0b-efd3eac8022a",
                                                "sense_id": "16fbc8f7-6c54-379e-a888-df092b2ebf45",
                                                "text": "Five feet in diameter and a shade above knee high, the center of the fragile white canvass structure is filled with […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A ghost or specter; a spirit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ce0958-1810-4ea5-af55-362c5ba84ff1",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "Too long have I been haunted by that shade."
                                            },
                                            {
                                                "example_id": "9723a3f5-9ffa-4ae8-abaf-f82ddf0b5082",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "The adventurer was attacked by a shade."
                                            },
                                            {
                                                "example_id": "92877aef-8fcb-43ac-88af-1f2b06257d3a",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "Swift as thought the flitting shade / Thro' air his momentary journey made."
                                            },
                                            {
                                                "example_id": "8f1c1c40-c8c7-4fe8-99f6-5dc76655dace",
                                                "sense_id": "aca9e622-efa5-3edb-a707-a619c69ed1f4",
                                                "text": "Still, Birch House (a sop to the shade of the murdered Perak Resident) had no more than its normal share of flagellation[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f973344-5b07-320b-8fb1-6025c3541438",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A postage stamp showing an obvious difference in colour/color to the original printing and needing a separate catalogue/catalog entry."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "Subtle insults."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9786b2c5-f6d7-457a-b1fc-d2611e1717e1",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "throw shade"
                                            },
                                            {
                                                "example_id": "db9ebb5d-5320-4cde-a388-18061761aa6d",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "Why did you paint your room chartreuse? No shade; I'm genuinely curious."
                                            },
                                            {
                                                "example_id": "c6ab0da7-a0f5-4a5e-830f-ca7fa6637334",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "Shade is: \"I don't tell you you're ugly, but I don't have to tell you because you know you're ugly.\" And that's shade."
                                            },
                                            {
                                                "example_id": "0413caa2-2862-44a8-b8dc-be3ba2ce5d78",
                                                "sense_id": "2f0b1711-6ce2-3a1a-96a8-f88eb9db6ea3",
                                                "text": "In a recent interview with Pitchfork, Carey offered her explanation for how the moment of shade came about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3593da2-9e71-375c-8609-8c64dec48ad5",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A cover around or above a light bulb, a lampshade."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8adc8260-062b-4611-a04e-0f15ee4dbc6a",
                                                "sense_id": "a3593da2-9e71-375c-8609-8c64dec48ad5",
                                                "text": "Lighting was unimaginative for the standard stock with naked tungsten filament bulbs and metal reflectors. However, all compartments had individual reading lights above the seats with attractive glass shades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e343e4-db91-3679-8510-e386b9f41362",
                                        "entry_id": "7b7425a8-ded6-3832-8b29-1a7b1fcd1141",
                                        "glosses": [
                                            "A candle-shade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50898fb9-7aea-4959-bf88-9830847363cf",
                                                "sense_id": "d8e343e4-db91-3679-8510-e386b9f41362",
                                                "text": "I am now finishing this letter by candle-light, with the help of a handkerchief tied over the shade."
                                            },
                                            {
                                                "example_id": "d2f64e03-e2df-4585-8b2e-39e6864c619e",
                                                "sense_id": "d8e343e4-db91-3679-8510-e386b9f41362",
                                                "text": "His tent is furnished with a good large bed, mattress, pillow, &c., a few camp-stools or chairs, a folding table, a pair of shades for his candles, six or seven trunks with table equipage, his stock of linen (at least 24 shirts); some dozens of wine, brandy, and gin; tea, sugar, and biscuit; and a hamper of live poultry and his milch-goat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0cc0e27-f792-3ecd-a438-a6018f073596",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To shield (someone or something) from light."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26daac34-b9ed-4393-8c19-cafa3cd5bb44",
                                                "sense_id": "f0cc0e27-f792-3ecd-a438-a6018f073596",
                                                "text": "The old oak tree shaded the lawn in the heat of the day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9799a7-18a5-36fe-b6b4-0e87d2de7dea",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To shield oneself from light."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88451f9a-7085-4c9f-870f-46a22dbee22f",
                                                "sense_id": "bf9799a7-18a5-36fe-b6b4-0e87d2de7dea",
                                                "text": "We shaded under a huge oak tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2aa2b2d-34d9-3ae6-b90e-d9d7de9f9db5",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To alter slightly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a36eb1-31be-4230-a8e2-d3a283f82ddb",
                                                "sense_id": "a2aa2b2d-34d9-3ae6-b90e-d9d7de9f9db5",
                                                "text": "You'll need to shade your shot slightly to the left."
                                            },
                                            {
                                                "example_id": "edf8b86e-da02-415b-bd7f-5847ea275650",
                                                "sense_id": "a2aa2b2d-34d9-3ae6-b90e-d9d7de9f9db5",
                                                "text": "Most politicians will shade the truth if it helps them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f54872-04a1-3d0d-aab7-105f3ee71c3b",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To vary or approach something slightly, particularly in color."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9efb2021-dadb-4a7d-abc7-d463f424cde3",
                                                "sense_id": "16f54872-04a1-3d0d-aab7-105f3ee71c3b",
                                                "text": "The hillside was bright green, shading towards gold in the drier areas."
                                            },
                                            {
                                                "example_id": "97cc6f6f-ba0a-40f2-a80d-9fe5f68c9056",
                                                "sense_id": "16f54872-04a1-3d0d-aab7-105f3ee71c3b",
                                                "text": "This small group will be most conveniently treated with the emotional division, into which it shades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d848fb-1308-37d7-b88c-5e05a86c6d72",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To move slightly from one's normal fielding position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041350ba-3c61-4da1-ae73-15f95006aeac",
                                                "sense_id": "32d848fb-1308-37d7-b88c-5e05a86c6d72",
                                                "text": "Jones will shade a little to the right on this pitch count."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c0e87a-a071-3117-bc94-00e81968de3b",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To darken, particularly in drawing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e464b935-9567-4482-a96f-e875ba847ff4",
                                                "sense_id": "62c0e87a-a071-3117-bc94-00e81968de3b",
                                                "text": "I draw contours first, gradually shading in midtones and shadows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0c90f8-48cc-3f81-8a71-923ffdf4d1f4",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To win by a narrow margin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72cc93b2-5b6b-44d2-8df7-bf0c484ca3a1",
                                                "sense_id": "ee0c90f8-48cc-3f81-8a71-923ffdf4d1f4",
                                                "text": "Both parties claimed afterwards that their man did best in the debate, but an early opinion poll suggested Mr Cameron shaded it."
                                            },
                                            {
                                                "example_id": "f15be8e7-142e-4c16-8353-db20d7e50d1e",
                                                "sense_id": "ee0c90f8-48cc-3f81-8a71-923ffdf4d1f4",
                                                "text": "It was Alexis Mac Allister who lit the touchpaper at the start of the second half, scoring from the penalty spot to cancel out John Stones’s opener for City midway through a first half that the defending champions had shaded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f7d251-4096-3c13-ba11-5fec8a5daa1d",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To reduce (a window) so that only its title bar is visible."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2923ee8-c636-3e5e-a3a9-bca0b9244e7b",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To throw shade, to subtly insult someone."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c7e99f5-9537-4df1-871d-2308489c37c3",
                                                "sense_id": "c2923ee8-c636-3e5e-a3a9-bca0b9244e7b",
                                                "text": "The lyrics have prompted headlines about her “shading” Musk with a “spicy dig”, but I reckon the guy got off lightly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a0c3534-bfe1-3a6e-ad4b-b5a563600926",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To shelter; to cover from injury; to protect; to screen."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28066ec7-40e2-4cd4-a5c6-28f713798b5f",
                                                "sense_id": "6a0c3534-bfe1-3a6e-ad4b-b5a563600926",
                                                "text": "Ere in our own house I do shade my head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c472732-2f54-3089-bcda-75bd5366d9be",
                                        "entry_id": "36ee13c3-4956-39b8-bc02-20f35e2eada4",
                                        "glosses": [
                                            "To present a shadow or image of; to shadow forth; to represent."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656830db-0985-42f8-902c-3e730a162eb1",
                                                "sense_id": "6c472732-2f54-3089-bcda-75bd5366d9be",
                                                "text": "His [Osiris’s] wife was Iſis, whom they likewiſe made / A Goddeſſe of great powre and ſouerainty, / And in her perſon cunningly did ſhade / That part of Iuſtice, which is Equity, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
