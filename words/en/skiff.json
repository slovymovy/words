{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5908e53-28f5-38d7-97ee-9ab240994981",
                    "sense_definition": "A small, light, flat-bottomed open boat suitable for rowing or sailing by one person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman rowed his small wooden <w>skiff</w> across the calm lake at dawn.",
                            "target_lang_translations": {
                                "de": "Der Fischer ruderte im Morgengrauen mit seinem kleinen hölzernen <w>Skiff</w> über den ruhigen See."
                            }
                        },
                        {
                            "text": "They tied the <w>skiff</w> to the dock before heading toward the shore.",
                            "target_lang_translations": {
                                "de": "Sie banden das <w>Boot</w> am Steg fest, bevor sie sich auf den Weg zum Ufer machten."
                            }
                        }
                    ],
                    "synonyms": [
                        "rowboat",
                        "dinghy"
                    ],
                    "common_phrases": [
                        "wooden skiff",
                        "rowing skiff"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines, leichtes, offenes Boot mit flachem Boden, das für eine Person zum Rudern oder Segeln geeignet ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Skiff",
                                "target_lang_sense_clarification": "Bootstyp, Einer-Ruderboot oder kleines Segelboot"
                            },
                            {
                                "target_lang_word": "Jolle",
                                "target_lang_sense_clarification": "kleines offenes Boot"
                            },
                            {
                                "target_lang_word": "Ruderboot",
                                "target_lang_sense_clarification": "kleines Boot zum Rudern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a22e045-0dc8-365d-831b-67b0a0375128",
                    "sense_definition": "A light dusting or thin layer of snow, ice, or dust covering a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We woke up to find a light <w>skiff</w> of snow coating the garden path.",
                            "target_lang_translations": {
                                "de": "Als wir aufwachten, bedeckte ein feiner <w>Hauch</w> von Schnee den Gartenweg."
                            }
                        },
                        {
                            "text": "A thin <w>skiff</w> of ice had formed over the pond during the freezing night.",
                            "target_lang_translations": {
                                "de": "Während der frostigen Nacht hatte sich eine dünne <w>Schicht</w> Eis über dem Teich gebildet."
                            }
                        }
                    ],
                    "synonyms": [
                        "dusting"
                    ],
                    "common_phrases": [
                        "skiff of snow",
                        "skiff of ice"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in North American and Scottish dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein feiner Hauch oder eine dünne Schicht aus Schnee, Eis oder Staub auf einer Oberfläche."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schicht",
                                "target_lang_sense_clarification": "dünne Lage von Schnee oder Eis"
                            },
                            {
                                "target_lang_word": "Hauch",
                                "target_lang_sense_clarification": "sehr dünne Lage, feiner Überzug"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ec839e4-ce78-342e-8483-8f6ad7b6a26c",
                    "sense_definition": "A light, fleeting shower of rain or snow, or a brief gust of wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A brief <w>skiff</w> of rain swept over the hills and passed quickly.",
                            "target_lang_translations": {
                                "de": "Ein kurzer <w>Regenschauer</w> zog über die Hügel und war schnell wieder vorbei."
                            }
                        },
                        {
                            "text": "With just a sudden <w>skiff</w> of wind, the dry leaves rustled along the fence.",
                            "target_lang_translations": {
                                "de": "Bei nur einer plötzlichen leichten <w>Windbö</w> raschelten die trockenen Blätter am Zaun entlang."
                            }
                        }
                    ],
                    "synonyms": [
                        "shower"
                    ],
                    "common_phrases": [
                        "skiff of rain",
                        "skiff of wind"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in regional varieties such as Scottish and Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein leichter, vorüberziehender Regen- oder Schneeschauer oder ein kurzer Windstoß."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schauer",
                                "target_lang_sense_clarification": "leichter, kurzer Niederschlag"
                            },
                            {
                                "target_lang_word": "Bö",
                                "target_lang_sense_clarification": "kurzer Windstoß"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36af36b6-6949-3c87-b1c2-e859551022d6",
                    "sense_definition": "The act of lightly pruning tea bushes to maintain leaf height without removing much wood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The estate workers applied a light <w>skiff</w> to the bushes before the growing season.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter der Plantage verpassten den Sträuchern vor der Vegetationsperiode einen leichten <w>Formschnitt</w>."
                            }
                        },
                        {
                            "text": "A careful <w>skiff</w> helps keep the tea canopy at an ideal plucking height.",
                            "target_lang_translations": {
                                "de": "Ein vorsichtiger <w>Rückschnitt</w> hilft dabei, die Teekronen auf einer idealen Pflückhöhe zu halten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "light skiff",
                        "deep skiff"
                    ],
                    "target_lang_definitions": {
                        "de": "Das leichte Zurückschneiden von Teesträuchern, um die Höhe der Pflückfläche ohne großen Holzverlust beizubehalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Leichtschnitt",
                                "target_lang_sense_clarification": "oberflächlicher Rückschnitt von Teesträuchern"
                            },
                            {
                                "target_lang_word": "Formschnitt",
                                "target_lang_sense_clarification": "leichter Pflegeschnitt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fcad3a8f-54ca-343e-bc3a-52e95477b2b4",
                    "sense_definition": "To travel or navigate in a small open boat.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>skiff</w> along the quiet coast instead of walking.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, mit dem <w>Boot</w> an der ruhigen Küste entlangzufahren, anstatt zu laufen."
                            }
                        },
                        {
                            "text": "He spent the summer days <w>skiffing</w> around the small islands.",
                            "target_lang_translations": {
                                "de": "Er verbrachte die Sommertage damit, mit dem <w>Boot</w> um die kleinen Inseln herumzufahren."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In einem kleinen offenen Boot fahren oder navigieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Boot fahren",
                                "target_lang_sense_clarification": "sich mit einem kleinen offenen Boot fortbewegen"
                            },
                            {
                                "target_lang_word": "rudern",
                                "target_lang_sense_clarification": "sich mit Rudern in einem kleinen Boot fortbewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3a3a45d-860e-3c10-b3ea-158664e27d60",
                    "sense_definition": "To fall lightly or briefly, leaving a thin dusting on the ground or other surfaces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A gentle snow <w>skiffed</w> the cold highway as dusk settled.",
                            "target_lang_translations": {
                                "de": "Ein sanfter Schneefall <w>überzog</w> die kalte Autobahn mit einer dünnen Schicht, als die Dämmerung einsetzte."
                            }
                        },
                        {
                            "text": "Rain began <w>skiffing</w> against the windowpanes in the late afternoon.",
                            "target_lang_translations": {
                                "de": "Am späten Nachmittag begann es, leicht gegen die Fensterscheiben zu <w>tröpfeln</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly found in dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Leicht oder kurz fallen und dabei eine dünne Schicht auf dem Boden oder anderen Oberflächen hinterlassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "leicht schneien",
                                "target_lang_sense_clarification": "eine dünne Schneeschicht hinterlassen"
                            },
                            {
                                "target_lang_word": "überstäuben",
                                "target_lang_sense_clarification": "mit einer feinen Schicht bedecken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02705d0a-7e98-3d18-aa4b-44911858f997",
                    "sense_definition": "To lightly prune a tea bush to preserve the level plucking surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Planters usually <w>skiff</w> the tea bushes every few years to encourage new growth.",
                            "target_lang_translations": {
                                "de": "Pflanzer <w>stutzen</w> die Teesträucher gewöhnlich alle paar Jahre leicht, um den Neuaustrieb anzuregen."
                            }
                        },
                        {
                            "text": "They must carefully <w>skiff</w> each row to keep the plucking table level.",
                            "target_lang_translations": {
                                "de": "Sie müssen jede Reihe vorsichtig <w>nachschneiden</w>, um die Pflückfläche eben zu halten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Teestrauch leicht stutzen, um eine ebene Pflückfläche zu erhalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "stutzen",
                                "target_lang_sense_clarification": "Teesträucher leicht beschneiden"
                            },
                            {
                                "target_lang_word": "nachschneiden",
                                "target_lang_sense_clarification": "Pflückebene leicht beschneiden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
