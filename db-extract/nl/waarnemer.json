                        "examples": [
                            {
                                "example_id": "73f2b690-7ce7-4c55-b668-787c99999236",
                                "sense_id": "bfbea1db-8517-38ec-bedf-542bd8f22ec7",
                                "text": "De Verenigde Naties wilden waarnemers sturen om de verkiezingen bij te wonen."
                            }
                        ]
