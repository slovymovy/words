                                        "sense_id": "747f01d0-9bb4-3c56-a5e9-1bba1bc8ce82",
                                        "entry_id": "85c3a450-dad9-33b9-ab75-0216fed10f90",
                                        "glosses": [
                                            "The recreational or educational activity of temporarily living in a tent or similar accommodation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9b4f43d-00aa-464c-862f-511b641f18b3",
                                                "sense_id": "747f01d0-9bb4-3c56-a5e9-1bba1bc8ce82",
                                                "text": "Camping is a favorite summer activity."
                                            },
                                            {
                                                "example_id": "1c63ac75-5822-4c0b-b2f3-f1bac5a33a26",
                                                "sense_id": "747f01d0-9bb4-3c56-a5e9-1bba1bc8ce82",
                                                "text": "to foreclose the possibility completely. she packed the footwell of the passenger seat with her duffel bag and camping gear and buckled a stack of seed trays on to the seat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340df315-ef55-33e1-8282-d87ab72d1a7f",
                                        "entry_id": "85c3a450-dad9-33b9-ab75-0216fed10f90",
                                        "glosses": [
                                            "The act of setting up a camp."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5533b82-48f3-40b5-b826-271136878983",
                                                "sense_id": "340df315-ef55-33e1-8282-d87ab72d1a7f",
                                                "text": "In some quarters, indeed, it was different — the troops bivouacked in many places. It was a strange and an unpleasing sight to see these campings in the heart of a city, yet it was picturesque in the extreme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4787bcb8-f4ac-4937-8e4f-a625ca5040e2",
                        "source_entry_id": "24f5e961-a783-38bb-afed-06e40b4cb45c",
                        "source_sense_description": "Croyance selon laquelle le monde est divisé en grands groupes politiques de pays",
                        "target_lang_word": "campism",
