                "senses": [
                    {
                        "sense_id": "b94b86c6-dd26-3d28-b53b-9238a90b71b5",
                        "entry_id": "f5fdc274-0c1e-3df6-9653-9e20d912fa3e",
                        "glosses": [
                            "Eigenschaft, überall vorkommen zu können"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1e13a717-3b58-4718-997e-3b15c65aa629",
                                "sense_id": "b94b86c6-dd26-3d28-b53b-9238a90b71b5",
                                "text": "„'Ruhm' (= neuer Roman) ist nicht auf einen Nenner zu bringen; wenn es einen roten Faden gibt, dann ist es das Unruhige unserer Gegenwart, die potentielle Erreichbarkeit per Handy, SMS oder E-Mail, die Ubiquität, Umtriebigkeit und Verlorenheit.“"
                            },
                            {
                                "example_id": "2babb58a-b6a3-449d-b44e-81c6ca80977f",
                                "sense_id": "b94b86c6-dd26-3d28-b53b-9238a90b71b5",
                                "text": "„Schon die Ubiquität des Namen Johannes legt von der christlichen Prägung der gesamten spätantiken Welt Zeugnis ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41a1a0b0-c190-3e73-b744-04b83ee8bf1f",
                        "entry_id": "f5fdc274-0c1e-3df6-9653-9e20d912fa3e",
                        "glosses": [
                            "Eigenschaft von Lebewesen, nicht an einen Standort gebunden zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "52ac97c9-0b0e-343d-8f12-e167c51ef73f",
                        "entry_id": "f5fdc274-0c1e-3df6-9653-9e20d912fa3e",
                        "glosses": [
                            "Allgegenwart (Gottes)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "edbc3cbc-8d25-3fc1-8201-a8ec1e349662",
                        "entry_id": "f5fdc274-0c1e-3df6-9653-9e20d912fa3e",
                        "glosses": [
                            "Gegenstände/Wirtschaftsgüter, die überall verfügbar sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac0f6778-1562-4105-9200-8ee2b304a8d1",
                                "sense_id": "edbc3cbc-8d25-3fc1-8201-a8ec1e349662",
                                "text": "„Man kann der Freiheit, die uns durch diese mühelose Ubiquität geschenkt wird, auch die guten Seiten nicht absprechen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b3e4b17-bb4b-466e-871a-3b355e1c47ec",
                        "source_entry_id": "f5fdc274-0c1e-3df6-9653-9e20d912fa3e",
                        "source_sense_id": "b94b86c6-dd26-3d28-b53b-9238a90b71b5",
                        "source_sense_description": "kein Plural: Eigenschaft, überall vorkommen zu können",
                        "target_lang_word": "ubiquity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ubiquity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ae3b256-184b-3408-8c40-31eebd86803c",
                                        "entry_id": "f1be342f-b577-3121-a786-288e1676f307",
                                        "glosses": [
                                            "The state or quality of being, or appearing to be, everywhere at once; actual or perceived omnipresence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3c01540-43de-4c73-9d3e-1f2ec2d62b98",
                                                "sense_id": "1ae3b256-184b-3408-8c40-31eebd86803c",
                                                "text": "Hence the ubiquity of Priapus himself as a sculptural representative of the generative principle, populated the Roman gardens, assertive in ithyphallic pose."
                                            },
                                            {
                                                "example_id": "56e4e33b-d51f-4d3b-be13-b02a6b8cea5c",
                                                "sense_id": "1ae3b256-184b-3408-8c40-31eebd86803c",
                                                "text": "It would be hard to exaggerate the ubiquity of the diminutive (-ito, -ita) in Latin American Spanish, which originates from the extreme reverence and indulgence accorded to the young."
                                            },
                                            {
                                                "example_id": "8aad5d82-e5e0-4b53-8089-8c40f8483abe",
                                                "sense_id": "1ae3b256-184b-3408-8c40-31eebd86803c",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives. And, as their ubiquity spreads, so too does the debate around whether we should allow ourselves to become so reliant on them – and who, if anyone, is policing their use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d49e212e-c597-3e1d-9179-a4f56a3cedf1",
                                        "entry_id": "f1be342f-b577-3121-a786-288e1676f307",
                                        "glosses": [
                                            "Anything that is ubiquitous within a specified area."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "204446b9-542a-4c02-b203-eedbdd827926",
                        "source_entry_id": "f5fdc274-0c1e-3df6-9653-9e20d912fa3e",
                        "source_sense_id": "b94b86c6-dd26-3d28-b53b-9238a90b71b5",
                        "source_sense_description": "kein Plural: Eigenschaft, überall vorkommen zu können",
                        "target_lang_word": "ubiquité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ubiquité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38241823-5010-3100-aab4-f601649f3db0",
                                        "entry_id": "e0261011-89ec-3ab4-a535-72e00542e13a",
                                        "glosses": [
                                            ", (Dogmatique) Attribut de Dieu, être présent dans le même temps partout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891c6a40-53a3-4e4d-9465-8b34bc57ae9d",
                                                "sense_id": "38241823-5010-3100-aab4-f601649f3db0",
                                                "text": "Brenz, au contraire, avait développé jusqu’à son maximum la doctrine de l’ubiquité, dont le but était d’expliquer la présence du corps du Christ dans le pain de la Cène — ce qu’on nomme la consubstantiation — d’une manière qui tend à rapprocher la cène luthérienne de l’eucharistie catholique, laquelle se définit par la transsubstantiation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                        "entry_id": "e0261011-89ec-3ab4-a535-72e00542e13a",
                                        "glosses": [
                                            "Aptitude à être présent physiquement à plusieurs endroits en même temps."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7909fd72-2a09-4782-9232-77ba992182ca",
                                                "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                                "text": "Grâce à mon don d’ubiquité, je peux aller au four et au moulin en même temps."
                                            },
                                            {
                                                "example_id": "f10d3432-392d-4145-a2eb-49daa8986cd9",
                                                "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                                "text": "Pour Antoine, […], la sensation d’ubiquité provoquée par toutes les technologies modernes constituait une espèce de baume : les époques révolues, le présent, les lieux les plus éloignés du monde se télescopaient sur l’écran dans une espèce de lévitation abstraite qu’il était rassurant d’appeler la vie, une apesanteur affective à la fois magique et monocorde."
                                            },
                                            {
                                                "example_id": "11dc185d-6c4e-4fb6-b8d9-dd3e9b9c733a",
                                                "sense_id": "615ad8dc-2a51-330d-a2e0-3890136e7de7",
                                                "text": "— Alors que le romancier, riche de son don d’ubiquité, peut se dédoubler en autant de personnages que son humeur daigne susciter au fil des pages, le poète reste fixé à la finitude de son expérience, à la racine de son cri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608ebce2-c011-3763-bbfc-a88afc38f1e7",
                                        "entry_id": "e0261011-89ec-3ab4-a535-72e00542e13a",
                                        "glosses": [
                                            "Omniprésence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e7ff9a-9561-4887-8be3-c89042aee97a",
                                                "sense_id": "608ebce2-c011-3763-bbfc-a88afc38f1e7",
                                                "text": "Je n'insisterai jamais assez sur l'ubiquité de la violence au Mexique qui imprègne tant de dimensions au quotidien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ubiquité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e50d532a-3757-35bd-a552-8abd81cfb65d",
                                        "entry_id": "3fa03e9e-c1aa-325d-a402-8887f1135a10",
