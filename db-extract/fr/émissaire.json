                "senses": [
                    {
                        "sense_id": "e522a7bf-1e73-39f6-8db5-eaca814050a1",
                        "entry_id": "6395899a-834d-3757-8fc8-c24348c2e51f",
                        "glosses": [
                            "Canalisation servant à évacuer un trop-plein d'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ddcb29-31a5-42b6-9bb7-0e822753ba67",
                                "sense_id": "e522a7bf-1e73-39f6-8db5-eaca814050a1",
                                "text": "Onze ans de travaux très pénibles exécutés par trente mille hommes furent nécessaires pour mener à bien le projet, lequel consistait à dériver les eaux du lac vers le Liris. Pour cela il fallut creuser un émissaire de plus de 5,6 kilomètres, large de 2,44 mètres et tenu par des murs de soutènement de près de 2,90 mètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "21335825-13a1-394c-84f0-f6f51d8a13e7",
                        "entry_id": "6395899a-834d-3757-8fc8-c24348c2e51f",
                        "glosses": [
                            "Cours d’eau quittant une grande étendue d'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a1c9d0-15dd-4ea0-a25c-9d0992f41ad5",
                                "sense_id": "21335825-13a1-394c-84f0-f6f51d8a13e7",
                                "text": "Au Sud, à la place actuelle de la Pièce d’Eau des Suisses, s’étendait une grande mare avec un émissaire s’écoulant vers le Nord."
                            }
                        ]
                    },
