            "senses": [
                {
                    "sense_id": "8c8e6f2c-8a7c-3178-97dd-8c89e10c1cdc",
                    "sense_definition": "Apercevoir confusément, imparfaitement ou pendant un très court instant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception_visuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À travers le brouillard épais, le marin a réussi à <w>entrevoir</w> les falaises de la côte."
                        },
                        {
                            "text": "La porte s'est ouverte un instant, me laissant <w>entrevoir</w> une silhouette familière dans le couloir."
                        }
                    ],
                    "synonyms": [
                        "apercevoir"
                    ],
                    "common_phrases": [
                        "laisser entrevoir",
                        "entrevoir une silhouette"
                    ]
                },
                {
                    "sense_id": "6d514023-2126-3852-afb5-4baf227d7bd9",
                    "sense_definition": "Pressentir, concevoir ou envisager vaguement une possibilité ou une issue future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit_anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de négociations tendues, les délégués commencent enfin à <w>entrevoir</w> une solution acceptable."
                        },
                        {
                            "text": "Malgré les difficultés financières du projet, nous <w>entrevoyons</w> un espoir d'obtenir un financement public."
                        }
                    ],
                    "common_phrases": [
                        "entrevoir une solution",
                        "entrevoir un espoir",
                        "entrevoir une possibilité"
                    ]
                },
                {
                    "sense_id": "bbc4b362-8bec-3dd6-87de-de6ca5650e36",
                    "sense_definition": "Se rencontrer brièvement pour avoir un entretien ou une entrevue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rencontre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux ministres se sont <w>entrevus</w> discrètement avant le début du sommet officiel."
                        },
                        {
                            "text": "Il faudrait que nous nous <w>entrevoyions</w> pour régler ce différend dans les meilleurs délais."
                        }
                    ]
                }
            ]
