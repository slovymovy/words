                        "glosses": [
                            "Apocope de bulgare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d355f1f-5ef3-4f07-9a1e-f6bd45fdd125",
                                "sense_id": "c624aa80-a6ae-3ac3-a032-391342d8e50e",
                                "text": "– Laisse ton sous-verge emmener tes poilus et amène-toi manger un poulet.\nEn m’entraînant, il m’explique :\nUn de mes types en a refait une couple dans une ferme bul. Il m’en a apporté un."
                            },
                            {
                                "example_id": "69fe1621-20a6-4745-8ad5-d38de7b1a896",
                                "sense_id": "c624aa80-a6ae-3ac3-a032-391342d8e50e",
                                "text": "Il y a un village bul à quinze kilomètres."
                            },
                            {
                                "example_id": "ccfbc56a-c090-45fd-a336-2f1bff8eb309",
                                "sense_id": "c624aa80-a6ae-3ac3-a032-391342d8e50e",
                                "text": "C’est toi qui vas aller leur faire comprendre qu’ils doivent la sauter, à deux pas des Buls bien gras à qui ils viennent de foutre la pile ?"
                            }
                        ]
                    }
                ],
