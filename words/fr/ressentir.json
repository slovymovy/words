    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9a510d5-4417-3144-9f86-626107acee9d",
                    "sense_definition": "Éprouver une sensation physique, un sentiment ou une émotion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eprouver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle commence à <w>ressentir</w> une vive douleur à la jambe après cette longue marche."
                        },
                        {
                            "text": "Il <w>ressent</w> une grande joie lorsqu'il retrouve ses amis d'enfance."
                        }
                    ],
                    "common_phrases": [
                        "ressentir une douleur",
                        "ressentir de la joie",
                        "ressentir de la colère"
                    ]
                },
                {
                    "sense_id": "49ad8c3c-369f-3831-86d0-4e9808117ad5",
                    "sense_definition": "Éprouver les effets ou les conséquences fâcheuses de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute l'économie locale va se <w>ressentir</w> de la fermeture définitive de cette grande usine."
                        },
                        {
                            "text": "L'entreprise se <w>ressent</w> encore des pertes financières subies l'année précédente."
                        }
                    ],
                    "common_phrases": [
                        "se ressentir de la crise",
                        "se ressentir des conséquences"
                    ]
                },
                {
                    "sense_id": "5f7ce939-2a18-32a2-a39d-4a7abeb1814c",
                    "sense_definition": "Garder encore des séquelles ou des douleurs d'un mal passé, comme une maladie ou une blessure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même après plusieurs mois de repos, le coureur se <w>ressent</w> de sa fracture."
                        },
                        {
                            "text": "Le patient continue de se <w>ressentir</w> de son opération lors des changements de temps."
                        }
                    ],
                    "common_phrases": [
                        "se ressentir d'une blessure",
                        "se ressentir de sa maladie"
                    ]
                }
            ]
        }
    ]
