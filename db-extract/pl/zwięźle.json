                                        "entry_id": "09772eba-8192-3981-8295-ae3d7427b412",
                                        "glosses": [
                                            "In a pithy manner, concisely and to the point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed45cb45-400c-4c36-97c3-35fff56bb44a",
                                                "sense_id": "945603f3-d613-3d2c-8443-f3409b8afa83",
                                                "text": "Essays are written on causes—they might be more pithily turned on consequences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82c2a72a-625a-477f-82bd-62fa85a39255",
                        "source_entry_id": "5a17b78f-adb0-3152-bf5b-75e596fe64f0",
                        "source_sense_id": "ccfe2916-a23c-3b6c-9150-da254523fb00",
                        "target_lang_word": "succinctly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "succinctly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                        "entry_id": "41b3c950-fdc9-3557-8f8e-728b1d471d36",
                                        "glosses": [
                                            "In a succinct manner, concisely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b92ebcf-bbdf-4d85-8b80-8172b5c510fc",
                                                "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                                "text": "With this preface, Sam related, as succinctly as he could, the last memorable conversation he had had with Mr. Pickwick."
                                            },
                                            {
                                                "example_id": "63dcb38c-6160-4aa8-8d43-b2b77b1e9e6a",
                                                "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                                "text": "My companion smiled approvingly. “You sum up the difficulties of the situation succinctly and well,” he said."
                                            },
                                            {
                                                "example_id": "9ac4576a-af77-44cd-9bd2-22c67645eee0",
                                                "sense_id": "b7d96659-4784-3e89-bb44-db1b8feac852",
                                                "text": "[\"]Who is he?\" \"He is Tom,\" replied Ajor succinctly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4667d2b-9030-441a-b07f-1eb4351226b8",
                        "source_entry_id": "5a17b78f-adb0-3152-bf5b-75e596fe64f0",
                        "source_sense_id": "ccfe2916-a23c-3b6c-9150-da254523fb00",
