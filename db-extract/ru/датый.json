                ],
                "senses": [
                    {
                        "sense_id": "14541713-a8c5-35f9-b7c9-6f18c37d9cac",
                        "entry_id": "d499403e-3788-3986-b22f-8cf11ea53cde",
                        "glosses": [
                            "прост. то же, что пьяный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a876a8-2ab3-4c58-af7b-4f53eb8d22aa",
                                "sense_id": "14541713-a8c5-35f9-b7c9-6f18c37d9cac",
                                "text": "На прощальной пьянке по окончанию гастролей сильно датый менеджер наехал на переводчика."
                            },
                            {
                                "example_id": "69458aee-6dbc-4b72-bfa0-a39c30baf2d9",
                                "sense_id": "14541713-a8c5-35f9-b7c9-6f18c37d9cac",
                                "text": "Он был уже здорово датый, остальные тоже."
                            },
                            {
                                "example_id": "ba3c6d6b-c487-4b80-be6f-1fcfe58de786",
                                "sense_id": "14541713-a8c5-35f9-b7c9-6f18c37d9cac",
                                "text": "А я чего-то усталый был как черт, ну и датый… слегка."
                            }
                        ]
                    }
                ],
