                                "target_lang_word": "greaves",
                                "target_lang_sense_clarification": "fried residue of animal fat"
                            },
                            {
                                "target_lang_word": "crackling",
                                "target_lang_sense_clarification": "crisp skin or fat"
                            }
                        ],
                        "ru": [
