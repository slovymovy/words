                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b663218-161c-45a5-bbbd-dd59d90d7815",
                                "sense_id": "17805e7a-3eb5-395e-b480-3bd980f5cffe",
                                "text": "„Er arbeitete in einem internationalen Ausgrabungsteam, das in einer Höhle unweit des Zentrums der heutigen chinesischen Hauptstadt den Schädel des nach seinem Fundort benannten Pekingmenschen entdeckte.“"
                            },
                            {
                                "example_id": "afcba13d-986c-4b2c-8dab-3f4756fc6a2d",
                                "sense_id": "17805e7a-3eb5-395e-b480-3bd980f5cffe",
                                "text": "„Das Ausgrabungsteam fand sie 1896 in einer Kammer, die sie entsprechend der Zählung »Room 33« nannten.“"
                            }
                        ],
