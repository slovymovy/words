                                "sense_id": "ce34c86f-fb56-3704-a46b-86cf668bd95b",
                                "text": "Si vous êtes pressé prenez le bateau-taxi."
                            },
                            {
                                "example_id": "0d8ea2cb-e7d8-4956-8104-fc14593e326f",
                                "sense_id": "ce34c86f-fb56-3704-a46b-86cf668bd95b",
                                "text": "Au moment où le bateau-taxi touchait la coque du voilier , le capitaine poussa un cri pour annoncer leur arrivée et il tourna la tête."
                            }
