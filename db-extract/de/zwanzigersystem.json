                "senses": [
                    {
                        "sense_id": "179ad0cf-90ec-3459-aea7-4e153df2f086",
                        "entry_id": "162dbf5d-85f0-3f9f-b828-8a91ee5120ca",
                        "glosses": [
                            "Stellenwertsystem zur Basis zwanzig"
