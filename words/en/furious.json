                {
                    "sense_id": "a21e86cf-cb88-3ed5-8f87-d2884410d2aa",
                    "sense_definition": "Moving with great energy, intensity, or violence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to seek shelter quickly as a <w>furious</w> storm began to lash the mountain.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось быстро искать укрытие, так как на гору обрушился <w>яростный</w> шторм.",
                                "nl": "De wandelaars moesten snel beschutting zoeken toen een <w>woeste</w> storm de berg begon te teisteren.",
                                "pl": "Turyści musieli szybko szukać schronienia, gdy <w>szalejąca</w> burza zaczęła smagać górę.",
                                "de": "Die Wanderer mussten schnell Schutz suchen, als ein <w>heftiger</w> Sturm über den Berg zu peitschen begann.",
                                "fr": "Les randonneurs ont dû rapidement chercher un abri alors qu'une tempête <w>furieuse</w> commençait à s'abattre sur la montagne.",
                                "it": "Gli escursionisti hanno dovuto cercare rapidamente un riparo quando una tempesta <w>furiosa</w> ha iniziato a sferzare la montagna.",
                                "cs": "Turisté museli rychle vyhledat úkryt, protože horu začala bičovat <w>divoká</w> bouře.",
                                "tr": "Dağı dövmeye başlayan <w>şiddetli</w> bir fırtına yüzünden dağcılar hızla sığınacak bir yer aramak zorunda kaldı.",
                                "es": "Los excursionistas tuvieron que buscar refugio rápidamente cuando una tormenta <w>furiosa</w> comenzó a azotar la montaña."
                            }
                        },
                        {
                            "text": "The boat struggled to stay upright against the <w>furious</w> wind and rising waves.",
                            "target_lang_translations": {
                                "ru": "Лодка с трудом удерживалась на плаву, сопротивляясь <w>свирепому</w> ветру и растущим волнам.",
                                "nl": "De boot had moeite om overeind te blijven tegen de <w>razende</w> wind en de opstuwende golven.",
                                "pl": "Łódź z trudem utrzymywała się na wodzie w walce z <w>gwałtownym</w> wiatrem i rosnącymi falami.",
                                "de": "Das Boot hatte Mühe, sich gegen den <w>wilden</w> Wind und die hohen Wellen aufrecht zu halten.",
                                "fr": "Le bateau luttait pour rester à flot face au vent <w>déchaîné</w> et aux vagues montantes.",
                                "it": "La barca faticava a rimanere a galla contro il vento <w>impetuoso</w> e le onde sempre più alte.",
                                "cs": "Loď měla potíže udržet se na hladině proti <w>prudkému</w> větru a zvedajícím se vlnám.",
                                "tr": "Tekne, <w>amansız</w> rüzgara ve yükselen dalgalara karşı ayakta kalmakta zorlanıyordu.",
                                "es": "El bote luchaba por mantenerse a flote contra el viento <w>furioso</w> y las olas cada vez más altas."
                            }
                        }
                    ],
