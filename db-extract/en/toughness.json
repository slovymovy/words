                                                "example_id": "719a801d-6a7b-4e3a-a705-744179153d99",
                                                "sense_id": "8842d15b-74fc-3888-8482-73629642595b",
                                                "text": "L’endurance se trouve au cœur de la performance sportive."
                                            }
