                    },
                    {
                        "form_id": "cb16b26e-90c1-483e-9225-500ddae84d56",
                        "entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "tags": [
                            "past"
                        ],
                        "form": "naturalized"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fde0e922-5717-3186-9764-63ead24cd95d",
                        "entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "glosses": [
                            "To grant citizenship to someone not born a citizen."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6bcb981e-5fb3-44c1-83fa-06acf60ebf43",
                                "sense_id": "fde0e922-5717-3186-9764-63ead24cd95d",
                                "text": "Pakche was destroyed and five years later, Kokuryo was also swept away by T’ang and Silla. T’ang set up An-tontu-hu-fu (Government headquarters) at P’ing jang to rule the former territories of Pakche and Kokuryo. Many refugees from these destroyed states came to Japan and became naturalized as Japanese."
                            }
                        ]
                    },
                    {
                        "sense_id": "90375060-b095-335f-8c0b-bfa8c8cbdc41",
                        "entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "glosses": [
                            "To acclimatize an animal or plant."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb1d010-d106-4ca2-becd-1e6373698343",
                                "sense_id": "90375060-b095-335f-8c0b-bfa8c8cbdc41",
                                "text": "Its wearer suggested that pears and peaches might yet be naturalized in the New England climate."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e712480-6b38-3b42-a3a7-e0364677a270",
                        "entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "glosses": [
                            "To make natural."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d1dd1b5-ac65-4936-bade-f6ffb7b50924",
                                "sense_id": "2e712480-6b38-3b42-a3a7-e0364677a270",
                                "text": "Custom naturalizes labour or study."
                            }
                        ]
                    },
                    {
                        "sense_id": "628157ad-c5a8-3415-b774-fe2550dd79c7",
                        "entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "glosses": [
                            "To limit explanations of a phenomenon to naturalistic ones and exclude supernatural ones."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "84072641-5454-31db-bcc3-7eb9dbadb86f",
                        "entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "glosses": [
                            "To make (a word) a natural part of the language, using the native homologue of each phoneme (and often for each morpheme) of the imported word (e.g., native inflections)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ebe0ff69-5474-43ef-b094-52abc3539ad4",
                                "sense_id": "84072641-5454-31db-bcc3-7eb9dbadb86f",
                                "text": "In English, foreign words are typically written in italics until they are naturalized."
                            },
                            {
                                "example_id": "c6086fd7-12ae-423a-a399-69bd57b915c7",
                                "sense_id": "84072641-5454-31db-bcc3-7eb9dbadb86f",
                                "text": "English speakers have naturalized the French word \"café\"."
                            },
                            {
                                "example_id": "ae32d63c-ab9f-475d-8cf1-c277e9c9af7f",
                                "sense_id": "84072641-5454-31db-bcc3-7eb9dbadb86f",
                                "text": "English orthography often (but not invariably) drops the diacritics from words that it has naturalized from other languages."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2b4c8a2-5b0b-30e8-ab2a-4ce5acc7fda2",
                        "entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "glosses": [
                            "To study nature."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "23466b5e-e289-46bb-9e9a-a5e15746fc52",
                                "sense_id": "d2b4c8a2-5b0b-30e8-ab2a-4ce5acc7fda2",
                                "text": "Well, any way, Doctor, we will make an appointment for a whole day here next spring ; we will botanize, herbarize and naturalize to our hearts' content, from morn till night.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da60b440-bbf0-4c64-b6f9-99068b8f0b96",
                        "source_entry_id": "cbc2fa6d-bb27-300f-93d3-318cd3ec71b2",
                        "source_sense_description": "to grant citizenship",
                        "target_lang_word": "naturaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naturaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3c06fce-667d-3b2a-99f0-35f4a76c5c7c",
                                        "entry_id": "48e709c0-22db-3c19-8f62-6ff781e69dff",
                                        "glosses": [
                                            "Accorder par une décision publique la nationalité d’un pays à une personne étrangère, avec les droits civils et droits politiques associés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9fb8cb-50f6-48c7-8107-553a788f8946",
                                                "sense_id": "b3c06fce-667d-3b2a-99f0-35f4a76c5c7c",
                                                "text": "Il s’est fait naturaliser français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c619495-84d9-38e4-bab8-68fb686f72a4",
                                        "entry_id": "48e709c0-22db-3c19-8f62-6ff781e69dff",
                                        "glosses": [
                                            "Introduire une espèce animale ou végétale dans un environnement où elle n’est pas native, de manière qu’elle puisse s’y reproduire naturellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6029958-9f39-4a53-a235-df444acaad0c",
                                                "sense_id": "2c619495-84d9-38e4-bab8-68fb686f72a4",
                                                "text": "L’Afrique renferme plusieurs espèces d’animaux qu’on ne pourrait naturaliser en Europe."
                                            },
                                            {
                                                "example_id": "7fd55dc8-55fc-45b5-b028-589381719144",
                                                "sense_id": "2c619495-84d9-38e4-bab8-68fb686f72a4",
                                                "text": "On est parvenu à naturaliser cette plante, cet arbre en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f14ea4b-6a3f-3b18-9f1a-dcf89b91cc14",
                                        "entry_id": "48e709c0-22db-3c19-8f62-6ff781e69dff",
                                        "glosses": [
                                            "Préparer un animal mort (par empaillage) ou conserver une plante de manière à lui garder son apparence de vivant."
                                        ],
                                        "tags": [
                                            "Taxidermie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92d3d3da-344a-4228-96d4-36afede1e861",
                                                "sense_id": "2f14ea4b-6a3f-3b18-9f1a-dcf89b91cc14",
                                                "text": "Son lieu d’élection est la tour la plus haute du château où Liz s’isole pour pratiquer la magie et la taxidermie : elle plante des épingles dans une statuette de glaise et empaille des oiseaux, les naturalise et fige leur vie fictive pour l’éternité. L’embaumement auquel elle se livre a un rapport oblique et déroutant avec l’art de la peinture et la figure du mari."
                                            },
                                            {
                                                "example_id": "6c614696-f3c3-47db-95a3-b4c5a9b7dafb",
                                                "sense_id": "2f14ea4b-6a3f-3b18-9f1a-dcf89b91cc14",
                                                "text": "La célèbre girafe Zarafa a été naturalisée après sa mort en 1845. Elle est conservée au muséum d’Histoire naturelle de La Rochelle."
                                            },
                                            {
                                                "example_id": "0141b043-f0c3-4253-a7cb-a53cc3559f73",
                                                "sense_id": "2f14ea4b-6a3f-3b18-9f1a-dcf89b91cc14",
                                                "text": "La troisième, c'est son père Richard, 87 ans, qui l'a naturalisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43ce68c0-78dd-3317-9265-1fa2288b90fd",
                                        "entry_id": "48e709c0-22db-3c19-8f62-6ff781e69dff",
                                        "glosses": [
                                            "Adapter un mot ou une expression emprunté(e) à une autre langue de façon qu’il ou elle s’intègre à l’orthographe, à la prononciation ou à la morphologie du français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "382ad12d-35d7-4660-911b-0bfb923e6a96",
                                                "sense_id": "43ce68c0-78dd-3317-9265-1fa2288b90fd",
                                                "text": "Le mot anglais week-end est naturalisé en français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "561369d5-45e7-31c2-9420-899839fe8c1f",
                                        "entry_id": "48e709c0-22db-3c19-8f62-6ff781e69dff",
                                        "glosses": [
                                            "Présenter un phénomène social, historique ou politique comme s’il était naturel ou allant de soi, en dissimulant sa construction ou sa contingence."
                                        ],
                                        "tags": [
                                            "Sciences humaines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc4a144-1fdd-47c2-992b-9aeed67efbb2",
                                                "sense_id": "561369d5-45e7-31c2-9420-899839fe8c1f",
                                                "text": "L’étude présentée ici révèle un héritage complexe. Il ne s’agit pas seulement de désigner le bas de l’échelle à un moment donné. La rationalisation de l’inégalité économique fait inconsciemment partie du credo national; la pauvreté a été naturalisée, souvent considérée comme quelque chose qui échappe au contrôle de l’homme.Selon cette mesure, les Blancs pauvres devaient être classés en tant que race distincte."
                                            },
                                            {
                                                "example_id": "7b2966f2-29f4-4661-a5e5-e1b1585b9135",
                                                "sense_id": "561369d5-45e7-31c2-9420-899839fe8c1f",
                                                "text": "L’industrialisation a été naturalisée en même temps que ses pollutions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99b439ac-f3df-4c9d-8e71-62b2f22f62a2",
