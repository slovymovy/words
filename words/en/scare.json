                                "target_lang_sense_clarification": "qui existe en petite quantité"
                            },
                            {
                                "target_lang_word": "scabreux",
                                "target_lang_sense_clarification": "insuffisant ou précaire"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "schaars",
                                "target_lang_sense_clarification": "in geringe mate aanwezig"
                            },
                            {
                                "target_lang_word": "zeldzaam",
                                "target_lang_sense_clarification": "niet veel voorkomend"
                            }
                        ]
                    }
                }
