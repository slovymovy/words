                    {
                        "sense_id": "d974d5fd-5eda-307e-a5cb-7887826ded05",
                        "entry_id": "9c12da51-b200-3766-b6ac-e5911d5002a0",
                        "glosses": [
                            "Person, die etwas per Post, Boten und/oder Kurier verschickt; Adressant, Absender"
                        ],
