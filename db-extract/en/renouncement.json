                        "translation_id": "162a717b-cb08-40f0-a506-a43962fa63d9",
                        "source_entry_id": "30bcabf6-f7bd-35bd-9095-ace7c955f818",
                        "source_sense_id": "e13a4363-22c9-34f9-ab4e-cc2a81e88bfd",
                        "source_sense_description": "the act of renouncing",
                        "target_lang_word": "renoncement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renoncement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                        "entry_id": "25a71a17-d61f-3971-b736-bb321c048552",
                                        "glosses": [
                                            "Action de renoncer."
                                        ],
                                        "tags": [],
                                        "note": "Se dit surtout dans les sujets de morale et particulièrement de morale religieuse",
                                        "examples": [
                                            {
                                                "example_id": "ec78164d-dfd6-498b-9d9f-aefde5a49ae5",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "« Tout homme porte en lui un ou plusieurs morts », m’avait dit sentencieusement le docteur, qui soupçonnait aussi des renoncements dans la vie du campagnard des Trembles."
                                            },
                                            {
                                                "example_id": "b459616a-a77a-43f7-bead-068e256e4540",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Sous le coup, la vieille servante chancela. Un déchirement, une douleur affreuse blêmit sa pauvre face usée, d’un renoncement de nonne, dans la blancheur de sa coiffe."
                                            },
                                            {
                                                "example_id": "28e94f7c-c142-40cd-b7e9-7c8acbc845ac",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "La tristesse indéfinissable, douce comme le renoncement définitif, des soirs d'or et de carmin, préparant au mystère menaçant des nuits obscures et pleines d'inconnu, …"
                                            },
                                            {
                                                "example_id": "0d31ca75-3dcc-4086-aa93-076adebf3e65",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Le renoncement à soi-même, à l’existence, à tout, le renoncement des religieux qui tentent de commencer dès ce monde la vie surnaturelle, si vous saviez comme il me tente."
                                            },
                                            {
                                                "example_id": "1e9b2d7c-546a-4caf-999a-54e1ae8b07d7",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Le renoncement à soi-même n'est pas la destruction de soi-même mais le renoncement à garder la vie pour soi."
                                            },
                                            {
                                                "example_id": "dde89af4-5757-4ff5-adba-29ec7f9c79b3",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Bouddha a encouragé de nombreuses vertus positives comme la bonté, le don, le détachement, le renoncement, l'équanimité, la patience, le pardon, la chasteté, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
