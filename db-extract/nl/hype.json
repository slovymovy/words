                                    {
                                        "sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                                        "entry_id": "4f85e630-52e9-3964-a748-57d8a506843b",
                                        "glosses": [
                                            "großes Getue, übertriebene Propaganda, Riesenrummel um eine Tatsache, Sache oder Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f98e9723-44cf-48b3-a242-15226d4d750c",
                                                "sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                                                "text": "Es ist momentan der volle Hype, Socken ohne Löcher zu tragen."
                                            },
                                            {
                                                "example_id": "fbf677d5-f19a-454c-8554-d8037dbbf3db",
                                                "sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                                                "text": "Man muss ja nicht jeden Hype mitmachen."
                                            },
                                            {
                                                "example_id": "7e0393c0-6597-4eff-a195-79b391fc2a12",
                                                "sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                                                "text": "Der Hype um Angela Merkels Deutschland-Handtasche wird auch vorübergehen."
                                            },
                                            {
                                                "example_id": "ca958e24-18de-4d5e-9910-306da3ab2a96",
                                                "sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                                                "text": "„Und siehe da, was noch vor fünf Jahren lediglich eine Handvoll engagierter Menschen interessiert hätte, entwickelt sich dank Facebook und Twitter zum echten Hype.“"
                                            },
                                            {
                                                "example_id": "b2393a96-e667-4166-8f0e-4793d4d20c39",
                                                "sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                                                "text": "„Irritieren mag aber auch die überraschende Ratlosigkeit, mit der viele Beobachter den Wirkungen und dem medialen Hype von Fake News gegenüberstehen.“"
                                            },
                                            {
                                                "example_id": "be5d9b97-e8d6-4ff2-b585-7365fdb29d93",
                                                "sense_id": "0e243170-6fed-3c1e-ad6b-90b68903b5b4",
                                                "text": "„Es war ein Hype sondergleichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95751460-f35d-3abb-ae8a-7d7411c7c431",
                                        "entry_id": "4f85e630-52e9-3964-a748-57d8a506843b",
                                        "glosses": [
                                            "Tatsache, Sache oder Person, um die ein großer Medienrummel herrscht"
                                        ],
                                        "tags": [
                                            "nur maskulines Genus"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
