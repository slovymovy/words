                    },
                    {
                        "translation_id": "39315720-dfc7-4802-988a-a3dbfb2e0ec2",
                        "source_entry_id": "2a55bc4d-8ac5-3051-b86d-dbd4cf8b54cc",
                        "source_sense_id": "55d03982-f126-353a-b72d-c24f1706d1b8",
                        "source_sense_description": "Auffangbecken",
                        "target_lang_word": "impluvium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impluvium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26b09ebb-49cc-3e25-be17-e39986649759",
                                        "entry_id": "8eddd993-2e75-3867-bc35-c955f40c84fc",
                                        "glosses": [
                                            "Bassin recueillant les eaux de pluie, situé au centre de l’atrium dans les maisons romaines antiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caaf42ef-3af1-469b-9b4b-f1f549b7f548",
                                                "sense_id": "26b09ebb-49cc-3e25-be17-e39986649759",
                                                "text": "Le puits du milieu y tient évidemment la place de l’impluvium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8615dc4a-9560-3b34-8e3d-96e289686453",
                                        "entry_id": "8eddd993-2e75-3867-bc35-c955f40c84fc",
                                        "glosses": [
                                            "Espace dans une maison contenant un bassin recueillant les eaux de pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "429af3c1-efa6-41b2-b749-57644b410dcc",
                                                "sense_id": "8615dc4a-9560-3b34-8e3d-96e289686453",
                                                "text": "Elle avait la forme élégante du chalet, et une véranda à laquelle pendaient des lampes chinoises contournait le long des murs comme un impluvium antique."
                                            },
                                            {
                                                "example_id": "9ac8fb2d-f050-46f1-a5a4-2e4bcb0cfe4f",
                                                "sense_id": "8615dc4a-9560-3b34-8e3d-96e289686453",
                                                "text": "Au-dessus, le toit se prolongeait en manière d’impluvium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bff61b0-7b91-35bf-8aa6-33cbb52a4a38",
                                        "entry_id": "8eddd993-2e75-3867-bc35-c955f40c84fc",
                                        "glosses": [
                                            "Espace recueillant les eaux de pluie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da64587-10bf-44f9-82af-d3a902d4ca18",
                                                "sense_id": "6bff61b0-7b91-35bf-8aa6-33cbb52a4a38",
                                                "text": "À certains intervalles, et sous cet impluvium naturel, l’œil surprenait des ouvertures ogivales d’un dessin admirable, à travers lesquelles les flots du large venaient se précipiter en écumant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
