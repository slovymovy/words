                "senses": [
                    {
                        "sense_id": "68c3d6c4-aa58-31bb-b415-561a5cbc6b94",
                        "entry_id": "f77c708b-79a3-3ccb-9b88-5250b5811db7",
                        "glosses": [
                            "eine Öffnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4665c725-1b0a-4683-bd35-de48fc6cc817",
                                "sense_id": "68c3d6c4-aa58-31bb-b415-561a5cbc6b94",
                                "text": "\"An orifice is any opening, mouth, hole or vent, as of a pipe, plate, or a body.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c3f83e5-7303-40ca-bc2f-f93633dbedc7",
                        "source_entry_id": "f77c708b-79a3-3ccb-9b88-5250b5811db7",
                        "source_sense_id": "68c3d6c4-aa58-31bb-b415-561a5cbc6b94",
                        "source_sense_description": "eine Öffnung",
                        "target_lang_word": "Öffnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Öffnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98dcc998-faa5-3996-b9bd-adb60bdea48b",
                                        "entry_id": "6c0e47ee-785a-3026-a4e8-60be1bdd4e03",
                                        "glosses": [
                                            "nicht verschlossener Bereich eines Gegenstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25c59bf-67e4-4c13-998e-03c629325186",
                                                "sense_id": "98dcc998-faa5-3996-b9bd-adb60bdea48b",
                                                "text": "Das Kameragehäuse hat eine Öffnung, vor der die Linse sitzt."
                                            },
                                            {
                                                "example_id": "79021931-d399-41f2-9e8e-07fc718501e0",
                                                "sense_id": "98dcc998-faa5-3996-b9bd-adb60bdea48b",
                                                "text": "Wir zwängten uns durch die schmale Öffnung hindurch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                        "entry_id": "6c0e47ee-785a-3026-a4e8-60be1bdd4e03",
                                        "glosses": [
                                            "Vorgang, bei dem etwas zuvor Geschlossenes geöffnet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9af46e-7b31-400b-b674-bdb4ca7f9ee0",
                                                "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                                "text": "Die Opposition fordert die sofortige Öffnung der Geschäfte."
                                            },
                                            {
                                                "example_id": "74dff74a-a9d2-413f-aeba-743ab264711f",
                                                "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                                "text": "In Griechenland erwog man zum Montag die Öffnung der Banken."
                                            },
                                            {
                                                "example_id": "57b66464-2675-488d-9713-a830b2e87c40",
                                                "sense_id": "3164a2e6-f8e0-3570-b58a-0dd087bb298c",
                                                "text": "China soll einer Öffnung seiner Märkte zustimmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "14e65c30-c48f-36bf-833d-06f077d93b54",
                                        "entry_id": "6c0e47ee-785a-3026-a4e8-60be1bdd4e03",
                                        "glosses": [
                                            "Annäherung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928ed838-ae5c-430e-a048-41a0aebf56c8",
                                                "sense_id": "14e65c30-c48f-36bf-833d-06f077d93b54",
                                                "text": "Russlands Öffnung nach Westen kam nicht unerwartet."
                                            },
                                            {
                                                "example_id": "41001c9d-51ea-4b8a-8a27-5c44c16a37d3",
                                                "sense_id": "14e65c30-c48f-36bf-833d-06f077d93b54",
                                                "text": "„Das Meer war Karthagos Element und die Flotte seine Lebensader. Der maritime Charakter der Stadt hatte ihre Öffnung nach allen Seiten hin begünstigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
