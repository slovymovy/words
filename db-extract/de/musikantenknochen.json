                                "target_senses": [
                                    {
                                        "sense_id": "b774ad6c-e12a-3dc0-81a8-c09c476a4fc3",
                                        "entry_id": "83bdfeb2-8d8a-3662-85f6-ef042bf61abd",
                                        "glosses": [
                                            "The ulnar nerve in the elbow, which, when hit, causes a tingly sensation."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7cb123a-b209-410f-9975-ce3f8c520dfc",
                                                "sense_id": "b774ad6c-e12a-3dc0-81a8-c09c476a4fc3",
                                                "text": "Ouch, I just hit my funny bone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c46fb8c3-0e89-3b9b-ab93-9826801003f5",
                                        "entry_id": "83bdfeb2-8d8a-3662-85f6-ef042bf61abd",
                                        "glosses": [
                                            "One's sense of humor."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d4e63d4-600f-4bbb-b831-243a6fbce3cd",
                                                "sense_id": "c46fb8c3-0e89-3b9b-ab93-9826801003f5",
                                                "text": "His wisecracks always tickle my funny bone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71f08c2d-50db-4cf3-9c94-37a17c02098c",
                        "source_entry_id": "66e759b4-95cc-36d0-8aa0-fcdcf64ab115",
                        "source_sense_id": "0dc2de86-0b55-3522-b9b3-d7ae2520a4ca",
                        "target_lang_word": "crazy bone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crazy bone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc06a8b7-2eff-383e-a5f9-b091695ec246",
                                        "entry_id": "5f252a37-7eea-375a-921f-f5a2a75f2bb6",
                                        "glosses": [
                                            "The funny bone; the ulnar nerve in the elbow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c9fcfa-8084-49d1-862a-f83b1a93edd0",
                                                "sense_id": "dc06a8b7-2eff-383e-a5f9-b091695ec246",
                                                "text": "I have seen a person in England, who had touched a torpedo; and he said the shock it gave him, was like striking that tender part of the elbow, which we call the crazy bone, very hard indeed;"
                                            },
                                            {
                                                "example_id": "b28cfe8b-ecf3-4683-81f0-aab3a49772ce",
                                                "sense_id": "dc06a8b7-2eff-383e-a5f9-b091695ec246",
                                                "text": "My hand was at his elbow, my fingers just at the indentation of his elbow, just about where you bump the nerve point everyone calls the “crazy-bone”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93daa240-6f96-475d-b779-f1dbfdbdf6e1",
                        "source_entry_id": "66e759b4-95cc-36d0-8aa0-fcdcf64ab115",
