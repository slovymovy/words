                "senses": [
                    {
                        "sense_id": "bd136780-3c6f-3718-a748-66c946afaba3",
                        "entry_id": "fca956ea-68ad-3db9-91f7-88d796eeda2b",
                        "glosses": [
                            "chemisches Element mit der Ordnungszahl 87, das zur Gruppe der Alkalimetalle gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d58c51-86a5-4074-b4dc-35a059068809",
                                "sense_id": "bd136780-3c6f-3718-a748-66c946afaba3",
                                "text": "Francium ist radioaktiv und hat eine kurze Halbwertszeit."
                            },
                            {
                                "example_id": "ab5de3ee-5ccc-4f70-9d0b-42bd83fccada",
                                "sense_id": "bd136780-3c6f-3718-a748-66c946afaba3",
                                "text": "„Francium kann nur als Salz in verdünnten Lösungen und hoch verdünnt als Amalgam studiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c3b47b4-3da0-4741-8475-dd426b53d578",
                        "source_entry_id": "fca956ea-68ad-3db9-91f7-88d796eeda2b",
                        "source_sense_id": "bd136780-3c6f-3718-a748-66c946afaba3",
                        "source_sense_description": "chemisches Element mit der Ordnungszahl 87",
                        "target_lang_word": "francium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "francium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91c5125b-e40d-3887-a2b2-32fc9dde4f7f",
                                        "entry_id": "85dfceea-9989-32d1-8d7e-ff87dbadbfaa",
                                        "glosses": [
                                            "The chemical element (symbol Fr) with an atomic number of 87. It is an intensely radioactive alkali metal that is not found in nature."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75dcba0b-2cb5-44fb-b35e-734d3b0339ad",
                                                "sense_id": "91c5125b-e40d-3887-a2b2-32fc9dde4f7f",
                                                "text": "The most elusive element of all, however, appears to be francium, which is so rare that it is thought that our entire planet may contain, at any given moment, fewer than twenty francium atoms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c420c3-8f29-3097-b6b6-64171d3178ae",
                                        "entry_id": "85dfceea-9989-32d1-8d7e-ff87dbadbfaa",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c16f3e3-6527-48c8-9c9a-cc9f4350e770",
                                                "sense_id": "67c420c3-8f29-3097-b6b6-64171d3178ae",
                                                "text": "Notice that franciums are balanced without even thinking in moles, atoms, or whatever."
                                            },
                                            {
                                                "example_id": "96c5ee0f-4900-41f8-8a03-a764c94ecf5a",
                                                "sense_id": "67c420c3-8f29-3097-b6b6-64171d3178ae",
                                                "text": "(a) Radons and poloniums are compared, (b) poloniums and astatines are compared and (c) radons and franciums are compared."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50db2513-77c0-485b-a28b-e73a002e0312",
                        "source_entry_id": "fca956ea-68ad-3db9-91f7-88d796eeda2b",
                        "source_sense_id": "bd136780-3c6f-3718-a748-66c946afaba3",
                        "source_sense_description": "chemisches Element mit der Ordnungszahl 87",
                        "target_lang_word": "francium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "francium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b45193-7592-3177-84a9-1922f5ad40c9",
                                        "entry_id": "332f8475-618a-3268-817e-a83dbf2b26d2",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 87 et de symbole Fr, hautement radioactif, il appartient à la série chimique des métaux alcalins."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36e55341-60fd-4cc2-937d-c93b3b1f734e",
                                                "sense_id": "d9b45193-7592-3177-84a9-1922f5ad40c9",
                                                "text": "Mais l’élément le plus rare reste semble-t-il le francium, au point que la planète entière n’en contient sans doute guère plus de vingt atomes à la fois."
                                            },
                                            {
                                                "example_id": "7c35666b-c1c8-4452-9610-3e4666106e09",
                                                "sense_id": "d9b45193-7592-3177-84a9-1922f5ad40c9",
                                                "text": "L’isotope le plus stable du francium a une demi-vie de 22 min, ce qui en fait l’élément naturel le plus instable. Il ne connait pas d’usage pratique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61569bba-4f67-389e-804b-00f4a5f49e0b",
                                        "entry_id": "332f8475-618a-3268-817e-a83dbf2b26d2",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) de francium."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e04281c-ba72-3b7b-8df3-e726ea58367e",
                                        "entry_id": "332f8475-618a-3268-817e-a83dbf2b26d2",
                                        "glosses": [
                                            "Isotopes ou alliages de francium, dans leur ensemble."
                                        ],
