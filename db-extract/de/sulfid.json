                                "target_senses": [
                                    {
                                        "sense_id": "be5993cd-7e25-300a-8dfc-6acd17033ffa",
                                        "entry_id": "4133a330-42f2-3305-8b01-911b179ff8cc",
                                        "glosses": [
                                            "A kind of clear marble with a small statuette or figure inside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed23239d-3786-4146-9e14-e13897dd9496",
                                                "sense_id": "be5993cd-7e25-300a-8dfc-6acd17033ffa",
                                                "text": "Rare marbles, especially overlays, sulphides, clambroths, and other unusual specimens, need gentle washing and drying."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4472bdd-f4c6-4dbd-9520-2a729441bd16",
                        "source_entry_id": "61af7de8-a1b7-397c-8258-f401ae6d68dd",
                        "source_sense_id": "5caaa283-4d6a-3dc1-adf9-92006efd8c36",
                        "source_sense_description": "Chemie: Salz oder Ester des Schwefelwasserstoffs",
                        "target_lang_word": "sulfure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sulfure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d7425bf-c688-3296-b69e-a99691d46d82",
                                        "entry_id": "000b672b-7db7-3050-96b0-4c6f1a33f056",
                                        "glosses": [
                                            "Combinaison du soufre avec un métal ou un métalloïde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eadf7d48-a43c-402d-953f-832fffb75b87",
                                                "sense_id": "9d7425bf-c688-3296-b69e-a99691d46d82",
                                                "text": "Le potelot, ou sulfure de molybdène natif, exposé au feu dans un vaisseau ouvert, exhale du soufre, & s'évapore presque tout entier en fumée blanche."
                                            },
                                            {
                                                "example_id": "89bcbca9-a20e-42ea-a44b-47ff8bc616d7",
                                                "sense_id": "9d7425bf-c688-3296-b69e-a99691d46d82",
                                                "text": "On a remarqué que chez les saturnins la peau prend une teinte noirâtre quand elle est badigeonnée avec une solution de sulfure de potassium à 5 pour 100."
                                            },
                                            {
                                                "example_id": "0b8ec1a2-4efc-41d4-848d-7ad3fb849ebc",
                                                "sense_id": "9d7425bf-c688-3296-b69e-a99691d46d82",
                                                "text": "L'extraction des graisses se fait par un dissolvant des matières grasses: benzine, sulfure de carbone, alcool, etc."
                                            },
                                            {
                                                "example_id": "8d682e68-db10-4fa2-9260-39876ff0d539",
                                                "sense_id": "9d7425bf-c688-3296-b69e-a99691d46d82",
                                                "text": "Les sulfures (COS, mono- et disulfures de méthyle et d’éthyle) sont analysés selon l’EPA par GC et détection par photométrie de flamme, après piégeage sur Tenax GC et élimination en amont du SO₂ par un piège alcalin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd1710be-c9f8-318a-94f5-7134003fd4c7",
                                        "entry_id": "000b672b-7db7-3050-96b0-4c6f1a33f056",
                                        "glosses": [
                                            "Boule presse-papiers contenant un décor noyé dans du cristal."
                                        ],
                                        "tags": [
                                            "Céramique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33bd321f-d061-4395-8f42-97732011ff95",
                                                "sense_id": "cd1710be-c9f8-318a-94f5-7134003fd4c7",
                                                "text": "Mais voici le palier éclairé par la lumière douce de vitrines où s'amoncelle un bric-à-brac, très bourgeois 1900, de petits bronzes, de sulfures, de biscuits de Saxe."
                                            },
                                            {
                                                "example_id": "ac644e22-b58b-4a24-97c5-a31f4a0eae59",
                                                "sense_id": "cd1710be-c9f8-318a-94f5-7134003fd4c7",
                                                "text": "Mais justement, rien ne me plaît de ce bric-à-brac suranné, ni les opalines de foire, ni les coupelles en Wedgewood, ni les sulfures mille-fleurs."
                                            },
                                            {
                                                "example_id": "04dbf1d3-8845-4efe-9b70-4071d38c7b00",
                                                "sense_id": "cd1710be-c9f8-318a-94f5-7134003fd4c7",
                                                "text": "Je dialoguais avec moi-même et ne me déplaçais jamais sans quelques-uns de mes objets fétiches : des crayons de couleur, ma collection de billes « tourbillon », une boule de sulfure dans laquelle était enfermé un papillon."
                                            }
                                        ]
                                    }
                                ]
                            },
