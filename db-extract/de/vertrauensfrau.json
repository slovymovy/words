                        "target_lang_word": "femme de confiance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femme de confiance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d96535-53e2-324a-abeb-dda6b1556197",
                                        "entry_id": "dc78e9b7-6cbc-3032-94b7-73f358d75fdb",
                                        "glosses": [
                                            "Femme que l’on emploie ordinairement dans les affaires délicates et secrètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dca7453-1db9-4499-a28d-a3bec33d8ff3",
                                                "sense_id": "d9d96535-53e2-324a-abeb-dda6b1556197",
                                                "text": "— J’étais femme de confiance chez un maréchal de France, le prince d’Ysembourg, dit-elle en prenant une pose de Dorine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93bde192-0899-4e46-8654-ceffd6a34afa",
                        "source_entry_id": "ed706d11-23a7-3278-8944-f7ae3103c554",
                        "source_sense_id": "0a2bb084-b6f2-37a3-89ef-15affdc19588",
