                "senses": [
                    {
                        "sense_id": "efa21b7c-fa36-37f2-ae03-908420304523",
                        "entry_id": "e08fbeb1-5508-32d0-8395-b3d58c4bb204",
                        "glosses": [
                            "Situation einer Gesellschaft, deren Gruppen von mehreren sehr unterschiedlichen Kulturen geprägt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e9c2aa-9a0f-4f1f-8ca1-8c134dc91e8d",
                                "sense_id": "efa21b7c-fa36-37f2-ae03-908420304523",
                                "text": "„Heute reden wir nicht mehr von Assimilation, sondern von Multikulturalismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd77b0c3-fa37-46e5-90a9-637ebe0c1613",
                        "source_entry_id": "e08fbeb1-5508-32d0-8395-b3d58c4bb204",
                        "source_sense_id": "efa21b7c-fa36-37f2-ae03-908420304523",
                        "source_sense_description": "Situation einer Gesellschaft, deren Gruppen von mehreren sehr unterschiedlichen Kulturen geprägt sind",
                        "target_lang_word": "multiculturalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiculturalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c0cde1e-b135-3600-981d-aedec6df9a0f",
                                        "entry_id": "363d9884-a2f8-3b8a-8217-caa6df2d75f9",
                                        "glosses": [
                                            "The characteristics of an organization, society, city etc. which has many different ethnic or national cultures mingling freely; political or social policies which support or encourage such coexistence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d7cba4-0ccb-4b2c-85eb-66144b584ef5",
                                                "sense_id": "9c0cde1e-b135-3600-981d-aedec6df9a0f",
                                                "text": "Near-synonym: polyculturalism (several or many)"
                                            },
                                            {
                                                "example_id": "02d5c97e-6e3c-4e62-ab5a-ab432f9c6351",
                                                "sense_id": "9c0cde1e-b135-3600-981d-aedec6df9a0f",
                                                "text": "The truth is that diversity, a kind of multiculturalism if we want to call it that, is the norm in any society."
                                            },
                                            {
                                                "example_id": "1726993f-3ad4-4804-8504-88f6df461442",
                                                "sense_id": "9c0cde1e-b135-3600-981d-aedec6df9a0f",
                                                "text": "Something had to replace the threat of communism, and at last a workable substitute is at hand. \"Multiculturalism,\" as the new menace is known, has been denounced in the media recently as the new McCarthyism, the new fundamentalism, even the new totalitarianism – take your choice."
                                            },
                                            {
                                                "example_id": "f18f33c1-8728-426b-aa95-f4120678da45",
                                                "sense_id": "9c0cde1e-b135-3600-981d-aedec6df9a0f",
                                                "text": "Britain has pursued a policy of multiculturalism - allowing people of different cultures to settle without expecting them to integrate into society."
                                            },
                                            {
                                                "example_id": "5750d5c3-4aa6-4937-99ad-6f76cfb6916c",
                                                "sense_id": "9c0cde1e-b135-3600-981d-aedec6df9a0f",
                                                "text": "Earlier this year he said multiculturalism had “failed”, that immigrants needed to “melt” into French society, and that “we do not want ostentatious prayers in the street in France.”"
                                            },
                                            {
                                                "example_id": "354f15d2-449f-4e58-9899-7543bab9bd30",
                                                "sense_id": "9c0cde1e-b135-3600-981d-aedec6df9a0f",
                                                "text": "Career diplomat Conrad Tribble said on Twitter that multiculturalism “is one of our greatest strengths as a country, and I go to that well often as an American diplomat. It’s hard to overstate the global soft power impact of America’s cultural diversity.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6854a391-75dd-37d1-89e5-da659cb9f7bb",
                                        "entry_id": "363d9884-a2f8-3b8a-8217-caa6df2d75f9",
                                        "glosses": [
                                            "The cultural Marxism conspiracy theory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
