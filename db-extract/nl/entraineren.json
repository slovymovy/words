                "translations": [
                    {
                        "translation_id": "f09501c1-ec24-4809-81d0-e6faf4da398b",
                        "source_entry_id": "858de952-6941-3eee-a9d7-131af576c671",
                        "source_sense_id": "314354f0-28e1-3f79-aa89-9a7ad70e9dfe",
                        "target_lang_word": "entrainer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrainer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50725ea5-c5d2-3876-9435-2949b6d37391",
                                        "entry_id": "111b5634-a44a-3304-8c22-aa80daf03633",
                                        "glosses": [
                                            "Trainer avec soi, après soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "432dbeb4-c813-4f99-a165-06d3149cdf19",
                                                "sense_id": "50725ea5-c5d2-3876-9435-2949b6d37391",
                                                "text": "Les torrents entrainent ce qui s’oppose à leur passage."
                                            },
                                            {
                                                "example_id": "6b1fbfe8-deea-4f0d-840d-eeb5e920512d",
                                                "sense_id": "50725ea5-c5d2-3876-9435-2949b6d37391",
                                                "text": "Le dégel est venu tout à coup, et la débâcle a entrainé les bateaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811130f1-5154-3237-bb04-a526d8fbfb80",
                                        "entry_id": "111b5634-a44a-3304-8c22-aa80daf03633",
                                        "glosses": [
                                            "Emmener, conduire avec une sorte de violence."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b027fe09-2b39-415a-bdeb-fda2281c99b5",
                                                "sense_id": "811130f1-5154-3237-bb04-a526d8fbfb80",
                                                "text": "Je le pris par le bras et l’entrainai hors de la chambre."
                                            },
                                            {
                                                "example_id": "f0a4e9f0-a355-4250-987f-391c56165396",
                                                "sense_id": "811130f1-5154-3237-bb04-a526d8fbfb80",
                                                "text": "Il l'entraîne sans la lâcher jusqu'à un recoin où sont entassées des poubelles. Odeur d'ordures, murs en béton gris. Elle baisse son collant jusqu'aux genoux, suce deux doigts et les passe dans sa fente qu'elle écarte généreusement pour qu'il vienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d1047e-9995-3a1e-9c9c-f264521da2d4",
                                        "entry_id": "111b5634-a44a-3304-8c22-aa80daf03633",
                                        "glosses": [
                                            "Porter quelqu’un à quelque chose avec force, et comme malgré lui."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a0bbc6e-4ea9-4516-8907-ecd41d310b6f",
                                                "sense_id": "71d1047e-9995-3a1e-9c9c-f264521da2d4",
                                                "text": "Il a été si éloquent qu’il a entrainé tout le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d4b48a-1c19-311b-8df5-613b5b6d8955",
                                        "entry_id": "111b5634-a44a-3304-8c22-aa80daf03633",
                                        "glosses": [
                                            "Avoir pour effet, pour résultat, pour conséquence nécessaire, inévitable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "note": "Cela se dit surtout en parlant des choses fâcheuses",
                                        "examples": [
                                            {
                                                "example_id": "e3331692-b71e-4c39-abb6-fa059752d223",
                                                "sense_id": "e8d4b48a-1c19-311b-8df5-613b5b6d8955",
                                                "text": "Cette peine entraine, par voie de conséquence, telle autre peine."
                                            },
                                            {
                                                "example_id": "2ff40e7a-fd32-4752-bc11-d83ed8a68339",
                                                "sense_id": "e8d4b48a-1c19-311b-8df5-613b5b6d8955",
                                                "text": "Cet orateur s’est entrainé à la discussion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entrainer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11933c4d-bf8e-3aee-a823-417e76475dcc",
                                        "entry_id": "bc5a89d4-b401-3bd0-baab-8059e60ad000",
                                        "glosses": [
                                            "Préparer un cheval pour la course au moyen de l’entrainement, ou, d’une façon plus générale, préparer une personne à quelque exercice physique ou intellectuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02a85eb-003c-4bd5-a847-976dbaf61ecd",
                                                "sense_id": "11933c4d-bf8e-3aee-a823-417e76475dcc",
                                                "text": "Il s’entraine à la marche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
