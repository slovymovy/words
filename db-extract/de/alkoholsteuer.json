                "senses": [
                    {
                        "sense_id": "08ef1612-04c6-3921-a809-d503c046b8bd",
                        "entry_id": "90309415-659c-34dc-88c6-40e12d29b04b",
                        "glosses": [
                            "Abgabe an den Staat, die auf Alkohol und alkoholhaltige Waren erhoben wird; staatliche Abgabe, die seit 2018 die Branntweinsteuer ersetzt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e2f1de12-0c94-4052-b198-34ffc3103a9b",
                                "sense_id": "08ef1612-04c6-3921-a809-d503c046b8bd",
                                "text": "Neben der Alkoholsteuer gibt es im Jahr 2022 in Deutschland noch weitere Steuern, die auf alkoholhaltige Produkte anfallen: die Schaumweinsteuer, die Biersteuer, die Zwischenerzeugnissteuer und die Alkopopsteuer."
                            },
                            {
                                "example_id": "041e781f-bb75-437c-b0f5-2f43918461be",
                                "sense_id": "08ef1612-04c6-3921-a809-d503c046b8bd",
                                "text": "„Die Psychotherapeuten fordern höhere Alkoholsteuern und einen Mindestpreis für Alkohol.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
