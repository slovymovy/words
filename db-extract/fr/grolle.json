                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3051365-56b6-3d6e-ac3a-eec178120190",
                                        "entry_id": "64f4f59b-00fe-37ea-ae56-834cf492c1dd",
                                        "glosses": [
                                            "hochgewachsener (und eher dünner) Mensch, der eine schlechte Haltung hat und nachlässig/schlaff geht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d3fa26d-c185-49f2-b59d-b3f7e85bb4a5",
                                                "sense_id": "b3051365-56b6-3d6e-ac3a-eec178120190",
                                                "text": "Kind! Jetzt lauf nicht so wie ein Latsch durch die Gegend!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "680aae28-3b8d-34ef-87eb-236cee33245a",
                                        "entry_id": "64f4f59b-00fe-37ea-ae56-834cf492c1dd",
                                        "glosses": [
                                            "dünner Kaffee"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053e4cb1-4403-4a0c-9597-87d3aa265595",
                                                "sense_id": "680aae28-3b8d-34ef-87eb-236cee33245a",
                                                "text": "Ich brauch jetzt was Ordentliches, nicht so einen Latsch!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
