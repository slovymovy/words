                            {
                                "example_id": "3db4ca56-ad25-4907-aad3-a965f1bb3870",
                                "sense_id": "f463a9ae-1e97-3ab9-8002-4dae5f1f4e04",
                                "text": "Les « é », enfin, en France, ils ont l’accent aigu, l’accent grave, l’accent circonflexe, nous z’autes : que l’accent pataouète ensoleillé"
                            },
                            {
                                "example_id": "427f7169-a322-4034-b752-8f2370c39df7",
                                "sense_id": "f463a9ae-1e97-3ab9-8002-4dae5f1f4e04",
                                "text": "Elle ne chercha pas à masquer son accent et, si elle soigna son langage en évitant l’usage d’expressions pataouètes, elle n’accepta jamais de paraître différente de ce qu’elle était au fond d’elle-même : une jeune fille libre et directe […]."
                            }
                        ]
                    }
