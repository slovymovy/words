                "senses": [
                    {
                        "sense_id": "5871bb4d-5338-3234-937b-1824d97a2950",
                        "entry_id": "96773d99-5124-3564-b7b3-e0200c2f33bb",
                        "glosses": [
                            "Dans les chemins de fer, celui qui groupe les petits colis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df5676f-e878-490b-879b-6cec5ea3e2b3",
                                "sense_id": "5871bb4d-5338-3234-937b-1824d97a2950",
                                "text": "Il s'est fondé, à côté des compagnies de chemins de fer, une industrie particulière, celle des groupeurs ; ces groupeurs font le wagon plein ; ils réunissent les colis et ils perçoivent sur ce groupement des bénéfices qui se chiffrent par millions et qui viennent en accroissement des charges du transport dans une proportion considérable."
                            }
                        ]
                    },
                    {
                        "sense_id": "f60375dc-7be7-37af-a330-c7f0209f5868",
                        "entry_id": "96773d99-5124-3564-b7b3-e0200c2f33bb",
                        "glosses": [
                            "Transporteur ou commissionnaire de transport qui regroupe des colis de divers personnes ou entreprises, pour les faire voyager ensemble et obtenir un coût moindre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c44b4bad-10f0-4f5c-934d-0c4b1bdddda4",
                                "sense_id": "f60375dc-7be7-37af-a330-c7f0209f5868",
                                "text": "Il existe des groupeurs de fret maritime, aérien, terrestre,..."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e34b7e5-445b-315c-abfc-7b52e8b0c934",
                        "entry_id": "96773d99-5124-3564-b7b3-e0200c2f33bb",
                        "glosses": [
                            "Engin agricole qui regroupe les bottes ou les balles de foin ou de paille pour les mettre en tas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "060e206e-ad3e-4019-ba71-6088fcba3dd4",
                                "sense_id": "7e34b7e5-445b-315c-abfc-7b52e8b0c934",
                                "text": "Chez moi, au temps ou ont faisaient encore des petits ballots, papa avait fabriqué un gros groupeur derrière la presse on y mettait 100 ballots déjà pas mal ensuite quand le groupeur était rempli on venait avec un plateau à cage juste à coté du groupeur, alors là la cage du groupeur se soulevait et vidait les ballots en vrac dans la cage, on avait 3 plateaux équipés comme ça pour suivre la presse."
                            }
                        ]
                    }
