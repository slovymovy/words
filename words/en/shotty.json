{
    "word_family": [
        "shotgun",
        "shot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73483265-033c-3dc1-bd50-ec905a0b80f0",
                    "sense_definition": "A slang term for a shotgun.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "firearms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept a <w>shotty</w> under the seat of his truck for protection.",
                            "target_lang_translations": {
                                "ru": "Для защиты он держал под сиденьем своего грузовика <w>дробаш</w>."
                            }
                        },
                        {
                            "text": "The action movie featured a scene with a double-barrel <w>shotty</w>.",
                            "target_lang_translations": {
                                "ru": "В боевике была сцена с двухствольным <w>дробашом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shotgun",
                        "scattergun"
                    ],
                    "common_phrases": [
                        "double barrel shotty",
                        "sawed-off shotty"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for a firearm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название дробовика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробаш",
                                "target_lang_sense_clarification": "сленг для дробовика"
                            },
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "общее сленговое название оружия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca86ad0f-79cc-3e9b-abcf-b5fd18f1dddb",
                    "sense_definition": "A type of pipe used for smoking cannabis, typically without a gauze filter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smoking_apparatus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They passed around a <w>shotty</w> made from a plastic bottle and a small tube.",
                            "target_lang_translations": {
                                "ru": "Они пустили по кругу <w>бульбулятор</w>, сделанный из пластиковой бутылки и маленькой трубки."
                            }
                        },
                        {
                            "text": "Using a <w>shotty</w> is a common but harsh way to smoke.",
                            "target_lang_translations": {
                                "ru": "Использование <w>трубки</w> — распространенный, но жесткий способ курения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit a shotty"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип самодельного приспособления для курения каннабиса, обычно без сетчатого фильтра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бульбулятор",
                                "target_lang_sense_clarification": "самодельное устройство для курения"
                            },
                            {
                                "target_lang_word": "трубка",
                                "target_lang_sense_clarification": "в контексте курения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8501223-056b-3c5a-abf5-14b9dc01211a",
                    "sense_definition": "A collective term for buckshot or small pellets used in shotgun shells.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ammunition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wall was peppered with <w>shotty</w> after the accidental discharge.",
                            "target_lang_translations": {
                                "ru": "После случайного выстрела стена была усыпана <w>дробью</w>."
                            }
                        },
                        {
                            "text": "He loaded the shells with heavy <w>shotty</w> for the hunt.",
                            "target_lang_translations": {
                                "ru": "Для охоты он снарядил патроны крупной <w>картечью</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "buckshot",
                        "pellets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательный термин для крупной дроби или мелких шариков, используемых в патронах для дробовика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробь",
                                "target_lang_sense_clarification": "мелкие свинцовые шарики"
                            },
                            {
                                "target_lang_word": "картечь",
                                "target_lang_sense_clarification": "крупная дробь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7c1daa0-d19e-3b2b-8820-a1f9346de3ce",
                    "sense_definition": "To claim or reserve something as one's own, typically by being the first to shout the word.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "claiming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>shottied</w> the front seat before anyone else could get to the car.",
                            "target_lang_translations": {
                                "ru": "Я <w>забил</w> переднее сиденье раньше, чем кто-либо другой успел подойти к машине."
                            }
                        },
                        {
                            "text": "You can't sit there because I <w>shottied</w> the sofa earlier.",
                            "target_lang_translations": {
                                "ru": "Ты не можешь там сидеть, потому что я <w>застолбил</w> диван раньше."
                            }
                        }
                    ],
                    "synonyms": [
                        "claim",
                        "bagsy"
                    ],
                    "common_phrases": [
                        "shotty the front seat",
                        "shotty the remote"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common among children and young adults"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять или зарезервировать что-либо за собой, обычно первым выкрикнув это слово."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забить",
                                "target_lang_sense_clarification": "зарезервировать за собой"
                            },
                            {
                                "target_lang_word": "застолбить",
                                "target_lang_sense_clarification": "утвердить свое право на что-то"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b4520e52-a1cd-32c4-8c4d-5b8850ac7c1d",
                    "sense_definition": "An exclamation used to claim a right or a specific object, such as the front seat of a car.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "claiming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Shotty</w>! I'm sitting next to the window on this flight.",
                            "target_lang_translations": {
                                "ru": "<w>Чур, я</w> сижу у окна на этом рейсе!"
                            }
                        },
                        {
                            "text": "When the pizza arrived, he yelled <w>shotty</w> for the last slice.",
                            "target_lang_translations": {
                                "ru": "Когда привезли пиццу, он крикнул «<w>забил</w>» на последний кусок."
                            }
                        }
                    ],
                    "synonyms": [
                        "shotgun",
                        "bagsy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to establish priority"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для заявления своих прав на что-либо, например, на переднее сиденье в машине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чур, я",
                                "target_lang_sense_clarification": "восклицание для заявления прав"
                            },
                            {
                                "target_lang_word": "забил",
                                "target_lang_sense_clarification": "я первый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f753b5d4-9df5-340c-8e3a-fd23f29599b1",
                    "sense_definition": "Describing small, hard, inflamed lymph nodes that feel like pellets under the skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted several <w>shotty</w> nodes during the physical examination.",
                            "target_lang_translations": {
                                "ru": "Во время осмотра врач отметил несколько <w>дробовидных</w> узлов."
                            }
                        },
                        {
                            "text": "Small <w>shotty</w> lymph nodes are often found in healthy children after a viral infection.",
                            "target_lang_translations": {
                                "ru": "Маленькие <w>дробовидные</w> лимфоузлы часто встречаются у здоровых детей после вирусной инфекции."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflamed",
                        "pellet-like"
                    ],
                    "common_phrases": [
                        "shotty lymph nodes",
                        "shotty adenopathy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание маленьких, твердых, воспаленных лимфатических узлов, которые ощущаются как дробинки под кожей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробовидный",
                                "target_lang_sense_clarification": "о лимфоузлах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}