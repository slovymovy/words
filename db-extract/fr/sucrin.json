                    {
                        "sense_id": "0af73b2c-0185-3168-a526-2c32c468432d",
                        "entry_id": "a0d55ca8-537c-3370-8f4e-2e8d4fb62e62",
                        "glosses": [
                            "Qui a un goût de sucre ; il ne se dit qu’en parlant des melons."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e002ef11-96df-4e72-9ca2-427e62799359",
                                "sense_id": "0af73b2c-0185-3168-a526-2c32c468432d",
                                "text": "Pour amasser des biens avare je serai,\nPour devenir plus grand mon cœur j'abaisserai,\nBref, ô melon succrin, pour t'accabler de gloire,\nDes faveurs de Margot je perdrai la mémoire."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3325e78c-471f-34e8-87af-e0a96f27b8c7",
                "word": "sucrin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "282ff593-eaa9-4090-b504-affc86367943",
                        "entry_id": "3325e78c-471f-34e8-87af-e0a96f27b8c7",
                        "tags": [
