                    {
                        "sense_id": "c8f52a2c-9bb1-390c-9c62-50e4fc0c7251",
                        "entry_id": "a22d3ed1-f380-3bb3-9cc1-1b8a13cff402",
                        "glosses": [
                            "Dans les pays du Maghreb, réception faite à des hôtes et marquée par un grand repas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f0db95-93b8-42c1-a1ac-f079774b7fe6",
                                "sense_id": "c8f52a2c-9bb1-390c-9c62-50e4fc0c7251",
                                "text": "Vous vous êtes annoncé chez nous comme un simple pèlerin, et nous vous avons offert la diffa."
                            },
                            {
                                "example_id": "b27b3e4f-11f3-427d-9e76-b6853f53c0cb",
                                "sense_id": "c8f52a2c-9bb1-390c-9c62-50e4fc0c7251",
                                "text": "Ce fut pour la tribu l’occasion de diffas et de fantasias interminables. Toute la nuit, les tambourins, les flûtes de roseau retentirent."
                            },
                            {
                                "example_id": "0f18a88b-1e99-4884-8ae2-506be034f3a9",
                                "sense_id": "c8f52a2c-9bb1-390c-9c62-50e4fc0c7251",
                                "text": "Voici le menu fondamental d'une diffa d'après le cérémonial le plus rigoureux."
                            },
                            {
                                "example_id": "368720dc-f76a-4e48-a61e-0dcb4a026a3a",
                                "sense_id": "c8f52a2c-9bb1-390c-9c62-50e4fc0c7251",
                                "text": "Nous étions reçus chez les résidents et les gouverneurs, parfois chez les pachas à diffas."
                            }
                        ]
                    }
                ],
