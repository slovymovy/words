                "forms": [
                    {
                        "form_id": "5ea4ac53-e565-433b-a4e6-497a4399a4c0",
                        "entry_id": "b8f916c3-bb39-393c-bdb9-c692a076d6ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "fordismes"
