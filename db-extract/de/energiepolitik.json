                        "form": "die Energiepolitik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "684c264c-b97d-3bb3-9f51-586e939f2498",
                        "entry_id": "29006ada-9bee-3ad4-bf51-ddbb91bb92ec",
                        "glosses": [
                            "Bereich der Politik, der sich um die Versorgung mit Energie kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "259a76d4-0461-4a90-8dff-9943e5257f20",
                                "sense_id": "684c264c-b97d-3bb3-9f51-586e939f2498",
                                "text": "„Zusammen mit Matthias Kleiner, dem Präsidenten der Deutschen Forschungsgemeinschaft, und rund einem Dutzend weiterer Mitglieder soll er auf den kokelnden Ruinen der schwarzgelben Energiepolitik etwas Neues aufbauen.“"
                            },
                            {
                                "example_id": "d474154e-5ded-455d-bb74-a65fe68d5736",
                                "sense_id": "684c264c-b97d-3bb3-9f51-586e939f2498",
                                "text": "„Für eine grüne Energiepolitik in NRW bleibt natürlich noch viel zu tun.“"
                            },
                            {
                                "example_id": "b11d080a-3274-4475-8cb0-f8836d2d3544",
                                "sense_id": "684c264c-b97d-3bb3-9f51-586e939f2498",
                                "text": "„Charismatisch war sie nie, aber bislang galt sie als kompetente Technokratin und Expertin für Energiepolitik.“"
                            },
                            {
                                "example_id": "c5e0c9e3-ea80-4589-aa76-53cdae27e0f2",
                                "sense_id": "684c264c-b97d-3bb3-9f51-586e939f2498",
                                "text": "„Dazu gehört der Versuch, durch Mülltrennung und Energiepolitik den Planeten zu retten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
