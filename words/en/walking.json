{
    "word_family": [
        "walk",
        "walker",
        "walkway",
        "sidewalk",
        "crosswalk",
        "boardwalk",
        "catwalk",
        "sleepwalk",
        "jaywalk",
        "outwalk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07a29917-0d8e-31ee-afb0-048b8d802ae3",
                    "sense_definition": "Present participle of <w>walk</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>walking</w> to the bus stop right now.",
                            "target_lang_translations": {
                                "ru": "Она <w>идёт</w> на автобусную остановку прямо сейчас.",
                                "zh": "她现在正<w>走</w>去公交车站。"
                            }
                        },
                        {
                            "text": "We were <w>walking</w> along the beach when it started to rain.",
                            "target_lang_translations": {
                                "ru": "Мы <w>гуляли</w> по пляжу, когда начался дождь.",
                                "zh": "我们正沿着海滩<w>散步</w>时，天开始下雨了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола walk (идти, гулять).",
                        "zh": "动词 walk 的现在分词形式，表示正在进行行走或散步的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идущий",
                                "target_lang_sense_clarification": "причастие: перемещающийся пешком"
                            },
                            {
                                "target_lang_word": "гуляющий",
                                "target_lang_sense_clarification": "причастие: совершающий прогулку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走",
                                "target_lang_sense_clarification": "表示正在行走"
                            },
                            {
                                "target_lang_word": "散步",
                                "target_lang_sense_clarification": "表示正在散步"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9668418-5db3-3f4f-957e-a86979eda04e",
                    "sense_definition": "The activity or action of moving on foot at a regular pace for exercise or pleasure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Walking</w> is excellent exercise for people of all ages.",
                            "target_lang_translations": {
                                "ru": "<w>Ходьба</w> — отличное упражнение для людей всех возрастов.",
                                "zh": "<w>步行</w>对各个年龄段的人来说都是极好的锻炼。"
                            }
                        },
                        {
                            "text": "The hotel is within <w>walking</w> distance of the city center.",
                            "target_lang_translations": {
                                "ru": "Отель находится в пределах <w>пешей</w> доступности от центра города.",
                                "zh": "酒店距离市中心在<w>步行</w>可达的范围内。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strolling",
                        "hiking"
                    ],
                    "antonyms": [
                        "running"
                    ],
                    "common_phrases": [
                        "go walking",
                        "walking distance",
                        "keep walking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс перемещения пешком в обычном темпе ради упражнения или удовольствия.",
                        "zh": "为了锻炼或娱乐而以正常速度步行进行的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходьба",
                                "target_lang_sense_clarification": "процесс перемещения пешком"
                            },
                            {
                                "target_lang_word": "прогулка",
                                "target_lang_sense_clarification": "хождение ради удовольствия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "步行",
                                "target_lang_sense_clarification": "指代行走这一活动"
                            },
                            {
                                "target_lang_word": "散步",
                                "target_lang_sense_clarification": "指代休闲的行走"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb03a413-b163-3764-bd32-10382e162751",
                    "sense_definition": "Relating to, designed for, or used during the activity of walking.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure you wear comfortable <w>walking</w> shoes for the hike.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что надели удобную обувь <w>для ходьбы</w> для похода.",
                                "zh": "去徒步时一定要穿舒适的<w>步行</w>鞋。"
                            }
                        },
                        {
                            "text": "We signed up for a historical <w>walking</w> tour of the old town.",
                            "target_lang_translations": {
                                "ru": "Мы записались на историческую <w>пешеходную</w> экскурсию по старому городу.",
                                "zh": "我们报名参加了老城的历史<w>徒步</w>游。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pedestrian"
                    ],
                    "common_phrases": [
                        "walking tour",
                        "walking shoes",
                        "walking stick",
                        "walking boots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к ходьбе, предназначенный для неё или используемый во время неё.",
                        "zh": "与步行活动相关、为步行设计或在步行时使用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пешеходный",
                                "target_lang_sense_clarification": "предназначенный для пешеходов (о турах, маршрутах)"
                            },
                            {
                                "target_lang_word": "для ходьбы",
                                "target_lang_sense_clarification": "предназначенный для использования при ходьбе (об обуви, снаряжении)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "步行",
                                "target_lang_sense_clarification": "用于修饰与步行相关的名词"
                            },
                            {
                                "target_lang_word": "徒步",
                                "target_lang_sense_clarification": "指代徒步旅行或相关装备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fbb4267-fac2-31f1-bb89-e4535a0ae11d",
                    "sense_definition": "Used to describe a person who embodies a particular quality or characteristic to an extreme degree, as if they were a living version of it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather is a <w>walking</w> dictionary of local history.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка — <w>ходячая</w> энциклопедия местной истории.",
                                "zh": "我祖父是当地历史的<w>活</w>字典。"
                            }
                        },
                        {
                            "text": "After surviving that terrible accident, he is considered a <w>walking</w> miracle.",
                            "target_lang_translations": {
                                "ru": "После того как он выжил в той ужасной аварии, его считают <w>живым</w> чудом.",
                                "zh": "在那场可怕的事故中幸存下来后，他被视为一个<w>活</w>奇迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "living",
                        "personified",
                        "incarnate"
                    ],
                    "common_phrases": [
                        "walking dictionary",
                        "walking disaster",
                        "walking contradiction",
                        "walking miracle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания человека, который воплощает в себе определённое качество в крайней степени, словно он его живая версия.",
                        "zh": "形容某人极其具备某种特质，仿佛该特质的活体化身。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходячий",
                                "target_lang_sense_clarification": "перен.: являющийся воплощением какого-либо качества"
                            },
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "воплощенный, настоящий (в метафорах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活的",
                                "target_lang_sense_clarification": "比喻某人是某种事物的化身"
                            },
                            {
                                "target_lang_word": "行走的",
                                "target_lang_sense_clarification": "形容某人是某种知识或特质的集合体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e09dd5cd-46e1-38fe-ab81-395f2942e346",
                    "sense_definition": "Able to walk around and not confined to a bed, despite having an injury or illness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital set up a separate area to treat the <w>walking</w> wounded.",
                            "target_lang_translations": {
                                "ru": "Больница выделила отдельную зону для лечения <w>ходячих</w> раненых.",
                                "zh": "医院设立了一个单独的区域来治疗那些<w>能走动</w>的伤员。"
                            }
                        },
                        {
                            "text": "She went to work every day despite suffering from <w>walking</w> pneumonia.",
                            "target_lang_translations": {
                                "ru": "Она ходила на работу каждый день, несмотря на пневмонию, переносимую <w>на ногах</w>.",
                                "zh": "尽管患有<w>轻症</w>肺炎，她还是每天坚持去上班。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ambulatory"
                    ],
                    "antonyms": [
                        "bedridden"
                    ],
                    "common_phrases": [
                        "walking wounded",
                        "walking pneumonia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный передвигаться самостоятельно, не прикованный к постели, несмотря на травму или болезнь.",
                        "zh": "指尽管有伤病但仍能走动，无需卧床。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходячий",
                                "target_lang_sense_clarification": "способный ходить, не лежачий (о больном)"
                            },
                            {
                                "target_lang_word": "на ногах",
                                "target_lang_sense_clarification": "переносящий болезнь без постельного режима"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "能走动的",
                                "target_lang_sense_clarification": "指非卧床的病人"
                            },
                            {
                                "target_lang_word": "带病坚持",
                                "target_lang_sense_clarification": "指在患病期间仍能正常活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ee23855-2d63-3086-ac7a-eb8072c7a8de",
                    "sense_definition": "Describing a bass accompaniment in jazz or blues that moves in a steady, regular rhythm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jazz bassist played a smooth <w>walking</w> bass line throughout the song.",
                            "target_lang_translations": {
                                "ru": "Джазовый басист играл плавный <w>шагающий</w> бас на протяжении всей песни.",
                                "zh": "爵士贝斯手在整首歌中演奏了流畅的<w>行走低音</w>线条。"
                            }
                        },
                        {
                            "text": "This track features a classic <w>walking</w> rhythm that drives the music forward.",
                            "target_lang_translations": {
                                "ru": "В этом треке звучит классический <w>шагающий</w> ритм, который движет музыку вперёд.",
                                "zh": "这首曲子采用了经典的<w>行走</w>节奏，推动着音乐向前发展。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "walking bass",
                        "walking bassline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает басовый аккомпанемент в джазе или блюзе, движущийся в ровном, регулярном ритме.",
                        "zh": "描述爵士乐或蓝调中以平稳、规律节奏进行的低音伴奏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шагающий",
                                "target_lang_sense_clarification": "муз.: о басовой линии (walking bass)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行走低音",
                                "target_lang_sense_clarification": "音乐术语，指爵士乐中的低音线条"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}