                "senses": [
                    {
                        "sense_id": "db737c5d-df25-323e-940e-cf06f58495e8",
                        "entry_id": "62c969ce-831e-38a4-bceb-baf27d0c300f",
                        "glosses": [
                            "Arbeitsmaschine; angetriebene Maschine, die Energie aufnimmt und diese einem Medium als Arbeit zuführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb646044-1805-44af-8775-631d1ada84b4",
                                "sense_id": "db737c5d-df25-323e-940e-cf06f58495e8",
                                "text": "„Die Gasturbine und damit der Verdichter werden sowohl im Flugtriebwerk als auch bei der stationären Energieversorgung noch lange eine bedeutende Rolle spielen.“"
                            },
                            {
                                "example_id": "4867e9d9-96d4-42d6-ad43-4bcb874d1b7e",
                                "sense_id": "db737c5d-df25-323e-940e-cf06f58495e8",
                                "text": "„Wir unterstützen Sie als Betreiber eines solchen Verdichters Ihre Anlage in einem leistungsorientierten Umfeld weiter profitabel zu betreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f0a738cf-7129-33c6-9d26-fa3193e12355",
                        "entry_id": "62c969ce-831e-38a4-bceb-baf27d0c300f",
                        "glosses": [
                            "Arbeitsmaschine; angetriebene Maschine, die Energie aufnimmt und diese einem Medium als Arbeit zuführt",
                            "Axialverdichter"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "27e65003-7d7a-34c9-9df7-e2ce3cd966df",
                        "entry_id": "62c969ce-831e-38a4-bceb-baf27d0c300f",
                        "glosses": [
