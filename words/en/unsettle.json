{
    "word_family": [
        "settle",
        "unsettled",
        "unsettling",
        "settlement",
        "settler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e4cf062-aa2b-3eb4-a501-b6c2e764feaa",
                    "sense_definition": "To make someone feel anxious, nervous, or uncomfortable",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in his behavior began to <w>unsettle</w> the entire team during the meeting.",
                            "target_lang_translations": {
                                "ru": "Внезапная перемена в его поведении начала <w>тревожить</w> всю команду во время собрания."
                            }
                        },
                        {
                            "text": "The strange noises coming from the attic were enough to <w>unsettle</w> the guests.",
                            "target_lang_translations": {
                                "ru": "Странных звуков, доносившихся с чердака, было достаточно, чтобы <w>обеспокоить</w> гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "disturb",
                        "perturb",
                        "agitate",
                        "disconcert",
                        "upset"
                    ],
                    "antonyms": [
                        "comfort",
                        "relieve",
                        "settle"
                    ],
                    "common_phrases": [
                        "unsettle the mind",
                        "deeply unsettle someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо чувствовать тревогу, нервозность или дискомфорт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбивать из колеи",
                                "target_lang_sense_clarification": "лишать душевного равновесия"
                            },
                            {
                                "target_lang_word": "тревожить",
                                "target_lang_sense_clarification": "вызывать беспокойство"
                            },
                            {
                                "target_lang_word": "обеспокоить",
                                "target_lang_sense_clarification": "нарушить спокойствие"
                            },
                            {
                                "target_lang_word": "смущать",
                                "target_lang_sense_clarification": "приводить в замешательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "363eca8d-ac5b-3113-a307-46b343d4c80b",
                    "sense_definition": "To bring something into a state of disorder or to disrupt a stable situation",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new economic policy might <w>unsettle</w> the markets and lead to a period of instability.",
                            "target_lang_translations": {
                                "ru": "Новая экономическая политика может <w>дестабилизировать</w> рынки и привести к периоду нестабильности."
                            }
                        },
                        {
                            "text": "Be careful not to <w>unsettle</w> the horses or they might bolt from the stable.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, не <w>всполошите</w> лошадей, иначе они могут вырваться из конюшни."
                            }
                        }
                    ],
                    "synonyms": [
                        "disarrange",
                        "displace",
                        "derange"
                    ],
                    "antonyms": [
                        "order",
                        "array",
                        "settle"
                    ],
                    "common_phrases": [
                        "unsettle the balance",
                        "unsettle the status quo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести что-либо в состояние беспорядка или нарушить стабильную ситуацию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дестабилизировать",
                                "target_lang_sense_clarification": "нарушать стабильность"
                            },
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "нарушать порядок или планы"
                            },
                            {
                                "target_lang_word": "всполошить",
                                "target_lang_sense_clarification": "напугать или привести в движение животных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}