                "senses": [
                    {
                        "sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                        "entry_id": "e5afff22-7d38-3e53-9c93-32e1c65bc672",
                        "glosses": [
                            "vor kurzer Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e96aae8a-9c7b-4dc5-a5d4-2b95d3093337",
                                "sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                                "text": "Ich habe vorhin gerade erst eine Suppe gegessen, danke, ich habe jetzt keinen Appetit mehr."
                            },
                            {
                                "example_id": "10befc72-63c8-4e50-9738-e6cd57923a70",
                                "sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                                "text": "Aber ich habe sie doch gerade noch vorhin gesehen!"
                            },
                            {
                                "example_id": "43efb91b-f62e-4102-a721-51e065d6fd8f",
                                "sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                                "text": "Das hättest du aber nun auch vorhin schon sagen können."
                            },
                            {
                                "example_id": "5117df5f-13ab-4154-b5a7-7203c96d049d",
                                "sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                                "text": "Die Frau, die du da vorhin gesehen hast, ist wirklich nicht meine Mutter!"
                            },
                            {
                                "example_id": "d474a3c4-4726-4f49-b264-27beb0f3ccd3",
                                "sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                                "text": "Aber vorhin haben Sie gesagt, dass wir das noch diskutieren können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1cc1353-e805-423f-85da-0c2ac88e67e3",
                        "source_entry_id": "e5afff22-7d38-3e53-9c93-32e1c65bc672",
                        "source_sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                        "source_sense_description": "vor kurzer Zeit",
                        "target_lang_word": "recently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                        "entry_id": "6dc644cb-40c6-3768-b4b0-4d2d16a3e0f4",
                                        "glosses": [
                                            "In the recent past",
                                            "a short while ago."
                                        ],
                                        "tags": [
                                            "referring to a point of time in the recent past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "515f07a8-283b-4b94-bdc6-1c4700bb0273",
                                                "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                                "text": "My recently published book about the life stories of recently-arrived immigrants."
                                            },
                                            {
                                                "example_id": "188f866c-98c0-4b11-9b40-c017c7b5a24d",
                                                "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                        "entry_id": "6dc644cb-40c6-3768-b4b0-4d2d16a3e0f4",
                                        "glosses": [
                                            "In the recent past",
                                            "in recent times."
                                        ],
                                        "tags": [
                                            "referring to a time period starting in the recent past and including the present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb89aeae-89fd-40f0-a7ba-2c4f97ff8b80",
                                                "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                                "text": "I haven't been sleeping well recently."
                                            },
                                            {
                                                "example_id": "4f3a357a-b53a-45ca-a057-21e157f6043c",
                                                "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b71e68c-56f7-44cf-82e5-72492be0b234",
                        "source_entry_id": "e5afff22-7d38-3e53-9c93-32e1c65bc672",
                        "source_sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                        "source_sense_description": "vor kurzer Zeit",
                        "target_lang_word": "a little while ago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7351f7ee-e875-464d-ab1e-6e0c9da33f5a",
                        "source_entry_id": "e5afff22-7d38-3e53-9c93-32e1c65bc672",
                        "source_sense_id": "d8cb13a9-47c1-3347-8b6b-8942d196f1ec",
                        "source_sense_description": "vor kurzer Zeit",
                        "target_lang_word": "tout à l’heure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout à l’heure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9fbf75a-ad4b-341e-aef4-c6f54a83d4fc",
                                        "entry_id": "a2063deb-318c-3ffc-b4dd-2c2d7d1316c3",
                                        "glosses": [
                                            "Il y a quelques minutes ou quelques heures."
                                        ],
                                        "tags": [
                                            "Dans le passé"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb78dc23-499d-4864-b8ae-43ffb10a4dc0",
                                                "sense_id": "c9fbf75a-ad4b-341e-aef4-c6f54a83d4fc",
                                                "text": "Tout à l'heure, […], j'ai vu un corsage de velours noir se pencher à demi au-dessus d'une fenêtre et de grands yeux noirs jeter un éclair."
                                            },
                                            {
                                                "example_id": "2c54e3a5-45ca-4a87-9a96-d8d78bf45b95",
                                                "sense_id": "c9fbf75a-ad4b-341e-aef4-c6f54a83d4fc",
                                                "text": "— Mais, demanda Scaër, vous sembliez craindre tout à l’heure qu'on espionnât ce brave garçon... Pourquoi ?"
                                            },
                                            {
                                                "example_id": "5e26e4cf-036c-46bd-9ee5-068e92e9b89c",
                                                "sense_id": "c9fbf75a-ad4b-341e-aef4-c6f54a83d4fc",
                                                "text": "Et, tout à l'heure, quand il s'était adressé à la prostituée enceinte, il avait usé d'un terme dont la grossièreté […] me choquait encore secrètement."
                                            },
                                            {
                                                "example_id": "6dd9d7ac-134d-469b-95e2-7ab8c3a8e30c",
                                                "sense_id": "c9fbf75a-ad4b-341e-aef4-c6f54a83d4fc",
                                                "text": "Tout à l’heure, j'ai pu mettre mon faux col que j'avais enlevé quelques minutes avant le départ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f662a12c-0e87-3711-a144-8d277c36fef8",
                                        "entry_id": "a2063deb-318c-3ffc-b4dd-2c2d7d1316c3",
                                        "glosses": [
                                            "Dans quelques minutes ou dans quelques heures."
                                        ],
                                        "tags": [
                                            "Dans le futur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfb9964-f3e7-4222-a061-2e54d8eeaa0f",
                                                "sense_id": "f662a12c-0e87-3711-a144-8d277c36fef8",
                                                "text": "Tout à l'heure j'irai déjeûner à notre restaurant habituel où Paul est gérant."
                                            },
                                            {
                                                "example_id": "1d9abe93-df00-4d27-ae3a-c6ce6fcbcc8a",
                                                "sense_id": "f662a12c-0e87-3711-a144-8d277c36fef8",
                                                "text": "La jolie jeune fille, elle me dira tout à l'heure si elle est mariée ou non , elle nous dira ça, peut-être... ou peut-être non... tout à l'heure, hein ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4fe3d8c-d8c7-33bd-a366-6922f806241c",
                                        "entry_id": "a2063deb-318c-3ffc-b4dd-2c2d7d1316c3",
                                        "glosses": [
                                            "Immédiatement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ce006a4-deee-40fb-96c2-06db221bc331",
                                                "sense_id": "e4fe3d8c-d8c7-33bd-a366-6922f806241c",
                                                "text": "La raison du plus fort est toujours la meilleure :\nNous l’allons montrer tout à l’heure."
                                            },
                                            {
                                                "example_id": "8b5334ae-18dd-4ec8-82e7-8c0b594fcc68",
                                                "sense_id": "e4fe3d8c-d8c7-33bd-a366-6922f806241c",
                                                "text": "Je dis que je veux avoir de l’argent tout à l’heure."
                                            },
                                            {
                                                "example_id": "efa7d93d-1a54-49b2-8f97-4c9b917a50c0",
                                                "sense_id": "e4fe3d8c-d8c7-33bd-a366-6922f806241c",
                                                "text": "C'en est fait. Vous voulez que je parte demain;\nEt moi, j'ai résolu de partir tout à l’heure;\nEt je pars. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0fec09f-eb87-362f-a2a7-e63cdc10e381",
                                        "entry_id": "a2063deb-318c-3ffc-b4dd-2c2d7d1316c3",
                                        "glosses": [
                                            "Très bientôt ; dans très peu de temps, avec une idée d'imminence."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f6256af-f360-45b4-ba2e-100252fefac0",
                                                "sense_id": "b0fec09f-eb87-362f-a2a7-e63cdc10e381",
                                                "text": "Il est tout-à-l'heure minuit, sans que cela paraisse, et les nuits ne sont pas chaudes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
