                            {
                                "example_id": "d8051a4f-78ee-4b24-85ba-5a9083dde460",
                                "sense_id": "81ecea1f-79e8-3b8e-b743-6c2315a27363",
                                "text": "De Amerikaanse talkshowpresentator Jay Leno is in de laatste uitzending van zijn Tonight Show uitgezwaaid door een keur aan bekende mensen. Onder anderen Oprah Winfrey, Jack Black en Kim Kardashian kwamen langs. Van president Obama was er een opgenomen afscheidsgroet."
                            },
                            {
                                "example_id": "a4e20dac-6724-470a-b9f5-f9b386f306a0",
                                "sense_id": "81ecea1f-79e8-3b8e-b743-6c2315a27363",
                                "text": "Op dit jaarlijkse evenement doen journalisten en politici even net of ze de beste vrienden zijn. Talkshowpresentator Conan O'Brien was ditmaal de gastpresentator."
                            }
                        ]
                    }
