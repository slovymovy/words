                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f167d01e-c682-3533-ba90-e1bff89864eb",
                        "entry_id": "78938a18-f2ba-322e-9030-c75132ba6834",
                        "glosses": [
                            "depressive Stimmung, Katzenjammer, Depristimmung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6edc80e8-a9d0-3b18-bd0f-041c24f7d4f1",
                        "entry_id": "78938a18-f2ba-322e-9030-c75132ba6834",
                        "glosses": [
                            "Flaute"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08044cf9-6573-4b5c-82fc-0f9a67eeb68d",
                        "source_entry_id": "78938a18-f2ba-322e-9030-c75132ba6834",
                        "source_sense_id": "f167d01e-c682-3533-ba90-e1bff89864eb",
                        "source_sense_description": "umgangssprachlich: depressive Stimmung, Katzenjammer, Depristimmung",
                        "target_lang_word": "Katzenjammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katzenjammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90ed2ce4-58ff-3d29-9998-36dbe54a4e42",
                                        "entry_id": "fdbe042a-ad58-3fff-9997-010901dc3b88",
                                        "glosses": [
                                            "unangenehme körperliche Symptome nach einem Rausch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f66b8dc-649c-42c3-bc78-7c60dd6dd372",
                                                "sense_id": "90ed2ce4-58ff-3d29-9998-36dbe54a4e42",
                                                "text": "„Ich torkelte nach Hause. Am nächsten Tag stand ich mit einem fürchterlichen Katzenjammer auf.“"
                                            },
                                            {
                                                "example_id": "b11d2ebe-8d4c-4f80-ae45-99025feb1b10",
                                                "sense_id": "90ed2ce4-58ff-3d29-9998-36dbe54a4e42",
                                                "text": "„Rollmöpse oder Salzheringe nützen auch vor dem Katzenjammer, weil sie reichlich Mineralstoffe enthalten.“"
                                            },
                                            {
                                                "example_id": "0d6be3ba-9414-49dd-aa02-aacfb849d58f",
                                                "sense_id": "90ed2ce4-58ff-3d29-9998-36dbe54a4e42",
                                                "text": "„Wenn die Leute Crystal schnupfen oder rauchen, haben sie eine so große Mengen Methamphetamin im Gehirn, dass sie dieses Glücksgefühl nie wieder vergessen. Danach kommt aber schnell der Katzenjammer. Und gerade dieser Kontrast ist besonders stark.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                        "entry_id": "fdbe042a-ad58-3fff-9997-010901dc3b88",
                                        "glosses": [
                                            "schlechte, niedergedrückte Stimmung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a36a5f53-d30b-41dc-b760-658547ba3efd",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„Melancholie und zeitweiliger Katzenjammer bleiben keinem Sterblichen aus.“"
                                            },
                                            {
                                                "example_id": "2680674d-7821-4a80-9035-7e02255f86bb",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„Sollte es Obama gelingen, nicht nur die Automobilindustrie, sondern auch den Gesundheitssektor zum Leben zu erwecken, würde er nicht nur als guter, sondern als großer Präsident in die Geschichte eingehen. Sollte er scheitern, würde Amerika von einem großen Katzenjammer erfasst werden.“"
                                            },
                                            {
                                                "example_id": "c357c6e4-e08e-4d41-9037-a313f9603545",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„Der rauschhafte Jubel über den eigenen Staat [Katalonien] könnte schnell in Katzenjammer umschlagen [, wenn der Handel als EU-Ausland mit Spanien und der EU einbricht].“"
                                            },
                                            {
                                                "example_id": "7afd26cf-d67a-4e6e-b17c-8655caa01317",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„[Bei Einfuhrzöllen würde] auf die Euphorie der Katzenjammer folgen. Langfristig würde das Wirtschaftswachstum der USA sinken.“"
                                            },
                                            {
                                                "example_id": "bb0546eb-1a88-4af0-aabe-208b8ebf6f8c",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„In der großen Buchbranche wird öffentlich durchaus ein Katzenjammer gepflegt. Zur bevorstehenden Buchmesse haben zwei große Verlagshäuser ihre traditionellen Verlagspartys abgesagt.“"
                                            },
                                            {
                                                "example_id": "b8d0237f-4157-4776-bf14-a0fbf9a4e527",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„Das ist der typische Fehler, dass man gerade in wirtschaftlich guten Zeiten jede Menge Geld rauswirft. Der Katzenjammer kommt dann, wenn der Abschwung kommt.“"
                                            },
                                            {
                                                "example_id": "3b12c7b0-d128-46f5-b472-5fb1d2898f0e",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„[Olympischen Spiele in Rio de Janeiro:] […] wie immer gibt es diejenigen, die warnen, nach den Spielen werde nichts bleiben außer Katzenjammer - über Schulden, neue Dopingfälle und enttäuschte Hoffnungen.“"
                                            },
                                            {
                                                "example_id": "03349a15-5ab7-4ce8-9981-6b5b95254025",
                                                "sense_id": "d69ad7a3-bd08-31f0-923a-180aea0493bc",
                                                "text": "„Der Katzenjammer bei der Wirtschaft [nach dem 'Nein' zum EWR-Beitritt] war damals gross, heute gibt es diesen Katzenjammer eigentlich nicht mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e165dd29-9c15-4521-b864-acdf8932dd19",
                        "source_entry_id": "78938a18-f2ba-322e-9030-c75132ba6834",
                        "source_sense_id": "f167d01e-c682-3533-ba90-e1bff89864eb",
