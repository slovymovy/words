                                    {
                                        "sense_id": "49c63fad-46be-34b3-87b4-44a438d39f59",
                                        "entry_id": "41791137-43f1-370f-a34d-83ef7fde37b3",
                                        "glosses": [
                                            "Teil eines gegliederten Textes (oder Werkes), in dem man die Aufteilung und die Seitenzahlen ablesen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6185b5c4-89bd-42a3-a536-33ad34d24250",
                                                "sense_id": "49c63fad-46be-34b3-87b4-44a438d39f59",
                                                "text": "In diesem Buch steht das Inhaltsverzeichnis auf den letzten Seiten und nicht am Anfang."
                                            },
                                            {
                                                "example_id": "26cd10a7-baab-4b19-b693-d0de0a5ee146",
                                                "sense_id": "49c63fad-46be-34b3-87b4-44a438d39f59",
                                                "text": "Der Blickfang auf der Titelseite ist thematisch nicht im Inhaltsverzeichnis aufgeführt!"
                                            },
                                            {
                                                "example_id": "b38036dc-e1b9-4ea9-b36c-7e7447ded0ec",
                                                "sense_id": "49c63fad-46be-34b3-87b4-44a438d39f59",
                                                "text": "„Er schlug im Inhaltsverzeichnis nach.“"
                                            },
                                            {
                                                "example_id": "3e62960b-24f0-4198-ad9e-99695eed5a4c",
                                                "sense_id": "49c63fad-46be-34b3-87b4-44a438d39f59",
                                                "text": "„Stattdessen ging ich gleich zum Inhaltsverzeichnis über und wollte das Editorial in aller Eile übergehen, da ich keinen Kommentar wünschte oder erwartete, aber nun fuhr die Chefin vom Dienst plötzlich von ihrem Stuhl hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
