                        "glosses": [
                            "Dampftopf, in dem etwas digeriert wird oder ein spezielles Gefäß zum Digerieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb7948d-db08-44d3-8570-755a16a043ae",
                                "sense_id": "9613e216-9cab-327e-a54f-c2e7cb33a316",
                                "text": "Ein Digestor kann mit dem zugehörigen Deckel luftdicht verschlossen werden."
                            },
                            {
