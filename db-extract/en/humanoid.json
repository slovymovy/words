                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd0d457a-622d-4cc0-95a8-803e24b1b23c",
                                                "sense_id": "f5597dbc-48cd-3de3-aa75-70735ad830eb",
                                                "text": "Zazwyczaj fikcyjne humanoidy to stworzenia dwunożne, o kształcie ciała podobnym do ludzkiego, jednak różniące się od ludzi kolorem skóry, ilością i umiejscowieniem włosów, wzrostem, masą ciała, kształtem uszu i nosa."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
