                        "examples": [
                            {
                                "example_id": "901114ee-a49b-4656-b143-4519838c06e7",
                                "sense_id": "62e803b6-09af-38e1-9fcd-a62973dd468a",
                                "text": "Volgens de supermarkt verdwijnt met het afschaffen van de muntjes ook de irritatiefactor: klanten hebben dikwijls geen muntje bij zich of moeten ernaar zoeken."
                            },
                            {
                                "example_id": "cbb462e3-4623-4849-a0c6-9b218eb9839c",
                                "sense_id": "62e803b6-09af-38e1-9fcd-a62973dd468a",
                                "text": "In Zuid-Holland is harde muziek in 60 procent van de gevallen de oorzaak van een burenruzie. In Noord-Holland (15 procent van de burenruzies) is overlast van kinderen de grootste irritatiefactor. In Gelderland, waar 12 procent van de burenruzies zich afspeelt, is overhangend groen de voornaamste oorzaak van conflicten."
                            }
                        ]
                    }
