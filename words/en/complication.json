{
    "word_family": [
        "complicate",
        "complicated",
        "uncomplicated"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "396a5ed8-147d-3326-aeb0-605668e09e99",
                    "sense_definition": "A situation or factor that makes something more difficult or complex to deal with.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden rain was an unexpected <w>complication</w> for the outdoor wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Внезапный дождь стал неожиданным <w>осложнением</w> для свадебной церемонии на открытом воздухе."
                            }
                        },
                        {
                            "text": "We need to avoid any <w>further</w> <w>complication</w> while we are finishing this project.",
                            "target_lang_translations": {
                                "ru": "Нам нужно избегать любых дальнейших <w>усложнений</w>, пока мы завершаем этот проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "entanglement",
                        "intricacy",
                        "snarl"
                    ],
                    "antonyms": [
                        "simplicity",
                        "clarity"
                    ],
                    "common_phrases": [
                        "further complication",
                        "unexpected complication",
                        "added complication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация или фактор, который делает что-либо более трудным или сложным для решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осложнение",
                                "target_lang_sense_clarification": "трудность или препятствие"
                            },
                            {
                                "target_lang_word": "усложнение",
                                "target_lang_sense_clarification": "увеличение трудности или сложности"
                            },
                            {
                                "target_lang_word": "затруднение",
                                "target_lang_sense_clarification": "препятствие, создающее сложность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d97809-7812-3abd-bd74-b66f654b10f5",
                    "sense_definition": "A secondary disease or condition that develops during the course of a primary disease and makes it worse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered a serious <w>complication</w> after the surgery was completed.",
                            "target_lang_translations": {
                                "ru": "У пациента возникло серьезное <w>осложнение</w> после завершения операции."
                            }
                        },
                        {
                            "text": "Doctors are monitoring him closely to prevent a <w>medical</w> <w>complication</w> from developing.",
                            "target_lang_translations": {
                                "ru": "Врачи внимательно наблюдают за ним, чтобы предотвратить развитие медицинского <w>осложнения</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical complication",
                        "postoperative complication",
                        "serious complication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вторичное заболевание или состояние, возникающее в ходе основной болезни и ухудшающее её течение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осложнение",
                                "target_lang_sense_clarification": "медицинское последствие болезни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d5de5e2-034e-318b-95c0-932b40cf2d37",
                    "sense_definition": "Any feature in a mechanical watch that goes beyond the simple display of hours and minutes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "horology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Obsessed, he was after a watch that contained the greatest number of <w>complications</w> in the boldest combinations.",
                            "target_lang_translations": {
                                "ru": "Одержимый, он искал часы с наибольшим количеством <w>усложнений</w> в самых смелых сочетаниях."
                            }
                        },
                        {
                            "text": "A perpetual calendar is a highly prized <w>watch</w> <w>complication</w> among collectors.",
                            "target_lang_translations": {
                                "ru": "Вечный календарь — это высоко ценимое часовое <w>усложнение</w> среди коллекционеров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "watch complication",
                        "horological complication"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in horology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая функция механических часов, выходящая за рамки простого отображения часов и минут."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усложнение",
                                "target_lang_sense_clarification": "дополнительная функция в часовом механизме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebb04e99-f353-3e15-b5ab-3edebe36329d",
                    "sense_definition": "The act of twisting, intertwining, or tangling things together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist depicted the snaky <w>complication</w> in the Caduceus with great detail.",
                            "target_lang_translations": {
                                "ru": "Художник с большой детализацией изобразил змеиное <w>сплетение</w> в Кадуцее."
                            }
                        },
                        {
                            "text": "The <w>complication</w> of the vines made it impossible to walk through the garden.",
                            "target_lang_translations": {
                                "ru": "<w>Сплетение</w> лоз сделало невозможным проход через сад."
                            }
                        }
                    ],
                    "synonyms": [
                        "entanglement",
                        "snarl"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in a physical sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт скручивания, переплетения или запутывания вещей между собой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетение",
