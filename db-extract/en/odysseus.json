                                    {
                                        "sense_id": "69d47129-7911-3970-9b6b-41e7c038cc7f",
                                        "entry_id": "3888cb35-dceb-3b4e-a18f-dbd45409689c",
                                        "glosses": [
                                            "Héros grec, époux de Pénélope, qui figure dans l’Iliade et l’Odyssée d’Homère."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4426e10-fd5b-4bd7-bd70-903165e18676",
                                                "sense_id": "69d47129-7911-3970-9b6b-41e7c038cc7f",
                                                "text": "Cela explique les images, si fréquentes en littérature, du voyage, du naufrage, du cheminement (Ulysse, Don Quichotte et tant d’autres) vers un but souvent obscur au départ, mais qui peut donner sens à la démarche, à la voie choisie, à la « méthode » (du grec hodos qui signifie « chemin, voie »)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8833b68f-aaa1-4196-a4bb-44e350082450",
                        "source_entry_id": "2bc4f7fe-9c1d-3fce-af9b-7b1cc5a99839",
                        "source_sense_description": "son of Laertes; Greek leader during the Trojan War",
                        "target_lang_word": "Odysseus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Odysseus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ba19564-813c-38e9-9f10-ecf811915675",
                                        "entry_id": "7d8702de-c0fe-389d-b4ec-3c8ddd020701",
                                        "glosses": [
                                            "Ulysse."
                                        ],
                                        "tags": [
                                            "Mythologie grecque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87277a55-07e8-4e40-9221-1690f6bd156f",
                                                "sense_id": "4ba19564-813c-38e9-9f10-ecf811915675",
                                                "text": "« Ne faites pas attention, il est extrêmement blagueur », dit-il à mi-voix à Saint-Loup qui n’en fut que plus intéressé, étant très curieux de la psychologie des menteurs. — Plus menteur encore que l’Ithaquesien Odysseus qu’Athènes appelait pourtant le plus menteur des hommes, compléta notre camarade Bloch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72d59bcf-fdab-4665-8ce6-d2294258ab98",
                        "source_entry_id": "2bc4f7fe-9c1d-3fce-af9b-7b1cc5a99839",
                        "source_sense_description": "son of Laertes; Greek leader during the Trojan War",
                        "target_lang_word": "Odysseus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Odysseus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83d85259-550a-3886-8420-80ff125a1c00",
                                        "entry_id": "801a1b4e-584a-3885-af85-63843b37649b",
                                        "glosses": [
                                            "Name eines Heroen der griechischen Mythologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457d51de-9f73-4fe2-863a-6cb6cc4fce3b",
                                                "sense_id": "83d85259-550a-3886-8420-80ff125a1c00",
                                                "text": "Odysseus war der Sohn des Laërtes (in weniger verbreiteten Versionen des Sisyphos) und der Antikleia sowie der Bruder der Ktimene. Von seinem Vater übernahm Odysseus die Herrschaft über Ithaka."
                                            },
                                            {
                                                "example_id": "af0091a0-a3fc-4b15-a33e-22f409e50fde",
                                                "sense_id": "83d85259-550a-3886-8420-80ff125a1c00",
                                                "text": "Astronomen haben anhand einer in Homers Odyssee beschriebenen Sonnenfinsternis die Ankunft von Odysseus in Ithaka datiert: Demnach kehrte der sagenhafte König und Heerführer am 16. April 1178 vor Christus nach seiner Irrfahrt auf seine Heimatinsel zurück."
                                            },
                                            {
                                                "example_id": "1868f7fc-d64c-41ff-8e54-909b2dd2957b",
                                                "sense_id": "83d85259-550a-3886-8420-80ff125a1c00",
                                                "text": "„Wir können die Serie aber auch als den Versuch sehen, einen modernen Mythos zu schaffen: den Mythos eines Mannes, der sich wie Odysseus erst auf Irrfahrt begeben muss, bevor er sein Ziel erreichen kann.“"
                                            },
                                            {
                                                "example_id": "fe017364-b542-4966-b9f9-6b4b3388b6f7",
                                                "sense_id": "83d85259-550a-3886-8420-80ff125a1c00",
                                                "text": "„Die Sirenen erschienen Morgner wagemutiger als Odysseus, eine weibliche Trobadora sinnlicher als ihre männlichen Kollegen und Pandora menschlicher als der von ihr angebetete Prometheus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
