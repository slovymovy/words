        "fr-extract.jsonl": [
            {
                "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                "word": "béatitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cdd3352a-263a-4742-9fc0-34462ba35553",
                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                        "tags": [
                            "plural"
                        ],
                        "form": "béatitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                        "glosses": [
                            "Félicité dont les élus jouissent au paradis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67e77094-eb5b-43c2-ac37-2c19a8a459bd",
                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                "text": "Ceux-là ne navigueront plus sur les mers mauvaises parce qu’ils ont trouvé le port et que l’ancre a été jetée dans l’incomparable béatitude."
                            },
                            {
                                "example_id": "7cf1e5dc-8d5b-4b8e-aee1-6efdf4d192ac",
                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                "text": "J’ai commencé dès ma douzième année à me faire une certaine idée que Donzac, l’année dernière et cette année, m’a rendue claire, c’est qu’à leur insu, les chrétiens qui nous ont élevés prennent en tout le contrepied de l’Évangile, et que de chaque béatitude du Sermon sur la Montagne, ils ont fait une malédiction : qu’ils ne sont pas doux, qu’ils ne sont pas seulement injustes mais qu’ils exècrent la justice."
                            },
                            {
                                "example_id": "bd48a833-516d-47a9-9165-8d60edf67c90",
                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                "text": "La vraie béatitude consiste dans la vue de Dieu. — Les huit béatitudes, les huit sortes de félicités dont l’évangile fait l’énumération."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                        "glosses": [
                            "Bonheur parfait, satisfaction tranquille."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "21c79dab-4b80-47e0-b64c-cf23ba4055a1",
                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                "text": "Un grand chat noir, frileusement roulé en boule, rêvait dans la lueur rouge du feu, avec un tout petit ronron de béatitude."
                            },
                            {
                                "example_id": "754abccf-eefc-4198-92ea-cb7a64bfc0fb",
                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                "text": "Je sens mes intestins qui ronronnent légèrement. La digestion sans heurts est le plus grand facteur d'activité. Le cerveau s'emplit avec le ventre et l'optimisme a sa source dans la béatitude des tripes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c33be2d-0ac0-49ae-806c-db7827f4d124",
                        "source_entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                        "target_lang_word": "cloud nine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloud nine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                        "entry_id": "1396bf49-1c37-38c9-9ac1-5ff0789679c6",
                                        "glosses": [
                                            "Often in the phrase on cloud nine: a state of bliss, elation or happiness."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a5e697d-11f9-4629-8b50-f5eb95e22cda",
                                                "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                                "text": "Following a highly successful tour of Italy in July/August 1993, with recital and orchestral appearances and an especially inspiring last performance, I returned to New York on cloud nine and full of euphoria."
                                            },
                                            {
                                                "example_id": "46882238-2475-4ea9-9dfa-caa5faaf31da",
                                                "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                                "text": "He was on cloud nine for days after she agreed to marry him."
                                            },
                                            {
                                                "example_id": "28a51b54-110f-4a9c-bc1c-c68a024f17c3",
                                                "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                                "text": "In your zeal you may not feel you are undertaking a thing for your own sake but think you are doing so for God. Nevertheless, you should remember that at the time of great excitement as though you were on cloud nine, you may perhaps be most fleshly!"
                                            },
                                            {
                                                "example_id": "32001171-a751-4c0b-a2e0-11f8503ec808",
                                                "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                                "text": "Most of us do not think of excitement as a problem. After all, doesn't everybody like to be on cloud number nine? I agree: if we could stay on cloud number nine, life might be very pleasant. But, as all of us know, the cloud eventually evaporates. Then we not only come abruptly back to earth; we usually burrow right into its depths and hide – that is, we go into a depression."
                                            },
                                            {
                                                "example_id": "6786246a-b1e0-4de8-9ba5-9b1aff242595",
                                                "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                                "text": "A. A. scanned the crowd and spotted Lili's happy face. Lili had been on cloud nine ever since she and Max had gotten back together."
                                            },
                                            {
                                                "example_id": "a18c6dc1-1ca7-4a0d-9005-69fedf05d3d8",
                                                "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                                "text": "On the first day at the university I was on cloud nine that I had begun my intellectual life. I was happy to join the cream of creams."
                                            },
                                            {
                                                "example_id": "32416163-e1d5-4002-a85c-2ff25025db2f",
                                                "sense_id": "3ab99388-b801-3a31-ac30-0bb94731f596",
                                                "text": "Falling from cloud nine / Crashing from the high / I'm letting go tonight / Yeah, I'm falling from cloud nine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1a1fa4-2b66-39ae-b7ee-9e9bc7dd3ff4",
                                        "entry_id": "1396bf49-1c37-38c9-9ac1-5ff0789679c6",
                                        "glosses": [
                                            "A state of fantastic or impractical dreaming or thinking."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "nonstandard",
                                            "possibly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caea82ab-250b-4468-84af-2c14b1a84604",
                                                "sense_id": "1a1a1fa4-2b66-39ae-b7ee-9e9bc7dd3ff4",
                                                "text": "Now, the system approach, needless to say, wants to help out in that particular problem, but it lives up on cloud nine for the most part. This is one of the reasons that it has not made more headway than it has in the civilian agencies of government."
                                            },
                                            {
                                                "example_id": "0d6756bf-8e64-4530-9319-56ba45dbd820",
                                                "sense_id": "1a1a1fa4-2b66-39ae-b7ee-9e9bc7dd3ff4",
                                                "text": "Mr. Walsh – […] It sounds like the purpose of the geographic base coding system is to fulfill a planning function of the agency. If that is not the case, then I am concerned as that is one way to get up on \"cloud nine\"—that is, to not associate with end products."
                                            },
                                            {
                                                "example_id": "9a380ce3-5bd0-47a4-a2e1-35e7303d22c5",
                                                "sense_id": "1a1a1fa4-2b66-39ae-b7ee-9e9bc7dd3ff4",
                                                "text": "Members are living on cloud nine if they think that playing the stock-numbers game is doing anything for the farmers or the country."
                                            },
                                            {
                                                "example_id": "c82cfee5-2133-4981-8dd5-894638b669ff",
                                                "sense_id": "1a1a1fa4-2b66-39ae-b7ee-9e9bc7dd3ff4",
                                                "text": "By coming to grips with these problems, we can demonstrate that libertarianism is not just a beautiful ideal somewhere on Cloud Nine, but a tough-minded body of truths that enables us to take our stand and to cope with the whole host of issues of our day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7a7939f-8332-48e8-9fff-80ed91232618",
                        "source_entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                        "target_lang_word": "blessedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blessedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                        "entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                                        "glosses": [
                                            "The condition or state of being blessed; holy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "581ff2cb-067c-4376-8228-3f4b84da3267",
                                                "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                                "text": "But earthlyer happy is the roſe diſtild, / Then that, vvhich, vvithering on the virgin thorne, / Grovves, liues, and dies, in ſingle bleſſedneſſe."
                                            },
                                            {
                                                "example_id": "0b52f8a3-619b-44af-b105-df6af2055793",
                                                "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                                "text": "It matters little to tell you of my blessedness; but my very heart was filled with the light of those radiant eyes, which were to me what the sun is to the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5da97f4d-dc4c-4738-b511-a11a908b6689",
                        "source_entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
