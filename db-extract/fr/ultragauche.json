                ],
                "senses": [
                    {
                        "sense_id": "ab8b98c8-0da5-357a-9d9e-5632a04db612",
                        "entry_id": "56f8b5e5-33a0-33fa-9238-a54ace02cf71",
                        "glosses": [
                            "Ensemble des partis politiques de la gauche communiste révolutionnaire ou anticapitaliste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63f9a28-8ae3-4d7c-8172-e81f0a5d25a1",
                                "sense_id": "ab8b98c8-0da5-357a-9d9e-5632a04db612",
                                "text": "Fin 2017, la revendication par des groupes d’ultragauche de trois incendies de casernes de gendarmerie avaient suscité des déclarations inquiètes de l’exécutif sur une possible résurgence de velléités terroristes de cette mouvance."
                            },
                            {
                                "example_id": "97fbe1b1-6203-420a-bb2f-b06b4cf91e4b",
                                "sense_id": "ab8b98c8-0da5-357a-9d9e-5632a04db612",
                                "text": "Pour corser une addition déjà lourde, l’ultragauche s’invite sur scène."
                            },
                            {
                                "example_id": "7939d995-91fb-4b79-9cef-a95947a018d7",
                                "sense_id": "ab8b98c8-0da5-357a-9d9e-5632a04db612",
                                "text": "Et, je vous en ai parlé, j’ai l’intention d’écrire un livre sur votre itinéraire au sein du maelström de la gauche et de l’ultragauche : ce sera un document passionnant."
                            }
                        ]
                    }
                ],
