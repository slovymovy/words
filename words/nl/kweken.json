                },
                {
                    "sense_id": "47f3a140-bfd6-3853-b984-277eba582f14",
                    "sense_definition": "het langzaam ontwikkelen of verkrijgen van een bepaalde eigenschap of vaardigheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door elke dag te trainen kun je meer spieren <w>kweken</w>.",
                            "target_lang_translations": {
                                "en": "By training every day, you can <w>build up</w> more muscle.",
                                "ru": "Тренируясь каждый день, можно <w>накачать</w> больше мышц."
                            }
                        },
                        {
                            "text": "Je moet veel geduld <w>kweken</w> als je met jonge kinderen werkt.",
                            "target_lang_translations": {
                                "en": "You have to <w>cultivate</w> a lot of patience when working with young children.",
                                "ru": "Нужно запастись большим терпением (или <w>выработать</w> его), когда работаешь с маленькими детьми."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontwikkelen",
                        "opbouwen"
