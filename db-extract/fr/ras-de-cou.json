                                    {
                                        "sense_id": "c0f02148-446f-3f2b-9d2c-c71f54868b34",
                                        "entry_id": "2f28a33c-b2c0-30f2-9043-b81079d487ca",
                                        "glosses": [
                                            "A piece of jewelry or ornamental fabric, worn as a necklace or neckerchief, tight to the throat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430499cd-94c3-4ef6-8380-ee3e64a9e27f",
                                                "sense_id": "c0f02148-446f-3f2b-9d2c-c71f54868b34",
                                                "text": "Anne Talbot looked demurely ravishing, as was her intention, in a very low-cut evening frock of bottle-green, choker of Kelantan silver, earrings in the shape of krises."
                                            },
                                            {
                                                "example_id": "6c908b8b-e529-4a93-a539-0f6aa9dff93a",
                                                "sense_id": "c0f02148-446f-3f2b-9d2c-c71f54868b34",
                                                "text": "She appears on the 90th anniversary issue of French Vogue wearing nothing but a mask, gloves and a choker – everything but her now iconic gap-toothed pout and impressive cleavage is obscured."
                                            },
                                            {
                                                "example_id": "179f0e03-e797-49d7-ad50-005637fa162d",
                                                "sense_id": "c0f02148-446f-3f2b-9d2c-c71f54868b34",
                                                "text": "The words: “Take your hands off when I say no, take your eyes off when I say no” were spelled out on video screens as the first model marched past in loose black layers, a punky choker and black shoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c4a3f25-2d28-3c5e-a9ca-352d2d1b0181",
                                        "entry_id": "2f28a33c-b2c0-30f2-9043-b81079d487ca",
                                        "glosses": [
                                            "One who, or that which, chokes or strangles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fee873ff-54ed-44a6-946f-235b500f8cee",
                                                "sense_id": "7c4a3f25-2d28-3c5e-a9ca-352d2d1b0181",
                                                "text": "The Yorkshire Choker, a serial killer who quotes Shakespeare, is pursued by Dalziel and Pascoe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6d23b78-c40f-3d16-a474-1a56f14965e7",
                                        "entry_id": "2f28a33c-b2c0-30f2-9043-b81079d487ca",
                                        "glosses": [
                                            "One who operates the choke of an engine during ignition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d73db556-cf04-3a90-b780-62d4073c2ac7",
                                        "entry_id": "2f28a33c-b2c0-30f2-9043-b81079d487ca",
                                        "glosses": [
                                            "Any disappointing or upsetting circumstance."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "764797ad-d6fd-4037-8c01-f2fafa3bd537",
                                                "sense_id": "d73db556-cf04-3a90-b780-62d4073c2ac7",
                                                "text": "I lost £100 on the horses today — what a choker!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e942d3-cf9f-3708-b543-6f85de868550",
                                        "entry_id": "2f28a33c-b2c0-30f2-9043-b81079d487ca",
                                        "glosses": [
                                            "One who performs badly at an important part of a competition because they are nervous, especially when winning."
                                        ],
