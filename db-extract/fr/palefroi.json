        "fr-extract.jsonl": [
            {
                "entry_id": "73575d5c-b59d-38ec-aeee-1bb954c2de51",
                "word": "palefroi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "95da1d52-9343-4e2a-9cd3-a97c45e80091",
                        "entry_id": "73575d5c-b59d-38ec-aeee-1bb954c2de51",
                        "tags": [
                            "plural"
                        ],
                        "form": "palefrois"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13e88ad0-4c6c-37c0-a7fa-030653face00",
                        "entry_id": "73575d5c-b59d-38ec-aeee-1bb954c2de51",
                        "glosses": [
                            "Cheval de marche et aussi de parade, opposé à destrier."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "481d8a1d-66ac-48b2-8695-516fa8803f19",
                                "sense_id": "13e88ad0-4c6c-37c0-a7fa-030653face00",
                                "text": "Ils plaignent le pèlerin attardé qui rencontre le roi Pialus et la reine Wilberta, car c’est l’heure où le roi mène boire son palefroi de vapeurs au Rhin."
                            },
                            {
                                "example_id": "1e535037-1823-476b-9746-0f990eccd3bd",
                                "sense_id": "13e88ad0-4c6c-37c0-a7fa-030653face00",
                                "text": "La selle et la housse du superbe palefroi étaient abritées d’une longue couverture qui tombait presque jusqu’à terre."
                            },
                            {
                                "example_id": "bb3fd534-2502-4e08-a9c5-189e65087beb",
                                "sense_id": "13e88ad0-4c6c-37c0-a7fa-030653face00",
                                "text": "L'accident fit 12 morts, dont le duc de Bretagne et le frère du pontife ; Charles de Valois, frère du roi de France, qui tenait son palefroi par la bride, avait été lui-même gravement blessé."
                            },
                            {
                                "example_id": "6c8a4140-6600-44a5-a665-524f6a06e953",
                                "sense_id": "13e88ad0-4c6c-37c0-a7fa-030653face00",
                                "text": "Combattre avec une mule, et plus encore un palefroi (cheval de parade) ou, pire, un roncin ou un sommier (chevaux de trait ou de somme) constitue pour un chevalier une humiliation que les plus démunis ne peuvent parfois éviter."
                            }
                        ]
                    },
                    {
                        "sense_id": "93b169f5-7d1e-376d-aae0-4f76fa8bbe05",
                        "entry_id": "73575d5c-b59d-38ec-aeee-1bb954c2de51",
                        "glosses": [
                            "Cheval monté par les dames."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d23c19de-b57e-4e42-a88f-94d7912749b0",
                        "source_entry_id": "73575d5c-b59d-38ec-aeee-1bb954c2de51",
                        "target_lang_word": "palfrey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palfrey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d771bcd-2226-3c5b-992c-68e324379dcd",
                                        "entry_id": "5b23af9a-0afc-3f72-aad8-accfdad48b7f",
                                        "glosses": [
                                            "A small horse with a smooth, ambling gait, popular in the Middle Ages with nobles and women for riding (contrasted with a warhorse)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fad58bd-75b3-4bee-8e2f-2c1135e5d772",
                                                "sense_id": "3d771bcd-2226-3c5b-992c-68e324379dcd",
                                                "text": "Five warriors seiz'd me yestermorn, / Me, even me, a maid forlorn: / They choked my cries with force and fright, / And tied me on a palfrey white. / The palfrey was as fleet as wind, / And they rode furiously behind."
                                            },
                                            {
                                                "example_id": "3cce0c12-c089-412f-a832-d94e5924a919",
                                                "sense_id": "3d771bcd-2226-3c5b-992c-68e324379dcd",
                                                "text": "The eye of father and sister alike forgot every other object while watching the evolutions of the young and graceful boy, who realised the descriptions of romance as, his golden curls dancing on the wind, his cheek flushed with exercise, and his large blue eyes dilated and flashing with triumph, he ruled the snow-white palfrey by a wave of the hand and an imperceptible pressure of the knee. It seemed as if the docile creature intuitively divined his will."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
