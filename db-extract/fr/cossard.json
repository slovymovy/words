                "senses": [
                    {
                        "sense_id": "fe1d8a20-1bd6-3571-8645-76cd48737edd",
                        "entry_id": "461b0222-face-32f4-9832-afeb2260bb00",
                        "glosses": [
                            "Fainéant, paresseux, qui a la cosse."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "15769357-5fff-4606-ad1f-a379d8f2fc18",
                                "sense_id": "fe1d8a20-1bd6-3571-8645-76cd48737edd",
                                "text": "Mais quelle cossarde celle-là, elle n’a pas encore commencé, allez vite au travail !"
                            },
                            {
                                "example_id": "3721bc2e-a9f6-4b55-ad33-f3647015ab14",
                                "sense_id": "fe1d8a20-1bd6-3571-8645-76cd48737edd",
                                "text": "Il est intelligent mais trop cossard."
                            },
                            {
                                "example_id": "051cb223-c0e4-40c3-a823-a17262d97caf",
                                "sense_id": "fe1d8a20-1bd6-3571-8645-76cd48737edd",
                                "text": "On traverse la nuit. Les panneaux espacés – Futuroscope, Poitiers-Nord, Poitiers-Sud, prochaine sortie Marais poitevin – ont des noms bien français qui sentent les leçons de géographie. Mais c’est une saveur abstraite, une réalité aveugle que l’on efface avec un vieux fond de roublardise cossarde : cette France virtuelle que l’on abolit, un pied sur l’accélérateur, un œil sur le compteur kilométrique, c’est une leçon de plus que l’on n’apprendra pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4fbeae8-6ce0-4a3b-b915-09104361c656",
                        "source_entry_id": "461b0222-face-32f4-9832-afeb2260bb00",
                        "source_sense_id": "fe1d8a20-1bd6-3571-8645-76cd48737edd",
                        "source_sense_description": "Fainéant",
                        "target_lang_word": "faul",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faul",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "613e3d06-ddf7-340b-84b6-9fc985faaff8",
                                        "entry_id": "eef07b3e-a3a6-3fae-b4a8-59a6afbbda4a",
                                        "glosses": [
                                            "nicht mehr frisch; verrottet, verfault"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e36feb36-7cff-4a67-9f02-5925b7c60c99",
                                                "sense_id": "613e3d06-ddf7-340b-84b6-9fc985faaff8",
                                                "text": "Es roch stark nach Schwefelwasserstoff, das ist der typische Geruch fauler Eier."
                                            },
                                            {
                                                "example_id": "a99e1897-3122-4ee6-ac71-a1ae7248012e",
                                                "sense_id": "613e3d06-ddf7-340b-84b6-9fc985faaff8",
                                                "text": "Um ein Ei als faul zu erkennen, muss man nicht selber Eier legen können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a603c102-2a8c-38c8-be54-68d17038e4a1",
                                        "entry_id": "eef07b3e-a3a6-3fae-b4a8-59a6afbbda4a",
                                        "glosses": [
                                            "keine Lust beziehungsweise Motivation besitzend, sich einer anstrengend erscheinenden Angelegenheit zu widmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e5d8e91-202f-4795-aa8b-69dfcfdfa204",
                                                "sense_id": "a603c102-2a8c-38c8-be54-68d17038e4a1",
                                                "text": "Wenn er immer so faul ist, wird er nie eine anständige Arbeit finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                        "entry_id": "eef07b3e-a3a6-3fae-b4a8-59a6afbbda4a",
                                        "glosses": [
                                            "falsch, fragwürdig, verdächtig, problematisch oder nicht in Ordnung"
                                        ],
                                        "tags": [
                                            "auf Gesellschaftsordnungen",
                                            "Finanzgeschäfte oder allgemeine Missstände bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6782552-8b96-459b-ac44-73828800f66d",
                                                "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                                "text": "An dieser Sache ist etwas faul."
                                            },
                                            {
                                                "example_id": "481b0dc6-5dd2-420a-b76a-1b432dae9fd6",
                                                "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                                "text": "Es wurden faule Immobilienkredite vergeben."
                                            },
                                            {
                                                "example_id": "6ca6ad28-57ee-41cd-9124-c3c2709ea23c",
                                                "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                                "text": "Dass er krank sein soll, das ist doch nur eine faule Ausrede. In Wirklichkeit renoviert er sein Haus!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "faul",
                                "target_lang_code": "de",
