                "senses": [
                    {
                        "sense_id": "6f56a923-5960-3bbf-b013-1c98dad82e18",
                        "entry_id": "3279d14e-82df-3ad1-889a-97954115e47d",
                        "glosses": [
                            "etwas, das nicht von öffentlichem Interesse ist, das Privatleben betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa1d645-3eeb-4100-920b-3d391d74c79b",
                                "sense_id": "6f56a923-5960-3bbf-b013-1c98dad82e18",
                                "text": "„Nach seiner Ansicht handelte es sich um eine Privatangelegenheit, die nur die eigene Familie etwas anging.“"
                            },
                            {
                                "example_id": "a337840f-6149-4e72-8e59-3bc16be1aa64",
                                "sense_id": "6f56a923-5960-3bbf-b013-1c98dad82e18",
                                "text": "„Und dann riet er ihr, sich nicht in die Privatangelegenheiten der Dorfbewohner einzumischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
