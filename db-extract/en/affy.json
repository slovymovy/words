                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6ef733bb-cd68-430d-882d-611d604cea34",
                                "sense_id": "a0a1e519-e43e-3100-8302-95c2be57f093",
                                "text": "He, though affide unto a former love, / To whom his faith he firmely ment to hold, / […] Her graunted love, but with affection cold […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "5274509b-a196-3e3a-acbf-f03a5c53ceaf",
