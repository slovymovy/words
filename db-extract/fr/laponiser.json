                        "glosses": [
                            "Donner un caractère lapon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6daceda9-81ed-46ca-b4c5-0136ab76db18",
                                "sense_id": "0d385cdf-f4d4-309a-bc53-244874b94bfb",
                                "text": "La coutume lapone est de «laponiser» les prénoms des étrangers, voyageurs ou ethnologues, qui ont vécu parmi eux et ont su gagner leur estime, en leur accolant le nom de leur nationalité, formant ainsi un double nom d'apparence lapone."
                            },
                            {
                                "example_id": "5f22953a-320e-4498-9280-5d8997f3a063",
                                "sense_id": "0d385cdf-f4d4-309a-bc53-244874b94bfb",
                                "text": "finalement, vous auriez une certaine tendance à vous laponiser."
                            }
                        ]
                    }
