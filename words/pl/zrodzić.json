                    "sense_id": "1e05d99e-dcfb-350f-a5f2-9e00266e9781",
                    "sense_definition": "spowodować powstanie czegoś, dać czemuś początek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego ostatnia wypowiedź w mediach <w>zrodziła</w> wiele niepotrzebnych wątpliwości wśród wyborców.",
                            "target_lang_translations": {
                                "en": "His recent statement in the media <w>gave rise to</w> many unnecessary doubts among voters."
                            }
                        },
                        {
                            "text": "Nowy kryzys gospodarczy może <w>zrodzić</w> poważne konflikty społeczne w całym kraju.",
                            "target_lang_translations": {
                                "en": "The new economic crisis may <w>breed</w> serious social conflict across the whole country."
                            }
                        }
                    ],
                    "synonyms": [
                        "dać początek"
                    ],
                    "common_phrases": [
                        "zrodzić wątpliwości",
                        "zrodzić konflikt",
                        "zrodzić pytanie"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause something to arise, develop, or come into existence"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spawn",
                                "target_lang_sense_clarification": "to generate or produce something, often widespread"
                            },
                            {
                                "target_lang_word": "give rise to",
                                "target_lang_sense_clarification": "to cause or be the source of something"
                            },
                            {
                                "target_lang_word": "breed",
                                "target_lang_sense_clarification": "to produce or result in feelings, ideas, or conflict"
                            },
                            {
                                "target_lang_word": "engender",
                                "target_lang_sense_clarification": "to bring about or give rise to a feeling or situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0eb9de4-dbae-3ebd-aba7-6156b42d4a71",
                    "sense_definition": "wziąć początek lub pojawić się, zwłaszcza w odniesieniu do myśli, uczuć lub zjawisk (zwykle w formie zwrotnej)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "come_to_be",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego głowie nagle <w>zrodził</w> się genialny pomysł na kolejną powieść kryminalną.",
                            "target_lang_translations": {
                                "en": "A brilliant idea for a new crime novel was suddenly <w>born</w> in his mind."
                            }
                        },
                        {
                            "text": "W sercach mieszkańców powoli <w>zrodziła</w> się nadzieja na szybkie zakończenie wojny.",
                            "target_lang_translations": {
                                "en": "Hope for a swift end to the war slowly <w>arose</w> in the hearts of the residents."
                            }
                        }
                    ],
                    "synonyms": [
                        "powstać"
                    ],
                    "common_phrases": [
                        "zrodzić się w głowie",
                        "zrodzić się z nadziei"
                    ],
                    "target_lang_definitions": {
                        "en": "to originate, emerge, or be born (especially regarding feelings, thoughts, or ideas; typically reflexive: zrodzić się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be born",
                                "target_lang_sense_clarification": "metaphorically, of thoughts, ideas, or feelings originating"
                            },
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "to emerge or come into being"
                            },
                            {
                                "target_lang_word": "spring up",
                                "target_lang_sense_clarification": "to appear or develop suddenly"
                            }
                        ]
                    }
                }
            ]
