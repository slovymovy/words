                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Incruster de marbre, de jaspe une colonne, un pilastre, un portique."
                                            },
                                            {
                                                "example_id": "3a5fbafe-a5c8-4e07-b724-3f804c225209",
                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Incruster un pilastre, un portique, etc."
                                            },
                                            {
                                                "example_id": "e7dd4d16-338a-4340-9066-5564b9121d92",
                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Incruster d’or une tabatière d’écaille."
                                            },
                                            {
                                                "example_id": "da8edffb-6ea2-48e7-ad3b-d3c0c13927de",
                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Des lettres d’or incrustées dans une plaque de marbre."
                                            }
                                        ]
                                    },
