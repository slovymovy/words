                "senses": [
                    {
                        "sense_id": "68e03dbd-08b0-36f5-8c2f-5b638c32744e",
                        "entry_id": "4790c391-f6d7-30f2-acae-e3550626b169",
                        "glosses": [
                            "Eigenschaft, gerne und viel zu reden, zu sprechen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7f6b1d7d-28c6-415a-8f5d-86b88c619579",
                                "sense_id": "68e03dbd-08b0-36f5-8c2f-5b638c32744e",
                                "text": "„Was sie auszeichnet, ist eine überaus große Redelustigkeit und Gesprächigkeit […].“"
                            },
                            {
                                "example_id": "92f7739a-0f5a-47a4-a9a2-889d43ee855f",
                                "sense_id": "68e03dbd-08b0-36f5-8c2f-5b638c32744e",
                                "text": "„Die Ursache davon, daß so viele falsche Gerüchte cursiren, liegt in der außerordentlichen Redelustigkeit der Schwarzen und ihrer Empfänglichkeit für Neuigkeiten.“"
                            },
                            {
                                "example_id": "82bd2905-1f1f-49d3-b62b-434b8ce78f32",
                                "sense_id": "68e03dbd-08b0-36f5-8c2f-5b638c32744e",
                                "text": "„Ihre überreizte Verfassung und Redelustigkeit führen zu einem unliebsamen Verlauf der Begegnung.“"
                            },
                            {
                                "example_id": "28985bd7-5440-4a46-91c9-8eb403f0bd77",
                                "sense_id": "68e03dbd-08b0-36f5-8c2f-5b638c32744e",
                                "text": "„Er fasse den Vorschlag des Abgeordneten Hennig als einen Appell auf , ganz allgemein die Redelustigkeit einzuschränken.“"
                            },
                            {
                                "example_id": "e088620a-3f3e-4e5c-ac11-c469fdace05a",
                                "sense_id": "68e03dbd-08b0-36f5-8c2f-5b638c32744e",
                                "text": "„So herrschte dann an der königlichen Abendtafel eine einigermaßen gedrückte Stimmung, und auch der Toast, den zu halten Seine Redelustigkeit Friedrich Wilhelm IV. sich nicht versagen konnte, blieb ohne Echo und rechte Wirkung […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
