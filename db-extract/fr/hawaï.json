                        "form_id": "8a6e60f1-6853-47e2-9d62-ded577b9248f",
                        "entry_id": "d957732c-4aea-3200-a335-4f298115e48e",
                        "tags": [],
                        "form": "Hawaii"
                    },
                    {
                        "form_id": "af783f34-4ba3-4c85-9114-0b950b8dbe81",
                        "entry_id": "d957732c-4aea-3200-a335-4f298115e48e",
                        "tags": [],
                        "form": "Hawaiʻi"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d20570e0-14fc-391c-8ce2-3db219395ed7",
                        "entry_id": "d957732c-4aea-3200-a335-4f298115e48e",
                        "glosses": [
                            "Grande île de l’océan Pacifique Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f32b699-e4d9-4c3d-ab85-1c0c350aca38",
                                "sense_id": "d20570e0-14fc-391c-8ce2-3db219395ed7",
                                "text": "Hawaï est une île de la Polynésie, la plus grande et la plus méridionale de l’archipel des Sandwich."
                            },
                            {
                                "example_id": "43211348-7930-402f-ac8d-155cea950fca",
                                "sense_id": "d20570e0-14fc-391c-8ce2-3db219395ed7",
                                "text": "Hawaii est l’île volcanique la plus récente et la plus volumineuse (150 x 130 km) de l’archipel (long de 3 600 km et constitué par plus de 100 volcans)."
                            }
                        ]
                    },
                    {
                        "sense_id": "643224da-e321-3935-b71e-f02d1fbf902b",
                        "entry_id": "d957732c-4aea-3200-a335-4f298115e48e",
                        "glosses": [
                            "Archipel de l’océan Pacifique Nord, constitué de huit grandes îles (dont Hawaï, plus grande que toutes les autres réunies) et de nombreuses autres plus petites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e96b9d-19f8-4290-b353-bb1e2ca7fc30",
                                "sense_id": "643224da-e321-3935-b71e-f02d1fbf902b",
                                "text": "Une circulaire destinée à la Presse locale (« Press Bulletin », nᵒ 5) et émanant de la Station agronomique de Honolulu, nous apprend qu’il existe aux Hawaï de nombreux pieds de Chanvre de Manille (Musa textilis) provenant d’introductions, déjà anciennes."
                            },
                            {
                                "example_id": "8be9721a-a5f9-4fbe-b563-131a33d1dc84",
                                "sense_id": "643224da-e321-3935-b71e-f02d1fbf902b",
                                "text": "Signalons, de plus, que la Nouvelle-Zélande a une flore complexe et les îles Hawaï une flore très particulière, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "93fc0264-9662-39c4-85a9-1014f17a6a63",
                        "entry_id": "d957732c-4aea-3200-a335-4f298115e48e",
                        "glosses": [
                            "Un des cinquante États des États-Unis d’Amérique, de code postal HI, dont le territoire correspond à l’archipel (à l’exception des îles Midway), et dont la capitale est Honolulu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc5e6894-d270-4076-9cf6-75c73c6ed2a9",
                                "sense_id": "93fc0264-9662-39c4-85a9-1014f17a6a63",
                                "text": "Au début du siècle à Hawaï, le boum de l’activité sucrière attira une main-d'œuvre étrangère venue de pays aussi différents que la Chine, le Japon, les Philippines, la Corée et le Portugal."
                            },
                            {
                                "example_id": "21e30bf9-d6aa-45e0-911e-3f19758dc0bc",
                                "sense_id": "93fc0264-9662-39c4-85a9-1014f17a6a63",
                                "text": "Ces trésors végétaux viennent de Madère, des Canaries, des Antilles, des îles Juan Fernandez ou encore d’Hawaï."
                            },
                            {
                                "example_id": "ae1ebfdd-0a23-4948-8749-98d346d75fa1",
                                "sense_id": "93fc0264-9662-39c4-85a9-1014f17a6a63",
                                "text": "C’est là tout le paradoxe du poke bowl, dont la version originale est élaborée avec des ingrédients ultra-locaux trouvés à Hawaï."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05d56a49-ed54-49b8-b04b-1e548ba11732",
                        "source_entry_id": "d957732c-4aea-3200-a335-4f298115e48e",
                        "target_lang_word": "Hawaii",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hawaii",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85f4fe71-d07b-3458-b210-16f89333e3a6",
                                        "entry_id": "38d77c95-b080-33fa-8291-f08c2e16472e",
                                        "glosses": [
                                            "im Pazifik gelegene Inselgruppe, Bundesstaat der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9fa22eb-68ea-4d16-b750-8da248299b85",
                                                "sense_id": "85f4fe71-d07b-3458-b210-16f89333e3a6",
                                                "text": "Hawaii ist ungefähr 4000 Km vom amerikanischen Festland entfernt."
                                            },
                                            {
                                                "example_id": "659f4710-22b5-49bb-a34a-25c166da7bb9",
                                                "sense_id": "85f4fe71-d07b-3458-b210-16f89333e3a6",
                                                "text": "Früher lebte Hawaii vor allem von seinem Fischfang und seiner Landwirtschaft."
                                            },
                                            {
                                                "example_id": "f8e5c076-c5f6-46a1-bd9d-572859c02982",
                                                "sense_id": "85f4fe71-d07b-3458-b210-16f89333e3a6",
                                                "text": "Der US-Bundesstaat Hawaii begann ebenfalls Evakuierungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "97f1eff2-8957-3529-bd2c-76e16f3cff00",
                                        "entry_id": "38d77c95-b080-33fa-8291-f08c2e16472e",
                                        "glosses": [
                                            "im Pazifik gelegene Insel, die größte der Hawaii-Inseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fff16c-b16a-47b7-8be9-c5a11cf0912f",
                                                "sense_id": "97f1eff2-8957-3529-bd2c-76e16f3cff00",
                                                "text": "Der Vulkan Kilauea auf Hawaii ist noch aktiv."
                                            },
                                            {
                                                "example_id": "25c9ed40-3f62-4104-8209-91b74dafc317",
                                                "sense_id": "97f1eff2-8957-3529-bd2c-76e16f3cff00",
                                                "text": "Nahe der Stadt Hilo auf der Insel Hawaii wurde eine 1,7 Meter hohe Welle gemessen, auf der Insel Maui waren einige Wellen bis zu zwei Meter hoch."
                                            },
                                            {
                                                "example_id": "5db4fa3c-9870-41a3-b017-14d9763827cc",
                                                "sense_id": "97f1eff2-8957-3529-bd2c-76e16f3cff00",
                                                "text": "Das Pazifische Tsunami-Warnzentrum auf Hawaii hatte kurz nach dem Seebeben vor möglichen Überschwemmungen in der Region gewarnt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fef39cc-eceb-4fc7-aac5-928407745b7c",
                        "source_entry_id": "d957732c-4aea-3200-a335-4f298115e48e",
                        "target_lang_word": "Hawaii-Insel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
