                "senses": [
                    {
                        "sense_id": "7ad486c8-c292-3865-8b0b-cc27b0c93276",
                        "entry_id": "a8dadfc1-4d82-3aa8-b2af-710637624329",
                        "glosses": [
                            "Commune française, située dans le département du Cher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4297339-5e3e-40c5-b006-629bfac1bec4",
                                "sense_id": "7ad486c8-c292-3865-8b0b-cc27b0c93276",
                                "text": "La femme supérieure de Sancerre demeurait à La Baudraye, maison de ville et de campagne à la fois, située à dix minutes de la ville, dans le village ou, si vous voulez, le faubourg de Saint-Satur."
                            },
                            {
                                "example_id": "56fefea0-b023-4fdc-b933-2dac090bc9e7",
                                "sense_id": "7ad486c8-c292-3865-8b0b-cc27b0c93276",
                                "text": "J’allais voir ma maîtresse, Éléonore Boursang, installée pour les vacances à la pension Germain, route de Sancerre, à Saint-Thibaut."
                            },
                            {
                                "example_id": "7fe9466a-007f-473f-aac4-0b94e53e7871",
                                "sense_id": "7ad486c8-c292-3865-8b0b-cc27b0c93276",
                                "text": "Je me rends à Sancerre."
                            }
                        ]
                    },
                    {
                        "sense_id": "2026bf4c-f915-3735-8358-6186b7f56b0f",
