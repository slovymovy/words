                "forms": [],
                "senses": [
                    {
                        "sense_id": "6dc877e2-5597-386c-a928-013041356b38",
                        "entry_id": "9a186e3e-08b1-3010-82c3-fa881e7073ab",
                        "glosses": [
                            "наречие к пылкий; ярко, жарко (об огне, пламени и т. п.)"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "e29abac2-240f-4788-865e-03c8cd635722",
                                "sense_id": "6dc877e2-5597-386c-a928-013041356b38",
                                "text": "Утро было морозно, солнце катилось по синеве пылко и лучезарно."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3ea1fc8-036b-361c-aa74-c694cdcc412e",
                        "entry_id": "9a186e3e-08b1-3010-82c3-fa881e7073ab",
                        "glosses": [
                            "перен. страстно, горячо, с жаром"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b846c17-5d7c-4df6-bdfc-39e63805420b",
                                "sense_id": "c3ea1fc8-036b-361c-aa74-c694cdcc412e",
                                "text": "Студент говорил пылко, с тою особенною юношескою страстью, которая кидается навстречу неизвестному будущему безрасчетно и безрассудно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d840345d-cf36-456a-8098-e252baf5c3bd",
