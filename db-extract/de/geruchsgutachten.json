                "senses": [
                    {
                        "sense_id": "78c0e25f-85f2-3a0d-8c68-ded3a12759a7",
                        "entry_id": "d0166614-9160-3f15-b654-582085688c3e",
                        "glosses": [
                            "schriftliches Beurteilung von einem Fachmann oder Sachverständigen, zur Geruchsbelastung um eine Geruchsquelle; Abschätzung der Geruchsemission"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5971af5-6e54-47fa-8e68-c8ff422dfa7a",
                                "sense_id": "78c0e25f-85f2-3a0d-8c68-ded3a12759a7",
                                "text": "„Das LANUV prüft insbesondere die im Rahmen von Einzelfällen wie z.B. Nachbarschaftsbeschwerden vorgelegten Geruchsgutachten auf deren Plausibilität.“"
                            },
                            {
                                "example_id": "d908fa4e-0bba-434e-b4d5-b968ecb90fb0",
                                "sense_id": "78c0e25f-85f2-3a0d-8c68-ded3a12759a7",
                                "text": "„Abhilfe können Geruchsgutachten schaffen. Für eine Geruchsprognose werden aus geruchsrelevanten Daten einer Anlage oder eines landwirtschaftlichen Betriebes (Betriebszeiten, Quellhöhen, Tierzahlen, Abluftmengen etc.), Literaturwerten und geruchsspezifischen Daten aus einer Vielzahl hauseigener Messungen Geruchsemissionen ermittelt.“"
                            },
                            {
                                "example_id": "02fc3224-c8d3-4909-ac7d-d774a55f734d",
                                "sense_id": "78c0e25f-85f2-3a0d-8c68-ded3a12759a7",
                                "text": "„Um den Bau des Schweinemaststalls im Feld genehmigt zu bekommen, muss der Rodenbacher Landwirt Thomas Söhnel kein Geruchsgutachten vorlegen.“"
                            },
                            {
                                "example_id": "3e380046-1e72-427d-b619-ae92013fd8d3",
                                "sense_id": "78c0e25f-85f2-3a0d-8c68-ded3a12759a7",
                                "text": "„Ebenfalls bestätigt ist der Plan, ein weiteres Geruchsgutachten in Auftrag zu geben.“"
                            },
                            {
                                "example_id": "f896c96e-c787-41ba-b9d0-ae43035becba",
                                "sense_id": "78c0e25f-85f2-3a0d-8c68-ded3a12759a7",
                                "text": "„Für eine aktuelle Einschätzung der Machbarkeit der geplanten Baugebietsausweisung hat die Gemeinde Essen die Meodor Borken UG beauftragt, ein ergänzendes Geruchsgutachten auf Grundlage des o.g. Gutachtens von 2010 (Übernahme Tierbestände, meteorologische Daten und weitere Ausbreitungsparameter) unter Berücksichtigung aktueller spezifischer Emissionsfaktoren für die Tierhaltung durchzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
