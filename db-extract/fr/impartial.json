                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a303047-f7d3-4856-8c9e-6551493e9c74",
                        "source_entry_id": "1f4be23d-a92a-34c0-9f7b-802c99273fa5",
                        "source_sense_id": "259e7222-2ac4-3204-9317-56f5516eb2dd",
                        "target_lang_word": "нелицеприятный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нелицеприятный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "772d5344-7ac8-398b-a3d7-8a76c886646f",
                                        "entry_id": "a5588a34-c93c-330e-8295-3671dc428870",
                                        "glosses": [
                                            "книжн. не основанный на лицеприятии, стремлении угодить кому-либо; беспристрастный, справедливый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8d0d02-df01-47cb-9146-b9ced08ed7b2",
                                                "sense_id": "772d5344-7ac8-398b-a3d7-8a76c886646f",
                                                "text": "В настоящее время, во всех концах России, все, даже самые отсталые люди, начинают сознавать живую потребность в суде правом и нелицеприятном."
                                            },
                                            {
                                                "example_id": "b07f5d4e-829e-4e4c-a8df-b320d0ffc65e",
                                                "sense_id": "772d5344-7ac8-398b-a3d7-8a76c886646f",
                                                "text": "У нас не существует нелицеприятного уголовного суда; даже более, наш уголовный суд превратился в какое-то орудие мести."
                                            },
                                            {
                                                "example_id": "5f4d179b-7903-438b-9dc9-974cc45fb4e7",
                                                "sense_id": "772d5344-7ac8-398b-a3d7-8a76c886646f",
                                                "text": "Строгий, мягкий, приятный, нелицеприятный, высоко державший преподавание, — таким видится Николай Дмитриевич."
                                            },
                                            {
                                                "example_id": "53654a51-771d-4c70-8acb-a5f276049882",
                                                "sense_id": "772d5344-7ac8-398b-a3d7-8a76c886646f",
                                                "text": "Во всяком случае, он сумел создать у нас атмосферу искренности и нелицеприятного говорения правды друг другу в глаза, а это одно уже было очень важно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e29646cb-dcf6-327e-b958-b958249c9d00",
                                        "entry_id": "a5588a34-c93c-330e-8295-3671dc428870",
                                        "glosses": [
                                            "разг., неправ. неприятный, грубый, жёсткий, обидный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0757e47b-9a92-40c6-9510-404823386eab",
                                                "sense_id": "e29646cb-dcf6-327e-b958-b958249c9d00",
                                                "text": "Вместо приветствий американского президента встречают плакатами нелицеприятного содержания."
                                            },
                                            {
                                                "example_id": "55d1ca68-aba6-405b-9830-34da9ce44372",
                                                "sense_id": "e29646cb-dcf6-327e-b958-b958249c9d00",
                                                "text": "Во избежание неприятностей и ссор с соседями лишний раз проверьте состояние своей сантехники. Самокритичность позволит избежать нелицеприятных ситуаций."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
