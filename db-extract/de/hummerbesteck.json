                "senses": [
                    {
                        "sense_id": "a0c72c7d-597d-38eb-82bd-92838002b6c2",
                        "entry_id": "debe6eff-fbe2-3f6f-8d67-2b8eebe3e9c0",
                        "glosses": [
                            "besonderes Werkzeug zum Herauslösen des Hummerfleisches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "417b9340-e74f-49c7-90cb-129bb3e157d2",
                                "sense_id": "a0c72c7d-597d-38eb-82bd-92838002b6c2",
                                "text": "„Vermutlich wissen die meisten, die am Tisch formvollendet mit einem Hummerbesteck umgehen können, nichts vom Liebesleben dieser Zehnfußkrebse. Sonst könnte es passieren, dass ihnen beim Auskratzen des Hummerschwanzes eine Träne auf den Teller tropft.“"
                            },
                            {
                                "example_id": "30781d41-19df-4603-bf7e-50ba2a3ce3f8",
                                "sense_id": "a0c72c7d-597d-38eb-82bd-92838002b6c2",
                                "text": "„Mit einem Hummerbesteck fing alles an. Wer immer Schwierigkeiten hatte, die harte Schale der stark eiweißhaltigen Meeresdelikatesse auf elegante Art zu knacken, konnte es bei Lis Droste lernen.“"
                            }
                        ],
