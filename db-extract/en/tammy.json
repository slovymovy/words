                "senses": [
                    {
                        "sense_id": "db7958bf-52cc-3411-9f15-40659dd67a13",
                        "entry_id": "c2f7177c-3933-35ff-b0b8-d7e08659be58",
                        "glosses": [
                            "A female given name popular in the 1960s and the 1970s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "424f7898-b95e-4f67-b0f0-f4ec3dbb9c5c",
                                "sense_id": "db7958bf-52cc-3411-9f15-40659dd67a13",
                                "text": "Wish I knew if he knew\nWhat I'm dreaming of\nTammy, Tammy, Tammy's in love."
                            },
                            {
                                "example_id": "4e4a15d1-30bb-4443-a38a-1dfce2014729",
                                "sense_id": "db7958bf-52cc-3411-9f15-40659dd67a13",
                                "text": "“We are devastated by the tragedy that unfolded Sunday evening in Waukesha,” the statement read. “It is with heavy hearts and great sadness that we inform you of the passing of Tammy Durand, wife of our Executive Chairman Dave Durand. Tammy was an integral part of our family who will be missed dearly by everyone at BVM.”"
                            },
                            {
                                "example_id": "df887093-393f-4756-bfd8-9af3497f6bd4",
                                "sense_id": "db7958bf-52cc-3411-9f15-40659dd67a13",
                                "text": "The pixels’ use in a taxpayer context resulted in the “reckless” sharing of legally protected data that could put taxpayers at risk, according to the report by Warren and her Democratic colleagues Sens. Ron Wyden; Richard Blumenthal; Tammy Duckworth; and Sheldon Whitehouse; Sen. Bernie Sanders, an independent who caucuses with Democrats; and Democratic Rep. Katie Porter."
                            },
                            {
                                "example_id": "95249e2d-4a5a-4a39-a0a2-0efb6edb7f1f",
                                "sense_id": "db7958bf-52cc-3411-9f15-40659dd67a13",
                                "text": "Tammy Baldwin, the two-term Wisconsin Democrat, didn’t attend President Joe Biden’s post-debate rally in the state earlier this month."
                            }
                        ]
                    }
                ],
