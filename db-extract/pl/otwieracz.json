                                        "examples": [
                                            {
                                                "example_id": "0b50e541-22bc-4c5e-86c8-91f323d4cf65",
                                                "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                                                "text": "Der Öffner der Schaltung hat nur eine Wirkung, wenn er nicht vom Schließer des anderen Schützes überbrückt wird."
                                            },
                                            {
                                                "example_id": "5de8197d-c5d4-4829-8695-39b3d8632bbd",
                                                "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                                                "text": "NOT-Aus-Taster sind Öffner."
                                            },
                                            {
                                                "example_id": "e9d3becf-1762-4520-be6f-f0f55d0175ad",
                                                "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                                                "text": "Bei Betätigung stellen Einschalter als Schließer Kontaktverbindungen her, während Öffner Verbindungen trennen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
