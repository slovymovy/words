                    {
                        "sense_id": "089c0a5d-35e4-344c-a4b3-12f63f0729dc",
                        "entry_id": "c126dae2-3696-3223-a076-260995aa8ce0",
                        "glosses": [
                            "iets dat gebruikt wordt om een andere zaak gemakkelijker te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7519f939-f0f9-4f4a-907c-a2744f726032",
                                "sense_id": "089c0a5d-35e4-344c-a4b3-12f63f0729dc",
                                "text": "Bord en krijt zijn vanouds belangrijke hulpmiddelen bij klassikaal onderricht."
                            },
                            {
                                "example_id": "5ddc7f37-8afd-425e-b076-0ec340592c46",
                                "sense_id": "089c0a5d-35e4-344c-a4b3-12f63f0729dc",
                                "text": "Uit het onderzoek blijkt dat medische hulpmiddelen die als 'veilig' op de markt zijn gebracht, de afgelopen tien jaar kunnen worden gekoppeld aan 1,7 miljoen gevallen van letsel en bijna 83.000 doden."
                            },
                            {
                                "example_id": "0a081b80-cb2c-4970-afb0-827d22c8224b",
                                "sense_id": "089c0a5d-35e4-344c-a4b3-12f63f0729dc",
                                "text": "Ik had een grote powerbank die mijn telefoon 12 keer kon opladen, dus besloot ik het vanaf toen alleen met digitale hulpmiddelen te doen."
                            }
                        ]
                    }
                ],
