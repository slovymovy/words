                        "glosses": [
                            "groep mensen die de belangen behartigt namens alle huurders van één of meer wooncomplexen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85872e46-3874-4d00-abaf-5f10814b2f63",
                                "sense_id": "b43bfa8a-c2d3-3ca3-a492-683cc8971313",
                                "text": "Ook in Deventer is de ervaring dat uitbreiding van het bestaande centrum makkelijker gaat. “We hebben aan een bewonerscommissie gevraagd of we nog een inspraakavond moesten houden over de uitbreiding van het aantal plekken in het AZC in Schalkhaar, zegt een woordvoerder van de gemeente. “Maar dat vonden ze niet nodig.”"
                            },
                            {
                                "example_id": "734abbb1-d9b6-45f6-86f8-45f7294e0747",
                                "sense_id": "b43bfa8a-c2d3-3ca3-a492-683cc8971313",
                                "text": "De kozijnen van een rij huizen in de Amsterdamse Jordaan zijn bijna helemaal doorgerot. Tamar Stern, voorzitter van de bewonerscommissie, laat zien wat er aan de woningen mankeert. Het is duidelijk, een opknapbeurt is nodig."
                            },
                            {
                                "example_id": "76eb4d6e-8483-4a0e-b048-c1e8ca07db72",
                                "sense_id": "b43bfa8a-c2d3-3ca3-a492-683cc8971313",
                                "text": "De Molukse wijk in Hoogeveen blijft louter bestemd voor Molukkers. Dat is de uitkomst van een gesprek tussen de gemeente, woningstichting Domesta en de bewonerscommissie Maluku Maju."
                            }
                        ]
