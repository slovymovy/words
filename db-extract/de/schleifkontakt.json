                "senses": [
                    {
                        "sense_id": "b95c5a60-b821-341b-976a-ed99bcf2321b",
                        "entry_id": "1457017e-8c7b-347b-b052-7f911aa3a0a1",
                        "glosses": [
                            "elektrisch leitende Verbindung, zwischen beweglichen Teilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33c93ef-1da4-4e73-92ad-71c57f75c53e",
                                "sense_id": "b95c5a60-b821-341b-976a-ed99bcf2321b",
                                "text": "„Wie stark er ist, hängt von der Position eines Kontakts ab, der entlang eines leitfähigen Untergrundes geführt wird (auch Gleitkontakt oder Schleifkontakt genannt).“"
                            },
                            {
                                "example_id": "e4d4da1e-427e-43b8-a8de-10bd341cea4d",
                                "sense_id": "b95c5a60-b821-341b-976a-ed99bcf2321b",
                                "text": "„Diese Ströme werden durch einen Schleifkontakt am Rande der Scheibe abgeleitet und durch eine um die Rotationsachse symmetrische Spule geleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
