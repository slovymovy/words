                "senses": [
                    {
                        "sense_id": "d72640a1-9707-38aa-ae72-203fa585f6e4",
                        "entry_id": "568f8581-5971-34d8-a0e5-d16c0d9d1672",
                        "glosses": [
                            "A nigger."
                        ],
                        "tags": [
                            "ethnic",
                            "offensive",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "936d8363-2ce7-471d-ae7e-5242b844a323",
                                "sense_id": "d72640a1-9707-38aa-ae72-203fa585f6e4",
                                "text": "Cotton-eyed Joe, Cotton-eyed Joe,\nHe was de nig dat sarved me so,…"
                            },
                            {
                                "example_id": "9048b7e7-a20b-4be0-bc57-4a99cebcdfbf",
                                "sense_id": "d72640a1-9707-38aa-ae72-203fa585f6e4",
                                "text": "He always thought one step ahead of the nigs."
                            },
                            {
                                "example_id": "c67a8bf5-7469-4d69-95de-c464294ceea8",
                                "sense_id": "d72640a1-9707-38aa-ae72-203fa585f6e4",
                                "text": "In a field near the house was a nigger working a poor old broken-down mule and another nigger sowing wheat. When we came up, both nigs quit work and stared at us."
                            },
                            {
                                "example_id": "d5c4c4bd-49df-4aac-bebb-ac4a345f9640",
                                "sense_id": "d72640a1-9707-38aa-ae72-203fa585f6e4",
                                "text": "What part did she play in your marrying a nig — a black man — nig, nig — Negro?"
                            }
                        ]
                    },
                    {
                        "sense_id": "2a4d8555-9183-3791-a208-6c5942ee193c",
                        "entry_id": "568f8581-5971-34d8-a0e5-d16c0d9d1672",
                        "glosses": [
                            "Clipping of nigga (“friend, fellow black person”)."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping"
                        ],
                        "examples": [
                            {
                                "example_id": "ce6ae9d0-c53a-4e16-9c20-e9a19903e23f",
                                "sense_id": "2a4d8555-9183-3791-a208-6c5942ee193c",
                                "text": "Take Blow, my room dawg and fraternity brother from back in the college days. He's a real smoove nig, curly haired handsome, and got mad chick appeal."
                            }
                        ]
                    }
                ],
