                "senses": [
                    {
                        "sense_id": "ab97c1f1-82a8-3eb6-90f5-09ccd9e52c7f",
                        "entry_id": "adc5c702-08d6-3ced-a109-83c06e7167b3",
                        "glosses": [
                            "Qui est prématuré, qui devance le moment convenable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d3d860-4548-47d7-a365-3bfb26020c2b",
                                "sense_id": "ab97c1f1-82a8-3eb6-90f5-09ccd9e52c7f",
                                "text": "Une espérance anticipée."
                            },
                            {
                                "example_id": "62d559ec-de05-4e18-b21f-77f8bf337d83",
                                "sense_id": "ab97c1f1-82a8-3eb6-90f5-09ccd9e52c7f",
                                "text": "Une douleur, une crainte anticipée."
                            },
                            {
                                "example_id": "d5e7f64c-ce69-4c65-91dc-4b4599ac1e22",
                                "sense_id": "ab97c1f1-82a8-3eb6-90f5-09ccd9e52c7f",
                                "text": "Des regrets anticipés."
                            },
                            {
                                "example_id": "6eef5a3d-0426-4c50-bbbb-8db6196a45c7",
                                "sense_id": "ab97c1f1-82a8-3eb6-90f5-09ccd9e52c7f",
                                "text": "Une connaissance anticipée de ce que l’on devrait encore ignorer."
                            },
                            {
                                "example_id": "1e4f2c94-b857-400a-9e6e-42fb5456ac48",
                                "sense_id": "ab97c1f1-82a8-3eb6-90f5-09ccd9e52c7f",
                                "text": "Il avait travaillé sur les bases de données mondiales et avait anticipé la crise qui est arrivée en mars."
                            }
                        ]
                    }
