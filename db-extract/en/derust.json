                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dérouiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3510e87-a320-36d6-b357-7c2bdbc0c4ce",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Débarrasser de la rouille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3925b749-7536-48c4-9884-224872a986a9",
                                                "sense_id": "e3510e87-a320-36d6-b357-7c2bdbc0c4ce",
                                                "text": "La porte en fer forgé est trop vieille, on n’arrive plus à la dérouiller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e4d774b-c2e7-39db-a411-5d3412e90d4f",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Remettre une personne ou une de ses facultés physiques ou intellectuelles en état de fonctionner normalement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b692fdc-1f64-4da0-accb-9421c9d4f521",
                                                "sense_id": "8e4d774b-c2e7-39db-a411-5d3412e90d4f",
                                                "text": "Il n’écrivait plus depuis un certain temps, il a fallu le dérouiller !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ecd710f-c875-31cf-9d33-cd4272258304",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Donner une correction, une raclée (une dérouillée)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7964428b-bfec-4573-8c2c-08120a002629",
                                                "sense_id": "7ecd710f-c875-31cf-9d33-cd4272258304",
                                                "text": "J’ai connu des types qui sont venus exprès du Texas ou de Californie à New-York dans l’espoir de mettre la main sur lui et lui flanquer une rossée. Et quand je dit rossée, je suis timide — je veux dire le dérouiller, l’aplatir comme une crêpe."
                                            },
                                            {
                                                "example_id": "15d47363-1f6f-460d-a6f4-f73fc5e00f44",
                                                "sense_id": "7ecd710f-c875-31cf-9d33-cd4272258304",
                                                "text": "– Il la frappait ?\n– Il lui foutait sur la gueule. Ils ont passé un peu plus d'une semaine à Reugny. Il l’a dérouillée deux fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6acf15cc-2e64-3d7c-9d57-d2c342d6afaa",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Perdre sa rouille."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54578f5a-6b3e-4b93-945d-c751b38d2c57",
                                                "sense_id": "6acf15cc-2e64-3d7c-9d57-d2c342d6afaa",
                                                "text": "La serrure se dérouille peu à peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4528d04-2c77-3204-8fa2-cf4547755798",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Retrouver un fonctionnement normal, retrouver son agilité."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75159666-d66a-4bb0-b94d-0101bc1d2b63",
                                                "sense_id": "e4528d04-2c77-3204-8fa2-cf4547755798",
                                                "text": "Ma mémoire commence à se dérouiller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12903aa2-2f34-36ff-a89e-039ea37d7358",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Recevoir une correction, une raclée."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "675c9de7-475e-4070-a0eb-86678446757a",
                                                "sense_id": "12903aa2-2f34-36ff-a89e-039ea37d7358",
                                                "text": "Il a sérieusement dérouillé, ils s’y sont mis à trois pour le tabasser !"
                                            },
                                            {
                                                "example_id": "af9db423-36df-4fc3-9a16-edd93d082dd2",
                                                "sense_id": "12903aa2-2f34-36ff-a89e-039ea37d7358",
                                                "text": "— I dérouillent ! I dérouillent, les Fridolins !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c9acd81-48aa-30eb-9aee-078e155d40ae",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Subir les séquelles, souffrir des conséquences de quelque chose."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478c6d3e-ac6b-4259-a50d-27d0987af4ab",
                                                "sense_id": "2c9acd81-48aa-30eb-9aee-078e155d40ae",
                                                "text": "J’ai dérouillé depuis quelques mois : ma mère est morte, j’ai été opéré d’un cancer …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "336788f7-92d8-35a8-a763-ef3ea0a1bce4",
                                        "entry_id": "9af1acca-593d-3533-87d3-879e5d32c8a6",
                                        "glosses": [
                                            "Avoir une relation sexuelle avec une prostituée."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ec4196b-9e33-4aef-b7f4-ca94e770485f",
                                                "sense_id": "336788f7-92d8-35a8-a763-ef3ea0a1bce4",
                                                "text": "— T’as jamais été au boxon, j’suis sûr, même pour boire un coup ?\n— Non, dit encore Simon.\n— Vous entendez, les gars ? Il a pas encore dérouillé, Chalume !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
