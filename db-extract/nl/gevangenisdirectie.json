                        "examples": [
                            {
                                "example_id": "c685cc0f-22d1-44da-ae67-166017e2218e",
                                "sense_id": "58a859f7-d6eb-35a5-ad21-1f04acadfbad",
                                "text": "Toen de gevangene werd binnengebracht in de gevangenis, wist de gevangenisdirectie dat het risico bestond dat de gevangene zelfmoord kon plegen. Na een gesprek met de gevangene, waarbij onder anderen een psycholoog aanwezig was, zag men geen acuut gevaar voor zelfmoord. De gevangene maakte een rustige indruk, zei een woordvoerder van justitie. Op een vraag van een journalist of de psycholoog ervaring had met terreurverdachten, was het antwoord nee."
                            },
                            {
                                "example_id": "5f6749cd-9ab4-453e-bfad-d5c92e290b3c",
                                "sense_id": "58a859f7-d6eb-35a5-ad21-1f04acadfbad",
                                "text": "Volgens Seebregts zijn er nu gesprekken over het regime met de gevangenisdirectie. Het ministerie van Veiligheid en Justitie bevestigt in het AD dat er gesprekken zijn, maar zegt dat het manifest niet de aanleiding daarvoor is."
                            }
                        ]
                    }
