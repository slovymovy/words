                    {
                        "translation_id": "816ff1be-61ef-4ed2-b12f-60777c2cb6f8",
                        "source_entry_id": "5da66afc-7373-35dc-8549-311bd749b6a5",
                        "source_sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
