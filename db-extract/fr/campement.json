        "fr-extract.jsonl": [
            {
                "entry_id": "e121cf00-c20b-3d29-826b-2188df3817a3",
                "word": "campement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dccf7990-6bbd-45d3-874f-3042af7a513c",
                        "entry_id": "e121cf00-c20b-3d29-826b-2188df3817a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "campements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                        "entry_id": "e121cf00-c20b-3d29-826b-2188df3817a3",
                        "glosses": [
                            "Action de camper, ou le camp lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d153910b-4f77-4cd3-8cf1-f7526fb17584",
                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                "text": "Une demi-heure après, ils atteignaient leur campement situé dans une étroite gorge de la vallée, où les attendait le chariot gardé par deux conducteurs de race boschjesmane."
                            },
                            {
                                "example_id": "c9b8d23b-51de-459c-b3bf-81b98b5f18ea",
                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                "text": "Enfin, je finis par m’arrêter, comprenant que j’avais fait fausse route et que j’avais dû dépasser le campement."
                            },
                            {
                                "example_id": "0e3d0c09-115c-4c2b-b002-8c9c6e075e3e",
                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                "text": "A la tombée de la nuit, six hommes de garde envoyés par le caïd sont venus s’accroupir autour de notre petit campement pour veiller à notre sécurité."
                            },
                            {
                                "example_id": "82b9d3f0-8183-406a-9d8f-2199101eb46c",
                                "sense_id": "47401abf-9865-3a51-826a-db373ff1d2a3",
                                "text": "Un campement à la bordure d’une forêt, et éclairé par quelques bougies, donne d’étranges apparences ; je crus voir une falaise et des cavernes ; je revis ce lieu plus d’une fois ; jamais je n’y pus reconnaître ma première impression."
                            }
                        ]
                    },
                    {
                        "sense_id": "46530c85-6e95-3eab-9261-7dc3bee1e827",
                        "entry_id": "e121cf00-c20b-3d29-826b-2188df3817a3",
                        "glosses": [
                            "Objets nécessaires pour camper."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
