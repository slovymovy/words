                        "glosses": [
                            "Dire des bêtises, ou faire des bêtises."
                        ],
                        "tags": [
                            "Sète"
                        ],
                        "examples": [
                            {
                                "example_id": "645f54fa-ae1c-4be5-a139-e706f9cc043f",
                                "sense_id": "c5fbac35-7894-3c94-9c1a-11ef306439b7",
                                "text": "Dire de tel enfant qu’il est tissous, que c’est un goulamas et qu’il nous dévarie, ce n’est pas forcément débourronner."
                            },
                            {
                                "example_id": "1a6db14b-d0d3-435b-a114-7113ba3530d6",
                                "sense_id": "c5fbac35-7894-3c94-9c1a-11ef306439b7",
                                "text": "Alors arrêter un peu de débourronner sur le tout le monde, ca devient CHIANT à force.....!!!!!!!!"
                            },
                            {
                                "example_id": "f9550d7a-c154-41e6-9437-1be83aa05626",
                                "sense_id": "c5fbac35-7894-3c94-9c1a-11ef306439b7",
                                "text": "J’aime débourronner moins être embrousiné."
                            }
                        ]
                    }
