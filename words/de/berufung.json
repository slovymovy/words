                    "frequency": "Middle",
                    "semantic_group_id": "ernennung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Wissenschaftlerin freute sich über ihre <w>Berufung</w> an die renommierte Universität."
