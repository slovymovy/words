                "senses": [
                    {
                        "sense_id": "8112629c-6ca8-39bd-bca4-8eeb10542599",
                        "entry_id": "57676a08-ffcf-362e-a91f-3a2f80dc7619",
                        "glosses": [
                            "Donner un caractère azerbaïdjanais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc59172b-30e1-4567-a3fa-75bd0e26d550",
                                "sense_id": "8112629c-6ca8-39bd-bca4-8eeb10542599",
                                "text": "À Bakou, la population rurale a contribué à « azerbaïdjaniser » une ville auparavant russophone."
                            },
                            {
                                "example_id": "ffd8208c-81b0-4012-af55-dd52911fe45b",
                                "sense_id": "8112629c-6ca8-39bd-bca4-8eeb10542599",
                                "text": "Aujourd'hui, on assiste à des tentatives pour les azerbaïdjaniser, en les présentant comme l’archétype de la population azerbaïdjanaise du fait de son mode de vie authentique."
                            },
                            {
                                "example_id": "8e45fe53-7ad9-40a5-b1f6-a8b003328fdc",
                                "sense_id": "8112629c-6ca8-39bd-bca4-8eeb10542599",
                                "text": "il [Koroglu] est considéré comme un Turc [Azerbaïdjanais] par les Turcs [Azerbaïdjanais], comme un Kurde par les Kurdes et comme un Arménien azerbaïdjanisé par les Arméniens."
                            }
                        ]
                    }
