                "senses": [
                    {
                        "sense_id": "6d5d7f6e-b698-310c-9603-e26ca3738a39",
                        "entry_id": "9056083d-1d41-381e-9e5a-8fb760040689",
                        "glosses": [
                            "Sorte de pirogue originaire des peuples d’Amérique du nord dans laquelle un ou plusieurs utilisateurs propulsent le bateau à l’aide d’une pagaie à une pale."
                        ],
                        "tags": [
                            "Navigation",
                            "Canoë-kayak"
                        ],
                        "examples": [
                            {
                                "example_id": "0a25f0a5-f8b4-4657-897f-7a2553d8f3b2",
                                "sense_id": "6d5d7f6e-b698-310c-9603-e26ca3738a39",
                                "text": "Le canoë a remis en honneur les rivières de France abandonnées."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0b2ac7a-2741-3d11-8742-06f879be0098",
                        "entry_id": "9056083d-1d41-381e-9e5a-8fb760040689",
                        "glosses": [
                            "Sport nautique qui se pratique avec cette embarcation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c903d3c1-13ac-4600-a2d1-b06433cd2f33",
                                "sense_id": "c0b2ac7a-2741-3d11-8742-06f879be0098",
                                "text": "Nous proposons des activités nautiques en canoë, kayak, raft, pour le loisir et la compétition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8ce5b13-8399-47cb-a152-1632738d8c65",
                        "source_entry_id": "9056083d-1d41-381e-9e5a-8fb760040689",
                        "target_lang_word": "Kanu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                        "entry_id": "d280d2e8-3025-3587-808f-22c1ed17d9d4",
                                        "glosses": [
                                            "Sportboot, das mit Paddeln bewegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f19b02-2074-4f5d-8fad-57387586095c",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "Viele Inseln wurden mit Kanus besiedelt."
                                            },
                                            {
                                                "example_id": "17965762-ef59-481c-aaa5-d29ff2a53155",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Die Beförderung der Handelswaren von den Kanus zum Lagerhaus im fünf Kilometer entfernten Jakin war Sache von Trägern, die nach Leistung bezahlt wurden.“"
                                            },
                                            {
                                                "example_id": "68b03fde-bfd6-4b10-b3c5-42188706360d",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Dazwischen zogen Tausende von braunen Kanus ihre Bahnen; die Mexica lebten im See und nicht an Land.“"
                                            },
                                            {
                                                "example_id": "b2ee3548-1ff3-4a95-ad27-65116ff47826",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Es waren Männer in Kanus erschienen und hatten auf Muschelhörnern geblasen.“"
                                            },
                                            {
                                                "example_id": "fa446be2-b3bd-4038-9cf7-7032853bbf87",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Als wir wieder an Bord des Schoners zurückkehrten, fanden wir ein Kanu, das quer vor den Bug getrieben und festgemacht worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d354564-5554-49df-9a72-9ec8eafb71c0",
                        "source_entry_id": "9056083d-1d41-381e-9e5a-8fb760040689",
                        "target_lang_word": "canoe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canoe",
