                        ],
                        "form": "согбе́нна"
                    },
                    {
                        "form_id": "d4c8cc39-d388-4392-bf29-d22a30081afd",
                        "entry_id": "90717c14-1fec-3899-a5d4-53da76ee6e38",
                        "tags": [
                            "plural",
