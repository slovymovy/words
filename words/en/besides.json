                                "target_lang_word": "除了",
                                "target_lang_sense_clarification": "表示排除"
                            },
                            {
                                "target_lang_word": "除……之外",
                                "target_lang_sense_clarification": "正式用法"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "oprócz",
                                "target_lang_sense_clarification": "w znaczeniu z wyłączeniem"
                            },
                            {
                                "target_lang_word": "poza",
                                "target_lang_sense_clarification": "w znaczeniu z wyłączeniem"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sauf",
                                "target_lang_sense_clarification": "très courant pour exprimer une exception"
                            },
