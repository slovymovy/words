                "translations": [
                    {
                        "translation_id": "ff1143e5-5d20-4271-b4e6-6ce0d7880524",
                        "source_entry_id": "f1907aa2-1aa0-337d-afaa-1472d7133a22",
                        "source_sense_id": "504423d2-55ff-39ea-8702-2014a50eeb08",
                        "target_lang_word": "hypertension",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypertension",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f05c5c2f-b630-3a5f-add7-af0cc3288d0c",
                                        "entry_id": "5eb6fd56-2e16-34a5-8987-4f0adc9a87c0",
                                        "glosses": [
                                            "A state of abnormally high blood pressure of arterial blood (arterial hypertension) or of the intra-ocular fluid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244ff09c-5d89-4fbd-b3ad-9c6fdcf72ffc",
                                                "sense_id": "f05c5c2f-b630-3a5f-add7-af0cc3288d0c",
                                                "text": "Once stroke was classified by a risk factor-free method, the stronger relationship between hypertension and lacunar versus nonlacunar infarction patients disappeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d080bab-c60d-3cbe-8822-21ce867f6d05",
                                        "entry_id": "5eb6fd56-2e16-34a5-8987-4f0adc9a87c0",
                                        "glosses": [
                                            "A state of great (nervous or emotional) tension."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2888659f-2222-48da-be79-6bfc9e240bc7",
                                                "sense_id": "5d080bab-c60d-3cbe-8822-21ce867f6d05",
                                                "text": "The opportunity for which she had been tensely waiting was upon her. In a few minutes, as this hypertension and ruthlessness faded in her, it would be gone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
