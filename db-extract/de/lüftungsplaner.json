                "senses": [
                    {
                        "sense_id": "d24f4602-ee6a-373a-9a33-49e83d0d07b2",
                        "entry_id": "4543d65f-3fea-39ff-969a-90fa9b88a948",
                        "glosses": [
                            "(männliche^☆) Person, die (beruflich) Lüftungsanlagen plant und Lüftungskonzepte ausarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b76e055-d816-4228-85c0-085543ab2581",
                                "sense_id": "d24f4602-ee6a-373a-9a33-49e83d0d07b2",
                                "text": "„Das Merkblatt ist Arbeitsgrundlage für den Lüftungsplaner und gilt für Wohnungslüftungen mit Zu- und Abluft sowie Wärmerückgewinnung.“"
                            },
                            {
                                "example_id": "a3464fb5-308c-473f-bf8d-9db4a180f400",
                                "sense_id": "d24f4602-ee6a-373a-9a33-49e83d0d07b2",
                                "text": "„Und sollte er irgendwann nicht mehr gefragt sein, wird er vielleicht wieder als Lüftungsplaner arbeiten.“"
                            },
                            {
                                "example_id": "684efef5-b831-427f-a7a3-e44c0c0b6245",
                                "sense_id": "d24f4602-ee6a-373a-9a33-49e83d0d07b2",
                                "text": "„Diesbezüglich sollte sich die Architektin oder der Lüftungsplaner keinerlei Illusionen hingeben: Lüftungsgeräusche beeinträchtigen den Wohnkomfort und führen zu jahrelangen Auseinandersetzungen zwischen Bewohnern und Verwaltung respektive Eigentümerschaft. Fazit: sorgfältig planen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b0d6be8-629c-31e4-9a58-5302933fd2a0",
                        "entry_id": "4543d65f-3fea-39ff-969a-90fa9b88a948",
                        "glosses": [
                            "Computerprogramm das [1] unterstützt und Interessenten frei zugänglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bb444e3-1bcd-4382-8c51-29f0fb822b32",
                                "sense_id": "3b0d6be8-629c-31e4-9a58-5302933fd2a0",
                                "text": "„Der Lüftungsplaner von energiewelt.de unterstützt Sie bei der Planung und Installation Ihrer Lüftungsanlage.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
