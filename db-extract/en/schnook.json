                        ],
                        "form": "schnooks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
                        "entry_id": "5ce187ff-c7b4-32d7-8014-41037c1a5dcc",
                        "glosses": [
                            "A person who is easily taken advantage of."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "124f6283-4c1e-46d0-bc14-c19bae7f93d9",
                                "sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
                                "text": "He’s just a schnook. She’s obviously using him but he keeps coming back for more abuse."
                            },
                            {
                                "example_id": "0795e6cf-9a41-4b42-b7e1-1c43f6e948e3",
                                "sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
                                "text": "The Apartment. Producer-Director Billy Wilder tells of a sweet-natured schnook (brilliantly played by Jack Lemmon) who shoots up the corporate ladder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c52f0f9-282f-4b73-9f8a-2b34ee38b35f",
                        "source_entry_id": "5ce187ff-c7b4-32d7-8014-41037c1a5dcc",
                        "source_sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
                        "source_sense_description": "a person, easily taken advantage of",
                        "target_lang_word": "Depp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Depp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cc4ee30-6935-3af9-8a95-86b8e7469aa0",
                                        "entry_id": "7cc9de60-f499-3765-95a7-993c7408c097",
                                        "glosses": [
                                            "Mensch mit geringerer Intelligenz oder Vernunft als die Allgemeinheit"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc48196a-3ef7-4aa0-8f8a-909c86301443",
                                                "sense_id": "9cc4ee30-6935-3af9-8a95-86b8e7469aa0",
                                                "text": "Was macht der Depp da?"
                                            },
                                            {
                                                "example_id": "7e247fae-0230-489a-9508-a29210b70b6e",
                                                "sense_id": "9cc4ee30-6935-3af9-8a95-86b8e7469aa0",
                                                "text": "„Neben den Pflanzen lagen Zettel, die Deppen wie mich über die magische Wirkung der Mittel aufklärten.“"
                                            },
                                            {
                                                "example_id": "e3df8f51-79bd-4aad-bbf8-7cb1c85d8100",
                                                "sense_id": "9cc4ee30-6935-3af9-8a95-86b8e7469aa0",
                                                "text": "„In Amerika hingegen ist der Depp in unverschämter Weise stolz auf seine Dummheit, so sehr, dass er letztlich zum Führer politischer Diskurse und ideologisch dominanter Fraktionen einer ganzen Partei werden kann.“"
                                            },
                                            {
                                                "example_id": "ab7e9184-3691-49e9-ac28-934ca1a68a4d",
                                                "sense_id": "9cc4ee30-6935-3af9-8a95-86b8e7469aa0",
                                                "text": "„Der Club, der sich selbst gern einen Depp nennt, ist nach 21 Spielen natürlich noch längst nicht abgestiegen.“"
                                            },
                                            {
                                                "example_id": "628a62ff-0099-4874-8451-379c397a034b",
                                                "sense_id": "9cc4ee30-6935-3af9-8a95-86b8e7469aa0",
                                                "text": "„Neun Tage lang verweigerte er die Nahrungsaufnahme, er wurde in ein Lazarett gesteckt, dort spielte er so lange den Deppen, bis ein Arzt diese Diagnose übernahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1538ea3-5bf8-4874-a5bb-b6be44103388",
                        "source_entry_id": "5ce187ff-c7b4-32d7-8014-41037c1a5dcc",
                        "source_sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
                        "source_sense_description": "a person, easily taken advantage of",
                        "target_lang_word": "Trottel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trottel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "736e3158-9063-3308-9050-c16422aca6d9",
                                        "entry_id": "ae433b48-4870-3a29-a3c5-e00d1ac4e2da",
                                        "glosses": [
                                            "schwachsinniger Mensch, ein unter Kretinismus leidender Mensch"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9af5b9a-3559-4c27-8bb4-20231cd183a9",
                                                "sense_id": "736e3158-9063-3308-9050-c16422aca6d9",
                                                "text": "Er ist nur ein harmloser Trottel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                        "entry_id": "ae433b48-4870-3a29-a3c5-e00d1ac4e2da",
                                        "glosses": [
                                            "ein nicht sehr kluger oder nur wenig gebildeter, einfältiger Mensch"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4d7f849-8803-44ce-bcad-f49e6100021f",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "Der Trottel kann nicht mal richtig lesen."
                                            },
                                            {
                                                "example_id": "a3db7a22-fb29-41b7-9d79-f44438be8028",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Der Mann meiner Wirtin ist ganz liebenswürdig, aber – so scheint mir – ein Trottel, dessen einzige Fähigkeit darin besteht, sich die Liebe seiner Frau zu erhalten, der er reizende Kinder zeugte.“"
                                            },
                                            {
                                                "example_id": "6b07f80d-0a77-4131-af58-413d13dc0d43",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie kam mir so vernünftig vor. Dabei ist sie ein Trottel.“"
                                            },
                                            {
                                                "example_id": "df0f6513-126f-4917-ade6-b0b7b1b9fa7e",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie ist ein Trottel! Sie hat den Wert eines Fabergé-Eis zerstört!“"
                                            },
                                            {
                                                "example_id": "8eb22c01-f9e9-4093-a144-e91eaa10729b",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie war ein Trottel. Das Schild hing seit ihrem sechsten Lebensjahr dort.“"
                                            },
                                            {
                                                "example_id": "c3feeace-4d3d-47a4-aee7-9805c14b7d39",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie war ein Trottel gewesen, als sie daran geglaubt hatte, dass ein Mann wie er helfen könnte.“"
                                            },
                                            {
                                                "example_id": "60f920ff-fdc0-4dcc-86fd-599be9986392",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Tori hatte recht. Sie war ein Trottel.“"
                                            },
                                            {
                                                "example_id": "b84c66b6-efc6-40c1-8002-00fb1c2d4289",
                                                "sense_id": "d0a9c210-e19f-3d2a-b88b-56cd16d9181b",
                                                "text": "„Sie ist ein Trottel. Sie glaubt alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e7cd19c5-09c5-300a-a8ca-ff32397e6a5b",
                                        "entry_id": "ae433b48-4870-3a29-a3c5-e00d1ac4e2da",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca0cb8ec-f43c-432a-82b2-6c100adf1a78",
                                                "sense_id": "e7cd19c5-09c5-300a-a8ca-ff32397e6a5b",
                                                "text": "Welcher Trottel hat hier alles verstellt?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fe794dc-3e0f-4135-8c64-5de7a80651ef",
                        "source_entry_id": "5ce187ff-c7b4-32d7-8014-41037c1a5dcc",
                        "source_sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
                        "source_sense_description": "a person, easily taken advantage of",
                        "target_lang_word": "Schwachkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwachkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                        "entry_id": "b1503b93-8814-3d97-ac89-aa2dc89ef814",
                                        "glosses": [
                                            "Person, die man für geistig minderbemittelt hält; jemand, der nichts begreift"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc823dd6-7694-4ea9-9efd-7d93cecd2262",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "Man hat noch selten einen Schwachkopf wie dich erlebt."
                                            },
                                            {
                                                "example_id": "b517b2fe-0057-4f58-ab91-e5b86c73b5f6",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "Er versteht gar nichts, er ist ein richtiger Schwachkopf."
                                            },
                                            {
                                                "example_id": "3b3353a4-e562-4971-b30a-5ca645b408d9",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Dass ein Schwachkopf weniger fähig sein mag, die Schönheit einer Symphonie oder eines subtilen Gedankengangs zu genießen, glaubt man ohne Weiteres, im Hinblick auf beispielsweise eine Fellatio hingegen überrascht es; die Erfahrung bestätigt es dennoch.“"
                                            },
                                            {
                                                "example_id": "3b862ffc-9ccb-48b4-8d7a-434c4d216b44",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Ich war sehr besorgt, denn wenn der Geistliche kein Schwachkopf war, konnte ihm nicht verborgen bleiben, daß die Verblichene an Gift gestorben war.“"
                                            },
                                            {
                                                "example_id": "3019a9d8-ba2e-4d3c-b9a4-2e5b02b62372",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Sie schienen nicht zu merken, was für ein Schwachkopf ich geworden war.“"
                                            },
                                            {
                                                "example_id": "1d4d6de9-fddd-4a8c-abbd-e3c7dec50def",
                                                "sense_id": "2d026170-5da0-3c20-a94d-ac1a178b220d",
                                                "text": "„Einmal, vor etwa achtzehn Monaten, habe ich über einhundert Stiche gebraucht, bis dieser Schwachkopf damals endlich tot war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aa80e3b-4762-4040-9114-c10f858086b9",
                        "source_entry_id": "5ce187ff-c7b4-32d7-8014-41037c1a5dcc",
                        "source_sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
