                "senses": [
                    {
                        "sense_id": "9a0f6382-a8b0-3a8f-96d5-9677b869d1ec",
                        "entry_id": "ed5bfe86-12f5-34e2-a120-40b144bf252f",
                        "glosses": [
                            "Mikrofon, das außen direkt am Kehlkopf anliegend getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90a2e8a-30fc-487b-8ac2-0a6d55764db3",
                                "sense_id": "9a0f6382-a8b0-3a8f-96d5-9677b869d1ec",
                                "text": "„Ohne ihre Harris-Falcon-Kurzwellenfunkgeräte mit den Kehlkopfmikrofonen wären die Worte der Männer im Niemandsland jenseits ihrer Nachtsichtgeräte vom Lärm verschluckt worden.“"
                            },
                            {
                                "example_id": "533e8395-3ecf-4ef4-9461-ba5191ff7473",
                                "sense_id": "9a0f6382-a8b0-3a8f-96d5-9677b869d1ec",
                                "text": "„›Basis, hier ist Aufklärung Zwei. Wir haben die Entsorgungsanlage erreicht‹, sagte er in sein Kehlkopfmikrofon.“"
                            },
                            {
                                "example_id": "a3d00c2e-0163-468a-a53b-280244bf1b48",
                                "sense_id": "9a0f6382-a8b0-3a8f-96d5-9677b869d1ec",
                                "text": "„Vor ihnen entquillt einer Limousine das Gefolge irgendeiner Minirockpuppe, dünne Gestalten mit Kehlkopfmikrofonen und Ohrstöpseln am Kopf, jeder von ihnen im Gespräch mit jemandem, der weit weg ist.“"
                            },
                            {
                                "example_id": "01d29fa8-22d5-4a81-a72f-cef8e84be327",
                                "sense_id": "9a0f6382-a8b0-3a8f-96d5-9677b869d1ec",
                                "text": "„Ich fummelte an meinem Kehlkopfmikrofon herum, überprüfte meine bluetoothfähigen Ohrstöpsel und drückte erneut die Sendetaste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
