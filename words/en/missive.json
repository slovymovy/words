                    "sense_definition": "Intended to be thrown or launched as a weapon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers launched their <w>missive</w> spears at the enemy lines.",
                            "target_lang_translations": {
                                "es": "Los soldados arrojaron sus lanzas <w>arrojadizas</w> contra las líneas enemigas."
