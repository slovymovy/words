                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75da5721-02c1-3b09-876d-802dea6419d4",
                        "entry_id": "09cb0489-6343-3715-81d0-12aa721b8e36",
                        "glosses": [
                            "Statut fiscal accordé aux particuliers ayant des revenus provenant de locations de meublés qui n’excèdent pas la somme de 23 000 € ou 50 % de ses revenus par an."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "aac8cc55-c17d-43ac-8403-b038655bb72a",
                                "sense_id": "75da5721-02c1-3b09-876d-802dea6419d4",
                                "text": "Le régime fiscal est, le plus souvent, celui de loueur en meublé non professionnel (LMNP) : l’épargnant peut amortir une partie de son investissement dans le neuf, ce qui allège l’impôt sur les loyers encaissés."
                            },
                            {
                                "example_id": "e4b1a94b-3952-42c6-ad13-8661fd3c09f3",
                                "sense_id": "75da5721-02c1-3b09-876d-802dea6419d4",
                                "text": "La LMNP concerne la location de logements meublés dont les revenus générés par la location n’excèdent pas la somme de 23 000€ par an pour le propriétaire ou 50% de ses revenus globaux par an."
                            },
                            {
                                "example_id": "5a8dc9f4-23ed-43c7-852b-385089bc55bf",
                                "sense_id": "75da5721-02c1-3b09-876d-802dea6419d4",
                                "text": "Pour investir en LMNP, vous devez acquérir un bien meublé et justifier du fait que vous n'êtes pas un professionnel de la location immobilière."
                            }
                        ]
                    }
                ],
