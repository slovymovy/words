                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661dfef4-2796-4fc7-ba86-0128e34d6054",
                                "sense_id": "2e418aa9-d83e-3238-a4b2-3def7e69facb",
                                "text": "Kadeci byli zdecydowanymi monarchistami, ale pragnęli przekształcić cesarstwo rosyjskie w monarchię konstytucyjną typu zachodnioeuropejskiego z zapewnieniem burżuazji roli kierowniczej w państwie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03b86a91-6880-45ae-94a6-54f786205f7c",
