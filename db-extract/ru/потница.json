                    {
                        "translation_id": "4d028afc-33df-4025-a378-a4124afec284",
                        "source_entry_id": "8cc52df6-aa12-358f-8abc-eb8c8da679be",
                        "source_sense_id": "cec8c6b9-3433-3647-b4f4-a1634b99e2f5",
