                "senses": [
                    {
                        "sense_id": "0f2d0d74-a631-3198-ac68-94b0905435c7",
                        "entry_id": "c159717f-2654-37cf-85ac-d7d18645bd5d",
                        "glosses": [
                            "могущественный, властный; повелительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58becb7-eb84-460e-abd7-03e656c42508",
                                "sense_id": "0f2d0d74-a631-3198-ac68-94b0905435c7",
                                "text": "Гордый, властительный и безгранично полновластный Иоанн чувствовал себя в высокой степени угнетённым и приниженным во внешних делах."
                            }
                        ]
                    },
                    {
                        "sense_id": "a88a2a55-a5f3-33d1-a941-2736cc93f4f0",
                        "entry_id": "c159717f-2654-37cf-85ac-d7d18645bd5d",
                        "glosses": [
                            "перен. влиятельный; авторитетный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4b8157-adb2-47eb-ac95-69bdab11e0f7",
                                "sense_id": "a88a2a55-a5f3-33d1-a941-2736cc93f4f0",
                                "text": "Властительные кадровики на этот раз не промахнулись."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f668353-82cd-3ebd-b4ef-89db2e3a2422",
                        "entry_id": "c159717f-2654-37cf-85ac-d7d18645bd5d",
                        "glosses": [
                            "перен. очевидный; непреложный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ee88f5-c4bd-4b4d-b2fb-b9299905a086",
                                "sense_id": "4f668353-82cd-3ebd-b4ef-89db2e3a2422",
                                "text": "Есть тонкие властительные связи // Меж контуром и запахом цветка."
                            }
                        ]
                    }
