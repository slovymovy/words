                                        "entry_id": "e9f768b4-581c-3b65-a5c4-71625b367c3c",
                                        "glosses": [
                                            "Totalement, complètement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b898e2-3734-494d-b3e4-22386b7d572d",
                                                "sense_id": "df9bbfe6-21cb-3aab-92dd-a575e82e1c51",
                                                "text": "Je suis puni par où j’ai péché …, voilà ce qui fait qu’aujourd'hui je suis roulé à plate couture."
                                            },
                                            {
                                                "example_id": "74ea7b93-173f-48b2-a2b6-b05d2163c674",
                                                "sense_id": "df9bbfe6-21cb-3aab-92dd-a575e82e1c51",
                                                "text": "La CAQ a perdu dans Jean-Talon. À plate couture."
                                            },
                                            {
                                                "example_id": "c0637ade-a46a-4310-ac9d-cff30a71277d",
                                                "sense_id": "df9bbfe6-21cb-3aab-92dd-a575e82e1c51",
                                                "text": "– …et, cette fois, nous les battrions à plate couture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
