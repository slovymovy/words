                ],
                "senses": [
                    {
                        "sense_id": "6d6f4c9b-f0cd-3276-92d9-2d225f776344",
                        "entry_id": "52a1904b-4f72-3dc8-99f1-d280361aa147",
                        "glosses": [
                            "iemand die idealen nastreeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da683c2-d420-4505-9734-b06046f1f159",
                                "sense_id": "6d6f4c9b-f0cd-3276-92d9-2d225f776344",
                                "text": "Je bent een onverbeterlijke idealist dat je hier woorden zit in te vullen."
                            },
                            {
                                "example_id": "27c0055d-72f6-4231-ad3e-8871ab725c7e",
                                "sense_id": "6d6f4c9b-f0cd-3276-92d9-2d225f776344",
                                "text": "Terlouw pleitte ervoor \"progressief, onafhankelijk, kritisch en redelijk\" te zijn. Hij zette zichzelf neer als optimist en idealist, die stond voor de zorg voor de aarde en het milieu. Het was een boodschap die hij ook na zijn politieke carrière tot op hoge leeftijd zou blijven uitdragen."
                            }
                        ]
                    },
                    {
                        "sense_id": "af698217-56e4-3e56-a725-34e849f91b53",
                        "entry_id": "52a1904b-4f72-3dc8-99f1-d280361aa147",
                        "glosses": [
                            "aanhanger van het idealisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae2b58d1-1f28-411c-9025-7d6acf7ff33c",
                                "sense_id": "af698217-56e4-3e56-a725-34e849f91b53",
                                "text": "In die ruimte zaten allerlei idealisten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40877915-9692-4688-b66f-1b0af67a9b0e",
                        "source_entry_id": "52a1904b-4f72-3dc8-99f1-d280361aa147",
