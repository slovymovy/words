                "translations": [
                    {
                        "translation_id": "0c7f68ff-a123-4012-8965-1624079f561c",
                        "source_entry_id": "846778dc-eb72-3423-a04b-5cdd1486b74d",
                        "source_sense_description": "a soldier on guard",
                        "target_lang_word": "Wärter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wärter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                        "entry_id": "66a245c1-1bc3-36cb-b369-9216834d9063",
                                        "glosses": [
                                            "Person, die etwas beaufsichtigt oder bewacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066a6da1-dbd5-4ce0-b93d-e7173bbca943",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "Die Wärter waren alle eingeschlafen."
                                            },
                                            {
                                                "example_id": "cca730d7-1dbf-415e-ba7d-c17af511443a",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Andere wandten ein, es werde die Gemeinde zehn Pfund und zwölf Schilling für die Kutsche und die Dienste eines Wärters kosten, das Mädchen zur Einschiffung nach London zu schaffen.“"
                                            },
                                            {
                                                "example_id": "412e101d-d06b-49fc-8a4a-50a140e53b1b",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Der Wärter hatte seinen Kopf gewaltsam dem Maler zugedreht.“"
                                            },
                                            {
                                                "example_id": "89ced730-5b63-4206-9d0d-14eb8d8e170c",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Bewacht wird die Zufahrt von zwei Wärtern in Tarnuniform, von denen einer auf einem Holzturm achtgibt, dass der Wald nirgends brennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fae7ab2-0d95-4477-be37-f52c43ee440b",
                        "source_entry_id": "846778dc-eb72-3423-a04b-5cdd1486b74d",
                        "source_sense_description": "a soldier on guard",
                        "target_lang_word": "Gardist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gardist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                        "entry_id": "5c849a84-68bd-3182-a787-31f310ae92e0",
                                        "glosses": [
                                            "Angehöriger der Garde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44b3d03-628d-4477-a7e3-f4eb5baef3a9",
                                                "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                                "text": "„Aber nicht das Gebäude ist die Attraktion, sondern die davor Wache haltenden Soldaten: Ein Gardist zu Fuß und zwei zu Pferd vom Corps der Household Cavalry stehen, unbeeindruckt von den um sie herum wuselnden Touristen, auf ihrem Posten.“"
                                            },
                                            {
                                                "example_id": "7d52f4df-365e-446a-a112-cfb8a0b44ccb",
                                                "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                                "text": "„Die beiden Gardisten erzählten Rostow von ihrem Marsch und von allen Empfängen und Feiern, die man der Garde zu Ehren in Russland, in Polen und im Auslande veranstaltet hatte.“"
                                            },
                                            {
                                                "example_id": "d9691df1-ca3d-4850-9e79-0901d25170e2",
                                                "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                                "text": "„Von 189 Gardisten kamen 147 ums Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "375a7c99-472b-486b-af4b-14a1b6212241",
                        "source_entry_id": "846778dc-eb72-3423-a04b-5cdd1486b74d",
