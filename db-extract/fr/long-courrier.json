                ],
                "senses": [
                    {
                        "sense_id": "5e7a2b8e-bfb0-3ec0-888c-04ed9bfc5a6b",
                        "entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
                        "glosses": [
                            "Navire qui navigue au long cours."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6745f816-f47a-313a-b845-fd036c1e44f2",
                        "entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
                        "glosses": [
                            "Marin pratiquant le long cours."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "18f6abda-00c2-42ed-8e8a-c230dade5bc3",
                                "sense_id": "6745f816-f47a-313a-b845-fd036c1e44f2",
                                "text": "À ces mots qui rompirent le charme, Nonna, Anne et les sabotiers se rapprochèrent des longs-courriers et osèrent en toucher les manches humides."
                            }
                        ]
                    },
                    {
                        "sense_id": "67523cac-b318-38ed-85e5-5347a277e84e",
                        "entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
                        "glosses": [
                            "Vol commercial qui transporte des passagers sur de longues distances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0b1760-150e-4e3e-9813-71ab59b32ac3",
                                "sense_id": "67523cac-b318-38ed-85e5-5347a277e84e",
                                "text": "Car, nonobstant sa soif de découvertes, l’avion, ce n’était pas trop son truc à Camille. Et plus encore quand elle songeait aux long-courriers."
                            }
                        ]
                    },
                    {
                        "sense_id": "edbaa0fc-2b0e-3e24-928a-5291d60126fa",
                        "entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
                        "glosses": [
                            "Avion qui permet ce type de vol."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "de68c6fa-0953-425c-bcf8-5920882d19a8",
                                "sense_id": "edbaa0fc-2b0e-3e24-928a-5291d60126fa",
                                "text": "Un avion moyen-courrier en charge environ 5 tonnes pour un Paris-Milan, et un long-courrier plus de 50 tonnes pour un Rome-New York."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5fe660c-2da5-4dab-aa2e-5cf95a3bf95c",
                        "source_entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
                        "target_lang_word": "Langstrecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langstrecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "828d8b36-a61a-3ec8-8b02-f886056b9954",
                                        "entry_id": "c07fb16b-f2fc-337f-9bee-4d6af361ff54",
                                        "glosses": [
                                            "relativ lange Strecke, zum Beispiel relativ lange Fahrtstrecke, Flugstrecke oder Bahnstrecke"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c2f6bae-55d1-4c49-98be-0a145d452f21",
                                                "sense_id": "828d8b36-a61a-3ec8-8b02-f886056b9954",
                                                "text": "„Das Auto macht richtig Spaß, es unterstützt mit ganz neuen, fehlerfrei agierenden Assistenzsystemen und wäre damit hervorragend für die Langstrecke geeignet.“"
                                            },
                                            {
                                                "example_id": "9b8af475-9926-4178-9452-d82d2e265ffa",
                                                "sense_id": "828d8b36-a61a-3ec8-8b02-f886056b9954",
                                                "text": "„Das größte Wachstum gibt es jedoch auf der Langstrecke über dem Atlantik und vor allem Richtung Asien.“"
                                            },
                                            {
                                                "example_id": "92094f6e-2047-41e5-8a13-18400d50b02e",
                                                "sense_id": "828d8b36-a61a-3ec8-8b02-f886056b9954",
                                                "text": "„Ich würde mal schätzen, dass wir 80 Prozent aller Fahrten mit dem Leaf machen und nur noch Langstrecken mit unserem Diesel.“"
                                            },
                                            {
                                                "example_id": "178bdb58-d9e4-4060-b1d4-465424982dab",
                                                "sense_id": "828d8b36-a61a-3ec8-8b02-f886056b9954",
                                                "text": "„Die Rekuperation im Stadtverkehr und die Planung von Ladevorgängen auf Langstrecken über das Navigationssystem empfindet Conrad als zuverlässig, obwohl die Vorkonditionierung des Akkus für eine optimierte Ladeleistung fehlt.“"
                                            },
                                            {
                                                "example_id": "64fad69c-3483-4895-8362-f12ad5ded0c9",
                                                "sense_id": "828d8b36-a61a-3ec8-8b02-f886056b9954",
                                                "text": "„Die Ladezeit interessiert die Fahrer im Regelfall nur auf der Langstrecke und nicht auf der Kurzstrecke zum Kindergarten, in den Supermarkt oder ins Büro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "221a6d26-3bc6-3b43-aabd-8d4c8a5c8ca0",
                                        "entry_id": "c07fb16b-f2fc-337f-9bee-4d6af361ff54",
                                        "glosses": [
                                            "relativ lange Streckenlänge oder Wettkampfdistanz; Strecke, deren Zurücklegen eine hohe Ausdauer erfordert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fca833-ec1d-44cc-98f8-b377eed3164f",
                                                "sense_id": "221a6d26-3bc6-3b43-aabd-8d4c8a5c8ca0",
                                                "text": "„Bei den Crosslauf-Weltmeisterschaften 2005 in Saint-Galmier belegte sie auf der Langstrecke den 75. Platz.“"
                                            },
                                            {
                                                "example_id": "208de736-c461-4d49-bc44-3a1b9f3712d9",
                                                "sense_id": "221a6d26-3bc6-3b43-aabd-8d4c8a5c8ca0",
                                                "text": "„Auf Langstrecken wurde er neunmal Deutscher Meister der Bundesrepublik.“"
                                            },
                                            {
                                                "example_id": "e8c83ca9-b1de-45a0-9d0e-14dee969a1af",
                                                "sense_id": "221a6d26-3bc6-3b43-aabd-8d4c8a5c8ca0",
                                                "text": "„National gewann er ebenso über die Langstrecken wie über 1500 m Freistil und bei den Wintermeisterschaften über 1500 und 800 m. Dabei stellte er in 7:51,59 min einen neuen deutschen Rekord über 800 m Freistil auf.“"
                                            },
                                            {
                                                "example_id": "8e1a9ee0-cd05-4fcc-89e1-3a142e0e8c28",
                                                "sense_id": "221a6d26-3bc6-3b43-aabd-8d4c8a5c8ca0",
                                                "text": "„Ihre größten Erfolge hatte sie zunächst im Crosslauf: 1977 und 1978 wurde sie auf der Kurzstrecke, 1981 auf der Langstrecke Deutsche Meisterin.“"
                                            },
                                            {
                                                "example_id": "549c6699-a347-4b65-a2a2-efaff3a77e12",
                                                "sense_id": "221a6d26-3bc6-3b43-aabd-8d4c8a5c8ca0",
                                                "text": "„Läufe von 2.000 bis 42.195 Meter (Marathon) werden als Langstrecke bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f11098d-eed0-4fc8-9abd-d200b6647a1e",
                        "source_entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
