                    {
                        "sense_id": "d295773d-5e3d-3085-ae76-7ba524de7003",
                        "entry_id": "859bc51d-e07d-3c88-957d-0adb0f83051a",
                        "glosses": [
                            "Véhicule permettant de remorquer les véhicules en panne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5713d831-4c02-4e2f-8621-a6eb35787e80",
                                "sense_id": "d295773d-5e3d-3085-ae76-7ba524de7003",
                                "text": "Dans la lumière des projecteurs du camion des pompiers et de la dépanneuse que les gendarmes ont réquisitionnée à Pleyben, l’équipe de secours se prépare."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a59410b-eaa0-33e5-be2f-0255d2c74425",
                        "entry_id": "859bc51d-e07d-3c88-957d-0adb0f83051a",
                        "glosses": [
                            "Celle qui est chargée de réparer les pannes."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea1df23-b469-4cb8-bda4-94a6adb82f23",
                                "sense_id": "2a59410b-eaa0-33e5-be2f-0255d2c74425",
                                "text": "Mais la jeune dépanneuse le sait bien : dans un univers très masculin, sa présence dénote."
                            },
                            {
                                "example_id": "2e5c2f28-cee3-4a6c-b9b5-df19deb4c894",
                                "sense_id": "2a59410b-eaa0-33e5-be2f-0255d2c74425",
                                "text": "Olivia n’est pas chanteuse, ni même danseuse étoile. Mais dépanneuse. Elle vient en aide aux automobilistes dans la région de Vichy. A seulement 25 ans, elle s’est imposée dans un monde très masculin. La France compte ainsi seulement 30 femmes spécialistes du dépannage."
                            }
                        ]
                    }
