                    {
                        "translation_id": "e43b87ba-eb55-4ec2-8ba8-dc7c2de4c54e",
                        "source_entry_id": "8be91d0e-fab1-3e95-9e07-3fda68f9b543",
                        "source_sense_description": "small shop, especially one that sells fashionable clothes, jewelry and the like",
                        "target_lang_word": "boetiek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boetiek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e6ce35a9-5f6f-3cdf-9a0a-b64758523631",
                                        "entry_id": "f8f988fb-97ba-3ebb-8cda-446cab3413e5",
                                        "glosses": [
                                            "kleine winkel met modieuze artikelen (vaak een kledingwinkel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7cb675-40aa-4c87-a787-f9130e528f05",
                                                "sense_id": "e6ce35a9-5f6f-3cdf-9a0a-b64758523631",
                                                "text": "Carnaby Street en Kings Road verwierven in de jaren 60 wereldwijde bekendheid als een 'hippe' winkelstraat, waar zich vooral muziekwinkels en kledingboutiekjes bevonden."
                                            },
                                            {
                                                "example_id": "274dde04-333c-459f-89e6-b5e53072075f",
                                                "sense_id": "e6ce35a9-5f6f-3cdf-9a0a-b64758523631",
                                                "text": "Zoals gewoonlijk zag zij er weer uit alsof ze rechtstreeks van zowel de kapper als een luxe boetiek kwam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a903f9fe-9c20-4383-b300-2105ce9ba2ff",
                        "source_entry_id": "8be91d0e-fab1-3e95-9e07-3fda68f9b543",
                        "source_sense_description": "small shop, especially one that sells fashionable clothes, jewelry and the like",
                        "target_lang_word": "boutique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boutique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e1b39a9-d1e8-32ea-898a-90cca362d4aa",
                                        "entry_id": "da45ec95-3eca-35be-b614-4f733bb6992d",
                                        "glosses": [
                                            "Magasin, partie de façade du rez-de-chaussée d’une maison consacrée à un commerce de détail ou, à la fois, à la fabrication et à la vente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe2dad8-d1f5-4c47-b4bc-9ba5adecf92b",
                                                "sense_id": "9e1b39a9-d1e8-32ea-898a-90cca362d4aa",
                                                "text": "Une pluie glacée tombait dans les rues miroitantes. Je marchais le long des boutiques, m’appuyant au rebord des devantures pour ne point m’écrouler sur le trottoir."
                                            },
                                            {
                                                "example_id": "dc17d54f-9a9d-496c-ab7e-0f9db265abff",
                                                "sense_id": "9e1b39a9-d1e8-32ea-898a-90cca362d4aa",
                                                "text": "Il y avait là, juste en face, une boutique de modeste apparence qui pouvait bien être celle d'une crèmerie. La porte vitrée était ouverte et une femme en tablier blanc se tenait sur le seuil, attendant la pratique."
                                            },
                                            {
                                                "example_id": "bb8c0890-9099-491b-bc30-13700373dccf",
                                                "sense_id": "9e1b39a9-d1e8-32ea-898a-90cca362d4aa",
                                                "text": "M. Tom Smallways était fruitier de son état et jardinier par vocation, et Jessica, sa modeste épouse, vaquait aux soins de la boutique."
                                            },
                                            {
                                                "example_id": "6fcb7c07-19aa-4f7b-bf50-adecbb469d34",
                                                "sense_id": "9e1b39a9-d1e8-32ea-898a-90cca362d4aa",
                                                "text": "J’ai donc repris la file des passants […] et nous avançâmes par saccades à cause des boutiques dont chaque étalage fragmentait la foule."
                                            },
                                            {
                                                "example_id": "41b89cdb-acc2-47b7-83bf-b832a32b7d5e",
                                                "sense_id": "9e1b39a9-d1e8-32ea-898a-90cca362d4aa",
                                                "text": "En sabots, les manches relevées sur leurs bras blancs, les filles balayaient le devant des boutiques."
                                            },
                                            {
                                                "example_id": "bbef8ea9-815c-4507-9389-4dac7791e4b0",
                                                "sense_id": "9e1b39a9-d1e8-32ea-898a-90cca362d4aa",
                                                "text": "Ils n’avaient pas dépassé la boutique de l’épicier, vers la mer, que le tonitrument de l’autre bal, celui qui était de ce côté-ci du fleuve, s’éleva à son tour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "961e201c-6895-344b-8ca6-449219f9ce4d",
                                        "entry_id": "da45ec95-3eca-35be-b614-4f733bb6992d",
                                        "glosses": [
                                            "Étalage en plein vent ou baraque de marchand forain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34e7ca6-7897-4d8b-984d-197f89db9246",
                                                "sense_id": "961e201c-6895-344b-8ca6-449219f9ce4d",
                                                "text": "Il y a deux boutiques où l'on vend de la viande rôtie, kebab. Ces boutiques sont tenues par des Turcs, le kebab n'étant pas un mets arabe."
                                            },
                                            {
                                                "example_id": "9921e935-8692-40d3-8557-ac62008b047c",
                                                "sense_id": "961e201c-6895-344b-8ca6-449219f9ce4d",
                                                "text": "On arriva sur une petite place circulaire, où étaient dressées quelques boutiques, un bal, un manège. Il n’y avait pas grande foule, quelques badauds seulement circulaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d2227d-7731-3ca3-94c9-ee2191d9ea2f",
                                        "entry_id": "da45ec95-3eca-35be-b614-4f733bb6992d",
                                        "glosses": [
                                            "Métier de commerçant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6cea613-c8c8-4163-a2af-1da489be73aa",
                                                "sense_id": "f7d2227d-7731-3ca3-94c9-ee2191d9ea2f",
                                                "text": "Fermer boutique, cesser de travailler ou de vendre, quitter le commerce."
                                            },
                                            {
                                                "example_id": "d532a9be-ae0a-4b35-b8e4-a65290698fd3",
                                                "sense_id": "f7d2227d-7731-3ca3-94c9-ee2191d9ea2f",
                                                "text": "Se mettre en boutique, ouvrir boutique."
                                            },
                                            {
                                                "example_id": "9b677fbe-4c70-48aa-bc13-8e121be6cd0a",
                                                "sense_id": "f7d2227d-7731-3ca3-94c9-ee2191d9ea2f",
                                                "text": "Entreprendre quelque espèce de commerce ou d’industrie à boutique ouverte."
                                            },
                                            {
                                                "example_id": "251a0511-46e4-4711-ad78-bd1a39b00c91",
                                                "sense_id": "f7d2227d-7731-3ca3-94c9-ee2191d9ea2f",
                                                "text": "Il me faut du repos. C’est une marchandise dont vous ne tenez pas boutique à la foire, sous l’enseigne de Motus-un-doigt-sur-la-bouche. Allez rire et ne restez pas ici. C’est malsain : la vieillesse se gagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45e81f54-fe55-3b06-942d-fc8c57ab011a",
                                        "entry_id": "da45ec95-3eca-35be-b614-4f733bb6992d",
                                        "glosses": [
                                            "Toutes les marchandises dont une boutique est garnie."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e22d874-439e-410d-8968-af975563932f",
                                                "sense_id": "45e81f54-fe55-3b06-942d-fc8c57ab011a",
                                                "text": "Il a vendu sa boutique, son fonds de boutique."
                                            },
                                            {
                                                "example_id": "c426b310-62e6-47a4-abee-a6b8eb41cb25",
                                                "sense_id": "45e81f54-fe55-3b06-942d-fc8c57ab011a",
                                                "text": "Il a engagé toute sa boutique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32812c81-3dad-39f2-8dda-1ab1779aabcd",
                                        "entry_id": "da45ec95-3eca-35be-b614-4f733bb6992d",
                                        "glosses": [
                                            "Maison particulière, administration, compagnie que l’on veut discréditer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3211df0e-7628-4bb5-b3ef-27516550dd75",
                                                "sense_id": "32812c81-3dad-39f2-8dda-1ab1779aabcd",
                                                "text": "Car il est toujours ivre, et avec ça l’esprit le plus exécrable, criant du matin au soir contre les bourgeois, disant que, s’il avait encore des bras, ce serait lui qui ferait sauter la boutique…"
                                            },
                                            {
                                                "example_id": "3133264e-a3e3-452a-a6ee-78e68c7bb89a",
                                                "sense_id": "32812c81-3dad-39f2-8dda-1ab1779aabcd",
                                                "text": "Certains au sein des forces de l’ordre, qui ne tarissent pas d’éloges sur l’homme, l’imaginent déjà dans un rôle de grand patron de la police, capable de réconcilier les nombreuses boutiques qui composent la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3707bd4-b007-306d-b449-ac6e26bc7091",
                                        "entry_id": "da45ec95-3eca-35be-b614-4f733bb6992d",
                                        "glosses": [
                                            "Bateau de pêcheur dont le fond est percé de trous et dans lequel le poisson se conserve vivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66073cc2-bed1-403e-a9fb-fba94bf723ce",
                                                "sense_id": "e3707bd4-b007-306d-b449-ac6e26bc7091",
                                                "text": "Aller prendre du poisson à la boutique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2e52e9-88cb-36b6-9305-c638324080e6",
                                        "entry_id": "da45ec95-3eca-35be-b614-4f733bb6992d",
                                        "glosses": [
                                            "Entreprise artisanale de la métallurgie."
                                        ],
