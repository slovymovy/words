                        ],
                        "examples": [
                            {
                                "example_id": "f7cbd453-2d6e-4f4e-ac7c-3d5a85c060e5",
                                "sense_id": "77179cd5-0dfb-3c71-b343-1d3e7780527c",
                                "text": "Voornaamste meningsverschillen betreffen de islamitische wetgeving en de rol van de talrijke strijdkrachten in het land."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a411a76-e627-353d-90bc-1959254a4f19",
                        "entry_id": "f1b832c2-2c6a-3e22-9e6d-e990d126ccbb",
                        "glosses": [
                            "geheel van de militaire organisaties die een staat ter beschikking staan"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3ba9169c-ea92-460d-984c-79b5166f4b48",
                                "sense_id": "4a411a76-e627-353d-90bc-1959254a4f19",
                                "text": "Xi Jinping, de leider van de Communistische Partij van China (CPC) en van de Chinese strijdkrachten, heeft China herschapen in een machtig land waarover hij steeds meer persoonlijk de baas is."
                            },
                            {
                                "example_id": "b6e4e026-fef9-442d-80eb-3ccd4e340fb3",
                                "sense_id": "4a411a76-e627-353d-90bc-1959254a4f19",
                                "text": "Vooralsnog heeft Defensie honderd Nederlandse patiënten overgeplaatst naar een ander ziekenhuis. Ook hebben de strijdkrachten 65 beademingsapparaten geleverd."
                            }
                        ]
                    }
