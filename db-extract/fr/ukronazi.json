                        "sense_id": "33735af7-9ad6-3e17-816d-09fdbdd730e6",
                        "entry_id": "c35ef90e-89a6-3a4b-855c-cd0085f08899",
                        "glosses": [
                            "Qui est en rapport avec l’Ukraine lorsque considérée comme néo-nazi."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "177f0100-95e5-4ec2-9378-919ca3748d9c",
                                "sense_id": "33735af7-9ad6-3e17-816d-09fdbdd730e6",
                                "text": "Il n y aura personnes ! Nous soutenons nos frères et sœur du Donbass contre le régime\nukronazi et la Russie est sœur de la France... 😉\nLe régime corrompus de Zézé tombera !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "406c0546-a565-4574-9654-6039b4f49646",
                        "source_entry_id": "c35ef90e-89a6-3a4b-855c-cd0085f08899",
                        "source_sense_id": "33735af7-9ad6-3e17-816d-09fdbdd730e6",
                        "source_sense_description": "Relatif à l’Ukraine lorsque considéré néo-nazi (adjectif).",
                        "target_lang_word": "Ukronazi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9146eaa3-092d-440c-a562-2860c03cd1ed",
                        "source_entry_id": "c35ef90e-89a6-3a4b-855c-cd0085f08899",
                        "source_sense_id": "33735af7-9ad6-3e17-816d-09fdbdd730e6",
                        "source_sense_description": "Relatif à l’Ukraine lorsque considéré néo-nazi (adjectif).",
                        "target_lang_word": "Ukronazi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ukronazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a6ace6-7d69-3274-9caf-17889f563eba",
                                        "entry_id": "a236f6bb-04d6-30f7-acc9-1d0e4bdb957d",
                                        "glosses": [
                                            "A Ukrainian nationalist, especially one harboring Russophobia and anti-Russian sentiment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f724aae5-0b38-4c27-b720-759a45150701",
                                                "sense_id": "f3a6ace6-7d69-3274-9caf-17889f563eba",
                                                "text": "In a sad and tragic way, the Ukronazis have achieved their dream – they have created an anti-Russia, a polar opposite of the Russian civilizational realm."
                                            },
                                            {
                                                "example_id": "41d6f26f-522a-48ce-9ed9-add11ab0f8ae",
                                                "sense_id": "f3a6ace6-7d69-3274-9caf-17889f563eba",
                                                "text": "Not to be undone, the Ukronazis have also taken a highly significant step: the Ukrainian Prime Minister has declared that he thinks that the irregular forces currently enforcing the blockade should be considered official border guards (as for these soon to be \"border guards\", they have explained that for their main border post shall be called \"nightingale\" in honor of the Nachtigall battalion of the Nazi Abwehr)."
                                            },
                                            {
                                                "example_id": "8aad3075-608c-4b61-a503-a39d0d167652",
                                                "sense_id": "f3a6ace6-7d69-3274-9caf-17889f563eba",
                                                "text": "Last week, following the imposition of a total blockade against Novorussia by the \"Ukronazis\" [Kiev regime], Russia declared that she will from now on recognize the official documents emitted by the DNR and LNR authorities."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ukronazi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b45e47ba-b843-30d8-a995-ee4f5bf7d548",
                                        "entry_id": "9d9572be-058f-3ad6-a79b-f4d3aacf1587",
                                        "glosses": [
                                            "Of or pertaining to Ukrainian nationalists, especially one harboring Russophobia and anti-Russian sentiment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b065b7-3730-4f83-bdee-6ec0115b5711",
                                                "sense_id": "b45e47ba-b843-30d8-a995-ee4f5bf7d548",
                                                "text": "The Ukrowehrmacht detachments have been ordered to kill all civilians in the area without distinction, which is genocide carried out by the Ukronazi government under Anglo-Saxon influence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
