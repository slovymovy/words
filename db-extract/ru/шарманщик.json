                "senses": [
                    {
                        "sense_id": "f4205b72-efc6-3aab-b26f-e80b7775a234",
                        "entry_id": "e4cec44e-7d68-393f-9749-ba1e77e371f3",
                        "glosses": [
                            "бродячий музыкант с шарманкой, тот, кто играет на шарманке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da78344d-c551-4c61-8711-9e8000a4e50b",
                                "sense_id": "f4205b72-efc6-3aab-b26f-e80b7775a234",
                                "text": "Шарманщик в огромной шляпе с вислыми полями крутил ручку своего аппарата, населенного зверьем, как целый лес."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af9d450e-d930-4582-83cc-1b5b9508862f",
                        "source_entry_id": "e4cec44e-7d68-393f-9749-ba1e77e371f3",
                        "source_sense_id": "f4205b72-efc6-3aab-b26f-e80b7775a234",
                        "target_lang_word": "organ-grinder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organ-grinder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78d51436-8958-363b-bc2c-afd55dbb2ccf",
                                        "entry_id": "1d8f0a81-9d80-3d9c-a23b-961ca234650a",
                                        "glosses": [
                                            "Alternative spelling of organ grinder."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06831619-ceba-4f59-9981-5752c4b121b1",
                        "source_entry_id": "e4cec44e-7d68-393f-9749-ba1e77e371f3",
                        "source_sense_id": "f4205b72-efc6-3aab-b26f-e80b7775a234",
                        "target_lang_word": "organ grinder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organ grinder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cdccdf2-ebb9-371b-a7ae-ef0bc01fc7fe",
                                        "entry_id": "79b301fd-04b2-3e1f-9ecb-d785f62c69df",
                                        "glosses": [
                                            "The player of a barrel organ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbddd3e1-5540-46b9-8c0e-088946210db6",
                                                "sense_id": "1cdccdf2-ebb9-371b-a7ae-ef0bc01fc7fe",
                                                "text": "There is one beautiful sight in the East End, and only one, and it is the children dancing in the street when the organ-grinder goes his round."
                                            },
                                            {
                                                "example_id": "ab13e373-bae5-4d42-93aa-d62cca00eef5",
                                                "sense_id": "1cdccdf2-ebb9-371b-a7ae-ef0bc01fc7fe",
                                                "text": "The organ-grinders were at work; but they were always precocious harbingers. It was near enough spring for them to go penny-hunting when the skating ball dropped at the park."
                                            },
                                            {
                                                "example_id": "5801d089-6c40-44a0-afab-34a57bc5a35f",
                                                "sense_id": "1cdccdf2-ebb9-371b-a7ae-ef0bc01fc7fe",
                                                "text": "“You should read Spanish,” he said. “It is a noble tongue. It has not the mellifluousness of Italian, Italian is the language of tenors and organ-grinders, but it has grandeur: it does not ripple like a brook in a garden, but it surges tumultuous like a mighty river in flood.”"
                                            },
                                            {
                                                "example_id": "91915068-8e09-4a1a-86c9-0b406025edda",
                                                "sense_id": "1cdccdf2-ebb9-371b-a7ae-ef0bc01fc7fe",
                                                "text": "Thus the vision of humanity appeared to be in some way connected with Bloomsbury, and faded distinctly by the time she crossed the main road; then a belated organ-grinder in Holborn set her thoughts dancing incongruously; […]"
                                            },
                                            {
                                                "example_id": "ccda9099-b3af-47bc-bdf4-00050d8a11ac",
                                                "sense_id": "1cdccdf2-ebb9-371b-a7ae-ef0bc01fc7fe",
                                                "text": "Those who cannot play any instrument wheel a gramophone through the streets on a barrow, but the largest number of these street musicians are organ grinders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2846b0b-a499-39ea-90a2-dee310fe8883",
                                        "entry_id": "79b301fd-04b2-3e1f-9ecb-d785f62c69df",
                                        "glosses": [
                                            "The person who is in charge, rather than a lackey or representative; the person truly responsible for another's actions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43892cb-8f37-4483-adc6-c6059de9c1f1",
                                                "sense_id": "e2846b0b-a499-39ea-90a2-dee310fe8883",
                                                "text": "I want to speak to the organ grinder, not the monkey."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "025d918b-5f4e-4529-b296-ef92421d15cc",
