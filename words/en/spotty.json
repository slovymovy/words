{
    "word_family": [
        "spot"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7316eeb3-4cfe-3caf-94bb-981e28818685",
                    "sense_definition": "Covered with or marked by small spots.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy had a <w>spotty</w> coat with patches of brown and white.",
                            "target_lang_translations": {
                                "nl": "De puppy had een <w>gevlekte</w> vacht met bruine en witte vlekken.",
                                "ru": "У щенка была <w>пятнистая</w> шерсть с коричневыми и белыми пятнами."
                            }
                        },
                        {
                            "text": "She wore a <w>spotty</w> dress to the summer party.",
                            "target_lang_translations": {
                                "nl": "Ze droeg een <w>jurk met stippeltjes</w> naar het zomerfeest.",
                                "ru": "Она надела на летнюю вечеринку платье <w>в горошек</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spotted",
                        "speckled"
                    ],
                    "antonyms": [
                        "plain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bedekt met of gekenmerkt door kleine vlekjes.",
                        "ru": "Покрытый или отмеченный небольшими пятнами или точками."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gevlekt",
                                "target_lang_sense_clarification": "algemene term voor iets met vlekken"
                            },
                            {
                                "target_lang_word": "stippeltjes-",
                                "target_lang_sense_clarification": "vaak gebruikt voor patronen op kleding"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пятнистый",
                                "target_lang_sense_clarification": "покрытый пятнами"
                            },
                            {
                                "target_lang_word": "в крапинку",
                                "target_lang_sense_clarification": "с мелким точечным узором"
                            },
                            {
                                "target_lang_word": "в горошек",
                                "target_lang_sense_clarification": "об узоре на ткани или одежде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e01bd389-0c4c-3d0b-afaa-3a0491790384",
                    "sense_definition": "Occurring in some places but not others; irregular or inconsistent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mobile phone reception in this remote area tends to be rather <w>spotty</w>.",
                            "target_lang_translations": {
                                "nl": "Het mobiele bereik in dit afgelegen gebied is nogal <w>onregelmatig</w>.",
                                "ru": "Мобильная связь в этом глухом районе, как правило, довольно <w>прерывистая</w>."
                            }
                        },
                        {
                            "text": "The team showed <w>spotty</w> performance throughout the entire season.",
                            "target_lang_translations": {
                                "nl": "Het team liet gedurende het hele seizoen <w>wisselvallige</w> prestaties zien.",
                                "ru": "Команда показывала <w>нестабильную</w> игру на протяжении всего сезона."
                            }
                        }
                    ],
                    "synonyms": [
                        "irregular",
                        "inconsistent",
                        "patchy"
                    ],
                    "antonyms": [
                        "consistent",
                        "steady"
                    ],
                    "common_phrases": [
                        "spotty reception"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op sommige plaatsen aanwezig maar niet overal; onregelmatig of inconsistent.",
                        "ru": "Проявляющийся местами; прерывистый, нерегулярный или нестабильный."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onregelmatig",
                                "target_lang_sense_clarification": "niet constant of gelijkmatig"
                            },
                            {
                                "target_lang_word": "wisselvallig",
                                "target_lang_sense_clarification": "veranderlijk in kwaliteit of aanwezigheid"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "прерывистый",
                                "target_lang_sense_clarification": "работающий с перебоями или неравномерно"
                            },
                            {
                                "target_lang_word": "нестабильный",
                                "target_lang_sense_clarification": "переменчивый, не постоянный"
                            },
                            {
                                "target_lang_word": "неравномерный",
                                "target_lang_sense_clarification": "присутствующий лишь местами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "611e89a8-26cc-3359-91f2-8952fe9eb735",
                    "sense_definition": "Of varying or unreliable quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many of the buyers had a <w>spotty</w> credit history.",
                            "target_lang_translations": {
                                "nl": "Veel van de kopers hadden een <w>onbetrouwbare</w> kredietgeschiedenis.",
                                "ru": "У многих покупателей была <w>пятнистая</w> кредитная история."
                            }
                        },
                        {
                            "text": "The restaurant has a <w>spotty</w> reputation for service.",
                            "target_lang_translations": {
                                "nl": "Het restaurant heeft een <w>wisselvallige</w> reputatie wat betreft de service.",
                                "ru": "У ресторана <w>неоднозначная</w> репутация в отношении обслуживания."
                            }
                        }
                    ],
                    "synonyms": [
                        "unreliable",
                        "uneven"
                    ],
                    "target_lang_definitions": {
                        "nl": "Van wisselende of onbetrouwbare kwaliteit.",
                        "ru": "Переменного или ненадежного качества; неровный."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wisselvallig",
                                "target_lang_sense_clarification": "van variërende kwaliteit"
                            },
                            {
                                "target_lang_word": "onbetrouwbaar",
                                "target_lang_sense_clarification": "niet consistent in prestaties"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неоднородный",
                                "target_lang_sense_clarification": "различающийся по качеству"
                            },
                            {
                                "target_lang_word": "неровный",
                                "target_lang_sense_clarification": "с переменными результатами или качеством"
                            },
                            {
                                "target_lang_word": "с пробелами",
                                "target_lang_sense_clarification": "ненадежный, с недостатками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4afc0c0f-4e8a-3029-af11-bfee7dec33a7",
                    "sense_definition": "A type of fish found in New Zealand waters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went fishing today and all I caught were <w>spotties</w>.",
                            "target_lang_translations": {
                                "nl": "Ik ben vandaag gaan vissen en het enige wat ik ving waren <w>spotty-vissen</w>.",
                                "ru": "Я сегодня ходил на рыбалку, и все, что я поймал, были рыбы-<w>спотти</w>."
                            }
                        },
                        {
                            "text": "The <w>spotty</w> is a common catch for children fishing off the wharf.",
                            "target_lang_translations": {
                                "nl": "De <w>spotty</w> is een veelvoorkomende vangst voor kinderen die vanaf de kade vissen.",
                                "ru": "<w>Спотти</w> — частая добыча для детей, рыбачащих с причала."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vissoort die in Nieuw-Zeelandse wateren voorkomt.",
                        "ru": "Вид рыб семейства губановых, обитающий в прибрежных водах Новой Зеландии (Notolabrus celidotus)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spotty",
                                "target_lang_sense_clarification": "vissoort uit Nieuw-Zeelandse wateren; naam onvertaald"
                            },
                            {
                                "target_lang_word": "spotty-vis",
                                "target_lang_sense_clarification": "dezelfde vis, met soortaanduiding"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спотти",
                                "target_lang_sense_clarification": "рыба Notolabrus celidotus, новозеландский губан"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}