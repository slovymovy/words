                "senses": [
                    {
                        "sense_id": "1ebf8dde-7454-3ad7-ba15-ce8319a95770",
                        "entry_id": "d8087d05-1291-3149-bad5-9d0ae9ba18b8",
                        "glosses": [
                            "Schreckgestalt, die den Heiligen Nikolaus begleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "752176f0-316f-477b-ae8b-1f538b54879d",
                                "sense_id": "1ebf8dde-7454-3ad7-ba15-ce8319a95770",
                                "text": "Der Krampus ähnelt in der Funktion dem Knecht Ruprecht, es bestehen aber Unterschiede zwischen beiden Figuren; zum Beispiel treten Krampusse meist in größeren Gruppen auf."
                            },
                            {
                                "example_id": "1ca50898-0662-4438-84ba-e06528588185",
                                "sense_id": "1ebf8dde-7454-3ad7-ba15-ce8319a95770",
                                "text": "„Der Krampus ist eine Art höllisches Zottelwesen und gehört zum süddeutschen Nikolaus-Brauchtum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
