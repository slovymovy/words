{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c7576ca-556c-3ac7-b398-76a6e5ba9684",
                    "sense_definition": "A person who is used by another person for their own benefit or profit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician treated his assistant like a mere <w>stooge</w> to take the blame for his mistakes.",
                            "target_lang_translations": {
                                "zh": "那位政客把助手当成了替自己背黑锅的<w>替罪羊</w>。"
                            }
                        },
                        {
                            "text": "He realized he was just a <w>stooge</w> for the company and quit his job immediately.",
                            "target_lang_translations": {
                                "zh": "他意识到自己不过是公司的<w>傀儡</w>，便立刻辞职了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lackey",
                        "minion",
                        "puppet"
                    ],
                    "target_lang_definitions": {
                        "zh": "被他人利用以谋取私利或充当替罪羊的人；傀儡，走狗"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "傀儡",
                                "target_lang_sense_clarification": "指受人操纵、缺乏自主权的人"
                            },
                            {
                                "target_lang_word": "走狗",
                                "target_lang_sense_clarification": "贬义，指为他人效劳做坏事的人"
                            },
                            {
                                "target_lang_word": "替罪羊",
                                "target_lang_sense_clarification": "代人受过的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "617f7b97-2f5f-3e68-a548-f0f9876c960c",
                    "sense_definition": "A person who secretly provides information to the police.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "informant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang members suspected that one of them was a police <w>stooge</w>.",
                            "target_lang_translations": {
                                "zh": "帮派成员怀疑他们当中有人是警方的<w>卧底</w>。"
                            }
                        },
                        {
                            "text": "He was labeled a <w>stooge</w> after the authorities raided the hideout.",
                            "target_lang_translations": {
                                "zh": "在当局突袭了藏匿点后，他被认定为警方的<w>线人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "informant",
                        "snitch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in criminal or informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "暗中为警方提供情报的人；线人，卧底"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "线人",
                                "target_lang_sense_clarification": "暗中提供情报的人"
                            },
                            {
                                "target_lang_word": "卧底",
                                "target_lang_sense_clarification": "潜伏在内部收集情报的人"
                            },
                            {
                                "target_lang_word": "告密者",
                                "target_lang_sense_clarification": "暗中告发或告密的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0966951-a719-3ae5-b1ba-84c2d022edd7",
                    "sense_definition": "A person who secretly works for a researcher to assist in an experiment without the participant knowing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confederate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experiment included a <w>stooge</w> who acted as another participant to influence the results.",
                            "target_lang_translations": {
                                "zh": "实验安排了一名<w>实验同谋</w>假扮成其他受试者，以影响实验结果。"
                            }
                        },
                        {
                            "text": "Participants were unaware that the person sitting next to them was actually a <w>stooge</w>.",
                            "target_lang_translations": {
                                "zh": "受试者们并不知道坐在身旁的人实际上是个<w>托儿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confederate"
                    ],
                    "target_lang_definitions": {
                        "zh": "（心理学或社会学实验中）假扮成普通受试者以协助研究人员的同谋，托儿"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "实验同谋",
                                "target_lang_sense_clarification": "心理学或科研实验中假扮被试的配合人员"
                            },
                            {
                                "target_lang_word": "托儿",
                                "target_lang_sense_clarification": "指暗中配合假扮普通人的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aef4bdd-9da7-36d7-95fd-8d4e4ab27b6d",
                    "sense_definition": "A performer who acts as a straight man in a comedy routine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years working as a <w>stooge</w> for the famous comedian.",
                            "target_lang_translations": {
                                "zh": "他为那位著名喜剧演员当了多年的<w>捧哏</w>。"
                            }
                        },
                        {
                            "text": "The role of the <w>stooge</w> is to set up the jokes for the funny man.",
                            "target_lang_translations": {
                                "zh": "<w>捧哏</w>的作用就是给主角搭话垫话，引出笑料。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（喜剧或曲艺表演中的）捧哏演员，充当配角逗笑的人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "捧哏",
                                "target_lang_sense_clarification": "在喜剧或相声中配合主角引出笑料的人"
                            },
                            {
                                "target_lang_word": "配角演员",
                                "target_lang_sense_clarification": "在滑稽戏中衬托主角的配角"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d65a7841-9b1a-335b-afe9-42a8b89ea37f",
                    "sense_definition": "A magician's assistant who pretends to be a member of the audience.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician used a <w>stooge</w> in the crowd to help with the card trick.",
                            "target_lang_translations": {
                                "zh": "魔术师利用人群中的一个<w>托儿</w>来协助完成纸牌魔术。"
                            }
                        },
                        {
                            "text": "The audience did not realize the volunteer was actually a <w>stooge</w>.",
                            "target_lang_translations": {
                                "zh": "观众没有意识到那个自愿上台的人实际上是个<w>暗托</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（魔术表演中）假装成普通观众的助手；暗托，托儿"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "托儿",
                                "target_lang_sense_clarification": "在观众席中暗中配合表演的人"
                            },
                            {
                                "target_lang_word": "暗托",
                                "target_lang_sense_clarification": "隐藏身份的助手"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2177957-e316-3c68-ac89-39f473b2bbdc",
                    "sense_definition": "To perform the role of a straight man in a comedy act.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>stooge</w> for his partner during their new comedy show.",
                            "target_lang_translations": {
                                "zh": "在他们的新喜剧演出中，他决定为搭档<w>捧哏</w>。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>stooge</w> effectively without good timing.",
                            "target_lang_translations": {
                                "zh": "如果节奏感不好，就很难有效地<w>当配角</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在喜剧演出中充当配角或捧哏"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "捧哏",
                                "target_lang_sense_clarification": "担任捧哏角色进行表演"
                            },
                            {
                                "target_lang_word": "当配角",
                                "target_lang_sense_clarification": "充当衬托主角的配角"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}