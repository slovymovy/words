                                "target_senses": [
                                    {
                                        "sense_id": "5c89d8a6-d2f0-3e8d-87c3-01fb93ed82e3",
                                        "entry_id": "acec4676-3822-3829-b5fd-0825f53c1969",
                                        "glosses": [
                                            "stockend und schwankend gehen, weil ein Bein weniger belastet wird als das andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d473f5-4368-4548-b3ac-dfeccaef439f",
                                                "sense_id": "5c89d8a6-d2f0-3e8d-87c3-01fb93ed82e3",
                                                "text": "Seit ich die Nagelbettentzündung am Zeh habe, kann ich nur noch humpeln."
                                            },
                                            {
                                                "example_id": "ef645d35-9dae-4abc-9b79-6d6ad7703f6a",
                                                "sense_id": "5c89d8a6-d2f0-3e8d-87c3-01fb93ed82e3",
                                                "text": "Die Arme muss wegen ihrem Ischias am Stock humpeln."
                                            },
                                            {
                                                "example_id": "dc36520d-8e1d-4308-a24c-da9e1acbc4ec",
                                                "sense_id": "5c89d8a6-d2f0-3e8d-87c3-01fb93ed82e3",
                                                "text": "Damit Florian aufgrund des verkürzten Beines nicht humpelt, trägt er orthopädische Schuhe, die die Differenz ausgleichen."
                                            },
                                            {
                                                "example_id": "fa51d650-b3c8-4ddf-ac59-3b8fad4156f6",
                                                "sense_id": "5c89d8a6-d2f0-3e8d-87c3-01fb93ed82e3",
                                                "text": "Er ist mit dem Gips durch die Gegend gehumpelt."
                                            },
                                            {
                                                "example_id": "47f7ec54-7001-46fc-b52d-4f1c0fac54b7",
                                                "sense_id": "5c89d8a6-d2f0-3e8d-87c3-01fb93ed82e3",
                                                "text": "Sie hat zwei Tage lang stark gehumpelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ece36373-3fd7-3dcc-8917-7c8bfc0a73d5",
                                        "entry_id": "acec4676-3822-3829-b5fd-0825f53c1969",
                                        "glosses": [
                                            "so fahren, dass es holpert"
                                        ],
