                    {
                        "sense_id": "21af558b-3e7a-3383-8bc9-64fc6081bc3e",
                        "entry_id": "704ee0e0-d3d5-373c-82a9-d033ffbd1f7d",
                        "glosses": [
                            "Poisson-perroquet, bec-de-perroquet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b4d7d7-8479-4bf3-af34-a2a6c7263315",
                                "sense_id": "21af558b-3e7a-3383-8bc9-64fc6081bc3e",
                                "text": "This fish isn’t just beautiful—parrotfish create the very sand on our beaches.",
                                "translation": "Ce poisson n’est pas que beau à voir ; les poissons-perroquets créent le sable même de nos plages."
                            },
                            {
                                "example_id": "fb15b78c-a04f-406c-84f9-ae7480a0d1ac",
                                "sense_id": "21af558b-3e7a-3383-8bc9-64fc6081bc3e",
                                "text": "Every night, certain species of parrotfish envelope themselves in a transparent cocoon made of mucous secreted from an organ on their head. Scientists think the cocoon masks their scent, making them harder for nocturnal predators, like moray eels, to find.",
                                "translation": "Chaque nuit, certaines espèces de poisson-perroquet s’enveloppent dans un cocon translucide fait de mucus sécrété par un organe situé sur leur tête. Les scientifiques pensent que ce cocon masque leur odeur, ce qui les rendrait plus difficiles à trouver pour les prédateurs nocturnes, telles que les murènes."
                            }
                        ]
                    }
                ],
