                                "target_senses": [
                                    {
                                        "sense_id": "fa5b328d-c575-3e7f-a830-3a90787fae3d",
                                        "entry_id": "36dc1f24-2a70-3c3a-87d8-19612312b669",
                                        "glosses": [
                                            "ağaçtan yapılan, iki karış boyunda, ağız bölümü yayvan, keskin bir ses çıkaran ve çoğu zaman davulla veya dümbelekle birlikte çalınan nefesli çalgı"
                                        ],
                                        "tags": [
                                            "müzik aletleri"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8858689-d5f7-4897-8348-c14f76bb5b65",
                                                "sense_id": "fa5b328d-c575-3e7f-a830-3a90787fae3d",
                                                "text": "Davullar dövüldü, zurnalar halay havaları üfürdü, düğün dernek kutlandı."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9ef68ad-b71b-421e-a9ac-5563c7315ecc",
                        "source_entry_id": "bd4b07e5-7212-3d40-b0e1-c8be2a836678",
                        "source_sense_id": "3b4bc767-da60-3445-a9b0-afd0801f06e1",
                        "target_lang_word": "zourna",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zourna",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9577a0-97a3-3be0-8e95-c64b96b2a7dc",
                                        "entry_id": "bdc7f2fd-9da1-3629-97cc-537a3a6fb6a6",
                                        "glosses": [
                                            "Instrument à vent à anche double de la grande famille des hautbois dont les origines remontent au VIIIᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84469f50-e15d-4477-826d-bc57beffe354",
                                                "sense_id": "6c9577a0-97a3-3be0-8e95-c64b96b2a7dc",
                                                "text": "Ayez donc appris que les orchestres nationaux se composent de « zournas », qui sont des flûtes aigres, de « salamouris », qui sont des clarinettes criardes, de mandolines à cordes de cuivre pincées avec une plume, de « tchianouris », violons dont on joue verticalement, de « dimplipitos », espèces de cymbales, qui crépitent comme la grêle sur les carreaux de vitre !"
                                            },
                                            {
                                                "example_id": "f4b37791-df69-46a1-9a0c-7449d048ec26",
                                                "sense_id": "6c9577a0-97a3-3be0-8e95-c64b96b2a7dc",
                                                "text": "On venait manifestement d’amener la jeune mariée : en montant l’escalier, Dalgat aperçut immédiatement le joueur de zourna en sueur et le joueur de tambour, auxquels on servait de l’eau minérale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
