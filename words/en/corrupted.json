                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The file was <w>corrupted</w> during the transfer process.",
                            "target_lang_translations": {
                                "ru": "Файл был <w>повреждён</w> в процессе передачи.",
                                "cs": "Soubor byl během přenosu <w>poškozen</w>."
                            }
                        },
                        {
                            "text": "Power has <w>corrupted</w> many leaders throughout human history.",
                            "target_lang_translations": {
                                "ru": "Власть <w>развратила</w> многих лидеров на протяжении человеческой истории.",
                                "cs": "Moc v lidské historii <w>zkazila</w> mnoho vůdců."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола corrupt (повреждать, развращать, коррумпировать).",
                        "cs": "Minulé příčestí od slovesa corrupt (poškodit, zkorumpovat, zkazit)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повреждён",
                                "target_lang_sense_clarification": "о файле или данных"
                            },
                            {
                                "target_lang_word": "развращён",
                                "target_lang_sense_clarification": "о человеке или обществе"
                            },
                            {
                                "target_lang_word": "испорчен",
                                "target_lang_sense_clarification": "о характере или системе"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "poškozený",
