                    }
                ],
                "senses": [
                    {
                        "sense_id": "513dafa4-4366-3bdf-a281-6a9826c94f9a",
                        "entry_id": "abcdaba8-9595-3a9d-b13d-e0e16fd535be",
                        "glosses": [
                            "een ruimte waar kunstwerken, veelal schilderijen, uitgestald worden en te koop worden aangeboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53704568-d36e-4fa6-9e9d-8e8d952adeea",
                                "sense_id": "513dafa4-4366-3bdf-a281-6a9826c94f9a",
                                "text": "Ze heeft daar een prachtige galerie die druk bezocht wordt."
                            },
                            {
                                "example_id": "99a318cf-665b-4f18-8069-134d6b058f79",
                                "sense_id": "513dafa4-4366-3bdf-a281-6a9826c94f9a",
                                "text": "Als kind al, wanneer ze in een hoekje van zijn galerie had zitten spelen, had ze Harold hierover horen discussiëren met klanten, zowel mannen als vrouwen, en vaak waren de vrouwen het met hem eens en steunden ze met hun geld liever jongemannen dan iemand van hun eigen sekse."
                            },
                            {
                                "example_id": "64dd19ee-91d4-4f47-910b-b33cbc29c408",
                                "sense_id": "513dafa4-4366-3bdf-a281-6a9826c94f9a",
                                "text": "Mijn blik schiet over de markante façade van de galerie waar France 3 Auvergne vorig jaar de beelden maakte van Emil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3bd7d3a-24d7-4f6b-85e5-b6484d44608f",
                        "source_entry_id": "abcdaba8-9595-3a9d-b13d-e0e16fd535be",
                        "source_sense_id": "513dafa4-4366-3bdf-a281-6a9826c94f9a",
                        "target_lang_word": "gallery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "242b13c9-c670-38f5-a851-619ca85ec327",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "An institution, building, or room for the exhibition and conservation of important objects, especially works of art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14f8f0d-92a1-4771-9bcc-0bc265929120",
                                                "sense_id": "242b13c9-c670-38f5-a851-619ca85ec327",
                                                "text": "In the gallery are displayed genuine artifacts dug up from the site, and in the gift shop you can buy a replica as a souvenir."
                                            },
                                            {
                                                "example_id": "a3877d12-3e58-4def-9d2d-5ee5a35db2a0",
                                                "sense_id": "242b13c9-c670-38f5-a851-619ca85ec327",
                                                "text": "Some of her work is so impressive that it really ought to be in a gallery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f965a2-b10d-3be4-8b30-8e897486a5d9",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "An establishment that buys, sells, and displays works of art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea47043-7deb-49cf-9bcb-f7ef00c5dc14",
                                                "sense_id": "c0f965a2-b10d-3be4-8b30-8e897486a5d9",
                                                "text": "Near-synonyms: art dealer's, dealer's"
                                            },
                                            {
                                                "example_id": "c3d487f1-72d7-474d-affd-a1fa77df7dda",
                                                "sense_id": "c0f965a2-b10d-3be4-8b30-8e897486a5d9",
                                                "text": "Some of her best work can be yours: it is available at a gallery, if you can afford it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "027dd399-50bd-3f41-9e22-e24be12103e2",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "The uppermost seating area projecting from the rear or side walls of a theater, concert hall, or auditorium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c804e7-63a0-4d88-ba90-484644d09627",
                                                "sense_id": "027dd399-50bd-3f41-9e22-e24be12103e2",
                                                "text": "We could afford the less expensive seats in the gallery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c426191d-2b30-3309-ab9d-c9be87a19335",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "The spectators at an event, collectively."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d41ca867-f1ca-445f-9122-66ffba7d42ef",
                                                "sense_id": "c426191d-2b30-3309-ab9d-c9be87a19335",
                                                "text": "The politician was clearly appealing to the gallery"
                                            },
                                            {
                                                "example_id": "473ca106-8d42-476e-a95d-e031473062a3",
                                                "sense_id": "c426191d-2b30-3309-ab9d-c9be87a19335",
                                                "text": "Capello was missing his son's wedding in Milan to take charge – yet his reshaped England team gave him cause for a double celebration as they overturned the odds in front of a delighted Wembley gallery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c69ad2e2-eb5a-33e3-b624-e10fa9874ca6",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "The part of a courtroom, often elevated and in the rear, where seating for the public audience is facilitated during trial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6967aa8-0465-43f3-b41d-33e3ff467882",
                                                "sense_id": "c69ad2e2-eb5a-33e3-b624-e10fa9874ca6",
                                                "text": "appealing to the gallery"
                                            },
                                            {
                                                "example_id": "5486d46c-a3a1-483a-829f-80fd9a530363",
                                                "sense_id": "c69ad2e2-eb5a-33e3-b624-e10fa9874ca6",
                                                "text": "Rose and Valerie, screaming from the gallery\nSay he must go free"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13646b96-5648-3d71-9fa6-ee43c3015470",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "A roofed promenade, especially one extending along the wall of a building and supported by arches or columns on the outer side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b545ee-f5bd-4025-9933-bc81c95b027f",
                                                "sense_id": "13646b96-5648-3d71-9fa6-ee43c3015470",
                                                "text": "elegant galleries looking out onto manicured gardens"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e4dd4c-0f04-308a-9a69-81bb629a49d5",
                                        "entry_id": "739cd662-d9b3-3bad-9f5c-0d339172a77c",
                                        "glosses": [
                                            "A browsable collection of images, font styles, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8fc081-c040-4e61-8d31-7f078a02582a",
                                                "sense_id": "89e4dd4c-0f04-308a-9a69-81bb629a49d5",
                                                "text": "a gallery of image thumbnails"
                                            },
                                            {
                                                "example_id": "3de615a2-9ecb-409d-ae8d-ec6f8c3fb9ee",
                                                "sense_id": "89e4dd4c-0f04-308a-9a69-81bb629a49d5",
                                                "text": "a clip-art gallery in a word processor"
                                            }
                                        ]
                                    },
