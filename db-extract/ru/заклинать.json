                "senses": [
                    {
                        "sense_id": "19acb042-1a96-3e47-bc80-b5006a8de125",
                        "entry_id": "16b726ef-f005-3e13-be2f-e36ada10cf17",
                        "glosses": [
                            "ворожбой, колдовством подчинять магической силе, делать покорным тому, кто обладает тайными знаниями"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "354ff923-97d6-33e1-932a-685c95af9ec7",
                        "entry_id": "16b726ef-f005-3e13-be2f-e36ada10cf17",
                        "glosses": [
                            "умолять с торжественной настойчивостью во имя чего-либо святого, высокого"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9327f0cf-77ae-485e-90ef-8e5cafabf13d",
                                "sense_id": "354ff923-97d6-33e1-932a-685c95af9ec7",
                                "text": "Но заклинаю держать в тайне моё имя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e0f80e6-eaeb-4e9d-89d9-bd438f51abda",
                        "source_entry_id": "16b726ef-f005-3e13-be2f-e36ada10cf17",
                        "source_sense_description": "умолять",
                        "target_lang_word": "implorer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implorer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fdcc0c9-65c5-3723-a4d8-c7ec7e578557",
                                        "entry_id": "a888fad8-a55a-384c-adf2-22ae5d5e7f20",
                                        "glosses": [
                                            "Demander humblement et avec instance, secours, faveur, ou grâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13fe98a1-edcf-4870-9c62-a52d303d7c68",
                                                "sense_id": "5fdcc0c9-65c5-3723-a4d8-c7ec7e578557",
                                                "text": "On poursuivait un homme, on allait le tuer ; il vint tomber à genoux contre la porte de l’hôtel, comme s’il eût imploré ma protection."
                                            },
                                            {
                                                "example_id": "a41c048b-28a0-4b00-b8b7-e9487824c6e0",
                                                "sense_id": "5fdcc0c9-65c5-3723-a4d8-c7ec7e578557",
                                                "text": "J’implorai avec ferveur la belle image de la Vierge coloriée à laquelle, tous les soirs, avant de me coucher, j’adressais ma prière."
                                            },
                                            {
                                                "example_id": "8a0dcf03-414b-4f58-8754-ac4f5a7bec84",
                                                "sense_id": "5fdcc0c9-65c5-3723-a4d8-c7ec7e578557",
                                                "text": "[…] je dois murmurer à voix très basse :\n— Esprit-Saint, aidez-moi !\nL’idéal serait de faire en même temps le signe de croix. À l’église, pas de problème. En classe, dans la rue, impossible d’implorer le secours de l’Esprit-Saint : les communistes se moqueraient de moi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
