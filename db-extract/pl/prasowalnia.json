                                                "example_id": "f9605d84-829a-46e6-a292-5eb3a00e5222",
                                                "sense_id": "c75848ba-3e97-32c7-8637-ae02674bed2d",
                                                "text": "But, then, running into the guy who rooms across the hall from me—in the Paris Metro?"
                                            }
