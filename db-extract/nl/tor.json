                                    {
                                        "sense_id": "d3d502ee-f0f7-343a-9268-191372cc2edb",
                                        "entry_id": "a06dc5fa-a40c-34e2-aca9-a2c04bb86378",
                                        "glosses": [
                                            "To beat with a heavy mallet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72c4de77-4697-3a62-8ce2-5084799933ac",
