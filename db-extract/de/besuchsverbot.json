                "senses": [
                    {
                        "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                        "entry_id": "98db097c-baee-3b1c-9ede-e08738dfdbae",
                        "glosses": [
                            "Einschränkung des Umgangs mit anderen Personen; Verbot, eine bestimmte andere Person oder generell andere Menschen zu sehen/treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d5f021-993d-49ab-ad88-1be674dcc508",
                                "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                                "text": "„Wann sind Hausverbote/Besuchsverbote zulässig?“"
                            },
                            {
                                "example_id": "b33ef8dd-2b3a-45da-bfc1-f80a157ca0f5",
                                "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                                "text": "Der Untersuchungshäftling bekam ein Besuchsverbot auferlegt."
                            },
                            {
                                "example_id": "9566ae79-94eb-431e-a712-75ff285034a2",
                                "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                                "text": "„Die türkische Regierung hat ein seit acht Jahren geltendes Besuchsverbot für den inhaftierten PKK-Gründer Abdullah Öcalan aufgehoben.“"
                            },
                            {
                                "example_id": "3738b910-006e-4fd4-9ba3-81ff4d80b903",
                                "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                                "text": "Der Ehemann konnte ein Besuchsverbot seiner gewalttätigen Ehefrau bewirken."
                            },
                            {
                                "example_id": "d8d2ad8e-a5b6-434c-9fb3-7cb15040d050",
                                "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                                "text": "„Das vorübergehende Besuchsverbot habe sich der Vater selber zuzuschreiben: offenbar weigere er sich, die Kinder am Wohnort der Mutter abzuholen.“"
                            },
                            {
                                "example_id": "abb0ae59-9350-43f6-9a85-bdcdf8f5254c",
                                "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                                "text": "Schweden sprach dem verurteilten Straftäter gegenüber ein 5-jähriges Besuchsverbot aus."
                            },
                            {
                                "example_id": "c665b006-1f7e-452e-8476-f1a0f8829bd5",
                                "sense_id": "125bdc6c-866e-37bd-994e-5141ffe635f0",
                                "text": "„Ein Besuchsverbot in der Hausordnung empfinden viele Mieter als unangemessene Einmischung in die Privatsphäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
