                        "sense_id": "c22b1417-7bb4-3a5b-a1e4-9c3c09aa1d16",
                        "entry_id": "23bb0da1-9e99-3899-98ef-f80d971572d2",
                        "glosses": [
                            "całokształt jakiegoś sprzętu, np. narzędzia, oprzyrządowanie sportowe"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "d29d4f75-78cc-47db-8fdc-595d470a3116",
                                "sense_id": "c22b1417-7bb4-3a5b-a1e4-9c3c09aa1d16",
                                "text": "Major Anatol Gmitruk zostawił cały szpej Olafowi, nie licząc niewielkiego bidonu z wodą, który włożył do bocznej kieszeni spodni, i wysłał go do schroniska z przykazaniem czekania i pilnowania, żeby turyści nie wypili całego piwa."
                            },
                            {
                                "example_id": "9447a97f-353f-46da-922d-a4e8ca54e05e",
                                "sense_id": "c22b1417-7bb4-3a5b-a1e4-9c3c09aa1d16",
                                "text": "Ja od koleżanki dostałem bogaty szpej fotograficzny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
