                        ]
                    },
                    {
                        "translation_id": "e63d71c6-5ce5-4c8e-a95b-bc2bbaa301cc",
                        "source_entry_id": "085453fd-f9dd-3da0-bffc-6130d27e3b9f",
                        "source_sense_id": "49dbeec8-5180-3e62-b71b-3f5b5125a9be",
                        "source_sense_description": "de toestand waarin iets of iemand aan het eind van zijn of haar krachten is",
                        "target_lang_word": "épuisement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épuisement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da936678-7527-3612-8636-1400d278819e",
                                        "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                                        "glosses": [
                                            "Action d’épuiser, en tout ou en partie, les eaux amassées en un endroit ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7c2cd5-c3d6-4127-bbdf-fbe2f5cc62db",
                                                "sense_id": "da936678-7527-3612-8636-1400d278819e",
                                                "text": "On travaille depuis plusieurs jours à l’épuisement des eaux de la mine."
                                            },
                                            {
                                                "example_id": "b0831033-2947-427a-ad02-14ce9df4b96f",
                                                "sense_id": "da936678-7527-3612-8636-1400d278819e",
                                                "text": "Au bout du canal se dressait la tour d’un moulin à épuisement, dont les ailes au repos ressemblaient, avec leurs nervures noires, à des ailes de libellule grossies plusieurs milliers de fois par le microscope solaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13b0c812-8a5c-3cb4-94d1-c506d1cde8d0",
                                        "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                                        "glosses": [
                                            "Perte considérable de telle ou telle partie des forces de l’organisme et en général dissipation de forces."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21963b82-0114-4d46-8232-383220f4e1fd",
                                                "sense_id": "13b0c812-8a5c-3cb4-94d1-c506d1cde8d0",
                                                "text": "Les soins des deux femmes ne tardèrent pas à ranimer entièrement la jeune Esquimaude, dont l’extrême épuisement provenait non seulement de la fatigue, mais aussi de la faim."
                                            },
                                            {
                                                "example_id": "f62aa569-253e-44a2-8947-b8fed3bcf35b",
                                                "sense_id": "13b0c812-8a5c-3cb4-94d1-c506d1cde8d0",
                                                "text": "En plus du mal de mer, les rescapés souffraient de déshydratation, d'épuisement, de sérieux coups de soleil et portaient également les séquelles d’un stress psychologiques grave lié à la peur de périr en mer pendant quatre jours et quatre nuits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c443d0-fb44-3ee9-9094-e1a9c954dd43",
                                        "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                                        "glosses": [
                                            "Résultat de dépenses excessives, bien supérieures aux recettes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea71dbe-95a1-4371-805a-c33b45c9bfb9",
                                                "sense_id": "d7c443d0-fb44-3ee9-9094-e1a9c954dd43",
                                                "text": "L’épuisement du Trésor contraignit de recourir à des moyens extraordinaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b0e0065-28a6-4330-88ec-316f4c7be2d4",
                        "source_entry_id": "085453fd-f9dd-3da0-bffc-6130d27e3b9f",
                        "source_sense_id": "49dbeec8-5180-3e62-b71b-3f5b5125a9be",
                        "source_sense_description": "de toestand waarin iets of iemand aan het eind van zijn of haar krachten is",
                        "target_lang_word": "prostration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prostration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                        "entry_id": "0b2aad59-bad3-30bc-a9ce-6c8f22865453",
                                        "glosses": [
                                            "Affaiblissement extrême ; profond abattement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c36512-aae4-44fe-a62d-6cd4a908e4f9",
                                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                                "text": "Je lui racontai tout: cette étrange hallucination qui me prenait à cette heure où Kostaki avait dû mourir; cette terreur, cet engourdissement, ce froid de glace, cette prostration qui me couchait sur mon lit."
                                            },
                                            {
                                                "example_id": "4960662a-607e-4a36-8676-35b6669cd786",
                                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                                "text": "Elle se perdait ainsi durant des jours dans ses rêves, qui se terminaient d’ordinaire par des accès de complète prostration."
                                            },
                                            {
                                                "example_id": "bff153c5-991b-46fa-8e04-30ca2700fb77",
                                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                                "text": "Disons plus : la pieuse prostration de l’enfant qui a perdu sa vieille mère, par exemple, n’est-elle pas (de nos jours) un luxe que les indigents, harcelés par une tâche obligatoire, ne peuvent se permettre ? Le loisir de cette songerie morbide n’est donc pas de première nécessité : l’on peut, enfin, s’en passer ?"
                                            },
                                            {
                                                "example_id": "9e5c98aa-0214-46ae-8e71-2efb25fa079a",
                                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                                "text": "Cependant ces accidents s’amendèrent, mais la prostration morale ne s’améliora pas, et au bout de quelques jours, il n’y eut plus qu’elle qui inquiéta le médecin."
                                            },
                                            {
                                                "example_id": "f713cd3a-266a-4c78-96d8-6c1204356368",
                                                "sense_id": "a6d772d1-8e17-3cbf-8e7e-4b7cff5b43b6",
                                                "text": "Mon père profita de cette prostration totale de mes forces pour me demander la promesse formelle de partir avec lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67819ec9-5463-4429-85d7-8915de32025e",
                        "source_entry_id": "085453fd-f9dd-3da0-bffc-6130d27e3b9f",
                        "source_sense_id": "49dbeec8-5180-3e62-b71b-3f5b5125a9be",
                        "source_sense_description": "de toestand waarin iets of iemand aan het eind van zijn of haar krachten is",
                        "target_lang_word": "изнеможение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "изнеможение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "63fcd0bd-5789-3d6b-882b-63da8b38523b",
                                        "entry_id": "2ed2738e-7f8b-396a-85f5-ecf5075a8c00",
                                        "glosses": [
                                            "состояние крайней усталости, утомления, полного бессилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49b3a7f0-0610-4068-857c-2e8902451815",
                                                "sense_id": "63fcd0bd-5789-3d6b-882b-63da8b38523b",
                                                "text": "Нынешний «хороший» человек не наедается за обедом до отвала и не падает, после гречневой каши, от изнеможения сил."
                                            },
                                            {
                                                "example_id": "d3ec67a4-a0a0-4270-97df-7119c5feb1db",
                                                "sense_id": "63fcd0bd-5789-3d6b-882b-63da8b38523b",
                                                "text": "Усталый и счастливый до изнеможения, я вышел из флигеля; на прощанье Зинаида мне крепко пожала руку и опять загадочно улыбнулась."
                                            },
                                            {
                                                "example_id": "083f7d06-e83b-49ca-b97e-acf9ecc6b614",
                                                "sense_id": "63fcd0bd-5789-3d6b-882b-63da8b38523b",
                                                "text": "Генеральша вскрикнула и в изнеможении упала в кресло."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e2b608c-d81b-463f-9dea-7d403154b74e",
                        "source_entry_id": "085453fd-f9dd-3da0-bffc-6130d27e3b9f",
