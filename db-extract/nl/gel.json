                    {
                        "sense_id": "3e07c703-0f0e-36e5-83a8-0268ed9f9df0",
                        "entry_id": "af49b593-8b0e-3b64-9910-02c0a1a1289c",
                        "glosses": [
                            "een gecrosslinkt polymeer van voldoende verdunning om vervormbaar te zijn zonder spontaan te vloeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45107b82-a98d-48ab-bb01-d62eec693b3c",
                                "sense_id": "3e07c703-0f0e-36e5-83a8-0268ed9f9df0",
                                "text": "Gels worden onder andere toegepast bij elektroforese."
                            }
                        ]
                    },
                    {
                        "sense_id": "73e0cdc7-0acf-3817-b4f1-0d43ee0681fc",
                        "entry_id": "af49b593-8b0e-3b64-9910-02c0a1a1289c",
                        "glosses": [
                            "een product om haar mee in model te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1917189a-266c-4c4e-92f3-1b544dec551f",
                                "sense_id": "73e0cdc7-0acf-3817-b4f1-0d43ee0681fc",
                                "text": "Hij doet vaak gel in zijn haar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b24f9d0-6d6a-4ab5-809f-83ba51b45420",
                        "source_entry_id": "af49b593-8b0e-3b64-9910-02c0a1a1289c",
                        "source_sense_id": "3e07c703-0f0e-36e5-83a8-0268ed9f9df0",
                        "source_sense_description": "een gecrosslinkt polymeer van voldoende verdunning om vervormbaar te zijn zonder spontaan te vloeien",
                        "target_lang_word": "gel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6336a863-e76f-38e4-acd5-74d2870c67ba",
                                        "entry_id": "b4c9af03-c6ab-31c7-a162-55d9abba61a9",
                                        "glosses": [
                                            "A semi-solid to almost solid colloid of a solid and a liquid, such as jelly, cheese or opal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714a8f13-6006-4553-872a-3bea59d0d0f1",
                                                "sense_id": "6336a863-e76f-38e4-acd5-74d2870c67ba",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2beeba58-1749-3fd2-a921-51fef5377d78",
                                        "entry_id": "b4c9af03-c6ab-31c7-a162-55d9abba61a9",
                                        "glosses": [
                                            "Any gel intended for a particular cosmetic use, such as for styling the hair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8dd9589-c562-30ed-b1d4-f3890152afab",
                                        "entry_id": "b4c9af03-c6ab-31c7-a162-55d9abba61a9",
                                        "glosses": [
                                            "A film of flexible transparent plastic (such as acetate, celluloid, or cellophane) suitable for making superimpositions or diapositives (image to overlay on other images, especially for overhead projectors); a digital virtual equivalent of this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8e255e9-33c5-322b-bf68-da3c64868cb6",
                                        "entry_id": "5ae05a46-e4d7-356a-b280-1e85a598ad89",
                                        "glosses": [
                                            "To apply (cosmetic) gel to (the hair, etc)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "457d5b6b-b113-4c60-a303-60a2165924ff",
                                                "sense_id": "a8e255e9-33c5-322b-bf68-da3c64868cb6",
                                                "text": "It ended, as it so often does, with that familiar smile. Cristiano Ronaldo – gelled hair, dazzling teeth, magic in his boots – will never forget the night he scored the 600th goal of an almost implausible career."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af215783-9a52-37c0-87a3-64051234556a",
                                        "entry_id": "5ae05a46-e4d7-356a-b280-1e85a598ad89",
                                        "glosses": [
                                            "To become a gel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7d15805-2ea6-3745-b380-b3ac4256c741",
                                        "entry_id": "5ae05a46-e4d7-356a-b280-1e85a598ad89",
                                        "glosses": [
                                            "To develop a rapport."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f94fdb6-3940-4cf3-8ff5-847de50f5b2f",
                                                "sense_id": "b7d15805-2ea6-3745-b380-b3ac4256c741",
                                                "text": "He was a nice guy, and I got on OK with his friends, but the two of us never really gelled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98633282-056e-39a4-870f-a02447d4f851",
                                        "entry_id": "5ae05a46-e4d7-356a-b280-1e85a598ad89",
                                        "glosses": [
                                            "To come together to form something; to cohere."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdb02cd9-4bae-435e-978c-f55b67d79b63",
                                                "sense_id": "98633282-056e-39a4-870f-a02447d4f851",
                                                "text": "We put our ideas together and they eventually gelled into a saleable product."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3630434-2d22-3575-aec5-c8d431ab9e72",
                                        "entry_id": "1e75bd92-f103-3d53-a4ff-cfac32f9e8b6",
                                        "glosses": [
                                            "A girl."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53874926-1ab2-4ed5-84e9-7212bf85644f",
                                                "sense_id": "a3630434-2d22-3575-aec5-c8d431ab9e72",
                                                "text": "\"Now pray don't be troublesome, my dear gel,\" said Uncle Andrew."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0ec7024-7cbd-494c-b9a8-476050703a7f",
                        "source_entry_id": "af49b593-8b0e-3b64-9910-02c0a1a1289c",
                        "source_sense_id": "3e07c703-0f0e-36e5-83a8-0268ed9f9df0",
                        "source_sense_description": "een gecrosslinkt polymeer van voldoende verdunning om vervormbaar te zijn zonder spontaan te vloeien",
                        "target_lang_word": "gel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff41eaeb-d9f4-3616-b036-672b88f18a3e",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Solidification de l’eau en glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2487558c-78b8-42e8-86ea-a9c39093e6a5",
                                                "sense_id": "ff41eaeb-d9f4-3616-b036-672b88f18a3e",
                                                "text": "L’ombre et le gel habitent la chambre où les colchiques mauves s’épanouissaient, en automne, dans le vase que tu m’as donné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f380491-fa3d-34e6-b045-1adc9bb424a2",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Température en dessous de zéro degré Celsius."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac2b2daf-cd08-4768-9434-66d2ad283152",
                                                "sense_id": "9f380491-fa3d-34e6-b045-1adc9bb424a2",
                                                "text": "Confirmant les observations déjà réalisées sur la coupe de Ménil-Lépinois, les blocs crayeux, en surface comme sur toute la profondeur de pénétration du gel (10 à 12 cm), sont entourés d'une enveloppe de glace de cryosuccion."
                                            },
                                            {
                                                "example_id": "386f0451-56c4-47b2-b4ea-402266a2ff95",
                                                "sense_id": "9f380491-fa3d-34e6-b045-1adc9bb424a2",
                                                "text": "Le gel a détruit la récolte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e4e7ac-8ee8-36fe-bc5a-a78a4ecfa161",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Solution colloïdale qui est surtout liquide paraissant un solide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2686717e-cd56-454a-8c2c-754c7d8724a7",
                                                "sense_id": "f5e4e7ac-8ee8-36fe-bc5a-a78a4ecfa161",
                                                "text": "La gélatine est un gel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Arrêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ab4bec-ca48-4fc9-9db1-6932b5eef4d9",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Le gel des salaires."
                                            },
                                            {
                                                "example_id": "e2a06cf8-4792-421d-b8ec-f8339eb37454",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Le gel des relations diplomatiques entre l’Iran et les États-Unis."
                                            },
                                            {
                                                "example_id": "de95722e-154d-4e82-8e3f-b543e95c890c",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Au début de juillet, le conseil d’administration a également annoncé dans un courriel interne un gel des adhésions, dénoncé une « action de dénigrement et de déstabilisation » de l’association, et menacé des wikipédiens de poursuites judiciaires."
                                            },
                                            {
                                                "example_id": "4ba91518-0e92-4091-8b2e-35849134b1c4",
                                                "sense_id": "63d0cc2b-74b8-33a5-8cde-cc12fcaba3b1",
                                                "text": "Le ministère britannique des Affaires étrangères impose également un gel des avoirs à trois généraux de l’armée birmane, à qui elle interdit également de venir sur son sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9406b9b9-8de1-3ebe-8a87-bf3edf07a97e",
                                        "entry_id": "c8d168f8-6f87-344b-bc3b-6c11bdc4148b",
                                        "glosses": [
                                            "Gel permettant de fixer les cheveux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
