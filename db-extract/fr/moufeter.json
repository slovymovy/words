                "senses": [
                    {
                        "sense_id": "65e2173b-4343-3cfe-9d9f-ac453df98874",
                        "entry_id": "ec87bb45-3505-35d9-84d2-8240a0d9c862",
                        "glosses": [
                            "Autre orthographe de moufter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555fed10-e771-42af-97c6-e65880a7cc08",
                                "sense_id": "65e2173b-4343-3cfe-9d9f-ac453df98874",
                                "text": "— J’t’amène ton fils, Chalumot ! Évadé de son École. Il a pas moufeté… Je l’ai cueilli comme une fleur, en bas d’chez nous."
                            },
                            {
                                "example_id": "f905a2f9-94e5-4d8e-b6bd-6a67527f2d73",
                                "sense_id": "65e2173b-4343-3cfe-9d9f-ac453df98874",
                                "text": "Macron s’est payé le luxe de dénoncer Russia Today et Sputnik, deux médias financés par le Kemlin […]. Sans que Poutine — « la mine fermée », certifie « Le Parisien » — n’ose moufeter."
                            },
                            {
                                "example_id": "4624c1ed-0790-4a9e-88ed-e19fa07c1e47",
                                "sense_id": "65e2173b-4343-3cfe-9d9f-ac453df98874",
                                "text": "Personne ne moufetait, visage grave et fermé, à gauche comme à droite de Sylvia Monford."
                            }
                        ]
                    }
