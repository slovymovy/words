                "senses": [
                    {
                        "sense_id": "d9cade3a-081b-3981-b86c-2685d559eee8",
                        "entry_id": "0169d2d3-0cc5-3625-ad3c-f222413ea5d8",
                        "glosses": [
                            "geordende lijst met beschikbare zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe255c70-cf2b-4f24-ad74-99e249eaa173",
                                "sense_id": "d9cade3a-081b-3981-b86c-2685d559eee8",
                                "text": "De cataloog van Virgin Records omvat onder andere ook platen van de Rolling Stones en Iggy Pop."
                            },
                            {
                                "example_id": "184b9a19-9a96-44db-9874-d6b20cc80951",
                                "sense_id": "d9cade3a-081b-3981-b86c-2685d559eee8",
                                "text": "Maar we zitten hier met een klassiek probleem. Het is niet zo eenvoudig objectief te bepalen wie van de mensen die ooit één boek hebben gepubliceerd, ‘auteur’ is, en wie niet. Dus hoe hebben we dat concreet aangepakt? Ik heb aan de Stedelijke Openbare Bibliotheek Gent gevraagd of ze me een lijst konden geven met alle auteurs van fictiewerken die in de open rekken staan (dus nog uitgeleend kunnen worden). Hierbij hebben we geen verdere beperkingen gemaakt, zodat auteurs van strips en kinderboeken er ook bij kwamen. Het was wel even slikken toen dit een lijst van vijftienduizend namen opleverde! Maar dat is nu eenmaal wat je kunt ontlenen (en opzoeken) in de cataloog van de Bibliotheek in Gent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03881fd6-cb3a-4809-bd2b-77ca71a5a8fe",
                        "source_entry_id": "0169d2d3-0cc5-3625-ad3c-f222413ea5d8",
                        "source_sense_id": "d9cade3a-081b-3981-b86c-2685d559eee8",
                        "target_lang_word": "Katalog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katalog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c7bd3e5-a6fe-3970-99bb-234ebecc563e",
                                        "entry_id": "5b0df31d-3291-3c28-a55e-3e829860452e",
                                        "glosses": [
                                            "systematisch erstelltes Verzeichnis von Sachen oder auch von Personen, die gemeinsame Merkmale aufweisen; Verkaufs-, Warenangebot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8915a6e8-66a2-442a-8f11-85ef5caf0d95",
                                                "sense_id": "3c7bd3e5-a6fe-3970-99bb-234ebecc563e",
                                                "text": "Der Katalog enthält preisgünstige Angebote."
                                            },
                                            {
                                                "example_id": "68e89300-45b8-4a2d-baa6-77c7caa8b58b",
                                                "sense_id": "3c7bd3e5-a6fe-3970-99bb-234ebecc563e",
                                                "text": "„Heute nehmen sie die Bergsportler ins Visier, bieten Klettersteige nach Katalog oder nehmen die vorhandenen Wege und klassifizieren sie.“"
                                            },
                                            {
                                                "example_id": "2ffdb625-613e-4518-9083-a3542736f243",
                                                "sense_id": "3c7bd3e5-a6fe-3970-99bb-234ebecc563e",
                                                "text": "„Alles musste sie sich mühsam aus den Katalogen und Prospekten zusammenlesen.“"
                                            },
                                            {
                                                "example_id": "350298ea-65ec-445e-b788-083f4faf1ecd",
                                                "sense_id": "3c7bd3e5-a6fe-3970-99bb-234ebecc563e",
                                                "text": "„Die Sinnfindung in solchen Konzeptionen, heißt es in dem Katalog, ist auf die Irrsinnsmasse der amüsiergesellschaftlichen Zukunft orientiert.“"
                                            },
                                            {
                                                "example_id": "ed5f369a-51ff-4141-b13c-8e7e56c2b14f",
                                                "sense_id": "3c7bd3e5-a6fe-3970-99bb-234ebecc563e",
                                                "text": "„In ihrer ausdruckslosen Art glichen sie Modepuppen, die aus dem Katalog eines Konfektionshauses in Lebensgröße ausgeschnitten waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "446e5a99-3f31-358a-ad97-a9538cd22ee1",
                                        "entry_id": "5b0df31d-3291-3c28-a55e-3e829860452e",
                                        "glosses": [
                                            "Verzeichnis von Maßnahmen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ec599e02-61a7-3617-b2e0-db861c5a60a7",
                                        "entry_id": "5b0df31d-3291-3c28-a55e-3e829860452e",
                                        "glosses": [
                                            "Bestandsliste (beispielsweise in Bibliotheken)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd756f7-b02e-46f7-97f1-4e252cc19ce2",
                                                "sense_id": "ec599e02-61a7-3617-b2e0-db861c5a60a7",
                                                "text": "Alle Werke mit Erscheinungsjahr ab einschließlich 1971 sind in diesem Katalog verzeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
