                        "glosses": [
                            "народная эпическая песня у древних карелов, финнов, эстонцев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32540c7e-6158-48a2-a804-3efdd2cb2973",
                                "sense_id": "26a5fca3-2430-3120-a97b-07b71b1a52f9",
                                "text": "Город мой, твои громады-скалы, // Что стоят кругом, тебя храня, // Сделать руной новой Калевалы —// Вот мечта заветная моя."
