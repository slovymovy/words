                {
                    "sense_id": "be589a4a-76c5-3575-9d4d-f2136f168215",
                    "sense_definition": "In a quiet, gentle, and submissive way, often without arguing or expressing one's own opinion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>meekly</w> accepted the unfair decision because he was afraid to cause a scene.",
                            "target_lang_translations": {
                                "ru": "Он <w>покорно</w> принял несправедливое решение, так как боялся устроить сцену.",
                                "cs": "To nespravedlivé rozhodnutí <w>pokorně</w> přijal, protože se bál vyvolat scénu."
                            }
                        },
                        {
                            "text": "The dog followed its owner <w>meekly</w> back into the house after being scolded.",
                            "target_lang_translations": {
                                "ru": "Собака <w>смиренно</w> пошла за хозяином обратно в дом после того, как её отругали.",
                                "cs": "Pes po vyhubování <w>krotce</w> následoval svého majitele zpět do domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "submissively",
                        "humbly",
                        "docilely",
                        "obediently",
                        "timidly"
                    ],
                    "antonyms": [
                        "boldly",
                        "assertively",
                        "defiantly",
                        "arrogantly"
                    ],
                    "common_phrases": [
                        "accepted meekly",
                        "followed meekly",
                        "answered meekly",
                        "surrendered meekly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихо, мягко и покорно, часто без возражений или выражения собственного мнения.",
                        "cs": "Tichým, jemným a poddajným způsobem, často bez odporu nebo vyjádření vlastního názoru."
                    },
