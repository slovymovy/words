                "senses": [
                    {
                        "sense_id": "21b04546-65fc-38c2-ba92-cada58114192",
                        "entry_id": "9e6e0d62-3df0-3322-8eb4-5b5e99f2619a",
                        "glosses": [
                            "Grenze zwischen den Angreifern und den Verteidigern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1429f9fd-337f-40ec-b1f3-c864b43d5c4a",
                                "sense_id": "21b04546-65fc-38c2-ba92-cada58114192",
                                "text": "Die gegnerische Angriffslinie ist undurchbrechbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfd09c1b-52df-3334-96e4-5e86d13c7cfe",
                        "entry_id": "9e6e0d62-3df0-3322-8eb4-5b5e99f2619a",
                        "glosses": [
                            "Linie, in der Anlagen und/oder Truppen zwecks Angriff aufgeboten sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92226ddd-4381-4cdf-91ce-9fc5315e607e",
                                "sense_id": "cfd09c1b-52df-3334-96e4-5e86d13c7cfe",
                                "text": "„Sie nähern sich der Angriffslinie und feuern - jeder dreimal - auf die rund 500 Meter entfernten Ziele.“"
                            },
                            {
                                "example_id": "98f1cad4-6046-4c7c-9114-05c6dc8bf203",
                                "sense_id": "cfd09c1b-52df-3334-96e4-5e86d13c7cfe",
                                "text": "„Russlands Angriffslinie zeigt Schwachstellen: Nicht alle gepanzerten Fahrzeuge sind mit Störtechnologie ausgestattet, was sie zur leichten Beute für ukrainische Drohnen macht.“"
                            },
                            {
                                "example_id": "7dc211b7-d9f2-4e8b-89fa-d0c11f5f7f5a",
                                "sense_id": "cfd09c1b-52df-3334-96e4-5e86d13c7cfe",
                                "text": "„Der Stabschef des ukrainischen Präsidenten hat erstmals eingeräumt, dass die ukrainischen Streitkräfte in der Region Cherson am Ostufer des Flusses Dnipro Fuß gefasst haben, was eine neue Angriffslinie in Richtung Krim eröffnen könnte.“"
                            },
                            {
                                "example_id": "9bf63b61-a568-439c-b7c4-d07a93630115",
                                "sense_id": "cfd09c1b-52df-3334-96e4-5e86d13c7cfe",
                                "text": "„Der Transport schwerer militärischer Ausrüstung und von Vorräten über den Fluss könnte es den ukrainischen Truppen ermöglichen, eine neue Angriffslinie im Süden auf dem direktesten Landweg zur Schwarzmeer-Halbinsel Krim zu eröffnen, die 2014 von Russland annektiert wurde.“"
                            },
                            {
                                "example_id": "c88b1a13-b6b7-4897-8f7c-230a2a8307cc",
                                "sense_id": "cfd09c1b-52df-3334-96e4-5e86d13c7cfe",
                                "text": "„Ist sie außerhalb der Angriffslinie, geht ihr Alltag erst einmal weiter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c0444737-bcba-3927-97df-68d0c5af5e98",
                        "entry_id": "9e6e0d62-3df0-3322-8eb4-5b5e99f2619a",
                        "glosses": [
                            "Wirkungslinie, Gerade in Richtung der an einem Körper angreifenden Kraft"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
