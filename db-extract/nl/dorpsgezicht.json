                        "entry_id": "b728eb02-ca40-3fe9-9b26-c8335e84ab01",
                        "glosses": [
                            "het uiterlijk van een dorp; hoe een dorp er uitziet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed37d5c7-3177-4d22-b21f-84b1457f6c9f",
                                "sense_id": "a7941a8c-4b04-3294-92d5-8eb5c40386e9",
                                "text": "Dorpsgezicht Ik heb zelf nooit in een Russisch dorp gewoond."
                            },
                            {
                                "example_id": "897b9be6-15a4-4f2f-b4ce-3675077b7f06",
                                "sense_id": "a7941a8c-4b04-3294-92d5-8eb5c40386e9",
                                "text": "De gemeente verzette zich, want als de woning zou verdwijnen werd het beschermde dorpsgezicht ernstig aangetast. De familie Van Dijken toonde belangstelling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b38beab-2838-4eb7-9786-a50f2112f4c5",
                        "source_entry_id": "b728eb02-ca40-3fe9-9b26-c8335e84ab01",
                        "source_sense_id": "a7941a8c-4b04-3294-92d5-8eb5c40386e9",
                        "source_sense_description": "het uiterlijk van een dorp; hoe een dorp er uitziet",
                        "target_lang_word": "site",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
