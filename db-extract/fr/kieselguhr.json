                ],
                "senses": [
                    {
                        "sense_id": "42eaa7c0-7aca-3aa3-ada7-ee7c6753c0e0",
                        "entry_id": "a6cfbdb3-43ec-33b7-a04c-795636b9f827",
                        "glosses": [
                            "Terre de diatomée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a354a6-cff9-459f-90ab-3bb22162e2ab",
                                "sense_id": "42eaa7c0-7aca-3aa3-ada7-ee7c6753c0e0",
                                "text": "On ajoute à ce moment 172 grammes de silice pulvérisée impalpable : cette silice porte le nom de farine fossile ou kieselguhr."
                            },
                            {
                                "example_id": "7d8d3b22-231c-4252-aacc-ab5212a54275",
                                "sense_id": "42eaa7c0-7aca-3aa3-ada7-ee7c6753c0e0",
                                "text": "Beaucoup des tripolis et des randanites (ou Kieselguhr), dites souvent improprement « terres d’Infusoires », qui sont employées dans l’industrie, se sont ainsi formés autrefois dans les lacs de notre pays d’Auvergne, en particulier dans le versant nord de l’ancien grand volcan du Cantal."
                            },
                            {
                                "example_id": "e85a391f-2577-4b9d-8b96-504dffd6fed3",
                                "sense_id": "42eaa7c0-7aca-3aa3-ada7-ee7c6753c0e0",
                                "text": "Elles peuvent contenir des composants inertes tels que le kieselguhr et d’autres additifs tels que des colorants ou des stabilisants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5f0a5f7-5359-4be5-be35-d664aba67194",
                        "source_entry_id": "a6cfbdb3-43ec-33b7-a04c-795636b9f827",
                        "source_sense_id": "42eaa7c0-7aca-3aa3-ada7-ee7c6753c0e0",
                        "target_lang_word": "Kieselgur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kieselgur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d1a422e-9c9f-38c1-bf2d-7a22eab19dc1",
                                        "entry_id": "399ab588-3ce5-37cf-abd3-75ca136ff13e",
                                        "glosses": [
                                            "Erdart, entstanden aus den Schalen von Kieselalgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f7f14d8-73a8-4503-8a72-b90e1550a616",
                                                "sense_id": "6d1a422e-9c9f-38c1-bf2d-7a22eab19dc1",
                                                "text": "„Zumindest Hühnerhaltern und Sprengstoffexperten dürfte der Begriff Kieselgur geläufig sein.“"
                                            },
                                            {
                                                "example_id": "37b87a84-8993-4b9a-85f1-04d528359209",
                                                "sense_id": "6d1a422e-9c9f-38c1-bf2d-7a22eab19dc1",
                                                "text": "„Kieselgur wird aufgrund der porösen Struktur der Kieselalgenschalen nach Aufarbeitung vor allem als Filtrierhilfsmittel in der Anschwemmfiltration u.a. zur Klärung von Fruchtsäften, Wein und Bier sowie in der Zuckerindustrie verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
