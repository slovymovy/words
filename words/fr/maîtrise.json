                        "titulaire d'une maîtrise"
                    ]
                },
                {
                    "sense_id": "f21ad9c2-497d-3756-8fd7-d6c47fda2484",
                    "sense_definition": "Chœur d'enfants ou école de chant choral rattachée à une église ou à une institution musicale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>maîtrise</w> de la cathédrale chante régulièrement lors des grandes cérémonies religieuses."
                        },
                        {
                            "text": "Les jeunes choristes de la <w>maîtrise</w> répètent plusieurs heures par semaine."
                        }
                    ],
                    "synonyms": [
                        "manécanterie"
                    ]
                }
            ]
        },
