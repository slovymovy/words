                    {
                        "translation_id": "1b1baf33-5588-47c6-babd-daa84bff127e",
                        "source_entry_id": "b3f428be-03c7-3e05-9ceb-8020fb868ce0",
                        "source_sense_id": "6808a078-98f8-3e54-9db1-f147e729d7e4",
                        "source_sense_description": "serous membrane that surrounds the heart",
                        "target_lang_word": "pericardio",
