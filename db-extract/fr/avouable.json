                    }
                ],
                "translations": [
                    {
                        "translation_id": "44680a05-52fb-4555-8895-c04553f3988a",
                        "source_entry_id": "3d3b89a8-b3cf-334f-b63f-2b54cd816adf",
                        "source_sense_id": "36e4f46d-ab9d-3ecb-a8fb-6ecb2002bb9f",
                        "source_sense_description": "derart, dass man es ohne Scham zugeben kann: redlich",
                        "target_lang_word": "redlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04f8616a-a242-3347-babc-3a849070e066",
                                        "entry_id": "578d1e93-9383-3853-a4fb-a4049846eb06",
                                        "glosses": [
                                            "ehrlich, aufrichtig, rechtschaffen"
                                        ],
                                        "tags": [
                                            "von Menschen oder Handlungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4da7ba53-40de-4272-b288-04d3a21f39e3",
                                                "sense_id": "04f8616a-a242-3347-babc-3a849070e066",
                                                "text": "Die Annahme des redlichen Erwerbs in den verschiedenen Rechtsordnungen ist das Ergebnis einer geschichtlichen Entwicklung, die den Anwendungsbereich und die Voraussetzungen des gutgläubigen Erwerbs in jedem Land bestimmt."
                                            },
                                            {
                                                "example_id": "51b9f56e-0cd4-4475-815c-153157e52de9",
                                                "sense_id": "04f8616a-a242-3347-babc-3a849070e066",
                                                "text": "»… Glaubt mir, ein redlicher Dichter kann viel wagen, denn die Kunst, die ohne Stolz und Frevel, bespricht und bändigt die wilden Erdengeister, die aus der Tiefe nach uns langen.»"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9395a18-3b0e-3175-9d66-fc2b0b7c0efc",
                                        "entry_id": "578d1e93-9383-3853-a4fb-a4049846eb06",
                                        "glosses": [
                                            "sehr, tüchtig, ordentlich"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79bd4707-2cee-45e1-9c26-ff04f20c9a46",
                                                "sense_id": "c9395a18-3b0e-3175-9d66-fc2b0b7c0efc",
                                                "text": "Keine Sekunde dürfen wir lockerlassen, sondern müssen uns unsere Faulheit redlich verdienen."
                                            },
                                            {
                                                "example_id": "8a5812ad-f400-4fd8-8cdb-509efdd4035f",
                                                "sense_id": "c9395a18-3b0e-3175-9d66-fc2b0b7c0efc",
                                                "text": "Sie hätten's ihm zwar redlich gegönnt, wenn er nach allen Kanten kujoniert worden wäre und endlich Mores hätte lernen müssen, aber so war's auch gut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c266b6ce-8508-3fb6-8ee6-26f748bb5424",
                                        "entry_id": "578d1e93-9383-3853-a4fb-a4049846eb06",
                                        "glosses": [
                                            "sehr groß"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a54efa2-433f-468c-95b7-ac142672c4fa",
                                                "sense_id": "c266b6ce-8508-3fb6-8ee6-26f748bb5424",
                                                "text": "Das ließen sich die Freunde, die redlichen Hunger verspürten, nicht zweimal sagen."
                                            },
                                            {
                                                "example_id": "37b1cb66-5977-4add-8785-df51c7685074",
                                                "sense_id": "c266b6ce-8508-3fb6-8ee6-26f748bb5424",
                                                "text": "Der Durst ist der Wille bei dem, der sonst nichts hat. Nichts als Durst, aber redlicher Durst muß da seyn."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
