                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c76a6b41-240e-3313-8d81-9ece3a1cc1c8",
                                        "entry_id": "e65a335d-1b99-38fe-ab79-54205ec2edbc",
                                        "glosses": [
                                            "Mammifère digitigrade de l’ordre des Carnivores, de la famille des Canidae comprenant notamment les chiens, les loups et les renards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d72e4a1-a1fb-4b9a-8d41-7e3f1718f526",
                                                "sense_id": "c76a6b41-240e-3313-8d81-9ece3a1cc1c8",
                                                "text": "Nous en resterons donc au constat suivant : lorsque la présence de l’homme est marquée auprès d’un canidé, il ne peut s’agir que d’un chien, même si le type n’est pas identifiable."
                                            },
                                            {
                                                "example_id": "a752b101-8352-47d4-8bf9-190765cb7a21",
                                                "sense_id": "c76a6b41-240e-3313-8d81-9ece3a1cc1c8",
                                                "text": "« En l’absence d’autre itinéraire de repli, il est très probable que le canidé ait voulu forcer le passage », abonde dans un communiqué la préfecture."
                                            },
                                            {
                                                "example_id": "2e1c5265-d16d-4c18-98b6-b01b05715997",
                                                "sense_id": "c76a6b41-240e-3313-8d81-9ece3a1cc1c8",
                                                "text": "Ces événements baptisés Wouf s’inscrivent dans le cadre d’une grande rétrospective sur Elliott Erwitt, photographe franco-américain passionné des petits canidés, que le centre culturel lyonnais accueille jusqu’au 17 mars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
