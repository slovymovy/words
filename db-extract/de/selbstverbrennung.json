                "senses": [
                    {
                        "sense_id": "fa358675-a5e6-3f60-a92c-d873610dbe01",
                        "entry_id": "10a09e99-2b4c-3f70-a754-f794fa87fce1",
                        "glosses": [
                            "Handlung, sich selbst zu verbrennen und Ergebnis dieser Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f616f437-8490-42e4-89e0-d2f1242a7e28",
                                "sense_id": "fa358675-a5e6-3f60-a92c-d873610dbe01",
                                "text": "„Der neue Name hat nun wie der ursprüngliche Brand erneut die semantische Beziehung zum Feuer, auf die es Canetti besonders ankommt, denn ein katastrophisches Ende, die Selbstverbrennung des Büchermenschen, stand von den ersten Entwürfen an fest.“"
                            },
                            {
                                "example_id": "20259256-d55a-4f58-88fd-119ab135f51f",
                                "sense_id": "fa358675-a5e6-3f60-a92c-d873610dbe01",
                                "text": "„Peregrin hatte allerlei in dieser Hinsicht durchprobiert und durchgemacht, und das Ende seines Lebens war eine öffentliche Selbstverbrennung bei den Olympischen Spielen des Jahres 165, angeblich um zu demonstrieren, dass ein Kyniker keinen Schmerz fürchte und, wer an ein glückliches Jenseits glaube, den Tod nicht zu fürchten habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3d6074b-664e-4803-8f7f-35e7d8e94e65",
                        "source_entry_id": "10a09e99-2b4c-3f70-a754-f794fa87fce1",
                        "source_sense_id": "fa358675-a5e6-3f60-a92c-d873610dbe01",
                        "source_sense_description": "Handlung, sich selbst zu verbrennen und Ergebnis dieser Handlung",
                        "target_lang_word": "auto-immolation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auto-immolation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36447b76-c49b-3ecc-9316-beb28b792ba2",
                                        "entry_id": "faad36bf-39b2-3492-9ae0-df32ad3d4231",
                                        "glosses": [
                                            "Suicide, le plus souvent par le feu, en forme de protestation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a35460-6b68-4d91-93ce-2ac451ce7d84",
                                                "sense_id": "36447b76-c49b-3ecc-9316-beb28b792ba2",
                                                "text": "L’auto-immolation aurait un sens, elle exercerait une attraction pour ces personnes qui la choisiraient comme un moyen de suicide acceptable, malgré la mort lente et douloureuse qu’elle entraine. Forme extrême de protestation, cet acte survient dans un lieu fort de sens."
                                            },
                                            {
                                                "example_id": "064657e8-1bb7-428f-a05d-12a06af56eb5",
                                                "sense_id": "36447b76-c49b-3ecc-9316-beb28b792ba2",
                                                "text": "Depuis 2017, Moradiannejad voyage à travers l’Iran, l’Irak, la Turquie et la Syrie pour documenter la pratique brutale de l’auto-immolation (suicide par le feu) chez les femmes kurdes à travers une série de photos intitulée « Roulah ». Acte désespéré de protestation à la fois personnelle et politique, l’auto-immolation dévaste les familles qui perdent des êtres chers et les femmes qui survivent en portent à vie les cicatrices sur le visage et le corps."
                                            },
                                            {
                                                "example_id": "2d72217e-91a9-4b39-a073-6ed6a344d6d1",
                                                "sense_id": "36447b76-c49b-3ecc-9316-beb28b792ba2",
                                                "text": "L’auto-immolation de Thích Quảng Đức est largement considérée comme le point tournant de la crise bouddhiste au Vietnam qui a conduit à la chute du régime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bb3f6c-7895-3772-bb37-5edd4ac784aa",
                                        "entry_id": "faad36bf-39b2-3492-9ae0-df32ad3d4231",
                                        "glosses": [
                                            "Décomposition chimique provoquée par un stimulus et permettant, en pharmacologie, la libération d’un principe actif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b878b6-5fc6-4c7b-b7d8-a1237156027e",
                                                "sense_id": "e1bb3f6c-7895-3772-bb37-5edd4ac784aa",
                                                "text": "Sous l’effet d’un stimulus externe (activation), A est clivé spontanément lors d’un processus irréversible appelé auto-immolation, qui provoque la libération de l’espèce B."
                                            },
                                            {
                                                "example_id": "0e2e3157-26d1-47f0-b8d4-0b6f85d4480d",
                                                "sense_id": "e1bb3f6c-7895-3772-bb37-5edd4ac784aa",
                                                "text": "La conception du lieur dégradable permet de préparer la cascade d’auto-immolation à être activée et désactivée, garantissant ainsi que la libération de la charge utile a lieu uniquement dans des conditions environnementales spécifiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
