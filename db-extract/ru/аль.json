                                "target_senses": [
                                    {
                                        "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                        "entry_id": "0146f72c-f61a-3892-b691-d13a87d85a76",
                                        "glosses": [
                                            "Before; ere. Generally followed by \\\"ever\\\" or \\\"e'er\\\"."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57bd3a7e-968e-4647-b1ea-0a0b0053e6c3",
                                                "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                                "text": "Or euer the siluer corde be loosed, or the golden bowle be broken, or the pitcher be broken at the fountaine, or the wheele broken at the cisterne. Then shall the dust returne to the earth as it was: and the spirit shall returne vnto God who gaue it."
                                            },
                                            {
                                                "example_id": "0ef390a2-7938-48dc-bfa1-bff7ff628e39",
                                                "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                                "text": "I looked to heaven, and tried to pray;\nBut or ever a prayer had gusht,\nA wicked whisper came, and made\nMy heart as dry as dust."
                                            },
                                            {
                                                "example_id": "7e0a7779-efa6-49a9-bced-e396f6e30564",
                                                "sense_id": "9689b697-4f2d-34e4-b807-e724fffeec72",
                                                "text": "And Time went forth into the worlds to obey the commands of the gods, yet he cast furtive glances at his masters, and the gods distrusted Time because he had known the worlds or ever the gods became."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
