                                "target_senses": [
                                    {
                                        "sense_id": "abfbdad1-2556-3ae8-81cb-c8a0898afc99",
                                        "entry_id": "4e5b9460-75ed-37a4-9f77-b347331cedc1",
                                        "glosses": [
