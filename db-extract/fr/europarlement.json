                        "examples": [
                            {
                                "example_id": "9c0594d7-0004-47c6-98ce-ef056196ee41",
                                "sense_id": "07d60e65-b54c-3e20-9a23-ef14e856e701",
                                "text": "Elle partage le même idéal européen que les conservateurs britanniques, avec qui elle a tissé des liens, notamment à l’Europarlement."
                            },
                            {
                                "example_id": "20072070-f5e1-461f-9a4b-99cbd33a235b",
                                "sense_id": "07d60e65-b54c-3e20-9a23-ef14e856e701",
                                "text": "L’Europarlement a aussi le pouvoir d'adopter une motion de censure à l'encontre de la Commission. Il participe à la désignation de ses membres. Cette désignation doit être approuvée par le Parlement européen."
                            }
                        ]
