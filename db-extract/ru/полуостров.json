                                        "glosses": [
                                            "een landmassa die voor het grootste deel door water omgeven wordt, en slechts op (relatief) smalle verbinding heeft met het vasteland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3ac95b-3e15-4e9b-bb19-41d58cef1a89",
                                                "sense_id": "7b3042fa-d826-3466-820a-3f1e51d526da",
                                                "text": "Voorbeelden van schiereilanden zijn Marken, via een smalle dam met het vaste land verbonden, en het Iberisch schiereiland."
                                            }
