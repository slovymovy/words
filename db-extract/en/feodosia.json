                                "target_senses": [
                                    {
                                        "sense_id": "2116943f-575d-387c-b98c-d36d1c1bd962",
                                        "entry_id": "9381877f-8c44-359f-ac8c-09b2389619f9",
                                        "glosses": [
                                            "Stadt auf der Krim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98364586-313d-4f5b-95ed-509622edaf05",
                                                "sense_id": "2116943f-575d-387c-b98c-d36d1c1bd962",
                                                "text": "„In rastloser Verfolgung des geschlagenen Gegners erreichte die Division abends ohne Feindwiderstand den befohlenen Standpunkt. Damit hatte die Division den Feind bis auf die Landenge der Halbinsel Kertsch nördlich Feodossija zurückgeworfen.“"
                                            },
                                            {
                                                "example_id": "70bb0cb3-f1b6-4b70-bafe-11ac0be4fc8a",
                                                "sense_id": "2116943f-575d-387c-b98c-d36d1c1bd962",
                                                "text": "„Am 29. [1914] Oktober beschossen türkische Kriegsschiffe die russischen Schwarzmeerhäfen Sewastopol, Odessa, Feodossija und Noworossisk.“"
                                            },
                                            {
                                                "example_id": "93d8414a-a5ab-4b62-b24a-2d23dcc95e24",
                                                "sense_id": "2116943f-575d-387c-b98c-d36d1c1bd962",
                                                "text": "„Am Abend des 20. April war die Verladung der Truppen abgeschlossen, die Engländer nahmen alle, die den Wunsch äußerten, nach der Krim abtransportiert zu werden, an Bord ihrer Schiffe und brachten sie auf den Panzerkreuzern ‚Korodok‘ und ‚Marlborough‘ am nächsten Tag wohlbehalten nach Feodossija.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
