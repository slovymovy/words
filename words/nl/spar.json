                    "frequency": "Low",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman bevestigde de houten <w>spar</w> stevig aan de rest van de dakconstructie.",
                            "target_lang_translations": {
