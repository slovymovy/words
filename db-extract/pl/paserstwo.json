                        "glosses": [
                            "przestępstwo polegające na skupie, przechowywaniu lub sprzedaży rzeczy kradzionych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c4237c-ff12-4125-95eb-ecca8df48009",
                                "sense_id": "b0f48155-fe6c-3b1c-b126-4071cd5c03c6",
                                "text": "W niektórych knajpach na Pradze, szczególnie w pobliżu bazaru, kelnerzy wyłącznie trudnili się paserstwem i donosicielstwem."
                            }
