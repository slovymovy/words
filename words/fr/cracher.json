{
    "word_family": [
        "crachat",
        "crachement",
        "cracheur",
        "crachoir",
        "crachoter",
        "crachotis"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfbe6d51-0d33-37ab-a23f-1de0030be4b0",
                    "sense_definition": "Expulser de la salive ou des mucosités par la bouche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expulsion_corporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est strictement interdit de <w>cracher</w> par terre dans les lieux publics."
                        },
                        {
                            "text": "Pris d'une quinte de toux, le vieil homme a <w>craché</w> dans son mouchoir."
                        }
                    ],
                    "common_phrases": [
                        "cracher par terre",
                        "cracher au visage"
                    ]
                },
                {
                    "sense_id": "707b9e79-6e8e-3289-884e-0defcca18809",
                    "sense_definition": "Rejeter hors de la bouche un aliment, un liquide ou un corps étranger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expulsion_corporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a immédiatement <w>craché</w> le médicament à cause de son goût très amer."
                        },
                        {
                            "text": "Pendant l'entraînement, le boxeur blessé s'est mis à <w>cracher</w> du sang."
                        }
                    ],
                    "synonyms": [
                        "recracher"
                    ],
                    "antonyms": [
                        "avaler"
                    ],
                    "common_phrases": [
                        "cracher du sang"
                    ]
                },
                {
                    "sense_id": "0548cdc3-b188-3a6f-ba69-c72ee63e6fa4",
                    "sense_definition": "Mépriser, dédaigner ou refuser une opportunité ou un avantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut jamais <w>cracher</w> sur une opportunité aussi avantageuse pour votre carrière."
                        },
                        {
                            "text": "Même s'il est fatigué, il ne <w>crache</w> pas sur une bonne prime de fin d'année."
                        }
                    ],
                    "synonyms": [
                        "dédaigner",
                        "mépriser",
                        "rejeter"
                    ],
                    "antonyms": [
                        "accepter",
                        "apprécier"
                    ],
                    "common_phrases": [
                        "ne pas cracher sur",
                        "cracher dans la soupe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent utilisé dans la tournure négative 'ne pas cracher sur'"
                        }
                    ]
                },
                {
                    "sense_id": "38e32595-2b3b-3066-9df9-9b72c0b3b028",
                    "sense_definition": "Exprimer ou proférer des paroles avec haine, mépris ou violence.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Furieux, l'automobiliste a <w>craché</w> une série d'injures avant de repartir à vive allure."
                        },
                        {
                            "text": "Elle passe ses journées à <w>cracher</w> son venin sur ses collègues de travail."
                        }
                    ],
                    "synonyms": [
                        "lancer",
                        "proférer",
                        "vomir"
                    ],
                    "common_phrases": [
                        "cracher son venin",
                        "cracher des insultes"
                    ]
                },
                {
                    "sense_id": "64068651-371b-36ad-b874-18444cd4b866",
                    "sense_definition": "Projeter ou émettre violemment quelque chose hors de soi, en parlant d'une chose inanimée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "expulsion_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le volcan en éruption continue de <w>cracher</w> de la lave et des cendres brûlantes."
                        },
                        {
                            "text": "La vieille cheminée de l'usine <w>crachait</w> une épaisse fumée noire au-dessus de la ville."
                        }
                    ],
                    "synonyms": [
                        "émettre",
                        "expulser",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "cracher des flammes",
                        "cracher de la fumée"
                    ]
                },
                {
                    "sense_id": "15eb589f-fffd-30c9-9037-1af8a6b8bf0a",
                    "sense_definition": "Donner de l'argent ou payer, souvent à contrecœur ou sous la contrainte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce contrôle fiscal imprévu, il a dû <w>cracher</w> une somme astronomique à l'État."
                        },
                        {
                            "text": "Les escrocs ont menacé la victime pour la contraindre à <w>cracher</w> au bassinet."
                        }
                    ],
                    "synonyms": [
                        "débourser",
                        "payer"
                    ],
                    "antonyms": [
                        "encaisser"
                    ],
                    "common_phrases": [
                        "cracher au bassinet"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre familier ou argotique"
                        }
                    ]
                },
                {
                    "sense_id": "bf98f6b8-484d-35b2-8376-d91b8383de4b",
                    "sense_definition": "Projeter ou laisser échapper du liquide ou de la matière de manière incontrôlée et irrégulière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expulsion_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce stylo à plume est tellement usé qu'il se met à <w>cracher</w> sur le papier."
                        },
                        {
                            "text": "Le vieux robinet de la cuisine <w>crache</w> de l'eau rouillée dès qu'on essaie de l'ouvrir."
                        }
                    ],
                    "synonyms": [
                        "éclabousser",
                        "fuir"
                    ]
                }
            ]
        }
    ]
}