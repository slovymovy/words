                                "target_senses": [
                                    {
                                        "sense_id": "ab6a173a-661e-3671-a1db-3d3721822aef",
                                        "entry_id": "6fc347ca-8114-30c3-8f37-f39f1656e9c9",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 94, das zu den Actinoiden gehört"
