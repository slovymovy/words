                "senses": [
                    {
                        "sense_id": "3116d623-0e22-3e5b-a822-7a8eace06234",
                        "entry_id": "dcbd31ac-5409-3aa5-bec4-a18edcf12c38",
                        "glosses": [
                            "Reiterprozession zu Ehren einer Blutreliquie"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a81c3c9c-abd0-43bc-b30f-56a20cb3eaa3",
                                "sense_id": "3116d623-0e22-3e5b-a822-7a8eace06234",
                                "text": "„Aber schon, als ich mir Hemd, Frack und Schärpe für den Blutritt überwerfe, verändert sich das Gefühl.“"
                            },
                            {
                                "example_id": "591906f2-2caf-4691-8b68-1974926b7291",
                                "sense_id": "3116d623-0e22-3e5b-a822-7a8eace06234",
                                "text": "„Zum traditionellen Blutritt sind am Freitag wieder Tausende Reiter und Pilger in Weingarten gewesen.“"
                            },
                            {
                                "example_id": "b15f4089-6b52-4f63-96dd-990c0fec66a9",
                                "sense_id": "3116d623-0e22-3e5b-a822-7a8eace06234",
                                "text": "„Der Blutritt in Weingarten gilt als das größte Reiter- und Pilgerfest Europas.“"
                            },
                            {
                                "example_id": "30caee16-91d2-4d6f-a961-53142b23ddc7",
                                "sense_id": "3116d623-0e22-3e5b-a822-7a8eace06234",
                                "text": "„Beim traditionellen Blutritt sind am Freitag 1.841 Reiter durch Weingarten und die umliegenden Fluren gezogen.“"
                            },
                            {
                                "example_id": "521f525f-f819-4467-9aa8-102509e3e7c9",
                                "sense_id": "3116d623-0e22-3e5b-a822-7a8eace06234",
                                "text": "„Der Blutritt als größte Reiterprozession seiner Art wird auch am 30. Mai wieder etwa 1.800 Reiter sowie Tausende Fußwallfahrer ins oberschwäbische Weingarten locken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
