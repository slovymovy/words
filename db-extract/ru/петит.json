                        "glosses": [
                            "полигр. мелкий типографский шрифт, кегль (высота шрифта, размер) которого равен 8 пунктам (3,01 мм в системе Дидо; 2,8 мм в англо-американской системе)"
                        ],
                        "tags": [],
