    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                    "sense_definition": "To officially forbid something or make it illegal by law or rule.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "forbid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new city law will <w>prohibit</w> smoking in all public parks and playgrounds.",
                            "target_lang_translations": {
                                "ru": "Новый городской закон будет <w>запрещать</w> курение во всех общественных парках и на детских площадках."
                            }
                        },
                        {
                            "text": "Strict regulations <w>prohibit</w> the use of mobile phones while driving for safety reasons.",
                            "target_lang_translations": {
                                "ru": "Строгие правила <w>запрещают</w> использование мобильных телефонов во время вождения по соображениям безопасности."
                            }
                        },
                        {
                            "text": "The school rules <w>prohibit</w> students from leaving the campus during the lunch break.",
                            "target_lang_translations": {
                                "ru": "Школьные правила <w>запрещают</w> ученикам покидать территорию кампуса во время обеденного перерыва."
                            }
                        }
                    ],
                    "synonyms": [
                        "ban",
                        "forbid",
                        "proscribe",
                        "outlaw",
                        "veto",
                        "bar",
                        "disallow"
                    ],
                    "antonyms": [
                        "allow",
                        "permit",
                        "authorize",
                        "sanction"
                    ],
                    "common_phrases": [
                        "prohibit the use",
                        "strictly prohibit",
                        "prohibit by law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально запрещать что-либо или делать это незаконным в соответствии с законом или правилом."
                    },
