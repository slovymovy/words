                "senses": [
                    {
                        "sense_id": "d1d7cc62-a4fe-393a-b793-8f71b14a2dd3",
                        "entry_id": "14ab5876-3654-3778-838c-4f054b3d1908",
                        "glosses": [
                            "Trouble de la vision amenant à voir double."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ec8755a3-126a-4674-b57e-67206534d424",
                                "sense_id": "d1d7cc62-a4fe-393a-b793-8f71b14a2dd3",
                                "text": "La diplopie se traduit par une sensation de vision double : l’image d’un point objet est dédoublée, sa projection ne correspondant pas à la même zone de la rétine."
                            },
                            {
                                "example_id": "3c271cc1-254c-43a4-81b6-3037930e3bd2",
                                "sense_id": "d1d7cc62-a4fe-393a-b793-8f71b14a2dd3",
                                "text": "La diplopie, et la gêne qui en résulte, disparaissent par l’occlusion d’un œil."
                            }
                        ]
                    }
                ],
                "translations": [
