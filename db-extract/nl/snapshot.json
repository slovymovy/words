                    },
                    {
                        "form_id": "596a49f7-d203-47c1-9b71-66f6c64b6720",
                        "entry_id": "87737cab-d392-3313-a170-daa9d00b2ed0",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "snapshotjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6208e498-5a70-34f7-95d7-363a7ec0c400",
                        "entry_id": "87737cab-d392-3313-a170-daa9d00b2ed0",
                        "glosses": [
                            "snelle momentopname van een bewegend of veranderend voorwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0cc2ca-f7a3-49c4-ba21-04217d495160",
                                "sense_id": "6208e498-5a70-34f7-95d7-363a7ec0c400",
                                "text": "Ik zag bij hem thuis een fantastische tekening van het verkeerslicht hier op het kruispunt Hornsgata-Ringg, helemaal perfect, een soort snapshot in het donker."
                            },
                            {
                                "example_id": "95aa1be8-5a31-4eb5-848b-f07b09de6df0",
                                "sense_id": "6208e498-5a70-34f7-95d7-363a7ec0c400",
                                "text": "Koffietijd-presentatrice Quinty Trustfull is in Londen en spot daar continu vossen. \"Weer eens wat anders dan mijn katten\", schrijft ze bij een snapshot van een vos die in de achtertuin scharrelt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14636c7c-2a97-4bcb-922e-08bace52c8eb",
                        "source_entry_id": "87737cab-d392-3313-a170-daa9d00b2ed0",
                        "source_sense_id": "6208e498-5a70-34f7-95d7-363a7ec0c400",
                        "source_sense_description": "momentopname",
                        "target_lang_word": "snapshot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snapshot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03abf282-e83c-3839-82bb-982d87e61b2a",
                                        "entry_id": "dfbf0681-7a48-3989-a535-c779e6495c1c",
                                        "glosses": [
                                            "A photograph, especially one taken quickly or in a sudden moment of opportunity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aa86c91-8d4f-47fd-8a6a-1ca73171d667",
                                                "sense_id": "03abf282-e83c-3839-82bb-982d87e61b2a",
                                                "text": "He carried a snapshot of his daughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9ef134f-6210-3a32-a27c-0d31eec99b23",
                                        "entry_id": "dfbf0681-7a48-3989-a535-c779e6495c1c",
                                        "glosses": [
                                            "A glimpse of something; a portrayal of something at a moment in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f3f928-1d21-4ac4-b37b-47ac748835ea",
                                                "sense_id": "d9ef134f-6210-3a32-a27c-0d31eec99b23",
                                                "text": "The article offered a snapshot of life in that region."
                                            },
                                            {
                                                "example_id": "0d8dd653-f43d-45f1-8e76-78f5e1348b24",
                                                "sense_id": "d9ef134f-6210-3a32-a27c-0d31eec99b23",
                                                "text": "I hope you've enjoyed reading this series. As usual, it's just a snapshot because there's so much to say but only so many words can make it into print."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05796a47-9b6d-30a2-baae-9a28c3068a96",
                                        "entry_id": "dfbf0681-7a48-3989-a535-c779e6495c1c",
                                        "glosses": [
                                            "A file or set of files captured at a particular time, often capable of being reloaded to restore the earlier state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e65dc04-5977-452d-bd19-ba56407aee18",
                                                "sense_id": "05796a47-9b6d-30a2-baae-9a28c3068a96",
                                                "text": "This game is so hard that I find myself taking a snapshot every few seconds in case I get killed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ec61de0-a66f-33a0-85d7-0182311576db",
                                        "entry_id": "dfbf0681-7a48-3989-a535-c779e6495c1c",
                                        "glosses": [
                                            "A quick, unplanned or unexpected shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3624cd7-130e-401b-8b71-299562838bed",
                                                "sense_id": "4ec61de0-a66f-33a0-85d7-0182311576db",
                                                "text": "Yet Revell misjudged his promising position in the area to put his point-blank snapshot wide from only six yards out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01faa472-433f-33a9-839c-1c7dff050e17",
                                        "entry_id": "dfbf0681-7a48-3989-a535-c779e6495c1c",
                                        "glosses": [
                                            "A quick offhand shot, made without deliberately taking aim over the sights."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac7bc4c9-6a74-418e-86f9-490a1c1aea68",
                                                "sense_id": "01faa472-433f-33a9-839c-1c7dff050e17",
                                                "text": "How quick the eye and hand to catch him [the ruffed grouse] when he rises from the underbrush and is out of sight in the wood before the untrained sportsman stops him with what is little more than a snapshot, so instantaneously must all be done!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snapshot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a85a3bf1-4e46-36a8-a46c-fe80ffbc7b9b",
                                        "entry_id": "94bf3795-e178-38ef-a641-65e71d42e4d6",
                                        "glosses": [
                                            "To take a photograph of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac18344-b64e-4711-9003-16fc290306f5",
                                                "sense_id": "a85a3bf1-4e46-36a8-a46c-fe80ffbc7b9b",
                                                "text": "As he did not appear disposed to move off, I took my camera and approached within about thirty yards, when I snapshotted him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d46eaefb-7bd3-31b7-88c1-c84c4215caa2",
                                        "entry_id": "94bf3795-e178-38ef-a641-65e71d42e4d6",
                                        "glosses": [
                                            "To capture the state of, in a snapshot."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "538ba94f-c589-4825-b018-b44de89f0b72",
                                                "sense_id": "d46eaefb-7bd3-31b7-88c1-c84c4215caa2",
                                                "text": "Filer appliances also offer programmatic snapshotting and cloning at the block-level or file system-level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
