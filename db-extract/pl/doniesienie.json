                        "glosses": [
                            "rzecz. odczas. od donieść"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53020725-c980-4fe3-8723-0976d657ca49",
                                "sense_id": "102fea59-5c26-3078-8a76-d8d6a016366f",
                                "text": "Do sensacji jednak nie doszło: według doniesień zachodnich mediów, pertraktacje do niczego nie doprowadziły"
                            },
                            {
                                "example_id": "84a6d764-dce5-4b42-91f9-a4815eb14454",
                                "sense_id": "102fea59-5c26-3078-8a76-d8d6a016366f",
                                "text": "Pod wpływem następnych doniesień powołano komisję senacką do zbadania zakulisowych rozgrywek podczas kampanii prezydenckiej."
                            },
                            {
                                "example_id": "048f821f-23ab-4adc-8e31-313907ffbb80",
                                "sense_id": "102fea59-5c26-3078-8a76-d8d6a016366f",
                                "text": "Przyznał, że do UOP-u wpływa dużo doniesień o nieprawidłowościach w pracy komisji przydzielającej koncesje na import paliw"
                            }
                        ],
