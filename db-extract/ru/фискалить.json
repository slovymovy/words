                "senses": [
                    {
                        "sense_id": "17b52cea-26da-393f-ae5f-38e867d3677b",
                        "entry_id": "4d932bd7-50ee-3d61-9032-0365d98c163b",
                        "glosses": [
                            "прост. быть фискалом, заниматься фискальством; доносить, ябедничать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff023903-bdc2-43ee-8ecc-7513eaaee207",
                                "sense_id": "17b52cea-26da-393f-ae5f-38e867d3677b",
                                "text": "Она особенно любила щипаться и раздавать колотушки детям сестры своей, фискалить на них за утащенный сахар и хлеб, отчего между ней и старшей сестрой её существовала бесконечная и неутолимая ссора."
                            },
                            {
                                "example_id": "30430308-7381-4e14-8abd-e124c7bee90b",
                                "sense_id": "17b52cea-26da-393f-ae5f-38e867d3677b",
                                "text": "Второклассники накрыли фискала, и он теперь в лазарете, чтобы не фискалил."
                            }
                        ]
                    }
                ],
