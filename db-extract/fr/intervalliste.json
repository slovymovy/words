                "senses": [
                    {
                        "sense_id": "823bc142-54fa-3bd4-a4f9-3f31749f7452",
                        "entry_id": "be46a934-221b-3dca-922a-e2442418fc67",
                        "glosses": [
                            "Animateur assistant, chargé de dessiner les images intermédiaires qui s’intercalent entre des images-clés d’un dessin animé traditionnel afin que l’animation soit fluide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebbd8ae8-f5cc-4095-83cd-11b1302fb106",
                                "sense_id": "823bc142-54fa-3bd4-a4f9-3f31749f7452",
                                "text": "En 1931, il entre au studio d’Ub Iwerks et y devient bientôt gouacheur, puis encreur et, enfin, intervalliste, chargé de la composition des phases intermédiaires du mouvement dans le dessin animé."
                            },
                            {
                                "example_id": "1c1fa315-b333-4d90-8e33-92ba75681ad1",
                                "sense_id": "823bc142-54fa-3bd4-a4f9-3f31749f7452",
                                "text": "Né à Tōkyō en 1941, il débute sa carrière comme intervalliste dans les célèbres studios d’animation Tôei, d’où sortent les plus grands mangas japonais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02e5c636-84b2-403e-ac85-9a67b5f23a04",
                        "source_entry_id": "be46a934-221b-3dca-922a-e2442418fc67",
                        "source_sense_id": "823bc142-54fa-3bd4-a4f9-3f31749f7452",
                        "target_lang_word": "inbetweener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inbetweener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a971ee2-51b5-3b05-b338-60f4b2f1445a",
                                        "entry_id": "599d882c-516c-332d-8319-c1375a4aaa3d",
                                        "glosses": [
                                            "A person who specializes in tweening in an animation studio."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9072a3ad-b07c-3ff3-91d0-3faa5cb9aad7",
                                        "entry_id": "599d882c-516c-332d-8319-c1375a4aaa3d",
                                        "glosses": [
                                            "A person who or thing that falls between different groups or characteristics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0afd4d4-b608-4e90-950b-e2cf1e8bfbde",
                                                "sense_id": "9072a3ad-b07c-3ff3-91d0-3faa5cb9aad7",
                                                "text": "More than an outsider he was an in-betweener; caught between two cultures all the while shunning his own."
                                            },
                                            {
                                                "example_id": "6402ccdb-c028-45a1-b083-ea841d2a5f36",
                                                "sense_id": "9072a3ad-b07c-3ff3-91d0-3faa5cb9aad7",
                                                "text": "But having two bikes works well for me—so well that I'm daydreaming about getting a third, an in-betweener, light and strong enough to carry me over mountains with a sleeping bag and tent on the back."
                                            },
                                            {
                                                "example_id": "82db58ff-7550-43a2-96b8-8f2977881d9f",
                                                "sense_id": "9072a3ad-b07c-3ff3-91d0-3faa5cb9aad7",
                                                "text": "Now, Barney was what some voices referred to as an “inbetweener.” It met that he was never located in a permanent grade level. Back in those days when a student was found unfit of advancing to a higher level, he was held back for only half of the year and then advanced for the other half."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
