                "senses": [
                    {
                        "sense_id": "81481aac-c8e9-3d49-a79c-909cf4bd3524",
                        "entry_id": "fe6e0f56-c7dc-3465-9cdc-239d289e5dc3",
                        "glosses": [
                            "befestigter Raum in einem Gebäude, der zum Rückzug der Anwesenden bei Bedrohung durch Einbrecher oder Attentäter dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c07e5b-abbc-4758-b3ff-84b63c460308",
                                "sense_id": "81481aac-c8e9-3d49-a79c-909cf4bd3524",
                                "text": "„Die Quds-Agenten drangen in die Villa ein, töteten vier Sicherheitsmänner und beide Wachhunde, erreichten schließlich das Schlafzimmer des Regisseurs, in dem sie feststellen mussten, dass dieser sich gerade in einen angrenzenden Panikraum zurückgezogen hatte.“"
                            },
                            {
                                "example_id": "349f9ce6-a95c-497e-9339-939bf88fb629",
                                "sense_id": "81481aac-c8e9-3d49-a79c-909cf4bd3524",
                                "text": "„Außer Wohnzimmer, Speisezimmer, großer Küche, Schlafzimmer, Bad und Fitnessraum gibt es einen versteckten Panikraum, der jedem denkbaren Angriff widerstehen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
