                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0df7ac36-bcbf-490e-abee-5172b483475b",
                                                "sense_id": "4d1f77f2-3a7f-387a-b0c9-8b94bf50c2e9",
                                                "text": "Sanskrit, Greek, Slavonic, Germanic, and Celtic names were all of this type, but there are also shorter names formed from the compound ones; […]."
                                            }
                                        ]
                                    }
                                ]
