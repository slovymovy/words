                                        "glosses": [
                                            "A bacteriolytic (or antibiotic) enzyme found in many animal secretions, and in egg white."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff219f2-3597-46b7-a0dc-7113ff13dbb5",
                                                "sense_id": "b1e60d61-19c7-3f11-80ea-3cf4c7ea0321",
                                                "text": "[Alexander Fleming] had in 1923 discovered lysozyme, an antimicrobial enzyme found in saliva, mucus and tears as part of the body’s first line of defence against invading pathogens."
                                            }
