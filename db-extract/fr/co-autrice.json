                "senses": [
                    {
                        "sense_id": "9046c7c9-ca5f-39f1-8ba8-dfda1f48405d",
                        "entry_id": "0e3045dc-a2a1-3f1e-9c15-86ad93b1e091",
                        "glosses": [
                            "Autrice d’un ouvrage réalisé en collaboration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a28b5a-9f1d-4a5c-9af4-0f45a066621b",
                                "sense_id": "9046c7c9-ca5f-39f1-8ba8-dfda1f48405d",
                                "text": "L’académicienne Danièle Sallenave, co-autrice du rapport sur la féminisation des métiers, en explique la philosophie sur franceinfo."
                            },
                            {
                                "example_id": "fc8affc2-f540-4596-bfb8-34a2b27a0aef",
                                "sense_id": "9046c7c9-ca5f-39f1-8ba8-dfda1f48405d",
                                "text": "Maintenant qu’elle siège au 10, Downing Street, son discours « va devenir national dans la seule idéologie du parti, recontextualise Agnès Alexandre-Collier, professeure à l’université de Bourgogne et co-autrice de Les partis politiques en Grande-Bretagne (Armand Colin). Une fois en place, la realpolitik et les faits vous rattrapent. »."
                            },
                            {
                                "example_id": "224fafaa-4668-4a62-84d6-b7f11ccdaa81",
                                "sense_id": "9046c7c9-ca5f-39f1-8ba8-dfda1f48405d",
                                "text": "La maîtresse de conférences en langue française, co-autrice avec Karine Abiven de Trahir et venger, analyse les récits de forte mobilité sociale popularisés par des auteurs comme Annie Ernaux, Didier Eribon ou Édouard Louis."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4dab93b-574a-3745-a7be-56ee4a6ab510",
                        "entry_id": "0e3045dc-a2a1-3f1e-9c15-86ad93b1e091",
                        "glosses": [
                            "Celle qui est à l’origine de quelque chose en collaboration avec une autre personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "230fb4f6-3889-4c2d-b7a7-45fe33a6bfbf",
                                "sense_id": "a4dab93b-574a-3745-a7be-56ee4a6ab510",
                                "text": "Depuis la loi du 2 août 2021 relative à la bioéthique, la femme qui ne porte pas l’enfant doit être considérée comme la seconde mère dès lors qu’elle est co-autrice du projet parental."
                            },
                            {
                                "example_id": "43adec6d-a0f1-48c3-8073-0163408ce5b8",
                                "sense_id": "a4dab93b-574a-3745-a7be-56ee4a6ab510",
                                "text": "« Nous avons trouvé ce résultat chez quatorze chiens », indique la co-autrice de l’étude, Marianna Boros."
                            }
                        ]
                    }
