            {
                "entry_id": "0b8e318c-08d2-3514-a495-83d86e01dec3",
                "word": "Zorro",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bee61ca7-e72c-4df3-8a42-a1331e1e68ed",
                        "entry_id": "0b8e318c-08d2-3514-a495-83d86e01dec3",
                        "tags": [
                            "plural"
                        ],
                        "form": "Zorros"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "952f4518-93a2-335b-afd8-a9d5779c1f5b",
                        "entry_id": "0b8e318c-08d2-3514-a495-83d86e01dec3",
                        "glosses": [
                            "Any daring and mysterious avenger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b0512f-1d54-4b44-9b20-0b22f8dfee03",
                                "sense_id": "952f4518-93a2-335b-afd8-a9d5779c1f5b",
                                "text": "I told her about the Z found etched in Hector Peña's blood and my theory that the killer may indeed picture himself or herself as some kind of avenger, a modern-day Zorro with a twist."
                            },
                            {
                                "example_id": "3b068b46-735c-426d-9882-f658233276dd",
                                "sense_id": "952f4518-93a2-335b-afd8-a9d5779c1f5b",
                                "text": "[…] he made himself visible at certain crucial and dramatic moments, like a kind of Zorro of the ecodefense movement."
                            },
                            {
                                "example_id": "afb882dd-9cac-4f53-bbd9-b3160c3de71b",
                                "sense_id": "952f4518-93a2-335b-afd8-a9d5779c1f5b",
                                "text": "You are a real Zorro. You ride in, rescue the fair damsel (Maartje), start massive fires and vanish — until the next perceived injustice."
                            }
                        ]
                    }
                ],
