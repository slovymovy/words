                        "form": "ijlers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b328f23-66ae-3ac5-996c-3aab30e44851",
                        "entry_id": "a7548581-7196-358e-a1b4-0ae10c861947",
                        "glosses": [
                            "met een lage dichtheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a75a8d6-d411-4b3c-8b86-04bc30b09880",
                                "sense_id": "1b328f23-66ae-3ac5-996c-3aab30e44851",
                                "text": "In de bergen is er vaak een ijle lucht."
                            },
                            {
                                "example_id": "f9ad55d8-466c-4522-91df-5f49184f2087",
                                "sense_id": "1b328f23-66ae-3ac5-996c-3aab30e44851",
                                "text": "Ik vroeg of Claude ook last van de ijle lucht had, maar hij bleek er weinig van te merken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "792c9056-a393-4156-8bac-70cea80fb2b5",
                        "source_entry_id": "a7548581-7196-358e-a1b4-0ae10c861947",
                        "source_sense_id": "1b328f23-66ae-3ac5-996c-3aab30e44851",
                        "source_sense_description": "met een lage dichtheid",
                        "target_lang_word": "dünn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dünn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "von geringer Dicke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f72df0cc-ac7e-462b-8e53-1d072b787234",
                                                "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                                "text": "Ich hätte gerne eine dünne Scheibe Brot."
                                            },
                                            {
                                                "example_id": "ef2075b4-762e-487f-98ce-cb5107896646",
                                                "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                                "text": "Das ist ja mal ein dünnes Kind."
                                            },
                                            {
                                                "example_id": "c474b565-d320-4c99-85be-3edb80079fc4",
                                                "sense_id": "62a7ddb4-3e9e-320f-8f68-a4510405d8af",
                                                "text": "Aus einem Rezept: Eine große, beschichtete Pfanne erhitzen, 3 EL Öl dazugebe und die Hälfte der Kartoffeln locker einstreuen, so dass ein 0,5 cm dünner und 24 cm großer Kartoffelpfannkuchen entsteht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "wenig ausmachend, von geringem Ausmaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ddfd773-3814-47fb-8180-52cf9404c94f",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "Der Landstrich ist dünn besiedelt."
                                            },
                                            {
                                                "example_id": "ae1cadc2-45e3-4acb-a72a-700ae2809a9f",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "In der Höhe herrscht dünne Luft."
                                            },
                                            {
                                                "example_id": "1b4ac1c2-e36c-4382-a7a3-c35cde9fe0df",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "„Weiter vom Äquator entfernt, ist die Biosphäre dünner besiedelt.“"
                                            },
                                            {
                                                "example_id": "911a0bdf-c644-4d91-9676-898359ba5aeb",
                                                "sense_id": "5976d279-6706-3892-ab43-7f3ada1895e5",
                                                "text": "Noch gehört Russlands Finanzpolster zu den größten der Welt - doch es wird dünner. Erstmals seit 2009 liegen in Moskau weniger als 400 Milliarden Dollar auf der hohen Kante."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bed75f66-2a3f-3a49-a4df-14d537fe8aa8",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "viel Wasser oder Flüssigkeit enthaltend; wenig gehaltvoll an Nährstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f31ee77-f150-40c9-a7cf-9622aacc43b3",
                                                "sense_id": "bed75f66-2a3f-3a49-a4df-14d537fe8aa8",
                                                "text": "„Diese dünne Suppe schmeckt nach nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "wenig gehaltvoll in der Aussage, wenig fundiert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfdd1c92-3874-463f-9d48-74593e5f4a2f",
                                                "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                                "text": "„Deine Argumentation ist ziemlich dünn.“"
                                            },
                                            {
                                                "example_id": "b20ba41f-1cfb-4f0f-8e93-1a1b14fc910b",
                                                "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                                "text": "Wenn man die durchschnittliche Verweildauer von Vorstandsvorsitzenden deutscher Dax-Unternehmen als Grundlage nimmt, dann sind wirklich kompetente Manager dünn gesät."
                                            },
                                            {
                                                "example_id": "1faff5b8-2f89-48ae-b709-12881183d1aa",
                                                "sense_id": "9113d8c0-1017-365f-8f35-cd3933f21717",
                                                "text": "Es ist eine Art von Hollywood-Kino, wie wir sie vor 30 bis 40 Jahren einmal hatten: naiv und patriotisch, dramaturgisch dünn und lediglich auf den Effekt hin inszeniert. Der Geschehnisse des 2. Weltkrieges verkommen zur Kulisse für platte Späße und ein bisschen Action."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "64865466-09ba-3442-9963-6decd19abf88",
                                        "entry_id": "51018e1c-8c96-3031-86ff-a896e49ec55f",
                                        "glosses": [
                                            "kraftlos, leise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713c851d-c894-437d-a794-ca8c8cbe345b",
                                                "sense_id": "64865466-09ba-3442-9963-6decd19abf88",
                                                "text": "Wenn [Sachsens Chefin des Deutschen Gewerkschafts Bundes (DGB)] Iris Kloppich auf Marktplätzen ins Mikrofon spricht, hält ihre dünne Stimme nicht lange durch."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38b61767-a360-49b2-9818-985f46aef978",
                        "source_entry_id": "a7548581-7196-358e-a1b4-0ae10c861947",
                        "source_sense_id": "1b328f23-66ae-3ac5-996c-3aab30e44851",
                        "source_sense_description": "met een lage dichtheid",
                        "target_lang_word": "rarefied",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rarefied",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                        "entry_id": "ffaecedf-8942-3585-a1a6-aae33a78fa9e",
                                        "glosses": [
                                            "Distant from the lives and everyday concerns of ordinary people; esoteric, exclusive, select."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8b56b1-daa7-40b1-82cf-9e7fba2715f8",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "Philosophical debates can be quite rarefied."
                                            },
                                            {
                                                "example_id": "8fceb88b-8db4-40dc-b958-52e607e05f60",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "The country gentry of old time lived in a rarefied social air: dotted apart on their stations up the mountain they looked down with imperfect discrimination on the belts of thicker life below."
                                            },
                                            {
                                                "example_id": "8521bf19-6bdf-4f08-98bd-b5164a638ff1",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "Of course, Beaumont was the real boss; but he lived in the rarefied atmosphere of some Olympian height from which he could distinguish nothing smaller than an international crisis or a split in the Cabinet."
                                            },
                                            {
                                                "example_id": "604b33f6-7350-4812-891c-353a2e86f039",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "I'm not taking the stand of any moralist. I have done the whole S&M route: the costumes and all, so I'm not talking from any rarified point — that's very important. That I have experienced it, that I have lived it."
                                            },
                                            {
                                                "example_id": "b7123c88-2e2c-4921-a544-57d5c619d6b6",
                                                "sense_id": "cb9a06d0-c78e-30c6-8ae7-29f2ee1e1ff5",
                                                "text": "One day, she had to present the children, dressing them formally and introducing them by their full titles, ahead of high tea with extended family. It had been a crash course into the rarefied world in which some Norland charges live."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3d57719-0927-3631-be4e-003761e7fb4c",
                                        "entry_id": "ffaecedf-8942-3585-a1a6-aae33a78fa9e",
                                        "glosses": [
                                            "Elevated in style or nature, sublime; of high intellectual or moral value."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "103c74aa-c9a4-3e9a-8c70-3587f62abed2",
                                        "entry_id": "ffaecedf-8942-3585-a1a6-aae33a78fa9e",
                                        "glosses": [
                                            "Less dense than usual; thin."
                                        ],
                                        "tags": [
                                            "of a gas etc."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54bcd285-1ed3-4b3e-a819-b61c706cd15f",
                                                "sense_id": "103c74aa-c9a4-3e9a-8c70-3587f62abed2",
                                                "text": "The air at high altitudes at the top of mountains is rarefied."
                                            }
                                        ]
                                    }
                                ]
                            },
