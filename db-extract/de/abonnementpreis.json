                "senses": [
                    {
                        "sense_id": "6ffaccfc-be8a-39f5-b805-c692bcdf34ff",
                        "entry_id": "2100bf71-28e6-3f29-925b-bb4735aee775",
                        "glosses": [
                            "Gebühr, die für den Bezug einer Ware oder einer Dienstleistung in einem Abonnement bezahlt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5a0b1d-a8d3-4cd6-9a35-ff8b8cd0f241",
                                "sense_id": "6ffaccfc-be8a-39f5-b805-c692bcdf34ff",
                                "text": "Im Abonnementpreis sind die Versandkosten und die Mehrwertsteuer bereits enthalten."
                            },
                            {
                                "example_id": "79fcee84-541f-4833-a4e3-2904543843ef",
                                "sense_id": "6ffaccfc-be8a-39f5-b805-c692bcdf34ff",
                                "text": "„Die Bergbahngesellschaft in Saas-Fee wirbt im Rahmen einer Aktion mit einem extrem niedrigen Abonnementpreis.“"
                            },
                            {
                                "example_id": "9bc2e433-7dcb-44b3-9fb9-43b165c0bbbe",
                                "sense_id": "6ffaccfc-be8a-39f5-b805-c692bcdf34ff",
                                "text": "„Einen Vorsprung soll der günstige Abonnementpreis für die Nutzung des neuen Dienstes bringen: Nur 4,99 Dollar soll ein Familien-Abo im Monat kosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
