                "senses": [
                    {
                        "sense_id": "c587c8f1-30dc-3048-8089-d8cce377a68b",
                        "entry_id": "36c9e6e6-f62c-3fe9-b7d8-fb895967c87b",
                        "glosses": [
                            "Réétendre, étendre une seconde fois."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a6383ca1-9b77-4f6f-ad8e-b3fe07de9d3a",
                                "sense_id": "c587c8f1-30dc-3048-8089-d8cce377a68b",
                                "text": "[…] faire la lescive ^([sic]), laver, coudre , rétendre le linge, cribler ou râger le blé ou autre grain, aller au moulin, passer la farine, cuire, cueillir les fruits, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e7e493b5-a276-3d29-bbc4-862a69ef596f",
                        "entry_id": "36c9e6e6-f62c-3fe9-b7d8-fb895967c87b",
                        "glosses": [
                            "Épandre, disperser de l’engrais. référence nécessaire (résoudre le problème)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b973677d-2e01-4315-9027-2b87400f352f",
                                "sense_id": "e7e493b5-a276-3d29-bbc4-862a69ef596f",
                                "text": "[…] ce fumier est propre à tout lorsqu’il a passé une ^([sic]) couple de mois au grand air, ce n’est plus qu’un terreau facile à conduire, et encore plus facile à rétendre : cinq ou six tombereaux, tirés par deux bons chevaux, ou deux bœufs, suffisent sur un arpent de pré ; hersez fortement sans rien craindre, après l’avoir rétendu, vous serez étonné de l’effet que cela produira, sur-tout ^([sic]) s’il y a de la mousse."
                            }
                        ]
                    }
