        "de-extract.jsonl": [
            {
                "entry_id": "5756f15a-4532-3c6f-8449-0800dbc943a4",
                "word": "baisodrome",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2ec389d-c764-3d8f-9ea6-f123ce64aab5",
                        "entry_id": "5756f15a-4532-3c6f-8449-0800dbc943a4",
                        "glosses": [
                            "Ort, an dem man sich zum Geschlechtsverkehr trifft (Vergleiche baiser)"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "3e05bd85-3fab-4522-acf7-2f3e37f0d80e",
                                "sense_id": "e2ec389d-c764-3d8f-9ea6-f123ce64aab5",
                                "text": "„Ici, c’est juste un baisodrome pour les gens avec… des goûts un peu bizarres.“",
                                "translation": "Das hier ist bloß ein Liebesnest für Leute mit… etwas eigenartigen Vorlieben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d8d3321-4d52-4a39-8654-0cc1bea668fe",
                        "source_entry_id": "5756f15a-4532-3c6f-8449-0800dbc943a4",
                        "source_sense_id": "e2ec389d-c764-3d8f-9ea6-f123ce64aab5",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Liebesnest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebesnest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52fbb526-cc32-3527-95e1-59325da97a34",
                                        "entry_id": "9e25f94d-f9ea-3b65-b7f7-75c2060cca74",
                                        "glosses": [
                                            "Örtlichkeit (Wohnung, Hotelzimmer, Haus, Wohnwagen oder Ähnliches), wo Verliebte zu (heimlichen) Treffen zusammenkommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5fe2f44-210c-420b-9cf0-8b688cead2f8",
                                                "sense_id": "52fbb526-cc32-3527-95e1-59325da97a34",
                                                "text": "Ihr Ehemann hatte jahrelang eine Stadtwohnung als Liebesnest für sich und seine wechselnden Geliebten unterhalten."
                                            },
                                            {
                                                "example_id": "7f55538d-2bf6-430d-90d9-a141677cbcc9",
                                                "sense_id": "52fbb526-cc32-3527-95e1-59325da97a34",
                                                "text": "In dieser Wohnanlage dienen viele Appartements als diskrete Liebesnester."
                                            },
                                            {
                                                "example_id": "76577699-899e-4b7c-a6d6-bbd47bb529e3",
                                                "sense_id": "52fbb526-cc32-3527-95e1-59325da97a34",
                                                "text": "„Nun hielt er seine geliebte Französin aus La Baule wieder in den Armen, sein Bruder war nur knapp dem Tod entronnen, und er war aus seinem Münchner Liebesnest gerissen worden.“"
                                            },
                                            {
                                                "example_id": "7afa4728-2dd5-48e7-89bc-ba89df3dc689",
                                                "sense_id": "52fbb526-cc32-3527-95e1-59325da97a34",
                                                "text": "„Auf dem Land in Amerika hatte sich vorher das Auto als mobiles Liebesnest etabliert, weshalb ich zwei Autosexgeschichten vorwegstellen möchte.“"
                                            },
                                            {
                                                "example_id": "8cff3f26-dbe2-4681-86ad-622e53c36345",
                                                "sense_id": "52fbb526-cc32-3527-95e1-59325da97a34",
                                                "text": "„Isolde drängt zur Eile, um mit ihm rechtzeitig in ihrer Wohnung zu sein, die sie in stundenlanger Arbeit in ein vollendetes Liebesnest verwandelt hat.“"
                                            },
                                            {
                                                "example_id": "eca962f0-f715-4087-b9df-baa2dcec4511",
                                                "sense_id": "52fbb526-cc32-3527-95e1-59325da97a34",
                                                "text": "„Erst jetzt verständigte er seinen jungen Freund und überraschte ihn mit dem völlig fertigen Liebesnest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
