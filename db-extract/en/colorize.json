                "senses": [
                    {
                        "sense_id": "9c3f4a06-2a14-336a-8367-7f952a916e71",
                        "entry_id": "7f637de6-2fc1-3ea7-8bd6-ee7e1feef096",
                        "glosses": [
                            "To add color to."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "dd390f75-f834-4271-8a8d-b52be10fbb14",
                                "sense_id": "9c3f4a06-2a14-336a-8367-7f952a916e71",
                                "text": "The woman colorized her hair."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5d7bfdb-b356-3fc4-bb1f-e04e08f52467",
                        "entry_id": "7f637de6-2fc1-3ea7-8bd6-ee7e1feef096",
                        "glosses": [
                            "To convert black and white media to color by digital post production (as is often done in digital photography and in video special effects)."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "5d672cdb-2c1c-481f-8c39-26113a339e97",
                                "sense_id": "b5d7bfdb-b356-3fc4-bb1f-e04e08f52467",
                                "text": "There is a colorized version of Casablanca."
                            },
                            {
                                "example_id": "c781045e-dc13-42e9-b5f6-7d9e0acca626",
                                "sense_id": "b5d7bfdb-b356-3fc4-bb1f-e04e08f52467",
                                "text": "What we see are beautiful overlapping NASA satellite photographs of the American mainland, […]taken in black and white and then luminously colorized by computer for scientific reasons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "977fc14a-c800-4f99-b1e5-057a4196a23c",
                        "source_entry_id": "7f637de6-2fc1-3ea7-8bd6-ee7e1feef096",
                        "source_sense_description": "to add color to",
                        "target_lang_word": "coloriser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coloriser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "024fb71d-f529-3622-ab39-86962a481392",
                                        "entry_id": "26957e72-61a8-34b7-ae01-5fa64c86447f",
                                        "glosses": [
                                            "Mettre en couleur un film noir et blanc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41f0ed5c-0825-4020-982c-171a2970e922",
                                                "sense_id": "024fb71d-f529-3622-ab39-86962a481392",
                                                "text": "Ce film a été colorisé trente ans après sa sortie."
                                            },
                                            {
                                                "example_id": "51a6e8c6-1f64-4385-b6cf-1a64ed5de3c4",
                                                "sense_id": "024fb71d-f529-3622-ab39-86962a481392",
                                                "text": "Parce qu’il y a cinquante ans, les Américains débarquaient en Normandie, TF1 diffuse le film de Cornelius Ryan et Daryl F. Zanuck Le Jour le plus long dans une version « colorisée » (pourquoi pas « coloriée » ?) et Arte évoque l’événement par des bandes authentiques de provenance américaine, anglaise et allemande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99533113-265e-37a9-9b16-59dcfb86cf89",
                                        "entry_id": "26957e72-61a8-34b7-ae01-5fa64c86447f",
                                        "glosses": [
                                            "Mettre en couleur une illustration ou une planche de bande dessinée."
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "note": "Ce mot a une connotation plus professionnelle que son synonyme colorier",
                                        "examples": [
                                            {
                                                "example_id": "4142bc59-0c1b-494f-bff1-1052d3b234e5",
                                                "sense_id": "99533113-265e-37a9-9b16-59dcfb86cf89",
                                                "text": "Il a colorisé cette planche en aplats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "950fa29d-99be-3b5e-8ef0-4d2838609788",
                                        "entry_id": "26957e72-61a8-34b7-ae01-5fa64c86447f",
                                        "glosses": [
                                            "Afficher tout ou partie d'un texte en couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe3aebd-3602-4fee-9516-fcd5d56b70d9",
                                                "sense_id": "950fa29d-99be-3b5e-8ef0-4d2838609788",
                                                "text": "Le but de cette commande est de coloriser des chaînes de caractères correspondant à des expression régulières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0690a147-cc4d-30f7-9af4-b8ef437667d8",
                                        "entry_id": "26957e72-61a8-34b7-ae01-5fa64c86447f",
                                        "glosses": [
                                            "Faire participer plus de gens de couleur."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdab0e3f-ecb0-4eae-8f45-852d8e4ea9f7",
                                                "sense_id": "0690a147-cc4d-30f7-9af4-b8ef437667d8",
                                                "text": "Ce que je souhaite, c’est que le musée se colorise, nous sommes trop blancs. Il est encore très compliqué de faire venir des conservateurs des pays d’origine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a046ab89-45a5-46bc-901c-407ab75152af",
                        "source_entry_id": "7f637de6-2fc1-3ea7-8bd6-ee7e1feef096",
