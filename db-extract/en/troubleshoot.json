                                                "sense_id": "8fb1049b-9f64-369f-8073-243b8293ddbd",
                                                "text": "Die Forscher versuchen, das Rätsel des Lebens zu ergründen."
                                            },
                                            {
                                                "example_id": "bf380420-dce2-4962-812a-81f162094a8d",
                                                "sense_id": "8fb1049b-9f64-369f-8073-243b8293ddbd",
                                                "text": "In einer genaueren Umfrage unter 500 Freiwilligen ergründeten sie dann die Auswirkungen, die das Schlafverhalten haben kann."
                                            },
                                            {
                                                "example_id": "9789da8f-3533-4f39-af88-715e5cda0eb9",
                                                "sense_id": "8fb1049b-9f64-369f-8073-243b8293ddbd",
                                                "text": "Wolf-Michael Schreiber, Facharzt für Neurologie und Psychiatrie, ergründet im Römerhaus gemeinsam mit den Patienten die Ursachen ihrer Sucht - und versucht, sie herauszuführen aus der Hölle, soweit das irgend geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
