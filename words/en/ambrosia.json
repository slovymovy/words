{
    "word_family": [
        "ambrosial",
        "ambrosian"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ba0b21c-fe71-3695-a077-788bc19274c6",
                    "sense_definition": "The mythical food of the gods that grants immortality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient Greek myths, the gods consumed <w>ambrosia</w> to maintain their eternal youth.",
                            "target_lang_translations": {
                                "zh": "在古希腊神话中，众神通过食用<w>仙馔</w>来保持永恒的青春。"
                            }
                        },
                        {
                            "text": "The poet described the nectar and <w>ambrosia</w> served at the divine banquet.",
                            "target_lang_translations": {
                                "zh": "诗人描述了神宴上供应的琼浆和<w>仙馔</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "希腊神话中众神的食物，食用后可长生不老。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "仙馔",
                                "target_lang_sense_clarification": "神话中众神的食物。"
                            },
                            {
                                "target_lang_word": "神食",
                                "target_lang_sense_clarification": "指代神灵享用的食物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4474581-d8e4-3609-a9f2-2cb7be489a50",
                    "sense_definition": "Any food or drink that tastes or smells exceptionally delicious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fresh strawberries were pure <w>ambrosia</w> after our long hike in the heat.",
                            "target_lang_translations": {
                                "zh": "在炎热中长途跋涉后，这些新鲜草莓简直是<w>美味佳肴</w>。"
                            }
                        },
                        {
                            "text": "She prepared a dessert that was absolute <w>ambrosia</w> to the hungry guests.",
                            "target_lang_translations": {
                                "zh": "她准备的甜点对饥肠辘辘的客人们来说简直是<w>美味佳肴</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容极其美味的食物或饮料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "美味佳肴",
                                "target_lang_sense_clarification": "形容极好的食物。"
                            },
                            {
                                "target_lang_word": "琼浆玉液",
                                "target_lang_sense_clarification": "形容极其美味的饮料或食物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59e01e01-b00c-3982-a179-4d5b4a09ca9f",
                    "sense_definition": "A fruit salad dessert made with shredded coconut, pineapple, and oranges.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We served a bowl of chilled <w>ambrosia</w> at the summer picnic.",
                            "target_lang_translations": {
                                "zh": "我们在夏季野餐时供应了一碗冰镇的<w>安布罗西亚水果沙拉</w>。"
                            }
                        },
                        {
                            "text": "The traditional Southern <w>ambrosia</w> recipe includes plenty of fresh coconut.",
                            "target_lang_translations": {
                                "zh": "传统的南方<w>安布罗西亚水果沙拉</w>食谱中包含大量新鲜椰丝。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由椰丝、菠萝和橙子制成的水果沙拉甜点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安布罗西亚水果沙拉",
                                "target_lang_sense_clarification": "特指这种特定的美式甜点。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4c54c8a-fecd-394d-bfd1-60fe89e400db",
                    "sense_definition": "A plant of the genus Ambrosia, commonly known as ragweed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people suffer from allergies when the <w>ambrosia</w> plants begin to bloom.",
                            "target_lang_translations": {
                                "zh": "当<w>豚草</w>开始开花时，许多人会遭受过敏之苦。"
                            }
                        },
                        {
                            "text": "The field was overgrown with <w>ambrosia</w> and other common weeds.",
                            "target_lang_translations": {
                                "zh": "田野里长满了<w>豚草</w>和其他常见的杂草。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ragweed"
                    ],
                    "target_lang_definitions": {
                        "zh": "豚草属植物，通常指豚草。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "豚草",
                                "target_lang_sense_clarification": "植物学名称。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}