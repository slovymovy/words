                        "glosses": [
                            "elektrische fiets die ondersteuning geeft tot een snelheid van 25 km per uur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e632dff-85d6-4a6b-aea1-e83b4c8da0c9",
                                "sense_id": "66d105d0-4727-3cd9-9080-96becd822407",
                                "text": "Daarom moet het groeiende aantal pedelecs per 1 januari volgend jaar aan nieuwe regels voldoen. Nu hebben ze nog een blauw snorfiets-kentekenplaatje, maar volgend jaar moet dat een geel plaatje worden, net als bromfietsen. Een speciale pedelec-helm, een kruising tussen een brommerhelm en een fietshelm, is verplicht. En ze moeten op de rijbaan gaan rijden binnen de bebouwde kom."
                            },
                            {
                                "example_id": "f8a0033b-fb3f-4e39-a9ba-eaa4355f577f",
                                "sense_id": "66d105d0-4727-3cd9-9080-96becd822407",
                                "text": "De Nederlandse Fietsersbond vindt dat er strengere regels nodig zijn voor de high speed-fietsen. In ieder geval zouden de pedelecs wat de Fietsersbond betreft binnen de bebouwde kom niet op het fietspad mogen rijden."
                            }
                        ]
                    }
