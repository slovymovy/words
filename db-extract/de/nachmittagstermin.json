                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10daffb-0b12-43b3-88ec-f18ae9940458",
                                "sense_id": "6a25f708-373d-31c2-9e6f-8dade31a3977",
                                "text": "„Um die Einnahmen nicht zu schmälern, hat man deren nicht ausverkauften Start in der Felsenreitschule ärarisch schmerzschonend ähnlich einer Seniorenjause an einem Nachmittagstermin festgesetzt.“"
                            },
                            {
                                "example_id": "1a806dc8-cd07-4d31-99fe-cb9e563e6adf",
                                "sense_id": "6a25f708-373d-31c2-9e6f-8dade31a3977",
                                "text": "„Das dürfte auch bei seinem montäglichen Nachmittagstermin der Fall gewesen sein: Genüsslich ließ Andreas Mölzer schon zuvor seinem Parteichef, Heinz-Christian Strache, über die Medien ausrichten, er habe weder Angst vor ihm noch die Absicht zurückzutreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
