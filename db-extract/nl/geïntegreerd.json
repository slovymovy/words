                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f034e63-19cc-3d0f-b2cd-f738766aaf55",
                        "entry_id": "7ceea7a8-d229-3c19-9fc0-ec39bdeee3e5",
                        "glosses": [
                            "deel uitmakend van het grotere geheel, passen in het grotere geheel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8d341a3-6dfd-4670-9d50-ec81fe9f17e1",
                                "sense_id": "5f034e63-19cc-3d0f-b2cd-f738766aaf55",
                                "text": "Hervorming van de Verenigde Naties is voor de regering een belangrijk thema. Inhoudelijk ligt de prioriteit bij een geïntegreerde benadering van vrede, veiligheid en ontwikkeling, bij conflictpreventie en bij bescherming van burgers."
                            },
                            {
                                "example_id": "b02f636c-febf-4e1b-82e7-fab85bd371db",
                                "sense_id": "5f034e63-19cc-3d0f-b2cd-f738766aaf55",
                                "text": "Het bouwadvies is terecht en ingegeven door het eerder beschreven verdwijnen van de verzorgingshuizen. Of dat bouwen het ontstane zorgprobleem oplost, valt echter te betwijfelen. Het voormalige verzorgingshuis bood immers geïntegreerde huisvesting én zorg aan de groep kwetsbare ouderen, veelal boven de 80 jaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f75ec26-7936-3797-8978-a50a1c4ba233",
                        "entry_id": "7ceea7a8-d229-3c19-9fc0-ec39bdeee3e5",
                        "glosses": [
                            "één geheel dat bestaat uit veel onderdelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03b16757-b417-4ac6-9ec1-03e1214c3908",
                                "sense_id": "5f75ec26-7936-3797-8978-a50a1c4ba233",
                                "text": "De ontwikkeling van de computers heeft na de ontdekking van de transistor een grote stap voorwaarts gedaan door de productie van steeds complexere geïntegreerde schakelingen op één enkel chip."
                            }
                        ]
                    }
