                                        "glosses": [
                                            "Édicule de rue, à l’origine en forme de petit kiosque, servant de présentoir pour le commerce de la presse, fermé la nuit par des volets en bois ou en métal."
                                        ],
                                        "tags": [
                                            "Mobilier urbain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f6d935-ff32-4ee7-b8ff-58ecb224f36f",
                                                "sense_id": "7bac3849-7143-3af4-a276-2e8db3ffe557",
                                                "text": "Le visage de Jackie Kennedy ornait le dos du kiosque à journaux."
                                            },
                                            {
                                                "example_id": "9a56a23e-77a4-49e7-beee-5a7ec95372f5",
                                                "sense_id": "7bac3849-7143-3af4-a276-2e8db3ffe557",
                                                "text": "Plus bas, à l’angle de l’avenue de Friedland et de l’avenue Hoche, un nuage de fumée environne rapidement un kiosque à journaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2fd4619-ea0d-471a-8581-0b13e26664f5",
                        "source_entry_id": "5e3695ba-22bb-37d8-9974-b1df1fdd7363",
