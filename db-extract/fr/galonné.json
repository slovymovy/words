                ],
                "senses": [
                    {
                        "sense_id": "ebbdd378-a42e-365f-90fc-bf69262cab76",
                        "entry_id": "dc27fb2c-b9fe-35bf-8ee4-ba579a5139f6",
                        "glosses": [
                            "Officier ou sous-officier."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "08911c87-8959-42b6-bf0b-1b578c7402a2",
                                "sense_id": "ebbdd378-a42e-365f-90fc-bf69262cab76",
                                "text": "Mais il usa vainement le peu de forces qui lui restait, à combattre l’obstination imbécile de quelques galonnés importants, aux pieds desquels il se traîna en pleurant, et qui ne lui permirent seulement pas d’entrevoir le général. Il revint chez lui râlant de douleur."
                            },
                            {
                                "example_id": "73fefb82-d717-42f6-8a80-20db004b0a61",
                                "sense_id": "ebbdd378-a42e-365f-90fc-bf69262cab76",
                                "text": "Elles étaient toutes amoureuses des galants marins, du galonné au simple pompon rouge, tous tirés à quatre épingles avec coupe de cheveux stricte."
                            },
                            {
                                "example_id": "904ba4f1-2f22-4b00-96fb-df473f571e82",
                                "sense_id": "ebbdd378-a42e-365f-90fc-bf69262cab76",
                                "text": "Désormais, tous ces galonnés appartiennent à « une mission opérationnelle de sécurité et de défense » (sic), qui comprend neuf membres, et sont directement rattachés au directeur de cabinet, Stéphane Fratacci."
                            }
                        ]
                    }
