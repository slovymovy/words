                "senses": [
                    {
                        "sense_id": "a041935a-da0b-33ed-9359-65a5ec959f47",
                        "entry_id": "53947fd3-2578-3072-9a5f-3d2f10341e63",
                        "glosses": [
                            "osoba występująca w kostiumie upodabniającym ją do kogoś, czasem w masce"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d8cf5e46-8579-466e-8f90-5328207c0c93",
                                "sense_id": "a041935a-da0b-33ed-9359-65a5ec959f47",
                                "text": "W drzwiach stanęli przebierańcy – diabeł i śmierć; okazało się, że to kolędnicy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c3369bea-d45a-3cf5-af4a-d0d7d2fd214f",
                        "entry_id": "53947fd3-2578-3072-9a5f-3d2f10341e63",
                        "glosses": [
                            "o człowieku niestandardowo, śmiesznie ubranym"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "306596e3-1778-4b35-9870-00505565d87f",
                                "sense_id": "c3369bea-d45a-3cf5-af4a-d0d7d2fd214f",
                                "text": "Nasza córka chyba wpadła w nie najlepsze towarzystwo, widziałem ją na ulicy z jakimś dziwnym przebierańcem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
