                        ],
                        "form": "roulants"
                    },
                    {
                        "form_id": "2c273731-9818-47bb-9f87-415f45494699",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "roulante"
                    },
                    {
                        "form_id": "7a41a365-9a6a-4467-a499-5a4fdae9eccc",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "roulantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba1a4289-3617-387d-b8e7-b643ab90d4e8",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "glosses": [
                            "Qui roule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b21904bb-9252-48a5-a4a5-d3886f57f070",
                                "sense_id": "ba1a4289-3617-387d-b8e7-b643ab90d4e8",
                                "text": "Des pierres roulantes."
                            },
                            {
                                "example_id": "54ca271f-8961-484e-8a50-27a08dfe013b",
                                "sense_id": "ba1a4289-3617-387d-b8e7-b643ab90d4e8",
                                "text": "L’homme et la femme en haillons, trempés jusqu’aux os, suivaient la carriole, dont la toile oscillait sur des cerceaux d’osier. Des têtes d’enfants, ébouriffées, sortaient des ouvertures de la maison roulante."
                            },
                            {
                                "example_id": "b780a85e-f1f9-42a9-8487-b6c3c3f91cd5",
                                "sense_id": "ba1a4289-3617-387d-b8e7-b643ab90d4e8",
                                "text": "Ç’avait été un événement dans sa vie le jour où il avait vu passer un train. Mais jamais il n’avait mis le pied dans ces maisons roulantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5c71600-8dc6-3a56-a49b-0d1a9a875d1c",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "glosses": [
                            "Qualifie le matériel qui roule sur les voies, comme les wagons."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2e92a3fc-789e-3da1-b64d-8270d92de198",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "glosses": [
                            "Qualifie une voie qui se meut mécaniquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f64db3f-aad0-4507-a524-c5fc668003f2",
                                "sense_id": "2e92a3fc-789e-3da1-b64d-8270d92de198",
                                "text": "Trottoir roulant."
                            },
                            {
                                "example_id": "e0851a96-240d-4dde-9157-d6be88360f1d",
                                "sense_id": "2e92a3fc-789e-3da1-b64d-8270d92de198",
                                "text": "Chemin roulant, tapis roulant, escalier roulant."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d573320-629e-3de2-8db5-4cdceb93ce8a",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "glosses": [
                            "Qualifie un feu continu, une fusillade nourrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc806bef-576b-4ee1-8842-29f7b502578a",
                                "sense_id": "3d573320-629e-3de2-8db5-4cdceb93ce8a",
                                "text": "L’ennemi fit un feu roulant."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f171aef-604b-3782-beb9-c8e428a13111",
                        "entry_id": "e67f00cf-0044-3722-99ab-3372c4954fa0",
                        "glosses": [
                            "Drôle, tordant."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5b5eb4cd-aa82-458d-b976-029ce9dcad73",
                                "sense_id": "0f171aef-604b-3782-beb9-c8e428a13111",
                                "text": "Comment ? Vous n’avez pas lu Paludes ? C’est roulant… Mais oui, de Gide."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2c4f539d-4c9a-392f-97a5-5e4888292bc5",
                "word": "roulant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf2d4754-6f98-4e20-a8bf-5118b292c08e",
                        "entry_id": "2c4f539d-4c9a-392f-97a5-5e4888292bc5",
                        "tags": [
                            "plural"
                        ],
                        "form": "roulants"
                    },
                    {
                        "form_id": "842d7c20-6825-4f8b-a3d1-1e3db2dc7248",
                        "entry_id": "2c4f539d-4c9a-392f-97a5-5e4888292bc5",
                        "tags": [
                            "feminine"
                        ],
                        "form": "roulante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "516513fe-f587-3cb8-bba7-5d31203a49b1",
                        "entry_id": "2c4f539d-4c9a-392f-97a5-5e4888292bc5",
                        "glosses": [
                            "Employé d'une compagnie de chemin de fer qui travaille a bord du train (locomotive, wagon), par opposition au rampant (voies, gares, bureaux, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c489b5-274b-47dd-892a-b0254aa15fe3",
                                "sense_id": "516513fe-f587-3cb8-bba7-5d31203a49b1",
                                "text": "D'ailleurs, arrivés vers les quarante-cinq ans, les roulants ne rient presque plus. Ils font leur travail avec rancœur car la S.N.C.F. les traite comme des militaires qui font leur service militaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d475d21-665b-378d-87ef-4e4b59e3640b",
                        "entry_id": "2c4f539d-4c9a-392f-97a5-5e4888292bc5",
                        "glosses": [
                            "Vagabond, rôdeur, qui va de ville en ville et souvent vit de petits vols et de mendicité. Synonyme de chemineau."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "180013c7-41af-458f-9a98-1cd4e7e3487f",
                                "sense_id": "7d475d21-665b-378d-87ef-4e4b59e3640b",
                                "text": "On nous fit entrer dans une salle carrée, blanchie à la chaux et garnie de bancs, où il nous fallut attendre une grande heure et demie en compagnie de six roulants et de trois braconniers."
                            },
                            {
                                "example_id": "674d0fde-3c35-492c-8eae-02ad08b48a22",
                                "sense_id": "7d475d21-665b-378d-87ef-4e4b59e3640b",
                                "text": "Il ferma la porte avec fracas et ils l’entendirent distinctement dire à sa femme en se servant du mot dont on désigne les chemineaux :\n– C’est un roulant avec sa roulante."
                            },
                            {
                                "example_id": "16998db2-0adf-41ec-9338-efa8837c069a",
                                "sense_id": "7d475d21-665b-378d-87ef-4e4b59e3640b",
                                "text": "On se retenait, lorsqu’on avait envie de donner un sou aux roulants qui demandent la charité. Les femmes disaient :\n– Ma foi, tant pis ! Je le garde pour le père et la mère Sinturel."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca70b4a5-5a32-3203-b9a5-b069288f4e57",
                        "entry_id": "2c4f539d-4c9a-392f-97a5-5e4888292bc5",
                        "glosses": [
                            "Ensemble des biens mobiliers reliés à l’exploitation d’une entreprise."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d06fc63e-b121-40b3-af81-ba3ed7f83222",
                                "sense_id": "ca70b4a5-5a32-3203-b9a5-b069288f4e57",
                                "text": "Et quand je me suis retiré au village, il y a dix ans, j’ai vendu ma terre et mon roulant à mon garçon."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5a379801-888d-385e-ba9d-a17a6f81b313",
                "word": "roulant",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a7f053c-dc6a-39af-87ad-7c42ef6ed4ee",
                        "entry_id": "5a379801-888d-385e-ba9d-a17a6f81b313",
                        "glosses": [
                            "Participe présent de rouler."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d07fd2d2-992f-463e-8746-42cc0612dc35",
                                "sense_id": "3a7f053c-dc6a-39af-87ad-7c42ef6ed4ee",
                                "text": "En roulant ou déroulant du padou, il suivait le cours brillant des rivières."
                            }
                        ]
                    }
                ],
