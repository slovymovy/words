                        "examples": [
                            {
                                "example_id": "82ec324b-59d1-4705-8ef7-0ea72550483a",
                                "sense_id": "60e243d8-69b8-3a09-9ae0-9fbaa66c3031",
                                "text": "[…] c'est un dédale de pièces remplies de compactus, ces rayonnages qu’on fait coulisser en actionnant une grosse manivelle."
                            },
                            {
                                "example_id": "b8fc2a5f-2a03-42be-95ef-04654a59f538",
                                "sense_id": "60e243d8-69b8-3a09-9ae0-9fbaa66c3031",
                                "text": "L’endroit ressemble à un vaste hangar rempli de compactus, des armoires d’archives mobiles."
                            },
                            {
                                "example_id": "208380e9-082a-43e2-880d-49049af9726f",
                                "sense_id": "60e243d8-69b8-3a09-9ae0-9fbaa66c3031",
                                "text": "Toujours dans le cadre du chantier des collections, le Musée a répondu à un appel à projets de la Fédération Wallonie-Bruxelles pour l’obtention d’un subside d’équipement portant sur l’acquisition d’un compactus et d’armoires à plans destinées au rangement de documents graphiques et de drapeaux."
                            },
                            {
                                "example_id": "70935963-1f90-41e9-aeb5-eaea4ee94489",
                                "sense_id": "60e243d8-69b8-3a09-9ae0-9fbaa66c3031",
                                "text": "L’année 2018 a permis de poursuivre le réaménagement des collections dans le compactus installé au sein des réserves d’Ans."
                            }
