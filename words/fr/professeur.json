                    "frequency": "VeryLow",
                    "semantic_group_id": "doctrine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet écrivain se posait volontiers en <w>professeur</w> de sagesse face aux égarements de son époque."
