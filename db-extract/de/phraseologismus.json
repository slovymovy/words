                        ],
                        "form": "den Phraseologismus"
                    },
                    {
                        "form_id": "5d911d54-7c76-4b37-9cff-9ab9dd40ec3e",
                        "entry_id": "478dd377-9cd0-3f1d-adfa-0bf4ec5d9432",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Phraseologismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                        "entry_id": "478dd377-9cd0-3f1d-adfa-0bf4ec5d9432",
                        "glosses": [
                            "feste Verbindung von zwei oder mehr Wörtern, deren Gesamtbedeutung sich nicht mehr aus den Bedeutungen der einzelnen Komponenten ergibt, sondern eine Übertragung erfahren hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c659b01-f7de-4249-9ce4-387d104414b4",
                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                "text": "„Jemanden in die Pfanne hauen“, „den Rahm abschöpfen“, „durch die Lappen gehn“ sind Phraseologismen im Deutschen."
                            },
                            {
                                "example_id": "aef4fd9c-ed27-4c74-990d-f378a930a0d2",
                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                "text": "Mit Phraseologismen befasst sich die linguistische Disziplin Phraseologie."
                            },
                            {
                                "example_id": "7641397a-2e53-4980-b86c-909c061c433a",
                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                "text": "„Es gibt zwischensprachlich sogar eine Reihe von Phraseologismen, die lexikalisch analog und in ihrer syntaktischen Struktur parallel gebildet werden und dabei auch noch bedeutungsgleich sind: man spricht in diesem Fall von ‚isomorphen Phraseologismen‘.“"
                            },
                            {
                                "example_id": "6dc5c86c-2970-4f6d-ab1d-e7900d84fd42",
                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                "text": "„Unter Phraseologismen wollen wir feste Einheiten aus mehr als einem Wort verstehen.“"
                            },
                            {
                                "example_id": "2b8f2e79-cbd6-47e5-b42f-7b2e467ef735",
                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                "text": "„Bei W. Fleischer erscheinen die meisten festen Formen unter der heute gebräuchlichen Bezeichnung des Phraseologismus.“"
                            },
                            {
                                "example_id": "a0b2eea2-1bef-4e54-a99b-195953883955",
                                "sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                                "text": "„Sprichwörter zählen zu den Phraseologismen, das heißt zu festen Wortverbindungen, die laut H. Burger (…) Polylexikalität, relative semantische und syntaktische Stabilität, Festigkeit, Lexikalisierung und Idiomatizität sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c428445f-c949-4c1d-894a-176906e3a818",
                        "source_entry_id": "478dd377-9cd0-3f1d-adfa-0bf4ec5d9432",
                        "source_sense_id": "b3576b60-81bf-30fa-b57d-836636da7384",
                        "source_sense_description": "Linguistik: feste Wortverbindung, deren Bedeutung sich nicht aus den einzelnen Komponenten ergibt",
                        "target_lang_word": "phraseology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phraseology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10c75d38-0402-37fd-a681-e0aee67a52a1",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "Study of set or fixed expressions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1574c467-9315-3430-b706-67f4a0735e10",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "The style in which words and phrases are used in writing or speech."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf2e738-da27-450b-a7aa-ba2be9b24464",
                                                "sense_id": "1574c467-9315-3430-b706-67f4a0735e10",
                                                "text": "I was riding through the forest, when suddenly (pray correct my phraseology if too worldly—you know I am not well read in these epics of the heart) I saw a knight and his lady traversing one of the glades; the golden sunshine fell athwart the green leaves, and showed their white steeds and whiter plumes, while the air around grew musical with their gentle words and laughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "A group of specialized words and expressions used by a particular group."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024ce262-63bb-4ca9-8ffe-078c128e67d2",
                                                "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                                "text": "Fortunately, two servants she had brought with her, were devotedly attached to their mistress; and the others only entering her apartments at rare intervals, did not understand her mystic allusions; and she now, more than ever, affected to veil her meaning under the mysterious phraseology so much adopted by the Jacobites."
                                            },
                                            {
                                                "example_id": "7cae9367-80ee-4878-858f-a0981e7a7a1c",
                                                "sense_id": "7c85458b-cd99-3159-8a1e-2aa41c059cfd",
                                                "text": "Railway grouping had caused some peculiarly Scottish phraseology to disappear, though the note \"Stops on timous notice to the guard\" survived until comparatively recently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30186e8d-c8e4-3375-8503-03754d112f78",
                                        "entry_id": "19608c0e-93c2-30a4-837b-34fa40a6a8bd",
                                        "glosses": [
                                            "A collection of phrases; a phrasebook."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
