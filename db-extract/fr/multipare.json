                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "multipares"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2cec634-6159-3821-a687-0e41b9eb974e",
                        "entry_id": "a8bf3473-e13c-37dd-ab27-a787329af199",
                        "glosses": [
                            "Qui a accouché plus d’une fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d14d423-ee70-4f93-857e-5e458e47e002",
                                "sense_id": "b2cec634-6159-3821-a687-0e41b9eb974e",
                                "text": "Secondipare (peu usité) désigne une femme qui accouche pour la seconde fois. En pratique dès qu'une femme a accouché plus d'une fois on parle de femme multipare sans tenir compte du nombre d'accouchements."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdf079a1-14dc-388a-ab56-00e56e737acc",
                        "entry_id": "a8bf3473-e13c-37dd-ab27-a787329af199",
                        "glosses": [
                            "Qualifie une femelle qui a mis bas plusieurs fois."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "60c8fd0f-c994-3fb4-895f-bf106c207424",
                        "entry_id": "a8bf3473-e13c-37dd-ab27-a787329af199",
                        "glosses": [
                            "Qualifie une inflorescence possédant plus de trois ramifications sur la ramification principale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83168c4e-3962-4390-8ddc-529db75c5b27",
                                "sense_id": "60c8fd0f-c994-3fb4-895f-bf106c207424",
                                "text": "Au cours des ramifications successives, souvent les cymes s’appauvrissent : des cymes multipares deviennent bipares (Periploca), des cymes bipares deviennent unipares par développement d’une seule des branches"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c070cb7-a790-4092-9ccb-94a1f75ab28a",
                        "source_entry_id": "a8bf3473-e13c-37dd-ab27-a787329af199",
                        "source_sense_id": "b2cec634-6159-3821-a687-0e41b9eb974e",
                        "source_sense_description": "(Obstétrique) Qui a accouché plus d'une fois.",
                        "target_lang_word": "πολύτοκος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "πολύτοκος",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4db87b-ef96-348e-aff9-77543f889fb4",
                                        "entry_id": "d649296a-9337-352d-84bf-900d1593e560",
                                        "glosses": [
                                            "που έχει γεννήσει πολλές φορές"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147096d2-d877-493d-8047-db8da471deb4",
                                                "sense_id": "9d4db87b-ef96-348e-aff9-77543f889fb4",
                                                "text": "※ Στο πρώτο στάδιο του τοκετού διακρίνονται δύο φάσεις, η λανθάνουσα και η ενεργητική. Η λανθάνουσα φάση χαρακτηρίζεται από ήπιες ωδίνες της μήτρας και διαρκεί περίπου έξι ώρες στην πρωτότοκο και τέσσερις ώρες στην πολύτοκο. (Δυστοκία και μαιευτικές επιπλοκές κατά τον τοκετό ivf-embryo.gr, ανακτήθηκε στις 15/4/2023 https://www.ivf-embryo.gr/maieytikes-epiplokes)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40913acb-f112-3390-aa85-f2f05d96222a",
                                        "entry_id": "d649296a-9337-352d-84bf-900d1593e560",
                                        "glosses": [
                                            "που γεννά πολλά νεογνά"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2a9229d-b6dc-358a-b547-d41bb5318a2b",
                                        "entry_id": "d649296a-9337-352d-84bf-900d1593e560",
                                        "glosses": [
                                            "που γεννά πολλές ιδέες"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a635caae-8089-4180-a739-ff3fde373548",
                                                "sense_id": "c2a9229d-b6dc-358a-b547-d41bb5318a2b",
                                                "text": "※ Δεν είμαι χορογράφος, ένας απλός θεατής είμαι, αλλά μπορώ να υποψιαστώ ότι ένας πολύτοκος νους βασανίζεται αρκετά μέχρι να εντοπίσει το χρυσό νήμα που θα οδηγήσει σε μια γόνιμη έξοδο από τον χειμαρρώδη δαίδαλο. (Ένας αφυπνιστικός εφιάλτης, philenews.com, 8/1/2023 https://www.philenews.com/politismos/kritikes/article/1630990/enas-afypnistikos-efialtis)"
                                            }
                                        ]
                                    }
                                ]
