                        ]
                    },
                    {
                        "translation_id": "2d706098-cfd8-406c-b022-471431fc669a",
                        "source_entry_id": "f8de1ee9-9498-3227-974e-00c22f2fe91f",
                        "source_sense_id": "40991dbf-510f-3777-a2fe-89231e815b42",
                        "target_lang_word": "cheminer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheminer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96c1895b-d45a-3599-bbcf-6bc6ce0a9b63",
                                        "entry_id": "c2b29935-e41e-3889-8c62-c86ac0500f8d",
                                        "glosses": [
                                            "Marcher, aller, faire du chemin pour arriver quelque part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03de28b3-479f-4e6d-aa55-77b7e6760507",
                                                "sense_id": "96c1895b-d45a-3599-bbcf-6bc6ce0a9b63",
                                                "text": "Les traîneaux cheminaient paisiblement et facilement."
                                            },
                                            {
                                                "example_id": "768603c3-e0c9-43a3-8fb4-ff709b295f65",
                                                "sense_id": "96c1895b-d45a-3599-bbcf-6bc6ce0a9b63",
                                                "text": "Ils cheminaient donc en silence et ils allaient traverser la chaussée pour remonter le côté gauche du boulevard Malesherbes, lorsque le financier s'arrêta."
                                            },
                                            {
                                                "example_id": "a17f940c-2cab-4d08-a02f-f3884074d782",
                                                "sense_id": "96c1895b-d45a-3599-bbcf-6bc6ce0a9b63",
                                                "text": "Les branches les plus volumineuses de ces deux vaisseaux cheminent côte à côte dans des tractus fibreux, appelés espaces portes, accompagnés par les canaux biliaires qui véhiculent la bile dans la direction opposée […]"
                                            },
                                            {
                                                "example_id": "9ee6dd7a-ded7-4608-87ce-516f2137c5ef",
                                                "sense_id": "96c1895b-d45a-3599-bbcf-6bc6ce0a9b63",
                                                "text": "Le gamin est passé par la lucarne et a cheminé sur les toits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52ce0e03-9342-3e99-84aa-9a64d451478a",
                                        "entry_id": "c2b29935-e41e-3889-8c62-c86ac0500f8d",
                                        "glosses": [
                                            "Faire son chemin, progresser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b76de5-1c21-43f9-9daa-96d42b43a126",
                                                "sense_id": "52ce0e03-9342-3e99-84aa-9a64d451478a",
                                                "text": "[Sur la phrénologie de Franz Gall] Le bruissement de la postérité n'a pas retenu cette construction théorique révolutionnaire, et seules les bosses du pauvre Gall ont cheminé jusqu’à notre XXIᵉ siècle balbutiant. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 269)"
                                            },
                                            {
                                                "example_id": "368b6933-7afd-44ff-abdb-21cd0e836e39",
                                                "sense_id": "52ce0e03-9342-3e99-84aa-9a64d451478a",
                                                "text": "François Legault plaide que les réformes « cheminent »."
                                            },
                                            {
                                                "example_id": "8e5d2096-f3dd-4248-bed7-675f2f1b987a",
                                                "sense_id": "52ce0e03-9342-3e99-84aa-9a64d451478a",
                                                "text": "S’il y a des personnes non genrées qui veulent se présenter, bien, que ces personnes-là le fassent, et ça va nous faire cheminer !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6b51575-dce1-3e04-8b34-2cda6f10056a",
                                        "entry_id": "c2b29935-e41e-3889-8c62-c86ac0500f8d",
                                        "glosses": [
                                            "Avoir un parcours de réflexion et d'expériences pouvant mener vers une conversion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d1d27ba-ff25-4cef-8a31-f7c7e2757573",
                                                "sense_id": "c6b51575-dce1-3e04-8b34-2cda6f10056a",
                                                "text": "Dans la vie, je ne suis pas baptisé non plus, mais je « chemine », comme disent les cathos. C'est une expression marrante, ça, cheminer. Ça exprime bien ce que je vis. Le vrai Gad, il est dans le questionnement. J'ai toujours mon conseiller spirituel, le père Barthélémy, celui qu'on voit dans le film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16736c5-7a6e-3d3e-8d05-0f301a9d0325",
                                        "entry_id": "c2b29935-e41e-3889-8c62-c86ac0500f8d",
                                        "glosses": [
                                            "Pousser en avant les travaux d’attaque contre une place assiégée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
