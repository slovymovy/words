                        "entry_id": "f2d843e4-aa22-31a3-be69-c69e6b7ba4f5",
                        "glosses": [
                            "Nymphe des vallées boisées, des vallons et des grottes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0d63f1-faf2-4667-a318-cf17d087c8f3",
                                "sense_id": "45ae9afc-b6d0-30bc-a6bd-df9f24cd6e62",
                                "text": "S’il plonge, il baise une napée ; s’il se renverse, il est baisé."
                            },
                            {
                                "example_id": "19c58ddc-df77-495a-8bfd-6970636a6166",
                                "sense_id": "45ae9afc-b6d0-30bc-a6bd-df9f24cd6e62",
                                "text": "[…], Girardon, que nous nommons pour la première fois, fut un des plus nobles exécutants du XVIIᵉ siècle ; ses napées encore enfantines furent universellement admirées et séduisent toujours."
                            },
                            {
                                "example_id": "a4187d43-544e-48f6-875f-1c342cdfe608",
                                "sense_id": "45ae9afc-b6d0-30bc-a6bd-df9f24cd6e62",
                                "text": "… d’un ruisseau, l’une des napées […] lui dist…"
                            }
                        ]
                    }
