        "ru-extract.jsonl": [
            {
                "entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                "word": "попеременно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                        "entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                        "glosses": [
                            "сменяя друг друга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bb07134-9f4e-457e-a041-e81995b24b00",
                                "sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                                "text": "В первой молодости моей я был мечтателем, я любил ласкать попеременно то мрачные, то радужные образы, которые рисовало мне беспокойное и жадное воображение."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa59bbd-aeb8-41dd-9e84-7dbf381c7664",
                        "source_entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                        "source_sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                        "target_lang_word": "alternately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                        "entry_id": "bd988ddd-af6b-31b3-93cf-774746694f64",
                                        "glosses": [
                                            "In reciprocal succession; succeeding by turns; in alternate order."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60ba0ab5-f5d8-4716-b2b2-6acaeb9b926b",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "All night Katerina and I watched alternately, though, I shame to say, I slept more than I watched; and, having first ascertained that there was no change, I came directly hither."
                                            },
                                            {
                                                "example_id": "1fc7d224-f8d8-4ad1-91ae-88fa973bddce",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "Tired with the heat and my walk, I threw myself down on the grass in the shadow of the house, where I lay half-asleep enjoying a quiet rest, when I was startled by an unpleasant clamour, the jarring voice of a woman, who was trying by alternately scolding and using pet names to pacify a litter of grunting pigs on the farm."
                                            },
                                            {
                                                "example_id": "2980d7a1-8f09-48a4-92e2-ebecaf883bc4",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "Well, I can't help noticing that you insult me and then you're polite to me alternately."
                                            },
                                            {
                                                "example_id": "72665851-2e0a-42eb-a4b8-a39a3457518f",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "The 2025 timetable would feature two trains per hour, alternately routed via Kirkcaldy (with 11 intermediate stops) and Dunfermline (14 stops), with journey times ranging between 65 and 81 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08483303-905f-35b7-ba6a-6f65a8e3978b",
                                        "entry_id": "bd988ddd-af6b-31b3-93cf-774746694f64",
                                        "glosses": [
                                            "By alternation; when, in a proportion, the antecedent term is compared with antecedent, and consequent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dbad339-06ba-3637-8b5c-679f73ec0afe",
                                        "entry_id": "bd988ddd-af6b-31b3-93cf-774746694f64",
                                        "glosses": [
                                            "Alternatively."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "not-comparable",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe98cab-4ab7-4c73-9e31-bfc4fac19197",
                                                "sense_id": "4dbad339-06ba-3637-8b5c-679f73ec0afe",
                                                "text": "Downstairs, he was informed. That is, down the escalators, where there is both a women’s room (often with a line) and a men’s room (almost never with a line). Or alternately, he could ask the station master to buzz him into the “family” bathroom. He opted to go downstairs."
                                            },
                                            {
                                                "example_id": "a62d62b2-8db3-4a48-9aef-40aa48945558",
                                                "sense_id": "4dbad339-06ba-3637-8b5c-679f73ec0afe",
                                                "text": "Westerners have never quite understood the reverence in Japan for fugu, alternately known in English as puffer fish, globefish or blowfish, of the family Tetraodontidae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "290632be-cf85-42db-8501-847f568f53c6",
                        "source_entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                        "source_sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                        "target_lang_word": "in turn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in turn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "One after the other; one at a time; in succession; successively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ce150b-5396-4b48-9665-44b0b4c7eafc",
                                                "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                                "text": "The teacher answered the students each in turn."
                                            },
                                            {
                                                "example_id": "c49f48d0-3c51-408b-a49e-a4a844426333",
                                                "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                                "text": "Each member of the group, in turn, rose to share a personal story, until nearly everyone in the room had spoken."
                                            },
                                            {
                                                "example_id": "c1ac7bb5-9589-4134-8d7e-6ac8e06425c2",
                                                "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                                "text": "Eventually, each of the countries in turn would be brought to submission by the invading force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488e2bde-d111-39d0-b006-9f2dc16cffc7",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "In due order; in proper sequence; in a determined or measured sequence, as a waiting line or queue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "186d328f-cb4e-4862-93f6-a945a1e0b790",
                                                "sense_id": "488e2bde-d111-39d0-b006-9f2dc16cffc7",
                                                "text": "You are next in turn to bat."
                                            },
                                            {
                                                "example_id": "c383ab7e-8047-4ee2-b9c7-95b22207f038",
                                                "sense_id": "488e2bde-d111-39d0-b006-9f2dc16cffc7",
                                                "text": "The boy was next in turn to sit on Santa's lap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "In response; in return."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce3b8cd3-1983-441a-bae5-808e398ece97",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "The musical ambassadors finished their performance, and the local musicians in turn played for them a traditional ballad."
                                            },
                                            {
                                                "example_id": "40bd8a51-2746-481f-9caf-764633831414",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "With great humility, I call upon all Americans to help me keep our nation united in defense of those ideals which have been so eloquently proclaimed by Franklin Roosevelt. I want in turn to assure my fellow Americans and all of those who love peace and liberty throughout the world that I will support and defend those ideals with all my strength and all my heart."
                                            },
                                            {
                                                "example_id": "18327679-df02-416f-a0c3-ec0b23e373cf",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "As was the case with the \"Merchant Navy\" locomotives, some of these features have proved troublesome, and this in turn at times has reflected on performance as well as on maintenance."
                                            },
                                            {
                                                "example_id": "7770c3ae-4648-439b-83a6-9fc3cadb0d21",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "The initiated member gave a gift of a coin for the goddess, for which he received in turn a phallus and some salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "Having a relationship sequentially comparable to one just mentioned; accordingly or similarly, with respect to sequence, precedence, or hierarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174c0fd3-a504-49cf-8e51-f37f5807ea5f",
                                                "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                                "text": "The vassals were subject to their lords, who in turn were subject to barons or kings."
                                            },
                                            {
                                                "example_id": "b8b1b1a9-9917-4183-971c-8661270b9804",
                                                "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                                "text": "My car was hit by a truck, which in turn was hit by the van."
                                            },
                                            {
                                                "example_id": "2c115beb-c491-426a-a292-b433dce703fb",
                                                "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                                "text": "Mr. X leaked the secret to Mr. Y who in turn leaked it to Mr. Z."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46a57acd-ce36-41d3-8f3e-434fc65a3827",
                        "source_entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                        "source_sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                        "target_lang_word": "by turns",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by turns",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e1089b3-c34c-340d-ba47-a6ce955dd3d9",
                                        "entry_id": "888332c0-423b-39f5-a35e-59f395c3ebc5",
                                        "glosses": [
                                            "One after the other; successively; alternating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e675e9df-be2e-4ae9-836c-1bf72e9412a3",
                                                "sense_id": "2e1089b3-c34c-340d-ba47-a6ce955dd3d9",
                                                "text": "I am by turns angry and amused. I am the butchest of the three roommates; obviously she thought I was the most likely to get over my “bisexual phase.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea0f7a1-b693-317b-8a3b-25ee8b559560",
                                        "entry_id": "888332c0-423b-39f5-a35e-59f395c3ebc5",
                                        "glosses": [
                                            "At intervals; from time to time."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0b5ba1e-4695-48a3-9fc3-b1b44b905c90",
                                                "sense_id": "1ea0f7a1-b693-317b-8a3b-25ee8b559560",
                                                "text": "[They] feel by turns the bitter change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d15d407-d35a-48b6-a599-70cf06ef8fdc",
                        "source_entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                        "source_sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                        "target_lang_word": "in rotation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "709c2c83-e128-40d4-b27a-e05e9ddb41a1",
                        "source_entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                        "source_sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                        "target_lang_word": "alternativement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternativement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73eb64f8-b34e-3e2b-ba2d-a085d9d250e1",
                                        "entry_id": "1764a69a-c228-3059-a39c-01bf1954d633",
                                        "glosses": [
                                            "Tour à tour ; l’un après l’autre ; à tour de rôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d5faf1-530d-4974-b1c4-1e585ecb04e8",
                                                "sense_id": "73eb64f8-b34e-3e2b-ba2d-a085d9d250e1",
                                                "text": "Et tous les trois, ayant pris la tête de Iaokanann, s’en allèrent du côté de la Galilée.\nComme elle était très lourde, ils la portaient alternativement."
                                            },
                                            {
                                                "example_id": "2b326505-398f-4518-adae-fb9206959eba",
                                                "sense_id": "73eb64f8-b34e-3e2b-ba2d-a085d9d250e1",
                                                "text": "Helmy buvait ses paroles, contemplait ses yeux alternativement enflammés et tendres, et caressait lentement la main qu'elle lui abandonnait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d4b84b1-f4f6-400b-950c-9181fe7bf635",
                        "source_entry_id": "05a5f45f-1df8-3069-8573-2dfd1b7243cc",
                        "source_sense_id": "8b8f36ee-6212-3ecd-8203-24c4702b8a64",
                        "target_lang_word": "tour à tour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tour à tour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                        "entry_id": "9b84b49d-7285-3ba1-9712-14edef355c04",
                                        "glosses": [
                                            "Chacun à son tour ; l’un après l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7837ac1-8994-412e-8c07-d64861dcc34a",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "Là, je restai en calme pendant près d’une semaine, à huit lieues de la terre, dont les courans m’approchaient et m’éloignaient tour à tour."
                                            },
                                            {
                                                "example_id": "47394caf-805e-4e60-96e9-99f5a1023da9",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "L’Océan, que je ne connaissais pas encore, m’apparaissait […] avec ses marées qui viennent tour à tour cacher et nous dévoiler ses richesses."
                                            },
                                            {
                                                "example_id": "f3eb2b29-0968-43dd-9988-d1673eb21f97",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "Et Pausole observait debout les révélations successives d’un corps teinté, ferme, vivace, tandis qu’elle ouvrait tour à tour la chemisette bossue, la jupe monastique, le difforme pantalon blanc."
                                            },
                                            {
                                                "example_id": "36803dc8-c4bc-47d6-9ff5-1eb35d0904b2",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "Elle […] n’affirme sa supériorité que dans la gymnastique amoureuse. Elle excelle aux tortillements, tour à tour fougueuse et alanguie, […]."
                                            },
                                            {
                                                "example_id": "4274d6b1-5c61-471f-991c-ad4d46cc0653",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "« Je suis belle, ô mortels ! comme un rêve de pierre,\nEt mon sein, où chacun s'est meurtri tour à tour,\nEst fait pour inspirer au poète un amour\nÉternel et muet ainsi que la matière. »"
                                            },
                                            {
                                                "example_id": "662c7fcc-85af-40d2-b570-037361e0d662",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "Je relève dans ce second vers une faute magistrale qu’il faut bien appeler solécisme. « Tour à tour » signifie en effet l’un après l’autre ou alternativement. On n’est pas plus fondé à écrire « chacun s’est meurtri tour à tour » que « chacun s’est meurtri à tour de rôle ». Il aurait fallu dire : « où chacun s’est meurtri à son tour »."
                                            },
                                            {
                                                "example_id": "d7576c3d-ceb1-415e-850b-2b2f04530bc3",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "Il continuait son travail, mâchonnant de temps à autre une grosse chique qui tour à tour lui gonflait chaque joue […]."
                                            },
                                            {
                                                "example_id": "e04f83fb-afc4-4db0-9282-a4c7ffb791cc",
                                                "sense_id": "e000395f-acd1-3d3a-aa33-d28c7ca65f6d",
                                                "text": "Quelquefois aussi le trouvère chantait et viélait tout à la fois, les citations abondent qui nous montrent tour à tour les musiciens sous ces deux aspects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
