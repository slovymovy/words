                    {
                        "sense_id": "6369be7e-07dc-33dd-b61f-8d8e61ae6293",
                        "entry_id": "8634c5c2-875a-340c-b764-e25b13131ac4",
                        "glosses": [
                            "Sorte de flûte à bec qui sonne une octave au dessus de la flûte soprano, et une quinte au dessus de la flûte sopranino."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbb39e59-fe17-40a5-aebb-5dfdd713ee57",
                                "sense_id": "6369be7e-07dc-33dd-b61f-8d8e61ae6293",
                                "text": "Il en existe de plusieurs tailles (de l’exilent d'environ 16 cm au sopranino, soprano, alto, ténor, basset, basse et contrebasse, ou grande basse, d'environ 2 m). Chacune couvre à peu près deux octaves."
                            },
                            {
                                "example_id": "4faeb95d-37fe-4e3a-be54-dff316342768",
                                "sense_id": "6369be7e-07dc-33dd-b61f-8d8e61ae6293",
                                "text": "Ou bien, s'agirait-il, comme nous l'a suggéré le flûtiste Francis Mercet, l’exilent en Sol (sorte de sopranino), mentionné par Michael Praetorius dans son Syntagma musicum, qui sonne trois octaves plus haut que la « grande basse» en Fa?"
                            }
                        ]
                    }
                ],
