                "senses": [
                    {
                        "sense_id": "ce0d20bb-6f49-3038-b98e-182bb1bbc763",
                        "entry_id": "8cf71e20-f148-3ed7-9556-7ac684af2d8c",
                        "glosses": [
                            "Blutsverwandter von väterlicher Seite"
                        ],
                        "tags": [
                            "Römisches Reich"
                        ],
                        "examples": [
                            {
                                "example_id": "c00679cb-f5e4-47b2-8abc-951a27d79066",
                                "sense_id": "ce0d20bb-6f49-3038-b98e-182bb1bbc763",
                                "text": "Agnaten waren also alle Personen, die unter derselben väterlichen Gewalt standen (oder gestanden hätten, wenn das sie verbindende Haupt noch gelebt hätte)."
                            },
                            {
                                "example_id": "5302b782-b9b0-4d3e-b2fa-1be271e8a328",
                                "sense_id": "ce0d20bb-6f49-3038-b98e-182bb1bbc763",
                                "text": "Mehrere gleichnahe Agnaten teilten nach Köpfen, auch wenn sie verschiedenen Stämmen angehörten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f555392a-656e-3472-a576-d93b9453e124",
                        "entry_id": "8cf71e20-f148-3ed7-9556-7ac684af2d8c",
                        "glosses": [
                            "männlicher Blutsverwandter der männlichen Linie"
                        ],
                        "tags": [
                            "Rechtswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "9ba4b856-75e0-4838-876f-9ca5456e1f57",
                                "sense_id": "f555392a-656e-3472-a576-d93b9453e124",
                                "text": "„Als nächster Agnat des Hauses Stade kam sein Vetter Udo IV., genannt von Freckleben, der am Rhein begütert war, als Erbe in Betracht.“"
                            },
                            {
                                "example_id": "a2f1676f-5145-4acb-be5d-65a75d290bd5",
                                "sense_id": "f555392a-656e-3472-a576-d93b9453e124",
                                "text": "Als 1793 der Raddatzer Stamm ausstarb, meldeten sich 26 Agnaten aus den anderen Stämmen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b56a48cb-a3a0-4201-bca6-1e497de84446",
                        "source_entry_id": "8cf71e20-f148-3ed7-9556-7ac684af2d8c",
                        "source_sense_id": "ce0d20bb-6f49-3038-b98e-182bb1bbc763",
                        "source_sense_description": "Recht, Römisches Reich: Blutsverwandter von väterlicher Seite",
                        "target_lang_word": "agnate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agnate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb73a20-3046-37ab-9385-629a20d087e8",
                                        "entry_id": "2811fad5-a069-3c49-be3f-81f765c58eee",
                                        "glosses": [
                                            "A relative whose relation is traced only through male members of the family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de87b28-115d-4b15-b16c-5f5590f50e35",
                                                "sense_id": "bfb73a20-3046-37ab-9385-629a20d087e8",
                                                "text": "A great-grandfather is an agnate if he is your father’s father’s father."
                                            },
                                            {
                                                "example_id": "9679703c-9ab3-4019-b29c-7f59eda11409",
                                                "sense_id": "bfb73a20-3046-37ab-9385-629a20d087e8",
                                                "text": "Men accuse agnates of their own generation of bewitching them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e53af79-30b3-3af4-8481-d68f176a31c0",
                                        "entry_id": "2811fad5-a069-3c49-be3f-81f765c58eee",
                                        "glosses": [
                                            "Any paternal male relative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c6dfb45-02a3-3111-b9a9-eb98872d2049",
                                        "entry_id": "2811fad5-a069-3c49-be3f-81f765c58eee",
                                        "glosses": [
                                            "A statement having a similar meaning to another, but a different structure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "agnate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72621670-e4fb-34e4-8b87-35e420c08575",
                                        "entry_id": "03bf254e-99a4-3817-b129-39c54fdbeec2",
                                        "glosses": [
                                            "Related to someone by male connections or on the paternal side of the family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6240d9c1-f9b8-3d45-93b1-f69dfbb5fc18",
                                        "entry_id": "03bf254e-99a4-3817-b129-39c54fdbeec2",
                                        "glosses": [
                                            "allied; akin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb8c0df-6c70-4e4f-af7c-08f6a4d281f0",
                                                "sense_id": "6240d9c1-f9b8-3d45-93b1-f69dfbb5fc18",
                                                "text": "Assume more or less of a fictitious character, but congenial and agnate […] with the former."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db72180f-cc77-3276-88c2-8f79544c768c",
                                        "entry_id": "03bf254e-99a4-3817-b129-39c54fdbeec2",
                                        "glosses": [
                                            "Having a similar semantic meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38117160-a030-4647-97a4-2d8dda7dc319",
                                                "sense_id": "db72180f-cc77-3276-88c2-8f79544c768c",
                                                "text": "[...] we can talk about a swim, a drink, a look, even though swim, drink and look can also show up as verbs in agnate clauses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69ab4549-790b-44b4-8813-5bc53b1563ee",
                        "source_entry_id": "8cf71e20-f148-3ed7-9556-7ac684af2d8c",
                        "source_sense_id": "ce0d20bb-6f49-3038-b98e-182bb1bbc763",
                        "source_sense_description": "Recht, Römisches Reich: Blutsverwandter von väterlicher Seite",
                        "target_lang_word": "agnat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agnat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca45f98b-c251-3271-9898-89893f3ccf3c",
                                        "entry_id": "e0fc7305-cd1f-3b4d-ac0c-8c965a564688",
                                        "glosses": [
                                            "Membre d’une même famille, par les hommes."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "155abafa-cdb5-4493-83f1-99f2fdb03fd0",
                                                "sense_id": "ca45f98b-c251-3271-9898-89893f3ccf3c",
                                                "text": "La famille se compose donc exclusivement des personnes ayant reçu du même ancêtre, de mâle à mâle, le même sang et le même culte. Ce sont les agnats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "983b36d0-6bf9-386b-a961-e07ca4968cbb",
                                        "entry_id": "e0fc7305-cd1f-3b4d-ac0c-8c965a564688",
                                        "glosses": [
                                            "Collatéral d’une même souche masculine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00558a58-e1c7-49a8-b7ec-817e64abd338",
                                                "sense_id": "983b36d0-6bf9-386b-a961-e07ca4968cbb",
                                                "text": "La loi de la division des terres demanda que les biens d’une famille ne passassent pas dans une autre ; de là il suivit qu’il n’y eut que deux ordres d’héritiers établis par la loi : les enfants et tous les descendants qui vivoient sous la puissance du père, qu’on appela héritiers-siens ; et, à leur défaut, les plus proches parents par mâles, qu’on appela agnats."
                                            },
                                            {
                                                "example_id": "ede1d4b3-cdda-4088-b50e-750ffe2ab305",
                                                "sense_id": "983b36d0-6bf9-386b-a961-e07ca4968cbb",
                                                "text": "Macoudé et Batouala étaient frères, de mêmes père et mère, et non pas simplement des agnats comme cela est fréquent, puisque tout homme peut, si ses moyens le lui permettent, acheter plusieurs femmes et, de chacune d’elles, avoir des enfants."
                                            },
                                            {
                                                "example_id": "d6c9d68e-966e-4f61-bf89-24e0a3de0421",
                                                "sense_id": "983b36d0-6bf9-386b-a961-e07ca4968cbb",
                                                "text": "Quant aux fils des sœurs de ma mère, ils sont les fils d’hommes qui ont pris femme dans le lignage de ma mère. Autrement dit la terminologie ne distingue pas les agnats de ceux qui prennent femme dans les mêmes lignages qu’eux."
                                            },
                                            {
                                                "example_id": "4448bf45-b734-434d-b828-ca11996a0c26",
                                                "sense_id": "983b36d0-6bf9-386b-a961-e07ca4968cbb",
                                                "text": "Ne faut-il pas être condamné par la cour d'assises pour faire de la littérature pareille et dire les mots usucapion, agnats, cognats, parlez-moi de cognac plutôt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
