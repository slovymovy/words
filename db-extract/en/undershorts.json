    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0d900285-ae6f-3d51-ad06-9d2230feac33",
                "word": "undershorts",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8db854b-0147-399c-9d13-09a3f6a51c1a",
                        "entry_id": "0d900285-ae6f-3d51-ad06-9d2230feac33",
                        "glosses": [
                            "Underpants, type of underwear worn in skin contact with the hip portion of the body, small enough to be worn invisibly under shorts. Typically refers to male, not female, underpants."
                        ],
                        "tags": [
                            "dated",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "21146131-3332-4483-aa54-c4443c0b6ae0",
                                "sense_id": "c8db854b-0147-399c-9d13-09a3f6a51c1a",
                                "text": "I have one clean pair of undershorts."
                            },
                            {
                                "example_id": "07e02497-2ddd-4e56-82ff-55f0be4fbf3e",
                                "sense_id": "c8db854b-0147-399c-9d13-09a3f6a51c1a",
                                "text": "I have to buy more undershorts."
                            },
                            {
                                "example_id": "dba6e3b7-ca44-4b4f-a758-7b31f2bbe8bc",
                                "sense_id": "c8db854b-0147-399c-9d13-09a3f6a51c1a",
                                "text": "It being very warm, I removed all of my clothing except my undershorts and lay down to sleep."
                            },
                            {
                                "example_id": "7977c17e-2064-4eea-85c9-24c44fcc11ca",
                                "sense_id": "c8db854b-0147-399c-9d13-09a3f6a51c1a",
                                "text": "[…] like a mouse [I] hop frantically about on my toes, trying to clear my feet of my undershorts before anybody can peek inside, where, to my chagrin, to my bafflement, to my mortification, I always discover in the bottommost seam a pale and wispy brushstroke of my shit."
                            },
                            {
                                "example_id": "a6ad706d-e5b6-4d50-8c02-6336cc4d093f",
                                "sense_id": "c8db854b-0147-399c-9d13-09a3f6a51c1a",
                                "text": "I have been debriefed—I believe that is the current expression, though I am always tempted, when I hear it, to make sure I still have my undershorts on—by the mandarins of the External Affairs Ministry."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1023ec41-1c65-4990-98f3-7a33db14236c",
                        "source_entry_id": "0d900285-ae6f-3d51-ad06-9d2230feac33",
