                    "sense_id": "45466a3e-d010-39d0-8889-1f4968bda5dd",
                    "sense_definition": "Qui est fendu, coupé ou mis en pièces par un déchirement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a jeté son vieux pantalon <w>déchiré</w> à la poubelle.",
                            "target_lang_translations": {
                                "en": "He threw his old <w>torn</w> trousers into the bin.",
                                "ru": "Он выбросил свои старые <w>рваные</w> брюки в мусорное ведро.",
                                "de": "Er hat seine alte, <w>zerrissene</w> Hose in den Mülleimer geworfen.",
                                "es": "Tiró a la basura sus viejos pantalones <w>rotos</w>.",
                                "zh": "他把那条又旧又<w>破</w>的裤子扔进了垃圾桶。"
                            }
                        },
                        {
                            "text": "Elle a retrouvé une lettre <w>déchirée</w> au fond du tiroir.",
