    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0108e082-a51a-356e-8f6d-e1b543149d04",
                    "sense_definition": "drückt eine Frage nach einem bestimmten Ort oder einer Stelle aus",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weißt du vielleicht, <w>wo</w> mein roter Pullover liegt?"
                        },
                        {
                            "text": "Können Sie mir sagen, <w>wo</w> der nächste Bahnhof ist?"
                        }
                    ]
                },
                {
                    "sense_id": "ed3cd6c6-853d-33e0-8bf9-19d1f7c58adc",
                    "sense_definition": "leitet einen Relativsatz ein, der sich auf einen genannten Ort bezieht",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das ist die Stadt, <w>wo</w> ich aufgewachsen bin."
                        },
                        {
                            "text": "Er arbeitet in einem Restaurant, <w>wo</w> viele Touristen gerne essen."
                        }
                    ]
                },
                {
                    "sense_id": "ca3f9e60-76ea-3448-831c-0a7b8e8429ed",
                    "sense_definition": "bezieht sich auf einen bestimmten Zeitpunkt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das war genau der Tag, <w>wo</w> es angefangen hat zu schneien."
                        },
                        {
                            "text": "In dem Moment, <w>wo</w> sie anrief, verließ er das Haus."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Umgangssprachlich statt als oder an dem"
                        }
                    ]
                },
                {
                    "sense_id": "9b1a0140-019b-315d-b96c-6fba45c7ac77",
                    "sense_definition": "an einem unbestimmten Ort; verkürzte Form von irgendwo",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat seine Jacke gestern Abend bestimmt <w>wo</w> liegen lassen."
                        },
                        {
                            "text": "Wir treffen uns bestimmt bald wieder <w>wo</w> auf einen Kaffee."
                        }
                    ],
                    "synonyms": [
                        "irgendwo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Umgangssprachlich verkürzt"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "c267d935-cd9c-3848-981a-c0f1bb34a9d0",
                    "sense_definition": "leitet einen temporalen Nebensatz ein; drückt Gleichzeitigkeit in der Vergangenheit aus",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wo</w> ich aus dem Fenster geschaut habe, stand ein fremdes Auto vor der Tür."
                        },
                        {
                            "text": "<w>Wo</w> er mich im Flur sah, fing er sofort laut an zu lachen."
                        }
                    ],
                    "synonyms": [
                        "als"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Umgangssprachlich für als"
                        }
                    ]
                },
                {
                    "sense_id": "c6dda5d0-125d-35fc-a772-13b0bda875aa",
                    "sense_definition": "leitet einen Konditionalsatz ein; unter der Bedingung, dass",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Mitarbeiter halfen den Gästen immer gern, <w>wo</w> es nur möglich war."
                        },
                        {
                            "text": "<w>Wo</w> keine Hoffnung mehr besteht, muss man die Realität tapfer akzeptieren."
                        }
                    ],
                    "synonyms": [
                        "wenn"
                    ],
                    "common_phrases": [
                        "wo möglich"
                    ]
                },
                {
                    "sense_id": "418f874a-dc10-302a-9773-66e2adeeecb1",
                    "sense_definition": "leitet einen Kausalsatz ein; angesichts des Umstands, dass",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warum willst du heute kochen, <w>wo</w> wir doch eine Einladung zum Essen haben?"
                        },
                        {
                            "text": "Wie kannst du jetzt schlafen gehen, <w>wo</w> noch so viel dringende Arbeit wartet?"
                        }
                    ],
                    "synonyms": [
                        "da"
                    ]
                },
                {
                    "sense_id": "26eb5adb-18ec-3b33-970a-1f070b07f000",
                    "sense_definition": "leitet einen Nebensatz mit konzessivem oder adversativem Charakter ein; drückt einen Gegensatz oder Einwand aus",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er beklagt sich ständig über Geldmangel, <w>wo</w> er doch ein sehr stattliches Gehalt verdient."
                        },
                        {
                            "text": "Warum zweifelst du an seinen Worten, <w>wo</w> er dir doch immer die Wahrheit gesagt hat?"
                        }
                    ],
                    "synonyms": [
                        "obwohl",
                        "während"
                    ]
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "4404f525-6bd2-3ec4-a4ba-14053374ddca",
                    "sense_definition": "leitet einen Relativsatz ein, der sich auf Personen oder Sachen bezieht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kennst du eigentlich den Mann, <w>wo</w> da drüben an der Straßenkreuzung steht?"
                        },
                        {
                            "text": "Das ist genau die nette Nachbarin, <w>wo</w> mir gestern beim Einkaufen geholfen hat."
