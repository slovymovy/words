                ],
                "senses": [
                    {
                        "sense_id": "806e71c3-0214-37e6-be89-aaeac693675e",
                        "entry_id": "30c47b71-49a8-3ba7-9e3a-f7107ee14dcd",
                        "glosses": [
                            "Anhängerin der faschistischen Ideologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a5c77dd-23ce-4c4c-86f9-45a588f945f5",
                                "sense_id": "806e71c3-0214-37e6-be89-aaeac693675e",
                                "text": "„Bei einem Konzert nahe Turin bezeichnete sie der Frontmann der britischen Alternative-Rockband Placebo unter anderem als Faschistin, Nazistin und Rassistin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e5fc597-92c1-43f6-98b8-440eb24896bf",
                        "source_entry_id": "30c47b71-49a8-3ba7-9e3a-f7107ee14dcd",
                        "source_sense_id": "806e71c3-0214-37e6-be89-aaeac693675e",
                        "source_sense_description": "Anhängerin der faschistischen Ideologie",
                        "target_lang_word": "fascist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d3d3f2c-35c1-3ab6-9fc3-d4514d8a761f",
                                        "entry_id": "11444b30-8671-3142-8cab-73f448b4ec3e",
                                        "glosses": [
                                            "Of or relating to fascism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "140be661-6825-399e-be3b-11ad28806332",
                                        "entry_id": "11444b30-8671-3142-8cab-73f448b4ec3e",
                                        "glosses": [
                                            "Supporting the principles of fascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22efba62-8b0d-46d7-878f-10b2d6cdb50b",
                                                "sense_id": "140be661-6825-399e-be3b-11ad28806332",
                                                "text": "Under demagogues such as Donald Trump in the U.S., Jair Bolsonaro in Brazil, Recep Erdoğan in Turkey, Narendra Modi in India and Viktor Orbán in Hungary, a moral abyss has emerged in which state violence, widespread repression and a surge of lawlessness against those considered disposable have become the hallmark of an updated fascist politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef3dc87-ddab-3a86-98f9-3192aedd218b",
                                        "entry_id": "11444b30-8671-3142-8cab-73f448b4ec3e",
                                        "glosses": [
                                            "Unfairly oppressive or needlessly strict."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13811397-b57a-40aa-a979-f575fcb0f62a",
                                                "sense_id": "cef3dc87-ddab-3a86-98f9-3192aedd218b",
                                                "text": "I have a fascist boss."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "287da3e2-87bc-36eb-99af-2886d53e47c2",
                                        "entry_id": "6588d514-0a2b-39bf-bdb3-17e616d38483",
                                        "glosses": [
                                            "A proponent of fascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf3fd365-c7d8-4f97-8e3e-2825d555693d",
                                                "sense_id": "287da3e2-87bc-36eb-99af-2886d53e47c2",
                                                "text": "[I]f I can shoot rabbits / Then I can shoot fascists."
                                            },
                                            {
                                                "example_id": "a09136e7-d398-414d-85eb-9813746ff130",
                                                "sense_id": "287da3e2-87bc-36eb-99af-2886d53e47c2",
                                                "text": "Mussolini was a fascist well known for his repression of criticism and totalitarian government."
                                            },
                                            {
                                                "example_id": "162a6db5-a93f-43bd-b3cc-5007c2861ce1",
                                                "sense_id": "287da3e2-87bc-36eb-99af-2886d53e47c2",
                                                "text": "Fascist? I'm not fascist. You're the fascist!"
                                            },
                                            {
                                                "example_id": "8449a0f1-fbfb-46e0-8dc6-7afaeb9b1e92",
                                                "sense_id": "287da3e2-87bc-36eb-99af-2886d53e47c2",
                                                "text": "Thursday's long-awaited relocation fulfils a key pledge of the socialist government, which said Spain should not continue to glorify a fascist who ruled the country for nearly four decades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "516ad927-a779-4079-9487-4c99cd43de4c",
                        "source_entry_id": "30c47b71-49a8-3ba7-9e3a-f7107ee14dcd",
                        "source_sense_id": "806e71c3-0214-37e6-be89-aaeac693675e",
                        "source_sense_description": "Anhängerin der faschistischen Ideologie",
                        "target_lang_word": "fasciste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fasciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc31813e-5adc-3b0b-925d-55da6e59ad23",
                                        "entry_id": "ca70e8cb-e274-3123-a4e5-66e2b6121df0",
                                        "glosses": [
                                            "Qui est propre au fascisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a43b242-9251-4494-9c99-50a3683b1242",
                                                "sense_id": "cc31813e-5adc-3b0b-925d-55da6e59ad23",
                                                "text": "Il y eut aussi la révolution fasciste, que le Baron de D. refusait d'appeler autrement que « cette mascarade funèbre… », ou bien : « la pitrerie que vous savez »."
                                            },
                                            {
                                                "example_id": "b6cdc6a6-7270-4be5-a73e-9812ca1b2ce3",
                                                "sense_id": "cc31813e-5adc-3b0b-925d-55da6e59ad23",
                                                "text": "Leur sympathie pour le corporatisme, tel qu'avait tenté de l'établir le gouvernement Pétain sur le modèle de l’Italie fasciste et du Reich hitlérien, et qui, soumettant le travailleur au règne unique des traditions et des coutumes, c'est à dire de l’habitude, tend à ruiner en lui tout exercice de la liberté et de la raison."
                                            },
                                            {
                                                "example_id": "b49cc2e4-fef7-4997-9477-fd0878957ee0",
                                                "sense_id": "cc31813e-5adc-3b0b-925d-55da6e59ad23",
                                                "text": "Les groupements fascistes ne peuvent pas arriver au pouvoir sans l'aide multiforme des classes dirigeantes, et plus particulièrement des industriels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c341c173-3fd4-35c1-80ce-a4f649b8bbcf",
                                        "entry_id": "ca70e8cb-e274-3123-a4e5-66e2b6121df0",
                                        "glosses": [
                                            "Qui utilise les méthodes du fascisme, totalitaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ce4c6a-066c-4120-b170-9c6f707eab19",
                                                "sense_id": "c341c173-3fd4-35c1-80ce-a4f649b8bbcf",
                                                "text": "À l’Assemblée nationale, Jacqueline Chonavel (…) a rappelé que les communistes avaient déjà déposé une proposition de loi « tendant à la protection contre le racisme et à la dissolution des organisations fascistes. » ("
                                            },
                                            {
                                                "example_id": "6bb5ff00-1bdb-4387-98d6-12297890a11a",
                                                "sense_id": "c341c173-3fd4-35c1-80ce-a4f649b8bbcf",
                                                "text": "Repaire de fanatiques fascistes dont le seul mot d'ordre est de tuer tous ceux qui ne sont pas de leur avis, voire de ceux qui se foutent de leur gueule et d'asservir les autres... — (Jean Pierre Bonnavion, Métaphysique de mes deux, Société des Écrivains, 2012, page 330)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ebc297f-e42f-30c7-af4a-201872814dad",
                                        "entry_id": "ca70e8cb-e274-3123-a4e5-66e2b6121df0",
                                        "glosses": [
                                            "Qualificatif polémique attribué à toute personne, à tout groupe de personnes, ou à leurs théories, par leurs adversaires afin de les diaboliser, de les discréditer."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca95463-5619-48e1-8609-e5d361013f17",
                                                "sense_id": "8ebc297f-e42f-30c7-af4a-201872814dad",
                                                "text": "Aujourd’hui une bonne partie de la jeunesse réprouve, comme fasciste, toute manifestation d’autorité, qu’elle émane du père, du professeur ou du patron."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fasciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0aa47b7-73dc-35ea-ad59-9f0d24230b8a",
                                        "entry_id": "8c760f68-4557-37d2-b735-19eaa8f89dc8",
                                        "glosses": [
                                            "Membre du mouvement et du régime fasciste italien de 1922 à 1945."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b49c7762-63ca-39c3-8541-72f647cbbb05",
                                        "entry_id": "8c760f68-4557-37d2-b735-19eaa8f89dc8",
                                        "glosses": [
                                            "Tout partisan du fascisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "762cd3dc-56cb-4d14-ba66-11e321a0a430",
                                                "sense_id": "b49c7762-63ca-39c3-8541-72f647cbbb05",
                                                "text": "[…], et, petit à petit, sans bien sûr interrompre leur feu qui cependant faiblissait, les fascistes ont pris la poudre d’escampette, et les derniers assez vite pour que l'envie de courir après ne nous prît pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861452a2-3b68-3368-8454-c0300a97c7db",
                                        "entry_id": "8c760f68-4557-37d2-b735-19eaa8f89dc8",
                                        "glosses": [
                                            "Personne perçue comme autoritaire ou extrême dans sa démarche, souvent qualifiée ainsi par un adversaire idéologique afin de la diaboliser, de la discréditer, quand bien même son engagement n’aurait aucun rapport avec le fascisme."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f86da9b-df97-4d9f-a31e-b10b8ef6d1bd",
                                                "sense_id": "861452a2-3b68-3368-8454-c0300a97c7db",
                                                "text": "Les communistes disent toujours de leurs ennemis qu'ils sont des fascistes."
                                            },
                                            {
                                                "example_id": "c7134342-c43c-4e3b-903d-762312606c1f",
                                                "sense_id": "861452a2-3b68-3368-8454-c0300a97c7db",
                                                "text": "De Gaulle fonde le Rassemblement du peuple français ? C’est un fasciste. Certains prétendent que l’URSS abrite des camps de concentration ? Ce sont des fascistes. Le terme « fascisme » ne correspond plus à un contenu objectif. Il n’est plus qu’une insulte, une arme pour disqualifier l’adversaire."
                                            },
                                            {
                                                "example_id": "018df1ec-1ce7-4533-a3f3-550672939749",
                                                "sense_id": "861452a2-3b68-3368-8454-c0300a97c7db",
                                                "text": "Pourquoi brandir le fantôme de Hitler, sinon pour comparer (même pas subtilement) les gens qui appuient la loi 21 aux pires fascistes ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
