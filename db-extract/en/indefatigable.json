                        "source_sense_id": "61b56277-9009-3c3d-bdb3-1480b85f2710",
                        "source_sense_description": "extremely persistent and untiring",
                        "target_lang_word": "onvermoeibaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onvermoeibaar",
