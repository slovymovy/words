{
    "word_family": [
        "limboing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2e5e452-a156-3f02-9ced-eca4dcf8695e",
                    "sense_definition": "An uncertain state of delay, neglect, or unresolved status.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My passport application has been stuck in bureaucratic <w>limbo</w> for two weeks.",
                            "target_lang_translations": {
                                "zh": "我的护照申请在官僚机构的<w>搁置状态</w>中卡了整整两周。"
                            }
                        },
                        {
                            "text": "The project is in <w>limbo</w> until we receive more funding from the board.",
                            "target_lang_translations": {
                                "zh": "在我们从董事会获得更多资金之前，该项目一直处于<w>悬而未决的状态</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in limbo"
                    ],
                    "target_lang_definitions": {
                        "zh": "不确定、搁置或悬而未决的状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "悬而未决的状态",
                                "target_lang_sense_clarification": "指事情暂停推进或未有定论的处境"
                            },
                            {
                                "target_lang_word": "搁置状态",
                                "target_lang_sense_clarification": "指事务停滞不前的状态"
                            },
                            {
                                "target_lang_word": "未定状态",
                                "target_lang_sense_clarification": "指尚未明确结果的情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf290a9e-7429-356e-a0d0-de43200d0905",
                    "sense_definition": "A jail or prison.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "prison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief was sent to <w>limbo</w> to await his trial at the next court session.",
                            "target_lang_translations": {
                                "zh": "小偷被关进了<w>监狱</w>，等待下一次开庭审判。"
                            }
                        },
                        {
                            "text": "He spent the night in <w>limbo</w> after being arrested for causing a disturbance.",
                            "target_lang_translations": {
                                "zh": "因扰乱治安被捕后，他在<w>牢房</w>里度过了一夜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to refer to a prison."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "监狱或拘留所（古旧用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "监狱",
                                "target_lang_sense_clarification": "关押犯人的场所"
                            },
                            {
                                "target_lang_word": "牢房",
                                "target_lang_sense_clarification": "监禁场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f813ae8a-467a-3fb1-a06d-7b9c487e5369",
                    "sense_definition": "In theology, a place for souls who are not in heaven but are not suffering in hell.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medieval theologians debated whether unbaptized infants were sent to <w>limbo</w>.",
                            "target_lang_translations": {
                                "zh": "中世纪的神学家曾激烈辩论未受洗礼的婴儿是否会被送往<w>灵薄狱</w>。"
                            }
                        },
                        {
                            "text": "The concept of <w>limbo</w> was once a significant part of Catholic teaching.",
                            "target_lang_translations": {
                                "zh": "<w>灵薄狱</w>的概念曾是天主教教义中不可忽视的一部分。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（天主教神学中的）林波，灵薄狱（指未受洗礼者等无罪但未进天堂的灵魂暂居或安息之所）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灵薄狱",
                                "target_lang_sense_clarification": "天主教神学概念，边缘之地"
                            },
                            {
                                "target_lang_word": "林波",
                                "target_lang_sense_clarification": "神学术语音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d34280-bc93-330c-934a-8b7566d4daff",
                    "sense_definition": "The state of being held as security for a loan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to pay a large sum to redeem his watch from <w>limbo</w>.",
                            "target_lang_translations": {
                                "zh": "他不得不支付一大笔钱才把手表从<w>当铺</w>赎回来。"
                            }
                        },
                        {
                            "text": "The valuable painting was kept in <w>limbo</w> until the debt was fully repaid.",
                            "target_lang_translations": {
                                "zh": "在债务全额还清之前，这幅珍贵的画作一直处于<w>抵押状态</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pawn"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the state of being pawned."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "抵押或典当状态（古旧用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "当铺",
                                "target_lang_sense_clarification": "典当押物之处"
                            },
                            {
                                "target_lang_word": "抵押状态",
                                "target_lang_sense_clarification": "作为贷款担保被扣留"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8e2787b-e61e-3c57-835e-68c175137cf3",
                    "sense_definition": "A dance where people bend backward to pass under a low horizontal bar.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone at the party had fun trying to do the <w>limbo</w>.",
                            "target_lang_translations": {
                                "zh": "派对上的每个人都兴致勃勃地尝试跳<w>林波舞</w>。"
                            }
                        },
                        {
                            "text": "She won the contest by performing the <w>limbo</w> under a very low stick.",
                            "target_lang_translations": {
                                "zh": "她凭借从一根极低的横杆下跳过<w>林波舞</w>赢得了比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do the limbo"
                    ],
                    "target_lang_definitions": {
                        "zh": "林波舞（一种身体后仰通过低横杆的西印度群岛传统舞蹈）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "林波舞",
                                "target_lang_sense_clarification": "仰身过竿的舞蹈"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ac68b79-5be2-340f-b5ad-6d15d2281245",
                    "sense_definition": "To perform the limbo dance.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children started <w>limboing</w> as soon as the music began to play.",
                            "target_lang_translations": {
                                "zh": "音乐一响起，孩子们就开心地<w>跳起林波舞</w>来。"
                            }
                        },
                        {
                            "text": "We <w>limboed</w> under the bar until only one person remained.",
                            "target_lang_translations": {
                                "zh": "我们依次<w>跳林波舞</w>过竿，直到最后只剩下一人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "跳林波舞"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跳林波舞",
                                "target_lang_sense_clarification": "进行林波舞表演或娱乐"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9072221-b811-354d-868c-6942002d8e26",
                    "sense_definition": "To pass under an obstacle while bending the body.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>limboed</w> under the fence to reach the garden.",
                            "target_lang_translations": {
                                "zh": "那只狗从篱笆下<w>钻过</w>，跑进了花园。"
                            }
                        },
                        {
                            "text": "He <w>limboed</w> under the low barrier to enter the restricted area.",
                            "target_lang_translations": {
                                "zh": "他从低矮的路障下<w>躬身钻过</w>，进入了禁区。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "limbo under"
                    ],
                    "target_lang_definitions": {
                        "zh": "弯曲身体从障碍物下方穿过"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钻过",
                                "target_lang_sense_clarification": "从低矮处弯身穿过"
                            },
                            {
                                "target_lang_word": "躬身钻过",
                                "target_lang_sense_clarification": "俯身或仰身通过狭窄缝隙"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}