                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аномалия",
                                "target_lang_sense_clarification": "неправильно сформированная структура"
                            },
                            {
                                "target_lang_word": "уродство",
                                "target_lang_sense_clarification": "физический или структурный дефект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
