                "senses": [
                    {
                        "sense_id": "e91872b9-6fd3-3b1a-81c3-2cd477d00461",
                        "entry_id": "66a020b1-ed69-3558-bd0f-d5305742eadf",
                        "glosses": [
                            "aus Afrika und Eurasien bestehender Superkontinent, der die größte zusammenhängende Landmasse der Erde darstellt, wobei der trennende Suezkanal unberücksichtigt bleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93ddcf9-760a-447e-903d-df0a89f1de5a",
                                "sense_id": "e91872b9-6fd3-3b1a-81c3-2cd477d00461",
                                "text": "Mehr als 80% der Weltbevölkerung leben in Afrika-Eurasien."
                            },
                            {
                                "example_id": "6b189e56-d931-4c63-bf01-8a1b8137d011",
                                "sense_id": "e91872b9-6fd3-3b1a-81c3-2cd477d00461",
                                "text": "„Mit einer Fläche von etwa 85 Millionen km² bedeckt Afrika-Eurasien ein Sechstel der Oberfläche unseres Planeten und umfasst deutlich über die Hälfte allen Festlandes der Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
