                        "entry_id": "fe23faf1-e885-3928-8fb1-45195afc620d",
                        "glosses": [
                            "Genre de passereaux, comprenant 3 espèces endémiques d’Australie, à longue queue, sédentaires et de mœurs terrestres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99165c8-97e2-445f-b642-6968d8a6c99b",
                                "sense_id": "55526d76-dc11-3e2c-b705-f9ae3634d87c",
                                "text": "Les dasyornes sont les seuls membres de la famille des dasyornithidés."
                            },
                            {
                                "example_id": "63c8f86d-3ba6-4351-9106-fb50a41252b6",
                                "sense_id": "55526d76-dc11-3e2c-b705-f9ae3634d87c",
                                "text": "Les Dasyornes roux se déplacent en marchant et en sautillant lentement à travers la végétation basse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a1ef656-4dfe-45f5-b70f-c8cfeed62c58",
