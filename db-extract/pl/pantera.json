                        ],
                        "form": "pantery"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c4e2707-2050-3637-9e97-8d6bf1fed723",
                        "entry_id": "ba958fd0-4819-3bc5-ae82-0189541576e8",
                        "glosses": [
                            "lampart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7e2e75-0705-4417-b951-ed14a0805069",
                                "sense_id": "8c4e2707-2050-3637-9e97-8d6bf1fed723",
                                "text": "Na brzegach tych wąwozów widywali wielkie małpy, a niekiedy lwy i pantery, które gnieździły się w jaskiniach skalnych"
                            },
                            {
                                "example_id": "703c6e75-d08d-4add-8847-36ea23064c02",
                                "sense_id": "8c4e2707-2050-3637-9e97-8d6bf1fed723",
                                "text": "Byłżeby to jaguar lub ocelot, zwierzęta dzikie i okrutne jak lampart albo pantera?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "77ec05db-b13a-3482-a314-3b761017ffbe",
                        "entry_id": "ba958fd0-4819-3bc5-ae82-0189541576e8",
                        "glosses": [
                            "czołg niemiecki"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "09af464e-19b7-4d73-bc3e-e1525c6900a8",
                                "sense_id": "77ec05db-b13a-3482-a314-3b761017ffbe",
                                "text": "Pantera naśladowała to proste i bardzo skuteczne rozwiązanie, lecz jej pancerz był grubszy, a działo potężniejsze."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2745c04-0799-441c-a02e-16b0ff32e17c",
                        "source_entry_id": "ba958fd0-4819-3bc5-ae82-0189541576e8",
                        "source_sense_id": "8c4e2707-2050-3637-9e97-8d6bf1fed723",
                        "target_lang_word": "Panther",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panther",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e312e0c2-50a1-38e6-ba8e-9dc451d10d8f",
                                        "entry_id": "d2925e97-e579-39f7-86bb-699cdf2bb5c7",
                                        "glosses": [
                                            "(vor allem ein melanistisches Exemplar des) Leopard"
                                        ],
                                        "tags": [
                                            "Panthera pardus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddd86b3c-309b-4c68-952a-55e8ef65d1ba",
                                                "sense_id": "e312e0c2-50a1-38e6-ba8e-9dc451d10d8f",
                                                "text": "Das Gehege des schwarzen Panthers war stets umlagert."
                                            },
                                            {
                                                "example_id": "5bfaa128-1f87-49fe-b89f-f14ed9b5ad70",
                                                "sense_id": "e312e0c2-50a1-38e6-ba8e-9dc451d10d8f",
                                                "text": "„Schwarze Panther wirken daher besonders gefährlich, während die Löwen und Tiger oft zu verschlafen wirken, um gefährlich zu erscheinen.“"
                                            },
                                            {
                                                "example_id": "7a796c60-f98d-4916-9946-360e5fc51057",
                                                "sense_id": "e312e0c2-50a1-38e6-ba8e-9dc451d10d8f",
                                                "text": "„Ein Panther hatte erst vor wenigen Tagen eines seiner Füllen und die nächste Nacht ein großes, ausgewachsenes Arbeitspferd zerrissen, dem er von einem Baume aus auf den Hals gesprungen war; diesen unschädlich zu machen, war jedenfalls das Wichtigste, was sie vornehmen konnten.“"
                                            },
                                            {
                                                "example_id": "e4939e3e-0a54-4a07-9caf-9da3bf20908d",
                                                "sense_id": "e312e0c2-50a1-38e6-ba8e-9dc451d10d8f",
                                                "text": "Panther gibt es sowohl in der alten als auch in der neuen Welt. Es handelt sich aber um Schwärzlinge verschiedener Arten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "324ab44f-b3b4-30f0-83f6-3c7f7048f823",
                                        "entry_id": "d2925e97-e579-39f7-86bb-699cdf2bb5c7",
                                        "glosses": [
                                            "melanistisches Exemplar des Jaguars"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "becfac51-627a-4ee7-bf38-f1af7cf69abe",
                                                "sense_id": "324ab44f-b3b4-30f0-83f6-3c7f7048f823",
                                                "text": "Panther gibt es sowohl in der alten als auch in der neuen Welt. Es handelt sich aber um Schwärzlinge verschiedener Arten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d610b658-aa27-3748-b57a-d265b2b0e395",
                                        "entry_id": "d2925e97-e579-39f7-86bb-699cdf2bb5c7",
                                        "glosses": [
                                            "gemeine Figur, drachenähnliches Wesen mit Löwenbeinen"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4da20017-cd72-48c2-b568-f5210df38f39",
                                                "sense_id": "d610b658-aa27-3748-b57a-d265b2b0e395",
                                                "text": "Im Wappen des Freistaates Bayern findet sich unter anderem ein Panther."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
