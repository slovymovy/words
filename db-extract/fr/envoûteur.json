                "senses": [
                    {
                        "sense_id": "39ea23e6-baff-37e1-8f66-d7e96c5668e8",
                        "entry_id": "df0eac4c-8bea-3fb6-b4e8-71085b7a029f",
                        "glosses": [
                            "Personne qui envoûte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d2d2b6-c611-42ca-b739-012b262984a5",
                                "sense_id": "39ea23e6-baff-37e1-8f66-d7e96c5668e8",
                                "text": "D’ici furent dirigés ces inquisiteurs qui allèrent brûler Vaudois, cathares, fraticelles, béguins, sorciers, envoûteurs, magiciens, flagellants, ou juifs convertis, mais soupçonnés de sortilèges."
                            },
                            {
                                "example_id": "5aac5c47-6f9b-4721-8a07-ee16b4ba1c8f",
                                "sense_id": "39ea23e6-baff-37e1-8f66-d7e96c5668e8",
                                "text": "C’est un jeu d’enfant, en cours de route, de se substituer aux substituteurs, d’imiter les imitateurs, de plagier les plagieurs, de renévroser les névroses, de psychotiser les psychoses, et surtout, surtout, de déféticher les féticheurs, de réensorceler les sorcières et les envoûteurs inconscients, bien sûr, peu importe."
                            }
                        ]
                    }
                ],
