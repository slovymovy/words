                            "plural"
                        ],
                        "form": "formalisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc2823cb-61da-31b4-8a75-8dc32f5443e4",
                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "glosses": [
                            "Strict adherence to a given form of conduct, practice etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e1d5c44c-59a6-356d-86c3-708508e66254",
                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "glosses": [
                            "One of several alternative computational paradigms for a given theory."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "49457ef9-f9a4-3474-bfe1-25bb486f5e34",
                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "glosses": [
                            "An approach to interpretation and/or evaluation focused on the (usually linguistic) structure of a literary work rather than on the contexts of its origin or reception."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4b254f85-25e2-32d1-9a79-d36d726668ab",
                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "glosses": [
                            "The tendency to elevate formal above expressive value in music, as in serialism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "75d8b347-aad3-3e6f-b098-0d6d23b24c88",
                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "glosses": [
                            "A particular mathematical or scientific theory or description of a given state or effect."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dd6be155-deb9-42f1-9155-82e526a3184e",
                                "sense_id": "75d8b347-aad3-3e6f-b098-0d6d23b24c88",
                                "text": "Heisenberg seems to have been motivated by his intense annoyance that Schrödinger's more intuitive version of quantum theory was more widely accepted than his own, even though both formalisms led to the same results."
                            }
                        ]
                    },
                    {
                        "sense_id": "feeba37b-c36c-38d2-8a77-8a35fb737b99",
                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "glosses": [
                            "A formal expression of a grammar; a formal grammar; a set of rules of syntax that, without reference to semantics, determine whether a sequence of symbols is a well-formed sentence in a given formal language."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "751b8dd1-5ef2-457c-8bb5-392890917671",
                                "sense_id": "feeba37b-c36c-38d2-8a77-8a35fb737b99",
                                "text": "Dirac approaches quantum mechanics by means of a so-called symbolic method, the bracket formalism. Although this formalism has a mathematical flavour, in fact, it is based upon bold claims which lack mathematical foundation."
                            },
                            {
                                "example_id": "6ddd3b93-3e5a-485f-abd1-3020e77d7345",
                                "sense_id": "feeba37b-c36c-38d2-8a77-8a35fb737b99",
                                "text": "1992, tuart M. Shieber, Constraint-based Grammar Formalisms, The MIT Press, page 51,\nIt is this abstraction that justifies considering these methods as characterizing constraint-based formalisms in general, rather than an individual formalism."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aa0ebf6-c9ea-392c-8ce2-edf70589ff39",
                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "glosses": [
                            "The ontological view of mathematics as a mere collection of string manipulation rules."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9fd4eb7-c5dc-4dee-8910-a9b1cd361c0f",
                        "source_entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "source_sense_description": "strict adherence to a given form of conduct, practice, etc.",
                        "target_lang_word": "formalismus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c36ce6ba-c7c6-4085-b66c-ff9dfe84272f",
                        "source_entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                        "source_sense_description": "strict adherence to a given form of conduct, practice, etc.",
                        "target_lang_word": "formalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58d1e063-e559-34f1-8ace-bc67c8ffb592",
                                        "entry_id": "fce65aaf-2317-317b-8509-98a38f371ae8",
                                        "glosses": [
                                            "Attachement excessif aux formes, aux formalités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8c1069-3016-4cd4-bb40-cc3c090a4baf",
                                                "sense_id": "58d1e063-e559-34f1-8ace-bc67c8ffb592",
                                                "text": "Ce n’est pas entièrement sa faute, si son système a dégénéré en un pur formalisme."
                                            },
                                            {
                                                "example_id": "6a7bf9b2-36d1-4a46-9a31-0b6ae8f5738c",
                                                "sense_id": "58d1e063-e559-34f1-8ace-bc67c8ffb592",
                                                "text": "Le Christianisme romain tend alors à n’être qu’un formalisme rituel, pour lequel l’idéal du fidèle devient le bon paroissien qui pratique et qui croit sans discussion."
                                            },
                                            {
                                                "example_id": "9f687dd0-cfa3-4ef1-9928-cbb036effdc1",
                                                "sense_id": "58d1e063-e559-34f1-8ace-bc67c8ffb592",
                                                "text": "Quand nous arrivâmes en U.R.S.S., l’opinion était mal ressuyée de la grande querelle du Formalisme. Je cherchai à comprendre ce que l’on entendait par ce mot et voici ce qu’il me sembla : tombait sous l’accusation de formalisme, tout artiste coupable d’accorder moins d’intérêt au fond qu’à la forme. Ajoutons aussitôt que n’est jugé digne d’intérêt (ou plus exactement n’est toléré) le fond que lorsque incliné dans un certain sens."
                                            },
                                            {
                                                "example_id": "04edd844-f9c7-4423-8eea-383cebd42581",
                                                "sense_id": "58d1e063-e559-34f1-8ace-bc67c8ffb592",
                                                "text": "Dans cette structure bureaucratique, voire bureaupathologique (Thompson, 1969), la domination de la rationalité légale fait primer le formalisme juridique sur le contenu des productions ou services, autrement dit, systématiquement la forme sur le fond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9087894a-b49a-368b-a2ab-469ecf5c3726",
                                        "entry_id": "fce65aaf-2317-317b-8509-98a38f371ae8",
                                        "glosses": [
                                            "Présentation systématique d’un ensemble de propositions et de raisonnements, dans une langue de symboles abstraits qui vise à mettre en évidence les relations structurelles permanentes entre les éléments du système, à l’exclusion de toute référence à des contenus intuitifs ou sensibles déterminés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5499dc0f-c5e1-4904-978d-19d8dad438b9",
                                                "sense_id": "9087894a-b49a-368b-a2ab-469ecf5c3726",
                                                "text": "Le formalisme algorithmique (la syntaxe du langage algorithmique ou pseudo-code) reprend celui couramment utilisé dans les écoles d’informatique et dans les formations comme les BTS, DUT, premières années d’ingénierie, à qui ce livre est en partie destiné et conseillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88134b77-6026-3c44-a4ec-23d88cc726bd",
                                        "entry_id": "fce65aaf-2317-317b-8509-98a38f371ae8",
                                        "glosses": [
                                            "Doctrine antidémocratique réactionnaire qui cherche à instaurer un État fort autoritaire monarchique jugé plus efficace que la démocratie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b4aaef-2209-4561-a5af-0ed0701a6449",
                                                "sense_id": "88134b77-6026-3c44-a4ec-23d88cc726bd",
                                                "text": "[Mencius Moldbug nomme cette idéologie] formalisme dans sa première publication, avant d’arriver au terme de néoréaction, parfois nommé \"Lumières Obscures\", Dark Enlightenment, en référence au Siècle des Lumières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
