                        "cross_references": [
                            {
                                "target_word": "martyriser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de71d78b-24c1-36e1-8ce8-0daf921739c4",
                                        "entry_id": "c495ceb2-6854-3381-896f-1b673a88af0c",
                                        "glosses": [
                                            "Faire souffrir le martyre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01bbf60-753f-4b26-a0da-072ec0ad72a6",
                                                "sense_id": "de71d78b-24c1-36e1-8ce8-0daf921739c4",
                                                "text": "Je vous disais donc que la Chouette me martyrisait pour me faire pleurer, […]"
                                            },
                                            {
                                                "example_id": "7efac607-14cd-441b-a55c-6e81d89620dd",
                                                "sense_id": "de71d78b-24c1-36e1-8ce8-0daf921739c4",
                                                "text": "Un homme blanc, âgé de dix-sept ans à peine, attaché à un poteau, servait de but aux couteaux des Peaux-Rouges, qui se divertissaient à le martyriser avant de le sacrifier à leur rage sanguinaire."
                                            },
                                            {
                                                "example_id": "f4daa808-737f-466a-83aa-e476358aa90f",
                                                "sense_id": "de71d78b-24c1-36e1-8ce8-0daf921739c4",
                                                "text": "À chaque fois qu’un tel incident survenait, elle était corrigée. Bien que son père la martyrisa, elle lui annonçait où la pêche serait bonne, où un typhon apparaîtrait. Au début, son père ne croyait pas à ses prédictions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4be4734-71d6-34ca-825b-e91960e91c75",
                                        "entry_id": "c495ceb2-6854-3381-896f-1b673a88af0c",
                                        "glosses": [
                                            "Faire souffrir de grandes douleurs, de grands tourments."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33cbc664-7d40-4f38-a6b3-a1e9f40de404",
                                                "sense_id": "d4be4734-71d6-34ca-825b-e91960e91c75",
                                                "text": "Ses rhumatismes le martyrisent. — Martyriser un enfant. — Martyriser les animaux."
                                            },
                                            {
                                                "example_id": "bf67c44a-1582-448f-9153-8e03f39fb804",
                                                "sense_id": "d4be4734-71d6-34ca-825b-e91960e91c75",
                                                "text": "Mon Dieu ! je vous aime, je vous aime… Pourquoi prenez-vous plaisir à me martyriser ainsi ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86057167-47fc-4df9-90c4-c3fd0e44d29f",
                        "source_entry_id": "489f1514-51ec-3b4b-a8dc-8c82e975dbc5",
                        "source_sense_id": "388efe18-605c-390f-a0aa-ae5e9aa73d08",
                        "target_lang_word": "maltraiter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maltraiter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70c99099-35cb-3b05-8b88-5a3f480b6204",
                                        "entry_id": "11e233b1-e8d6-34c4-a14f-48437760dbc0",
                                        "glosses": [
                                            "Traiter durement en actions ou en paroles, malmener, frapper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f4528b-b288-4e75-a30b-3702d3fd97b3",
                                                "sense_id": "70c99099-35cb-3b05-8b88-5a3f480b6204",
                                                "text": "Ce mari maltraite sa femme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8246b61a-7ff3-3506-a1c2-ef3df9d93370",
                                        "entry_id": "11e233b1-e8d6-34c4-a14f-48437760dbc0",
                                        "glosses": [
                                            "Traiter quelqu’un d’une façon défavorable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd57ece-b1bf-4a59-89ec-8473227b23f7",
                                                "sense_id": "8246b61a-7ff3-3506-a1c2-ef3df9d93370",
                                                "text": "Cet arrêt a fort maltraité la partie plaignante."
                                            },
                                            {
                                                "example_id": "ecb12644-f704-46b1-84f7-532aaf05c1c8",
                                                "sense_id": "8246b61a-7ff3-3506-a1c2-ef3df9d93370",
                                                "text": "Cet auteur a été très maltraité par la critique."
                                            },
                                            {
                                                "example_id": "082ff6ad-b03a-49a3-b0ba-07e640911e7b",
                                                "sense_id": "8246b61a-7ff3-3506-a1c2-ef3df9d93370",
                                                "text": "Pourquoi Nakamura ne peut donc pas, selon certains, « représenter la France » aux JO ? Maltraiterait-elle à ce point la langue française ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
