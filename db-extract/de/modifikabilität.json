                "senses": [
                    {
                        "sense_id": "6f9dd134-678c-335a-ae9b-0f20ca4b6d40",
                        "entry_id": "c98e05b1-3c73-348a-b79b-9010a57d8eaf",
                        "glosses": [
                            "Eigenschaft/Vermögen, sich zu verändern, anzupassen (zu modifizieren)"
                        ],
                        "tags": [
                            "Geisteswissenschaften"
                        ],
                        "examples": [
                            {
                                "example_id": "e99fd4bf-9c60-420c-bc0b-c5bb65c31514",
                                "sense_id": "6f9dd134-678c-335a-ae9b-0f20ca4b6d40",
                                "text": "„Die klassische Unterscheidung von angeborenem und erworbenem Verhalten hebt Holzkamp-Osterkamp durch die Begriffe der Festgelegtheit und Modifikabilität auf. Einer phylogenetischen Festgelegtheit von Verhalten, etwa in Form der Erbkoordination steht die ontogenetische Modifikabilität des tierischen Verhaltens gegenüber.“"
                            },
                            {
                                "example_id": "f4b5b12e-14e3-42f8-81c3-2de7b1af8852",
                                "sense_id": "6f9dd134-678c-335a-ae9b-0f20ca4b6d40",
                                "text": "„Die Erscheinung, daß Individuen mit gleichem Genotypus verschiedene Phänotypen verwirklichen können, bezeichnet man als Modifikabilität.“"
                            },
                            {
                                "example_id": "cea7d181-e87d-4c8a-976e-d89fd331dd00",
                                "sense_id": "6f9dd134-678c-335a-ae9b-0f20ca4b6d40",
                                "text": "„Zuerst besitzt sie ein Vermögen, sich modifizieren zu lassen, Empfänglichkeit, Rezeptivität oder Modifikabilität; dann ein Vermögen, solche in ihr gewirkte Veränderungen zu fühlen. Beides zusammen macht das Gefühl aus.“"
                            },
                            {
                                "example_id": "ee203b96-f32a-4ff9-b1e4-c09da7e964e6",
                                "sense_id": "6f9dd134-678c-335a-ae9b-0f20ca4b6d40",
                                "text": "„Eine weitere Entwicklung in Richtung auf höhere Modifikabilität liegt vor, wenn auch dieses Systemprogramm nicht fest verdrahtet, sondern frei programmierbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
