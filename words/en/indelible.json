{
    "word_family": [
        "indelibility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c674729-293c-3e40-82d2-95aedf8a3e06",
                    "sense_definition": "Impossible to remove, wash away, or erase.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "permanence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ink from this marker is <w>indelible</w> and will not come off."
                        },
                        {
                            "text": "She used an <w>indelible</w> pen to sign the important legal document."
                        }
                    ],
                    "synonyms": [
                        "unerasable"
                    ],
                    "antonyms": [
                        "delible"
                    ],
                    "common_phrases": [
                        "indelible ink"
                    ]
                },
                {
                    "sense_id": "07680e25-f386-363b-a6a6-b09b78d91b37",
                    "sense_definition": "Impossible to forget or lose from one's memory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "permanence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic event left an <w>indelible</w> mark on her memory."
                        },
                        {
                            "text": "His kindness made an <w>indelible</w> impression on everyone he met."
                        }
                    ],
                    "synonyms": [
                        "unforgettable"
                    ],
                    "common_phrases": [
                        "indelible impression"
                    ]
                },
                {
                    "sense_id": "dbb1f998-c5cc-3494-a1b8-41244b72ef56",
                    "sense_definition": "Impossible to cancel or annul.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "permanence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest received an <w>indelible</w> character through the sacrament."
                        },
                        {
                            "text": "Some ancient laws are considered <w>indelible</w> by the traditionalists."
                        }
                    ]
                }
            ]
        }
    ]
