                "senses": [
                    {
                        "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                        "entry_id": "09bc90cb-9362-3aee-b40b-9ba339aa632e",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c02a68df-b90f-4dc7-aa98-86351a929390",
                                "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                                "text": "Frau Schmalzhaf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1ce5db76-be40-4801-8f04-b0f7dc226cdc",
                                "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                                "text": "Herr Schmalzhaf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b5590b17-64cd-4e4b-b83e-eead6e56b54d",
                                "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                                "text": "Die Schmalzhafs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8614e1af-5f56-48dc-9e13-9d0406070d69",
                                "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                                "text": "Der Schmalzhaf trägt nie die Schals, die die Eisele ihm strickt."
                            },
                            {
                                "example_id": "63518124-cc33-49bc-9f31-2de55ee5d294",
                                "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eisele kommt, geht der Herr Eisele.“"
                            },
                            {
                                "example_id": "2592a8f2-843a-4bd5-b1e4-87b5d10b7b63",
                                "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                                "text": "Schmalzhaf kommt und geht."
                            },
                            {
                                "example_id": "967d8491-a84b-450c-861e-145150b75e27",
                                "sense_id": "49bd43af-8fb2-3c5e-952a-bb35cba647b9",
                                "text": "Schmalzhafs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
