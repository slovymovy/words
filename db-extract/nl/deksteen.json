                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "522c8d6f-796b-4f81-8f61-d4a2a16d3f8b",
                        "source_entry_id": "29f715b7-8dc5-3466-b374-319d11fa13ab",
                        "source_sense_id": "50509b06-9067-33d9-8c9e-6f33d5b2a198",
                        "target_lang_word": "capstone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ea92d5-9c12-348f-affb-aeaf7b97fdfd",
                                        "entry_id": "c93dfd7d-714c-3607-9a3c-19e4244b50dd",
                                        "glosses": [
                                            "Any of the stones making up the top layer of a wall; a coping stone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d249641-b8a9-3eb1-ada6-d747cc532c3e",
                                        "entry_id": "c93dfd7d-714c-3607-9a3c-19e4244b50dd",
                                        "glosses": [
                                            "A crowning achievement, culmination or finishing touch."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e67459-f584-4375-a80f-c1aa7075116c",
                                                "sense_id": "3d249641-b8a9-3eb1-ada6-d747cc532c3e",
                                                "text": "“You see, I’ve never had a girl friend,” I added, by way of topping the obelisk of silliness with the capstone of fatuity."
                                            },
                                            {
                                                "example_id": "aeda4dd1-7702-49fb-af2a-0d16b84f946d",
                                                "sense_id": "3d249641-b8a9-3eb1-ada6-d747cc532c3e",
                                                "text": "Success of the Apollo program has been the capstone to a series of significant accomplishments for the United States in space in a broad spectrum of manned and unmanned exploration missions and in the application of space techniques for the benefit of man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "capstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2e062b-2b0b-34c1-8069-8093e14892fd",
                                        "entry_id": "2f1712d6-c4ea-3888-b932-bfb4d9e6e884",
                                        "glosses": [
                                            "To complete as a crowning achievement; to top off."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2c68b8-b63b-458e-a320-24ade8df7174",
                                                "sense_id": "ba2e062b-2b0b-34c1-8069-8093e14892fd",
                                                "text": "Capstoning a decade's worth of linked short stories, The Quiet War (2008) was a vivid and tense novel about a solar system sliding into conflict."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fc261c-6c03-35b0-b0ec-855936cbe439",
                                        "entry_id": "2f1712d6-c4ea-3888-b932-bfb4d9e6e884",
                                        "glosses": [
                                            "To train in the Capstone Military Leadership Program."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20fac184-71e1-47a8-ab05-992c710ad299",
                                                "sense_id": "52fc261c-6c03-35b0-b0ec-855936cbe439",
                                                "text": "“Capstoned” units are now able to train and plan in peacetime with the command with which they will fight in wartime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "801ceae2-d2d6-4307-a91f-3eea8f7a1ff5",
                        "source_entry_id": "29f715b7-8dc5-3466-b374-319d11fa13ab",
                        "source_sense_id": "50509b06-9067-33d9-8c9e-6f33d5b2a198",
                        "target_lang_word": "table",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "table",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9df91ed2-ceee-33a5-9eb3-a77aa1115ea3",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Surface plane de bois, de pierre, de marbre, etc., posée sur un ou plusieurs pieds et qui sert à divers usages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bbb60ff-2e91-4dc7-9289-75ab800171ef",
                                                "sense_id": "9df91ed2-ceee-33a5-9eb3-a77aa1115ea3",
                                                "text": "Chaque soir, les cueilleurs se groupaient dans notre salle commune, autour de la table à six pieds, massive comme un bloc de boucher, pour le dernier verre de kirch de la journée et les comptes."
                                            },
                                            {
                                                "example_id": "ab341fc0-15ea-4b98-8ff1-7c54d5c4f01c",
                                                "sense_id": "9df91ed2-ceee-33a5-9eb3-a77aa1115ea3",
                                                "text": "Ce fut, en ce temps de relative splendeur, qu’un soir de bombe, à Montparnasse, il cueillit Geneviève à une table de café."
                                            },
                                            {
                                                "example_id": "7c1eacee-cbb5-4bdd-a9a3-2c10c6796839",
                                                "sense_id": "9df91ed2-ceee-33a5-9eb3-a77aa1115ea3",
                                                "text": "Devant une table, encombrée par un chanteau de pain, une demi-meule de gruyère et une innombrable quantité de bouteilles vides, les deux amis qu’on croyait morts devisaient paisiblement comme des sages."
                                            },
                                            {
                                                "example_id": "2bcf69f8-336a-4491-ae07-cc1362545dc3",
                                                "sense_id": "9df91ed2-ceee-33a5-9eb3-a77aa1115ea3",
                                                "text": "Regardez. Brutalement éclairées par une lampe, de vieilles gens autour d’une table vident un litre d’aramon."
                                            },
                                            {
                                                "example_id": "fd1bec07-79bf-4b17-abeb-9b86e006a3ea",
                                                "sense_id": "9df91ed2-ceee-33a5-9eb3-a77aa1115ea3",
                                                "text": "L’ameublement était sommaire : un bureau, un fauteuil de cuir, des classeurs métalliques, deux petites tables dont l’une supportait une presse à copier."
                                            },
                                            {
                                                "example_id": "813c05ea-b831-4295-9a11-06d752d96a1e",
                                                "sense_id": "9df91ed2-ceee-33a5-9eb3-a77aa1115ea3",
                                                "text": "Par le baron Zorn de Bulach, nous savons qu'on jouait gros jeu à Schœnbrun. Il cite le cas d'une femme qui avait perdu près de 30 000 florins, et du mariage d'un haut personnage, où il y avait environ cinquante tables de jeu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a4e43dc-ec67-3082-8355-9e82e527348b",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Table à manger, et surtout celle servie, couverte de mets."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "note": "Il est souvent synonyme de repas en ce sens",
                                        "examples": [
                                            {
                                                "example_id": "d28c3e00-b30d-4817-abdc-8d0e43abfab0",
                                                "sense_id": "9a4e43dc-ec67-3082-8355-9e82e527348b",
                                                "text": "[…], sauf un lopin de terre où le jardinier sème des plants de carottes et de choux pour la table de sa Grandeur, tout le jardin est inculte ; […]."
                                            },
                                            {
                                                "example_id": "23d4cbdf-2d27-4468-a10c-83ec311a90a6",
                                                "sense_id": "9a4e43dc-ec67-3082-8355-9e82e527348b",
                                                "text": "Marc, au banquet, avait aperçu à la table d’honneur Caribe, sa femme et Le Garrec, faufilés en cette agape comme dans tous les autres spectacles gratis."
                                            },
                                            {
                                                "example_id": "a8f02d8b-b626-430d-9187-c69dd03820b3",
                                                "sense_id": "9a4e43dc-ec67-3082-8355-9e82e527348b",
                                                "text": "Le lendemain, je me rendis à bord du Rochester, où une quarantaine d’officiers, réunis à leur mess autour d’une table immense, me firent une excellente réception."
                                            },
                                            {
                                                "example_id": "0aed0cf7-75ec-442d-bc6c-731d77a24a6d",
                                                "sense_id": "9a4e43dc-ec67-3082-8355-9e82e527348b",
                                                "text": "C’est ainsi qu’en 465 le concile de Vannes interdit aux clercs non seulement de prendre part aux repas de juifs, mais de les inviter à leurs propre table."
                                            },
                                            {
                                                "example_id": "f491c76a-a6fe-4046-bf99-37cb105014b1",
                                                "sense_id": "9a4e43dc-ec67-3082-8355-9e82e527348b",
                                                "text": "Terroir de clos honorés jusque sur les tables royales, l’Orléanais se vantait de posséder sa propre « façon de barillerie » qu'on pouvait reconnaître de Jargeau à Beaugency."
                                            },
                                            {
                                                "example_id": "1b2ce280-eabe-4f59-a043-ffe5255706fb",
                                                "sense_id": "9a4e43dc-ec67-3082-8355-9e82e527348b",
                                                "text": "À Armenonville, à une table voisine de la nôtre, un sous-lieutenant de dragons enlace de son bras le buste de sa trop bruyante compagne et laisse voir ainsi au poignet un tatouage d'escarpe..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184ac8cd-895c-3b1e-b7bf-c0e86129b44a",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Restaurant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66ea828-c2e1-4037-b400-ac63056f5215",
                                                "sense_id": "184ac8cd-895c-3b1e-b7bf-c0e86129b44a",
                                                "text": "Oubliez tous vos a priori sur les cafètes de musées, l'Amber Restaurant de la Scotch Whisky Experience est une véritable table écossaise qui met en avant la tradition nationale et cuisine un excellent haggis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c5aef71-bbba-3c60-8b3a-c3e20d4f7315",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Ce que l’on sert à table, cuisine, bonne chère, mets, gastronomie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "222df241-5fb2-46a0-8b28-f6fc7f24ac41",
                                                "sense_id": "5c5aef71-bbba-3c60-8b3a-c3e20d4f7315",
                                                "text": "Il a tant, il dépense tant pour sa table."
                                            },
                                            {
                                                "example_id": "183d5147-b5ed-4076-9a22-847f09dbec20",
                                                "sense_id": "5c5aef71-bbba-3c60-8b3a-c3e20d4f7315",
                                                "text": "Sa table lui coûte beaucoup."
                                            },
                                            {
                                                "example_id": "8da4eff8-3992-4949-b23e-a45404581238",
                                                "sense_id": "5c5aef71-bbba-3c60-8b3a-c3e20d4f7315",
                                                "text": "Il a retranché, réformé, diminué sa table."
                                            },
                                            {
                                                "example_id": "e6815807-26e8-4afc-bee9-b310ec5b6496",
                                                "sense_id": "5c5aef71-bbba-3c60-8b3a-c3e20d4f7315",
                                                "text": "Aimer la table, aimer la bonne chère."
                                            },
                                            {
                                                "example_id": "b0430d8e-0e66-4c90-93e4-ff6cebe63da3",
                                                "sense_id": "5c5aef71-bbba-3c60-8b3a-c3e20d4f7315",
                                                "text": "Les plaisirs de la table."
                                            },
                                            {
                                                "example_id": "5459aaed-8506-4a22-a227-37ca9a4113ba",
                                                "sense_id": "5c5aef71-bbba-3c60-8b3a-c3e20d4f7315",
                                                "text": "Les arts de la table, la gastronomie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a1148b-31ea-3046-b93c-6c0a5ed67af9",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Partie supérieure présentant une surface plane de certains objets."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5108df29-3668-4fd9-9418-c4bbb7f6e1b8",
                                                "sense_id": "e7a1148b-31ea-3046-b93c-6c0a5ed67af9",
                                                "text": "Près du hameau de Bellevillotte se trouvait un dolmen dit la Pierre-couverte, dont les supports seuls restent en place. La table, enlevée il y a environ quarante ans, sert de pont sur l’Orvin : largeur, 2ᵐ,80; longueur, 2ᵐ,90; épaisseur, 0ᵐ,50."
                                            },
                                            {
                                                "example_id": "75e0e795-26c5-46ad-8500-46d0dfd31cdd",
                                                "sense_id": "e7a1148b-31ea-3046-b93c-6c0a5ed67af9",
                                                "text": "On court le plus vite qu'on peut, on prend une impulsion sur un tremplin et on appuie les mains sur la table de saut."
                                            },
                                            {
                                                "example_id": "048aac8b-dc13-41e5-abb4-ae75ab1a6c40",
                                                "sense_id": "e7a1148b-31ea-3046-b93c-6c0a5ed67af9",
                                                "text": "La table de l’autel."
                                            },
                                            {
                                                "example_id": "7bff8b74-607b-4542-9ed0-9611ab42754c",
                                                "sense_id": "e7a1148b-31ea-3046-b93c-6c0a5ed67af9",
                                                "text": "La table d’une enclume."
                                            },
                                            {
                                                "example_id": "196df5e5-75b6-4c0a-8703-46da3cfbebd8",
                                                "sense_id": "e7a1148b-31ea-3046-b93c-6c0a5ed67af9",
                                                "text": "Table de guitare, table de piano, d’harmonie."
                                            },
                                            {
                                                "example_id": "2b1e09b9-915c-480f-8357-5482d899362c",
                                                "sense_id": "e7a1148b-31ea-3046-b93c-6c0a5ed67af9",
                                                "text": "Sa table, son chevalet, son manche, son fond en érable, le sillet d’ébène, les chevilles qui sont en buis, tout est magnifique dans cet instrument de musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a8570cd-9e6b-3f97-8151-35bd43dc2f2d",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Châssis de madriers bien joints sur lesquels on applique le tapis."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60952a95-f8da-3704-ace7-3f10004902e3",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Masse de quelque chose qui est d’une épaisseur notablement moindre à ses autres dimensions."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4f6f9c-b5cd-4d9e-9eeb-413b18973cc3",
                                                "sense_id": "60952a95-f8da-3704-ace7-3f10004902e3",
                                                "text": "Quant aux « mises », ce sont de grandes caisses qui donnent au savon la forme d’un bloc ; au moyen d’un fil, on découpe ce bloc en tables, puis ces tables sont elles-mêmes découpées en « pains » ou morceaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a661503-27d0-3c96-b52e-b52e79f5c0c9",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Partie d’une machine à papier destinée à étaler la pâte à papier et l’égoutter pour former la feuille de papier, composée d’une toile métallique ou de plastique, d’une caisse de tête, de pontuseaux d’égouttage, d’un rouleau vergeur, de caisses aspirantes, d'un dispositif de recoupe de feuille par jets d'eau, d’un cylindre aspirant et de dispositifs de lavage constitués de rinceurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5376e9e-87d4-36c7-8d70-7ccdec0c6270",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Les deux lames osseuses qui revêtent les os du crâne."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95d6bd2a-24ae-3bd9-a71f-fcf5d61a55c3",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Lame, plaque ou planche de cuivre, d’argent ou de tout autre matériau plate et unie, sur laquelle on peut écrire, graver, peindre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87312a3-ba37-4859-8f11-338ebdd8b5c9",
                                                "sense_id": "95d6bd2a-24ae-3bd9-a71f-fcf5d61a55c3",
                                                "text": "Les Tables de la loi."
                                            },
                                            {
                                                "example_id": "ab8ad15f-ae24-46eb-a5e8-5f3e74b54ace",
                                                "sense_id": "95d6bd2a-24ae-3bd9-a71f-fcf5d61a55c3",
                                                "text": "Graver sur une table d’airain, sur une table de plomb."
                                            },
                                            {
                                                "example_id": "593ae704-a894-4b8f-b151-9775b5262e92",
                                                "sense_id": "95d6bd2a-24ae-3bd9-a71f-fcf5d61a55c3",
                                                "text": "Une table de rocher."
                                            },
                                            {
                                                "example_id": "b4f60a27-d2a0-41f6-a908-ab6f9e67fec1",
                                                "sense_id": "95d6bd2a-24ae-3bd9-a71f-fcf5d61a55c3",
                                                "text": "Ces tables de marbre sont destinées à recevoir des inscriptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "979b6e9a-e023-3f57-896b-daab0ed1e483",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Index permettant de trouver facilement les matières ou les mots qui sont dans un ouvrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "483f10c1-2212-4dd9-9587-6b6b76fd80d3",
                                                "sense_id": "979b6e9a-e023-3f57-896b-daab0ed1e483",
                                                "text": "Entre l’ancien et le nouveau cadastre, le système de numérotation des parcelles a changé, ce qui oblige à se reporter aux tables de correspondance figurant sur les premières matrices du « nouveau cadastre » (feuillets roses), pour suivre l'identité d'une parcelle."
                                            },
                                            {
                                                "example_id": "c4680c81-1591-449d-aa4a-91a06b41c95b",
                                                "sense_id": "979b6e9a-e023-3f57-896b-daab0ed1e483",
                                                "text": "Il n’y a point de table à ce livre. Table alphabétique. — Table analytique. — Table méthodique."
                                            },
                                            {
                                                "example_id": "83c8487e-3e70-44be-b733-f9e62dbf398b",
                                                "sense_id": "979b6e9a-e023-3f57-896b-daab0ed1e483",
                                                "text": "Table des noms propres. — Table des chapitres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b357a4a-4c30-35ef-8a05-91b24b810473",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Tableau d’informations ordonnées très courantes avant l’invention de la calculette et de l’ordinateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d226f828-e652-4bd2-98bb-497b01fc3b12",
                                                "sense_id": "6b357a4a-4c30-35ef-8a05-91b24b810473",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir; […]."
                                            },
                                            {
                                                "example_id": "a5e461a3-0106-46da-864c-7f90f239b6f7",
                                                "sense_id": "6b357a4a-4c30-35ef-8a05-91b24b810473",
                                                "text": "[…] ; on apprenait à mesurer le vent aux diverses altitudes en observant un ballon au moyen d’un théodolite ; on calculait les tables qui permettaient une interprétation rapide, et en même temps d’autres tables de correction pour le tir de l’artillerie."
                                            },
                                            {
                                                "example_id": "711f7203-6aa7-47c9-a3ad-46f1cdfb7d6c",
                                                "sense_id": "6b357a4a-4c30-35ef-8a05-91b24b810473",
                                                "text": "Cette table donne le moyen d’établir, dans l’hypothèse où la courbe de la marée est une sinusoïde, la hauteur de la marée à un instant quelconque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8778809d-2cd0-31be-a52c-4fe64a32d403",
                                        "entry_id": "893474dc-63f2-3baa-8fe5-12b68883e7e4",
                                        "glosses": [
                                            "Partie d’une base de données relationnelle, constituée de tuples décrivant chacun une occurrence d’un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd020b0c-a132-41d7-a5dd-1f2091af0eee",
                                                "sense_id": "8778809d-2cd0-31be-a52c-4fe64a32d403",
                                                "text": "Il n’y a rien de plus simple que de supprimer une table. Si vous utilisez l’option RESTRICT alors que la table est référencée par une vue ou une contrainte, l’instruction DROP (supprimer) retourne une erreur. Si vous faites appel à l’option CASCADE, la suppression réussit et toutes les vues et contraintes sont supprimées."
                                            }
                                        ]
                                    }
                                ]
                            },
