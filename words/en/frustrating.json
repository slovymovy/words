    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc597615-8803-3441-bea5-ce401661283a",
                    "sense_definition": "causing feelings of annoyance, disappointment, or anger because of being unable to achieve something",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is extremely <w>frustrating</w> when the internet connection keeps dropping during an important video call.",
                            "target_lang_translations": {
                                "ru": "Это крайне <w>раздражает</w>, когда интернет-соединение постоянно прерывается во время важного видеозвонка."
                            }
                        },
                        {
                            "text": "Trying to assemble this complex furniture without clear instructions is a <w>frustrating</w> experience for anyone.",
                            "target_lang_translations": {
                                "ru": "Попытка собрать эту сложную мебель без четких инструкций — <w>досадный</w> опыт для любого человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "discouraging"
                    ],
                    "antonyms": [
                        "satisfying",
                        "encouraging",
                        "rewarding"
                    ],
                    "common_phrases": [
                        "frustrating experience",
                        "deeply frustrating",
                        "frustrating situation",
                        "incredibly frustrating"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий чувство раздражения, разочарования или гнева из-за невозможности достичь чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разочаровывающий",
                                "target_lang_sense_clarification": "вызывающий чувство неудовлетворенности"
                            },
                            {
                                "target_lang_word": "досадный",
                                "target_lang_sense_clarification": "вызывающий досаду или раздражение"
                            },
                            {
                                "target_lang_word": "раздражающий",
                                "target_lang_sense_clarification": "вызывающий чувство бессилия и злости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e4a61c5-0c28-354a-94e5-6a636f2cab45",
                    "sense_definition": "present participle and gerund of <w>frustrate</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant delays were <w>frustrating</w> his efforts to finish the project on schedule.",
                            "target_lang_translations": {
                                "ru": "Постоянные задержки <w>сводили на нет</w> его усилия завершить проект в срок."
                            }
                        },
                        {
                            "text": "By <w>frustrating</w> the opponent's plans, the team managed to secure a narrow victory.",
                            "target_lang_translations": {
                                "ru": "<w>Сорвав</w> планы противника, команде удалось одержать трудную победу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
