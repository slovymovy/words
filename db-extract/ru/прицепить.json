                ],
                "senses": [
                    {
                        "sense_id": "4d84cd49-9101-33b2-96c9-a0ed377f4a66",
                        "entry_id": "08aab9fd-bef7-3c0e-a4a9-d6268f6b4331",
                        "glosses": [
                            "прочно присоединить одно к другому"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd58cc9-37d3-4f80-a123-d1397ab467f7",
                                "sense_id": "4d84cd49-9101-33b2-96c9-a0ed377f4a66",
                                "text": "Судя по толчкам, наш вагон прицепили к поезду."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f8d43ce-29f8-3ea8-bbd8-3897c4faa0a7",
                        "entry_id": "08aab9fd-bef7-3c0e-a4a9-d6268f6b4331",
                        "glosses": [
                            "зацепив, приколоть или привесить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b77c9893-f590-47ac-838c-6833fd3ee703",
                                "sense_id": "0f8d43ce-29f8-3ea8-bbd8-3897c4faa0a7",
                                "text": "Публика глядит в рукопись и видит красный крест… но такой крест, который не прицепишь к сюртуку."
                            },
                            {
                                "example_id": "94e6173b-e8da-4d1f-8a47-592ada9392fb",
                                "sense_id": "0f8d43ce-29f8-3ea8-bbd8-3897c4faa0a7",
                                "text": "«Надо оставить ей о себе память! — подумал он. — Прицеплю ей что-нибудь к удочке. Это будет сюрпризом от „неизвестного“»."
                            }
                        ]
                    }
                ],
