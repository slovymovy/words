                ],
                "senses": [
                    {
                        "sense_id": "50c3ef09-06df-3fa2-a9f4-8cf5430eaff2",
                        "entry_id": "14fe16ac-13ca-3284-8353-2b86a8191c44",
                        "glosses": [
                            "Faden aus Gold oder einem goldfarbenen Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7835eb-3e1c-45cd-b393-713d2e206587",
                                "sense_id": "50c3ef09-06df-3fa2-a9f4-8cf5430eaff2",
                                "text": "Die Gesichtsmaske ist mit Goldfäden durchwirkt."
                            },
                            {
                                "example_id": "d3e77aa6-24a2-447d-a3ab-18fdc632e0eb",
                                "sense_id": "50c3ef09-06df-3fa2-a9f4-8cf5430eaff2",
                                "text": "„Sie trug ein Hausgewand aus indischem Musselin, in den mit Goldfäden Blumen gestickt waren, und ihre Nachthaube war einer Königin würdig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "12d20bdb-7d52-33c4-8d96-a061aaee40f2",
                        "entry_id": "14fe16ac-13ca-3284-8353-2b86a8191c44",
                        "glosses": [
                            "textiler Faden, der goldfarben ist oder mit Gold überzogen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19bac933-055b-4ee4-81f8-6831a610bb59",
                                "sense_id": "12d20bdb-7d52-33c4-8d96-a061aaee40f2",
                                "text": "„Sie trug ein Hausgewand aus indischem Musselin, in den mit Goldfäden Blumen gestickt waren, und ihre Nachthaube war einer Königin würdig.“"
                            },
                            {
                                "example_id": "3e56a485-9679-4fd2-bdef-8fb18ed3ed87",
                                "sense_id": "12d20bdb-7d52-33c4-8d96-a061aaee40f2",
                                "text": "Dieses Muster, das die 12 Sternzeichen darstellt, ist mit blauer Seide und Goldfaden gehäkelt."
                            },
                            {
                                "example_id": "6eb4c950-787f-4bb8-8ae2-cb194414189d",
                                "sense_id": "12d20bdb-7d52-33c4-8d96-a061aaee40f2",
                                "text": "„Der Anwalt war ein älterer Mann mit weißem Bart, der den für diese Region typischen weißen Thoub und darüber einen mit Goldfäden bestickten schwarzen Umhang trug.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
