                "senses": [
                    {
                        "sense_id": "9a04fd46-506d-3470-b7b0-dd1b7eb33f2a",
                        "entry_id": "5833d116-3155-3edb-93ea-29f2200814d8",
                        "glosses": [
                            "as before, (still) as usual, still"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab98e80-1455-4a6c-bb0e-08e488a1301f",
                                "sense_id": "9a04fd46-506d-3470-b7b0-dd1b7eb33f2a",
                                "text": "Как хорошо́, что мы по-пре́жнему вдвоём!",
                                "translation": "It's so good that we're still together!",
                                "english": "It's so good that we're still together!"
                            },
                            {
                                "example_id": "4bbf9aa9-7081-4f55-886b-770725d22915",
                                "sense_id": "9a04fd46-506d-3470-b7b0-dd1b7eb33f2a",
                                "text": "Никола́й Петро́вич чита́л ему́ журна́лы, Фе́нечка ему́ прислу́живала по-пре́жнему, приноси́ла бульо́н, лимона́д, я́йца всмя́тку, чай; но та́йный у́жас овладева́л е́ю ка́ждый раз, когда́ она́ входи́ла в его́ ко́мнату.",
                                "translation": "Nikolai Petrovich read papers to him; Fenichka waited on him as before, brought him soup, lemonade, boiled eggs and tea; but a secret dread seized her every time she came into his room.",
                                "english": "Nikolai Petrovich read papers to him; Fenichka waited on him as before, brought him soup, lemonade, boiled eggs and tea; but a secret dread seized her every time she came into his room."
                            },
                            {
                                "example_id": "f87c9921-6b6a-4cfe-980d-7b68561e6780",
                                "sense_id": "9a04fd46-506d-3470-b7b0-dd1b7eb33f2a",
                                "text": "По-пре́жнему О́льга Ива́новна иска́ла вели́ких люде́й, находи́ла и не удовлетворя́лась и опя́ть иска́ла. По-пре́жнему она́ ка́ждый день возвраща́лась по́здно но́чью, но Ды́мов уже́ не спал, как в про́шлом году́, а сиде́л у себя́ в кабине́те и что́-то рабо́тал.",
                                "translation": "As before, Olga Ivanovna sought celebrities, found them, and, insatiable, sought for more. As before, she returned home late. But Duimoff, no longer sleeping as of old, sat in his study and worked.",
                                "english": "As before, Olga Ivanovna sought celebrities, found them, and, insatiable, sought for more. As before, she returned home late. But Duimoff, no longer sleeping as of old, sat in his study and worked."
                            }
                        ]
                    }
                ],
