                        "glosses": [
                            "Resembling or characteristic of a lion, for example in fierceness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51863811-c6f8-4c00-b4dd-7c94f136d05c",
                                "sense_id": "3c77d010-f9ba-325f-bf0f-d714a2d4700c",
                                "text": "For although I ſaid before, that the Church coveting to ride upon the lionly form of Juriſdiction, makes a transformation of herſelf into an Aſs, and becomes deſpicable..."
                            },
                            {
                                "example_id": "f8bf9d72-a2bb-40b7-8682-25f1f9d78c83",
                                "sense_id": "3c77d010-f9ba-325f-bf0f-d714a2d4700c",
                                "text": "Upon these interjections, placable flicks of the lionly tail addressed to Britannia the Ruler, who expected him in some mildish way to lash terga cauda in retiring, Sir Willoughby Patterne passed from a land of alien manners; […]"
                            },
                            {
                                "example_id": "c95f1951-57a8-4d6a-b7a9-b9679f5b286b",
                                "sense_id": "3c77d010-f9ba-325f-bf0f-d714a2d4700c",
                                "text": "The destructive lionly skepticism burns all bridges to prior beliefs and presuppositions."
                            },
                            {
                                "example_id": "52d34c1f-3a24-4cef-a899-5562a869960e",
                                "sense_id": "3c77d010-f9ba-325f-bf0f-d714a2d4700c",
                                "text": "Lionly strength expresses independence of will and a restless wandering based in deep curiosity and intense perception."
                            },
                            {
                                "example_id": "92c3db77-6674-436a-93c4-d38cf31ec513",
                                "sense_id": "3c77d010-f9ba-325f-bf0f-d714a2d4700c",
                                "text": "Picture these lionly lovers jumping through romantic hoops, otherwise known as the initial courtship phase, and then a disagreement or difference of opinion occurs."
                            }
                        ]
                    }
