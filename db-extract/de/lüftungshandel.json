                "senses": [
                    {
                        "sense_id": "a872cd2b-9a9b-3115-bcfe-3fe2041a9067",
                        "entry_id": "0804646f-0e96-31f2-9e3e-aaaab923cfd7",
                        "glosses": [
                            "Kauf oder Verkauf von Waren der Lüftungsindustrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47df450e-fa97-4017-91c2-baae9440c028",
                                "sense_id": "a872cd2b-9a9b-3115-bcfe-3fe2041a9067",
                                "text": "„Westaflex kann wie Lindab eigentlich über jedem Sanitär- und Lüftungshandel bezogen werden und zählt unserer Meinung nach wie Lindab zu den Anbietern mit dem besten Material.“"
                            },
                            {
                                "example_id": "41c14b88-57d1-4272-bf8b-ed3c072e7ee1",
                                "sense_id": "a872cd2b-9a9b-3115-bcfe-3fe2041a9067",
                                "text": "Auf den Seiten von Heizungs- und Lüftungshandel Andreas Minoia aus Hüfingen finden Sie Infos über Heizungs- und Lüftungsbedarf."
                            },
                            {
                                "example_id": "034929b9-f7eb-4f04-bb5c-49bc9b76e78d",
                                "sense_id": "a872cd2b-9a9b-3115-bcfe-3fe2041a9067",
                                "text": "Mit entsprechenden Standartkomponenten aus dem Lüftungshandel ist dies natürlich auch markenunabhängig zu realisieren."
                            },
                            {
                                "example_id": "7044542a-c2cc-4ea1-be7b-b0c5ac683ce7",
                                "sense_id": "a872cd2b-9a9b-3115-bcfe-3fe2041a9067",
                                "text": "Über Auswahl des Material (Luftverteilerbox in Eigenbau oder über Lüftungshandel erworben, Kanäle in Holz selbst gebaut, oder Wickelfalzrohr etc. und Dimensionierung der Querschnitte) will ich noch nichts sagen."
                            },
                            {
                                "example_id": "c290be1d-79ab-4a39-8b71-40e703c9f23a",
                                "sense_id": "a872cd2b-9a9b-3115-bcfe-3fe2041a9067",
                                "text": "Dies ist der kleinste Durchmesser, für den alle Komponenten (Bögen, Abzweigungen, Muffen,…) standardmäßig im Klima-/Lüftungshandel erhältlich sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
