                "senses": [
                    {
                        "sense_id": "a5e65234-c164-3065-ac90-7d12d7d30dee",
                        "entry_id": "f4b33818-a5e9-3b72-8081-8955d6b97f75",
                        "glosses": [
                            "The study of the brain, focussing on its structure and functions."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "52eca4be-09bb-4fc3-af44-67e9f5f02d9e",
                                "sense_id": "a5e65234-c164-3065-ac90-7d12d7d30dee",
                                "text": "It has been suggested by an acute student of cerebrophysiology that the white matter of the brain deals wholly with inhibiting the lower centres; and if inhibiting means the shaping of the action of the lower centres, this view seems very plausible."
                            },
                            {
                                "example_id": "45ffa1d6-a6ae-4e0c-a5f5-4aa4db01c9d5",
                                "sense_id": "a5e65234-c164-3065-ac90-7d12d7d30dee",
                                "text": "Research in anatomy and the physiology of the brain, the discovery of the microscopic structure of the brain, and the application of experimental methods to cerebrophysiology added to our stock of knowledge."
                            },
                            {
                                "example_id": "a15df6df-6ff0-47f5-96de-9b53222f3065",
                                "sense_id": "a5e65234-c164-3065-ac90-7d12d7d30dee",
                                "text": "Such observations not only led him to reject the evidence of the senses but also to assert that \"experiments with human beings could only be conducted by experts in cerebrophysiology.\""
                            },
                            {
                                "example_id": "ad18775b-c884-448b-baf6-c5ef16953af6",
                                "sense_id": "a5e65234-c164-3065-ac90-7d12d7d30dee",
                                "text": "In medical science, he focused especially on cerebrophysiology and conducted pathological research into Alzheimer's disease."
                            }
                        ]
                    }
                ],
