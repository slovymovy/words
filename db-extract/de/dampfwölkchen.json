                ],
                "senses": [
                    {
                        "sense_id": "71d5789a-11a3-3771-9554-e15ba331c4ac",
                        "entry_id": "55a77386-1f58-39a0-a63c-a1da94b4aef4",
                        "glosses": [
                            "kleine Wolke aus Dampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25b33b06-ca6e-4b02-b4da-343b55085458",
                                "sense_id": "71d5789a-11a3-3771-9554-e15ba331c4ac",
                                "text": "„Gräuliche Dampfwölkchen stiegen von den Autos, den Häusern und den Mündern der Menschen auf.“"
                            },
                            {
                                "example_id": "96d096a8-d847-432c-a062-af2451980bca",
                                "sense_id": "71d5789a-11a3-3771-9554-e15ba331c4ac",
                                "text": "„Zehn Minuten später tauchte der junge Bursche mit einem Gefährten auf, barfuß führten sie die zwei gesattelten und gestriegelten Pferde im Laufschritt die Straße entlang, Dampfwölkchen stiegen aus den Nüstern der Tiere, ihre Köpfe drehten sich elegant hin und her.“"
                            },
                            {
                                "example_id": "56a76195-e7fb-4a7b-b700-80367e34951e",
                                "sense_id": "71d5789a-11a3-3771-9554-e15ba331c4ac",
                                "text": "„Mit einem Stoßseufzer, der als Dampfwölkchen in der Nachtluft verschwand, zog Riegel es aus der Tasche.“"
                            },
                            {
                                "example_id": "737f725a-b728-4921-9dd3-0e95178b1f5f",
                                "sense_id": "71d5789a-11a3-3771-9554-e15ba331c4ac",
                                "text": "„Unter der Kühlerhaube, die zu einem V gekrümmt ist, steigen Dampfwölkchen empor und vermischen sich mit den Nebelschwaden.“"
                            },
                            {
                                "example_id": "488dcb4d-b726-4e36-b80d-e75d60780407",
                                "sense_id": "71d5789a-11a3-3771-9554-e15ba331c4ac",
                                "text": "„Andrews trat ans Feuer und suchte die Hitze; aus den Falten seiner Kleider stiegen Dampfwölkchen auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
