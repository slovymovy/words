                "senses": [
                    {
                        "sense_id": "3905b687-a1cf-3d1d-b358-1b70a00a499a",
                        "entry_id": "02a9d2d2-9ed9-3df5-84e5-58e410234307",
                        "glosses": [
                            "Fundament, auf dem ein Haus steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05681df7-27f8-4118-a2c3-81b16c0f1989",
                                "sense_id": "3905b687-a1cf-3d1d-b358-1b70a00a499a",
                                "text": "„Ein Bergbauexperte habe aber vorläufig Entwarnung gegeben. Obwohl der Krater bis an das Hausfundament reicht, sei die Standsicherheit nicht gefährdet.“"
                            },
                            {
                                "example_id": "84e3b0ca-5ccb-4d75-85e3-953898bed03a",
                                "sense_id": "3905b687-a1cf-3d1d-b358-1b70a00a499a",
                                "text": "„Bei Ausschachtungsarbeiten ist am Freitagmorgen versehentlich ein Hausfundament an einer belebten Einkaufsstraße freigelegt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d27c829b-49dd-4c38-b71c-a2cd0ea727c4",
                        "source_entry_id": "02a9d2d2-9ed9-3df5-84e5-58e410234307",
                        "source_sense_id": "3905b687-a1cf-3d1d-b358-1b70a00a499a",
                        "source_sense_description": "Bauwesen: Fundament, auf dem ein Haus steht",
                        "target_lang_word": "foundation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foundation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1619aa1d-dbfe-36ac-b146-df30c110e495",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "The act of founding, fixing, establishing, or beginning to erect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccef7acf-58c7-4c83-8868-8bda12958556",
                                                "sense_id": "1619aa1d-dbfe-36ac-b146-df30c110e495",
                                                "text": "The foundation of his institute has been wrought with difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ac5330-2f75-31f3-b6f5-e98cc304914f",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "That upon which anything is founded; that on which anything stands, and by which it is supported; the lowest and supporting layer of a superstructure; underbuilding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "131534d6-e06a-4eaa-9d2e-11c808c2bfe1",
                                                "sense_id": "62ac5330-2f75-31f3-b6f5-e98cc304914f",
                                                "text": "Aye Madam to be sure that is the Provoking circumstance—without Foundation—yes yes—there's the mortification indeed—for when a slanderous story is believed against one—there certainly is no comfort like the consciousness of having deserved it——"
                                            },
                                            {
                                                "example_id": "5a4f4960-388e-4681-8d46-efc182e63452",
                                                "sense_id": "62ac5330-2f75-31f3-b6f5-e98cc304914f",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2efd1c67-bb6e-3210-b6e9-e0b93bd2bc47",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "The result of the work to begin something; that which stabilizes and allows an enterprise or system to develop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de60f664-8c73-4364-aecb-f795ec5c7ba3",
                                                "sense_id": "2efd1c67-bb6e-3210-b6e9-e0b93bd2bc47",
                                                "text": "The implication is that the Gandhian model of growth is possible, now that Nehru's investment strategy had already laid a strong foundation for economic growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d26246-4782-35c1-8936-c83d196d2b8d",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "In solitaire or patience games, one of the piles of cards that the player attempts to build, usually holding all cards of a suit in ascending order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c425e987-0e17-3756-a79f-573c5375fd96",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "The lowest and supporting part or member of a wall, including the base course and footing courses; in a frame house, the whole substructure of masonry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cf5cc1d-c052-4b2c-9849-72675b743e53",
                                                "sense_id": "c425e987-0e17-3756-a79f-573c5375fd96",
                                                "text": "The foundations of this construction have been laid out."
                                            },
                                            {
                                                "example_id": "51f8baa7-80e2-46fd-9f19-56a3e3bd63b1",
                                                "sense_id": "c425e987-0e17-3756-a79f-573c5375fd96",
                                                "text": "“Marge Gets A Job” opens with the foundation of the Simpson house tilting perilously to one side, making the family homestead look like the suburban equivalent of the Leaning Tower Of Pisa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b8ef2f-d651-3997-863b-7e6c06ebaca9",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "A donation or legacy appropriated to support a charitable institution, and constituting a permanent fund; endowment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "786f6016-6161-3d13-ae93-426d73818e12",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "That which is founded, or established by endowment; an endowed institution or charity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd5cb14-9f90-4a67-9b39-0dcb093faeb8",
                                                "sense_id": "786f6016-6161-3d13-ae93-426d73818e12",
                                                "text": "The Wikimedia Foundation, Inc. is the parent organization of the Wiktionary collaborative project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0acfb244-6163-32f5-80c7-baeaee615ecf",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "Cosmetic cream roughly skin-colored, designed to make the face appear uniform in color and texture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21e0d107-44f2-336a-8d69-98eecb1caa0b",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "A basis for social bodies or intellectual disciplines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "111a1016-f27c-41f0-84b6-923064481e60",
                                                "sense_id": "21e0d107-44f2-336a-8d69-98eecb1caa0b",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too.[…]But as a foundation for analysis it is highly subjective: it rests on difficult decisions about what counts as a territory, what counts as output and how to value it. Indeed, economists are still tweaking it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbe65ef3-c3d8-4f7c-be24-46ef3c6fe37b",
                        "source_entry_id": "02a9d2d2-9ed9-3df5-84e5-58e410234307",
                        "source_sense_id": "3905b687-a1cf-3d1d-b358-1b70a00a499a",
                        "source_sense_description": "Bauwesen: Fundament, auf dem ein Haus steht",
                        "target_lang_word": "cimentación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cimentación",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f7319222-04b7-3a31-a55a-b4e5934ec179",
                                        "entry_id": "f3b0fc5c-d243-35da-aeb6-cd2d5ac22bc5",
                                        "glosses": [
                                            "Acción y efecto de cimentar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41a306fa-dca9-4fb8-970c-77f39774f662",
                                                "sense_id": "f7319222-04b7-3a31-a55a-b4e5934ec179",
                                                "text": "«Según la naturaleza de la cimentación, interesan unas pruebas más que otras. No son lo mismo una cimentación sobre pilotes flotantes o por grandes cajones (caissons) sumergibles, o por exclusa de aire en terreno anegadizo, o para bloques soporte de máquinas que dan lugar a transmisión de vibraciones o para asiento de terraplenes y diques de tierra sobre terreno clivoso y escurridizo»."
                                            },
                                            {
                                                "example_id": "366e30e1-ea02-4f9d-bb2f-82ed55aa2f37",
                                                "sense_id": "f7319222-04b7-3a31-a55a-b4e5934ec179",
                                                "text": "«Mientras la cimentación del paredón parecía ablandada marisma, mostrando largas tiras de su piel, el ladrillo cocido de nuevo por el directo lanzazo del cenital, se ajustaba como las capas que forman el tronco del plátano»."
                                            },
                                            {
                                                "example_id": "1599e913-e141-42ed-9f48-71e4bc7d0eba",
                                                "sense_id": "f7319222-04b7-3a31-a55a-b4e5934ec179",
                                                "text": "«La cimentación a grandes profundidades es técnica moderna; los romanos carecían de la misma y sus puentes suelen carecer de cimentación adecuada»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
