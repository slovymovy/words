                    {
                        "sense_id": "76aae107-0cf9-3c8b-a116-ea7be3fb3659",
                        "entry_id": "8585dcd1-7b3a-3678-af03-7c080e70d643",
                        "glosses": [
                            "книжн. свойство по значению прилагательного селективный; избирательность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f866120-2ce6-4df0-978d-8fce46fbfe28",
                                "sense_id": "76aae107-0cf9-3c8b-a116-ea7be3fb3659",
                                "text": "Всем видам кулонометрического метода свойственны высокие метрологические характеристики (малая погрешность анализа, высокая правильность, воспроизводимость, селективность)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47b610bf-052c-4105-9a21-b51cbe8197aa",
                        "source_entry_id": "8585dcd1-7b3a-3678-af03-7c080e70d643",
                        "source_sense_id": "76aae107-0cf9-3c8b-a116-ea7be3fb3659",
                        "target_lang_word": "selectivity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selectivity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a02ad5a0-bdd8-3e80-86a9-1867335f677c",
                                        "entry_id": "62953b6c-81c5-3822-9c86-89095cc2b9a6",
                                        "glosses": [
                                            "The quality of being selective, or extent to which something is selective."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8890a76-1c0c-400f-bbfb-7f2aee6af649",
                                                "sense_id": "a02ad5a0-bdd8-3e80-86a9-1867335f677c",
                                                "text": "[…] while music was known to have scientific qualities — harmony, Pythagorean proportional relationship, etc. — it was the musician who by his selectivity made these proportions beautiful, […]"
                                            },
                                            {
                                                "example_id": "e32ea460-43b6-4470-8705-380130c88d57",
                                                "sense_id": "a02ad5a0-bdd8-3e80-86a9-1867335f677c",
                                                "text": "“We must stop conflating selectivity with excellence. We must stop correlating prestige with privilege,” he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "846d5e21-ca4b-370a-adf8-3ed93c2dbc73",
                                        "entry_id": "62953b6c-81c5-3822-9c86-89095cc2b9a6",
                                        "glosses": [
                                            "The ability of a radio receiver to separate a desired signal frequency from others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e53d219-676a-3f73-8125-8bca4abfbfb5",
                                        "entry_id": "62953b6c-81c5-3822-9c86-89095cc2b9a6",
                                        "glosses": [
                                            "Discrimination of a reactant towards a choice of other reactants; the ratio of rate constants for different reactants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b1e771e-a0b7-3743-a1ce-237753d0d917",
                                        "entry_id": "62953b6c-81c5-3822-9c86-89095cc2b9a6",
                                        "glosses": [
                                            "An approach to social work that prioritizes people perceived as having the most need for assistance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "292d3dc0-f991-4175-a4b5-d37ad802f01f",
                                                "sense_id": "7b1e771e-a0b7-3743-a1ce-237753d0d917",
                                                "text": "Proponents of selectivity herald its cost effectiveness; instead of resources being spread over a vast population, money or services can be used where they are most needed. This can help fill in the gaps between needy and non-needy groups. […] Critics of selectivity argue, however, that it may be more cost effective to provide social welfare benefits across the board rather than to spend time and money sorting out those who are \"truly disadvantaged.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
