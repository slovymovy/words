                ],
                "senses": [
                    {
                        "sense_id": "d7f9ee02-f407-32a0-aecc-655a1c250105",
                        "entry_id": "d4aff791-7bd0-37cd-bb54-e2e773771246",
                        "glosses": [
                            "een proces van overleg waarbij partijen trachten tot een voor beiden aanvaardbare afspraak te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fdac3d0-578b-42e9-8ebf-dda11fb4b804",
                                "sense_id": "d7f9ee02-f407-32a0-aecc-655a1c250105",
                                "text": "De onderhandelingen zaten volledig in het slop."
                            },
                            {
                                "example_id": "260edfe3-64e7-42ef-af08-71d1d1ce9614",
                                "sense_id": "d7f9ee02-f407-32a0-aecc-655a1c250105",
                                "text": "Hoelang de onderhandelingen precies zullen duren is onduidelijk, maar de formele toetreding van Finland zal binnen een paar maanden tot een jaar geregeld moeten zijn. De parlementen van alle dertig NAVO-lidstaten moeten ermee instemmen. Secretaris-generaal Stoltenberg van de NAVO heeft gezegd dat de Finnen \"een warm welkom\" zullen krijgen. \"Het toetredingsproces zal soepel en snel gaan.\""
                            },
                            {
                                "example_id": "1beb3d25-9018-4fc5-955e-b9ffc634bbc6",
                                "sense_id": "d7f9ee02-f407-32a0-aecc-655a1c250105",
                                "text": "GroenLinks en PvdA, die het voorstel ook al eerder deden in onderhandelingen met het kabinet, willen dat de extra steun voor de lage middeninkomens nog voor de zomer geregeld wordt, zodat het geld zo snel mogelijk overgemaakt kan worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2a8e5f4-24f6-4c48-bab1-b4aafcd4748c",
                        "source_entry_id": "d4aff791-7bd0-37cd-bb54-e2e773771246",
                        "source_sense_id": "d7f9ee02-f407-32a0-aecc-655a1c250105",
                        "source_sense_description": "een proces van overleg waarbij partijen trachten tot een voor beiden aanvaardbare afspraak te komen",
                        "target_lang_word": "negotiation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negotiation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe503ad9-2807-360a-b3d0-893292b0bfcf",
                                        "entry_id": "ddeea71a-39f6-31e0-9481-166a15c4154e",
                                        "glosses": [
                                            "The process of achieving agreement through discussion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07dcc29b-9de2-450c-97db-defc335a4f1f",
                                                "sense_id": "fe503ad9-2807-360a-b3d0-893292b0bfcf",
                                                "text": "The two parties entered into negotiations about the merger."
                                            },
                                            {
                                                "example_id": "d772a681-ca34-4261-89d0-85d26cb5936a",
                                                "sense_id": "fe503ad9-2807-360a-b3d0-893292b0bfcf",
                                                "text": "The specifics of the contract are still under negotiation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2e538a3-9685-4a26-b15c-2b3be8e3256f",
                        "source_entry_id": "d4aff791-7bd0-37cd-bb54-e2e773771246",
                        "source_sense_id": "d7f9ee02-f407-32a0-aecc-655a1c250105",
                        "source_sense_description": "een proces van overleg waarbij partijen trachten tot een voor beiden aanvaardbare afspraak te komen",
                        "target_lang_word": "négociation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "négociation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "184eb6cc-20b9-3846-8d98-3509b9f6f7e6",
                                        "entry_id": "d9ab0b6a-45b2-3d10-a88a-e793a5f99c91",
                                        "glosses": [
                                            "Action de négocier les grandes affaires publiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "351eebb4-15d4-4a4b-a2fe-b0bb782af0c8",
                                                "sense_id": "184eb6cc-20b9-3846-8d98-3509b9f6f7e6",
                                                "text": "Il paroît que les négociations entre le saint Siége ^([sic]) et le roi des Pays-Bas, pour parvenir à un Concordat, vont se suivre. On a parle de l’arrivée de Mᵍʳ. Nazali, nonce en Suisse, à Bruxelles."
                                            },
                                            {
                                                "example_id": "2503e781-ac92-4267-a5a1-5b53331295f8",
                                                "sense_id": "184eb6cc-20b9-3846-8d98-3509b9f6f7e6",
                                                "text": "Deux jours plus tard, la défaite est consommée avec la formation du gouvernement Pétain, décidé à demander l’armistice au plus tôt. Le 25 juin, après trois jours de négociations et de menaces, les Allemands imposent leurs conditions."
                                            },
                                            {
                                                "example_id": "a4f2e4f6-0e85-4f14-bbd4-29f24d7ce41d",
                                                "sense_id": "184eb6cc-20b9-3846-8d98-3509b9f6f7e6",
                                                "text": "Une négociation c’est toujours la même chose, que l’on négocie des abricots, des calissons d’Aix, des téléphones portables ou des fusées Ariane, la négociation est un univers autonome qui obéit à ses propres lois, un univers à jamais inaccessible aux non-négociateurs."
                                            },
                                            {
                                                "example_id": "eafcbd47-a114-4651-b520-c67a3632578f",
                                                "sense_id": "184eb6cc-20b9-3846-8d98-3509b9f6f7e6",
                                                "text": "À l’issue des négociations entre groupes politiques sur la répartition des futures présidences des commissions du Parlement européen, il a été convenu que celle de l’Agriculture serait confiée au groupe conservateur ECR."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "588c3868-cfc8-375f-a4a4-277821fe5bca",
                                        "entry_id": "d9ab0b6a-45b2-3d10-a88a-e793a5f99c91",
                                        "glosses": [
                                            "Affaire même qu’on traite et qu’on négocie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5423393-ca0c-4fc8-bd74-44e3f91b1a23",
                                                "sense_id": "588c3868-cfc8-375f-a4a4-277821fe5bca",
                                                "text": "Il a une négociation difficile, délicate, importante entre les mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e419cd4-6bbb-3948-9a76-a07d8f5128a8",
                                        "entry_id": "d9ab0b6a-45b2-3d10-a88a-e793a5f99c91",
                                        "glosses": [
                                            "Les mêmes choses, en parlant des affaires privées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8b9351-1c1b-47a4-88aa-6c2a491a2bc4",
                                                "sense_id": "8e419cd4-6bbb-3948-9a76-a07d8f5128a8",
                                                "text": "Vous voulez que je m’occupe de ce mariage : vous me chargez là d’une négociation difficile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305db6a4-9a52-3420-9cc6-65bead4bca42",
                                        "entry_id": "d9ab0b6a-45b2-3d10-a88a-e793a5f99c91",
                                        "glosses": [
                                            "Transmission de la propriété d’une valeur ou d’un effet, soit par l’intermédiaire d’un agent de change ou d’un courtier, soit par contrat direct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98718a68-4981-49ea-8b90-59aa41b3fc23",
                                                "sense_id": "305db6a4-9a52-3420-9cc6-65bead4bca42",
                                                "text": "La négociation d’un billet, d’une lettre de change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39b2a5ae-8e2e-4119-a858-d21e7c7d87be",
                        "source_entry_id": "d4aff791-7bd0-37cd-bb54-e2e773771246",
                        "source_sense_id": "d7f9ee02-f407-32a0-aecc-655a1c250105",
                        "source_sense_description": "een proces van overleg waarbij partijen trachten tot een voor beiden aanvaardbare afspraak te komen",
                        "target_lang_word": "переговоры",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "переговоры",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f2544444-4d89-3a6f-931a-5c719eaac198",
                                        "entry_id": "e1a6dc63-4ae7-3d5f-b767-f964c74cce3f",
                                        "glosses": [
                                            "офиц. действия официально уполномоченных лиц, направленные на выяснение позиций сторон по какому-либо вопросу, достижение взаимопонимания и, возможно, заключение договора между ними"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0943a3-6d77-4576-b3fb-51c051892cd1",
                                                "sense_id": "f2544444-4d89-3a6f-931a-5c719eaac198",
                                                "text": "Но именно в декабре кроме советско-китайских переговоров, и то затянувшихся, ну и кроме семидесятилетия Хозяина, ничего положительного как-то не произошло."
                                            },
                                            {
                                                "example_id": "4ce8e183-185a-4643-86de-c1cc0ea25911",
                                                "sense_id": "f2544444-4d89-3a6f-931a-5c719eaac198",
                                                "text": "Потом уж мы переговоры вели: смотритель приходил и издалека всё уговаривал, чтоб отпустить старуху, а я его Блюхером притравливал, ― отлично берёт смотрителей Блюхер."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
