                        "glosses": [
                            "Personne qui fait trop de compliments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd36a315-c216-49f0-9097-3b7514ebc9c9",
                                "sense_id": "772b7c4d-bc75-3f22-bfc2-ccd00740b5de",
                                "text": "Un complimenteur éternel."
                            },
                            {
                                "example_id": "67a64279-8344-4c1d-b239-f2c898dc76a7",
                                "sense_id": "772b7c4d-bc75-3f22-bfc2-ccd00740b5de",
                                "text": "Valori. – La salle se remplit à tout instant de ces complimenteurs du matin. Ils attendent tranquillement qu’on les admette."
                            }
                        ]
                    }
