                "senses": [
                    {
                        "sense_id": "07f22999-702c-3be3-98bf-0d536105176b",
                        "entry_id": "d78e5391-75e8-3e42-b8cf-a872cbd210a8",
                        "glosses": [
                            "weibliche Person, die Tiere quält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ea2b1d-0d45-4f51-9e7c-693bf3dc516e",
                                "sense_id": "07f22999-702c-3be3-98bf-0d536105176b",
                                "text": "Im Herbst 2009 wurde sie angezeigt und als Tierquälerin beschimpft."
                            },
                            {
                                "example_id": "2a56c1e4-0dc3-41fb-a930-528cb9070885",
                                "sense_id": "07f22999-702c-3be3-98bf-0d536105176b",
                                "text": "„Im dritten Anlauf konnte heute am Landesgericht Ried in Oberösterreich der Prozess gegen eine Tierquälerin stattfinden.“"
                            },
                            {
                                "example_id": "0b60dbe1-1c95-42df-98cd-2ebb00fa1752",
                                "sense_id": "07f22999-702c-3be3-98bf-0d536105176b",
                                "text": "„Doch ich war keine Tierquälerin, die dachte, dass die Schildkröten lieber Hunderte Kilometer im Auto mit mir fahren wollten, als gemütlich auf ihren Sonnensteinen zu liegen, nur weil ich mich nicht von ihnen trennen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
