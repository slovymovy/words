                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72a25188-5cc1-3734-959b-934173a5b74d",
                                        "entry_id": "3f5389bc-b3db-37c0-8cfa-a20e0bf1d3eb",
                                        "glosses": [
                                            "The state of being held as security for a loan, or as a pledge."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4efca68b-e5ba-4103-90e9-a45088053132",
                                                "sense_id": "72a25188-5cc1-3734-959b-934173a5b74d",
                                                "text": "All our jewellery was in pawn by this stage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1498efd-15a2-35b0-9b06-1c2ededa98a6",
                                        "entry_id": "3f5389bc-b3db-37c0-8cfa-a20e0bf1d3eb",
                                        "glosses": [
                                            "An instance of pawning something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f768b4b2-b73a-4293-b612-b22bc18be6e5",
                                                "sense_id": "b1498efd-15a2-35b0-9b06-1c2ededa98a6",
                                                "text": "Redeem from broking pawn the blemish'd crown."
                                            },
                                            {
                                                "example_id": "f6b60144-2b76-49dc-a25f-47d932e60650",
                                                "sense_id": "b1498efd-15a2-35b0-9b06-1c2ededa98a6",
                                                "text": "As therefore the morning devv, is a pavvne of the evenings fatneſſe, ſo, O Lord, let this daies comfort be the earneſt of to morrowes, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c60247-221b-3f68-b876-7787c7e1f1ec",
                                        "entry_id": "3f5389bc-b3db-37c0-8cfa-a20e0bf1d3eb",
                                        "glosses": [
                                            "An item given as security on a loan, or as a pledge."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba56692b-7a73-4974-a9f9-d9ca3099aa0a",
                                                "sense_id": "50c60247-221b-3f68-b876-7787c7e1f1ec",
                                                "text": "My life I never held but as a pawn / To wage against thy enemies."
                                            },
                                            {
                                                "example_id": "177d877f-7ada-4f67-b891-909cc0e118b2",
                                                "sense_id": "50c60247-221b-3f68-b876-7787c7e1f1ec",
                                                "text": "Brokers, takers of pawns, biting userers, I will not admit; yet […] I will tolerate some kind of usery."
                                            },
                                            {
                                                "example_id": "ee4ce031-31d5-402e-8590-0fec7284e5fa",
                                                "sense_id": "50c60247-221b-3f68-b876-7787c7e1f1ec",
                                                "text": "As for mortgaging or pawning,[…]men will not take pawns without use [i.e. interest]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1c7ff6b-7e66-330f-9db1-d262cdf45d82",
                                        "entry_id": "3f5389bc-b3db-37c0-8cfa-a20e0bf1d3eb",
                                        "glosses": [
                                            "A pawnshop; pawnbroker."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1f3569b-8687-3643-b920-bbaa592ea37c",
                                        "entry_id": "a1417719-6afc-3da3-93bf-4a4d71daf7ea",
                                        "glosses": [
                                            "To pledge; to stake or wager."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c87e11a6-9a69-351a-bfa5-db75ae7dc379",
                                        "entry_id": "a1417719-6afc-3da3-93bf-4a4d71daf7ea",
                                        "glosses": [
                                            "To give as security on a loan of money; especially, to deposit (something) at a pawn shop."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c3ea13-df3a-40f5-80ee-458c91a61dfe",
                                                "sense_id": "c87e11a6-9a69-351a-bfa5-db75ae7dc379",
                                                "text": "A certain, and probably an appreciable, proportion of his so-called money at call and short notice would consist of fortnightly advances made to members of the Stock Exchange against pawned stocks and shares."
                                            },
                                            {
                                                "example_id": "8ffc3b03-ebc7-4e54-a4f2-64520f59fd6c",
                                                "sense_id": "c87e11a6-9a69-351a-bfa5-db75ae7dc379",
                                                "text": "But you'd better take your diamond ring, you'd better pawn it, babe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "532b33af-ea94-3542-a5fc-2b4a79e02e81",
                                        "entry_id": "dec58b33-be06-3fe1-aade-e22c046b8d3e",
                                        "glosses": [
                                            "The most numerous chess piece, or a similar piece in a similar game. In chess, each side starts with eight; moves are only forward, and attacks are only diagonally or en passant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae37388-3f98-44b3-8367-d29d23e711a2",
                                                "sense_id": "532b33af-ea94-3542-a5fc-2b4a79e02e81",
                                                "text": "The pawn may move forward to the square immediately in front of it on the same file, provided that this square is unoccupied […] Consequently, in the initial position the white pieces and pawns are placed on the first and second ranks; the black pieces and pawns on the eighth and seventh ranks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c83f393c-8e7d-3899-be26-4aef7933c742",
                                        "entry_id": "dec58b33-be06-3fe1-aade-e22c046b8d3e",
                                        "glosses": [
                                            "A person being manipulated by another, being used to some end."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9539556-724d-43ba-ad4a-bb8c5c10b3da",
                                                "sense_id": "c83f393c-8e7d-3899-be26-4aef7933c742",
                                                "text": "Near-synonym: chess piece"
                                            },
                                            {
                                                "example_id": "cbc46b63-d932-468e-8cbc-e1aca4f596d9",
                                                "sense_id": "c83f393c-8e7d-3899-be26-4aef7933c742",
                                                "text": "Though a pawn of the gods, her departure is the precipitating cause of the Trojan War."
                                            },
                                            {
                                                "example_id": "23b883e7-f11e-4d5e-b20c-dbb10a58387f",
                                                "sense_id": "c83f393c-8e7d-3899-be26-4aef7933c742",
                                                "text": "He delivered a broadside to the RMT leadership, saying: \"This response to a significantly enhanced offer exposes their true priority - using the British public and NR workers as pawns in a fight with the Government."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pawn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58fc63e1-6032-3815-ab60-7cd1dcbea66d",
                                        "entry_id": "5a802b73-e3da-3af4-be57-048df0597856",
                                        "glosses": [
                                            "Alternative form of paan."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
