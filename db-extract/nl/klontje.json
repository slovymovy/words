                                                "example_id": "db770e5d-a2a1-48ca-856c-a0eda4b46213",
                                                "sense_id": "935e032a-094b-3eac-8735-bed1bd50adc3",
                                                "text": "My co-worker annoys me by throwing things over the walls of my cube."
                                            }
