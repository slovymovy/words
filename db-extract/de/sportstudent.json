                "senses": [
                    {
                        "sense_id": "595def3f-1b4c-33ee-92d5-9cc4337c60e8",
                        "entry_id": "1f110f69-c3c5-3cfa-89fa-47b2621aa126",
                        "glosses": [
                            "Person, die das Fach Sport studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09fdac06-b90f-4696-900f-de74ab3d58e3",
                                "sense_id": "595def3f-1b4c-33ee-92d5-9cc4337c60e8",
                                "text": "„Nowitzki wirkt - nach all den Jahren im schrillen NBA-Betrieb - noch immer so lässig und bodenständig wie ein Sportstudent im 20. Semester, gerade deshalb bewundern ihn so viele Menschen auf der ganzen Welt.“"
                            },
                            {
                                "example_id": "666b0aaa-d105-446c-83c6-c45b7b21a24c",
                                "sense_id": "595def3f-1b4c-33ee-92d5-9cc4337c60e8",
                                "text": "„Für Mark Farner, der seine Ski- und Snowboard-Manufaktur 1984 als Sportstudent gegründet hat, ein wahrer Segen. Und Grund für gute Laune.“"
                            },
                            {
                                "example_id": "6e2500d5-da6c-43ad-8c4d-5720924129ee",
                                "sense_id": "595def3f-1b4c-33ee-92d5-9cc4337c60e8",
                                "text": "„Matthias, Sportstudent aus Köln, trainiert vier- bis sechsmal pro Woche im Fitnessstudio, seit drei Jahren ernährt er sich vegan, in letzter Zeit isst er fast ausschließlich Rohkost.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
