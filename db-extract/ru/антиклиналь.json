                                                "example_id": "c69a3ca5-3ae7-4db6-a686-f2e7bb959f7f",
                                                "sense_id": "0f8ab956-b7e1-378d-8e9d-30b2c43f5238",
                                                "text": "W rowerach downhillowych siodła mają trwalszą i szerszą konstrukcję."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "b2f2addb-fc4f-3861-b473-911650239af6",
                                        "entry_id": "08b78986-a167-3baa-90de-8045b95ec302",
                                        "glosses": [
                                            "płaski, poziomy element zaczepu umożliwiający połączenie ciągnika siodłowego z naczepą w samochodach ciężarowych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3f49a8c-ea39-4c43-89c6-913f0de9af4f",
                                                "sense_id": "b2f2addb-fc4f-3861-b473-911650239af6",
                                                "text": "Naciski wywierane na siodło zawierają się w przedziale od 5 do 36 ton"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "1c60b1e7-7075-3cff-a919-800ac2acea55",
                                        "entry_id": "08b78986-a167-3baa-90de-8045b95ec302",
                                        "glosses": [
                                            "wypukły fałd warstw skalnych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba46a569-bc10-4d75-8fa1-87146025a4d2",
                                                "sense_id": "1c60b1e7-7075-3cff-a919-800ac2acea55",
                                                "text": "Zamknięciem siodła jest peryklina."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "80fda838-de37-33c6-8a70-e8c70907900e",
                                        "entry_id": "08b78986-a167-3baa-90de-8045b95ec302",
                                        "glosses": [
                                            "szeroka przełęcz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5f4708-57ba-4430-9202-757ab4807fab",
                                                "sense_id": "80fda838-de37-33c6-8a70-e8c70907900e",
                                                "text": "Trasę prowadzącą przez siodło często wybierają przemytnicy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "e1c93ea0-2bbd-3a4d-8ede-c4dfbbae927a",
                                        "entry_id": "08b78986-a167-3baa-90de-8045b95ec302",
                                        "glosses": [
                                            "środkowy odcinek górnej powierzchni trzonu kości klinowej w dole środkowym czaszki"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea25f5a8-837b-4760-a54f-2db2334b41ab",
                                                "sense_id": "e1c93ea0-2bbd-3a4d-8ede-c4dfbbae927a",
                                                "text": "W lekkim wgłębieniu na siodle – dole przysadki – leży przysadka mózgowa"
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "5719ff8d-1042-3c33-9a45-de1136618197",
                                        "entry_id": "08b78986-a167-3baa-90de-8045b95ec302",
                                        "glosses": [
                                            "stanowisko lub pozycja społeczna"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.7\""
                                    }
                                ]
                            }
                        ]
