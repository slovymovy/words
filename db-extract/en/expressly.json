                                                "example_id": "ea9ed21e-25fb-49a4-948c-dd857e3aa3af",
                                                "sense_id": "b049f35f-6eef-36dd-87da-16d91cb8f9c3",
                                                "text": "— Кого имеете в виду? — быстро спросил Алексей. — Только укажите конкретно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18cba50-b591-3bd8-8f29-3578ebe4c5a0",
                                        "entry_id": "45b424d2-0c94-3310-8286-e40687712e3a",
                                        "glosses": [
