                "senses": [
                    {
                        "sense_id": "3f9da7bc-d625-39ea-ae29-c76141f1d5c1",
                        "entry_id": "a7a79ad1-b4c9-355b-9ed7-0558032bb2e9",
                        "glosses": [
                            "arcybiskup zajmujący czołowe miejsce w prowincji kościelnej – metropolii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "070152ee-2ccc-48e2-8bfe-39e1e35dea20",
                                "sense_id": "3f9da7bc-d625-39ea-ae29-c76141f1d5c1",
                                "text": "Może skończy się ta farsa, że formalnie diecezja jest częścią polskiej prowincji kościelnej i formalnie podlega – na pośmiewisko chyba – polskiemu metropolicie, arcybiskupowi Gniezna?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83001076-accf-4c77-bbef-c18ad968717a",
                        "source_entry_id": "a7a79ad1-b4c9-355b-9ed7-0558032bb2e9",
                        "source_sense_id": "3f9da7bc-d625-39ea-ae29-c76141f1d5c1",
                        "target_lang_word": "metropolitan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metropolitan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe06f09d-7759-359c-9ba2-e039baf560d9",
                                        "entry_id": "b0fb0645-ba08-34ad-965a-77c4f3c4fa14",
                                        "glosses": [
                                            "A bishop empowered to oversee other bishops; an archbishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "748af89c-9014-4e0c-872b-cc88e13f386e",
                                                "sense_id": "fe06f09d-7759-359c-9ba2-e039baf560d9",
                                                "text": "I knovv God by Miracle can inſtruct Kings, as he rained Mannah, and raiſed the Apoſtles from letterless Fiſher-men, to learned Metropolitans, and profound Doctours."
                                            },
                                            {
                                                "example_id": "377039d2-8fdb-4c69-8ae7-73aa3f1c1adb",
                                                "sense_id": "fe06f09d-7759-359c-9ba2-e039baf560d9",
                                                "text": "Yet from the late thirteenth century the metropolitan based himself either in Moscow or Vladimir-on-the-Kliazma, which was also in Muscovite territory, and it became the ambition of the Muscovites to make this arrangement permanent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cec7cf4-0284-31f7-81fe-424cb2dbae0b",
                                        "entry_id": "b0fb0645-ba08-34ad-965a-77c4f3c4fa14",
                                        "glosses": [
                                            "The inhabitant of a metropolis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "metropolitan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e115ba-c558-3e20-81d1-8e5c23e0809e",
                                        "entry_id": "d586a827-21ea-316e-94c6-b8e05f217c11",
                                        "glosses": [
                                            "Pertaining to the see or province of a metropolitan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e50ba094-9dcf-36b9-910c-4ff7b7708457",
                                        "entry_id": "d586a827-21ea-316e-94c6-b8e05f217c11",
                                        "glosses": [
                                            "Of, or pertaining to, a metropolis or other large urban settlement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df76c704-4633-3823-b9ba-b97143217ad6",
                                        "entry_id": "d586a827-21ea-316e-94c6-b8e05f217c11",
                                        "glosses": [
                                            "Of or pertaining to the parent state of a colony or territory, or the home country, e.g. metropolitan France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "230bc4b3-7525-406a-a58c-e26272e7e206",
                                                "sense_id": "df76c704-4633-3823-b9ba-b97143217ad6",
                                                "text": "Policies relating to the elimination of racial discrimination which obtain in metropolitan New Zealand are applicable in the Tokelau Islands."
                                            },
                                            {
                                                "example_id": "f75b4e4e-db6b-43c4-8d6b-fa3348354aed",
                                                "sense_id": "df76c704-4633-3823-b9ba-b97143217ad6",
                                                "text": "the new political status of these islands marks a definite break with the traditional Dutch colonial practice to keep its Caribbean colonies at a distance; and, after 2010, Dutch metropolitan laws and dministrative practices started being implemented on the islands."
                                            }
                                        ]
                                    }
                                ]
