                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef propose une omelette <w>forestière</w> préparée avec des champignons frais cueillis du matin."
                        },
                        {
                            "text": "Nous avons dégusté une tourte <w>forestière</w> bien chaude au coin du feu."
                        }
