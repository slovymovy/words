                        "cross_references": [
                            {
                                "target_word": "refrigerator mother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2998ff3a-81b4-30e9-979b-05c66293a6db",
                                        "entry_id": "c441fb82-515c-379e-8520-8dafcfc048e8",
                                        "glosses": [
                                            "An emotionally frigid mother, who does not exhibit normal care or love for her child or children."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c70e4ed-fb81-433a-b696-ee7e6c582556",
                                                "sense_id": "2998ff3a-81b4-30e9-979b-05c66293a6db",
                                                "text": "It was not until 1943 that Dr. Leo Kanner, an American pschiatrist, first diagnosed the syndrome in 11 children. . . . Kanner and others once postulated that these children were the products of \"refrigerator mothers,\" women who are overly cold and intellectual."
                                            },
                                            {
                                                "example_id": "d018f30b-4d8d-40e4-80cd-07d71ba727aa",
                                                "sense_id": "2998ff3a-81b4-30e9-979b-05c66293a6db",
                                                "text": "No present-day researcher takes the idea of the refrigerator mother as the cause of autism seriously."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
