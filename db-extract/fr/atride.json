                "senses": [
                    {
                        "sense_id": "deeafa6c-b814-310c-a5e3-e4e8d1ab16b8",
                        "entry_id": "e6a54d19-bf36-39d9-a857-38f077dabc86",
                        "glosses": [
                            "Membre d’une célèbre famille de la mythologie grecque, descendants d’Atrée."
                        ],
                        "tags": [
                            "Anthroponyme"
                        ],
                        "examples": [
                            {
                                "example_id": "a6fc0e26-1c27-4314-84c1-04e0c70b73ac",
                                "sense_id": "deeafa6c-b814-310c-a5e3-e4e8d1ab16b8",
                                "text": "Le sol d’Ithaca n’est point propre aux chevaux, n’étant point riche en vastes plaines et en nombreux herbages. Atride, je te laisse tes dons qui te conviennent mieux qu’à moi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b4d8dc1-c845-4051-9c31-e5f1eb6e34d0",
                        "source_entry_id": "e6a54d19-bf36-39d9-a857-38f077dabc86",
                        "source_sense_id": "deeafa6c-b814-310c-a5e3-e4e8d1ab16b8",
                        "target_lang_word": "Atreid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atreid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e709ca78-08ea-3099-9c48-70bc13718dc2",
                                        "entry_id": "f0a459be-cf72-3255-8ddf-f8172e031864",
                                        "glosses": [
                                            "Any of the family and descendants of the mythical Mycenaean king Atreus, including either of his sons Menelaus and Agamemnon, who both feature in the Iliad."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f399729f-75a2-42bd-859b-8045b6dc7304",
                                                "sense_id": "e709ca78-08ea-3099-9c48-70bc13718dc2",
                                                "text": "Ancient tradition said that Mycenae was founded by the Perseid dynasty and that the Atreids (Pelops, Atreus, Agamemnon) were outsiders."
                                            },
                                            {
                                                "example_id": "253ac615-28ed-4831-b353-97aedbc413f8",
                                                "sense_id": "e709ca78-08ea-3099-9c48-70bc13718dc2",
                                                "text": "While in the Oresteia sacrifice operated as a metaphor for the intrafamilial murders of the Atreids, among the Taurians the metaphor takes on materiality."
                                            },
                                            {
                                                "example_id": "b586e97f-8dae-4030-905c-f0a5af6e9198",
                                                "sense_id": "e709ca78-08ea-3099-9c48-70bc13718dc2",
                                                "text": "The family history of the Atreids is so complicated you'd need a flow chart to get it; what's more, that chart would flow with the blood of doomed family members. Situated in Mycenae, the Atreids were a brutal and competitive bunch; they worked hard to outdo each other with generation after generation of heinous crimes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
