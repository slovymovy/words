                            {
                                "example_id": "834af4d0-100e-41d4-a5ab-1eba10dbf850",
                                "sense_id": "118590fb-08ad-35c6-9e7d-eccd4bb9ceae",
                                "text": "To nasz gospodarz. Łzawiące ze starości, kaprawe oczy skaczą po nas bystro i przebiegle, porachowały już nasze worki, zlustrowały ubranie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f472cf9-48ff-4c9a-a14b-796637c93f51",
                        "source_entry_id": "0b36be48-6b7a-378b-8480-4e49ac41e377",
                        "source_sense_id": "118590fb-08ad-35c6-9e7d-eccd4bb9ceae",
                        "target_lang_word": "craftily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
