                "entry_id": "632ecafb-98c1-3b7a-9f2c-62f2a937bf71",
                "word": "soninké",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76fa6518-6ddb-38b7-bfa9-136173b953f0",
                        "entry_id": "632ecafb-98c1-3b7a-9f2c-62f2a937bf71",
                        "glosses": [
                            "Relatif au soninké."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe19d6f-4cef-4879-831b-012d0670dd27",
                                "sense_id": "76fa6518-6ddb-38b7-bfa9-136173b953f0",
                                "text": "Un laptot soninke pouvait gagner plus qu'un travailleur agricole en France et quatre fois plus qu'un paysan qui cultivait des arachides."
                            },
                            {
                                "example_id": "7b130843-51de-4737-aa77-10752d1ba4fd",
                                "sense_id": "76fa6518-6ddb-38b7-bfa9-136173b953f0",
                                "text": "La zone d’expansion de la communauté soninké comprend les deux tiers du Mali, le sud de la Mauritanie, une grande partie du Sénégal, le nord-ouest du Burkina Faso, une partie de la Gambie et de la Guinée-Bissau."
                            }
                        ]
                    }
