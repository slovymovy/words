                                "sense_id": "1ff58306-2906-30e7-a777-065ed529d936",
                                "text": "That recently passed political bill has been declared unconstitutional."
                            },
                            {
                                "example_id": "b6dd3c52-75c6-410c-bc2c-01949bb7f26b",
                                "sense_id": "1ff58306-2906-30e7-a777-065ed529d936",
                                "text": "A California law that ensures many gig workers are considered independent contractors, while affording them some limited benefits, is unconstitutional and unenforceable, a California Superior Court judge ruled Friday evening."
                            }
                        ]
