                        "sense_id": "648a17c9-c4f0-3dc3-a99b-3713b33a2738",
                        "entry_id": "a7b1ed79-b553-30d6-a987-7dad7c056e9b",
                        "glosses": [
                            "Procédé provoquant l’étourdissement à la suite de la traversée du cerveau par un courant électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01dff909-50cf-49fc-a4d9-e5f527e1f982",
                                "sense_id": "648a17c9-c4f0-3dc3-a99b-3713b33a2738",
                                "text": "Les abattages conventionnels prévoient notamment un étourdissement des bêtes — à l’aide d’une pince à électronarcose, d’un pistolet d’abattage ou de CO2 — et une deuxième tentative si la première a échoué, afin de leur éviter d’être conscientes au moment de leur mort."
                            },
                            {
                                "example_id": "02d784be-407d-45d7-b0b8-349d1a4193b5",
                                "sense_id": "648a17c9-c4f0-3dc3-a99b-3713b33a2738",
                                "text": "Il a été étourdi. Électronarcose pour être précise."
                            }
                        ]
                    }
                ],
