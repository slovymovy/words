                        "cross_references": [
                            {
                                "target_word": "Oberflächlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45573915-98d0-3615-bcf9-c2c660d515ca",
                                        "entry_id": "8703d02a-1ae1-3311-8e1b-83ceaea6ca80",
                                        "glosses": [
                                            "fehlende Notwendigkeit beziehungsweise das fehlende Bedürfnis, sich mit dem Gegenüber wirklich und tiefer auf ein Gespräch oder eine Beziehung einzulassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded662de-77ce-4122-be22-1f43d0d3494e",
                                                "sense_id": "45573915-98d0-3615-bcf9-c2c660d515ca",
                                                "text": "„Kennzeichnend für die histrionische Persönlichkeitsstörung (F60.4) sind […] Oberflächlichkeit, […] erhöhte Kränkbarkeit sowie ein übermäßiges Interesse an körperlicher Attraktivität.“"
                                            },
                                            {
                                                "example_id": "95eea139-7f1c-46a4-bcc8-1fa79eb355f1",
                                                "sense_id": "45573915-98d0-3615-bcf9-c2c660d515ca",
                                                "text": "„Er verdarb einem fast die Erwartung auf Maria, und es schien mir einen Augenblick, als hätte er sie mit seiner glatten, billigen Oberflächlichkeit beschmutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6512aae-5c9b-4638-8c73-a8e0bb4bff3d",
                        "source_entry_id": "01a94594-534c-3c95-8c93-301ab5d51865",
                        "source_sense_id": "bb7f556d-1d57-3fee-a3a9-ef5f22804268",
                        "target_lang_word": "yüzeysellik",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0a0994bc-cd9e-496e-9501-fea99b96c469",
                        "source_entry_id": "01a94594-534c-3c95-8c93-301ab5d51865",
                        "source_sense_id": "bb7f556d-1d57-3fee-a3a9-ef5f22804268",
                        "target_lang_word": "superficialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superficialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd276b4d-67cb-3ab6-aded-b87c8024278d",
                                        "entry_id": "bb571c61-1315-3fcb-b8b8-2ffb0c413826",
                                        "glosses": [
                                            "État de ce qui est superficiel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccdd133d-96c2-4197-b55c-8ad107b08a64",
                                                "sense_id": "fd276b4d-67cb-3ab6-aded-b87c8024278d",
                                                "text": "Dans la légèreté et même la superficialité de ce garçon, il y avait quelque chose qui plaisait à Violaine. Après tout, elle aussi vivait au jour le jour, avec son fardeau sur le cœur."
                                            },
                                            {
                                                "example_id": "5f5c7942-18b2-4a34-bfa5-52957b737a39",
                                                "sense_id": "fd276b4d-67cb-3ab6-aded-b87c8024278d",
                                                "text": "Mais, après tout, sans parler de nos penseurs médiatiques arguant de la profondeur de leur réflexion pour rivaliser de superficialité […]"
                                            },
                                            {
                                                "example_id": "c45851fc-7273-4e13-8a1c-b8c6a9558cee",
                                                "sense_id": "fd276b4d-67cb-3ab6-aded-b87c8024278d",
                                                "text": "La superficialité de l'existence au sein du monde contemporain se manifeste dans la vie professionnelle avec la disparition progressive de l'artisanat, qui était à la fois un mode d'expression et une voie de croissance intérieure."
                                            },
                                            {
                                                "example_id": "b3d27d29-81fd-4d23-9634-867d709a3093",
                                                "sense_id": "fd276b4d-67cb-3ab6-aded-b87c8024278d",
                                                "text": "Si, dès l'âge de 3 ans, le féminin est relié à l'esthétique et à la superficialité, alors il est ensuite bien difficile de faire machine arrière, que ce soit durant la suite de l'enfance, l'adolescence ou l'âge adulte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
