                ],
                "senses": [
                    {
                        "sense_id": "233eabfc-2d1b-387b-84ba-b84b4954c882",
                        "entry_id": "afd68d14-765f-3b40-80c5-7179119c20e5",
                        "glosses": [
                            "разг., фам. беспутный, опустившийся человек, пьяница"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01321d9b-731d-441e-b819-1375f3e2eb59",
                                "sense_id": "233eabfc-2d1b-387b-84ba-b84b4954c882",
                                "text": "[Катерина Ивановна:] По-моему, этот пьяный провиантский гораздо её умнее; по крайней мере уж видно, что забулдыга, последний ум пропил, а ведь эти все такие чинные, серьёзные…"
                            },
                            {
                                "example_id": "d36145fd-2df1-4885-a04d-10748b165517",
                                "sense_id": "233eabfc-2d1b-387b-84ba-b84b4954c882",
                                "text": "[художник Кранц:] Но, в общем, передо мной лежало преаппетитное создание, и я благословлял провидение, что оно послало такое утешение одинокому бродяге и забулдыге."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0187c77-6675-4492-b79c-99d0b2cb0473",
                        "source_entry_id": "afd68d14-765f-3b40-80c5-7179119c20e5",
                        "source_sense_id": "233eabfc-2d1b-387b-84ba-b84b4954c882",
                        "target_lang_word": "noceur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                        "entry_id": "4b88547e-96bc-3b60-a8b5-d8a15f055bd8",
                                        "glosses": [
                                            "Celui qui a une vie déréglée, qui fait trop la fête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abeb1e5a-eb7f-45dd-889d-514a3b903f9a",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "– Quel noceur ! se dit Joseph en employant une expression populaire passée dans les ateliers."
                                            },
                                            {
                                                "example_id": "5899014a-04f8-46be-918c-349e37bcb77a",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Paillardin. — Qu’est-ce que tu veux !… je ne suis pas un noceur, moi !… Je ne l’ai jamais été ! C’est même pour ça que je me suis marié ! Je n’avais pas de tempérament."
                                            },
                                            {
                                                "example_id": "7086e8f9-3a00-4c16-ae62-b64739f7199c",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Mongicourt.– Tiens ! moi, je suis un noceur réglé ! Je coordonne ma noce ! tout est là !… Savoir concilier ses plaisirs avec son travail !…"
                                            },
                                            {
                                                "example_id": "5de93acf-0647-469c-9e0d-7400ceabe7cc",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Certains caboulots, ici, ne ferment jamais réellement, et quel que soit l’heure, vous apercevez toujours, […], des noceurs, des gens en goguette."
                                            },
                                            {
                                                "example_id": "b63c7960-c3af-4d65-bea7-baf4dbf65b79",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Nous nous faisions la même idée mystique de l’amour – que nous ne concevions que sous la forme d’un amour unique, but et substance de toute une vie – et professions le même dégoût pour ces êtres volages que représentaient les « noceurs »."
                                            },
                                            {
                                                "example_id": "544c5e60-aec7-4795-aefa-5d6569984020",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Le matin du premier mai (qui, par ironie, se trouve être le jour de ma fête : el día de mi Santo) la rue que je devais prendre pour aboutir à la bouche du métro était jalonnée de vendeurs de muguet pour qui, à six heures du matin, j’étais le seul client avec un ou deux noceurs en smoking."
                                            },
                                            {
                                                "example_id": "367dea3b-3c97-4d49-ac7c-6abffa55d35b",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Bref, me voilà en route avec mes huit grosses valises, mes cinq tubars, le banquier Chauvassut, le noceur Clergerie, l’industriel Montagnoux, le poète Bois-Méard et le petit jeune homme de bonne famille, Gabriel Duplessis-Tournel. J’aurais très bien vu ces cinq cocos-là en uniforme bleu horizon avec un flingue baïonnette au canon, là bas, à Craonne, avec les copains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f59d95-50aa-35d1-85f2-192785ea3556",
                                        "entry_id": "4b88547e-96bc-3b60-a8b5-d8a15f055bd8",
                                        "glosses": [
                                            "Celui qui est invité à une noce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "noceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2a3e71-cef4-32f3-859e-330dc719cc75",
                                        "entry_id": "aa0379f2-8c8b-3df0-86e5-153d2d8c9e7f",
                                        "glosses": [
                                            "Qui a une vie déréglée ; qui fait trop la fête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4d6088-cd78-4bfc-a0f7-4d2e30038455",
                                                "sense_id": "cc2a3e71-cef4-32f3-859e-330dc719cc75",
                                                "text": "C’est un certain Méderic Gautruche, « ouvrier, noceur, gouapeur, rigoleur, faisant de la vie un lundi, rempli de la joie du vin, les lèvres perpétuellement humides d’une dernière goutte, […]. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c23f32b-5e25-44fa-b1db-8322b7179a05",
                        "source_entry_id": "afd68d14-765f-3b40-80c5-7179119c20e5",
                        "source_sense_id": "233eabfc-2d1b-387b-84ba-b84b4954c882",
                        "target_lang_word": "bambocheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bambocheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "568f8cd1-98e1-3029-b9ef-ecfda3adea11",
                                        "entry_id": "29497822-3602-3e58-b486-14cf53398d27",
                                        "glosses": [
                                            "Marionnettiste."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ebef98-d7ea-40c5-ba03-0fd39c8d6220",
                                                "sense_id": "568f8cd1-98e1-3029-b9ef-ecfda3adea11",
                                                "text": "Lettres de Jacques, maître bambocheur, à l’auteur du mémoire présenté au bureau économique. — (Réponse à la Lettre de Jacques, maître bambocheur à Saint-Cyprien, par un membre du bureau -1778)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e94c77e-6a81-309e-bca6-9664e0ba371e",
                                        "entry_id": "29497822-3602-3e58-b486-14cf53398d27",
                                        "glosses": [
                                            "Celui qui a l’habitude de faire bamboche, de faire la fête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d67ee1e2-6f16-4c73-a117-ca4289a1b218",
                                                "sense_id": "9e94c77e-6a81-309e-bca6-9664e0ba371e",
                                                "text": "Ramasse des confetti et jette-les nous : on aura l’air d'un groupe de bambocheurs."
                                            },
                                            {
                                                "example_id": "42caa6ac-d5e5-4816-a595-3de030454007",
                                                "sense_id": "9e94c77e-6a81-309e-bca6-9664e0ba371e",
                                                "text": "4 Heures du matin… Yvonne dort. Lucien, son bambocheur de mari rentre sur la pointe des pieds du bal des Quat’zarts, déguisé en Roi Soleil. Malheureusement pour lui, il a oublié ses clés."
                                            },
                                            {
                                                "example_id": "25bb35f1-59cc-4d16-b529-9332d543439d",
                                                "sense_id": "9e94c77e-6a81-309e-bca6-9664e0ba371e",
                                                "text": "Par deux fois, des bambocheurs arrêtèrent la litière et ouvrirent le rideau pour regarder à l’intérieur, déçus sans doute de n’y pas trouver quelque belle dame à effaroucher."
                                            },
                                            {
                                                "example_id": "bfdb493c-8721-41aa-90b2-8d99bf9628c3",
                                                "sense_id": "9e94c77e-6a81-309e-bca6-9664e0ba371e",
                                                "text": "À un tout autre point de vue, la moustache est essentielle. Elle détermine la physionomie. Elle vous donne l'air doux, tendre, violent, croque-mitaine, bambocheur, entreprenant !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
