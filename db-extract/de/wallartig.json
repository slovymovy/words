                        "form": "es ist wallartig"
                    },
                    {
                        "form_id": "e86940b3-8e37-46f8-bc2c-f90e9fc4d117",
                        "entry_id": "cea9178a-69dd-38ce-bd0e-0cdd186490af",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind wallartig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                        "entry_id": "cea9178a-69dd-38ce-bd0e-0cdd186490af",
                        "glosses": [
                            "im Aussehen einem Wall ähnlich; länglich (auf dem Boden) aufgeschüttet/aufgetürmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "610c2800-0ae1-490e-92e3-577e87a31c12",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Nur Steine und Geröll, das wallartig zur Endmoräne aufgeschüttet ist, hält den Gletschersee an Ort und Stelle“ […]."
                            },
                            {
                                "example_id": "f7e5d6b1-31ad-4793-9404-3c6c077d05d8",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Das Stadtbild verändert sich durch diese wallartigen Bauten.“"
                            },
                            {
                                "example_id": "0f617fbf-2902-4f9d-89a9-68d03542cfd0",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Im Fokus ist dabei eine wallartige Geländeerhebung, 500 Meter nördlich des Siedlungsrands, an der Grenze zur \"Schutzzone\", in der das Betreten verboten ist.“"
                            },
                            {
                                "example_id": "280559aa-fec6-48ad-b232-0d4560aaead5",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Hier und im Osten befinden sich gut erhaltene Reste der Parchimer Landwehr, die eine spätmittelalterliche und wallartige Grenzsicherungsanlage der Stadt Parchim war.“"
                            },
                            {
                                "example_id": "888b0da3-2334-4848-bed0-2e02263e0a2a",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Früher waren Strandburgen noch Strandburgen: Wallartige Barrikaden, mit denen man sich die Nachbarn vom zu bräunenden Leib hielt.“"
                            },
                            {
                                "example_id": "c26717fb-1bea-414e-9842-7ad7b626f63a",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Erwiesenermaßen kennen die Niederländer sich mit Deichbau aus. Rund 3000 Kilometer beträgt die Gesamtlänge der wallartigen Hochwasserschutzanlagen, die das flache Land, das zu großen Teilen sogar unterhalb des Meeresspiegels liegt, vor den Wellen der Nordsee schützen.“"
                            },
                            {
                                "example_id": "8d124949-31a0-4723-a331-45d214faef1f",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Auch auf die Äcker solcher mittelalterlicher Siedlungen, sogenannte Wölbackerfelder, wallartigen Ackerbeete, sind die Archäologen gestoßen.“"
                            },
                            {
                                "example_id": "80bf8185-0727-4d4a-98ba-39f1609752df",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Links und rechts der Bühne befinden sich wallartige gleißend weiße Wände, die nach Bedarf von einer Brücke verbunden werden“ […]."
                            },
                            {
                                "example_id": "55f06acc-af4a-41fb-b7f2-4895798c8cda",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "[Wallhecke:] „Die in Schleswig-Holstein und Niedersachsen gebräuchliche Bezeichnung „Knick“ (Mehrzahl: Knicke oder Knicks) bezeichnet dort wallartige Baum- und Strauchhecken“ […]."
                            },
                            {
                                "example_id": "a39e6b3d-0ac2-43da-a738-c13e92e11eb8",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "[…] „Am allerletzten Ende jenes Stadtgebiets, das es zur Ostsee mit einem wallartigen Inselchen abschließt und Amager heißt, liegt ein altes Werftgelände.“"
                            },
                            {
                                "example_id": "ca4329d8-dcd8-4543-9ee9-8e642b480405",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "[Rhein-Maas-Delta:] „Zwischen 3000 und 2500 BC veränderte sich der Charakter der Küste von einer offenen Küste zu einer Küste mit einer wallartigen Inselkette.“"
                            },
                            {
                                "example_id": "650b4b78-15be-4cab-bd8b-6006134b237d",
                                "sense_id": "e8007a8f-da4a-3a31-952a-448f38e1ac9f",
                                "text": "„Im Gegensatz zu den langgestreckten Oser-Zügen haben Kames eher unregelmäßige oder rundliche Grundrisse und sind nicht wallartig, sondern haben mehr Rücken- oder Kuppenform.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
