                                    },
                                    {
                                        "sense_id": "7decb563-9736-3e6a-abd4-cedc459c3c4a",
                                        "entry_id": "d05ebc64-3ada-3c8b-abd4-f24468cfa3de",
                                        "glosses": [
                                            "Any mixture or substance suggestive of soup consistency.",
                                            "A liquid or gelatinous substrate, especially the mixture of organic compounds that is believed to have played a role in the origin of life on Earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "991e9077-9c9c-45e9-9949-e27d7166bdbd",
                                                "sense_id": "7decb563-9736-3e6a-abd4-cedc459c3c4a",
                                                "text": "primordial soup"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52f77b74-9781-3c58-8d11-8f1da5f575ea",
                                        "entry_id": "d05ebc64-3ada-3c8b-abd4-f24468cfa3de",
                                        "glosses": [
                                            "Any mixture or substance suggestive of soup consistency.",
                                            "An unfortunate situation; trouble, problems (a fix, a mess); chaos."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "often",
                                            "uncountable",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d313e67-cd0e-4955-bffb-00bc394f39d4",
                                                "sense_id": "52f77b74-9781-3c58-8d11-8f1da5f575ea",
                                                "text": "B. Wickham had also the disposition and general outlook on life of a ticking bomb. In her society you always had the uneasy feeling that something was likely to go off at any moment with a pop. You never knew what she was going to do next or into what murky depths of soup she would carelessly plunge you. [...] “It may be fun for her,” I said with one of my bitter laughs, “but it isn't so diverting for the unfortunate toads beneath the harrow whom she plunges so ruthlessly in the soup.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c455ee17-8eb5-3542-95b8-ce37da7a18c9",
                                        "entry_id": "d05ebc64-3ada-3c8b-abd4-f24468cfa3de",
                                        "glosses": [
                                            "Any mixture or substance suggestive of soup consistency.",
                                            "The foamy portion of a wave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "845d46d9-e6b9-372e-ba3a-0200ff32eded",
                                        "entry_id": "d05ebc64-3ada-3c8b-abd4-f24468cfa3de",
                                        "glosses": [
                                            "Any mixture or substance suggestive of soup consistency.",
                                            "Any random starting pattern, typically studied to see what sorts of resultant more stable patterns emerge when evolved over subsequent generations."
                                        ],
                                        "tags": [
