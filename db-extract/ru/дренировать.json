                        "source_sense_id": "7bb93e69-9b6a-31e7-81bf-3ba5532e629a",
                        "target_lang_word": "drain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6daf010e-9959-3f5e-b771-ba831ca94645",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "A conduit allowing liquid to flow out of an otherwise contained volume; a plughole (UK)"
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab14a8e6-10aa-4d49-b0de-93f0df4acfe6",
                                                "sense_id": "6daf010e-9959-3f5e-b771-ba831ca94645",
                                                "text": "The drain in the kitchen sink is clogged."
                                            },
                                            {
                                                "example_id": "8b6c7591-200b-4efa-a768-0a9300c408c5",
                                                "sense_id": "6daf010e-9959-3f5e-b771-ba831ca94645",
                                                "text": "An extreme version of vorticity is a vortex. The vortex is a spinning, cyclonic mass of fluid, which can be observed in the rotation of water going down a drain, as well as in smoke rings, tornados and hurricanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8d9be3-0484-3ab2-9f53-ef1a6fd728c9",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "An access point or conduit for rainwater that drains directly downstream in a (drainage) basin without going through sewers or water treatment in order to prevent or belay floods."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38868cf6-b0bf-3667-911e-c4f876d9ae82",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "A natural or artificial watercourse which drains a tract of land."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b720704-f838-46c3-a8eb-7893c9c8fb87",
                                                "sense_id": "38868cf6-b0bf-3667-911e-c4f876d9ae82",
                                                "text": "Saganing Drain, Vermuyden's Drain, the South Drain river, Najafgarh drain"
                                            },
                                            {
                                                "example_id": "7e92b488-d726-40a1-946b-bb6761ac7eec",
                                                "sense_id": "38868cf6-b0bf-3667-911e-c4f876d9ae82",
                                                "text": "[…] the little runs and drains, that come through the hills, and to the sources of the creeks and their branches."
                                            },
                                            {
                                                "example_id": "37da5195-cadf-4b37-a4fb-66d7821541e7",
                                                "sense_id": "38868cf6-b0bf-3667-911e-c4f876d9ae82",
                                                "text": "The main drain of the country is the Walé nullah, which afterwards joins the Southern Ngombé and forms part of the system of the Malagarazi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af379a13-b2b3-3729-a430-2c46bd5ff96c",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "Something consuming resources and providing nothing in return."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7a7dec-c7ef-4271-ad4a-d6a448741373",
                                                "sense_id": "af379a13-b2b3-3729-a430-2c46bd5ff96c",
                                                "text": "That rental property is a drain on our finances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ffd4c5-15b2-3e1b-a8b8-424523d8c444",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "An act of urination."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29f4544f-df87-3924-a1fd-98a2e0ada6c0",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "One terminal of a field effect transistor (FET)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64c8fc45-b73f-374f-ae2e-1932e494bfd5",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "An outhole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f64fc3b-9a60-3cec-b432-7047df51ea35",
                                        "entry_id": "625cdfb0-af05-371a-8b77-a32cc197fc50",
                                        "glosses": [
                                            "A drink."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1e52658-6055-42f2-ba08-5fc4cc0498d4",
                                                "sense_id": "5f64fc3b-9a60-3cec-b432-7047df51ea35",
                                                "text": "When the play was over, we came out together, and I said, \"We've been very companionable and agreeable, and perhaps you wouldn't object to a drain?\""
                                            },
                                            {
                                                "example_id": "b42c92a1-c1fd-4dc6-a117-b522238f62c6",
                                                "sense_id": "5f64fc3b-9a60-3cec-b432-7047df51ea35",
                                                "text": "What did she want with money, except now and then for a drain of white satin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "516190b0-a64d-3756-a36c-536f0ef359cb",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To lose liquid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b694b3-daaf-4058-b574-3fee327b6338",
                                                "sense_id": "516190b0-a64d-3756-a36c-536f0ef359cb",
                                                "text": "The clogged sink drained slowly."
                                            },
                                            {
                                                "example_id": "12914d6d-deec-4ad3-ba26-ebb67e1790b1",
                                                "sense_id": "516190b0-a64d-3756-a36c-536f0ef359cb",
                                                "text": "Knock knock. / Who’s there? / Dwayne. / Dwayne who? / Drain the bathtub, I’m drowning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c22dc6d3-380c-35f0-bb7c-ab26a525a4f4",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To flow gradually."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4aed302-9ab9-4d7d-b069-3fc7ee8768da",
                                                "sense_id": "c22dc6d3-380c-35f0-bb7c-ab26a525a4f4",
                                                "text": "The water of low ground drains off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e9ea85-19ae-3e1d-acc1-90bf95661f17",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To cause liquid to flow out of."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da3622ce-8a93-413d-a072-c5606d0c1898",
                                                "sense_id": "46e9ea85-19ae-3e1d-acc1-90bf95661f17",
                                                "text": "Please drain the sink. It’s full of dirty water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2396adc8-3bdc-3e8d-baca-fc5a76b62101",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To convert a perennially wet place into a dry one."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74a17103-75d5-43ad-bffb-04bcddfc25a0",
                                                "sense_id": "2396adc8-3bdc-3e8d-baca-fc5a76b62101",
                                                "text": "They had to drain the swampy land before the parking lot could be built."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f39443e0-b443-3127-ba69-b16f30c6ad6a",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To deplete of energy or resources."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b0edd0b-e291-47c7-99ff-c23644a4560a",
                                                "sense_id": "f39443e0-b443-3127-ba69-b16f30c6ad6a",
                                                "text": "The stress of this job is really draining me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "745f1155-a24d-37cf-a235-3f6f9b080d05",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To draw off by degrees; to cause to flow gradually out or off; hence, to exhaust."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8a163c2-cc7c-48e6-848b-6b45702114a3",
                                                "sense_id": "745f1155-a24d-37cf-a235-3f6f9b080d05",
                                                "text": "Fountains drain the water from the ground adjacent."
                                            },
                                            {
                                                "example_id": "4c9f642c-587e-41fc-98be-8227c8cac5db",
                                                "sense_id": "745f1155-a24d-37cf-a235-3f6f9b080d05",
                                                "text": "At leaſt, I'm ſure I can fiſh it out of her. She's the very Sluce to her Lady's Secrets;—'Tis but ſetting her Mill agoing, and I can drein her of 'em all."
                                            },
                                            {
                                                "example_id": "63f27a7a-a79d-4619-b6ca-aa1012054c8c",
                                                "sense_id": "745f1155-a24d-37cf-a235-3f6f9b080d05",
                                                "text": "But it was not alone that he drained their treasure and hampered their industry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32859229-cc80-3e10-a395-70d9f52c4628",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To filter."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b5525b-cb60-42a7-b658-d3e29ee8aa0a",
                                                "sense_id": "32859229-cc80-3e10-a395-70d9f52c4628",
                                                "text": "Salt water, drained through twenty vessels of earth, hath become fresh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be371d43-e4a5-3847-9d54-6a32dcb00199",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To fall off the bottom of the playfield."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb695e53-5d0f-47df-80e8-61d6a0bb2508",
                                                "sense_id": "be371d43-e4a5-3847-9d54-6a32dcb00199",
                                                "text": "When a ball finally drains, it's gulped down by a giant gator beneath the set of flippers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9576386c-248f-334b-bcee-edd5edda900b",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To drink."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "963ca52a-602b-420f-ae57-8fe5fd97f538",
                                                "sense_id": "9576386c-248f-334b-bcee-edd5edda900b",
                                                "text": "But when I strove my flame to tell, / Says she, 'Come, stow that patter, / If you're a cove wot likes a gal, / Vy don't you stand some gatter?' / In course I instantly complied— / Two brimming quarts of porter, / With sev'ral goes of gin beside, / Drain'd Bet the Coaley's daughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749540b2-9e21-3c52-927b-944931b49a17",
                                        "entry_id": "aa620f13-f534-3666-96c4-a49750887c65",
                                        "glosses": [
                                            "To make a shot."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
