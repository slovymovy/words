                    {
                        "form_id": "e1dc9464-056a-4502-8050-e6ef19e74c3e",
                        "entry_id": "6aecea57-5ef2-328e-9e02-0cc9fa5dc5f2",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "aanrechtjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                        "entry_id": "6aecea57-5ef2-328e-9e02-0cc9fa5dc5f2",
                        "glosses": [
                            "vaste tafel met kastjes langs keukenwand voorzien van een waterbestendig aanrechtblad"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "63a55ddd-338d-4679-87fa-64e6a79a2153",
                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                "text": "De afwas van gisteren stond nog op het aanrecht."
                            },
                            {
                                "example_id": "7cf5a6c7-92c3-48ff-b9e4-b81f65ff4d35",
                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                "text": "Het enige recht van de huisvrouw was vroeger het aanrecht."
                            },
                            {
                                "example_id": "6250eb79-d1ca-4758-bc99-20582480c7c4",
                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                "text": "‘Volgende ronde,’ zei ze met een scheve grijns op haar gezicht en ze zette beide borden op het aanrecht."
                            },
                            {
                                "example_id": "0bf622f8-13bb-4d2c-8850-56d5fad36122",
                                "sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                                "text": "Hij staat zuchtend op en loopt naar de keuken die blauw ziet van de sigarettenrook. Meryem staat tegen het aanrecht en kijkt hem scherp aan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13e3b99d-23b8-44d0-beb2-b5c4b71cebf6",
                        "source_entry_id": "6aecea57-5ef2-328e-9e02-0cc9fa5dc5f2",
                        "source_sense_id": "b72ce866-0a46-3c0d-b94f-46078887d4bf",
                        "source_sense_description": "vaste tafel met kastjes langs keukenwand",
                        "target_lang_word": "Anrichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anrichte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43f6d2ac-b0c1-3bf5-aea0-3d7d9841e777",
                                        "entry_id": "c81b5e36-bc4a-35c9-acc1-9542f6e606cd",
                                        "glosses": [
                                            "Schrank mit einer Platte zum Abstellen von Geschirr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feffa9ef-d35a-4be4-9796-64a19cb037ad",
                                                "sense_id": "43f6d2ac-b0c1-3bf5-aea0-3d7d9841e777",
                                                "text": "„Er erhob sich und lief gebückt zur Anrichte.“"
                                            },
                                            {
                                                "example_id": "d4631129-92a0-43b2-a39a-8e719f9841b3",
                                                "sense_id": "43f6d2ac-b0c1-3bf5-aea0-3d7d9841e777",
                                                "text": "„Sie hängte das Bild über die kleine Anrichte in der Wohnstube und hoffte das Beste.“"
                                            },
                                            {
                                                "example_id": "ce1fd18d-065f-4565-92d0-b425d4d5e72d",
                                                "sense_id": "43f6d2ac-b0c1-3bf5-aea0-3d7d9841e777",
                                                "text": "„Hinter einer Anrichte stehen die Köche mit Kochhaube in blau-rot kariertem Rock und grinsen über alle vier Backen.“"
                                            },
                                            {
                                                "example_id": "c76013c5-31e0-4b0c-99e9-96d6bd8d7574",
                                                "sense_id": "43f6d2ac-b0c1-3bf5-aea0-3d7d9841e777",
                                                "text": "„Ein Radio war da, und auf einer Anrichte standen Gläser und Flaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
