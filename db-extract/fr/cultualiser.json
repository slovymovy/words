                "senses": [
                    {
                        "sense_id": "24ab2560-919b-370e-ae1c-f4e86b2d7192",
                        "entry_id": "a94bbf31-4eed-3779-a8a6-3a9b44e83f00",
                        "glosses": [
                            "Donner un caractère cultuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b48cbe3c-da2b-4427-93a2-355940624890",
                                "sense_id": "24ab2560-919b-370e-ae1c-f4e86b2d7192",
                                "text": "Autre limite perceptible dans cette volonté de « cultualiser » l’islam : une partie de cette religion échappe à toute tentative de « cultualisation », il s’agit de l’islam mystérieux et inquiétant des khouans…"
                            },
                            {
                                "example_id": "face8bed-d393-4b44-b833-e6f81bacdf07",
                                "sense_id": "24ab2560-919b-370e-ae1c-f4e86b2d7192",
                                "text": "La circulaire porte au passif de Weitling — et de tous ceux qui seraient ultérieurement tentés de l’imiter — d’avoir prétendu sacraliser et en quelque sorte « cultualiser » la Révolution."
                            }
                        ]
                    }
