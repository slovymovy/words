                                    {
                                        "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A fulfilment of a need or desire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32d0a7f-19ee-4357-8326-5dd3b50c5f2b",
                                                "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                                "text": "The witch, repository of hieratic lore and folk legends and occult arcana, became the distributor of philtres and unguents, electuaries and pastilles, herbs and charms and incantations - directed toward sexual pleasures and amatory satisfactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The pleasure obtained by such fulfillment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34259c4-c60b-473a-b42b-035929ff20c6",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "November 4, 1860, Henry David Thoreau, letter to Mr. D. R.\nThis life is not for complaint, but for satisfaction."
                                            },
                                            {
                                                "example_id": "7a9e0a5b-44e7-49bf-b2ac-5f1e4220978c",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "Selwyn, sitting up rumpled and cross-legged on the floor, after having boloed Drina to everybody's exquisite satisfaction, looked around at the sudden rustle of skirts to catch a glimpse of a vanishing figure—a glimmer of ruddy hair and the white curve of a youthful face, half-buried in a muff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bff076-83ba-3c86-81dd-8118a07497aa",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The source of such gratification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa560a67-e08d-308f-8633-5a534f01305a",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A reparation for an injury or loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A vindication for a wrong suffered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8dc26fd-bb59-431c-b7cb-fc84dded6dc9",
                                                "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                                "text": "The count demanded satisfaction in the form of a duel at dawn."
                                            },
                                            {
                                                "example_id": "60be5258-092d-487b-97d8-22cbc0f91c48",
                                                "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                                "text": "He is knight dubb'd with vnhatche'd Rapier, and on carpet conſideration, but he is a diuell in priuate brall, soules and bodies hath he diuorc'd three, and his incenſement at this moment is ſo implacable, that ſatisfaction can be none, but by pangs of death and ſepulcher: Hob, nob, is his word: giu't or take't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70eaccc-c774-3e97-90ae-2d4d43b7a16d",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "Sexual pleasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f8e87f0-53e0-4937-ba26-ab7866e2060f",
                                                "sense_id": "a70eaccc-c774-3e97-90ae-2d4d43b7a16d",
                                                "text": "To young man who enjoys receiving oral satisfaction, this BiWM will give you all you want."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f5a06d2-850a-42a3-b490-76d7eab68030",
                        "source_entry_id": "a02a0694-8cd7-34d7-aafc-df4462b00086",
                        "source_sense_id": "bd225814-8a37-3ad6-8199-cd63ad8905a6",
                        "source_sense_description": "iets waar men plezier aan beleeft",
                        "target_lang_word": "plaisir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaisir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Sentiment, sensation agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3153929f-9300-4e60-9c37-4d9586f5a500",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "« L’homme est né pour le plaisir : il le sent, il n’en faut point d’autre preuve. Il suit donc sa raison en se donnant au plaisir. »"
                                            },
                                            {
                                                "example_id": "05adaadc-1544-4154-92e7-364787e93a2b",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Bon vin, bons mots, gaillardes chansonnettes ;\nSont aiguillons aux amoureux désirs,\nEn toute porte entr’ouverte aux plaisirs\nL’adroit Amour aisément s’insinue."
                                            },
                                            {
                                                "example_id": "7348e426-0c05-4d1c-a606-b28ab6445d8f",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Dans Thomas l’imposteur, il avait combiné à une apparence de psychologie « rudimentaire » des aperçus ou constats très fins et pénétrants, dépatinant les sentiments les plus convenus (amour, plaisir, ambition), les sortant du lieu commun."
                                            },
                                            {
                                                "example_id": "42b130fc-8f02-4e6e-b9f2-8bbacfd15df3",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "J’eus le plaisir d’y admirer miss Gertrude Ederle, Ailen Riggin et Helen Wainwright, qui vinrent faire une démonstration de plongeons et de nages modernes."
                                            },
                                            {
                                                "example_id": "c67a1c83-c5c2-420b-936f-ddd792e2dbda",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Le Traité du plaisir de Maurice Bedel a été publié en 1945."
                                            },
                                            {
                                                "example_id": "7c50d512-960c-4f55-9e04-800e582afb6f",
                                                "sense_id": "7392c606-e92b-3de5-8bc3-e59bf2110c10",
                                                "text": "Depuis Michelet, on a aussi, bien souvent, incriminé l’influence exercée par le prêtre sur le comportement des épouses ; […]. En multipliant les interdits, il gênait l’épanouissement du plaisir des couples, quelle qu’ait pu être la valeur érotique de la transgression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Divertissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786eb312-6edb-4b00-ac50-0ede52d99ad8",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "Que faire donc ? je ne fume jamais ; la fidélité matrimoniale est bien ennuyeuse ; dans une intrigue où le cœur n'est que chatouillé on ne vise qu'au dénoûment : la promenade est mon unique plaisir ; triste plaisir à vingt ans !"
                                            },
                                            {
                                                "example_id": "bd9756f0-82f7-44d6-a5f4-4b6628d9ba42",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "Cette femme […] avait un goût décidé pour la dissipation et l’amusement : très bornée dans ses dépenses, elle ne pouvait se procurer les plaisirs dont elle était avide, ni consentir à s’en priver."
                                            },
                                            {
                                                "example_id": "0515c92d-3ce6-4d05-b460-b57e0f54c9d0",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "[…], des marchands d’un champagne dont la médiocrité n’était dépassée que par son prix qui ne cessait de monter, ne se préoccupaient plus, à Montmartre comme à Montparnasse, que d’adapter les soi-disants plaisirs de Paris à des images étrangères et le plus souvent chromolithographiques."
                                            },
                                            {
                                                "example_id": "72a847f3-36d2-44ec-a533-f0126a3811b0",
                                                "sense_id": "999e6d1b-b53d-3edb-bfe3-ac2f209ef375",
                                                "text": "Empêcher la vie des gens et leur plaisir devrait-il être permis ? De quoi se mêle un ministre ? De quel droit, avec quelle permission ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f025f234-bbad-3482-a230-6e636eca50db",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Volonté ; consentement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b54d3d8-663a-35dc-82ca-9b04dc533716",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Grâce ; faveur ; service ; bon office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bd0475-ab8f-4e58-afb1-64dec52866ce",
                                                "sense_id": "2b54d3d8-663a-35dc-82ca-9b04dc533716",
                                                "text": "C’est un homme qui ne cherche, qui ne demande qu’à faire plaisir. Faites-moi un plaisir."
                                            },
                                            {
                                                "example_id": "cd1c1def-ea9b-423f-9b41-adddf8b6b62f",
                                                "sense_id": "2b54d3d8-663a-35dc-82ca-9b04dc533716",
                                                "text": "Vous allez me faire le plaisir de vous torcher la figure et le sourire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff7242e2-b484-3d6c-9eaa-8c03b8b870eb",
                                        "entry_id": "080b43da-602f-3f0d-b7be-32ab42b3b780",
                                        "glosses": [
                                            "Espèce d’oublie légère, roulée en cornet."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71e8c20e-006c-4603-a53e-3f23563e001e",
                                                "sense_id": "ff7242e2-b484-3d6c-9eaa-8c03b8b870eb",
                                                "text": "C’étaient les vendeurs de plaisirs portant, sur le dos, leur grand cylindre rouge surmonté d’une tourniquet de loterie qui appelaient les promeneurs avec une crécelle et les invitaient à gagner leurs oublies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
