                "senses": [
                    {
                        "sense_id": "9fae1949-3a0c-3121-8e0a-7b36cf54ce52",
                        "entry_id": "0f87480f-bc35-3a67-9090-ea6e1925d9b9",
                        "glosses": [
                            "Receiving a stipend."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9d99a726-1706-42b4-9d50-6e53af927bda",
                                "sense_id": "9fae1949-3a0c-3121-8e0a-7b36cf54ce52",
                                "text": "His father, Mr. Justice Harley, died in his promising son's College term, bequeathing him nothing but his legal complexion, and Adrian became stipendiary officer in his uncles household."
                            },
                            {
                                "example_id": "ffc2ca64-b1b2-452f-ae71-c512f48d10d9",
                                "sense_id": "9fae1949-3a0c-3121-8e0a-7b36cf54ce52",
                                "text": "The unusual hour, appropriate as I supposed only to some porter or other stipendiary visitor of my hotel, caused to shine out with startling refulgence the morning splendors in which Papa Joliet had arrayed himself."
                            },
                            {
                                "example_id": "ae19aaf6-728a-48d1-99f9-098586347bf2",
                                "sense_id": "9fae1949-3a0c-3121-8e0a-7b36cf54ce52",
                                "text": "Now, to become a stipendiary editor of a New-Year's Gift-Book is not to be thought of, nor could I agree to work for any quantity of supply to such a publication."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
