                "senses": [
                    {
                        "sense_id": "6464f551-3da7-33ed-88fa-fb0254612bf7",
                        "entry_id": "f516e40f-dde6-320e-8ca6-e9f54feab67d",
                        "glosses": [
                            "militärische Körperstrafe, bei der der Verurteilte durch eine Gasse mehrerer Dutzend oder Hundert Soldaten gehen musste und von jedem einen Stockschlag erhielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3cbba4-a320-49a4-af7f-aad9a35fabb1",
                                "sense_id": "6464f551-3da7-33ed-88fa-fb0254612bf7",
                                "text": "„Es war, als habe damit das Spießrutenlaufen begonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "68549138-66c9-384f-8425-ec041808277c",
                        "entry_id": "f516e40f-dde6-320e-8ca6-e9f54feab67d",
                        "glosses": [
                            "Situation, in der jemandem die Feindseligkeit mehrerer Personen oder Behörden nacheinander entgegenschlägt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6a086a5b-9d2f-4c1d-9268-332aca4babe4",
                                "sense_id": "68549138-66c9-384f-8425-ec041808277c",
                                "text": "„Seit Heydrichs Amtsantritt war das Leben für Juden im Protektorat ein Spießrutenlaufen.“"
                            },
                            {
                                "example_id": "840a20f1-da67-4a87-b84d-0f67aeb837fb",
                                "sense_id": "68549138-66c9-384f-8425-ec041808277c",
                                "text": "„Während er sich, mühsam humpelnd und sich vor Schmerzen krümmend, zu seiner vor dem Eingang wartenden Kutsche schleppte, mußte er freilich noch ein regelrechtes Spießrutenlaufen in Kauf nehmen.“"
                            },
                            {
                                "example_id": "0ae416af-f7b2-4e6c-9b8b-9e355cfaef4e",
                                "sense_id": "68549138-66c9-384f-8425-ec041808277c",
                                "text": "„Noch ein paar Schritte, dachte Lillian, und das Spießrutenlaufen ist zu Ende.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
