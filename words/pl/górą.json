    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7c9f03e6-2d45-37df-a557-a92fc23035d6",
                    "sense_definition": "w górnej części, na pewnej wysokości, ponad czymś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Te kable puścimy teraz <w>górą</w>, tuż pod sufitem.",
                            "target_lang_translations": {
                                "ru": "Эти кабели мы пустим <w>поверху</w>, прямо под потолком.",
                                "en": "We'll run these cables <w>along the top</w> now, right beneath the ceiling."
                            }
                        },
                        {
                            "text": "Ptaki przelatywały <w>górą</w> nad naszymi głowami.",
                            "target_lang_translations": {
                                "ru": "Птицы пролетали <w>верхом</w> над нашими головами.",
                                "en": "Birds were flying <w>overhead</w> above our heads."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyżej",
                        "wysoko"
                    ],
                    "antonyms": [
                        "dołem"
                    ],
                    "common_phrases": [
                        "lecieć górą",
                        "iść górą"
                    ],
                    "target_lang_definitions": {
                        "ru": "в верхней части, на высоте, поверху",
                        "en": "in the upper part, overhead, above or at a height"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поверху",
                                "target_lang_sense_clarification": "в верхней части пространства"
                            },
                            {
                                "target_lang_word": "верхом",
                                "target_lang_sense_clarification": "по верхней части"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "overhead",
                                "target_lang_sense_clarification": "above in the air"
                            },
                            {
                                "target_lang_word": "above",
                                "target_lang_sense_clarification": "at a higher level"
                            },
                            {
                                "target_lang_word": "along the top",
                                "target_lang_sense_clarification": "running across an upper area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2c19635-bf84-360d-b79d-bdd08aebefd4",
                    "sense_definition": "drogą prowadzącą przez wzniesienie lub szczyt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ty pójdziesz <w>górą</w>, a ja pójdę doliną.",
                            "target_lang_translations": {
                                "ru": "Ты пойдешь <w>горой</w>, а я пойду долиной.",
                                "en": "You will go <w>over the mountain</w>, and I will take the valley."
                            }
                        },
                        {
                            "text": "Szlak turystyczny prowadzi <w>górą</w>, omijając dno wąwozu.",
                            "target_lang_translations": {
                                "ru": "Туристическая тропа ведет <w>верхом</w>, минуя дно ущелья.",
                                "en": "The hiking trail leads <w>along the ridge</w>, bypassing the gorge floor."
                            }
                        }
                    ],
                    "antonyms": [
                        "doliną",
                        "równiną"
                    ],
                    "common_phrases": [
                        "pójść górą"
                    ],
                    "target_lang_definitions": {
                        "ru": "дорогой, ведущей через возвышенность или вершину",
                        "en": "via an elevated route, ridge, or over a mountain"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горой",
                                "target_lang_sense_clarification": "путь через гору"
                            },
                            {
                                "target_lang_word": "верхом",
                                "target_lang_sense_clarification": "путь по возвышенности"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "over the top",
                                "target_lang_sense_clarification": "taking a route over a ridge or summit"
                            },
                            {
                                "target_lang_word": "via the ridge",
                                "target_lang_sense_clarification": "following high ground"
                            },
                            {
                                "target_lang_word": "over the mountain",
                                "target_lang_sense_clarification": "along an elevated path"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "962e3021-9abf-3742-9f91-3b80189d45cb",
                    "sense_definition": "w sytuacji przewagi, zwycięstwa nad kimś lub czymś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wygraliśmy ten trudny mecz, znowu jesteśmy <w>górą</w>!",
                            "target_lang_translations": {
                                "ru": "Мы выиграли этот трудный матч, мы снова <w>взяли верх</w>!",
                                "en": "We won that difficult match, we're <w>on top</w> again!"
                            }
                        },
                        {
                            "text": "W tym sporze rozsądek ostatecznie był <w>górą</w>.",
                            "target_lang_translations": {
                                "ru": "В этом споре здравый смысл в конечном счете <w>взял верх</w>.",
                                "en": "In this dispute, common sense ultimately <w>prevailed</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "być górą"
                    ],
                    "target_lang_definitions": {
                        "ru": "в ситуации превосходства, победы над кем-то или чем-то",
                        "en": "in a position of advantage, superiority, or victory"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять верх",
                                "target_lang_sense_clarification": "одержать победу (фразеологизм)"
                            },
                            {
                                "target_lang_word": "победить",
                                "target_lang_sense_clarification": "выиграть"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "on top",
                                "target_lang_sense_clarification": "in a winning or dominant position"
                            },
                            {
                                "target_lang_word": "victorious",
                                "target_lang_sense_clarification": "having won"
                            },
                            {
                                "target_lang_word": "having the upper hand",
                                "target_lang_sense_clarification": "having an advantage"
                            }
                        ]
                    }
                }
            ]
        },
        {
