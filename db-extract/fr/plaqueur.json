                        "sense_id": "308fa6d5-ad0b-3aa0-99c6-c203d91edc85",
                        "entry_id": "84f94f8c-e1c0-33da-bc36-20eb01d2b3dd",
                        "glosses": [
                            "Celui qui fait du placage, du plaqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52abecca-3604-4d84-a805-ec909f1aedb5",
                                "sense_id": "308fa6d5-ad0b-3aa0-99c6-c203d91edc85",
                                "text": "L’art du plaqueur."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec8fa89b-6422-30a7-953d-90855374330a",
                        "entry_id": "84f94f8c-e1c0-33da-bc36-20eb01d2b3dd",
                        "glosses": [
                            "Celui qui fait un plaquage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879d330e-4828-4edb-bcca-48ee68d49262",
                                "sense_id": "ec8fa89b-6422-30a7-953d-90855374330a",
                                "text": "Puis, il y a bien sûr le plaqueur Chris Jones et son acolyte Frank Clark à l’extrémité de la ligne défensive."
                            },
                            {
                                "example_id": "3ee29d8b-5ec5-4aa4-9047-4402c4b2d44f",
                                "sense_id": "ec8fa89b-6422-30a7-953d-90855374330a",
                                "text": "Il a frappé un grand coup du côté défensif en mettant la main sur le plaqueur Almondo Sewell et sur l'ailier Nick Usher."
                            },
                            {
                                "example_id": "ec2271b4-2a19-4453-bf85-d748f6357a3b",
                                "sense_id": "ec8fa89b-6422-30a7-953d-90855374330a",
                                "text": "Le plaquage soleil est un plaquage dangereux où le plaqueur fait passer les pieds du plaqué par dessus tête, augmentant les risques lors de la chute au sol."
                            }
                        ]
                    }
