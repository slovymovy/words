                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c77d0d95-0488-31e3-97e7-eadc5cc09e58",
                                        "entry_id": "417dd4c2-97e1-3dbc-b088-4820f2919772",
                                        "glosses": [
                                            "A method of purchasing an item, where the buyer hires it and takes possession of it and pays regular instalments. Ownership is only transferred on payment of the final amount. Abbreviated as HP."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14005819-ce63-49b6-9714-639b4c887b57",
                                                "sense_id": "c77d0d95-0488-31e3-97e7-eadc5cc09e58",
                                                "text": "Maggie Thatcher, you can't match her, she's the darling of us all. She's the curse of the Irish nation, Fine Gael and Fianna Fail. She's destroyed me hire purchase and she's put me on the dole. If I could only get my hands on her, I'd kick her up the hole!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "972dd42a-e0c5-4f43-81d7-9c39b4bb079a",
