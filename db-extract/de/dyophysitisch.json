                "senses": [
                    {
                        "sense_id": "182df4cb-abb6-3187-938e-216538a49d79",
                        "entry_id": "74937b3f-592f-3a00-bb93-1dc1a5203800",
                        "glosses": [
                            "sich auf den Dyophysitismus beziehend, den Dyophysitismus betreffend"
                        ],
                        "tags": [
                            "speziell Christentum"
                        ],
                        "examples": [
                            {
                                "example_id": "66668b2e-deee-43df-80f0-ed68d24e6069",
                                "sense_id": "182df4cb-abb6-3187-938e-216538a49d79",
                                "text": "„Ihre christologische Anschauung ist von einer Betonung der beiden Naturen in Christus geprägt, weswegen die Richtung auch als ‚dyophysitisch‘ beschrieben wird.“"
                            },
                            {
                                "example_id": "622bca83-4a70-44eb-80a4-0f6853edd811",
                                "sense_id": "182df4cb-abb6-3187-938e-216538a49d79",
                                "text": "„Der kaisertreue dyophysitische Wackelkopf konnte sich trotz mancher Widerstände in der Stadt eine Zeitlang halten, weil er Unterstützung aus den Klöstern in Kanopus erhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
