                "forms": [],
                "senses": [
                    {
                        "sense_id": "9bd3932a-26fc-3543-8c03-5cca54f4f73f",
                        "entry_id": "7e390e20-a1fd-393a-b5dc-efdf3d925bba",
                        "glosses": [
                            "nasekat, naštípat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef7e52c1-a5a4-4ffa-9313-e9b17498b017",
                                "sense_id": "9bd3932a-26fc-3543-8c03-5cca54f4f73f",
                                "text": "Ты посиди немножко, я дров наколю и печку растоплю, ты пока смели́ кофе.",
                                "translation": "Posaď se na chvilku, naštípám dříví a zatopím v kamnech, ty mezitím umel kafe."
                            }
                        ]
                    },
