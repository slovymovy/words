                    },
                    {
                        "translation_id": "f89f5aa7-c4d2-4053-88c7-3f623b71fb1d",
                        "source_entry_id": "88e96655-73f8-3ccb-ac6b-eec254d881c7",
                        "source_sense_id": "f31a86eb-1e5c-3880-89a8-b8c996dc42a8",
                        "target_lang_word": "Sinnbild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sinnbild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c11bd2d3-234f-3fee-a165-4d4ac12d027c",
                                        "entry_id": "ebc42237-fb97-33c0-96a0-a408c9700587",
                                        "glosses": [
                                            "konventionalisierte bildliche Darstellung eines abstrakten Sachverhalts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4258da4e-a0ac-422a-992b-ad9a38660a86",
                                                "sense_id": "c11bd2d3-234f-3fee-a165-4d4ac12d027c",
                                                "text": "Der Sensenmann ist ein Sinnbild des Todes."
                                            },
                                            {
                                                "example_id": "4c8da780-e816-401e-945b-ec90faf758fc",
                                                "sense_id": "c11bd2d3-234f-3fee-a165-4d4ac12d027c",
                                                "text": "„Was die Erfahrung des Bergsteigens zu einer Metapher des Lebens überhaupt werden lässt und sogar noch zum Sinnbild für die Suche nach dem ewigen Seelenheil, ist die Verbindung der kulturell positiv besetzten Vorstellung der Höhe mit der Abforderung einer körperlichen Leistung.“"
                                            },
                                            {
                                                "example_id": "718701a1-20f6-4b98-94fd-c822996ee0b6",
                                                "sense_id": "c11bd2d3-234f-3fee-a165-4d4ac12d027c",
                                                "text": "„Sein Sinnbild ist der Marabu, ein langbeiniger schöner Storchenvogel.“"
                                            },
                                            {
                                                "example_id": "dcab3acd-e378-4378-aab1-23d9ae905ee0",
                                                "sense_id": "c11bd2d3-234f-3fee-a165-4d4ac12d027c",
                                                "text": "„Linguistisch gesehen steht der Turmbau von Babel, das biblische Wahrzeichen vermessenen menschlichen Hochmuts, der vor dem Fall kommt, nicht nur als Sinnbild für die hernach auf der Erde herrschende Sprachenvielfalt, sondern auch für den uralten Sprachverfalls-Topos.“"
                                            },
                                            {
                                                "example_id": "369cbe24-6639-45ea-bd21-4372477f89dd",
                                                "sense_id": "c11bd2d3-234f-3fee-a165-4d4ac12d027c",
                                                "text": "„Es ist das Sinnbild der englischen Variante der Selbstdisziplin, der berühmten steifen Oberlippe, die allen Briten in Krisenzeiten ins Gesicht geschrieben steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e482cb45-6bcf-4dbb-b89e-70b327f90399",
                        "source_entry_id": "88e96655-73f8-3ccb-ac6b-eec254d881c7",
