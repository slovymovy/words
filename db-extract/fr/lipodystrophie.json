                            {
                                "example_id": "cc4ce38d-0099-436a-acc4-573ef8e81482",
                                "sense_id": "4590cd76-f1ed-37c8-a064-4b4ba02242d8",
                                "text": "Ce syndrome, appelé lipodystrophie, n’est actuellement pas élucidé dans son ensemble."
