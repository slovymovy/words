                "senses": [
                    {
                        "sense_id": "f9849a3c-aa1c-3e7c-9ac4-622928aedadd",
                        "entry_id": "954e1c54-91be-3c2f-9a8c-2884eafd3fea",
                        "glosses": [
                            "normale Lüftung bei An- oder auch Abwesenheit des Nutzers; Schaltstufe für Lüftungsanlagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0657618-3ea0-4a14-8d71-46ea55014e9c",
                                "sense_id": "f9849a3c-aa1c-3e7c-9ac4-622928aedadd",
                                "text": "„Die mittlere Stufe entspricht hier der Normallüftung.“"
                            },
                            {
                                "example_id": "52c1fece-0a43-483b-b41a-4e89e11cc399",
                                "sense_id": "f9849a3c-aa1c-3e7c-9ac4-622928aedadd",
                                "text": "„Bei Winterbetrieb der Normallüftung muss der vor dem Kühler vorgesehene elektrische Lufterhitzer zum Vorwärmen der Luft von -10°C auf +5°C in Betrieb genommen werden, um eine Einfrieren des eingeschalteten Kühlers auf jeden Fall zu vermeiden.“"
                            },
                            {
                                "example_id": "54396e90-de4c-46f5-9c44-7865e62d0128",
                                "sense_id": "f9849a3c-aa1c-3e7c-9ac4-622928aedadd",
                                "text": "„Als Rauch- und Wärmeabzugsgeräte werden Einzel- oder Doppelklappen integriert, die auch zur Normallüftung sowie zur Schönwetterlüftung angesteuert werden können.“"
                            },
                            {
                                "example_id": "cef662f1-a713-4a3d-ba0f-2a38406d81f4",
                                "sense_id": "f9849a3c-aa1c-3e7c-9ac4-622928aedadd",
                                "text": "„Geeignet für die Normallüftung, das heißt, in der Wohnung halten sich im Regelfall mehrere Bewohner auf.“"
                            },
                            {
                                "example_id": "5073458d-85ff-4d69-b66b-756225402505",
                                "sense_id": "f9849a3c-aa1c-3e7c-9ac4-622928aedadd",
                                "text": "„Bei Normallüftung ist der geplante Luftvolumenstrom einzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
