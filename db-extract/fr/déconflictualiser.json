                "senses": [
                    {
                        "sense_id": "ee67ec96-91f6-3f50-bada-303d58e83dcd",
                        "entry_id": "aa89b773-a020-385e-beb5-61f7da37da53",
                        "glosses": [
                            "Faire perdre son caractère conflictuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ca6f2f-c4fc-43b6-ba76-efaebb979682",
                                "sense_id": "ee67ec96-91f6-3f50-bada-303d58e83dcd",
                                "text": "Un jour, en voiture, alors que nous avions eu soudain une discussion un peu tendue, j’ai dit à mon garçon : il faut déconflictualiser les échanges."
                            },
                            {
                                "example_id": "aa9a649b-d3bf-460f-94d2-73b2565308b5",
                                "sense_id": "ee67ec96-91f6-3f50-bada-303d58e83dcd",
                                "text": "Servi par une volonté générale de réformation, il s’essaie donc à déconflictualiser, à purifier, à expulser de la cité tout ce qui est de l’ordre de la nuit."
                            }
                        ]
                    }
                ],
