                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "48b63c7b-da39-3631-9c44-3fdcce9fa504",
                                        "entry_id": "ea709f3d-d1fd-348c-bdf9-ac90f54fb955",
