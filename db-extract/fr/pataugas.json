                "senses": [
                    {
                        "sense_id": "6de3c032-045d-359c-8c87-11cad2eb949a",
                        "entry_id": "1dd4a71b-f358-398d-947d-f6f75709b344",
                        "glosses": [
                            "Chaussure de marche à l'origine en toile marron ou kaki, des modèles en cuir existent aussi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2276fce1-2c51-48e4-817d-dcea929d6759",
                                "sense_id": "6de3c032-045d-359c-8c87-11cad2eb949a",
                                "text": "Les Soldats de mon escadron revinrent ce jour avec des Pataugas tous neufs. J'étais fort étonné, j'interrogeai l'un d'eux :\n— Cela vient d'où ces Pataugas neufs que vous avez tous ?"
                            },
                            {
                                "example_id": "36ea8794-aa50-4559-bc41-be901bb3e48f",
                                "sense_id": "6de3c032-045d-359c-8c87-11cad2eb949a",
                                "text": "Comme nous portions les mêmes Pataugas, des sacs à dos de la même couleur et des Opinel identiques …, cela faisait de ma femme et moi les membres d'une même tribu aux yeux des Achuar..."
                            }
                        ]
                    }
                ],
