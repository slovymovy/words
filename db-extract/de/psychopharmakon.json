                ],
                "senses": [
                    {
                        "sense_id": "dd4aa7f9-8ad4-3a2c-bb2a-2e8b31408d91",
                        "entry_id": "fcba5087-e7e7-37b0-9185-58290efd2825",
                        "glosses": [
                            "Arzneistoff, der die seelische Verfassung beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88902fb-a2f2-4dd9-9d9b-679971ad4c50",
                                "sense_id": "dd4aa7f9-8ad4-3a2c-bb2a-2e8b31408d91",
                                "text": "„Immer mehr Kindern und Jugendlichen werden Psychopharmaka verschrieben.“"
                            },
                            {
                                "example_id": "f766e6b8-0add-4871-86d5-2af78e2067c9",
                                "sense_id": "dd4aa7f9-8ad4-3a2c-bb2a-2e8b31408d91",
                                "text": "„[Hans Hoffs] Verdienst war auch die systematische Eingliederung der medikamentösen Therapie (Psychopharmaka) in den Gesamtbehandlungsplan der ihm anvertrauten Patienten.“"
                            },
                            {
                                "example_id": "ec7b896b-f85a-4a8c-8954-131d526d53a6",
                                "sense_id": "dd4aa7f9-8ad4-3a2c-bb2a-2e8b31408d91",
                                "text": "„Ratten wurden mit Lithium – das ja bei Menschen als Psychopharmakon, z. B. gegen Depressionen dient – gefüttert.“"
                            },
                            {
                                "example_id": "cd9b125b-6451-48de-8e6b-c75e199d3f44",
                                "sense_id": "dd4aa7f9-8ad4-3a2c-bb2a-2e8b31408d91",
                                "text": "„Verabreicht unsere Gesellschaft ihren potenziellen Churchills zu schnell, zu leichtfertig ein Psychopharmakon?“"
                            },
                            {
                                "example_id": "ff459f94-b959-41c9-9534-02dd8523eaa2",
                                "sense_id": "dd4aa7f9-8ad4-3a2c-bb2a-2e8b31408d91",
                                "text": "„Dittmann (1987) fand heraus, daß von 790 Hamburger Schulanfängern im Alter zwischen 5 bis 7 Jahren 17,3% schon ein- oder mehrmals ein Psychopharmaka erhalten haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
