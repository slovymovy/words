                                "target_senses": [
                                    {
                                        "sense_id": "21af8ebb-f27a-3e1f-8b1c-f7be023884e1",
                                        "entry_id": "c9e0ba94-744c-3b73-9f02-2653e5bf2a47",
                                        "glosses": [
                                            "The practice of men splaying their legs open wide when sitting on public transport, thus occupying more than one seat."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad851d28-d04e-40e8-8512-f102b0c515bd",
                                                "sense_id": "21af8ebb-f27a-3e1f-8b1c-f7be023884e1",
                                                "text": "The new ads — aimed at curbing rude behavior like manspreading and wearing large backpacks on crowded trains — are set to go up in the subways next month."
                                            },
                                            {
                                                "example_id": "17a326c4-5418-4829-a4a1-230f48d87713",
                                                "sense_id": "21af8ebb-f27a-3e1f-8b1c-f7be023884e1",
                                                "text": "Manspreading is certainly bad manners in a crowded subway – and so is other stuff, like people wielding giant backpacks."
                                            },
                                            {
                                                "example_id": "f05554dd-dc50-4cd2-9c07-4e8f5138130a",
                                                "sense_id": "21af8ebb-f27a-3e1f-8b1c-f7be023884e1",
                                                "text": "Twitter, Snapchat and Instagram show thousands pictures of men engaging in this behaviour, and New York's transit authority launched a campaign against ‘manspreading’, with a Tumblr dedicated: Men Taking Up Too Much Space On The Train."
                                            },
                                            {
                                                "example_id": "7026d5aa-986d-440f-9430-32aeaabd36df",
                                                "sense_id": "21af8ebb-f27a-3e1f-8b1c-f7be023884e1",
                                                "text": "Manspreading creates stability for your pelvis and lower back. You can either position your feet together and let your knees fall to the sides or spread your feet wide."
                                            }
                                        ]
                                    }
                                ]
                            },
