    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "889e5104-4b41-3733-95ab-d98be17524ef",
                    "sense_definition": "aandacht aan iets of iemand geven",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet goed <w>letten</w> op de verkeersborden als je in een nieuwe stad rijdt.",
                            "target_lang_translations": {
                                "en": "You must <w>pay</w> close <w>attention</w> to the traffic signs when you drive in a new city.",
                                "ru": "Нужно внимательно <w>следить</w> за дорожными знаками, когда едешь в новом городе."
                            }
                        },
                        {
                            "text": "Tijdens het koken moet hij altijd goed <w>op</w> de <w>details</w> <w>letten</w>.",
                            "target_lang_translations": {
                                "en": "While cooking, he always has to <w>pay attention</w> to the details.",
                                "ru": "Во время готовки он всегда должен хорошо <w>обращать внимание</w> на детали."
                            }
                        }
                    ],
                    "synonyms": [
                        "opletten",
                        "acht slaan op"
                    ],
                    "antonyms": [
                        "verwaarlozen",
                        "negeren"
                    ],
                    "common_phrases": [
                        "op details letten",
                        "op de kleintjes letten",
                        "goed letten op"
                    ],
                    "target_lang_definitions": {
                        "en": "to pay attention to something or someone",
                        "ru": "уделять внимание чему-либо или кому-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay attention",
                                "target_lang_sense_clarification": "to focus one's mind on something"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to observe or look out for something"
                            },
                            {
                                "target_lang_word": "mind",
                                "target_lang_sense_clarification": "to be careful of or pay heed to"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обращать внимание",
                                "target_lang_sense_clarification": "сосредотачиваться на чем-то"
                            },
                            {
                                "target_lang_word": "следить",
                                "target_lang_sense_clarification": "внимательно наблюдать за чем-то"
                            },
                            {
                                "target_lang_word": "смотреть",
                                "target_lang_sense_clarification": "быть внимательным к чему-то"
                            }
                        ]
