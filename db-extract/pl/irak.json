                                            },
                                            {
                                                "example_id": "35b5a624-17a1-46a7-b5f0-ebb8821c64d8",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "Mosul ist die zweitgrößte Stadt Iraks."
                                            },
                                            {
                                                "example_id": "9c29b5b9-3d9b-430c-ad3d-ea9dda971676",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Im Nordosten hat der Irak Anteil an den schroffen und verkarsteten Ketten des Taurus und des Sagrosgebirges, im Süden und Südwesten an der syrisch-arabischen Wüste.“"
                                            },
                                            {
                                                "example_id": "cbf4ca99-5deb-4a31-b734-03ed399449ab",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Da im Irak unterschiedliche Niederschlagsverhältnisse herrschen, gibt es ebenfalls unterschiedliche Vegetationsarten. Im Nordirak gibt es Strauchvegetation und vereinzelte Waldbestände.“"
                                            },
                                            {
                                                "example_id": "c5448070-7f1a-4579-9f01-ea93ae0e7112",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Angesichts des Stillstands bei der Regierungsbildung im Irak hat der UN-Sicherheitsrat Fortschritte in Bagdad angemahnt.“"
                                            },
                                            {
                                                "example_id": "4ea3bbf7-2683-4886-9fad-38b782c43094",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Die verstärkten Anschläge im Irak stellen nach den Worten von US-Präsident Barack Obama nicht die Abzugspläne für die US-Kampftruppen bis Ende August infrage.“"
                                            },
                                            {
                                                "example_id": "ca060bb8-b94a-481e-b9bb-bc6488bf576e",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Auch mit ſeinem Halbbruder Mohammed mußte er hernach theilen h); dieſer behielt Aderbidſchan und ihm ſelbst blieb nur die Herrſchaft des Oſtens und die Oberlehnsherrſchaft über beide Irak.“ (1821)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
