{
    "word": "pileus",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                "word": "pileus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a71cf3d6-e4c6-4fbf-b0b4-6caca77e8b85",
                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "tags": [
                            "plural"
                        ],
                        "form": "pilei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aebcffba-616c-31df-aeb2-c524ec4dcdee",
                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "glosses": [
                            "The cap of a mushroom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d45bc34-42c7-4584-9217-4fc122a20fb4",
                                "sense_id": "aebcffba-616c-31df-aeb2-c524ec4dcdee",
                                "text": "The stem is easily separable from the pileus at its junction, in this respect being similar to Amanita, Amanitopsis, Lepiota and others."
                            },
                            {
                                "example_id": "41687784-db4f-47be-82b5-c76f0f5e231a",
                                "sense_id": "aebcffba-616c-31df-aeb2-c524ec4dcdee",
                                "text": "One must check the size and shape of the pileus as well as its color. Many weird and unexpected shapes are found in the mushroom kingdom."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bcca2c0-6f20-3796-b8ad-d2efb153c262",
                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "glosses": [
                            "The bell of a jellyfish."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "08198da1-eeb7-3590-9450-c7cad60e3777",
                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "glosses": [
                            "A small thin cloud attached to a cumulus cloud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55bb0056-9bfa-4922-af22-b337fddaec71",
                                "sense_id": "08198da1-eeb7-3590-9450-c7cad60e3777",
                                "text": "The most short-lived of all the accessory clouds, pileus is also the most beautiful."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6f374b3-ae2e-387e-befc-a9e5ac4472fd",
                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "glosses": [
                            "A conical felt hat worn in Ancient Rome and Greece."
                        ],
                        "tags": [
                            "Ancient-Rome",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "87533565-e4c5-46c9-992f-9f027ed806cd",
                                "sense_id": "e6f374b3-ae2e-387e-befc-a9e5ac4472fd",
                                "text": "Among the Romans the cap of felt was the emblem of liberty. When a slave obtained his freedom he had his head shaved, and wore instead of his hair an undyed pileus."
                            }
                        ]
                    },
                    {
                        "sense_id": "d27f663c-1eb4-3ac0-b8c8-c64b8d3bbd8a",
                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "glosses": [
                            "The top of the head of a bird, from the bill to the nape."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86be8446-187a-4406-8099-752ee6cce5ff",
                        "source_entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "source_sense_description": "the cap of a mushroom",
                        "target_lang_word": "klobouk",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klobouk",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "864ad674-f729-323f-b34c-33a14bb19b72",
                                        "entry_id": "cd679b07-4039-3a0e-8ab6-06c35d6d96d2",
                                        "glosses": [
                                            "pokrývka hlavy, která drží svůj vlastní tvar nezávislý na tvaru hlavy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "678545a7-4870-450b-a183-74c3f0d6093c",
                                                "sense_id": "864ad674-f729-323f-b34c-33a14bb19b72",
                                                "text": "Když vcházejí do kostela, divadla nebo vůbec kamkoli dovnitř, čeká se od pánů, že smeknou klobouky - dámy oproti tomu nemusí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baabe8d4-e16e-367d-aaf0-89b693bc7758",
                                        "entry_id": "cd679b07-4039-3a0e-8ab6-06c35d6d96d2",
                                        "glosses": [
                                            "část plodnice hub z podtřídy Agaricomycetidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7461081-2116-4ea6-83f1-1604ed94fd55",
                                                "sense_id": "baabe8d4-e16e-367d-aaf0-89b693bc7758",
                                                "text": "U tohoto druhu se odděluje noha od klobouku již v lese, bezprostředně po sebrání."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acb95db3-80a4-4ad1-9a98-458a6c4dfe66",
                        "source_entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "source_sense_description": "the cap of a mushroom",
                        "target_lang_word": "pileus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pileus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "039442f7-ec17-3283-a167-448af65668ff",
                                        "entry_id": "07fc27c6-fb0e-37ce-9c73-0835234dedda",
                                        "glosses": [
                                            "Bonnet de feutre dont se coiffaient les esclaves affranchis."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72fe4a1-3723-47d5-8055-e9b08fb18f40",
                                                "sense_id": "039442f7-ec17-3283-a167-448af65668ff",
                                                "text": "Dans la Rome antique, lors d'une cérémonie marquant l'affranchissement d'un esclave, son maître le coiffait du pileus symbole de sa liberté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcbceeba-2728-3e84-abd2-f8b817e0cca1",
                                        "entry_id": "07fc27c6-fb0e-37ce-9c73-0835234dedda",
                                        "glosses": [
                                            "Nuage annexe, en forme de bonnet ou de capuchon, qui se développe au-dessus du sommet d'un nuage convectif."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f7bccea-6df0-33d8-b987-2c3e436dbe33",
                                        "entry_id": "07fc27c6-fb0e-37ce-9c73-0835234dedda",
                                        "glosses": [
                                            "Nom scientifique du chapeau des champignons notamment chez les ascomycètes et les basidiomycètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "535639ad-e505-4569-8a38-47006f9e58a2",
                                                "sense_id": "8f7bccea-6df0-33d8-b987-2c3e436dbe33",
                                                "text": "Un coprin peut présenter un pileus de forme campanulée, puis étalée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67086f0e-5067-40d5-85ed-7f243e21a850",
                        "source_entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                        "source_sense_description": "the cap of a mushroom",
                        "target_lang_word": "Hut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56d77b6a-b8e3-3d4f-92de-61469fd3c54e",
                                        "entry_id": "756a0ec4-6526-35ac-818a-3f9ade612ecd",
                                        "glosses": [
                                            "an die Kopfform angepasste Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00daf47-8151-45ba-b628-01f181e29d7e",
                                                "sense_id": "56d77b6a-b8e3-3d4f-92de-61469fd3c54e",
                                                "text": "Das ist mein neuer Hut."
                                            },
                                            {
                                                "example_id": "461e9904-869a-4beb-9cf4-49d17f0c7a65",
                                                "sense_id": "56d77b6a-b8e3-3d4f-92de-61469fd3c54e",
                                                "text": "„Nichts als Hüte, Strohhüte und Filzhüte, Damenhüte und Herrenhüte, weiche Hüte und harte macht diese Stadt.“"
                                            },
                                            {
                                                "example_id": "f677238f-ce49-49e0-b6c9-27697c2c3cf3",
                                                "sense_id": "56d77b6a-b8e3-3d4f-92de-61469fd3c54e",
                                                "text": "„Sie hatte einen kleinen Rucksack auf dem Rücken, einen hübschen dunkelblauen Hut auf und den dicken blauen Wintermantel mit dem Pelzkragen an.“"
                                            },
                                            {
                                                "example_id": "237aacb2-37c3-420e-af54-1231c47348c8",
                                                "sense_id": "56d77b6a-b8e3-3d4f-92de-61469fd3c54e",
                                                "text": "„Ich sah, daß sie selbst einen Hut trug; es war eher eine kleine Kappe, ein schwarzes Nichts, das schief in ihrem Haar saß.“"
                                            },
                                            {
                                                "example_id": "3b7af055-92e4-4b3d-8500-d7c6210bed86",
                                                "sense_id": "56d77b6a-b8e3-3d4f-92de-61469fd3c54e",
                                                "text": "„In zwei Truhen transportierte die 45-Jährige ihre Petticoats, Korsetts und Hüte, aber auch Silber, Porzellan und Ölfarben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c31ce420-2440-3dff-b203-76fe97239d2d",
                                        "entry_id": "756a0ec4-6526-35ac-818a-3f9ade612ecd",
                                        "glosses": [
                                            "oberster Teil eines Ständerpilzes und mancher Schlauchpilze"
                                        ],
                                        "tags": [
                                            "Mykologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f57334b0-b047-4ccb-94a4-2a48a6fa6257",
                                                "sense_id": "c31ce420-2440-3dff-b203-76fe97239d2d",
                                                "text": "Der Hut der Maronen ist oft schmierig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c67f9f7d-333f-327d-a6a5-d7156010fd63",
                                        "entry_id": "fd001fcd-4f46-3e41-8988-90fbdf8f1f4c",
                                        "glosses": [
                                            "veraltet, nur noch redensartlich für Wache, Wacht oder auch Obhut"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
