                ],
                "senses": [
                    {
                        "sense_id": "b75e13b0-7eff-357d-876d-dd6576b28532",
                        "entry_id": "6a5f2d43-44b9-3cba-b17d-eb3d603ebaeb",
                        "glosses": [
                            "Feierlichkeit zum Anlass der Wiederkehr des Jahrestages, an dem eine Person geboren wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "297037d3-642e-4689-99f2-8ba188c5253a",
                                "sense_id": "b75e13b0-7eff-357d-876d-dd6576b28532",
                                "text": "Zur Geburtstagsfeier wurden mehr als 20 Gäste eingeladen."
                            },
                            {
                                "example_id": "70ba4c4a-f903-4678-9346-dfbc4d9b1200",
                                "sense_id": "b75e13b0-7eff-357d-876d-dd6576b28532",
                                "text": "„Wir waren hier auf Geburtstagsfeiern, Gartenfesten, Buchpremieren und einer Hochzeit.“"
                            },
                            {
                                "example_id": "35e358e6-18a1-414a-b1d1-ba3ba96b7de8",
                                "sense_id": "b75e13b0-7eff-357d-876d-dd6576b28532",
                                "text": "„Und wir verließen die Geburtstagsfeier des soeben dem Establishment zugealterten Gastgebers Arnulf und erholten uns beim Früh mit nem halve Hahn und Kölsch vom Köbes.“"
                            },
                            {
                                "example_id": "35572883-8de1-4602-96a3-6b4b394eba30",
                                "sense_id": "b75e13b0-7eff-357d-876d-dd6576b28532",
                                "text": "„Als die Geburtstagsfeier endete und der Wein im Zelt des Kaisers zur Neige ging, verabschiedete Napoleon seine Gäste mit der Order, am nächsten Morgen die Schlacht zu beginnen, gleich nach dem Frühstück.“"
                            },
                            {
                                "example_id": "3e3e8ec1-3ab2-4115-b63d-7c440ad81f79",
                                "sense_id": "b75e13b0-7eff-357d-876d-dd6576b28532",
                                "text": "„Im selben Jahr arrangierte Ernst Toller für den 50-jährigen in London eine Geburtstagsfeier, die ihn für einen Tag aus seiner Verlorenheit in der Millionenstadt riss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
