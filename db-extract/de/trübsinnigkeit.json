                "senses": [
                    {
                        "sense_id": "2f7de375-f935-3a90-b806-7078ac0caf9c",
                        "entry_id": "15435f3d-31ea-354d-9cc5-2b974043a1fa",
                        "glosses": [
                            "Zustand/Eigenschaft, melancholisch gestimmt zu sein, deprimierend zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347b6983-0fa6-4bb7-8869-6328ab6ca182",
                                "sense_id": "2f7de375-f935-3a90-b806-7078ac0caf9c",
                                "text": "„Mit seiner Weisheit und lockeren Art, half er mir oft aus der Trübsinnigkeit heraus.“"
                            },
                            {
                                "example_id": "ce58a1e3-b9cf-43b1-a26e-01f8dcebfc5d",
                                "sense_id": "2f7de375-f935-3a90-b806-7078ac0caf9c",
                                "text": "„Er pilgerte die breite Hauptstraße entlang, lauschte den Gesprächen und vergaß nach einer Weile seine Trübsinnigkeit.“"
                            },
                            {
                                "example_id": "fc1a6503-899a-4949-9365-493896806cb0",
                                "sense_id": "2f7de375-f935-3a90-b806-7078ac0caf9c",
                                "text": "„Bei Trübsinnigkeit und schlechter Laune sorgen Sie dafür, dass Glückshormone ausgeschüttet werden: lächelnd bewegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
