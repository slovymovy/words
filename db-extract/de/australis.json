                                "sense_id": "b43377eb-6fd9-357b-bde6-78b08beaca20",
                                "text": "Die Australis grenzt an die Paläotropis und die Antarktis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b1e5b048-7829-3bd7-b979-42b23983fc78",
                        "entry_id": "b917cb55-db0b-3c7c-bd0e-0d1f65d9f14f",
                        "glosses": [
                            "Faunenreich, das Australien, Neuseeland, Neuguinea und die Inseln Polynesiens umfasst"
                        ],
                        "tags": [
                            "Biogeografie",
                            "Tiergeographie"
                        ],
                        "examples": [
                            {
                                "example_id": "ff68c88d-f4fd-4bc7-967b-68bc8c7fb1c8",
                                "sense_id": "b1e5b048-7829-3bd7-b979-42b23983fc78",
                                "text": "Die Australis grenzt im Westen an die Orientalis, ein Teil der Paläotropis, im Norden an die Nearktis, im Osten an die Neotropis und im Süden an die Antarktis."
                            }
                        ],
