                                                "sense_id": "1490a277-8974-3590-829a-f7a62a761070",
                                                "text": "Chciałbym kiedyś zwiedzić ten stary budynek."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "3a3fc9fb-97a3-3858-971a-6bd36fb1ccd4",
