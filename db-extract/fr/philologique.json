                                        "glosses": [
                                            "die Philologie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac0ae56-3e0e-46fd-ad43-554728101ce9",
                                                "sense_id": "612ea66c-8fe1-3578-85fd-ede9e5a482a6",
                                                "text": "Texte in ihrer korrekten Form darzubieten ist eine wichtige philologische Aufgabe, die bei sehr alten Texten oft einen hohen Aufwand erfordert."
                                            }
