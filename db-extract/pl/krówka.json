                                    {
                                        "sense_id": "f127b219-9669-3e91-a1a2-e0e9f932fc4e",
                                        "entry_id": "c8aba2d1-aa3f-3cbd-bc29-aaf7684fed62",
                                        "glosses": [
                                            "Used in place of fuck."
