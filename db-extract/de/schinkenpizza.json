                "senses": [
                    {
                        "sense_id": "89b5475d-cb44-3b0c-989a-d66585dcbacf",
                        "entry_id": "4da161c1-efc2-327d-97ff-5d2e33b56405",
                        "glosses": [
                            "mit Schinken belegte Pizza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eb2cfad-e3ec-479b-b0c6-cc0f815bfa04",
                                "sense_id": "89b5475d-cb44-3b0c-989a-d66585dcbacf",
                                "text": "„Ich schüttelte wieder meinen Kopf und griff zum Schreibblock: ‚Pizza wäre nicht schlecht. Schinkenpizza ohne Pilze.‘“"
                            },
                            {
                                "example_id": "98eee951-9fe2-4975-9944-72039f162f19",
                                "sense_id": "89b5475d-cb44-3b0c-989a-d66585dcbacf",
                                "text": "„Unaufwendig im Vergleich zu den vielen Stunden Sport, die nötig wären, um sich die Schinkenpizza, den Salat, das Tiramisu und den dreiviertel Liter Cola wieder abzutrainieren.“"
                            },
                            {
                                "example_id": "15eba59d-510b-48cd-a567-48b295639806",
                                "sense_id": "89b5475d-cb44-3b0c-989a-d66585dcbacf",
                                "text": "„Wenig später standen sie bei ›Luigi‹ an den runden Tischchen. Danzik bestellte sich zum Prosecco ›Spaghetti al mare‹, sein Kollege Cola und Schinkenpizza.“"
                            },
                            {
                                "example_id": "6f4a1e3b-d27f-4d3b-b0f0-01046f77f242",
                                "sense_id": "89b5475d-cb44-3b0c-989a-d66585dcbacf",
                                "text": "„Besonders häufig seien die Beanstandungen in Gaststätten gewesen, wo in zwei Dritteln aller Fälle etwa für Schinkenpizza oder Schinkennudeln Imitate verwendet worden seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
