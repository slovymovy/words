                        "glosses": [
                            "Wintersportart, die mit Rodelschlitten betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ccb379-fa3d-4f3b-a3d9-431715c1040b",
                                "sense_id": "8b057f20-d90d-39b4-920e-cd15d174819f",
                                "text": "Im Rennrodeln sind deutsche Wintersportler besonders erfolgreich."
                            },
                            {
                                "example_id": "e36a4714-29eb-4d32-8b8e-a9b7df5b8a90",
                                "sense_id": "8b057f20-d90d-39b4-920e-cd15d174819f",
                                "text": "„In der Grundschule in Berchtesgaden wurde seine Leidenschaft fürs Rennrodeln geweckt.“"
                            },
                            {
                                "example_id": "10ddc5a4-f80b-45f9-8d9d-afacf9c4861d",
                                "sense_id": "8b057f20-d90d-39b4-920e-cd15d174819f",
                                "text": "„Im Bobsport, Rennrodeln, Biathlon, Langlauf und Eisschnelllauf konnten sie regelmäßig Medaillen in Welt-, Europameisterschaften und Olympischen Spielen gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
