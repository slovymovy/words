{
    "word_family": [
        "долг",
        "должник",
        "задолженность",
        "одолжить",
        "долженствовать"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19aba7de-9d0b-355a-aea6-c6a6790fb500",
                    "sense_definition": "Такой, какой требуется; надлежащий, подобающий правилам или ожиданиям.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "соответствующий_правилам",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Руководитель уделил этому важному вопросу <w>должное</w> внимание.",
                            "target_lang_translations": {
                                "pl": "Kierownik poświęcił tej ważnej kwestii <w>należytą</w> uwagę."
                            }
                        },
                        {
                            "text": "Все документы были оформлены <w>должным</w> образом и в срок.",
                            "target_lang_translations": {
                                "pl": "Wszystkie dokumenty zostały sporządzone w <w>należyty</w> sposób i na czas."
                            }
                        }
                    ],
                    "synonyms": [
                        "надлежащий",
                        "подобающий"
                    ],
                    "antonyms": [
                        "неподобающий"
                    ],
                    "common_phrases": [
                        "должным образом",
                        "должное внимание",
                        "отдать должное"
                    ],
                    "target_lang_definitions": {
                        "pl": "Taki, jaki jest wymagany; właściwy, odpowiedni, zgodny z zasadami lub oczekiwaniami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "należyty",
                                "target_lang_sense_clarification": "właściwy, odpowiedni"
                            },
                            {
                                "target_lang_word": "odpowiedni",
                                "target_lang_sense_clarification": "spełniający oczekiwania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d4c9251-abf8-30ef-9f29-7174b876fd86",
                    "sense_definition": "Обязанный совершить какое-либо действие (употребляется обычно в краткой форме с инфинитивом).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "модальность_обязанности",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый гражданин <w>должен</w> соблюдать законы своей страны.",
                            "target_lang_translations": {
                                "pl": "Każdy obywatel <w>powinien</w> przestrzegać praw swojego kraju."
                            }
                        },
                        {
                            "text": "Студенты <w>должны</w> сдать курсовые работы до конца недели.",
                            "target_lang_translations": {
                                "pl": "Studenci <w>muszą</w> oddać prace zaliczeniowe do końca tygodnia."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zobowiązany do wykonania jakiejś czynności; muszący coś zrobić."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powinien",
                                "target_lang_sense_clarification": "forma modalna oznaczająca powinność"
                            },
                            {
                                "target_lang_word": "musieć",
                                "target_lang_sense_clarification": "być zobowiązanym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87924d8b-de4e-36cc-a495-f5e18179e98d",
                    "sense_definition": "Имеющий финансовый долг или обязательство перед кем-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "финансовые_обязательства",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он остался <w>должен</w> банку крупную сумму денег после неудачной сделки.",
                            "target_lang_translations": {
                                "pl": "Po nieudanej transakcji został <w>winien</w> bankowi dużą sumę pieniędzy."
                            }
                        },
                        {
                            "text": "Я не хочу быть никому <w>должным</w> ни одной копейки.",
                            "target_lang_translations": {
                                "pl": "Nie chcę być nikomu <w>winien</w> ani grosza."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający dług finansowy lub zobowiązanie wobec kogoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "winien",
                                "target_lang_sense_clarification": "będący dłużnikiem"
                            },
                            {
                                "target_lang_word": "być winnym",
                                "target_lang_sense_clarification": "mieć dług finansowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "996704f2-810d-3b02-90d0-87a788e01bde",
                    "sense_definition": "Взятый взаймы и ещё не возвращённый кредитору.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "финансовые_обязательства",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Купец наконец собрал и передал кредиторам все <w>должные</w> суммы.",
                            "target_lang_translations": {
                                "pl": "Kupiec wreszcie zebrał i przekazał wierzycielom wszystkie <w>należne</w> sumy."
                            }
                        },
                        {
                            "text": "Старик аккуратно записал в книгу все свои <w>должные</w> деньги.",
                            "target_lang_translations": {
                                "pl": "Starzec starannie zapisał w księdze wszystkie swoje <w>dłużne</w> pieniądze."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pożyczony i jeszcze nieoddany wierzycielowi; należny komuś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "należny",
                                "target_lang_sense_clarification": "przysługujący komuś, pożyczony do oddania"
                            },
                            {
                                "target_lang_word": "dłużny",
                                "target_lang_sense_clarification": "przestarzale: stanowiący dług"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}