                        "examples": [
                            {
                                "example_id": "52429080-1729-4294-b8d0-9367325e7678",
                                "sense_id": "784f0351-171b-3eee-9475-a2d1828de776",
                                "text": "Het strandfeest in Hoek van Holland dat zondag exact een jaar na de rellen is gepland, gaat gewoon door. Volgens de gemeente Rotterdam ziet de organisator van het feest geen mogelijkheid om het op een andere datum te houden."
                            },
                            {
                                "example_id": "afe6a4d6-7ba3-4fdc-bc92-5a9d37ab8b8e",
                                "sense_id": "784f0351-171b-3eee-9475-a2d1828de776",
                                "text": "In de Thaise provincie Surat Thani zijn strandfeesten verboden na de moord op een Brits stel. De twee rugzaktoeristen werden vijf weken geleden doodgeslagen op het eiland Koh Tao."
                            }
