                "pos": "conj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d61257d-4234-3bfa-ab6a-ddfa6bd00607",
                        "entry_id": "47657a5a-cdf9-31dd-85df-3c4e153fa26c",
                        "glosses": [
                            "konsekutive Subjunktion, welche die Folge aus einer bekannten Tatsache einführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8935fa1f-be4a-478e-95de-3def69d9ccce",
                                "sense_id": "1d61257d-4234-3bfa-ab6a-ddfa6bd00607",
                                "text": "Er hat sich verletzt, sodass er beim Spiel nicht eingesetzt werden konnte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c3b845b-77b0-4ea2-9b81-d7d0f6a10ac9",
                        "source_entry_id": "47657a5a-cdf9-31dd-85df-3c4e153fa26c",
                        "source_sense_id": "1d61257d-4234-3bfa-ab6a-ddfa6bd00607",
                        "source_sense_description": "konsekutive Subjunktion, welche die Folge aus einer bekannten Tatsache einführt",
                        "target_lang_word": "so that",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so that",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce74804-54ec-3e5b-92de-a2cf3b0cd2cc",
                                        "entry_id": "2b66186e-3480-3e80-89fe-c9d2b8bea39b",
                                        "glosses": [
                                            "Indicates result; in order that, with the result that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08976bc4-375e-4ee0-8220-7049fb1c828d",
                                                "sense_id": "8ce74804-54ec-3e5b-92de-a2cf3b0cd2cc",
                                                "text": "He must die so that (as a result) others may/might live."
                                            },
                                            {
                                                "example_id": "1077a97f-0549-4625-a164-bb5db52c21a5",
                                                "sense_id": "8ce74804-54ec-3e5b-92de-a2cf3b0cd2cc",
                                                "text": "He seized his axe, which he had made very sharp, and as the leader of the wolves came on the Tin Woodman swung his arm and chopped the wolf's head from its body, so that it immediately died."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76de6cc0-3e1e-3d21-826b-5346d15600fd",
                                        "entry_id": "2b66186e-3480-3e80-89fe-c9d2b8bea39b",
                                        "glosses": [
                                            "Indicates purpose; in such a way that, with the intent that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f541263a-2e35-4ae0-bc1d-48dc5cc5d68f",
                                                "sense_id": "76de6cc0-3e1e-3d21-826b-5346d15600fd",
                                                "text": "He tied a complex knot so that others would find it hard to undo."
                                            },
                                            {
                                                "example_id": "2eeb2900-c575-44cc-ab2c-af81b1131d9e",
                                                "sense_id": "76de6cc0-3e1e-3d21-826b-5346d15600fd",
                                                "text": "The Bat—they called him the Bat.[…]. He'd never been in stir, the bulls had never mugged him, he didn't run with a mob, he played a lone hand, and fenced his stuff so that even the fence couldn't swear he knew his face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "196d41db-2332-4375-9ae1-f29285748110",
                        "source_entry_id": "47657a5a-cdf9-31dd-85df-3c4e153fa26c",
                        "source_sense_id": "1d61257d-4234-3bfa-ab6a-ddfa6bd00607",
                        "source_sense_description": "konsekutive Subjunktion, welche die Folge aus einer bekannten Tatsache einführt",
                        "target_lang_word": "si bien que",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "si bien que",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27f314de-7eef-36e7-84bd-840aab4f1b1d",
                                        "entry_id": "e4be487d-5cfb-3c2f-9bd0-032c237d3d7a",
                                        "glosses": [
                                            "Indique une conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c0dc952-a6b8-4acd-9a1c-ab746433c1f9",
                                                "sense_id": "27f314de-7eef-36e7-84bd-840aab4f1b1d",
                                                "text": "Le soir, les forçats regagnaient l'île Nou qui était en face, dans la baie et les soldats sortaient de la caserne : si bien qu’il y avait toujours quelque chose de curieux à regarder, dehors, pour un enfant."
                                            },
                                            {
                                                "example_id": "5ccdf1c4-e2c6-4572-8dad-58178d86b169",
                                                "sense_id": "27f314de-7eef-36e7-84bd-840aab4f1b1d",
                                                "text": "Le même phénomène anémochorique se produit évidemment lors de la dispersion des pollens, conduisant à des circulations géniques orientées, si bien que la pineraie agrégative se caractérise par un flux organisationnel, fondement d'un système diasporique: […]."
                                            },
                                            {
                                                "example_id": "6ed02d61-9f55-4a64-93f7-16a964cac8e5",
                                                "sense_id": "27f314de-7eef-36e7-84bd-840aab4f1b1d",
                                                "text": "Ces récits de braconnage sont inséparables de l'exagération si bien que beaucoup d'entre eux se sont mués en hâbleries, en contes de mensonge, invraisemblables et burlesques."
                                            },
                                            {
                                                "example_id": "b90c9f19-50d5-491a-976a-578881d64427",
                                                "sense_id": "27f314de-7eef-36e7-84bd-840aab4f1b1d",
                                                "text": "Ses parents, désemparés, avaient été impuissants à le calmer, si bien que sa fin fut un réel soulagement pour chacun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b93abac3-5678-48af-a16e-21711d4ce799",
                        "source_entry_id": "47657a5a-cdf9-31dd-85df-3c4e153fa26c",
                        "source_sense_id": "1d61257d-4234-3bfa-ab6a-ddfa6bd00607",
                        "source_sense_description": "konsekutive Subjunktion, welche die Folge aus einer bekannten Tatsache einführt",
                        "target_lang_word": "de sorte que",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de sorte que",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e624c93d-a458-38f4-a11b-076633ef5f25",
                                        "entry_id": "dec8ad45-151e-3384-936c-95b3cf400917",
                                        "glosses": [
                                            "Tellement que ; si bien que. — Note d’usage : Il est alors suivi d’un verbe à l’indicatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0827b858-5227-4693-9321-383d4470c4e1",
                                                "sense_id": "e624c93d-a458-38f4-a11b-076633ef5f25",
                                                "text": "Il n’en continua pas moins sa route, […] de sorte que, quelques minutes après, il franchissait la porte du château."
                                            },
                                            {
                                                "example_id": "4049abcb-3458-40e3-aa7b-f532bc7a50a1",
                                                "sense_id": "e624c93d-a458-38f4-a11b-076633ef5f25",
                                                "text": "Dans les provinces du sud, connues sous le nom de royaume de Maroc, on vend le blé à garare et à moud, […]. Il faut quarante mouds pour une garare. Le moud pèse 18 à 20 livres, de sorte que la garare doit peser près de 8 quintaux."
                                            },
                                            {
                                                "example_id": "8586bce3-4f53-494f-bc2d-52e6e9e0ec58",
                                                "sense_id": "e624c93d-a458-38f4-a11b-076633ef5f25",
                                                "text": "— (les Martiens, au moyen d’une drogue procurant des rêves magnifiques, supprimaient les malades, les infirmes et les mal nés, de sorte que, chez eux, la pitié était des plus rudimentaires) —"
                                            },
                                            {
                                                "example_id": "2e1538c1-ef26-416e-b1a0-905f15604da0",
                                                "sense_id": "e624c93d-a458-38f4-a11b-076633ef5f25",
                                                "text": "Solitaire endurci, M. des Lourdines aurait, à la rigueur, consenti à voir les gens, mais il ne voulait pas être vu, de sorte qu’on avait fini par le laisser se pelotonner dans son Fougeray, comme un pigeon dans son boulin."
                                            },
                                            {
                                                "example_id": "d2f481f8-7d4d-4c0c-97c1-c7c2d3f2285d",
                                                "sense_id": "e624c93d-a458-38f4-a11b-076633ef5f25",
                                                "text": "[…] ; ses variantes successives ont abouti à l'échelle MSK 64 (Medvelev, Sponheuer, Karnik) que l'on modifie de temps en temps, de sorte que l'on doit toujours rappeler l'année de la dernière mise à jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bececc-22f7-323f-a340-a0d45d6665e4",
                                        "entry_id": "dec8ad45-151e-3384-936c-95b3cf400917",
                                        "glosses": [
                                            "De manière que, pour que. — Note d’usage : Il est alors suivi d’un verbe au subjonctif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4a2457-9166-4637-98af-f8933354e3e0",
                                                "sense_id": "43bececc-22f7-323f-a340-a0d45d6665e4",
                                                "text": "Il va falloir déneiger cette route de sorte que nous puissions circuler facilement."
                                            },
                                            {
                                                "example_id": "f40ac7e7-5e51-4630-8223-d0f4882d699e",
                                                "sense_id": "43bececc-22f7-323f-a340-a0d45d6665e4",
                                                "text": "Marie avait laissé sa salle de bain ouverte de sorte que son amant y entrât."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65817715-dcef-4b1e-9a11-3f6450c91d22",
                        "source_entry_id": "47657a5a-cdf9-31dd-85df-3c4e153fa26c",
                        "source_sense_id": "1d61257d-4234-3bfa-ab6a-ddfa6bd00607",
                        "source_sense_description": "konsekutive Subjunktion, welche die Folge aus einer bekannten Tatsache einführt",
