                            {
                                "example_id": "7cbb1540-5b4e-45ba-9d19-cc434edccc3d",
                                "sense_id": "73f65fcd-1946-3c86-bd47-4b511bcd95cb",
                                "text": "Hij kan evengoed gaan zwemmen, ook al heeft hij een grote wond op zijn been."
                            },
                            {
                                "example_id": "5daa011b-76d1-4f00-9a30-226b484dbbc4",
                                "sense_id": "73f65fcd-1946-3c86-bd47-4b511bcd95cb",
                                "text": "Maar evengoed kan het gevaarlijk zijn in de Vallei der Dwaasheid. Zou je daarom eigenlijk wel meegaan? Jij bent veel te mooi om gevaar te lopen. Ik ben een mens, ik kan meer hebben dan jij.'"
                            },
                            {
                                "example_id": "d6b6d4f6-eb67-4cfa-b1fa-baa8ce0f4920",
                                "sense_id": "73f65fcd-1946-3c86-bd47-4b511bcd95cb",
                                "text": "Ze maakte zich evengoed zorgen over het geld en hij vermeed daarom de vraag of Hjalmar, wanneer hij verlof had gekregen uit het leger, verder wilde studeren. Het eindexamen was tenslotte slechts de eerste stap in het leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "96f4c18c-2f33-3686-a84a-6c35d4b73685",
                        "entry_id": "39b1e2e1-f7db-3bf0-b4ec-758481d38050",
