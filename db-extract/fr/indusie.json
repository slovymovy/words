                    }
                ],
                "senses": [
                    {
                        "sense_id": "afd64917-23a9-34af-bdda-a59a965420df",
                        "entry_id": "17cbbc8d-b783-3cd8-93ef-472715ab33c9",
                        "glosses": [
                            "Membrane protectrice recouvrant et protégeant les sporanges chez certaines fougères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd06d1c-000e-4526-a5e1-0f2addc21b70",
                                "sense_id": "afd64917-23a9-34af-bdda-a59a965420df",
                                "text": "Chez les Fougères à indusie (Adiantum, Aspidium), il faut couper les frondes fertiles du moment où l’indusie se lève et met à nu les sporanges."
                            }
                        ]
                    },
                    {
                        "sense_id": "03d93129-773f-3971-97b1-9966cbc774e0",
                        "entry_id": "17cbbc8d-b783-3cd8-93ef-472715ab33c9",
                        "glosses": [
                            "Voile membraneux ou lambeaux de voile recouvrant certains sporophores de champignons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a735984-e722-4145-96be-43c178c59f95",
                                "sense_id": "03d93129-773f-3971-97b1-9966cbc774e0",
                                "text": "Certains champignons du genre Phallus présentent une indusie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5df2364-5e46-3ffc-a722-8480092ad4e1",
                        "entry_id": "17cbbc8d-b783-3cd8-93ef-472715ab33c9",
                        "glosses": [
                            "Protection que construit avec divers débris la larve d'un insecte. Plus particulièrement, fourreau des larves de certains Trichoptères dont les Phryganes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406f6850-5ef4-40b8-81ee-d5e0676ccad3",
                                "sense_id": "f5df2364-5e46-3ffc-a722-8480092ad4e1",
                                "text": "La Phrygane est liée à son indusie moins intimement que la Lymnée à sa coquille, elle l'habite plutôt comme un Bernard- l'Ermite."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d433e80-1e4d-394d-a370-dde69a1034bc",
                        "entry_id": "17cbbc8d-b783-3cd8-93ef-472715ab33c9",
                        "glosses": [
                            "Calcaire à indusies. Roche formée par accumulation d'indusies de Phryganes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30193ff4-5ff0-4d10-b7b5-8d7bf3452bd1",
                                "sense_id": "0d433e80-1e4d-394d-a370-dde69a1034bc",
                                "text": "En plaine de Limagne (Auvergne), ces Trichoptères ont proliféré jusqu’à devenir, par leurs indusies, constructeurs de collines calcaires."
                            }
                        ]
                    }
                ],
