                                "target_senses": [
                                    {
                                        "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                        "entry_id": "0c1b73ea-8c6b-3330-a821-be8aebe634a5",
                                        "glosses": [
                                            "mit etwas anderem vereinbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b367a82-8036-4776-8eac-733c70e2bf8a",
                                                "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                                "text": "„Zu groß, zu kurz, zu lang – passende Kleidung zu finden, ist nicht immer einfach.“"
                                            },
                                            {
                                                "example_id": "784e2d0a-e495-42ed-bf3b-cded33b6dee9",
                                                "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                                "text": "Das ist das passende Modell."
                                            },
                                            {
                                                "example_id": "c73f2890-7af6-4977-a287-9ed0cad4ea4a",
                                                "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                                "text": "„Für deine Deutschkenntnisse ist das das passende Lehrbuch.“"
                                            },
                                            {
                                                "example_id": "da23185c-905d-47d9-8a4e-7fe348984ec5",
                                                "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                                "text": "„Du bist für das Vorstellungsgespräch nicht passend angezogen: Krawatte, Hemd, Sakko sind ein Must-have!“"
                                            },
                                            {
                                                "example_id": "703f9c54-c95c-47c6-a38c-6a2344705428",
                                                "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                                "text": "„Passend zum Motto von Veras und Dominiques Mitschülerinnen und Mitschülern ‚I wanna be a billionaire‘ ist Dagobert Duck als Symbolfigur, als Repräsentant, von Geld und Macht abgebildet.“"
                                            },
                                            {
                                                "example_id": "47808c89-3fb2-40ce-bb34-5ab7bba19cef",
                                                "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                                "text": "„Über 30 Bücher hat die amerikanische Soziologin Dr. Ruth Westheimer zum Thema Sex geschrieben. Passend zu ihrem 80. Geburtstag ist ihr aktuelles Buch auf Deutsch erschienen: \"Silver Sex\" ist ein Liebesratgeber für die Generation 50+.“"
                                            },
                                            {
                                                "example_id": "04acb5c2-f039-413f-8e09-559235ada6a9",
                                                "sense_id": "491715c9-d766-34ea-9069-35fc72b04a52",
                                                "text": "\"Es ist so, solche Gerichtssachen sind nie schön und sie kommen auch nie passend, weil man als Mutter einfach ohnehin schon sehr beschäftigt ist und belastet. Und das ist quasi eine Zusatzbelastung, die noch mal hinzukommt. Ja, schön war's nicht.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
