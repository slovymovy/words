                        "glosses": [
                            "Variante de matagraboliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12b0e7e9-21c4-49e7-9854-6133a1ed3217",
                                "sense_id": "33a2ae45-413d-341a-8032-6afe5f5ddc11",
                                "text": "Je ne fais pas de la modestie, car pour ceux qui m'accuseront de métagraboliser, j’ai ma conviction de poète, j’en rirais."
                            },
                            {
                                "example_id": "2d7c8028-d80d-4972-ae45-d7d8391e4bb8",
                                "sense_id": "33a2ae45-413d-341a-8032-6afe5f5ddc11",
                                "text": "L’officine semble avoir pour tâche d’étonner, de métagraboliser le bourgeois, de saper l’autorité et de préparer le peuple au « grand soir »."
                            }
                        ]
                    }
