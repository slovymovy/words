{
    "word_family": [
        "ontmoeting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3e50685-3b26-35dd-9eaf-d63da42a5eac",
                    "sense_definition": "met iemand kennismaken of bij elkaar komen om tijd samen door te brengen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sociale interactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil graag nieuwe mensen <w>ontmoeten</w> tijdens mijn vakantie in Spanje.",
                            "target_lang_translations": {
                                "en": "I would like to <w>meet</w> new people during my holiday in Spain.",
                                "ru": "Я бы хотел <w>познакомиться</w> с новыми людьми во время отпуска в Испании."
                            }
                        },
                        {
                            "text": "Zullen we elkaar morgen <w>ontmoeten</w> bij het station om samen te reizen?",
                            "target_lang_translations": {
                                "en": "Shall we <w>meet</w> at the station tomorrow to travel together?",
                                "ru": "Давай <w>встретимся</w> завтра у вокзала, чтобы поехать вместе?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elkaar ontmoeten",
                        "nieuwe mensen ontmoeten",
                        "iemand voor het eerst ontmoeten"
                    ],
                    "target_lang_definitions": {
                        "en": "to get to know someone or to come together to spend time together",
                        "ru": "познакомиться с кем-то или собраться вместе, чтобы провести время"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meet",
                                "target_lang_sense_clarification": "to get acquainted with someone"
                            },
                            {
                                "target_lang_word": "meet up",
                                "target_lang_sense_clarification": "to come together by arrangement"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "собираться вместе"
                            },
                            {
                                "target_lang_word": "знакомиться",
                                "target_lang_sense_clarification": "узнавать кого-то впервые"
                            },
                            {
                                "target_lang_word": "встретиться",
                                "target_lang_sense_clarification": "увидеться в назначенном месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "113d4156-3a57-3406-9d30-522079f77205",
                    "sense_definition": "iemand of iets toevallig tegenkomen zonder dat het gepland was",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "toevallige ontmoeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>ontmoette</w> mijn oude leraar toevallig in de supermarkt gisteren.",
                            "target_lang_translations": {
                                "en": "I <w>met</w> my old teacher by chance in the supermarket yesterday.",
                                "ru": "Вчера я случайно <w>встретил</w> своего старого учителя в супермаркете."
                            }
                        },
                        {
                            "text": "Tijdens onze wandeling in het bos <w>ontmoetten</w> we een groep herten.",
                            "target_lang_translations": {
                                "en": "During our walk in the forest, we <w>encountered</w> a group of deer.",
                                "ru": "Во время нашей прогулки в лесу мы <w>повстречали</w> группу оленей."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantreffen"
                    ],
                    "common_phrases": [
                        "toevallig ontmoeten",
                        "iemand op straat ontmoeten"
                    ],
                    "target_lang_definitions": {
                        "en": "to encounter someone or something by chance without it being planned",
                        "ru": "случайно встретить кого-то или что-то без предварительной договоренности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meet",
                                "target_lang_sense_clarification": "to come face to face with by accident"
                            },
                            {
                                "target_lang_word": "run into",
                                "target_lang_sense_clarification": "to encounter someone unexpectedly"
                            },
                            {
                                "target_lang_word": "encounter",
                                "target_lang_sense_clarification": "to come across something or someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "встретить",
                                "target_lang_sense_clarification": "случайно увидеть кого-то"
                            },
                            {
                                "target_lang_word": "столкнуться",
                                "target_lang_sense_clarification": "неожиданно встретиться"
                            },
                            {
                                "target_lang_word": "повстречать",
                                "target_lang_sense_clarification": "случайно наткнуться на кого-то или что-то"
                            }
                        ]
                    }
                }
            ]
        }
    ]
