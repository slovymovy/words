                    {
                        "sense_id": "67b34035-54f1-39e6-be0e-c4ac87b1864b",
                        "entry_id": "c2f4f293-a139-3e68-ad1a-6daaf8f90253",
                        "glosses": [
                            "een gat in een slot waardoor een sleutel moet worden gestoken om hem te openen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "118190b2-ce3f-3710-a755-f8a956070df2",
                        "entry_id": "c2f4f293-a139-3e68-ad1a-6daaf8f90253",
                        "glosses": [
                            "een gat in een deur waar men stiekem doorheen kan kijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc39153-ac62-49f5-a776-b87398cf19bb",
                                "sense_id": "118190b2-ce3f-3710-a755-f8a956070df2",
                                "text": "' Reede draaide zich om naar de deur, en ik durfde te zweren dat hij naar het sleutelgat keek."
                            },
                            {
                                "example_id": "81188e4a-59f5-4d6a-862c-5e25ceba270e",
                                "sense_id": "118190b2-ce3f-3710-a755-f8a956070df2",
                                "text": "Wie is er zo laat op de avond nog bij hem? Ze denkt al niet meer aan het lekkers voor Lucas en loopt zwijgend over de tegels naar de deur, waar ze zich laat zakken om door het sleutelgat te kijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29b443bf-396c-41c8-aa6e-d07f6929b522",
                        "source_entry_id": "c2f4f293-a139-3e68-ad1a-6daaf8f90253",
                        "source_sense_id": "67b34035-54f1-39e6-be0e-c4ac87b1864b",
                        "source_sense_description": "een gat in een slot waardoor een sleutel moet worden gestoken om hem te openen",
                        "target_lang_word": "Schlüsselloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlüsselloch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a06284a-32c4-3a99-aaa2-7e6811817a92",
                                        "entry_id": "9f740b3b-6af2-30d6-ad32-e4a5e6aca52b",
                                        "glosses": [
                                            "die Öffnung eines Schlosses, in welches ein Gegenstand zu Öffnung desjenigen eingesteckt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b27677e-bb08-4854-920a-afbfadeedcf9",
                                                "sense_id": "3a06284a-32c4-3a99-aaa2-7e6811817a92",
                                                "text": "Nur wenn der richtige Schlüssel im Schlüsselloch steckt, lässt sich die Tür öffnen."
                                            },
                                            {
                                                "example_id": "149f42f2-5ff3-4cf7-9685-c633a522112d",
                                                "sense_id": "3a06284a-32c4-3a99-aaa2-7e6811817a92",
                                                "text": "Mir ist der Schlüssel im Schlüsselloch abgebrochen."
                                            },
                                            {
                                                "example_id": "b6693bf6-4842-43c5-911e-1aa8080d8e8e",
                                                "sense_id": "3a06284a-32c4-3a99-aaa2-7e6811817a92",
                                                "text": "„Die Kellner, Friseure und Badediener sammeln besondere Erfahrungen; sie kennen jenen Ausschnitt der Welt, den man durch die Schlüssellöcher sieht.“"
                                            },
                                            {
                                                "example_id": "97887a3c-58dc-427a-85e2-6deae5053ecb",
                                                "sense_id": "3a06284a-32c4-3a99-aaa2-7e6811817a92",
                                                "text": "„Ich nahm ihren Platz am Schlüsselloch ein und erblickte tatsächlich die schöne Inesilla im Bett; doch wie fern war sie von jener Zurückhaltung, die ich immer an ihr beobachtet hatte.“"
                                            },
                                            {
                                                "example_id": "14d9dd12-4b82-4eab-ac9c-86b96f3cda54",
                                                "sense_id": "3a06284a-32c4-3a99-aaa2-7e6811817a92",
                                                "text": "„Der Graf legte das Ohr ans Schlüsselloch und begann zu lauschen.“"
                                            },
                                            {
                                                "example_id": "355fc2e5-0cee-4e35-a767-ff09fd0eed9b",
                                                "sense_id": "3a06284a-32c4-3a99-aaa2-7e6811817a92",
                                                "text": "„Fünf Minuten später sah ich durch das Schlüsselloch, wie sie in Begleitung Don Francescos hereinkamen; er zündete ihnen eine Nachtlampe an und ließ sie dann allein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
