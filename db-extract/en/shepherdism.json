                    {
                        "sense_id": "4a8e7e7e-2073-3a5b-96a5-e9bc21a32341",
                        "entry_id": "414cb5d6-7702-3c6c-8a63-a7b907e93068",
                        "glosses": [
                            "The theologically-based approach towards the environment propounded by Stephen M. Vantassel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9370899d-0e48-4eb8-9bfa-9b9d7932113a",
                                "sense_id": "4a8e7e7e-2073-3a5b-96a5-e9bc21a32341",
                                "text": "Shepherdism accepts the reality of human power but seeks to integrate that power into a comprehensive view of human-nature relations."
                            }
