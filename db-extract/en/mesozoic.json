                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                        "entry_id": "9092788e-357e-3850-ad88-abc4112416e3",
                        "glosses": [
                            "The Mesozoic era."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dcf22e3-0726-4c9e-a801-65628c93bb00",
                                "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                "text": "The whole history of the earth is divided into five eras, with corresponding rock-systems. These are: 1. Archæan or Eozoic¹ era, embodied in the Laurentian system; 2. Palæozoic² era, embodied in the Palæozoic or Primary system; 3. Mesozoic³ era, recorded in the Secondary system; 4. Cenozoic,⁴ recorded in the Tertiary and Quaternary systems; and, 5. The Psychozoic era, or era of Mind, recorded in the recent system."
                            },
                            {
                                "example_id": "43ef6be4-4898-4380-aa19-9d636e044d5e",
                                "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                "text": "The Mesozoic landscape of southeastern Utah can tell us much about the past, and it's one of the most intriguing and beautiful landscapes on Earth."
                            }
                        ]
                    }
                ],
