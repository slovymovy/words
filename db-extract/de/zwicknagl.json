                ],
                "senses": [
                    {
                        "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                        "entry_id": "3d49b5fb-4824-3798-9347-3c9ad278fcf3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fba7748-74c2-4f4c-8e99-2a928e9ea75f",
                                "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                                "text": "Frau Zwicknagl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "089be2d3-7f38-4a7a-8b66-edd259092672",
                                "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                                "text": "Herr Zwicknagl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "21bc1f53-0f57-48cf-91b9-2f487053066d",
                                "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                                "text": "Die Zwicknagls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "815fef79-236a-4f6a-975e-11bd71f2b5c2",
                                "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                                "text": "Der Zwicknagl trägt nie die Schals, die die Zwicknagl ihm strickt."
                            },
                            {
                                "example_id": "3aace2e6-41dd-40d6-af31-df83adcc4611",
                                "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zwicknagl kommt, geht der Herr Zwicknagl.“"
                            },
                            {
                                "example_id": "419d2edb-b96a-482f-b7e8-79c943b39890",
                                "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                                "text": "Zwicknagl kommt und geht."
                            },
                            {
                                "example_id": "74bd5185-e8cb-4ac5-b6ad-43479403ef51",
                                "sense_id": "ea29da4a-13c8-3453-a37d-046d3c4fc55e",
                                "text": "Zwicknagls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
