                                            {
                                                "example_id": "5d9a34d2-41b5-4801-bce1-9a70574c0b7f",
                                                "sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                                                "text": "Ik vermoed dat ergens onderweg datgene wat Isaac Robles ons wilde vertellen, verloren is geraakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "603db332-2ce7-328c-893a-cd924c888070",
                                        "entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                                        "glosses": [
                                            "onderweg zijn: bezig zijn zich van plek A naar plek B te verplaatsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0519eef-1f13-4856-a425-7be9bc25d043",
                                                "sense_id": "603db332-2ce7-328c-893a-cd924c888070",
                                                "text": "Het Utrechtse TivoliVredenburg wordt die week omgetoverd tot het Serious Request-hoofdkwartier. Ook vanuit die plek, met een radiostudio, krijgen de zwervende en onderweg radio makende presentatoren opdrachten ingefluisterd."
                                            },
                                            {
                                                "example_id": "b8264f5b-bc16-49ab-9028-b254c06f94a0",
                                                "sense_id": "603db332-2ce7-328c-893a-cd924c888070",
                                                "text": "Zo zat er in elke doos ontbijt, lunch en avondeten, maar ook al mijn snacks, repen en noten voor onderweg en papieren landkaarten voor de volgende etappe, nieuw wc-papier en om de 700 kilometer een paar nieuwe schoenen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
