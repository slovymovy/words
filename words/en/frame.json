{
    "word_family": [
        "framework",
        "framer",
        "framing",
        "reframe",
        "unframed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d81d46c-1177-3411-9719-3f2af216022b",
                    "sense_definition": "A rigid, usually rectangular border that surrounds and supports a picture, mirror, or similar object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "picture_mounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a silver <w>frame</w> for her wedding photograph.",
                            "target_lang_translations": {
                                "ru": "Она купила серебряную <w>рамку</w> для своей свадебной фотографии.",
                                "zh": "她为她的结婚照买了一个银色的<w>相框</w>。"
                            }
                        },
                        {
                            "text": "The painting looked much better once it was placed in a wooden <w>frame</w>.",
                            "target_lang_translations": {
                                "ru": "Картина смотрелась намного лучше, когда ее поместили в деревянную <w>раму</w>.",
                                "zh": "这幅画一旦装进木制<w>画框</w>里，看起来好多了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "picture frame",
                        "photo frame",
                        "window frame",
                        "wooden frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жесткая, обычно прямоугольная окантовка, которая окружает и поддерживает картину, зеркало или подобный предмет.",
                        "zh": "一种坚硬的、通常为矩形的边框，用于环绕和支撑图片、镜子或类似物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рамка",
                                "target_lang_sense_clarification": "для фотографий, небольшая"
                            },
                            {
                                "target_lang_word": "рама",
                                "target_lang_sense_clarification": "для картин, зеркал, окон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相框",
                                "target_lang_sense_clarification": "用于照片或小图片"
                            },
                            {
                                "target_lang_word": "画框",
                                "target_lang_sense_clarification": "用于画作或镜子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0595778c-580d-3e16-94c2-aa0723f8168c",
                    "sense_definition": "The main supporting structure of a building, vehicle, or other object that gives it shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frame</w> of the bicycle is made of lightweight aluminum.",
                            "target_lang_translations": {
                                "ru": "<w>Рама</w> велосипеда сделана из легкого алюминия.",
                                "zh": "这辆自行车的<w>车架</w>是用轻质铝材制成的。"
                            }
                        },
                        {
                            "text": "Once the steel <w>frame</w> is complete, the construction workers will add the walls.",
                            "target_lang_translations": {
                                "ru": "Как только стальной <w>каркас</w> будет готов, строители начнут возводить стены.",
                                "zh": "一旦钢制<w>框架</w>完成，建筑工人就会开始砌墙。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steel frame",
                        "bicycle frame",
                        "timber frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная несущая конструкция здания, транспортного средства или другого объекта, придающая ему форму.",
                        "zh": "建筑物、车辆或其他物体的支撑结构，使其具有形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каркас",
                                "target_lang_sense_clarification": "здания, сооружения"
                            },
                            {
                                "target_lang_word": "рама",
                                "target_lang_sense_clarification": "велосипеда, автомобиля"
                            },
                            {
                                "target_lang_word": "остов",
                                "target_lang_sense_clarification": "внутренняя основа, скелет конструкции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "框架",
                                "target_lang_sense_clarification": "通用的支撑结构"
                            },
                            {
                                "target_lang_word": "骨架",
                                "target_lang_sense_clarification": "建筑或物体的内部支撑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d97e53e2-2f7c-312f-8e28-e01d75fa0da1",
                    "sense_definition": "The size and shape of a person's body; one's physical build.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his small <w>frame</w>, he is surprisingly strong.",
                            "target_lang_translations": {
                                "ru": "Несмотря на хрупкое <w>телосложение</w>, он удивительно силен.",
                                "zh": "尽管他<w>体格</w>瘦小，但力气却大得惊人。"
                            }
                        },
                        {
                            "text": "The coat was too large for her slender <w>frame</w>.",
                            "target_lang_translations": {
                                "ru": "Пальто было слишком велико для ее стройной <w>фигуры</w>.",
                                "zh": "这件外套对她纤细的<w>身材</w>来说太大了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "small frame",
                        "large frame",
                        "slender frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размер и форма тела человека; физическое сложение.",
                        "zh": "一个人的身体大小和形状；体格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телосложение",
                                "target_lang_sense_clarification": "физическая комплекция"
                            },
                            {
                                "target_lang_word": "фигура",
                                "target_lang_sense_clarification": "очертания тела"
                            },
                            {
                                "target_lang_word": "костяк",
                                "target_lang_sense_clarification": "основа фигуры, скелет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体格",
                                "target_lang_sense_clarification": "身体的结构和强壮程度"
                            },
                            {
                                "target_lang_word": "身材",
                                "target_lang_sense_clarification": "身体的轮廓或外形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09133f11-648d-3645-8299-ca1bd1e744d4",
                    "sense_definition": "A single image in a sequence of pictures on photographic film or video.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Standard video is recorded at thirty <w>frames</w> per second.",
                            "target_lang_translations": {
                                "ru": "Стандартное видео записывается со скоростью тридцать <w>кадров</w> в секунду.",
                                "zh": "标准视频的录制速度为每秒三十<w>帧</w>。"
                            }
                        },
                        {
                            "text": "We paused the movie on a single <w>frame</w> to see the detail in the background.",
                            "target_lang_translations": {
                                "ru": "Мы поставили фильм на паузу на одном <w>кадре</w>, чтобы рассмотреть детали на заднем плане.",
                                "zh": "我们将电影暂停在单幅<w>画面</w>上，以观察背景中的细节。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "freeze frame",
                        "frame rate",
                        "frames per second"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное изображение в последовательности снимков на фотопленке или видео.",
                        "zh": "胶片或视频序列中的单个图像。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кадр",
                                "target_lang_sense_clarification": "фильма, видео"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帧",
                                "target_lang_sense_clarification": "视频或动画的单位"
                            },
                            {
                                "target_lang_word": "画面",
                                "target_lang_sense_clarification": "电影或视频中的单幅图像"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40564a42-fd73-3b73-a31d-693085ba7f03",
                    "sense_definition": "A particular context, period, or system used for understanding or planning something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project must be completed within a strict time <w>frame</w>.",
                            "target_lang_translations": {
                                "ru": "Проект должен быть завершен в строгие временные <w>рамки</w>.",
                                "zh": "该项目必须在严格的时间<w>范围</w>内完成。"
                            }
                        },
                        {
                            "text": "His argument makes sense within that specific <w>frame</w> of reference.",
                            "target_lang_translations": {
                                "ru": "Его аргумент имеет смысл в этой конкретной <w>системе</w> отсчета.",
                                "zh": "他的论点在那个特定的参考<w>框架</w>内是有道理的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "time frame",
                        "frame of reference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный контекст, период или система, используемые для понимания или планирования чего-либо.",
                        "zh": "用于理解或规划某事的特定背景、时期或系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рамки",
                                "target_lang_sense_clarification": "границы, пределы (напр. временные)"
                            },
                            {
                                "target_lang_word": "система",
                                "target_lang_sense_clarification": "в контексте системы отсчета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "界限或限度"
                            },
                            {
                                "target_lang_word": "框架",
                                "target_lang_sense_clarification": "参考系统或结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "326303fd-37ee-34ea-9b5f-309ae49fa205",
                    "sense_definition": "A particular mood or mental state.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was not in the right <w>frame</w> of mind to make such a big decision.",
                            "target_lang_translations": {
                                "ru": "Она была не в том <w>расположении</w> духа, чтобы принимать такое важное решение.",
                                "zh": "她当时没有合适的心情来做出如此重大的决定。"
                            }
                        },
                        {
                            "text": "Walking in the park always puts me in a happier <w>frame</w> of mind.",
                            "target_lang_translations": {
                                "ru": "Прогулка в парке всегда приводит меня в более счастливое <w>расположение</w> духа.",
                                "zh": "在公园散步总能让我处于更愉快的<w>心境</w>中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "frame of mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое настроение или психическое состояние.",
                        "zh": "特定的情绪或心理状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "духа"
                            },
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "психическое состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心境",
                                "target_lang_sense_clarification": "心理状态"
                            },
                            {
                                "target_lang_word": "情绪",
                                "target_lang_sense_clarification": "精神状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "505916ae-a211-3d16-bd02-e0ff02086c47",
                    "sense_definition": "A single game or round in sports such as snooker or bowling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needs to win the next <w>frame</w> to stay in the match.",
                            "target_lang_translations": {
                                "ru": "Ему нужно выиграть следующий <w>фрейм</w>, чтобы остаться в матче.",
                                "zh": "他需要赢得下一<w>局</w>才能留在比赛中。"
                            }
                        },
                        {
                            "text": "She bowled a strike in the final <w>frame</w>.",
                            "target_lang_translations": {
                                "ru": "Она выбила страйк в финальном <w>фрейме</w>.",
                                "zh": "她在最后一<w>轮</w>投出了全中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "final frame",
                        "deciding frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная партия или раунд в таких видах спорта, как снукер или боулинг.",
                        "zh": "斯诺克或保龄球等运动中的单局或单轮比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрейм",
                                "target_lang_sense_clarification": "в снукере, боулинге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "局",
                                "target_lang_sense_clarification": "斯诺克比赛单位"
                            },
                            {
                                "target_lang_word": "轮",
                                "target_lang_sense_clarification": "保龄球比赛单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d44cdde9-26c6-3a05-96c8-190551010aba",
                    "sense_definition": "To place a picture or object inside a decorative border.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "picture_mounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>frame</w> the poster and hang it in the hallway.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>вставить в раму</w> постер и повесить его в коридоре.",
                                "zh": "我们决定把海报<w>装裱</w>起来挂在走廊里。"
                            }
                        },
                        {
                            "text": "He <w>framed</w> his university degree to display it in his office.",
                            "target_lang_translations": {
                                "ru": "Он <w>вставил в рамку</w> свой университетский диплом, чтобы повесить его в офисе.",
                                "zh": "他把大学学位证书<w>装进框里</w>，挂在办公室展示。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "frame a picture",
                        "frame a photo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить картину или объект внутрь декоративной окантовки.",
                        "zh": "将图片或物体放入装饰性边框内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставить в раму",
                                "target_lang_sense_clarification": "картину, зеркало"
                            },
                            {
                                "target_lang_word": "обрамлять",
                                "target_lang_sense_clarification": "делать окантовку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装裱",
                                "target_lang_sense_clarification": "给画作加框"
                            },
                            {
                                "target_lang_word": "加框",
                                "target_lang_sense_clarification": "放入框中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cee839b6-f314-3fd4-8254-eb236c117bec",
                    "sense_definition": "To produce false evidence against an innocent person to make them appear guilty of a crime.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect claimed that the police tried to <w>frame</w> him for the robbery.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый заявил, что полиция пыталась <w>подставить</w> его в ограблении.",
                                "zh": "嫌疑人声称警方试图在抢劫案中<w>陷害</w>他。"
                            }
                        },
                        {
                            "text": "She realized someone was trying to <w>frame</w> her when the stolen money was found in her locker.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что кто-то пытается <w>подставить</w> ее, когда украденные деньги нашли в ее шкафчике.",
                                "zh": "当在她的储物柜里发现赃款时，她意识到有人在试图<w>栽赃</w>她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "set up"
                    ],
                    "common_phrases": [
                        "frame someone for murder",
                        "frame someone for a crime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сфабриковать ложные улики против невиновного человека, чтобы выставить его виновным в преступлении.",
                        "zh": "制造虚假证据陷害无辜者，使其看起来有罪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подставить",
                                "target_lang_sense_clarification": "ложно обвинить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陷害",
                                "target_lang_sense_clarification": "诬陷他人"
                            },
                            {
                                "target_lang_word": "栽赃",
                                "target_lang_sense_clarification": "通过伪造证据陷害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b847db45-1ddb-3954-ac9d-b8138d667522",
                    "sense_definition": "To express or formulate something in words, often to create a specific effect or context.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>frame</w> your question carefully to avoid offending anyone.",
                            "target_lang_translations": {
                                "ru": "Вам следует тщательно <w>сформулировать</w> свой вопрос, чтобы никого не обидеть.",
                                "zh": "你应该仔细<w>措辞</w>你的问题，以免冒犯任何人。"
                            }
                        },
                        {
                            "text": "The politician <w>framed</w> the debate as a choice between safety and freedom.",
                            "target_lang_translations": {
                                "ru": "Политик <w>представил</w> дебаты как выбор между безопасностью и свободой.",
                                "zh": "这位政治家将辩论<w>表述</w>为安全与自由之间的选择。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "frame a question",
                        "frame an argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выразить или сформулировать что-либо словами, часто для создания определенного эффекта или контекста.",
                        "zh": "用语言表达或制定某事，通常是为了创造特定的效果或背景。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сформулировать",
                                "target_lang_sense_clarification": "выразить словами"
                            },
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "подать в определенном свете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "措辞",
                                "target_lang_sense_clarification": "表达方式"
                            },
                            {
                                "target_lang_word": "表述",
                                "target_lang_sense_clarification": "以特定方式呈现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6039d6f-120a-3cf7-b1f1-1f467490513f",
                    "sense_definition": "To build the main structural elements of a house or other object.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They will start to <w>frame</w> the roof next week.",
                            "target_lang_translations": {
                                "ru": "Они начнут <w>возводить каркас</w> крыши на следующей неделе.",
                                "zh": "他们下周将开始<w>搭建</w>屋顶的框架。"
                            }
