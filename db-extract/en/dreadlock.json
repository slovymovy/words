                        "cross_references": [
                            {
                                "target_word": "dreadlock",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "10fc9bab-ec98-3765-8328-53ec7fa67231",
                                        "entry_id": "eed64a06-8724-3367-9a7d-fa4d2ddaa9f2",
                                        "glosses": [
                                            "dikke streng van vervilte, samengevlochten haren (als onderdeel van een kapsel dat uit zulke strengen bestaat), vooral bij rastafari's"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5323e24-839e-4f0f-a3ab-abb4b64a7966",
                                                "sense_id": "10fc9bab-ec98-3765-8328-53ec7fa67231",
                                                "text": "Er hangen lange, blonde lokken langs zijn gezicht, maar halverwege zijn kapsel ontstaat een enorme dreadlock, een gevaarte ter grootte van een babyzeehond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bc3cb47-d2a0-4667-b032-4a8ca557fed1",
                        "source_entry_id": "294d7fb3-08ee-3648-8661-49628212f52d",
                        "source_sense_id": "44c5b033-c3b1-3364-b6b7-08180eb08724",
                        "source_sense_description": "single strand of dreadlocks",
                        "target_lang_word": "dread",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dread",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a62dcb1-fbea-3cb1-b2fb-fe7e444e84c1",
                                        "entry_id": "5914b4a6-cfc0-3a44-9362-509d271af254",
                                        "glosses": [
                                            "Mèche de cheveux emmêlées naturellement, dreadlock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88373455-ad26-49ca-8761-3f1eda1a1479",
                                                "sense_id": "1a62dcb1-fbea-3cb1-b2fb-fe7e444e84c1",
                                                "text": "Avant toute chose, le principe d'une dread synthétique, c'est de ressembler à une vraie dreadlock, mais ce n'est pas une vraie dreadlock."
                                            },
                                            {
                                                "example_id": "022955e4-84cf-491f-ad21-59ad53082064",
                                                "sense_id": "1a62dcb1-fbea-3cb1-b2fb-fe7e444e84c1",
                                                "text": "A ma JAPD mon voisin avait une dread comme ça, avec le reste des cheveux courts et une clochette au bout."
                                            },
                                            {
                                                "example_id": "07eafd74-19d0-40dc-9184-33f887f1a5ab",
                                                "sense_id": "1a62dcb1-fbea-3cb1-b2fb-fe7e444e84c1",
                                                "text": "La technique pour obtenir des dreads de manière naturelle consiste... à ne rien faire !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38d9ee47-0b5b-4ae5-84c9-5d39ebd866af",
                        "source_entry_id": "294d7fb3-08ee-3648-8661-49628212f52d",
                        "source_sense_id": "44c5b033-c3b1-3364-b6b7-08180eb08724",
                        "source_sense_description": "single strand of dreadlocks",
                        "target_lang_word": "cadenette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadenette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c828c597-b25f-3265-8a8a-90197299b85e",
                                        "entry_id": "7ae24fcd-6011-3b4e-a41f-173f308dc1b3",
                                        "glosses": [
                                            "Longue mèche de cheveux qui pend sur la tempe gauche, tel que la portait le sire de Cadenet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687af5fd-cbbb-4b2d-afce-7570d5433459",
                                                "sense_id": "c828c597-b25f-3265-8a8a-90197299b85e",
                                                "text": "Il y avait toujours là Christian IV, avec sa belle cadenette tressée à côté de sa joue large, doucement bombée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bccdfbfe-c844-353f-8794-6ef9b5ee0dfc",
                                        "entry_id": "7ae24fcd-6011-3b4e-a41f-173f308dc1b3",
                                        "glosses": [
                                            "Coiffure militaire consistant en deux tresses de cheveux de chaque côté de la tête, qui fut portée par les grenadiers et les hussards du xviiᵉ siècle au début du xixᵉ siècle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78caf005-5f9a-44ef-a140-2c473bb0c358",
                                                "sense_id": "bccdfbfe-c844-353f-8794-6ef9b5ee0dfc",
                                                "text": "La nécessité des guenilles, des cadenettes et de la moustache aux talons n’est certainement pas démontrée d’une manière très-rigoureuse; mais l’éleveur de mules repousserait le baudet qui ne les porterait pas."
                                            },
                                            {
                                                "example_id": "3ff36c38-1a9b-4b85-aa4b-d9808b07fad6",
                                                "sense_id": "bccdfbfe-c844-353f-8794-6ef9b5ee0dfc",
                                                "text": "Les jeunes gens portaient les cheveux en cadenette à la guise des militaires."
                                            },
                                            {
                                                "example_id": "27f5747a-a4d6-4f41-803c-4512e2a39edf",
                                                "sense_id": "bccdfbfe-c844-353f-8794-6ef9b5ee0dfc",
                                                "text": "Les cheveux, tressés en cadenettes bleues, couvraient les oreilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ee4f16-14b2-325b-a038-63adb894872c",
                                        "entry_id": "7ae24fcd-6011-3b4e-a41f-173f308dc1b3",
                                        "glosses": [
                                            "Dreadlock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
