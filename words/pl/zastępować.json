                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niespodziewanie strażnik wybiegł zza rogu i <w>zastępował</w> drogę uciekającemu złodziejowi.",
