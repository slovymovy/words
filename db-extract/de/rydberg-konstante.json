                ],
                "senses": [
                    {
                        "sense_id": "0a7ab28b-f56d-34ad-a809-bd0be4ae2f16",
                        "entry_id": "16bea2bf-4195-307e-88b8-94854f4447be",
                        "glosses": [
                            "Naturkonstante, die nach Johannes Rydberg benannt wurde und zur Berechnung von Atomspektren verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f06463-6c94-4e11-8d4d-bf94b8c75512",
                                "sense_id": "0a7ab28b-f56d-34ad-a809-bd0be4ae2f16",
                                "text": "„Entweder müsse nun die sogenannte Rydberg-Konstante korrigiert werden, die am genauesten bestimmte Naturkonstante überhaupt, oder die QED beschreibe die Wechselwirkungen im Wasserstoff unzureichend, folgern die Physiker.“"
                            },
                            {
                                "example_id": "e9b8d87c-f8c0-49b3-ad18-8ea775c45da7",
                                "sense_id": "0a7ab28b-f56d-34ad-a809-bd0be4ae2f16",
                                "text": "„Indem die Forscher das Ergebnis mit einer früheren Messung einer anderen Spektrallinie kombinierten, konnten sie Werte für den Protonenradius und die sogenannte Rydberg-Konstante ableiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
