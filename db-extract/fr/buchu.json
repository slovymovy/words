                ],
                "senses": [
                    {
                        "sense_id": "42c2a142-24c3-37cc-8a6e-48d46e438d9d",
                        "entry_id": "77ddafb1-2049-3005-afbf-5a2efd8369d3",
                        "glosses": [
                            "Arbuste originaire d’Afrique du Sud, riche en huiles essentielles aux propriétés aromatiques et médicinales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0fb4680-3fbe-4b09-9061-00e10b08dce0",
                                "sense_id": "42c2a142-24c3-37cc-8a6e-48d46e438d9d",
                                "text": "Les feuilles de buchu (Agathosma Betulina) sont des agents naturels de neutralisation et de détoxication."
                            },
                            {
                                "example_id": "48ebabca-4474-44db-9773-040ba50d25d4",
                                "sense_id": "42c2a142-24c3-37cc-8a6e-48d46e438d9d",
                                "text": "Le buchu est d’introduction assez récente en thérapeutique et ne figure dans la pharmacopée française que depuis 1949."
                            },
                            {
                                "example_id": "0d5737ae-dad8-4b69-a389-a2f4f8f4fb77",
                                "sense_id": "42c2a142-24c3-37cc-8a6e-48d46e438d9d",
                                "text": "Le buchu nous vient d’Afrique du Sud, où il est utilisé depuis très longtemps pour ses vertus contre les infections urinaires, les rhumatismes, les troubles digestifs."
                            },
                            {
                                "example_id": "5e68d505-8ac4-425b-b2a4-6120f1333473",
                                "sense_id": "42c2a142-24c3-37cc-8a6e-48d46e438d9d",
                                "text": "Il aimait retrouver ces odeurs de cuisine, de feu de bois, de caramel, d’oignons crus ou de cannelle. Et aussi l’odeur de Zenzile, dont la peau sentait le buchu. Elle lui rappelait les effluves suaves de l’étable, du lait cru et du foin, les parfums de sa petite enfance, celui des seins de Nozipho, de ses cheveux laineux."
                            }
                        ]
                    }
                ],
