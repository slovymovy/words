                        "source_sense_id": "c27e1f09-340a-3db8-986e-3c0b0bc8310b",
                        "source_sense_description": "een dorp dat uit paalwoningen bestaat",
                        "target_lang_word": "cité lacustre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cité lacustre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b32a65-0d50-3398-a126-24d4160bae4e",
                                        "entry_id": "96fbcc27-92aa-36c3-adf8-42d95c28fb81",
                                        "glosses": [
                                            "Village, parfois très peuplé, construit sur des pilotis, au-dessus d’une étendue d’eau, de marais ou d’une zone fréquemment inondée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aab28a5-06d9-4839-8747-c63baa457466",
                                                "sense_id": "b3b32a65-0d50-3398-a126-24d4160bae4e",
                                                "text": "C’est un labyrinthe de petits îlots, de marécages inextricables. On raconte qu’au XIXe siècle, les esclaves qui s’étaient évadés venaient se réfugier ici. La ville de Sô-Ava, qui compte près de 118 000 habitants, est une cité lacustre située sur les rives du lac Nokoué, dans le sud du Bénin."
                                            },
                                            {
                                                "example_id": "baa43adb-2bf7-402f-b238-ced63cbbc23a",
                                                "sense_id": "b3b32a65-0d50-3398-a126-24d4160bae4e",
                                                "text": "Perchée sur pilotis au bord du lac Nokoué, la cité lacustre de Ganvié est l’une des perles du Bénin."
                                            },
                                            {
                                                "example_id": "cacd1c62-f73b-4c17-bc21-71d295dda673",
                                                "sense_id": "b3b32a65-0d50-3398-a126-24d4160bae4e",
                                                "text": "Elle aurait près de 8000 ans. Les traces archéologiques retrouvées au fond du lac d’Orhid, en Albanie, constituent les vestiges de la plus ancienne cité lacustre jamais retrouvée en Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
