                "senses": [
                    {
                        "sense_id": "ce7867bf-e84b-3a88-b9cf-356d8e419fbb",
                        "entry_id": "ae66f551-f49c-3d93-ac9c-3b88f8b23796",
                        "glosses": [
                            "die formlose Materie; der Urstoff, bevor er geformter Stoff wird"
                        ],
                        "tags": [
                            "nach Aristoteles"
                        ],
                        "examples": [
                            {
                                "example_id": "dc15e3fd-f138-4e5e-8a97-c2dd13e01653",
                                "sense_id": "ce7867bf-e84b-3a88-b9cf-356d8e419fbb",
                                "text": "Hyle ist nicht Nicht-sein, es ist Noch-nicht-sein."
                            },
                            {
                                "example_id": "a85524a0-e645-4632-8029-a9717d181d6c",
                                "sense_id": "ce7867bf-e84b-3a88-b9cf-356d8e419fbb",
                                "text": "Das Werden eines real existierenden Dinges lässt sich nach Aristoteles durch die Prinzipien von Hyle und Form/Formgebung erklären."
                            },
                            {
                                "example_id": "aa8c26be-b183-41d3-8eac-3b9dcb6697ec",
                                "sense_id": "ce7867bf-e84b-3a88-b9cf-356d8e419fbb",
                                "text": "„Die Hyle ist somit zwar notwendige Voraussetzung fur die körperhafte Welt, aber nicht im Sinne einer ersthaften Ursache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
