                "senses": [
                    {
                        "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                        "entry_id": "f6bbf882-9f1f-331f-918f-610fb77f9685",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e962f0-2d3e-4f32-ac70-9be8fd255d68",
                                "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                                "text": "Seibelts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "a42b52b2-2833-4e00-8e25-c7ae85cec666",
                                "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                                "text": "Frau Seibelt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7ba21acc-10b7-4af6-b578-8358aeb3551d",
                                "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                                "text": "Herr Seibelt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f137e33f-15c8-4b0f-8b98-7d6e0ee47308",
                                "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                                "text": "Die Seibelts fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "667fbc90-569e-4fea-a4c8-b511a8467fd0",
                                "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                                "text": "Der Seibelt trägt nie die Schals, die die Seibelt ihm strickt."
                            },
                            {
                                "example_id": "9132d82d-e7a1-4ba3-99df-709ff69f7a6e",
                                "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Seibelt kommt, geht der Herr Seibelt.“"
                            },
                            {
                                "example_id": "ac13ca16-9b81-4aa1-aa51-c02be103dbee",
                                "sense_id": "51b9c7df-adb0-30cd-8c3f-d7fa8bb0134f",
                                "text": "Seibelt kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
