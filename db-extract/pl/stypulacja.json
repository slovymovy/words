                                        "entry_id": "9c228fb8-c982-30d7-9b49-7579d1f2135d",
                                        "glosses": [
                                            "Something that is stated or stipulated as a condition of an agreement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eaccee1-76ad-4589-9a44-422e9b2f6f03",
                                                "sense_id": "077aeaf1-fc18-34cd-86c0-a4ce0537e092",
                                                "text": "The stipulations of the contract won't allow you to do that."
                                            },
                                            {
                                                "example_id": "96a8d8eb-36cc-44de-a9a3-83c97b1b0e16",
                                                "sense_id": "077aeaf1-fc18-34cd-86c0-a4ce0537e092",
                                                "text": "If I lend you my car, my only stipulation is that you fill up the gas tank before returning it."
                                            },
                                            {
                                                "example_id": "643ba494-c684-42ca-8cff-f8c2834d0e30",
                                                "sense_id": "077aeaf1-fc18-34cd-86c0-a4ce0537e092",
                                                "text": "The acts authorising the subsequent Underground lines would include a stipulation that cheap early morning fares be provided, and the Cheap Trains Act of 1883 would standardise the terms for all railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d989ab6c-bdc4-3cc2-b635-2cc4fccd33c1",
                                        "entry_id": "9c228fb8-c982-30d7-9b49-7579d1f2135d",
                                        "glosses": [
                                            "The situation, arrangement, and structure of the stipules."
