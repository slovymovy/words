                "senses": [
                    {
                        "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                        "entry_id": "4e09316a-4483-3c96-a728-ced0304efb94",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3419c25c-d45a-4f73-bccd-39d1613b7ff6",
                                "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                                "text": "Frau Cizek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ec16c556-e3b7-4248-91a7-aeba19a68684",
                                "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                                "text": "Herr Cizek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "087df30c-6285-4727-b4c0-b7078ac21f64",
                                "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                                "text": "Die Cizeks kommen heute aus dem Frankenwald."
                            },
                            {
                                "example_id": "f35de5c1-fc50-4cbe-ad18-03d18c2d0599",
                                "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                                "text": "Der Cizek trägt nie die Schals, die die Cizek ihm strickt."
                            },
                            {
                                "example_id": "60fd2b20-b8a4-44f2-b99e-775db7e65628",
                                "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cizek kommt, geht der Herr Cizek.“"
                            },
                            {
                                "example_id": "d840e6a8-2563-446f-a9ab-fbb2dbc27dbd",
                                "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                                "text": "Cizek kommt und geht."
                            },
                            {
                                "example_id": "6d0102ac-be45-4547-98ea-7e21f00dbdfe",
                                "sense_id": "e56995b6-09c7-3229-9392-1897b1b02042",
                                "text": "Cizeks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
