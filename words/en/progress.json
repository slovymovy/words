                        "zh": "向前方或朝特定目标方向的移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвижение",
                                "target_lang_sense_clarification": "перемещение в пространстве"
                            },
                            {
                                "target_lang_word": "движение вперёд",
                                "target_lang_sense_clarification": "поступательное движение"
