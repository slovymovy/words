                "senses": [
                    {
                        "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                        "entry_id": "4110abd2-137a-3b04-b79a-20987bb77eae",
                        "glosses": [
                            "de uitslag bepalend, beslissend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c94b63-607c-4c7b-a095-7e9f46fecae3",
                                "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                                "text": "- Deze voorverkiezing bleek van doorslaggevender belang dan oorspronkelijk gedacht."
                            },
                            {
                                "example_id": "d85353e0-72b8-4481-9f18-76601b352c5a",
                                "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                                "text": "- Het eerste argument bleek al van doorslaggevende betekenis te zijn."
                            },
                            {
                                "example_id": "c358f727-a177-414f-88ff-8c57d0a3065d",
                                "sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                                "text": "Maar als je één ding kunt leren van Poetins oorlogen in Tsjetsjenië, Georgië, Oekraïne, Syrië of Noord-Afrika, is het wel dat economische redenen niet doorslaggevend zijn bij zijn keus voor grof geweld. Oorlog is irrationeel, en dat is iets wat velen in Europa helaas zijn vergeten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4fe185d-1f09-47ae-a135-f2ff319ad406",
                        "source_entry_id": "4110abd2-137a-3b04-b79a-20987bb77eae",
                        "source_sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
                        "target_lang_word": "décisif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décisif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d78ba2-5ee5-3379-8f2f-9edbb543b251",
                                        "entry_id": "2b2cd668-c4f7-3d05-87fb-7b5eea470ffa",
                                        "glosses": [
                                            "Qui emporte la décision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d31e32-876f-4cb2-82f4-45f739f15235",
                                                "sense_id": "b7d78ba2-5ee5-3379-8f2f-9edbb543b251",
                                                "text": "Un avantage décisif"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "178571e2-498d-3e0d-b336-44738bfa2cf7",
                                        "entry_id": "2b2cd668-c4f7-3d05-87fb-7b5eea470ffa",
                                        "glosses": [
                                            "Qui décide ; qui apporte une solution ; qui est déterminant."
                                        ],
                                        "tags": [
                                            "En parlant de choses"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "816f8647-ca23-44cb-aa4e-ef350d0f8af7",
                                                "sense_id": "178571e2-498d-3e0d-b336-44738bfa2cf7",
                                                "text": "La laïcité est engagée dans une lutte âpre et décisive contre le cléricalisme. L'État se bat contre l'Église."
                                            },
                                            {
                                                "example_id": "3ef4f815-a766-4ab7-b7ea-3015c6b36eba",
                                                "sense_id": "178571e2-498d-3e0d-b336-44738bfa2cf7",
                                                "text": "Pour les gens de ma génération, Platini, c'est le top du top. Platinix. Celui qui arrivait avec sa potion magique pour nous qualifier dans les matchs décisifs."
                                            },
                                            {
                                                "example_id": "2eb84e24-45ac-4193-bde1-19c9968b49fb",
                                                "sense_id": "178571e2-498d-3e0d-b336-44738bfa2cf7",
                                                "text": "La pièce décisive d’un procès, le point décisif de la cause."
                                            },
                                            {
                                                "example_id": "06ba896e-5a30-4f7f-b856-80404c419177",
                                                "sense_id": "178571e2-498d-3e0d-b336-44738bfa2cf7",
                                                "text": "Un évènement, un fait, un jugement, un moment, un rôle décisif."
                                            },
                                            {
                                                "example_id": "295dded4-2e95-488f-b656-071d91cfae81",
                                                "sense_id": "178571e2-498d-3e0d-b336-44738bfa2cf7",
                                                "text": "Une raison, une preuve, une expérience décisive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bed7f018-b2e5-3f4a-976a-9d54a9e8306d",
                                        "entry_id": "2b2cd668-c4f7-3d05-87fb-7b5eea470ffa",
                                        "glosses": [
                                            "Qualifie la passe permettant à un partenaire de marquer un panier (basketball), un but (football, handball), un essai (rugby), etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11c50203-7849-3a9c-b2af-2b4c4e4c4842",
                                        "entry_id": "2b2cd668-c4f7-3d05-87fb-7b5eea470ffa",
                                        "glosses": [
                                            "Qui dénote dans la décision une hardiesse mêlée de quelque arrogance, en parlant des personnes et de leurs actions."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c90857c1-bfc5-4069-8d4d-4bc7fbb42507",
                                                "sense_id": "11c50203-7849-3a9c-b2af-2b4c4e4c4842",
                                                "text": "Il eut tort de citer le mot de Voltaire, qui est beaucoup trop décisif et immodéré : « L’écriture est la peinture de la voix ; plus elle est ressemblante, meilleure elle est », et qui conduirait à l’orthographe individuelle, c’est-à-dire à une confusion telle qu’on ne se comprendrait jamais quand on s’écrirait les uns aux autres ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed7ce68-5c40-433c-a995-7f40b355c0cd",
                        "source_entry_id": "4110abd2-137a-3b04-b79a-20987bb77eae",
                        "source_sense_id": "9e040980-f700-3b11-a97b-e46738aaf8d4",
