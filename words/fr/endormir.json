                    ]
                },
                {
                    "sense_id": "a9ff9757-ec8c-3b5e-8b58-c1195e954d84",
                    "sense_definition": "Rendre insensible une partie du corps par le froid, une mauvaise posture ou un anesthésique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dentiste applique un produit local pour <w>endormir</w> la douleur avant d'intervenir."
                        },
                        {
                            "text": "Je suis resté assis trop longtemps et cette mauvaise posture m'a <w>endormi</w> la jambe."
                        }
                    ],
                    "synonyms": [
                        "engourdir",
                        "anesthésier"
                    ],
                    "common_phrases": [
