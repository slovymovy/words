{
    "word_family": [
        "peaky",
        "peaked"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0aab4362-fe30-31ea-90d9-0d8f18de4342",
                    "sense_definition": "The pointed top of a mountain, hill, or ridge.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see the snowy <w>peaks</w> from our hotel window.",
                            "target_lang_translations": {
                                "ru": "Из окна нашего отеля мы видели заснеженные <w>вершины</w>.",
                                "fr": "Nous pouvions voir les <w>pics</w> enneigés depuis la fenêtre de notre hôtel."
                            }
                        },
                        {
                            "text": "It took them three days to climb to the <w>peak</w> of the mountain.",
                            "target_lang_translations": {
                                "ru": "Им потребовалось три дня, чтобы подняться на <w>вершину</w> горы.",
                                "fr": "Il leur a fallu trois jours pour grimper jusqu'au <w>sommet</w> de la montagne."
                            }
                        }
                    ],
                    "synonyms": [
                        "summit",
                        "top",
                        "pinnacle",
                        "apex"
                    ],
                    "antonyms": [
                        "base",
                        "bottom",
                        "foot"
                    ],
                    "common_phrases": [
                        "mountain peak",
                        "snowy peak",
                        "highest peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остроконечная вершина горы, холма или хребта.",
                        "fr": "La partie la plus élevée et pointue d'une montagne, d'une colline ou d'une crête."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "самая верхняя часть горы"
                            },
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "остроконечная вершина"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pic",
                                "target_lang_sense_clarification": "sommet pointu d'une montagne"
                            },
                            {
                                "target_lang_word": "sommet",
                                "target_lang_sense_clarification": "partie la plus élevée d'une montagne"
                            },
                            {
                                "target_lang_word": "cime",
                                "target_lang_sense_clarification": "partie la plus haute d'une montagne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61406788-240d-3a26-8c21-b78eb9069f8e",
                    "sense_definition": "The point when something is at its highest level, value, strength, or success.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete retired when he was at the <w>peak</w> of his career.",
                            "target_lang_translations": {
                                "ru": "Спортсмен ушёл из спорта, когда был на <w>пике</w> своей карьеры.",
                                "fr": "L'athlète a pris sa retraite alors qu'il était au <w>sommet</w> de sa carrière."
                            }
                        },
                        {
                            "text": "Traffic usually reaches a <w>peak</w> around five in the evening.",
                            "target_lang_translations": {
                                "ru": "Движение обычно достигает <w>пика</w> около пяти вечера.",
                                "fr": "La circulation atteint généralement un <w>pic</w> vers dix-sept heures."
                            }
                        }
                    ],
                    "synonyms": [
                        "maximum",
                        "high point",
                        "zenith",
                        "acme",
                        "height",
                        "top",
                        "pinnacle"
                    ],
                    "antonyms": [
                        "low",
                        "trough",
                        "minimum",
                        "nadir"
                    ],
                    "common_phrases": [
                        "at the peak",
                        "reach a peak",
                        "past its peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Момент, когда что-либо находится на высшем уровне, имеет наибольшую ценность, силу или успех.",
                        "fr": "Le moment ou le point où quelque chose atteint son niveau, sa valeur, sa force ou son succès le plus élevé."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "высшая точка развития"
                            },
                            {
                                "target_lang_word": "максимум",
                                "target_lang_sense_clarification": "наибольшее значение"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pic",
                                "target_lang_sense_clarification": "moment le plus haut d'une évolution"
                            },
                            {
                                "target_lang_word": "sommet",
                                "target_lang_sense_clarification": "degré le plus haut"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e762779-0c66-3a28-82a4-006c30131eab",
                    "sense_definition": "The sharp or pointed end of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should beat the cream until it forms stiff <w>peaks</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует взбивать сливки до образования устойчивых <w>пиков</w>.",
                                "fr": "Vous devez battre la crème jusqu'à ce qu'elle forme des <w>pointes</w> fermes."
                            }
                        },
                        {
                            "text": "The roof of the old house rises to a sharp <w>peak</w>.",
                            "target_lang_translations": {
                                "ru": "Крыша старого дома сходится в острый <w>пик</w>.",
                                "fr": "Le toit de la vieille maison s'élève en une <w>pointe</w> acérée."
                            }
                        }
                    ],
                    "synonyms": [
                        "point",
                        "tip"
                    ],
                    "common_phrases": [
                        "stiff peaks",
                        "widow's peak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый или заострённый конец чего-либо.",
                        "fr": "L'extrémité pointue ou acérée de quelque chose."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остриё",
                                "target_lang_sense_clarification": "острый конец"
                            },
                            {
                                "target_lang_word": "кончик",
                                "target_lang_sense_clarification": "крайняя часть чего-либо"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pointe",
                                "target_lang_sense_clarification": "extrémité acérée"
                            },
                            {
                                "target_lang_word": "bout",
                                "target_lang_sense_clarification": "extrémité d'un objet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84ffa842-14e7-3de6-a72d-3f057cfc7616",
                    "sense_definition": "The flat curved part at the front of a cap that sticks out to protect the eyes from the sun.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cap_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled the <w>peak</w> of his cap down to shield his eyes.",
                            "target_lang_translations": {
                                "ru": "Он натянул <w>козырёк</w> кепки, чтобы защитить глаза.",
                                "fr": "Il a abaissé la <w>visière</w> de sa casquette pour se protéger les yeux."
                            }
                        },
                        {
                            "text": "The baseball cap has a stiff <w>peak</w>.",
                            "target_lang_translations": {
                                "ru": "У бейсболки жёсткий <w>козырёк</w>.",
                                "fr": "La casquette de baseball a une <w>visière</w> rigide."
                            }
                        }
                    ],
                    "synonyms": [
                        "visor",
                        "bill"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская изогнутая часть спереди кепки, выступающая для защиты глаз от солнца.",
                        "fr": "La partie plate et incurvée à l'avant d'une casquette qui dépasse pour protéger les yeux du soleil."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "козырёк",
                                "target_lang_sense_clarification": "часть головного убора"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "visière",
                                "target_lang_sense_clarification": "partie d'une casquette protégeant les yeux"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05753215-ce41-3b00-a4c4-7692fc8d8fb8",
                    "sense_definition": "Used to describe the time when something is at its highest level or greatest extent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hotel prices are much higher during the <w>peak</w> season.",
                            "target_lang_translations": {
                                "ru": "Цены в отелях намного выше в <w>пиковый</w> сезон.",
                                "fr": "Les prix des hôtels sont beaucoup plus élevés pendant la saison <w>de pointe</w>."
                            }
                        },
                        {
                            "text": "We advise customers to avoid traveling during <w>peak</w> hours.",
                            "target_lang_translations": {
                                "ru": "Мы советуем клиентам избегать поездок в часы <w>пик</w>.",
                                "fr": "Nous conseillons aux clients d'éviter de voyager pendant les heures <w>de pointe</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "maximum",
                        "highest",
                        "top"
                    ],
                    "antonyms": [
                        "off-peak"
                    ],
                    "common_phrases": [
                        "peak season",
                        "peak hours",
                        "peak time",
                        "peak performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания времени, когда что-либо находится на высшем уровне или имеет наибольший размах.",
                        "fr": "Utilisé pour décrire la période où quelque chose est à son niveau le plus élevé ou à son intensité maximale."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиковый",
                                "target_lang_sense_clarification": "относящийся к максимуму нагрузки"
                            },
                            {
                                "target_lang_word": "максимальный",
                                "target_lang_sense_clarification": "наивысший"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "de pointe",
                                "target_lang_sense_clarification": "période de forte activité"
                            },
                            {
                                "target_lang_word": "maximal",
                                "target_lang_sense_clarification": "au plus haut niveau"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8703cc8-1535-3dfb-89f0-c422e99e251a",
                    "sense_definition": "Representing the most extreme, typical, or quintessential example of a type or behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wearing socks with sandals is <w>peak</w> dad fashion.",
                            "target_lang_translations": {
                                "ru": "Носки с сандалиями — это <w>верх</w> отцовской моды.",
                                "fr": "Porter des chaussettes avec des sandales, c'est le <w>summum</w> de la mode des papas."
                            }
                        },
                        {
                            "text": "That awkward interview was <w>peak</w> television.",
                            "target_lang_translations": {
                                "ru": "Это неловкое интервью было <w>верхом</w> телевидения.",
                                "fr": "Cette interview gênante était le <w>summum</w> de la télévision."
                            }
                        }
                    ],
                    "synonyms": [
                        "quintessential",
                        "archetypical",
                        "ultimate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий собой самый крайний, типичный или совершенный пример типа или поведения.",
                        "fr": "Représentant l'exemple le plus extrême, typique ou parfait d'un type ou d'un comportement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верх",
                                "target_lang_sense_clarification": "высшая степень чего-либо"
                            },
                            {
                                "target_lang_word": "типичный",
                                "target_lang_sense_clarification": "характерный пример"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "le summum",
                                "target_lang_sense_clarification": "le degré le plus élevé"
                            },
                            {
                                "target_lang_word": "l'apogée",
                                "target_lang_sense_clarification": "le point culminant"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c479414-2dac-363c-add0-71bba55f3f29",
                    "sense_definition": "To reach the highest point, value, or level.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_maximum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Temperatures are expected to <w>peak</w> at thirty degrees this afternoon.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что температура <w>достигнет пика</w> в тридцать градусов сегодня днём.",
                                "fr": "Les températures devraient <w>atteindre un pic</w> de trente degrés cet après-midi."
                            }
                        },
                        {
                            "text": "Her interest in the hobby <w>peaked</w> last year and has since declined.",
                            "target_lang_translations": {
                                "ru": "Её интерес к хобби <w>достиг пика</w> в прошлом году и с тех пор снизился.",
                                "fr": "Son intérêt pour ce passe-temps a <w>culminé</w> l'année dernière et a décliné depuis."
                            }
                        }
                    ],
                    "synonyms": [
                        "culminate",
                        "climax",
                        "top out"
                    ],
                    "antonyms": [
                        "bottom out"
                    ],
                    "common_phrases": [
                        "peak early",
                        "peak at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигать высшей точки, значения или уровня.",
                        "fr": "Atteindre le point, la valeur ou le niveau le plus élevé."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать пика",
                                "target_lang_sense_clarification": "доходить до высшей точки"
                            },
                            {
                                "target_lang_word": "достигать максимума",
                                "target_lang_sense_clarification": "доходить до предела"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "atteindre un pic",
                                "target_lang_sense_clarification": "arriver au point culminant"
                            },
                            {
                                "target_lang_word": "culminer",
                                "target_lang_sense_clarification": "atteindre son maximum"
                            }
                        ]
                    }
                }
            ]
        },
        {
