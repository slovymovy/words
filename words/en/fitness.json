{
    "word_family": [
        "fit",
        "fitter",
        "fitness-center",
        "unfitness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7576c05f-c697-3b82-a5f0-603ebccbb5ee",
                    "sense_definition": "The state of being physically healthy and strong, often through regular exercise and diet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise is essential for maintaining good physical <w>fitness</w> and mental health.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения необходимы для поддержания хорошей физической <w>формы</w> и психического здоровья.",
                                "zh": "定期锻炼对于保持良好的身体<w>健康</w>和心理健康至关重要。"
                            }
                        },
                        {
                            "text": "The athlete is working hard to reach peak <w>fitness</w> before the championship begins.",
                            "target_lang_translations": {
                                "ru": "Атлет усердно работает, чтобы достичь пика <w>формы</w> до начала чемпионата.",
                                "zh": "这位运动员正在努力训练，以便在锦标赛开始前达到最佳<w>体能</w>状态。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unfitness"
                    ],
                    "common_phrases": [
                        "physical fitness",
                        "peak fitness",
                        "fitness level",
                        "improve fitness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние физического здоровья и силы, часто достигаемое за счет регулярных упражнений и правильного питания.",
                        "zh": "指通过定期锻炼和饮食保持身体健康和强壮的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "физическая форма",
                                "target_lang_sense_clarification": "состояние тела"
                            },
                            {
                                "target_lang_word": "фитнес",
                                "target_lang_sense_clarification": "система упражнений и состояние здоровья"
                            },
                            {
                                "target_lang_word": "подтянутость",
                                "target_lang_sense_clarification": "внешний вид и тонус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "健康",
                                "target_lang_sense_clarification": "身体强壮的状态"
                            },
                            {
                                "target_lang_word": "体能",
                                "target_lang_sense_clarification": "身体素质和运动能力"
                            },
                            {
                                "target_lang_word": "健身",
                                "target_lang_sense_clarification": "通过锻炼保持身体健康"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19935bc1-6976-3091-9fcc-f8c573874ddb",
                    "sense_definition": "The quality of being suitable, appropriate, or right for a particular purpose or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee will evaluate the <w>fitness</w> of the candidate for this high-level position.",
                            "target_lang_translations": {
                                "ru": "Комитет оценит <w>пригодность</w> кандидата на эту высокую должность.",
                                "zh": "委员会将评估该候选人对于这一高层职位的<w>胜任力</w>。"
                            }
                        },
                        {
                            "text": "They questioned the <w>fitness</w> for purpose of the new safety regulations.",
                            "target_lang_translations": {
                                "ru": "Они поставили под сомнение <w>соответствие</w> новых правил безопасности их назначению.",
                                "zh": "他们质疑了新安全法规的<w>合用性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suitability",
                        "capability"
                    ],
                    "antonyms": [
                        "unfitness"
                    ],
                    "common_phrases": [
                        "fitness for purpose",
                        "test of fitness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество соответствия, уместности или правильности для определенной цели или ситуации.",
                        "zh": "指某事物或某人对于特定目的或情况的适合、恰当或正确程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пригодность",
                                "target_lang_sense_clarification": "соответствие требованиям"
                            },
                            {
                                "target_lang_word": "соответствие",
                                "target_lang_sense_clarification": "подходящий характер"
                            },
                            {
                                "target_lang_word": "годность",
                                "target_lang_sense_clarification": "способность к использованию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适宜性",
                                "target_lang_sense_clarification": "适合某种目的的性质"
                            },
                            {
                                "target_lang_word": "胜任力",
                                "target_lang_sense_clarification": "指人能够胜任某职位的资格"
                            },
                            {
                                "target_lang_word": "合用性",
                                "target_lang_sense_clarification": "指物品符合使用目的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "266a5e2b-5061-3365-a217-980ed92d0224",
                    "sense_definition": "The ability of an organism to survive and reproduce in its environment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In evolutionary biology, reproductive <w>fitness</w> determines which traits are passed to the next generation.",
                            "target_lang_translations": {
                                "ru": "В эволюционной биологии репродуктивная <w>приспособленность</w> определяет, какие черты передаются следующему поколению.",
                                "zh": "在进化生物学中，繁殖<w>适应度</w>决定了哪些性状会遗传给下一代。"
                            }
                        },
                        {
                            "text": "Natural selection favors individuals with higher genetic <w>fitness</w> in changing environments.",
                            "target_lang_translations": {
                                "ru": "Естественный отбор благоприятствует особям с более высокой генетической <w>приспособленностью</w> в меняющихся условиях среды.",
                                "zh": "在不断变化的环境中，自然选择更青睐那些具有更高遗传<w>适应性</w>的个体。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "evolutionary fitness",
                        "reproductive fitness",
                        "genetic fitness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность организма выживать и размножаться в своей среде обитания.",
                        "zh": "生物学概念，指生物体在其环境中生存和繁衍的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспособленность",
                                "target_lang_sense_clarification": "биологический термин"
                            },
                            {
                                "target_lang_word": "фитнес",
                                "target_lang_sense_clarification": "генетический успех особи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适应度",
                                "target_lang_sense_clarification": "进化生物学中的生存繁衍能力"
                            },
                            {
                                "target_lang_word": "适应性",
                                "target_lang_sense_clarification": "生物对环境的适应能力"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}