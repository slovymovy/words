                {
                    "sense_id": "100eb6fe-bf40-3522-99c4-fff9db495810",
                    "sense_definition": "unter der Bedingung oder Voraussetzung, dass",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "konditional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Solange</w> du mich bei der Arbeit nicht störst, darfst du hier sitzen bleiben.",
                            "target_lang_translations": {
                                "en": "<w>As long as</w> you do not disturb me at work, you may stay seated here.",
                                "ru": "<w>Пока</w> ты не мешаешь мне работать, можешь оставаться сидеть здесь.",
                                "nl": "<w>Zolang</w> je me niet stoort bij het werk, mag je hier blijven zitten.",
                                "pl": "<w>Dopóki</w> nie przeszkadzasz mi w pracy, możesz tu siedzieć.",
                                "fr": "<w>Tant que</w> tu ne me déranges pas dans mon travail, tu peux rester assis ici.",
                                "it": "<w>Finché</w> non mi disturbi mentre lavoro, puoi rimanere seduto qui.",
                                "cs": "<w>Dokud</w> mě při práci nerušíš, můžeš tu zůstat sedět.",
                                "tr": "Çalışırken beni rahatsız etmediğin <w>sürece</w> burada oturabilirsin.",
                                "es": "<w>Mientras</w> no me molestes en el trabajo, puedes quedarte sentado aquí.",
                                "zh": "<w>只要</w>你不打扰我工作，就可以继续坐在这里。"
                            }
                        },
                        {
                            "text": "Wir können gerne draußen sitzen, <w>solange</w> das Wetter trocken bleibt.",
                            "target_lang_translations": {
                                "en": "We can gladly sit outside <w>as long as</w> the weather stays dry.",
                                "ru": "Мы с удовольствием посидим на улице, <w>если только</w> погода останется сухой.",
                                "nl": "We kunnen gerust buiten zitten, <w>zolang</w> het weer droog blijft.",
                                "pl": "Możemy chętnie posiedzieć na zewnątrz, <w>o ile</w> utrzyma się sucha pogoda.",
                                "fr": "Nous pouvons volontiers nous asseoir dehors, <w>tant que</w> le temps reste sec.",
                                "it": "Possiamo sederci volentieri fuori, <w>purché</w> il tempo si mantenga asciutto.",
                                "cs": "Můžeme klidně sedět venku, <w>dokud</w> zůstane sucho.",
                                "tr": "Hava yağışsız kaldığı <w>sürece</w> memnuniyetle dışarıda oturabiliriz.",
                                "es": "Podemos sentarnos fuera con gusto, <w>siempre que</w> el tiempo se mantenga seco.",
                                "zh": "<w>只要</w>天气保持干燥不下雨，我们很乐意坐在外面。"
                            }
                        }
                    ],
