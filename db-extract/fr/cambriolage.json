        "fr-extract.jsonl": [
            {
                "entry_id": "fda1ab66-7afd-307c-99fc-7e7dde5167d6",
                "word": "cambriolage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54f842c0-5528-4184-9a9f-4fe0c0dba18d",
                        "entry_id": "fda1ab66-7afd-307c-99fc-7e7dde5167d6",
                        "tags": [
                            "plural"
                        ],
                        "form": "cambriolages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "526d7d15-9242-341b-88d9-964be4429971",
                        "entry_id": "fda1ab66-7afd-307c-99fc-7e7dde5167d6",
                        "glosses": [
                            "Action de cambrioler ou résultat de cette action ; vol commis dans un local ou habitation après y être entré par effraction, en escaladant ou en utilisant des fausses clés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc3352c-0b6b-4f87-8ffa-fe03d108a946",
                                "sense_id": "526d7d15-9242-341b-88d9-964be4429971",
                                "text": "Selon nos propres observations, très généralement, un cambriolage amène les gendarmes de Montréal comme de Neuvic à se déplacer sur les lieux pour faire une série de constatations."
                            },
                            {
                                "example_id": "db479ffa-1c62-4496-9df7-563da8d86d73",
                                "sense_id": "526d7d15-9242-341b-88d9-964be4429971",
                                "text": "Dès la fin des années 1880, en effet, des « bandits » se prévalent de l’anarchisme pour opérer non des vols ou des cambriolages, mais des « reprises individuelles »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83f2b92c-42dd-4882-aa56-ceb956d2c2fd",
                        "source_entry_id": "fda1ab66-7afd-307c-99fc-7e7dde5167d6",
                        "source_sense_id": "526d7d15-9242-341b-88d9-964be4429971",
                        "source_sense_description": "Action de cambrioler ou résultat de cette action",
                        "target_lang_word": "Einbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4726103-7303-359a-ac7c-769f6ebf76a5",
                                        "entry_id": "7d855e8c-f794-3cfb-81e6-9f4c65f44f7e",
                                        "glosses": [
                                            "das Eindringen in eine Örtlichkeit mit räuberischen Absichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85550447-bc80-464c-9d73-e63d446f0e0e",
                                                "sense_id": "f4726103-7303-359a-ac7c-769f6ebf76a5",
                                                "text": "Der Einbruch konnte trotz Warnanlage nicht verhindert werden."
                                            },
                                            {
                                                "example_id": "56f66fdb-3e4d-448c-a290-d94827cf245b",
                                                "sense_id": "f4726103-7303-359a-ac7c-769f6ebf76a5",
                                                "text": "„Es ist die grausige Wahrheit, was ich berichte von Franz Biberkopf, der ahnungslos von Hause wegging, wider seinen Willen bei einem Einbruch mitmachte und vor ein Auto geworfen wurde.“"
                                            },
                                            {
                                                "example_id": "2db8fe3d-3452-456f-b4f8-ac67d79bca97",
                                                "sense_id": "f4726103-7303-359a-ac7c-769f6ebf76a5",
                                                "text": "„Ein Überfall und ein Einbruch beim Gutsbesitzer Glathe im Oberleutersdorfer Rittergut im Mai 1800 wurde ihm zum Verhängnis.“"
                                            },
                                            {
                                                "example_id": "33751023-21cc-47b7-b6b0-027c1b4f36f8",
                                                "sense_id": "f4726103-7303-359a-ac7c-769f6ebf76a5",
                                                "text": "„Einbrüche kamen in Akranes schon mal vor, wobei er bezweifelte, dass Diebe um diese Tageszeit zuschlagen würden.“"
                                            },
                                            {
                                                "example_id": "3811a348-cd18-4e3d-854c-e333842f3407",
                                                "sense_id": "f4726103-7303-359a-ac7c-769f6ebf76a5",
                                                "text": "„Ein Einbruch hingegen war ein echter Grund für weitere Recherchen rund um den Tod des Mädchens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b64d34c7-3783-3cb6-84cd-3f3784c3a866",
                                        "entry_id": "7d855e8c-f794-3cfb-81e6-9f4c65f44f7e",
                                        "glosses": [
                                            "plötzlicher Beginn"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b57ebca7-2b80-426f-b320-fb1c7867ae20",
                                                "sense_id": "b64d34c7-3783-3cb6-84cd-3f3784c3a866",
                                                "text": "Bei Einbruch der Nacht wurde die Suche aufgegeben."
                                            },
                                            {
                                                "example_id": "a980e03d-8733-44ef-bfa1-79d487f99372",
                                                "sense_id": "b64d34c7-3783-3cb6-84cd-3f3784c3a866",
                                                "text": "„Ungeduldig erwarteten die Siedler den Einbruch der Dunkelheit.“"
                                            },
                                            {
                                                "example_id": "743bbfb0-5e07-496a-9b11-90c108faeac5",
                                                "sense_id": "b64d34c7-3783-3cb6-84cd-3f3784c3a866",
                                                "text": "„Sie rasteten erst nach Einbruch der Dunkeheit und hatten bis dahin keine einzige Pause gemacht.“"
                                            },
                                            {
                                                "example_id": "a1d5dfde-e10a-48c9-9ec5-74f5c094ad56",
                                                "sense_id": "b64d34c7-3783-3cb6-84cd-3f3784c3a866",
                                                "text": "„Bei Einbruch der Dunkelheit machten wir uns auf den Rückweg.“"
                                            },
                                            {
                                                "example_id": "c3374d74-7bc4-4bea-a80a-0c04babc0a1d",
                                                "sense_id": "b64d34c7-3783-3cb6-84cd-3f3784c3a866",
                                                "text": "„Am 25. Februar traf ich bei Einbruch der Nacht im besten Gasthof Anconas ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d63465f9-7462-36c1-979e-abcc5f4a303f",
                                        "entry_id": "7d855e8c-f794-3cfb-81e6-9f4c65f44f7e",
                                        "glosses": [
                                            "starker Rückfall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5557b580-1be0-4be5-8d0b-83aed261e2ad",
                                                "sense_id": "d63465f9-7462-36c1-979e-abcc5f4a303f",
                                                "text": "Der Einbruch der Aktienkurse war nicht vorhersehbar."
                                            },
                                            {
                                                "example_id": "0b235fb3-8c3f-4ecf-8ee0-69bdcf30b051",
                                                "sense_id": "d63465f9-7462-36c1-979e-abcc5f4a303f",
                                                "text": "„Chinas Immobilienmarkt steht vor einem massiven Einbruch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "68875564-e938-32f1-8dc4-25b9a1073aaa",
                                        "entry_id": "7d855e8c-f794-3cfb-81e6-9f4c65f44f7e",
                                        "glosses": [
                                            "das Zerbrechen nach unten oder innen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1817fa5-2e8f-4220-ab32-db8e7d78329d",
                                                "sense_id": "68875564-e938-32f1-8dc4-25b9a1073aaa",
                                                "text": "Der Einbruch des Eises überraschte alle Eisläufer."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c505e791-324a-3e24-82ab-95fe07a832dc",
                                        "entry_id": "7d855e8c-f794-3cfb-81e6-9f4c65f44f7e",
                                        "glosses": [
                                            "das Scheitern, schwere Niederlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98604122-13c5-48ae-9b29-77434142b9da",
                                                "sense_id": "c505e791-324a-3e24-82ab-95fe07a832dc",
                                                "text": "Das war der schwerste Einbruch, den die nicht mehr mehrheitlich gewählte Partei einstecken musste."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
