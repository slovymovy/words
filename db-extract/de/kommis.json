                "senses": [
                    {
                        "sense_id": "0ce50665-8636-30ae-8c41-71e804935c39",
                        "entry_id": "cf0a93fd-a961-362f-bfae-5be8b112ad35",
                        "glosses": [
                            "Person, die im Auftrag anderer an deren Handelsgeschäften mitarbeitet"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "1033315b-1f3d-4998-ba05-57d4197e912f",
                                "sense_id": "0ce50665-8636-30ae-8c41-71e804935c39",
                                "text": "„Wenn wir einmal annehmen, dass die zweite Hälfte der Fracht rechtzeitig eintraf und zu den gleichen Konditionen verkauft wurde wie die erste, dann müssen die Brüder Billy und ihr Partner La Croix einigermaßen betroffen dreingeschaut haben, als ihr Kommis die Schlussrechnung aufsetzte.“"
                            },
                            {
                                "example_id": "83967d38-6e4c-4b6c-a7e8-18a3b5ff023b",
                                "sense_id": "0ce50665-8636-30ae-8c41-71e804935c39",
                                "text": "„Den Kommis habe ich vorher nach Hause geschickt.“"
                            },
                            {
                                "example_id": "505ae9c1-b402-4187-956d-c014923c076c",
                                "sense_id": "0ce50665-8636-30ae-8c41-71e804935c39",
                                "text": "„Ich sah einen kleinen buckligen Kommis aus dem gegenüberliegenden Büro der Schiffahrtsgesellschaft heraustreten, um auf das dürre Täfelchen vor der Tür einen Schiffsnamen einzutragen, eine Abfahrtszeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
