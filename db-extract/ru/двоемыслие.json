                "senses": [
                    {
                        "sense_id": "fabf8a5d-64a1-35cf-a265-f0c6b126d12f",
                        "entry_id": "28f4c8ce-d717-3411-81ac-d1186c86918e",
                        "glosses": [
                            "лицемерие, неискренность; двуличие"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e3d9840e-a538-31b0-93a3-d131546b0cec",
                        "entry_id": "28f4c8ce-d717-3411-81ac-d1186c86918e",
                        "glosses": [
                            "устар. наличие двоякого смысла, возможность двоякого понимания; неясность, двусмысленность"
                        ],
                        "tags": [],
