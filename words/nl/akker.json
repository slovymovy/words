                            "target_lang_translations": {
                                "en": "The farmer drives his large tractor across the <w>field</w> to prepare the land."
                            }
                        },
                        {
                            "text": "Op de Groningse <w>akkers</w> worden elk jaar veel suikerbieten verbouwd door de lokale boeren.",
                            "target_lang_translations": {
                                "en": "On the <w>fields</w> of Groningen, many sugar beets are grown every year by local farmers."
                            }
