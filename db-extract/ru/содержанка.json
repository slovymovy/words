                "translations": [
                    {
                        "translation_id": "da357702-6d29-4b90-aead-b7baa5b36ac5",
                        "source_entry_id": "2b20fe7f-a27e-3a56-823e-ae9357051dba",
                        "source_sense_id": "52258fde-0899-3ed4-a8f1-e261fff17b95",
                        "target_lang_word": "kept woman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kept woman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f622aa2-cf20-3821-90b2-de2a2d1eba7d",
                                        "entry_id": "9c669c0d-3191-3bf0-93e2-c95af6595682",
                                        "glosses": [
                                            "A woman who is supported financially by a lover (usually a married man)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c5da89-fd92-49ad-89cc-7eee16f58175",
                                                "sense_id": "5f622aa2-cf20-3821-90b2-de2a2d1eba7d",
                                                "text": "He said: \"Why bother about a career? After all, kept woman is a thoroughly respectable occupation—or can be made so by any preacher or justice of the peace. . . .\"\n\"I could not belong to a man unless I cared for him,\" said she."
                                            },
                                            {
                                                "example_id": "629a11cb-6b0a-474a-b98c-001bc208dc4a",
                                                "sense_id": "5f622aa2-cf20-3821-90b2-de2a2d1eba7d",
                                                "text": "\"I'm a kept woman,\" she explained. \"What else is any woman?\""
                                            },
                                            {
                                                "example_id": "10c1e54b-378f-4118-9d45-057417933eb6",
                                                "sense_id": "5f622aa2-cf20-3821-90b2-de2a2d1eba7d",
                                                "text": "Fannie Hurst's tender and moving biography of a kept woman is here reproduced in a sincere, detailed picture. Irene Dunne . . . falls in love with John Boles, a pedigreed young banker, who by a series of misunderstandings, makes her his mistress instead of his wife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
