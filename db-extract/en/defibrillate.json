                ],
                "senses": [
                    {
                        "sense_id": "2455830b-8669-3c7f-bb5e-06e700d98076",
                        "entry_id": "8d636a47-ba64-358a-93d5-188c14b83c06",
                        "glosses": [
                            "To stop the fibrillation of the heart in order to restore normal contractions, especially by the use of an electric shock."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1bd80166-760c-4d52-aba1-9c65c60ae4a1",
                                "sense_id": "2455830b-8669-3c7f-bb5e-06e700d98076",
                                "text": "Dynamic typography reinvigorates the storytelling genre by anthropomorphizing fonts, defibrillating calligraphy, creating rhythmic, ambient moodscapes without sacrificing speed or lushness."
                            },
                            {
                                "example_id": "85682fc0-9ed1-4e4b-8e4d-8db5471b1a15",
                                "sense_id": "2455830b-8669-3c7f-bb5e-06e700d98076",
                                "text": "Though occasionally a “flatliner” can be revived with a defib, it is most commonly used to change the uncoordinated contractions of the heart (fibrillation) into a normal sinus rhythm—that is, to defibrillate the heart."
                            },
                            {
                                "example_id": "bbfdb1a3-2095-4456-8840-6d3e7c922f96",
                                "sense_id": "2455830b-8669-3c7f-bb5e-06e700d98076",
                                "text": "The former sex addict turned exuberant Christian influencer Russell Brand showed up in a leopard-print cardigan to offer a rare note of empathy, saying the stunt was an attempt to “defibrillate divinity down here on the lower levels.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59fa77ce-e0ba-4e03-b276-5b15394f3ef2",
                        "source_entry_id": "8d636a47-ba64-358a-93d5-188c14b83c06",
                        "source_sense_id": "2455830b-8669-3c7f-bb5e-06e700d98076",
                        "source_sense_description": "to stop cardiac fibrillation",
                        "target_lang_word": "défibriller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défibriller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b12a3c04-be87-325b-b412-b8e600c6126e",
                                        "entry_id": "8643d2c0-66f9-3818-b67c-9c0c6fa0d780",
                                        "glosses": [
                                            "Traiter la fibrillation ventriculaire en envoyant au cœur des chocs électriques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e026a8e4-22c1-465b-8262-b08774adb3b7",
                        "source_entry_id": "8d636a47-ba64-358a-93d5-188c14b83c06",
                        "source_sense_id": "2455830b-8669-3c7f-bb5e-06e700d98076",
                        "source_sense_description": "to stop cardiac fibrillation",
                        "target_lang_word": "defibrillieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defibrillieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                        "entry_id": "990a2028-644a-3604-a33b-fb9a8560f03b",
                                        "glosses": [
                                            "ein stillstehendes Herz mittels eines einen kontrollierten Stromschlag produzierenden Gerätes (einem Defibrillator) wieder zum Schlagen bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0dd81e5-faf8-4bef-86b6-065bd6c5f18b",
                                                "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                                "text": "„Bei einem Herzanfall ist es mir doch egal, ob der Chefarzt einer kardiologischen Abteilung oder sein Pförtner mich defibrilliert - Hauptsache, es tut überhaupt jemand etwas!“"
                                            },
                                            {
                                                "example_id": "0462ba85-f99f-43ce-bc4f-379bf270db6a",
                                                "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                                "text": "„Defibrillieren kann jeder! Bei einem Herzinfarkt je früher, um so besser.“"
                                            },
                                            {
                                                "example_id": "a38d60d3-c942-4528-b09c-c9599fc56b8d",
                                                "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                                "text": "Beim Kammerflimmern, einem elektrischen Chaos im Herzen, verstirbt der Patient nach wenigen Minuten, wenn nichts getan wird. Um dieses Chaos zu beenden wird ein starker Stromstoß benötigt, er schaltet quasi alle Zellen wieder auf Null. Hierfür schließt man die Elektroden des Defibrillators an die Brust und die Seite des Patienten an. Stromstoß - und der Sinusknoten hat wieder die Möglichkeit, die normalen Impulse abzugeben. Man defibrilliert sozusagen das elektrische Chaos."
                                            },
                                            {
                                                "example_id": "7c25f4f0-965e-4afa-8987-8fe75c1368a8",
                                                "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                                "text": "Kinder unter 8 Jahren werden nicht defibrilliert."
                                            },
                                            {
                                                "example_id": "9de72677-2ed9-4d12-9214-e5f2687303f9",
                                                "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                                "text": "In Israel dauert es oft noch länger als in Deutschland, bis endlich ein Rettungswagen kommt. Deshalb übernehmen die per Handy herbeigerufenen Freiwilligen die Erstversorgung: Blutung stoppen, Herzdruckmassage, defibrillieren, Medikamente geben."
                                            },
                                            {
                                                "example_id": "684c31cd-758e-447f-9e3f-f7bdd9181258",
                                                "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                                "text": "Primary Care Paramedic (PCP): Dies ist die niedrigste Stufe der Qualifikation für Personal im kanadischen Rettungsdienst. PCPs führen Basismaßnahmen durch, dürfen außerdem einige ausgewählte Medikamente verabreichen, defibrillieren und 3-Kanal-EKGs interpretieren."
                                            },
                                            {
                                                "example_id": "dd69cec0-ca4f-4a59-b42d-70bf65447954",
                                                "sense_id": "88be23f1-9612-3a5e-9e47-c07e289cafee",
                                                "text": "Größere Verkehrsflugzeuge haben automatische Defibrillilatoren, so genannte AEDs, an Bord. Damit können auch geschulte Laien bei einem durch Herzkammerflimmern ausgelösten Herzstillstand defibrillieren (kontrollierte Elektroschocks an das Herz abgeben). Dazu müssen aber vorher zwei große Elektroden auf die Brust des Patienten aufgeklebt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
