                ],
                "senses": [
                    {
                        "sense_id": "0ef2d448-d0ee-33e6-bcc8-5f7b56901a04",
                        "entry_id": "670fe8e8-296d-3572-a0cb-0edf1ab784c9",
                        "glosses": [
                            "Étriper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b160e0af-2fe9-4ce9-8cc1-36b38c2526d5",
                                "sense_id": "0ef2d448-d0ee-33e6-bcc8-5f7b56901a04",
                                "text": "Je n’en connais pas que la jouissance qu’ils auraient à étripailler un homme d’en face aiderait à sortir de la tranchée au moment de l’assaut."
                            },
                            {
                                "example_id": "3366b575-8540-4afa-ae89-880f1bc51773",
                                "sense_id": "0ef2d448-d0ee-33e6-bcc8-5f7b56901a04",
                                "text": "On n’a jamais su comment ces deux femmes ne se sont pas étripaillées à n’en pas laisser, de l’une et de l’autre, un bout entier gros comme l’ongle."
                            },
                            {
                                "example_id": "f8a57c87-3292-4036-b675-85249c814dc2",
                                "sense_id": "0ef2d448-d0ee-33e6-bcc8-5f7b56901a04",
                                "text": "Je vais vous étripailler tout ça et que ça pue, et que ça vous ramène une saleté définitive."
                            }
                        ]
                    }
                ],
