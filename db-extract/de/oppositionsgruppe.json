                "senses": [
                    {
                        "sense_id": "f887ff6a-37ad-3a9f-b368-a8cb72afdebc",
                        "entry_id": "2936d9a8-7f5e-38b0-8e5b-3cd274187897",
                        "glosses": [
                            "Personengruppe, die aus Oppositionellen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbab29c-c9b0-4727-adc8-9ea0ef9ad5a1",
                                "sense_id": "f887ff6a-37ad-3a9f-b368-a8cb72afdebc",
                                "text": "„Das war die Auffassung einer Oppositionsgruppe unter dem Gewerkschafter Josef Zinner, der eine England-Gruppe von Vertrauensmännern der Gewerkschaften ins Leben gerufen hatte.“"
                            },
                            {
                                "example_id": "93111921-651b-47b6-9c98-a5647ed761a1",
                                "sense_id": "f887ff6a-37ad-3a9f-b368-a8cb72afdebc",
                                "text": "„In Südafrika testen alle Oppositionsgruppen die gewaltfreien Methoden Gandhis so lange wie möglich aus, obwohl sie mit einer wesentlich brutaleren Staatsgewalt konfrontiert waren als ihre Pendants in Rhodesien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
