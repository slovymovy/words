                                "target_senses": [
                                    {
                                        "sense_id": "f97d2321-0f09-31ef-8de9-fe14d680c90e",
                                        "entry_id": "5ec551aa-0a0e-36cd-8b99-e03d43062b34",
                                        "glosses": [
                                            "брат жены"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd778dd3-31dc-47a1-9601-cecfe85b6ab0",
                                                "sense_id": "f97d2321-0f09-31ef-8de9-fe14d680c90e",
                                                "text": "Тарантас с кривым пыльным верхом дал ему шурин, в имении которого он проводил лето."
                                            },
                                            {
                                                "example_id": "a1172585-0f70-4e10-80d2-fcec5445be62",
                                                "sense_id": "f97d2321-0f09-31ef-8de9-fe14d680c90e",
                                                "text": "Вскоре сбежались и замужние дочери и кто был на селе из зятьев; тут пошли шурья, свояки, свояченицы, тещи, невестки, кумы, кумовья ― русский человек без сродников не живет, ― и набралась полная изба."
                                            },
                                            {
                                                "example_id": "a6feec03-f26e-4b73-83c6-596cd537829d",
                                                "sense_id": "f97d2321-0f09-31ef-8de9-fe14d680c90e",
                                                "text": "Шурин и жена его сопровождали нас к теще в деревню."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
