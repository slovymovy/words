                ],
                "senses": [
                    {
                        "sense_id": "ce906c72-87ae-3cdb-8e2f-f58288e9c0a8",
                        "entry_id": "b8380bf0-b3c9-3fd2-970e-dda64e73a979",
                        "glosses": [
                            "de opbouw en kenmerken hebbend van een verhaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d67079cb-ba91-4b3e-bb22-cd2815f65244",
                                "sense_id": "ce906c72-87ae-3cdb-8e2f-f58288e9c0a8",
                                "text": "‘Zijn boeken hebben alles wat goede narratieve fictie moet hebben: het is met een geweldige vaart geschreven, is informerend en op zijn tijd ook nog eens geestig. Bovendien gaat het over ons allemaal.’ HP de Tijd 20/10"
                            },
                            {
                                "example_id": "5453df77-eb53-415c-a8dc-db2ea0235946",
                                "sense_id": "ce906c72-87ae-3cdb-8e2f-f58288e9c0a8",
                                "text": "Voor kijkers die het geduld kunnen opbrengen om narratief aan hun lot te worden overgelaten en plezier hebben in los zand, is 'The Forbidden Room' een verrukkellijke filmische ervaring. Voor wie smacht naar narratieve structuur is de film eerder een koude, intellectuele exercitie."
                            },
                            {
                                "example_id": "b08e01c6-19d4-4583-817f-4d62f96e5ea4",
                                "sense_id": "ce906c72-87ae-3cdb-8e2f-f58288e9c0a8",
                                "text": "Het toevoegen van narratieve elementen is kenmerkend voor New Journalism, een stijl waarin literaire technieken zoals het opvoeren van personages en het gebruik van dialoog, worden gebruikt om een nieuwsverhaal leesbaarder te maken. HP de Tijd 17/05"
                            }
                        ]
                    }
