                "senses": [
                    {
                        "sense_id": "6e09c781-9f35-30f1-a579-af14b524b63a",
                        "entry_id": "850dc16e-43bf-3b2e-87b1-bcbcd9ed12f8",
                        "glosses": [
                            "наклонить набок, увеличить угол крена"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82f35c58-6a70-4b02-b941-838dffde3b3e",
                                "sense_id": "6e09c781-9f35-30f1-a579-af14b524b63a",
                                "text": "Накренить самолёт."
                            },
                            {
                                "example_id": "636a08c4-7f17-4d6d-b453-63da7c9233af",
                                "sense_id": "6e09c781-9f35-30f1-a579-af14b524b63a",
                                "text": "Накренить шею."
                            },
                            {
                                "example_id": "cd956c89-8751-4a05-b79b-52bfebc9e454",
                                "sense_id": "6e09c781-9f35-30f1-a579-af14b524b63a",
                                "text": "Похоже, что когда-то эта кабина стояла вертикально, а потом подложили под неё сбоку заряд взрывчатки, и теперь её сильно накренило, так что край её днища приподнялся вместе с приросшим к нему пластом асфальта и глинистой земли."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bcba774-0cb4-35f6-9fb2-3dc73f53ca2e",
                        "entry_id": "850dc16e-43bf-3b2e-87b1-bcbcd9ed12f8",
                        "glosses": [
                            "перен. склонить в одну сторону"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f248ebd-abcd-4a68-b8ff-f39940cc9772",
                                "sense_id": "0bcba774-0cb4-35f6-9fb2-3dc73f53ca2e",
                                "text": "Накренить чашу на весах правосудия."
                            }
                        ]
                    }
