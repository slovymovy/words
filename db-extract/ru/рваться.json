                "senses": [
                    {
                        "sense_id": "ccd477f0-a7e9-3a45-85f6-7a2ce7928747",
                        "entry_id": "3efa52f3-c4a4-3488-8766-72a74b2fb173",
                        "glosses": [
                            "терять целостность, разделяясь на части или приходя в негодность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe500659-6230-4047-a8cc-f00a1070aed4",
                                "sense_id": "ccd477f0-a7e9-3a45-85f6-7a2ce7928747",
                                "text": "Облегченья не находит она подавленным слезам, и сердце рвётся пополам."
                            }
                        ]
                    },
                    {
                        "sense_id": "50163ce0-7e47-3bcb-819c-f3848e814f95",
                        "entry_id": "3efa52f3-c4a4-3488-8766-72a74b2fb173",
                        "glosses": [
                            "перен. прекращаться, нарушаться"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "93c8bb87-0d63-3106-9214-39cd3d717a9a",
                        "entry_id": "3efa52f3-c4a4-3488-8766-72a74b2fb173",
                        "glosses": [
                            "то же, что взрываться"
                        ],
                        "tags": [
                            "3-е л."
                        ],
                        "examples": [
                            {
                                "example_id": "dd07df47-2757-46ec-9013-355405ffcdb9",
                                "sense_id": "93c8bb87-0d63-3106-9214-39cd3d717a9a",
                                "text": "Смотреть по сторонам было особенно некогда, поскольку вокруг самолёта кучно рвались снаряды."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                        "entry_id": "3efa52f3-c4a4-3488-8766-72a74b2fb173",
                        "glosses": [
                            "стремиться куда-нибудь; прилагая усилия, стараться высвободиться, преодолеть какие-нибудь препятствия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f768a2af-4607-4b8e-9193-95b1ee175b37",
                                "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                                "text": "Рваться в бой."
                            },
                            {
                                "example_id": "29e7b616-a68c-40b6-87cc-2d83a2a2dac3",
                                "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                                "text": "Ребёнок рвался к матери."
                            },
                            {
                                "example_id": "743c5482-85f3-4a0e-af3b-d7b6b24ec0df",
                                "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                                "text": "Душа тоскливо вдаль не рвётся."
                            },
                            {
                                "example_id": "903adae9-2e2f-4b71-944c-a49cb0127c0e",
                                "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                                "text": "Псы залились в хлевах и рвутся вон на драку."
                            },
                            {
                                "example_id": "51743e24-46b6-4ad6-b446-175cc9e1152b",
                                "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                                "text": "Лебедь рвётся в облака."
                            },
                            {
                                "example_id": "950d5a9e-96d5-4758-bd0f-043b61ec109e",
                                "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                                "text": "Нева всю ночь рвалася к морю против бури."
                            },
                            {
                                "example_id": "16eec074-534a-4620-b311-a8cc51490d3c",
                                "sense_id": "6b72cc4a-fbea-390e-a8fa-3be0ab904648",
                                "text": "Рвалась и плакала сначала, с супругом чуть не развелась."
                            }
                        ]
                    },
                    {
                        "sense_id": "aab624a0-f36d-3d6d-b933-aef79560fe5b",
                        "entry_id": "3efa52f3-c4a4-3488-8766-72a74b2fb173",
                        "glosses": [
                            "страд. к рвать [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91415582-5124-4907-bd03-3e5fdef5d3e0",
                                "sense_id": "aab624a0-f36d-3d6d-b933-aef79560fe5b",
                                "text": "Эта нитка рвётся лёгким усилием."
                            }
                        ]
                    }
                ],
