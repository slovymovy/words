                        "entry_id": "29743ff5-bfd3-3431-8145-87cdb8c73ff1",
                        "glosses": [
                            "Sportler, der sich auf Mittelstrecken spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b236858-6aef-4bd9-9b89-61efd5b1187a",
                                "sense_id": "3b4241f1-432e-3303-94d3-af69cda9a1a9",
                                "text": "Mein Sohn Alexander ist ein begabter Mittelstreckenläufer."
                            },
                            {
                                "example_id": "92926ff5-6af4-47e9-af33-498fba83b3f2",
                                "sense_id": "3b4241f1-432e-3303-94d3-af69cda9a1a9",
                                "text": "„Dr. Meichsner, ehemals ein hervorragender Mittelstreckenläufer […], der nach eigenen Aussagen seine Marathon-Bestzeit von 2:21 Stunden als Nebenprodukt seines Mittelstreckentrainings erzielte, ist schon seit Jahren nicht nur mein Sportorthopäde, sondern behandelt fast alle unsere Athleten im Verein.“"
                            }
                        ],
