                                            {
                                                "example_id": "8e01d3a0-c8c8-411a-958a-08ec02d01b86",
                                                "sense_id": "e9e3347d-a59f-362c-9c85-69f4c8b31933",
                                                "text": "Echtes Lametta wird heute selten benutzt. Stattdessen kommen meist Streifen aus Kunststofffolie zum Einsatz."
                                            },
                                            {
                                                "example_id": "ee652ef1-e47c-412f-b505-321b50fcedca",
                                                "sense_id": "e9e3347d-a59f-362c-9c85-69f4c8b31933",
                                                "text": "Früher war mehr Lametta! (Loriot)"
                                            },
                                            {
                                                "example_id": "04149617-ab43-441d-a84f-2b6e8c22918a",
                                                "sense_id": "e9e3347d-a59f-362c-9c85-69f4c8b31933",
                                                "text": "„Unter dem Tannenbäumchen, das auch mit Kugeln und Lametta geschmückt war, lagen viele große Schüsseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
