                        "glosses": [
                            "Condescendance, dédain, mépris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b268c37-c58e-4273-803c-602fb4ae5401",
                                "sense_id": "2e5a8fc3-40bc-37dc-9d8f-6393dcf0ccc7",
                                "text": "Er begrüßte, behandelte mich mit Herablassung. : il me salua, me traita(it) avec condescendance."
                            },
                            {
                                "example_id": "6fafd6bf-bbb2-4548-8b75-516afabeae17",
                                "sense_id": "2e5a8fc3-40bc-37dc-9d8f-6393dcf0ccc7",
                                "text": "Gefühle , die aus Mitleid und Herablassung gemischt sind : des sentiments où se mêlent pitié et dédain"
                            }
                        ]
                    }
