                                "target_senses": [
                                    {
                                        "sense_id": "fd67c64f-37d0-3cf7-867b-6587110dbfd1",
                                        "entry_id": "1302bf23-00c9-392e-9de6-915f48179ec1",
                                        "glosses": [
                                            "internet"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5e682e4-b92f-4257-bb84-e5a0b6f658ee",
                                                "sense_id": "fd67c64f-37d0-3cf7-867b-6587110dbfd1",
                                                "text": "Ik koop alles wat ik nodig heb wel via het interweb. Dat is ook droevig."
                                            },
                                            {
                                                "example_id": "d941da1f-faa0-42e3-bcc3-bf822a955b0c",
                                                "sense_id": "fd67c64f-37d0-3cf7-867b-6587110dbfd1",
                                                "text": "Zijn moeder wist niet eens hoe ze het internet moest gebruiken, of het interweb zoals zij het half ironisch noemde."
                                            },
                                            {
                                                "example_id": "33bf3b11-b8bc-46ac-a45f-bfcefb430692",
                                                "sense_id": "fd67c64f-37d0-3cf7-867b-6587110dbfd1",
                                                "text": "Dus al die extra's laat ik over aan de fanfictieschrijvers op het interweb."
                                            },
                                            {
                                                "example_id": "fe0efb44-1aba-4e8b-b073-96f00fb373ac",
                                                "sense_id": "fd67c64f-37d0-3cf7-867b-6587110dbfd1",
                                                "text": "Ze moest me uiteraard wel alles helemaal uitleggen van begin tot eind, want, zoals je weet, snap ik niets van het interweb en ik had het artikel zelf niet gezien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
