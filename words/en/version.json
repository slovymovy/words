{
    "word_family": [
        "versioning",
        "subversion",
        "inversion",
        "conversion",
        "aversion",
        "diversion",
        "reversion"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6eb2bc88-2a0f-3380-a67f-5ee117c30b6b",
                    "sense_definition": "A specific form or variation of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director released a longer <w>version</w> of the movie with extra scenes.",
                            "target_lang_translations": {
                                "ru": "Режиссер выпустил более длинную <w>версию</w> фильма с дополнительными сценами.",
                                "zh": "导演发布了一个包含额外场景的更长<w>版本</w>。"
                            }
                        },
                        {
                            "text": "This new <w>version</w> of the car is much more fuel-efficient than the old one.",
                            "target_lang_translations": {
                                "ru": "Этот новый <w>вариант</w> автомобиля гораздо экономичнее старого.",
                                "zh": "这款新<w>版本</w>的汽车比旧款更省油。"
                            }
                        }
                    ],
                    "synonyms": [
                        "variant",
                        "adaptation"
                    ],
                    "common_phrases": [
                        "new version",
                        "original version",
                        "final version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная форма или разновидность чего-либо.",
                        "zh": "某事物的特定形式或变体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "вариант исполнения или издания"
                            },
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "видоизменение чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "指作品、产品或事物的不同形式"
                            },
                            {
                                "target_lang_word": "变体",
                                "target_lang_sense_clarification": "指同一事物的不同变种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "727e4539-3f6d-37c1-9c0c-2376368f529b",
                    "sense_definition": "A particular revision of software, firmware, or hardware.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should upgrade to the latest <w>version</w> for new features and bug fixes.",
                            "target_lang_translations": {
                                "ru": "Вам следует обновиться до последней <w>версии</w> ради новых функций и исправлений ошибок.",
                                "zh": "你应该升级到最新<w>版本</w>以获取新功能和错误修复。"
                            }
                        },
                        {
                            "text": "I am still using an older <w>version</w> of the operating system.",
                            "target_lang_translations": {
                                "ru": "Я все еще использую старую <w>версию</w> операционной системы.",
                                "zh": "我还在使用旧<w>版本</w>的操作系统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ver",
                        "ver."
                    ],
                    "common_phrases": [
                        "latest version",
                        "software version",
                        "beta version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная редакция программного обеспечения или оборудования.",
                        "zh": "软件、固件或硬件的特定修订版。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "редакция программы или прошивки"
                            },
                            {
                                "target_lang_word": "релиз",
                                "target_lang_sense_clarification": "выпуск ПО"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "软件或系统的修订编号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54084702-3629-363b-8dc1-b97587883ecc",
                    "sense_definition": "An account or description from a particular point of view, especially as contrasted with another account.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "account",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness gave a different <w>version</w> of the events than the police report.",
                            "target_lang_translations": {
                                "ru": "Свидетель изложил иную <w>версию</w> событий, чем та, что была в полицейском отчете.",
                                "zh": "目击者给出的事件<w>说法</w>与警方报告不同。"
                            }
                        },
                        {
                            "text": "I want to hear your <w>version</w> of the story before I make a decision.",
                            "target_lang_translations": {
                                "ru": "Я хочу услышать твою <w>версию</w> случившегося, прежде чем приму решение.",
                                "zh": "在做决定之前，我想听听你对这件事的<w>说法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interpretation",
                        "rendition"
                    ],
                    "common_phrases": [
                        "your version",
                        "official version",
                        "different version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассказ или описание событий с определенной точки зрения.",
                        "zh": "从特定角度对事件的叙述或描述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "изложение событий"
                            },
                            {
                                "target_lang_word": "интерпретация",
                                "target_lang_sense_clarification": "трактовка событий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说法",
                                "target_lang_sense_clarification": "对事件的个人陈述或解释"
                            },
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "对事件的特定描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "427c2e2e-d634-33d5-bfe4-aa6976424ed0",
                    "sense_definition": "A translation from one language to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "translation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The English <w>version</w> of the novel was published two years after the original.",
                            "target_lang_translations": {
                                "ru": "Английский <w>перевод</w> романа был опубликован через два года после оригинала.",
                                "zh": "这部小说的英文<w>译本</w>在原著出版两年后问世。"
                            }
                        },
                        {
                            "text": "It is only in the King James <w>Version</w> of the Bible.",
                            "target_lang_translations": {
                                "ru": "Это есть только в <w>переводе</w> Библии короля Якова.",
                                "zh": "这只存在于《圣经》的钦定<w>译本</w>中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interpretation",
                        "rendition"
                    ],
                    "common_phrases": [
                        "translated version",
                        "English version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевод с одного языка на другой.",
                        "zh": "从一种语言到另一种语言的翻译。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевод",
                                "target_lang_sense_clarification": "текст на другом языке"
                            },
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "языковой вариант издания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "译本",
                                "target_lang_sense_clarification": "翻译后的文本"
                            },
                            {
                                "target_lang_word": "翻译",
                                "target_lang_sense_clarification": "语言转换后的版本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e38d9a4-c44b-37db-8d37-a4c8e7060393",
                    "sense_definition": "A change of form, direction, or position; a transformation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "External cephalic <w>version</w> is a process by which a baby can be turned in the womb.",
                            "target_lang_translations": {
                                "ru": "Наружный акушерский <w>поворот</w> — это процедура, с помощью которой можно развернуть ребенка в утробе.",
                                "zh": "外<w>倒转</w>术是一种可以在子宫内调整胎儿位置的程序。"
                            }
                        },
                        {
                            "text": "The alchemist sought the <w>version</w> of lead into gold.",
                            "target_lang_translations": {
                                "ru": "Алхимик искал способ <w>превращения</w> свинца в золото.",
                                "zh": "炼金术士寻求将铅<w>转化</w>为金子的方法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cephalic version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение формы, направления или положения; трансформация.",
                        "zh": "形式、方向或位置的改变；转化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворот",
                                "target_lang_sense_clarification": "изменение положения плода в медицине"
                            },
                            {
                                "target_lang_word": "превращение",
                                "target_lang_sense_clarification": "трансформация формы или вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒转",
                                "target_lang_sense_clarification": "医学上指改变胎儿在子宫内的位置"
                            },
                            {
                                "target_lang_word": "转化",
                                "target_lang_sense_clarification": "指物质或形式的改变"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8207f3cd-cd97-3897-8c9e-ae42925c7dbf",
                    "sense_definition": "To keep track of a file or document in a system that manages different revisions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developers <w>versioned</w> the source code to ensure they could revert any mistakes.",
                            "target_lang_translations": {
                                "ru": "Разработчики <w>версионировали</w> исходный код, чтобы иметь возможность откатить любые ошибки.",
                                "zh": "开发人员对源代码进行了<w>版本化</w>处理，以确保能够撤销任何错误。"
                            }
                        },
                        {
                            "text": "We need to start <w>versioning</w> our documentation more strictly.",
                            "target_lang_translations": {
                                "ru": "Нам нужно начать более строго <w>версионировать</w> нашу документацию.",
                                "zh": "我们需要开始更严格地对文档进行<w>版本化</w>管理。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отслеживать изменения файла или документа в системе управления версиями.",
                        "zh": "在管理不同修订版的系统中跟踪文件或文档。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "версионировать",
                                "target_lang_sense_clarification": "сохранять разные редакции в системе контроля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版本化",
                                "target_lang_sense_clarification": "对文件进行版本管理"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}