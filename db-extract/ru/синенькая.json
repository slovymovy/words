                "senses": [
                    {
                        "sense_id": "f6076ed3-ac8b-31d7-92aa-203dbb8d29a9",
                        "entry_id": "6340c947-2df3-34dd-9659-d35d3647ccdd",
                        "glosses": [
                            "устар. прост. субстантивир. пятирублёвая купюра (в России до 1917 г.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a73bdf7-861a-4af2-b35e-fd0370f66b69",
                                "sense_id": "f6076ed3-ac8b-31d7-92aa-203dbb8d29a9",
                                "text": "Поликей стал рассказывать историю, как дохтору синенькую мужик дал и тем уволился."
                            },
                            {
                                "example_id": "3ca177be-3cc9-4e64-99b6-898d88642a07",
                                "sense_id": "f6076ed3-ac8b-31d7-92aa-203dbb8d29a9",
                                "text": "А мы, знаете ли, шли, шли, взяли да и зашли. Дай, думаю, зайдём, праздничные возьмём, чтоб завтра не беспокоить… Я сунул обоим по синенькой. Дробискулов сконфузился."
                            }
                        ]
                    }
