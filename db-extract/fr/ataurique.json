                                                "example_id": "c214063f-a926-4d6f-94cc-81f40d781f3e",
                                                "sense_id": "acfe04d5-baa8-329a-891c-18c48854dc2e",
                                                "text": "Completing the decoration are stylized ataurique motifs distinguished by asymmetrical leaves."
                                            },
                                            {
                                                "example_id": "b4e248c1-373a-4975-9d13-dba632613ff6",
                                                "sense_id": "acfe04d5-baa8-329a-891c-18c48854dc2e",
                                                "text": "The profusion of ataurique throughout the palaces reminds us of their interdependence with the gardens that they frame or look out upon."
                                            }
