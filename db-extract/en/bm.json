                        "examples": [
                            {
                                "example_id": "9c095bd2-0896-4f77-b70d-112e2821de33",
                                "sense_id": "8181e3d5-7dbe-36a4-8d20-3eb7c79cd5aa",
                                "text": "Bahasa Melayu is the national language and the official language of the Federation, said Dr Noor Hisham. Therefore, one of the entry requirements […] is a pass in BM subject at SPM level or equivalent."
                            },
                            {
                                "example_id": "57b98f23-13c5-45ac-98c6-5440fcab7a65",
                                "sense_id": "8181e3d5-7dbe-36a4-8d20-3eb7c79cd5aa",
                                "text": "[…] on “National Language Day”, Bahasa Malaysia will be used […] Thursday will be made the day to use BM while Monday or Tuesday for English."
                            },
                            {
                                "example_id": "babcfc59-75d2-4e55-a2f2-0243cae59453",
                                "sense_id": "8181e3d5-7dbe-36a4-8d20-3eb7c79cd5aa",
                                "text": "The assumption that Malay children are already proficient in Bahasa Melayu (BM) upon entering Year One is incorrect […] But while their command of English is strong, their BM is weak."
                            }
                        ]
                    },
