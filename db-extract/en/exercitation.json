                        "examples": [
                            {
                                "example_id": "c7f8f6d1-3b05-48c9-a777-c38fcef0a36b",
                                "sense_id": "adaf2e12-19f2-3ab2-b7d4-5d0c5fd638d5",
                                "text": "To Crates and Dicæarchus it seemed that there was none at all;[…] To Plato, that it was a substance moving of it selfe: To Thales, a Nature without rest; To Asclepiades, an exercitation of the senses[…]."
                            },
                            {
                                "example_id": "553506cf-22f4-4058-8167-b5561844f2b0",
                                "sense_id": "adaf2e12-19f2-3ab2-b7d4-5d0c5fd638d5",
                                "text": "This was at first to have taken place alternately at each other's houses, but we soon discovered that my friend's resolution was inadequate to severing him from his couch at the early hour fixed for this exercitation."
                            },
                            {
                                "example_id": "b9fc9c39-d221-4be8-b76e-b56c216891cc",
                                "sense_id": "adaf2e12-19f2-3ab2-b7d4-5d0c5fd638d5",
                                "text": "Mens sana in corpore sano, which being translated means, mens—or perhaps I should say, men—should incorporate bodily exercise with mental exercitation."
                            },
                            {
                                "example_id": "6475263f-7c2d-42e7-b12c-b6f4fd163c19",
                                "sense_id": "adaf2e12-19f2-3ab2-b7d4-5d0c5fd638d5",
                                "text": "Come up, sir, and show me your exercitation."
                            }
                        ]
                    }
