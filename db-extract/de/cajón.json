                "senses": [
                    {
                        "sense_id": "27d1e03f-6307-3fd8-a4f5-fbbad5d0bd1e",
                        "entry_id": "dc10832b-4746-3560-adac-cded9ecc338a",
                        "glosses": [
                            "kistenartiges Perkussionsinstrument, das zumeist mit den Händen bespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c67e4117-cac8-411f-8c14-e3a64feef658",
                                "sense_id": "27d1e03f-6307-3fd8-a4f5-fbbad5d0bd1e",
                                "text": "„Gitarrenspieler beginnen ihr virtuoses Spiel, begleitet vom Klatschen der umstehenden Musiker und den rhythmischen Schlägen auf einen ‚Cajón‘, ein traditionelles Perkussionsinstrument.“"
                            },
                            {
                                "example_id": "732bd488-5fd8-4887-87dd-ad3d0ed35163",
                                "sense_id": "27d1e03f-6307-3fd8-a4f5-fbbad5d0bd1e",
                                "text": "„Sein Cousin Jakob Rebay spielt Cajón, eine Kistentrommel, und hat mit seiner Familie den Lebensmittelpunkt in Weßling.“"
                            },
                            {
                                "example_id": "ba9c8a57-0fee-4fdc-92e9-a0925c751db8",
                                "sense_id": "27d1e03f-6307-3fd8-a4f5-fbbad5d0bd1e",
                                "text": "„Stefan Pellmaier machte sich gleich mit einem Marimbaphon und einem Vibraphon ganz breit in der hintersten Reihe, zog es aber meistens dann doch vor, mit Perkussionsinstrumenten wie Cajón, Rassel oder Trommel und vor allem mit dem Akkordeon für so etwas wie Heimatsound in vorderster Reihe zu sorgen.“"
                            },
                            {
                                "example_id": "59021857-8d26-4c67-aaba-ffc4c501446b",
                                "sense_id": "27d1e03f-6307-3fd8-a4f5-fbbad5d0bd1e",
                                "text": "„Auf einer kleinen Nebenbühne zur Hallenmitte hin gibt das an Streetbusker angelehnte Duo an Mikrofon, Akustikgitarre, Schlagzeug und Cajón von Anfang an Vollgas und entfacht frenetischen Jubel durch raffinierte Mitmachaktionen.“"
                            },
                            {
                                "example_id": "dc89e731-a529-4973-bc22-d0eccabac75a",
                                "sense_id": "27d1e03f-6307-3fd8-a4f5-fbbad5d0bd1e",
                                "text": "„Die Besetzung mit Cajón und Gitarre ist minimalistisch, das Ganze klingt aber trotzdem nach flotter Sponti-Party, weil immerhin drei polyglotte Leute singen, ob auf Deutsch, Englisch oder Italienisch.“"
                            },
                            {
                                "example_id": "fc189e83-5d03-48ec-b6e3-83af7a720652",
                                "sense_id": "27d1e03f-6307-3fd8-a4f5-fbbad5d0bd1e",
                                "text": "„Das patentierte Instrument ist eine Mischung aus einer Kazoo, einer Ansing-Trommel in Form eines Röhrchens, und einer Cajón, einer hockerartigen Kistentrommel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
