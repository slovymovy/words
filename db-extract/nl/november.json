                            {
                                "example_id": "95adb9b3-2cce-4568-9f08-b0ca4f26ffd8",
                                "sense_id": "d046c9d4-5310-3a41-95d7-1755a3127994",
                                "text": "Op 11 november wordt in sommige streken Sint-Maarten gevierd."
                            },
                            {
                                "example_id": "6147f8d1-1c69-4b89-a360-47651648f10c",
                                "sense_id": "d046c9d4-5310-3a41-95d7-1755a3127994",
                                "text": "Zo werd op een winderige dag in november een kleine magere jongen binnengelaten bij de Sint en zijn honderd Pieten."
                            },
                            {
                                "example_id": "15c381cb-fad0-41ff-b6c1-66dcd0974116",
                                "sense_id": "d046c9d4-5310-3a41-95d7-1755a3127994",
                                "text": "De mensen die vanuit Canada vertrekken (de South Bounders, SOBO) vertrekken vaak in juni en komen begin november aan bij Mexico."
                            }
                        ]
                    }
                ],
