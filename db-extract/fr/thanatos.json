                "senses": [
                    {
                        "sense_id": "544a9c69-5747-339c-aff5-d1450a97536e",
                        "entry_id": "6dd7244b-ea39-3867-b61d-c453bd00d5aa",
                        "glosses": [
                            "Personnification de la mort."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb2b95b-8614-4f33-ac02-8b1c13008d18",
                                "sense_id": "544a9c69-5747-339c-aff5-d1450a97536e",
                                "text": "Thanatos est le frère d’Hypnos (le Sommeil), de Moros (la Fatalité), et des Kères (les Morts violentes)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac36a966-40af-3ad1-adca-2a286795e2d0",
                        "entry_id": "6dd7244b-ea39-3867-b61d-c453bd00d5aa",
                        "glosses": [
                            "Pulsion de mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d6abcd-0c20-4fbf-9dfb-053423059007",
                                "sense_id": "ac36a966-40af-3ad1-adca-2a286795e2d0",
                                "text": "Freud appelle force de la mort — Thanatos — cette tension du corps vers un état d’insensibilité et d’équilibre parfait et définitif."
                            }
                        ]
                    }
                ],
