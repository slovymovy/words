                "senses": [
                    {
                        "sense_id": "72d0eaa0-07cc-3972-b93e-6e060d69530f",
                        "entry_id": "32dbf261-b151-3f9f-8c1e-aaf48fa36c62",
                        "glosses": [
                            "Tasche, die sich an der Seite (der Jacke, des Mantels, …) befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143474c7-d645-4a33-bdd8-c59255e88e58",
                                "sense_id": "72d0eaa0-07cc-3972-b93e-6e060d69530f",
                                "text": "„Den leeren Jackenärmel hatte er sorgfältig in die Seitentasche gesteckt.“"
                            },
                            {
                                "example_id": "7d6b97d6-0280-42b8-be56-d98a91bbc0ff",
                                "sense_id": "72d0eaa0-07cc-3972-b93e-6e060d69530f",
                                "text": "„Tom schob behutsam seinen Laptop in die gepolsterte Seitentasche seiner Fahrradbox, als er sich nach diesem unglaublichen Nachmittag mit Noby auf den Weg nach Hause machte.“"
                            },
                            {
                                "example_id": "56a626d0-4625-4695-a7e4-413c6f2b5521",
                                "sense_id": "72d0eaa0-07cc-3972-b93e-6e060d69530f",
                                "text": "„Dann war früh Abends die Regenzeit angebrochen – jetzt habe ich nicht bereut, dass ich die wasserdichten Seitentaschen gekauft habe – ich hatte mich riesig gefreut, es war überhaupt kein Problem mit dem Wasser mehr, sie waren hundertprozentig dicht.“"
                            },
                            {
                                "example_id": "ef09efc9-b5ed-4975-a14c-a44c0a358e6d",
                                "sense_id": "72d0eaa0-07cc-3972-b93e-6e060d69530f",
                                "text": "„Kaffee hatte sie abgelehnt und auf ihre Wasserflasche gezeigt, die aus einer Seitentasche ihres dünnen Rucksacks herausschaute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
