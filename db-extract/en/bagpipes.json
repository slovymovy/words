                                                "example_id": "e1b1b11a-50e4-459c-95f1-365a963c5f6d",
                                                "sense_id": "54ad8ac2-b66b-3119-9aae-092f9cf03799",
                                                "text": "Tenant sa cornemuse par les bois, comme on saisit un lièvre aux oreilles, le piper courut jusqu’au château donner l’alerte."
                                            }
