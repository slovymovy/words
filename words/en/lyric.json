{
    "word_family": [
        "lyrical",
        "lyricism",
        "lyricist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afbee6e2-3834-3d79-9a6d-b4183e4ba9d0",
                    "sense_definition": "The words of a song or other vocal music.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lyric</w> in the third line of the chorus does not rhyme with the rest. ",
                            "target_lang_translations": {
                                "ru": "<w>Текст</w> в третьей строке припева не рифмуется с остальными."
                            }
                        },
                        {
                            "text": "She spent the whole afternoon trying to write a catchy <w>lyric</w> for her new song.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день, пытаясь написать запоминающийся <w>текст</w> для своей новой песни."
                            }
                        }
                    ],
                    "synonyms": [
                        "songword"
                    ],
                    "common_phrases": [
                        "song lyric",
                        "write a lyric",
                        "catchy lyric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слова песни или другого вокального произведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текст песни",
                                "target_lang_sense_clarification": "слова музыкального произведения"
                            },
                            {
                                "target_lang_word": "лирика",
                                "target_lang_sense_clarification": "текстовая составляющая песни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7420e39-1452-3d09-88c1-74cb3c051455",
                    "sense_definition": "A short poem that expresses the personal emotions or thoughts of a speaker.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet published a beautiful <w>lyric</w> about the passing of the seasons.",
                            "target_lang_translations": {
                                "ru": "Поэт опубликовал прекрасное <w>лирическое стихотворение</w> о смене времен года."
                            }
                        },
                        {
                            "text": "In this anthology, every <w>lyric</w> reflects the author's deep connection to nature.",
                            "target_lang_translations": {
                                "ru": "В этой антологии каждое <w>лирическое произведение</w> отражает глубокую связь автора с природой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "short lyric",
                        "poetic lyric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое стихотворение, выражающее личные чувства или мысли автора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лирическое стихотворение",
                                "target_lang_sense_clarification": "поэтический жанр"
                            },
                            {
                                "target_lang_word": "лирика",
                                "target_lang_sense_clarification": "произведение лирического жанра"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7394a111-065d-3bf1-8028-91d4b206befe",
                    "sense_definition": "Expressing the writer's emotions in an imaginative and beautiful way; <w>lyrical</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author's <w>lyric</w> prose makes the novel feel like a long, beautiful poem.",
                            "target_lang_translations": {
                                "ru": "<w>Лиричная</w> проза автора заставляет роман казаться длинной красивой поэмой."
                            }
                        },
                        {
                            "text": "She gave a <w>lyric</w> description of the sunset that moved everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Она дала <w>поэтичное</w> описание заката, которое тронуло всех присутствующих."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lyric prose",
                        "lyric style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий эмоции автора образным и красивым способом; лиричный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лиричный",
                                "target_lang_sense_clarification": "проникновенный и эмоциональный"
                            },
                            {
                                "target_lang_word": "поэтичный",
                                "target_lang_sense_clarification": "образный и возвышенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1f81d4f-e5a0-3acb-a28a-a40d4e344a56",
                    "sense_definition": "Relating to a category of poetry that expresses subjective thoughts and feelings in a songlike style.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sonnet is a classic example of <w>lyric</w> poetry used to express love.",
                            "target_lang_translations": {
                                "ru": "Сонет — это классический пример <w>лирической</w> поэзии, используемой для выражения любви."
                            }
                        },
                        {
                            "text": "Scholars often study <w>lyric</w> verse to understand the emotional climate of the era.",
                            "target_lang_translations": {
                                "ru": "Ученые часто изучают <w>лирические</w> стихи, чтобы понять эмоциональный климат эпохи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lyric poetry",
                        "lyric verse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к категории поэзии, выражающей субъективные мысли и чувства в песенном стиле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лирический",
                                "target_lang_sense_clarification": "относящийся к лирике как роду литературы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7708a8a4-2bbe-3fd1-b2a8-6d7e62c37b27",
                    "sense_definition": "Having a light, bright singing voice with a modest range, especially in opera.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young singer is a <w>lyric</w> soprano with a very clear and agile voice.",
                            "target_lang_translations": {
                                "ru": "Молодая певица — <w>лирическое</w> сопрано с очень чистым и подвижным голосом."
                            }
                        },
                        {
                            "text": "He was cast in the role because his <w>lyric</w> tenor was perfect for the part.",
                            "target_lang_translations": {
                                "ru": "Его взяли на эту роль, потому что его <w>лирический</w> тенор идеально подходил для этой партии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lyric soprano",
                        "lyric tenor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий легким, светлым певческим голосом с умеренным диапазоном, особенно в опере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лирический",
                                "target_lang_sense_clarification": "о типе певческого голоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fbe240f-a994-3547-afa1-67e404410569",
                    "sense_definition": "Relating to musical drama, opera, or the performance of music.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is famous for its grand <w>lyric</w> theater where many operas premiere.",
                            "target_lang_translations": {
                                "ru": "Город знаменит своим величественным <w>оперным</w> театром, где проходят премьеры многих опер."
                            }
                        },
                        {
                            "text": "The <w>lyric</w> stage requires performers to have both acting and singing skills.",
                            "target_lang_translations": {
                                "ru": "<w>Оперная</w> сцена требует от исполнителей как актерских, так и вокальных навыков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lyric theater",
                        "lyric stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыкальной драме, опере или исполнению музыки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лирический",
                                "target_lang_sense_clarification": "связанный с оперным искусством"
                            },
                            {
                                "target_lang_word": "музыкально-драматический",
                                "target_lang_sense_clarification": "относящийся к театру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f61578-99e5-3a6e-8c15-5eb56d65bada",
                    "sense_definition": "Relating to the lyre or music played on it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient Greek festivals often featured <w>lyric</w> performances accompanied by stringed instruments.",
                            "target_lang_translations": {
                                "ru": "На древнегреческих фестивалях часто устраивались <w>лирные</w> выступления в сопровождении струнных инструментов."
                            }
                        },
                        {
                            "text": "The museum displayed several <w>lyric</w> fragments from the classical period.",
                            "target_lang_translations": {
                                "ru": "В музее было выставлено несколько фрагментов <w>лир</w> классического периода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lyric instrument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к лире или музыке, исполняемой на ней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лирный",
                                "target_lang_sense_clarification": "связанный с инструментом лирой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a10c32f6-fddd-392e-9af3-e7c0a977cc0e",
                    "sense_definition": "A female given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her parents named her <w>Lyric</w> because they both loved music and poetry.",
                            "target_lang_translations": {
                                "ru": "Родители назвали ее <w>Лирик</w>, потому что оба любили музыку и поэзию."
                            }
                        },
                        {
                            "text": "<w>Lyric</w> decided to pursue a career in songwriting just like her namesake.",
                            "target_lang_translations": {
                                "ru": "<w>Лирик</w> решила продолжить карьеру в написании песен, прямо как ее тезка."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лирик",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad1c211-8096-3d08-b83c-c43e15052126",
                    "sense_definition": "A male given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Lyric</w> is a relatively modern and unique name for a boy.",
                            "target_lang_translations": {
                                "ru": "<w>Лирик</w> — относительно современное и уникальное имя для мальчика."
                            }
                        },
                        {
                            "text": "The teacher called on <w>Lyric</w> to read his essay to the class.",
                            "target_lang_translations": {
                                "ru": "Учитель вызвал <w>Лирика</w>, чтобы тот прочитал свое эссе классу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лирик",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}