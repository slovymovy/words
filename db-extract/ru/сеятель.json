                                        "glosses": [
                                            "Celui qui sème du grain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0a7f85-202f-4be5-826b-fa74ae660a88",
                                                "sense_id": "a528f3b7-1cf7-3570-8e6d-1f2a46cb2c94",
                                                "text": "Et il esquisse dans l’air des gestes de semeur, au ralenti."
                                            },
                                            {
                                                "example_id": "b215de37-61d3-4f6f-93dc-62e817623aed",
                                                "sense_id": "a528f3b7-1cf7-3570-8e6d-1f2a46cb2c94",
