                ],
                "senses": [
                    {
                        "sense_id": "5a61cf55-8f62-3425-8a84-8d84111c18a5",
                        "entry_id": "0d35871a-c423-386f-a451-c7987089e659",
                        "glosses": [
                            "kopflose Schraube mit Gewinde sowohl am Mutternende als auch am Einschraubende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc115308-048b-443f-8ea4-8907de6089bb",
                                "sense_id": "5a61cf55-8f62-3425-8a84-8d84111c18a5",
                                "text": "„Bei der Gestaltung von Verbindungen mit Stiftschrauben sind die durchaus verschiedenen Betriebsfälle zu beachten, die völlig unterschiedliche Belastungen der Gewindezone verursachen.“"
                            },
                            {
                                "example_id": "a1c0881d-b299-40ac-943f-d4ea9d913c9e",
                                "sense_id": "5a61cf55-8f62-3425-8a84-8d84111c18a5",
                                "text": "„Die Stiftschraube wird durch die mit Innengewinde versehenen Backen erfaßt.“"
                            },
                            {
                                "example_id": "83cebfb1-2f9b-4cc7-82b0-a2dfe8fce52e",
                                "sense_id": "5a61cf55-8f62-3425-8a84-8d84111c18a5",
                                "text": "„Für hochbelastete Dieselmotoren stellt die Stiftschraube für Lagerbügel und Zylinderkopfbefestigung die hochwertigere Verbindung auch bei Graugußgehäusen dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
