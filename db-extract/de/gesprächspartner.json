                    {
                        "form_id": "00b910db-1add-4757-98b6-777e42d2f817",
                        "entry_id": "22ec73af-564f-32df-a171-db57f9135886",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Gesprächspartner"
                    },
                    {
                        "form_id": "abc14b25-a1ae-464a-bc7e-a3da6aa9d2d8",
                        "entry_id": "22ec73af-564f-32df-a171-db57f9135886",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gesprächspartner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                        "entry_id": "22ec73af-564f-32df-a171-db57f9135886",
                        "glosses": [
                            "eine Person, die sich mit (einer) anderen im Gespräch befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af19116-cb26-4368-a939-5ef931d36cfb",
                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                "text": "„Es gibt tatsächlich auch Leute, die ihren Gesprächspartner im Eifer am Anzugsknopf festhalten und so lange damit spielen, bis er abgedreht ist.“"
                            },
                            {
                                "example_id": "71d08d04-23ab-4d03-8160-abd76d752224",
                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                "text": "„In acht Gruppen bearbeiteten die Jugendlichen verschiedene Fragen, etwa wie türkisch-deutsche Familien ihre Mehrsprachigkeit erleben oder wie die eigene Sprache auf den Gesprächspartner wirkt.“"
                            },
                            {
                                "example_id": "34c155e5-25c7-4c72-9c1e-2c2e12aa2466",
                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                "text": "„Es kommt vor, dass er das letzte Wort des Gesprächspartners wie ein Echo wiederholt, als Ausdruck von Höflichkeit, und um die Rede des anderen nicht ohne Antwort zu lassen.“"
                            },
                            {
                                "example_id": "664254a1-2754-4fea-a4fd-a7fe1ad87984",
                                "sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                                "text": "„Da es in der Stadt keine Gelehrtenzirkel und Salons gab, lernte Schlegel nur wenige anregende Gesprächspartner kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ef0e191-062b-483d-839b-386edcd833cf",
                        "source_entry_id": "22ec73af-564f-32df-a171-db57f9135886",
                        "source_sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                        "source_sense_description": "eine Person, die sich mit (einer) anderen im Gespräch befindet",
                        "target_lang_word": "interlocutor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interlocutor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc41d8f-da9a-3adf-ad53-19a4513913ef",
                                        "entry_id": "152d4195-f799-3e1f-b73e-91b7ef69a404",
                                        "glosses": [
                                            "A person who takes part in dialogue or conversation: a locutive partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db70d3e-b837-4165-b995-583f65ca8c3a",
                                                "sense_id": "cbc41d8f-da9a-3adf-ad53-19a4513913ef",
                                                "text": "Explanations which continually remind one's interlocutor of one's ignorance are a great damper upon the easy flow of talk."
                                            },
                                            {
                                                "example_id": "7b659961-028e-432d-bfc4-b2b01f1f68ef",
                                                "sense_id": "cbc41d8f-da9a-3adf-ad53-19a4513913ef",
                                                "text": "In the run-up to his return to the White House next Monday, Mr. Trump has rattled the world, and America’s neighborhood in particular, with a list of objectives – buying Greenland, seizing the Panama Canal, making Canada the 51st state – that treat friendly nations as weak interlocutors and impediments to be subdued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f2917f-e0eb-3b2d-86cd-2f952cb4454f",
                                        "entry_id": "152d4195-f799-3e1f-b73e-91b7ef69a404",
                                        "glosses": [
                                            "A man in the middle of the line in a minstrel show who questions the endmen and acts as leader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4838fd62-40a1-4dae-aa27-29c40dca3955",
                                                "sense_id": "53f2917f-e0eb-3b2d-86cd-2f952cb4454f",
                                                "text": "The \"interlocutor\" greeted the audience and engaged in comical repartee with the \"end men,\" named Tambo and Bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89cfc9ca-f899-3c7a-a631-63717286b878",
                                        "entry_id": "152d4195-f799-3e1f-b73e-91b7ef69a404",
                                        "glosses": [
                                            "An interlocutory judgement or sentence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "interlocutor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8b67c4-94d4-3f18-b0c6-2422eb108247",
                                        "entry_id": "84ca0e6c-434d-3979-b431-42f7f09acfe6",
                                        "glosses": [
                                            "A decree of a court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7d52b2-a95c-4a8c-a0f5-dd581f7b3013",
                                                "sense_id": "8c8b67c4-94d4-3f18-b0c6-2422eb108247",
                                                "text": "A decree of the English Court of Chancery is not entitled to more respect in Scotland than a decree (interlocutor) of the Scottish Court of Session in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f33dda86-63c7-4683-8d17-585b6e9f1a01",
                        "source_entry_id": "22ec73af-564f-32df-a171-db57f9135886",
                        "source_sense_id": "4b43217a-2844-3444-916d-b7ee9b3d5f76",
                        "source_sense_description": "eine Person, die sich mit (einer) anderen im Gespräch befindet",
                        "target_lang_word": "interlocuteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interlocuteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cef3a0f-7aad-39db-b52e-1e91460e98f7",
                                        "entry_id": "02999ef4-9277-374c-a415-434770e530bb",
                                        "glosses": [
                                            "Personne avec qui l’on échange dans le cadre d’une conversation ou d’un dialogue, qu’il soit formel ou informel."
                                        ],
                                        "tags": [
                                            "Communication"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "946d0a66-71cf-41d0-b762-7fe5b5c38fb4",
                                                "sense_id": "6cef3a0f-7aad-39db-b52e-1e91460e98f7",
                                                "text": "En algèbre, sentant mon interlocuteur plus calé que je ne le suis, je reprends mon rôle de disciple attentif."
                                            },
                                            {
                                                "example_id": "4fe390b8-7971-41b3-8067-ae33d78e006e",
                                                "sense_id": "6cef3a0f-7aad-39db-b52e-1e91460e98f7",
                                                "text": "[…], car il cessa de pérorer pour l'écouter avec une attention soutenue et elle finit par tenir le dé de la conversation, c'est-à-dire qu'à elle seule, elle parlait beaucoup plus que ses deux interlocuteurs, […]."
                                            },
                                            {
                                                "example_id": "91dbf2da-e93b-45a8-8d9d-eb6a2814bceb",
                                                "sense_id": "6cef3a0f-7aad-39db-b52e-1e91460e98f7",
                                                "text": "L’obsédante proximité de la rivière embrouillait les pensées du commissaire. Tantôt languide, tantôt tourbillonnante, elle oblitérait ses réflexions au point de provoquer de brusques réactions d’agacement ou de lassitude, à la grande surprise des interlocuteurs."
                                            },
                                            {
                                                "example_id": "f7c12e75-09a6-4d6a-a72d-a215891bb460",
                                                "sense_id": "6cef3a0f-7aad-39db-b52e-1e91460e98f7",
                                                "text": "La suite, c’est : la formation professionnelle, la réforme des retraites et celle de l’assurance-chômage, autant de sujets où les deux syndicats se voient bien renforcer leur influence en interlocuteurs privilégiés d’un dialogue social renouvelé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26391067-eca2-3716-a6f2-a0ae3f4d53ca",
                                        "entry_id": "02999ef4-9277-374c-a415-434770e530bb",
                                        "glosses": [
                                            "Personnage qu’un·e écrivain·e introduit dans un dialogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40b3122-3893-48a8-a0d7-6685ca6b30c9",
                                                "sense_id": "26391067-eca2-3716-a6f2-a0ae3f4d53ca",
                                                "text": "Il avait le dos tourné à son principal interlocuteur."
                                            },
                                            {
                                                "example_id": "4eed2b0e-3953-4e07-897b-b0b57119bc22",
                                                "sense_id": "26391067-eca2-3716-a6f2-a0ae3f4d53ca",
                                                "text": "Les interlocuteurs de la troisième scène seront debout."
                                            },
                                            {
                                                "example_id": "98d76162-c7d4-4d71-83d5-39f54a5693f8",
                                                "sense_id": "26391067-eca2-3716-a6f2-a0ae3f4d53ca",
                                                "text": "En réalité, les dialogues de cette série sont toujours écrits selon le même schéma : les protagonistes ont beau s’exprimer clairement, leurs interlocuteurs ne comprennent que ce qu’ils ont envie de comprendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae59f02a-ac6c-4f7b-b1b5-ee59f1b6d1a2",
                        "source_entry_id": "22ec73af-564f-32df-a171-db57f9135886",
