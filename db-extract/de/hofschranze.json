                        "form": "den Hofschranzen"
                    },
                    {
                        "form_id": "ac34b1ef-2352-423f-a12a-fae986ab9bc1",
                        "entry_id": "6a2c3da0-0f02-3091-a017-b4603a643a01",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hofschranzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                        "entry_id": "6a2c3da0-0f02-3091-a017-b4603a643a01",
                        "glosses": [
                            "charakterloser Angehöriger der Hofgesellschaft, der sich dem Fürsten gegenüber liebedienerisch verhält"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "73f26b00-5d27-4336-9aa1-a2787b687ee3",
                                "sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                                "text": "Gefällt dem Fürsten ein Schmeichler, ein müßiggehender Hofschranze vorzüglich wohl, so gibt er ihm den Rang eines Feldherrn und überschüttet ihn mit Reichtümern, die hundert arbeitsame Familien aus dem Elende retten würden."
                            },
                            {
                                "example_id": "d555209b-1498-42d4-bee4-a3b58204c181",
                                "sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                                "text": "Was plaudert nicht eine Hofschranze! Und hätte ich ihn doch nur plaudern lassen!"
                            },
                            {
                                "example_id": "df922751-d070-4771-82a6-b2599c5a20fc",
                                "sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                                "text": "Wenn man sie nicht als Hofschranze, sondern als unabhängiger Kritiker beurteilt, so muss man zu dem Schlusse gelangen, daß sie es ohne ihre fürstliche Geburt in den gewählten Gebieten aus eigener Kraft nie zu einer ansehnlichen Stellung gebracht hätten."
                            },
                            {
                                "example_id": "ddf5da0d-a9a6-4671-9575-12043f447207",
                                "sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                                "text": "Was hat ein müßiger Hofschranze, was hat ein reicher Tagedieb, der um sein bares Geld sich Titel und Rang erkauft hat, vor dem fleißigen Bürger voraus, der seinen Unterhalt auf erlaubte Weise durch seiner Hände Arbeit erwirbt?"
                            },
                            {
                                "example_id": "dac84ddd-8a77-4631-85a1-1765459e60ac",
                                "sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                                "text": "Der Zar wandte sich an seinen Astrologen: »Eine Frage, Stepan Simonowitsch, warum benimmt sich unsere Reisegefährtin plötzlich wie eine Hofschranze?«"
                            },
                            {
                                "example_id": "a9b77ac2-f311-440d-803a-950188a6f428",
                                "sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                                "text": "Der Hofschranze tobte eine Weile, schrie lautstark um Hilfe, doch die Bewaffneten rührten sich keinen Meter vom Fleck."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1f544e8-5caa-4c78-824e-beffa9a1823f",
                        "source_entry_id": "6a2c3da0-0f02-3091-a017-b4603a643a01",
                        "source_sense_id": "cf5ce25c-9c33-3e04-a1b8-e7ff5d5c7b37",
                        "source_sense_description": "charakterloser Angehöriger der Hofgesellschaft",
                        "target_lang_word": "lackey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lackey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57030b33-863e-3965-8bea-fd6282539c21",
                                        "entry_id": "fa1611fc-e319-3e4c-a278-707e9bf31ccc",
                                        "glosses": [
                                            "A footman, a liveried male servant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7da5c3e-65f2-4a3b-9263-39a954a1ad4d",
                                                "sense_id": "57030b33-863e-3965-8bea-fd6282539c21",
                                                "text": "My dearest father,—I say nothing of them,—but I dare to speak of myself,—I can never be a monk,—if that is your object—spurn me,—order your lacqueys to drag me from this carriage,—leave me a beggar in the streets to cry “fire and water,”—but do not make me a monk."
                                            },
                                            {
                                                "example_id": "77827604-cf7b-42cb-8a9c-0a37f30fa989",
                                                "sense_id": "57030b33-863e-3965-8bea-fd6282539c21",
                                                "text": "St. Martin [of Tours] looks round, first, deliberately;—becomes aware of a tatterdemalion and thirsty-looking soul of a beggar at his chair side, who has managed to get his cup filled somehow, also—by a charitable lacquey. St. Martin turns his back on the Empress, and hobnobs with him!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366b0de9-74a5-3b28-9f4f-8456ce33672d",
                                        "entry_id": "fa1611fc-e319-3e4c-a278-707e9bf31ccc",
                                        "glosses": [
                                            "A fawning, servile follower."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lackey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "668ec693-8397-3e2d-85f6-cd5ec8f42b9a",
                                        "entry_id": "f0262200-237d-30bc-9e32-354feb807c68",
                                        "glosses": [
                                            "To attend, wait upon, serve obsequiously."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fe561e9-44a7-4872-83c4-613a304039d3",
                                                "sense_id": "668ec693-8397-3e2d-85f6-cd5ec8f42b9a",
                                                "text": "[T]he ebbed man, ne'er loved till ne'er worth love,\nComes deared by being lacked. This common body,\nLike to a vagabond flag upon the stream,\nGoes to and back, lackeying the varying tide,\nTo rot itself with motion."
                                            },
                                            {
                                                "example_id": "40dab9ff-c5b1-4deb-9487-074299c43b10",
                                                "sense_id": "668ec693-8397-3e2d-85f6-cd5ec8f42b9a",
                                                "text": "So dear to Heav'n is Saintly chastity,\nThat when a soul is found sincerely so,\nA thousand liveried Angels lacky her […]",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9571f38-43df-3159-b04a-147f52a10f46",
                                        "entry_id": "f0262200-237d-30bc-9e32-354feb807c68",
                                        "glosses": [
                                            "To toady, play the flunky."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11e2bd77-7380-4d5e-a5bf-0ad20416be44",
                        "source_entry_id": "6a2c3da0-0f02-3091-a017-b4603a643a01",
