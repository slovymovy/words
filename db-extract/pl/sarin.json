                            {
                                "example_id": "5d90ac26-22c2-4ddf-9ae7-28fb8b36519d",
                                "sense_id": "ff9d8e03-21e5-39a8-997e-c9997b960ef4",
                                "text": "O 9:30 nadszedł pierwszy komunikat, że przyczyną zatrucia mógł być sarin."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
