                        ],
                        "examples": [
                            {
                                "example_id": "1eda9de0-ca08-4d16-a3bf-1822ad35b18c",
                                "sense_id": "b066558a-9f9d-3b12-82fb-44dabbbe2279",
                                "text": "Quoi qu’on fasse et où qu’on aille, des murs s’élèvent autour de nous et par nos soins, abris d’abord, et bientôt prison."
                            },
                            {
                                "example_id": "face43d2-81b8-4056-ac17-60cf21a47025",
                                "sense_id": "b066558a-9f9d-3b12-82fb-44dabbbe2279",
                                "text": "On gratta et lava les murs noircis de fumée autant pour les rendre beaux que pour les désimprégner de l’individu lui-même."
                            }
                        ]
                    }
