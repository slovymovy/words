                "senses": [
                    {
                        "sense_id": "4528217f-b423-322a-9d7d-e6f9b9bfc2e5",
                        "entry_id": "0cb14978-61eb-365f-92b7-817124bbc10b",
                        "glosses": [
                            "Sensibiliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56365b01-c401-4e10-8c56-589c6694a0bd",
                                "sense_id": "4528217f-b423-322a-9d7d-e6f9b9bfc2e5",
                                "text": "Et il commença de se rattacher et de se resensibiliser."
                            },
                            {
                                "example_id": "0296f4d1-278e-405b-9501-b9cafffc9f4b",
                                "sense_id": "4528217f-b423-322a-9d7d-e6f9b9bfc2e5",
                                "text": "Par contre, la facilité de la télévision et de la radio à franchir ces mêmes frontières sert aujourd'hui à nous resensibiliser à des réseaux de langues jusqu(ici trop négligés."
                            },
                            {
                                "example_id": "f3444e7f-1946-4ada-bc36-519f19a493df",
                                "sense_id": "4528217f-b423-322a-9d7d-e6f9b9bfc2e5",
                                "text": "De plus, cette suspension thérapeutique aurait l'intérêt de « resensibiliser » la population virale et de retrouver une certaine efficacité virologique."
                            }
                        ]
                    }
