                "senses": [
                    {
                        "sense_id": "44487ac4-537d-35cd-a1e4-c1451cfa3be5",
                        "entry_id": "867cf6f2-89e9-3de1-bff0-d054736f1bcc",
                        "glosses": [
                            "Mond des Saturns; Mond, der den Saturn umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff2825a-4c8f-45ed-bf72-a253f6f9f1ee",
                                "sense_id": "44487ac4-537d-35cd-a1e4-c1451cfa3be5",
                                "text": "„Am Computer ließ er Simulationen mit Körpern in einer viskosen Scheibe laufen und berechnete so die Strukturen, die eventuell vorhandene Saturnmonde durch das Wirken von Gravitationskräften im Ring hinterlassen.“"
                            },
                            {
                                "example_id": "880e61f8-5fbd-425a-a713-ae074662335b",
                                "sense_id": "44487ac4-537d-35cd-a1e4-c1451cfa3be5",
                                "text": "„Er ist der kleinste Planet des Sonnensystems und mit einem Durchmesser von 4.878 Kilometern nur wenig größer als der Erdmond – und kleiner als Jupitermond Ganymed und Saturnmond Titan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
