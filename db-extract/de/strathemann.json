                ],
                "senses": [
                    {
                        "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                        "entry_id": "a42b3ffe-bf3d-3c90-bd57-c2e835c6c2e5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20462f12-d92b-4ba6-a71a-cb85dcfb7e4a",
                                "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                                "text": "Frau Strathemann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c275fd19-ac27-4618-bf1d-448414f44151",
                                "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                                "text": "Herr Strathemann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "eb79b367-a07c-492c-8c46-170d81147ced",
                                "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                                "text": "Die Strathemanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7336cfc9-ee89-4b6c-a808-505618678528",
                                "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                                "text": "Der Strathemann trägt nie die Schals, die die Strathemann ihm strickt."
                            },
                            {
                                "example_id": "17d453c6-2e3c-4bcb-9c29-abe70de8d8bf",
                                "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Strathemann kommt, geht der Herr Strathemann.“"
                            },
                            {
                                "example_id": "6ba8666c-01ae-4f28-bbdf-15f381a9cd20",
                                "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                                "text": "Strathemann kommt und geht."
                            },
                            {
                                "example_id": "f2dca3ef-55a1-4252-9277-6ce58e3ad8e2",
                                "sense_id": "894a5a68-943e-39c6-9da4-fd7d02b2f26c",
                                "text": "Strathemanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
