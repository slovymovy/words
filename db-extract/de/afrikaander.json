                        "translation_id": "7f3c4e21-2529-4463-b2f5-aaeb31b649b2",
                        "source_entry_id": "87474029-30a5-38d6-885d-49909efbf795",
                        "source_sense_id": "4fecfbfe-2817-3dbb-a0a1-bf3adeda0c07",
