                    ]
                },
                {
                    "sense_id": "38858af6-1965-3ba5-a214-4c455837a2bc",
                    "sense_definition": "À une température inférieure à zéro degré.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait très froid ce matin, le thermomètre affiche cinq degrés <w>au-dessous</w>."
                        },
                        {
                            "text": "En plein hiver dans cette région montagneuse, la température descend souvent bien <w>au-dessous</w>."
                        }
                    ],
                    "common_phrases": [
                        "degrés au-dessous"
                    ]
                },
                {
                    "sense_id": "981f09c6-58f3-3638-8843-0abcf4dc3866",
                    "sense_definition": "Au théâtre, placé sur le devant de la scène par rapport à un meuble ou un comédien, du point de vue du public.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le metteur en scène lui a demandé de se placer un peu <w>au-dessous</w> de la table."
                        },
                        {
                            "text": "Durant toute la tirade du second acte, le comédien est resté immobile <w>au-dessous</w> du fauteuil."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "9003cad4-1aed-3aef-b83b-38e1d49bbda5",
                    "sense_definition": "Sous, à un niveau inférieur à (généralement en locution avec la préposition de).",
