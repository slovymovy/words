                "senses": [
                    {
                        "sense_id": "3fa65c22-6b30-34ba-acaa-e04d93440bee",
                        "entry_id": "2677b5f3-87d6-3641-8c9e-164a68b9af22",
                        "glosses": [
                            "Stadtteil von Hongkong"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00117f2f-00b2-4b9e-a765-0f6849fa9516",
                                "sense_id": "3fa65c22-6b30-34ba-acaa-e04d93440bee",
                                "text": "„Colin aufzuspüren war lächerlich einfach gewesen, viel einfacher, als jemandem durch das verzweigte Labyrinth von Kowloon zu folgen.“"
                            },
                            {
                                "example_id": "9d53ac2e-87fe-4454-b1b0-f9516b63e20b",
                                "sense_id": "3fa65c22-6b30-34ba-acaa-e04d93440bee",
                                "text": "„Als er die Augen vom Seitenspiegel abwandte, erhaschte er einen ersten Blick auf sein Fünfsternehotel, das Peninsula Hong Kong an der Südspitze Kowloons, direkt auf der gegenüberliegenden Straßenseite von der Fähranlegestelle am Hafen.“"
                            },
                            {
                                "example_id": "abf082c0-bb26-401b-8f71-758cb903ceff",
                                "sense_id": "3fa65c22-6b30-34ba-acaa-e04d93440bee",
                                "text": "„In Kowloon gibt es nicht nur viele Menschen, sondern überhaupt viel von allem, besonders Neonlicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
