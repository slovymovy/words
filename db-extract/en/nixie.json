                                "target_senses": [
                                    {
                                        "sense_id": "4f50eeb0-3e59-3de2-9949-9ee5913fe05c",
                                        "entry_id": "1099ab89-affa-3804-aeea-fb3b4ea31e3b",
                                        "glosses": [
                                            "nadpřirozená bytost, zpravidla v podobě krásné ženy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afd4b4fd-8f97-49ef-b959-864fc26fee9f",
                                                "sense_id": "4f50eeb0-3e59-3de2-9949-9ee5913fe05c",
                                                "text": "Uprostřed nesčetných pivoněk bydlela útlá, spanilá víla, jejíž něžné tělo krylo průsvitné, červené roucho."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ec48f9-9c46-39a4-a636-dc44091d16bc",
                                        "entry_id": "1099ab89-affa-3804-aeea-fb3b4ea31e3b",
                                        "glosses": [
                                            "krásná žena"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8d85f8e-65b6-4f9c-8526-bfca316f7bb2",
                                                "sense_id": "e2ec48f9-9c46-39a4-a636-dc44091d16bc",
                                                "text": "Jak se tam octla najednou mladá, oslňující půvabem, víla z dálného zeleného a květnatého údolí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
