                "senses": [
                    {
                        "sense_id": "694d6290-6aef-3e05-8714-e9aad6f00473",
                        "entry_id": "82e4a0f9-05eb-34f5-aa66-44cba29a8957",
                        "glosses": [
                            "Ventiler par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919ef0a4-aa4b-4781-bc78-dbe9743f618d",
                                "sense_id": "694d6290-6aef-3e05-8714-e9aad6f00473",
                                "text": "Cette technologie possède la propriété unique de pouvoir autoventiler les produits de combustion dans l'atmosphère."
                            },
                            {
                                "example_id": "c892a41b-c694-418d-b5d5-c6d5c888a7de",
                                "sense_id": "694d6290-6aef-3e05-8714-e9aad6f00473",
                                "text": "J'ai aussi des soucis avec la HD qui chauffe énormément, elle n'a pas une seule ouverture pour s'autoventiler."
                            },
                            {
                                "example_id": "7b56b30b-57e1-4e69-ae4b-b4f255da359b",
                                "sense_id": "694d6290-6aef-3e05-8714-e9aad6f00473",
                                "text": "Contrôler que le moteur peut s'autoventiler."
                            }
                        ]
                    }
