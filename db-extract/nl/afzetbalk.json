                        "examples": [
                            {
                                "example_id": "25481c22-e6ef-4470-bdba-cb51a3632e2f",
                                "sense_id": "521abf15-1385-3cbb-88d1-188d54199915",
                                "text": "Na die supersprong werd de afzetbalk lager gezet en bovendien viel de wind weg, waardoor Kubacki 'slechts' 121,5 meter ver kwam. Hij kreeg echter genoeg compensatie voor de lagere afzetbalk om alsnog de winst te pakken."
                            },
                            {
                                "example_id": "0fdd4d77-42e3-4723-acb3-daee3060c373",
                                "sense_id": "521abf15-1385-3cbb-88d1-188d54199915",
                                "text": "Johnson-Thompson, met een persoonlijk record van 6,92 meter de beste van het veld, nam na twee mislukte pogingen bij haar derde poging ook veel risico. Ze plaatste haar voet net iets te ver op de afzetbalk."
                            }
