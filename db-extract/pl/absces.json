                                                "sense_id": "58464cdf-7f89-3f4d-88de-12eb07e98d93",
                                                "text": "„Er nahm an, dass es sich um eine Art Eitergeschwüre handeln musste, deren Faulgase womöglich für das Licht verantwortlich waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
