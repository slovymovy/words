                "senses": [
                    {
                        "sense_id": "6e629e42-36dd-3b5d-ad5f-946801e1ae5a",
                        "entry_id": "00db220e-aaf1-32c6-a59f-d46228b08306",
                        "glosses": [
                            "зоол. отряд насекомых с неполным превращением; как правило, с твёрдыми передними и перепончатыми задними крыльями"
                        ],
                        "tags": [],
