                                "target_senses": [
                                    {
                                        "sense_id": "c4f943b5-7b44-3b74-b79e-ac5009d9bd25",
                                        "entry_id": "e9d8e735-bddc-3542-9963-c4b555cfabbe",
                                        "glosses": [
                                            "Relating to macroeconomics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64f9e5a3-4932-3c75-9cd8-ad7425e12d8f",
                                        "entry_id": "e9d8e735-bddc-3542-9963-c4b555cfabbe",
                                        "glosses": [
                                            "Relating to the entire economy, including the growth rate, money and credit, exchange rates, the total amount of goods and services produced, total income earned, the level of employment of productive resources, and the general behavior of prices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bc7736b-d537-4ab8-b1a5-eb8a75be09ff",
                                                "sense_id": "64f9e5a3-4932-3c75-9cd8-ad7425e12d8f",
                                                "text": "On Monday, chipmaker Nvidia (NVDA) cut its sales outlook for the fourth quarter, citing “deteriorating macroeconomic conditions, particularly in China.” Last week, Intel’s (INTC) CEO also noted that “trade and macro concerns, especially in China, have intensified.”"
                                            },
                                            {
                                                "example_id": "77a9e3f2-393f-4a44-8466-2c2ef35a9a9b",
                                                "sense_id": "64f9e5a3-4932-3c75-9cd8-ad7425e12d8f",
                                                "text": "But judges, law students, economists, human rights experts, and Mexico’s most important trading partners worry [the judicial reform] could lead to democratic backsliding – and macroeconomic turbulence – that the incoming President Claudia Sheinbaum will inherit when she takes office Oct. 1."
                                            }
                                        ]
                                    }
                                ]
                            }
