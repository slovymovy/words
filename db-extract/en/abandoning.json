                    {
                        "sense_id": "5257bf3c-4f70-3ee5-b3e1-4acc67fd3b89",
                        "entry_id": "19dd1779-7158-3d4f-abd7-5a6ff771234b",
                        "glosses": [
                            "An act in which something or someone is abandoned; abandonment, neglect"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f153cb1-cb5b-4b1b-a9e8-cd596b669e18",
                                "sense_id": "5257bf3c-4f70-3ee5-b3e1-4acc67fd3b89",
                                "text": "Their sensuality—[…] —their universal and insatiable lustings, and disgraceful abandonings of their unhappy victims— […] may not be credited by those who have not proof of such crimes."
                            },
                            {
                                "example_id": "0fb6ad4b-017f-4eac-a4e5-192f0cde95f3",
                                "sense_id": "5257bf3c-4f70-3ee5-b3e1-4acc67fd3b89",
                                "text": "I […] owe the one who depends upon me the gentlest of abandonings, if I leave him."
                            },
                            {
                                "example_id": "5aedbfa4-b99e-48ff-ab5f-16aa38913b93",
                                "sense_id": "5257bf3c-4f70-3ee5-b3e1-4acc67fd3b89",
                                "text": "We live in time and through it, we build our huts in its ruins and we cannot afford all these abandonings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1b615fb-7aa6-48f1-931a-8302340e3860",
