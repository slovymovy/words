                                                "sense_id": "2faa946f-ad76-3d69-b2bd-1f4f12355f3c",
                                                "text": "Пойдём сегодня в кино!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "183687d6-5c81-3b05-b537-d69068efdf33",
                                        "entry_id": "69e68f6c-9cfa-3913-a883-188685c875c9",
                                        "glosses": [
                                            "перен., ирон. забавная ситуация, интересное, необычное происшествие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c360300-694a-4c71-a31b-6c024f0e63bc",
                                                "sense_id": "183687d6-5c81-3b05-b537-d69068efdf33",
