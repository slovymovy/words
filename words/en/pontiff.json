                    "frequency": "Middle",
                    "semantic_group_id": "religious_leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Roman Catholic <w>pontiff</w> addressed thousands of worshippers gathered in the square."
                        },
                        {
                            "text": "In several respects, he turned out to be an unexpected figure as the supreme <w>pontiff</w>."
                        }
                    ],
                    "synonyms": [
