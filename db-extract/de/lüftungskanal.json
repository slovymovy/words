                ],
                "senses": [
                    {
                        "sense_id": "e1110bf7-3c81-3a6f-8720-7d78bedd7358",
                        "entry_id": "845fef5a-acd9-3b87-8b3e-8e37d29f3907",
                        "glosses": [
                            "ein aus Blech oder anderen Materialien geformter rechteckiger/ovaler Kanal, in welchem Luft in einer Lüftungsanlage strömt bzw. transportiert wird"
                        ],
                        "tags": [
                            "Lüftung"
                        ],
                        "examples": [
                            {
                                "example_id": "643a1b96-aa3b-4a88-afc9-ce0f3f4af604",
                                "sense_id": "e1110bf7-3c81-3a6f-8720-7d78bedd7358",
                                "text": "„Der Lüftungskanal oder -rohr ist ein zentraler Bestandteil jeder Lüftungsanlage–egal ob zentrale oder dezentrale Lüftung. In der Regel bestehen Lüftungskanäle aus runden oder eckigen Bauteilen–einen runden Lüftungskanal nennt man auch Wickelfalzrohr.“"
                            },
                            {
                                "example_id": "888f584d-6a85-4de4-a1f6-301a40241274",
                                "sense_id": "e1110bf7-3c81-3a6f-8720-7d78bedd7358",
                                "text": "„In einem Lüftungskanal sind zur Versteifung gegenüberliegende Kanalwände auf der Kanalmitte durch einen Profilstab miteinander starr verbunden.“"
                            },
                            {
                                "example_id": "17569f7a-b740-4895-a6fb-ec5c3533de9c",
                                "sense_id": "e1110bf7-3c81-3a6f-8720-7d78bedd7358",
                                "text": "„Es wird ein Lüftungskanal aus einzelnen über Stoßflansche (2) miteinander verbindbaren Kanalabschnitten mit rechteckigem Querschnitt beschrieben, wobei die […]“"
                            },
                            {
                                "example_id": "3f640475-d0af-4f64-9486-5c6fe174c858",
                                "sense_id": "e1110bf7-3c81-3a6f-8720-7d78bedd7358",
                                "text": "„Lüftungskanäle und Formstücke aus Stahl verzinkt gefalzt nach DIN EN 1505, DIN EN 1507 und VDI 3803“"
                            },
                            {
                                "example_id": "2a2ae52f-b2a7-4568-b872-f24817c2dfd3",
                                "sense_id": "e1110bf7-3c81-3a6f-8720-7d78bedd7358",
                                "text": "„Vertikale Lüftungskanäle sind nicht zu beproben, weil dort kaum Schmutzanlagerungen ineiner nennenswerten Form auftreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
