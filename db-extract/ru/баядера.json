                                            {
                                                "example_id": "a04bb1aa-ac6b-4a2a-8f97-af8ace8fd75f",
                                                "sense_id": "47a1d319-6d56-3aa7-8037-7ae7a610d9fb",
                                                "text": "„Der Gott und die Bajadere (Indische Legende) ist der Titel einer Ballade von Johann Wolfgang von Goethe, die er zwischen dem 6. und 9. Juni 1797 in Jena schrieb.“"
                                            }
