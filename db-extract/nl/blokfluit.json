                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18bad36b-e46e-4405-ba4d-a9b81d0cb343",
                                "sense_id": "b78ba6b9-963a-398f-9a30-5af10a2888fa",
                                "text": "Zij speelt blokfluit.",
                                "translation": "Sie spielt Blockflöte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6225b67-3188-49df-89ef-4d7bfc581853",
                        "source_entry_id": "bb6034c5-2993-33b3-b697-8f8257ec5f25",
                        "source_sense_id": "b78ba6b9-963a-398f-9a30-5af10a2888fa",
                        "source_sense_description": "Blockflöte",
                        "target_lang_word": "Blockflöte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blockflöte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcf88c07-6c47-3329-803b-00a7cf0c457a",
                                        "entry_id": "15d207f4-6c90-3ce4-98b5-49cc03ff4515",
                                        "glosses": [
                                            "zu den Holzblasinstrumenten gehörende Längsflöte mit Schnabel"
                                        ],
                                        "tags": [
                                            "Musikinstrument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4562ecad-d907-404c-9b9c-06e620e9dc30",
                                                "sense_id": "dcf88c07-6c47-3329-803b-00a7cf0c457a",
                                                "text": "Viele Kinder lernen als erstes Instrument Blockflöte."
                                            },
                                            {
                                                "example_id": "d108a792-71d9-4a5a-83ff-cc591c317217",
                                                "sense_id": "dcf88c07-6c47-3329-803b-00a7cf0c457a",
                                                "text": "„Die Blockflöte ist nicht das Virtuoseninstrument, zu dem es auch schon wieder einige machen wollen. […] Wir müssen lernen, mit Blockflötenohren zu hören und mit Blockflötenfingern zu spielen, nicht mit Querflötenohren und mit Geigenfingern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01ccf964-ce09-3486-9860-5f0dc5d49396",
                                        "entry_id": "15d207f4-6c90-3ce4-98b5-49cc03ff4515",
                                        "glosses": [
                                            "Angehöriger einer Blockpartei in der DDR"
                                        ],
                                        "tags": [
                                            "volkstümlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7e79fe8-1a30-431e-a2d8-4a4ce873bc0b",
                                                "sense_id": "01ccf964-ce09-3486-9860-5f0dc5d49396",
                                                "text": "„[Lafontaine:] Es ist doch einfach nicht begreiflich, dass die CDU in Ostdeutschland in Gemeinden und Landkreisen mit der PDS koaliert und dass dieselben Blockflöten auf dem Bundesparteitag der CDU gerade beschlossen haben, ihr Tun sei verwerflich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d5d1460-5e58-4d2f-90aa-6c322e15f36f",
                        "source_entry_id": "bb6034c5-2993-33b3-b697-8f8257ec5f25",
                        "source_sense_id": "b78ba6b9-963a-398f-9a30-5af10a2888fa",
                        "source_sense_description": "Blockflöte",
                        "target_lang_word": "recorder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31065c03-2d4e-39ff-98bf-8788eef407ed",
                                        "entry_id": "51614616-0c02-3ed0-ad51-2ff90f8cb076",
                                        "glosses": [
                                            "An apparatus for recording; a device which records."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea81e1d-f857-4930-90da-545f82eddd73",
                                                "sense_id": "31065c03-2d4e-39ff-98bf-8788eef407ed",
                                                "text": "A smartphone is not the best camera, notebook, word processor, audio recorder, radio, MP3 player, map reader, pedometer and so on, but it is good enough replace numerous separate devices for most people most of the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32432ca1-29b7-34c7-8588-820f0243839f",
                                        "entry_id": "51614616-0c02-3ed0-ad51-2ff90f8cb076",
                                        "glosses": [
                                            "Agent noun of record; one who records."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb89a0ba-9a0b-3615-bf1d-532f8b9b07ca",
                                        "entry_id": "51614616-0c02-3ed0-ad51-2ff90f8cb076",
                                        "glosses": [
                                            "A judge in a municipal court."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "recorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                        "entry_id": "c80ef65d-f0c8-3241-bb1a-2a56c8d9cfed",
                                        "glosses": [
                                            "A musical instrument of the woodwind family; a type of fipple flute, a simple internal duct flute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839dcff4-7dcc-432d-a531-f4ce58259d40",
                                                "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                                "text": "Recorders are made in various sizes, from the high soprano or descant recorder to the low bass recorder."
                                            },
                                            {
                                                "example_id": "8bfaa64b-64b2-4702-8f92-e95cc5a01be6",
                                                "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                                "text": "Indeed he hath played on his prologue like a child on a recorder; a sound, but not in government."
                                            },
                                            {
                                                "example_id": "18d2e241-6a94-419a-b1b2-66ebe57b36f8",
                                                "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                                "text": "[…] he beheld\nThe city fronted with bright fires, and heard\nPipes, and recorders, and the hum of war;"
                                            },
                                            {
                                                "example_id": "fdfd1e3a-202d-43b0-a128-3158aa588161",
                                                "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                                "text": "On his [Hamlet’s] taking the recorders—very like a little black flute that had just been played in the orchestra and handed out at the door—he was called upon unanimously for Rule Britannia."
                                            },
                                            {
                                                "example_id": "bca0664b-d76f-447f-990f-1e821e32976f",
                                                "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                                "text": "And when they paused on a hilltop for lunch, he whipped out his battered recorder and commenced to tootling “Greensleeves,” scaring off all living creatures within a five-mile radius—which may have been his intention."
                                            },
                                            {
                                                "example_id": "7333a20a-8f84-4281-b169-0bb2f9060508",
                                                "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                                "text": "[…] he had huffed into his white plastic recorder while scowling at the sheets of music that lay open on the wobbly stainless-steel stand."
                                            },
                                            {
                                                "example_id": "694fbc30-de52-46cb-8d9a-3140d0c543d3",
                                                "sense_id": "cf9ac55a-16c8-321c-b86b-c92b95260f1a",
                                                "text": "Recorder players today will disagree, and probably hate me for saying so, but all these “historically authentic” recorders used today generally produce – with rare exceptions – a rather plain, lifeless, non-vibrato, non-singing performance. This appeals only to recorder players themselves, early music fans and academic music specialists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
