                "senses": [
                    {
                        "sense_id": "2e35f4b4-96b5-3ca1-9286-fbf6c8d4e872",
                        "entry_id": "8561d1f8-0054-3f9b-b7fa-fdca9d3d80df",
                        "glosses": [
                            "Teilnehmerin an einem Vorgespräch zu einer Koalitionsverhandlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0063597-247f-4a40-a109-a32e86b40180",
                                "sense_id": "2e35f4b4-96b5-3ca1-9286-fbf6c8d4e872",
                                "text": "„Die Grünen vermuten, dass die Linken doch noch Ina Leukefeld - eine ehemalige IM der Stasi-nahen Polizeieinheit K1 - als Sondiererin aufstellen könnten.“"
                            },
                            {
                                "example_id": "458c3f87-e0c5-4a4e-9520-c2100d1e0da1",
                                "sense_id": "2e35f4b4-96b5-3ca1-9286-fbf6c8d4e872",
                                "text": "„Und was haben sie besprochen, am frühen Abend in der abgelegenen Sitzecke im Heidenheimer Kongresszentrum: Kretschmann, Özdemir und Agnieszka Brugger, die Sondiererin, die ebenfalls für höhere Aufgaben gehandelt wird?“"
                            },
                            {
                                "example_id": "696b1b4e-efc0-422f-9a49-084260db7b60",
                                "sense_id": "2e35f4b4-96b5-3ca1-9286-fbf6c8d4e872",
                                "text": "„Sondiererin Kramp-Karrenbauer bei Verkehrsunfall verletzt“"
                            },
                            {
                                "example_id": "f2a26da3-e76e-4cd8-a564-8e16bc786abf",
                                "sense_id": "2e35f4b4-96b5-3ca1-9286-fbf6c8d4e872",
                                "text": "„Sondiererin bei Unfall verletzt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f1721e23-cabe-3e4e-b43e-b101058bea3f",
                        "entry_id": "8561d1f8-0054-3f9b-b7fa-fdca9d3d80df",
                        "glosses": [
                            "weibliche Person, die eine Lage erkundet"
                        ],
                        "tags": [
                            "sehr selten außerhalb der Politik"
                        ],
                        "examples": [
                            {
                                "example_id": "40c245a5-5ff8-4692-a0b5-ccf6e043a5e4",
                                "sense_id": "f1721e23-cabe-3e4e-b43e-b101058bea3f",
                                "text": "„»Eine Laufbahn als Feuerwerkerin bei der Bundeswehr war zu Beginn meiner beruflichen Tätigkeit für Frauen noch nicht möglich. Ich absolvierte daher die bestmögliche Ausbildung im zivilen Bereich – mit drei Lehrgängen als Sondiererin/Munitionsräumerin, Hilfstruppführerin und Truppführerin an der Sprengschule Dresden«, so Tanya Beimel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
