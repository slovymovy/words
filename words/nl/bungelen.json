                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is in de volksmond gebruikelijk om <w>bungelen</w> te zeggen in plaats van de standaardvorm.",
                            "target_lang_translations": {
                                "en": "It is common in colloquial speech to say <w>bungelen</w> instead of the standard form."
