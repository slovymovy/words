                {
                    "sense_id": "a5d65984-1a05-3655-a939-8a47a755da46",
                    "sense_definition": "Zustand oder Eigenschaft, sein Leben eigenverantwortlich zu gestalten und nicht auf die Hilfe anderer angewiesen zu sein",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "autonomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eltern sollten ihre heranwachsenden Kinder frühzeitig zur <w>Selbstständigkeit</w> erziehen."
                        },
                        {
                            "text": "Mit dem Auszug aus dem Elternhaus begann für sie ein neues Leben voller <w>Selbstständigkeit</w>."
                        }
                    ],
                    "synonyms": [
                        "Eigenständigkeit",
                        "Unabhängigkeit"
                    ],
                    "antonyms": [
                        "Abhängigkeit",
                        "Unselbstständigkeit"
                    ],
                    "common_phrases": [
                        "zur Selbstständigkeit erziehen",
                        "Schritt in die Selbstständigkeit"
                    ]
                },
                {
                    "sense_id": "15796bf4-aa32-3f48-bd8b-8f483b02de6c",
                    "sense_definition": "Zustand, beruflich auf eigenes Risiko und ohne festen Arbeitgeber tätig zu sein",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach zehn Jahren als Angestellte wagte sie endlich den Schritt in die berufliche <w>Selbstständigkeit</w>."
                        },
                        {
                            "text": "Die <w>Selbstständigkeit</w> bietet viele Freiheiten, bringt aber auch finanzielle Unsicherheiten mit sich."
                        }
                    ],
                    "antonyms": [
                        "Festanstellung",
                        "Angestelltenverhältnis"
                    ],
                    "common_phrases": [
                        "berufliche Selbstständigkeit",
                        "Weg in die Selbstständigkeit"
                    ]
                },
                {
                    "sense_id": "6c3c4171-c8dd-3010-b349-7380acafbc08",
                    "sense_definition": "Zustand politischer und staatlicher Unabhängigkeit eines Landes oder Volkes",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Zerfall des Reiches forderte die Region ihre völkerrechtliche <w>Selbstständigkeit</w>."
                        },
                        {
                            "text": "Die ehemalige Kolonie wurde nach jahrelangen Verhandlungen feierlich in die <w>Selbstständigkeit</w> entlassen."
