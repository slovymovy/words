                                "target_senses": [
                                    {
                                        "sense_id": "9f5a5e07-e371-37e3-bd8f-e623a9d650f5",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To be engaged in informal conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688838c0-7475-4c7c-8a5c-5e3fa0a5f8be",
                                                "sense_id": "9f5a5e07-e371-37e3-bd8f-e623a9d650f5",
                                                "text": "She chatted with her friend in the cafe."
                                            },
                                            {
                                                "example_id": "b06d67ef-1d26-4c07-986f-4de2ebe45cf9",
                                                "sense_id": "9f5a5e07-e371-37e3-bd8f-e623a9d650f5",
                                                "text": "I like to chat over a coffee with a friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a406dd6-5f9c-3ad8-8914-c0efe371b7e5",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To talk more than a few words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2624dbdd-7bab-49cd-a9cb-05d15dae378f",
                                                "sense_id": "1a406dd6-5f9c-3ad8-8914-c0efe371b7e5",
                                                "text": "I met my old friend in the street, so we chatted for a while."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e66e928a-5a23-3c85-914c-d76568e84d56",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To talk of; to discuss."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd840527-296d-4e45-9c98-0488046916c3",
                                                "sense_id": "e66e928a-5a23-3c85-914c-d76568e84d56",
                                                "text": "They chatted politics for a while."
                                            },
                                            {
                                                "example_id": "846a5b8f-99cb-4284-bac7-302c69003c97",
                                                "sense_id": "e66e928a-5a23-3c85-914c-d76568e84d56",
                                                "text": "We would get totally stoned and usually drunk too and chat a load of nonsense into the small hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e626f93-3105-381d-9087-632580267236",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To chat shit (to speak nonsense, to lie)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b8f5fd-f8b0-46f1-aa6a-7c6c3946a39b",
                                                "sense_id": "8e626f93-3105-381d-9087-632580267236",
                                                "text": "Don't listen to me, I'm chatting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a040c1-51fd-3955-bbd3-6f632de5a900",
                                        "entry_id": "58faa329-4609-374e-94b1-f8e27336df8c",
                                        "glosses": [
                                            "To exchange text or voice messages in real time through a computer network such as a social media chat room or messaging application (as if having a face-to-face conversation instead of SMS or writing emails or letters)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e564255-2465-494e-9119-ad9b174ee2ab",
                                                "sense_id": "86a040c1-51fd-3955-bbd3-6f632de5a900",
                                                "text": "Do you want to chat online later?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e46c4da4-05e0-3265-bc11-9d9a4d3c6b08",
