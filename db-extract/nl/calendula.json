                        "examples": [
                            {
                                "example_id": "dd7c28fd-bc7b-47c3-b283-a27796af50e5",
                                "sense_id": "a73a27e2-95a7-3967-9996-f1521a3da93e",
                                "text": "Lelsz verbouwt naast groenten en bloemen, twaalf verschillende keukenkruiden en zo’n tien geneeskrachtige kruiden. Daarvan maakt ze zalfjes en olie voor eigen gebruik en voor familie en vrienden. Lelsz wijst naar de fleurige goudsbloem in de vaas, oftewel calendula in het Latijn. De plant wordt veel gebruikt wordt voor de genezing van wonden. „Sneetjes, kloofjes; calendula zorgt voor een snelle genezing van de huid.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2f23604-8fe5-3a09-8726-1a8c9c0a432f",
                        "entry_id": "d4397154-23d1-3df7-94b5-0af371c0544d",
                        "glosses": [
                            "ingrediënt van natuurgeneesmiddel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0524abf-56b0-4d56-9b51-352cc60fde9d",
                                "sense_id": "e2f23604-8fe5-3a09-8726-1a8c9c0a432f",
                                "text": "Westerhof smeert calendulazalf op de grote brandwond bij zijn achterpoot. Maandagmiddag kreeg hij al een boterham met ibuprofen. Naast Zeeman liggen vier andere varkens. „Ze zijn verstoord en ontheemd.” De vijf hebben de schok van hun leven gehad toen de brand uitbrak in hun slaapruimte. Ze wisten te ontkomen door de deur te forceren. „Echt een godswonder.”"
                            }
                        ]
                    }
