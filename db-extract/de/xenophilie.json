                ],
                "senses": [
                    {
                        "sense_id": "cffb548c-0b83-330a-a331-b86762c7c5a1",
                        "entry_id": "0bf021b5-2727-3d67-a37f-e91ce1dd43d3",
                        "glosses": [
                            "Vorliebe für fremde, unbekannte Dinge oder Menschen"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "0681a7e7-1624-49fe-a546-ea239bd3116f",
                                "sense_id": "cffb548c-0b83-330a-a331-b86762c7c5a1",
                                "text": "„Wer jedoch länger hier lebt und sich den Minderheiten nicht anschließt, sich auch nicht verführen läßt von der Xenophilie der Intellektuellen, mag allmählich die Konturen einer verborgenen Form erkennen.“"
                            },
                            {
                                "example_id": "51e7c643-f0fc-422f-933f-4fd7f0821271",
                                "sense_id": "cffb548c-0b83-330a-a331-b86762c7c5a1",
                                "text": "„Jäh schlug 1945 nationale Überheblichkeit um in eine rührige Xenophilie.“"
                            },
                            {
                                "example_id": "5c3a989f-4c25-4d98-928d-136523ad4be2",
                                "sense_id": "cffb548c-0b83-330a-a331-b86762c7c5a1",
                                "text": "„Ich betreibe hier keineswegs Xenophilie: Der amerikanische Durchschnittsbürger, gewöhnt an wohlerzogenen Dissens, glaubt an nichts mehr.“"
                            },
                            {
                                "example_id": "22a9bb4d-4c54-4cbd-964a-cf8d995d997e",
                                "sense_id": "cffb548c-0b83-330a-a331-b86762c7c5a1",
                                "text": "„Demnach zeige die Geschichte „verhängnisvolle Wechselwirkungen solcher Xenophilien [Vorliebe für Fremde, Anm. d. Red.]“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7904bfa6-c045-465d-8830-efb4d92a4ad5",
                        "source_entry_id": "0bf021b5-2727-3d67-a37f-e91ce1dd43d3",
                        "source_sense_id": "cffb548c-0b83-330a-a331-b86762c7c5a1",
                        "source_sense_description": "bildungssprachlich: Vorliebe für fremde, unbekannte Dinge oder Menschen",
                        "target_lang_word": "xenophilia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xenophilia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2610d566-b85a-3959-965c-67c482f36c17",
                                        "entry_id": "e565bf04-c6f3-31a1-8357-745dfc6bd2ce",
                                        "glosses": [
                                            "An attraction to or love of foreign people, manners or culture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6ba96b3-f336-3a28-953b-5f7e55d36ede",
                                        "entry_id": "e565bf04-c6f3-31a1-8357-745dfc6bd2ce",
                                        "glosses": [
                                            "Love (especially sexual love) between humans and extraterrestrials."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b381dec7-7b89-4031-b2d6-67ee75709e43",
                                                "sense_id": "c6ba96b3-f336-3a28-953b-5f7e55d36ede",
                                                "text": "While it may appear that Sturgeon has thus become an advocate of homoeroticism, incest, xenophilia, and other exotic or decadent sexual practices, he remains committed rather to the ideals of understanding and tolerance."
                                            },
                                            {
                                                "example_id": "9599799d-fa75-4361-a6e1-37be07d24d5f",
                                                "sense_id": "c6ba96b3-f336-3a28-953b-5f7e55d36ede",
                                                "text": "An alien—seemingly just a tourist—lands in the middle of Washington, assumes human, male form, and is adopted by four college kids for fun and sex. The story is told in snatches of dialogue and scraps of poetry (the title is from e.e. cummings), and is all goofy juxtapositions, happy xenophilia, and affection for the enthusiastic and accepting youth."
                                            },
                                            {
                                                "example_id": "5ac87672-8e8b-47be-9ac3-b53fb87a18a7",
                                                "sense_id": "c6ba96b3-f336-3a28-953b-5f7e55d36ede",
                                                "text": "Xenophilia (header) From a young age, even before I knew what sex was, I always had a thing for girls. Alien girls I mean — Alorians in particular. I broke out in a sweat every time I saw them. They were so beautiful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
