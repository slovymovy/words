                                        "sense_id": "7da8b74f-0076-36d5-ac1c-f5b87ed9069e",
                                        "entry_id": "7a32cc78-2e3c-3a10-81bd-4c400780bd83",
                                        "glosses": [
                                            "Celle qui brasse de la bière et qui en vend en gros."
                                        ],
