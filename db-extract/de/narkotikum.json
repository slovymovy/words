                    {
                        "translation_id": "1ecbb1e0-9ae1-4b4d-b43a-a4b789cfd867",
                        "source_entry_id": "c7862f34-4224-3ab3-9b25-43722a3170d4",
                        "source_sense_id": "b8b7f762-4d5c-3b78-be00-e05b9085cb5b",
                        "target_lang_word": "anesthetic",
