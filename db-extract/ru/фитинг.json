                "translations": [
                    {
                        "translation_id": "796f338f-a206-4efb-9490-bd729996ae8f",
                        "source_entry_id": "76542aef-7828-3cda-88ae-df7069f9ce44",
                        "source_sense_id": "09bfc61d-e9bc-3e11-990f-387041c79407",
                        "target_lang_word": "raccord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raccord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a04b142-63d0-3f2c-af76-5c673aa974e2",
                                        "entry_id": "ec8af175-f0bd-398b-a9b3-0251d8f7017d",
                                        "glosses": [
                                            "Liaison, ajustage de parties séparées ou dissemblables, ou qui faisaient disparate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605ae57a-e43a-4f70-99aa-d349868ba92f",
                                                "sense_id": "9a04b142-63d0-3f2c-af76-5c673aa974e2",
                                                "text": "Faire le raccord des deux ailes d’un bâtiment."
                                            },
                                            {
                                                "example_id": "ef030c3b-11b5-4a28-9af9-064c18f98e1e",
                                                "sense_id": "9a04b142-63d0-3f2c-af76-5c673aa974e2",
                                                "text": "Un raccord de papier de tenture, de peinture."
                                            },
                                            {
                                                "example_id": "4c8ad363-ee40-41f6-b119-4f4ac97ea5f6",
                                                "sense_id": "9a04b142-63d0-3f2c-af76-5c673aa974e2",
                                                "text": "On ne voit pas le raccord fait à la façade de ce bâtiment."
                                            },
                                            {
                                                "example_id": "6b5f7d57-4834-4433-85bd-0cca9c1c8586",
                                                "sense_id": "9a04b142-63d0-3f2c-af76-5c673aa974e2",
                                                "text": "On n’aperçoit pas le raccord de ces deux planches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "799dafb6-7c61-3904-8a79-5a30bc4d48ae",
                                        "entry_id": "ec8af175-f0bd-398b-a9b3-0251d8f7017d",
                                        "glosses": [
                                            "Pièce en fonte, en cuivre, en poterie, en PVC, etc., qui sert à assembler deux tuyauteries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "442bee24-a15d-47d9-8d0e-d2dedbe541f2",
                                                "sense_id": "799dafb6-7c61-3904-8a79-5a30bc4d48ae",
                                                "text": "Quand il s'agissait de livrer en Allemagne ou au Luxembourg, le dépotage des citernes de notre flotte était freiné par le système de raccord allemand Storz, la norme dans ces deux pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978e2173-df7a-3a1d-89e8-549d87bd1a82",
                                        "entry_id": "ec8af175-f0bd-398b-a9b3-0251d8f7017d",
                                        "glosses": [
                                            "Se dit en parlant des ouvrages de l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef56f7f-945f-4d80-8ee5-0625964827d4",
                                                "sense_id": "978e2173-df7a-3a1d-89e8-549d87bd1a82",
                                                "text": "Pendant les répétitions, il a fait des raccords, ajouté des béquets, et aussi pratiqué des coupures qui ont précisément pour but de lui rendre ce public indulgent et favorable."
                                            },
                                            {
                                                "example_id": "b22e26fb-10a4-4a93-8ba1-7ceeb25c2107",
                                                "sense_id": "978e2173-df7a-3a1d-89e8-549d87bd1a82",
                                                "text": "On avait fait des coupures dans cette pièce, il a fallu faire des raccords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0646cc-3165-3211-81f4-6465079009fa",
                                        "entry_id": "ec8af175-f0bd-398b-a9b3-0251d8f7017d",
                                        "glosses": [
                                            "Enchaînement entre deux plans successifs d’un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f458f62-bc98-4a48-bfc0-1e3d2445c360",
                                                "sense_id": "1c0646cc-3165-3211-81f4-6465079009fa",
                                                "text": "— C’est vous qui m’avez signalé, un matin, que l’acteur qui entrait, la veille, dans le plan, avait une cigarette allumée, et qu’il ne fumait plus au raccord…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b5408e-feb5-375a-ada5-f2bfc9cd92f5",
                                        "entry_id": "ec8af175-f0bd-398b-a9b3-0251d8f7017d",
                                        "glosses": [
                                            "Avant un concert dans un lieu nouveau, préparation du placement des musiciens sur la scène, de l’entrée en scène, de la sortie des musiciens, répétition de certains morceaux et des enchainements pour les accorder à l’acoustique du lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "866dc3dc-c084-4e59-8e29-96840514a32c",
                                                "sense_id": "27b5408e-feb5-375a-ada5-f2bfc9cd92f5",
                                                "text": "Donnez-moi le produit des préventes au plus tard avant le raccord du concert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1acf728d-0c3c-3ed6-8ed2-7af885311afd",
                                        "entry_id": "ec8af175-f0bd-398b-a9b3-0251d8f7017d",
                                        "glosses": [
                                            "Concordance des éléments graphiques d’une coupure avec ceux d’une coupure adjacente, le long de la limite commune."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a3012b2-b8cd-3788-b26a-6e419d01d1aa",
                                        "entry_id": "ec8af175-f0bd-398b-a9b3-0251d8f7017d",
                                        "glosses": [
                                            "Concordance des images représentées par deux documents quelconques présentant une zone commune, le long d’une ligne de cette zone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "raccord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac12df8f-b445-39ec-847e-12aeb9442385",
                                        "entry_id": "366efdc1-f1c5-34bb-b862-f1222fc22d9c",
                                        "glosses": [
                                            "Cohérent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356e793a-9de2-46eb-bb2c-8a71d4120ead",
                                                "sense_id": "ac12df8f-b445-39ec-847e-12aeb9442385",
                                                "text": "Faire raccord, être raccord."
                                            },
                                            {
                                                "example_id": "ebf481f2-d694-413a-8c8b-296ced8a4829",
                                                "sense_id": "ac12df8f-b445-39ec-847e-12aeb9442385",
                                                "text": "Il faut quelqu’un capable de comprendre le monde scientifique, qui est celui qui décrit l’état du monde – y compris quand cela n’est pas raccord avec l’opinion, qui peut sous-estimer la gravité du problème (par exemple dans le cas du climat, de la pêche ou de la biodiversité), ou au contraire – même si plus rarement – la surestimer (par exemple dans le cas du nucléaire)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raccord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8917a0-0941-369d-bd2c-038060b21d0e",
                                        "entry_id": "6856bd3c-75df-395f-bd23-b1e4d60b1458",
                                        "glosses": [
                                            "En continuité."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13ce015c-2aaa-4288-a27c-1a81db8fd959",
                                                "sense_id": "8c8917a0-0941-369d-bd2c-038060b21d0e",
                                                "text": "En répétition comme en tournage, vous accomplirez toujours vos actions de façon identique, d’une prise à l’autre, afin d’être raccord. C’est indispensable pour le montage d’une séquence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc12b36-6a24-3870-8d8d-82c9b0905a95",
                                        "entry_id": "6856bd3c-75df-395f-bd23-b1e4d60b1458",
                                        "glosses": [
                                            "En harmonie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9d14c84-343a-4254-a75a-31e03dc51aaa",
                                                "sense_id": "5dc12b36-6a24-3870-8d8d-82c9b0905a95",
                                                "text": "Donc, pour en revenir à Pichon, le moins qu’on puisse dire c’est qu’il n’est pas raccord dans la police actuelle. Un type qui dérange. L’homme à abattre."
                                            },
                                            {
                                                "example_id": "12858dcb-df3e-40ff-88b1-d5c606b84802",
                                                "sense_id": "5dc12b36-6a24-3870-8d8d-82c9b0905a95",
                                                "text": "Tu sais, je me disais que vu qu’on n’arrive plus à mettre la main sur lui et que de toutes façons tu as repris ses enquêtes, on devrait peut-être faire un point tous les deux, pour être raccord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ab5f04b-57a3-3a43-acc8-e2646f5211ba",
                                        "entry_id": "6856bd3c-75df-395f-bd23-b1e4d60b1458",
                                        "glosses": [
                                            "En situation de coïncidence paraissant naturelle."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01486843-44cc-4255-8a2b-6bad66992046",
                                                "sense_id": "3ab5f04b-57a3-3a43-acc8-e2646f5211ba",
                                                "text": "La première personne sur laquelle Alix tomba, dans le hall de l’Office, fut Valentine Cara qui sortait de l’ascenseur du parking. Elles se seraient donné rendez-vous qu’elles n’auraient pas été plus raccord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
