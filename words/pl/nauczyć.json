            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f9d6a81-8a46-3652-9f0c-6af5f982f5cd",
                    "sense_definition": "przekazać komuś wiedzę lub wykształcić u kogoś daną umiejętność",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nauczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój starszy brat <w>nauczył</w> mnie jeździć na rowerze w zeszłym roku.",
                            "target_lang_translations": {
                                "en": "My older brother <w>taught</w> me how to ride a bike last year."
                            }
                        },
                        {
                            "text": "Doświadczona nauczycielka szybko <w>nauczyła</w> dzieci podstawowych zwrotów po angielsku.",
                            "target_lang_translations": {
                                "en": "The experienced teacher quickly <w>taught</w> the children basic English phrases."
                            }
                        }
                    ],
                    "synonyms": [
                        "wykształcić"
                    ],
                    "common_phrases": [
                        "nauczyć kogoś rozumu",
                        "nauczyć kogoś pływać"
                    ],
                    "target_lang_definitions": {
                        "en": "to impart knowledge or a skill to someone; to teach someone successfully"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "teach",
                                "target_lang_sense_clarification": "to impart knowledge or a skill"
                            },
                            {
                                "target_lang_word": "instruct",
                                "target_lang_sense_clarification": "to give directions or training"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eca44610-7ed7-3037-ba41-406fc3a6a290",
                    "sense_definition": "przyswoić sobie wiedzę lub opanować określoną umiejętność (w konstrukcji z „się”)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nauczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uczniowie szybko <w>nauczyli</w> się nowych słów na pamięć przed sprawdzianem.",
                            "target_lang_translations": {
                                "en": "The students quickly <w>learned</w> the new words by heart before the test."
                            }
                        },
                        {
                            "text": "Marek <w>nauczył</w> się pływać podczas ostatnich wakacji nad jeziorem.",
                            "target_lang_translations": {
                                "en": "Marek <w>learned</w> to swim during the last vacation by the lake."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nauczyć się na pamięć",
                        "nauczyć się na błędach"
                    ],
                    "target_lang_definitions": {
                        "en": "to acquire knowledge or master a skill (used reflexively with 'się')"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "learn",
                                "target_lang_sense_clarification": "to acquire knowledge or master a skill"
                            },
                            {
                                "target_lang_word": "master",
                                "target_lang_sense_clarification": "to acquire complete knowledge or skill in something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
