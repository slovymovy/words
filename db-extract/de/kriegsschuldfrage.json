                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53635385-b029-4e53-812e-cfded17f276a",
                                "sense_id": "498ef127-078e-372e-a2d9-f744c20da7ad",
                                "text": "„Aufgabe des Historikers ist es zum Glück nicht, frühmittelalterliche Kriegsschuldfragen zu klären.“"
                            },
                            {
                                "example_id": "57fa34ba-0ddb-469b-8d5d-36c500c0d5d4",
                                "sense_id": "498ef127-078e-372e-a2d9-f744c20da7ad",
                                "text": "„Caesar brauchte sich freilich nicht mit der Erörterung von Kriegsschuldfragen aufzuhalten.“"
                            },
                            {
                                "example_id": "13a0f4a0-f8ff-4c5c-b67b-50a8bbc21dac",
                                "sense_id": "498ef127-078e-372e-a2d9-f744c20da7ad",
                                "text": "„Die heiße Erörterung der Kriegsschuldfrage, die Belastung des deutschen Volkes durch den Kriegsschuldparagraphen veranlaßte die deutsche Regierung zu einer umfassenden Dokumentation der deutschen Politik des Kaiserreiches.“"
                            }
                        ],
