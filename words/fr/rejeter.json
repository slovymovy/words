                    "synonyms": [
                        "imputer"
                    ],
                    "common_phrases": [
                        "rejeter la faute",
                        "rejeter la responsabilité"
                    ]
                },
                {
                    "sense_id": "e50b9a6e-62be-3efb-97ad-faf2e5e020bd",
                    "sense_definition": "Lancer ou jeter de nouveau un objet.",
