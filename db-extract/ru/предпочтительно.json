                        "target_lang_word": "vorzugsweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorzugsweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                        "entry_id": "8e88a999-b52f-3bc3-b45c-779f4e6d5b04",
                                        "glosses": [
                                            "am liebsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77f05bb-23ae-4a0e-bdd4-0bdb43cbbbca",
                                                "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                                "text": "Obgleich ich mit dem Auto zur Arbeit fahren könnte, nehme ich vorzugsweise das Rad, um in dieser Morgensportübung zu mir zu finden."
                                            },
                                            {
                                                "example_id": "fd9cabad-2c23-43a6-b9b9-34f119f644e5",
                                                "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                                "text": "„Zu Ikea rückt man vorzugsweise paarweise an, um den Anblick der tausend anderen jungen Paare besser zu ertragen, die wahrscheinlich verliebt bis über beide Ohren über die notwendige Matratzengröße debattieren und darüber, ob sie nun das Bett Gutvik kaufen sollen oder doch eher den Narvik.“"
                                            },
                                            {
                                                "example_id": "23c68823-1647-4957-ab9f-b83dc0730f60",
                                                "sense_id": "677af59e-68e6-3a0d-a227-7f9c610d88ac",
                                                "text": "„Ich finde und habe immer gefunden, daß sich ein Buch gerade vorzugsweise zu einem freundschaftlichen Geschenk eignet. Man liest es oft, man kehrt oft dazu zurück, man nahet sich ihm aber nur in ausgewählten Momenten, braucht es nicht wie eine Tasse, ein Glas, einen Hausrath, so in jedem gleichgültigen Augenblick des Lebens, und erinnert sich so immer des Freundes im Augenblick eines würdigen Genusses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a64f80d5-f74d-441a-9a1f-85661cdc3156",
                        "source_entry_id": "f971e4d5-fc50-37e0-84d5-1ac5ec1345b2",
