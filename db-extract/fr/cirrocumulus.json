                        "entry_id": "5f235959-f2ae-38e9-afee-8989706be655",
                        "glosses": [
                            "Nuage appartenant à l'étage supérieur, situé à une altitude comprise entre 5000 et 10000 mètres, en forme de fleur de coton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da26a88-0fe8-4eb3-b850-b83ac55fa736",
                                "sense_id": "652def6b-f67b-3c4d-9a62-c61388d57d2c",
                                "text": "On observe souvent des cirrus se formant à partir de virga issues de cirrocumulus ou d’altocumulus, ou à partir de la partie supérieure d’un cumulonimbus."
                            }
                        ]
                    }
                ],
