                "senses": [
                    {
                        "sense_id": "ccc6aaf3-780a-3db2-aeae-dc65231f43c5",
                        "entry_id": "376312c0-101d-3f40-a928-f04d2cb9efc4",
                        "glosses": [
                            "Person, die das regierende Regime öffentlich kritisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a8d3e58-ee2e-4ac8-b377-805b374c801a",
                                "sense_id": "ccc6aaf3-780a-3db2-aeae-dc65231f43c5",
                                "text": "„Der chinesische Friedensnobelpreisträger Liu Xiaobo ist im Alter von 61 Jahren an Leberkrebs verstorben. Der Regimekritiker verbrachte 18 Jahre seines Lebens im Gefängnis.“"
                            },
                            {
                                "example_id": "d953e5ef-4c28-4a62-9b32-a4e369b7ff0d",
                                "sense_id": "ccc6aaf3-780a-3db2-aeae-dc65231f43c5",
                                "text": "„Die Weltmeisterschaft 1978 gilt als Sündenfall der Fußballgeschichte. Sie fand in Argentinien statt, wo zu jener Zeit General Videla mit seiner Faschistenriege herrschte und Regimekritiker foltern, verschwinden, umbringen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
