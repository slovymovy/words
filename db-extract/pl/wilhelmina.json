                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3efebf16-c2fc-41a4-a1d2-0df6d35bf80f",
                                                "sense_id": "a27ec854-0e4c-3f45-b1a4-62c3bec95e2d",
                                                "text": "Appréhendé avec plus de 52 000 comprimés de méthamphétamine à son domicile de Magog, Daniel Guillemette restera détenu au moins pour la prochaine semaine."
                                            },
                                            {
                                                "example_id": "29c05aa4-1b2f-4bcb-9fa0-ae0bf34e5617",
                                                "sense_id": "a27ec854-0e4c-3f45-b1a4-62c3bec95e2d",
                                                "text": "Des gardes de vingt-quatre heures « qui sont le fonctionnement habituel des 2 600 marins-pompiers de Marseille », détaille le commandant en second, le capitaine de vaisseau Christophe Guillemette."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Guillemette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "461c220a-4441-3882-91bc-5a0ccf592f23",
