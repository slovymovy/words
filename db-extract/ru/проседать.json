                "senses": [
                    {
                        "sense_id": "b974ff7a-aa1b-3a7a-a13b-961ad69836de",
                        "entry_id": "d6b79575-8d33-387e-bba5-376979f22701",
                        "glosses": [
                            "опускаться, оседать, прогибаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77d80e8-5d06-45cd-80fd-1e2e2be60e2b",
                                "sense_id": "b974ff7a-aa1b-3a7a-a13b-961ad69836de",
                                "text": "Но шли века, грунт под монолитом постепенно проседал."
                            },
                            {
                                "example_id": "13ce2e59-a137-47ea-93ac-e10db10c48e1",
                                "sense_id": "b974ff7a-aa1b-3a7a-a13b-961ad69836de",
                                "text": "Муравей проседал под тяжестью, но волок, тащил, спотыкаясь и останавливаясь."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ec19bb8-7e06-372a-a607-709ce852b6c1",
                        "entry_id": "d6b79575-8d33-387e-bba5-376979f22701",
                        "glosses": [
                            "жарг. понижаться, уменьшаться, сокращаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21b09472-95ab-42d7-bcaf-d62c27f01b90",
                                "sense_id": "6ec19bb8-7e06-372a-a607-709ce852b6c1",
                                "text": "Уже в первом квартале 2014-го начал проседать рынок тяжелых грузовиков, в первую очередь магистральных тягачей."
                            }
                        ]
                    }
