                        "glosses": [
                            "To surpass in whirling or spinning."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ebfb24e7-d103-48eb-b42d-f4cb7061736c",
                                "sense_id": "59016653-6c6f-3cc8-b542-e1325998c1ec",
                                "text": "O Cynthia! why so pale? Dost thou lament\nThy wretched neighbour? Grieve to see thy wheel\nOf ceaseless change outwhirl'd in human life?"
                            },
                            {
                                "example_id": "b8f57027-6d79-4b10-ae62-e509346fc65a",
                                "sense_id": "59016653-6c6f-3cc8-b542-e1325998c1ec",
                                "text": "I want to interrogate Anna's grandmother to learn the grace of her dervish heritage, to see her perform the whirl—forbidden to females—in the intimacy of her home, where, Anna's mother told me, she was renowned for outwhirling even the fittest of men."
                            }
                        ]
                    }
