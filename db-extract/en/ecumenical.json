                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74499145-62a3-4cfb-9296-3b76a6e4baa1",
                                                "sense_id": "b8a912ce-7903-3f0c-80d9-a463df6b954a",
                                                "text": "Bij het oecumenisch overleg konden de protestante en katholieke afgevaardigden het niet helemaal eens worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5397d8c2-2512-4e79-bd74-c362c15136f1",
                        "source_entry_id": "408f2b10-3662-3d3e-9df6-8a5841a8beed",
                        "source_sense_description": "ecclesiastical: pertaining to the Christian Church in a worldwide sense",
