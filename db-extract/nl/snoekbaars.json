                    {
                        "translation_id": "7e169b0f-c95b-417f-b948-5335c1e4c57d",
                        "source_entry_id": "543d15c8-a88e-3145-98c7-6ec195bbd1ca",
                        "source_sense_id": "b55a3cc4-8425-3ee3-9cf0-9676265895e5",
                        "source_sense_description": "bepaald soort zoetwaterroofvis, Sander lucioperca",
                        "target_lang_word": "sandre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0939e510-db9d-3cb6-9dd6-2103af261a2d",
                                        "entry_id": "3bc87368-39df-37a0-b74d-afe3e2c2a04d",
                                        "glosses": [
                                            "Espèce de grand poisson osseux d’eau douce et d'eau saumâtre d'Europe, de la famille des perches, allongé, à tête assez fine et longue, à deux nageoires dorsales distinctes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5b4ee8-7a42-4cbc-98b7-cb9bb749bbc8",
                                                "sense_id": "0939e510-db9d-3cb6-9dd6-2103af261a2d",
                                                "text": "La grande taille de la sandre − elle peut atteindre un mètre − n’enlève rien à la qualité de sa chair, très fine."
                                            },
                                            {
                                                "example_id": "c5e50833-f3fa-457a-a5cd-5efb992caa37",
                                                "sense_id": "0939e510-db9d-3cb6-9dd6-2103af261a2d",
                                                "text": "Si la pêche du sandre est théoriquement possible toute l’année, les deux meilleures périodes semblent être la fin du printemps, juste après le frai, puis l’automne."
                                            },
                                            {
                                                "example_id": "ea273c34-4560-429e-a908-6e78cf247d2e",
                                                "sense_id": "0939e510-db9d-3cb6-9dd6-2103af261a2d",
                                                "text": "Près d’un moulin à huile, nous avons dégusté de la sandre à la Table du Meunier, puis nous avons navigué en barque sur la Mayenne où dansaient des truites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6836bc11-98fe-3e12-8d00-d5d603e37ea7",
                                        "entry_id": "3bc87368-39df-37a0-b74d-afe3e2c2a04d",
                                        "glosses": [
                                            "Synonyme de saule blanc (arbre)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
