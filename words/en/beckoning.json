{
    "word_family": [
        "beckon"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8f1536e-5b30-369f-8a9b-d4ef1db3cd8a",
                    "sense_definition": "Present participle of <w>beckon</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beckon_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guide was <w>beckoning</w> to us to follow him through the narrow passage.",
                            "target_lang_translations": {
                                "nl": "De gids was ons aan het <w>wenken</w> om hem door de smalle doorgang te volgen."
                            }
                        },
                        {
                            "text": "She saw her friend <w>beckoning</w> from across the crowded room.",
                            "target_lang_translations": {
                                "nl": "Ze zag haar vriend aan de andere kant van de drukke kamer <w>wenken</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gesturing",
                        "signaling"
                    ],
                    "common_phrases": [
                        "beckoning someone over"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord van 'beckon': met een hand- of hoofdgebaar iemand wenken of naar zich toe roepen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wenkend",
                                "target_lang_sense_clarification": "als deelwoord van wenken"
                            },
                            {
                                "target_lang_word": "wenken",
                                "target_lang_sense_clarification": "het werkwoord zelf"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "66f46169-7258-35ce-81da-ba03f23b2323",
                    "sense_definition": "Appealing, inviting, or enticing, as if summoning someone closer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beckon_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm fire was a <w>beckoning</w> sight after hours of walking in the cold.",
                            "target_lang_translations": {
                                "nl": "Het warme vuur was een <w>uitnodigend</w> gezicht na uren wandelen in de kou."
                            }
                        },
                        {
                            "text": "A open door gave way to a <w>beckoning</w> path through the lush garden.",
                            "target_lang_translations": {
                                "nl": "Een open deur leidde naar een <w>aanlokkelijk</w> pad door de weelderige tuin."
                            }
                        }
                    ],
                    "synonyms": [
                        "alluring",
                        "inviting",
                        "enticing"
                    ],
                    "antonyms": [
                        "repellent",
                        "forbidding"
                    ],
                    "common_phrases": [
                        "beckoning finger",
                        "beckoning light"
                    ],
                    "target_lang_definitions": {
                        "nl": "Aantrekkelijk, aanlokkelijk of uitnodigend, alsof het je naderbij roept."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aanlokkelijk",
                                "target_lang_sense_clarification": "zeer aantrekkelijk en verleidelijk"
                            },
                            {
                                "target_lang_word": "uitnodigend",
                                "target_lang_sense_clarification": "een warm of welkom gevoel gevend"
                            },
                            {
                                "target_lang_word": "verleidelijk",
                                "target_lang_sense_clarification": "aansporend om dichterbij te komen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a1a0edd-0514-3c57-b998-5e82795e2cd5",
                    "sense_definition": "A gesture made with the hand or head to summon someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beckon_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With repeated <w>beckonings</w> of his hand, he urged the travelers to step forward.",
                            "target_lang_translations": {
                                "nl": "Met herhaaldelijk <w>wenken</w> met zijn hand spoorde hij de reizigers aan om naar voren te stappen."
                            }
                        },
                        {
                            "text": "She ignored his silent <w>beckoning</w> and remained seated where she was.",
                            "target_lang_translations": {
                                "nl": "Ze negeerde zijn stille <w>wenk</w> en bleef zitten waar ze zat."
                            }
                        }
                    ],
                    "synonyms": [
                        "gesture",
                        "signal",
                        "summons"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gebaar met de hand of het hoofd om iemand dichterbij te roepen; een wenk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het wenken",
                                "target_lang_sense_clarification": "de handeling van een wenkend gebaar maken"
                            },
                            {
                                "target_lang_word": "wenk",
                                "target_lang_sense_clarification": "een uitnodigend hand- of hoofdgebaar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}