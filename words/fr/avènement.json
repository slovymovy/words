                        "avènement de l'imprimerie"
                    ]
                },
                {
                    "sense_id": "3428d63d-fa72-3155-8d03-8887f2d3ff01",
                    "sense_definition": "Accession d'une personne à une dignité souveraine, en particulier au trône.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès son <w>avènement</w> au trône, le jeune prince a promis d'importantes réformes politiques."
                        },
                        {
                            "text": "Le peuple célébra l'<w>avènement</w> du nouveau souverain avec de grandes fêtes publiques."
                        }
                    ],
                    "synonyms": [
                        "accession",
                        "couronnement",
                        "intronisation"
                    ],
                    "antonyms": [
                        "abdication",
                        "destitution",
                        "déchéance"
                    ],
                    "common_phrases": [
                        "avènement au trône",
                        "avènement d'un souverain"
                    ]
                },
                {
                    "sense_id": "d2a44666-ac5c-3935-8d17-e942c3235293",
                    "sense_definition": "Venue de Jésus-Christ ou du Messie sur la Terre selon la tradition chrétienne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles prient pour célébrer l'<w>avènement</w> du Sauveur au moment de Noël."
                        },
                        {
                            "text": "Les prophéties bibliques annoncent l'<w>avènement</w> du Christ parmi les hommes."
