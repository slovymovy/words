                ],
                "senses": [
                    {
                        "sense_id": "08e781cd-f43d-35c3-ba5a-42bf5f7afda9",
                        "entry_id": "199c106a-8489-38f5-97fc-eb32f4df8b7e",
                        "glosses": [
                            "To die intentionally in a match by having oneself slain by enemy characters or structures so as to give resources to the opposing team"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1e4fd33b-200b-4f5c-9332-eaf146c1bc89",
                                "sense_id": "08e781cd-f43d-35c3-ba5a-42bf5f7afda9",
                                "text": "2017 The difficulty in banning the ‘most toxic League of Legends player in North America’\nTyler’s signature crime was his habit of intentionally feeding or “inting” in ranked matches."
                            },
                            {
                                "example_id": "2dec52d0-1b4b-4006-83a8-e771cca78ad7",
                                "sense_id": "08e781cd-f43d-35c3-ba5a-42bf5f7afda9",
                                "text": "2018 Riot Games Comments on Intentional Feeding Sion Strategy\nInting, or intentional feeding, is one of the greatest sins in League of Legends. This strategy, apparently discovered by a player named MidLanerFromHell, uses Sion as a turret destroyer above all else, even sacrificing himself in the name of base destruction."
                            },
                            {
                                "example_id": "142c77ec-80eb-4a72-9741-2c115365a2d3",
                                "sense_id": "08e781cd-f43d-35c3-ba5a-42bf5f7afda9",
                                "text": "2019 Broxah reported Febiven for inting on stream"
                            }
                        ]
                    },
                    {
                        "sense_id": "10c5aa5f-76bf-3dba-9ef1-c3d72f2e0713",
                        "entry_id": "199c106a-8489-38f5-97fc-eb32f4df8b7e",
                        "glosses": [
                            "To make a bad play, even if it's unintentional."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "adb35d70-e74a-45b4-bc5c-37ff279626d6",
                                "sense_id": "10c5aa5f-76bf-3dba-9ef1-c3d72f2e0713",
                                "text": "Sorry guys, I inted. I thought I could get the kill and then get out."
                            }
                        ]
                    },
                    {
                        "sense_id": "047e0a0c-cc87-3083-a44c-bafd9f8d5a45",
                        "entry_id": "199c106a-8489-38f5-97fc-eb32f4df8b7e",
                        "glosses": [
                            "To ruin a match or a specific part of a match by intentionally or unintentionally dying or making bad plays"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "532a73e9-005d-493f-8c55-6a9363f11102",
                                "sense_id": "047e0a0c-cc87-3083-a44c-bafd9f8d5a45",
                                "text": "Why are you inting my lane?"
                            },
                            {
                                "example_id": "61bfb64b-fd11-4eaf-9f63-f7a3cf124ea6",
                                "sense_id": "047e0a0c-cc87-3083-a44c-bafd9f8d5a45",
                                "text": "I know this guy. He recently inted my diamond promos (promotional games to the diamond tier)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d730515-8297-32d3-b4b0-044891eb4410",
                        "entry_id": "199c106a-8489-38f5-97fc-eb32f4df8b7e",
                        "glosses": [
                            "To make someone lose a match by (mostly) intentionally or unintentionally dying"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8d963bf0-7903-4c89-bb34-708c75f7fb51",
                                "sense_id": "6d730515-8297-32d3-b4b0-044891eb4410",
                                "text": "Whenever I meet him again, I will gladly int him."
                            }
                        ]
                    }
                ],
