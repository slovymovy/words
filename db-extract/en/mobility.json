                    },
                    {
                        "translation_id": "41c5443c-3a49-4033-a017-bf7d1fce8c31",
                        "source_entry_id": "223c5b06-92af-3df8-95be-8ab412e81375",
                        "source_sense_description": "ability to move",
                        "target_lang_word": "mobilita",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c98eb83c-cd96-4ce8-9bb2-7b63e25dafb7",
                        "source_entry_id": "223c5b06-92af-3df8-95be-8ab412e81375",
                        "source_sense_description": "ability to move",
                        "target_lang_word": "mobilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mobilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e3d507-7f6b-3f21-aaab-0632dc37c7ec",
                                        "entry_id": "b719a941-0c51-35d3-a1ff-f83c46aea5d6",
                                        "glosses": [
                                            "Facilité à être mû."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8bd83b6-783a-42f6-b3a2-8970efb4c011",
                                                "sense_id": "e6e3d507-7f6b-3f21-aaab-0632dc37c7ec",
                                                "text": "Sa langue, d'une mobilité étonnante, courait amoureusement sur ses lèvres comme si elle se promettait de goûter à toutes les félicités d'ici-bas."
                                            },
                                            {
                                                "example_id": "553c9911-0f99-4e8d-937f-ab64d76b57c3",
                                                "sense_id": "e6e3d507-7f6b-3f21-aaab-0632dc37c7ec",
                                                "text": "La contamination par le mercure est ubiquiste en raison de sa grande mobilité et les systèmes aquatiques sont particulièrement affectés."
                                            },
                                            {
                                                "example_id": "404db2aa-4e9b-4782-980a-62bcbfb3f754",
                                                "sense_id": "e6e3d507-7f6b-3f21-aaab-0632dc37c7ec",
                                                "text": "De nombreux bivalves ont par exemple une mobilité nulle ou presque dès la métamorphose larvaire."
                                            },
                                            {
                                                "example_id": "24f2ca7a-a16a-4656-abb3-7c2209dfa213",
                                                "sense_id": "e6e3d507-7f6b-3f21-aaab-0632dc37c7ec",
                                                "text": "La combinaison de ces girations permet d’expliquer simultanément la mobilité plus complexe des planètes, du Soleil et de la Lune."
                                            },
                                            {
                                                "example_id": "a9d3d9b5-e316-4eea-af6e-3e9e9011d5ab",
                                                "sense_id": "e6e3d507-7f6b-3f21-aaab-0632dc37c7ec",
                                                "text": "La mobilité de la population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "425e6d83-af5e-3b88-8d48-a1d6295576d4",
                                        "entry_id": "b719a941-0c51-35d3-a1ff-f83c46aea5d6",
                                        "glosses": [
                                            "Facilité à changer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1497b8cc-8cc4-45c9-aab3-9abfaaa8e07a",
                                                "sense_id": "425e6d83-af5e-3b88-8d48-a1d6295576d4",
                                                "text": "Mobilité des traits, de la physionomie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49479657-00bf-34d8-bf16-c6ba66062f61",
                                        "entry_id": "b719a941-0c51-35d3-a1ff-f83c46aea5d6",
                                        "glosses": [
                                            "Ensemble des moyens de déplacement individuels ou collectifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac59e8d3-07ef-475b-8db2-c35fcfbf7eda",
                                                "sense_id": "49479657-00bf-34d8-bf16-c6ba66062f61",
                                                "text": "Mot municipal. Les habits verts du terme transport, sale et entaché de pétrole. Mobilité sonne fluide et vert, alors que transport est gris et (cône) orange. Transport est devenu synonyme dimmobilité. La mobilité, c'est rester dans son quartier, mais à vélo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad3b428c-b2c2-3d35-862c-cee59446160a",
                                        "entry_id": "b719a941-0c51-35d3-a1ff-f83c46aea5d6",
                                        "glosses": [
                                            "Facilité à passer rapidement d’une disposition à une autre, d’un objet à un autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a20c3a9-2cdc-4409-b479-68bafba621db",
                                                "sense_id": "ad3b428c-b2c2-3d35-862c-cee59446160a",
                                                "text": "La mobilité des choses humaines, la mobilité des opinions, leur incertitude, leur passage continuel d’un état à un autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d6be95-7531-3a1f-b128-3e858d38089f",
                                        "entry_id": "b719a941-0c51-35d3-a1ff-f83c46aea5d6",
                                        "glosses": [
                                            "Changement d’état, de statut ou de lieu, d’un individu ou d’un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9a5b80-60ff-4806-90c5-55a4e2fe2648",
                                                "sense_id": "09d6be95-7531-3a1f-b128-3e858d38089f",
                                                "text": "Quand une mobilité est demandée au salarié en raison de l’évolution de l’environnement interne ou externe à l’entreprise, les méthodes privilégiant l’adaptation et l’accompagnement du changement seront recherchées au bon niveau et avec le plus d’anticipation possible, notamment à travers les moyens de formation et d’information adéquats."
                                            },
                                            {
                                                "example_id": "f66d9140-3d3b-47ec-b19c-5577fb443010",
                                                "sense_id": "09d6be95-7531-3a1f-b128-3e858d38089f",
                                                "text": "Les États, soucieux de contrôler leurs territoires ont de plus en plus de mal à faire face à ces multiples mobilités, à ce qu’on nomme « globalisation ». Migrations et migrants sont parties prenantes de ce processus qui façonne un monde nouveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
