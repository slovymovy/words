                    "sense_definition": "plural of <w>democrat</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "political_philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "True <w>democrats</w> believe that every citizen should have a voice in government.",
                            "target_lang_translations": {
                                "ru": "Истинные <w>демократы</w> верят, что каждый гражданин должен иметь право голоса в управлении государством.",
                                "zh": "真正的<w>民主主义者</w>认为每个公民都应在政府中拥有发言权。"
                            }
                        },
                        {
                            "text": "The social <w>democrats</w> advocated for stronger labor laws.",
                            "target_lang_translations": {
                                "ru": "Социал-<w>демократы</w> выступали за более строгие трудовые законы.",
                                "zh": "社会<w>民主党人</w>主张制定更强有力的劳动法。"
                            }
                        }
                    ],
