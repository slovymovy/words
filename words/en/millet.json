                },
                {
                    "sense_id": "0928b869-7ba1-30c5-8e1d-d8c39df5d92a",
                    "sense_definition": "A town in Alberta, Canada.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to move to <w>Millet</w> to enjoy life in a quieter community.",
                            "target_lang_translations": {
                                "pl": "Zdecydowali się przeprowadzić do <w>Millet</w>, aby cieszyć się życiem w spokojniejszej społeczności."
                            }
