                "senses": [
                    {
                        "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                        "entry_id": "61b29a2d-7b54-3077-ba31-1cb546db947d",
                        "glosses": [
                            "Bundesstaat im Mittleren Westen der USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92757ec9-8755-49e8-bdaa-b328914d7328",
                                "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                                "text": "Mein Mann kommt aus Iowa."
                            },
                            {
                                "example_id": "5b383f02-e54e-4956-bd7a-b5e8c93ed674",
                                "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                                "text": "Iowa ist für seine weiten Naturlandschaften bekannt, aber auch für seine dörfliche und kleinstädtische Natur."
                            },
                            {
                                "example_id": "f9b752a9-d014-477a-a224-d6dcbf183092",
                                "sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                                "text": "Man nennt Iowa nicht ohne Grund den Corn State, denn nirgendwo anders wird soviel Mais angebaut wie hier."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29d3c10c-f074-4256-a594-65851ed1bfce",
                        "source_entry_id": "61b29a2d-7b54-3077-ba31-1cb546db947d",
                        "source_sense_id": "db7ce305-dc7f-329b-a2e1-17fc94551ddc",
                        "source_sense_description": "Bundesstaat im Mittleren Westen der USA",
