                    {
                        "sense_id": "6714c040-fe3b-38df-bdcf-55fac96561b5",
                        "entry_id": "04e946ae-05dd-3663-9847-6687f2e849f0",
                        "glosses": [
                            "ein landwirtschaftlicher Großbetrieb für die Zucht, den Anbau von Tomatenpflanzen und der Ernte derer Früchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe38b14-e664-40d5-a441-62fa390aaf05",
                                "sense_id": "6714c040-fe3b-38df-bdcf-55fac96561b5",
                                "text": "„Saskias nächster Job ist auf einer Tomatenfarm.“"
                            },
                            {
                                "example_id": "6b947496-38b5-4557-bf8b-f2f076f6eaf1",
                                "sense_id": "6714c040-fe3b-38df-bdcf-55fac96561b5",
                                "text": "„Besucht wird zunächst gemeinsam eine große Tomatenfarm mit fachlicher Führung durch die Gewächshäuser.“"
                            },
                            {
                                "example_id": "1fe40358-651c-438f-9894-8e56a37d3cf8",
                                "sense_id": "6714c040-fe3b-38df-bdcf-55fac96561b5",
                                "text": "„Didi Cune war 16 Jahre alt, als ein Ehepaar sie auf seiner Tomatenfarm aufnahm.“"
                            },
                            {
                                "example_id": "2da882f0-f82e-4efd-acfd-c49c44f44534",
                                "sense_id": "6714c040-fe3b-38df-bdcf-55fac96561b5",
                                "text": "„Tom ist ein 34-jähriger Manager einer Tomatenfarm in Belgien, auf der Arbeiter aus verschiedenen EU-Ländern beschäftigt sind.“"
                            },
                            {
                                "example_id": "5fa8dacf-9de1-4818-b407-0c52ec746fb1",
                                "sense_id": "6714c040-fe3b-38df-bdcf-55fac96561b5",
                                "text": "„Ephriams Schwester Winifried hat eine kleine Tomatenfarm.“"
                            }
                        ],
