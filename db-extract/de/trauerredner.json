                "senses": [
                    {
                        "sense_id": "b2a6ef62-2e47-30a8-8449-78a04e770e1c",
                        "entry_id": "f47f9f5f-0b77-314c-bd31-29e13cd22c44",
                        "glosses": [
                            "Person, die bei einer Trauerfeier die Abschiedsrede (Trauerrede) hält und auch für den Ablauf der Veranstaltung verantwortlich sein kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2d183a3-4978-43b4-9037-fb2d4a9e07eb",
                                "sense_id": "b2a6ef62-2e47-30a8-8449-78a04e770e1c",
                                "text": "„Willy streifte sich mit der Serviette über den Mund und erzählte, wie ihn nach dem Tod seiner Frau der Trauerredner besuchte. Das übliche Ritual. Ein kultivierter und sachlicher Mann, dem man sofort ansah, dass er mit Sprache umgehen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
