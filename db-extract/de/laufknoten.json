                        "examples": [
                            {
                                "example_id": "3beb87e6-20d8-495c-b4aa-f6f6007b6bbd",
                                "sense_id": "d89470a6-057a-37e8-b749-68b64f70e9c9",
                                "text": "Nachdem er seine Handgelenke aneinandergelegt hatte, steckte er seine Hände durch einen Laufknoten und zog diesen mit den Zähnen fest."
                            },
                            {
                                "example_id": "693059a2-c2b1-446e-9e1d-f7c410c1a9e3",
                                "sense_id": "d89470a6-057a-37e8-b749-68b64f70e9c9",
                                "text": "Die mit den Laufknoten gesicherten Kettschlaufen liegen zum Warenbaum hin."
                            },
                            {
                                "example_id": "08b8f4b8-1ed4-41ba-8764-ed23a8042a94",
                                "sense_id": "d89470a6-057a-37e8-b749-68b64f70e9c9",
                                "text": "Das Schnurlot wird mit einem Laufknoten am Lothaken aufgehängt."
                            }
                        ],
