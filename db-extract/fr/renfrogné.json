                            "feminine"
                        ],
                        "form": "renfrognées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab60091a-bb78-3fe2-971c-38653583ac4e",
                        "entry_id": "f3f62c35-15b5-3378-96a7-37c13f30b803",
                        "glosses": [
                            "Contracté, plissé en signe de mécontentement, en parlant du visage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeeb0ef2-65f2-407e-8585-a0e80353ba90",
                                "sense_id": "ab60091a-bb78-3fe2-971c-38653583ac4e",
                                "text": "Il l’écouta d’un air assez renfrogné, mais il se dérida dès qu’il se trouva en face de Mme de Mazatlan."
                            },
                            {
                                "example_id": "4f71a784-369f-4795-96a3-d64860b91964",
                                "sense_id": "ab60091a-bb78-3fe2-971c-38653583ac4e",
                                "text": "un gentilhomme de belle taille et de haute mine, quoique au visage légèrement renfrogné, lequel causait avec deux personnes qui paraissaient l’écouter avec déférence."
                            },
                            {
                                "example_id": "aca760e0-20ec-4cfe-ae0c-4d55f0f77af6",
                                "sense_id": "ab60091a-bb78-3fe2-971c-38653583ac4e",
                                "text": "Aux premiers mots elle eut la satisfaction de voir la physionomie renfrognée des ouvriers s’éclairer ; il est vrai que ce n’était là qu’une phrase de conversation courante, mais leur demi-sourire était de bonne augure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ea089f9-aff2-4f56-8c86-3a833a47a3fe",
                        "source_entry_id": "f3f62c35-15b5-3378-96a7-37c13f30b803",
                        "source_sense_id": "ab60091a-bb78-3fe2-971c-38653583ac4e",
                        "target_lang_word": "sullen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sullen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c84a08bc-265e-3423-8822-71e03e3ad82c",
                                        "entry_id": "51feb946-3d41-330b-a5e1-1404a15e615d",
                                        "glosses": [
                                            "Having a brooding ill temper; sulky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5722a004-0488-4806-bf89-11f968d58fb0",
                                                "sense_id": "c84a08bc-265e-3423-8822-71e03e3ad82c",
                                                "text": "Still she entreats, and prettily entreats, / For to a pretty ear she tunes her tale; / Still is he sullen, still he lours and frets, / ‘Twixt crimson shame and anger ashy-pale;"
                                            },
                                            {
                                                "example_id": "e8fb133b-b5a1-4dfc-8311-21047c0793e7",
                                                "sense_id": "c84a08bc-265e-3423-8822-71e03e3ad82c",
                                                "text": "And sullen I forsook the imperfect feast."
                                            },
                                            {
                                                "example_id": "6e5e5c86-4dc0-4465-aa34-b4e72b77f016",
                                                "sense_id": "c84a08bc-265e-3423-8822-71e03e3ad82c",
                                                "text": "2007, Steven Wilson, \"Normal\", Porcupine Tree, Nil Recurring.\nSullen and bored the kids stay / And in this way wish away each day"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1ca9a54-8d1b-3247-981a-d86fe73b371a",
                                        "entry_id": "51feb946-3d41-330b-a5e1-1404a15e615d",
                                        "glosses": [
                                            "Gloomy; dismal; foreboding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "286d5a5e-da24-4e08-9b55-7b5a913aa698",
                                                "sense_id": "f1ca9a54-8d1b-3247-981a-d86fe73b371a",
                                                "text": "a sullen atmosphere"
                                            },
                                            {
                                                "example_id": "8f8ea375-88bb-443f-81bd-3999e8812942",
                                                "sense_id": "f1ca9a54-8d1b-3247-981a-d86fe73b371a",
                                                "text": "Our solemn hymns to sullen dirges change;"
                                            },
                                            {
                                                "example_id": "61ee2508-1466-4ac2-915d-b2bcf39cbf8a",
                                                "sense_id": "f1ca9a54-8d1b-3247-981a-d86fe73b371a",
                                                "text": "He added not; and Satan bowing low / His gray diſſimulation, diſappear'd / Into thin Air diffuſ'd: for now began / Night with her ſullen wing to double-ſhade / The Deſert; Fowls in thir clay neſts were couch't; / And now wild Beaſts came forth the woods to roam."
                                            },
                                            {
                                                "example_id": "02ca5d76-d13c-4e8d-8415-4fdaa7ccca78",
                                                "sense_id": "f1ca9a54-8d1b-3247-981a-d86fe73b371a",
                                                "text": "No cheerful breeze this sullen region knows, / The dreaded East is all the wind that blows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edc69e3-5eec-36f7-80d1-e2b13636df2d",
                                        "entry_id": "51feb946-3d41-330b-a5e1-1404a15e615d",
                                        "glosses": [
                                            "Sluggish; slow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceade781-11b1-433a-b22f-0a116244bdc6",
                                                "sense_id": "2edc69e3-5eec-36f7-80d1-e2b13636df2d",
                                                "text": "The larger [stream] was placid, and even sullen, in its course."
                                            },
                                            {
                                                "example_id": "c02f64b9-ea57-410e-a3f9-e0845bd2fd62",
                                                "sense_id": "2edc69e3-5eec-36f7-80d1-e2b13636df2d",
                                                "text": "When ends life's transient dream, / when death’s cold, sullen stream / shall o'er me roll,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7bff711-6d22-3608-8f38-0287c9ab0332",
                                        "entry_id": "51feb946-3d41-330b-a5e1-1404a15e615d",
                                        "glosses": [
                                            "Mischievous; malignant; unpropitious."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018fc864-f63f-471f-9a30-40b70df2deb5",
                                                "sense_id": "f7bff711-6d22-3608-8f38-0287c9ab0332",
                                                "text": "Such sullen planets at my birth did shine, / They threaten every Fortune mixt with mine."
                                            },
                                            {
                                                "example_id": "cd7cd768-41ef-431e-9d77-65b03c50637a",
                                                "sense_id": "f7bff711-6d22-3608-8f38-0287c9ab0332",
                                                "text": "she meets again / The savage murderer's sullen gaze,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f53fb65-c5e6-3513-8ab7-1a68fd4d45a9",
                                        "entry_id": "51feb946-3d41-330b-a5e1-1404a15e615d",
                                        "glosses": [
                                            "Obstinate; intractable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faa09485-c188-4199-8823-999530721d9f",
                                                "sense_id": "3f53fb65-c5e6-3513-8ab7-1a68fd4d45a9",
                                                "text": "Things are as sullen as we are, and will be what they are whatever we think of them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sullen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a40df5e7-8258-3061-82f5-2d48b8c992bb",
                                        "entry_id": "f735e077-c5cd-30ec-8230-46e60c7c6994",
                                        "glosses": [
                                            "One who is solitary, or lives alone; a hermit."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1062b23e-e96a-45b0-9924-2148fb337571",
                                                "sense_id": "a40df5e7-8258-3061-82f5-2d48b8c992bb",
                                                "text": "He sit neither with seint Johan, / Symond ne Jude, / Ne with maydenes ne with martires, / Confessours ne wydewes; / But by hymself as a soleyn, / And served on erthe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "113ceeb6-c3fc-345d-a300-fc30cd3f470f",
                                        "entry_id": "f735e077-c5cd-30ec-8230-46e60c7c6994",
                                        "glosses": [
                                            "Sullen feelings or manners; sulks; moroseness."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb77c382-c230-4460-ae49-265e72e2d340",
                                                "sense_id": "113ceeb6-c3fc-345d-a300-fc30cd3f470f",
                                                "text": "And let them die that age and sullens have;"
                                            },
                                            {
                                                "example_id": "5796003d-171c-40a9-b598-94783e74adcc",
                                                "sense_id": "113ceeb6-c3fc-345d-a300-fc30cd3f470f",
                                                "text": "If she be not sick of the sullens, I see not the least infirmity in her."
                                            },
                                            {
                                                "example_id": "5006b287-0c0f-45b6-a7e0-251fed01c719",
                                                "sense_id": "113ceeb6-c3fc-345d-a300-fc30cd3f470f",
                                                "text": "[M]y brother […] charged my desire of being excused coming down to sullens, because a certain person had been spoken against, upon whom, as he supposed, my fancy ran."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sullen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b397ab3-4f15-3c87-aad1-c50c071ec0ad",
                                        "entry_id": "41c87d78-4103-3516-82b8-6f4c1d3cb978",
                                        "glosses": [
                                            "To make sullen."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b1d0fa-32e3-464e-bb47-2cc50f5b4cd8",
                                                "sense_id": "7b397ab3-4f15-3c87-aad1-c50c071ec0ad",
                                                "text": "The idle man is like the dumb jack in a virginal: while all the other dance out a winning music, this, like a member out of joint, sullens the whole body, with an ill disturbing laziness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
