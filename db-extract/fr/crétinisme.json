                        ]
                    },
                    {
                        "translation_id": "4768d125-ee6d-4166-95b0-dc0150d93d7d",
                        "source_entry_id": "29be1613-2a62-37e2-af17-7dc29ae72b86",
                        "source_sense_description": "(Médecine) Arriération mentale, intellectuelle et parfois physique due à une insuffisance thyroïdienne congénitale",
                        "target_lang_word": "кретинизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кретинизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f16096-1e7b-33fa-a31f-e74fc0243964",
                                        "entry_id": "671e25f9-d578-30d6-adc4-a9107e62c86d",
                                        "glosses": [
                                            "мед. резкое отставание физического и умственного развития в связи с синдромом врожденной недостаточности щитовидной железы или недостатком йода в рационе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee3bb5c-98c2-4860-a7e9-d0a3efd9d5fb",
                                                "sense_id": "c4f16096-1e7b-33fa-a31f-e74fc0243964",
                                                "text": "Очень характерной вариацией этого типа является кретинизм, зависящий от недостаточной деятельности щитовидной железы и иногда сопровождающийся микседематозными явлениями (микседематозный кретинизм)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b81d068-dc33-39ec-929a-e45c9b23bd21",
                                        "entry_id": "671e25f9-d578-30d6-adc4-a9107e62c86d",
                                        "glosses": [
                                            "разг. глупое, бессмысленое поведение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398bfc31-a6de-47ce-b416-28a9c731a2b6",
                                                "sense_id": "6b81d068-dc33-39ec-929a-e45c9b23bd21",
                                                "text": "Он стоял вместе с другими ребятами в туалете и раздраженно курил, все они ругались и независимо сплевывали, и Эди ругался тоже в припадке бессильной злости на кретинизм школьного начальства."
                                            },
                                            {
                                                "example_id": "db5471c8-fc33-4888-ae50-bfbedd627d58",
                                                "sense_id": "6b81d068-dc33-39ec-929a-e45c9b23bd21",
                                                "text": "Знаешь, Нюха, по-моему, это форменный кретинизм — быть в ссоре больше пяти минут."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
