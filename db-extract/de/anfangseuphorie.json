                "senses": [
                    {
                        "sense_id": "2c4fb67e-498a-3a1b-b4a5-b504b24e66ab",
                        "entry_id": "f36b3758-dde6-3ad0-af0b-b426d77f05ec",
                        "glosses": [
                            "(vorübergehend) begeisterter Gemütszustand am Beginn einer Zeitspanne oder Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c5ae38-de55-4485-a1b8-96327e77a473",
                                "sense_id": "2c4fb67e-498a-3a1b-b4a5-b504b24e66ab",
                                "text": "Startups leben von Anfangseuphorie und Selbstausbeutung."
                            },
                            {
                                "example_id": "e614885e-6ffe-4d97-9858-58ca8123de27",
                                "sense_id": "2c4fb67e-498a-3a1b-b4a5-b504b24e66ab",
                                "text": "„Diese Anfangseuphorie hat auf das Paar einen entlastenden Effekt.“"
                            },
                            {
                                "example_id": "07d89a2d-0574-4b89-b8a5-ca04d838f1b1",
                                "sense_id": "2c4fb67e-498a-3a1b-b4a5-b504b24e66ab",
                                "text": "„Allerdings hielt die Anfangseuphorie nicht lange an.“"
                            },
                            {
                                "example_id": "77290854-b0db-4e86-b902-60d5e092f3c5",
                                "sense_id": "2c4fb67e-498a-3a1b-b4a5-b504b24e66ab",
                                "text": "„Heute, etwas mehr als neun Monate später, scheint die Anfangseuphorie verpufft und die Barmbeker Bürger weit davon entfernt, ihre Einkäufe auf dem ehemaligen Hertie-Gelände erledigen zu können.“"
                            },
                            {
                                "example_id": "b3475891-8a3d-4cb4-82df-373e8d2a98fd",
                                "sense_id": "2c4fb67e-498a-3a1b-b4a5-b504b24e66ab",
                                "text": "„Die Anfangseuphorie führte dazu, dass mehr Menschen für ein, zwei Jahre Podcasts hörten. Einfach so. Und dann war alles genauso schnell wieder vorbei.“"
                            },
                            {
                                "example_id": "064f092e-48a5-48a1-a99d-cd80ba8545a2",
                                "sense_id": "2c4fb67e-498a-3a1b-b4a5-b504b24e66ab",
                                "text": "„Nach der Anfangseuphorie, als die jungen Soldaten es kaum erwarten konnten, in den Krieg zu ziehen, werden die Kriegsweihnachtsfeste in Singen zum Anlass, über das „köstliche Gut“, den Frieden, nachzudenken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
