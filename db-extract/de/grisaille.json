                ],
                "translations": [
                    {
                        "translation_id": "c9843e68-b1f6-4f0b-a577-c495836e1b58",
                        "source_entry_id": "d0baf023-110f-37c6-9c7d-e5ac0246d8ef",
                        "source_sense_id": "42bbd401-a066-39dd-95c5-a544cda312bf",
                        "source_sense_description": "Malerei: Maltechnik, bei der vorwiegend Grautöne verwendet werden",
                        "target_lang_word": "grisaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grisaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8c18aa-e9d0-3786-a435-68b0257b7f23",
                                        "entry_id": "dc7e8261-c4c8-3082-b809-d3dc9b397561",
                                        "glosses": [
                                            "Peinture qui se fait avec deux couleurs, l’une claire, l’autre sombre, et qui représente des objets supposés blancs, ou en imitation d'un bas-relief."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68a2394f-1724-4879-b83c-dea73e704403",
                                                "sense_id": "4b8c18aa-e9d0-3786-a435-68b0257b7f23",
                                                "text": "Çà et là, sur les grisailles fauves des broussailles, un troupeau de chèvres jetait une tache noire à côté de celle, blanche, d’un troupeau de moutons."
                                            },
                                            {
                                                "example_id": "a55a2921-4d47-4355-9bd7-621eb863016f",
                                                "sense_id": "4b8c18aa-e9d0-3786-a435-68b0257b7f23",
                                                "text": "La montagne s’estompait en grisaille sous la buée chaude avec les taches d’ombre mouvante des nuages qui passaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5680cb12-d213-3894-9d73-998e08580358",
                                        "entry_id": "dc7e8261-c4c8-3082-b809-d3dc9b397561",
                                        "glosses": [
                                            "Vitrail en tons gris, réalisé par ajout d’oxydes métalliques avant la cuisson du verre."
                                        ],
                                        "tags": [
                                            "Verrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dfb71bc-848b-4434-9386-48b6ed5b9e82",
                                                "sense_id": "5680cb12-d213-3894-9d73-998e08580358",
                                                "text": "Mais dans le sanctuaire, il existe deux fenêtres garnies, au xviᵉ siècle, de vitraux d’une grande valeur […] Les grisailles sont modernes et ont été fabriquées à l’aide des fragments anciens qui existaient encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2504270-c377-3a8b-93ee-5c7258a570be",
                                        "entry_id": "dc7e8261-c4c8-3082-b809-d3dc9b397561",
                                        "glosses": [
                                            "Temps gris et couvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7599f75a-9f2d-489a-92ad-d00a1eaa72c7",
                                                "sense_id": "a2504270-c377-3a8b-93ee-5c7258a570be",
                                                "text": "Le jour pointait à peine, tout de grisailles mêlées aux restes d’une nuit tenace."
                                            },
                                            {
                                                "example_id": "0ec4b0f2-c60b-473c-824e-0a3c0fbffc02",
                                                "sense_id": "a2504270-c377-3a8b-93ee-5c7258a570be",
                                                "text": "Le confinement et la détresse se pointent chez bien des Québécois, conséquences du confinement rallongé et du spleen bien québécois du dehors novembre. Grisaille et noirceur à l’extérieur comme à l’intérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b72146e1-6cbc-362d-bf76-b427c2a8c655",
                                        "entry_id": "dc7e8261-c4c8-3082-b809-d3dc9b397561",
                                        "glosses": [
                                            "Un des noms vernaculaires du peuplier blanc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e6ab59-a1f5-4c60-9755-16eb07df7b4c",
                                                "sense_id": "b72146e1-6cbc-362d-bf76-b427c2a8c655",
                                                "text": "Le peuplier blanc a larges feuilles, que l’on nomme aussi grisaille d’Hollande, ou ypreau, ou franc picard, & en Angleterre abele […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c92663c-527b-32db-ad77-9d9db6049884",
                                        "entry_id": "dc7e8261-c4c8-3082-b809-d3dc9b397561",
                                        "glosses": [
                                            "Ensemble indistinct et sans éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a57878-bdf7-4edf-9a78-04b7b7c98e7f",
                                                "sense_id": "7c92663c-527b-32db-ad77-9d9db6049884",
                                                "text": "En vain fermait-il ses yeux, la chère image ne sortait plus de la grisaille informe, où s’effaçait lentement tout ce passé d’amour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "829f15eb-67fb-3fbe-b25c-eeeb36442965",
                                        "entry_id": "dc7e8261-c4c8-3082-b809-d3dc9b397561",
                                        "glosses": [
                                            "Mélange de cheveux blancs et de cheveux noirs, destiné à confectionner des perruques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5586a650-c8c0-395b-b480-e4e4ab2f191a",
                                        "entry_id": "dc7e8261-c4c8-3082-b809-d3dc9b397561",
                                        "glosses": [
                                            "Tissu mélangé de blanc et de noir, ou à petits carreaux blancs et noirs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
