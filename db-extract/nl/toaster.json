        "nl-extract.jsonl": [
            {
                "entry_id": "fc67b84d-966e-3a69-88bc-cab3fbeffb9f",
                "word": "toaster",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "df4b3273-e923-4932-9147-ee34d69e33df",
                        "entry_id": "fc67b84d-966e-3a69-88bc-cab3fbeffb9f",
                        "tags": [
                            "plural"
                        ],
                        "form": "toasters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e969b2a-bb7f-373f-bb46-490252f7ed9f",
                        "entry_id": "fc67b84d-966e-3a69-88bc-cab3fbeffb9f",
                        "glosses": [
                            "apparaat waarmee men brood kan roosteren"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "8fedacce-11af-401d-afb4-d889cf0c8538",
                                "sense_id": "7e969b2a-bb7f-373f-bb46-490252f7ed9f",
                                "text": "„Tosti?” Anneke Swarts legt de stapel boterhammen met kaas en salami vast klaar bij de toaster."
                            },
                            {
                                "example_id": "14af30ad-b796-42c9-bcd8-ac661ea3058b",
                                "sense_id": "7e969b2a-bb7f-373f-bb46-490252f7ed9f",
                                "text": "Een elektrische toaster is misschien iets voor mensen die met zo’n apparaat om kunnen gaan, maar er gaat niets boven toast die, aan een toastvork geprikt, voor het vuur gehouden en aandachtig geroosterd wordt, om vervolgens door een snelle bode die het huis een warm hart toedraagt, naar de tafel getransporteerd te worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2b9e6f2-8e30-36d1-abea-125c851ed119",
                        "entry_id": "fc67b84d-966e-3a69-88bc-cab3fbeffb9f",
                        "glosses": [
                            "iemand die teksten op reggaemuziek zingzegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f17ca59-cdcc-4ab5-82ba-f6714ff065ee",
                                "sense_id": "a2b9e6f2-8e30-36d1-abea-125c851ed119",
                                "text": "We wilden een reggaenummer opnemen met een toaster, wat in feite de Jamaicaanse variant op de rapper is."
                            },
                            {
                                "example_id": "39325f92-70bd-41bd-ac0b-93a4a6a1cb3c",
                                "sense_id": "a2b9e6f2-8e30-36d1-abea-125c851ed119",
                                "text": "Behalve de drummer, gitarist, bassist en keyboard-speler waren er Tricky zelf, zangeres Amber Sunshower en toaster Hawkman. Die laatste twee hadden de ondankbare rol om slechts af en toe een liedje te zingen en verder werkeloos te moeten toekijken."
                            }
                        ]
                    },
                    {
                        "sense_id": "70ea8b0f-583f-3a72-99be-f575cc140411",
                        "entry_id": "fc67b84d-966e-3a69-88bc-cab3fbeffb9f",
                        "glosses": [
                            "verouderde spelling of vorm van tooster tot 2006"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "195e425c-1f86-4b32-a419-7623d7954368",
                                "sense_id": "70ea8b0f-583f-3a72-99be-f575cc140411",
                                "text": "Toch dient gezegd dat deze autobiografische terugblik op Dekkers leven in 1842-44 relatief gezien veel, wellicht te veel plaatsruimte inneemt in het geheel van het boek, temeer daar zij de onstelpbare speecher en toaster die Dekker is, gelegenheid te over bieden om naar aanleiding van alles en nog wat zijn hier en daar wel wat mat fonkelende ‘esprit’ te laten bewonderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "173017fd-c636-47e0-8c2c-835db37ec221",
                        "source_entry_id": "fc67b84d-966e-3a69-88bc-cab3fbeffb9f",
                        "source_sense_id": "7e969b2a-bb7f-373f-bb46-490252f7ed9f",
                        "source_sense_description": "broodrooster",
                        "target_lang_word": "toaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toaster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32780278-dce3-3b56-8172-437d7e43682c",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "An electrical device for toasting food, typically sliced bread."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7c45a5f-00bd-389e-9c02-8c07f403152a",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A toasting fork."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77175d4d-3688-3da8-84f6-b3af927a62b3",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A fish ready for toasting."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11c32a7-1fad-4ab9-ba83-20002947f7c0",
                                                "sense_id": "77175d4d-3688-3da8-84f6-b3af927a62b3",
                                                "text": "[T]he tumult of the thousand different cries of the eager dealers, all shouting at the top of their voices, at one and the same time, is almost bewildering. […] \"Come and look at 'em! here's toasters!\" bellows one with a Yarmouth bloater stuck on a toasting-fork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0142b83-1871-3902-9cf8-959a932bc8aa",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "One who toasts (cooks lightly by browning)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0ec4b76-1e3c-3b81-88e8-ad24ffb347b4",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "One who toasts (engages in salute while drinking alcohol)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "490aaad6-6ca5-3b3b-b21a-642e6011b013",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A firearm, especially a pistol."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0094fde0-0c41-4625-98d9-c15c1950c1e9",
                                                "sense_id": "490aaad6-6ca5-3b3b-b21a-642e6011b013",
                                                "text": "The renegade, you been afraid I penetrate pop culture / Bring 'em a lot closer to the block where they pop toasters"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86cd46e4-5a08-3d28-9319-8f52ab0471cc",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A rapier or similar weapon."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e5b0754-7869-4670-8a62-d13447204777",
                                                "sense_id": "86cd46e4-5a08-3d28-9319-8f52ab0471cc",
                                                "text": "This attitude, and the sight of the blade which glistened by moonlight in his face, checked in some sort, the ardour of his assailant, who desired he would lay aside his toaster, and take a bout with him at equal arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd190af-76d4-362b-a3f3-3de50839ee28",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "Any of several small, box-like automobiles exemplified by the Scion xB and Honda Element."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49650292-7a8c-3a73-830c-e814ff0af339",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "An electronic organ, especially a crude one that uses analog technology."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf5d9390-deea-3462-b010-de7f26dbc5a9",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A low-end or outdated personal computer."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7ebb880-e5d0-44ea-8d2f-9047cf77fb50",
                                                "sense_id": "bf5d9390-deea-3462-b010-de7f26dbc5a9",
                                                "text": "For most older computers (pre-486 and even some 486s), it's simply easier to throw them away and start over (and cheaper, too). I know; this probably goes against the grain; after all, you hung onto that old toaster for three years, and now it makes a darn good doorstop."
                                            },
                                            {
                                                "example_id": "d031340f-addd-41bd-b2cd-5a6bc9f79d6d",
                                                "sense_id": "bf5d9390-deea-3462-b010-de7f26dbc5a9",
                                                "text": "On the technical side, we had only the old “toaster” Macintosh computers as our environment (only black and white and 512 by 480 screen resolution) and a variety of IBM PCs or equivalents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e8b1e5-9e12-36c7-9d38-bc67705af8fd",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A protogen."
                                        ],
                                        "tags": [
                                            "endearing",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cf499c5-e904-3722-a3d1-2ed9ca95dc42",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A self-contained software package distributable over the Internet or by burning onto CDs."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b154bdc0-ca36-45d6-9760-8cf7f18819b5",
                                                "sense_id": "0cf499c5-e904-3722-a3d1-2ed9ca95dc42",
                                                "text": "The Freedom Toaster was developed with backing from Mark Shuttleworth as a vending-machine-style dispenser of free digital products, including Ubuntu Linux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b120f9a2-39e3-31c1-92b4-f5ef7bc6d264",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "A disc jockey who accompanies reggae music with improvised rhythmic speech."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a61ebaf-5da4-3f6b-b4d1-a9210948104f",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "Diesel locomotives built by GE Transportation known for a propensity to catch fire, especially those showing previous fire damage."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dddbee21-0eb8-4536-8040-e6b1bb3729bb",
                                                "sense_id": "4a61ebaf-5da4-3f6b-b4d1-a9210948104f",
                                                "text": "No. 4020 shows off the aftereffects of the GE “toaster” phenomenon as it runs on the Joint Line north of the Air Force Academy (7/02/2023)."
                                            },
                                            {
                                                "example_id": "70046cca-7348-4055-b03a-4e96c7b4481d",
                                                "sense_id": "4a61ebaf-5da4-3f6b-b4d1-a9210948104f",
                                                "text": "Railfans often call GE Dash-9s as \"toasters\" which certainly applies to this locomotive."
                                            },
                                            {
                                                "example_id": "fcfe09ae-f6b1-4275-b368-5cc03bda034d",
                                                "sense_id": "4a61ebaf-5da4-3f6b-b4d1-a9210948104f",
                                                "text": "IIRC, it's usually a toaster (GE)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79bee87a-b012-3b0b-b30d-884e15e82479",
                                        "entry_id": "3814eada-8f49-3442-a81d-01564ebd1ab1",
                                        "glosses": [
                                            "An EMD AEM-7 electric locomotive"
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db503cb6-ec98-4fc1-ab09-57915e9ff6de",
                                                "sense_id": "79bee87a-b012-3b0b-b30d-884e15e82479",
                                                "text": "The origin of the design led railroaders to dub the units “meatballs,” and its boxy appearance inspired railfans to call them “toasters.”"
                                            },
                                            {
                                                "example_id": "dd094f0f-8cee-4f46-9797-e9236a153617",
                                                "sense_id": "79bee87a-b012-3b0b-b30d-884e15e82479",
                                                "text": "Sometimes affectionately referred to as “toasters” and “Swedish meatballs” due to their compact, boxy design and Swedish origins, the AEM-7s first entered service in May 1980 and since then have traveled more than 220 million miles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
