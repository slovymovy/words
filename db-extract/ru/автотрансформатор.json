                        "sense_id": "948bd82c-f33f-38ae-b3f2-187f0c9d4777",
                        "entry_id": "5b44df63-85dd-3fc3-87e9-01725d2a5874",
                        "glosses": [
                            "трансформатор, в котором первичная и вторичная обмотки гальванически соединены или представляют собой части одной общей обмотки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e14d8795-867a-44b5-9c89-b8201502236c",
                                "sense_id": "948bd82c-f33f-38ae-b3f2-187f0c9d4777",
                                "text": "Из-за короткозамкнутого витка автотрансформатор сгорел."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07577d96-5ef1-46b7-8207-b66532bea7ce",
                        "source_entry_id": "5b44df63-85dd-3fc3-87e9-01725d2a5874",
