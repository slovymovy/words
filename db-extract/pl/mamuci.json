                "senses": [
                    {
                        "sense_id": "1a75fede-2448-3602-8426-d775e540fce3",
                        "entry_id": "3000d076-3423-3c84-b477-b1e12960a404",
                        "glosses": [
                            "związany z mamutem, dotyczący mamuta, odnoszący się do mamuta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9059415-ca85-45f7-b1ca-3bc5f53d7fef",
                                "sense_id": "1a75fede-2448-3602-8426-d775e540fce3",
                                "text": "W naszym muzeum eksponowany jest mamuci szkielet."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f582ed1f-2406-3749-a4f3-38fa545b5ace",
                        "entry_id": "3000d076-3423-3c84-b477-b1e12960a404",
                        "glosses": [
                            "dotyczący rodzaju olbrzymiej skoczni narciarskiej, odnoszący się do olbrzymiej skoczni"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "44932d64-054a-456f-81fa-09ea7a49bc1b",
                                "sense_id": "f582ed1f-2406-3749-a4f3-38fa545b5ace",
                                "text": "To na mamuciej Małysz zdobył złoty medal."
                            },
                            {
                                "example_id": "d37afcf5-d5a5-43bf-b738-d6009039a801",
                                "sense_id": "f582ed1f-2406-3749-a4f3-38fa545b5ace",
                                "text": "Skocznia ta jest uważana za czwarty co do wielkości obiekt mamuci na świecie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3a08041b-4aac-3091-a64a-6e138dee42a7",
                        "entry_id": "3000d076-3423-3c84-b477-b1e12960a404",
                        "glosses": [
                            "olbrzymi, wielki"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "457e718e-1aa4-442c-be6b-7065a7f7ef4a",
                                "sense_id": "3a08041b-4aac-3091-a64a-6e138dee42a7",
                                "text": "Mamucie działa oddały na Helu zaledwie po kilka próbnych strzałów"
                            },
                            {
                                "example_id": "e8a0c149-df6b-4fae-8a28-b76cc5abdc03",
                                "sense_id": "3a08041b-4aac-3091-a64a-6e138dee42a7",
                                "text": "IBM buduje mamuci dysk"
                            },
                            {
                                "example_id": "5a41e275-3cf9-4177-bd05-3aabcdb37014",
                                "sense_id": "3a08041b-4aac-3091-a64a-6e138dee42a7",
                                "text": "Norweski trener staje przed olbrzymim, mamucim testem swojego menedżerskiego charakteru"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
