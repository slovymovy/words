                    "sense_definition": "Destin contraire, mauvaise fortune qui s'acharne sur quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "destin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il semble poursuivi par le <w>malheur</w> depuis plusieurs années."
                        },
                        {
                            "text": "Nous avons joué de <w>malheur</w> pendant tout notre voyage à cause de la tempête."
                        }
                    ],
                    "antonyms": [
                        "bonheur"
                    ],
                    "common_phrases": [
                        "avoir le malheur de",
                        "jouer de malheur"
                    ]
                },
                {
                    "sense_id": "f0aec94a-6ea5-34e7-96d7-0387103e224e",
                    "sense_definition": "État de détresse morale ou de profonde affliction.",
