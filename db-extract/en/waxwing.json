    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "49995899-5fc1-3949-9f78-b2af4d1375ad",
                "word": "waxwing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f2fc0c01-54d7-40c3-b152-6775103cd925",
                        "entry_id": "49995899-5fc1-3949-9f78-b2af4d1375ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "waxwings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d35cdfa-73fa-3730-b622-b7aa2093d552",
                        "entry_id": "49995899-5fc1-3949-9f78-b2af4d1375ad",
                        "glosses": [
                            "Any of several songbirds of the genus Bombycilla, having crested heads, and red tips to the wings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ad8d15-ab74-4581-abd2-03a56b882365",
                                "sense_id": "6d35cdfa-73fa-3730-b622-b7aa2093d552",
                                "text": "I was the shadow of the waxwing slain\nBy the false azure in the windowpane;\nI was the smudge of ashen fluff—and I\nLived on, flew on, in the reflected sky."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d9ae32a-79e3-495f-a029-d122550d2c57",
                        "source_entry_id": "49995899-5fc1-3949-9f78-b2af4d1375ad",
                        "source_sense_id": "6d35cdfa-73fa-3730-b622-b7aa2093d552",
                        "source_sense_description": "songbird of genus Bombycilla",
                        "target_lang_word": "brkoslav",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e33c1f60-b9b5-48e3-b3cc-4e34f962f590",
                        "source_entry_id": "49995899-5fc1-3949-9f78-b2af4d1375ad",
                        "source_sense_id": "6d35cdfa-73fa-3730-b622-b7aa2093d552",
                        "source_sense_description": "songbird of genus Bombycilla",
                        "target_lang_word": "jaseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58d8f190-bee3-3c99-99a6-93784b937514",
                                        "entry_id": "99263518-6f77-3adf-b188-738e2e8b31e3",
                                        "glosses": [
                                            "Qui jase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "082bcd93-b8a0-4daf-a622-9531312a4c68",
                                                "sense_id": "58d8f190-bee3-3c99-99a6-93784b937514",
                                                "text": "…, je crains que vous n’ayez choisi un sot jaseur et importun pour vous servir de guide."
                                            },
                                            {
                                                "example_id": "3aa6d15f-3b2f-42dc-ac90-be59a0170e36",
                                                "sense_id": "58d8f190-bee3-3c99-99a6-93784b937514",
                                                "text": "Les mots que tu m’as dits sont des oiseaux jaseurs qui tournent autour de ma tête."
                                            },
                                            {
                                                "example_id": "dbb5c5fd-605a-4b4a-af87-766040032c29",
                                                "sense_id": "58d8f190-bee3-3c99-99a6-93784b937514",
                                                "text": "Là-haut, nous serions seuls avec le vent jaseur."
                                            },
                                            {
                                                "example_id": "d50a24f9-ae86-4dfa-96af-41c085b95478",
                                                "sense_id": "58d8f190-bee3-3c99-99a6-93784b937514",
                                                "text": "La soirée fut toute rieuse, toute égayée du bavardage joliment jaseur de Nello, qui disait qu’avant quinze jours, il irait jeter ses béquilles dans la Seine, au pont de Neuilly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "817cfbed-97da-35ce-aeac-111c250b12d6",
                                        "entry_id": "44d90aa8-50e6-3fd6-8411-cdc64929251f",
                                        "glosses": [
                                            "Celui qui jase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78512bf-8257-472c-9e0b-dfbc27f1959b",
                                                "sense_id": "817cfbed-97da-35ce-aeac-111c250b12d6",
                                                "text": "Ce ne pouvait être que la fille, Géraud n’étant ni un jaseur ni un chicaneur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7205c9a6-5313-3f6e-b1f1-e78729c1cf14",
                                        "entry_id": "9c0baccc-d358-3b82-87d2-6f66a7607d42",
                                        "glosses": [
                                            "Genre de passereaux dentirostres et migrateurs qui habitent principalement dans les forêts de sapins. On les trouve essentiellement en Europe du Nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2196c32-e5c1-41bc-8d0c-9510e8c8c998",
                                                "sense_id": "7205c9a6-5313-3f6e-b1f1-e78729c1cf14",
                                                "text": "La chatte était tapie au pied du pommier, à guetter deux jaseurs boréaux agrippés à leur tranche de lard."
                                            },
                                            {
                                                "example_id": "c357824a-7b92-430c-95f4-601f39f09dbd",
                                                "sense_id": "7205c9a6-5313-3f6e-b1f1-e78729c1cf14",
                                                "text": "Alors qu’en plaine, fauvettes et serins cinis sont de retour de leur villégiature hivernale dans le Sud, en ce lieu, trente jaseurs boréaux, arrivés de Scandinavie pendant l’automne, s’attardent, vraisemblablement peu enclins à reprendre la route du Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
