                                        "entry_id": "fe397629-b4fe-3184-bc42-96344f963e0f",
                                        "glosses": [
                                            "zum Flachwasserbereich des Meeres gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1871afcb-24dd-400d-a3a2-f756a008d102",
                                                "sense_id": "8cc1bf73-b7b5-3eef-bc03-d02ad1b1ffe3",
                                                "text": "Bei der bathymetrische Gliederung der marinen Lebensräume wird der neritische Lebensbereich in die litorale und die sublitorale Zone aufgeteilt."
                                            },
                                            {
                                                "example_id": "4c312ba6-570d-4fa1-9c17-171f8fad6acf",
                                                "sense_id": "8cc1bf73-b7b5-3eef-bc03-d02ad1b1ffe3",
                                                "text": "Der neritische Lebensraum umfasst den gesamten Bereich von der Spritzzone direkt an der Küste, die Gezeitenzone und den küstennahen Meeresbereich bis zu einer Tiefe von ungefähr 200 m."
                                            }
                                        ],
