{
    "word_family": [
        "simping",
        "simpleton"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28dcada0-74d7-3d14-91cf-d806eb532474",
                    "sense_definition": "to be especially deferential to and emotionally vulnerable with a woman, often with the intent of receiving sexual gratification",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obsequious behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent all his money on gifts for her, but his friends told him to stop <w>simping</w> so hard.",
                            "target_lang_translations": {
                                "ru": "Он потратил все деньги на подарки для нее, но друзья сказали ему перестать так сильно <w>симпить</w>."
                            }
                        },
                        {
                            "text": "It is nothing wrong with treating your lady nice, but some of these guys are just <w>simping</w> for attention.",
                            "target_lang_translations": {
                                "ru": "Нет ничего плохого в том, чтобы хорошо относиться к своей даме, но некоторые из этих парней просто <w>унижаются</w> ради внимания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop simping",
                        "simping for attention"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "modern internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "проявлять чрезмерную почтительность и эмоциональную уязвимость по отношению к женщине, часто с целью получения сексуального удовлетворения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симпить",
                                "target_lang_sense_clarification": "интернет-сленг"
                            },
                            {
                                "target_lang_word": "подлизываться",
                                "target_lang_sense_clarification": "к женщине ради выгоды"
                            },
                            {
                                "target_lang_word": "бегать хвостиком",
                                "target_lang_sense_clarification": "унизительно ухаживать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20a33281-adc9-375e-b24b-680839c95174",
                    "sense_definition": "to obsequiously praise or admire someone, often a celebrity or public figure",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obsequious behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans were <w>simping</w> over the new lead singer's photos all day on social media.",
                            "target_lang_translations": {
                                "ru": "Фанаты весь день <w>пускали слюни</w> на фото нового солиста в соцсетях."
                            }
                        },
                        {
                            "text": "I cannot believe you are <w>simping</w> for a politician who does not even know you exist.",
                            "target_lang_translations": {
                                "ru": "Не верится, что ты так <w>фанатеешь</w> по политику, который даже не знает о твоем существовании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "simping over someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "modern internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "подобострастно хвалить или восхищаться кем-либо, часто знаменитостью или общественным деятелем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фанатеть",
                                "target_lang_sense_clarification": "чрезмерно восхищаться"
                            },
                            {
                                "target_lang_word": "симпить",
                                "target_lang_sense_clarification": "интернет-сленг, обожать кумира"
                            },
                            {
                                "target_lang_word": "боготворить",
                                "target_lang_sense_clarification": "слепо поклоняться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fd50aee-6533-33c9-9228-dc72c405d3f5",
                    "sense_definition": "to reminisce melancholically or recall fond memories tinged with sadness, especially regarding a former lover",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stayed up late listening to sad songs and <w>simping</w> over my ex-girlfriend.",
                            "target_lang_translations": {
                                "ru": "Я не спал допоздна, слушая грустные песни и <w>страдая</w> по своей бывшей девушке."
                            }
                        },
                        {
                            "text": "Stop <w>simping</w> over that boy and move on with your life.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>сохнуть</w> по этому парню, живи своей жизнью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "simping over an ex"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "modern internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "меланхолично предаваться воспоминаниям или вспоминать приятные моменты с оттенком грусти, особенно о бывшем партнере"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдать",
                                "target_lang_sense_clarification": "по бывшему партнеру"
                            },
                            {
                                "target_lang_word": "сохнуть",
                                "target_lang_sense_clarification": "по кому-то из прошлого"
                            },
                            {
                                "target_lang_word": "грустить",
                                "target_lang_sense_clarification": "вспоминая отношения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94d4d91f-5992-311e-b255-31d7b7283cfa",
                    "sense_definition": "a man who foolishly overvalues and defers to a woman, putting her on a pedestal",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obsequious person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His girlfriend won't even touch him, yet he bought her a house; he is such a <w>simp</w>.",
                            "target_lang_translations": {
                                "ru": "Его девушка даже не прикасается к нему, а он купил ей дом; он такой <w>симп</w>."
                            }
                        },
                        {
                            "text": "Don't be a <w>simp</w> by buying expensive gifts for a girl who doesn't like you.",
                            "target_lang_translations": {
                                "ru": "Не будь <w>подкаблучником</w>, покупая дорогие подарки девушке, которой ты не нравишься."
                            }
