                "senses": [
                    {
                        "sense_id": "324ad382-af91-3ba9-8692-872bb7c19146",
                        "entry_id": "1711b907-b2dc-3082-b17d-c5a4b9046eec",
                        "glosses": [
                            "mit Zinn beschichtetes dünn gewalztes Stahlblech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb1c050-3ce2-4fd4-a3b3-ffb8baab8ce2",
                                "sense_id": "324ad382-af91-3ba9-8692-872bb7c19146",
                                "text": "„Die Lebensmitteldose besteht aus besonders dünnem Weißblech, das mit Zinn veredelt und innenseitig mit einer hochelastischen Kunststoffschicht versehen ist.“"
                            },
                            {
                                "example_id": "9f9d35f6-60bf-4061-9fef-6dce48c4b9d6",
                                "sense_id": "324ad382-af91-3ba9-8692-872bb7c19146",
                                "text": "„Bei näherem Hinsehen zeigt sich, dass es aus Weißblech zusammengebogen wurde, der Aufdruck des recycelten Dosenmetalls ist zu entziffern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91c2f9cd-41b7-48fe-90b4-9c2bf65c4b27",
