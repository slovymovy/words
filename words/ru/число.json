                        {
                            "text": "Мы договорились встретиться десятого <w>числа</w>.",
                            "target_lang_translations": {
                                "en": "We agreed to meet on the tenth <w>of the month</w>.",
                                "zh": "我们约好十<w>号</w>见面。"
                            }
