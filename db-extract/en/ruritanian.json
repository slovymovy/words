                                    {
                                        "sense_id": "b477584e-468a-302f-ab22-d38105d764db",
                                        "entry_id": "b0514b32-22af-31e5-b2ab-00e294a94c4f",
                                        "glosses": [
                                            "Que pertenece o concierne a la quimera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f21217-3892-48e2-a8ae-51028d5bb51c",
                                                "sense_id": "b477584e-468a-302f-ab22-d38105d764db",
                                                "text": "«Por razones que en seguida se os harán patentes, es difícil que pueda haber alguien más consciente que yo mismo de lo quimérica que resulta a estas alturas cualquier pretensión de originalidad en el modo de expresar la gratitud en el arranque de un discurso como este»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddf4679d-cb34-46cf-8615-9fba44820003",
                        "source_entry_id": "23ba41d7-cdf5-3114-a0a6-7fb72c76cea2",
                        "source_sense_description": "used to describe a fictitious and generic foreign government or person",
                        "target_lang_word": "Poldavie",
                        "target_lang_code": "fr",
