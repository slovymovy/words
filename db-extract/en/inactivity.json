    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "78c059d6-0ec2-33d2-b8c9-8af463839cbd",
                "word": "inactivity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f9b95738-62c1-4020-a8b6-7d58d6bcd73c",
                        "entry_id": "78c059d6-0ec2-33d2-b8c9-8af463839cbd",
                        "tags": [
                            "plural"
                        ],
                        "form": "inactivities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "179b45f4-cc5e-3e44-8bde-3778cec351ad",
                        "entry_id": "78c059d6-0ec2-33d2-b8c9-8af463839cbd",
                        "glosses": [
                            "The quality of being inactive; idleness; passiveness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f50b54f-0185-4b39-aced-bdffff41d713",
                                "sense_id": "179b45f4-cc5e-3e44-8bde-3778cec351ad",
                                "text": "Painters depicted Idle Hours (see fig. 99), reverie, solitude, and other themes that reflected Americans' new willingness to eschew productivity, and they sold their canvases to patrons who enjoyed both the inactivities portrayed and seeing themselves portrayed in inactivities."
                            },
                            {
                                "example_id": "3884aceb-b0e9-47b0-a4df-545d152e5187",
                                "sense_id": "179b45f4-cc5e-3e44-8bde-3778cec351ad",
                                "text": "Shepard: How do the Reapers survive out in dark space?\nVigil: We have only theories. The researchers here came to believe the Reapers enter prolonged states of inactivity to conserve energy.\nVigil: This allows them to survive the thousands and thousands of years it takes for organic civilization to rebuild itself. But in this state, they are vulnerable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c368fd1-ca85-4b68-a98e-5bc959d07715",
                        "source_entry_id": "78c059d6-0ec2-33d2-b8c9-8af463839cbd",
                        "source_sense_id": "179b45f4-cc5e-3e44-8bde-3778cec351ad",
                        "source_sense_description": "quality of being inactive",
                        "target_lang_word": "nečinnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cd4a502e-de3a-4669-b687-9b552ceabdb4",
                        "source_entry_id": "78c059d6-0ec2-33d2-b8c9-8af463839cbd",
                        "source_sense_id": "179b45f4-cc5e-3e44-8bde-3778cec351ad",
                        "source_sense_description": "quality of being inactive",
                        "target_lang_word": "inactiviteit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inactiviteit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                                        "entry_id": "945fed67-0f05-3dfe-8814-84f43bbb30bc",
                                        "glosses": [
                                            "het niet actief zijn; het niet in beweging zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d2e4f91-0b87-42fd-9e07-45756850c411",
                                                "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                                                "text": "Zo moet vanaf 1 januari een filterkoffieapparaat met isolatiekan automatisch afslaan na 1 minuut inactiviteit. Koffieautomaten met warmhoudplaatje mogen langer aanblijven, maar ook daar is een maximum van 40 minuten."
                                            },
                                            {
                                                "example_id": "d62dd2a2-edc3-419f-b179-8e835e91797e",
                                                "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                                                "text": "Monfils kwam langszij en in de vijfde set op 2-0. Na maanden inactiviteit door blessures én al meer dan elf uur arbeid in Melbourne was toen ook bij hem het beste er wel af."
                                            },
                                            {
                                                "example_id": "1a87c55c-4c69-470f-84f0-cee7a8cc946c",
                                                "sense_id": "bb136f72-51db-31c1-a796-858f08b0e8fa",
                                                "text": "Het verbaast de onderzoekers hoe sociaal geaccepteerd het nog is amper te bewegen. \"Inactiviteit wordt gezien als normaal. Dokters schrijven patiënten veel vaker bedrust voor dan dat ze hen aanmoedigen meer te bewegen,\" schrijven ze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e93a02a-75b4-455c-973d-3aacd6281bba",
                        "source_entry_id": "78c059d6-0ec2-33d2-b8c9-8af463839cbd",
                        "source_sense_id": "179b45f4-cc5e-3e44-8bde-3778cec351ad",
                        "source_sense_description": "quality of being inactive",
                        "target_lang_word": "inactivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inactivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b6c99eb-cac8-393f-87df-904be400057e",
                                        "entry_id": "d1614243-0ca1-372f-8331-7fa135bd8626",
                                        "glosses": [
                                            "Disposition à ne rien faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d36983b-2c04-4495-924c-f43a82d11d82",
                                                "sense_id": "7b6c99eb-cac8-393f-87df-904be400057e",
                                                "text": "Son inactivité m’impatiente."
                                            },
                                            {
                                                "example_id": "60d98341-686b-4dfe-ad23-5ceb9bcffdb6",
                                                "sense_id": "7b6c99eb-cac8-393f-87df-904be400057e",
                                                "text": "Il entend à peine Slobodan qui entre, ses reproches devant son inactivité, sa colère qui monte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09dc41be-cff5-36eb-a2d3-343b9a5b19ff",
                                        "entry_id": "d1614243-0ca1-372f-8331-7fa135bd8626",
                                        "glosses": [
                                            "État d’un fonctionnaire qui n’exerce pas ses fonctions."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d59947c8-c820-4cbb-aba5-e94620946063",
                                                "sense_id": "09dc41be-cff5-36eb-a2d3-343b9a5b19ff",
                                                "text": "Traitement d’inactivité."
                                            }
                                        ]
