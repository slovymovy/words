{
    "word_family": [
        "binarism",
        "binarity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5475a856-61e4-3c05-9c3f-514817de598b",
                    "sense_definition": "Relating to a system of counting or logic that uses only two numbers, 0 and 1.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "base_2_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Computers process all information using <w>binary</w> code consisting of ones and zeros.",
                            "target_lang_translations": {
                                "ru": "Компьютеры обрабатывают всю информацию, используя <w>двоичный</w> код, состоящий из единиц и нулей.",
                                "zh": "计算机使用由0和1组成的<w>二进制</w>代码处理所有信息。"
                            }
                        },
                        {
                            "text": "The <w>binary</w> number system is the fundamental language of digital electronics.",
                            "target_lang_translations": {
                                "ru": "<w>Двоичная</w> система счисления является фундаментальным языком цифровой электроники.",
                                "zh": "<w>二进制</w>数制是数字电子技术的基础语言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "base-2"
                    ],
                    "common_phrases": [
                        "binary code",
                        "binary system",
                        "binary digit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к системе счисления или логике, использующей только два числа: 0 и 1.",
                        "zh": "指仅使用0和1两个数字的计数或逻辑系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двоичный",
                                "target_lang_sense_clarification": "о коде или системе счисления"
                            },
                            {
                                "target_lang_word": "бинарный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二进制",
                                "target_lang_sense_clarification": "指代二进制系统或逻辑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4400fedf-eae9-3e25-85bf-bddd0ec01620",
                    "sense_definition": "Involving two distinct parts, options, or mutually exclusive states.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "two_parts_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The issue is complex and cannot be reduced to a simple <w>binary</w> choice.",
                            "target_lang_translations": {
                                "ru": "Этот вопрос сложен и не может быть сведен к простому <w>бинарному</w> выбору.",
                                "zh": "这个问题很复杂，不能简化为简单的<w>二元</w>选择。"
                            }
                        },
                        {
                            "text": "Water is a <w>binary</w> compound formed from hydrogen and oxygen.",
                            "target_lang_translations": {
                                "ru": "Вода — это <w>бинарное</w> соединение, образованное водородом и кислородом.",
                                "zh": "水是由氢和氧组成的<w>二元</w>化合物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dual",
                        "twofold",
                        "double",
                        "black-and-white"
                    ],
                    "common_phrases": [
                        "binary opposition",
                        "binary choice",
                        "binary compound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включающий две различные части, варианта или взаимоисключающих состояния.",
                        "zh": "涉及两个截然不同的部分、选项或互斥状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бинарный",
                                "target_lang_sense_clarification": "состоящий из двух компонентов"
                            },
                            {
                                "target_lang_word": "двойной",
                                "target_lang_sense_clarification": "имеющий две части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二元的",
                                "target_lang_sense_clarification": "指由两个部分组成"
                            },
                            {
                                "target_lang_word": "双重的",
                                "target_lang_sense_clarification": "指具有两个方面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6caf2760-8f93-3e54-b236-c1d8333e5ae1",
                    "sense_definition": "Relating to the classification of gender into two distinct forms of male and female.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gender_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people argue that a strict <w>binary</w> view of gender excludes some identities.",
                            "target_lang_translations": {
                                "ru": "Многие утверждают, что строгий <w>бинарный</w> взгляд на гендер исключает некоторые идентичности.",
                                "zh": "许多人认为，严格的<w>二元性别</w>观排斥了一些身份认同。"
                            }
                        },
                        {
                            "text": "The survey included options for those who do not identify with <w>binary</w> genders.",
                            "target_lang_translations": {
                                "ru": "Опрос включал варианты для тех, кто не отождествляет себя с <w>бинарными</w> гендерами.",
                                "zh": "这项调查为那些不认同<w>二元性别</w>的人提供了选项。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gender-binary"
                    ],
                    "antonyms": [
                        "non-binary"
                    ],
                    "common_phrases": [
                        "gender binary",
                        "binary gender"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к классификации гендера на две различные формы: мужскую и женскую.",
                        "zh": "指将性别划分为男性和女性两种形式的分类方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бинарный",
                                "target_lang_sense_clarification": "относящийся к гендерной системе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二元性别",
                                "target_lang_sense_clarification": "指性别二元论"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00f07487-c9fb-3a77-a544-5e71afc7f730",
                    "sense_definition": "The system of numbers used in computing that consists only of the digits 0 and 1.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "base_2_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students learn how to count in <w>binary</w> during their first computer science class.",
                            "target_lang_translations": {
                                "ru": "Студенты учатся считать в <w>двоичной системе</w> на первом занятии по информатике.",
                                "zh": "学生们在第一堂计算机课上学习如何用<w>二进制</w>计数。"
                            }
                        },
                        {
                            "text": "The message was encoded in <w>binary</w> before being transmitted across the network.",
                            "target_lang_translations": {
                                "ru": "Сообщение было закодировано в <w>двоичный код</w> перед передачей по сети.",
                                "zh": "消息在通过网络传输之前被编码为<w>二进制</w>格式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "base 2"
                    ],
                    "common_phrases": [
                        "in binary"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Система чисел, используемая в вычислениях, состоящая только из цифр 0 и 1.",
                        "zh": "计算机中使用的仅由0和1组成的数字系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двоичная система",
                                "target_lang_sense_clarification": "система счисления"
                            },
                            {
                                "target_lang_word": "двоичный код",
                                "target_lang_sense_clarification": "представление данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二进制",
                                "target_lang_sense_clarification": "指代二进制计数系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4547970b-ed40-3a65-ab11-f0cf250904b3",
                    "sense_definition": "A computer file containing machine-readable code or data rather than plain text.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "file_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to download the correct <w>binary</w> for your specific operating system.",
                            "target_lang_translations": {
                                "ru": "Вам нужно скачать правильный <w>бинарный файл</w> для вашей конкретной операционной системы.",
                                "zh": "你需要为你的特定操作系统下载正确的<w>二进制文件</w>。"
                            }
                        },
                        {
                            "text": "The programmer compiled the source code into a <w>binary</w> that could be executed.",
                            "target_lang_translations": {
                                "ru": "Программист скомпилировал исходный код в <w>бинарный файл</w>, который можно выполнить.",
                                "zh": "程序员将源代码编译成了可以执行的<w>二进制文件</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "binary file"
                    ],
                    "antonyms": [
                        "text file"
                    ],
                    "common_phrases": [
                        "executable binary"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерный файл, содержащий машиночитаемый код или данные, а не простой текст.",
                        "zh": "包含机器可读代码或数据而非纯文本的计算机文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бинарный файл",
                                "target_lang_sense_clarification": "файл данных или программы"
                            },
                            {
                                "target_lang_word": "исполняемый файл",
                                "target_lang_sense_clarification": "программа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二进制文件",
                                "target_lang_sense_clarification": "指计算机数据文件"
                            },
                            {
                                "target_lang_word": "可执行文件",
                                "target_lang_sense_clarification": "指程序文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04cabaea-1dc9-3b84-a890-5b0e2bc2d7ae",
                    "sense_definition": "A system of two stars that orbit around a common center of mass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers discovered a new <w>binary</w> in a distant part of the galaxy.",
                            "target_lang_translations": {
                                "ru": "Астрономы обнаружили новую <w>двойную звезду</w> в отдаленной части галактики.",
                                "zh": "天文学家在银河系的遥远区域发现了一颗新的<w>双星</w>。"
                            }
                        },
                        {
                            "text": "The brighter star in the <w>binary</w> is easily visible through a small telescope.",
                            "target_lang_translations": {
                                "ru": "Более яркая звезда в <w>двойной системе</w> легко видна в небольшой телескоп.",
                                "zh": "<w>双星</w>中较亮的那颗星通过小型望远镜很容易看到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "binary star",
                        "double star"
                    ],
                    "common_phrases": [
                        "eclipsing binary",
                        "visual binary"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "astronomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Система из двух звезд, вращающихся вокруг общего центра масс.",
                        "zh": "围绕共同质心运行的两颗恒星组成的系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двойная звезда",
                                "target_lang_sense_clarification": "астрономический объект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "双星",
                                "target_lang_sense_clarification": "指天文学中的双星系统"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}