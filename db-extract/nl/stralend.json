        "nl-extract.jsonl": [
            {
                "entry_id": "884874d2-9538-3eba-8985-5e044acb02ae",
                "word": "stralend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d78f86fa-0f34-309b-9075-6327e99c5a3e",
                        "entry_id": "884874d2-9538-3eba-8985-5e044acb02ae",
                        "glosses": [
                            "straling (zoals bijvoorbeeld zichtbaar licht) afgevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dee1490-79f2-492d-842b-0dad958e3907",
                                "sense_id": "d78f86fa-0f34-309b-9075-6327e99c5a3e",
                                "text": "Met kernenergie gaan we een stralende toekomst tegemoet, en zonder kernenergie trouwens ook."
                            }
                        ]
                    },
                    {
                        "sense_id": "54c10cd5-3b21-3841-b92f-e37d9747d57a",
                        "entry_id": "884874d2-9538-3eba-8985-5e044acb02ae",
                        "glosses": [
                            "zonnig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "244cbf87-3dab-4924-b2ce-2ec17f801f63",
                                "sense_id": "54c10cd5-3b21-3841-b92f-e37d9747d57a",
                                "text": "Het was een stralende zomerdag."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ee307e1-02e5-3870-ba8d-61e2121c39d5",
                        "entry_id": "884874d2-9538-3eba-8985-5e044acb02ae",
                        "glosses": [
                            "blij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ab6f51-bd41-4e12-af3f-cd98cd8f31cb",
                                "sense_id": "5ee307e1-02e5-3870-ba8d-61e2121c39d5",
                                "text": "Het stralende bruidje was het middelpunt van het feest."
                            },
                            {
                                "example_id": "f44c0847-13e7-4a7e-9ab0-2a9f09e6bc73",
                                "sense_id": "5ee307e1-02e5-3870-ba8d-61e2121c39d5",
                                "text": "‘Sinds de hotsprings heb ik je niet meer gezien.’ Met stralende ogen vertelde hij wat ik daar allemaal gemist had: een leuke groep meiden, een kampvuurtje en tot diep in de nacht in het warme water."
                            },
                            {
                                "example_id": "7b62a5ab-ffc2-4033-bc12-35efd8c11ecd",
                                "sense_id": "5ee307e1-02e5-3870-ba8d-61e2121c39d5",
                                "text": "Ze maakte 's ochtends schoon in het hotel in Kramfors, ging dan met de bus naar huis en deed de afwas in de lunchbarakken van de arbeiders bij de brugfundering en haastte zich daarna naar hem toe om het eten op tafel te zetten, alles in vliegende vaart en altijd met hetzelfde stralende humeur."
                            }
                        ]
                    }
