                        "sense_id": "28ea07d7-4311-3326-a89c-9ee5dd796104",
                        "entry_id": "5092b05d-bd7d-3410-b29d-161a763df115",
                        "glosses": [
                            "A product manufactured by Yamaha, particularly a motorcycle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59704d02-dca6-4ba1-92a8-e7a11fd55206",
                                "sense_id": "28ea07d7-4311-3326-a89c-9ee5dd796104",
                                "text": "Actually, if you can find an enduro in which non-street-legal machinery can compete, and the event isn't going to be an extremely difficult one, you can ride it on the Yamaha."
                            },
                            {
                                "example_id": "b89a4e1c-7c5f-446a-ba89-6ac00c07e6f8",
                                "sense_id": "28ea07d7-4311-3326-a89c-9ee5dd796104",
                                "text": "By the time we were finished, we had learned that these new Yamahas are a lot of things—but that slow and boring definitely are not two of them."
                            },
                            {
                                "example_id": "7dced9a6-66c5-43db-8dab-9cef0574bb48",
                                "sense_id": "28ea07d7-4311-3326-a89c-9ee5dd796104",
                                "text": "Astride my Yamaha I ride along the Savo road – on my way to the cinema to see the new Bond film, The Spy Who Loved Me."
                            }
                        ]
                    }
                ],
