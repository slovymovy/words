                "senses": [
                    {
                        "sense_id": "3ef40f66-df48-36d1-a63e-7f088de60bf5",
                        "entry_id": "eb054e82-febd-3f46-aafa-1469f43bd040",
                        "glosses": [
                            "meist historischer Gegenstand aus Holz, den jemand gefunden hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276aa745-56d1-4ad6-8db8-2d694aaa5cff",
                                "sense_id": "3ef40f66-df48-36d1-a63e-7f088de60bf5",
                                "text": "„Holzfunde aus der eisenzeitlichen Siedlung von Glastonbury und aus der Hügelfestung von Breiddin vermitteln einen anschaulichen Eindruck vom hohen Stand der Holzverarbeitung, der andernorts auch durch Funde spezialisierter Werkzeuge wie Äxte, Beile, Meißel und Hohleisen bestätigt wird.“"
                            },
                            {
                                "example_id": "6ae0bd39-f7f7-4820-8d8a-3fa0977f5313",
                                "sense_id": "3ef40f66-df48-36d1-a63e-7f088de60bf5",
                                "text": "„Um das Alter der Holzfunde zu eruieren, gab das Museum eine Radiokohlenstoffdatierung in Auftrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
