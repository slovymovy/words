                "senses": [
                    {
                        "sense_id": "05c2af14-33fc-3c10-8d25-091df5d45376",
                        "entry_id": "80fd6ed8-cc14-3751-a672-41a87201ddca",
                        "glosses": [
                            "Donner un caractère vacataire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ecf1028-bd06-4226-86b9-dde1870c0dd7",
                                "sense_id": "05c2af14-33fc-3c10-8d25-091df5d45376",
                                "text": "On voit l’irresponsabilité de l’État qui encourage le développement de secteurs nouveaux (Arts Plastiques, Théâtre, Musique, FLE…) sans donner les moyens en postes pour les faire fonctionner et qui du jour au lendemain dévalorise et menace les nouvelles formations, notamment l’ensemble des centres de Français Langue Étrangère du secteur public (à 90 % vacatarisé)."
                            },
                            {
                                "example_id": "f4162cd1-e26e-45d1-8105-c9bd3dc217ea",
                                "sense_id": "05c2af14-33fc-3c10-8d25-091df5d45376",
                                "text": "Les contractuels ont, tous, ou presque, été vacatarisés."
                            },
                            {
                                "example_id": "174c3108-fba1-4aef-89b0-a6944c630f53",
                                "sense_id": "05c2af14-33fc-3c10-8d25-091df5d45376",
                                "text": "Puisque, le Saes avait toujours et de tout temps, refusé que l'Université soit vacatarisée."
                            }
                        ]
                    }
