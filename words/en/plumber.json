{
    "word_family": [
        "plumbing",
        "plumb"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50d05570-1cbe-3712-b79e-58268fb39cb6",
                    "sense_definition": "A person who installs and repairs pipes and fixtures for water, gas, or drainage systems.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>plumber</w> fixed the leaking pipe under the kitchen sink.",
                            "target_lang_translations": {
                                "zh": "<w>水管工</w>修好了厨房水槽下漏水的管道。"
                            }
                        },
                        {
                            "text": "We called a professional <w>plumber</w> to install our new bathroom fixtures.",
                            "target_lang_translations": {
                                "zh": "我们请了一位专业的<w>水管工</w>来安装新的浴室设备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plumb#Verb"
                    ],
                    "common_phrases": [
                        "call a plumber",
                        "professional plumber"
                    ],
                    "target_lang_definitions": {
                        "zh": "从事安装和维修水管、煤气管道或排水系统装置的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "水管工",
                                "target_lang_sense_clarification": "指专门负责安装和修理管道设施的专业人员。"
                            },
                            {
                                "target_lang_word": "管道工",
                                "target_lang_sense_clarification": "指从事管道安装与维修工作的技术工人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "560b75bb-5f79-36af-8138-6ac3217f1b3c",
                    "sense_definition": "A person who investigates or stops the unauthorized leaking of confidential information.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administration hired a team of <w>plumbers</w> to find the source of the press leaks.",
                            "target_lang_translations": {
                                "zh": "政府雇佣了一队<w>泄密调查员</w>来寻找媒体泄密的源头。"
                            }
                        },
                        {
                            "text": "Political <w>plumbers</w> were tasked with silencing whistleblowers during the scandal.",
                            "target_lang_translations": {
                                "zh": "在丑闻期间，政治<w>泄密调查员</w>的任务是让举报人噤声。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Historical usage, specifically referring to the Nixon-era White House unit."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指负责调查或阻止机密信息泄露的人员（常用于政治语境）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泄密调查员",
                                "target_lang_sense_clarification": "指专门负责追查内部信息泄露源头的人员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "551de705-b994-3455-840a-02809f9cdaff",
                    "sense_definition": "A colloquial term for a urologist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was referred to a <w>plumber</w> to address his urinary tract issues.",
                            "target_lang_translations": {
                                "zh": "病人被转诊给一位<w>泌尿科医生</w>以处理他的尿路问题。"
                            }
                        },
                        {
                            "text": "Some surgeons jokingly refer to urologists as <w>plumbers</w> due to the nature of their work.",
                            "target_lang_translations": {
                                "zh": "一些外科医生因为泌尿科医生工作的性质，戏称他们为<w>管道工</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in medical contexts to refer to urologists."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对泌尿科医生的戏称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泌尿科医生",
                                "target_lang_sense_clarification": "指医学上的泌尿系统专科医生，此处为口语戏称。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2233b0b-72b7-3c92-b8f9-9a5adf45ebc1",
                    "sense_definition": "To perform the work of a plumber.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>plumber</w> for a living after finishing his apprenticeship.",
                            "target_lang_translations": {
                                "zh": "他在完成学徒期后决定以<w>做管道工</w>为生。"
                            }
                        },
                        {
                            "text": "They <w>plumbered</w> the entire house during the renovation project.",
                            "target_lang_translations": {
                                "zh": "他们在翻新工程中为整栋房子<w>安装了管道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plumb#Verb"
                    ],
                    "common_phrases": [
                        "plumber by day"
                    ],
                    "target_lang_definitions": {
                        "zh": "从事管道工的工作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "做管道工",
                                "target_lang_sense_clarification": "指以管道安装维修为职业。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abb987ee-6dd0-3f46-ba34-6d063a4b2557",
                    "sense_definition": "To install plumbing systems in a building.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor <w>plumbered</w> the new apartment complex with modern copper pipes.",
                            "target_lang_translations": {
                                "zh": "承包商为新的公寓大楼<w>安装了</w>现代化的铜管。"
                            }
                        },
                        {
                            "text": "It is expensive to <w>plumber</w> an old house that lacks proper drainage.",
                            "target_lang_translations": {
                                "zh": "为一栋缺乏适当排水系统的老房子<w>安装管道</w>非常昂贵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plumb#Verb"
                    ],
                    "common_phrases": [
                        "plumber the house"
                    ],
                    "target_lang_definitions": {
                        "zh": "为建筑物安装管道系统。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安装管道",
                                "target_lang_sense_clarification": "指在建筑工程中铺设水管或排水系统。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38691059-ac27-3591-8aab-12b1aa752664",
                    "sense_definition": "To ruin or botch a task or situation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I completely <w>plumbered</w> the presentation by forgetting my notes.",
                            "target_lang_translations": {
                                "zh": "我因为忘了带笔记，彻底<w>搞砸了</w>这次演讲。"
                            }
                        },
                        {
                            "text": "He <w>plumbered</w> the entire project by ignoring the instructions.",
                            "target_lang_translations": {
                                "zh": "他因为无视说明，把整个项目都<w>搞砸了</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Archaic or highly regional usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "搞砸或弄糟某项任务或局面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "搞砸",
                                "target_lang_sense_clarification": "指因失误而导致事情失败。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}