                "translations": [
                    {
                        "translation_id": "298a1a59-c5f6-425a-af72-1f3058e5ee87",
                        "source_entry_id": "eb90e785-5fbf-3432-803a-5f46640998e5",
                        "source_sense_id": "9304780f-dc0c-311f-a5f0-4a535cb88b51",
                        "source_sense_description": "allgemein: Schutz, Vorbeugung, Vorbeugungsmaßnahme",
                        "target_lang_word": "Schutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                        "entry_id": "685c5e11-e21b-3aa8-af9b-673b4f6d9169",
                                        "glosses": [
                                            "Ding, Handlung, Maßnahme, etwas, das die Sicherheit verbessern oder garantieren, vor Schaden bewahren soll"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fc0829-e1da-46a6-a0a5-182d6025e7da",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "Die Blauhelm-Soldaten boten der Bevölkerung den notwendigen Schutz."
                                            },
                                            {
                                                "example_id": "592451a6-2bc6-4344-b810-6512da6739bf",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "„Urspüngliche Aufgabe der Polizei war der Schutz der Gesellschaft vor Verkehrsunfällen und vor Verbrechen.“"
                                            },
                                            {
                                                "example_id": "adcc3d22-cbc7-46cb-8f70-1570dbb001ea",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "„Das Mainzer Unternehmen Biontech und der US-Pharmariese Pfizer geben an, dass ihr gemeinsam entwickelter Impfstoff einen mehr als 90-prozentigen Schutz vor Covid-19 bietet.“"
                                            },
                                            {
                                                "example_id": "5806d328-c1e9-4471-82c8-8326a832a6d7",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "Sie suchten in einer Berghütte Schutz vor dem drohenden Unwetter."
                                            },
                                            {
                                                "example_id": "7527932b-c675-4967-a910-ceb313850518",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "„Im Winter bietet Laub vielen Tieren Schutz vor Kälte und Frost: Igeln, aber auch Würmern, Spinnen, Asseln und Insekten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "549e5e41-6bf4-3cac-9e9f-0470e623609d",
                                        "entry_id": "685c5e11-e21b-3aa8-af9b-673b4f6d9169",
                                        "glosses": [
                                            "Bauteil, das einer Verbesserung der Sicherheit von etwas dient und Schäden daran/dadurch verhindern soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f7c08c2-93dc-4117-8263-f363b06ee047",
                                                "sense_id": "549e5e41-6bf4-3cac-9e9f-0470e623609d",
                                                "text": "Wir sollten auf der Terrasse einen Schutz anbringen. Ein Sonnensegel oder so was."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
