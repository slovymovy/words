                                        "glosses": [
                                            "(pouze plurál, resp. jako pomnožné, archaicky i singulár) zánět příušních slinných žláz; akutní infekční onemocnění způsobené virem Paramyxovirus parotitis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659c1bdb-8370-4643-92c7-b63d40b84241",
                                                "sense_id": "f5dc5d65-939e-3dfc-ae1c-d6160552c266",
                                                "text": "Jako malá měla Evička příušnice, ale průběh byl celkem hladký."
                                            },
                                            {
                                                "example_id": "db78bdde-2edd-430e-9ad8-5617fa43cb46",
                                                "sense_id": "f5dc5d65-939e-3dfc-ae1c-d6160552c266",
                                                "text": "Jako dítě prý prodělal příušnice, zarděnky, neštovice, spalničky, spálu, dokonce i pátou a šestou nemoc, ale vše nakonec bez následků přestál a dnes se, jak se zdá, těší pevnému zdraví."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b146c3f-1fcd-3bbb-b888-ca3cd24b987e",
                                        "entry_id": "e8f9ad8f-fb34-3307-9cc4-ccc434aa331e",
