    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d14f45b-e4d6-3654-8be3-0549742abd57",
                    "sense_definition": "bardziej lubić lub chcieć coś od czegoś innego",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "preferencja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ona <w>woli</w> gruszki od jabłek.",
                            "target_lang_translations": {
                                "ru": "Она <w>предпочитает</w> груши яблокам.",
                                "en": "She <w>prefers</w> pears to apples."
                            }
                        },
                        {
                            "text": "Zawsze <w>wolę</w> kawę niż herbatę o poranku.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>предпочитаю</w> кофе чаю по утрам.",
                                "en": "I always <w>prefer</w> coffee to tea in the morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "preferować"
                    ],
                    "common_phrases": [
                        "woleć kawę niż herbatę"
                    ],
                    "target_lang_definitions": {
                        "ru": "больше любить или хотеть что-то, чем что-то другое",
                        "en": "to like or want something more than something else"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предпочитать",
                                "target_lang_sense_clarification": "делать выбор в пользу чего-то"
                            },
                            {
                                "target_lang_word": "больше любить",
                                "target_lang_sense_clarification": "отдавать предпочтение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "prefer",
                                "target_lang_sense_clarification": "to like better"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91f9a6b5-4d2e-39c2-ab87-f34c4b79fb8a",
                    "sense_definition": "chcieć czegoś bardziej, zwłaszcza wyrażając życzenie w trybie przypuszczającym",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "preferencja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wolałbym</w> nie iść dziś do szkoły, bo źle się czuję.",
                            "target_lang_translations": {
                                "ru": "Я <w>предпочел бы</w> не идти сегодня в школу, потому что плохо себя чувствую.",
                                "en": "I <w>would rather</w> not go to school today because I feel unwell."
                            }
                        },
                        {
                            "text": "Czy <w>wolałabyś</w> zostać w domu, czy wyjść na spacer?",
                            "target_lang_translations": {
                                "ru": "Ты <w>предпочла бы</w> остаться дома или пойти на прогулку?",
                                "en": "Would you <w>prefer</w> to stay at home or go for a walk?"
                            }
                        }
                    ],
                    "synonyms": [
                        "chcieć"
                    ],
                    "common_phrases": [
                        "wolałbym nie"
                    ],
                    "target_lang_definitions": {
                        "ru": "хотеть чего-то больше, особенно при выражении желания в сослагательном наклонении",
                        "en": "to want something more, especially when expressing a wish in the conditional mood"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предпочитать",
                                "target_lang_sense_clarification": "в сослагательном наклонении (предпочел бы)"
                            },
                            {
                                "target_lang_word": "лучше бы",
                                "target_lang_sense_clarification": "выражение нежелания или альтернативного желания"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "would prefer",
                                "target_lang_sense_clarification": "to want something more in a conditional context"
                            },
                            {
                                "target_lang_word": "would rather",
                                "target_lang_sense_clarification": "to prefer to do something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}