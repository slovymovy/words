                        "glosses": [
                            "to talk, to have a talk, to speak (to, with)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5ad335-d138-46b1-8d60-854b443e35da",
                                "sense_id": "158a12a3-d17c-3c66-bc9a-af883bcfe5d6",
                                "text": "переговори́ть по телефо́ну",
                                "translation": "to talk on/by the telephone",
                                "english": "to talk on/by the telephone"
                            },
                            {
                                "example_id": "ea8db679-57e5-4b70-bb03-59ac60575400",
                                "sense_id": "158a12a3-d17c-3c66-bc9a-af883bcfe5d6",
                                "text": "я переговорю́ с ним об э́том",
                                "translation": "I'll speak to him about it",
                                "english": "I'll speak to him about it"
                            }
                        ]
                    },
                    {
                        "sense_id": "92ff22f0-82ba-3912-bc37-013308b51bb7",
                        "entry_id": "ee0ce0da-a425-3904-9803-4bd6c3c03961",
                        "glosses": [
                            "to discuss, to cover"
                        ],
