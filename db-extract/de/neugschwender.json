                ],
                "senses": [
                    {
                        "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                        "entry_id": "3503240f-7495-3f59-82e8-2b9797ef80f2",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a347a7-9052-4a9e-a2be-9052937bc0ad",
                                "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                                "text": "Frau Neugschwender ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "03830507-182d-44b1-afc8-cda8b62b7947",
                                "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                                "text": "Herr Neugschwender wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aceeac2b-5c4b-4af1-b8d4-1afbc03cdec1",
                                "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                                "text": "Die Neugschwenders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fb75f2e2-e368-4eaf-8854-7ccaf5421e75",
                                "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                                "text": "Der Neugschwender trägt nie die Schals, die die Neugschwender ihm strickt."
                            },
                            {
                                "example_id": "1d7643f2-1a57-43e5-81c8-7183ed29e09f",
                                "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neugschwender kommt, geht der Herr Neugschwender.“"
                            },
                            {
                                "example_id": "85742846-7116-4aed-9b5e-df23c55e1fd2",
                                "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                                "text": "Neugschwender kommt und geht."
                            },
                            {
                                "example_id": "90ecbbe2-2260-4906-8167-295d08b06aac",
                                "sense_id": "1e157740-5220-3159-803f-7edab3d13a4b",
                                "text": "Neugschwenders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
