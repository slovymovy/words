                        "glosses": [
                            "Wörterbuch im Internet, an dem sich Interessierte beteiligen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c10dc2-37b3-46fd-9c44-b7768cd3a724",
                                "sense_id": "dba483b9-9e55-314e-a657-fcae5e2535a5",
                                "text": "„Das belegt nicht zuletzt ein weiteres Projekt des ILR, das interaktive Mitmachwörterbuch, das die Sprachabteilung seit einigen Jahren im Internet zur Dokumentation der rheinischen Umgangssprache betreibt.“"
                            },
                            {
                                "example_id": "7822a947-5df3-4de5-bf96-a17dbc7d6d7f",
                                "sense_id": "dba483b9-9e55-314e-a657-fcae5e2535a5",
                                "text": "„Das Mitmachwörterbuch Wittgensteiner Platt strebt die spontane Sammlung des Wittgensteiner Sprachschatzes (Wittgensteiner Platt) an.“"
                            }
                        ],
