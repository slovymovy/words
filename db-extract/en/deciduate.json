                "senses": [
                    {
                        "sense_id": "85e86b26-9ff7-3e85-8621-2da69ac40855",
                        "entry_id": "3ee9efdf-7d67-3f81-b01f-7f8bac5716f6",
                        "glosses": [
                            "An animal that sheds a decidua."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a8d0cd5-46cd-4848-97ff-8732bfc12eb1",
                                "sense_id": "85e86b26-9ff7-3e85-8621-2da69ac40855",
                                "text": "In the non-deciduates this relation is one of simple contact; but this same relation has been likewise observed in mammiferous deciduates, whether they have the zonarial or the discoidal form of placenta."
                            },
                            {
                                "example_id": "f66e1d9d-41a3-4f0f-9be2-021f6ae41046",
                                "sense_id": "85e86b26-9ff7-3e85-8621-2da69ac40855",
                                "text": "Still more characteristic of the deciduates is the peculiar and very intimate connection between the chorion frondosum and the corresponding part of the mucous coat of the womb, which we must regard as a real coalescence of the two."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
