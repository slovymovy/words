        "fr-extract.jsonl": [
            {
                "entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                "word": "idéologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c26ba70d-0b4f-4ec6-bc1b-eb3575800a42",
                        "entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "tags": [
                            "plural"
                        ],
                        "form": "idéologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8537447-11ca-3f1c-ae97-9901e76307f0",
                        "entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "glosses": [
                            "Science des idées ; étude de l’origine, de la formation et de la propagation des idées."
                        ],
                        "tags": [
                            "Sens original",
                            "aujourd'hui rare"
                        ],
                        "examples": [
                            {
                                "example_id": "99e4dcfa-8048-452c-b42b-2a4919d7a4c3",
                                "sense_id": "b8537447-11ca-3f1c-ae97-9901e76307f0",
                                "text": "Traité d’idéologie."
                            }
                        ]
                    },
                    {
                        "sense_id": "88e23877-ace1-397f-b31d-4c0c38820ae2",
                        "entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "glosses": [
                            "Ensemble de dogmes ou doctrines dans un ou plusieurs domaines (société, politique, économie, morale, spiritualité ou religion…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bedd7e52-b023-464d-9201-02806f46cd70",
                                "sense_id": "88e23877-ace1-397f-b31d-4c0c38820ae2",
                                "text": "C'est à l’idéologie, à cette ténébreuse métaphysique qui, en recherchant avec subtilité les causes premières , veut sur ses bases fonder la législation des peuples, au lieu d'approprier les lois à la connaissance du cœur humain et aux leçons de l'histoire, qu'il faut attribuer tous les malheurs qu'a éprouvés notre belle France."
                            },
                            {
                                "example_id": "71a47bd2-cc7f-44c6-8629-604c4cc7099d",
                                "sense_id": "88e23877-ace1-397f-b31d-4c0c38820ae2",
                                "text": "Protégées par le prestige des guerres de la Liberté, les institutions nouvelles étaient devenues intangibles et l’idéologie qui fut construite pour les expliquer devint comme une foi qui sembla longtemps avoir pour les Français la valeur que la révélation de Jésus a pour les catholiques."
                            },
                            {
                                "example_id": "82765a6d-33bf-495e-8183-ecaf76758fa2",
                                "sense_id": "88e23877-ace1-397f-b31d-4c0c38820ae2",
                                "text": "Il est arrivé qu’une révolution, faite par des millions de pauvres gens dans un esprit égalitaire, avec une idéologie socialiste, ayant remporté une victoire complète, s’est trouvée confisquée par les parvenus qu’elle avait installés dans tous les rouages de l’État, et d’abord dans ceux du parti révolutionnaire."
                            },
                            {
                                "example_id": "ab2f4c3c-1b1e-4fdf-9d73-a0b5318b6554",
                                "sense_id": "88e23877-ace1-397f-b31d-4c0c38820ae2",
                                "text": "Tout à la fois thriller haletant et chronique d’une Amérique en crise, le dernier roman de Douglas Kennedy nous plonge dans les réalités socio-économiques d’un pays où les idéologies extrêmes s’affrontent violemment."
                            },
                            {
                                "example_id": "240c75d2-2241-4b61-9bc2-867befff7310",
                                "sense_id": "88e23877-ace1-397f-b31d-4c0c38820ae2",
                                "text": "Si dans le passé l’idéologie soviétique opposait l’U.R.S.S. aux nations capitalistes, Staline substitue désormais les solidarités anti-hitlériennes aux solidarités de classe."
                            },
                            {
                                "example_id": "0aef5177-3c98-4d9f-9e8d-547dd6622fcd",
                                "sense_id": "88e23877-ace1-397f-b31d-4c0c38820ae2",
                                "text": "Le cas de la société tibétaine d’avant 1950 illustre de façon tragique les lacunes d’une idéologie dogmatique bouddhiste gérée par de faillibles humains. Elle a conduit à une société féodale esclavagiste basée sur l’oppression de presque toute la population par les hiérarchies religieuse et aristocratique."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3589cfc-9c08-3627-84a1-7a88094d3efc",
                        "entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "glosses": [
                            "Appareil de propagande politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9be8bff-09b5-46e6-a9cf-f5fedf4502cd",
                                "sense_id": "d3589cfc-9c08-3627-84a1-7a88094d3efc",
                                "text": "L’idéologie officielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b30eea6-982f-3ed8-993b-38908bf31d07",
                        "entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "glosses": [
                            "Théorie sur quelque chose que l'on veut mettre en valeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4948c5-de3e-4ce8-b434-ef170b5f45cf",
                                "sense_id": "0b30eea6-982f-3ed8-993b-38908bf31d07",
                                "text": "Car le Marché commun représente pour le Français moyen, niveau de vie, autos, frigos, idéologie de consommation."
                            }
                        ]
                    },
                    {
                        "sense_id": "72a7002d-866c-36b5-8ce2-86a37697818e",
                        "entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "glosses": [
                            "Développement ou discussions sur des idées abstraites."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "60561ef3-fb55-4e81-ae26-877370138fad",
                                "sense_id": "72a7002d-866c-36b5-8ce2-86a37697818e",
                                "text": "Ce dévoiement, c’est celui du patriotisme allemand, révolutionnaire et antidynastique dans son principe, au profit de l’Ancien Régime allemand et européen et de sa « restauration » par le biais de l’idéologie médiévisante du romantisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56031bb8-6335-4cfb-87c9-4b4ac5f2ea50",
                        "source_entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "target_lang_word": "Ideologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ideologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cfe8040-9c64-3f0b-a339-2d6becb1cea4",
                                        "entry_id": "d2584803-1ced-388b-b66a-8086f6f6654d",
                                        "glosses": [
                                            "eine Anschauung, oft auch Weltanschauung, eine bestimmte Meinung, ein Ergebnis eines Diskurses, eine Idee; eine Denkweise über Mensch und Gesellschaft, die zu bestimmten Zielen, Ergebnissen führen und diese unterstützen soll, eine politische und soziale Theorie, ein System von Anschauungen, Begriffen und anderen ideellen Komponenten, welches einen gesellschaftlichen Standpunkt darstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4526912-2c2b-495d-9e57-1cec4f532cac",
                                                "sense_id": "3cfe8040-9c64-3f0b-a339-2d6becb1cea4",
                                                "text": "„Sie besorgte diese Aufgabe aber auch – ganz unmittelbar – als wissenschaftlich drapierte Ideologie, indem sie zum Beispiel gesellschaftliche Probleme individualisierte oder objektive Ursachen von Problemen in solche angeblich psychischer Natur umdeutete.“ (Internet-Beleg)"
                                            },
                                            {
                                                "example_id": "478dff0f-509a-4c8b-b6ba-29fe06a6523f",
                                                "sense_id": "3cfe8040-9c64-3f0b-a339-2d6becb1cea4",
                                                "text": "Dass man heute Religion mit Ideologie verwechselt, verdanken wir Karl Marx, der in der Ideologie einen Überbegriff für Metaphysik, Moral und Religion sah."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89151683-a8c0-36a8-b960-bfa0d0dc6c27",
                                        "entry_id": "d2584803-1ced-388b-b66a-8086f6f6654d",
                                        "glosses": [
                                            "ein (häufig) erstarrter, dogmatischer Diskurs, eine in dieser Art aufzufassende Meinung; eine Meinung, die mit der Absicht vertreten wird, andere oder sich selbst zu täuschen"
                                        ],
                                        "tags": [
                                            "negativ besetzt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60d8b1b-e2c6-4c7f-a7dc-a6267430577e",
                                                "sense_id": "89151683-a8c0-36a8-b960-bfa0d0dc6c27",
                                                "text": "Sie goss kübelweise ihre Ideologie aus „weiblicher Inklusion statt männlicher Exklusion“ und „Wenn nur erst die Frauen an die Macht kämen, würde die Welt bald friedlich“ über ihre mehr oder weniger verzückten Zuhörer und schreckte nicht einmal davor zurück, zur „Beglaubigung“ Indira Gandhi und Gold Meir anzuführen."
                                            },
                                            {
                                                "example_id": "91f12853-c600-4e05-b668-8204bc29ca7d",
                                                "sense_id": "89151683-a8c0-36a8-b960-bfa0d0dc6c27",
                                                "text": "„Die kommunistische Ideologie versprach den Menschen Großartiges.“"
                                            },
                                            {
                                                "example_id": "e647ee8d-248a-43dc-a045-0aad920337e6",
                                                "sense_id": "89151683-a8c0-36a8-b960-bfa0d0dc6c27",
                                                "text": "„Das wahre Ziel liegt darin, die unbewusste Gramatik ins Bewusstsein zu laden, damit jeder ständig die Idee der Ideologie repetiert.“"
                                            },
                                            {
                                                "example_id": "8168901d-8d72-4199-8a61-954c92e44724",
                                                "sense_id": "89151683-a8c0-36a8-b960-bfa0d0dc6c27",
                                                "text": "„Mühsam war kein bequemer Mann, nicht für die Sozialdemokraten und auch nicht für die Kommunisten, weil er Ideologien nicht als säkularisierte Heilslehren hinnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74f69fe1-f2c1-4f09-a9b7-a33b106853ed",
                        "source_entry_id": "679aaace-aebd-37f2-bc83-f9ac11c21ff2",
                        "target_lang_word": "ideology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ideology",
