            },
            {
                "entry_id": "fa869e2e-daf0-3536-8720-972d8d567ed9",
                "word": "intercesseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a5d8779-913f-4d02-b6d5-4d36adfa142e",
                        "entry_id": "fa869e2e-daf0-3536-8720-972d8d567ed9",
