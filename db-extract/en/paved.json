                    },
                    {
                        "sense_id": "35259be5-3845-3c75-aa11-5bf95d326b53",
                        "entry_id": "ec3f8ed9-3df0-365b-a8f3-eb17017f4cd0",
                        "glosses": [
                            "Laid out or made, as intentions, desires, plans, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "915b1d8c-d8fc-407b-adb9-5305ef9f342f",
                                "sense_id": "35259be5-3845-3c75-aa11-5bf95d326b53",
                                "text": "The road to Hell is paved with good intentions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8bd4cb5-60ea-4274-bd71-bccc0ec46c1b",
                        "source_entry_id": "ec3f8ed9-3df0-365b-a8f3-eb17017f4cd0",
                        "source_sense_description": "covered in pavement",
                        "target_lang_word": "asphaltiert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphaltiert",
                                "target_lang_code": "de",
