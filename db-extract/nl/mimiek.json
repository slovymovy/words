                "translations": [
                    {
                        "translation_id": "5819589c-1d85-4be4-858d-fc3137efe751",
                        "source_entry_id": "c6f6b4bc-18d9-3e4e-adb1-147ce5b579cb",
                        "source_sense_id": "824cef78-e5c5-3fd9-824c-08bcc355ba61",
                        "source_sense_description": "gezichtsuitdrukking",
                        "target_lang_word": "Mimik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mimik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e065f00a-b7b2-3c18-8afc-214a051e7ea6",
                                        "entry_id": "f8446fee-f0f9-3b0a-8790-21c8ddcedd10",
                                        "glosses": [
                                            "Gesamtheit der möglichen Gesichtsausdrücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2cd404-6757-4b32-bc44-fad768546f49",
                                                "sense_id": "e065f00a-b7b2-3c18-8afc-214a051e7ea6",
                                                "text": "„Gestik und Mimik werden in der mündlichen Kommunikation als unterstützende Medien ausgenutzt und die gemeinsame Situation erlaubt in vielen Fällen die Verwendung deiktischer Pronomina anstatt expliziter Benennungen für die Identifizierung von und Bezugnahme auf Gegenstände.“"
                                            },
                                            {
                                                "example_id": "6944e3d0-42f5-4504-b5a3-31ef19dccfa6",
                                                "sense_id": "e065f00a-b7b2-3c18-8afc-214a051e7ea6",
                                                "text": "„Aber danach hatte sie der Frau direkt ins Gesicht und in ihre Gedanken geschaut, geübt darin, die Mimik und Gestik zu lesen, keine Bestürzung wahrgenommen oder überhaupt etwas anderes als diese normale Hausfrauenmilde.“"
                                            },
                                            {
                                                "example_id": "71863e37-4091-4ee3-9578-8d469352a49f",
                                                "sense_id": "e065f00a-b7b2-3c18-8afc-214a051e7ea6",
                                                "text": "„Rosa habe die schönste und scheueste Mimik aller Hörenden gehabt, erzählte mir eine alte Lehrerin aus ihrer Schule.“"
                                            },
                                            {
                                                "example_id": "d10524b0-61bf-4509-8d14-8d018c1375ca",
                                                "sense_id": "e065f00a-b7b2-3c18-8afc-214a051e7ea6",
                                                "text": "„Offenbar war sie nicht imstande, ihre Mimik unter Kontrolle zu halten.“."
                                            },
                                            {
                                                "example_id": "fd6a3aa5-fad1-4c96-90b9-f47e3a5981a4",
                                                "sense_id": "e065f00a-b7b2-3c18-8afc-214a051e7ea6",
                                                "text": "Die Mimik ist eine Form der nonverbalen Kommunikation."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33db3bce-bf7c-4d08-a074-fbf11755a75f",
                        "source_entry_id": "c6f6b4bc-18d9-3e4e-adb1-147ce5b579cb",
                        "source_sense_id": "824cef78-e5c5-3fd9-824c-08bcc355ba61",
                        "source_sense_description": "gezichtsuitdrukking",
                        "target_lang_word": "Pantomime",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pantomime",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                        "entry_id": "07c6ae4f-151a-317d-aa0d-24d50d9759b4",
                                        "glosses": [
                                            "Gebärdenspiel, Schauspiel ohne Stimme, Szene nur mit Gebärden, Mienenspiel und Tanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "040a819a-f226-479a-aeda-cbecc923963a",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "Um die Pantomime verstehen zu können, braucht man keiner Sprache mächtig zu sein."
                                            },
                                            {
                                                "example_id": "f2b7e295-33ed-46d9-ad48-fb88b2164753",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "„Petitjacques wiederholte seine Pantomime mit dem Klebestreifen.“"
                                            },
                                            {
                                                "example_id": "40197e66-f9de-4d7d-98bd-a3c12266b1c1",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "„Sie führten eine lustige Pantomime auf und zeigten Kalabreser Tänze.“"
                                            },
                                            {
                                                "example_id": "3c558389-098f-47e1-a72e-4abee06cbd18",
                                                "sense_id": "b2ed1afa-dc1d-3433-9134-61d22272dc04",
                                                "text": "„Ich machte aus dieser Beobachtung eine Pantomime, bei der ich nur mit Händen und Füßen arbeite, mein Gesicht unbewegt und schneeweiß immer in der Mitte bleibt, und es gelingt mir, mit meinen vier Extremitäten den Eindruck einer ungeheuren Quantität von überstürzter Bewegung zu erwecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pantomime",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a367540-8746-32bf-bdee-4b19d87ba77c",
                                        "entry_id": "61c25865-a413-3922-8846-c5e5026fe729",
                                        "glosses": [
                                            "Darsteller des Gebärdenspiels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b438176e-0402-4ff3-a0c9-6e0eeedb0cf1",
                                                "sense_id": "8a367540-8746-32bf-bdee-4b19d87ba77c",
                                                "text": "Der Pantomime überzeugte durch seine Kunst."
                                            },
                                            {
                                                "example_id": "897ceb68-7759-4b62-a5a5-94c33bfbdc8a",
                                                "sense_id": "8a367540-8746-32bf-bdee-4b19d87ba77c",
                                                "text": "„In der Dämmerung drängt sich das ganze Volk zu den Opern, den Komödien, den Pantomimen und den Seiltänzern; alle Darsteller müssen entweder richtige Männer oder Kastraten sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32f69c96-1061-4e7a-abd3-b30e6c090547",
                        "source_entry_id": "c6f6b4bc-18d9-3e4e-adb1-147ce5b579cb",
