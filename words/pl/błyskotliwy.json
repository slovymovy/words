                    "sense_id": "8cfa706a-8cb0-3cf2-a68b-e33819df8727",
                    "sense_definition": "odznaczający się bystrym umysłem, inteligencją lub dowcipem; świadczący o takich cechach",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intelekt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody naukowiec przedstawił <w>błyskotliwy</w> pomysł na rozwiązanie skomplikowanego problemu.",
                            "target_lang_translations": {
                                "en": "The young scientist presented a <w>brilliant</w> idea for solving the complex problem.",
                                "ru": "Молодой учёный предложил <w>блестящую</w> идею для решения сложной проблемы."
                            }
                        },
                        {
                            "text": "Jej <w>błyskotliwa</w> riposta natychmiast rozbawiła wszystkich zgromadzonych gości.",
                            "target_lang_translations": {
                                "en": "Her <w>witty</w> retort immediately amused all the gathered guests.",
                                "ru": "Её <w>остроумная</w> реплика тут же развеселила всех собравшихся гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "błyskotny",
                        "dowcipny",
                        "efektowny",
                        "inteligentny",
                        "lotny"
                    ],
                    "common_phrases": [
                        "błyskotliwa kariera",
                        "błyskotliwa riposta",
                        "błyskotliwy umysł"
