                ],
                "translations": [
                    {
                        "translation_id": "ffc3de72-e744-41b1-b430-6abf3d57109b",
                        "source_entry_id": "71fbd10e-a14c-3e6d-ab9c-d76f85c57399",
                        "source_sense_id": "50d77215-e0de-3382-a769-4ddbc207269a",
                        "target_lang_word": "baisser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baisser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7dfdf7e-ac59-3aa8-ad96-3c4d473457e3",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Faire descendre, mettre plus bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecd563ed-c651-4dca-b8c1-b30e274c7473",
                                                "sense_id": "e7dfdf7e-ac59-3aa8-ad96-3c4d473457e3",
                                                "text": "Je baissai la vitre et roulai en écoutant les sons étouffés d’une fin de soirée d'été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "817fd0e6-40b5-3c8f-be57-5e4633422783",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Incliner vers le sol."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5968e22d-13eb-4c25-aa57-8c75e054c28d",
                                                "sense_id": "817fd0e6-40b5-3c8f-be57-5e4633422783",
                                                "text": "La fillette baissa d’abord la tête puis la releva craintivement et nous regarda."
                                            },
                                            {
                                                "example_id": "d0060d21-fc8d-4bce-b205-a2f6e8edb357",
                                                "sense_id": "817fd0e6-40b5-3c8f-be57-5e4633422783",
                                                "text": "Aussitôt l’intrus recula, baissa les yeux et, relevant les pans de sa pèlerine, affecta de se chauffer."
                                            },
                                            {
                                                "example_id": "4f24c366-d7d0-435f-9579-275c66ab6777",
                                                "sense_id": "817fd0e6-40b5-3c8f-be57-5e4633422783",
                                                "text": "A l’époque du procès, cette femme pouvait avoir cinquante ans ; […]; sa voix était mielleuse, elle baissait la vue comme une vierge; en un mot, c’était une pateline dont l’aspect édifiant aurait suffi pour faire sortir un saint du purgatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158154a5-1a82-3219-86e9-a611ce2bed2b",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Amoindrir un son."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c408bbb-3860-4114-88f4-8101196b5b1d",
                                                "sense_id": "158154a5-1a82-3219-86e9-a611ce2bed2b",
                                                "text": "Baisser la voix. — Baisser un instrument de musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b8baebe-1cd1-3909-a6c3-d7b0296ab62b",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Diminuer la valeur vénale d’une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbb97cf-64e6-413f-b1d5-bb8985fae561",
                                                "sense_id": "7b8baebe-1cd1-3909-a6c3-d7b0296ab62b",
                                                "text": "Baisser le prix d’une marchandise,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "190749b7-ee04-3d29-acf0-d84226ddd718",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Diminuer de hauteur, rendre plus bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6fd565-f769-4ed7-858a-3820c92be01a",
                                                "sense_id": "190749b7-ee04-3d29-acf0-d84226ddd718",
                                                "text": "Baisser une muraille, un toit, une maison."
                                            },
                                            {
                                                "example_id": "06c61562-8714-439d-b533-39ffd2e26041",
                                                "sense_id": "190749b7-ee04-3d29-acf0-d84226ddd718",
                                                "text": "— Au cours de l'année 1915, le blé, après avoir été pendant les premiers mois à 11 fr. 50 et 12 fr. 50 le moud d'environ 21 kilos, baissait graduellement jusqu'à 8 fr. 10 et même 7 fr. 30 en juillet et en août."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a17c5f7b-b0c0-3597-854c-aae2c3edca23",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Descendre (une rivière, un fleuve)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23d1ad6-1548-4f96-9bf1-051665491cc1",
                                                "sense_id": "a17c5f7b-b0c0-3597-854c-aae2c3edca23",
                                                "text": "Nous nous embarquâmes, ma cousine et moi avec la fille de chambre, dans un petit bateau pour baisser la Loire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aa36fd6-595f-3e87-950f-9b0d06fcc1dd",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Aller en diminuant de hauteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a6247d-22b4-408a-857c-aa81454cd054",
                                                "sense_id": "0aa36fd6-595f-3e87-950f-9b0d06fcc1dd",
                                                "text": "Le baromètre a baissé terriblement pendant la nuit et la matinée. Je m’attends à du gros temps."
                                            },
                                            {
                                                "example_id": "6d527a3a-3dfa-4e9d-9bc5-a89331359da9",
                                                "sense_id": "0aa36fd6-595f-3e87-950f-9b0d06fcc1dd",
                                                "text": "La rivière a baissé d’un pied."
                                            },
                                            {
                                                "example_id": "65d4aac7-6e29-436e-90a2-e3bac85178f8",
                                                "sense_id": "0aa36fd6-595f-3e87-950f-9b0d06fcc1dd",
                                                "text": "La mer hausse et baisse deux fois le jour, par l’action du flux et du reflux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "Diminuer en intensité, en force."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799f5666-eed7-49cc-9153-062ca209ed12",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Le jour baisse, le jour diminue, la nuit commence à venir."
                                            },
                                            {
                                                "example_id": "3ba8b4aa-2c4e-4203-b665-ffe52321a9ee",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Ce vieillard baisse, il s’affaiblit tous les jours."
                                            },
                                            {
                                                "example_id": "6ac01217-2248-4ef0-a220-4c012e11548b",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Ce malade baisse, son état empire."
                                            },
                                            {
                                                "example_id": "1c6b968b-6761-4bec-9659-2d62446070e7",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Sa vue commence à baisser, sa vue commence à n’être plus aussi bonne."
                                            },
                                            {
                                                "example_id": "985921e4-a64a-4218-870a-6ecd0cfddcdf",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Son génie, son talent, son esprit baisse, il diminue, il s’affaiblit."
                                            },
                                            {
                                                "example_id": "99ef3137-7df2-47d2-8f15-7e4d81163ec7",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Ce vin baisse, il perd de sa force, de son bouquet."
                                            },
                                            {
                                                "example_id": "ea17c738-9fdb-4ea1-bbc0-d7021e5e59c8",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Cette place de commerce baisse, elle perd de son commerce, de son crédit."
                                            },
                                            {
                                                "example_id": "043ce377-05c5-45c5-bf13-9442d79aba13",
                                                "sense_id": "909b70f7-b47c-3aa3-9c60-d68900944024",
                                                "text": "Cette marchandise baisse ; les actions, les rentes baissent ; les fonds publics baissent, le change baisse ; ils tombent, ils diminuent de prix, de valeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46f5c2e-5266-39b1-85e1-345104765da9",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0025cf86-cd68-4516-93e1-1cc5416bf9f5",
                                                "sense_id": "f46f5c2e-5266-39b1-85e1-345104765da9",
                                                "text": "Les actions de cet homme baissent, Sa puissance, son crédit, sa réputation diminuent."
                                            },
                                            {
                                                "example_id": "2b2a373f-f9d7-4cbf-9c6f-70955dfb8c18",
                                                "sense_id": "f46f5c2e-5266-39b1-85e1-345104765da9",
                                                "text": "Son crédit, sa faveur baisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b785121-0062-377a-99ca-10cb612ac4f1",
                                        "entry_id": "345c19f8-13d6-32c6-a84f-07dade9403fd",
                                        "glosses": [
                                            "S’abaisser, se courber, se faire petit."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b17f604-9c6a-40cb-b718-6eaadb0a4401",
                                                "sense_id": "5b785121-0062-377a-99ca-10cb612ac4f1",
                                                "text": "Je me baissai pour ramasser le portefeuille et les cartes de visite qui s’étaient envolées dans le ruisseau."
                                            },
                                            {
                                                "example_id": "fcf7bf71-2bb6-44e3-be7b-ca5176f5d2b3",
                                                "sense_id": "5b785121-0062-377a-99ca-10cb612ac4f1",
                                                "text": "Il faut se baisser, se baisser bien bas pour entrer dans cette grotte."
                                            },
                                            {
                                                "example_id": "9e6ac88d-7cd5-4b3c-8513-5c2b7a8c8782",
                                                "sense_id": "5b785121-0062-377a-99ca-10cb612ac4f1",
                                                "text": "Baissez-vous davantage."
                                            },
                                            {
                                                "example_id": "dd8a18ce-b356-4378-b9a4-95483d601678",
                                                "sense_id": "5b785121-0062-377a-99ca-10cb612ac4f1",
                                                "text": "C’est un homme qui ne se hausse ni ne se baisse, il ne s’émeut de rien, il est toujours égal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baisser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "030f187a-15a1-3adb-9267-9fabe82d37a0",
                                        "entry_id": "5c9e66a2-b277-31da-b38b-4a265efa21e5",
                                        "glosses": [
                                            "Action de baisser (généralement un rideau)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11386dd6-f702-4d79-a47d-e554336209ee",
                                                "sense_id": "030f187a-15a1-3adb-9267-9fabe82d37a0",
                                                "text": "Baisser de rideau général jeudi pour les commerçants bressauds"
                                            }
                                        ]
                                    }
                                ]
                            }
