                    {
                        "form_id": "0225cc80-91e7-492a-89a8-18d1a6c40499",
                        "entry_id": "dc6f045f-06af-3ed0-b647-85bb53faa4b7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Cineasten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1829d40-0b46-3fe6-ac67-24ad67389f9c",
                        "entry_id": "dc6f045f-06af-3ed0-b647-85bb53faa4b7",
                        "glosses": [
                            "Verehrer der Filmkunst und ausgewiesener Kenner der Filmgeschichte sowie der künstlerischen Qualitäten des Kinos mit Interesse an einem Filmdiskurs, der über den reinen Unterhaltungswert des Films hinausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894e95a9-0d7b-430e-877a-389b6e5b34ac",
                                "sense_id": "d1829d40-0b46-3fe6-ac67-24ad67389f9c",
                                "text": "Spätestens seit seinem außergewöhnlichen Werk \"Trainspotting\" hat er [Danny Boyle] bei vielen Cineasten Kultstatus."
                            },
                            {
                                "example_id": "b4ae7d29-01ee-4965-9499-5f91b29a5688",
                                "sense_id": "d1829d40-0b46-3fe6-ac67-24ad67389f9c",
                                "text": "„Teilweise Ausfälle des gesamten Ticketsystems haben am Samstag zu stundenlangen Wartezeiten und erbosten Cineasten geführt, am Sonntag konnten die Probleme dann behoben werden.“"
                            },
                            {
                                "example_id": "a132b9eb-3c5c-43ba-9aa7-5765965c1640",
                                "sense_id": "d1829d40-0b46-3fe6-ac67-24ad67389f9c",
                                "text": "„Natürlich schleppt mich dieser bekloppte Cineast in die Originalfassung, kantonesisch mit englischen Untertiteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97d9f5c5-2106-3fab-8a00-6c6dec0eaaa4",
                        "entry_id": "dc6f045f-06af-3ed0-b647-85bb53faa4b7",
                        "glosses": [
                            "Filmemacher des künstlerischen Kinos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "933fa93b-8981-4fa8-ac7f-908dd0436dad",
                                "sense_id": "97d9f5c5-2106-3fab-8a00-6c6dec0eaaa4",
                                "text": "„Da viele selbsternannte Cineasten eigene Filmclubs gründeten und später selbst Regisseure wurden, kann man den Begriff Cineast sowohl für einen Filmkunst-Fan, als auch für einen Regisseur gebrauchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b825ce09-5580-38ae-affc-aff2c43c68d1",
                        "entry_id": "dc6f045f-06af-3ed0-b647-85bb53faa4b7",
                        "glosses": [
                            "jemand, der sich auskennt und auch als Filmkritiker tätig sein kann, zum Beispiel ein Aktiver in Filmclubs und Kinematheken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09638acf-0636-45fe-beb9-c9e7814a614f",
                                "sense_id": "b825ce09-5580-38ae-affc-aff2c43c68d1",
                                "text": "„Jetzt ist eine schöne Ausgabe erschienen, mustergültig ediert, mit wunderbaren Vorworten von François Truffaut und Tom Tykwer, der beschreibt, wie er mit Bazin vom Fan zum Cineasten wurde. Bazins Texte schürfen im Grundsätzlichen, es sind zeitlose Plädoyers für eine offene Sichtweise; man kann sie aber auch wie einen Steinbruch benutzen: absolute Klarheit, stupende Gegenwart.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
