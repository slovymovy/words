                ],
                "senses": [
                    {
                        "sense_id": "b1fd4636-4722-395e-8adb-e79b61347e7d",
                        "entry_id": "14f6a6c7-ce3e-3fea-87ce-07cbe9c60ee8",
                        "glosses": [
                            "allgemein: im Vergleich zu anderen weniger bedeutsamer Anteil, Aspekt, Bestandteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698ba5a6-a16f-4563-b7f6-922e39ac056a",
                                "sense_id": "b1fd4636-4722-395e-8adb-e79b61347e7d",
                                "text": "„Aus Süßspeisen, die einst einen Nebenakzent der Herrenküchen bildeten, wurden fortan die raffiniertesten Kreationen geschaffen.“"
                            },
                            {
                                "example_id": "79a76c3e-476d-445d-8e8c-6d61c16e00f4",
                                "sense_id": "b1fd4636-4722-395e-8adb-e79b61347e7d",
                                "text": "„Es fehlt der Rauch und auch das “einen idyllischen Nebenakzent setzende 'kleine' Haus” (361).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6d7ed1b6-a80d-3535-ba38-d5d059a268d0",
                        "entry_id": "14f6a6c7-ce3e-3fea-87ce-07cbe9c60ee8",
                        "glosses": [
                            "im Vergleich zum Hauptakzent schwächere Betonung einer Silbe in einem komplexen Wort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0513f0e4-92d7-459c-85ff-13e2ec5403db",
                                "sense_id": "6d7ed1b6-a80d-3535-ba38-d5d059a268d0",
                                "text": "„Allerdings können rhythmische Gründe solche Umwandlungen von ehemaligem Hauptakzent in Nebenakzent verhindern.“"
                            },
                            {
                                "example_id": "812999a9-0e0b-4708-a35b-feee816230fe",
                                "sense_id": "6d7ed1b6-a80d-3535-ba38-d5d059a268d0",
                                "text": "In einem Wort wie „Behinderungen“ trägt das „i“ den Hauptton, das „u“ den Nebenton."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
