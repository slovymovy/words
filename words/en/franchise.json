    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0aaa6ed3-15a8-3e0c-8dc6-871d3c36f450",
                    "sense_definition": "The authorization granted by a company to sell or distribute its goods or services in a certain area.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to sell the <w>franchise</w> to a local investor.",
                            "target_lang_translations": {
                                "ru": "Компания решила продать <w>франшизу</w> местному инвестору.",
                                "zh": "公司决定将该<w>特许经营权</w>卖给当地的一位投资者。"
                            }
                        },
                        {
                            "text": "He paid a large fee to obtain the <w>franchise</w> for the new coffee brand.",
                            "target_lang_translations": {
                                "ru": "Он заплатил большой взнос, чтобы получить <w>франшизу</w> нового кофейного бренда.",
                                "zh": "他支付了一笔高额费用以获得该新咖啡品牌的<w>特许经营权</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "franchise agreement",
                        "franchise fee",
                        "franchise owner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Право, предоставляемое компанией на продажу её товаров или услуг на определённой территории.",
                        "zh": "公司授予在特定区域销售或分销其商品或服务的授权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "франши́за",
                                "target_lang_sense_clarification": "лицензия на бизнес"
                            },
                            {
                                "target_lang_word": "лицензия",
                                "target_lang_sense_clarification": "разрешение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特许经营权",
                                "target_lang_sense_clarification": "商业授权"
                            },
                            {
                                "target_lang_word": "加盟权",
                                "target_lang_sense_clarification": "加入连锁经营的权利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9c9f174-868f-3e70-a907-d4489c4a1240",
                    "sense_definition": "A business or shop operating under an authorization to sell a specific company's goods or services.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They opened a new fast-food <w>franchise</w> in the city center.",
                            "target_lang_translations": {
                                "ru": "Они открыли новую <w>франшизу</w> быстрого питания в центре города.",
                                "zh": "他们在市中心开了一家新的快餐<w>加盟店</w>。"
                            }
                        },
                        {
                            "text": "She manages a successful <w>franchise</w> that employs twenty people.",
                            "target_lang_translations": {
                                "ru": "Она управляет успешным <w>предприятием по франшизе</w>, в котором работают двадцать человек.",
                                "zh": "她管理着一家雇佣了二十名员工的成功<w>加盟店</w>。"
                            }
                        }
                    ],
                    "synonyms": [
