                "senses": [
                    {
                        "sense_id": "e18d2014-5048-33bd-81ab-2b96f5ec085b",
                        "entry_id": "46d12d39-a812-3e30-be3a-cba899fd98b8",
                        "glosses": [
                            "текст. механизм для ложного кручения нити"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85353de-3e5b-4724-9d3a-3f219c6d94f8",
                                "sense_id": "e18d2014-5048-33bd-81ab-2b96f5ec085b",
                                "text": "Но вскоре новое технологическое устройство — вьюрок, соединившее все операции свивания и крутки, в один процесс, — резко удешевило материал, так как производительность крутильных машин возросла в десять раз."
                            }
                        ]
                    }
