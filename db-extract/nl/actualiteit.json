                "senses": [
                    {
                        "sense_id": "84b07bcd-52ea-3a4f-912e-e334817e3f98",
                        "entry_id": "dc5558ef-392d-31df-9283-5580abc29284",
                        "glosses": [
                            "datgene wat momenteel sterk in de belangstelling staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae05283c-fec4-4256-b47e-7954afc3243d",
                                "sense_id": "84b07bcd-52ea-3a4f-912e-e334817e3f98",
                                "text": "Dit programma houdt zich voornamelijk met actualiteiten bezig."
                            },
                            {
                                "example_id": "a1c34733-1313-4c5f-b0d2-f1ce3c28e9b3",
                                "sense_id": "84b07bcd-52ea-3a4f-912e-e334817e3f98",
                                "text": "De oorlog in Oekraïne is nu weer uit de actualiteiten verdwenen."
                            },
                            {
                                "example_id": "21236c51-5ceb-43ad-b921-6d5ad831780b",
                                "sense_id": "84b07bcd-52ea-3a4f-912e-e334817e3f98",
                                "text": "Beelden van een paar dagen geleden vermengden zich met de actualiteit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b048543-8cce-4652-a5bf-0c7e2f9faa63",
                        "source_entry_id": "dc5558ef-392d-31df-9283-5580abc29284",
                        "source_sense_id": "84b07bcd-52ea-3a4f-912e-e334817e3f98",
                        "target_lang_word": "Aktualität",
