                "senses": [
                    {
                        "sense_id": "55f81b8a-456b-38e5-8a74-1b99255a3d39",
                        "entry_id": "1f0e4f95-939d-3333-98b4-8b62a780a918",
                        "glosses": [
                            "computer die speciaal geschikt is voor het spelen van videospelletjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d35624f-4ac5-4969-8fb2-e2955ede5f64",
                                "sense_id": "55f81b8a-456b-38e5-8a74-1b99255a3d39",
                                "text": "Er zijn ook voordelen: je kunt je games overal mee naartoe nemen als je op een tablet speelt. Ook heb je geen zware gameconsole nodig om de nieuwste games te spelen. Plus: je hebt al je spellen bij elkaar verzameld."
                            },
                            {
                                "example_id": "26c90365-b735-423e-8fb7-66ef12f1dc63",
                                "sense_id": "55f81b8a-456b-38e5-8a74-1b99255a3d39",
                                "text": "Toch is het maar de vraag of China massaal achter de gameconsole gaat zitten nu het verbod is opgeheven. Een spelletje kost al snel 40 euro, terwijl op mobiele apparaten zoals tablets en smartphones gratis gespeeld kan worden."
                            },
                            {
                                "example_id": "3e6b4e67-c880-466a-9d71-d08046fb48ab",
                                "sense_id": "55f81b8a-456b-38e5-8a74-1b99255a3d39",
                                "text": "Na de presentatie van het nieuwe paradepaardje van Microsoft lieten gamers massaal weten dat ze tegen het tweedehandsbeleid en een \"online check\" zijn. De gameconsole zou eens in de 24 uur verbinding met internet moeten maken om een spel te kunnen spelen. Daarvoor zou de console altijd verbinding met internet moeten hebben. Microsoft zet daar nu een streep door."
                            }
                        ]
                    }
