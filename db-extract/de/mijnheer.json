                                                "text": "Ik meneer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a36431-6226-3e74-8d48-31537fbb2552",
                                        "entry_id": "35678a91-6028-33a5-a1db-4dc86da1927b",
