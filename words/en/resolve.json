{
    "word_family": [
        "resolution",
        "resolute",
        "resolutely",
        "unresolved",
        "irresolute"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "affd13c9-3da3-3b72-ac77-b8827c97ab86",
                    "sense_definition": "To find a satisfactory way of dealing with a problem or difficulty.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>resolve</w> this technical issue before the product launch.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>решить</w> эту техническую проблему до запуска продукта.",
                                "zh": "在产品发布前，我们需要<w>解决</w>这个技术问题。",
                                "de": "Wir müssen dieses technische Problem vor der Produkteinführung <w>beheben</w>."
                            }
                        },
                        {
                            "text": "The committee met to <w>resolve</w> the problem regarding the budget allocation.",
                            "target_lang_translations": {
                                "ru": "Комитет собрался, чтобы <w>решить</w> проблему с распределением бюджета.",
                                "zh": "委员会开会讨论并<w>解决</w>了预算分配方面的问题。",
                                "de": "Das Komitee traf sich, um das Problem bezüglich der Budgetzuweisung zu <w>lösen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resolve a problem",
                        "resolve an issue",
                        "resolve a crisis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Найти удовлетворительный способ решения проблемы или трудности.",
                        "zh": "找到解决问题或困难的满意方法。",
                        "de": "Eine zufriedenstellende Lösung für ein Problem oder eine Schwierigkeit finden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решить",
                                "target_lang_sense_clarification": "найти ответ или выход из ситуации"
                            },
                            {
                                "target_lang_word": "разрешить",
                                "target_lang_sense_clarification": "устранить проблему или кризис"
                            },
                            {
                                "target_lang_word": "уладить",
                                "target_lang_sense_clarification": "справиться с трудностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "解决",
                                "target_lang_sense_clarification": "处理问题或困难"
                            },
                            {
                                "target_lang_word": "处理",
                                "target_lang_sense_clarification": "对问题进行应对"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lösen",
                                "target_lang_sense_clarification": "ein Problem oder eine Aufgabe bewältigen"
                            },
                            {
                                "target_lang_word": "beseitigen",
                                "target_lang_sense_clarification": "ein Hindernis oder einen Fehler entfernen"
                            },
                            {
                                "target_lang_word": "beheben",
                                "target_lang_sense_clarification": "einen Schaden oder technischen Fehler korrigieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46921adf-0766-39f3-b272-837380ce41bf",
                    "sense_definition": "To settle a dispute, disagreement, or conflict.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two countries managed to <w>resolve</w> their differences peacefully through diplomacy.",
                            "target_lang_translations": {
                                "ru": "Двум странам удалось мирно <w>разрешить</w> свои разногласия с помощью дипломатии.",
                                "zh": "两国通过外交手段和平地<w>化解</w>了分歧。",
                                "de": "Die beiden Länder schafften es, ihre Differenzen friedlich durch Diplomatie <w>beizulegen</w>."
                            }
                        },
                        {
                            "text": "It took a long time to <w>resolve</w> the dispute between the neighbors.",
                            "target_lang_translations": {
                                "ru": "Потребовалось много времени, чтобы <w>уладить</w> спор между соседями.",
                                "zh": "花了很长时间才<w>调解</w>了邻居之间的纠纷。",
                                "de": "Es dauerte lange, den Streit zwischen den Nachbarn zu <w>schlichten</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resolve a conflict",
                        "resolve a dispute",
                        "resolve differences"
                    ],
                    "target_lang_definitions": {
                        "ru": "Урегулировать спор, разногласие или конфликт.",
                        "zh": "平息争端、分歧或冲突。",
                        "de": "Einen Streit, eine Meinungsverschiedenheit oder einen Konflikt beilegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урегулировать",
                                "target_lang_sense_clarification": "официально или дипломатично"
                            },
                            {
                                "target_lang_word": "разрешить",
                                "target_lang_sense_clarification": "положить конец спору"
                            },
                            {
                                "target_lang_word": "уладить",
                                "target_lang_sense_clarification": "примирить стороны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调解",
                                "target_lang_sense_clarification": "通过第三方平息争端"
                            },
                            {
                                "target_lang_word": "化解",
                                "target_lang_sense_clarification": "消除矛盾或冲突"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beilegen",
                                "target_lang_sense_clarification": "einen Streit oder Konflikt friedlich beenden"
                            },
                            {
                                "target_lang_word": "schlichten",
                                "target_lang_sense_clarification": "einen Streit zwischen Parteien vermitteln"
                            },
                            {
                                "target_lang_word": "lösen",
                                "target_lang_sense_clarification": "einen Konflikt durch eine Einigung beenden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a2e01f8-9023-3ef8-a011-5b26c988b7e6",
                    "sense_definition": "To make a firm decision to do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>resolved</w> to exercise every morning to improve her health.",
                            "target_lang_translations": {
                                "ru": "Она <w>решила</w> делать зарядку каждое утро, чтобы поправить здоровье.",
                                "zh": "她<w>决定</w>每天早上锻炼以改善健康。",
                                "de": "Sie <w>beschloss</w>, jeden Morgen Sport zu treiben, um ihre Gesundheit zu verbessern."
                            }
                        },
                        {
                            "text": "After the accident, he <w>resolved</w> never to drive recklessly again.",
                            "target_lang_translations": {
                                "ru": "После аварии он <w>твердо решил</w> никогда больше не водить машину неосторожно.",
                                "zh": "事故发生后，他<w>下定决心</w>再也不鲁莽驾驶了。",
                                "de": "Nach dem Unfall <w>nahm er sich vor</w>, nie wieder leichtsinnig zu fahren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resolve to do something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принять твердое решение сделать что-либо.",
                        "zh": "下定决心做某事。",
                        "de": "Den festen Entschluss fassen, etwas zu tun."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решить",
                                "target_lang_sense_clarification": "сделать выбор, постановить"
                            },
                            {
                                "target_lang_word": "решиться",
                                "target_lang_sense_clarification": "преодолеть сомнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决定",
                                "target_lang_sense_clarification": "做出选择"
                            },
                            {
                                "target_lang_word": "下定决心",
                                "target_lang_sense_clarification": "坚定地打算做某事"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beschließen",
                                "target_lang_sense_clarification": "eine Entscheidung treffen"
                            },
                            {
                                "target_lang_word": "sich entschließen",
                                "target_lang_sense_clarification": "den festen Willen zu einer Handlung fassen"
                            },
                            {
                                "target_lang_word": "sich vornehmen",
                                "target_lang_sense_clarification": "die Absicht haben, etwas Bestimmtes zu tun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a1ad587-9814-3bb6-8b91-88b03a7a6ac6",
                    "sense_definition": "To make the separate parts of an image or object visible and distinguishable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new telescope is powerful enough to <w>resolve</w> distant stars that were previously invisible.",
                            "target_lang_translations": {
                                "ru": "Новый телескоп достаточно мощный, чтобы <w>различать</w> далекие звезды, которые раньше были невидимы.",
                                "zh": "这台新望远镜功能强大，足以<w>分辨</w>出以前看不见的遥远恒星。",
                                "de": "Das neue Teleskop ist leistungsstark genug, um ferne Sterne, die zuvor unsichtbar waren, <w>aufzulösen</w>."
                            }
                        },
                        {
                            "text": "High-quality microscopes can <w>resolve</w> details as small as a single cell.",
                            "target_lang_translations": {
                                "ru": "Высококачественные микроскопы могут <w>различать</w> детали размером с одну клетку.",
                                "zh": "高质量的显微镜可以<w>解析</w>小至单个细胞的细节。",
                                "de": "Hochwertige Mikroskope können Details so klein wie eine einzelne Zelle <w>auflösen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resolve details",
                        "resolve an image"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать отдельные части изображения или объекта видимыми и различимыми.",
                        "zh": "使图像或物体的各个部分变得清晰可见。",
                        "de": "Die einzelnen Teile eines Bildes oder Objekts sichtbar und unterscheidbar machen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "различать",
                                "target_lang_sense_clarification": "видеть отдельные детали"
                            },
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "оптический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分辨",
                                "target_lang_sense_clarification": "区分出细节"
                            },
                            {
                                "target_lang_word": "解析",
                                "target_lang_sense_clarification": "光学或成像术语"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auflösen",
                                "target_lang_sense_clarification": "optische Details trennen und sichtbar machen"
                            },
                            {
                                "target_lang_word": "unterscheiden",
                                "target_lang_sense_clarification": "Details voneinander differenzieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4196741b-1d8b-321e-a1e1-cd9a9494cbfa",
                    "sense_definition": "To break something down into its constituent parts or elements.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist tried to <w>resolve</w> the compound into its basic elements.",
                            "target_lang_translations": {
                                "ru": "Химик попытался <w>разложить</w> соединение на его базовые элементы.",
                                "zh": "化学家试图将该化合物<w>分解</w>为其基本元素。",
                                "de": "Der Chemiker versuchte, die Verbindung in ihre Grundelemente zu <w>zerlegen</w>."
                            }
                        },
                        {
                            "text": "Under intense heat, the substance will <w>resolve</w> into a gas and a liquid residue.",
                            "target_lang_translations": {
                                "ru": "При сильном нагревании вещество <w>распадется</w> на газ и жидкий остаток.",
                                "zh": "在高温下，该物质会<w>分解</w>成气体和液体残留物。",
                                "de": "Unter starker Hitze wird sich die Substanz in ein Gas und einen flüssigen Rückstand <w>auflösen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разложить что-либо на составные части или элементы.",
                        "zh": "将某物分解为其组成部分或元素。",
                        "de": "Etwas in seine Bestandteile oder Elemente zerlegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разлагать",
                                "target_lang_sense_clarification": "на элементы (химия)"
                            },
                            {
                                "target_lang_word": "расщеплять",
                                "target_lang_sense_clarification": "разделять на части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分解",
                                "target_lang_sense_clarification": "将整体拆分为部分"
                            },
                            {
                                "target_lang_word": "解析",
                                "target_lang_sense_clarification": "化学或科学分析"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zerlegen",
                                "target_lang_sense_clarification": "in Einzelteile trennen"
                            },
                            {
                                "target_lang_word": "auflösen",
                                "target_lang_sense_clarification": "chemisch oder strukturell in Bestandteile trennen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e954e02-272e-39c8-ad8b-f0046becb2ef",
                    "sense_definition": "Strong determination and willpower to achieve something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took all her <w>resolve</w> to finish the marathon despite the pain.",
                            "target_lang_translations": {
                                "ru": "Ей потребовалась вся ее <w>решимость</w>, чтобы закончить марафон, несмотря на боль.",
                                "zh": "尽管感到疼痛，她还是凭着全部的<w>决心</w>跑完了马拉松。",
                                "de": "Es kostete ihre ganze <w>Entschlossenheit</w>, den Marathon trotz der Schmerzen zu beenden."
                            }
                        },
                        {
                            "text": "The team showed great <w>resolve</w> in coming back from a deficit to win the game.",
                            "target_lang_translations": {
                                "ru": "Команда проявила огромную <w>решимость</w>, отыгравшись и выиграв матч.",
                                "zh": "球队展现出了巨大的<w>毅力</w>，在落后的情况下反超赢得了比赛。",
                                "de": "Das Team zeigte große <w>Standhaftigkeit</w>, als es einen Rückstand aufholte und das Spiel gewann."
                            }
                        }
                    ],
                    "synonyms": [
                        "fortitude",
                        "resoluteness",
                        "tenacity",
                        "inner strength"
                    ],
                    "common_phrases": [
                        "weaken resolve",
                        "strengthen resolve",
                        "test someone's resolve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная решимость и сила воли для достижения чего-либо.",
                        "zh": "为实现目标而具备的坚定决心和意志力。",
                        "de": "Starke Entschlossenheit und Willenskraft, um etwas zu erreichen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решимость",
                                "target_lang_sense_clarification": "готовность к действию"
                            },
                            {
                                "target_lang_word": "решительность",
                                "target_lang_sense_clarification": "твердость характера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决心",
                                "target_lang_sense_clarification": "坚定的意志"
                            },
                            {
                                "target_lang_word": "毅力",
                                "target_lang_sense_clarification": "坚持不懈的意志"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Entschlossenheit",
                                "target_lang_sense_clarification": "willensstarke Haltung"
                            },
                            {
                                "target_lang_word": "Zielstrebigkeit",
                                "target_lang_sense_clarification": "fokussierte Willenskraft"
                            },
                            {
                                "target_lang_word": "Standhaftigkeit",
                                "target_lang_sense_clarification": "Beharrlichkeit trotz Widerständen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
