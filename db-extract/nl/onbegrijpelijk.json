                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03548961-a094-434f-8dc0-85cb2011f831",
                        "source_entry_id": "28750b18-66ce-3288-8770-751262e22c3a",
