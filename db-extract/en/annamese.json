                "senses": [
                    {
                        "sense_id": "44cac2c7-ce94-3299-b037-9af2762332ec",
                        "entry_id": "19788c77-b843-399e-b755-f12cdc48c55e",
                        "glosses": [
                            "A native or inhabitant of Annam (or Vietnam)."
                        ],
