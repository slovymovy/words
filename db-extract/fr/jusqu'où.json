                        "examples": [
                            {
                                "example_id": "4cbd3d0e-39a4-45fa-b853-ca046b825876",
                                "sense_id": "e0e2af41-4eb6-3759-bfb9-12bc1a40aa60",
                                "text": "Et je m'en irai sur le sable me courir après creuser des initiales, aller jusqu'où me mène l'empreinte de mes pas avant que la mer ne l'efface."
                            },
                            {
                                "example_id": "3ca00921-a56c-45b6-a6e0-451f49058473",
                                "sense_id": "e0e2af41-4eb6-3759-bfb9-12bc1a40aa60",
                                "text": "Jusqu'où j'irai, j'en sais rien."
                            },
                            {
                                "example_id": "6e26bdcc-6682-4b80-abbe-121a013d1f0f",
                                "sense_id": "e0e2af41-4eb6-3759-bfb9-12bc1a40aa60",
                                "text": "Jusqu'où va-t-on aller ?",
                                "translation": "How far are we going to go?",
                                "english": "How far are we going to go?"
                            }
                        ]
                    },
                    {
                        "sense_id": "bcf5374e-76b3-3ae1-b8cd-d01c2843d43e",
                        "entry_id": "cd4725dd-3c5b-3484-b8d3-eb1730863a85",
                        "glosses": [
