                                            {
                                                "example_id": "df468155-aec0-44e9-82f1-7d9cd782dfa6",
                                                "sense_id": "58dc6a9c-ed5a-38b2-a788-dbf03ab0d0fb",
                                                "text": "I've had an attack of the flu."
                                            }
                                        ]
                                    },
