                                                "example_id": "23e67270-60d0-4e88-aaa0-bb4f06e63840",
                                                "sense_id": "00a7cbf9-f347-36e2-9cf5-da07e4136410",
                                                "text": "I put a drip of vanilla extract in my hot cocoa."
                                            },
                                            {
                                                "example_id": "37798008-6c63-443b-9198-1822fdd4d40c",
                                                "sense_id": "00a7cbf9-f347-36e2-9cf5-da07e4136410",
                                                "text": "I need a bucket to catch the drips."
