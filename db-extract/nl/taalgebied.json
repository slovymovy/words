                                                "sense_id": "482ca0c6-2ca8-32c3-8974-293cddf5d99a",
                                                "text": "Tom Clancy of Elan Recruitment thinks that staff shortages in the regions could be as severe as in Dublin."
                                            },
                                            {
                                                "example_id": "116ebab5-dd98-4987-8c3f-54a578fcfe4b",
                                                "sense_id": "482ca0c6-2ca8-32c3-8974-293cddf5d99a",
                                                "text": "Three government departments may be named for a move from London to the regions."
