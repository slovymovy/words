{
    "word_family": [
        "prevalence",
        "prevalent",
        "prevailer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8abdfc7-293b-3d63-94bb-c2938c666356",
                    "sense_definition": "To be victorious or to triumph over an opponent or a difficult situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the many challenges they faced during the competition, the team managed to <w>prevail</w> in the end.",
                            "target_lang_translations": {
                                "ru": "Несмотря на многочисленные трудности, с которыми они столкнулись во время соревнований, команде в итоге удалось <w>одержать победу</w>."
                            }
                        },
                        {
                            "text": "Many people believe that justice will eventually <w>prevail</w> against corruption in the legal system.",
                            "target_lang_translations": {
                                "ru": "Многие верят, что справедливость в конечном итоге <w>восторжествует</w> над коррупцией в правовой системе."
                            }
                        }
                    ],
                    "synonyms": [
                        "triumph",
                        "win",
                        "conquer",
                        "overcome"
                    ],
                    "antonyms": [
                        "lose",
                        "fail",
                        "surrender",
                        "succumb"
                    ],
                    "common_phrases": [
                        "justice will prevail",
                        "prevail against",
                        "prevail over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одержать победу или восторжествовать над противником или в трудной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восторжествовать",
                                "target_lang_sense_clarification": "о победе идеи, справедливости или в борьбе"
                            },
                            {
                                "target_lang_word": "одержать победу",
                                "target_lang_sense_clarification": "в соревновании или сражении"
                            },
                            {
                                "target_lang_word": "победить",
                                "target_lang_sense_clarification": "взять верх над кем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64679317-5bdd-347b-a80a-d3996359b68d",
                    "sense_definition": "To be common, widespread, or the most frequent feature in a particular place or time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this mountainous region, cold winds <w>prevail</w> throughout most of the winter months.",
                            "target_lang_translations": {
                                "ru": "В этом горном регионе на протяжении большинства зимних месяцев <w>господствуют</w> холодные ветры."
                            }
                        },
                        {
                            "text": "A sense of optimism began to <w>prevail</w> among the citizens after the new law was passed.",
                            "target_lang_translations": {
                                "ru": "После принятия нового закона среди граждан начал <w>преобладать</w> оптимизм."
                            }
                        }
                    ],
                    "synonyms": [
                        "predominate",
                        "persist",
                        "abound"
                    ],
                    "common_phrases": [
                        "prevailing conditions",
                        "prevailing winds",
                        "prevailing attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть обычным, широко распространенным или наиболее частым признаком в определенном месте или времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преобладать",
                                "target_lang_sense_clarification": "иметь численный или качественный перевес"
                            },
                            {
                                "target_lang_word": "господствовать",
                                "target_lang_sense_clarification": "о климате, ветрах или настроениях"
                            },
                            {
                                "target_lang_word": "царить",
                                "target_lang_sense_clarification": "об атмосфере или настроении"
                            },
                            {
                                "target_lang_word": "превалировать",
                                "target_lang_sense_clarification": "книжный вариант для обозначения перевеса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bf3d096-fbbb-38d7-b5e7-00ec390d5f8f",
                    "sense_definition": "To successfully persuade or induce someone to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hours of intense discussion, I finally <w>prevailed</w> on him to join our research project.",
                            "target_lang_translations": {
                                "ru": "После многочасовых напряженных дискуссий мне наконец удалось <w>уговорить</w> его присоединиться к нашему исследовательскому проекту."
                            }
                        },
                        {
                            "text": "The committee was <w>prevailed</w> upon to reconsider their initial decision regarding the budget cuts.",
                            "target_lang_translations": {
                                "ru": "Комитет удалось <w>убедить</w> пересмотреть свое первоначальное решение относительно сокращения бюджета."
                            }
                        }
                    ],
                    "synonyms": [
                        "persuade",
                        "convince",
                        "induce"
                    ],
                    "antonyms": [
                        "dissuade"
                    ],
                    "common_phrases": [
                        "prevail on",
                        "prevail upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно убедить или склонить кого-либо к совершению какого-либо действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уговорить",
                                "target_lang_sense_clarification": "склонить к действию доводами"
                            },
                            {
                                "target_lang_word": "убедить",
                                "target_lang_sense_clarification": "заставить согласиться на что-либо"
                            },
                            {
                                "target_lang_word": "склонить",
                                "target_lang_sense_clarification": "побудить к принятию решения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}