                    {
                        "sense_id": "66863989-a338-306e-a95f-282961731551",
                        "entry_id": "720047e2-c320-39b3-a30a-3cb82a9b57e8",
                        "glosses": [
                            "terrein waar zowel de circustent als alle wagens van het circus zijn gelokaliseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde9574b-6dda-494d-b852-fdbf5157312d",
                                "sense_id": "66863989-a338-306e-a95f-282961731551",
                                "text": "De olifant greep de man zo'n honderd meter van het circusterrein in Buchen, ten zuiden van Frankfurt."
                            },
                            {
                                "example_id": "4965989c-df92-477a-bdfa-fd38a76090a0",
                                "sense_id": "66863989-a338-306e-a95f-282961731551",
                                "text": "De dieren zouden vannacht tussen 03.00 uur en 03.30 uur van het circusterrein zijn ontsnapt en de busbaan zijn opgelopen. Daar werden ze geschept door de nachtbus tussen Amsterdam en Haarlem. De chauffeur en de passagiers bleven ongedeerd. De bus raakte flink beschadigd."
                            },
                            {
                                "example_id": "0aa57606-a068-476c-a334-6624c66bc8a6",
                                "sense_id": "66863989-a338-306e-a95f-282961731551",
                                "text": "Het dier stond op een circusterrein in de stad Tupelo, toen het in zijn schouder werd geraakt door een kogel. Die werd afgevuurd vanuit een auto die langsreed. Er raakten geen andere dieren of mensen gewond."
                            }
                        ]
                    }
