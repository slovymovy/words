            "senses": [
                {
                    "sense_id": "b4609849-d044-37b3-b46a-a90b19b64d1e",
                    "sense_definition": "The meat of a deer, typically one that lived in its natural habitat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant serves a delicious stew made with fresh <w>venison</w>.",
                            "target_lang_translations": {
                                "pl": "Restauracja serwuje pyszny gulasz ze świeżej <w>dziczyzny</w>."
                            }
                        },
                        {
                            "text": "Many hunters enjoy eating <w>venison</w> after a successful trip in the woods.",
                            "target_lang_translations": {
                                "pl": "Wielu myśliwych chętnie je <w>dziczyznę</w> po udanej wyprawie do lasu."
                            }
                        }
                    ],
                    "synonyms": [
                        "deer meat",
                        "deerflesh"
                    ],
                    "common_phrases": [
                        "fresh venison",
                        "venison stew"
                    ],
                    "target_lang_definitions": {
