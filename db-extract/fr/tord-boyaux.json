        "fr-extract.jsonl": [
            {
                "entry_id": "e93bc2d7-1116-3f28-b5e8-a43e7d780ee1",
                "word": "tord-boyaux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                        "entry_id": "e93bc2d7-1116-3f28-b5e8-a43e7d780ee1",
                        "glosses": [
                            "Eau-de-vie très forte."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c04c344d-ea3a-4102-a749-c9284d47fe80",
                                "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                                "text": "On apporta bientôt de l’eau-de-vie de sorbe qui, d’après Nozdirov, rappelait la prune à s’y méprendre, mais qui, au profond étonnement des invités, se révéla un atroce tord-boyaux."
                            },
                            {
                                "example_id": "3adeb40a-abdb-4917-a335-3833709586f9",
                                "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                                "text": "Curieusement, cet alcool presque pur inspirait à Kornilov une étrange lucidité. « Je l’aime bien, se disait-il, ce brave pope. Son tord-boyaux aussi."
                            },
                            {
                                "example_id": "764cb0e0-3805-4bd2-94aa-4ef3b95e543e",
                                "sense_id": "b9a155c9-18f8-377e-bf79-35ebec9073c0",
                                "text": "Il alla quérir une bouteille de cette merveilleuse vodka des paysans polonais, tord-boyaux sauveur et sacré, et j’osai lui dire, après le premier cul sec, que nous mourions de faim."
                            }
                        ]
                    },
                    {
                        "sense_id": "9030f5ca-1c65-36e4-9e0d-1d7414335c23",
                        "entry_id": "e93bc2d7-1116-3f28-b5e8-a43e7d780ee1",
                        "glosses": [
                            "Mal de ventre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f13f046e-e052-420c-93ef-0ef0c7ba0460",
                                "sense_id": "9030f5ca-1c65-36e4-9e0d-1d7414335c23",
                                "text": "C’était la terreur. Un sacré tord-boyaux de frousse tellement on avait peur qu’un des deux se viandât méchamment cinq mètres plus bas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43a904be-3b21-430b-bd55-038d11bd6dd2",
                        "source_entry_id": "e93bc2d7-1116-3f28-b5e8-a43e7d780ee1",
                        "target_lang_word": "Fusel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fusel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                        "entry_id": "94a96fd1-e854-35ec-84a7-e69f95b7628c",
                                        "glosses": [
                                            "schlechter, billiger, minderwertiger Branntwein, Schnaps oder Wein"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bcaa6d9-2145-4f71-8a6d-14caecec9276",
                                                "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                                "text": "Trink' nicht immer diesen billigen Fusel!"
                                            },
                                            {
                                                "example_id": "ddb2c0ce-d265-4a6d-987a-fe41dcb84bd1",
                                                "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                                "text": "„An dem Fusel brauchte man nur zu schnuppern, und schon stiegen einem die Tränen in die Augen.“"
                                            },
                                            {
                                                "example_id": "96faaa93-9c1b-4ac1-b1a9-b131917966a5",
                                                "sense_id": "11be6a83-b6f2-33a8-8ce4-6dfdc5109cdf",
                                                "text": "„Aus einer Kammer rechts hinter dem Ladentisch roch es nach Fusel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb68b508-5572-3a12-a8e4-bf5dd6478e7b",
                                        "entry_id": "94a96fd1-e854-35ec-84a7-e69f95b7628c",
                                        "glosses": [
                                            "Gemisch verschiedener Amylalkohole"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1350c491-d3f4-48b7-aa22-6e2c3c9135d2",
                                                "sense_id": "eb68b508-5572-3a12-a8e4-bf5dd6478e7b",
                                                "text": "„Im Bier schwanken die Fuselanteile aufgrund der unterschiedlichen Herstellungsverfahren. Weizenbier hat höhere Konzentrationen als Pilsener oder Exportbier. Ebenso hat Obergäriges Bier mehr Fusel als untergäriges.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "587c8b78-a930-44e8-9ed4-dd99ca342492",
                        "source_entry_id": "e93bc2d7-1116-3f28-b5e8-a43e7d780ee1",
