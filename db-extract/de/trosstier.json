                "senses": [
                    {
                        "sense_id": "9bf1ae1b-388c-3f3e-ac8b-de4a579e7aba",
                        "entry_id": "3da2dc0b-1155-3e18-9b61-c978d4b259c7",
                        "glosses": [
                            "Tier, das für den Transport von Personen oder Gegenständen im Tross zuständig ist"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "cda8ae64-9d92-4157-8531-d253810f08b5",
                                "sense_id": "9bf1ae1b-388c-3f3e-ac8b-de4a579e7aba",
                                "text": "„Wenn 5000 Menschen hier wohnen wollten, dann brauchten nicht nur sie, sondern auch die Pferde und Trosstiere etwas zu trinken.“"
                            },
                            {
                                "example_id": "3094e9e2-cef5-4c35-84e7-6c4aa74055c6",
                                "sense_id": "9bf1ae1b-388c-3f3e-ac8b-de4a579e7aba",
                                "text": "„Deshalb ist es nahe liegender, das Veterinarium als Tierlazarett zu deuten, wo verwundete und lahme Trosstiere behandelt wurden.“"
                            },
                            {
                                "example_id": "04b8a07d-66c6-4a69-83c5-d3f95078e30e",
                                "sense_id": "9bf1ae1b-388c-3f3e-ac8b-de4a579e7aba",
                                "text": "„Blitz und Donner tobten über unseren Köpfen und machten die Pferde und Trosstiere rasend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
