            {
                "entry_id": "3f3b1d1e-8657-3ab1-b841-a85e604d5666",
                "word": "castagneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b272f570-3fff-4fc2-810c-20f160dc7170",
                        "entry_id": "3f3b1d1e-8657-3ab1-b841-a85e604d5666",
                        "tags": [
                            "plural"
                        ],
                        "form": "castagneurs"
                    },
                    {
                        "form_id": "769cffb3-f597-422d-8598-5dbf8ec05d51",
                        "entry_id": "3f3b1d1e-8657-3ab1-b841-a85e604d5666",
                        "tags": [
                            "feminine"
                        ],
                        "form": "castagneuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3fec6c6-3472-370f-8a8c-5c08c2743f4f",
                        "entry_id": "3f3b1d1e-8657-3ab1-b841-a85e604d5666",
                        "glosses": [
                            "Individu qui aime la bagarre, qui est toujours prêt à se battre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3843d066-73e4-44d6-bb6d-0a10ed869228",
                                "sense_id": "d3fec6c6-3472-370f-8a8c-5c08c2743f4f",
                                "text": "Évidemment, au moment où mon poing s’est écrasé sur le menton de Freddy Cereseto, je me suis souvenu que j’étais en train de taper sur l’un des plus gros castagneurs de la ville."
                            },
                            {
                                "example_id": "99df47f7-15d0-4d17-aa8f-074d14c2aa58",
                                "sense_id": "d3fec6c6-3472-370f-8a8c-5c08c2743f4f",
                                "text": "Les policiers ont eu des difficultés à arrêter les castagneurs."
                            },
                            {
                                "example_id": "efca9382-a2b3-4a1e-9e00-8df6bd3b96fe",
                                "sense_id": "d3fec6c6-3472-370f-8a8c-5c08c2743f4f",
                                "text": "Quand il a bu, Marc est un vrai castagneur."
                            },
                            {
                                "example_id": "acac0e0b-7520-4b6b-8c4d-39091fa4d658",
                                "sense_id": "d3fec6c6-3472-370f-8a8c-5c08c2743f4f",
                                "text": "Pierrot il était costaud, c’était un castagneur, mais il était sérieux aussi, authentique, raconte un de ses amis, mao-prolo de Renault dont le nom de guerre est « Marseille »."
                            }
                        ]
                    }
                ],
