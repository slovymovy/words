                    {
                        "translation_id": "7a9ee6f2-41db-4d9c-9495-3ead30b303c1",
                        "source_entry_id": "f4e0be58-342c-37a4-8e38-a3b35a7841e8",
                        "source_sense_id": "f9342cdf-5b4e-3483-9e15-7a5f1f1e70f7",
                        "target_lang_word": "paywall",
