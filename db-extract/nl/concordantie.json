                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e69f6eb7-194c-3355-87bf-58e138734fff",
                                        "entry_id": "2ae386f0-cebd-31b5-a3d4-74d4f8e402d9",
                                        "glosses": [
                                            "Fait que diverses choses vont bien ensemble ; accord entre les choses ; conformité ; analogie ; correspondance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6249e08a-2b7a-45d0-8c1c-2433f03679e5",
                                                "sense_id": "e69f6eb7-194c-3355-87bf-58e138734fff",
                                                "text": "La pendule de la cheminée et ma montre sont mises en concordance pour la comparaison du moment de départ et du moment d’arrivée."
                                            },
                                            {
                                                "example_id": "8227b76c-acd3-4752-84b3-2d748f3240cc",
                                                "sense_id": "e69f6eb7-194c-3355-87bf-58e138734fff",
                                                "text": "Le secret des chefs-d’œuvre est là, dans la concordance du sujet et du tempérament de l’auteur."
                                            },
                                            {
                                                "example_id": "544207e7-492a-4dbc-b52f-06000dad82e6",
                                                "sense_id": "e69f6eb7-194c-3355-87bf-58e138734fff",
                                                "text": "Ô miracle des mots, magique concordance de l’heure, du décor et de la fière légende paysanne que le poète déroulait pour nous tout le long de l’étroit chemin, entre les champs d’oliviers et de vignes !"
                                            },
                                            {
                                                "example_id": "883628ae-0f37-4284-805f-a57242f94042",
                                                "sense_id": "e69f6eb7-194c-3355-87bf-58e138734fff",
                                                "text": "L’opinion de Pavlov sur le rôle décisif du milieu ambiant […], se trouve ainsi en concordance parfaite avec les thèses théoriques de Mitchourine, avec les principes du darwinisme soviétique créateur développé actuellement par T. Lyssenko."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a421ee6b-4b07-3e54-84ec-e2098358d4b4",
                                        "entry_id": "2ae386f0-cebd-31b5-a3d4-74d4f8e402d9",
                                        "glosses": [
                                            "Emploi du même mot dans divers versets de la Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8ee04a-6ecb-4ede-9e14-bf885dcf0577",
                                                "sense_id": "a421ee6b-4b07-3e54-84ec-e2098358d4b4",
                                                "text": "Quelle est la concordance du mot sept ?"
                                            },
                                            {
                                                "example_id": "739692f6-40cc-40d3-bf21-b64a46e29857",
                                                "sense_id": "a421ee6b-4b07-3e54-84ec-e2098358d4b4",
                                                "text": "La concordance des évangiles : ouvrage dans lequel sont rapprochés les passages des évangiles qui se rapportent aux mêmes sujets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "893e5a77-a448-3a8b-8ccf-d98cf057a910",
                                        "entry_id": "2ae386f0-cebd-31b5-a3d4-74d4f8e402d9",
                                        "glosses": [
                                            "Index alphabétique qui contient tous les mots d’une œuvre ou d’un auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a40a73c-c998-44b6-b476-4690483be352",
                                                "sense_id": "893e5a77-a448-3a8b-8ccf-d98cf057a910",
                                                "text": "Chercher un passage, un mot dans la concordance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc81d8e-9030-3290-bb09-275d62bccc4b",
                                        "entry_id": "2ae386f0-cebd-31b5-a3d4-74d4f8e402d9",
                                        "glosses": [
                                            "Accord des mots les uns avec les autres, suivant les règles de la syntaxe."
                                        ],
