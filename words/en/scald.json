{
    "word_family": [
        "scalding",
        "scalded"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "deade959-f2ab-3fab-a51c-e43f0aa6a17a",
                    "sense_definition": "To burn the skin or flesh with hot liquid or steam.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>scald</w> your hand with the boiling water.",
                            "target_lang_translations": {
                                "cs": "Dávej si pozor, ať si <w>neopaříš</w> ruku vařící vodou."
                            }
                        },
                        {
                            "text": "The worker was <w>scalded</w> by a sudden burst of hot steam.",
                            "target_lang_translations": {
                                "cs": "Dělník byl <w>opařen</w> náhlým výronem horké páry."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scald the hand"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit popáleninu kůže nebo tkáně horkou tekutinou nebo párou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opařit",
                                "target_lang_sense_clarification": "způsobit si nebo někomu popáleninu horkou tekutinou"
                            },
                            {
                                "target_lang_word": "spařit",
                                "target_lang_sense_clarification": "častěji používané v kontextu kuchyňské úpravy nebo krátkého vystavení horku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83e8f381-3680-3e8a-b115-0d75330ba21f",
                    "sense_definition": "To heat a liquid until it is almost at the boiling point.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>scald</w> the milk before adding it to the chocolate mixture.",
                            "target_lang_translations": {
                                "cs": "Mléko bys měl <w>zahřát pod bod varu</w>, než ho přidáš do čokoládové směsi."
                            }
                        },
                        {
                            "text": "The recipe says to <w>scald</w> the cream until small bubbles appear on the surface.",
                            "target_lang_translations": {
                                "cs": "Recept říká, že se smetana má <w>zahřát pod bod varu</w>, dokud se na povrchu neobjeví malé bublinky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scald the milk"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zahřát tekutinu na teplotu těsně pod bodem varu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zahřát pod bod varu",
                                "target_lang_sense_clarification": "popisný výraz pro ohřev mléka či smetany"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2233d8e-4f3b-398a-b1ce-4e36c4125c27",
                    "sense_definition": "A burn or injury to the skin caused by hot liquid or steam.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She treated the painful <w>scald</w> on her arm with cold water.",
                            "target_lang_translations": {
                                "cs": "Bolestivou <w>opařeninu</w> na paži ošetřila studenou vodou."
                            }
                        },
                        {
                            "text": "The doctor examined the <w>scald</w> to see if it needed a bandage.",
                            "target_lang_translations": {
                                "cs": "Lékař vyšetřil <w>opařeninu</w>, aby zjistil, zda potřebuje obvaz."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Popálenina nebo zranění kůže způsobené horkou tekutinou nebo párou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opařenina",
                                "target_lang_sense_clarification": "zranění způsobené horkou tekutinou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5128c98e-05a6-3875-b465-aa9153d33f93",
                    "sense_definition": "A skin disease characterized by scaly or crusty patches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old medical text described various treatments for the <w>scald</w>.",
                            "target_lang_translations": {
                                "cs": "Starý lékařský text popisoval různé způsoby léčby <w>strupovitosti</w>."
                            }
                        },
                        {
                            "text": "Historical records mention the <w>scald</w> as a common ailment in crowded conditions.",
                            "target_lang_translations": {
                                "cs": "Historické záznamy zmiňují <w>strupovitost</w> jako běžné onemocnění v přeplněných podmínkách."
                            }
                        }
                    ],
                    "synonyms": [
                        "scabby"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical medical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kožní onemocnění charakterizované šupinatými nebo strupovitými ložisky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strupovitost",
                                "target_lang_sense_clarification": "zastaralý nebo obecný výraz pro kožní chorobu se strupy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5ce4ccb-59b3-3b14-b603-b1d3cad46043",
                    "sense_definition": "An ancient Scandinavian poet or bard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scald</w> sang epic tales of heroes and battles in the great hall.",
                            "target_lang_translations": {
                                "cs": "<w>Skald</w> zpíval ve velké síni epické příběhy o hrdinech a bitvách."
                            }
                        },
                        {
                            "text": "Many legends were preserved through the oral traditions of the northern <w>scalds</w>.",
                            "target_lang_translations": {
                                "cs": "Mnoho legend bylo zachováno díky ústní tradici severních <w>skaldů</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical Norse poets."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Starověký skandinávský básník nebo pěvec."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skald",
                                "target_lang_sense_clarification": "historické označení pro staroseverského básníka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5efcb6f7-ba56-300c-a985-d9d47e1a423e",
                    "sense_definition": "Land that is considered poor or unproductive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers struggled to grow crops on the dry and rocky <w>scald</w>.",
                            "target_lang_translations": {
                                "cs": "Zemědělci se snažili pěstovat plodiny na suché a kamenité <w>neúrodné půdě</w>."
                            }
                        },
                        {
                            "text": "Little vegetation could survive on the barren <w>scald</w>.",
                            "target_lang_translations": {
                                "cs": "Na neúrodné <w>půdě</w> mohlo přežít jen málo vegetace."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional usage for poor land."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Půda, která je považována za neúrodnou nebo neproduktivní."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neúrodná půda",
                                "target_lang_sense_clarification": "obecné označení pro neproduktivní pozemek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "17bad357-7dd6-3f9e-b9bf-4f4179b9d6e2",
                    "sense_definition": "Covered with scabs or skin sores.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character in the play was described as a <w>scald</w> and miserable beggar.",
                            "target_lang_translations": {
                                "cs": "Postava ve hře byla popsána jako <w>strupovitý</w> a ubohý žebrák."
                            }
                        },
                        {
                            "text": "He was mocked for his <w>scald</w> appearance.",
                            "target_lang_translations": {
                                "cs": "Posmívali se mu kvůli jeho <w>strupovitému</w> vzhledu."
                            }
                        }
                    ],
                    "synonyms": [
                        "scabby"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrytý strupy nebo kožními vředy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strupovitý",
                                "target_lang_sense_clarification": "pokrytý strupy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "947f299f-c7dd-3b0e-af25-7950c290cd5c",
                    "sense_definition": "Despicable, worthless, or of very low quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was betrayed by a group of <w>scald</w> knaves.",
                            "target_lang_translations": {
                                "cs": "Král byl zrazen skupinou <w>opovrženíhodných</w> darebáků."
                            }
                        },
                        {
                            "text": "They were tired of listening to the <w>scald</w> rhymers at the tavern.",
                            "target_lang_translations": {
                                "cs": "Už je nebavilo poslouchat ty <w>podřadné</w> rýmy v krčmě."
                            }
                        }
                    ],
                    "synonyms": [
                        "contemptible",
                        "despicable",
                        "miserable",
                        "trashy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used as an insult in older English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Opovrženíhodný, bezcenný nebo velmi nízké kvality."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opovrženíhodný",
                                "target_lang_sense_clarification": "vyjádření morální nízkosti"
                            },
                            {
                                "target_lang_word": "podřadný",
                                "target_lang_sense_clarification": "vyjádření nízké kvality"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}