                        "examples": [
                            {
                                "example_id": "e9dd9e4c-d41a-4aad-bfc8-93a563caa824",
                                "sense_id": "a1c64da8-35a9-35fe-87a8-489f055af245",
                                "text": "The posterior contour is shown by ascertaining the relations which the bistephanic or maximum frontal and bigoniac diameters bear to the bizygomatic width, this being taken as 100."
                            },
                            {
                                "example_id": "8479444a-c950-4326-bb5e-90e3df76cd9a",
                                "sense_id": "a1c64da8-35a9-35fe-87a8-489f055af245",
                                "text": "the large divergence in the case of the maxillo-zygomatic index, which is calculated from the bigoniac and bizygomatic measurements, in both of which there is considerable scope for differences between different observers."
                            },
                            {
                                "example_id": "df8ebd6e-929e-4788-a8b7-2eefe8c2df3c",
                                "sense_id": "a1c64da8-35a9-35fe-87a8-489f055af245",
                                "text": "The bigoniac diameter may also show an exaggerated development due to the enormous volume of the mandible ( criminaloid type — Lombroso's assassin type ) ."
                            }
                        ]
