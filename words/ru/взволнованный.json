    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d6d323e7-13ce-34e0-9a66-b1cbbe182f25",
                    "sense_definition": "Испытывающий сильное душевное беспокойство, тревогу или волнение.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "эмоциональное состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она была слишком <w>взволнована</w>, чтобы говорить спокойно после этой неожиданной встречи.",
                            "target_lang_translations": {
                                "en": "She was too <w>agitated</w> to speak calmly after that unexpected meeting."
                            }
                        },
                        {
                            "text": "Перед началом важного экзамена <w>взволнованный</w> студент никак не мог сосредоточиться на вопросах.",
                            "target_lang_translations": {
                                "en": "Before the start of the important exam, the <w>anxious</w> student just couldn't concentrate on the questions."
                            }
                        }
                    ],
                    "synonyms": [
                        "встревоженный",
                        "обеспокоенный",
                        "растревоженный",
                        "смятенный",
                        "беспокойный",
                        "тревожный"
                    ],
                    "antonyms": [
                        "спокойный",
                        "невозмутимый",
                        "хладнокровный"
                    ],
                    "common_phrases": [
                        "взволнованный студент",
                        "взволнованный вид"
                    ],
                    "target_lang_definitions": {
                        "en": "Experiencing strong mental anxiety, worry, or excitement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excited",
                                "target_lang_sense_clarification": "agitated or emotionally aroused, positively or negatively"
                            },
                            {
                                "target_lang_word": "agitated",
                                "target_lang_sense_clarification": "feeling troubled, nervous, or perturbed"
                            },
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "worried or uneasy"
                            },
                            {
                                "target_lang_word": "worried",
                                "target_lang_sense_clarification": "anxious or troubled about actual or potential problems"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2387c18-b895-3635-9c91-a1aa9e69ca87",
                    "sense_definition": "Выражающий волнение, беспокойство или свидетельствующий о нём (о голосе, взгляде, жестах).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "эмоциональное состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Саша заморгал глазами, приложил руку к сердцу и сказал <w>взволнованным</w> голосом: — Кланялась вам, Иван Николаевич, мамаша и велела благодарить вас…",
                            "target_lang_translations": {
                                "en": "Sasha blinked, put his hand to his heart, and said in an <w>agitated</w> voice: 'My mother sends her regards, Ivan Nikolayevich, and told me to thank you...'"
                            }
                        },
                        {
                            "text": "Её <w>взволнованный</w> шёпот выдавал сильный страх перед предстоящим разговором.",
                            "target_lang_translations": {
                                "en": "Her <w>tremulous</w> whisper betrayed a strong fear of the upcoming conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "трепетный",
                        "тревожный"
                    ],
                    "antonyms": [
                        "ровный",
                        "спокойный"
                    ],
                    "common_phrases": [
                        "взволнованный голос",
                        "взволнованный шёпот"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing excitement, anxiety, or indicating it (of voice, look, gestures)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agitated",
                                "target_lang_sense_clarification": "showing nervous excitement or worry in voice or manner"
                            },
                            {
                                "target_lang_word": "excited",
                                "target_lang_sense_clarification": "showing strong emotion or eagerness"
                            },
                            {
                                "target_lang_word": "tremulous",
                                "target_lang_sense_clarification": "shaking or quivering slightly due to emotion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4606f88e-aa82-34a8-a086-3371ef3deec2",
                    "sense_definition": "Покрытый волнами, неспокойный (о водной поверхности).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "состояние воды",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Корабль медленно шёл сквозь <w>взволнованное</w> море, преодолевая сильный ветер.",
                            "target_lang_translations": {
                                "en": "The ship slowly made its way through the <w>rough</w> sea, overcoming a strong wind."
                            }
                        },
                        {
                            "text": "Мы смотрели на <w>взволнованное</w> озеро, по которому пробегали мелкие серые волны.",
                            "target_lang_translations": {
                                "en": "We looked at the <w>choppy</w> lake, across which small gray waves were running."
                            }
                        }
                    ],
                    "synonyms": [
                        "беспокойный",
                        "тревожный"
                    ],
                    "antonyms": [
                        "тихий",
                        "спокойный",
                        "гладкий"
                    ],
                    "common_phrases": [
                        "взволнованное море"
                    ],
                    "target_lang_definitions": {
                        "en": "Covered with waves, rough (of a water surface)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rough",
                                "target_lang_sense_clarification": "of water, having large waves"
                            },
                            {
                                "target_lang_word": "choppy",
                                "target_lang_sense_clarification": "of water, having many small waves"
                            },
                            {
                                "target_lang_word": "agitated",
                                "target_lang_sense_clarification": "of water, disturbed or turbulent"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17486814-e211-3e70-b09c-ec79c4faf6b6",
                    "sense_definition": "Страдательное причастие прошедшего времени от глагола <w>взволновать</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Общество было глубоко <w>взволновано</w> новостями о предстоящих экономических реформах.",
                            "target_lang_translations": {
                                "en": "Society was deeply <w>agitated</w> by the news of the upcoming economic reforms."
                            }
                        },
                        {
                            "text": "Сердце, <w>взволнованное</w> воспоминаниями детства, забилось чаще при виде старого дома.",
                            "target_lang_translations": {
                                "en": "The heart, <w>stirred</w> by childhood memories, beat faster at the sight of the old house."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'взволновать' (to agitate, excite, or disturb)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agitated",
                                "target_lang_sense_clarification": "disturbed or stirred up emotionally"
                            },
                            {
                                "target_lang_word": "excited",
                                "target_lang_sense_clarification": "stirred up or stimulated"
                            },
                            {
                                "target_lang_word": "moved",
                                "target_lang_sense_clarification": "deeply affected by emotion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
