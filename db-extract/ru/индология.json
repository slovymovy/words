                                "target_senses": [
                                    {
                                        "sense_id": "3834150e-3228-36c0-b8f6-5e17eacff29a",
                                        "entry_id": "4a06af24-1d4e-3324-9dbb-ee66c9f22ec2",
                                        "glosses": [
                                            "Wissenschaft von den Sprachen und Kulturen Indiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa0e070-fcff-4484-9a23-6745f2e99566",
                                                "sense_id": "3834150e-3228-36c0-b8f6-5e17eacff29a",
                                                "text": "„Besonders gefragt seien Themenbereiche wie Geschichte, Kunst und Kultur, Ostasienstudien und Indologie.“"
                                            },
                                            {
                                                "example_id": "f7a1c964-9aeb-4a0f-9494-8556ca6d481c",
                                                "sense_id": "3834150e-3228-36c0-b8f6-5e17eacff29a",
                                                "text": "„Er avancierte zum bedeutendsten Indologen Deutschlands und brachte die Indologie durch seine unermüdlichen Forschungen in vielen Feldern voran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37fb06b8-ad7a-4e77-8f7e-df73a6c285ef",
                        "source_entry_id": "518dc69b-4a08-359b-afb5-9755ee0db6e4",
                        "source_sense_id": "9e562123-7e09-35d1-8a0b-9b07eecb3035",
                        "target_lang_word": "indologie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indologie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "761bf05f-5498-348d-8ebb-c7e5c6574073",
                                        "entry_id": "366f14fd-7a4e-34c9-aa42-8f84c8465ced",
                                        "glosses": [
                                            "studie naar de cultuur van Indonesië (het voormalig Nederlands Indië)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2be40238-d36f-4c67-9b7a-7fecf0ebbfc1",
                                                "sense_id": "761bf05f-5498-348d-8ebb-c7e5c6574073",
                                                "text": "Mijn vader, die vanwege zijn studie indologie ook islamoloog was, had als Nederduits Hervormde weinig op met de islam. Ik heb daar wel eens met hem over gesproken, maar daar herinner ik me alleen van dat hij de Koran als een nep-Bijbel bestempelde en dat hij in het Arabisch enkele soera's kon citeren."
                                            },
                                            {
                                                "example_id": "eb051cc5-82f1-46a7-8523-a4c00e742b53",
                                                "sense_id": "761bf05f-5498-348d-8ebb-c7e5c6574073",
                                                "text": "Zijn weduwe Karina Wolkers heeft opgediept hoe hij zelf over zijn fascinatie over schreef: 'Hoe was het mogelijk dat zo'n gereformeerd schlemieltje (...) zonder leidsman of enige kennis de bezielde scheppingen ontdekte van Afrikaanse en Melanesische volkeren, die daar slechts aanwezig schenen te zijn om de rechtschapen student indologie te waarschuwen voor de duistere duivelse verschrikkingen en afgodische perversiteiten van het heidendom waarin hij met zijn lelieblanke ziel zou kunnen verdagen.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ed5f92-681c-34af-be37-59592e17caae",
                                        "entry_id": "366f14fd-7a4e-34c9-aa42-8f84c8465ced",
                                        "glosses": [
                                            "studie naar de cultuur van India"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "310cc1f1-39f0-413a-b0c7-cdb5ce09d6e8",
                        "source_entry_id": "518dc69b-4a08-359b-afb5-9755ee0db6e4",
                        "source_sense_id": "9e562123-7e09-35d1-8a0b-9b07eecb3035",
