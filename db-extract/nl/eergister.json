                        "translation_id": "742d8083-8c70-4ac8-9d8c-5ed6854756b7",
                        "source_entry_id": "107580b7-0aae-3cc4-a394-0436a39c10f9",
                        "source_sense_id": "740bf3db-b7a2-3d1d-b7df-1801839f4d5f",
                        "source_sense_description": "de voorlaatste dag die voltooid is",
                        "target_lang_word": "vorgestern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorgestern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90f607ce-dcb3-33eb-b249-8796129d0911",
                                        "entry_id": "b1c30c01-ea11-357e-b39a-6769192b5265",
                                        "glosses": [
                                            "am Tag unmittelbar vor gestern; vor zwei Tagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d30e59-c8d2-465f-bbc8-cc5854d804b9",
                                                "sense_id": "90f607ce-dcb3-33eb-b249-8796129d0911",
                                                "text": "Vorgestern hätte ich fast einen schlimmen Autounfall verursacht."
                                            },
                                            {
                                                "example_id": "fd0be015-7c24-4b70-85c5-092e3b781450",
                                                "sense_id": "90f607ce-dcb3-33eb-b249-8796129d0911",
                                                "text": "„Keiner fragt, wo Levin gewesen ist, gestern, vorgestern.“"
                                            },
                                            {
                                                "example_id": "6344031b-98a1-4fee-9401-b4f550ebe4f0",
                                                "sense_id": "90f607ce-dcb3-33eb-b249-8796129d0911",
                                                "text": "„Seit vorgestern, einem Sonntag, war das Zimmer nicht mehr geheizt worden.“"
                                            },
                                            {
                                                "example_id": "65422155-9e70-4b6b-bc7e-eb57b5df44b1",
                                                "sense_id": "90f607ce-dcb3-33eb-b249-8796129d0911",
                                                "text": "„Er ist verantwortlich für die Ermordung von mindestens 6400 Juden in der besetzten Sowjetunion. Ein falscher Name hatte bis vorgestern genügt.“"
                                            },
                                            {
                                                "example_id": "a6088377-218e-4d1a-bfe0-989b624b7fd5",
                                                "sense_id": "90f607ce-dcb3-33eb-b249-8796129d0911",
                                                "text": "„ Sie dachte an die Verkäuferin im Bäckerladen in der Bornholmer Straße, die ihr vorgestern das letzte Brot im Regal, ein verbranntes, als Doppelback aufschwatzen wollte und beleidigt war, weil Lisa es nicht kaufte.“"
                                            },
                                            {
                                                "example_id": "354d6718-3db9-442b-89f4-0c0e2259fb5b",
                                                "sense_id": "90f607ce-dcb3-33eb-b249-8796129d0911",
                                                "text": "„»Sie haben mich vorgestern angerufen«, sage ich, »aber leider habe ich vergessen, mir ihre Telefonnummer aufzuschreiben.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
