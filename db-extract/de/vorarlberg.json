                    }
                ],
                "senses": [
                    {
                        "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                        "entry_id": "b512065e-ba29-335c-a00d-963eb7318625",
                        "glosses": [
                            "ein Bundesland der Republik Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef3f8f7-c2e8-44b9-a067-989c5587e5f1",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "Das kleinste österreichische Bundesland Vorarlberg überrascht den Wintersportler mit einem erstaunlich vielseitigen Pistenangebot."
                            },
                            {
                                "example_id": "745fe531-64b4-4282-adfc-28681ea5bd7f",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "Wie kam es, dass die Europäische Union Vorarlberg zu einer ihrer fünf dynamischsten Regionen auszeichnete?"
                            },
                            {
                                "example_id": "0ee8d30e-6c7e-436e-abb1-956d4bca09cb",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "Die Landesregierung von Vorarlberg hat die strengsten Umweltvorschriften Österreichs erlassen."
                            },
                            {
                                "example_id": "d2044135-0d77-4bde-92e3-8fbf31b8f189",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "Bei jeder Gelegenheit wird in Vorarlberg darauf hingewiesen, dass die französische Hauptstadt von Bregenz aus näher liege als die eigene - eine halbe Stunde bloss, aber die sei entscheidend."
                            },
                            {
                                "example_id": "f55ec9ac-dcdc-4af1-8d0c-f9c5aa003ddc",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "Am 21. September werden in Vorarlberg neun Parteien am Landtagswahlzettel stehen."
                            },
                            {
                                "example_id": "2dbe1e52-c988-4c99-8b6d-61b898d2a6cb",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "„Ein Blick auf die Wahlergebnisse in den Gemeinden zeigt, wie stark seine ÖVP abgeschnitten hat: Von Niederösterreich im Nordosten bis ins Vorarlberg im Südwesten ist die politische Landkarte überwiegend türkis eingefärbt – die Farbe der ÖVP.“"
                            },
                            {
                                "example_id": "4e05fa8f-7d2b-40eb-a2f1-02b9d9ba791f",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "„Dominic Büchler wird 2021 ins Vorarlberg ziehen – nächsten Frühling kandidiert er trotzdem nochmals für die SVP.“"
                            },
                            {
                                "example_id": "bb904ba1-4b51-4be2-b715-376291762e4e",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "„Das Wetter hätte nicht besser sein können: strahlender Sonnenschein und eine geniale Weitsicht in alle Richtungen, ob ins Rheintal, ins Saminatal, ins Vorarlberg oder auf die Gipfel rund herum.“"
                            },
                            {
                                "example_id": "90d1fd93-e143-4d2f-b1dc-709b4f95b254",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "„Diese Bahnstrecke wurde auch als Verbindung Tirols ins Vorarlberg und weiter in die Schweiz diskutiert. Nach dem Deutsch-Französischen Krieg von 1870/1871 wurde jedoch die Arlbergbahn als inner-österreichische Verbindung ins Vorarlberg, gegenüber der Verbindung über den Fernpass und Kempten bevorzugt.“"
                            },
                            {
                                "example_id": "db5e34ed-2d1d-4544-acd2-95c6939385a3",
                                "sense_id": "869efc2d-874c-3cbd-b5ed-a07e5c6f7add",
                                "text": "„Hinsichtlich der Entlohnung sei sie nach dem Kollektivvertrag für Soziales- und Gesundheitsorganisationen im Vorarlberg entlohnt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
