                "translations": [
                    {
                        "translation_id": "71675107-d4c9-4ee3-9182-87facec565ca",
                        "source_entry_id": "4c82862d-faff-3158-bdfd-92265cb0c0e3",
                        "source_sense_id": "bd6aabd8-bcdc-3b88-8f02-216039f171ce",
                        "target_lang_word": "incarnation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incarnation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d56482c-84c7-30f7-a56f-29cc53dd1a1e",
                                        "entry_id": "89ff023d-1d5f-39b2-ab22-354884517925",
                                        "glosses": [
                                            "An incarnate being or form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "548633ba-7ac9-440f-b3d5-fc5d9f9608dc",
                                                "sense_id": "4d56482c-84c7-30f7-a56f-29cc53dd1a1e",
                                                "text": "She is a new incarnation of some of the illustrious dead."
                                            },
                                            {
                                                "example_id": "3a91f83b-73bc-4424-b488-28da3a3b1688",
                                                "sense_id": "4d56482c-84c7-30f7-a56f-29cc53dd1a1e",
                                                "text": "She had cast off the terror of the leaping flame, the cold power of judgment that was even now being done, and the wise sadness of the tombs - cast them off and put them behind her, like the white shroud she wore, and now stood out the incarnation of lovely tempting womanhood, made more perfect - and in a way more spiritual - than ever woman was before."
                                            },
                                            {
                                                "example_id": "83475e41-adc5-4a70-a0e5-5214b8641eee",
                                                "sense_id": "4d56482c-84c7-30f7-a56f-29cc53dd1a1e",
                                                "text": "Robespierre, the very incarnation of lustful and deadly Vengeance, stands silently by.."
                                            },
                                            {
                                                "example_id": "591cef3d-b738-4294-a8fa-0fd45c9a2533",
                                                "sense_id": "4d56482c-84c7-30f7-a56f-29cc53dd1a1e",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c166082-5e61-361f-906f-dc0291b6c037",
                                        "entry_id": "89ff023d-1d5f-39b2-ab22-354884517925",
                                        "glosses": [
                                            "A version or iteration (of something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b55aa7-8e0c-46b1-a1d2-95ea9eb74baa",
                                                "sense_id": "0c166082-5e61-361f-906f-dc0291b6c037",
                                                "text": "It seems that they existed in some sort of previous incarnation of our universe, and use abstract terms to describe their existence, such as \"feeding on concepts\". They prepared for some sort of ascension, but then the Pattern came, which they describe at first as an all-consuming emptiness, elaborating by saying that anything that passed into it was torn asunder, subjected to a set of principles and order that grinds things down to nothing, in a process of which entropy is just one part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9030edb3-ca63-37c6-8bb0-ae7f63f1fa8e",
                                        "entry_id": "89ff023d-1d5f-39b2-ab22-354884517925",
                                        "glosses": [
                                            "A living being embodying a deity or spirit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c46632db-74b5-3016-b98e-2b8a11a8cd57",
                                        "entry_id": "89ff023d-1d5f-39b2-ab22-354884517925",
                                        "glosses": [
                                            "An assumption of human form or nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29fd8b29-c69b-3f7f-afed-f0a7f6a3cca5",
                                        "entry_id": "89ff023d-1d5f-39b2-ab22-354884517925",
                                        "glosses": [
                                            "A person or thing regarded as embodying or exhibiting some quality, idea, or the like."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3897038f-c5d4-434f-9998-e4d0db75a5f8",
                                                "sense_id": "29fd8b29-c69b-3f7f-afed-f0a7f6a3cca5",
                                                "text": "The leading dancer is the incarnation of grace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e3c7c0-50ee-3d93-81f0-0aa99b2fa7a9",
                                        "entry_id": "89ff023d-1d5f-39b2-ab22-354884517925",
                                        "glosses": [
                                            "The act of incarnating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17db62bc-0ebb-38fd-9d11-b0d3d0759b79",
                                        "entry_id": "89ff023d-1d5f-39b2-ab22-354884517925",
                                        "glosses": [
                                            "The state of being incarnated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
