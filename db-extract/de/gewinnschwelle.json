                                        "entry_id": "66448556-dd6b-3be0-bc59-1e4e79ddd964",
                                        "glosses": [
                                            "The level of revenues sufficient to cover costs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffcc67cc-6eea-481e-b798-8424ced935bc",
                                                "sense_id": "e75faa79-7824-39ee-801b-84ed4a8935f3",
                                                "text": "We'll never reach break-even if our variable costs are higher than our selling price."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "break-even",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd6a10aa-afa8-3462-9e8e-2a4c48ea3cc9",
                                        "entry_id": "2bcad1d8-d960-33f4-97eb-b4e434148d1f",
                                        "glosses": [
                                            "that is characterized by the level of revenues just sufficient to cover costs"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7569e0-c09b-45d5-93be-da727faca428",
                                                "sense_id": "dd6a10aa-afa8-3462-9e8e-2a4c48ea3cc9",
                                                "text": "The Altair 8800 computer was a break-even sale for MITS."
                                            },
                                            {
                                                "example_id": "10c5915d-3cad-41da-94f4-ca21b1133cc8",
                                                "sense_id": "dd6a10aa-afa8-3462-9e8e-2a4c48ea3cc9",
                                                "text": "The British Transport Commission (BTC) was created to own not just the railways, but also London Underground, docks, inland waterways, and some road haulage activities. Its remit was to operate on a break-even basis, with sustained losses unacceptable."
                                            }
                                        ]
                                    }
                                ]
                            }
