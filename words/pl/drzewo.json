                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni w skupieniu adorowali <w>Drzewo</w> Krzyża podczas wielkopiątkowej liturgii.",
                            "target_lang_translations": {
                                "ru": "Верующие сосредоточенно поклонялись <w>Древу</w> Креста во время литургии Страстной пятницы.",
                                "en": "The faithful devoutly venerated the <w>Tree</w> of the Cross during the Good Friday liturgy."
                            }
                        },
                        {
                            "text": "Stara pieśń religijna opowiada o męce Pańskiej na <w>drzewie</w> hańby.",
                            "target_lang_translations": {
