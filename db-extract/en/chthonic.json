                                    {
                                        "sense_id": "f66827ac-955c-3202-8457-24a88dc5c26a",
                                        "entry_id": "987cbda3-e919-3982-b03a-e0342c22d1e9",
                                        "glosses": [
                                            "der Erde zugehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f65c4509-8cef-473d-a298-016057efce5c",
                                                "sense_id": "f66827ac-955c-3202-8457-24a88dc5c26a",
                                                "text": "„Die chthonische Mutter, die Erde, gebiert, ernährt und empfängt die Toten wieder in ihrem Schoß.“"
                                            },
                                            {
                                                "example_id": "c3643b4f-58c8-48b3-ae97-fcaae8ed5046",
                                                "sense_id": "f66827ac-955c-3202-8457-24a88dc5c26a",
                                                "text": "„Man tritt ein und ist geblendet von dieser Verschwörung, die das höhere Universum der himmlischen Wölbungen mit der chthonischen Welt der Mineralölfresser verbindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
