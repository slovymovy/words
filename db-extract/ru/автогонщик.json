                                    },
                                    {
                                        "sense_id": "b71085de-5bea-3e29-89fd-ec4662c4c4e4",
                                        "entry_id": "a3379fe6-602d-37af-8695-4c1071a87c75",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de piloter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98e2bd33-ca8d-4616-8a90-9c8348f6d9e3",
                                                "sense_id": "b71085de-5bea-3e29-89fd-ec4662c4c4e4",
                                                "text": "Après le welsh rarebit de rigueur chez Fouquet’s , il me reconduit dans sa splendide Lorraine sport. Il pilote lui-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1f4864-4c05-3c61-bb01-41d46ce12edf",
                                        "entry_id": "a3379fe6-602d-37af-8695-4c1071a87c75",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de piloter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e188ac12-160d-3329-9d81-2748a4187af0",
                                        "entry_id": "a3379fe6-602d-37af-8695-4c1071a87c75",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de piloter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67233105-e0b2-3bc5-9d6e-ea8e95faad91",
                                        "entry_id": "a3379fe6-602d-37af-8695-4c1071a87c75",
                                        "glosses": [
