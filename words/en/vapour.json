{
    "word_family": [
        "vaporize",
        "vaporization",
        "vaporous",
        "evaporate",
        "evaporation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08fc3826-b6a6-37e7-ae82-3ed5532e7845",
                    "sense_definition": "A substance in the gas phase at a temperature lower than its critical point, such as visible moisture or steam suspended in the air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vapour</w> rose from the hot tea cup as she held it between her hands.",
                            "target_lang_translations": {
                                "tr": "Fincanı ellerinin arasında tutarken sıcak çay bardağından <w>buhar</w> yükseliyordu."
                            }
                        },
                        {
                            "text": "Cold weather can cause water <w>vapour</w> in your breath to condense into a visible cloud.",
                            "target_lang_translations": {
                                "tr": "Soğuk hava, nefesinizdeki su <w>buharının</w> yoğunlaşarak görünür bir buluta dönüşmesine neden olabilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "steam",
                        "mist",
                        "gas",
                        "fume"
                    ],
                    "common_phrases": [
                        "water vapour",
                        "vapour pressure",
                        "dense vapour",
                        "turn to vapour"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kritik sıcaklığının altındaki bir sıcaklıkta gaz fazında bulunan, havada asılı duran görünür nem veya buhar gibi madde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buhar",
                                "target_lang_sense_clarification": "gaz fazındaki nem veya duman"
                            },
                            {
                                "target_lang_word": "buğu",
                                "target_lang_sense_clarification": "yüzeylerde oluşan hafif buhar veya nem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88147b9b-03a4-3f01-b660-4c8bce6c9550",
                    "sense_definition": "To emit moisture or gas into the air, or to talk in a boastful or empty manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The liquid began to <w>vapour</w> off rapidly when exposed to extreme heat.",
                            "target_lang_translations": {
                                "tr": "Sıvı, aşırı ısıya maruz kaldığında hızla <w>buharlaşmaya</w> başladı."
                            }
                        },
                        {
                            "text": "He spent the entire evening <w>vapouring</w> about his alleged achievements.",
                            "target_lang_translations": {
                                "tr": "Tüm akşamı sözde başarıları hakkında <w>böbürlenerek</w> geçirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "evaporate",
                        "exhale",
                        "boast",
                        "bluster"
                    ],
                    "common_phrases": [
                        "vapour away"
                    ],
                    "target_lang_definitions": {
                        "tr": "Havaya nem veya gaz yaymak ya da böbürlenerek veya boş yere konuşmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buharlaşmak",
                                "target_lang_sense_clarification": "gaz veya nem yayarak yok olmak"
                            },
                            {
                                "target_lang_word": "böbürlenmek",
                                "target_lang_sense_clarification": "boş laf etmek, caka satmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}