                                "target_senses": [
                                    {
                                        "sense_id": "58f28f63-3a5b-3aaf-ac74-9ebd740321c3",
                                        "entry_id": "d810ec1a-aa9c-3d97-87a4-80d77a4e96e6",
                                        "glosses": [
                                            "биогеографический регион, охватывающий Европу, Азию к северу от Гималаев и без Аравийского полуострова, а также Северную Африку до южного края пустыни Сахара"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e1b7c0-bef2-435a-8c9b-1f21133c5e7b",
                                                "sense_id": "58f28f63-3a5b-3aaf-ac74-9ebd740321c3",
                                                "text": "Все эти животные принадлежат югу мио-плиоценовой Палеарктики независимо от ее ранга."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
