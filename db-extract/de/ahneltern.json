                ],
                "senses": [
                    {
                        "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                        "entry_id": "c3e5b502-dd43-376c-9c4e-43b4784d9ec5",
                        "glosses": [
                            "Vorfahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d37248-6794-4de4-ad0d-3acf4846fb96",
                                "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                                "text": "„Völkergeschichte erscheint in der Gestalt von Familiengeschichte, weil ein genealogisch strukturiertes Denken den Ursprung eines Volkes nicht anders als in Geschichten von den Ahneltern zu erzählen vermag.“"
                            },
                            {
                                "example_id": "8998bf5c-a470-4705-b586-7e642f55dd9b",
                                "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                                "text": "„Ihre Ahneltern waren lauter tapfere Leute.“"
                            },
                            {
                                "example_id": "dfe2265f-658b-48ea-bafc-cded58c87cc1",
                                "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                                "text": "„Uneheliche Kinder beerben ihre mütterlichen Großeltern, Ahneltern u. s. w. , sofern diese keine eheliche Nachkommenschaft hinterlassen.“"
                            },
                            {
                                "example_id": "17d056e7-4a3a-495a-8f0a-d7958f676196",
                                "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                                "text": "„Aus der damaligen Kleidung unserer Ahneltern, lässet sich ebenfalls auf unsern heutigen Kleiderpracht ein nützliches Morale ziehen.“"
                            },
                            {
                                "example_id": "2a70ae22-3245-43f6-bc68-f261e9ae1365",
                                "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                                "text": "„Völkergeschichte erscheint in der Gestalt von Familiengeschichte, weil ein genealogisch strukturiertes Denken den Ursprung eines Volkes nicht anders als in Geschichten von den Ahneltern zu erzählen vermag.“"
                            },
                            {
                                "example_id": "0c5317f8-9362-4dd8-8561-f6a902b39928",
                                "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                                "text": "„Es war das Bestreben des Menschen, Gott gleich zu sein, das dann den ersten Ungehorsam unserer Ahneltern ADAM und EVA im Paradies heraufbeschwor (1. Mose 3).“"
                            },
                            {
                                "example_id": "99de4540-30c2-45a2-a6bc-cb227e894556",
                                "sense_id": "b23cd000-599a-32ba-a278-41f4afb06d8a",
                                "text": "„Zum Mythos des Drachengottes Lac Long Quan und der Bergfee Au Co als Ahneltern der Vietnamesen […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
