                "senses": [
                    {
                        "sense_id": "dcb79cec-ae84-32e8-b62b-d132d6faf6b0",
                        "entry_id": "635519a8-bb4e-33ee-a613-25834102ff22",
                        "glosses": [
                            "A formal investigation, often held before a jury, especially one into the cause of a death"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d66c2d-ebfd-4d2e-8fd6-e38a197aa3c5",
                                "sense_id": "dcb79cec-ae84-32e8-b62b-d132d6faf6b0",
                                "text": "The inquest on keeper Davidson was duly held, and at the commencement seemed likely to cause Tony Palliser less anxiety than he had expected."
                            },
                            {
                                "example_id": "499a97c1-2a37-4cfd-825b-9baf63921226",
                                "sense_id": "dcb79cec-ae84-32e8-b62b-d132d6faf6b0",
                                "text": "However, the 'accidental death' verdict of the jury in the inquest into the Croydon tram accident of November 2016 is the latest episode in a saga that seems likely to prevent the full story of this eminently preventable disaster from ever being exposed."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b218d63-55f9-347b-9fc9-189408bd5eae",
                        "entry_id": "635519a8-bb4e-33ee-a613-25834102ff22",
                        "glosses": [
                            "An inquiry, typically into an undesired outcome"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c4194821-abc3-3437-8c47-015fa26327f2",
                        "entry_id": "635519a8-bb4e-33ee-a613-25834102ff22",
                        "glosses": [
                            "The jury hearing such an inquiry, and the result of the inquiry"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "988df366-6f7f-39a0-a50e-6b447bf77f43",
                        "entry_id": "635519a8-bb4e-33ee-a613-25834102ff22",
                        "glosses": [
                            "enquiry; quest; search"
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c47eb2ab-91c3-4a0a-96b1-a7b9c20bb044",
                                "sense_id": "988df366-6f7f-39a0-a50e-6b447bf77f43",
                                "text": "the laborious and vexatious inquest that the soul must make after science"
                            },
                            {
                                "example_id": "0ef9e820-5d5e-4236-8a9b-8c7bc8f624db",
                                "sense_id": "988df366-6f7f-39a0-a50e-6b447bf77f43",
                                "text": "Hauing of late by diligent inquest,\nProuided him a sword of meanest sort"
                            }
                        ]
                    }
                ],
