                                            {
                                                "example_id": "af684acf-5a92-4259-867c-e1adf0a418f9",
                                                "sense_id": "61a4108e-0f86-37d5-92fc-2ebfca3bdcc7",
                                                "text": "On se croirait chez nous! jubila Jean en engouffrant une grosse fourchettée de nouilles."
                                            },
                                            {
                                                "example_id": "993af679-bd66-4892-aa8d-0d0f9dc7a581",
                                                "sense_id": "61a4108e-0f86-37d5-92fc-2ebfca3bdcc7",
                                                "text": "Il fut intéressé par la salade de carottes râpées en longues lamelles. Il en prit une fourchettée, mâcha. Le goût le surprit. Il n'appréciait pas."
                                            }
                                        ]
