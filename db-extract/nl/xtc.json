                    {
                        "translation_id": "c9f7c1ea-d2b4-4063-bcd1-198928aaff12",
                        "source_entry_id": "15b0e680-9001-3514-9844-5e4c88e57afb",
                        "source_sense_id": "e3d0e430-d7d0-3ed2-9ac9-99e97f16347c",
                        "source_sense_description": "de afkorting voor ecstasy, een hallucinerende drug",
                        "target_lang_word": "ecstasy",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecstasy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf47e8e4-0a60-349b-893d-711b0ef22e1f",
                                        "entry_id": "3073d000-df96-3663-8c2c-5bb38299be13",
                                        "glosses": [
                                            "Nom commercial de la MDMA, molécule psychotrope entactogène de la famille des amphétamines souvent vendue sous forme de pilules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73942df4-c718-44cb-9135-c61d51ae78aa",
                                                "sense_id": "cf47e8e4-0a60-349b-893d-711b0ef22e1f",
                                                "text": "Mes camarades de classe se défoncent à l’ecstasy comme on gobe des Michoko et, le pire, c’est que là où il y a de la drogue, il y a du sexe."
                                            },
                                            {
                                                "example_id": "9041eeab-727c-48b1-a389-914df656787e",
                                                "sense_id": "cf47e8e4-0a60-349b-893d-711b0ef22e1f",
                                                "text": "Aussi, l’ecstasy provoque la libération d’un autre neurotransmetteur, la noradrénaline, qui est probablement la cause de l’augmentation de la fréquence cardiaque et de la pression artérielle."
                                            },
                                            {
                                                "example_id": "4bfd4ea4-3dc9-4319-b9ad-be12222f0f5d",
                                                "sense_id": "cf47e8e4-0a60-349b-893d-711b0ef22e1f",
                                                "text": "La semaine dernière, j’ai consommé un demi-cachet d’ecstasy pour la première fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47370e3-2c51-31fd-9b18-755d666d2b2f",
                                        "entry_id": "3073d000-df96-3663-8c2c-5bb38299be13",
                                        "glosses": [
                                            "Pilule contenant de la MDMA."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf311c8f-4e73-4684-a683-816d832650db",
                                                "sense_id": "c47370e3-2c51-31fd-9b18-755d666d2b2f",
                                                "text": "J’ai pris une ecstasy avec 2 amis le mardi 17 octobre, ça s’est passé plutôt bien, je suis du genre à rester calme et [à] avoir des discussions profondes avec mon entourage, [à] essayer de comprendre le monde, etc., c’est la deuxième ecstasy que j’ai prise, la première date de plus d’un mois"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5a5c9db-792e-3fff-83bc-433cfbaabef4",
                                        "entry_id": "3073d000-df96-3663-8c2c-5bb38299be13",
                                        "glosses": [
                                            "Produit contenant de la MDMA coupée avec d’autres drogues."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1e3dace-8eef-45f8-b8f8-de189148e737",
                                                "sense_id": "c5a5c9db-792e-3fff-83bc-433cfbaabef4",
                                                "text": "Le principal composant de l’ecstasy est le méthylènedioxyméthamphétamine ou MDMA, chaque comprimé en contient de 60 à 120 milligrammes."
                                            },
                                            {
                                                "example_id": "9d8a4fe6-47e7-4c52-a213-9a9d961bdda2",
                                                "sense_id": "c5a5c9db-792e-3fff-83bc-433cfbaabef4",
                                                "text": "Alors, théoriquement, la MDMA est le principe actif de l’ecstasy"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
