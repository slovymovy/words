                            {
                                "example_id": "7e31a1cc-0a58-4254-acd8-477efdfa1680",
                                "sense_id": "aa0bfcd3-368c-313e-9f1c-33f6a590eeda",
                                "text": "‘In fifteen minutes I will be at the carpark, sitting hopefully inside a puce Reliant Scimitar.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "3efbf343-8f25-3158-b915-28d9d84d4ee0",
                        "entry_id": "05e09f93-8c99-3209-860f-04efd73cda34",
                        "glosses": [
                            "It is hoped that; I hope; we hope."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f060d02f-2252-4057-8f38-7bfda4f1c477",
                                "sense_id": "3efbf343-8f25-3158-b915-28d9d84d4ee0",
                                "text": "Hopefully, my father will arrive in time for the show."
                            },
                            {
                                "example_id": "6dfd3f14-5618-404a-a5b9-05fafedf189d",
                                "sense_id": "3efbf343-8f25-3158-b915-28d9d84d4ee0",
                                "text": "She was buried with her mom and hopefully they are together now."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2e10f0a-dba2-4fb2-92a6-427fda98ce82",
                        "source_entry_id": "05e09f93-8c99-3209-860f-04efd73cda34",
