                "senses": [
                    {
                        "sense_id": "abb20392-c491-36df-ad4b-8c8edc8f5297",
                        "entry_id": "cdb4666f-97e2-3089-b2fe-659be787dc18",
                        "glosses": [
                            "Ausnahme, Abweichung von der Regel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b89542-4392-4dd9-b980-eb3a2e2c2851",
                                "sense_id": "abb20392-c491-36df-ad4b-8c8edc8f5297",
                                "text": "Es wird ein Sonderfall bleiben, dass Ausländer wählen dürfen."
                            },
                            {
                                "example_id": "35fdcdb6-c4a5-41f3-8a24-c386f0bd4315",
                                "sense_id": "abb20392-c491-36df-ad4b-8c8edc8f5297",
                                "text": "„Die Lebenssituation der Sámi und Rentierzüchter ist ein absoluter Sonderfall in Europa.“"
                            },
                            {
                                "example_id": "3bbcdbfc-600f-4531-bb07-b754f065f4c5",
                                "sense_id": "abb20392-c491-36df-ad4b-8c8edc8f5297",
                                "text": "„Auch ein witzig gemaltes Portrait kann man sich vorstellen, ganz abgesehen davon, dass es ja als dessen Sonderfall die Karikatur gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "872237e3-63ec-4898-b97d-d11b63f0e9c2",
                        "source_entry_id": "cdb4666f-97e2-3089-b2fe-659be787dc18",
                        "source_sense_id": "abb20392-c491-36df-ad4b-8c8edc8f5297",
                        "source_sense_description": "Ausnahme, Abweichung von der Regel",
                        "target_lang_word": "special case",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "special case",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "398216c8-74ea-3b51-97d5-de61d8395063",
                                        "entry_id": "ad817ade-91dc-3d0e-805c-98f62991593b",
                                        "glosses": [
                                            "A specialized instance of a more general phenomenon, category, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc5e4e37-2614-4d58-b0b4-f0656e2e76c4",
                                                "sense_id": "398216c8-74ea-3b51-97d5-de61d8395063",
                                                "text": "For quotations using this term, see Citations:special case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06d9819d-1f07-3026-bc82-6ac4812d4877",
                                        "entry_id": "ad817ade-91dc-3d0e-805c-98f62991593b",
                                        "glosses": [
                                            "A specialized instance of a more general phenomenon, category, etc.",
                                            "A class of phenomena that is a subset of a more general class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eff82ae-99a6-489c-855a-c2843fe9a461",
                                                "sense_id": "06d9819d-1f07-3026-bc82-6ac4812d4877",
                                                "text": "Habermas, e.g., put forward that the legal discourse should not be understood as a special case of the moral discourse because in law next to moral reasons there are also ethical and pragmatic reasons to play a legitimate part (J. Habermas, Between Facts and Norms, 230 ff.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee825e63-34fa-35ca-aaa6-eccdc008febc",
                                        "entry_id": "ad817ade-91dc-3d0e-805c-98f62991593b",
                                        "glosses": [
                                            "A specialized instance of a more general phenomenon, category, etc.",
                                            "A theorem or other statement that follows directly from a more general statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3330561-e0d0-4886-83bc-e89cf4ec344d",
                                                "sense_id": "ee825e63-34fa-35ca-aaa6-eccdc008febc",
                                                "text": "This is a special case of equation 4.9.10 with h(x)#61;K#95;v(#92;betax)."
                                            },
                                            {
                                                "example_id": "b5d90686-7537-40c8-870c-912211eb13f4",
                                                "sense_id": "ee825e63-34fa-35ca-aaa6-eccdc008febc",
                                                "text": "Clearly, the Pythagorean theorem is a special case of the more general theorem, arrived at by letting r = 1."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "special case",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d81a1bb5-2eb7-3cf6-9545-0277483e064c",
                                        "entry_id": "0bf91807-24ee-3e5a-bd0e-d129f7bddfb9",
                                        "glosses": [
                                            "To treat something as a special case; to handle in an explicitly different way."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51f221d4-2303-4143-bbc6-310faf3c2a87",
                                                "sense_id": "d81a1bb5-2eb7-3cf6-9545-0277483e064c",
                                                "text": "Special-casing the 100 most common words in English might speed things up."
                                            },
                                            {
                                                "example_id": "4259c672-7a4e-46b7-81fb-84c94f467695",
                                                "sense_id": "d81a1bb5-2eb7-3cf6-9545-0277483e064c",
                                                "text": "If these programs work as well as they can even without going through QuickDraw, what's the penalty for going around the system and special casing?"
                                            },
                                            {
                                                "example_id": "cca764b1-5381-4162-801f-f09829eacc26",
                                                "sense_id": "d81a1bb5-2eb7-3cf6-9545-0277483e064c",
                                                "text": "Other languages have since special-cased that kind of computation with, for example, generators in Python or something where you can yield values."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "272859ef-6a47-47af-9e5b-bf96af6567b8",
                        "source_entry_id": "cdb4666f-97e2-3089-b2fe-659be787dc18",
