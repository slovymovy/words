                                                "text": "Une œuvre géniale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d03fa09-f96e-3deb-95da-fbe7fcd79dde",
                                        "entry_id": "9a55a1e0-4b6f-36ea-ac2a-260b0e2615e6",
                                        "glosses": [
                                            "(Utilisé aussi comme une interjection) Excellent, remarquable, extraordinaire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58dbeba-791c-4c91-848b-3c8550397712",
