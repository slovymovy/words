                        ],
                        "examples": [
                            {
                                "example_id": "fc004522-b087-485d-abaa-12539c9bf9e2",
                                "sense_id": "299242f4-b378-3522-aaf7-1c65926e7c62",
                                "text": "„Hinter der Bar stehen Vietnamesinnen in Skianoraks und bedienen die gepiercte Jugend. Dazwischen hockt ein alter Zausel und senkt dann und wann sein zerklüftetes Gesicht in einen Bierhumpen.“"
                            },
                            {
                                "example_id": "5fc36804-8ba6-42b1-838a-5afa2045bb23",
                                "sense_id": "299242f4-b378-3522-aaf7-1c65926e7c62",
                                "text": "„Er ist auf dem besten Weg, ein mürrischer, verschlossener, ewig mit dem Schicksal hadernder Zausel zu werden […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
