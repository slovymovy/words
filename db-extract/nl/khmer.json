                        "glosses": [
                            "lid van een volk in het hedendaagse Cambodja en delen van zuidelijk Vietnam en Noordoost-Thailand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1451b9-d3b8-4dcd-8e4d-f8806988c909",
                                "sense_id": "25766332-c5ce-338f-8b6f-4e759ffb784b",
                                "text": "(…) het personeel is er op getraind om elke Khmer die binnen komt duidelijk de pool regels uit te leggen."
                            },
                            {
                                "example_id": "53cddbfb-ccbc-4dcb-9bf5-d18942973688",
                                "sense_id": "25766332-c5ce-338f-8b6f-4e759ffb784b",
                                "text": "De rijke Khmers werken bij de ministeries en de overheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "d24b3887-0da0-3db0-81d6-c473c24e5cfb",
                        "entry_id": "d9d9df72-a45e-32aa-8443-62505af3172d",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord Khmer"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0b307dfd-3120-4057-8dbb-b3991568d436",
                                "sense_id": "d24b3887-0da0-3db0-81d6-c473c24e5cfb",
                                "text": "Degenen die de Cambodjaanse genocide ontkennen zijn erop uit de nagedachtenis van de miljoenen omgekomen Khmer te doen vergeten."
                            }
                        ]
                    }
