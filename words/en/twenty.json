                                "ru": "В классе <w>двадцать</w> учеников.",
                                "zh": "教室里有<w>二十</w>名学生。"
                            }
                        },
                        {
                            "text": "He has worked at the company for <w>twenty</w> years.",
                            "target_lang_translations": {
                                "ru": "Он проработал в компании <w>двадцать</w> лет.",
                                "zh": "他在那家公司工作了二十年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "top twenty",
                        "twenty-four seven",
                        "twenty-twenty vision"
