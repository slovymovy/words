    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "74b2b4ba-a702-3dd4-aa24-4a81969f4474",
                "word": "placket",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6582b534-b4db-43fc-a89d-6c224c5ed13f",
                        "entry_id": "74b2b4ba-a702-3dd4-aa24-4a81969f4474",
                        "tags": [
                            "plural"
                        ],
                        "form": "plackets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6d4ab71-bac6-31f9-8905-305a80200f30",
                        "entry_id": "74b2b4ba-a702-3dd4-aa24-4a81969f4474",
                        "glosses": [
                            "A slit or other opening in an item of clothing, to allow access to pockets or fastenings"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ba4172-36a6-4e33-9430-7a9178cb0534",
                                "sense_id": "d6d4ab71-bac6-31f9-8905-305a80200f30",
                                "text": "Dislike dressing together. Nicked myself shaving. Biting her nether lip, hooking the placket of her skirt."
                            },
                            {
                                "example_id": "82f0435e-4d3f-4638-a5b5-8a9912feb6ca",
                                "sense_id": "d6d4ab71-bac6-31f9-8905-305a80200f30",
                                "text": "When the placket of his shirt gave way, the stones tore freely into the skin on his chest and back, and he no longer imagined Lucy Hartley enjoying his guitar serenades—he wondered if he would get to the roof alive."
                            }
                        ]
                    },
                    {
                        "sense_id": "53ae4834-d6d7-354b-a250-2232211c6ce2",
                        "entry_id": "74b2b4ba-a702-3dd4-aa24-4a81969f4474",
                        "glosses": [
                            "A petticoat, especially an underpetticoat."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f2cb71c9-0460-4eae-9f01-25f4be24b3a0",
                                "sense_id": "53ae4834-d6d7-354b-a250-2232211c6ce2",
                                "text": "Is there no manners left among maids?VVill they\nvveare their plackets vvhere they ſhould bear their faces?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3c7182af-10a7-35fb-8932-c0c86d4dd460",
                        "entry_id": "74b2b4ba-a702-3dd4-aa24-4a81969f4474",
                        "glosses": [
                            "A woman."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "56c99d20-bdb9-4c31-81b7-b2d3e500a4c1",
                                "sense_id": "3c7182af-10a7-35fb-8932-c0c86d4dd460",
                                "text": "[…]: after this,the vengeance on the vvhole\nCamp,or rather,the bone-ach,for that,me thinkes is the\ncurſe dependant on thoſe that vvarre for a placket."
                            },
                            {
                                "example_id": "97f2356d-ea88-47cb-adbc-0555d61ca5a2",
                                "sense_id": "3c7182af-10a7-35fb-8932-c0c86d4dd460",
                                "text": "[…] was that brave [hart] made to pant for a placket: and now i’th’ dog-days too, when nothing dare love!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e04fe428-f50b-39f3-93da-0aebab1257ec",
                        "entry_id": "74b2b4ba-a702-3dd4-aa24-4a81969f4474",
                        "glosses": [
                            "A woman's pocket."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fc75daa6-58e8-351a-b0a7-d1d877d00acb",
                        "entry_id": "74b2b4ba-a702-3dd4-aa24-4a81969f4474",
                        "glosses": [
                            "A leather jacket strengthened with strips of steel."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
