        "fr-extract.jsonl": [
            {
                "entry_id": "5741aa75-1531-364f-8bf2-f171d9a69843",
                "word": "claquement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "388822d1-de2c-4ca1-a6b6-f6960307baf0",
                        "entry_id": "5741aa75-1531-364f-8bf2-f171d9a69843",
                        "tags": [
