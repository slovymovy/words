                        "translation_id": "a931c05f-8a24-4dff-9aeb-b821056ed8fd",
                        "source_entry_id": "3f960692-2173-3f44-8b48-82ed8c74804a",
                        "source_sense_id": "e2210503-9f8b-3fbc-85f2-800999491c29",
