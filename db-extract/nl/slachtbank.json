                    },
                    {
                        "sense_id": "d0018030-0164-3617-8f3b-c184c465de31",
                        "entry_id": "09925877-9430-3fbd-ab43-326e5abf9467",
                        "glosses": [
                            "plaats waar mensen bestraft of gedood worden"
                        ],
