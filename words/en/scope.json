                    "target_lang_definitions": {
                        "ru": "Провести беглый осмотр; осмотреться или изучить местность.",
                        "de": "Eine flüchtige Untersuchung durchführen; sich umsehen oder ein Gebiet erkunden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмотреться",
                                "target_lang_sense_clarification": "изучить обстановку"
                            },
                            {
                                "target_lang_word": "разведать",
                                "target_lang_sense_clarification": "изучить местность заранее"
                            },
                            {
                                "target_lang_word": "оценить",
                                "target_lang_sense_clarification": "бегло изучить ситуацию"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auskundschaften",
                                "target_lang_sense_clarification": "ein Gebiet gezielt erkunden"
                            },
                            {
                                "target_lang_word": "sich umsehen",
                                "target_lang_sense_clarification": "die Umgebung betrachten"
                            },
                            {
                                "target_lang_word": "ausspähen",
                                "target_lang_sense_clarification": "etwas oder jemanden beobachten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86ebdbb4-2de7-31cc-9bfc-2f7017c1e288",
                    "sense_definition": "To define the boundaries or extent of a project or investigation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>scope</w> the investigation before developing a work plan.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>определить рамки</w> расследования перед разработкой плана работы.",
                                "de": "Wir müssen den <w>Rahmen</w> der Untersuchung festlegen, bevor wir einen Arbeitsplan entwickeln."
                            }
                        },
                        {
                            "text": "The committee will <w>scope</w> the project to ensure it stays on budget.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>очертит</w> границы проекта, чтобы гарантировать соблюдение бюджета.",
                                "de": "Das Komitee wird den <w>Rahmen</w> des Projekts abstecken, um sicherzustellen, dass es im Budget bleibt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scope a project",
                        "scope the investigation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business/professional"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определить границы или масштаб проекта или расследования.",
                        "de": "Die Grenzen oder den Umfang eines Projekts oder einer Untersuchung festlegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять рамки",
                                "target_lang_sense_clarification": "устанавливать границы проекта"
                            },
                            {
                                "target_lang_word": "очерчивать",
                                "target_lang_sense_clarification": "обозначать масштаб работ"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abgrenzen",
                                "target_lang_sense_clarification": "den Umfang eines Projekts definieren"
                            },
                            {
                                "target_lang_word": "den Rahmen festlegen",
                                "target_lang_sense_clarification": "die Grenzen einer Untersuchung bestimmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05bd9158-8957-363e-b004-1e6fd6ac8dde",
                    "sense_definition": "To perform a medical procedure involving a camera or tube, such as an endoscopy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon will <w>scope</w> the player's knee to repair the ligament.",
                            "target_lang_translations": {
                                "ru": "Хирург <w>проведет осмотр</w> колена игрока, чтобы восстановить связку.",
                                "de": "Der Chirurg wird das Knie des Spielers <w>arthroskopieren</w>, um das Band zu reparieren."
                            }
                        },
                        {
                            "text": "They decided to <w>scope</w> his throat to check for any blockage.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>обследовать</w> его горло, чтобы проверить наличие закупорки.",
                                "de": "Sie entschieden sich, seinen Hals zu <w>spiegeln</w>, um nach einer Blockade zu suchen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "medical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить медицинскую процедуру с использованием камеры или трубки, например, эндоскопию.",
                        "de": "Ein medizinisches Verfahren mit einer Kamera oder einem Schlauch durchführen, wie eine Endoskopie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить осмотр",
                                "target_lang_sense_clarification": "с помощью эндоскопа"
                            },
                            {
                                "target_lang_word": "делать скопию",
                                "target_lang_sense_clarification": "выполнять процедуру"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "spiegeln",
                                "target_lang_sense_clarification": "eine medizinische Untersuchung durchführen"
                            },
                            {
                                "target_lang_word": "endoskopieren",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff für die Untersuchung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
