                                "de": "Mein Bruder und ich haben sehr <w>verschiedene</w> Charaktere.",
                                "fr": "Mon frère et moi avons des caractères très <w>différents</w>.",
                                "it": "Mio fratello ed io abbiamo caratteri molto <w>diversi</w>.",
                                "cs": "Můj bratr a já máme velmi <w>různé</w> povahy.",
                                "tr": "Erkek kardeşim ve benim çok <w>farklı</w> karakterlerimiz var.",
                                "es": "Mi hermano y yo tenemos caracteres muy <w>diferentes</w>.",
                                "zh": "我和我哥哥的性格非常<w>不同</w>。"
                            }
                        },
                        {
                            "text": "Ze wonen in twee totaal <w>verschillende</w> huizen.",
                            "target_lang_translations": {
                                "en": "They live in two totally <w>different</w> houses.",
                                "ru": "Они живут в двух совершенно <w>разных</w> домах.",
                                "pl": "Mieszkają w dwóch całkowicie <w>różnych</w> domach.",
                                "de": "Sie wohnen in zwei völlig <w>unterschiedlichen</w> Häusern.",
                                "fr": "Ils habitent dans deux maisons totalement <w>différentes</w>.",
                                "it": "Vivono in due case totalmente <w>diverse</w>.",
                                "cs": "Bydlí ve dvou naprosto <w>odlišných</w> domech.",
                                "tr": "Tamamen <w>farklı</w> iki evde yaşıyorlar.",
                                "es": "Viven en dos casas totalmente <w>distintas</w>.",
                                "zh": "他们住在两栋完全<w>不同</w>的房子里。"
