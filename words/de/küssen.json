                    "semantic_group_id": "kissen_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In alten Schriften aus dem Mittelalter bezeichnete man ein bequemes Polster manchmal als <w>Küssen</w>."
                        },
                        {
                            "text": "Der Großvater legte seinen Kopf auf das weiche <w>Küssen</w>, um sich etwas auszuruhen."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
