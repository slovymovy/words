    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "58a0fea4-e8e8-3bca-8b20-c3d701e6e3bd",
                    "sense_definition": "На большом расстоянии от поверхности вниз или внутрь.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Корни этого старого дерева уходят <w>глубоко</w> в землю.",
                            "target_lang_translations": {
                                "en": "The roots of this old tree go <w>deep</w> into the ground.",
                                "de": "Die Wurzeln dieses alten Baumes reichen <w>tief</w> in die Erde."
                            }
                        },
                        {
                            "text": "Мы решили не нырять <w>глубоко</w>, так как вода была мутной.",
                            "target_lang_translations": {
                                "en": "We decided not to dive <w>deep</w> because the water was murky.",
                                "de": "Wir haben beschlossen, nicht <w>tief</w> zu tauchen, da das Wasser trüb war."
                            }
                        }
                    ],
                    "antonyms": [
                        "мелко"
                    ],
                    "common_phrases": [
                        "глубоко дышать",
                        "глубоко под землей",
                        "глубоко в лесу",
                        "зарыть глубоко"
                    ],
                    "target_lang_definitions": {
                        "en": "Far down or far into something from the surface.",
                        "de": "In großer Entfernung von der Oberfläche nach unten oder innen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deep",
                                "target_lang_sense_clarification": "adverb, physical distance"
                            },
                            {
                                "target_lang_word": "deeply",
                                "target_lang_sense_clarification": "adverb, physical position"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "tief",
                                "target_lang_sense_clarification": "Adverb, räumliche Tiefe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3afd8a20-bcfa-38c7-b04c-8bf7b8398015",
                    "sense_definition": "О наличии большой глубины где-либо (обычно используется как сказуемое в безличных предложениях).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не заходи в воду слишком далеко, там сразу <w>глубоко</w>.",
                            "target_lang_translations": {
                                "en": "Don't go too far into the water, it gets <w>deep</w> immediately there.",
                                "de": "Geh nicht zu weit ins Wasser, dort ist es sofort <w>tief</w>."
                            }
                        },
                        {
                            "text": "В этом месте реки совсем не <w>глубоко</w>.",
                            "target_lang_translations": {
                                "en": "It is not <w>deep</w> at all in this part of the river.",
                                "de": "An dieser Stelle des Flusses ist es überhaupt nicht <w>tief</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "мелко"
                    ],
                    "common_phrases": [
                        "здесь глубоко",
                        "там глубоко",
                        "слишком глубоко"
                    ],
                    "target_lang_definitions": {
                        "en": "Describing a place (usually water) where there is great depth.",
                        "de": "Über das Vorhandensein einer großen Tiefe an einem Ort (meist als Prädikativ in unpersönlichen Sätzen verwendet)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deep",
                                "target_lang_sense_clarification": "adjective, describing depth"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "tief",
                                "target_lang_sense_clarification": "Prädikativ, Beschreibung der Wassertiefe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22b62ba3-4ecf-30bd-889e-82ad41d4411e",
                    "sense_definition": "Очень сильно, в высшей степени (о чувствах, состояниях или процессах).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "figurative_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>глубоко</w> уважаю вашего коллегу за его профессионализм.",
                            "target_lang_translations": {
                                "en": "I <w>deeply</w> respect your colleague for his professionalism.",
                                "de": "Ich respektiere Ihren Kollegen wegen seiner Professionalität <w>zutiefst</w>."
                            }
                        },
                        {
                            "text": "Он <w>глубоко</w> ошибается, если думает, что мы согласимся.",
                            "target_lang_translations": {
                                "en": "He is <w>deeply</w> mistaken if he thinks we will agree.",
                                "de": "Er irrt sich <w>gewaltig</w>, wenn er glaubt, dass wir zustimmen werden."
                            }
                        }
                    ],
                    "synonyms": [
                        "сильно",
                        "очень",
                        "серьезно"
                    ],
                    "common_phrases": [
                        "глубоко уважать",
                        "глубоко ошибаться",
                        "глубоко спать",
                        "глубоко сожалеть"
                    ],
                    "target_lang_definitions": {
                        "en": "Very strongly; to a high degree (used with feelings, states, or mistakes).",
                        "de": "Sehr stark, in höchstem Maße (in Bezug auf Gefühle, Zustände oder Prozesse)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deeply",
                                "target_lang_sense_clarification": "intensifier"
                            },
                            {
                                "target_lang_word": "profoundly",
                                "target_lang_sense_clarification": "formal intensifier"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "tief",
                                "target_lang_sense_clarification": "Adverb, Verstärkung von Gefühlen oder Zuständen"
                            },
                            {
                                "target_lang_word": "zutiefst",
                                "target_lang_sense_clarification": "Adverb, gehobene Verstärkung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ddd6430-1e45-31d2-a0b0-e05bc4e99b6e",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>глубокий</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это горное озеро невероятно <w>глубоко</w> и прозрачно.",
                            "target_lang_translations": {
                                "en": "This mountain lake is incredibly <w>deep</w> and clear.",
                                "de": "Dieser Bergsee ist unglaublich <w>tief</w> und klar."
                            }
                        },
                        {
                            "text": "Его понимание проблемы было <w>глубоко</w> и точно.",
                            "target_lang_translations": {
                                "en": "His understanding of the problem was <w>profound</w> and accurate.",
                                "de": "Sein Verständnis des Problems war <w>tiefgründig</w> und präzise."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Having great depth (short form of the adjective).",
                        "de": "Kurzform des sächlichen Singulars des Adjektivs 'глубокий' (tief)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deep",
                                "target_lang_sense_clarification": "adjective"
                            },
                            {
                                "target_lang_word": "profound",
                                "target_lang_sense_clarification": "adjective, abstract meaning"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "tief",
                                "target_lang_sense_clarification": "Adjektiv, physische oder abstrakte Tiefe"
                            },
                            {
                                "target_lang_word": "tiefgründig",
                                "target_lang_sense_clarification": "Adjektiv, im Sinne von intellektuell tief"
                            }
                        ]
                    }
                }
            ]
        }
    ]
