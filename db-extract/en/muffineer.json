                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7831cd-60b8-42b7-8eec-7f8b1155dcab",
                                "sense_id": "512a3ee6-6566-31b7-b463-8977be77dbc7",
                                "text": "He was sitting at his table by the light of a solitary candle, with a pen in one hand, and a muffineer in the other, with which he occasionally sprinkled salt on the wick, to make it burn blue."
                            },
                            {
                                "example_id": "84b0c676-bffe-4259-974c-d76d32963be6",
                                "sense_id": "512a3ee6-6566-31b7-b463-8977be77dbc7",
                                "text": "The handled spice dredger was superseded during the 1760s by the handleless caster used for cinnamon and known to collectors as the muffineer, a name brought into use for such a caster early in the nineteenth century."
                            },
                            {
                                "example_id": "e9e51dc4-a64d-49bd-bece-bd61532bed46",
                                "sense_id": "512a3ee6-6566-31b7-b463-8977be77dbc7",
                                "text": "The piece was an eighteenth-century silver muffineer, or sugar shaker."
                            }
                        ]
