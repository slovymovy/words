                ],
                "senses": [
                    {
                        "sense_id": "0523822d-f596-3592-830e-c1fcc6afc78d",
                        "entry_id": "5b7f5071-11c3-3868-9ea2-8da3175b282a",
                        "glosses": [
                            "Pain brioché au raisin sec."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "af4ef2b5-9605-4cf9-96ae-8cbdcc70c9a8",
                                "sense_id": "0523822d-f596-3592-830e-c1fcc6afc78d",
                                "text": "Le lendemain, en entrant au réfectoire, je fus ébloui par un « cramique », un vrai cramique plein de corinthes, qui, dans la manne du Kasaï, remplaçait les bananes d’or."
                            },
                            {
                                "example_id": "a1ef7718-0e1a-4930-884a-00cd678b3d5c",
                                "sense_id": "0523822d-f596-3592-830e-c1fcc6afc78d",
                                "text": "Une gourmandise nationale est la [sic] cramique, intermédiaire entre la brioche et le pain, et qui fait merveille dans le chocolat et le café au lait."
                            },
                            {
                                "example_id": "1c3b3835-98ee-4cd0-b75a-56923009fe00",
                                "sense_id": "0523822d-f596-3592-830e-c1fcc6afc78d",
                                "text": "La jeune fille s’apprêtait à croquer avec application dans le moelleux d’une cramique, parfait intermédiaire entre la brioche et le pain, qui faisait merveille, dit-on, trempée dans une tasse de five o’clock."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0abd9306-1a08-4164-9e04-7a7d12d70b7c",
                        "source_entry_id": "5b7f5071-11c3-3868-9ea2-8da3175b282a",
                        "source_sense_id": "0523822d-f596-3592-830e-c1fcc6afc78d",
