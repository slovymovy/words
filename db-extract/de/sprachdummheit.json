                "senses": [
                    {
                        "sense_id": "780301ce-e785-36cd-b203-025bb93df060",
                        "entry_id": "c6d9b7e0-591a-3dc8-9291-601a1521dc0d",
                        "glosses": [
                            "aufgrund unzulänglicher Fähigkeit, eine Sprache angemessen zu verwenden, oder aufgrund von Achtlosigkeit deutlich werdender Verstoß gegen eine Regel, nach der sprachliche Einheiten gebildet (und verstanden) werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9829896-4750-4588-80c7-fb5cf55528c9",
                                "sense_id": "780301ce-e785-36cd-b203-025bb93df060",
                                "text": "In Lokalzeitungen und im Rundfunk sind Sprachdummheiten häufiger als in überregionalen Tageszeitungen."
                            },
                            {
                                "example_id": "b61e3270-90c6-47b6-9b2d-64b97fa0ff26",
                                "sense_id": "780301ce-e785-36cd-b203-025bb93df060",
                                "text": "„Ein Buch ohne Fehl; nur schade, daß wir es nicht im Original zu lesen vermögen. Denn die Übersetzung hat ein paar störende Haken und Ösen, verursacht durch Sprachdummheiten, wie sie im Alltagsdeutsch ihr Unwesen treiben.“"
                            },
                            {
                                "example_id": "862e1c6f-1a3e-47a8-a9ab-3a9be1a9b7b4",
                                "sense_id": "780301ce-e785-36cd-b203-025bb93df060",
                                "text": "„Es fällt uns heute schwer, zu glauben, daß Sprachdummheiten, wie Kraus sie aufgreift, jemals in einer ernsthaften Zeitung erschienen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
