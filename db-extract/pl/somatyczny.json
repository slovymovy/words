                                "target_senses": [
                                    {
                                        "sense_id": "bc3a5bae-e68f-3070-a966-90aa7686294c",
                                        "entry_id": "e511a153-4e12-3593-8b44-ffadf355b8b3",
                                        "glosses": [
                                            "Part of, or relating to the body of an organism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb4176e-edd3-4bf7-a9d6-58fb09df16eb",
                                                "sense_id": "bc3a5bae-e68f-3070-a966-90aa7686294c",
                                                "text": "The somatic and botanical metaphors in this passage were commonplace in the 1700s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca09c1d-f201-32f9-a9f1-0255af34b8e2",
                                        "entry_id": "e511a153-4e12-3593-8b44-ffadf355b8b3",
                                        "glosses": [
                                            "Pertaining, and restricted, to an individual; not inheritable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb77ced-6711-4d95-a78e-9f0532f2700e",
                                                "sense_id": "0ca09c1d-f201-32f9-a9f1-0255af34b8e2",
                                                "text": "a somatic epitype"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ec771c3-33e8-36b0-be63-7f6f6ee58e10",
                                        "entry_id": "e511a153-4e12-3593-8b44-ffadf355b8b3",
                                        "glosses": [
                                            "Of or relating to the wall of the body; somatopleuric; parietal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a316d06-1a07-4748-a2cb-3aa25df267bf",
                                                "sense_id": "3ec771c3-33e8-36b0-be63-7f6f6ee58e10",
                                                "text": "the somatic stalk of the yolk sac of an embryo"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f2b9f09-70f4-4062-8d0a-3f9bf4486076",
                        "source_entry_id": "f5216397-10be-371c-839f-7563bcc419ba",
                        "source_sense_id": "644b6b02-f4be-3276-8c31-068243a42cf8",
                        "target_lang_word": "somatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                                        "glosses": [
                                            "Relatif au corps dans sa dimension physique, par opposition à sa dimension psychique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d43102-6943-46a3-a8e3-869e70baf0d4",
                                                "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                                "text": "Les violences et maltraitances, somatiques et/ou psychiques, ne sont en effet pas toutes et pas nécessairement, tant s'en faut, à rapporter à des relations d'emprise."
                                            },
                                            {
                                                "example_id": "ec1df4f2-b55e-42ac-aa4d-e4e3bd41deba",
                                                "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                                "text": "Ici, les adolescents souffrant de TCA et d’obésité sont pris en charge de manière pluridisciplinaire (somatique et psychique), en consultation, en hospitalisation complète ou de jour, de manière individuelle, familiale, groupale en fonction des besoins, précise le Pʳ Marie Rose Moro, chef de service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f08ca5-4e20-3f67-b481-96687b677d45",
                                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                                        "glosses": [
                                            "Relatif au soma, aux cellules non reproductrices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0e6c7a-bd6c-4416-8336-43e9de67ec81",
                                                "sense_id": "81f08ca5-4e20-3f67-b481-96687b677d45",
                                                "text": "Une majorité de chercheurs semblent d’accord sur l’essentiel : s’engager à ne pas toucher au génome de l’embryon humain, ni aux cellules reproductrices, et se limiter à corriger les gènes porteurs de maladies génétiques graves situés dans les cellules somatiques, c’est-à-dire non sexuelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b788c72-78ca-304d-84d1-9a4b96c30989",
                                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                                        "glosses": [
                                            "Relatif au contrôle volontaire des mouvements du corps et à la perception des stimuli externes via des récepteurs spécifiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f48c35f-bde9-4e19-91b5-d326e26ae3b4",
                        "source_entry_id": "f5216397-10be-371c-839f-7563bcc419ba",
                        "source_sense_id": "644b6b02-f4be-3276-8c31-068243a42cf8",
                        "target_lang_word": "somatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df0bd093-78f1-317e-b51f-cebf1be72323",
                                        "entry_id": "86ab5ef6-bb70-3ef4-9358-9e318cb28c62",
                                        "glosses": [
                                            "den Körper betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "143d7fde-89f2-4b2e-b4c5-6a0a54665f8a",
                                                "sense_id": "df0bd093-78f1-317e-b51f-cebf1be72323",
                                                "text": "Ihr Unwohlsein hat keine somatischen Ursachen."
                                            },
                                            {
                                                "example_id": "e3065fe3-9568-4ca0-8a01-d69285bb3319",
                                                "sense_id": "df0bd093-78f1-317e-b51f-cebf1be72323",
                                                "text": "„Zahnärzte sind gefordert, ihre Diagnosen und Therapien nicht nur aus fachbegrenzt somatischer Sicht zu sehen, sondern auch allgemeinmedizinische, psychische und soziale Faktoren der Krankheit zu berücksichtigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2897c02-dcca-3316-b790-3e9650e5b4f0",
                                        "entry_id": "86ab5ef6-bb70-3ef4-9358-9e318cb28c62",
                                        "glosses": [
                                            "zum Körper gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d869dcf-a634-439d-96d5-e83b9fb75814",
                                                "sense_id": "f2897c02-dcca-3316-b790-3e9650e5b4f0",
                                                "text": "Fortpflanzungszellen und somatische Zellen unterscheiden sich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9751331-31f5-4661-a949-4f2c3e7c2096",
                        "source_entry_id": "f5216397-10be-371c-839f-7563bcc419ba",
                        "source_sense_id": "644b6b02-f4be-3276-8c31-068243a42cf8",
                        "target_lang_word": "соматический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "соматический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba3db99-ecc7-3b24-bc1c-84a6fdc47b20",
                                        "entry_id": "dd966b0b-4bcc-34f4-84fa-b73834cd1e57",
                                        "glosses": [
                                            "биол. связанный с телом; телесный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b2f6f6-83d7-4dfb-85b5-ae93bf1eeb9d",
                                                "sense_id": "5ba3db99-ecc7-3b24-bc1c-84a6fdc47b20",
                                                "text": "Почкообразная стадия в развитии грудей рано (в 7/10 лет) наступает в череде соматических изменений, сопровождающих приближение половой зрелости."
                                            },
                                            {
                                                "example_id": "6df0e371-54e7-42f7-90db-9c26804755d8",
                                                "sense_id": "5ba3db99-ecc7-3b24-bc1c-84a6fdc47b20",
                                                "text": "Соматическое (общее) состояние по всем показателям было просто отличное."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaec8fbf-c7e4-31c8-b8ae-c34eb03b7a38",
                                        "entry_id": "dd966b0b-4bcc-34f4-84fa-b73834cd1e57",
                                        "glosses": [
                                            "мед. относящийся к нерепродуктивным частям тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9314387-738b-4279-9765-de60ab4663cf",
                                                "sense_id": "aaec8fbf-c7e4-31c8-b8ae-c34eb03b7a38",
                                                "text": "И в каждой из этих соматических клеток (сома — тело) — весь набор генов, существовавших в исходной зиготе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07100eee-0d8c-3153-8d07-ef66ed3f8e25",
                                        "entry_id": "dd966b0b-4bcc-34f4-84fa-b73834cd1e57",
                                        "glosses": [
                                            "мед. относящийся к стенке полости тела (т. е. ко всем частям тела, за исключением внутренних органов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d88ea1-3adc-4ad2-ae74-37a3179528e3",
                                                "sense_id": "07100eee-0d8c-3153-8d07-ef66ed3f8e25",
                                                "text": "Латеральные части мезодермы делятся на два слоя: наружный — соматическая мезодерма и внутренний — спланхническая мезодерма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d67ab3-c8c4-3b95-b09a-bcc0f1ba52db",
                                        "entry_id": "dd966b0b-4bcc-34f4-84fa-b73834cd1e57",
                                        "glosses": [
                                            "мед. относящийся больше к телу, чем к разуму"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a48a693-5624-49ea-b517-9539002971ce",
                                                "sense_id": "97d67ab3-c8c4-3b95-b09a-bcc0f1ba52db",
                                                "text": "Из всех наркотиков наибольшей токсичностью обладает, по-видимому, героин, который даёт резкие соматические расстройства."
                                            },
                                            {
                                                "example_id": "10108d9a-52b2-4fae-bc29-40f4c8d5a9d1",
                                                "sense_id": "97d67ab3-c8c4-3b95-b09a-bcc0f1ba52db",
                                                "text": "Наконец, он подчёркивает необходимость отдавать себе самый детальный отчёт в соматическом состоянии больного, так как некоторые внутренние болезни вызывают несомненные отклонения в душевной деятельности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
