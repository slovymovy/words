                                "target_senses": [
                                    {
                                        "sense_id": "6d061a77-ccb2-3ced-a25c-9f6365a1d27d",
                                        "entry_id": "a1bad62d-5827-32c9-8104-049099e31f55",
                                        "glosses": [
                                            "Money that is obtained at the cost of another's life."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e7ee00-9f4f-4c4b-b6c1-56d00a8967bc",
                                                "sense_id": "6d061a77-ccb2-3ced-a25c-9f6365a1d27d",
                                                "text": "Judas: I don't want your blood money!\nCaiaphas: Oh, that doesn't matter: our expenses are good.\nJudas: I don't need your blood money!\nAnnas: But you might as well take it; we think that you should."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f8d59b-b279-3aaf-b3a2-1b43dee271d6",
                                        "entry_id": "a1bad62d-5827-32c9-8104-049099e31f55",
                                        "glosses": [
                                            "Money paid (as by a killer or the killer's clan) to the family of a person who has been killed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
