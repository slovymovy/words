                        "cross_references": [
                            {
                                "target_word": "vroedman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "28ea758c-49d7-3f4d-a4ac-2f6c60b88d74",
                                        "entry_id": "45f89559-28f8-3bbe-829f-2124c2fc5e7e",
                                        "glosses": [
                                            "verstandig man"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db9cb509-32cd-4258-b8ea-ef17cf229678",
                                                "sense_id": "28ea758c-49d7-3f4d-a4ac-2f6c60b88d74",
                                                "text": "Ik ben van meening dat wy eerst den goeden raed van den Vroedman moesten gaen hooren. Die kerel, zegt men, heeft meer verstand in zynen kleinen vinger, dan wy allen hier te hoop in geheel ons lyf; en daerna, zullen wy naer zynen raed werken."
                                            },
                                            {
                                                "example_id": "070ff419-af49-4022-87bc-62342d086b21",
                                                "sense_id": "28ea758c-49d7-3f4d-a4ac-2f6c60b88d74",
                                                "text": "Walewein 6965: Eens vroetmans raet es dicke goet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a3891f-4e4c-3aa6-b6cf-5930485e8b23",
                                        "entry_id": "45f89559-28f8-3bbe-829f-2124c2fc5e7e",
                                        "glosses": [
                                            "een man die zwangere vrouwen beroepsmatig begeleidt tijdens de bevalling van hun kind"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d7a102d-e0bb-41ec-883e-a218c437e6b3",
                                                "sense_id": "f7a3891f-4e4c-3aa6-b6cf-5930485e8b23",
                                                "text": "Dan volgt een tafereel in het oude burleske genre: Vader Jupiter verkeert in barensnood, en maakt schrikkelijk misbaar. De ‘vroedman’ Vulkaan wordt ontboden: ‘Jou schurk der schurken, Hah aanstonds toe! de bijl in top,"
                                            },
                                            {
                                                "example_id": "0ace0f64-95ff-46c9-be2a-76345497e939",
                                                "sense_id": "f7a3891f-4e4c-3aa6-b6cf-5930485e8b23",
                                                "text": "Eén ding is wel veranderd: sinds de opkomst van de vroedman heet de vroedvrouw 'verloskundige'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4096d8b9-5f3c-4b2b-88b3-20c94609fef0",
                        "source_entry_id": "435b7444-eb90-3218-83c4-4eafed95cc2b",
                        "source_sense_id": "a42df2a8-17b9-343c-9bee-dfbca0974fa8",
                        "source_sense_description": "person who assists women in childbirth",
                        "target_lang_word": "sage-femme homme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sage-femme homme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c457d3e0-5406-3ba0-a89e-dd70cf9f77c3",
                                        "entry_id": "3bb9a470-fdf6-3022-bea4-077f316c0b1d",
                                        "glosses": [
                                            "Homme qui aide à l’accouchement et qui prend en charge le nouveau-né."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4427ed19-5a2d-4f3c-9ed7-28a7f224bef6",
                                                "sense_id": "c457d3e0-5406-3ba0-a89e-dd70cf9f77c3",
                                                "text": "La direction des affaires juridiques de l’APHP n’a été saisie qu’une seule fois pour un problème de refus de soins par un(e) sage-femme homme."
                                            },
                                            {
                                                "example_id": "e56f2e3f-46ad-4901-908b-6042df50adde",
                                                "sense_id": "c457d3e0-5406-3ba0-a89e-dd70cf9f77c3",
                                                "text": "Pour préciser le sexe, on recourait et certains locuteurs recourent encore à l’emploi du terme classificateur antéposé, “femme” : une “femme” professeur, une “femme” ingénieur, une “femme” docteur, policier, chirurgien, etc. Ou, plus rarement, un professeur femme. Il est à noter que, pour des raisons socio-culturelles, l’inverse n’est presque jamais attesté : tout au plus rencontre-t-on quelques « sages-femmes hommes » à la même période."
                                            },
                                            {
                                                "example_id": "8c343921-d52a-4054-9d54-e71e869dbd2d",
                                                "sense_id": "c457d3e0-5406-3ba0-a89e-dd70cf9f77c3",
                                                "text": "C’est particulièrement vrai du côté des sages-femmes hommes (l’appellation, pour une fois, n’a même pas de masculin) dont le pourcentage issu de notre école fausse quand même la statistique nationale de 1 %, notre école de sages-femmes comptant 13 % d’hommes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f64e090-3295-4b96-b364-0466ef3eabbd",
                        "source_entry_id": "435b7444-eb90-3218-83c4-4eafed95cc2b",
                        "source_sense_id": "a42df2a8-17b9-343c-9bee-dfbca0974fa8",
                        "source_sense_description": "person who assists women in childbirth",
                        "target_lang_word": "accoucheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accoucheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbc42e80-5df7-3be2-98b0-4f3212462203",
                                        "entry_id": "6e4b64b7-308b-3261-8bdc-20b06ea4eeaa",
                                        "glosses": [
                                            "Celui dont la profession est de faire des accouchements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f24e6cc-2844-4075-bc52-e048880dab3a",
                                                "sense_id": "bbc42e80-5df7-3be2-98b0-4f3212462203",
                                                "text": "Il se souvint d’une « médicale » télévisée où l’on montrait des nourrissons soumis ainsi aux investigations manuelles d’un accoucheur."
                                            },
                                            {
                                                "example_id": "f713a8c9-f3f0-4d88-b474-ee2a91415810",
                                                "sense_id": "bbc42e80-5df7-3be2-98b0-4f3212462203",
                                                "text": "C’est sur-tout depuis quelque temps que j’ai été constamment appellé auprès des femmes mutilées par des accoucheurs et des matrônes mal-habiles que le nombre de ces victimes s’accroît tous les jours ; […]"
                                            },
                                            {
                                                "example_id": "ce56222d-a34a-412a-b793-d24fef18567a",
                                                "sense_id": "bbc42e80-5df7-3be2-98b0-4f3212462203",
                                                "text": "Mais pour revenir à cette observation, ce chirurgien-accoucheur fut mandé pour secourir une Dame qui étoit en travail depuis trois jours, à laquelle il proposa une prise de ces poudres, qu'elle accepta avec plaisir dans l'espérance qu'elle alloit accoucher très vite ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7d71f44-73bf-4325-ac82-34e11a0d6882",
                        "source_entry_id": "435b7444-eb90-3218-83c4-4eafed95cc2b",
                        "source_sense_id": "a42df2a8-17b9-343c-9bee-dfbca0974fa8",
                        "source_sense_description": "person who assists women in childbirth",
                        "target_lang_word": "sage-homme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sage-homme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3554c8c-173d-39ac-a202-14a113a11204",
                                        "entry_id": "3c83196f-eb01-3162-881c-fe91b72d39fd",
                                        "glosses": [
                                            "Praticien qui aide à l’accouchement et qui prend en charge le nouveau-né."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bccfd339-6561-4b56-a0d1-1eb942b50783",
                                                "sense_id": "c3554c8c-173d-39ac-a202-14a113a11204",
                                                "text": "Le conseil de la Haute école spécialisée bernoise propose que l’admission à l’année d’études 2011/12 soit limitée pour les filières de bachelor suivantes : Physiothérapie, Sage-femme et sage-homme, Soins infirmiers ainsi que Nutrition et diététique."
                                            },
                                            {
                                                "example_id": "c5dd5258-c283-4d88-8214-1e0c26a453f8",
                                                "sense_id": "c3554c8c-173d-39ac-a202-14a113a11204",
                                                "text": "L’objectif est d’une part d’ouvrir l’accès à tous les métiers tant aux garçons qu’aux filles (sage-homme ou éducateur de la petite enfance, policière ou médiamaticienne etc.)."
                                            },
                                            {
                                                "example_id": "80a20932-a41f-4fab-9d34-f471acafe5f5",
                                                "sense_id": "c3554c8c-173d-39ac-a202-14a113a11204",
                                                "text": "La mise en place d’un système d’hospitalisation à domicile s’accompagne, pour le plus grand plaisir des futures mamans, de l’arrivée d’Atlas, un charmant sage-homme."
                                            },
                                            {
                                                "example_id": "9b57ca7c-26ea-45be-879a-413746925fff",
                                                "sense_id": "c3554c8c-173d-39ac-a202-14a113a11204",
                                                "text": "Au cours de sa fructueuse carrière de « sage-homme » reconnu, il effectue quelque 200 accouchements."
                                            },
                                            {
                                                "example_id": "78898f2d-82e9-4f2a-a95c-43121c2840a5",
                                                "sense_id": "c3554c8c-173d-39ac-a202-14a113a11204",
                                                "text": "La grande originalité du lieu, qu’il aime à souligner, tient en fait à la présence d’un «sage-homme», appelé maïeuticien par l’administration, qui s’est toujours contentée de «sage-femme» pour ses homologues féminins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bb38e15-cb44-48ed-8587-19cf4ff050bc",
                        "source_entry_id": "435b7444-eb90-3218-83c4-4eafed95cc2b",
