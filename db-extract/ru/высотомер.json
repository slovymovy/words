                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                                        "entry_id": "75f6c689-31ff-38e4-9903-7377bf4b9bdb",
                                        "glosses": [
                                            "Gerät zur Bestimmung des vertikalen Abstandes (Höhe) eines Objekts zu einer definierten Ebene (meist Erdoberfläche)"
                                        ],
                                        "tags": [
                                            "Geodäsie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e15e35-57ad-416a-bc60-f71681f4d292",
                                                "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                                                "text": "„Neu sind auch ein Altimeter, welcher eine Messung von Höhenmetern in Echtzeit ermöglicht und ein Always-On-Display für besseren Überblick während des Trainings.“"
                                            },
                                            {
                                                "example_id": "c578e4d6-77c2-43f8-aff8-5001e4aa09ad",
                                                "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                                                "text": "„Das führte zu einer Formel, die der Konstruktion des Altimeters zugrunde liegt, mit dem Piloten und Bergsteiger ihre Höhe über dem Meeresspiegel messen.“"
                                            },
                                            {
                                                "example_id": "8c0a42b0-8585-4415-ad54-2e2b971b411f",
                                                "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                                                "text": "„Oliver musste hilflos mit ansehen, wie ihre Höhe auf dem Altimeter bedenklich heruntertickte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
