                    {
                        "sense_id": "99e844de-ff2e-3d56-a904-be47d807426b",
                        "entry_id": "16fef7c4-f9d9-3ac4-a18e-54fea96221dd",
                        "glosses": [
                            "onvriendelijk, nors persoon die vooral de negatieve kant van situaties ziet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1895fa35-bedd-45db-8082-126b7a9d6617",
                                "sense_id": "99e844de-ff2e-3d56-a904-be47d807426b",
                                "text": "Ouderwets heldendom staat voorop en slechts de grootste zuurpruim valt er nog over dat dit brandweerkorps nauwelijks etnische minderheden en al helemaal geen vrouwen telt."
                            },
                            {
                                "example_id": "b72eac9e-0c0c-472e-b125-9d6894535ff2",
                                "sense_id": "99e844de-ff2e-3d56-a904-be47d807426b",
                                "text": "Gibney toont een hardvochtige grootindustrieel en hautaine zuurpruim, die tot zijn laatste snik medewerkers afsnauwt en manipuleert, sjoemelt en belastingen ontduikt, vervuilende en uitbuitende Chinese leveranciers kiest en neerkijkt op liefdadigheid."
                            }
                        ]
                    }
