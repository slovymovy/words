        "fr-extract.jsonl": [
            {
                "entry_id": "358c1722-c50c-359f-993f-462798a37206",
                "word": "paresseusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                        "entry_id": "358c1722-c50c-359f-993f-462798a37206",
                        "glosses": [
                            "Avec paresse ; d’une manière paresseuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc945d80-ce26-4d29-a27a-c088a7a6513f",
                                "sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                                "text": "Mollement enfoncé dans un fauteuil relaxe de la salle de séjour de son appartement privé, un verre de whisky à portée de la main, Jacques Dubois-Rimbert laissait paresseusement errer son regard sur les toiles de maîtres qui ornaient les murs aux teintes beige rosé de la pièce."
                            },
                            {
                                "example_id": "c166b5f5-0189-4750-8e3a-97a4e526ccb6",
                                "sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                                "text": "Pour unique réponse, Geisha s'étira paresseusement et demanda une cigarette."
                            },
                            {
                                "example_id": "1805bc8e-d6e9-4ef3-b044-e1dae321c5e8",
                                "sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                                "text": "[…] ; soleil que l'on recherche l'hiver pour s’encagnarder en le savourant paresseusement, ou soleil que l'on fuit en été vers la parcelle d'ombre qui nous met à l'abri de ses rayons meurtriers."
                            },
                            {
                                "example_id": "b50797d5-cc88-48f4-9754-94ec543a9afb",
                                "sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                                "text": "Il me semble, ma très chère, que vous devez m’en aimer mieux, quand vous êtes couchée bien paresseusement ; c’est là ma fantaisie,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76b90249-6dda-406d-adec-d92442ff5841",
                        "source_entry_id": "358c1722-c50c-359f-993f-462798a37206",
                        "source_sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                        "target_lang_word": "idly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f13dc2-e69e-3291-965b-8325cb43fee9",
                                        "entry_id": "f8266684-e545-3ef1-bac5-47e1f97cf9cb",
                                        "glosses": [
                                            "Without specific purpose, intent or effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37d13f2-2c06-4db3-8de0-db969197d618",
                                                "sense_id": "c5f13dc2-e69e-3291-965b-8325cb43fee9",
                                                "text": "I idly played with the paper, not even realizing I was folding it into a paper airplane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034c1e89-c04e-3724-b9e5-930f7f000a65",
                                        "entry_id": "f8266684-e545-3ef1-bac5-47e1f97cf9cb",
                                        "glosses": [
                                            "In an idle manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "idly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4ba45a-18c6-3f02-adf0-70b11a0ee701",
                                        "entry_id": "97282729-621a-37e0-aa59-c767db450bb0",
                                        "glosses": [
                                            "Alternative spelling of idli."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7d49e53-03d7-4359-9349-f718a76bac44",
                                                "sense_id": "8f4ba45a-18c6-3f02-adf0-70b11a0ee701",
                                                "text": "A Tamil breakfast starts with idly (steamed rice cakes) with sambhar (hot, spicy and sour lentils with vegetables) and rasams (broth of lentil, spiced) and upma (cooked course wheat), lunch is generally dosai (thin crepes), vadas (deep fried nuggets of lentils) with sambhar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2572df27-252f-448d-b18a-b0c842e7af54",
                        "source_entry_id": "358c1722-c50c-359f-993f-462798a37206",
                        "source_sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                        "target_lang_word": "lazily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7436754b-e513-3c3c-b038-afa2d3d9cdb8",
                                        "entry_id": "1ace8064-b5b2-3805-a868-15127edfb3a6",
                                        "glosses": [
                                            "In a lazy manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3e936f3-a9ed-428e-bcf8-7997428dd85a",
                                                "sense_id": "7436754b-e513-3c3c-b038-afa2d3d9cdb8",
                                                "text": "She lazily scrubbed the pot, but without some real elbow grease it wasn't going to get clean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3797bdbb-bc82-3d05-978b-3e70805ef4b3",
                                        "entry_id": "1ace8064-b5b2-3805-a868-15127edfb3a6",
                                        "glosses": [
                                            "In a slow manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "197237c7-2e88-45a2-ae08-d491dd673b58",
                                                "sense_id": "3797bdbb-bc82-3d05-978b-3e70805ef4b3",
                                                "text": "Her ensign dropped limp like a rag; the muzzles of the long eight-inch guns stuck out all over the low hull; the greasy, slimy swell swung her up lazily and let her down, swaying her thin masts."
                                            },
                                            {
                                                "example_id": "ce27f081-fa6b-4c46-b258-b5c4c50cb7a4",
                                                "sense_id": "3797bdbb-bc82-3d05-978b-3e70805ef4b3",
                                                "text": "Disembarkation seemed a slow business. From the deck one watched a \"Merchant Navy\" Pacific drift lazily along the track beside the wall of the Marine Station, and little South Eastern tanks go snorting fussily about."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f0893f7-36c8-40bc-9cb6-a23cce59fd65",
                        "source_entry_id": "358c1722-c50c-359f-993f-462798a37206",
                        "source_sense_id": "8d9854d0-68da-3036-9dca-1843fa8c9d8c",
                        "target_lang_word": "sluggishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sluggishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d775444-5b7f-3261-ae8b-35b515fce075",
                                        "entry_id": "bddf894f-b688-3c20-99c6-0baa8b6b7875",
                                        "glosses": [
                                            "In a sluggish manner; responding or moving slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e553c1b-d93e-4077-89b1-49fa7832338e",
                                                "sense_id": "5d775444-5b7f-3261-ae8b-35b515fce075",
                                                "text": "It hung together in banks, flowing sluggishly down the slope of the land and driving reluctantly before the wind[.]"
                                            },
                                            {
                                                "example_id": "cd991105-c7d4-4b01-9fc8-b802d5418ecb",
                                                "sense_id": "5d775444-5b7f-3261-ae8b-35b515fce075",
                                                "text": "\"Their survival to this day tells us Mars' mantle has evolved sluggishly over billions of years,\" Charalambous said. \"On Earth, features like these may well have been largely erased.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
