                    },
                    {
                        "sense_id": "b68eee2f-bb07-30a4-bc4a-ca9d6d7f38a9",
                        "entry_id": "f21402ea-4dde-3658-93c8-307d00ccdcc1",
                        "glosses": [
                            "A prank in which a person's underpants are pulled up sharply from behind in order to wedge the clothing uncomfortably between the person's buttocks."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "48543788-a9a2-4ab1-83ce-672e19611992",
                                "sense_id": "b68eee2f-bb07-30a4-bc4a-ca9d6d7f38a9",
                                "text": "If the strippers learn that there is a bachelor party, they will often call the groom onstage and publicly embarrass him. They may tie him up, whip him, tease him, give him a wedgie, cover him in whipped cream, beat his ass with a belt, put a dog collar on him, walk him around the stage like a dog, and/or humiliate him with whatever objects are at their disposal."
                            },
                            {
                                "example_id": "63a21d1a-62f7-4176-84bc-2d90babbcb31",
                                "sense_id": "b68eee2f-bb07-30a4-bc4a-ca9d6d7f38a9",
                                "text": "When Laura tells Bart that she can teach him to dance, Bart and Laura are suddenly transformed into Astaire and Rogers in a black-and-white fantasy sequence before Bart’s reverie is abruptly ended when Laura reverts back to bratty tomboy form and gives him a wedgie."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd214d17-a2c7-3a4a-a735-398089fab59f",
                        "entry_id": "f21402ea-4dde-3658-93c8-307d00ccdcc1",
                        "glosses": [
                            "A situation where a person's underpants are stuck uncomfortably between their buttocks."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd00431-307d-432a-8df7-7aa02747acc6",
                                "sense_id": "dd214d17-a2c7-3a4a-a735-398089fab59f",
                                "text": "I thought, maybe she had an uncomfortable wedgie or something and was trying to work that out. I looked away thinking how embarrassing it must be especially with people staring."
                            }
                        ]
                    },
                    {
                        "sense_id": "b02f2762-7518-3520-b2ea-0926f9eb8fa0",
                        "entry_id": "f21402ea-4dde-3658-93c8-307d00ccdcc1",
                        "glosses": [
                            "A basketball stuck between the rim and the backboard following a field goal, free throw, rebound, or block attempt."
