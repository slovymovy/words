                    {
                        "sense_id": "c62119c6-41ca-3250-936f-289252f5d65e",
                        "entry_id": "60da625b-b4e2-32af-9819-f31878dbd06e",
                        "glosses": [
                            "Conventionnel, banal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c4639c5-971c-4453-8908-599c188e63f6",
                                "sense_id": "c62119c6-41ca-3250-936f-289252f5d65e",
                                "text": "Et puis le roman noir, c’est la liberté du langage contre les formules convenues : l’argot du polar redonne une place à la fonction poétique du langage."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d997383-bbaf-305a-8ca9-a06ba06a765e",
                        "entry_id": "60da625b-b4e2-32af-9819-f31878dbd06e",
                        "glosses": [
                            "Décidé d’un commun accord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16bc6b08-027c-4671-ab25-ff11d08ba82a",
                                "sense_id": "5d997383-bbaf-305a-8ca9-a06ba06a765e",
                                "text": "Elle ne se gêne plus, ne prend même plus la peine de mentir… on dirait que c’est affaire convenue entre nous…"
                            }
                        ]
                    }
                ],
