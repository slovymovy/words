                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e601001c-7fc4-3ef1-9fdf-88ab4be83faa",
                        "entry_id": "eb2515f7-20a4-3e9f-bb10-2fcd39c14060",
                        "glosses": [
                            "op een dwingende, commanderende manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f003136b-9b30-4078-bd4b-e3eed45f6f03",
                                "sense_id": "e601001c-7fc4-3ef1-9fdf-88ab4be83faa",
                                "text": "Niet het verbond en de doop gaan voorop, maar het Woord. God komt tot ons met Zijn Woord en vraagt ons aandachtig te luisteren. De plicht en dus ook het recht om tot Christus te komen, liggen niet in het verbond en de doop, maar in Zijn nodigende en bevelende Woord, dat ons gepredikt wordt (Rom. 16:26)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "660278b5-3433-44a6-a339-734f52b7b6b1",
                        "source_entry_id": "eb2515f7-20a4-3e9f-bb10-2fcd39c14060",
                        "source_sense_id": "e601001c-7fc4-3ef1-9fdf-88ab4be83faa",
