                                        "entry_id": "acf99e57-528a-371a-9151-c083ec3a39d1",
                                        "glosses": [
                                            "zakażenie ośrodkowego układu nerwowego najczęściej spowodowane infekcją wirusową, rzadziej bakteryjną"
                                        ],
