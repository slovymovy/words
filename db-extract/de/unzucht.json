                                                "example_id": "9fe7af20-b24c-45f2-895f-a2b53d1afa7b",
                                                "sense_id": "8fcb5fe9-dafe-3f8e-a5d4-9587060dd700",
                                                "text": "Er is gisteren een 34-jarige man opgepakt wegens het plegen van ontucht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
