                "senses": [
                    {
                        "sense_id": "8114453f-d386-38dc-a64a-df265821224c",
                        "entry_id": "95e49910-4f08-3e7b-950b-d8a943f35994",
                        "glosses": [
                            "Donner un caractère wagnérien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8bc375d-fc7d-4f21-a124-3416cb40aff1",
                                "sense_id": "8114453f-d386-38dc-a64a-df265821224c",
                                "text": "Ce très savant musicien, aux conceptions colossales, réduites par l’érudition la plus rare d’un métier qu’il possède seul, eut wagnérianisé la tradition; le contraire, chez lui, nous aurait surpris."
                            },
                            {
                                "example_id": "af8573b4-73b8-4bab-8fe5-a084d0ef2fe5",
                                "sense_id": "8114453f-d386-38dc-a64a-df265821224c",
                                "text": "Verdi plus Tchekhov, avec, surtout sensible dans Ludwig et Les Damnés, un zeste de Shakespeare wagnérianisé."
                            }
                        ]
                    }
                ],
