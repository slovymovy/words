                        "examples": [
                            {
                                "example_id": "ed7ec275-46b2-47bb-9a00-a36de4b424bf",
                                "sense_id": "befd8f84-0a7e-3be1-bfc8-e035010c8316",
                                "text": "Syn he of helthe hath opned me the yate"
                            },
                            {
                                "example_id": "31b26c1a-72c6-4ec6-970c-6959badd6266",
                                "sense_id": "befd8f84-0a7e-3be1-bfc8-e035010c8316",
                                "text": "For thy my Kiddie, be ruled by me,\n And never give trust to his trechery:\n And if he chance come when I am abroad,\n Spar the yate fast, for fear of fraud."
                            },
                            {
                                "example_id": "7a382458-dc6d-4c87-90b2-ee5eab837b10",
                                "sense_id": "befd8f84-0a7e-3be1-bfc8-e035010c8316",
                                "text": "He's left th' yate at t' full swing, and Miss's pony has trodden dahn two rigs o' corn , and plottered through, raight o'er into t' meadow!"
                            }
                        ]
                    }
                ],
