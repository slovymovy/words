                ],
                "senses": [
                    {
                        "sense_id": "ae204dac-7389-3f31-ac9b-02706d297dd1",
                        "entry_id": "c3cb45a5-4d55-3c22-8335-aa99ef1f0eef",
                        "glosses": [
                            "Kleid aus Taft (für festliche Anlässe)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "764a3fb1-bbf6-4c11-b720-a0ca9f5109f6",
                                "sense_id": "ae204dac-7389-3f31-ac9b-02706d297dd1",
                                "text": "„Alle Taftkleider der Pariser Haute Couture haben lange Ärmel.“"
                            },
                            {
                                "example_id": "226b4c1a-e5b4-450e-bf94-43566dd3072c",
                                "sense_id": "ae204dac-7389-3f31-ac9b-02706d297dd1",
                                "text": "„Eine Bemerkung, die von Tante Marguerite ſehr wohlwollend aufgenommen und von einem unwillkürlichen Zupfen an ihrem Taftkleide begleitet wurde.“"
                            },
                            {
                                "example_id": "dd7649e9-aa0f-4087-8641-753b500a6de4",
                                "sense_id": "ae204dac-7389-3f31-ac9b-02706d297dd1",
                                "text": "„Er sieht aber nicht Iskuhi, sondern Juliette in ihrem Taftkleid.“"
                            },
                            {
                                "example_id": "be298ea8-6ebe-40fd-85fb-6f4714942281",
                                "sense_id": "ae204dac-7389-3f31-ac9b-02706d297dd1",
                                "text": "„Und am besten verstehen sich die noch verbliebenen Macher großer Mode in Paris zweifellos auf üppigen Luxus: Bei den Herbst-Modeschauen der Haute Couture schickten sie letzte Woche ihre Mannequins in Samt- und Taftkleidern, goldbestickten oder nerzbesetzten Jacken über die Laufstege — Cardin rühmte sich gar, einen der wohl teuersten handgewebten Stoffe verwendet zu haben (Meterpreis: 900 Mark).“"
                            },
                            {
                                "example_id": "4acd36ad-3773-49b4-99df-d42ae62b3057",
                                "sense_id": "ae204dac-7389-3f31-ac9b-02706d297dd1",
                                "text": "„Der Schnitt des Taftkleides, der die Trägerin schlank erscheinen läßt, ist beachtlich; graziös wirkt die große rückwärtige Schleife.“"
                            },
                            {
                                "example_id": "e611cd17-397b-49ed-87de-4632ef82a9a2",
                                "sense_id": "ae204dac-7389-3f31-ac9b-02706d297dd1",
                                "text": "„Sie beschreibt ihr aufgekratzt das Taftkleid, das sie in einem Laden gefunden hat und das Mila wahnsinnig gefallen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
