                                        "entry_id": "2979b7b2-1cb6-3755-9de7-5d02e03f00d2",
                                        "glosses": [
                                            "een examen of test opnieuw afleggen in de hoop van een betere uitkomst"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25af1e37-8ac1-4ac8-842f-8c75bd79ac00",
                                                "sense_id": "52a0019d-d467-37b9-a945-ad9a8ebd6a8e",
                                                "text": "Het is niet op alle faculteiten aan de RUG mogelijk voor studenten om een voldoende te herkansen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a6dce4c-3b71-45f6-8623-0ba01b9c5152",
