                },
                {
                    "sense_id": "4b51b742-de30-39c5-8c7b-1e79a0e4bef8",
                    "sense_definition": "Actual action or performance, as distinct from words, thoughts, or promises.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved his loyalty in <w>deed</w>, not just in words.",
                            "target_lang_translations": {
                                "ru": "Он доказал свою преданность на <w>деле</w>, а не только на словах.",
                                "nl": "Hij bewees zijn loyaliteit met <w>daden</w>, niet alleen met woorden."
                            }
                        },
                        {
                            "text": "We need unity in <w>deed</w> and truth, rather than empty speeches.",
                            "target_lang_translations": {
                                "ru": "Нам нужно единство на <w>деле</w> и в истине, а не пустые речи.",
                                "nl": "We hebben eenheid in <w>daad</w> en waarheid nodig, in plaats van lege toespraken."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in word and deed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фактическое действие или исполнение в противовес словам или обещаниям.",
                        "nl": "Feitelijke actie of uitvoering, in tegenstelling tot woorden, gedachten of beloften."
