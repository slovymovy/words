                "senses": [
                    {
                        "sense_id": "400d1639-6130-3256-9ee6-e591c1fe29eb",
                        "entry_id": "e3732d01-0a9a-3262-985b-52f01bd2084e",
                        "glosses": [
                            "forma żeńska od: altowiolinista"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88846851-e1a2-46eb-ab5e-135661bd95de",
                                "sense_id": "400d1639-6130-3256-9ee6-e591c1fe29eb",
                                "text": "Altowiolinistka zagrała piękny koncert."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75376b71-fed1-4205-9120-5954f37bc6fc",
                        "source_entry_id": "e3732d01-0a9a-3262-985b-52f01bd2084e",
                        "source_sense_id": "400d1639-6130-3256-9ee6-e591c1fe29eb",
                        "target_lang_word": "Bratschistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bratschistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "954484aa-a723-34bd-93eb-5ad585df09df",
                                        "entry_id": "6dc1510a-67aa-3513-aaaf-7850782d086e",
                                        "glosses": [
                                            "weibliche Person, die (berufsmäßig) Bratsche spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8122aafb-f0d0-496d-b5b7-3f172991ba10",
                                                "sense_id": "954484aa-a723-34bd-93eb-5ad585df09df",
                                                "text": "„Bei einer verknüpften Datenauswertung läßt sich feststellen, daß gerade bei eher zierlichen Bratschistinnen mit relativ großen Instrumenten Beschwerden und Veränderungen im Bereich des oberen Bewegungsapparates gehäuft und schwerer sind, was allerdings auch schon bei der einfachen Auswertung nach Korpusgröße unabhängig vom Spieler deutlich wird.“"
                                            },
                                            {
                                                "example_id": "76998621-7c05-43c9-b836-2254bb794144",
                                                "sense_id": "954484aa-a723-34bd-93eb-5ad585df09df",
                                                "text": "„Seine Frau, Bratschistin bis zur Auflösung ihres Orchesters, hat hier früher geübt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84c12559-002a-4508-905a-02ac2aa15d27",
                        "source_entry_id": "e3732d01-0a9a-3262-985b-52f01bd2084e",
                        "source_sense_id": "400d1639-6130-3256-9ee6-e591c1fe29eb",
                        "target_lang_word": "Bratscherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bratscherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15979d64-a2ec-3f5c-875f-04a86e9c2ba9",
                                        "entry_id": "2d331378-55ae-3d16-8762-45aa4768fb50",
                                        "glosses": [
                                            "weibliche Person, die Bratsche spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636ca996-750a-4018-9e3e-3a38e0c063a4",
                                                "sense_id": "15979d64-a2ec-3f5c-875f-04a86e9c2ba9",
                                                "text": "„Eine Bratscherin, die Harfenistin und der Dirigent treffen sich zufällig in der Sauna.“"
                                            },
                                            {
                                                "example_id": "36818f2c-032d-4a46-97fb-fd446099e964",
                                                "sense_id": "15979d64-a2ec-3f5c-875f-04a86e9c2ba9",
                                                "text": "„Das Streichquartett der Berliner Staatskapelle ist der beste Beweis dafür, denn die Homogenität und Klangkultur der Violinisten Wolfram Brandl und Krzysztof Specjal, der Bratscherin Yulia Deyneka und des Cellisten Claudius Popp erweist sich am Mittwochabend im Pierre Boulez Saal als phänomenal.“"
                                            },
                                            {
                                                "example_id": "7029122f-63b6-4713-b30c-a0d2a0917ec5",
                                                "sense_id": "15979d64-a2ec-3f5c-875f-04a86e9c2ba9",
                                                "text": "„Tabea Zimmermann, die derzeit bedeutendste Bratscherin hierzulande, spielt eine Viola, die Étienne Vatelot 1983 gebaut hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
