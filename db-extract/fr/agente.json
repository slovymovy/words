                    },
                    {
                        "form_id": "0dc1db41-3380-4cfd-92e2-b835858f047a",
                        "entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "tags": [
                            "masculine"
                        ],
                        "form": "agent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0895450b-cf79-3e7f-8638-35f8196e653f",
                        "entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "glosses": [
                            "Celle qui est chargée d’une fonction, d’une mission, soit par un gouvernement soit par une administration, soit par un ou plusieurs particuliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a1afa09-ee45-4eb5-bb34-273c37b13a26",
                                "sense_id": "0895450b-cf79-3e7f-8638-35f8196e653f",
                                "text": "Dans L’Équipe, son agente, Rafaela Pimenta, l’exhortait à « affirmer sa personnalité pleine de joie face aux médias », pour se défaire de l’étiquette robotique qui lui colle à la peau."
                            },
                            {
                                "example_id": "da9a8002-141e-4ffc-ba76-213732bf88e6",
                                "sense_id": "0895450b-cf79-3e7f-8638-35f8196e653f",
                                "text": "Une ancienne agente de l’Institut national de recherche pour l’agriculture, l’alimentation et l’environnement est aujourd’hui atteinte de la maladie de Creutzfeldt-Jakob. Elle pourrait l’avoir contractée en manipulant des prions."
                            }
                        ]
                    },
                    {
                        "sense_id": "69be9488-2144-36bc-a296-932d5f69b78c",
                        "entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "glosses": [
                            "Fonctionnaire de police."
                        ],
                        "tags": [
                            "ellipsis",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "74bed24c-80c9-49f8-ab6d-627e0ccf82ce",
                                "sense_id": "69be9488-2144-36bc-a296-932d5f69b78c",
                                "text": "La dernière montrait la police actuelle par différents détachements dotés des divers armements en usage à Genève, et précédée d’un peloton d’agentes de la circulation."
                            },
                            {
                                "example_id": "328dc889-4611-48e1-b3f3-8a69659d252d",
                                "sense_id": "69be9488-2144-36bc-a296-932d5f69b78c",
                                "text": "Le mois d’avant Bud s’était fait entortiller par une agente en civil qui l’avait supplié de lui vendre un joint afin de le prendre en flagrant délit de vente de stupéfiants."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d5ccfc8-7b1f-3f48-920e-3097239b5482",
                        "entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "glosses": [
                            "(Suivi de de) Celle qui agit dans une profession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7b5e28-548f-4dfe-9a5c-fc47c921d32a",
                                "sense_id": "1d5ccfc8-7b1f-3f48-920e-3097239b5482",
                                "text": "L’éducation pratique que je vous ai fait donner vous ouvre une foule de carrières, voulez-vous essayer de la finance ? voulez-vous devenir banquière ? agente de change ? je puis aider à vos débuts en vous trouvant une place chez une agente de change… vous vous initierez là aux grandes questions financières, et avec de l’intelligence, de la volonté, de la persévérance, de l’initiative…"
                            },
                            {
                                "example_id": "32474dfc-ccd5-40d2-b79c-33a340d86353",
                                "sense_id": "1d5ccfc8-7b1f-3f48-920e-3097239b5482",
                                "text": "Madame Pescott est « agente de douanes et fournisseure de navires »."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4145d7d-d57e-3657-a965-546af50fd909",
                        "entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "glosses": [
                            "Ce qui agit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b48c6d56-4003-4e12-90eb-6043ff500b98",
                                "sense_id": "b4145d7d-d57e-3657-a965-546af50fd909",
                                "text": "Elles n’y sont présentées ni comme actrices essentielles, ni comme agentes secondaires ou indirectes."
                            }
                        ]
                    },
                    {
                        "sense_id": "07d05d6c-4190-34f7-a7cd-917715192343",
                        "entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "glosses": [
                            "Personne ou chose qui fait une action, montrée généralement par un sujet dans la voix active."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbaa034a-2f6c-4d99-9567-99172c4e7a80",
                        "source_entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "source_sense_id": "0895450b-cf79-3e7f-8638-35f8196e653f",
                        "source_sense_description": "Celle qui exerce une mission pour le compte d’autrui",
                        "target_lang_word": "Agentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8aa78c-a61c-3344-9f77-cedf9ed1cc79",
                                        "entry_id": "97d5d04e-ddb9-3390-b2a5-8125780ac968",
                                        "glosses": [
                                            "weibliche Person, die Vermittlungsdienstleistungen für ihre Kunden erbringt, insbesondere für Künstler, Schriftsteller, Sportler; allgemein Vermittlerin, Handelsvertreterin"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe28a70-3e78-454d-9c22-350e2a87ed13",
                                                "sense_id": "4e8aa78c-a61c-3344-9f77-cedf9ed1cc79",
                                                "text": "Hauptberuflich arbeitet sie als Agentin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                        "entry_id": "97d5d04e-ddb9-3390-b2a5-8125780ac968",
                                        "glosses": [
                                            "weibliche Person, die im Staatsauftrag oder im Auftrag einer Organisation im Geheimen tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225ca31c-2127-4c40-a071-66b3074b33e4",
                                                "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                                "text": "Die Tarnung der Agentin ist aufgeflogen."
                                            },
                                            {
                                                "example_id": "230af63c-f552-4290-bda8-1e3841341396",
                                                "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                                "text": "„Möglicherweise war sie eine Agentin, vielleicht auch eine Luxushure – oder auch schlicht ein Flittchen.“"
                                            },
                                            {
                                                "example_id": "76e1158c-7b7d-49c1-a88d-3c68e58ea155",
                                                "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                                "text": "„Hier saßen sie zu Haufen, Agenten und Agentinnen, die in Luxus und Wohlstand ihr ebenso gemeines wie idiotisches Handwerk betrieben –im Namen der jeweiligen Vaterländer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0141c54-8ca5-4b2c-aa14-908564f3b3e0",
                        "source_entry_id": "8a36bda5-e276-3d18-bc62-d2f597f466c7",
                        "source_sense_id": "0895450b-cf79-3e7f-8638-35f8196e653f",
                        "source_sense_description": "Celle qui exerce une mission pour le compte d’autrui",
                        "target_lang_word": "agent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2611f4a-67d1-3c3f-9fa5-5cbb4e9f7bab",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "One who exerts power, or has the power to act."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e570aff-9517-45c1-a6bf-1471eeac05ec",
                                                "sense_id": "a2611f4a-67d1-3c3f-9fa5-5cbb4e9f7bab",
                                                "text": "Seeing we are so wonderfully endowed with priceless gifts by our Heavenly Father, will he not require usury at our hands? He will. But he has made us agents to ourselves, which makes us responsible for the way in which we use the talents he has given us, for the manner we expend the gold and silver, the wheat and fine flour, the cattle upon a thousand hills, and the wine and oil, for they all belong to Him"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aee2f0b-c584-3fd1-b6a3-abe672fd9a72",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "One who acts for, or in the place of, another (the principal), by that person's authority; someone entrusted to act on behalf of or in behalf of another, such as to transact business for them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da36e016-8234-4f9d-bf1f-f7fda133b762",
                                                "sense_id": "1aee2f0b-c584-3fd1-b6a3-abe672fd9a72",
                                                "text": "He worked as an agent for the government."
                                            },
                                            {
                                                "example_id": "0ec74351-5c1c-4391-ba01-2a2f004e4c24",
                                                "sense_id": "1aee2f0b-c584-3fd1-b6a3-abe672fd9a72",
                                                "text": "I see in him [Moby Dick] outrageous strength, with an inscrutable malice sinewing it. That inscrutable thing is chiefly what I hate; and be the white whale agent, or be the white whale principal, I will wreak that hate upon him."
                                            },
                                            {
                                                "example_id": "600d396f-d14e-49ce-a059-b7a1d3e39145",
                                                "sense_id": "1aee2f0b-c584-3fd1-b6a3-abe672fd9a72",
                                                "text": "Having a good buyer’s agent also means having someone who is knowledgeable about the local real estate market and who has the skills and competence to negotiate with the seller’s agent on your behalf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62751dd2-7127-31bf-8daf-5078f4868fa4",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "A person who looks for work for another person and brokers a deal between the hiree and hirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28f148c-2664-457d-825b-c52fadff377a",
                                                "sense_id": "62751dd2-7127-31bf-8daf-5078f4868fa4",
                                                "text": "Ronald Koeman has agreed a deal with Everton to become their new manager, his agent has reportedly told Dutch media. The agent Rob Jansen said, according to the popular Voetbal International website, that it was now down to Southampton and Everton to agree a compensation package for the Dutchman, who has a year remaining on his contract at St Mary’s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf307fb4-80be-3f16-9327-872b97887c17",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "Someone who works for an intelligence agency: whether an officer or employee thereof or anyone else who agrees to help their efforts (for ideology, for money, as blackmailee, or otherwise)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9cf060-fe6f-42be-9895-9650a1e0ed88",
                                                "sense_id": "cf307fb4-80be-3f16-9327-872b97887c17",
                                                "text": "@Gary, are you a PAP agent? ... =) trying to incite rebellion and revolution on this site so that the govt will have an excuse to take down this site?"
                                            },
                                            {
                                                "example_id": "8ee90616-938c-4402-8c44-e9f1dd18e52b",
                                                "sense_id": "cf307fb4-80be-3f16-9327-872b97887c17",
                                                "text": "In the Atlanta suburb of Lilburn, ICE agents arrested Walter Valladares, a 53-year-old undocumented immigrant from Honduras, according to family members who spoke with CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e613ce9-efa5-3b9c-afc0-e667f6cb6a02",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "An active power or cause or substance; something (e.g. biological, chemical, thermal, etc.) that has the power to produce an effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e3c1061-24f5-4521-b997-2aad84d0a129",
                                                "sense_id": "0e613ce9-efa5-3b9c-afc0-e667f6cb6a02",
                                                "text": "So far seems to be the work of chemistry alone; at least we have no right to conclude that any other agent interferes; since hay, when it happens to imbibe moisture, exhibits nearly the same processes.\""
                                            },
                                            {
                                                "example_id": "32a0eb15-00d0-4a1e-bbdc-4a2fd6c9431b",
                                                "sense_id": "0e613ce9-efa5-3b9c-afc0-e667f6cb6a02",
                                                "text": "Agents are means-rational insofar as they effectively pursue the goals they currently have—but means-rationality (even under a narrow-scope interpretation) does not prohibit agents from changing their goals or dropping them entirely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0991f853-acda-3d36-8085-09b3c4ca1e76",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "In the client-server model, the part of the system that performs information preparation and exchange on behalf of a client or server. Especially in the phrase “intelligent agent” it implies some kind of autonomous process which can communicate with other agents to perform some collective task on behalf of one or more humans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e028b69-8328-32ca-baf1-04dd71b9e9d4",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "The participant of a situation that carries out the action in this situation, e.g. \\\"the boy\\\" in the sentences \\\"The boy kicked the ball\\\" and \\\"The ball was kicked by the boy\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9811df97-cef4-4002-9454-af8230ddf7d5",
                                                "sense_id": "0e028b69-8328-32ca-baf1-04dd71b9e9d4",
                                                "text": "Near-synonym: doer"
                                            },
                                            {
                                                "example_id": "a0af5590-6c6e-4922-8d5c-f2985f1775a0",
                                                "sense_id": "0e028b69-8328-32ca-baf1-04dd71b9e9d4",
                                                "text": "A verb is typically described as active when its subject is the agent or actor. By contrast, a verb is said to be passive when the subject does not perform the action, but is the patient, target, or undergoer of the action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ccb5a10-19be-3284-b66a-a020f60c52f0",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "A cheat who is assisted by dishonest casino staff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7f91d74-96fd-4f25-ba0c-288f38660f3d",
                                                "sense_id": "5ccb5a10-19be-3284-b66a-a020f60c52f0",
                                                "text": "Nevada casinos are fleeced out of millions of dollars yearly by agents (cheats acting as players) in collusion with crooked Black Jack dealers and pit bosses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68caa96-056e-38c5-af55-955763564286",
                                        "entry_id": "81b8e434-2a84-39c0-82e7-c904bd9beca1",
                                        "glosses": [
                                            "A respectful term of address for an agent, especially a non-police law enforcement agent."
                                        ],
                                        "tags": [
                                            "US",
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64419999-dff2-47ec-a789-26bbef206d5f",
                                                "sense_id": "a68caa96-056e-38c5-af55-955763564286",
                                                "text": "Steve Haines (Robert Bogue): Agent Sanchez! Apprehend these suspects!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
