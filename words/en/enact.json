{
    "word_family": [
        "enactment",
        "enactor",
        "re-enact",
        "reenactment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f9104ff-7e69-34f4-a361-83e9641b5253",
                    "sense_definition": "To officially make a bill or proposal into a law.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legislation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government plans to <w>enact</w> new legislation to protect the environment next year.",
                            "target_lang_translations": {
                                "ru": "Правительство планирует <w>принять</w> новое законодательство по защите окружающей среды в следующем году.",
                                "tr": "Hükümet önümüzdeki yıl çevreyi korumak için yeni bir mevzuatı <w>yasalaştırmayı</w> planlıyor."
                            }
                        },
                        {
                            "text": "After months of debate, the council finally decided to <w>enact</w> a law banning smoking in public parks.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев дебатов совет наконец решил <w>ввести в действие</w> закон, запрещающий курение в общественных парках.",
                                "tr": "Aylarca süren tartışmaların ardından konsey nihayet halka açık parklarda sigara içilmesini yasaklayan bir yasayı <w>yürürlüğe koymaya</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass",
                        "ratify",
                        "sanction",
                        "legislate"
                    ],
                    "antonyms": [
                        "repeal",
                        "revoke",
                        "annul",
                        "rescind"
                    ],
                    "common_phrases": [
                        "enact a law",
                        "enact legislation",
                        "enact a bill",
                        "enact new rules"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal and political context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально принимать законопроект или предложение, придавая им силу закона.",
                        "tr": "Bir yasa tasarısını veya teklifini resmi olarak yasalaştırmak, kanunlaştırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "закон или постановление"
                            },
                            {
                                "target_lang_word": "вводить в действие",
                                "target_lang_sense_clarification": "закон"
                            },
                            {
                                "target_lang_word": "постановлять",
                                "target_lang_sense_clarification": "официально устанавливать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yasalaştırmak",
                                "target_lang_sense_clarification": "yasa tasarısını kanun haline getirmek"
                            },
                            {
                                "target_lang_word": "kanunlaştırmak",
                                "target_lang_sense_clarification": "yasal hale getirmek"
                            },
                            {
                                "target_lang_word": "yürürlüğe koymak",
                                "target_lang_sense_clarification": "yasayı uygulamaya koymak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aa12a41-0eb1-3075-9c31-f7649d5f657f",
                    "sense_definition": "To perform a role or represent a character in a play or film.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were asked to <w>enact</w> a scene from a famous Shakespearean play.",
                            "target_lang_translations": {
                                "ru": "Студентов попросили <w>разыграть</w> сцену из знаменитой пьесы Шекспира.",
                                "tr": "Öğrencilerden ünlü bir Shakespeare oyunundan bir sahneyi <w>canlandırmaları</w> istendi."
                            }
                        },
                        {
                            "text": "It was a challenge for the young actor to <w>enact</w> the role of the tragic hero so convincingly.",
                            "target_lang_translations": {
                                "ru": "Для молодого актера было непростой задачей так убедительно <w>исполнить</w> роль трагического героя.",
                                "tr": "Genç oyuncu için trajik kahraman rolünü bu kadar inandırıcı bir şekilde <w>oynamak</w> büyük bir zorluktu."
                            }
                        }
                    ],
                    "synonyms": [
                        "act",
                        "perform",
                        "portray",
                        "play"
                    ],
                    "common_phrases": [
                        "enact a role",
                        "enact a scene",
                        "enact a character"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or theatrical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять роль или представлять персонажа в пьесе или фильме.",
                        "tr": "Bir tiyatro oyununda veya filmde bir rolü oynamak veya karakteri canlandırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "роль или сцену"
                            },
                            {
                                "target_lang_word": "исполнять",
                                "target_lang_sense_clarification": "роль на сцене"
                            },
                            {
                                "target_lang_word": "инсценировать",
                                "target_lang_sense_clarification": "разыгрывать действие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "canlandırmak",
                                "target_lang_sense_clarification": "bir rolü oynamak"
                            },
                            {
                                "target_lang_word": "sahnelemek",
                                "target_lang_sense_clarification": "bir oyunu veya sahneyi oynamak"
                            },
                            {
                                "target_lang_word": "oynamak",
                                "target_lang_sense_clarification": "rol üstlenmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a797278-88b0-3b6d-a54b-3d2747e25644",
                    "sense_definition": "To put something into action or to carry out a particular behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist helped the patient <w>enact</w> new ways of responding to stressful situations.",
                            "target_lang_translations": {
                                "ru": "Терапевт помог пациенту <w>отработать</w> новые способы реагирования на стрессовые ситуации.",
                                "tr": "Terapist, hastanın stresli durumlara yanıt vermenin yeni yollarını <w>uygulamasına</w> yardımcı oldu."
                            }
                        },
                        {
                            "text": "They chose to <w>enact</w> their rituals in private to avoid unwanted attention from the public.",
                            "target_lang_translations": {
                                "ru": "Они предпочли <w>совершать</w> свои ритуалы уединенно, чтобы избежать нежелательного внимания общественности.",
                                "tr": "Halkın istenmeyen dikkatinden kaçınmak için ritüellerini gizlice <w>gerçekleştirmeyi</w> tercih ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "execute",
                        "perform",
                        "implement",
                        "effect"
                    ],
                    "common_phrases": [
                        "enact a ritual",
                        "enact a plan",
                        "enact a change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в действие или осуществлять определенное поведение.",
                        "tr": "Bir şeyi eyleme geçirmek veya belirli bir davranışı gerçekleştirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "на практике"
                            },
                            {
                                "target_lang_word": "разыгрывать",
                                "target_lang_sense_clarification": "модель поведения или ритуал"
                            },
                            {
                                "target_lang_word": "претворять в жизнь",
                                "target_lang_sense_clarification": "план или идею"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uygulamaya koymak",
                                "target_lang_sense_clarification": "bir planı veya davranışı gerçekleştirmek"
                            },
                            {
                                "target_lang_word": "gerçekleştirmek",
                                "target_lang_sense_clarification": "eyleme dönüştürmek"
                            },
                            {
                                "target_lang_word": "sergilemek",
                                "target_lang_sense_clarification": "bir davranışı veya ritüeli icra etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
