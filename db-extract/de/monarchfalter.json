                                        "entry_id": "67df5ef3-55de-3e48-a3d9-6f80e08aa9a5",
                                        "glosses": [
                                            "A butterfly of the species Danaus plexippus, native to North and Central America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5e4147-f09b-4e19-a6ee-70b5a3599583",
                                                "sense_id": "426c599a-ba8c-35ed-bbc7-6a5cf28e1917",
                                                "text": "A US study published earlier this year found that dust emitted when seeds treated with neonicotinoids are planted causes sub-lethal effects in caterpillars of the monarch butterfly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbb9beb5-0115-4deb-b109-076a12786a53",
                        "source_entry_id": "e7fd33f6-2996-30e1-9481-f009dd6c988e",
                        "source_sense_id": "e7ed15ac-4893-365c-8280-74d60bd3ed56",
