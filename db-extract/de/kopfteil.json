                "senses": [
                    {
                        "sense_id": "f7e68cfd-8dde-31c5-b893-ac675d565ae1",
                        "entry_id": "b025180c-5faa-3726-b361-126a3efc9f94",
                        "glosses": [
                            "Abschnitt des Bettes, an dem das Kopfkissen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b96ca52b-b940-4fbf-a62a-30ea0048e33a",
                                "sense_id": "f7e68cfd-8dde-31c5-b893-ac675d565ae1",
                                "text": "Er stellte das/den Kopfteil seines Bettes ans Fenster."
                            },
                            {
                                "example_id": "f1dcd875-9ada-4221-b6e8-5fb2d1a01500",
                                "sense_id": "f7e68cfd-8dde-31c5-b893-ac675d565ae1",
                                "text": "„Sie hatten das Kopfteil des Betts halb hochgeklappt und George ein Kissen in den Rücken geschoben.“"
                            },
                            {
                                "example_id": "7f9a9c8d-d65f-41a7-9615-f5823425bef6",
                                "sense_id": "f7e68cfd-8dde-31c5-b893-ac675d565ae1",
                                "text": "„Ich fuhr das Kopfteil meines Bettes in eine angenehme Position und versank im Fernseher hoch über mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "581e4c68-dfd6-48c1-825c-481e644901b6",
                        "source_entry_id": "b025180c-5faa-3726-b361-126a3efc9f94",
                        "source_sense_id": "f7e68cfd-8dde-31c5-b893-ac675d565ae1",
                        "source_sense_description": "Abschnitt des Bettes, an dem das Kopfkissen liegt",
                        "target_lang_word": "fronton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fronton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                        "entry_id": "9711238f-eac6-3703-8716-ff7d6f0eb8b5",
                                        "glosses": [
                                            "Ornement d’architecture qui est fait habituellement en triangle et qui se met en haut de l’entrée principale d’un bâtiment, au-dessus des portes, des croisées, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5533148-78e7-47ac-817f-8a2bea4d19c3",
                                                "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                                "text": "Elle offre aussi un visage sobrement néo-classique avec trois arcades et un fronton à horloge."
                                            },
                                            {
                                                "example_id": "302e65ec-1625-423a-a4a5-17ec28293e1f",
                                                "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                                "text": "Il y a quelques années, florissait, orgueil de nos boulevards, certain vaste et lumineux café, situé presque en face d’un de nos théâtres de genre, dont le fronton rappelle celui d’un temple païen."
                                            },
                                            {
                                                "example_id": "06299166-1ab0-44fd-bd65-370105a8d73f",
                                                "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                                "text": "Depuis quelques années, des commerçants constatent le vol des lettres « U » sur le fronton de leur boutique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbafae26-d025-3c68-9741-4989e6adf3a9",
                                        "entry_id": "9711238f-eac6-3703-8716-ff7d6f0eb8b5",
                                        "glosses": [
                                            "Mur sur lequel frappe la pelote."
                                        ],
                                        "tags": [
                                            "Pelote basque"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                        "entry_id": "9711238f-eac6-3703-8716-ff7d6f0eb8b5",
                                        "glosses": [
                                            "Terrain où l’on pratique la pelote basque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0200aa58-5a00-484d-b2a6-ea11f96ca5af",
                                                "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                                "text": "Il longeait le terrain de sport, celui des jeux pour enfants, les courts de tennis et le fronton de pelote basque."
                                            },
                                            {
                                                "example_id": "927f29cf-95c3-4f56-a250-4e8de5384f7b",
                                                "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                                "text": "Au Pays basque, le fronton fait souvent office de place centrale du village."
                                            },
                                            {
                                                "example_id": "7a2e0b31-5fbb-40cc-b35e-5184f7956fcd",
                                                "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                                "text": "En Provence, surtout dans le pays grassois, on jouait à la pelote provençale (à l'origine jeu de paume) également sur un fronton, mais à main nue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fronton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5833dd98-8007-3cb3-b02d-d6b1c0f20e56",
                                        "entry_id": "b4cfed4d-1c93-362e-aa23-831be9ee3f3f",
                                        "glosses": [
                                            "Relatif à Fronton (Haute-Garonne), commune française, située dans le département de la Haute-Garonne et à son vignoble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73c8b36-242b-4b85-88b4-fc59f1b1ddec",
                                                "sense_id": "5833dd98-8007-3cb3-b02d-d6b1c0f20e56",
                                                "text": "Nous sommes l'unique cave coopérative de l'appellation fronton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
