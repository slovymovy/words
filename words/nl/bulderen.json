{
    "word_family": [
        "gebulder",
        "bulderlach",
        "bulderstem"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "733b9e23-0dee-3313-a80d-4d9711acbc11",
                    "sense_definition": "een hard en dreunend geluid maken, zoals van de wind, de zee of geschut",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zware kanonnen <w>bulderden</w> éénentwintig maal bij wijze van saluut.",
                            "target_lang_translations": {
                                "en": "The heavy cannons <w>thundered</w> twenty-one times as a salute."
                            }
                        },
                        {
                            "text": "De wind begon hard te <w>bulderen</w> tegen de muren van het oude huis.",
                            "target_lang_translations": {
                                "en": "The wind began to <w>roar</w> loudly against the walls of the old house."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreunen",
                        "looeien",
                        "razen"
                    ],
                    "common_phrases": [
                        "bulderen tegen de muren",
                        "de wind hoort bulderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a loud, deep, and booming sound, such as the wind, the sea, or artillery"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to roar",
                                "target_lang_sense_clarification": "of wind or sea"
                            },
                            {
                                "target_lang_word": "to thunder",
                                "target_lang_sense_clarification": "of cannons or heavy sounds"
                            },
                            {
                                "target_lang_word": "to boom",
                                "target_lang_sense_clarification": "deep resonant sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c37d89c8-67e1-320f-bc99-6619e163ec45",
                    "sense_definition": "op een zeer luide, ruwe en vaak boze manier spreken of roepen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Daar komt niets van in!\" <w>bulderde</w> hij tegen zijn personeel.",
                            "target_lang_translations": {
                                "en": "\"That's out of the question!\" he <w>bellowed</w> at his staff."
                            }
                        },
                        {
                            "text": "De kapitein begon te <w>bulderen</w> van woede toen hij de schade zag.",
                            "target_lang_translations": {
                                "en": "The captain began to <w>roar</w> with rage when he saw the damage."
                            }
                        }
                    ],
                    "synonyms": [
                        "brullen",
                        "schreeuwen",
                        "razen"
                    ],
                    "antonyms": [
                        "fluisteren"
                    ],
                    "common_phrases": [
                        "bulderen van woede",
                        "tegen iemand bulderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to speak or shout in a very loud, rough, and often angry manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to bellow",
                                "target_lang_sense_clarification": "shouting loudly and deeply"
                            },
                            {
                                "target_lang_word": "to roar",
                                "target_lang_sense_clarification": "shouting in anger"
                            },
                            {
                                "target_lang_word": "to thunder",
                                "target_lang_sense_clarification": "speaking with a powerful, angry voice"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}