                "senses": [
                    {
                        "sense_id": "0bdb9526-3e87-30ec-bc46-8a42faa58a41",
                        "entry_id": "e6a37493-8e7d-3e09-84a2-e35f077e57ed",
                        "glosses": [
                            "Enlever son caractère culturel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ec2fc0-bbe4-457e-808c-b3bb614664ae",
                                "sense_id": "0bdb9526-3e87-30ec-bc46-8a42faa58a41",
                                "text": "Elles proposent de déculturaliser la façon dont le texte a pu être lu."
                            },
                            {
                                "example_id": "2fdc83d5-828d-42a8-88ca-c1ca21c23586",
                                "sense_id": "0bdb9526-3e87-30ec-bc46-8a42faa58a41",
                                "text": "En multipliant les tentatives pour déculturaliser le désir, elle célèbre la fin de la sexualité telle qu’elle a été conçue et réglée par le processus de civilisation."
                            },
                            {
                                "example_id": "92e9a0f2-0e5c-475e-84a2-b88fd2cd2480",
                                "sense_id": "0bdb9526-3e87-30ec-bc46-8a42faa58a41",
                                "text": "D’autre part, il vise à « désessentialiser » et « déculturaliser » les références qui sont faites à l’islam."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6e27de8-316e-3e73-ba15-f2352ba2e71b",
                        "entry_id": "e6a37493-8e7d-3e09-84a2-e35f077e57ed",
                        "glosses": [
                            "Faire perdre sa culture à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b364c9-1407-4240-b7d6-a96f52cc4ec5",
                                "sense_id": "b6e27de8-316e-3e73-ba15-f2352ba2e71b",
                                "text": "L'entreprise qui nécessite de « reculturaliser » des personnes déculturalisées est très délicate."
                            }
                        ]
                    }
