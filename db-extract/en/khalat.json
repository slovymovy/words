                                        "glosses": [
                                            "домашняя или рабочая длиннополая одежда, запахивающаяся или застёгивающаяся сверху донизу, обычно из хлопчатобумажной ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355f1467-7a3d-44db-af20-509dbd323333",
                                                "sense_id": "a7228711-4c3f-3c15-9b35-850496b87888",
                                                "text": "Килька в томате да Манька в халате."
                                            },
                                            {
                                                "example_id": "b35aee86-30b4-45ef-8948-fb03e7590e19",
                                                "sense_id": "a7228711-4c3f-3c15-9b35-850496b87888",
                                                "text": "Если из дому выходили люди в белых халатах, это значило, что в доме покойник."
                                            }
                                        ]
                                    }
                                ]
                            }
