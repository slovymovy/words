                        "entry_id": "232ae061-778a-3d52-82ee-5402b4e6549f",
                        "glosses": [
                            "Mise en forme temporaire de la chevelure à chaud, avec un séchoir et une brosse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d865dd87-7124-4e6b-b44d-735f4f2f3ef3",
                                "sense_id": "2123fb7d-8281-3213-a46c-c4c663bf8b6d",
                                "text": "Tu as vu son brushing ? Les drapeaux claquaient au vent et son casque ne bougeait pas d’un pouce."
                            }
                        ]
                    }
                ],
