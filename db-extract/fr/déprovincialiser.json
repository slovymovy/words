                "senses": [
                    {
                        "sense_id": "36518cfa-a362-349d-b091-d21e2cf22ec5",
                        "entry_id": "d86d4282-ac5b-3ead-8ad4-ee54cc6db997",
                        "glosses": [
                            "Faire perdre les mœurs, les manières provinciales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e61899e5-7aa8-467a-a918-074e73d8f0f0",
                                "sense_id": "36518cfa-a362-349d-b091-d21e2cf22ec5",
                                "text": "Boulot. — Ah ! comme la vie est autre à Paris qu’en province !…\nBastien. — Boulot, mon ami, il faudra vous déprovincialiser ici !"
                            },
                            {
                                "example_id": "2a60c7ba-9d04-4414-9c42-45bc5ddcf21b",
                                "sense_id": "36518cfa-a362-349d-b091-d21e2cf22ec5",
                                "text": "Ne pensez-vous pas que, pour un tel projet, l’expression plastique pourrait être utilisée car il s’agit d’une forme de langage, et en tenant compte de cela, on pourrait réécrire, d’une certaine manière, l’histoire du Maroc pour la « décitadiniser » et donc la « déprovincialiser »."
                            },
                            {
                                "example_id": "f3c22053-ab71-47a1-bae8-c34b566986df",
                                "sense_id": "36518cfa-a362-349d-b091-d21e2cf22ec5",
                                "text": "Déprovincialisez-vous avant de vous emparisienner !"
                            }
                        ]
                    }
                ],
