                        "examples": [
                            {
                                "example_id": "270e6608-6a28-435d-a802-cf0aac181840",
                                "sense_id": "72c5704a-1355-3042-b327-ad8e615944e5",
                                "text": "The Canterburianism of the times of Charles the First did that hapless monarch much harm."
                            },
                            {
                                "example_id": "dda2e33e-82dc-453d-af9a-347f461c5861",
                                "sense_id": "72c5704a-1355-3042-b327-ad8e615944e5",
                                "text": "An authority on the Scottish Eucharist itself, George R. Burnet, describes tendencies in the Communion office of 1637 that would have alarmed opponents of Canterburianism: Internally, the most significant contrasts to the English Prayer Book related to the Communion office."
                            },
                            {
                                "example_id": "f1834c23-72cb-421d-85f7-b908944a152d",
                                "sense_id": "72c5704a-1355-3042-b327-ad8e615944e5",
                                "text": "Elsewhere he stated that Canterburianism was 'nothing but masked Popery, but a high path-royall way to Rome, a Schoole of Idolatry, Heresie, Treadhery, and mercilesse bloodshed.'"
                            }
                        ]
                    }
