                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e53af7-7247-47cc-81b7-b73c38803ea5",
                                "sense_id": "028bf6c7-8778-3a9c-a15b-8bb3d4ac0e45",
                                "text": "It was a chilling story, but the children enjoyed it."
                            },
                            {
                                "example_id": "6608861c-c0c6-4af6-a1b8-cddcdbae3d6d",
                                "sense_id": "028bf6c7-8778-3a9c-a15b-8bb3d4ac0e45",
                                "text": "22 March 2012, Scott Tobias, AV Club The Hunger Gameshttp://www.avclub.com/articles/the-hunger-games,71293/\nDisplaying a sturdy professionalism throughout that stops just short of artistry, director Gary Ross, who co-scripted with Collins and Billy Ray, does his strongest work in the early scenes, which set up the stakes with chilling efficiency."
                            }
                        ]
