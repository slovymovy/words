                "senses": [
                    {
                        "sense_id": "778114c8-9f62-317d-a9cc-960a068fbde2",
                        "entry_id": "e3958844-e240-386f-9081-49940684e995",
                        "glosses": [
                            "Any of various edible freshwater fish of the genus Pangasius, native to southeast Asia, especially an iridescent shark, Pangasius hypophthalmus, now reclassified as Pangasianodon hypophthalmus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8cf141d0-ea02-319e-8761-9e811c1d4b3d",
                        "entry_id": "e3958844-e240-386f-9081-49940684e995",
                        "glosses": [
                            "A type of modest-sized, open, outboard-powered, fishing boat common throughout much of the developing world, including Central America, the Caribbean, parts of Africa, the Middle East, and much of Asia."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e56f4adf-2a61-4959-990d-072b355ba93b",
                        "source_entry_id": "e3958844-e240-386f-9081-49940684e995",
                        "source_sense_description": "fish — see also iridescent shark",
                        "target_lang_word": "Pangasius",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pangasius",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb6f00b9-5c41-3c02-a05d-03acce72d980",
                                        "entry_id": "f4d7218e-e88f-39c4-a351-4f60105e6094",
                                        "glosses": [
                                            "Speisefisch aus der Familie der Welse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad894ccd-4c25-4682-b97c-c05b8f468f17",
                                                "sense_id": "cb6f00b9-5c41-3c02-a05d-03acce72d980",
                                                "text": "Der Pangasius ist praktisch grätenfrei."
                                            },
                                            {
                                                "example_id": "01e0b4e7-b51a-4e86-afd3-84dd4343102e",
                                                "sense_id": "cb6f00b9-5c41-3c02-a05d-03acce72d980",
                                                "text": "„Tipps zur Zubereitung: Den Pangasius schonend über Nacht im Kühlschrank auftauen … Die Pangasiusfilets mit Salz und Pfeffer würzen. …“"
                                            },
                                            {
                                                "example_id": "498878d3-370e-44f6-bc6c-8aff98a8bd86",
                                                "sense_id": "cb6f00b9-5c41-3c02-a05d-03acce72d980",
                                                "text": "„Matthias Keller vom Bundesverband der deutschen Fischindustrie sagt, der Pangasius sei der erste Zuchtfisch, der für die Tiefkühlindustrie interessant sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
