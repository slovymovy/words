                    },
                    {
                        "translation_id": "2b984c89-2296-48cd-99e2-ae020d5bef1c",
                        "source_entry_id": "a12b794b-250f-3cb7-b3df-d97f3c48f7b5",
                        "source_sense_id": "27b979f2-727a-3399-b8bf-e72046b4de4b",
