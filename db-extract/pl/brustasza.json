                "senses": [
                    {
                        "sense_id": "a967dbf4-1539-3a4a-8c0e-8f4ac46275f8",
                        "entry_id": "5d87a1f4-46ab-3591-b505-fb1dc54e54c1",
                        "glosses": [
                            "zewnętrzna kieszonka w górnej części marynarki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "354017a9-6f22-40c6-abcb-bf4917e0bb5e",
                                "sense_id": "a967dbf4-1539-3a4a-8c0e-8f4ac46275f8",
                                "text": "Jan poprawił tylko jedwabną poszetkę w brustaszy, lekko wygładził marynarkę i był gotów do wyjścia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ee7a876-f4ac-4353-8d44-c1d04def96b7",
                        "source_entry_id": "5d87a1f4-46ab-3591-b505-fb1dc54e54c1",
                        "source_sense_id": "a967dbf4-1539-3a4a-8c0e-8f4ac46275f8",
                        "target_lang_word": "breast pocket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breast pocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a1a657c-8749-34b5-b92d-384741ff9a6c",
                                        "entry_id": "bd90e11a-a026-3780-bf54-535c3f7b79a7",
                                        "glosses": [
                                            "a small, outward pocket on a jacket or shirt, located over one's chest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d93cb02-d52f-407f-9c87-3a7830913a17",
                                                "sense_id": "2a1a657c-8749-34b5-b92d-384741ff9a6c",
                                                "text": "He put the pen inside his breast pocket."
                                            },
                                            {
                                                "example_id": "b43e90b4-1d5a-450f-b4be-a73c10a34540",
                                                "sense_id": "2a1a657c-8749-34b5-b92d-384741ff9a6c",
                                                "text": "Zoe thought it might be easier to show him, so she reached into her breast pocket, and pulled out her rat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bb613a8-cfe8-4583-a9cd-829cd8daf866",
                        "source_entry_id": "5d87a1f4-46ab-3591-b505-fb1dc54e54c1",
                        "source_sense_id": "a967dbf4-1539-3a4a-8c0e-8f4ac46275f8",
                        "target_lang_word": "Brusttasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brusttasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d41f387d-7671-3339-9bce-4adf78252e8c",
                                        "entry_id": "9a150019-5688-3b74-9395-e58b456ce33e",
                                        "glosses": [
                                            "Tasche an Kleidungsstücken, die im Brustbereich angebracht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385f70cc-2356-422d-a8e1-d53be7133011",
                                                "sense_id": "d41f387d-7671-3339-9bce-4adf78252e8c",
                                                "text": "„Fritz Kleebusch greift an die Brusttasche, in der die Briefe von Karin stecken.“"
                                            },
                                            {
                                                "example_id": "df9f5f44-6556-4a16-a8f4-904401316cec",
                                                "sense_id": "d41f387d-7671-3339-9bce-4adf78252e8c",
                                                "text": "„Aus seiner Brusttasche lugte das Fernschreiben von der Reederei, dessen Inhalt mich sehr interessierte.“"
                                            },
                                            {
                                                "example_id": "f5deb22e-de94-4dd2-adad-a79ab6b030ee",
                                                "sense_id": "d41f387d-7671-3339-9bce-4adf78252e8c",
                                                "text": "„Er zog ihn aus der Brusttasche und hielt ihn ihr vor die Nase.“"
                                            },
                                            {
                                                "example_id": "4fca81cf-f956-4023-a0b5-6dcf5cec7d18",
                                                "sense_id": "d41f387d-7671-3339-9bce-4adf78252e8c",
                                                "text": "„In seiner Brusttasche wusste er das kleine Büchlein mit den kostbaren Notizen sicher aufbewahrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
