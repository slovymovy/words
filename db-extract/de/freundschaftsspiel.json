                                "sense_id": "52a51a14-fd9d-3d6a-9f02-fb1071217f3e",
                                "text": "Das Freundschaftsspiel endete zwei zu zwei unentschieden."
                            },
                            {
                                "example_id": "6e5ed2b6-745e-4ea1-8876-506f85c9332e",
                                "sense_id": "52a51a14-fd9d-3d6a-9f02-fb1071217f3e",
                                "text": "„Man hat die Sozialisten mit einer Fußballmannschaft verglichen, die zwar Freundschaftsspiele gewinnt, bei Punktespielen aber versagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
