                    {
                        "translation_id": "484d3a8b-1bd8-407e-b9b0-1e1a842515a8",
                        "source_entry_id": "635aa8dc-67d3-3bff-ace7-8b7ca361c4dd",
                        "target_lang_word": "gracieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gracieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42201c27-a443-3f5c-9b8d-2de441c8bc80",
                                        "entry_id": "a7adea65-4ece-3a5e-a5dd-cb77e7d3e291",
                                        "glosses": [
                                            "D’une manière gracieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db2b57a-c3a5-4094-a8df-12822da2437d",
                                                "sense_id": "42201c27-a443-3f5c-9b8d-2de441c8bc80",
                                                "text": "Rien ne pouvait être plus gracieusement majestueux que sa démarche et ses manières, […]."
                                            },
                                            {
                                                "example_id": "37ddce14-fe68-43c7-a809-7e68475d39c8",
                                                "sense_id": "42201c27-a443-3f5c-9b8d-2de441c8bc80",
                                                "text": "L’admirable sensibilité, si gracieusement exprimée dans cette correspondance, mouilla ses yeux des larmes […]."
                                            },
                                            {
                                                "example_id": "57716173-ca48-4954-8260-6a08aab3f2f5",
                                                "sense_id": "42201c27-a443-3f5c-9b8d-2de441c8bc80",
                                                "text": "La petite dame du type « conoïde » tristement inexpressif, que l’absence de menton fait comiquement grimacer alors qu’elle s’imagine gracieusement sourire, se proclame volontiers reine de beauté, […]."
                                            },
                                            {
                                                "example_id": "3f89834f-1498-468d-9ab3-85bdcb3a275b",
                                                "sense_id": "42201c27-a443-3f5c-9b8d-2de441c8bc80",
                                                "text": "— Elles […] répondaient gracieusement à de sympathiques surnoms : Rirette-les-Belles-Dents, Paillasson et Queue-de-Vache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c20c46e-a54d-3e93-9be5-c85f74993429",
                                        "entry_id": "a7adea65-4ece-3a5e-a5dd-cb77e7d3e291",
                                        "glosses": [
                                            "Gratuitement, à titre gratuit, sans exiger d’honoraires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26af109-f545-407b-9dca-f5741fc2282f",
                                                "sense_id": "4c20c46e-a54d-3e93-9be5-c85f74993429",
                                                "text": "À la buvette des parlementaires, ne seront servies gracieusement que des boissons non alcooliques : la consommation d’alcool sera payante."
                                            },
                                            {
                                                "example_id": "14e9e0b3-b95d-400a-a390-72e783e4b034",
                                                "sense_id": "4c20c46e-a54d-3e93-9be5-c85f74993429",
                                                "text": "Preeti évoque alors Kamaraj, l'ancien président du Tamil Nadu, qui a œuvré en son temps pour l’éducation des classes défavorisées en promettant qu’à l’école, chaque élève serait nourri 'gracieusement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
