                    "frequency": "Low",
                    "semantic_group_id": "publicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>fanfared</w> their new product as a revolutionary invention."
                        },
                        {
                            "text": "They <w>fanfared</w> the event across all major social media platforms."
                        }
                    ],
                    "synonyms": [
