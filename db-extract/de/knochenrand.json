                        "examples": [
                            {
                                "example_id": "109588bf-29e3-4eaa-a717-8963a6c6ecee",
                                "sense_id": "798877a9-a548-3dd0-b443-e0829020725c",
                                "text": "„Die vernarbten Knochenränder beweisen, dass die Patienten die Operationen überlebt hatten.“"
                            },
                            {
                                "example_id": "005e6923-b47c-42bd-aa68-f73aad556476",
                                "sense_id": "798877a9-a548-3dd0-b443-e0829020725c",
                                "text": "„Der Shuttlebus bringt mich in die Innenstadt von Phoenix, und in jeder Bar, in die ich gehe, sind diese Kerle mit Stichen um die Augenhöhlen, wo ein satter Schlag ihre Gesichtshaut gegen den Knochenrand gequetscht hat.“"
                            }
                        ],
