                "senses": [
                    {
                        "sense_id": "0c30d5d3-7196-3539-bc62-1ff573f9f51c",
                        "entry_id": "4b0a6f30-8acf-3117-86b0-278b17274947",
                        "glosses": [
                            "Tisch, auf dem Landkarten ausgebreitet werden"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "2884625e-2f66-410f-acc2-1432fdbf953c",
                                "sense_id": "0c30d5d3-7196-3539-bc62-1ff573f9f51c",
                                "text": "Der General blickte auf den Kartentisch."
                            },
                            {
                                "example_id": "4514a958-b0ed-44a2-8035-2df42ba3fc8e",
                                "sense_id": "0c30d5d3-7196-3539-bc62-1ff573f9f51c",
                                "text": "Die Kartentische im Stadtvermessungsamt in Stuhlweißenburg waren Schicht um Schicht mit ausgebreiteten Karten und Plänen bedeckt und darauf standen die Kaffeetassen."
                            },
                            {
                                "example_id": "34c617c4-08cd-4293-af44-c7db6b7606ef",
                                "sense_id": "0c30d5d3-7196-3539-bc62-1ff573f9f51c",
                                "text": "„Diesmal will er zum Kartentisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97c019ed-8864-3fa2-aa17-23c88dbf98e4",
                        "entry_id": "4b0a6f30-8acf-3117-86b0-278b17274947",
                        "glosses": [
                            "Tisch für Kartenspiele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e30f44-091c-4801-964f-f82a551a2c49",
                                "sense_id": "97c019ed-8864-3fa2-aa17-23c88dbf98e4",
                                "text": "Ein Sakrileg - am Kartentisch wurde gewürfelt."
                            },
                            {
                                "example_id": "78da7d0b-d826-42ac-b100-2435d6ddedc4",
                                "sense_id": "97c019ed-8864-3fa2-aa17-23c88dbf98e4",
                                "text": "„Wir hatten uns wieder an den Kartentisch gesetzt.“"
                            },
                            {
                                "example_id": "04bdfdb1-2705-434e-8576-f9f59b9c2c4b",
                                "sense_id": "97c019ed-8864-3fa2-aa17-23c88dbf98e4",
                                "text": "„Er hatte einen Kartentisch ins Wohnzimmer gestellt, damit sie dort essen konnten, und dazu zwei Küchenstühle, der eine aus Holz mit steifer Rückenlehne, der andre aus Stahlrohr mit Formica-Sitz und -Lehne.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
