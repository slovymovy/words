{
    "word_family": [
        "trolleybus"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2daf70b2-5bf4-3d2e-9978-46548688ad0e",
                    "sense_definition": "A cart used for carrying goods, especially in a supermarket.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put your groceries into the <w>trolley</w>.",
                            "target_lang_translations": {
                                "zh": "请把你的杂货放进<w>购物车</w>里。",
                                "ru": "Пожалуйста, положите ваши продукты в <w>тележку</w>."
                            }
                        },
                        {
                            "text": "I pushed the <w>trolley</w> through the supermarket aisles.",
                            "target_lang_translations": {
                                "zh": "我推着<w>购物车</w>穿过超市的过道。",
                                "ru": "Я вез <w>тележку</w> по рядам супермаркета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shopping trolley"
                    ],
                    "target_lang_definitions": {
                        "zh": "在超市等场所用于运送物品的手推车。",
                        "ru": "Тележка, используемая для перевозки товаров, особенно в супермаркете."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "购物车",
                                "target_lang_sense_clarification": "专指超市中用于购物的手推车。"
                            },
                            {
                                "target_lang_word": "手推车",
                                "target_lang_sense_clarification": "泛指各种人力推动的运货小车。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "продуктовая тележка",
                                "target_lang_sense_clarification": "специальная тележка для покупок в супермаркете"
                            },
                            {
                                "target_lang_word": "тележка",
                                "target_lang_sense_clarification": "общее название для ручных тележек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f2bcb6b-0b5f-35b7-9adf-af17cd12b17a",
                    "sense_definition": "A public transport vehicle that runs on rails in the street.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took the <w>trolley</w> to the city center.",
                            "target_lang_translations": {
                                "zh": "我们乘<w>电车</w>去了市中心。",
                                "ru": "Мы поехали в центр города на <w>трамвае</w>."
                            }
                        },
                        {
                            "text": "The <w>trolley</w> stopped at the busy station.",
                            "target_lang_translations": {
                                "zh": "<w>电车</w>在繁忙的车站停了下来。",
                                "ru": "<w>Трамвай</w> остановился на оживленной станции."
                            }
                        }
                    ],
                    "synonyms": [
                        "tram",
                        "trolley car"
                    ],
                    "common_phrases": [
                        "take the trolley"
                    ],
                    "target_lang_definitions": {
                        "zh": "在街道轨道上运行的公共交通工具。",
                        "ru": "Общественный транспорт, движущийся по рельсам на улице."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "电车",
                                "target_lang_sense_clarification": "指在城市街道轨道上行驶的公共交通工具。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "трамвай",
                                "target_lang_sense_clarification": "городской рельсовый транспорт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79e8e916-f85e-3b66-b2c6-b4851c4b3fc2",
                    "sense_definition": "A wheeled bed used for moving patients in a hospital.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurses moved the patient onto a <w>trolley</w>.",
                            "target_lang_translations": {
                                "zh": "护士们把病人移到了<w>平车</w>上。",
                                "ru": "Медсестры переложили пациента на <w>каталку</w>."
                            }
                        },
                        {
                            "text": "They rushed the injured man on a <w>trolley</w> to the emergency room.",
                            "target_lang_translations": {
                                "zh": "他们用<w>平车</w>把伤者紧急送往急诊室。",
                                "ru": "Они срочно доставили пострадавшего на <w>каталке</w> в отделение неотложной помощи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "医院里用于运送病人的带轮担架。",
                        "ru": "Колесная каталка, используемая для перемещения пациентов в больнице."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "平车",
                                "target_lang_sense_clarification": "医院内专门用于运送病人的带轮担架。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "медицинская каталка",
                                "target_lang_sense_clarification": "носилки на колесах для перевозки больных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "913e365c-664f-30b6-93d8-bcd2fb9837e0",
                    "sense_definition": "A small vehicle with wheels used for moving heavy objects by hand.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "cart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the <w>trolley</w> to move those heavy boxes.",
                            "target_lang_translations": {
                                "zh": "用<w>手推车</w>把那些沉重的箱子搬走。",
                                "ru": "Используйте <w>тележку</w>, чтобы перевезти эти тяжелые коробки."
                            }
                        },
                        {
                            "text": "He loaded the equipment onto a small <w>trolley</w>.",
                            "target_lang_translations": {
                                "zh": "他把设备装上了一辆小型<w>手推车</w>。",
                                "ru": "Он погрузил оборудование на маленькую <w>тележку</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于搬运重物的小型手推车。",
                        "ru": "Небольшое транспортное средство на колесах для ручной перевозки тяжелых предметов."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "手推车",
                                "target_lang_sense_clarification": "用于搬运货物的小型人力车辆。"
                            },
                            {
                                "target_lang_word": "搬运车",
                                "target_lang_sense_clarification": "专门用于搬运重物的小型车辆。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ручная тележка",
                                "target_lang_sense_clarification": "приспособление для перевозки грузов вручную"
                            },
                            {
                                "target_lang_word": "грузовая тележка",
                                "target_lang_sense_clarification": "тележка для перемещения тяжелых предметов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "125306f1-7c7e-3b38-9227-fc40e9846eab",
                    "sense_definition": "A pole on top of a vehicle that collects electricity from overhead wires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>trolley</w> lost contact with the overhead wire.",
                            "target_lang_translations": {
                                "zh": "<w>集电杆</w>与架空电线脱离了接触。",
                                "ru": "<w>Токоприемник</w> потерял контакт с подвесным проводом."
                            }
                        },
                        {
                            "text": "The driver had to fix the <w>trolley</w> to restore power.",
                            "target_lang_translations": {
                                "zh": "司机必须修理<w>集电杆</w>以恢复供电。",
                                "ru": "Водителю пришлось поправить <w>штангу</w>, чтобы восстановить подачу питания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "车辆顶部用于从架空电线收集电力的导电杆。",
                        "ru": "Штанга на крыше транспортного средства, собирающая электричество с подвесных проводов."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "集电杆",
                                "target_lang_sense_clarification": "电车顶部与架空线接触的导电装置。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "токоприемник",
                                "target_lang_sense_clarification": "устройство для снятия тока с контактной сети"
                            },
                            {
                                "target_lang_word": "штанга",
                                "target_lang_sense_clarification": "разговорное название токоприемника троллейбуса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68eb8163-6ce9-3a89-99f2-91ffab626af9",
                    "sense_definition": "To travel using a streetcar or light rail system.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>trolley</w> across the city to save time.",
                            "target_lang_translations": {
                                "zh": "为了节省时间，我们决定<w>乘电车</w>穿过城市。",
                                "ru": "Мы решили <w>проехать на трамвае</w> через весь город, чтобы сэкономить время."
                            }
                        },
                        {
                            "text": "It is faster to <w>trolley</w> than to walk in this weather.",
                            "target_lang_translations": {
                                "zh": "在这种天气下，<w>乘电车</w>比走路快。",
                                "ru": "В такую погоду быстрее <w>доехать на трамвае</w>, чем идти пешком."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "乘坐电车出行。",
                        "ru": "Передвигаться на трамвае."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乘电车",
                                "target_lang_sense_clarification": "指使用电车作为交通工具。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ехать на трамвае",
                                "target_lang_sense_clarification": "использование трамвая как средства передвижения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}