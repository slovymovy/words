                    "frequency": "Middle",
                    "semantic_group_id": "animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coq <w>chante</w> dès le lever du soleil pour réveiller la ferme."
                        },
                        {
                            "text": "Au milieu de l'été, nous écoutons les cigales <w>chanter</w> dans les arbres."
                        }
                    ],
                    "common_phrases": [
