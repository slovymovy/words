                        "cross_references": [
                            {
                                "target_word": "geschwätzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                        "entry_id": "36c3c009-5a51-3f46-84ad-3457a5233f53",
                                        "glosses": [
                                            "viel und aufdringlich redend"
                                        ],
                                        "tags": [
                                            "häufig abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c056bd2-1665-4ff4-baa8-bb661a00b38e",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Die Leute beim Kongress waren so geschwätzig, dass ich keine Lust hatte, selbst etwas zu sagen."
                                            },
                                            {
                                                "example_id": "e971ef64-633a-429a-b669-a93e23a48260",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Ich kann deine ganzen geschwätzigen Verwandten nicht mehr länger ertragen."
                                            },
                                            {
                                                "example_id": "a6052674-afa1-4a59-bfef-8d8f1e5f2b6e",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Die geschwätzige Amanda unterhielt wieder die ganze Kaffeetafel."
                                            },
                                            {
                                                "example_id": "6ce900b1-6dd1-43dd-919a-eb4c9b0cefce",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "Sieh bloß zu, dass du dem geschwätzigen Nachbarn nicht begegnest. Der quatscht dir eine Frikadelle ans Ohr."
                                            },
                                            {
                                                "example_id": "6ab3b6fe-caf3-4ec5-9266-26ae040f46bc",
                                                "sense_id": "9651b9fe-b445-37c2-9773-fbf0f0bd2a13",
                                                "text": "„In der selbstlosen und opferfreudigen Liebe eines Tieres ist etwas, das jedem tief zu Herzen gehen muß, der je Gelegenheit hatte, die armselige ›Freundschaft‹ und geschwätzige Treue des ›erhabenen‹ Menschen zu erproben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f9db61d-0758-4795-9e5a-84d55594dcb8",
                        "source_entry_id": "743384b3-94d1-301b-b1eb-96c05b752215",
                        "source_sense_id": "1eaf9b99-8076-34d1-a1f5-75126503012a",
                        "source_sense_description": "in a loquacious manner",
                        "target_lang_word": "schwatzhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwatzhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                        "entry_id": "c062523b-8218-3a5f-a99e-5480c91137dd",
                                        "glosses": [
                                            "viel und wortreich (über Überflüssiges oder Belangloses) redend; dazu neigend, Geheimnisse weiterzuerzählen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7de0a61-f847-4c94-b1ac-8b94a94cd7c1",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Die Deutschlehrerin meines Sohnes ist eine äußerst schwatzhafte Person."
                                            },
                                            {
                                                "example_id": "fa285a27-6bfc-45ef-9b8c-62290b763116",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Neil wäre eigentlich ein ganz patenter Kerl, wäre er doch nur nicht so furchtbar schwatzhaft."
                                            },
                                            {
                                                "example_id": "a652ab60-4b57-4b41-af64-5f69d472b83c",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Ich hätte nicht gedacht, dass es jemanden geben könnte, der noch schwatzhafter ist als Yolantha."
                                            },
                                            {
                                                "example_id": "a0273b2d-ae0c-4f88-990c-0a7f708e0668",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Tante Priscilla darfst du rein gar nichts erzählen. Sie ist dermaßen schwatzhaft, dass in null Komma nichts jeder in ihrem Umfeld über alles Bescheid weiß."
                                            },
                                            {
                                                "example_id": "2e146d9a-7f53-4954-8036-228d16a22b0e",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Auf der Feier war auch die Kollegin von Reiner. In ihrer schwatzhaften Art hat sie mich den ganzen Abend über mit Beschlag belegt, so dass mir irgendwann von ihrem ununterbrochenen Gesabbel die Ohren klingelten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
