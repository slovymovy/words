            "senses": [
                {
                    "sense_id": "dd1bc3d9-d677-3f21-90c5-c87f0592c8db",
                    "sense_definition": "An advertisement broadcast on radio or television.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a funny <w>commercial</w> for a new brand of cereal.",
                            "target_lang_translations": {
                                "ru": "Мы посмотрели смешной <w>рекламный ролик</w> нового бренда хлопьев.",
                                "tr": "Yeni bir kahvaltılık gevrek markasının komik bir <w>reklamını</w> izledik."
                            }
                        },
                        {
                            "text": "The movie was interrupted by a long <w>commercial</w> every twenty minutes.",
                            "target_lang_translations": {
                                "ru": "Фильм прерывался на длинную <w>рекламу</w> каждые двадцать минут.",
                                "tr": "Film her yirmi dakikada bir uzun bir <w>reklamla</w> kesildi."
