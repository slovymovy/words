                                        "entry_id": "1acc8b59-cef2-3ae6-8ed3-a97b78cde97f",
                                        "glosses": [
                                            "To protect from danger; to secure against surprise, attack, or injury; to keep in safety; to defend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a9d680-f38a-4c5e-bcd4-66043cc05e6f",
                                                "sense_id": "edc72730-3ab2-3f15-a04f-e32a8a7fb802",
                                                "text": "For Heaven still guards the right."
                                            },
                                            {
                                                "example_id": "c77b1cd8-4cfb-4b83-b4d6-4e0d5ccffdbe",
                                                "sense_id": "edc72730-3ab2-3f15-a04f-e32a8a7fb802",
                                                "text": "Henceforth, wherever thou may’st roam,\n⁠My blessing, like a line of light,\n⁠Is on the waters day and night,\nAnd like a beacon guards thee home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d835d8-2ca7-3dec-aa6b-0b9d9d85ed17",
                                        "entry_id": "1acc8b59-cef2-3ae6-8ed3-a97b78cde97f",
                                        "glosses": [
                                            "To keep watch over, in order to prevent escape or restrain from acts of violence, or the like."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ad092b-feea-45be-84bd-9d1f9d9c387d",
                                                "sense_id": "14d835d8-2ca7-3dec-aa6b-0b9d9d85ed17",
                                                "text": "Guard the prisoner."
