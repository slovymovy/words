                ],
                "senses": [
                    {
                        "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                        "entry_id": "27856862-cfbb-3c11-898b-785de75caf7e",
                        "glosses": [
                            "eine keilförmige Vertiefung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e231c910-c346-49f1-8052-23b51218410a",
                                "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                                "text": "Um einen Baum mit einer Axt zu fällen, sollte man zuerst eine Kerbe in den Stamm schlagen."
                            },
                            {
                                "example_id": "86a9add9-534a-43ed-91fc-7a1457314315",
                                "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                                "text": "„Aber alle realen Gläser weisen mikroskopische Kerben und Fehlstellen auf.“"
                            },
                            {
                                "example_id": "a7a25970-def4-4c1e-a66e-1957d198456c",
                                "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                                "text": "„Nur ab und zu warf ich einen Blick in den Container, auf die Reste dessen, womit ich aufgewachsen war und was jetzt Kerben und Beulen bekommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eaa5ed78-182b-3351-b713-e04ea79013bf",
                        "entry_id": "27856862-cfbb-3c11-898b-785de75caf7e",
                        "glosses": [
                            "regional für: Kirchweih"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51e6c36c-3d93-4ca4-b3f7-773418d90447",
                        "source_entry_id": "27856862-cfbb-3c11-898b-785de75caf7e",
                        "source_sense_description": "Übersetzungen umgeleitet",
                        "target_lang_word": "kerf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kerf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8d3efc-9697-3f9f-b663-5bb6736fe225",
                                        "entry_id": "222b9851-2c00-3757-b32c-2f70d88145a1",
                                        "glosses": [
                                            "The act of cutting or carving something; a stroke or slice."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8974afa-6f52-3026-8670-678bbf48f547",
                                        "entry_id": "222b9851-2c00-3757-b32c-2f70d88145a1",
                                        "glosses": [
                                            "The groove or slit created by cutting or sawing something; an incision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e84d70d4-b5ae-4cc8-99f7-7386290aa99d",
                                                "sense_id": "b8974afa-6f52-3026-8670-678bbf48f547",
                                                "text": "They pass through a cleft that has been made across a low range of hills, like a kerf in the top of a log, and enter into a lovely territory of subtly swelling emerald green fields strewn randomly with small white capsules that he takes to be sheep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "261ee565-22b5-3e02-82ff-14d65ec727d4",
                                        "entry_id": "222b9851-2c00-3757-b32c-2f70d88145a1",
                                        "glosses": [
                                            "The portion or quantity (e.g. of wood, hay, turf, wool, etc.) removed or cut off in a given stroke."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2786b9-5ad5-48a7-8dd7-0c2439877628",
                                                "sense_id": "261ee565-22b5-3e02-82ff-14d65ec727d4",
                                                "text": "1991, Popular Mechanics, January issue, page 63, \"Thin-kerf blades\", by Rosario Capotostro\nSawing with a thin-kerf blade produces a kerf that's 1/2 to 1/3 the size of a standard blade kerf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04efe3a2-7c36-3a11-b7bf-f9252b1fe480",
                                        "entry_id": "222b9851-2c00-3757-b32c-2f70d88145a1",
                                        "glosses": [
                                            "The distance between diverging saw teeth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fbe6885-7c01-453b-9dee-2f9aaba533eb",
                                                "sense_id": "04efe3a2-7c36-3a11-b7bf-f9252b1fe480",
                                                "text": "1991, Popular Mechanics, January issue, page 63, \"Thin-kerf blades\", by Rosario Capotostro\nSawing with a thin-kerf blade produces a kerf that's 1/2 to 1/3 the size of a standard blade kerf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37296b2-bd46-3f2d-aa0f-60378bd8bf4b",
                                        "entry_id": "222b9851-2c00-3757-b32c-2f70d88145a1",
                                        "glosses": [
                                            "The flattened, cut-off end of a branch or tree; a stump or sawn-off cross-section."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c92a33-c1ea-487a-b046-362e9525c971",
                                                "sense_id": "a37296b2-bd46-3f2d-aa0f-60378bd8bf4b",
                                                "text": "Sebastian, still not alone, is seated on the white-and-cinder-grey trunk of a felled tree. […] A Camberwell Beauty skims past and settles on the kerf, fanning its velvety wings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kerf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a105f56f-d6d3-32d0-9e6c-a71cb40aed7f",
                                        "entry_id": "c9233b38-ea80-3f5e-be4e-ffb22e1cc71d",
                                        "glosses": [
                                            "To cut a piece of wood or other material with several kerfs to allow it to be bent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ced641a0-5e38-4a4c-9b6d-5c40f48b3272",
                        "source_entry_id": "27856862-cfbb-3c11-898b-785de75caf7e",
                        "source_sense_description": "Übersetzungen umgeleitet",
                        "target_lang_word": "entaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6ae1fe9-c6e0-3349-90a0-8a469f7841bd",
                                        "entry_id": "096c0b2d-028a-350b-a317-553e1db4ef4b",
                                        "glosses": [
                                            "Coupure avec enlèvement de parties, faite dans une pierre, dans une pièce de bois, etc., soit pour y en emboîter une autre, soit pour quelque autre objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fb950c5-67cb-4481-a274-7d269bb45bcc",
                                                "sense_id": "c6ae1fe9-c6e0-3349-90a0-8a469f7841bd",
                                                "text": "Il tira son couteau de sa poche, fit une large et profonde entaille à un des arbres auprès desquels s’était arrêtée la voiture."
                                            },
                                            {
                                                "example_id": "5fdee665-0ba4-4a51-b5ac-e720d511944e",
                                                "sense_id": "c6ae1fe9-c6e0-3349-90a0-8a469f7841bd",
                                                "text": "L’ouvrier se sert d’une lame courte et tranchante, engagée dans un manche d’os, avec laquelle il pratique, au bas de l’arbre, une entaille circulaire et assez profonde pour arriver jusqu’à l’aubier."
                                            },
                                            {
                                                "example_id": "2326aa0f-9505-486e-8f74-c21ab6cb9419",
                                                "sense_id": "c6ae1fe9-c6e0-3349-90a0-8a469f7841bd",
                                                "text": "Ces vantaux étaient fortement unis par une barre qui se logeait dans une entaille réservée dans le parement du mur de droite lorsque la porte était ouverte […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0309feef-c0cc-3b5f-9804-85947ab49f19",
                                        "entry_id": "096c0b2d-028a-350b-a317-553e1db4ef4b",
                                        "glosses": [
                                            "Coupure faite dans un objet pour y laisser une marque."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9567a8c9-e213-4cf1-a6d7-354932651462",
                                                "sense_id": "0309feef-c0cc-3b5f-9804-85947ab49f19",
                                                "text": "La boulangère marquait chaque pain livré d'une petite entaille au couteau, une coche. On ne payait qu'à semaine échue."
                                            },
                                            {
                                                "example_id": "810e51be-dbf0-4885-b267-ae6bc92c8883",
                                                "sense_id": "0309feef-c0cc-3b5f-9804-85947ab49f19",
                                                "text": "Dans sa monographie comparative sur les pratiques administratives dans le nord-ouest de l’Allemagne au bas Moyen Âge, Mark Mersiowsky a accordé à l’utilisation des baguettes à entailles une place systématique au sein des dépenses seigneuriales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d23c7e7f-ae9f-3c30-a62e-209f524fd987",
                                        "entry_id": "096c0b2d-028a-350b-a317-553e1db4ef4b",
                                        "glosses": [
                                            "Coupure faite dans les chairs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f052e361-edb3-4029-8fa4-edd6aa36cd00",
                                                "sense_id": "d23c7e7f-ae9f-3c30-a62e-209f524fd987",
                                                "text": "Il a reçu dans le bras un coup de sabre qui lui a fait une grande entaille."
                                            },
                                            {
                                                "example_id": "31a60eeb-7b6e-4138-8aa1-c6eee299a69c",
                                                "sense_id": "d23c7e7f-ae9f-3c30-a62e-209f524fd987",
                                                "text": "Allons, miss, interrompis-je, ne parlez pas si vite, vous allez défaire le mouchoir mouillé que j’ai mis autour de votre figure et l’entaille va saigner de nouveau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77db8ffb-e2b5-37db-8b48-d0463ea11bcd",
                                        "entry_id": "00571709-62a6-30cb-be61-820b2235014a",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de entailler."
                                        ],
