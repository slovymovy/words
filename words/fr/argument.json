            "senses": [
                {
                    "sense_id": "e700f411-9fbd-3615-b548-ac2f7ef1b809",
                    "sense_definition": "Raison ou élément invoqué pour justifier, réfuter une thèse ou convaincre un interlocuteur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rhétorique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son avocat a présenté un <w>argument</w> très convaincant pour prouver son innocence."
                        },
                        {
                            "text": "Quels que soient les <w>arguments</w> avancés, ils refusent d'accepter ce compromis."
                        }
                    ],
                    "synonyms": [
                        "raisonnement",
                        "justification",
                        "preuve"
                    ],
                    "antonyms": [
                        "contre-argument"
                    ],
                    "common_phrases": [
                        "argument de poids",
                        "argument massue",
                        "argument convaincant"
                    ]
                },
                {
                    "sense_id": "1d7df4f5-8f8c-3394-81ec-c313f1d3a129",
                    "sense_definition": "En informatique, valeur transmise à une fonction ou à une commande lors de son appel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fonction prend une chaîne de caractères comme premier <w>argument</w>."
                        },
                        {
                            "text": "L'utilisateur a oublié d'ajouter un <w>argument</w> obligatoire lors de l'exécution du script."
