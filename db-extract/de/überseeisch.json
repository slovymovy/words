                ],
                "senses": [
                    {
                        "sense_id": "0f508670-b3dc-3a6b-a614-41e604c736de",
                        "entry_id": "e27cee74-4cbd-3bc7-ab1f-e89614030113",
                        "glosses": [
                            "Übersee betreffend, in/aus Ländern oder Gebieten jenseits eines Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45850b2-aa6b-46aa-9e24-7b24ff2923e2",
                                "sense_id": "0f508670-b3dc-3a6b-a614-41e604c736de",
                                "text": "„Nach Einrichtung des Weltpostvereins und seines Standardportos verzeichnet der überseeische Postverkehr ebenso wie die Postdienste der beteiligten Länder gänzlich unerwartete Zuwachsraten.“"
                            },
                            {
                                "example_id": "53eebe4d-b0c7-46b3-9b0d-22200ae56852",
                                "sense_id": "0f508670-b3dc-3a6b-a614-41e604c736de",
                                "text": "„Noch während der neue Staat im Entstehen war, begann er, den mit Spanien vereinigten Portugiesen deren überseeische Besitzungen streitig zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7aa94f0-b07a-49b1-a61c-c817aa76c243",
