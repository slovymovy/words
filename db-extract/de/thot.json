                        "sense_id": "6c265869-8dd7-3300-a586-3403624323e3",
                        "entry_id": "e4196e5e-b414-3d6f-b597-a2eb323dd359",
                        "glosses": [
                            "in der ägyptischen Mythologie der ibisköpfige oder paviangestaltige Gott des Mondes, der Magie, der Wissenschaft, der Schreiber, der Weisheit und des Kalenders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d968cb-8556-4bb2-b81e-6ae3ace32aee",
                                "sense_id": "6c265869-8dd7-3300-a586-3403624323e3",
                                "text": "„Dieser bloße ›Wahrsager‹ ist ein außerordentlich wichtiger Mann: Er ist der Hohe Priester von Heliopolis, Reinkarnation von Thot und Wächter über das Buch der Magie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d40b21b6-41d0-4db4-ae44-a2a96ecdda20",
                        "source_entry_id": "e4196e5e-b414-3d6f-b597-a2eb323dd359",
                        "source_sense_id": "6c265869-8dd7-3300-a586-3403624323e3",
                        "source_sense_description": "ägyptische Gottheit",
                        "target_lang_word": "Thoth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thoth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c645e8e-fd85-31af-a78c-bc0c43d922ed",
                                        "entry_id": "30801de2-bb5e-39f1-bcc0-9a01b610798a",
                                        "glosses": [
                                            "The ancient Egyptian moon god of wisdom, learning, and magic, usually depicted as an ibis or baboon."
                                        ],
                                        "tags": [
                                            "Egyptian"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72c1d6d3-b444-387a-af2c-bf21b99cd7cf",
                                        "entry_id": "30801de2-bb5e-39f1-bcc0-9a01b610798a",
                                        "glosses": [
                                            "The first month of the later ancient Egyptian civil calendar and Coptic calendar, corresponding to the first month of the season of Akhet. Since 25 BCE, when the calendar was reformed to include leap-days, Thoth has been in roughly September."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b15b4c-49e9-4233-b999-d90bb104e87a",
                                                "sense_id": "72c1d6d3-b444-387a-af2c-bf21b99cd7cf",
                                                "text": "To November 1 add 7, and the ſum will ſhew, that the ſeventh day of Thoth fell, that year, upon the eighth day of November."
                                            },
                                            {
                                                "example_id": "ae0297d7-3e69-4113-ae0a-157697a780f2",
                                                "sense_id": "72c1d6d3-b444-387a-af2c-bf21b99cd7cf",
                                                "text": "Now the month of Thoth was the first of the Egyptian year, because this month begins a new period."
                                            },
                                            {
                                                "example_id": "e760bdae-58c0-4cef-a2aa-c98bbf2fa1e5",
                                                "sense_id": "72c1d6d3-b444-387a-af2c-bf21b99cd7cf",
                                                "text": "In that case this quadrimenstruum would be the first one of the Egyptian year, Thoth, Phaophi, Hathyr, Choeac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
