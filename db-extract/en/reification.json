                                                "sense_id": "337981e2-ebca-326d-ab0d-350267e5a86c",
                                                "text": "Reifikation ist ein logischer Fehler."
                                            },
                                            {
                                                "example_id": "f11dfe3c-bf60-4e3f-bf03-e1aa10221569",
                                                "sense_id": "337981e2-ebca-326d-ab0d-350267e5a86c",
                                                "text": "Ein Beispiel für Reifikation ist die Vorstellung, dass „Mutter Natur“ sich am Menschen rächt, wenn dieser die Umwelt belastet und vergiftet."
                                            }
