    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2330d309-9ce7-3a06-9d45-1d10e3592000",
                    "sense_definition": "simple past and past participle of <w>choke</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accidentally <w>choked</w> on a piece of hard candy and needed help.",
                            "target_lang_translations": {
                                "nl": "Hij <w>verslikte zich</w> per ongeluk in een hard snoepje en had hulp nodig."
                            }
                        },
                        {
                            "text": "Thick smoke from the fireplace almost <w>choked</w> everyone in the room.",
                            "target_lang_translations": {
                                "nl": "Dikke rook uit de open haard <w>verstikte</w> bijna iedereen in de kamer."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
