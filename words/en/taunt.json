                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a family named <w>Taunt</w> living in the village.",
                            "target_lang_translations": {
                                "de": "Die historischen Aufzeichnungen erwähnen eine Familie namens <w>Taunt</w>, die im Dorf lebte."
                            }
                        },
                        {
                            "text": "Mr. <w>Taunt</w> was a well-known local photographer in the nineteenth century.",
                            "target_lang_translations": {
