                "senses": [
                    {
                        "sense_id": "d0ca5595-4085-3ffb-8d83-227df03a232e",
                        "entry_id": "8dfc0b7d-c5a2-3730-98c0-5829e5d17d43",
                        "glosses": [
                            "mechanisches oder elektronisches Bauteil, das in Zählern für die Kernfunktion des Zählens eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b12b619-4b5a-4f69-a9d9-dc7a14c42335",
                                "sense_id": "d0ca5595-4085-3ffb-8d83-227df03a232e",
                                "text": "Ein Zählwerk zählt die Umdrehungen von Rädern und Wellen meist in Verbindung mit bestimmten Messgeräten, um aufeinanderfolgende gleichartige Vorgänge zahlenmäßig festzuhalten; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae3363a1-e69a-47c3-98a0-c00c7cee5e4f",
                        "source_entry_id": "8dfc0b7d-c5a2-3730-98c0-5829e5d17d43",
                        "source_sense_id": "d0ca5595-4085-3ffb-8d83-227df03a232e",
                        "target_lang_word": "compteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e083384f-411c-3412-8217-8fa1db799a9c",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Celui qui compte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa5047e-c150-4201-87d3-edec0e674f00",
                                                "sense_id": "e083384f-411c-3412-8217-8fa1db799a9c",
                                                "text": "Il y a quatre chambres qui appartiennent à l’échiquier : 1ᵒ. la recette de l’échiquier qui a le ménagement des revenus du roi ; 2ᵒ. la cour d’équité ; 3ᵒ. la cour de la loi coutumière, qui fut établie en faveur des compteurs du roi qui s’y poursuivaient l’un l’autre, et où chacun peut commencer une action, sous la fiction qu’il est compteur du roi ; […]"
                                            },
                                            {
                                                "example_id": "e552f438-6bc2-47b0-830e-a6aa8792051d",
                                                "sense_id": "e083384f-411c-3412-8217-8fa1db799a9c",
                                                "text": "[…] il est compteur de journaux aux Nouvelles Messageries de la Presse parisienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97633015-0df5-3be2-875e-f0730227c97c",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Prostituée, du point de vue du souteneur."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "452da436-da71-4fc3-bef8-fb2786435cba",
                                                "sense_id": "97633015-0df5-3be2-875e-f0730227c97c",
                                                "text": "Moi qui étais toujours si bien nippé, dites, vous vous souvenez, hein ? Et bourré de fric, avec mes deux compteurs de la Caumar. Tandis que maintenant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "096c5a5b-4a76-3118-b802-5acf82236a43",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Instrument de mesure qui indique un nombre, souvent assorti d’une unité, mesurant une quantité ou un taux spécifique. L’indication peut-être soit instantanée, soit cumulative sur une période donnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e282ea3-d79a-45cd-9123-6d62fa064445",
                                                "sense_id": "096c5a5b-4a76-3118-b802-5acf82236a43",
                                                "text": "J’y voyais juste assez clair pour deviner le clignotement du répondeur. En laissant des flaques sur mon passage, je m’en approchai doucement, comme si un mouvement brusque pouvait le faire exploser — en fait, c’était ma tête qui risquait d’exploser. Le compteur indiquait la présence de six messages. Trop pour un jour normal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d16453-d950-3270-9ada-1a989f0b0009",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Instrument de mesure qui indique un nombre, souvent assorti d’une unité, mesurant une quantité ou un taux spécifique. L’indication peut-être soit instantanée, soit cumulative sur une période donnée.",
                                            "Compteur de vitesse, instrument indiquant la vitesse d’un véhicule."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc8394ad-1ab9-4517-9e30-cb9160c0ec96",
                                                "sense_id": "93d16453-d950-3270-9ada-1a989f0b0009",
                                                "text": "La vitesse est limitée à 70 km/h dans les tunnels qui courent sous Marseille jusqu’à l’autoroute nord. Kernel appuie sur l’accélérateur jusqu’à atteindre 150 au compteur. L’autre accepte le jeu auquel il a été convié."
                                            },
                                            {
                                                "example_id": "2a02ed1d-94f5-4164-a584-1200d09c60e5",
                                                "sense_id": "93d16453-d950-3270-9ada-1a989f0b0009",
                                                "text": "Thomas filait à vive allure, le compteur indiquait 160 kilomètres-heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b94afd3-5f39-3561-aac6-59e82d1101ff",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Instrument de mesure qui indique un nombre, souvent assorti d’une unité, mesurant une quantité ou un taux spécifique. L’indication peut-être soit instantanée, soit cumulative sur une période donnée.",
                                            "Compteur kilométrique, odomètre indiquant la distance parcourue par un véhicule."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04ba3a7-18fd-4fe6-9b34-df2b7edeec2b",
                                                "sense_id": "4b94afd3-5f39-3561-aac6-59e82d1101ff",
                                                "text": "Il a fini par prononcer une phrase intelligible :\n– Elle a fini sa route, votre bagnole.\nLa réparer ? Bien sûr, qu’il pouvait la réparer ! Si on avait 2000 euros à perdre, il était prêt à la remettre en état. Mais il faudrait bientôt tout changer. Les freins. Les amortisseurs. L’embrayage.\nPrès de 200000 au compteur. Elle avait largement fait son temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35e5ebdb-1978-3465-95fa-92c2b061afd5",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Instrument de mesure qui indique un nombre, souvent assorti d’une unité, mesurant une quantité ou un taux spécifique. L’indication peut-être soit instantanée, soit cumulative sur une période donnée.",
                                            "Appareil qui mesure dans un temps donné la consommation d’une quantité de gaz, d’électricité, d’eau, etc. Généralement utilisé par le fournisseur pour facturer au client sa consommation. (→ voir dérivés)"
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1654fdda-4b9e-459d-ac06-55878a8a5988",
                                                "sense_id": "35e5ebdb-1978-3465-95fa-92c2b061afd5",
                                                "text": "15 janvier 42 – Les Martinez, eux, se chauffent à gogo à l’électricité : après le passage de l’employé de la C.P.D.E., ils piquent une épingle à travers le voyant et immobilisent le compteur. Papa nous a interdit d’employer cette méthode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f83b738d-8130-3dd0-82b9-d3b0a86cdc73",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Type de classificateur utilisé seulement quand on compte. Les classificateurs en japonais sont des compteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9331a7ac-77ae-4206-b990-c05f9570e3a9",
                                                "sense_id": "f83b738d-8130-3dd0-82b9-d3b0a86cdc73",
                                                "text": "Pour les petits animaux tels que les insectes, les poissons, les chiens ou les chats, vous devez utiliser le compteur ~匹 (hiki) et pour les animaux plus grands comme les éléphants, le compteur ~頭 (tou) est celui que vous recherchez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73454d23-5f9b-39ae-a038-1321e1d10e84",
                                        "entry_id": "8dd15069-ac8d-30de-adc8-2a8b7152a652",
                                        "glosses": [
                                            "Variable qui s’incrémente ou se décrémente pour compter quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abda9a9a-8a26-42c7-9c7a-752757e1f79c",
                                                "sense_id": "73454d23-5f9b-39ae-a038-1321e1d10e84",
                                                "text": "De nombreuses recherches ont été menées sur les différentes manières d’implémenter un ramasse-miettes. L’algorithme le plus simple consiste à ajouter à chaque objet un compteur de références. Celui-ci maintient le nombre de pointeurs référençant l’objet. Lorsque la valeur du compteur est à zéro, on peut immédiatement détruire l’objet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
