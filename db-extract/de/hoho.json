                                        "examples": [
                                            {
                                                "example_id": "d364dabc-8600-432f-a8a4-7940492d40ca",
                                                "sense_id": "3f6b48c5-4393-34ca-8cb2-4cf9b228b1e6",
                                                "text": "'Mehh,' they say to the ewes, and the ewes answer, ¶ 'Meeehh.' ¶ 'Mheh.' ¶ 'Meh-meh.'"
                                            },
                                            {
                                                "example_id": "4754cf70-f1c6-4a84-9ccb-dc7f6b59f8e6",
                                                "sense_id": "3f6b48c5-4393-34ca-8cb2-4cf9b228b1e6",
                                                "text": "Cookie was bouncing around stacks of brightly colored tires, mehhing happily, while Scal stood on one end of a teeter-totter like he was king of the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
