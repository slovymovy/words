                    {
                        "translation_id": "606859b2-ca88-414a-8814-2f368df31876",
                        "source_entry_id": "359adc50-85f4-328b-8165-3fbcddcdb8e2",
                        "source_sense_id": "385d4f4a-62cf-3f83-8f70-6b1d9ce535e0",
                        "target_lang_word": "launch",
