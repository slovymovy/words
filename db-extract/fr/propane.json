                "senses": [
                    {
                        "sense_id": "c1b89562-64f7-3f5c-8a09-21ae2543cefc",
                        "entry_id": "0675fe78-7e50-39ac-9f96-42fa14fd8deb",
                        "glosses": [
                            "Hydrocarbure saturé de la famille des paraffines, de formule chimique C₃H₈. C’est un gaz plus lourd que l’air, facilement liquéfiable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77fb3cce-b8b4-4bdc-83cc-5c4d87efbfee",
                                "sense_id": "c1b89562-64f7-3f5c-8a09-21ae2543cefc",
                                "text": "Le procédé unique de valorisation énergétique utilisé par RSI Environnement lui permet de procéder aux traitements des sols tout en diminuant sa consommation de propane."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "218598b1-830c-4551-a2e7-ced2afb1e460",
                        "source_entry_id": "0675fe78-7e50-39ac-9f96-42fa14fd8deb",
