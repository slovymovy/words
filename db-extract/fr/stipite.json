                        "entry_id": "c97181fc-bade-3fa4-b731-a6b63727a684",
                        "glosses": [
                            "Variété de houille de couleur grise. Nommée parfois houille maigre, ou houille limoneuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1346d5e5-ca9c-444a-9e45-b8a367debec9",
                                "sense_id": "22baef51-0456-350f-a887-8a63802f3170",
                                "text": "La stipite se présente avec la structure polyédrique, ou la texture schisteuse, lamellaire, granulaire, compacte ou terreuse."
                            },
                            {
                                "example_id": "3446ab20-b3fa-4fe5-9bd3-926e275b7765",
                                "sense_id": "22baef51-0456-350f-a887-8a63802f3170",
                                "text": "C'est la stipite, combustible compacte dont les dépôts en forme de bassins et de couches sont venus se perdre au milieu des grès, bigarrés et des arkoses de cet âge."
                            },
                            {
                                "example_id": "8b2552b7-e542-4af5-bc12-6027af3f6bb7",
                                "sense_id": "22baef51-0456-350f-a887-8a63802f3170",
                                "text": "A partir du lias jusqu'à la fin du terrain jurassique, ils rentrent dans le stipite, espèce de houille sèche et maigre."
                            }
                        ]
                    }
