                ],
                "senses": [
                    {
                        "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                        "entry_id": "b9715f66-425a-387e-8b96-5116eb04d33f",
                        "glosses": [
                            "Umtauschen von Geld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89de7773-2f6a-44a3-bb45-bec264b37b1f",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Die Vereinspräsidentin betont, dass alle von der Europäischen Union profitierten: ‚Das beginnt bei den wegfallenden Grenzkontrollen, geht mit dem nicht mehr notwendigen Geldwechsel weiter und endet dabei, dass man als Österreicher in Deutschland keine Aufenthaltsgenehmigung mehr benötigt.‘“"
                            },
                            {
                                "example_id": "b7c60a32-2c4d-4968-812c-bdb0e4774471",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„So viel in Auftrag gegebene Selbstbeweihräucherung im Zeichen der hier wohl nicht nur symbolisch aufzufassenden Gaben Gold, Myrrhe und Weihrauch als Hinweise auf Geldwechsel und Warentermingeschäfte des Bankhauses, die diesen Bildluxus finanzierten, waren vielleicht selbst dem immer tiefgekühlt souverän erscheinenden Botticelli zu viel.“"
                            },
                            {
                                "example_id": "0f7ac8b6-1b3e-4d2a-bc4d-6aa1516f9f46",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Nun soll der Liter Benzin rund einen Bolivar kosten (91 Oktan) beziehungsweise 6 Bolivar für 95 Oktan - was bei einem Geldwechsel auf dem Schwarzmarkt immer noch bedeutet, dass 100 Liter Benzin nur knapp 15 Dollar-Cent kosten beziehungsweise 75 Dollar-Cent.“"
                            },
                            {
                                "example_id": "712f121e-1dea-4b28-8733-9e500a08acef",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Aber damals zahlten die Kunden auch noch mit Eurocheque, Geldwechsel gehörten im noch nicht währungsvereinten Europa zum Tagesgeschäft, und das Internet war noch eine Nischenveranstaltung.“"
                            },
                            {
                                "example_id": "059ada1b-cdbb-4d49-a1dd-8ab0dcd0dd2a",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Sie mußten sich durch ihre Kleidung zu erkennen geben und neben Abgaben an die Kirche hohe Sondersteuern für Geldwechsel, Pfandleihe und Zinsnahme entrichten.“"
                            },
                            {
                                "example_id": "b943d9e8-a185-495b-860b-7fc9422c7a09",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Die Folge ist in vielen Fällen das Gefühl, dass es beim Geldwechsel nicht mit rechten Dingen zugeht, und dieser Verdacht ist in der Tat berechtigt.“"
                            },
                            {
                                "example_id": "659e91c7-c5d3-423e-87df-6483bc336c46",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Gebührenfreier Geldwechsel, günstiger Devisenkurs und ein Höchstmaß an Sicherheit machten es konkurrenzlos preiswert.“"
                            },
                            {
                                "example_id": "d6ab876c-def6-4b4b-9ce1-898f0052833f",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Insgesamt können Schweizer in den Ferien weiter vom starken Franken profitieren, wenn sie bei der Buchung darauf achten, nicht zu teuren Angeboten geleitet zu werden, wenn sie beim Geldwechsel in ausländische Währung geschickt vorgehen und wenn sie in den Ferienorten nicht auf typische «Touri-Produkte» hereinfallen.“"
                            },
                            {
                                "example_id": "b4853312-e96d-4f98-9328-866575905d0c",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Solange der Nominalzins aber beim Geldwechsel die überragende Rolle spielt, werden Privatleute damit leben müssen, dass an der Preisschraube heftig gedreht wird.“"
                            },
                            {
                                "example_id": "832eebfe-9978-4dd2-9960-f2a12149fd40",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„In diesem Fall würde sich der Griff zum Füllhalter gar nicht mehr lohnen, weil Kunden für einfachen Geldwechsel eigentlich keine Hilfe brauchen.“"
                            },
                            {
                                "example_id": "31393913-40bc-4127-af11-1082ec975bf5",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Vor allem vor dem Geldwechsel bei privaten Händlern oder auf der Straße warnen Polizei und Bundesbank.“"
                            },
                            {
                                "example_id": "d33c2ce5-b817-4cd4-b9f4-c1956cb72a67",
                                "sense_id": "1de6809a-5ab5-3d3f-bb4b-aa482835da14",
                                "text": "„Geldwechsel ist wichtig in Djibouti, das von alters her ein Umschlagplatz und Schmelztiegel war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
