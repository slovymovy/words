                        "sense_id": "6bc43563-01e1-38f3-a923-bb0c7bf66391",
                        "entry_id": "26d74316-3ea8-3043-ac05-a3616e088551",
                        "glosses": [
                            "Violence exercée à distance via Internet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59849a5b-616e-4462-8395-1fab3daae235",
                                "sense_id": "6bc43563-01e1-38f3-a923-bb0c7bf66391",
                                "text": "Les cyberviolences regroupent toutes les formes de violences réalisées avec les écrans, diffusées sur Internet ou via les réseaux sociaux."
                            },
                            {
                                "example_id": "3f53a915-f74d-4f84-8665-98a59fda270c",
                                "sense_id": "6bc43563-01e1-38f3-a923-bb0c7bf66391",
                                "text": "Les cyberviolences dans un couple sont très souvent le prolongement de violences physiques ou psychologiques."
                            },
                            {
                                "example_id": "a7849c74-c051-4bf2-baa1-33378ee5b0b8",
                                "sense_id": "6bc43563-01e1-38f3-a923-bb0c7bf66391",
                                "text": "Mais il ne s’agit pas ici de n’importe quelle communauté de fans et on aimerait faire l’hypothèse que ceux de Kaamelott sont particulièrement prédisposés à mettre en œuvre de telles dynamiques de cyberviolence collective."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98b02b1b-6b1f-41cc-9727-30c76f73f9ed",
                        "source_entry_id": "26d74316-3ea8-3043-ac05-a3616e088551",
                        "source_sense_id": "6bc43563-01e1-38f3-a923-bb0c7bf66391",
                        "target_lang_word": "cyberviolence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyberviolence",
