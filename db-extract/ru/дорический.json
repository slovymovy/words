                "senses": [
                    {
                        "sense_id": "5b20fe96-2f02-3d61-80f8-32586f1708f5",
                        "entry_id": "9d607194-c11e-31bf-b46c-dc1b22359972",
                        "glosses": [
                            "связанный с древнегреческой областью Доридой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d6c328-6460-45a5-86d0-306525ce5703",
                                "sense_id": "5b20fe96-2f02-3d61-80f8-32586f1708f5",
                                "text": "Дорическое наречие."
                            }
                        ]
                    },
                    {
                        "sense_id": "1650d042-5442-3192-9888-5132c5b0ca2c",
                        "entry_id": "9d607194-c11e-31bf-b46c-dc1b22359972",
                        "glosses": [
                            "связанный с особым архитектурным стилем, возникшим в Дориде и отличающимся простотой и массивностью отделки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dccf42c2-0c10-48fb-b6b3-b69dd8b14417",
                                "sense_id": "1650d042-5442-3192-9888-5132c5b0ca2c",
                                "text": "Дорическая колонна. Дорический орден."
                            },
                            {
                                "example_id": "ab8fbc16-29db-4fbc-8acd-a62aaea88370",
                                "sense_id": "1650d042-5442-3192-9888-5132c5b0ca2c",
                                "text": "Но тотчас, по изгнании врага, на её месте явилась новая [будка], серенькая с белыми колонками дорического ордена, и Юрко стал опять расхаживать около неё с секирой и в броне сермяжной."
                            }
                        ]
                    }
