            {
                "entry_id": "bf97cad7-570b-349f-ab51-2105a8a893c6",
                "word": "macrophage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e0d79133-cea5-41e2-8003-2acfd4d3268f",
                        "entry_id": "bf97cad7-570b-349f-ab51-2105a8a893c6",
                        "tags": [
                            "plural"
                        ],
                        "form": "macrophages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac5560e6-7c8a-361f-9da2-7fe31c6b3883",
                        "entry_id": "bf97cad7-570b-349f-ab51-2105a8a893c6",
                        "glosses": [
                            "Cellule qui a, dans le corps des animaux, pour fonction de phagocyter les cellules étrangères à ce corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9246559f-8723-4478-b197-1a7b4e05f785",
                                "sense_id": "ac5560e6-7c8a-361f-9da2-7fe31c6b3883",
                                "text": "Face à un inoculum limité, le macrophage alvéolaire peut assumer seul la clairance bactérienne."
                            },
                            {
                                "example_id": "11677999-9804-4259-bd2d-623b220356f7",
                                "sense_id": "ac5560e6-7c8a-361f-9da2-7fe31c6b3883",
                                "text": "Les macrophages constituent le premier organisme de défense cellulaire contre les agents infectieux. On les retrouve dans tous les tissus, en particulier le thymus, la rate, les ganglions lymphatiques, les muqueuses ; en fonction de leur localisation, ils sont connus sous différentes appellations (histiocyte dans le tissu conjonctif, cellule de Kupfer dans le foie, ostéoclaste dans le tissu osseux, etc.)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fd2cf6a-7c2c-4597-8098-3c940782e8f9",
                        "source_entry_id": "bf97cad7-570b-349f-ab51-2105a8a893c6",
                        "source_sense_id": "ac5560e6-7c8a-361f-9da2-7fe31c6b3883",
