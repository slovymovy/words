                        "examples": [
                            {
                                "example_id": "140f013d-ec05-4739-be0e-a2835b624397",
                                "sense_id": "13b998a8-5e81-3428-bb77-be550e5df98c",
                                "text": "„An einem Blumenstand kaufte er eine langstielige rote Rose.“"
                            },
                            {
                                "example_id": "90264eaf-8a9f-4c4e-a24e-1ca1273d30ed",
                                "sense_id": "13b998a8-5e81-3428-bb77-be550e5df98c",
                                "text": "„Ich fuhr um den Bahnhof herum, hielt an dem Blumenstand vor der Handwerkerbank, stieg aus und ließ mir für drei Mark gelbe Tulpen geben: es waren zehn, und ich gab der Frau noch drei Mark und ließ mir noch zehn geben.“"
                            }
                        ],
