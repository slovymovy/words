                        "target_lang_word": "punch line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punch line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa058571-cdba-328a-95cc-e338a93d1f00",
                                        "entry_id": "5d0a55b9-4730-30f0-bcfc-451a7f026f32",
                                        "glosses": [
                                            "The final part of a joke; the word, sentence, or exchange of sentences that is intended to be funny and provokes laughter from the listeners."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a95661-e1a8-4fa0-9b34-81ff3c7569fa",
                                                "sense_id": "fa058571-cdba-328a-95cc-e338a93d1f00",
                                                "text": "That was quite a build-up for such a puny punch line."
                                            },
                                            {
                                                "example_id": "a92e49d6-a566-4217-b3d5-1b1c2bd5cc21",
                                                "sense_id": "fa058571-cdba-328a-95cc-e338a93d1f00",
                                                "text": "While explaining a punchline might initially kill the joke, Roberts claims it can shed light on the use of humour in language and help students remember the gag for future use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb4c213-2ee8-34c1-bb36-b06724c1a86f",
                                        "entry_id": "5d0a55b9-4730-30f0-bcfc-451a7f026f32",
                                        "glosses": [
                                            "The butt of a joke; laughing stock."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c358db0c-f7fe-4aee-9274-442e10a7ca16",
                                                "sense_id": "bdb4c213-2ee8-34c1-bb36-b06724c1a86f",
                                                "text": "The women are a phenomenon; the men are a punchline."
                                            },
                                            {
                                                "example_id": "51588a03-f38c-49ed-b9b9-52ae1401c0b0",
                                                "sense_id": "bdb4c213-2ee8-34c1-bb36-b06724c1a86f",
                                                "text": "(It didn’t help when Microsoft relaunched its Bing search engine with OpenAI’s technology inside, instantly ending Bing’s decade-long run as a punchline.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c9066b1-c2c6-36d8-b502-dc0764de44bf",
                                        "entry_id": "5d0a55b9-4730-30f0-bcfc-451a7f026f32",
                                        "glosses": [
                                            "A final, concluding statement that an explanation has been leading up to; a conclusion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414bb981-bff1-483c-99d2-c932c21b58a8",
                                                "sense_id": "7c9066b1-c2c6-36d8-b502-dc0764de44bf",
                                                "text": "The final, the Munich-based liberal newspaper writes, was a “fitting punchline” to a great tournament."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
