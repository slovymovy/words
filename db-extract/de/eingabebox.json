                "senses": [
                    {
                        "sense_id": "7519de29-1bf1-3885-b91b-ffa862aa3cbe",
                        "entry_id": "f387a071-e27b-3648-a20d-b71f4bc0fffa",
                        "glosses": [
                            "grafisches Element, in das sich Werte, Texte, Daten oder Ähnliches eintragen lassen"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "e9d01c5c-8cc4-4672-874b-889729198ef7",
                                "sense_id": "7519de29-1bf1-3885-b91b-ffa862aa3cbe",
                                "text": "„Zuerst erscheint die schon bekannte Eingabebox, in die du deinen Namen eingibst.“"
                            },
                            {
                                "example_id": "5f0e0644-95f0-4723-a09d-61cd6bae8f87",
                                "sense_id": "7519de29-1bf1-3885-b91b-ffa862aa3cbe",
                                "text": "„Jede Eingabebox ist auf eine maximale Zeichenanzahl limitiert, und jedem Nutzer steht nur begrenzter Speicherplatz zur Verfügung.“"
                            },
                            {
                                "example_id": "ab4dc365-75fd-4506-be69-18949063996b",
                                "sense_id": "7519de29-1bf1-3885-b91b-ffa862aa3cbe",
                                "text": "„Als nächstes erscheint eine Eingabebox auf dem Bildschirm, die den Namen der Datei erwartet, die geöffnet werden soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
