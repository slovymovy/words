{
    "word_family": [
        "convocation",
        "reconvoquer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae2047f4-6397-314c-820a-dc10272acd7c",
                    "sense_definition": "Ordonner à une ou plusieurs personnes de se réunir ou de se présenter devant une autorité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé de <w>convoquer</w> tous les employés dans la grande salle."
                        },
                        {
                            "text": "Pierre a été <w>convoqué</w> par son chef pour un entretien individuel important."
                        }
                    ],
                    "synonyms": [
                        "mander",
                        "appeler"
                    ],
                    "common_phrases": [
                        "convoquer une réunion",
                        "convoquer les délégués"
                    ]
                },
                {
                    "sense_id": "7b0aab77-3196-35ba-bf38-c44870573a8f",
                    "sense_definition": "Assigner ou sommer quelqu'un de comparaître formellement devant une juridiction ou la police.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé est <w>convoqué</w> devant le tribunal correctionnel pour répondre de ses actes."
                        },
                        {
                            "text": "Les enquêteurs ont <w>convoqué</w> le témoin pour recueillir sa déposition officielle."
                        }
                    ],
                    "synonyms": [
                        "assigner",
                        "citer"
                    ],
                    "common_phrases": [
                        "convoquer un témoin",
                        "convoquer au tribunal"
                    ]
                },
                {
                    "sense_id": "08c81b0d-c0f2-376e-8d2f-e4eead6b91ab",
                    "sense_definition": "Faire appel à, évoquer ou mobiliser des souvenirs, des images ou des concepts abstraits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son nouveau roman, l'écrivain aime <w>convoquer</w> les souvenirs de son enfance."
                        },
                        {
                            "text": "Le conférencier a su <w>convoquer</w> de nombreuses références philosophiques dans son argumentation."
                        }
                    ],
                    "synonyms": [
                        "évoquer",
                        "mobiliser"
                    ],
                    "common_phrases": [
                        "convoquer des souvenirs",
                        "convoquer le passé"
                    ]
                }
            ]
        }
    ]
}