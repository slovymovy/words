                                "example_id": "c373a503-28ae-477f-8798-68327f5959ed",
                                "sense_id": "a58158b1-5a0d-32f0-a849-bef89216f368",
                                "text": "Ik mocht het gekochte boek wel voor mijn eigen gebruik kopiëren, maar ik mag die kopieën niet verkopen op marktplaats."
                            },
                            {
                                "example_id": "1fa9fde1-4765-45a2-b8f2-fc5143a48257",
                                "sense_id": "a58158b1-5a0d-32f0-a849-bef89216f368",
                                "text": "Daar verdeelde ik de volgende paar uur ontelbare zojuist gekochte producten in grote postdozen."
                            },
                            {
                                "example_id": "bf3d43fa-abdc-4bb4-b21d-0de5b5a3319a",
                                "sense_id": "a58158b1-5a0d-32f0-a849-bef89216f368",
                                "text": "Mijn pas gekochte gymschoenen knellen bij de tenen en de zool begint een beetje los te laten."
                            }
                        ]
                    }
                ],
