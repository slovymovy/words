                                                "example_id": "baf675e1-c625-4095-a6d9-fb183892ca67",
                                                "sense_id": "463ee060-cfb9-394e-866f-e08906bcfe32",
                                                "text": "Zaváže-li se plátce k placení důchodu na dobu života nějaké osoby nebo na dobu delší než pět let, vyžaduje smlouva písemnou formu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "408bf682-7954-4430-810a-639e0f012077",
                        "source_entry_id": "ab8e5431-397a-3396-b4cd-8e95a6b3f9b5",
                        "source_sense_id": "f43ba71f-d14a-3f3a-bb48-f0c513488666",
                        "target_lang_word": "payeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "payeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8365e774-c38b-3c2b-b018-636c00dc9597",
                                        "entry_id": "cd383334-f3f0-3bbb-9ba8-0b80593d51eb",
                                        "glosses": [
                                            "Celui qui paie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08e93b1-449c-4cd9-a873-c259684e775d",
                                                "sense_id": "8365e774-c38b-3c2b-b018-636c00dc9597",
                                                "text": "C’est un bon payeur, c’est une mauvaise payeuse.."
                                            },
                                            {
                                                "example_id": "8bcc7077-f5cb-4a52-a632-35f79bac635d",
                                                "sense_id": "8365e774-c38b-3c2b-b018-636c00dc9597",
                                                "text": "Il me nomma même trésorier des tributs que l'Arabie Pétrée payait au roi des rois. Je fis ma charge de receveur et point du tout celle de payeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98fb413e-2f02-339f-8d95-0b6f46e3aac1",
                                        "entry_id": "cd383334-f3f0-3bbb-9ba8-0b80593d51eb",
                                        "glosses": [
                                            "Celui qui est chargé par son emploi, par son office de payer des dépenses, des traitements, des rentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "712b0dc2-5537-4c9c-afc2-0681bdf1bb12",
                                                "sense_id": "98fb413e-2f02-339f-8d95-0b6f46e3aac1",
                                                "text": "Il est payeur à la trésorerie."
                                            },
                                            {
                                                "example_id": "065e207a-e3ce-474f-b577-e532e0215047",
                                                "sense_id": "98fb413e-2f02-339f-8d95-0b6f46e3aac1",
                                                "text": "Payeur de l’armée, payeur divisionnaire se dit en temps de guerre."
                                            }
                                        ]
                                    }
                                ]
                            },
