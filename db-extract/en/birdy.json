                        "glosses": [
                            "Diminutiv von Vogel; Vögelchen, Vöglein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e05c8b27-b1a9-4990-b730-04b9c784e287",
                                "sense_id": "cebeac8c-5faf-33af-9f8d-b5bdc8bfa4d1",
                                "text": "Aw, that's a cute little birdy. Is it a budgie?",
                                "translation": "Oh, das ist ein süßes kleines Vöglein. Ist es ein Wellensittich?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a111b9ca-4d24-4276-a88c-23d408319f1e",
                        "source_entry_id": "40ef6f84-2a0c-3ede-aa93-1224d763c3b9",
                        "source_sense_id": "cebeac8c-5faf-33af-9f8d-b5bdc8bfa4d1",
                        "source_sense_description": "Diminutiv von Vogel; Vögelchen, Vöglein",
                        "target_lang_word": "Vögelchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vögelchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                        "entry_id": "466ffe92-d71b-3d1a-b054-1a90e18500e1",
                                        "glosses": [
                                            "kleiner Vogel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72198ce3-fcd3-4264-ad33-7607d62c7044",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "Guck mal, eine Kuckucksuhr! Wenn du genau hinsiehst, kannst du gleich ein kleines Vögelchen sehen, das herausschaut."
                                            },
                                            {
                                                "example_id": "5bf2380a-4b0a-484e-b6b7-470e7bdb3e41",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "„Ein paar Mal kreiste das Vögelchen über der Polizeistation, bevor es hinüber zum Grün der Sportplätze flog.“"
                                            },
                                            {
                                                "example_id": "1ede66a2-8417-4018-b07e-e88f55265269",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "„Dort war eines Nachmittags ein Vögelchen durch eines der sommerlich geöffneten Fenster hereingeflattert.“"
                                            },
                                            {
                                                "example_id": "19df51c0-5c88-4f6d-b1b0-85716c989d75",
                                                "sense_id": "1603c599-6397-314f-9b54-f4754a31f502",
                                                "text": "„Sie nippte an dem Braten wie ein Vögelchen und aß ein paar Graupen und trank drei Mundvoll Wein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e8f9ae2-cfa0-4afa-8f1c-e689d113edb1",
                        "source_entry_id": "40ef6f84-2a0c-3ede-aa93-1224d763c3b9",
                        "source_sense_id": "cebeac8c-5faf-33af-9f8d-b5bdc8bfa4d1",
                        "source_sense_description": "Diminutiv von Vogel; Vögelchen, Vöglein",
                        "target_lang_word": "Vöglein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vöglein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48149fe8-467b-332c-99a4-3c74a44aa88e",
                                        "entry_id": "a7797655-3750-3b71-8daf-971961ecb684",
                                        "glosses": [
                                            "kleiner Vogel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e578b66e-ac43-4801-9ddb-daea464e70a0",
                                                "sense_id": "48149fe8-467b-332c-99a4-3c74a44aa88e",
                                                "text": "„Wenn ich ein Vöglein wär…“"
                                            },
                                            {
                                                "example_id": "c5dd1d59-f536-4bde-8009-4d03769826d9",
                                                "sense_id": "48149fe8-467b-332c-99a4-3c74a44aa88e",
                                                "text": "[Aschenputtel:] Da kamen zum Küchenfenster zwei weiße Täubchen herein, und danach die Turteltäubchen, und endlich schwirrten und schwärmten alle Vöglein unter dem Himmel herein, und ließen sich um die Asche nieder."
                                            },
                                            {
                                                "example_id": "9e90ba0e-d924-4bfe-b913-409226d30218",
                                                "sense_id": "48149fe8-467b-332c-99a4-3c74a44aa88e",
                                                "text": "Mir hat ein Vöglein gezwitschert, Sie würden die nächste Vorsitzende werden?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "491f797b-8ec1-4f59-a835-996391b38900",
                        "source_entry_id": "40ef6f84-2a0c-3ede-aa93-1224d763c3b9",
                        "source_sense_id": "cebeac8c-5faf-33af-9f8d-b5bdc8bfa4d1",
                        "source_sense_description": "Diminutiv von Vogel; Vögelchen, Vöglein",
                        "target_lang_word": "oiselle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oiselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6feb45-3677-335b-adb6-fb44c706cf46",
                                        "entry_id": "f506c548-604b-3859-933d-45b983217e80",
                                        "glosses": [
                                            "Femelle oiseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294a902e-47f1-4f74-b8f8-5f4df2497a68",
                                                "sense_id": "0b6feb45-3677-335b-adb6-fb44c706cf46",
                                                "text": "Est-ce bien toi, cet enfant\nTriomphant,\nDont le père, ouvrant son aile,\nAu fond d’un nid de roseau\nFut oiseau,\nDont la mère fut oiselle ?"
                                            },
                                            {
                                                "example_id": "2cbe14a5-a70c-4fda-90ea-3d21b1278a07",
                                                "sense_id": "0b6feb45-3677-335b-adb6-fb44c706cf46",
                                                "text": "Si les autres sont dams oiseaux, elle me semble dame oiselle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f51a3392-5002-3677-80d8-2cac646ceb2c",
                                        "entry_id": "f506c548-604b-3859-933d-45b983217e80",
                                        "glosses": [
                                            "Jouvencelle, jeune fille dans la fleur de l’âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cf74f77-2e85-433c-8457-dfdf701667c3",
                                                "sense_id": "f51a3392-5002-3677-80d8-2cac646ceb2c",
                                                "text": "Les invités de cette étrange matinée se retiraient par groupes, causant et commentant, surtout admirant la charmante oiselle…"
                                            },
                                            {
                                                "example_id": "21a19362-0f04-4739-b62e-cb5d6db458c2",
                                                "sense_id": "f51a3392-5002-3677-80d8-2cac646ceb2c",
                                                "text": "Quant à Mʳ Henry dactylographe, qu’il apprenne que j’en ai depuis hier une exquise, une vraie, une de ces tonnerres de sages, prestes et débrouillardes charmantes petites oiselles du pavé de Paris. J’aime mieux sentir Maître Henry aux Brenets que par ici, car il m'enlèverait mon petit z’oiseau."
                                            },
                                            {
                                                "example_id": "15b1cbcc-3499-499f-98e2-922bbca8d992",
                                                "sense_id": "f51a3392-5002-3677-80d8-2cac646ceb2c",
                                                "text": "Et il est évident que les lois françaises ont été iniques grâce à Napoléon qui avait le malheur d’avoir des sœurs sottes à souhait, et dévergondées, et il s’est dit : on ne peut pas laisser une famille entre les mains de pareilles oiselles."
                                            }
                                        ]
                                    }
                                ]
                            },
