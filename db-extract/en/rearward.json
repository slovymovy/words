                                "example_id": "22ec25ad-ee34-4254-93da-57b8a915b6f9",
                                "sense_id": "14ef2043-f4ea-376a-af22-ce4972187095",
                                "text": "The rearward seats of the bus were unpleasantly close to the toilet facilities."
                            },
                            {
                                "example_id": "d6e264e4-e9fe-48c1-98de-f3d4c0d4f5b0",
                                "sense_id": "14ef2043-f4ea-376a-af22-ce4972187095",
                                "text": "Unlike the earlier standard designs, in which the whole of the footplate was on the engine, fall plates are re-introduced and these are hinged from the front of the tender to rest on the rearward extension of the cab floor."
                            }
                        ]
