                        "glosses": [
                            "To write or utter pretentious statements."
                        ],
                        "tags": [
                            "dated",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "66fd6a06-dec6-4d75-940f-f7cf6d6ad921",
                                "sense_id": "4467ee55-564b-3ef5-8429-648d40fc0d6d",
                                "text": "What is a poet's love? — / To write a girl a sonnet, / To get a ring, or some such thing, / And fustianize upon it."
                            },
                            {
                                "example_id": "2288cc81-af64-4b67-8b54-2a9166d7a2d3",
                                "sense_id": "4467ee55-564b-3ef5-8429-648d40fc0d6d",
                                "text": "When they talk war they amuse the soldier and when they fustianize about advertising, they make such statements as, “Advertising Is Literature\" or “Advertising is the greatest force in modern business,\" which it is not."
                            }
                        ]
                    }
