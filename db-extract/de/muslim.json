                ],
                "senses": [
                    {
                        "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                        "entry_id": "3786a5be-364e-3cfd-9d7c-379a3165d06b",
                        "glosses": [
                            "Anhänger der islamischen Religion"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "684bd69a-293b-41cd-b55b-b64e25284649",
                                "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                                "text": "In Deutschland leben mehr als drei Millionen Muslime."
                            },
                            {
                                "example_id": "91bf9dcb-1cbd-4a63-822e-b2e7b483cdf2",
                                "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                                "text": "Ein Muslim sollte jeden Tag fünfmal beten."
                            },
                            {
                                "example_id": "aa9036e6-ba6a-4416-9396-93fa9255be0c",
                                "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                                "text": "Zu den Pflichten des Muslim(s) gehört die Pilgerfahrt nach Mekka."
                            },
                            {
                                "example_id": "b56dbd76-b788-479a-82f2-c7b7368fa13d",
                                "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                            },
                            {
                                "example_id": "414815c4-8d2a-40f1-ab7a-6dc9952793fe",
                                "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                                "text": "„Sie fordern Hindus auf, zehn Kinder zu bekommen, um die Muslime zu verdrängen.“"
                            },
                            {
                                "example_id": "d1731f7a-d327-4be8-a141-e3dcbaa907ba",
                                "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                                "text": "„Während die meisten Berliner letzte Nacht tief und fest schliefen, begann für viele Muslime um 1.13 Uhr der erste Fastentag des Ramadan.“"
                            },
                            {
                                "example_id": "172716c7-5e66-4b7b-8260-5300dc076988",
                                "sense_id": "08ac883b-bb2a-3c18-9c86-931a769e5585",
                                "text": "„Dies gab dem Maharadscha noch einmal die Gelegenheit, seine Wut an den verbliebenen Muslimen auszulassen, es gab Pogrome und Vertreibungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
