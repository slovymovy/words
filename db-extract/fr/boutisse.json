                                    {
                                        "sense_id": "35da1a76-333e-3513-8478-089c35385cd8",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "The act of hitting the ball with the head."
