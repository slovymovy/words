                "senses": [
                    {
                        "sense_id": "abffa1d1-7b60-3ffc-94ce-e50888c868ee",
                        "entry_id": "04f3004b-d82f-3923-acc7-68eb014639e1",
                        "glosses": [
                            "Messfühler, der zur Messung der Temperatur dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7a07a65-f3ae-4c03-bf6f-54f9234b5607",
                                "sense_id": "abffa1d1-7b60-3ffc-94ce-e50888c868ee",
                                "text": "„Temperatursensoren sind elektronische Bauteile, die die anliegende Temperatur in eine elektrische Größe umwandeln.“"
                            },
                            {
                                "example_id": "1b57993a-8626-4574-80b3-a6b1492b9bfe",
                                "sense_id": "abffa1d1-7b60-3ffc-94ce-e50888c868ee",
                                "text": "„Eine Temperaturdifferenz der Umgebung gegenüber dem Temperatursensor führt zu einem Wärmestrom aus der Umgebung in den Sensor oder umgekehrt.“"
                            },
                            {
                                "example_id": "85f53387-341f-4faa-87e4-ec2b751c6c36",
                                "sense_id": "abffa1d1-7b60-3ffc-94ce-e50888c868ee",
                                "text": "„Diese Temperatursensoren sind nichts anderes als veränderliche Widerstände in einem Plastikgehäuse“"
                            },
                            {
                                "example_id": "7280932d-a5b0-4411-96db-7f104e27621b",
                                "sense_id": "abffa1d1-7b60-3ffc-94ce-e50888c868ee",
                                "text": "„Die KTY-Temperatursensoren sind verglichen mit anderen Temperatursensoren verhältnismäßig günstig, haben dafür aber auch mehr Nachteile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
