                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4dd5776b-a233-4153-8c46-0af216a67d8c",
                        "source_entry_id": "8ede62d4-34dd-3703-a84d-b73cc1e61bf4",
                        "source_sense_id": "cbb84f49-ef6d-320c-889d-e8e73634490f",
                        "source_sense_description": "bearing fruit",
                        "target_lang_word": "fruitier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fruitier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3370ae4a-0d66-309c-834d-3ea347db1512",
                                        "entry_id": "b04e7c4e-c1e1-36f2-bb86-75cf229bcb80",
                                        "glosses": [
                                            "Qui porte des fruits ; qui concerne les fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "218024e2-abf6-4496-be5f-6fe2fe2747a8",
                                                "sense_id": "3370ae4a-0d66-309c-834d-3ea347db1512",
                                                "text": "Un arbre fruitier, est un arbre qui porte des fruits bons à manger."
                                            },
                                            {
                                                "example_id": "86387823-6544-4f33-9d9e-423cbece47e9",
                                                "sense_id": "3370ae4a-0d66-309c-834d-3ea347db1512",
                                                "text": "M. Nallet est un de ces hommes entièrement dévoués à l’arboriculture fruitière et qui met son jardin et les résultats de ses expériences à la disposition de tout le monde."
                                            },
                                            {
                                                "example_id": "8dc3c434-3d46-4f29-90b1-f2009ce709d5",
                                                "sense_id": "3370ae4a-0d66-309c-834d-3ea347db1512",
                                                "text": "Après avoir considéré le jardin potager comme distinct des autres parties en culture, je traiterai du jardin fruitier dans un chapitre particulier et je donnerai quelques détails sur sa disposition, parce qu’elle importe beaucoup à sa production."
                                            },
                                            {
                                                "example_id": "0c5e86d9-0469-4adb-b710-6a094e41fb21",
                                                "sense_id": "3370ae4a-0d66-309c-834d-3ea347db1512",
                                                "text": "On ne dispose d’informations détaillées sur la production fruitière que pour quelques espèces seulement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fruitier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e89ef2f8-2d11-36f8-881a-ade76617f15a",
                                        "entry_id": "5673b7a8-2f2b-3433-aa91-c0a84d2b2e1f",
                                        "glosses": [
                                            "Celui qui fait le commerce au détail des fruits, du fromage et du beurre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92292d7f-af32-4770-a108-0628cb4d43ef",
                                                "sense_id": "e89ef2f8-2d11-36f8-881a-ade76617f15a",
                                                "text": "Il s’est fait fruitier."
                                            },
                                            {
                                                "example_id": "6c81446d-e10f-41d4-9216-8b1f0936be20",
                                                "sense_id": "e89ef2f8-2d11-36f8-881a-ade76617f15a",
                                                "text": "À propos, Augustine, mon rez-de-chaussée est loué ; je viens d’en recevoir la nouvelle ; il est loué à un fruitier."
                                            },
                                            {
                                                "example_id": "2d808052-ec44-4800-90b1-2f35fb1fc554",
                                                "sense_id": "e89ef2f8-2d11-36f8-881a-ade76617f15a",
                                                "text": "M. Tom Smallways était fruitier de son état et jardinier par vocation, et Jessica, sa modeste épouse, vaquait aux soins de la boutique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29f9986-4efc-3edb-a323-f0c2b7fc0d64",
                                        "entry_id": "5673b7a8-2f2b-3433-aa91-c0a84d2b2e1f",
                                        "glosses": [
                                            "Artisan chargé de la fabrication du gruyère."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e61363e8-85fc-487d-bbb4-1199ede9f2db",
                                                "sense_id": "a29f9986-4efc-3edb-a323-f0c2b7fc0d64",
                                                "text": "fruitier, c’est l’homme qui, dans les montagnes de la Suisse, est chargé de la fabrication des fromages dits de Gruyère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fruitier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e23cbd8f-cca4-37d9-897c-8c99c6e36869",
                                        "entry_id": "301aee78-24cf-3795-bc3b-46903dd96178",
                                        "glosses": [
                                            "Lieu où l’on conserve les fruits pendant l’hiver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42251c8f-73ab-49e7-a467-74b0be252659",
                                                "sense_id": "e23cbd8f-cca4-37d9-897c-8c99c6e36869",
                                                "text": "Toutes ces espèces de pommes se conservent jusqu’en mars et avril. Néanmoins, si l’on néglige de visiter le fruitier, au moins trois ou quatre fois par semaine, une seule poire ou une seule pomme qui se gâtera pourra perdre une planche entière. […]\nUne chose qu’il faut éviter, c’est de mettre dans le fruitier des potirons, des coloquintes, des concombres du Canada ; toutes ces plantes […] répandraient une odeur forte, qui serait très nuisible aux fruits."
                                            },
                                            {
                                                "example_id": "b74f4fcc-c7a9-42e0-9d11-c42244c321a7",
                                                "sense_id": "e23cbd8f-cca4-37d9-897c-8c99c6e36869",
                                                "text": "Au-dessus de ces constructions légères, on avait ménagé des greniers, un fruitier et une chambre de domestique."
                                            },
                                            {
                                                "example_id": "2d8a0187-c501-48ea-8e64-acd3002b448e",
                                                "sense_id": "e23cbd8f-cca4-37d9-897c-8c99c6e36869",
                                                "text": "Pour compléter la disposition du fruitier, il faut en faire boiser les murs ou les couvrir de paillassons ou de nattes, afin d'empêcher la température intérieure de s'équilibrer avec celle de l'extérieur; en un mot, l'entourer de corps mauvais conducteurs du calorique pour en prévenir la déperdition."
                                            },
                                            {
                                                "example_id": "ad2bd259-824c-42b3-a057-5b0d35251479",
                                                "sense_id": "e23cbd8f-cca4-37d9-897c-8c99c6e36869",
                                                "text": "Mais je me plaisais dans le fruitier, où des pommes et des poires mûrissaient sur des claies, et dans les celliers, parmi les tonneaux, les bouteilles, les jambons, les saucissons, les chapelets d’oignons et de champignons séchés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e124f4a-ca07-3c60-97c9-87c8cc2ac4e8",
                                        "entry_id": "301aee78-24cf-3795-bc3b-46903dd96178",
                                        "glosses": [
                                            "Jardin à fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269f977b-d4dc-4a90-9d81-6d820ef3d64a",
                                                "sense_id": "1e124f4a-ca07-3c60-97c9-87c8cc2ac4e8",
                                                "text": "En ce dernier sens, on dit aussi absolument et substantivement, Un fruitier, pour, Un jardin rempli uniquement d’arbres à fruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa77da8a-87f5-3054-8a55-fa06c0936141",
                                        "entry_id": "301aee78-24cf-3795-bc3b-46903dd96178",
                                        "glosses": [
                                            "Arbre fruitier."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "636e4907-98fb-4f17-bf36-de8457001e23",
                                                "sense_id": "fa77da8a-87f5-3054-8a55-fa06c0936141",
                                                "text": "Un fruitier nain, un fruitier en espalier, à plein vent."
                                            },
                                            {
                                                "example_id": "fa44cc67-249e-4ec0-bb96-381f1004e595",
                                                "sense_id": "fa77da8a-87f5-3054-8a55-fa06c0936141",
                                                "text": "Préparez le sol en vue des plantations de fruitiers"
                                            },
                                            {
                                                "example_id": "9dd05e65-cd84-437a-adfa-25a1d696841f",
                                                "sense_id": "fa77da8a-87f5-3054-8a55-fa06c0936141",
                                                "text": "Si les températures se réchauffent trop rapidement, les fruitiers sont aussi exposés aux gelées tardives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
