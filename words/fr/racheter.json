{
    "word_family": [
        "rachat",
        "rachetable",
        "racheteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a6cb8ae-3d5d-3c6f-9ef7-db53a6edbc69",
                    "sense_definition": "Acheter de nouveau un produit ou un objet que l'on n'a plus ou qu'on a épuisé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme nous n'avons plus de lait pour le petit-déjeuner, je vais en <w>racheter</w> ce soir."
                        },
                        {
                            "text": "Elle a cassé sa tasse préférée hier matin et doit en <w>racheter</w> une autre demain."
                        }
                    ],
                    "common_phrases": [
                        "racheter du pain",
                        "racheter des fournitures"
                    ]
                },
                {
                    "sense_id": "8c116219-ee1f-3b50-ae3c-29cfd390cf96",
                    "sense_definition": "Acquérir une entreprise, un commerce ou des parts appartenant à un tiers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le groupe international a décidé de <w>racheter</w> cette jeune entreprise en plein essor."
                        },
                        {
                            "text": "Les associés négocient depuis plusieurs semaines pour <w>racheter</w> les parts de leur collègue."
                        }
                    ],
                    "synonyms": [
                        "acquérir",
                        "reprendre"
                    ],
                    "common_phrases": [
                        "racheter une entreprise",
                        "racheter des parts"
                    ]
                },
                {
                    "sense_id": "68526d15-118e-3655-9e2e-24c965a8b9d0",
                    "sense_definition": "Compenser un défaut ou faire pardonner une mauvaise action par une attitude positive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a marqué deux buts superbes pour <w>racheter</w> son erreur commise en début de partie."
                        },
                        {
                            "text": "Sa grande générosité et sa gentillesse constante <w>rachètent</w> largement ses petits caprices quotidiens."
                        }
                    ],
                    "synonyms": [
                        "compenser",
                        "réparer"
                    ],
                    "common_phrases": [
                        "racheter une erreur",
                        "se racheter d'une faute"
                    ]
                },
                {
                    "sense_id": "9b17c8b1-76ce-3a07-8f10-24ea8ce77f39",
                    "sense_definition": "Délivrer une personne captive ou prisonnière en versant une somme d'argent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les familles ont réuni une somme colossale pour <w>racheter</w> les captifs aux mains des pirates."
                        },
                        {
                            "text": "Autrefois, certains souverains envoyaient des émissaires afin de <w>racheter</w> les prisonniers de guerre."
                        }
                    ],
                    "common_phrases": [
                        "racheter un captif",
                        "racheter un otage"
                    ]
                },
                {
                    "sense_id": "0ece4b3a-f3c1-348a-953f-08cd1876037f",
                    "sense_definition": "Se libérer d'une obligation financière périodique ou d'une rente en payant un capital.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'emprunteur a choisi de <w>racheter</w> sa rente viagère afin de clore définitivement le contrat."
                        },
                        {
                            "text": "Le débiteur a versé une indemnité forfaitaire pour <w>racheter</w> cette lourde redevance annuelle."
                        }
                    ],
                    "synonyms": [
                        "amortir"
                    ],
                    "common_phrases": [
                        "racheter une rente",
                        "racheter une pension"
                    ]
                }
            ]
        }
    ]
}