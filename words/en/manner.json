                            },
                            {
                                "target_lang_word": "образ",
                                "target_lang_sense_clarification": "способ осуществления чего-либо"
                            },
                            {
                                "target_lang_word": "способ",
                                "target_lang_sense_clarification": "метод достижения цели"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "biçim",
                                "target_lang_sense_clarification": "tarz veya şekil"
                            },
                            {
                                "target_lang_word": "tarz",
                                "target_lang_sense_clarification": "yapılış şekli"
                            },
                            {
                                "target_lang_word": "yol",
                                "target_lang_sense_clarification": "yöntem, biçim"
