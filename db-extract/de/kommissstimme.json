                "senses": [
                    {
                        "sense_id": "0177626c-1553-3c43-bea3-dc590605f7fd",
                        "entry_id": "a78c134d-84a7-3e6c-942b-596680ef9b84",
                        "glosses": [
                            "barsche Stimmenlage, militärischer Ton"
