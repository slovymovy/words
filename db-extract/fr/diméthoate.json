                "senses": [
                    {
                        "sense_id": "9c6bbbf5-6c5f-3eda-9fdd-fa3abdb80409",
                        "entry_id": "720f7782-2100-3a14-ad34-1d74ed72d4a4",
                        "glosses": [
                            "Composé organothiophosphoré de formule chimique C₅H₁₂O₃PS₂N , à usage d'insecticide endothérapique sur de nombreux insectes, avec une certaine action acaricide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e444a3ca-68f8-4b15-8ccd-8c255cc31180",
                                "sense_id": "9c6bbbf5-6c5f-3eda-9fdd-fa3abdb80409",
                                "text": "La lutte contre les thrips peut être réalisée à l'aide d'insecticide tels que diméthoate ou thiométon."
                            },
                            {
                                "example_id": "30f8b564-09aa-40de-b249-a77f1b3fde8a",
                                "sense_id": "9c6bbbf5-6c5f-3eda-9fdd-fa3abdb80409",
                                "text": "Dans le cadre d'autorisations de mise sur le marché, des produits phytopharmaceutiques à base de diméthoate peuvent être utilisés contre les mouches des fruits. Compte tenu de ses caractéristiques toxicologiques, le diméthoate est la seule substance active pour laquelle un risque lié aux résidus a été identifié dans la seconde étude alimentation totale conduite par l'agence nationale de sécurité sanitaire de l'alimentation, de l'environnement et du travail."
                            }
                        ]
                    }
                ],
