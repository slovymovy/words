                    {
                        "form_id": "ed0cdb3a-0534-424a-838d-ef4d535cb2b4",
                        "entry_id": "922601ea-231c-363b-8dbd-aef914ca11b9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Koeffizienten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df6dae80-ca08-3805-8006-a2de7d52d171",
                        "entry_id": "922601ea-231c-363b-8dbd-aef914ca11b9",
                        "glosses": [
                            "Faktor vor einer Variablen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25cabfc8-c75f-492a-b064-1be8bd170499",
                                "sense_id": "df6dae80-ca08-3805-8006-a2de7d52d171",
                                "text": "„Es müssen so nur noch die Koeffizienten der einzelnen Summanden bestimmt werden.“"
                            },
                            {
                                "example_id": "88965ea7-eb2b-4656-9144-340e3a0b0ffb",
                                "sense_id": "df6dae80-ca08-3805-8006-a2de7d52d171",
                                "text": "„Die Gesamtminutensumme regelmäßig wiederkehrender Werke in Sendungen, die im vorstehenden Sinne mit Koeffizient 1 abzurechnen sind, wird folgendermaßen verrechnet:“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf695a67-aee5-38a3-b032-10b1583ed3b7",
                        "entry_id": "922601ea-231c-363b-8dbd-aef914ca11b9",
                        "glosses": [
                            "Kennzahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e0d7e0-03a8-493d-bb79-510584792349",
                                "sense_id": "bf695a67-aee5-38a3-b032-10b1583ed3b7",
                                "text": "„Mit dem Berner Sieg war der Sprung in den Topf der gesetzten Teams perfekt, weil kurz zuvor mit RSC Anderlecht schon die erste Mannschaft mit dem besseren Koeffizienten als Borussia gescheitert war.“"
                            },
                            {
                                "example_id": "4034c787-f5d6-47e5-9cc0-9aedcc0408c3",
                                "sense_id": "bf695a67-aee5-38a3-b032-10b1583ed3b7",
                                "text": "„Wenn ein Koeffizient 1 vollkommene Übereinstimmung bedeute, erreiche sie einen Wert von 0,86; mehr als der kanadische Dollar (0,81), der mexikanische Peso (0,78) und der brasilianische Real (0,66).“"
                            },
                            {
                                "example_id": "c092ef96-df90-4d29-b5b1-8a30382d6330",
                                "sense_id": "bf695a67-aee5-38a3-b032-10b1583ed3b7",
                                "text": "„Für die USA wird ein Koeffizient von 0,41 errechnet, für Russland 0,46. Die ungleichste Verteilung weist Namibia mit 0,71 auf.“"
                            },
                            {
                                "example_id": "9001ded3-5596-4f94-ab30-3ce95e692f6e",
                                "sense_id": "bf695a67-aee5-38a3-b032-10b1583ed3b7",
                                "text": "„In unserem Beispiel in der [sic!] wir die Weltbevölkerung betrachten ergibt sich für 1993 ein Koeffizient von 0,006, was auf eine sehr starke Ungleichverteilung hinweist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62fcc614-784a-44f8-bcf6-50e75a8c2711",
                        "source_entry_id": "922601ea-231c-363b-8dbd-aef914ca11b9",
                        "source_sense_id": "df6dae80-ca08-3805-8006-a2de7d52d171",
                        "source_sense_description": "Mathematik: Faktor vor einer Variablen",
                        "target_lang_word": "coefficient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coefficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2586ae80-7c6f-3e72-815a-efeb34b5675d",
                                        "entry_id": "1620f0db-fa8f-3a77-95ec-fe51c8956518",
                                        "glosses": [
                                            "Cooperating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d6f724-dab3-4981-98d4-fd8a1358274b",
                                                "sense_id": "2586ae80-7c6f-3e72-815a-efeb34b5675d",
                                                "text": "And so our own idea of Christ compels us to admit that two factors, the one natural, the other supernatural, were coefficient in his entrance into human life;"
                                            },
                                            {
                                                "example_id": "c5de11c2-c898-4992-aa21-75583d89a383",
                                                "sense_id": "2586ae80-7c6f-3e72-815a-efeb34b5675d",
                                                "text": "Nevertheless, there was some substance to the notion that acclaim and merit were coefficient."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coefficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f372e716-3af8-31aa-b730-31efd9b6f401",
                                        "entry_id": "fc10e511-8128-307f-a96b-5f8c2e4ff5a4",
                                        "glosses": [
                                            "A constant by which an algebraic term is multiplied."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3210b383-8e63-3afd-9480-7ca07d2648ff",
                                        "entry_id": "fc10e511-8128-307f-a96b-5f8c2e4ff5a4",
                                        "glosses": [
                                            "An entry of a matrix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d468d35-d430-4f51-8b3c-567f41fbce81",
                                                "sense_id": "3210b383-8e63-3afd-9480-7ca07d2648ff",
                                                "text": "Notice that many of the terms of the matrices [Sᵉ] (e = 1, 2, 3) vanish. We call the non-vanishing coefficients of the matrix [Sᵉ] the stiffness coefficients of element e and we denote them by Kᵣₛᵉ."
                                            },
                                            {
                                                "example_id": "b23950f7-9364-4f80-a110-dab73001b346",
                                                "sense_id": "3210b383-8e63-3afd-9480-7ca07d2648ff",
                                                "text": "Definition 3.7. A lattice Λ is called an integral lattice if its Gram matrix has coefficients in ℤ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4528e2f4-ef05-358a-aa6d-c68a3212e03a",
                                        "entry_id": "fc10e511-8128-307f-a96b-5f8c2e4ff5a4",
                                        "glosses": [
                                            "A number, value, or item that serves as a measure of some property or characteristic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c77ab1d-9d5f-4717-a132-40d441f022e9",
                                                "sense_id": "4528e2f4-ef05-358a-aa6d-c68a3212e03a",
                                                "text": "Near-synonym: constant"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "995d8089-b487-4738-8ad8-d819d30a5226",
                        "source_entry_id": "922601ea-231c-363b-8dbd-aef914ca11b9",
                        "source_sense_id": "df6dae80-ca08-3805-8006-a2de7d52d171",
                        "source_sense_description": "Mathematik: Faktor vor einer Variablen",
                        "target_lang_word": "coefficient",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coefficient",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99a5eba8-eb48-3d5a-9b32-7cfb9f6af0d4",
                                        "entry_id": "e44b2b6b-1e46-33b5-a033-8739c69e66ba",
                                        "glosses": [
                                            "Efficient, qui produit un effet."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4658cec-f984-4a48-b04b-e5c202161e23",
                                                "sense_id": "99a5eba8-eb48-3d5a-9b32-7cfb9f6af0d4",
                                                "text": "Il est, à certaines époques, des noms, des institutions, des pouvoirs à qui l’on prête tous les malheurs, à qui l’on dénie leurs talents, et qui servent de raison coefficiente aux sots."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coefficient",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50978baa-60f2-3bfe-90ce-bc60fae4e73c",
                                        "entry_id": "ced1c16f-1bc8-3f36-bb36-ef5776bd4384",
                                        "glosses": [
                                            "Facteur connu d’une inconnue, dans une équation."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dedc8c2c-c1f5-4d82-97d5-359f1b4e357a",
                                                "sense_id": "50978baa-60f2-3bfe-90ce-bc60fae4e73c",
                                                "text": "On a représenté (fig. 12) les valeurs des logarithmes des coefficients d’aimantation (LK) en fonction des logarithmes de la température absolue (LT)."
                                            },
                                            {
                                                "example_id": "22e4ea66-dc93-466b-90d6-655667765e43",
                                                "sense_id": "50978baa-60f2-3bfe-90ce-bc60fae4e73c",
                                                "text": "Pour caractériser la cubicité, c’est-à-dire la forme aussi compacte que possible des grains d’agrégats, l’AFNOR a défini un coefficient volumétrique qui peut s’appliquer soit à un grain, soit à l’ensemble des grains d’un agrégat."
                                            },
                                            {
                                                "example_id": "1d4e0791-2da4-4a30-af07-98306254d08c",
                                                "sense_id": "50978baa-60f2-3bfe-90ce-bc60fae4e73c",
                                                "text": "Le coefficient de sécurité au glissement du talus seul (sans sa fondation) est, dans ces conditions, proche de la valeur du rapport de la tangente de l’angle de talutage à celle de l’angle de frottement interne."
                                            },
                                            {
                                                "example_id": "3ed62f63-254e-4f2b-908b-21453e05f909",
                                                "sense_id": "50978baa-60f2-3bfe-90ce-bc60fae4e73c",
                                                "text": "Le glissant est généralement apporté par une addition d’érucamide dont le pourcentage dépend de la cadence de la machine. Les plus rapides demandent un coefficient de glissabilité de l'ordre de 0,15 à 0,18 et les autres acceptent un coefficient de 0,25 à 0,30."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea73f5ce-1d7a-30d3-bca3-c14ba0d06343",
                                        "entry_id": "ced1c16f-1bc8-3f36-bb36-ef5776bd4384",
                                        "glosses": [
                                            "Nombre qui fixe la valeur relative attribué à chacune des épreuves de certains examens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30060c3b-428a-454c-8b07-70c9bcaecd19",
                                                "sense_id": "ea73f5ce-1d7a-30d3-bca3-c14ba0d06343",
                                                "text": "Le français a un coefficient de 3 et les mathématiques de 4."
                                            },
                                            {
                                                "example_id": "34431ea3-4cff-4c6e-99dc-025830729db5",
                                                "sense_id": "ea73f5ce-1d7a-30d3-bca3-c14ba0d06343",
                                                "text": "C’était donc pour l’École polytechnique qu’il avait été chauffé, ne travaillant que les matières exigées pour les examens de l’École, et cela en proportion de leur coefficient : 58 les mathématiques, 10 la physique, 5 la chimie, 6 le français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
