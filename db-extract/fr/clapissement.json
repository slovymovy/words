                ],
                "senses": [
                    {
                        "sense_id": "0f606273-c83c-36f3-a06b-9c3e7e4e9afb",
                        "entry_id": "d312cdab-8aed-302d-b463-a2ff5bbef186",
                        "glosses": [
                            "Cri du lapin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d55d778-5a90-40ec-bb1a-6a378afdce50",
                                "sense_id": "0f606273-c83c-36f3-a06b-9c3e7e4e9afb",
                                "text": "Mais ce qui paraît encore plus concluant, en faveur d’une origine commune, c’est le rapport entre le clapissement des lapins de Cécuba et celui des mêmes animaux de la rive voisine."
                            }
                        ]
                    },
                    {
                        "sense_id": "32ec4226-eeca-3f88-9367-ca1c822ea49e",
                        "entry_id": "d312cdab-8aed-302d-b463-a2ff5bbef186",
                        "glosses": [
                            "Cri comparable d’un autre animal, comme le chien."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "020454a1-33fa-4287-a5c7-ab99e9a961e6",
                                "sense_id": "32ec4226-eeca-3f88-9367-ca1c822ea49e",
                                "text": "Cependant ne voilà-t-il pas que le petit misérable [(un petit chien)], redoublant de clapissement, ameute tous les chiens de la rue contre moi, qui, dociles à ses instigations, se mettent à répéter tout ce qu’il me dit, et je me vois pour le coup chassé dans toutes les règles comme un autre Actéon, excepté que, par pure décence, je ne pressais point mon allure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c48ccb5-2f0d-4f1b-b85c-e0ebed958412",
                        "source_entry_id": "d312cdab-8aed-302d-b463-a2ff5bbef186",
                        "target_lang_word": "whine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a33338b6-0572-3dc2-908d-727b2294d622",
                                        "entry_id": "6309b92d-3a73-37db-8bfa-854204842a6a",
                                        "glosses": [
                                            "A long-drawn, high-pitched complaining cry or sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75ad3b5-ffb4-4676-840a-3e234e3302c2",
                                                "sense_id": "a33338b6-0572-3dc2-908d-727b2294d622",
                                                "text": "The 18-year-old [Justin] Bieber can’t quite pull off the “adult” thing just yet: His voice may have dropped a bit since the days of “Baby,” but it still mostly registers as “angelic,” and veers toward a pubescent whine at times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                        "entry_id": "6309b92d-3a73-37db-8bfa-854204842a6a",
                                        "glosses": [
                                            "A complaint or criticism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32d766a-2251-4ac2-ac07-9aa9c8e1edf0",
                                                "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                                "text": "I need to have a quick whine about my boss before we start talking about the holiday."
                                            },
                                            {
                                                "example_id": "4b6960d0-12dc-4652-8f20-425b4bc8d10c",
                                                "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                                "text": "Eighner, in particular, is infamous for his \"what publishers and editors did to poor me\" whines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "815902ea-0e26-3a67-9bd9-c2a3416615a1",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To utter a high-pitched cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00118e6c-3bd4-32b5-b20e-7e1b11994f9a",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To make a sound resembling such a cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456e12bb-c172-4823-9746-7704041054ff",
                                                "sense_id": "00118e6c-3bd4-32b5-b20e-7e1b11994f9a",
                                                "text": "The jet engines whined at take off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To complain or protest with a whine (compare whinge) or as if with a whine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "910dc3d0-88ee-4e29-a544-b03a1f560d3c",
                                                "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                                "text": "[S]he was one of your ſoft ſpoken, canting, whining hypocrites, who with a truly jeſuitical art, could wreſt evil out of the moſt inoffenſive thought, word, look or action; […]"
                                            },
                                            {
                                                "example_id": "5eff3abf-3242-46a0-9922-268aebd72fc3",
                                                "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                                "text": "Feel awfully about Scott... I always knew he couldn't think—he never could—but he had a marvelous talent and the thing is to use it—not whine in public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To move with a whining sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d12854-613a-49f9-8c07-0e4a69f3d815",
                                                "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                                "text": "The jet whined into the air."
                                            },
                                            {
                                                "example_id": "e60faf57-7955-49d9-8b3f-a27d6f8f2d47",
                                                "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                                "text": "The wind whined and moaned through the trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To utter with the sound of a whine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93e0b4f-ae59-4770-b746-8e00a7adbefc",
                                                "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                                "text": "The child whined all his complaints."
                                            },
                                            {
                                                "example_id": "69724124-6bba-4a22-a3fc-cd7c92d4f4de",
                                                "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                                "text": "Kelly Queen was whining that the boss made him put on his tie."
                                            }
                                        ]
                                    }
