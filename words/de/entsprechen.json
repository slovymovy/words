                    "sense_definition": "bestimmten Erwartungen, Anforderungen oder Wünschen gerecht werden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "erfüllen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das neue Hotel <w>entspricht</w> leider überhaupt nicht unseren Erwartungen.",
                            "target_lang_translations": {
                                "en": "Unfortunately, the new hotel does not <w>meet</w> our expectations at all.",
                                "ru": "Новый отель, к сожалению, совсем не <w>соответствует</w> нашим ожиданиям.",
                                "nl": "Het nieuwe hotel <w>voldoet</w> helaas helemaal niet <w>aan</w> onze verwachtingen.",
                                "pl": "Nowy hotel niestety w ogóle nie <w>odpowiada</w> naszym oczekiwaniom.",
                                "fr": "Le nouvel hôtel ne <w>correspond</w> malheureusement pas du tout à nos attentes.",
                                "it": "Purtroppo il nuovo hotel non <w>corrisponde</w> affatto alle nostre aspettative.",
                                "cs": "Nový hotel bohužel vůbec <w>neodpovídá</w> našim očekáváním.",
                                "tr": "Yeni otel ne yazık ki beklentilerimizi hiç <w>karşılamıyor</w>.",
                                "es": "Lamentablemente, el nuevo hotel no <w>cumple con</w> nuestras expectativas en absoluto.",
                                "zh": "遗憾的是，这家新酒店完全不<w>符合</w>我们的期望。"
                            }
                        },
                        {
                            "text": "Die Bewerberin <w>entspricht</w> allen fachlichen Anforderungen für diese anspruchsvolle Stelle.",
                            "target_lang_translations": {
                                "en": "The applicant <w>meets</w> all the professional requirements for this demanding position.",
                                "ru": "Кандидатка <w>отвечает</w> всем профессиональным требованиям для этой ответственной должности.",
                                "nl": "De sollicitante <w>voldoet aan</w> alle inhoudelijke eisen voor deze veeleisende functie.",
                                "pl": "Kandydatka <w>spełnia</w> wszystkie wymagania merytoryczne na to wymagające stanowisko.",
                                "fr": "La candidate <w>répond à</w> toutes les exigences professionnelles pour ce poste exigeant.",
                                "it": "La candidata <w>soddisfa</w> tutti i requisiti professionali per questa posizione impegnativa.",
                                "cs": "Uchazečka <w>splňuje</w> všechny odborné požadavky na tuto náročnou pozici.",
                                "tr": "Aday, bu zorlu pozisyon için gereken tüm mesleki şartları <w>karşılıyor</w>.",
                                "es": "La candidata <w>cumple con</w> todos los requisitos técnicos para este puesto tan exigente.",
                                "zh": "这位应聘者<w>满足</w>了这个高要求职位的全部专业要求。"
                            }
                        }
