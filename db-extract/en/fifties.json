                                    {
                                        "sense_id": "eeebba12-b419-3aef-a5a9-403c51c6ba88",
                                        "entry_id": "cfaab940-d754-3370-ac88-77ba998dd2d8",
                                        "glosses": [
                                            "Décennie couvrant les années 1950 à 1959."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "394ae73c-c502-4717-83f4-2ea0a224c009",
                                                "sense_id": "eeebba12-b419-3aef-a5a9-403c51c6ba88",
                                                "text": "« On reconstruisait la ville et il y avait partout des bruits de marteau. Ça ne nous dérangeait pas. J’aime toujours le choc d’un marteau sur le bois. Ça me rappelle les années 50, on rebâtissait. Nous sentions une espérance. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e4f02d3-092e-45cf-8dc7-856d17ced5fc",
                        "source_entry_id": "721e9531-d766-3938-944e-ff170790f78e",
                        "source_sense_description": "The decade of the 1850s, 1950s, etc.",
                        "target_lang_word": "fünfziger Jahre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "28f5cb7b-04e4-44c9-a87c-6d4e921aa92e",
                        "source_entry_id": "721e9531-d766-3938-944e-ff170790f78e",
                        "source_sense_description": "The decade of the 1850s, 1950s, etc.",
                        "target_lang_word": "Fünfziger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fünfziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b9223f6-1b0b-3405-934a-296c0075fabe",
                                        "entry_id": "f000f496-32be-3947-a9e6-2ed5f443aaa7",
                                        "glosses": [
                                            "ein Geldschein oder seltener eine Münze mit dem Wert 50 Währungseinheiten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58e358bb-c524-42b4-99cf-425f0a3ad9b8",
                                                "sense_id": "3b9223f6-1b0b-3405-934a-296c0075fabe",
                                                "text": "Kannst du mir einen Fünfziger wechseln?"
                                            },
                                            {
                                                "example_id": "6e71b283-53b4-4d6e-b31a-55916fc3c04a",
                                                "sense_id": "3b9223f6-1b0b-3405-934a-296c0075fabe",
                                                "text": "„Ich ging zu Tohil und zog ihm die Brieftasche raus. Ein Fünfziger war drin, zwei Zwanziger, ein Fünfer und ein einzelner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c3b9a2c-548c-38ea-973c-5ea217b40e35",
                                        "entry_id": "f000f496-32be-3947-a9e6-2ed5f443aaa7",
                                        "glosses": [
                                            "das sechste Jahrzehnt eines Jahrhunderts oder eines Lebens"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0327c451-b414-4d10-85c1-101dc35967c4",
                                                "sense_id": "4c3b9a2c-548c-38ea-973c-5ea217b40e35",
                                                "text": "In den Fünfzigern erlebte Deutschland ein Wirtschaftswunder."
                                            },
                                            {
                                                "example_id": "cc61eb5d-693d-462c-b580-77e9e475c0ba",
                                                "sense_id": "4c3b9a2c-548c-38ea-973c-5ea217b40e35",
                                                "text": "„Die Kellnerinnen wirkten, wie das Restaurant selbst, als wären sie aus den Fünfzigern.“"
                                            },
                                            {
                                                "example_id": "c0d173ed-486b-4ecd-81d3-c0453ff88dcf",
                                                "sense_id": "4c3b9a2c-548c-38ea-973c-5ea217b40e35",
                                                "text": "„In den späteren Fünfzigern veränderte ein Literaturagent und zwanghafter Sammler von Science-Fiction-Memorabilia namens Forest J. Ackerman das Leben Tausender Kinder — ich gehörte dazu — mit seinem Magazin ‚Famous Monsters of Filmland‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "697f25f8-6a82-329c-b45a-22e598978a2f",
                                        "entry_id": "f000f496-32be-3947-a9e6-2ed5f443aaa7",
                                        "glosses": [
                                            "Person im Alter von 50 bis 59 Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "209cea55-3299-4d56-a2cd-76a91ecbd404",
                                                "sense_id": "697f25f8-6a82-329c-b45a-22e598978a2f",
                                                "text": "Ihr neuer Freund ist ein grau melierter Fünfziger."
                                            },
                                            {
                                                "example_id": "03cb2ce6-2657-4c98-8134-492c3603902c",
                                                "sense_id": "697f25f8-6a82-329c-b45a-22e598978a2f",
                                                "text": "„Der ältere Herr, ein starker Fünfziger, an den sich dieser Bescheid gerichtet hatte, reichte seiner Dame den Arm und ging in langsamem Tempo, wie man eine Rekonvaleszentin führt, bis an das Ende des Zuges.“"
                                            },
                                            {
                                                "example_id": "3a2662ee-dfa9-458f-8fd4-6871fc6d7cee",
                                                "sense_id": "697f25f8-6a82-329c-b45a-22e598978a2f",
                                                "text": "„Nach seiner ersten Bypass-Operation in seinen Fünfzigern ging Sandy schließlich zu einem Psychologen, der seine Wutanfälle durch Hypnose kurieren wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
