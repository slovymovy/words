                        "sense_id": "f5674fd5-e06d-3919-b4fa-f07218efa926",
                        "entry_id": "8598ba04-32ab-34e4-b1ba-c01307739708",
                        "glosses": [
                            "reg. (Górny Śląsk) gw. (Śląsk Cieszyński) reg. (Poznań) gw. (Bukowina), także garnitur"
                        ],
