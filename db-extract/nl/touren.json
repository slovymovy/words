                "senses": [
                    {
                        "sense_id": "061557c8-f515-31d1-8789-cd7fe3671f0e",
                        "entry_id": "15c77ac1-bffc-3654-9d96-e324511ce464",
                        "glosses": [
                            "rondreis maken met optredens in verschillende steden en landen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1beb84b6-def5-4a3c-a2f4-7f8c636cb4f5",
                                "sense_id": "061557c8-f515-31d1-8789-cd7fe3671f0e",
                                "text": "Toen ze gingen touren met The Winters, reed ik altijd naar ze toe als ze in het weekend optraden en dan dronk ik gezellig mee achter de schermen."
                            },
                            {
                                "example_id": "f63da64a-c448-4196-a184-1eae5727a413",
                                "sense_id": "061557c8-f515-31d1-8789-cd7fe3671f0e",
                                "text": "Avicii had het moeilijk met zijn roem. Hij stortte in, maakte een comeback, maar bleef kampen met gezondheidsproblemen. In 2014 schrapte hij een tournee vanwege een alvleesklierontsteking, deels veroorzaakt door overmatig alcoholgebruik. Uiteindelijk besloot hij om te stoppen met touren. Wel bleef hij muziek maken."
                            }
                        ]
                    }
