                            {
                                "example_id": "8033c0f7-e1fb-4c09-93db-01deb442da40",
                                "sense_id": "88e6f9c3-7ab1-3a43-9fd4-b6f10d5b26aa",
                                "text": "„Zwar hat es in der Geschichte der EU den einen oder anderen Kairos, den einen oder anderen richtigen Moment für mehr Demokratie gegeben, doch die Gelegenheit war nie im gesamten Raum gleichermaßen günstig.“"
                            },
                            {
                                "example_id": "32ef45e3-f753-4162-9a8a-f32b85368ad9",
                                "sense_id": "88e6f9c3-7ab1-3a43-9fd4-b6f10d5b26aa",
                                "text": "„Zumindest verpasste Europa in den Jahren 2007 und 2008 zum wiederholten Male den καιρός (Kairos) und ließ die notwendige Unbedingtheit des Gestaltungswillen nur schemenhaft erkennen.“"
                            }
                        ],
