                    "target_lang_definitions": {
                        "ru": "Ученик определенного класса или года обучения в школе",
                        "tr": "Okulda belirli bir sınıfta veya düzeyde olan öğrenci.",
                        "zh": "在学校特定年级就读的学生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учени́к",
                                "target_lang_sense_clarification": "класса"
                            },
                            {
                                "target_lang_word": "старшекла́ссник",
                                "target_lang_sense_clarification": "ученик старших классов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öğrenci",
                                "target_lang_sense_clarification": "belirli bir sınıf düzeyindeki öğrenci"
                            },
                            {
                                "target_lang_word": "sınıf öğrencisi",
                                "target_lang_sense_clarification": "belirli bir sınıfa giden"
                            }
