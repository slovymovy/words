                ],
                "senses": [
                    {
                        "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                        "entry_id": "8ad1764b-06f0-3850-b0f5-7f78dc6a9b81",
                        "glosses": [
                            "massenhaftes Eingehen/Sterben der Gattung Picea (Fichte) (beispielsweise durch Schädlingsbefall, Dürre, Luftschadstoffe; oft in einem Wald)"
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "3472c297-9620-44ed-9f5a-783ad1a114b4",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„»Seit etwa 2017 haben wir ein riesiges Fichtensterben wegen des Borkenkäfers.«“"
                            },
                            {
                                "example_id": "755b807c-c467-4130-a01e-add6923c9253",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Der heiße und dürre Sommer 2018 verursachte ein umfangreiches Fichtensterben im Mühlhäuser Stadtwald.“"
                            },
                            {
                                "example_id": "f7932363-720d-4446-a6c8-e8e4e3ba362c",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Im Landschaftsschutzgebiet standen bis zum Fichtensterben (ab 2020) überwiegend Fichten.“"
                            },
                            {
                                "example_id": "f8d73a59-b019-442e-92d1-7c7a5614c8c8",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„[…] Wenn der Borkenkäfer überhand nimmt, kommt das große Fichtensterben, der Wald lichtet sich.“"
                            },
                            {
                                "example_id": "b557a048-dc81-42a6-bdf6-8670d263b959",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Das Fichtensterben hat auch damit zu tun, dass die Fichten aufgrund der Trockenheit weniger Harz bilden und damit der Borkenkäfer die Bäume leichter befallen kann.“"
                            },
                            {
                                "example_id": "12641092-89ca-4cd8-9ed9-9a365d5dd5df",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Das große Fichtensterben im Westerwald war für viele Menschen ein Schock.“"
                            },
                            {
                                "example_id": "ee22da8e-331a-4961-951c-f5da680f6971",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Das Fichtensterben passiert aber auch in anderen Gebieten in Deutschland, betont die Nationalparkleiterin, »wo weit und breit kein Schutzgebiet in der Nähe ist«, zum Beispiel im Frankenwald oder im Harz.“"
                            },
                            {
                                "example_id": "c406e0a2-50d9-4a92-abdd-29f953b73817",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Während Kiefern und Eichen einigermaßen durch die Trockenjahre gekommen sind, zeigt die Statistik bei Buchen leicht höhere Schäden und ein regelrechtes Fichtensterben.“"
                            },
                            {
                                "example_id": "874b139a-1b28-462f-8722-c5a0dcfaa4bb",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Großflächiges Fichtensterben und ein Umdenken der Waldbesitzer haben dazu geführt, dass die Fichte nicht nur seit einiger Zeit ihren Rang als \"Baum Nummer eins\" in Deutschland an die Kiefer verloren hat, sondern mittlerweile gibt es in Deutschland sogar mehr Buchen als Fichten. Noch vor 20 Jahren war da das Verhältnis in etwa 1:2.“"
                            },
                            {
                                "example_id": "2fcda540-15b7-44db-bf91-3bc133cc5bce",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Um das derzeit flächengrößte Fichtensterben in Mitteleuropa zu begrenzen, hat die bayerische Staatsregierung für das Erweiterungsgebiet – der Nationalpark wurde 1997 um 11.000 auf jetzt insgesamt 24.000 Hektar vergrößert – für eine Übergangszeit von 20 Jahren Borkenkäferbekämpfung und Neupflanzungen in den Hochlagen erlaubt.“"
                            },
                            {
                                "example_id": "66d8d801-3f8f-431e-8e39-ecf2e9d60c7f",
                                "sense_id": "d993cd70-91e8-32cf-bd8b-b8639595dfcd",
                                "text": "„Försterin Lena macht sich […] Sorgen um ihren Wald. Gleichzeitig sieht sie das Fichtensterben aber auch als Chance: Sie will die freigewordenen Flächen mit verschiedenen Baumarten wieder aufforsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
