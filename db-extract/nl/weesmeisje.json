                                                "sense_id": "d42a3b7a-6d9b-3e99-b874-2fa0fd1f9be4",
                                                "text": "With its government funding curtailed, the gun registry became an orphan program."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orphan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de1c0a9c-3a66-3dc5-9c09-d6d1450463f0",
                                        "entry_id": "73e161a0-cd2c-3c36-9e64-794d3062e3b2",
                                        "glosses": [
                                            "To deprive of parents (used almost exclusively in the passive)."
                                        ],
                                        "tags": [
                                            "transitive"
