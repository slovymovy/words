                "senses": [
                    {
                        "sense_id": "98b5e4c8-ce20-35a5-9d61-2e8aa654f8f9",
                        "entry_id": "a1678c73-206b-3af7-96dd-deb0b85e8ae4",
                        "glosses": [
                            "een gas, bestaande uit een verbinding van koolstof (C) en zuurstof(O₂): (CO₂)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f44340-6a78-455a-b80b-fd9c2588ef5d",
                                "sense_id": "98b5e4c8-ce20-35a5-9d61-2e8aa654f8f9",
                                "text": "Planten nemen koolzuurgas uit de atmosfeer op en geven zuurstof af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc18a078-6e50-4d19-a94c-99082af0c4e7",
                        "source_entry_id": "a1678c73-206b-3af7-96dd-deb0b85e8ae4",
                        "source_sense_id": "98b5e4c8-ce20-35a5-9d61-2e8aa654f8f9",
                        "source_sense_description": "een gas, bestaande uit een verbinding van koolstof en zuurstof (CO₂)",
                        "target_lang_word": "Kohlendioxid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohlendioxid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                        "entry_id": "c22ba409-2b69-3e3f-8d7c-2b73812eb871",
                                        "glosses": [
                                            "ein farb- und geruchloses Gas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802fdbf1-bc8e-44b4-9250-78f7bb63e6d1",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "Der Ausstoß von Kohlendioxid soll reduziert werden."
                                            },
                                            {
                                                "example_id": "e5d499b7-17b5-455a-8289-e8dfe300fc48",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Beim Verbrennen entsteht Kohlendioxid.“"
                                            },
                                            {
                                                "example_id": "1467672a-42f0-4944-a2de-7134456578ad",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Beim Verbrennen von Treibstoff wird im Falle des herkömmlichen PKWs oder des mit Kerosin betankten Flugzeugs klimaschädliches Kohlendioxid freigesetzt, das in die Atmosphäre gelangt und diese aufheizt.“"
                                            },
                                            {
                                                "example_id": "57c96392-a601-41c4-ac3d-d26d45d0c26e",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Durch das Verbrennen fossiler Brennstoffe und durch die weltumfassende Entwaldung wird Kohlendioxid (CO₂) in der Atmosphäre angereichert.“"
                                            },
                                            {
                                                "example_id": "e41ca3e7-06be-468a-aa3a-03085b9562e8",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Der von Menschen verursachte Ausstoß von Kohlendioxid (CO₂) gilt als Hauptursache für die Klimaerwärmung.“"
                                            },
                                            {
                                                "example_id": "c05043a5-5c13-4b5f-a3d9-555c329354ee",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Die Ozeane produzieren die Hälfte des Sauerstoffs in der Erdatmosphäre und nehmen einen erheblichen Teil des Kohlendioxids auf, das durch menschliche Aktivitäten ausgestoßen wird.“"
                                            },
                                            {
                                                "example_id": "704edf7f-7a73-4d4e-b6de-9aeb9820b06b",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Je nach Szenario müssen etwa 100 bis 1000 Milliarden Tonnen Kohlendioxid weltweit bis 2100 aus der Luft raus – zusätzlich zu den Klimaschutzmaßnahmen, die Treibhausgase zu reduzieren.“"
                                            },
                                            {
                                                "example_id": "3705ce95-2a04-4e92-a2b2-46b82a8b34b7",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Das Heizen von Räumen verursacht in Deutschland etwa 150 Millionen Tonnen Kohlendioxid jährlich.“"
                                            },
                                            {
                                                "example_id": "12aa1726-d4d5-4dbd-a6d8-8a46c45af693",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Methan ist 80-mal klimaschädlicher als das Kohlendioxid (CO₂), und beschleunigt die Erderhitzung deshalb vor allem kurzfristig.“"
                                            },
                                            {
                                                "example_id": "d0ebb72d-4ed5-415e-bdf3-9a9fd276dcee",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Methan gilt demnach als etwa 25-, Lachgas sogar als fast 300-mal klimawirksamer als Kohlendioxid.“"
                                            },
                                            {
                                                "example_id": "672234db-95e0-4ac6-bfaa-4774908165c9",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "[…] „wenn die Landwirte oder -wirtinnen anders pflügen oder auf tief wurzelnde Pflanzen setzen, die besser Kohlendioxid binden, können beträchtliche Mengen an CO₂ gebunden werden.“"
                                            },
                                            {
                                                "example_id": "9761acea-2ef2-44ea-8d5c-ddbc898bdc77",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Die Gesteine reagieren mit Kohlendioxid und binden dieses als festes Karbonat.“"
                                            },
                                            {
                                                "example_id": "462188dd-aebd-461c-ab6d-9f05097bf917",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Wenn Basalt verwittert, bindet es Kohlendioxid und könnte so einen Weg zu negativen Emissionen eröffnen.“"
                                            },
                                            {
                                                "example_id": "4fd9f18d-62eb-4c97-9124-c4036fdb3751",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Silikathaltige Minerale lösen sich langsam auf, wenn sie mit Kohlensäure – in Wasser gelöstem Kohlendioxid – zusammentreffen.“"
                                            },
                                            {
                                                "example_id": "c0f02a0d-64c4-4bc7-9465-35d2716df4a0",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Wenn das Kohlendioxid aus Luft oder Abgasen technisch eingesammelt wird, muss es anschließend sicher und dauerhaft gelagert werden.“"
                                            },
                                            {
                                                "example_id": "a7dba043-c8e7-4a83-9ed1-717ab015bb2f",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Kohlendioxid ist jedoch giftig für den Organismus und muss aus dem Körper ausgeschieden werden.“"
                                            },
                                            {
                                                "example_id": "5fe0bbc4-234d-4403-afc6-bf93bf2ecc06",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„Worüber wird das giftige Kohlendioxid ausgeschieden?“ – „Über die Ausatemluft.“"
                                            },
                                            {
                                                "example_id": "d385d442-c0ba-42fd-9bec-7184d62fe671",
                                                "sense_id": "cccc6066-108d-3c4b-81de-2a84e1367e66",
                                                "text": "„In der Lunge sind es die Lungenbläschen, in denen Sauerstoff ins Blut gelangt und das Kohlendioxid aus dem Blut entfernt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f008b2d5-284a-4123-b291-7b79ab64c580",
                        "source_entry_id": "a1678c73-206b-3af7-96dd-deb0b85e8ae4",
                        "source_sense_id": "98b5e4c8-ce20-35a5-9d61-2e8aa654f8f9",
