                "senses": [
                    {
                        "sense_id": "6edea024-5ffd-3309-b91d-ae0db39d633a",
                        "entry_id": "58acc8a7-722c-3784-b850-61d6297dd687",
                        "glosses": [
                            "Exprimer de façon sardonique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ae383d-1ebd-4ee5-b963-99794497ed7f",
                                "sense_id": "6edea024-5ffd-3309-b91d-ae0db39d633a",
                                "text": "Ha ! sardonise Laure. Je me vois très bien aller voir le capitaine Marceau dans son bureau et lui demander poliment : voilà, Capitaine, il me faudrait pour demain matin, deux hélicoptères, un millier d’hommes et une dizaine de brigades cynophiles pour patrouiller sur le territoire de la commune de Loguivy-de-la-Mer…"
                            },
                            {
                                "example_id": "1730a234-2911-4624-ac5f-34f543f181ed",
                                "sense_id": "6edea024-5ffd-3309-b91d-ae0db39d633a",
                                "text": "Allons, mes enfants ! sardonise Luc, qui est pourtant le plus jeune de nous trois."
                            },
                            {
                                "example_id": "06c08b81-b2ce-4e1f-9f59-b10ffa64bf01",
                                "sense_id": "6edea024-5ffd-3309-b91d-ae0db39d633a",
                                "text": "« Trop tard ! », sardonise la tombe, « tu finiras comme tu as vécu, sans le savoir… »"
                            }
                        ]
                    }
                ],
