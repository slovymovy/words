        "fr-extract.jsonl": [
            {
                "entry_id": "edb1e26f-106f-3ba9-bfd2-4d843df02b87",
                "word": "plastic",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2add9bbf-1091-4a66-af77-eb9e53c3dafb",
                        "entry_id": "edb1e26f-106f-3ba9-bfd2-4d843df02b87",
