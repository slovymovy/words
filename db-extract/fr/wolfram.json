                        "examples": [
                            {
                                "example_id": "c7ff6cc7-8f0e-4b6d-b6a2-601c465e1b6c",
                                "sense_id": "63277177-a903-3d93-a062-9caa3b03861a",
                                "text": "À trois kilomètres de chez nous il y avait une mine de wolfram où travaillaient surtout des Nord-Africains logés dans des baraquements."
                            }
                        ]
                    },
                    {
                        "sense_id": "a53fae2d-d4e4-3078-be75-897d22fb7716",
                        "entry_id": "cb06f15a-5897-313e-b4f1-c342020a23e3",
                        "glosses": [
                            "Wolframite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88dec776-83e5-43d6-8644-2c1174253532",
                                "sense_id": "a53fae2d-d4e4-3078-be75-897d22fb7716",
                                "text": "On peut en dire autant d’une eſpéce de ſubſtance ferrugineuſe que les Allemands nomment Wolfram ; elle eſt ſtriée & d’une vraie couleur de fer, on la trouve à Altemberg en Miſnie , où on lui donne très-improprement le nom d’antimoine."
                            },
                            {
                                "example_id": "0b2c8a96-4e9b-45bf-a4d8-823595243ca6",
                                "sense_id": "a53fae2d-d4e4-3078-be75-897d22fb7716",
                                "text": "Parfois il devait transporter des marchandises d’un autre genre au milieu des cargaisons habituelles : des armes lourdes, des prototypes de moteurs d’avions allemands, des minéraux comme le wolfram, des explosifs expérimentaux."
                            }
                        ]
                    }
