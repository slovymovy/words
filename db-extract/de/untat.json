                        ],
                        "form": "die Untat"
                    },
                    {
                        "form_id": "31c59727-1b21-4cc4-ab3a-dcc405b34e0b",
                        "entry_id": "38c4b2df-80f2-35d3-877b-356ed5ec1f48",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Untaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                        "entry_id": "38c4b2df-80f2-35d3-877b-356ed5ec1f48",
                        "glosses": [
                            "grauenvolle, verwerfliche Tat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0776524-dfd7-43e6-96bf-78a358d52cbc",
                                "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                                "text": "„Sie gingen aufs Forum, und Lucretia berichtete dem Volk von der Untat des Königssohnes.“"
                            },
                            {
                                "example_id": "08e677ed-ebf3-4f14-9652-22ba27f11e7a",
                                "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                                "text": "„Und das findet man noch schlimmer als die Untat.“"
                            },
                            {
                                "example_id": "532c9609-cd0d-4c70-92da-12550e195bf8",
                                "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                                "text": "„Gleichwohl muss dem Nachspüren einer nationalen Tragödie – und um eine solche handelt es sich bei der ethnischen Säuberung der ehemaligen Ostgebiete – heute nicht mehr unterstellt werden, damit deutsche Untaten relativieren zu wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4775bdad-bfef-4c53-b3a9-7137e14fcd8f",
                        "source_entry_id": "38c4b2df-80f2-35d3-877b-356ed5ec1f48",
                        "source_sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                        "source_sense_description": "grauenvolle, verwerfliche Tat",
                        "target_lang_word": "misdeed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misdeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                        "entry_id": "cb81d770-210a-38f3-97a7-abc61ccdb480",
                                        "glosses": [
                                            "That which was done that should not have been, ranging from any sin or moral offense to various degrees of crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d345cc99-bdae-4a40-b3ad-d09ab30d3750",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "The petty misdeeds of his youth came back to haunt him when he ran for political office and his character was smeared."
                                            },
                                            {
                                                "example_id": "7d90b864-53ab-423c-b7d8-aa3803e2a5e0",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "These [putting feet on seats and leaving rubbish behind] are officially among the worst habits revealed by staff working on Northern's trains and at stations. Other bugbears include playing music through loudspeakers, not giving way to passengers getting off the train and actually illegal activities such as fare evasion and vaping in enclosed spaces. The list of misdeeds was released by the operator on March 3 to coincide with Employee Appreciation Day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2141d34-6e4d-47d7-ba1a-17f38615f9f2",
                        "source_entry_id": "38c4b2df-80f2-35d3-877b-356ed5ec1f48",
                        "source_sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                        "source_sense_description": "grauenvolle, verwerfliche Tat",
                        "target_lang_word": "злодеяние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "злодеяние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "56a20c2d-71a6-33e8-9f97-7578feb8bd63",
                                        "entry_id": "d581e37d-d009-3397-9ec4-0b2fdefb3c53",
                                        "glosses": [
                                            "высок. злодейский поступок, тяжёлое преступление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29180fb-980e-436c-8b25-71020d74adbd",
                                                "sense_id": "56a20c2d-71a6-33e8-9f97-7578feb8bd63",
                                                "text": "Подчеркнуто, что это чудовищное злодеяние ещё раз доказывает, что терроризм является наиболее серьёзной угрозой международному миру и безопасности и подтверждает необходимость наращивать усилия по противодействию этой угрозе."
                                            },
                                            {
                                                "example_id": "3ba71f18-563e-41c8-a297-0b512cbbf343",
                                                "sense_id": "56a20c2d-71a6-33e8-9f97-7578feb8bd63",
                                                "text": "Ей приходится воевать за истину и справедливость в областном суде при рассмотрении самых тяжких злодеяний: убийств, бандитских нападений, разбоев, совершенных, как правило, в организованных преступных группировках."
                                            },
                                            {
                                                "example_id": "e0b7f3b0-f851-42ee-a1b4-a0c3a8c577b1",
                                                "sense_id": "56a20c2d-71a6-33e8-9f97-7578feb8bd63",
                                                "text": "Северный народ обычно очень честен, и редко-редко приходится слышать в северной деревне про кражи или другие злодеяния этого рода."
                                            },
                                            {
                                                "example_id": "3e9cfd2a-ad25-4f4d-b357-1ca41745d096",
                                                "sense_id": "56a20c2d-71a6-33e8-9f97-7578feb8bd63",
                                                "text": "Речь идёт там о дворянине-отцеубийце, который весь месяц после своего злодеяния провёл самым развратным образом."
                                            },
                                            {
                                                "example_id": "39ec5aaa-22ef-4f96-b9e8-63fb5124bfb4",
                                                "sense_id": "56a20c2d-71a6-33e8-9f97-7578feb8bd63",
                                                "text": "Чтобы придать себе дерзости на злодеяние, он выпил много вина и, опьянелый, с ружьём кинулся к палатке полковника."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
