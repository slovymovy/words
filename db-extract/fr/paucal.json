                                        "entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                                        "glosses": [
                                            "Expressing a relatively small quantity or degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b21cea2-d54b-440c-837a-3ee12c40fbb8",
                                                "sense_id": "b0f066cc-99e2-3ca7-9a05-76f3725bef8c",
                                                "text": "But too much can occur in the negative with a paucal meaning when there is no explicit or implicit infinitival complement: I didn't enjoy it too much is simply an informal alterant of I didn't enjoy it very much."
                                            }
                                        ]
