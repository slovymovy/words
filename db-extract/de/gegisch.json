                        "sense_id": "b9bacd2d-873c-3cb0-8040-c9ce3e5e77ed",
                        "entry_id": "8d965c7b-d805-3dae-beea-feee9c6bdb37",
                        "glosses": [
                            "die Gegen (Nordalbaner) betreffend, den Gegen gehörig"
