                ],
                "senses": [
                    {
                        "sense_id": "516f9c9e-21a7-3f45-8724-3de34874f717",
                        "entry_id": "fc15163e-6b11-388f-8a78-b145f38ef88d",
                        "glosses": [
                            "Tisch, an dem bestimmte Arbeiten durchgeführt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c4185d0-11c5-4983-a4be-894bbd0f44e2",
                                "sense_id": "516f9c9e-21a7-3f45-8724-3de34874f717",
                                "text": "„Brian und Alan saßen ins Gespräch vertieft an einem fahrbaren Arbeitstisch mit grüner Oberfläche, der sich in unmittelbarer Nähe des Quantencomputers befand.“"
                            },
                            {
                                "example_id": "cf6d58fc-3bf0-4d25-b035-bae4b37ca3b2",
                                "sense_id": "516f9c9e-21a7-3f45-8724-3de34874f717",
                                "text": "Mein Arbeitstisch ist aus Buchenholz."
                            },
                            {
                                "example_id": "22a3bb09-defc-4b1b-a0f6-02d332f3cfc3",
                                "sense_id": "516f9c9e-21a7-3f45-8724-3de34874f717",
                                "text": "„Zwei mittlere Arbeitstische, mit Papieren bedeckt, ein Stehpult, ein fahrbarer Bücherwagen, niedere Stühle und Sitzkissen füllten den Raum, der ein Gefühl der Stille und der Weltabgeschiedenheit auslöste.“"
                            },
                            {
                                "example_id": "8ce16e41-1768-4646-a1d9-777fd61445c0",
                                "sense_id": "516f9c9e-21a7-3f45-8724-3de34874f717",
                                "text": "„Aufgeschlagen lagen die vier Pässe auf dem großen Arbeitstisch beim Fenster.“"
                            },
                            {
                                "example_id": "1fc95347-e120-4aa7-9fba-8af16f9fa4bb",
                                "sense_id": "516f9c9e-21a7-3f45-8724-3de34874f717",
                                "text": "„Azhar führte ihn weiter zu einer anderen Gruppe von Arbeitstischen, die er ihm als seine »Finanzabteilung« vorstellte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
