                "senses": [
                    {
                        "sense_id": "23384597-d826-3fe0-8eb1-92da9e382d47",
                        "entry_id": "4c48270f-2569-3b6a-b4c4-a9599b8d5ac0",
                        "glosses": [
                            "Priver de sa raison d’être ; vider de son sens ; rendre vain."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c2a91848-5a99-44ad-ab05-012d59826fcb",
                                "sense_id": "23384597-d826-3fe0-8eb1-92da9e382d47",
                                "text": "Tout ce printemps lointain conquis sur nos frimas de France, m’éprend, m’ensorcelle, m’anéantit délicieusement, … et me défend l’effort, m’abrège le souci, me simplifie, inanise les complications de désirs et de fièvres d’une coutumière existence."
                            },
                            {
                                "example_id": "03da6d96-ce02-48f4-b06f-ca7944f5d156",
                                "sense_id": "23384597-d826-3fe0-8eb1-92da9e382d47",
                                "text": "Mes plus subtils efforts s’inanisèrent devant le parti pris mutiste du père de Georges :\n– Georges n’a que ce qu’il mérite !!!…"
                            }
                        ]
                    }
                ],
