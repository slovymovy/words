                "senses": [
                    {
                        "sense_id": "53883169-7508-3134-85d8-bdb3a28fcb87",
                        "entry_id": "05a3a9e0-dcff-3230-8866-00baa8a340ff",
                        "glosses": [
                            "Having some of the characteristics of an amphitheatre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "422b91c6-c0e7-4cc0-8037-76828b286dd6",
                                "sense_id": "53883169-7508-3134-85d8-bdb3a28fcb87",
                                "text": "A new Chapel, of novel design, being of an amphitheatrical form, has been recently completed, from the designs of W. Brooks, architect."
                            },
                            {
                                "example_id": "d4781e39-425c-4c92-8388-db47e7fe7fd2",
                                "sense_id": "53883169-7508-3134-85d8-bdb3a28fcb87",
                                "text": "The hall was fitted up with an amphitheatrical descent of seats towards a platform, on which stood a desk, two lights, a stool, and a capacious antique chair."
                            },
                            {
                                "example_id": "72326658-f086-4bf0-a673-ddb099dcaaf2",
                                "sense_id": "53883169-7508-3134-85d8-bdb3a28fcb87",
                                "text": "In the high, amphitheatrical Nicolai Hall that afternoon I saw the Duma sitting in permanence, tempestuous, grouping around it all the forces of opposition."
                            }
                        ]
                    }
                ],
