                    }
                ],
                "senses": [
                    {
                        "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                        "entry_id": "1733cd96-a684-34d1-8ede-8167d97c1b43",
                        "glosses": [
                            "Appareil destiné à stocker durablement les produits surgelés ou congelés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "809d1290-a4fd-4203-bd19-9664b4992438",
                                "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                                "text": "Placée au congélateur, la propolis devient friable et peut être récupérée."
                            },
                            {
                                "example_id": "585b7099-6b65-44fd-8b20-4276bbb42689",
                                "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                                "text": "Ici aussi, on vivait de la récup, de la réparation d’appareils usagés, de la vente de métaux. Des coups de marteau s'élevaient derrière des palissades formées de frigos ou de congélateurs."
                            },
                            {
                                "example_id": "9637bf49-fd84-49c5-8746-4324fde697d5",
                                "sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                                "text": "Daniel Paré assure cependant que de nombreuses doses sont conservées dans des congélateurs, comme l’exige le type de vaccin produit par Pfizer, pour administrer les deuxièmes doses aux personnes qui ont été vaccinées cette semaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a2f43f3-fd85-4835-9d31-33240d4bc743",
                        "source_entry_id": "1733cd96-a684-34d1-8ede-8167d97c1b43",
                        "source_sense_id": "3057d0ae-47be-3f66-9956-8e23bdcb7525",
                        "target_lang_word": "Tiefkühltruhe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiefkühltruhe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c467f4-26d4-36b2-ad65-0fa4bb87b764",
                                        "entry_id": "ec77963f-fabc-3fde-b1b4-7970585ea613",
                                        "glosses": [
                                            "ein energiesparendes Kühlgerät für dauerhafte Tiefkühlung von Lebensmitteln unter −10 °C"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542abdbb-48f9-4f86-9f71-24d53edbc01e",
                                                "sense_id": "d9c467f4-26d4-36b2-ad65-0fa4bb87b764",
                                                "text": "Die Lebensmittel in einer Tiefkühltruhe bleiben über viele Monate haltbar, da sehr tiefe Temperaturen von -10° bis -20° vorherrschen."
                                            },
                                            {
                                                "example_id": "3416489d-36d1-45bb-a034-6e6c85dc78ad",
                                                "sense_id": "d9c467f4-26d4-36b2-ad65-0fa4bb87b764",
                                                "text": "In der Tiefkühltruhe seiner Mutter fand er mehrere Gefrierbeutel mit acht Jahre alter Kalbsleber."
                                            },
                                            {
                                                "example_id": "333772d8-8091-42cd-9eb7-731b69fb1d09",
                                                "sense_id": "d9c467f4-26d4-36b2-ad65-0fa4bb87b764",
                                                "text": "„Ein Winterschuh absolviert derweil bei minus 17 Grad Celsius den Kältetest in einer Tiefkühltruhe.“"
                                            },
                                            {
                                                "example_id": "1ed19297-f9ea-4ba3-bd0c-35e9c2a4e24d",
                                                "sense_id": "d9c467f4-26d4-36b2-ad65-0fa4bb87b764",
                                                "text": "„Sara zeigte auf die Tiefkühltruhe, wo ich mir die Pizza holen konnte, ein halbherziger Versuch ihrerseits, Selbstbedienung zu ermöglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d21f777-87b7-4ea3-8bd9-c8304ca47b19",
                        "source_entry_id": "1733cd96-a684-34d1-8ede-8167d97c1b43",
