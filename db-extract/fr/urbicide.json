                "senses": [
                    {
                        "sense_id": "c285c820-8968-35ae-b020-4317c7a2ed50",
                        "entry_id": "d2e04f58-dba9-33b5-9206-1d1ac089ab26",
                        "glosses": [
                            "Destruction délibérée, lors d’un conflit, de tout ou partie d’une ville en tant qu’objectif autant symbolique que militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76f874e-8a0a-4aea-b79e-87fe8752c0c1",
                                "sense_id": "c285c820-8968-35ae-b020-4317c7a2ed50",
                                "text": "Mossoul, Phnom Penh, Sarajevo... Après les génocides, les spécialistes parlent d’urbicides. Mais peut-on dire que même une ville peut mourir ?"
                            },
                            {
                                "example_id": "4f746069-3ba4-4e42-b136-4d524695a373",
                                "sense_id": "c285c820-8968-35ae-b020-4317c7a2ed50",
                                "text": "Urbicide. Le terme existe depuis les années 1960. Le concept, lui, a été formalisé « par l’ancien maire de Belgrade, qui était architecte, après la destruction de la ville de Sarajevo », raconte l’historienne Caroline Le Mao, maîtresse de conférences à l’Université Bordeaux Montaigne."
                            },
                            {
                                "example_id": "6c23f152-b7b3-423b-bc0c-8030ff2e4c6d",
                                "sense_id": "c285c820-8968-35ae-b020-4317c7a2ed50",
                                "text": "[Véronique Nahoum-Grappe] L’urbicide vise l’anéantissement de tout ce qui meurt en même temps que s’effondre « la ville où l’ennemi vit, bouge, se nourrit, invente, aime et se dispute, c’est cela qu’il faut annihiler, rendre nul, vide, abrasé, rasé et reconstruit sous la mode nouvelle du conquérant »."
                            }
                        ]
                    }
                ],
