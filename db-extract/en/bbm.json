                "senses": [
                    {
                        "sense_id": "b56858cb-b9b7-3804-8ddd-345f89ade55a",
                        "entry_id": "6121a0b1-7a9a-3f4b-b813-8b6197ec81d1",
                        "glosses": [
                            "To send (a message) to (someone) via the BlackBerry Messenger service."
                        ],
                        "tags": [
                            "ditransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ae38c3e2-4bb5-49b7-a382-c56906cc0f1a",
                                "sense_id": "b56858cb-b9b7-3804-8ddd-345f89ade55a",
                                "text": "His comment galvanized fiscally conservative Democrats to support the president’s bill and heightened the sense of despondency among those Republican congressmen and senators who BBMed and Tweeted on their BlackBerries throughout the speech."
                            },
                            {
                                "example_id": "376585d8-5d76-479c-a7b1-cd444fb75e84",
                                "sense_id": "b56858cb-b9b7-3804-8ddd-345f89ade55a",
                                "text": "2010 February 15, Emma Roberts, quoted by Michael Ordoña, \"Sweet Times for Emma Roberts\", Los Angeles Times\nOur generation is definitely all about the texting and the e-mailing and the BBM-ing and the IM-ing; it's endless."
                            },
                            {
                                "example_id": "9c6fefd2-c74c-4bdb-b186-7176246d2d99",
                                "sense_id": "b56858cb-b9b7-3804-8ddd-345f89ade55a",
                                "text": "No place, perhaps not even a church (though Sir Simon does not report from Mass so it is hard to know), is safe from this facebookery and twittering and BBMing."
                            },
                            {
                                "example_id": "82a24597-b176-4110-b7b8-a3142282a0fd",
                                "sense_id": "b56858cb-b9b7-3804-8ddd-345f89ade55a",
                                "text": "I slid my phone onto my lap and BBMed Lexa and Khloe my number."
                            },
                            {
                                "example_id": "9f600252-7f95-457e-9c07-09ac9b621585",
                                "sense_id": "b56858cb-b9b7-3804-8ddd-345f89ade55a",
                                "text": "“This outfit is so amaze. You look cute in breeches, too, but I want Drew to see you in this outfit. Like, now!” I laughed. “I kind of do too. And what about you? How much Zack spotting since last time we BBMed?”"
                            }
                        ]
                    }
