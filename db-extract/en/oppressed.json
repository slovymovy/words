                                                "sense_id": "1e942eca-1f77-3ea5-a7e4-2ce60dd48475",
                                                "text": "Il prend toujours la défense des opprimés, de l’opprimé."
                                            },
                                            {
                                                "example_id": "54b94e81-838b-419f-8cc5-1c268eedd8d8",
                                                "sense_id": "1e942eca-1f77-3ea5-a7e4-2ce60dd48475",
                                                "text": "Lorsqu’un opprimé prend les armes au nom de la justice, il fait un pas dans l’univers de l’injustice, et cela est tout le problème."
                                            }
                                        ]
                                    }
