        "fr-extract.jsonl": [
            {
                "entry_id": "a422a79c-442e-3953-a57a-4bc2469ea2d7",
                "word": "brutalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7ed90488-ef82-4fe3-85df-91ddeb7e3280",
                        "entry_id": "a422a79c-442e-3953-a57a-4bc2469ea2d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "brutalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49e6531f-e694-33c1-8e42-5322e3b229e8",
                        "entry_id": "a422a79c-442e-3953-a57a-4bc2469ea2d7",
                        "glosses": [
                            "Mouvement littéraire faisant une description brutale de la réalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e2f9c5-7e54-4ae9-8159-e33e201bdb73",
                                "sense_id": "49e6531f-e694-33c1-8e42-5322e3b229e8",
                                "text": "La brutalité dans son esprit est un mode de persuasion : le réalisme décrit, le brutalisme doit convaincre."
                            },
                            {
                                "example_id": "15b1a69c-dac2-43fe-9940-a67f4fe3f075",
                                "sense_id": "49e6531f-e694-33c1-8e42-5322e3b229e8",
                                "text": "On y discernait déjà, outre les éléments du réalisme de 1857, quelques tendances naturalistes : une note brutale (le brutalisme, raillaient les ennemis de « la Rue »), le respect des sciences positives, l’antimilitarisme et les revendications sociales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0a6e0e7-44b2-47e9-ac20-ee21e31fd975",
                        "source_entry_id": "a422a79c-442e-3953-a57a-4bc2469ea2d7",
                        "source_sense_id": "49e6531f-e694-33c1-8e42-5322e3b229e8",
                        "target_lang_word": "brutalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brutalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a63e6bc8-fc8b-3488-bbe7-b7bc24c2d836",
                                        "entry_id": "90632e9d-9b6e-3fd7-8ffe-8124e123e7c0",
                                        "glosses": [
                                            "Brutal, violent behaviour; savagery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e414d144-dd20-456f-99c6-163ab6c06cee",
                                                "sense_id": "a63e6bc8-fc8b-3488-bbe7-b7bc24c2d836",
                                                "text": "1839, Earl of Clarendon, Speech to House of Lords, recorded in Mirror of Parliament, republished in 1840 January-June, The Eclectic Review, New Series, Volume 7, page 455,\nTheir punishments for crimes were of the most savage nature: and the absurdities of the Theodosian Code, together with the ancient customs of Germany, came to be all blended into a singular amalgamation of refinement and meanness,—of brutalism and bravery."
                                            },
                                            {
                                                "example_id": "2a324c8a-381e-4880-955d-87c7b6337679",
                                                "sense_id": "a63e6bc8-fc8b-3488-bbe7-b7bc24c2d836",
                                                "text": "Instances of misguidance like the ones given, and at least recognized in retrospect, in fascism, racism, and ecological brutalism, are also to be sensed by religious communication in other contexts."
                                            },
                                            {
                                                "example_id": "ab1cf481-c340-4eff-ac0a-fc8b10d63083",
                                                "sense_id": "a63e6bc8-fc8b-3488-bbe7-b7bc24c2d836",
                                                "text": "2013, Aimee Gasston, Katherine Mansfield, Cannibal, Janet Wilson, Gerri Kimber, Delia da Sousa Correa (editors), Katherine Mansfield and the (Post)colonial, Edinburgh University Press, page 15,\nShe revelled at being dubbed the 'little savage from New Zealand' by her principal at Queen's College, London, and as an adult would develop a commitment to brutalism by consistently refusing to represent a falsely civilised world view in her fiction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41339a1-5007-34a1-b129-ac7111998dd8",
                                        "entry_id": "90632e9d-9b6e-3fd7-8ffe-8124e123e7c0",
                                        "glosses": [
                                            "Alternative letter-case form of Brutalism."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c2e343-d895-45b3-9802-b75bce32258a",
                                                "sense_id": "d41339a1-5007-34a1-b129-ac7111998dd8",
                                                "text": "Art deco is one of the first truly modern styles and a precursor to the more streamlined and simpler lines of later styles, such as the international style, art moderne, and even brutalism."
                                            },
                                            {
                                                "example_id": "187306da-c798-4cf0-8f9a-f5a9be72a489",
                                                "sense_id": "d41339a1-5007-34a1-b129-ac7111998dd8",
                                                "text": "On the face of it the pair also seemed to plunder much of their muscular brutalism in the building of the church from late Le Corbusier but they have consistently, and independently, rejected any Corbusian or even post-Corbusian label."
                                            },
                                            {
                                                "example_id": "91a999c9-f88c-464f-8dfd-0ee24e2d740a",
                                                "sense_id": "d41339a1-5007-34a1-b129-ac7111998dd8",
                                                "text": "2015, Johnny Rogan, Ray Davies: A Complicated Life, Vintage (The Bodley Head), page 375,\nA founder of the Victorian Society in 1958, Betjeman was a celebrated critic of architectural brutalism and an active campaigner against the march of modernism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa61d37b-51ba-4a45-bd85-cf8072109788",
                        "source_entry_id": "a422a79c-442e-3953-a57a-4bc2469ea2d7",
                        "source_sense_id": "49e6531f-e694-33c1-8e42-5322e3b229e8",
                        "target_lang_word": "Brutalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brutalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b55a6e-9ee1-3e3e-87a6-b5241e0aa8d9",
                                        "entry_id": "fad1fcd8-bdf7-3a7b-8871-c9f6c79ee759",
                                        "glosses": [
                                            "A style of modernist architecture characterized by angular geometry and overt signs of the construction process."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06d6749-2ffd-486a-9370-b700eff4a204",
                                                "sense_id": "f1b55a6e-9ee1-3e3e-87a6-b5241e0aa8d9",
                                                "text": "In similar spirit, Nigel Henderson, a member of the Independent Group's Brutalist core, exhibited black and white photographs of the East End at the 1953 ICA show Parallel of Life and Art which stressed the unsanitised reality of everyday life: Peter Smithson's defence of Brutalism through the categorical rhetoric of objectivity and truth, quoted above, echoes Anderson."
                                            },
                                            {
                                                "example_id": "5f939c20-62dd-49d0-8f50-b439f5ec9d8c",
                                                "sense_id": "f1b55a6e-9ee1-3e3e-87a6-b5241e0aa8d9",
                                                "text": "2004, B. M. Boyle, Brutalism, R. Stephen Sennott (editor), Encyclopedia of Twentieth Century Architecture, Volume 1: A-F, Taylor & Francis (Fitzroy Dearborn), page 181,\nNonetheless, despite its radical appearance, Brutalism could claim, if not legitimacy, at least ancestry in pre-World War II modernism."
                                            },
                                            {
                                                "example_id": "8efe2085-9831-49c1-b0cb-bd2e7639fc47",
                                                "sense_id": "f1b55a6e-9ee1-3e3e-87a6-b5241e0aa8d9",
                                                "text": "The trend towards Brutalism - an austere style that had its origins in the Bauhaus and is characterized by its emphasis on the building materials (especially bare concrete) and unconcealed service pipes - did little to improve the situation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "a5c6e40b-0a2a-36c7-811c-ee3599341297",
                "word": "brutalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "db1e66da-cd3f-42e4-8dc7-f88e120b4dd8",
                        "entry_id": "a5c6e40b-0a2a-36c7-811c-ee3599341297",
                        "tags": [
                            "plural"
                        ],
                        "form": "brutalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de0c0e5b-66d0-3666-ae43-2cc919e71f50",
                        "entry_id": "a5c6e40b-0a2a-36c7-811c-ee3599341297",
                        "glosses": [
                            "Mouvement architectural axé sur une nouvelle étude des besoins fonctionnels et sur une construction laissant apparaitre les infrastructures en matériaux bruts (béton, brique, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ddd73c6-9469-47dc-a57f-b9895ff1fe99",
                                "sense_id": "de0c0e5b-66d0-3666-ae43-2cc919e71f50",
                                "text": "Les deux exemples précurseurs du brutalisme sont l’Unité d’habitation à Marseille (1947-1953) et la maison Jaoul en banlieue de Paris (1956)."
                            },
                            {
                                "example_id": "51337df5-5a92-403f-ae5a-7db3b61d2360",
                                "sense_id": "de0c0e5b-66d0-3666-ae43-2cc919e71f50",
                                "text": "Ma conception du confort exige 1 certain brutalisme nordique, qui produit des meubles solides, des aménagements fermes, des appuis ; ou j’ai tendance à faire (ou à faire faire) “dans la dentelle”, préjugeant qu’1 installation fine sera plus élégante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23544f66-1b2a-4924-90a5-04c30483a6b0",
                        "source_entry_id": "a5c6e40b-0a2a-36c7-811c-ee3599341297",
                        "source_sense_id": "de0c0e5b-66d0-3666-ae43-2cc919e71f50",
