                "senses": [
                    {
                        "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                        "entry_id": "1a6c7250-82ca-3b7d-936e-5d921e682c3c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51e56a4-6687-4d8f-86ee-45f5e71b850a",
                                "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                                "text": "Babekuhls kamen, sahen und siegten."
                            },
                            {
                                "example_id": "3cc18bb4-c7df-4279-913f-b0c72e68968c",
                                "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                                "text": "Frau Babekuhl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5ae487de-edca-4098-8c6b-cadc44c57066",
                                "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                                "text": "Herr Babekuhl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a826a3f7-eb8e-4e50-9c4b-66e41954b46f",
                                "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                                "text": "Die Babekuhls fliegen heute nach Barcelona."
                            },
                            {
                                "example_id": "081fd105-c2e1-4bcb-9e54-e527562c3a3e",
                                "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                                "text": "Der Babekuhl trägt nie die Pullover, die die Babekuhl ihm strickt."
                            },
                            {
                                "example_id": "dbf8fa8c-0edb-4774-80cc-8dce2782d87d",
                                "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Babekuhl kommt, geht der Herr Babekuhl.“"
                            },
                            {
                                "example_id": "fd9f54ae-4c31-4f2d-bd4f-2bdba9f562b0",
                                "sense_id": "2eba9353-eeca-33a7-9428-79311a5152e1",
                                "text": "Babekuhl kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
