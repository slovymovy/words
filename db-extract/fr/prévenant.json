                        ],
                        "form": "prévenante"
                    },
                    {
                        "form_id": "87e749f7-82f4-4246-b9b6-63ee5935d1b2",
                        "entry_id": "216c7ab3-0abe-33dd-b4cd-f270b0d849f8",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "prévenantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a12e91a-d987-32fe-913d-864706c8bd6d",
                        "entry_id": "216c7ab3-0abe-33dd-b4cd-f270b0d849f8",
                        "glosses": [
                            "Qui est obligeant, qui va au-devant de tout ce qui peut faire plaisir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6fad302-1841-4a8f-b9d2-0441e94f9495",
                                "sense_id": "0a12e91a-d987-32fe-913d-864706c8bd6d",
                                "text": "Il avait des manières courtoises et prévenantes, saluant poliment tout le monde, mais particulièrement les dames et les demoiselles, à qui il adressait même des propos flatteurs et galamment tournés."
                            },
                            {
                                "example_id": "d92477d6-6eb8-40ff-8507-fb89e2feb416",
                                "sense_id": "0a12e91a-d987-32fe-913d-864706c8bd6d",
                                "text": "Seul Gauzi semble se souvenir que j’existe, parce qu’il a eu la la bonne idée de louer un appartement dans le même immeuble, pour devenir, par la force des choses, mon voisin de palier le plus prévenant."
                            }
                        ]
                    },
                    {
                        "sense_id": "19f099a1-2f3d-3dc6-98b0-b1b5e79fa9f2",
                        "entry_id": "216c7ab3-0abe-33dd-b4cd-f270b0d849f8",
                        "glosses": [
                            "Qui est agréable, qui dispose en sa faveur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d976be8-3268-4e9d-b871-aa8fb0d41d3d",
                                "sense_id": "19f099a1-2f3d-3dc6-98b0-b1b5e79fa9f2",
                                "text": "Cet homme a un air prévenant, une physionomie prévenante, une mine prévenante."
                            }
                        ]
                    },
                    {
                        "sense_id": "cecfccb1-3bc8-39f2-97f3-83109140c278",
                        "entry_id": "216c7ab3-0abe-33dd-b4cd-f270b0d849f8",
                        "glosses": [
                            "Qui prévient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6c40c6-a3c7-4e39-b6e6-d2e198825e27",
                                "sense_id": "cecfccb1-3bc8-39f2-97f3-83109140c278",
                                "text": "C’est par une grâce prévenante de Dieu."
                            },
                            {
                                "example_id": "84c09116-93f7-454f-bb08-8150ff28460a",
                                "sense_id": "cecfccb1-3bc8-39f2-97f3-83109140c278",
                                "text": "Sans une grâce prévenante du ciel."
                            },
                            {
                                "example_id": "5069385b-d956-49dc-98aa-7cc39891c482",
                                "sense_id": "cecfccb1-3bc8-39f2-97f3-83109140c278",
                                "text": "Les secours prévenants de la grâce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2d2ed0e-0278-48d4-ac57-3e6d61b99dcb",
                        "source_entry_id": "216c7ab3-0abe-33dd-b4cd-f270b0d849f8",
