                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d245eae1-aa7e-4d29-8abc-808c95c758f4",
                                "sense_id": "21bb62e8-bbcc-3eea-a899-f1b4d0d93d77",
                                "text": "The temperature at noon had risen to 33 deg., and everything was more soakingly wet than ever, if that was possible."
                            },
                            {
                                "example_id": "ee8e32a2-3c16-4920-bb2d-964fb410f473",
                                "sense_id": "21bb62e8-bbcc-3eea-a899-f1b4d0d93d77",
                                "text": "There are people who even in this enlightened age vegetate upon the face of the earth and know not these things, and a very great many more who do not know that they ought to select a soakingly wet day to appreciate the Falls of Niagara at their highest value."
