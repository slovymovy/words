                        "sense_id": "8678fc46-39b8-31d5-ba08-160b8904de48",
                        "entry_id": "24c3f73e-b697-329a-8123-405c2dbaf8c9",
                        "glosses": [
                            "aufgrund bestimmter Merkmale definierte Gruppe von Menschen innerhalb einer Bevölkerung"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "47940ed5-ce66-4e22-9b4a-d657549d53d3",
                                "sense_id": "8678fc46-39b8-31d5-ba08-160b8904de48",
                                "text": "„Leider gehöre ich zu jener Bevölkerungsschicht, die auf technischem Gebiet immer hinterherhinkt (mein modernstes Gerät ist ein elektrischer Rasierapparat).“"
                            },
                            {
                                "example_id": "7470fd65-881b-4ce0-b670-7dbd90a44639",
                                "sense_id": "8678fc46-39b8-31d5-ba08-160b8904de48",
                                "text": "„Im Prozess der Militarisierung weiter Bevölkerungsschichten im Kaiserreich kam den Kriegsvereinen eine bedeutende Rolle zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
