                "senses": [
                    {
                        "sense_id": "92fb9f01-34a1-3820-b09e-35dd8f5e9f8e",
                        "entry_id": "5572053f-2c5b-3827-82d4-adc844657e5f",
                        "glosses": [
                            "Transport nicht mehr für den ursprünglichen Gebrauch geeigneter Stoffe oder Güter (über Landesgrenzen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "886ee771-6c8e-4304-9008-56ab26984f23",
                                "sense_id": "92fb9f01-34a1-3820-b09e-35dd8f5e9f8e",
                                "text": "„Atommüll, alte Arzneimittel, Batterien und Essensreste landen, legal oder illegal, dort, wo Entsorgung billiger ist; grenzüberschreitende Abfallverbringung nennt man das.“"
                            },
                            {
                                "example_id": "7062d153-de96-4ff5-8e91-5a396592e274",
                                "sense_id": "92fb9f01-34a1-3820-b09e-35dd8f5e9f8e",
                                "text": "„Illegale Abfallverbringung ist in mehrerer Hinsicht problematisch.“"
                            },
                            {
                                "example_id": "f874c85f-0ecb-4a49-a981-452332eb2429",
                                "sense_id": "92fb9f01-34a1-3820-b09e-35dd8f5e9f8e",
                                "text": "„Die grenzüberschreitende Abfallverbringung stellt einen hochsensiblen Rechtsbereich dar, der eine weitreichende Bedeutung im Rahmen des geltenden Völker- und Europarechts erfahren hat.“"
                            },
                            {
                                "example_id": "dbbaf457-36d0-424d-a430-d632b8206d8e",
                                "sense_id": "92fb9f01-34a1-3820-b09e-35dd8f5e9f8e",
                                "text": "„Weiters liege keine Strafbarkeit der Veranlassung einer Verbringung oder einer versuchten Abfallverbringung vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
