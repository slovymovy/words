                "senses": [
                    {
                        "sense_id": "9f07abc3-02d9-35fa-9f7c-3aa8162f5f39",
                        "entry_id": "06f0d744-b0b4-3250-b058-fa2c5582dc09",
                        "glosses": [
                            "Donner un caractère agnatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eddc708-7add-4226-afc1-fa5bb1b0b7c6",
                                "sense_id": "9f07abc3-02d9-35fa-9f7c-3aa8162f5f39",
                                "text": "Certains tendent même à « agnatiser » le « lien du ventre » pour en faire le fondement d'une germanité exclusivement agnatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "52cc8981-dfb1-3987-a30e-0c3af8d17c71",
                        "entry_id": "06f0d744-b0b4-3250-b058-fa2c5582dc09",
                        "glosses": [
                            "Appliquer une règle de nature agnatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967aa9c0-7ff7-48a8-948f-274e589acaa8",
                                "sense_id": "52cc8981-dfb1-3987-a30e-0c3af8d17c71",
                                "text": "Dans le cas où le défunt laisse un descendant mâle, la fille sera agnatisée par son frère et partagera le reliquat de la succession en appliquant la règle de la double part au profit du fils (article 119 du code tunisien)."
                            },
                            {
                                "example_id": "0bf91a47-c005-4e97-8f46-355ef6861602",
                                "sense_id": "52cc8981-dfb1-3987-a30e-0c3af8d17c71",
                                "text": "La fille est agnatisée par son frère."
                            }
                        ]
                    }
