                        "source_entry_id": "8c7c94db-3389-3097-9725-998ca48255a5",
                        "source_sense_id": "1ff1ac96-22d1-35c4-9bdb-1ea7865c1eb8",
                        "source_sense_description": "een honderdste deel",
                        "target_lang_word": "percent",
