                "senses": [
                    {
                        "sense_id": "593eb821-7874-3c2d-b29c-39e92f3635c9",
                        "entry_id": "c80d0df3-bc69-39c1-946b-97c127640787",
                        "glosses": [
                            "ein Kartoffelgericht aus gekochten und zerdrückten Kartoffeln"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "cceb03d0-e613-4b7c-84fc-7da138f62c58",
                                "sense_id": "593eb821-7874-3c2d-b29c-39e92f3635c9",
                                "text": "Der Kartoffelstock sollte nach der Zubereitung möglichst frisch gegessen werden."
                            },
                            {
                                "example_id": "94393859-c54c-42f2-b151-af74aadeeccf",
                                "sense_id": "593eb821-7874-3c2d-b29c-39e92f3635c9",
                                "text": "„Dann schöpft der Gemeinderat das Essen aus den Wärmekanistern. Kartoffelstock, Hackbraten mit Rotweinsauce, Salat, die Sauce nach Wahl. Wann immer es die Gemeindekasse erlaubt, ist der Anlass gratis.“"
                            },
                            {
                                "example_id": "8561724b-e1d1-475f-bac8-33f6df65eb9b",
                                "sense_id": "593eb821-7874-3c2d-b29c-39e92f3635c9",
                                "text": "Das Kochen eines Kartoffelstocks ist das A und O in der Hauswirtschaft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
