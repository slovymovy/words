                        "entry_id": "775528b7-e7cd-3e53-91e9-706e269fce52",
                        "glosses": [
                            "Wissenschaft, die sich mit der Mehrung des Wohlstands einer Nation beschäftigt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "872510b6-ed88-445b-bdf8-24130dccad12",
                                "sense_id": "4b46d008-0dd3-3b57-9757-0631999eeb2f",
                                "text": "„Kunth entschied, daß der ältere Bruder die Rechte und der jüngere Kameralistik studieren sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
