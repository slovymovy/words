                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "codes",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The train schedule lists the stop as <w>Kan</w>.",
                            "target_lang_translations": {
                                "zh": "列车时刻表将该站列为Kan。"
                            }
                        },
                        {
                            "text": "Passengers should look for the <w>Kan</w> code on their tickets.",
                            "target_lang_translations": {
                                "zh": "乘客应在车票上查看Kan代码。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "印度卡纳枢纽火车站的车站代码。"
                    },
                    "translations": {
                        "zh": []
                    }
                },
                {
                    "sense_id": "d1a01d21-fa58-390e-b031-6832ea77466c",
                    "sense_definition": "The station code for Kananook railway station in Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "codes",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The <w>Kan</w> station is located on the Frankston line.",
                            "target_lang_translations": {
                                "zh": "Kan车站位于弗兰克斯顿线上。"
                            }
                        },
                        {
                            "text": "Check the map for the <w>Kan</w> station identifier.",
                            "target_lang_translations": {
                                "zh": "在地图上查看Kan车站标识。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "澳大利亚卡纳努克火车站的车站代码。"
                    },
                    "translations": {
