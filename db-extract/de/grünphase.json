                ],
                "senses": [
                    {
                        "sense_id": "de02614e-47ae-32a8-8f06-8f7f89a710b2",
                        "entry_id": "d5e3904f-33f6-30a2-b5aa-29d780c16d12",
                        "glosses": [
                            "Zeitraum, in dem ein Signalgeber (eine Ampel) die Farbe Grün anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e065ecb-e6a0-46e3-a76a-0a57abda1a01",
                                "sense_id": "de02614e-47ae-32a8-8f06-8f7f89a710b2",
                                "text": "„Hoch oben über der Kreuzung zeigt eine digitale Uhr die Sekunden an, die die Grünphase noch dauern wird - ein Hauch von Hightech, eingenebelt vom allgegenwärtigen gelben Staub.“"
                            },
                            {
                                "example_id": "277a9c46-2336-4f6b-8684-620ccab776ae",
                                "sense_id": "de02614e-47ae-32a8-8f06-8f7f89a710b2",
                                "text": "„Gelbphasen, die auf die Grünphase folgen, sind bei Fußgängerampeln im deutschsprachigen Teil der Schweiz der Regelfall, sonst äußerst selten, können aber – beispielsweise in Düsseldorf – vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
