                "senses": [
                    {
                        "sense_id": "274b631d-5dcc-3fa2-bc2b-06422b272dc7",
                        "entry_id": "8ed2ed7a-4028-358c-a308-c4825cb3bcfa",
                        "glosses": [
                            "fehlerhafte Entwicklung eines Gewebes oder Organs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4261382-290b-43bc-b83c-f1b272827171",
                                "sense_id": "274b631d-5dcc-3fa2-bc2b-06422b272dc7",
                                "text": "„Die Daten in bezug auf Dysplasien beim Morbus Crohn sind weniger einheitlich, wie am Fehlen von Dysplasien bei einigen Patienten mit kolorektalen Karzinomen gesehen werden kann. Trotzdem wurde über eine enge Korrelation zwischen Dysplasie und Karzinom berichtet.“"
                            },
                            {
                                "example_id": "b0b2b8b7-ede4-4a7d-a5ce-7e0f6aa4def0",
                                "sense_id": "274b631d-5dcc-3fa2-bc2b-06422b272dc7",
                                "text": "„Bei der fibrösen Dysplasie handelt es sich um eine genetisch bedingte, tumorartige Fehlbildung des knochenbildenden Mesenchyms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
