                            "accusative",
                            "plural"
                        ],
                        "form": "die Versprechungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "856b0eac-f268-38fe-b73a-2592908827fa",
                        "entry_id": "2bcb2c72-3c29-3efe-a853-45c468f9d3b1",
                        "glosses": [
                            "verbindliche Zusage, die oft jedoch tatsächlich haltlos ist"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9a610b87-fb0c-45ec-8688-67cacdbb28f8",
                                "sense_id": "856b0eac-f268-38fe-b73a-2592908827fa",
                                "text": "„Oft wandten sich die Gespräche dem Schicksal von Frankreich in einem sich nahezu täglich wandelnden Europa zu, mit einem Krieg in Spanien und einem Diktator in Deutschland, dessen Versprechungen nicht mehr wert waren als Toilettenpapier, wie Gide sich ausdrückte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "132d5f74-7f5b-4232-9acc-cda2349b4b26",
                        "source_entry_id": "2bcb2c72-3c29-3efe-a853-45c468f9d3b1",
                        "source_sense_id": "856b0eac-f268-38fe-b73a-2592908827fa",
                        "source_sense_description": "meist im Plural: verbindliche Zusage, die oft jedoch tatsächlich haltlos ist",
                        "target_lang_word": "promesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Action de promettre ; ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7cdde-cd1d-4d5b-bb3d-cb608e33acbc",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Mettez-vous en garde contre ces belles promesses, elles cachent souvent la plus infame des tromperies."
                                            },
                                            {
                                                "example_id": "2e4ea110-0aa7-4ea3-bd17-ce3255016b0f",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Et il réfléchissait. Ce qui est inintelligible, se dit-il, c’est la disproportion qui existe entre les promesses que Jésus lui fit et les résultats qu’elles obtinrent."
                                            },
                                            {
                                                "example_id": "24a634ea-4833-44fc-b8a7-0ff03b941ebd",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Si Dimitri ne voulait pas épouser Phoebe, il aurait au moins dû avoir le courage de l’avouer et de rompre formellement sa promesse. Au lieu de cela, il avait opté pour le silence et l'hypocrisie, […]."
                                            },
                                            {
                                                "example_id": "fd84f999-8461-44eb-aab2-b3a4802055d5",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Si nous promettons une livraison, nous devons tenir notre promesse."
                                            },
                                            {
                                                "example_id": "e2199848-29a9-4050-8b7c-6a8d2e9fd84b",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Venus en Europe avec la promesse d’un salaire de 1 500 euros mensuels, « voire 2 200 avec les bonus » selon Brighton Jonasi, la plupart ne reçoivent qu’entre 600 et 700 euros, depuis octobre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Ce que l'on espère obtenir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d2bcca-4eb8-4ee7-862b-fa3c9f026cac",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Le talent, chez les hommes est donc à peu près, quant au moral, ce qu’est la beauté chez les femmes, une promesse."
                                            },
                                            {
                                                "example_id": "0dbc55fc-1a54-4012-a58b-7450e1b0c595",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans […]."
                                            },
                                            {
                                                "example_id": "ee961b96-21bf-445e-b7bd-179a285fae5f",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Parmi les fléaux qui s'abattent sur la vigne, le plus terrible, dans ses effets, est évidemment la grêle. Le vignoble est beau, et plein de promesses, et cinq minutes plus tard il n'en reste rien ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3e0195-28a8-3da1-817d-2195f11767ec",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Engagement à terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5065659e-7cba-4a64-a00b-de7f7fa300a5",
                                                "sense_id": "9c3e0195-28a8-3da1-817d-2195f11767ec",
                                                "text": "Il faudrait, en premier lieu, répandre parmi nous, par le perfectionnement des institutions de crédit, l'usage des billets, des promesses, des reconnaissances. C'est dire que nos banques devraient cesser de vivre sous l'empire d'un monopole aussi absolu qu'injuste et funeste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
