                                "sense_id": "d166280e-be13-3fea-abd2-f8cf512667dd",
                                "text": "Ik heb nieuwe kleren gekocht.",
                                "translation": "I bought new clothes.",
                                "english": "I bought new clothes."
                            },
                            {
                                "example_id": "ebafc646-0e29-48a1-a72f-d098227f3cd0",
                                "sense_id": "d166280e-be13-3fea-abd2-f8cf512667dd",
                                "text": "Haar kleren waren nat van de regen.",
                                "translation": "Her clothes were wet from the rain.",
                                "english": "Her clothes were wet from the rain."
                            },
                            {
                                "example_id": "d86acb87-a22c-4157-ba24-80c4a932a089",
                                "sense_id": "d166280e-be13-3fea-abd2-f8cf512667dd",
                                "text": "De kinderen droegen kleurrijke kleertjes tijdens het feest.",
                                "translation": "The children wore colorful clothes during the party.",
                                "english": "The children wore colorful clothes during the party."
                            }
                        ]
