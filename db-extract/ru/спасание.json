                                        "entry_id": "f9243693-6b1f-35d3-bbe3-c70447a90a00",
                                        "glosses": [
                                            "A reduction in cost or expenditure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "684b8edc-c118-473f-b8e2-ed20cc29a5c5",
                                                "sense_id": "2b203543-c2cf-3987-940b-ce4eb07b3127",
                                                "text": "This new yard will replace a group of out-of-date yards, and there will be an estimated net saving of £150,000 a year."
                                            },
                                            {
                                                "example_id": "1c339e5f-f952-4dd9-8ee1-e624772dbecb",
                                                "sense_id": "2b203543-c2cf-3987-940b-ce4eb07b3127",
                                                "text": "The shift of the supplier gave us a saving of 10 percent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                                        "entry_id": "f9243693-6b1f-35d3-bbe3-c70447a90a00",
                                        "glosses": [
                                            "Something (usually money) that is saved, particularly money that has been set aside for the future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24d1427b-f37b-4ba9-8b6e-1ab43e252c55",
                                                "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                                                "text": "I invested all my savings in gold."
                                            },
                                            {
                                                "example_id": "cca32724-803a-4be2-bf23-8c34d33fc4d0",
                                                "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                                                "text": "The collapse of Enron wiped out the life savings of many people, leaving them poor in their retirement."
                                            },
                                            {
                                                "example_id": "e5d63d74-95fb-4790-a111-b2df715ccc5e",
                                                "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                                                "text": "“Rather than writing off both jets as a loss … teams made a bold decision in 2022 to remove the nose from AF-27 and put it onto AF-211 to maximize savings and add back an operational aircraft to the fleet,” a report from the F-35 JPO said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae1ba96-eeaa-33e9-bb09-9999977d66b4",
                                        "entry_id": "f9243693-6b1f-35d3-bbe3-c70447a90a00",
                                        "glosses": [
                                            "The action of the verb to save."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f225fe16-8b53-3ea2-b21a-aa15c75cf21c",
                                        "entry_id": "f9243693-6b1f-35d3-bbe3-c70447a90a00",
                                        "glosses": [
                                            "Exception; reservation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f815247-2a80-4d3a-a163-7eb4691d83ac",
                                                "sense_id": "f225fe16-8b53-3ea2-b21a-aa15c75cf21c",
                                                "text": "saving and transitional provisions"
                                            },
                                            {
                                                "example_id": "d69ae87d-cc2e-4acd-802d-8e291ed81c36",
                                                "sense_id": "f225fe16-8b53-3ea2-b21a-aa15c75cf21c",
                                                "text": "Tis Good Advice not to Contend with Those that are too Strong for us, but still with a saving to Honesty and Justice"
                                            }
                                        ]
                                    }
