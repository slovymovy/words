                    }
                ],
                "senses": [
                    {
                        "sense_id": "d07438a4-9095-39c2-945d-fcf0139b8f15",
                        "entry_id": "752eb03c-e197-322e-96b6-b702731a8fa8",
                        "glosses": [
                            "Qualifie une pièce qui est représentée à l’aide d’une corde. À rapprocher de câblé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6929f5-1aa5-45fa-b937-9f27f08964e8",
                                "sense_id": "d07438a4-9095-39c2-945d-fcf0139b8f15",
                                "text": "D’azur à trois trangles ondées d’argent, à l’aigle essorante soutenue d’un coupeau mouvant de la pointe et surmontée d’une coquille, le tout d’or et brochant sur les trangles ; à l’orle cordé d’argent brochant sur le tout, qui est d’Albine du Tarn → voir illustration « orle cordé »"
                            }
                        ]
                    },
                    {
                        "sense_id": "7561a372-dafa-32ee-b1f1-cefce4764ff1",
                        "entry_id": "752eb03c-e197-322e-96b6-b702731a8fa8",
                        "glosses": [
                            "Qualifie un arc dont la corde est d'une autre couleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0352293-edfd-49dd-800f-4ab98b3e7406",
                                "sense_id": "7561a372-dafa-32ee-b1f1-cefce4764ff1",
                                "text": "De sinople à un arc de gueules cordé de sable, avec une flèche aussi de sable, accompagné de neuf quilles d’or posées en orle et soutenu d’une boule de sable, qui est de Châlus → voir illustration « arc cordé »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8a206c1-88e7-3f54-a458-f1a264fd0cc5",
                        "entry_id": "752eb03c-e197-322e-96b6-b702731a8fa8",
                        "glosses": [
                            "Qualifie la couleur des cordes des instruments de musique à cordes. S’applique par exemple à la guitare, la harpe, au luth, à la lyre ou encore la mandoline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57b12a9-8918-47fc-bd63-0295477980e3",
                                "sense_id": "a8a206c1-88e7-3f54-a458-f1a264fd0cc5",
                                "text": "D’azur à une lyre d’or cordée d’argent, qui est de l’Irlande → voir illustration « lyre cordée »"
                            }
                        ]
                    }
                ],
