                        "glosses": [
                            "Organisme du ministère de l’Économie et des Finances français, chargé de la lutte contre le blanchiment d’argent et contre le financement du terrorisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6717a5f-7ae8-4b30-8232-e0fad76d3c0a",
                                "sense_id": "37258936-03cb-3865-8bf5-e22686fc01d6",
                                "text": "Chargée de la lutte contre l’argent sale, Tracfin, cellule française du ministère de l'Economie, a enregistré une hausse sans précédent de son activité en 2016."
                            },
                            {
                                "example_id": "ea15491e-a243-4940-9570-efccac1e4272",
                                "sense_id": "37258936-03cb-3865-8bf5-e22686fc01d6",
                                "text": "La fraude au CPF a fortement augmenté en 2021, détaillait en juillet Tracfin, la cellule de renseignements financiers de Bercy."
                            },
                            {
                                "example_id": "0927cc47-ce6f-40b1-9cbe-fcc8888b391b",
                                "sense_id": "37258936-03cb-3865-8bf5-e22686fc01d6",
                                "text": "La même année, Tracfin, le service de lutte contre la fraude fiscale, sociale et douanière, émet des signalements."
                            }
                        ]
                    }
