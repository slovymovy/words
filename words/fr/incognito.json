                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le célèbre acteur préfère voyager <w>incognito</w> pour éviter l'attention des journalistes et du public."
                        },
                        {
                            "text": "Elle est venue <w>incognito</w> à la cérémonie afin de ne pas attirer tous les regards."
                        }
                    ],
                    "synonyms": [
                        "clandestinement",
                        "secrètement"
                    ],
                    "common_phrases": [
                        "voyager incognito",
                        "rester incognito",
                        "vivre incognito"
                    ]
                }
            ]
        },
