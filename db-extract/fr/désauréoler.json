                        "glosses": [
                            "Ne plus auréoler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7cfca4c-8ede-47a4-8122-b37c91061dda",
                                "sense_id": "2a34a2c4-d9a8-3b92-905b-00c8de519f71",
                                "text": "Et puisque le passé de Climène se trouvait ici plus directement rappelé, fallait-il la désauréoler ?"
                            },
                            {
                                "example_id": "7fc54244-59ee-4e38-a870-9fbdb85e54ee",
                                "sense_id": "2a34a2c4-d9a8-3b92-905b-00c8de519f71",
                                "text": "Cette réserve faite, louons M. Villaret d’avoir osé, dans son texte, désauréoler ces terres fortunées de tout le convenu qui s’attache à elles."
                            }
                        ]
                    }
