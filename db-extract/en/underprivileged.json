                                        "entry_id": "2006ea1e-4bb0-3e9a-b5bc-b02199e82d2f",
                                        "glosses": [
                                            "durch bestimmte Umstände im Nachteil seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d538f320-d37c-4b57-8076-78b3414d2a28",
                                                "sense_id": "d3ef2a3a-38d9-351e-ad87-a86dff5560a7",
                                                "text": "Durch den Abriss des einzigen Krankenhauses im Ort sind die Bürger benachteiligt."
                                            },
                                            {
                                                "example_id": "9ddceb12-003e-4545-b988-30bf505a5922",
                                                "sense_id": "d3ef2a3a-38d9-351e-ad87-a86dff5560a7",
                                                "text": "„Für viele Polen sind die angebotenen Waren unerschwinglich. Rentner, Kranke und Alleinstehende gehören zu den sozial besonders benachteiligten Gruppen.“"
                                            },
                                            {
                                                "example_id": "874d138a-4896-4135-bd3d-75f6d3b4d83a",
                                                "sense_id": "d3ef2a3a-38d9-351e-ad87-a86dff5560a7",
                                                "text": "„Für benachteiligte Kinder, egal ob aus Flüchtlings- oder aus deutschen Familien, sieht die Bildungssituation nicht gut aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
