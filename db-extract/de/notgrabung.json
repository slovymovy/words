                "senses": [
                    {
                        "sense_id": "ab960503-76b9-3f99-a5cf-6eaced4fb326",
                        "entry_id": "9642914a-a9bf-32bb-a3a5-fc8429cff8db",
                        "glosses": [
                            "kurzfristig organisierte Grabung zur Sicherung einer archäologischen Fundstelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8491f543-b89d-4131-8009-86bc04eba2d2",
                                "sense_id": "ab960503-76b9-3f99-a5cf-6eaced4fb326",
                                "text": "„Eine Notgrabung in Tübingen zu den Lebensbedingungen des Neandertalers brachte zahlreiche Knochenfunde im Alter von 50.000 bis 100.000 Jahren zutage.“"
                            },
                            {
                                "example_id": "ed436c41-51cd-4ecd-b101-33fa2b77d1df",
                                "sense_id": "ab960503-76b9-3f99-a5cf-6eaced4fb326",
                                "text": "„Die meisten Ausgrabungen sind heute kurzfristige Rettungsgrabungen (Notgrabungen), bei denen durch Erd- und Bauarbeiten bedrohte Fundplätze untersucht werden.“"
                            },
                            {
                                "example_id": "26afa247-56ee-4e7c-b50b-88d5e1bf8d90",
                                "sense_id": "ab960503-76b9-3f99-a5cf-6eaced4fb326",
                                "text": "„Eine Notgrabung in der ägyptischen Oase Fajum brachte jahrtausende alte Schätze zutage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
