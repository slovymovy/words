                        "examples": [
                            {
                                "example_id": "ec8b6787-b73b-4be2-9b78-1cc1ee4b0119",
                                "sense_id": "74388fa8-0b56-39b0-9b1b-c03d1e6ad9e0",
                                "text": "Le v est non seulement désonorisé, mais il est aussi défricativisé, puisqu’il se réalise sous la forme occlusive p (cf. appaa, ‘la moitié de’)."
                            },
                            {
                                "example_id": "5c4dfc34-aa11-4c09-ab50-8e3fff0f0f92",
                                "sense_id": "74388fa8-0b56-39b0-9b1b-c03d1e6ad9e0",
                                "text": "Peut-être est-ce là la conséquence d’une particularité phonétique du français canadien qui n’hésite pas à désonoriser le (I) en syllabe fermée."
                            },
                            {
                                "example_id": "e507f066-5496-42e6-a4c1-6fd68147f803",
                                "sense_id": "74388fa8-0b56-39b0-9b1b-c03d1e6ad9e0",
                                "text": "Il faut aussi mentionner que le /r/ en position implosive a fortement tendance à se désonoriser ([ʁ̥]) dans les cantons de Neuchâtel, de Berne et du Jura."
                            }
                        ]
