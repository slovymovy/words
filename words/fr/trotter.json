                    "frequency": "VeryLow",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entraîneur a fait <w>trotter</w> le jeune poulain pendant une demi-heure."
                        },
                        {
                            "text": "Le cavalier a décidé de <w>trotter</w> son cheval pour l'échauffer."
                        }
                    ],
                    "common_phrases": [
