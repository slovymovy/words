                "senses": [
                    {
                        "sense_id": "50252860-e30e-3b52-aba8-c8ef6a9009c2",
                        "entry_id": "c53f6a69-9c29-39f3-a592-1aa9edd9774e",
                        "glosses": [
                            "groep van mensen of organisaties die het overheidsbeleid in een bepaalde richting willen sturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc6cac7f-bec1-4287-9440-5ad4dce9df17",
                                "sense_id": "50252860-e30e-3b52-aba8-c8ef6a9009c2",
                                "text": "Niemand wil meer de hoge oude bomen oogsten met ladders en de olijven oprapen van doeken op de grond. De overheid liet de oren hangen naar pressiegroepen. Ook de wetenschap is slachtoffer door haar machteloosheid, om te zwijgen over de enorme belangen die bedreigd worden buiten Zuid-Italië."
                            },
                            {
                                "example_id": "4f079968-45af-4527-a0c4-43c39ccdc19e",
                                "sense_id": "50252860-e30e-3b52-aba8-c8ef6a9009c2",
                                "text": "Trump werd op zijn eerste werkdag ook meteen aangeklaagd. Volgens pressiegroep CREW (Citizens for Responsibility and Ethics in Washington) ontvangen zijn hotels geld van buitenlandse diplomaten en huren regeringen van andere landen kantoorruimte in gebouwen die van Trump zijn. Dat is strijdig met de grondwet en dus is er een klacht tegen hem ingediend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae59a11b-6bde-4aec-a60a-c2539d7cee34",
                        "source_entry_id": "c53f6a69-9c29-39f3-a592-1aa9edd9774e",
                        "source_sense_id": "50252860-e30e-3b52-aba8-c8ef6a9009c2",
                        "source_sense_description": "(politiek) groep van mensen of organisaties die het overheidsbeleid in een bepaalde richting willen sturen",
                        "target_lang_word": "pressure group",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressure group",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "513a6277-fef4-3ccf-8d28-30fbceaafb06",
                                        "entry_id": "c5d88a7d-9bc7-3f4d-8a6a-7c6e15c08339",
                                        "glosses": [
                                            "An advocacy group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6299171c-379b-4869-8870-5a3b5daf9472",
                                                "sense_id": "513a6277-fef4-3ccf-8d28-30fbceaafb06",
                                                "text": "Various efforts by certain political pressure groups were still being made to stop the West Africa Squadron's activities, for a number of less-than-honourable reasons, but the government was able to resist them and the patrols would continue."
                                            },
                                            {
                                                "example_id": "4d28fb08-ef60-4578-8a21-2fb4c3017ba3",
                                                "sense_id": "513a6277-fef4-3ccf-8d28-30fbceaafb06",
                                                "text": "Passengers, pressure groups and local authorities have criticised the operator's plans for a permanent reduction in services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
