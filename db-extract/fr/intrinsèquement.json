        "fr-extract.jsonl": [
            {
                "entry_id": "2faeea65-b73e-3b3f-9c2f-1676060556a6",
                "word": "intrinsèquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "321265e4-3020-389b-9bb1-fe85c26607c1",
                        "entry_id": "2faeea65-b73e-3b3f-9c2f-1676060556a6",
                        "glosses": [
                            "D’une manière intrinsèque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdeb4e6c-1c38-4e89-9550-b48169b8bd6c",
                                "sense_id": "321265e4-3020-389b-9bb1-fe85c26607c1",
                                "text": "Je fus le conseil de Cossé sur ce qui regardait intrinsèquement la succession à la dignité."
                            },
                            {
                                "example_id": "6f9e3246-be96-409c-8ff2-bd45564be9b5",
                                "sense_id": "321265e4-3020-389b-9bb1-fe85c26607c1",
                                "text": "[…], mais prenez un livre d'histoire et considérez les contemporains de Montaigne ou même ceux de Descartes et vous verrez que la haine religieuse qui a opposé les chrétiens catholiques et les Chrétiens protestants était plus furibonde, plus sanguinaire, plus fanatique, plus intrinsèquement sauvage que celle qui peut exister aujourd'hui entre les communautés musulmanes et chrétiennes d'Afrique."
                            },
                            {
                                "example_id": "5d994580-8081-4a33-ab28-324f1892bb7d",
                                "sense_id": "321265e4-3020-389b-9bb1-fe85c26607c1",
                                "text": "Affichant non sans panache un athéisme militant, il appelle à en finir avec une certaine tolérance envers les religions monothéistes, intrinsèquement intolérantes et pétries de haine."
                            },
                            {
                                "example_id": "3305a644-7e78-47ad-8af4-bb5dfd1ab632",
                                "sense_id": "321265e4-3020-389b-9bb1-fe85c26607c1",
                                "text": "Il n’est pas absurde, il n’est pas intrinsèquement irrationnel, c’est-à-dire contradictoire avec des principes fondamentaux, que la philosophie préfère la pauvreté à la richesse, la servitude à la liberté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5cbc3b5-b5f2-4816-9794-37604b2e759f",
                        "source_entry_id": "2faeea65-b73e-3b3f-9c2f-1676060556a6",
                        "source_sense_id": "321265e4-3020-389b-9bb1-fe85c26607c1",
                        "target_lang_word": "intrinsically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrinsically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7452f9d5-f720-305b-8e18-b9248443ff5b",
                                        "entry_id": "7711f4c7-e0a9-3410-ac7c-c669cb61c347",
                                        "glosses": [
                                            "In an intrinsic manner; internally; essentially."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0422db9-dbb0-410e-9739-ac8dd241fd31",
                                                "sense_id": "7452f9d5-f720-305b-8e18-b9248443ff5b",
                                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                                            },
                                            {
                                                "example_id": "b57c7489-4a72-4ae9-89e0-5c5ef7ac163c",
                                                "sense_id": "7452f9d5-f720-305b-8e18-b9248443ff5b",
                                                "text": "What cannot be commoditized because it is intrinsically inaccessible to commodification?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bca1635-169a-33cb-9222-af2dc9c06807",
                                        "entry_id": "7711f4c7-e0a9-3410-ac7c-c669cb61c347",
                                        "glosses": [
                                            "Necessarily"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f74b48-de51-4772-9a6d-a5884fa19d61",
                                                "sense_id": "7bca1635-169a-33cb-9222-af2dc9c06807",
                                                "text": "Like in the case of living languages, the classification of substrate elements as belonging to a certain language family shmould ideally be based on morphological as well as lexical evidence. The difference with living languages is however that the available material for substrate languages is scarcer, especially in the morphological domain, and intrinsically transmitted indirectly through the language that replaced it."
                                            },
                                            {
                                                "example_id": "45ce7979-bba4-4079-99cd-6c28aea54fb1",
                                                "sense_id": "7bca1635-169a-33cb-9222-af2dc9c06807",
                                                "text": "I think the kind of hi-lo, low tax / blue collar coalition PP is running this time, it intrinsically leads to inferior outcomes regardless of party policymakers intent"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d41c4ac-4145-4012-9dd8-0d4ee4f8e5dd",
                        "source_entry_id": "2faeea65-b73e-3b3f-9c2f-1676060556a6",
                        "source_sense_id": "321265e4-3020-389b-9bb1-fe85c26607c1",
                        "target_lang_word": "intrínsecamente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrínsecamente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "574b8894-e548-3654-a14e-aec928071856",
                                        "entry_id": "ee886d58-007d-3de2-866f-3954b1db833b",
                                        "glosses": [
                                            "De forma o manera intrínseca."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8cc615-e7b9-40e7-92bc-e29c2e50220a",
                                                "sense_id": "574b8894-e548-3654-a14e-aec928071856",
                                                "text": "¿No es acaso el libre albedrío una facultad intrínsecamente humana y que no se puede cambiar?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
