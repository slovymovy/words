                        ],
                        "form": "das Nachtlager"
                    },
                    {
                        "form_id": "449704e8-109c-4030-b022-85c31a85e49b",
                        "entry_id": "188bc243-b725-376f-85c8-075cf139369a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nachtlager"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                        "entry_id": "188bc243-b725-376f-85c8-075cf139369a",
                        "glosses": [
                            "Ort zum Schlafen in der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890c7457-48f5-4b76-a1b4-51fd08bbf8e6",
                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                "text": "Sie schlugen ihr Nachtlager am See auf."
                            },
                            {
                                "example_id": "5491c152-1130-4f8d-9ef4-ec1fea3b9241",
                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                "text": "„Erst als alle ihr klägliches Nachtlager bezogen hatten, sprach Lea in die Dunkelheit hinein.“"
                            },
                            {
                                "example_id": "f5718dad-1a61-402d-9567-65c068c8f35d",
                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                "text": "„In Marseille schlug ich mein Nachtlager in einem angenehm heruntergekommenen Hotel an der Corniche auf, der Küstenstraße, die sich am Mittelmeer entlang schlängelt.“"
                            },
                            {
                                "example_id": "4365eadf-d237-476e-b5dc-cd55e20a93a2",
                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                "text": "„Ein Trompeter blies die Sonne in ihr Nachtlager, die Soldaten sangen Lieder und schwärmten von Fischen und gebratenem Ochsenfleisch.“"
                            },
                            {
                                "example_id": "044226fb-e8a2-4f28-b87d-3af28a5d6e45",
                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                "text": "„Der Vogt hatte einen Boten zu seinen Dienern geschickt, daß sie der Tochter des Richters ihr Nachtlager bereiteten und sie bedienten, und sie kamen mit Braten und Wein, als der Richter Abschied von seiner Tochter nahm und zu seiner Thingbude und seinen Gästen zurückging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "994a90c2-b868-4c2b-b93d-f8db8a56774f",
                        "source_entry_id": "188bc243-b725-376f-85c8-075cf139369a",
                        "source_sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                        "source_sense_description": "Ort zum Schlafen in der Nacht",
                        "target_lang_word": "ночной привал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ecf2686f-032b-4a41-811b-7af39a18d539",
                        "source_entry_id": "188bc243-b725-376f-85c8-075cf139369a",
                        "source_sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                        "source_sense_description": "Ort zum Schlafen in der Nacht",
                        "target_lang_word": "ночлег",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ночлег",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e8bf50f4-27c3-3a4b-a1fa-3dbe31f44a64",
                                        "entry_id": "3e6fb575-0fdf-385e-a589-7d053ecdb660",
                                        "glosses": [
                                            "место для ночного сна, отдыха (как правило не у себя дома)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e80cbe8-a994-430e-8fe7-4edae93a2e3e",
                                                "sense_id": "e8bf50f4-27c3-3a4b-a1fa-3dbe31f44a64",
                                                "text": "За неимением комнаты для проезжающих на станции, нам отвели ночлег в дымной сакле."
                                            },
                                            {
                                                "example_id": "67691694-f739-4f05-9b91-04447a0d24bd",
                                                "sense_id": "e8bf50f4-27c3-3a4b-a1fa-3dbe31f44a64",
                                                "text": "Будучи принужден остаться ночевать в чужом доме, он боялся, чтоб не отвели ему ночлега где-нибудь в уединённой комнате, куда легко могли забраться воры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc4ea9b-0b42-378e-9558-5b4c7dc76803",
                                        "entry_id": "3e6fb575-0fdf-385e-a589-7d053ecdb660",
                                        "glosses": [
                                            "то же, что ночёвка; остановка где-либо на ночь для сна, отдыха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a0dc1cf-3f03-4f31-8659-8203b0ae303e",
                                                "sense_id": "8dc4ea9b-0b42-378e-9558-5b4c7dc76803",
                                                "text": "В пути мне пришлось остановиться на ночлег в придорожной харчевне."
                                            },
                                            {
                                                "example_id": "db932c09-1e87-477b-a936-187eb5991289",
                                                "sense_id": "8dc4ea9b-0b42-378e-9558-5b4c7dc76803",
                                                "text": "Штаб дивизии расположился на ночлег в обширном лесу, в центре забывшихся неспокойным сном полков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6877426-61c6-318a-baae-872f2a407221",
                                        "entry_id": "3e6fb575-0fdf-385e-a589-7d053ecdb660",
                                        "glosses": [
                                            "ночной отдых, сон (обычно животных, птиц)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
