                "senses": [
                    {
                        "sense_id": "995de3c3-5e54-31c0-bad5-d1cfb3008644",
                        "entry_id": "1adf15a8-172b-3c2f-8529-25bae8439168",
                        "glosses": [
                            "в неудачный, неподходящий момент, не вовремя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a581671-8ffa-441b-9aaf-d936f6702f10",
                                "sense_id": "995de3c3-5e54-31c0-bad5-d1cfb3008644",
                                "text": "Извинился за то, что пришёл без предупреждения, добавив, что немедленно уйдёт, если явился некстати."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee2fe617-3ea6-3e4b-ab2f-37f44416b0a2",
                        "entry_id": "1adf15a8-172b-3c2f-8529-25bae8439168",
                        "glosses": [
                            "не к месту, неуместно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c951f16-53ff-44a5-b872-d90f0d34748c",
                                "sense_id": "ee2fe617-3ea6-3e4b-ab2f-37f44416b0a2",
                                "text": "Сегодня в ресторане ты говорил опять много и всё некстати."
                            }
                        ]
                    }
                ],
