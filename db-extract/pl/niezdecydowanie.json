                        "translation_id": "280f1639-ab3c-42cb-8f8c-ab8394c37397",
                        "source_entry_id": "7f71051a-b2b8-355c-bca3-e6b94a880556",
                        "source_sense_id": "dc54029c-0c6a-37d1-87df-56d0e7049df3",
