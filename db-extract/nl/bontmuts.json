                        "examples": [
                            {
                                "example_id": "6fcbba8a-6d2e-43b2-b3bb-9ad3a3c27476",
                                "sense_id": "a6580c65-3aa1-3cda-ae3d-b07427c05260",
                                "text": "Ook de televisiecritici misten de markante NOS-verslaggever. „Wie schitterde door afwezigheid was onze vertrouwde ingesneeuwde Gerri met zijn befaamde bontmuts”, aldus Parool-recensent Han Lips. „Dus stonden drie andere NOS-heren te blauwbekken op de respectievelijke crisisplekken in het land. Allemaal zonder bontmuts.”"
                            },
                            {
                                "example_id": "b44f8537-dede-4582-a43a-274493d575a1",
                                "sense_id": "a6580c65-3aa1-3cda-ae3d-b07427c05260",
                                "text": "27 januari draait de uitzending om schaatser Kees Verkerk en zijn bekende, van zijn overleden moeder gekregen bontmuts."
                            }
                        ]
                    }
