    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c7aca8f7-1398-353d-8eae-0f86482233a3",
                    "sense_definition": "первый знак зодиака в астрологии, соответствующий сектору эклиптики от 0° до 30°",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zodiac",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Солнце вступает в знак <w>Овна</w> в день весеннего равноденствия.",
                            "target_lang_translations": {
                                "en": "The Sun enters the sign of <w>Aries</w> on the day of the vernal equinox."
                            }
                        },
                        {
                            "text": "По гороскопу мой брат — типичный <w>Овен</w>.",
                            "target_lang_translations": {
                                "en": "According to the horoscope, my brother is a typical <w>Aries</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "♈"
                    ],
                    "antonyms": [
                        "Весы"
                    ],
                    "common_phrases": [
                        "знак Овна"
                    ],
                    "target_lang_definitions": {
                        "en": "the first astrological sign in the zodiac, corresponding to the sector of the ecliptic from 0° to 30°"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Aries",
                                "target_lang_sense_clarification": "zodiac sign"
                            },
                            {
                                "target_lang_word": "the Ram",
                                "target_lang_sense_clarification": "astrological sign"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6da204d-dbe5-38be-a109-578e3765dd2a",
                    "sense_definition": "экваториальное созвездие северного полушария неба",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "На ночном небе астрономы без труда разглядели созвездие <w>Овна</w>.",
                            "target_lang_translations": {
                                "en": "In the night sky, astronomers easily spotted the constellation of <w>Aries</w>."
                            }
                        },
                        {
                            "text": "Главные звёзды созвездия <w>Овен</w> образуют характерную дугу.",
                            "target_lang_translations": {
                                "en": "The main stars of the constellation <w>Aries</w> form a distinctive arc."
                            }
                        }
                    ],
                    "common_phrases": [
                        "созвездие Овна"
                    ],
                    "target_lang_definitions": {
                        "en": "an equatorial constellation of the northern celestial hemisphere"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Aries",
                                "target_lang_sense_clarification": "constellation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c71a68a-3192-3b17-8397-9a718dcdb056",
                    "sense_definition": "человек, родившийся под зодиакальным знаком Овна",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zodiac",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой друг родился в начале апреля, поэтому он настоящий <w>овен</w>.",
                            "target_lang_translations": {
                                "en": "My friend was born in early April, so he is a true <w>Aries</w>."
                            }
                        },
                        {
                            "text": "Многие <w>овны</w> отличаются решительностью и упрямым характером.",
                            "target_lang_translations": {
                                "en": "Many <w>Arians</w> are known for their decisiveness and stubborn nature."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person born under the astrological sign of Aries"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Aries",
                                "target_lang_sense_clarification": "person born under the sign of Aries"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7030546-a407-362f-bd57-c3fb98e39ae5",
                    "sense_definition": "самец овцы; то же, что <w>баран</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В древнем тексте упоминается жертвенный <w>овен</w> с большими рогами.",
                            "target_lang_translations": {
                                "en": "The ancient text mentions a sacrificial <w>ram</w> with large horns."
                            }
                        },
                        {
                            "text": "Пастух вёл стадо, во главе которого уверенно шагал белый <w>овен</w>.",
                            "target_lang_translations": {
                                "en": "The shepherd led the flock, at the head of which strode a white <w>ram</w> with confidence."
                            }
                        }
                    ],
                    "synonyms": [
                        "баран"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее обозначение барана"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a male sheep; ram (archaic/literary)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ram",
                                "target_lang_sense_clarification": "male sheep"
                            }
                        ]
                    }
                }
            ]
        }
    ]
