                "senses": [
                    {
                        "sense_id": "14c00074-839e-31f6-b31b-81bb48227d35",
                        "entry_id": "b40960d3-0f9a-3e55-b1b9-db64d02e561e",
                        "glosses": [
                            "Anhänger der philosophischen Lehren Ernst Machs ^(→ WP)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904fa9b2-d78f-4446-806b-8ca1ba2079f5",
                                "sense_id": "14c00074-839e-31f6-b31b-81bb48227d35",
                                "text": "„Adler war Machist, und Einsteins Überzeugung von der objektiven Realität der Welt war ihm fremd.“"
                            },
                            {
                                "example_id": "d3c20189-0bb4-4aa7-a07c-ef45b945e648",
                                "sense_id": "14c00074-839e-31f6-b31b-81bb48227d35",
                                "text": "„Die Vorstöße der Machisten waren sehr gefährlich, weil sie ihre Ansichten zur Zeit der politischen und ideologischen Generaloffensive der Reaktion zu verbreiten suchten.“"
                            },
                            {
                                "example_id": "736e9f69-c828-4a46-a06c-4d0bc61ee2af",
                                "sense_id": "14c00074-839e-31f6-b31b-81bb48227d35",
                                "text": "„Aber er wich der entscheidenden Frage aus, die die Machisten aufgebracht hatten: Die Frage nach den Auswirkungen der neuen Entdeckungen im Bereich der Physik auf den Materialismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
