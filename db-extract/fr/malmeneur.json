                "senses": [
                    {
                        "sense_id": "7db6c6bf-8aa7-3b6f-921c-3c9f4575822f",
                        "entry_id": "d81533c6-695a-34d2-b1f6-457d6b5ca412",
                        "glosses": [
                            "Personne qui malmène."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b6f64bce-3276-4d58-b611-28b9dd197199",
                                "sense_id": "7db6c6bf-8aa7-3b6f-921c-3c9f4575822f",
                                "text": "Il travaille plutôt avec enthousiasme pour l’administration coloniale. Ainsi on le voit s’occuper de retrouver le malmeneur de M. T., le commerçant grec."
                            },
                            {
                                "example_id": "564a25c6-bb65-46d2-a0a2-7e6fdf218177",
                                "sense_id": "7db6c6bf-8aa7-3b6f-921c-3c9f4575822f",
                                "text": "Plutôt qu’à repartir sur des voies déjà tracées, ne peut-on s’étonner que cet investigateur du social, ce malmeneur d’idées reçues ne s’engage pas, quand il est question du pouvoir, sur des voies à défricher ?"
                            },
                            {
                                "example_id": "f8906c99-0a77-4bfd-8d2b-fe66c9cafccc",
                                "sense_id": "7db6c6bf-8aa7-3b6f-921c-3c9f4575822f",
                                "text": "C’est ce qu’il interrogeait sur le motif de son inculpation où il était traité de « malmeneur d’intimité »."
                            }
                        ]
                    }
                ],
