                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fca1911-ba52-35e4-b9d2-eac4ce5ece7d",
                                        "entry_id": "ca58375f-0d9e-3d57-9b1c-db3269567616",
