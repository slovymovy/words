                    {
                        "translation_id": "da55069c-d3c3-4fb7-8240-cd5e746639ab",
                        "source_entry_id": "0002779d-8077-33d6-a53c-6cc908f52b3d",
                        "source_sense_id": "a29b02c6-f39c-32b3-901c-8f879e38920e",
