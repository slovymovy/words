                                                "sense_id": "23933129-39d9-311a-ae00-4495c1fb4adc",
                                                "text": "Ton interrogatif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5df3f75-aa71-3d78-ab44-40f5b0360283",
                                        "entry_id": "d79e6bee-a577-3508-afed-a8ad494dda09",
                                        "glosses": [
                                            "Qui sert à interroger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7dcbc67-f66a-42f3-abc2-8f18cbbb81e3",
                                                "sense_id": "d5df3f75-aa71-3d78-ab44-40f5b0360283",
                                                "text": "Particule interrogative."
                                            },
                                            {
                                                "example_id": "710152fb-3a03-40d3-aa75-3efec4285d91",
                                                "sense_id": "d5df3f75-aa71-3d78-ab44-40f5b0360283",
                                                "text": "Se servir de termes interrogatifs."
                                            },
                                            {
                                                "example_id": "5c08781c-3bdd-4fcf-8b8e-0499f3ed0888",
                                                "sense_id": "d5df3f75-aa71-3d78-ab44-40f5b0360283",
                                                "text": "– Êtes-vous contents, êtes-vous assez contents ?\nIl ne savait s’il fallait donner à ces phrases un air interrogatif ou exclamatif, tant le visage des enfants témoignait d’indifférence."
                                            }
                                        ]
                                    }
                                ]
