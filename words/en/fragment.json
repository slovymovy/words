{
    "word_family": [
        "fragmentary",
        "fragmentation",
        "fragmentize",
        "defragment",
        "fragmented"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "842ec629-f23d-3579-8869-0ac57132355b",
                    "sense_definition": "A small part that has broken off or is detached from something larger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archaeologists found a small <w>fragment</w> of ancient pottery buried deep in the sand.",
                            "target_lang_translations": {
                                "ru": "Археологи нашли небольшой <w>осколок</w> древней керамики, зарытый глубоко в песке."
                            }
                        },
                        {
                            "text": "I only heard a <w>fragment</w> of their conversation as I walked past the open door.",
                            "target_lang_translations": {
                                "ru": "Я услышал лишь <w>отрывок</w> их разговора, когда проходил мимо открытой двери."
                            }
                        }
                    ],
                    "synonyms": [
                        "piece",
                        "bit",
                        "scrap",
                        "chip",
                        "portion",
                        "snippet"
                    ],
                    "common_phrases": [
                        "fragment of conversation",
                        "bone fragment",
                        "tiny fragment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая часть, которая откололась или отделилась от чего-то большего."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "часть целого"
                            },
                            {
                                "target_lang_word": "осколок",
                                "target_lang_sense_clarification": "от твердого предмета"
                            },
                            {
                                "target_lang_word": "обломок",
                                "target_lang_sense_clarification": "от сломанного предмета"
                            },
                            {
                                "target_lang_word": "отрывок",
                                "target_lang_sense_clarification": "о разговоре или тексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcfa16e4-5377-378b-a659-9221770ee7ce",
                    "sense_definition": "An incomplete sentence that lacks either a subject or a main verb.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your essay is good, but you need to fix this sentence <w>fragment</w> to make it grammatically correct.",
                            "target_lang_translations": {
                                "ru": "Ваше эссе хорошее, но вам нужно исправить этот <w>фрагмент предложения</w>, чтобы оно было грамматически правильным."
                            }
                        },
                        {
                            "text": "The phrase because he was tired is a <w>fragment</w> and cannot stand alone as a sentence.",
                            "target_lang_translations": {
                                "ru": "Фраза «потому что он устал» является <w>неполным предложением</w> и не может употребляться самостоятельно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sentence fragment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконченное предложение, в котором отсутствует подлежащее или сказуемое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрагмент предложения",
                                "target_lang_sense_clarification": "грамматическая ошибка"
                            },
                            {
                                "target_lang_word": "неполное предложение",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efa7bfa1-b6e8-3e7c-a092-0663c4d9a53c",
                    "sense_definition": "The part of a web address that follows a hash symbol and points to a specific section of a page.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The URL ends with a <w>fragment</w> identifier that takes the user directly to the contact section.",
                            "target_lang_translations": {
                                "ru": "URL-адрес заканчивается идентификатором <w>фрагмента</w>, который перенаправляет пользователя прямо в раздел контактов."
                            }
                        },
                        {
                            "text": "When you click the link, the browser uses the <w>fragment</w> to scroll down to the correct heading.",
                            "target_lang_translations": {
                                "ru": "Когда вы нажимаете на ссылку, браузер использует <w>фрагмент</w>, чтобы прокрутить страницу до нужного заголовка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fragment identifier"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть веб-адреса, которая следует за символом решетки и указывает на определенный раздел страницы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "идентификатор в URL"
                            },
                            {
                                "target_lang_word": "якорь",
                                "target_lang_sense_clarification": "ссылка на раздел страницы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4db1352e-8767-3f73-b21e-d437cfbbf21d",
                    "sense_definition": "A small, incomplete piece of computer programming code.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shared a code <w>fragment</w> on the forum to show how the function should be implemented.",
                            "target_lang_translations": {
                                "ru": "Он поделился <w>фрагментом</w> кода на форуме, чтобы показать, как должна быть реализована функция."
                            }
                        },
                        {
                            "text": "The developer analyzed the <w>fragment</w> of code to find the source of the error.",
                            "target_lang_translations": {
                                "ru": "Разработчик проанализировал <w>кусок</w> кода, чтобы найти источник ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "snippet"
                    ],
                    "common_phrases": [
                        "code fragment"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой, неполный фрагмент программного кода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрагмент кода",
                                "target_lang_sense_clarification": "часть программы"
                            },
                            {
                                "target_lang_word": "сниппет",
                                "target_lang_sense_clarification": "небольшой кусок кода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1da5caa-8421-3aa2-98cc-9280451b2fd4",
                    "sense_definition": "A piece of an organism that breaks off and grows into a new individual during asexual reproduction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>fragment</w> of the starfish has the potential to regenerate into a complete new animal.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>фрагмент</w> морской звезды способен регенерировать в новое полноценное животное."
                            }
                        },
                        {
                            "text": "The biologist observed how a single <w>fragment</w> of the plant could survive and grow in the lab.",
                            "target_lang_translations": {
                                "ru": "Биолог наблюдал, как один <w>фрагмент</w> растения может выжить и вырасти в лаборатории."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть организма, которая отделяется и вырастает в новую особь при бесполом размножении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "биологический термин"
                            },
                            {
                                "target_lang_word": "часть",
                                "target_lang_sense_clarification": "отделившийся кусок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1c514cd-faa6-326d-9d37-de7d11fb55d7",
                    "sense_definition": "To break or fall apart into many small pieces or separate parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political party began to <w>fragment</w> after the leader resigned and members disagreed on a new direction.",
                            "target_lang_translations": {
                                "ru": "Политическая партия начала <w>распадаться</w> после того, как лидер ушел в отставку, а члены партии не сошлись во мнениях относительно нового курса."
                            }
                        },
                        {
                            "text": "If the glass is hit with enough force, it will <w>fragment</w> into thousands of tiny shards.",
                            "target_lang_translations": {
                                "ru": "Если по стеклу ударить с достаточной силой, оно <w>разлетится</w> на тысячи мелких осколков."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragmentize"
                    ],
                    "common_phrases": [
                        "begin to fragment",
                        "fragment into pieces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбиваться или распадаться на множество мелких кусочков или отдельных частей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрагментироваться",
                                "target_lang_sense_clarification": "распадаться на части"
                            },
                            {
                                "target_lang_word": "раскалываться",
                                "target_lang_sense_clarification": "о группе или предмете"
                            },
                            {
                                "target_lang_word": "разваливаться",
                                "target_lang_sense_clarification": "терять целостность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae844b42-0d00-3c65-b038-35620342ae1b",
                    "sense_definition": "To store a computer file in several different places on a disk rather than in one continuous space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Over time, the hard drive will <w>fragment</w> files, which can significantly slow down the system's performance.",
                            "target_lang_translations": {
                                "ru": "Со временем жесткий диск начнет <w>фрагментировать</w> файлы, что может значительно замедлить работу системы."
                            }
                        },
                        {
                            "text": "The operating system tends to <w>fragment</w> data when the disk is nearly full.",
                            "target_lang_translations": {
                                "ru": "Операционная система склонна <w>фрагментировать</w> данные, когда диск почти заполнен."
                            }
                        }
                    ],
                    "antonyms": [
                        "defragment"
                    ],
                    "common_phrases": [
                        "fragment the disk"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хранить компьютерный файл в нескольких разных местах на диске, а не в одном непрерывном пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрагментировать",
                                "target_lang_sense_clarification": "о данных на диске"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}