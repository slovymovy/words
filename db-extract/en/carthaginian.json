                        "source_entry_id": "e04129cf-3b15-36d3-a0ce-0f5b346fba3b",
                        "source_sense_id": "6d4b7bec-07ba-322d-b538-d68eb27ed40d",
                        "source_sense_description": "person from Carthage",
                        "target_lang_word": "Karthager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karthager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "970ca9e0-8913-3120-ba6e-85e7405522a1",
                                        "entry_id": "07d20a95-5adb-38a3-bd26-e84e29f1b28b",
                                        "glosses": [
                                            "Einwohner Karthagos (männlichen oder unbestimmten Geschlechts)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df050ba8-a242-47f7-8319-11e0327a2fe2",
                                                "sense_id": "970ca9e0-8913-3120-ba6e-85e7405522a1",
                                                "text": "Die Karthager zogen über die Alpen gegen Rom."
                                            },
                                            {
                                                "example_id": "7d646a5e-b1e4-4d2f-8bfc-df1a2668dcf4",
                                                "sense_id": "970ca9e0-8913-3120-ba6e-85e7405522a1",
                                                "text": "„Seine Heimat Epirus war durch die Kelten bedroht, und in Sizilien waren die Karthager wieder einmal dabei, die Griechen zu unterwerfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b39cc05f-61d5-4396-8fb3-0ac78e33d45b",
                        "source_entry_id": "e04129cf-3b15-36d3-a0ce-0f5b346fba3b",
                        "source_sense_id": "6d4b7bec-07ba-322d-b538-d68eb27ed40d",
                        "source_sense_description": "person from Carthage",
                        "target_lang_word": "Karthagerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karthagerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07dd6d1e-3bdb-3406-9d98-19844c5c3347",
                                        "entry_id": "fd1725ec-47a0-3770-8e2f-0124f906bd9b",
                                        "glosses": [
                                            "Einwohnerin Karthagos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9618622-daaa-48d7-9595-3093f62f5a00",
                                                "sense_id": "07dd6d1e-3bdb-3406-9d98-19844c5c3347",
                                                "text": "„In der einfachen Formel unbedingter Gegnerschaft gegen die Römer erfüllt sich somit der Patriotismus der Karthagerin, den sie vor allem als Gattin des Syphax unter Beweis gestellt haben soll.“"
                                            },
                                            {
                                                "example_id": "d514fdbf-07b9-4a2a-b765-40509a953e39",
                                                "sense_id": "07dd6d1e-3bdb-3406-9d98-19844c5c3347",
                                                "text": "„Diese Anklagen verstärkten in Scipio die Einsicht, daß die Karthagerin unter allen Umständen trotz der erfolgten Heirat sofort von Massinissa getrennt werden mußte, da er durch sie einen unheilvollen politischen Einfluß auf ihn voraussah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
