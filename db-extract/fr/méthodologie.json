                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60996969-ff1d-3bb0-b0c3-2a6ae1274711",
                                        "entry_id": "50ec0adb-dcbd-3071-a939-79fd5d386b98",
                                        "glosses": [
                                            "方法についての批判的もしくは体系的な論考・論述。たとえば、教育（学校教育）に関しての「教育方法学」、経営管理に関しての「経営工学」など。"
                                        ],
                                        "tags": [],
