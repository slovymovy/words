{
    "word_family": [
        "zawołać",
        "odwołać",
        "powołać",
        "przywołać",
        "wywołać",
        "nawoływać",
        "wołanie",
        "wołacz"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d867919-496a-3da3-b4db-82f1b2c8cc6e",
                    "sense_definition": "zwracać się do kogoś głośno, aby podszedł lub zwrócił uwagę; wzywać",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kontakt_glosowy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama głośno <w>woła</w> dzieci na obiad z balkonu.",
                            "target_lang_translations": {
                                "en": "Mom is loudly <w>calling</w> the children for dinner from the balcony."
                            }
                        },
                        {
                            "text": "Tyle razy cię <w>wołałem</w>, a ty twierdzisz, że nic nie słyszałaś?",
                            "target_lang_translations": {
                                "en": "I <w>called</w> you so many times, and you claim you didn't hear anything?"
                            }
                        }
                    ],
                    "synonyms": [
                        "wzywać"
                    ],
                    "common_phrases": [
                        "wołać o pomoc",
                        "wołać na obiad",
                        "wołać psa"
                    ],
                    "target_lang_definitions": {
                        "en": "to address someone loudly to approach or draw attention; to summon or call out to"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to summon or attract someone's attention with voice"
                            },
                            {
                                "target_lang_word": "call out",
                                "target_lang_sense_clarification": "to shout to get someone's attention"
                            },
                            {
                                "target_lang_word": "summon",
                                "target_lang_sense_clarification": "to call someone to come"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89981501-84ab-3a9e-b0b8-f5703b8a0fd1",
                    "sense_definition": "mówić coś bardzo głośnym głosem; wykrzykiwać",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kontakt_glosowy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tłum na ulicy zaczął głośno <w>wołać</w> różne hasła.",
                            "target_lang_translations": {
                                "en": "The crowd in the street started <w>shouting</w> various slogans loudly."
                            }
                        },
                        {
                            "text": "Niektórzy śmiali się, ale większość <w>wołała</w>, żeby zszedł ze sceny.",
                            "target_lang_translations": {
                                "en": "Some laughed, but most were <w>yelling</w> for him to get off the stage."
                            }
                        }
                    ],
                    "synonyms": [
                        "krzyczeć"
                    ],
                    "target_lang_definitions": {
                        "en": "to say something in a very loud voice; to shout or exclaim"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shout",
                                "target_lang_sense_clarification": "to utter in a loud voice"
                            },
                            {
                                "target_lang_word": "cry out",
                                "target_lang_sense_clarification": "to exclaim loudly"
                            },
                            {
                                "target_lang_word": "yell",
                                "target_lang_sense_clarification": "to utter a loud cry or words"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51f0f4fd-8f6a-3a14-be12-f71138cd8798",
                    "sense_definition": "zwracać się do kogoś określonym imieniem, przezwiskiem lub przydomkiem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nazywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W podstawówce koledzy <w>wołali</w> na mnie Gałązka.",
                            "target_lang_translations": {
                                "en": "In primary school, my classmates <w>called</w> me Twig."
                            }
                        },
                        {
                            "text": "Wszyscy znajomi z osiedla <w>wołają</w> na niego Kuba, choć ma na imię Jakub.",
                            "target_lang_translations": {
                                "en": "All his friends from the neighborhood <w>call</w> him Kuba, even though his name is Jakub."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wołać na kogoś"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w odniesieniu do przezwisk"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to address someone by a particular name, nickname, or moniker"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to name or refer to someone by a name or nickname"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1236e0ba-fe52-3a6a-8c25-a4766ffcc30e",
                    "sense_definition": "żądać określonej sumy pieniędzy jako zapłaty za towar lub usługę",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mechanik <w>woła</w> zbyt dużo za naprawę starego samochodu.",
                            "target_lang_translations": {
                                "en": "The mechanic is <w>asking for</w> too much to repair that old car."
                            }
                        },
                        {
                            "text": "Oni <w>wołają</w> dwieście złotych za samą wymianę opon.",
                            "target_lang_translations": {
                                "en": "They are <w>charging</w> two hundred zlotys just to change the tires."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wołać za usługę"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie żądania ceny"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to demand a specific sum of money as payment for goods or services"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ask for",
                                "target_lang_sense_clarification": "to demand a particular price"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to ask an amount as a fee or price"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}