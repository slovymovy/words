                    {
                        "sense_id": "a34e6e61-d2e1-3f10-9ba8-50a150e1a475",
                        "entry_id": "723b2d3b-91de-3de0-b36f-3380ae42e626",
                        "glosses": [
                            "Teilchen, das auf der Nase aufliegt und für den Halt der Brille sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1116ee-6d1b-4cfd-85da-4ccfcb6190cf",
                                "sense_id": "a34e6e61-d2e1-3f10-9ba8-50a150e1a475",
                                "text": "„An den Stegplättchen hatte sich Schweiß gesammelt, der brannte auf der Haut.“"
                            },
                            {
                                "example_id": "d36420fa-4e5f-4d58-880e-ff39027c3d2c",
                                "sense_id": "a34e6e61-d2e1-3f10-9ba8-50a150e1a475",
                                "text": "„Manche Brillen verfügen zusätzlich über Stegplättchen, welche entsprechend der jeweiligen Nasenform angepasst werden können.“"
                            },
                            {
                                "example_id": "53774e1d-a74a-47d2-80c5-80340ad59026",
                                "sense_id": "a34e6e61-d2e1-3f10-9ba8-50a150e1a475",
                                "text": "„Seine Brille hat keine Bügel, sondern hält nur dank des Drucks der Stegplättchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
