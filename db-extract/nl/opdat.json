                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ab93d5-6c62-402f-a6dc-30954181e491",
                                "sense_id": "73c98e41-17ae-34e9-a062-ac82f23c3fb2",
                                "text": "Ik leer mijn lessen opdat ik het examen haal."
                            },
                            {
                                "example_id": "c6eb31ba-1d60-4457-a3dd-848031925f56",
                                "sense_id": "73c98e41-17ae-34e9-a062-ac82f23c3fb2",
                                "text": "Opdat ik het examen haal leer ik mijn lessen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90ddb515-78ed-432c-bfc0-47ba63318266",
                        "source_entry_id": "92786e16-85b6-3f50-bcf0-2bb48a326aa4",
                        "source_sense_id": "73c98e41-17ae-34e9-a062-ac82f23c3fb2",
                        "target_lang_word": "damit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
