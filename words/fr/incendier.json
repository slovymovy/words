                },
                {
                    "sense_id": "42e620ea-af5e-30f0-9485-13897168f4fe",
                    "sense_definition": "Teinter ou illuminer d'une couleur rouge et éclatante pareille à celle d'un feu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil couchant <w>incendia</w> l'horizon d'une splendide lumière pourpre."
