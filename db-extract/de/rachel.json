                                    },
                                    {
                                        "sense_id": "744d0c1d-0a3c-34aa-a24d-56dc110aaf10",
                                        "entry_id": "5b1454c4-ac6c-3104-a45f-82c2723ce814",
                                        "glosses": [
                                            "Dame de carreau dans un jeu de cartes traditionnel."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b83bc447-37d0-3dea-ad7b-02e400f545f5",
                                        "entry_id": "5b1454c4-ac6c-3104-a45f-82c2723ce814",
                                        "glosses": [
                                            "Nom de scène de la célèbre tragédienne Élisabeth-Rachel Félix (1821-1858), née en Suisse de parents juifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7888057-903c-4d27-a6f1-0895043393e9",
                                                "sense_id": "b83bc447-37d0-3dea-ad7b-02e400f545f5",
                                                "text": "— Avez-vous vu l’Israélite ? Comment a-t-elle marché ce soir ?\nL’Israélite, c’était la grande tragédienne Rachel, alors au plus beau moment de sa gloire.\n— Elle va de plus en plus mal, dit le professeur en haussant les épaules… Cette fille n’a rien… C’est une grue, une vraie grue.\n— Une vraie grue, ajouta l’élève, et derrière elle les deux autres répétèrent avec conviction : « Une vraie grue… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d054d4-8ed7-31cc-9fce-6391057abf3d",
                                        "entry_id": "5b1454c4-ac6c-3104-a45f-82c2723ce814",
                                        "glosses": [
                                            "Coupe de cheveux féminine en dégradé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Rachel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "330d91ba-7408-3539-b32e-021754f56f2d",
                                        "entry_id": "a53057aa-24ab-35e8-a699-da5b491fceee",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c8ed578-495d-4ccc-bd8b-8b0f9d46ac40",
                                                "sense_id": "330d91ba-7408-3539-b32e-021754f56f2d",
                                                "text": "Il souffle très doucement pour se désagacer, mais il ne voudrait pas humilier Rachel."
                                            },
                                            {
                                                "example_id": "cafbfb66-4e9e-4153-bba1-1fa2d0265ae5",
                                                "sense_id": "330d91ba-7408-3539-b32e-021754f56f2d",
                                                "text": "Cette nuit, Rachel Bachelard n’a trouvé le sommeil qu’après avoir avalé un comprimé entier d’Halcion."
