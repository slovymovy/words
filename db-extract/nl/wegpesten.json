                                                "sense_id": "11003907-cee8-3e5e-b943-923a87418e31",
                                                "text": "Bully, she's finally asked for that promotion!"
                                            },
                                            {
                                                "example_id": "b8789f06-3681-4715-aab4-ca69f1b087ba",
                                                "sense_id": "11003907-cee8-3e5e-b943-923a87418e31",
                                                "text": "Bully! Bully! Finis coronet opus, “the end crowns all”; “may the last be the best!” By Godfrey it was delightful."
                                            }
                                        ]
                                    }
                                ]
                            }
