                "senses": [
                    {
                        "sense_id": "0fb5158e-6859-3487-b445-8104538cecd7",
                        "entry_id": "d5f29357-7287-355e-a1ec-b8e54ef99571",
                        "glosses": [
                            "Celui qui apprête les peaux principalement d’ovins et de caprins à l’exclusion des grosses peaux de bovins dont s’occupent les tanneurs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bcd366f0-35a0-4a0c-bf63-c0f292c9caef",
                                "sense_id": "0fb5158e-6859-3487-b445-8104538cecd7",
                                "text": "Les cinq métiers de la bonne ville de Paris sont les tanneurs, les mégissiers, les baudroyeurs, les boursiers et les sueurs."
                            },
                            {
                                "example_id": "14d9c5ee-1a8d-49c7-80ff-1a5a8e17a134",
                                "sense_id": "0fb5158e-6859-3487-b445-8104538cecd7",
                                "text": "Il faut mentionner cependant que toutes ces espèces de laines sont souvent confondues sous le nom collectif de laines de tanneur, parce que toutes elles sont également livrées au commerce par les chamoiseurs et les mégissiers."
                            },
                            {
                                "example_id": "3e80dc25-764f-43e1-8f10-30244acbfa44",
                                "sense_id": "0fb5158e-6859-3487-b445-8104538cecd7",
                                "text": "Certains moralistes, à la police et chez certains journalistes, reprocheront plus tard à Vidock d’avoir donné les informations qui aboutirent à l’arrestation du mégissier."
                            }
                        ]
                    }
                ],
