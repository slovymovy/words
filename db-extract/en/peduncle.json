    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                "word": "peduncle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a879255f-f6db-49b9-b7da-42a6d329fb9f",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "tags": [
                            "plural"
                        ],
                        "form": "peduncles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "138b47dc-1dbd-3c92-9a9e-ae88bf3775d4",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "glosses": [
                            "The stalk supporting an inflorescence or a solitary flower/fruit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "40313b60-f696-315d-9d5d-e483f56a53b0",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "glosses": [
                            "A short stalk at the base of a reproductive structure of a non-flowering plant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efb9cb4-cfff-474a-b6a9-25f16aa2bdb9",
                                "sense_id": "40313b60-f696-315d-9d5d-e483f56a53b0",
                                "text": "On fertilization, the archegonia form obyriform calyptrae that are distinctly narrowed at base to form a stalk or peduncle; this does not occur in other Hepaticae."
                            }
                        ]
                    },
                    {
                        "sense_id": "75d7385b-99b1-340c-8357-22b05e6a50e0",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "glosses": [
                            "A bundle of neurons connecting different parts of the brain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bac52eac-08e5-39b9-aa5c-a6a332bc987e",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "glosses": [
                            "In arthropods, the base segments of an antenna or stalk-like structures such as the peduncles of some barnacles"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3302c53f-9753-30cf-ad61-eab898f37f8a",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "glosses": [
                            "In vertebrates, the base of any relatively massive anatomical member connected to the body by a narrower section. Cf. caudal peduncle of fishes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a7fd58f7-37b8-3f4b-8a09-26220cf42f7a",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "glosses": [
                            "A stem attaching a mass of tissue (such as a polyp) to the body."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "307bd5b9-e286-31fe-aece-ef7eff409602",
                        "entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "glosses": [
                            "A collection of nerves in the appendage of an animal (such as the tip of a dolphin's tail)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "212a85f8-cd13-4251-9bd6-ce9f35165e8c",
                        "source_entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
                        "source_sense_description": "botany: axis or supporting stalk of inflorescence",
                        "target_lang_word": "pédoncule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pédoncule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17ee99be-5bc2-37a4-821b-a541545268ec",
                                        "entry_id": "d9e517bf-af8d-3f87-945d-d2ab87c2a76e",
                                        "glosses": [
                                            "Tige (ou queue) d’une fleur (et donc, après fécondation, d’un fruit), distincte de la tige de la plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf13f5c9-959f-496d-a4af-13c7292fdc46",
                                                "sense_id": "17ee99be-5bc2-37a4-821b-a541545268ec",
                                                "text": "Leur pédoncule vert et frisé est vraiment bien réussi."
                                            },
                                            {
                                                "example_id": "65ccd623-aba1-4c29-8b87-8515786b35c7",
                                                "sense_id": "17ee99be-5bc2-37a4-821b-a541545268ec",
                                                "text": "Sur 382 variétés observées pendant trois ans, seulement six variétés rouges et deux variétés blanches présentent une très bonne aptitude à la récolte sans pédoncule. […] Il est à noter que jusqu’à présent aucune variété rouge précoce n’est susceptible d’être récoltée sans pédoncule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                        "entry_id": "d9e517bf-af8d-3f87-945d-d2ab87c2a76e",
                                        "glosses": [
                                            "Support d’une partie quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a1a7f8-3e18-4481-a2f9-67f9e3f8444c",
                                                "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                                "text": "À l’aide du sous-marin de recherche Johnson Sea Link, des spécimens de la pentacrine Neocrinus decorus vivant au large des Bahamas par 420 m de profondeur ont été marqués, replacés puis récupérés 250 jours plus tard. La vitesse moyenne de croissance en longueur du pédoncule est de 10,8 cm/a avec une valeur maximum de 14,3 cm/a."
                                            },
                                            {
                                                "example_id": "ef175eaa-a01a-4fc2-9502-c1d951cb9136",
                                                "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                                "text": "Pédoncules cérébraux, prolongements de la moelle allongée."
                                            },
                                            {
                                                "example_id": "5483ea21-2947-41d0-b70c-1c8be5f9cfff",
                                                "sense_id": "ad983574-9199-32d1-88fa-a03caf13acd1",
                                                "text": "Pédoncules cérébelleux, cordons qui relient le cervelet au cerveau et concourent à la formation des pédoncules cérébraux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8db8664-8579-4668-8b4d-363e39c6a3ba",
                        "source_entry_id": "5f68493c-0707-355b-ae7e-eb53de66725d",
