                                            {
                                                "example_id": "8f3fe3d1-7d5d-489c-8cf9-dcb5167b715c",
                                                "sense_id": "0beb9351-b623-38d2-89df-2bca9673bf6d",
                                                "text": "Der Verrat wurde bestraft."
                                            },
                                            {
                                                "example_id": "772e8100-0c28-497a-9e6d-7ea9bc654c97",
                                                "sense_id": "0beb9351-b623-38d2-89df-2bca9673bf6d",
                                                "text": "„Trump hetzt gegen Justizminister Jeff Sessions, einen bislang treuen Vasallen und beinharten Konservativen, nur weil der getan hat, was Recht und Gesetz von ihm verlangen: Trump sieht gerade in der Rechtstreue seines Justizministers den Verrat.“"
                                            },
                                            {
                                                "example_id": "d638d922-db5d-43dd-b594-de13155ebb4d",
                                                "sense_id": "0beb9351-b623-38d2-89df-2bca9673bf6d",
                                                "text": "„Sie konnte eigentlich nur für ihn kochen, ohne dauernd an mich denken zu müssen, denn das hat sie so selten für mich getan, daß es nicht unbedingt Verrat oder Hurerei sein würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
