                        "glosses": [
                            "Celui qui dévalise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45f6246-47cd-40e8-b4cc-6049139651c1",
                                "sense_id": "75d2dbb7-8fa0-3348-809e-8b5d96539480",
                                "text": "Il a crié le premier au voleur, comme Arlequin dévaliseur de maisons."
                            },
                            {
                                "example_id": "a5b836ea-d89d-4fe4-abc4-550ac379a0f7",
                                "sense_id": "75d2dbb7-8fa0-3348-809e-8b5d96539480",
                                "text": "M. Goron, ancien chef de la Sûreté, consacre dans ses mémoires un chapitre aux dévaliseurs de villas, métier peu honorable, mais lucratif et très répandu dans les environs de Paris."
                            },
                            {
                                "example_id": "cfacb755-5b07-49ac-b928-c53b4c9fa540",
                                "sense_id": "75d2dbb7-8fa0-3348-809e-8b5d96539480",
                                "text": "Cette petite pièce à conviction où figurait l’adresse de son fournisseur, Lafcadio, après tout, était fort reconnaissant à son dévaliseur de l’avoir soustraite à la police."
                            }
                        ]
                    }
