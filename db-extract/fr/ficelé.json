                        "entry_id": "8958489d-66b3-39ce-93e3-2465896d3b29",
                        "glosses": [
                            "Qui a été ficelé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "638cd0a6-4f37-4269-8ba5-6906885248b1",
                                "sense_id": "dea8d998-a109-3272-883b-32465a521039",
                                "text": "Il a reçu un paquet ficelé."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8daba1e-3d83-32fc-a0a2-dd039543e99b",
                        "entry_id": "8958489d-66b3-39ce-93e3-2465896d3b29",
                        "glosses": [
                            "Qui est plutôt mal habillé."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "220cb9c9-c760-4c64-b71f-5194d176e874",
                                "sense_id": "f8daba1e-3d83-32fc-a0a2-dd039543e99b",
                                "text": "Comme te voilà ficelé !"
                            },
                            {
                                "example_id": "c45aefc4-877a-41e6-8fd0-cc09a8b469ed",
                                "sense_id": "f8daba1e-3d83-32fc-a0a2-dd039543e99b",
                                "text": "Il est mal ficelé."
                            },
                            {
                                "example_id": "8f3a2d0c-ab4f-4a27-b61a-ba9bcf8b539c",
                                "sense_id": "f8daba1e-3d83-32fc-a0a2-dd039543e99b",
                                "text": "« Jusqu’à l’église, précisa Maria, tout bas. Ficelés comme on l’est, nous ne pourrions pas entrer. Mais ça suffira pour marquer le coup. Reboutonne ton col… »"
                            }
                        ]
                    },
                    {
                        "sense_id": "f414b734-d5e2-3c6c-b7eb-671dc3fc94f2",
                        "entry_id": "8958489d-66b3-39ce-93e3-2465896d3b29",
                        "glosses": [
                            "Se dit d’une histoire qui est complète et sans erreur même dans les détails."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8f19f5d1-9968-4704-a501-f62e031a8f0a",
                                "sense_id": "f414b734-d5e2-3c6c-b7eb-671dc3fc94f2",
                                "text": "L’escroquerie était bien ficelée et des centaines de Français y ont perdu leurs économies."
                            },
                            {
                                "example_id": "8ff8617a-b94a-4ce3-a04b-c283fe9b2877",
                                "sense_id": "f414b734-d5e2-3c6c-b7eb-671dc3fc94f2",
                                "text": "C’est très important, la bonne présentation. L’objectif est qu’on ne puisse pas vous dire non. Si la présentation est bien ficelée, c’est très difficile pour le client de dire qu’il n’est pas d’accord avec les conclusions."
                            }
                        ]
                    },
                    {
                        "sense_id": "46d10b6b-2247-39f2-b347-3f6bb673406e",
                        "entry_id": "8958489d-66b3-39ce-93e3-2465896d3b29",
                        "glosses": [
                            "Lié, ligoté."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "936244a9-b119-44e2-83df-45f8b83a6227",
                                "sense_id": "46d10b6b-2247-39f2-b347-3f6bb673406e",
                                "text": "Du Bruel était étourdi du déploiement de cette ruse à la Maintenon, et il admirait cette femme sans faire un seul retour sur lui-même, il était déjà si bien ficelé qu’il ne sentait plus la ficelle."
                            }
                        ]
                    }
