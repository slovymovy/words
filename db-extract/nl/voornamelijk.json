                                    {
                                        "sense_id": "8f036141-68eb-37c2-9fe8-6b6edfcf8f3a",
                                        "entry_id": "0c093c9e-5274-3fcc-be63-c454303c6045",
                                        "glosses": [
                                            "besonders; vor allem"
                                        ],
