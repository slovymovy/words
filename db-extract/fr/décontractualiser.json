                "senses": [
                    {
                        "sense_id": "7a1ad38d-6196-33ea-8cc2-f2e4cb5ddf56",
                        "entry_id": "62235041-8808-3689-9161-d7b04f696056",
                        "glosses": [
                            "Faire perdre son caractère contractuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a2a99eb-6289-4cb7-ae2e-122215fbbe1e",
                                "sense_id": "7a1ad38d-6196-33ea-8cc2-f2e4cb5ddf56",
                                "text": "Certes, la stipulation d’une telle clause présente l’intérêt pour l’employeur de « décontractualiser » le lieu de travail en tant que situé dans un secteur géographique."
                            },
                            {
                                "example_id": "f7608331-784c-400d-990e-e85e1adbb7a3",
                                "sense_id": "7a1ad38d-6196-33ea-8cc2-f2e4cb5ddf56",
                                "text": "En pure logique, à force d’insister sur la condition d’équité et de prôner un retour à une conception originelle de l’article 1135, ne faudrait-il pas décontractualiser totalement la sécurité ?"
                            }
                        ]
                    }
