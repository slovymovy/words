                                                "sense_id": "8038e67b-17f3-3d80-8e24-167dceb6dc82",
                                                "text": "an organ loft"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af9c79e1-47ea-33d7-874a-61b5bc2a7879",
                                        "entry_id": "bd46b87f-ed6b-33bf-a03e-adeed8939b3b",
                                        "glosses": [
                                            "A residential flat (apartment) on an upper floor of an apartment building."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b7797b-78c9-4582-8365-6d16b40e23da",
                                                "sense_id": "af9c79e1-47ea-33d7-874a-61b5bc2a7879",
                                                "text": "a Manhattan loft"
                                            },
                                            {
                                                "example_id": "ebc740e5-769c-41b7-88f4-4632b2c58c2b",
                                                "sense_id": "af9c79e1-47ea-33d7-874a-61b5bc2a7879",
                                                "text": "Today, with a loft in Manhattan and a condo in Century City, they are the epitome of the bi-coastal couple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c07e5ce1-0be1-3769-a33c-2ab73c9034c0",
                                        "entry_id": "bd46b87f-ed6b-33bf-a03e-adeed8939b3b",
                                        "glosses": [
                                            "Ellipsis of pigeon loft."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f35c07-d172-4b92-b49b-1ae9adac2290",
                                                "sense_id": "c07e5ce1-0be1-3769-a33c-2ab73c9034c0",
                                                "text": "Releasing some of the 12,000 racing pigeons that had arrived by special train (in foreground) at Dumfries Station for a race to their home lofts in Lanarkshire and West Lothian"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74bda31f-47f1-3e1d-86e1-11bdaafdd2da",
                                        "entry_id": "bd46b87f-ed6b-33bf-a03e-adeed8939b3b",
                                        "glosses": [
                                            "The pitch or slope of the face of a golf club (tending to drive the ball upward)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7736c928-e7a0-36d5-921b-9ba11712a702",
                                        "entry_id": "bd46b87f-ed6b-33bf-a03e-adeed8939b3b",
                                        "glosses": [
                                            "A lofted drive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aab4269d-e208-3745-b1e5-7efd627d7074",
                                        "entry_id": "bd46b87f-ed6b-33bf-a03e-adeed8939b3b",
                                        "glosses": [
                                            "A floor or room placed above another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a1c1e4-808e-4c3d-b79b-de31d67482fe",
                                                "sense_id": "aab4269d-e208-3745-b1e5-7efd627d7074",
                                                "text": "Eutychus […] fell down from the third loft."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afe8010-64c1-3588-8a99-8445be802f7d",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To propel high into the air."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f114a4-4a66-4a0e-a9bc-df923b560ce6",
                                                "sense_id": "6afe8010-64c1-3588-8a99-8445be802f7d",
                                                "text": "Marouane Chamakh then spurned a great chance to kill the game off when he ran onto Andrey Arshavin's lofted through ball but shanked his shot horribly across the face of goal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7361251-91e7-3ccd-85ab-c42c04423aa9",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To fly or travel through the air, as though propelled"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddea5da4-baa2-4176-b256-4daacc9406e2",
                                                "sense_id": "f7361251-91e7-3ccd-85ab-c42c04423aa9",
                                                "text": "When she saw houses lofting past her window, she ran to the child, who slept on a feather bed and she gathered the coverlet around them both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de6e54f6-954e-302a-b69b-1f16db24b419",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To throw the ball erroneously through the air instead of releasing it on the lane's surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a609939-73d2-3643-9b24-e3fb09695c7e",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To furnish with a loft space."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c21f2a1-8176-425a-9753-4c721bf4f271",
                                                "sense_id": "0a609939-73d2-3643-9b24-e3fb09695c7e",
                                                "text": "Two sisters, one under fifteen years of age, have lofted the house, so as to have a room for themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b84f67-1a31-32f5-8f5b-ee62f95be84b",
                                        "entry_id": "a2d7e446-c371-3251-9196-063c1e939cef",
                                        "glosses": [
                                            "To raise (a bed) on tall supports so that the space beneath can be used for something else."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df0f56f-14ce-45be-a2e4-035b0c73cc01",
                                                "sense_id": "53b84f67-1a31-32f5-8f5b-ee62f95be84b",
                                                "text": "Lofting a bed is much harder work than it seems, and pulling a nail out with the back of a hammer is much simpler than using your own nails."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5424f34b-0c13-3977-9a11-4218b26bc411",
                                        "entry_id": "0ac91b2d-e5cf-3b63-888f-4d91c18aa624",
                                        "glosses": [
                                            "lofty; proud; haughty"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b79755a-6b9a-4fda-957b-5b0b5e43d504",
                                                "sense_id": "5424f34b-0c13-3977-9a11-4218b26bc411",
                                                "text": "A heart, where dread was never so imprest\nTo hide the thought that might the truth advance;\nIn neither fortune loft, nor yet represt"
                                            }
