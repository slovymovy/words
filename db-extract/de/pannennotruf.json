                "senses": [
                    {
                        "sense_id": "d16b9995-f740-35c9-9c7b-4a6513a505fb",
                        "entry_id": "0883d1b5-a803-3d85-90c1-68c5d7960059",
                        "glosses": [
                            "Telefonnummer, die im Falle eines technischen Schadens am Fahrzeug angerufen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5eae5ee-68c6-46ec-bd2e-5980c5ea12b5",
                                "sense_id": "d16b9995-f740-35c9-9c7b-4a6513a505fb",
                                "text": "„Der ADAC bestätigte den Pannennotruf und die Pannenhilfe und auf dem Überwachungsvideo der Tankstelle sah man Peter im neongelben Trikot mit seinem Bike an der Luftsäule.“"
                            },
                            {
                                "example_id": "9a8e4c34-24c2-40d3-bc5a-7561c80f0a41",
                                "sense_id": "d16b9995-f740-35c9-9c7b-4a6513a505fb",
                                "text": "„Mit Connect hat man nicht nur ein Navigationssystem, eine Freisprechanlage oder einen Pannennotruf.“"
                            },
                            {
                                "example_id": "724e0371-8f90-469d-937e-ced0857b235d",
                                "sense_id": "d16b9995-f740-35c9-9c7b-4a6513a505fb",
                                "text": "„Schlimmer noch, auch der im Auto integrierte Pannennotruf eCall fällt aus, der ab 2018 in der Europäischen Union für alle Neuwagen vorgeschrieben ist, heute aber schon vielfach eingebaut wird.“"
                            },
                            {
                                "example_id": "363dc097-0761-44e2-a6f1-e483efda9617",
                                "sense_id": "d16b9995-f740-35c9-9c7b-4a6513a505fb",
                                "text": "„Neben BMW-Online gibt es zweitens die klassischen Telematikdienste, die in allen Modellen verfügbar sind, wie zum Beispiel Pannennotruf oder Verkehrsinformation.“"
                            },
                            {
                                "example_id": "83c84736-d405-400c-b261-c58aab8077f3",
                                "sense_id": "d16b9995-f740-35c9-9c7b-4a6513a505fb",
                                "text": "„Bis Mitte der achtziger Jahre wird der Pannennotruf bundesweit vereinheitlicht die Nummer 120 ist seither ohne Vorwahl erreichbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
