                "senses": [
                    {
                        "sense_id": "1db3e4d1-d61a-3e00-a389-d1058b4c0ce3",
                        "entry_id": "ae1fc169-7391-37c3-ba55-143936941ba4",
                        "glosses": [
                            "einem Falken ähnelnd, an einen Falken erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b87e26fb-86c1-4e96-8208-a5933e1ef58d",
                                "sense_id": "1db3e4d1-d61a-3e00-a389-d1058b4c0ce3",
                                "text": "„Er hatte ein rundes, flaches Gesicht mit buschigen Augenbrauen, die über seiner falkenartigen Nase zusammengewachsen waren, und sah ziemlich einschüchternd aus.“"
                            },
                            {
                                "example_id": "17f50e2b-6c02-41a8-abdd-a9f11168986e",
                                "sense_id": "1db3e4d1-d61a-3e00-a389-d1058b4c0ce3",
                                "text": "„Auf dem Podium saß Yotai Yun - schlank, boshaft, falkenartig - und neben ihm hockte eine große Gestalt mit schwarzem Umhang, deren Gesicht unter einer schwarzen Maske verborgen war - der Vermummte Lama!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
