                        "entry_id": "e658cb92-2d67-3b89-9462-2b6644f72676",
                        "glosses": [
                            "Qui n’est pas inflammable."
                        ],
                        "tags": [
                            "Lutte contre l’incendie"
                        ],
                        "examples": [
                            {
                                "example_id": "6dd81a27-035a-4b14-a0fe-57523dedfb57",
                                "sense_id": "2111f83f-cb5f-3ca3-869f-7858b80dd2d7",
                                "text": "Gaz ininflammable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbb74942-1925-42c5-89c1-09c229e5fadc",
                        "source_entry_id": "e658cb92-2d67-3b89-9462-2b6644f72676",
                        "source_sense_id": "2111f83f-cb5f-3ca3-869f-7858b80dd2d7",
                        "target_lang_word": "brennbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brennbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3a1d324-a2f3-357e-ae0a-21670ebdc7d9",
                                        "entry_id": "ca0d93b6-9029-3241-80d9-0e1c4ac6f266",
                                        "glosses": [
                                            "in der Lage, zu brennen, zu verbrennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ed42ba-3961-441c-a2cc-3fa38170ce86",
                                                "sense_id": "b3a1d324-a2f3-357e-ae0a-21670ebdc7d9",
                                                "text": "Die Lagerung von brennbaren Flüssigkeiten ist untersagt."
                                            },
                                            {
                                                "example_id": "647af136-b351-4c80-9724-17872de785d0",
                                                "sense_id": "b3a1d324-a2f3-357e-ae0a-21670ebdc7d9",
                                                "text": "Diese Flüssigkeit ist brennbar."
                                            },
                                            {
                                                "example_id": "ed7045dc-c252-44ec-8ef1-136eb78279fb",
                                                "sense_id": "b3a1d324-a2f3-357e-ae0a-21670ebdc7d9",
                                                "text": "„Bei den brennbaren Stoffen kann es sich um feste, um flüssige oder auch um gasförmige Stoffe handeln.“"
                                            },
                                            {
                                                "example_id": "8bd88c77-e557-44e5-b6cc-914acdcd80b1",
                                                "sense_id": "b3a1d324-a2f3-357e-ae0a-21670ebdc7d9",
                                                "text": "Die Hölzer, die einst das Zundermehl hauptsächlich geliefert haben, dürften wir wohl in denen wiedererkennen, die später zum Feuerreiben dienten; denn natürlich sind die Hölzer, die sich durch Reiben am besten entzünden, auch die, die das brennbarste Mehl geben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7b146f4-45ef-4162-8091-28ddef33ef15",
                        "source_entry_id": "e658cb92-2d67-3b89-9462-2b6644f72676",
                        "source_sense_id": "2111f83f-cb5f-3ca3-869f-7858b80dd2d7",
                        "target_lang_word": "feuerfest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuerfest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                        "entry_id": "85603fa7-8300-30bc-aee8-2a3901f2d0ea",
                                        "glosses": [
                                            "unempfindlich gegen die Auswirkungen von Feuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d12767c-d786-4520-9875-ef8f623adc69",
                                                "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                                "text": "Die wichtigen Firmenunterlagen werden in einem feuerfesten Tresor aufbewahrt."
                                            },
                                            {
                                                "example_id": "a7d671a4-ff15-4cbd-906d-54d12b3e8a73",
                                                "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                                "text": "„Feuerfest und wärmedämmend, hitze- und säurebeständig sind diese mineralischen Fasern – für die Anwendung in Bauten und Anlagen ideale Eigenschaften.“"
                                            },
                                            {
                                                "example_id": "b314da0b-b10e-4aad-8b25-91dc97144935",
                                                "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                                "text": "„Über ihm, in dem Haus, zu dem der Pool gehört, ist Licht angegangen, und Kinder sehen aus ihren Schlafzimmerfenstern zu ihm herunter, warm und kuschelig in ihren Li'l Crips und Ninja-Krieger-Pyjamas, die entweder feuerfest oder nichtkrebserzeugend sein können, aber nicht beides zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
