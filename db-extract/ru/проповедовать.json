                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69159724-5dd4-46a5-964d-c7aac67418c2",
                                                "sense_id": "4292475a-14e3-38ff-a52b-b548814e5ecd",
                                                "text": "– If you can't do the time, don't do the crime! – Preach!"
                                            }
