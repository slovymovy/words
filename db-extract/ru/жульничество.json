                ],
                "translations": [
                    {
                        "translation_id": "a4c51578-bc8a-48a4-ba01-d0c71677a878",
                        "source_entry_id": "3a9fbc6a-af3d-3be0-8254-fd48dccc6965",
                        "source_sense_id": "87a04c33-5f2b-36d7-8255-7b45ef2b5d16",
                        "target_lang_word": "deception",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deception",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                        "entry_id": "dafe6e5e-a27d-33ab-aaf3-e955869b0cf6",
                                        "glosses": [
                                            "An instance of actions and/or schemes fabricated to mislead someone into believing a lie or inaccuracy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e1d366-1671-475e-9170-c91f7566a822",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "deliberate deception"
                                            },
                                            {
                                                "example_id": "c877aa76-05a8-4741-af58-08112bc2957e",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "pure deception"
                                            },
                                            {
                                                "example_id": "523e19ef-db91-4db2-8eb1-cf70f8a023c3",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "She got the money out of the tourist by deception."
                                            },
                                            {
                                                "example_id": "ba2a2921-7c30-4b0a-b4b4-944657f0db8d",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "The Priest also places a moral barrier between himself and his tale by establishing himself as an \"unreliable narrator\" capable of deception and irony. Thus, through his habit of speaking equivocally, he can disavow responsibility for his frequently provocative words."
                                            },
                                            {
                                                "example_id": "15c80ffe-2fac-4e76-9901-67fcf1db70c7",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "Reports related to Trump’s second impeachment very well reflect the Trumpology of the last four years – lie as much as you find tolerable (and the tolerance levels have been moved out extensively), and cover the truth with more lies and deception.[…]Lies, deceit and corruption – the core of Trumpology."
                                            },
                                            {
                                                "example_id": "3514c310-f1ef-4f40-bebe-7dea4b96905c",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "The movie delivers a critical and analytical 'unfolding of the circumstances of Reality [Winner]’s life, starting with her childhood in Texas, in order to reveal her sense of deceptions and injustices that pass largely unchallenged in everyday American life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a5d280a-842a-492c-9cbc-5cc57cb71e9b",
                        "source_entry_id": "3a9fbc6a-af3d-3be0-8254-fd48dccc6965",
                        "source_sense_id": "87a04c33-5f2b-36d7-8255-7b45ef2b5d16",
                        "target_lang_word": "Gaunerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaunerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                        "entry_id": "41911532-5c27-3834-b25c-42ec54d76ef7",
                                        "glosses": [
                                            "eine von einem Gauner begangene Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f39bc618-0063-4495-9d47-2c5c26e33004",
                                                "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                                "text": "Es ist schon eine Gaunerei mit den Öl- und Gas-Preisen."
                                            },
                                            {
                                                "example_id": "48994829-71c7-47db-9ec8-a5ebfd758754",
                                                "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                                "text": "„Außer in solchen Gaunereien, auf die er sich viel zugute tat, besaß er eine umfassende Erfahrung in Dingen, wie sie die Stubenmädchen treiben oder wie sie in schlecht beleuchteten Hinterzimmern von kleinen Stundenhotels vor sich gehen.“"
                                            },
                                            {
                                                "example_id": "6107acb5-90a4-44fc-9747-98c2881fcfe5",
                                                "sense_id": "e9af95c4-56d3-394b-baa0-994da3100342",
                                                "text": "„Ein kluger Spieler kann das eine wie das andere tun, ohne sich dem Vorwurf der Gaunerei auszusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da0edeb6-e58c-4bed-b124-4db552888137",
                        "source_entry_id": "3a9fbc6a-af3d-3be0-8254-fd48dccc6965",
                        "source_sense_id": "87a04c33-5f2b-36d7-8255-7b45ef2b5d16",
                        "target_lang_word": "Schwindel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwindel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                        "entry_id": "865ef420-4556-3cb0-b619-24d71527cd05",
                                        "glosses": [
                                            "Beeinträchtigung des Gleichgewichtssinns; Gefühl zu taumeln, wanken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "767a31c5-b4e3-43ff-95ee-4ec80fc965ee",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Mich überkam plötzlich ein heftiger Schwindel."
                                            },
                                            {
                                                "example_id": "8da3155c-8469-4ae8-a932-00afce640590",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "„Er versuchte aufzustehen, aber Schwindel und Schüttelfrost vereitelten seinen Plan.“"
                                            },
                                            {
                                                "example_id": "0d6b2d02-17ba-4402-aae1-4057126befe7",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Der 65-jährige Finanzminister Rapanos klagte über Schwindel und Schweißausbrüche und wurde wegen eines Ohnmachtsanfalls zur Beobachtung in eine Privatklinik eingewiesen."
                                            },
                                            {
                                                "example_id": "d7034c1b-0dfc-49fe-8db5-f5ddeadad0aa",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Anna S. ist niedergeschlagen, antriebslos. Sie hat Schlafstörungen, leidet unter Schwindel und Kopfschmerzen."
                                            },
                                            {
                                                "example_id": "e1924b17-6b01-4809-8a62-64ceadb409b0",
                                                "sense_id": "3a7c9552-e81f-36aa-ae38-013fb64ed8a3",
                                                "text": "Alles dreht sich, der Boden schwankt: Schwindel! Jeder kennt es vom Karussellfahren. Doch da geht das Gefühl zum Glück schnell vorüber. Aber was tun, wenn der Schwindel zur Qual wird?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                        "entry_id": "865ef420-4556-3cb0-b619-24d71527cd05",
                                        "glosses": [
                                            "(nicht sehr schwerwiegende) unwahre Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0ba11d-82d1-4a93-a0d6-006644b030fd",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "Alles, was die machen, ist ein einziger Schwindel."
                                            },
                                            {
                                                "example_id": "4a17aa7f-f143-400c-b9b9-6b15d2d1347f",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "Da er [Professor Harald Lesch] auch Schwindel und Irrtümer in den Naturwissenschaften aufklärt, hat er sich nicht nur Freunde gemacht."
                                            },
                                            {
                                                "example_id": "04247d3a-c785-45ca-8bbd-f964542f9b8e",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "„Wenn entwickelte Länder sich darauf zurückziehen, dass Klimawandel ein Schwindel sei und sie keine Pflicht hätten, die Klimaziele zu erfüllen, dann ist das eine sehr ignorante Position.“"
                                            },
                                            {
                                                "example_id": "769d1b22-3c90-4f79-bb19-788cd03a311c",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "Zu Fake News sagte man früher Schwindel"
                                            },
                                            {
                                                "example_id": "d1307c6d-0cd7-4957-9c13-7d8dbfe756c7",
                                                "sense_id": "e122b47a-b88b-324c-a5dd-bf65bdeb7794",
                                                "text": "„Es gibt kein Verbrechen, keinen Kniff, keinen Trick, keinen Schwindel, kein Laster, das nicht von Geheimhaltung lebt. Bringt diese Heimlichkeiten ans Tageslicht, beschreibt sie, macht sie vor aller Augen lächerlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8532f2d-3fee-4a2f-a4c2-66d74f85ccec",
                        "source_entry_id": "3a9fbc6a-af3d-3be0-8254-fd48dccc6965",
                        "source_sense_id": "87a04c33-5f2b-36d7-8255-7b45ef2b5d16",
                        "target_lang_word": "Betrügerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrügerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                        "entry_id": "cf583084-32b3-3b26-83ce-42213afde889",
                                        "glosses": [
                                            "mehrere/viele Handlungen, bei denen jemand/andere hinters Licht geführt und um rechtmäßigen Besitz gebracht wird/werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da65e6a9-252d-4c33-9502-008cb3ddca8a",
                                                "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                                "text": "„Er hatte viel mehr Glück als sein Bruder Ludwig, der wegen Betrügereien im Bergwerk ins Gefängnis kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
