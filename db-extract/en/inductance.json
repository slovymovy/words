                "senses": [
                    {
                        "sense_id": "59787855-cee4-3af0-ad89-3e59bc79aec4",
                        "entry_id": "0f1c1114-bfe4-3f51-8e7f-c613eb27625c",
                        "glosses": [
                            "The property of an electric circuit by which a voltage is induced in it by a changing magnetic field."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03184b86-c0af-460c-a840-31f16239fddb",
                                "sense_id": "59787855-cee4-3af0-ad89-3e59bc79aec4",
                                "text": "The power cable itself has enough inductance to disrupt the digital signal of the video output cable, due to poor shielding."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cf53d9e-ab60-3ef6-8603-34dffccefdfd",
                        "entry_id": "0f1c1114-bfe4-3f51-8e7f-c613eb27625c",
                        "glosses": [
                            "The quantity of the resulting electromagnetic flux divided by the current that produces it, measured in henries (SI symbol: H.)"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c0197bb-0d2b-4b66-a433-aac4de2ade78",
                                "sense_id": "2cf53d9e-ab60-3ef6-8603-34dffccefdfd",
                                "text": "What is the inductance of that power supply's main inductor?"
                            }
                        ]
                    }
                ],
