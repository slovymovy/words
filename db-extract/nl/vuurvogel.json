                "senses": [
                    {
                        "sense_id": "b20d0985-90cb-3435-867e-92f66b57fad4",
                        "entry_id": "b2823169-a6de-3e0c-8d3b-f9e4e0f7f521",
                        "glosses": [
                            "magische vogel uit een Russisch sprookje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d13ad6b5-4de8-48fb-a665-7453d725c3cc",
                                "sense_id": "b20d0985-90cb-3435-867e-92f66b57fad4",
                                "text": "Voor gezinnen wordt de voorstelling van Rood Verlangen getipt. Een bewerking van het Russissche sprookje De Vuurvogel, gespeeld door Laurens ten Den, die faam heeft gemaakt als Hein Bode in de regiosoap Van Jonge Leu en Oale Groond."
                            },
                            {
                                "example_id": "04881603-ccf9-4274-8be5-32ba83353f40",
                                "sense_id": "b20d0985-90cb-3435-867e-92f66b57fad4",
                                "text": "Verwacht wordt dat er veel belangstelling is voor de multimediale kunstinstallatie De Vuurvogel die op 1 oktober komt."
                            },
                            {
                                "example_id": "9e69d69f-5bbd-49b3-9436-c0cbd63340ff",
                                "sense_id": "b20d0985-90cb-3435-867e-92f66b57fad4",
                                "text": "Hollywood-acteur Ben Affleck (43) is op een filmset gespot met een enorme tatoeage op zijn rug. Volgens Amerikaanse entertainmentsites is het een echte permanente huidtekening waaraan vele maanden is gewerkt. Het gaat om een phoenix: een vuurvogel die tussen de schouderbladen van de ster de vleugels uitslaat omringd door aanvullende versieringen."
                            }
                        ]
                    }
