                "senses": [
                    {
                        "sense_id": "c099fc69-1316-30b7-90a6-dace462b42da",
                        "entry_id": "6fa18aa0-189a-3c8f-9191-6ea73f47f3fb",
                        "glosses": [
                            "het pak dat een duiker beschermt tegen koude onder water en dat hem voorziet van ademlucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777d1275-6166-4278-978d-5af9695d6057",
                                "sense_id": "c099fc69-1316-30b7-90a6-dace462b42da",
                                "text": "In minstens twee gevallen is nu volgens de BBC bekend dat illegalen het bijna 35 kilometer brede Kanaal zwemmend proberen over te steken. Het tweetal kocht een duikerspak en verdween daarna spoorloos. Ook is al eens een onbekende man in een duikerspak aangespoeld op de kust van Noorwegen, terwijl daar niemand werd vermist. Het Kanaal staat bekend om zijn sterke en verraderlijke stromingen."
                            },
                            {
                                "example_id": "7878baba-fdc4-4a29-a248-dc198a8cd378",
                                "sense_id": "c099fc69-1316-30b7-90a6-dace462b42da",
                                "text": "Opstelten hield wel van een grap. Zo bedachten de heren dat ze op een verrassende wijze zouden aankomen bij een buitenreceptie van de roeivereniging: via het water. Ze regelden duikerspakken en zuurstofflessen."
                            }
                        ]
                    }
