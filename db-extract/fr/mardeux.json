                                "sense_id": "0808f572-d8a0-3fcb-ab3c-e0cecc96a62b",
                                "text": "Il est don ben mardeux !"
                            },
                            {
                                "example_id": "05ff7a2b-c5f2-48ee-a834-403a14a9c2bc",
                                "sense_id": "0808f572-d8a0-3fcb-ab3c-e0cecc96a62b",
                                "text": "Yé mardeux au boute : la seule fois qu’y s’achète une loterie, y gagne le gros lot !"
                            }
                        ]
                    },
                    {
                        "sense_id": "02022708-896b-3b64-859e-a17a2ffff8ec",
                        "entry_id": "7c8de2cd-e569-3eed-b6db-8ab169532434",
