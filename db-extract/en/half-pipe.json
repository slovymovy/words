                "senses": [
                    {
                        "sense_id": "f57e9924-b463-36e3-bff5-921e37293cc7",
                        "entry_id": "d8a1497e-5eb6-3061-8fb9-94bcba7e1862",
                        "glosses": [
                            "A structure used to perform tricks, approximately semicircular in cross-section, resembling the bottom half of a cylinder lying down."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "518f5a19-965e-4dc5-a0b8-ea011d6fabc7",
                                "sense_id": "f57e9924-b463-36e3-bff5-921e37293cc7",
                                "text": "But the kid who washed windows for $2 an hour when he was 8 so he could buy his first snowboard served notice he could be a contender at the 2010 Vancouver Olympics with a silver medal yesterday in men's halfpipe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cce05228-835c-408c-9d3b-2d4b77004a3f",
                        "source_entry_id": "d8a1497e-5eb6-3061-8fb9-94bcba7e1862",
                        "source_sense_id": "f57e9924-b463-36e3-bff5-921e37293cc7",
