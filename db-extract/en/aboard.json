    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c7598f74-792d-3deb-8968-7bbf9e2e7a62",
                "word": "aboard",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c277ade0-4aba-3d65-a7c4-acee22fe0c57",
                        "entry_id": "c7598f74-792d-3deb-8968-7bbf9e2e7a62",
                        "glosses": [
                            "On board; into or within a ship or boat; hence, into or within a railway car."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "88b3b157-d9a5-43fc-aeba-8415253d59db",
                                "sense_id": "c277ade0-4aba-3d65-a7c4-acee22fe0c57",
                                "text": "We all climbed aboard."
                            },
                            {
                                "example_id": "d445fb77-ccc3-4598-936d-c263526b2764",
                                "sense_id": "c277ade0-4aba-3d65-a7c4-acee22fe0c57",
                                "text": "As the 1857 to Manchester Piccadilly rolls in, I scan the windows and realise there are plenty of spare seats, so I hop aboard. The train is a '221'+'220' combo to allow for social distancing - a luxury on an XC train as normally you're playing sardines, so I make the most of it."
                            },
                            {
                                "example_id": "64b2264b-fbbb-4a70-bb2b-6d7ef14af4e7",
                                "sense_id": "c277ade0-4aba-3d65-a7c4-acee22fe0c57",
                                "text": "Trump said he signed the executive orders while aboard Air Force One on a return flight to Washington from Florida."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd8b9032-9e6e-395b-a394-e3a357e78cfc",
                        "entry_id": "c7598f74-792d-3deb-8968-7bbf9e2e7a62",
                        "glosses": [
                            "On or onto a horse, a camel, etc."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "28d31b4f-bde4-4bac-9dcb-4f3523073689",
                                "sense_id": "fd8b9032-9e6e-395b-a394-e3a357e78cfc",
                                "text": "to sling a saddle aboard"
                            }
                        ]
                    },
                    {
                        "sense_id": "96876cc8-ba42-393b-918f-51ec224988c9",
                        "entry_id": "c7598f74-792d-3deb-8968-7bbf9e2e7a62",
                        "glosses": [
                            "On base."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3e3dc2a8-81df-452e-afa6-0bc668d797d7",
                                "sense_id": "96876cc8-ba42-393b-918f-51ec224988c9",
                                "text": "He doubled with two men aboard, scoring them both."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9abb515-e0e2-33a1-b92b-264c3cd180bf",
                        "entry_id": "c7598f74-792d-3deb-8968-7bbf9e2e7a62",
                        "glosses": [
                            "Into a team, group, or company."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3c39526-8dec-4b80-8a44-a81f366bf1b5",
                                "sense_id": "c9abb515-e0e2-33a1-b92b-264c3cd180bf",
                                "text": "The office manager welcomed him aboard."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c59d7a5-a0d5-3df3-b6d8-50b453b21ea8",
                        "entry_id": "c7598f74-792d-3deb-8968-7bbf9e2e7a62",
                        "glosses": [
                            "Alongside."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fc74c311-9223-4d95-b2bc-879620f24c4d",
                                "sense_id": "8c59d7a5-a0d5-3df3-b6d8-50b453b21ea8",
                                "text": "The ships came close aboard to pass messages."
                            },
                            {
                                "example_id": "f6745a9d-89c1-4037-8da9-dfcd48278db2",
                                "sense_id": "8c59d7a5-a0d5-3df3-b6d8-50b453b21ea8",
                                "text": "The captain laid his ship aboard the enemy's ship."
                            }
                        ]
                    }
                ],
                "translations": [
