                        "examples": [
                            {
                                "example_id": "aa27adf8-c210-422d-a50d-32c74a952477",
                                "sense_id": "1900d7a7-d43d-38cf-8eac-7127bc33b158",
                                "text": "Наборная касса. Наборное дело. Наборная машина."
                            },
