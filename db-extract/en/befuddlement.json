                        "sense_id": "73bcbe37-54f5-32a5-8b92-2c0724640f17",
                        "entry_id": "8df5973f-c195-3acb-90de-fcacb276a2c4",
                        "glosses": [
                            "The state of being befuddled."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "85450739-3062-4b19-abe4-9acc8310efd5",
                                "sense_id": "73bcbe37-54f5-32a5-8b92-2c0724640f17",
                                "text": "1907, Algernon Blackwood, “Max Hensig—Bacteriologist and Murderer” Chapter 4, in The Listener and Other Stories, New York: Knopf, 1917, p. 105,\nIt was, of course, an effect of hypnotism, he remembered thinking, vaguely through the befuddlement of his drink—this culminating effect of an evil and remorseless personality acting upon one that was diseased and extra receptive."
                            },
                            {
                                "example_id": "2f9225b4-0e86-4b0c-b367-2f6324fa33f6",
                                "sense_id": "73bcbe37-54f5-32a5-8b92-2c0724640f17",
                                "text": "A change came over his wind-beaten face, a slight befuddlement, the shock of some minor fact jarred loose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "776b6256-03aa-4065-a136-1df6af089939",
