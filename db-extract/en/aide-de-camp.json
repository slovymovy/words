                ],
                "senses": [
                    {
                        "sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                        "entry_id": "bce4dc73-036c-3769-b9df-cc27dd552194",
                        "glosses": [
                            "A military officer who serves as an adjutant to a higher-ranking officer, prince or other high political dignitary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b708850f-94fc-4eed-b3d9-0f9236b9cb3d",
                                "sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                                "text": "Unlike the orderly or batman, a humble low-ranking servant, an aide-de-camp is often a general, who before the institution of the chief of staff could hold a similar position to his chief."
                            },
                            {
                                "example_id": "b17eb92d-2488-4504-854c-827967c3d9a3",
                                "sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                                "text": "The police uncovered the plot after recovering information from the phone of Bolsonaro’s former personal secretary, Lt Col Mauro Cid, who served as Bolsonaro’s aide-de-camp during his 2019–2023 presidency."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdee2a50-9010-4b9b-b0b1-1e073bd2d91c",
                        "source_entry_id": "bce4dc73-036c-3769-b9df-cc27dd552194",
                        "source_sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                        "source_sense_description": "military officer",
                        "target_lang_word": "vleugeladjudant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vleugeladjudant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "40c00688-d995-3536-aab2-a6bc2099368a",
                                        "entry_id": "3f32cb77-1de5-3b02-98e5-b046c7afc2a1",
                                        "glosses": [
                                            "iemand die bevelen van een hoger geplaatst persoon overbrengt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0cfbe87-9fcd-4564-a337-d9ea8b904a47",
                                                "sense_id": "40c00688-d995-3536-aab2-a6bc2099368a",
                                                "text": "Hij is overal welkom. Hij zou ook makkelijk vleugeladjudant kunnen worden."
                                            },
                                            {
                                                "example_id": "195464e8-1dcc-4e97-a3ae-6c5c440ee3e2",
                                                "sense_id": "40c00688-d995-3536-aab2-a6bc2099368a",
                                                "text": "De muziekkapel van het leger speelde voor de dienst de Brabançonne, het Belgische volkslied. De staatsbegrafenis werd niet bijgewoond door koning Filip, maar hij liet zich zoals altijd bij dit soort gelegenheden vervangen door zijn 'vleugeladjudant'. De kist was bekleed met de Belgische vlag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "910b1b53-4aca-4a24-9198-d6401e9a5bea",
                        "source_entry_id": "bce4dc73-036c-3769-b9df-cc27dd552194",
                        "source_sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                        "source_sense_description": "military officer",
                        "target_lang_word": "aide de camp",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aide de camp",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78543cf2-ce87-3091-88bd-31e4281ef6b2",
                                        "entry_id": "a0c72436-a6d3-368c-894d-d1d6e530452d",
                                        "glosses": [
                                            "Officier chargé de suivre un supérieur hiérarchique afin de faire exécuter ses ordres. Il est en permanence à ses côtés et veille à son confort. Il est au-dessus des officiers d’ordonnance qui sont des subalternes chargés principalement de porter des messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f2c246e-77a5-4484-a609-661f3b09f3f8",
                                                "sense_id": "78543cf2-ce87-3091-88bd-31e4281ef6b2",
                                                "text": "En 1672, il suivit le roi dans ses campagnes en qualité de son aide de camp."
                                            },
                                            {
                                                "example_id": "89c239c5-ddc5-4f14-9b12-745c309b9265",
                                                "sense_id": "78543cf2-ce87-3091-88bd-31e4281ef6b2",
                                                "text": "Des aides de camp, des estafettes apportaient des nouvelles."
                                            },
                                            {
                                                "example_id": "115e544e-de40-4338-913d-611974edbac2",
                                                "sense_id": "78543cf2-ce87-3091-88bd-31e4281ef6b2",
                                                "text": "Trois heures plus tard, une voiture découverte quitte Sedan par la porte de Torcy, en direction de Donchery. L'escorte est réduite au strict minimum : trois aides de camp accompagnent l'attelage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa22ac9d-37e5-35ea-b10f-b217f292a997",
                                        "entry_id": "a0c72436-a6d3-368c-894d-d1d6e530452d",
                                        "glosses": [
                                            "Fonction militaire spéciale."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ce37b3-21fe-4f1a-8649-ca9ddd79ec75",
                        "source_entry_id": "bce4dc73-036c-3769-b9df-cc27dd552194",
                        "source_sense_id": "5159ffea-0360-3675-a30a-4ada36660c45",
                        "source_sense_description": "military officer",
                        "target_lang_word": "adjudant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjudant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80878522-0b81-37d1-9126-542ae38bf2b0",
                                        "entry_id": "1bc167f3-506d-383b-8ccf-5b29154873e9",
                                        "glosses": [
                                            "Grade donné à un sous-officier. En France, dans l’armée de terre, l’armée de l’air et la gendarmerie nationale, il est situé entre son supérieur hiérarchique, l’adjudant-chef, et son subordonné, le sergent-chef (armée de terre, armée de l’air) ou le maréchal des logis-chef (gendarmerie). Ce grade correspond à celui de premier maître dans la Marine nationale française. Le code OTAN : OR-8."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2970b8d8-2088-49af-b1ac-b9deb8bcfe16",
                                                "sense_id": "80878522-0b81-37d1-9126-542ae38bf2b0",
                                                "text": "À vos ordres, mon adjudant !"
                                            },
                                            {
                                                "example_id": "cba7cfab-ae8c-4bc5-854e-59356dd805be",
                                                "sense_id": "80878522-0b81-37d1-9126-542ae38bf2b0",
                                                "text": "Plus d’ombre ; elle se sont déjà séparées de nous, comme si la bataille allait être grave, comme si les adjudants nous les avait réclamées tout à l’heure, avec les livrets matricules."
                                            },
                                            {
                                                "example_id": "0c5c84ea-daa0-4088-b6ac-39fd017bab12",
                                                "sense_id": "80878522-0b81-37d1-9126-542ae38bf2b0",
                                                "text": "Sur les deux mâles, l’un rempilait comme adjudant au 55ᵉ de ligne, en Avignon, cité des Papes et des punaises, et cueillait une flamboyante vérole parmi les nymphes de la rue des Grottes."
                                            },
                                            {
                                                "example_id": "4ba4e114-e033-4a07-a370-aa44d68d9739",
                                                "sense_id": "80878522-0b81-37d1-9126-542ae38bf2b0",
                                                "text": "— S’il veut, le bougre, il sera officier à vingt ans. Moi, j’avais pas son instruction… J’ai pas pu aller bien loin dans la carrière. Je ne suis qu’adjudant…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33a2e48f-fa71-35de-ae65-5b97b9e650de",
                                        "entry_id": "1bc167f3-506d-383b-8ccf-5b29154873e9",
                                        "glosses": [
                                            "Grade des Forces armées canadiennes. Le code OTAN : OR-7."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3610f40e-510c-419b-b27c-28e8707c7d46",
                                                "sense_id": "33a2e48f-fa71-35de-ae65-5b97b9e650de",
                                                "text": "Pour de nombreux escadrons à travers le Canada, l'adjudant deuxième classe est le cadet portant le grade le plus élevé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "682823c4-2699-3876-a274-28bbf38654fe",
                                        "entry_id": "1bc167f3-506d-383b-8ccf-5b29154873e9",
                                        "glosses": [
                                            "L'un des noms vulgaires du marabout argala (Leptotilos dubius), ou argilah, une espèce d'échassier de la famille des ciconiidés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
