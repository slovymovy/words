                    {
                        "sense_id": "cefe3f7e-8376-33d0-977d-f8b514cea2be",
                        "entry_id": "657976f9-1c7a-35d9-be8f-3239a27c0ea6",
                        "glosses": [
                            "Être suprême apportant vie et bien-être à son peuple ou à ses fidèles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff2f9873-139c-4d64-9a93-db3142af61cc",
                                "sense_id": "cefe3f7e-8376-33d0-977d-f8b514cea2be",
                                "text": "Le sens général de cette composition se rapporte au roi défunt : pendant sa vie, semblable au soleil dans sa course de l’orient à l’occident, le roi devait être le vivificateur, l’illuminateur de l’Égypte, et la source de tous les biens physiques et moraux nécessaires à ses habitants."
                            },
                            {
                                "example_id": "fa4383c7-cc1c-47bc-a167-67c61a0d3410",
                                "sense_id": "cefe3f7e-8376-33d0-977d-f8b514cea2be",
                                "text": "Jésus est le vivificateur éternel."
                            }
                        ]
                    }
                ],
