                        ],
                        "form": "des Morgenlands"
                    },
                    {
                        "form_id": "08786732-43ea-4413-8a53-5a18e46189a8",
                        "entry_id": "4c58613e-5c93-3c2e-8402-799b0ba1a882",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Morgenlandes"
                    },
                    {
                        "form_id": "748d0842-0eca-4449-9fcb-61d6754d5480",
                        "entry_id": "4c58613e-5c93-3c2e-8402-799b0ba1a882",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Morgenland"
                    },
                    {
                        "form_id": "bcbc3b96-169e-437c-a9fc-d06dfe27013e",
                        "entry_id": "4c58613e-5c93-3c2e-8402-799b0ba1a882",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Morgenland"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a52a8857-432f-3859-b3c9-1309730898fb",
                        "entry_id": "4c58613e-5c93-3c2e-8402-799b0ba1a882",
                        "glosses": [
                            "veraltet für Orient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b643522-8f93-4d09-b782-5b6fe3a2c1a3",
                                "sense_id": "a52a8857-432f-3859-b3c9-1309730898fb",
                                "text": "„Unter Gundofarr (etwa 19–65 n. Chr.), […] entsteht ein großes indo-parthisches Reich […] Dieser machtvolle Herrscher, […] ist auf zweifache Weise mit der Geschichte des Christentums verknüpft worden. Er gilt als einer der drei Weisen aus dem Morgenland, die das Christuskind in Bethlehem besucht haben;“"
                            },
                            {
                                "example_id": "40fdb1e0-af72-457b-aed2-ec03ce96e3d6",
                                "sense_id": "a52a8857-432f-3859-b3c9-1309730898fb",
                                "text": "„Das Morgenland ist groß und die Fahrt dauerte lang.“"
                            },
                            {
                                "example_id": "a53df41c-05c3-4024-b8eb-3b9b46b3f272",
                                "sense_id": "a52a8857-432f-3859-b3c9-1309730898fb",
                                "text": "„In seiner Nähe hältst du es nicht lange aus, weil Murat sich mit allen Düften des Morgenlandes parfümiert.“"
                            },
                            {
                                "example_id": "d8cf2edb-2730-4200-957d-52aa1de59ce6",
                                "sense_id": "a52a8857-432f-3859-b3c9-1309730898fb",
                                "text": "„Was wäre gewesen, wenn die drei Frauen aus dem Morgenland drei weise Frauen gewesen wären?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "314934d3-b158-4d37-ab7e-c15c062529ec",
                        "source_entry_id": "4c58613e-5c93-3c2e-8402-799b0ba1a882",
                        "source_sense_id": "a52a8857-432f-3859-b3c9-1309730898fb",
                        "source_sense_description": "veraltet für Orient",
                        "target_lang_word": "levant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "levant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2947b4df-f173-3f69-9554-d5ea77981e79",
                                        "entry_id": "ee02a8d6-93e0-33dc-a3d0-0730990bfc23",
                                        "glosses": [
                                            "Qui se lève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7faff2-93db-4334-a2b9-308e471af1a2",
                                                "sense_id": "2947b4df-f173-3f69-9554-d5ea77981e79",
                                                "text": "Par moments une plainte s’élevait, venant du dehors, une clameur affolante, comme le cri des chiens qui aboient à la mort, sous la lune levante, au fond des fermes perdues dans la campagne."
                                            },
                                            {
                                                "example_id": "2ff2b831-bbb6-468e-a180-7559e01482ed",
                                                "sense_id": "2947b4df-f173-3f69-9554-d5ea77981e79",
                                                "text": "La princesse Morgane avait lu dans les livres l’histoire du miroir de Blanche-Neige qui savait parler et lui annonça son égorgement, et le conte du miroir d’Ilsée, d’où sortit une autre Ilsée qui tua Ilsée, et l’aventure du miroir nocturne de la ville de Milet qui faisait s’étrangler les Milésiennes à la nuit levante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4312c19e-e50c-31b9-96e2-295ac6c5da57",
                                        "entry_id": "ee02a8d6-93e0-33dc-a3d0-0730990bfc23",
                                        "glosses": [
                                            "Qui se lève, en parlant du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07637b30-d43c-4ea4-bf45-897a7a0c30c0",
                                                "sense_id": "4312c19e-e50c-31b9-96e2-295ac6c5da57",
                                                "text": "Si au jour levant un paysan la voyait sortir de cette pièce dépouillée, ou même s’il l’apercevait aux environs, il la soupçonnerait d’être de la compagnie des voleurs et l’arrêterait."
                                            },
                                            {
                                                "example_id": "418ffca7-2a5e-4dc9-90bb-b5c68d3e0930",
                                                "sense_id": "4312c19e-e50c-31b9-96e2-295ac6c5da57",
                                                "text": "Les vitres embuées mettaient une doublure de mousseline à la translucidité des rideaux de cretonne blanchissant avec la lumière levante."
                                            },
                                            {
                                                "example_id": "501e3c4d-a4c8-4b79-8761-39328d0e5702",
                                                "sense_id": "4312c19e-e50c-31b9-96e2-295ac6c5da57",
                                                "text": "Je serai là au soleil levant. — Cette maison regarde le soleil levant, est tournée au soleil levant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "levant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d8e16d-5ebf-35f7-b3b0-831328e184b8",
                                        "entry_id": "141cac62-6438-3f2c-ad41-603cbd64315d",
                                        "glosses": [
                                            "Orient, est, lieu où le soleil se lève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94cfc85b-226a-49bc-acc1-a28f24ff3946",
                                                "sense_id": "c8d8e16d-5ebf-35f7-b3b0-831328e184b8",
                                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, restaient d’un vert dru malgré la chaleur torride de cette fin d’été."
                                            },
                                            {
                                                "example_id": "72209fb2-0fc4-45bf-b80d-ce7b7a2efd96",
                                                "sense_id": "c8d8e16d-5ebf-35f7-b3b0-831328e184b8",
                                                "text": "Du levant au couchant. — Entre le levant et le midi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "levant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfdb194f-5938-36d7-aea7-094b0a4e174f",
                                        "entry_id": "f94ea610-c00c-3b3e-a460-f22752d5f5ac",
                                        "glosses": [
                                            "Vent d’est doux et très humide soufflant en mer Méditerranée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "levant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e328716-53d3-3cbe-b192-0058dd70894a",
                                        "entry_id": "fe375c13-0f6c-3c38-bcf5-95422490c45e",
                                        "glosses": [
                                            "Participe présent de lever."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b10665-c602-45cb-b8ff-c490210c00ce",
                                                "sense_id": "0e328716-53d3-3cbe-b192-0058dd70894a",
                                                "text": "Lui seul peut, dit le prêtre en levant le doigt, lui seul peut équilibrer… boussoler la vie !"
                                            },
                                            {
                                                "example_id": "380671b0-437d-4bcb-b751-932dd53f0d16",
                                                "sense_id": "0e328716-53d3-3cbe-b192-0058dd70894a",
                                                "text": "Notre alimentation n’est pas non plus circulaire, c’est-à-dire parcourant un cercle, mais bien continue si on considère l’ensemble des boites qui se succèdent; elle est alternativement interrompue et reprise si l’on considère que chaque boite qui, en se levant, désalimente le peigne, le réalimente ensuite en descendant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
