                                        "sense_id": "25aa33c7-8870-327c-b737-7c255ac28b5c",
                                        "entry_id": "9e5b341c-9d7d-35f1-ab98-b29cc1f78c12",
                                        "glosses": [
                                            "An instrument for determining the size of blood cells by measuring the angular diameter of diffraction of light passing through the blood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e609f42-3e2c-4d12-866e-77587c20c00f",
                                                "sense_id": "25aa33c7-8870-327c-b737-7c255ac28b5c",
                                                "text": "When a small source of light is viewed through a thin blood film on a glass slide, a circular coloured pattern, or halo, is seen. The angular diameter of this halo is inversely proportional to the diameter of the blood cell and it is this which the halometer measures."
                                            }
                                        ]
                                    }
