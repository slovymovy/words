                        "translation_id": "a9b8ed4a-9583-41e2-bf40-51ea187061bc",
                        "source_entry_id": "69d23874-df7c-39f9-9610-6d11f0c30047",
                        "source_sense_id": "d14e94ff-9666-31b6-8bcf-55c6d6dd9431",
                        "target_lang_word": "Zentralasien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zentralasien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e58853d-cffe-34eb-b621-3bfdb165eff9",
                                        "entry_id": "9c5870b8-ed33-3470-87c9-8a560ffb8065",
                                        "glosses": [
                                            "Großregion im Zentrum Asiens, die die Staaten Kasachstan, Usbekistan, Tadschikistan, Turkmenistan und Kirgisistan sowie die zu China gehörenden Autonomen Gebiete Sinkiang (Xinjiang) und Tibet umfasst; nach unterschiedlichen Auffassungen zählen auch die Staaten Afghanistan, Mongolei und die Gebiete Südturkestan, Wüste Gobi, Innere Mongolei dazu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dafe4d6-fd8f-47b7-897d-f8b87baabfc3",
                                                "sense_id": "8e58853d-cffe-34eb-b621-3bfdb165eff9",
                                                "text": "In Zentralasien schwelten in der Geschichte häufig geopolitische Interessenkonflikte."
                                            },
                                            {
                                                "example_id": "0e3baae8-2b3b-4fb2-9f03-7496c6569113",
                                                "sense_id": "8e58853d-cffe-34eb-b621-3bfdb165eff9",
                                                "text": "„Dabei zeigte sich zugleich, dass Moskau in Zentralasien zwar aufständische Gegner besiegen konnte, nicht aber die Korruption, die schon zuvor dort tief verwurzelt war.“"
                                            },
                                            {
                                                "example_id": "f07525ad-e8f8-4ec1-8aba-3b291d9940cf",
                                                "sense_id": "8e58853d-cffe-34eb-b621-3bfdb165eff9",
                                                "text": "„In Deutschland dagegen erlosch eigenartigerweise das brennende Interesse an der Erkundung Zentralasiens nach der Zeit der Berliner Geographen Ritter und Richthofen.“"
                                            },
                                            {
                                                "example_id": "536d8912-f337-482a-9484-2ab3df6639c7",
                                                "sense_id": "8e58853d-cffe-34eb-b621-3bfdb165eff9",
                                                "text": "„Die Mohnpflanze soll bereits im 6. vorchristlichen Jahrtausend in Zentralasien bekannt gewesen sein, in Europa vom Altertum an.“"
                                            },
                                            {
                                                "example_id": "fb54ed7d-735f-4d5f-96e4-685efdd33e55",
                                                "sense_id": "8e58853d-cffe-34eb-b621-3bfdb165eff9",
                                                "text": "„Eine Gruppe Menschen zog damals aus dem nördlichen Kaukasus quer durch Zentralasien in das Gebiet des heutigen Jakutiens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af86e13f-bddf-3dfd-9604-8d833754692f",
                                        "entry_id": "9c5870b8-ed33-3470-87c9-8a560ffb8065",
                                        "glosses": [
                                            "nur die Hochländer, die von Himalaya, Karakorum, Pamir, Altai, Tian Shan, Sajan- und Jablonowygebirge und dem Großen Chingan eingerahmt werden, also innere und äußere Mongolei, Tibet, das Tarimbecken und die Dsungarei sowie das Tuwinische Becken; politisch fast ausschließlich zu China und Mongolei gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
