                ],
                "senses": [
                    {
                        "sense_id": "5b997533-79f1-354e-bc39-8d99ae6e9e21",
                        "entry_id": "c8f4aa6b-ac0f-3ef7-a4d3-4a1a9c326ec7",
                        "glosses": [
                            "S’administrer des médicaments sans prescription médicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "964a8d7f-89a3-4d95-8be4-6d888603699a",
                                "sense_id": "5b997533-79f1-354e-bc39-8d99ae6e9e21",
                                "text": "Le médecin va permettre à son patient de pouvoir s’auto-médicaliser en toute sécurité, et notamment d’être capable d’utiliser l’insuline sans nuire à sa santé."
                            },
                            {
                                "example_id": "4aebcc34-4793-40e0-8002-c9d7a9a85ce3",
                                "sense_id": "5b997533-79f1-354e-bc39-8d99ae6e9e21",
                                "text": "Sans s’être informé d’abord auprès de son médecin traitant, il ne faut pas s’auto-médicaliser en doses irraisonnables d’huile de foie de morue."
                            }
                        ]
                    }
                ],
