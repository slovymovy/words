                ],
                "senses": [
                    {
                        "sense_id": "35121a78-bc33-3c97-88a3-1139c0ffdb65",
                        "entry_id": "7b35f8e6-a2c6-3569-88b9-65f95641769b",
                        "glosses": [
                            "Wind, der am Abend, in den Abendstunden weht, aufkommt"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "4d0e6b5c-637c-433c-938f-710b5c0c67c8",
                                "sense_id": "35121a78-bc33-3c97-88a3-1139c0ffdb65",
                                "text": "„»Warum bist du so betrübt, kleiner Goldregen?« säuselte der Abendwind mitleidig. »Sieh, alle deine Schwestern sind heiter und freuen sich ihres Daseins und ihrer Schönheit, nur du machst ein griesgrämiges Gesicht«.“"
                            },
                            {
                                "example_id": "9df7615c-0a4a-424b-b563-eb780c5bc419",
                                "sense_id": "35121a78-bc33-3c97-88a3-1139c0ffdb65",
                                "text": "„Der Abendwind begann und blätterte in den Seiten des Buches, als läse jemand unsichtbar darin.“"
                            },
                            {
                                "example_id": "8d871586-2770-4f59-85d6-b906e2bbc9e4",
                                "sense_id": "35121a78-bc33-3c97-88a3-1139c0ffdb65",
                                "text": "„Sie legte den Hut aufs Bett, drehte sich zur Seite und blickte zum Fenster hinaus. Das frische Grün der Bäume im Garten, die sich im Licht der Neonlampe im Abendwind bogen und wieder aufrichteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0a8045ee-27ef-37e6-84c2-13473ef63c95",
                        "entry_id": "7b35f8e6-a2c6-3569-88b9-65f95641769b",
                        "glosses": [
                            "Wind, der aus dem Westen (veraltet: Abend) weht"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "167a0610-aeeb-4de4-b33f-1cacbed5844d",
                                "sense_id": "0a8045ee-27ef-37e6-84c2-13473ef63c95",
                                "text": "Früher oder später muss der stürmische Abendwind dem stillen Passat weichen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
