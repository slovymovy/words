                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3e726ec9-8826-414c-a67b-6cb559a5ec8c",
                        "entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
