        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "273aee8c-5683-3439-ad0f-cdc4670f3b80",
                    "sense_definition": "To leave someone in a difficult situation; to abandon or desert.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abandonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airline strike will <w>strand</w> thousands of passengers at the airport.",
                            "target_lang_translations": {
                                "ru": "Забастовка авиакомпании <w>оставит</w> тысячи пассажиров в аэропорту без возможности улететь.",
                                "de": "Der Streik der Fluggesellschaft wird Tausende Passagiere am Flughafen <w>stranden</w> lassen.",
                                "tr": "Havayolu grevi binlerce yolcuyu havaalanında <w>mağdur edecek</w>.",
                                "zh": "航空公司罢工将使成千上万名乘客<w>滞留</w>在机场。"
                            }
                        },
                        {
                            "text": "Do not <w>strand</w> your friends in a strange city without a map.",
                            "target_lang_translations": {
                                "ru": "Не <w>бросайте</w> своих друзей в чужом городе без карты.",
                                "de": "Lass deine Freunde nicht in einer fremden Stadt ohne Karte <w>im Stich</w>.",
                                "tr": "Arkadaşlarınızı yabancı bir şehirde haritasız <w>ortada bırakmayın</w>.",
                                "zh": "别把朋友<w>丢</w>在陌生的城市里，让他们没有地图可用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "desert",
                        "maroon",
                        "leave behind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставить кого-либо в трудной ситуации; бросить или покинуть.",
                        "de": "Jemanden in einer schwierigen Lage zurücklassen; im Stich lassen.",
                        "tr": "Birini zor bir durumda bırakmak; terk etmek veya yüzüstü bırakmak.",
                        "zh": "使某人陷入困难处境而走不了；抛下，弃置不顾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросить",
                                "target_lang_sense_clarification": "в беде"
                            },
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "без помощи"
                            },
                            {
                                "target_lang_word": "подставить",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "im Stich lassen",
                                "target_lang_sense_clarification": "jemanden verlassen"
                            },
                            {
                                "target_lang_word": "stranden lassen",
                                "target_lang_sense_clarification": "jemanden hilflos zurücklassen"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yarı yolda bırakmak",
                                "target_lang_sense_clarification": "zor durumda terk etmek"
                            },
                            {
                                "target_lang_word": "mağdur etmek",
                                "target_lang_sense_clarification": "çaresiz bırakmak"
                            },
                            {
                                "target_lang_word": "ortada bırakmak",
                                "target_lang_sense_clarification": "yardımsız bırakmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滞留",
                                "target_lang_sense_clarification": "使人因交通中断等而动弹不得"
                            },
                            {
                                "target_lang_word": "撇下",
                                "target_lang_sense_clarification": "把人丢下不管，置于困境中"
                            },
