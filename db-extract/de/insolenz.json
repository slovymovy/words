                        ],
                        "examples": [
                            {
                                "example_id": "fd65c16e-cf9f-4368-bd48-388a804d11a7",
                                "sense_id": "a4b21314-c28d-3490-9bd6-4353e7258760",
                                "text": "Er ist der Einzige, der feine Gesellschaft, den demonstrativen Prunk, die Insolenz perfekt zu simulieren weiß."
                            },
                            {
                                "example_id": "90ef2f4a-1866-4122-ac2e-e9480c225d3b",
                                "sense_id": "a4b21314-c28d-3490-9bd6-4353e7258760",
                                "text": "Nun hat er sein Büro über der alten Revolutionsgasse Rue du Faubourg St. Honore verlassen, und sein als Buch veröffentlichter Mahnbrief „Die Republik soll leben\" […] läßt die Pariser Medienwelt wohlig schaudern angesichts solch Insolenz."
                            }
                        ],
