                "senses": [
                    {
                        "sense_id": "96766abc-d036-3521-a97f-dde37431da26",
                        "entry_id": "4c12b67c-d011-3c2c-b1ce-230f512c8804",
                        "glosses": [
                            "rechtlich gesicherte, regelmäßig unentziehbare Erwerbsaussicht auf ein Recht, dessen Voraussetzungen noch nicht (voll) erfüllt sind"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "226a7421-a1f0-47b6-8c84-b2543524b8ca",
                                "sense_id": "96766abc-d036-3521-a97f-dde37431da26",
                                "text": "„Im öffentlichen Dienst war damit oft eine Anwartschaft auf die Amtsnachfolge verbunden, die sich in Österreich noch bis 1979 in der Verwendung der Bezeichnung ‚Adjunkt‘ als Amtstitel für eine niedere Beamtenstufe ausdrückte; ein Relikt ist der in der Försterausbildung auch heute noch gängige Titel des ‚Forstadjunkts‘ (Förster in der Praxisausbildung).“"
                            },
                            {
                                "example_id": "daf4e86a-5693-46fc-a64a-3b2b9a0fa87e",
                                "sense_id": "96766abc-d036-3521-a97f-dde37431da26",
                                "text": "„Die Gewaltenteilung hatte auch politisches Gewicht: bei jedem Wechsel in der Person des Landesfürsten wurde die Landesherrschaft des Nachfolgers, auf die kraft Belehnung durch das Oberhaupt des Heiligen Römischen Reichs Anwartschaft bestand, erst wirksam, wenn die Stände dem neuen Herrn ‚gehuldigt‘ (das heißt Treue gelobt) hatten und dieser sich zur Respektierung der Landesverfassung verpflichtet hatte.“"
                            },
                            {
                                "example_id": "4744103a-9f93-4d77-8509-d1f54f1c0d35",
                                "sense_id": "96766abc-d036-3521-a97f-dde37431da26",
                                "text": "„Dann ersparen sie sich später eine erneute Gesundheitsprüfung und sichern sich, je nach Umfang der Anwartschaft, die Beitragskonditionen von früher.“"
                            },
                            {
                                "example_id": "5783e800-2284-4eea-8fec-034af3c7072c",
                                "sense_id": "96766abc-d036-3521-a97f-dde37431da26",
                                "text": "übertragen: „Er steht auf dem Sprung in die Top 3 der Welt, seine Anwartschaft auf Großes hat er 2017 mit zwei Masters-1000-Siegen in Rom und Montreal bewiesen.“"
                            },
                            {
                                "example_id": "76950202-ce78-468e-8dc8-3fedaf4ae5d1",
                                "sense_id": "96766abc-d036-3521-a97f-dde37431da26",
                                "text": "übertragen: „Die FDP-Frauen haben ihre Anwartschaft mit Blick auf die Nachfolge von Pascal Couchepin im Bundesrat angemeldet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6f0533f-ff88-4058-a549-046fa3cb1a00",
                        "source_entry_id": "4c12b67c-d011-3c2c-b1ce-230f512c8804",
                        "source_sense_id": "96766abc-d036-3521-a97f-dde37431da26",
                        "source_sense_description": "begründete Aussicht auf etwas",
                        "target_lang_word": "expectancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expectancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                        "entry_id": "75f76b55-c3e0-3176-9561-bd5d8c864eff",
                                        "glosses": [
                                            "Expectation or anticipation; the state of expecting something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "526eb0c8-1b3a-4f3f-8664-0ec6d85d0c03",
                                                "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                                "text": "[T]he Dukes dissembled their feares, and dissolued their forces, and remained in expectancie what would ensue."
                                            },
                                            {
                                                "example_id": "cf30a609-e297-444d-b774-792860cec94d",
                                                "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                                "text": "If you foresee not this misery, and the fatall consequence which necessarily must follow such a turn of Fortune, I must leave you to your own will and expectancy […]"
                                            },
                                            {
                                                "example_id": "c2d2f591-7d1c-4b7e-a2cb-184c2fc98dc1",
                                                "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                                "text": "[T]his is generally thought to repreſent the Vices of Nero, vvho […] did from the higheſt Expectancy become a ſtubborn and a fooliſh Tyrant."
                                            },
                                            {
                                                "example_id": "8db193b0-e434-4520-aef8-4094639b74d2",
                                                "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                                "text": "Renewed hope followed renewed effort; it shone like the former for some weeks, then, like it, it faded, flickered: not a line, not a word reached me. When half a year wasted in vain expectancy, my hope died out; and then I felt dark indeed."
                                            },
                                            {
                                                "example_id": "d68aa2e3-d1b0-40eb-9aae-71fd7a76074f",
                                                "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                                "text": "Six minutes later Clovis approached the supper-table, in the blessed expectancy of one who has dined sketchily and long ago."
                                            },
                                            {
                                                "example_id": "50cfec5b-3507-4623-b1df-9791df5106a9",
                                                "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                                "text": "Great Danes have relatively short life expectancies compared to smaller dogs, living for an average of 8-10 years, and males are typically about 2.5 feet (0.76 meters) tall, according to the American Kennel Club."
                                            },
                                            {
                                                "example_id": "d48bf029-7d86-487e-8efe-049a63af8a1f",
                                                "sense_id": "9be328f9-72ea-391b-82e6-4cb53483577f",
                                                "text": "People born in 2023 are now estimated to live 78.4 years, according to the CDC. That’s still shy of the 78.8-year life expectancy from 2019, but it’s a significant improvement driven by lower death rates in each of the 10 leading causes of death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec6f605-37d7-381f-b61d-10adf98e0391",
                                        "entry_id": "75f76b55-c3e0-3176-9561-bd5d8c864eff",
                                        "glosses": [
                                            "The state of being expected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7090da46-dcb9-33e6-b860-e88c3e5a96ec",
                                        "entry_id": "75f76b55-c3e0-3176-9561-bd5d8c864eff",
                                        "glosses": [
                                            "Future interest as to possession or enjoyment"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f495a17b-e87e-3ec4-822a-b386b27ad661",
                                        "entry_id": "75f76b55-c3e0-3176-9561-bd5d8c864eff",
                                        "glosses": [
                                            "expectation; expected value"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ea7b40e-de69-3f30-b462-9292befeadb6",
                                        "entry_id": "75f76b55-c3e0-3176-9561-bd5d8c864eff",
                                        "glosses": [
                                            "Something expected or awaited."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63665f08-c371-474b-8e0f-7a6621009c2e",
                                                "sense_id": "2ea7b40e-de69-3f30-b462-9292befeadb6",
                                                "text": "O, what a noble mind is here o’erthrown! / The courtier’s, scholar’s, soldier’s, eye, tongue, sword, / Th’ expectancy and rose of the fair state […]"
                                            },
                                            {
                                                "example_id": "6720bdbe-65d3-4e3c-b799-a0bda56e276a",
                                                "sense_id": "2ea7b40e-de69-3f30-b462-9292befeadb6",
                                                "text": "[…] Frederic II. King of Prussia, in consequence of an expectancy granted to the house of Brandenburg, by the Emperor Leopold in 1604, took possession of East Friezland […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f925753f-9b0e-4d2f-9d04-553b8712ece2",
                        "source_entry_id": "4c12b67c-d011-3c2c-b1ce-230f512c8804",
                        "source_sense_id": "96766abc-d036-3521-a97f-dde37431da26",
