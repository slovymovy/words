                "senses": [
                    {
                        "sense_id": "4d2a8a1c-8d1d-3e18-b302-4035391088e3",
                        "entry_id": "d4b99b65-2cdd-3cc3-9e73-b36f64c27fda",
                        "glosses": [
                            "Investmentfonds, der hauptsächlich oder gänzlich in Aktien investiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad1aa817-3383-4325-a712-91199e0baae1",
                                "sense_id": "4d2a8a1c-8d1d-3e18-b302-4035391088e3",
                                "text": "Ich zahle monatlich 100 EURO in einen Aktienfonds ein."
                            },
                            {
                                "example_id": "eca63015-177b-4cec-8009-3c03258e37f5",
                                "sense_id": "4d2a8a1c-8d1d-3e18-b302-4035391088e3",
                                "text": "„Die Internetbank … beispielsweise bietet ihren Kunden rund 11 500 verschiedene Aktienfonds zum Kauf an ….“"
                            },
                            {
                                "example_id": "b16da104-1d58-4eb0-b589-edaa17e5caf0",
                                "sense_id": "4d2a8a1c-8d1d-3e18-b302-4035391088e3",
                                "text": "„Wir finden, jedenfalls einen Teil des Geldes in Aktien oder Aktienfonds gesteckt zu haben, eine vernünftige Entscheidung für jeden ….“"
                            },
                            {
                                "example_id": "c0efe0bf-4211-4992-a906-60fbaa0d15e4",
                                "sense_id": "4d2a8a1c-8d1d-3e18-b302-4035391088e3",
                                "text": "„Der von Arts Asset Management gemanagte Dachfonds C-Quadrat Arts Total Return Balanced kann etwa bis zu 50 Prozent in Aktienfonds und bis zu hundert Prozent in Anleihen- und Geldmarktfonds bzw. geldmarktnahe Fonds investieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
