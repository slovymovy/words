                "senses": [
                    {
                        "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                        "entry_id": "2206b074-dde3-35f3-ac19-9b1e9196b617",
                        "glosses": [
                            "Gerät in Form eines auf einer Schiene montierten Sitzes, das eine Person eine Treppe hinauf- und hinunterbefördern kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79c6b61-4b30-4a93-ab44-c60fa568e427",
                                "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                                "text": "Gehbehinderte Personen können sich durch einen Treppenlift ein gewisses Maß an Eigenständigkeit bewahren."
                            },
                            {
                                "example_id": "4dce79e7-f869-4696-8bf7-1da5253bd9ef",
                                "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                                "text": "„An dem hölzernen Geländer, das sich in den ersten Stock windet, ist ein Treppenlift befestigt.“"
                            },
                            {
                                "example_id": "8f973edc-f696-42f7-af06-54c826037d3e",
                                "sense_id": "9f3b616e-dd71-3143-92d8-3a4d60eeba40",
                                "text": "„Sie hatte sich einen Treppenlift bis in den obersten Stock bauen lassen, wo sie wohnte, auf diese Weise konnte sie weiterhin ein und aus gehen, obwohl ihre Beine nicht mehr wollten, langsam kam sie das Geländer entlanggeschwebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
