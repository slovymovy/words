                "senses": [
                    {
                        "sense_id": "ce49160a-6b8e-3d64-b0f6-918b7cec4af7",
                        "entry_id": "518e1dd7-f519-3fea-a0b9-cff6a2f1282a",
                        "glosses": [
                            "Attitude individuelle ou collective par laquelle l'homme s'engage à respecter les principes et les règles destinés à préserver l'environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "162a187f-3556-4a9e-aacf-d63a76845fc1",
                                "sense_id": "ce49160a-6b8e-3d64-b0f6-918b7cec4af7",
                                "text": "Consommer moins d’énergie pour respecter l’environnement. Cette consigne est facilement applicable si chacun y met du sien afin d’alléger la charge qui pèse sur notre environnement. Ainsi, prendre l’habitude d’éteindre nos appareils est une meilleure solution, en termes d’écocitoyenneté, que de les laisser en veille toute la nuit."
                            },
                            {
                                "example_id": "d810cc26-b9b3-41bb-837c-f09c3c1d02d8",
                                "sense_id": "ce49160a-6b8e-3d64-b0f6-918b7cec4af7",
                                "text": "L’écopédagogie critique nous amène à l’idée d’écocitoyenneté, au cœur de la dimension politique de l’éducation relative à l’environnement."
                            },
                            {
                                "example_id": "ea06a427-7cc9-4fee-b814-b29e8edd6017",
                                "sense_id": "ce49160a-6b8e-3d64-b0f6-918b7cec4af7",
                                "text": "Mais pour l’instant, pour remplacer le souk religieux d’ECR, le gouvernement semble préparer un autre fourre-tout où l’on enseignera l’écocitoyenneté et des notions d’éducation sexuelle, en passant la citoyenneté numérique."
                            }
                        ]
                    }
