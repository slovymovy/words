                                "target_lang_sense_clarification": "способ организации или расположения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5893dcba-a159-3f15-8530-de4025e11623",
                    "sense_definition": "A formal legal document that contains the fundamental laws and principles of a state or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_framework",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyers spent months drafting the <w>constitution</w> for the new republic.",
                            "target_lang_translations": {
                                "ru": "Юристы потратили месяцы на разработку проекта <w>конституции</w> для новой республики."
                            }
                        },
                        {
                            "text": "You can find the full text of the legal <w>constitution</w> in the national archives.",
                            "target_lang_translations": {
                                "ru": "Полный текст юридической <w>конституции</w> можно найти в национальных архивах."
                            }
