                                    {
                                        "sense_id": "dbdb4db5-32ce-3fc4-86d6-4883f49b1118",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "The act of correcting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94a5edfd-2f56-357b-ba36-551188dacd4b",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "A substitution for an error or mistake."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5146710e-d431-3395-bf56-c26d9c2684a5",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "Punishment that is intended to rehabilitate an offender."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57610803-890b-4aae-90dd-be776ef3dd46",
                                                "sense_id": "5146710e-d431-3395-bf56-c26d9c2684a5",
                                                "text": "As the facts of the case were investigated, it became apparent that before us was the story of a man whom the entire machinery of law enforcement and correction had conspired against from the beginning to the end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b287e0e0-8dcc-3c64-8690-ccd69ba4cfff",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "An amount or quantity of something added or subtracted so as to correct."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bc94ba9-0aac-3b98-8865-98b809d95c26",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "A decline in a stock market price after a period of rises. Often operationally defined as a market value drop of 10% or more on some specific stock market index."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19af3c5a-de40-3a20-a7c5-ed97e2a3b1ac",
                                        "entry_id": "0f159dbb-3c12-34e0-be27-9ddeda1dab82",
                                        "glosses": [
                                            "a station's indication that previous information was incorrect and will continue with correct information from the last correct transmitted"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c43a06-0366-45a5-8f1f-6a81dc5402fc",
                                                "sense_id": "19af3c5a-de40-3a20-a7c5-ed97e2a3b1ac",
                                                "text": "I have four T-80 tanks at grid Three-niner-niner-four-eight-eight, Correction: Grid Three niner-niner-four-eight-five. How copy? Over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fe7bb8b-a82f-4cf3-971d-c6edea7b17f5",
                        "source_entry_id": "acd76e34-d3de-37c3-9481-de2342432c50",
                        "source_sense_id": "f238cf82-fa20-3e4c-b55f-3158d7c90fa7",
                        "target_lang_word": "rebuke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebuke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                        "entry_id": "7b8548d8-ca5f-34bb-b746-3daee1e92f89",
                                        "glosses": [
                                            "A harsh criticism."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c1e58d-4ac0-4cc8-b3df-53e01971b6a7",
                                                "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                                "text": "There was the sternness of an old-fashioned Tour patron in his rebuke to the young Frenchman Pierre Rolland, the only one to ride away from the peloton and seize the opportunity for a lone attack before being absorbed back into the bunch, where he was received with coolness."
                                            },
                                            {
                                                "example_id": "1cc842e7-dd8c-48fe-bc7d-ee2ab9a774f4",
                                                "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                                "text": "U.S. Vice President JD Vance met Saturday with the Vatican's No. 2 official, following a remarkable papal rebuke of the Trump administration’s crackdown on migrants and Vance’s theological justification of it."
                                            },
                                            {
                                                "example_id": "b8e6cd1c-17dc-4750-9196-0aa247eeb4e6",
                                                "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                                "text": "With his emphasis on accepting the science (he was a trained chemist) – and hence his stern rebuke to the climate change deniers and the politicians who courted them – he even managed to reset the relationship between science and religion, which had been rocky ever since Galileo fell foul of the Inquisition 400 years earlier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rebuke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3daaaf7d-cae5-3236-b6b0-027d2e58743e",
                                        "entry_id": "85a7cc07-1d91-36da-a09f-c49cb5120dd9",
                                        "glosses": [
                                            "To criticise harshly; to reprove."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d18bd88-1267-4e59-9a2f-1c9c46d83083",
                                                "sense_id": "3daaaf7d-cae5-3236-b6b0-027d2e58743e",
                                                "text": "O Lord, do not rebuke me in Your anger or discipline me in Your wrath."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "197d3fa6-d081-4019-9072-ec3f48771388",
                        "source_entry_id": "acd76e34-d3de-37c3-9481-de2342432c50",
                        "source_sense_id": "f238cf82-fa20-3e4c-b55f-3158d7c90fa7",
                        "target_lang_word": "reproof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "869572a4-49f0-3c77-bcb2-d7880712fece",
                                        "entry_id": "69247755-11fb-3ca6-8649-bdaf1ef4a09d",
                                        "glosses": [
                                            "An act or instance of reproving or of reprobating; a rebuke, a reproach, an admonition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "636aeb61-e9d9-4903-990a-ce64bce82412",
                                                "sense_id": "869572a4-49f0-3c77-bcb2-d7880712fece",
                                                "text": "You could not give me a greater reproof for the mistake I fell into. It was all my doing, I know. I have not forgotten it, I assure you."
                                            },
                                            {
                                                "example_id": "8f4030b9-9fcf-4474-9b0f-0012309b376e",
                                                "sense_id": "869572a4-49f0-3c77-bcb2-d7880712fece",
                                                "text": "On at least one such occasion, in L.N.E.R. days, I discovered later that what I had written was precisely what the authorities wanted to be said, though it would have been highly impolitic for my chief to have given me this information rather than the formal reproof that I received!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a31a01-90c1-3b9f-92ca-355e9334127a",
                                        "entry_id": "0794efae-826d-3ff6-bb1d-64c0a5440a25",
                                        "glosses": [
                                            "To proof again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05842430-f7d3-45bc-b6c2-3b85f20abcdf",
                                                "sense_id": "a2a31a01-90c1-3b9f-92ca-355e9334127a",
                                                "text": "We need to reproof the book before publication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
