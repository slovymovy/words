                "senses": [
                    {
                        "sense_id": "e41612c8-1fea-3536-918a-c0396007286e",
                        "entry_id": "73bfcdcc-a360-3aaa-a2b2-a11f7502e107",
                        "glosses": [
                            "kleines, appetitanregendes Gericht zur Eröffnung einer Mahlzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de89a3d0-284b-4d74-9c5b-39b686e68411",
                                "sense_id": "e41612c8-1fea-3536-918a-c0396007286e",
                                "text": "„Sie zogen sich an und kletterten hinauf zum kleinen Café, wo das Dejeuner eben fertig war, das Horsd’œuvre stand schon auf dem Tisch, winzige Crevetten in Undurchschaubarem, Köstlichem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23fab0c0-52c6-46db-920b-19d0edbbced0",
                        "source_entry_id": "73bfcdcc-a360-3aaa-a2b2-a11f7502e107",
                        "source_sense_id": "e41612c8-1fea-3536-918a-c0396007286e",
                        "source_sense_description": "kleines, appetitanregendes Gericht zur Eröffnung einer Mahlzeit",
                        "target_lang_word": "hors-d’œuvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hors-d’œuvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4e796d-0a9f-3dba-970c-f97a50d1e0af",
                                        "entry_id": "61701858-cdc0-36ef-9a4a-69308d7a51ae",
                                        "glosses": [
                                            "Pièce qui est en saillie, et qui ne fait pas partie de l’ordonnance générale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256dcfee-0c6c-40ec-a58f-3889ae2fa9c8",
                                                "sense_id": "9d4e796d-0a9f-3dba-970c-f97a50d1e0af",
                                                "text": "Cette partie de l’édifice est un hors-d’œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5eb9623-2bc1-39db-82fd-406b25464171",
                                        "entry_id": "61701858-cdc0-36ef-9a4a-69308d7a51ae",
                                        "glosses": [
                                            "Partie d’un ouvrage qui ne dépend pas essentiellement du sujet, et qu’on pourrait retrancher sans nuire à l’ensemble du plan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f98abf-c2e4-492e-ae8b-5d627836be4d",
                                                "sense_id": "c5eb9623-2bc1-39db-82fd-406b25464171",
                                                "text": "Cet épisode est un hors-d’œuvre."
                                            },
                                            {
                                                "example_id": "9980ebca-2a4a-4bad-a1ee-ae33213860b4",
                                                "sense_id": "c5eb9623-2bc1-39db-82fd-406b25464171",
                                                "text": "Les hors-d’œuvre plaisent quelquefois, mais il y en a trop dans cet ouvrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "086f3528-31b4-3b9f-8849-d16116eb246a",
                                        "entry_id": "61701858-cdc0-36ef-9a4a-69308d7a51ae",
                                        "glosses": [
                                            "Certains mets que l’on sert après le potage ou au début du repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "995f28f5-9857-4d9a-8cb4-a8e79d1e1f72",
                                                "sense_id": "086f3528-31b4-3b9f-8849-d16116eb246a",
                                                "text": "Il y avait aussi, comme hors-d’œuvre, des tranches rouges qu’on étendait sur du pain noir en le saupoudrant de poivre : c'était du saumon fumé."
                                            },
                                            {
                                                "example_id": "f73842b4-7780-46b4-84b3-d2f0452f2903",
                                                "sense_id": "086f3528-31b4-3b9f-8849-d16116eb246a",
                                                "text": "[…] : ce sont des sauterelles (jerâd). […]. Le soir, Mohammed m’en sert un plat en guise de hors-d’œuvre. On mange surtout l’abdomen des femelles, gonflé d’œufs avant la ponte. Et réellement, bouillies dans l’eau salée, puis frites, elles constituent un mets qui n’est pas à dédaigner."
                                            },
                                            {
                                                "example_id": "26be2f6c-853b-4cc7-a0a2-9afba7dbc99c",
                                                "sense_id": "086f3528-31b4-3b9f-8849-d16116eb246a",
                                                "text": "Comme hors-d’œuvre, il y avait du poisson crû macéré dans le jus de citron sauvage et servi avec des sauces savamment aromatisées, […]."
                                            },
                                            {
                                                "example_id": "b203defd-e6cd-45fb-a5fe-a871e18b1ffe",
                                                "sense_id": "086f3528-31b4-3b9f-8849-d16116eb246a",
                                                "text": "Les hors-d’œuvre disparaissaient avec les banalités d’une conversation qui attend le dessert pour se dessiner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9958cc5-0d88-3924-87ca-31cb160820b1",
                                        "entry_id": "61701858-cdc0-36ef-9a4a-69308d7a51ae",
                                        "glosses": [
                                            "Ce qui n’est pas principal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26611c7a-0514-4164-aa2e-47e6f4eebae4",
                                                "sense_id": "c9958cc5-0d88-3924-87ca-31cb160820b1",
                                                "text": "Mais alors il devenait inutile de calculer l’hendécagone. Et ce n’est pas là un polygone d’un calcul aisé comme le triangle et le carré dont Ptolémée a fait mention en hors-d’œuvre."
                                            },
                                            {
                                                "example_id": "6b33b9d9-a040-469c-a63e-b1cc050f224b",
                                                "sense_id": "c9958cc5-0d88-3924-87ca-31cb160820b1",
                                                "text": "Aux yeux du matérialiste, les corps célestes sont d’inutiles hors-d’œuvre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hors-d’œuvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
