                    "frequency": "High",
                    "semantic_group_id": "ruines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues ont découvert de magnifiques <w>vestiges</w> romains au cœur de la vieille ville."
                        },
                        {
                            "text": "Cette tour médiévale est le seul <w>vestige</w> encore debout de l'ancien château fort."
                        }
                    ],
                    "synonyms": [
                        "ruine",
                        "relique",
                        "reste"
                    ],
                    "common_phrases": [
