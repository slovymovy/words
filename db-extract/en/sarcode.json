                        "examples": [
                            {
                                "example_id": "86075d5b-3347-4bce-9dc2-6978b6149c41",
                                "sense_id": "63b09729-c5aa-343a-864d-cb71e33c2cc0",
                                "text": "How a nerve comes to be sensitive to light, hardly concerns us more than how life itself originated; but I may remark that, as some of the lowest organisms, in which nerves cannot be detected, are known to be sensitive to light, it does not seem impossible that certain elements in their tissues or sarcode should have become aggregated and developed into nerves endowed with this special sensibility to its action."
                            },
                            {
                                "example_id": "9640a6e6-98b0-4db2-89b2-871bf96e7a46",
                                "sense_id": "63b09729-c5aa-343a-864d-cb71e33c2cc0",
                                "text": "The amoeba — a mere shapeless mass of moving sarcode — digests rapidly and constantly without a trace of organism! An organism when dead we assume to be chemically the same as the living organism, but we cannot prove it."
                            }
                        ]
                    }
