                                "example_id": "88815560-7df8-4782-b69d-85d84efe9ff0",
                                "sense_id": "59c1baba-08f2-3138-80a6-8afa211c5891",
                                "text": "Il s’appelait Albin. Il était de la montagne."
                            },
                            {
                                "example_id": "9d370c77-ccc3-4036-a77e-466c25bbb0c8",
                                "sense_id": "59c1baba-08f2-3138-80a6-8afa211c5891",
                                "text": "Je repartis que je me nommais Albin, et d’un petit mouvement de la bouche, elle me signifia que ça lui était bien égal."
                            },
                            {
                                "example_id": "eb6fa68f-28eb-4233-9f76-cd0fcc3a2412",
                                "sense_id": "59c1baba-08f2-3138-80a6-8afa211c5891",
                                "text": "De mémoire d’expert, Albin Wagener n’a pas le souvenir d’une telle accumulation de bons mots, surtout chez un dirigeant de l’ONU."
                            }
                        ]
                    }
