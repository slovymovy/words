                "senses": [
                    {
                        "sense_id": "2aa0a988-ed76-37ac-be81-c52fc38d8748",
                        "entry_id": "6cb66433-111c-3982-aa82-e1298fa2081a",
                        "glosses": [
                            "Boire du vin avec excès, s’enivrer avec du pinard."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e6710915-23d7-4639-b9ab-f8937f8ee1e3",
                                "sense_id": "2aa0a988-ed76-37ac-be81-c52fc38d8748",
                                "text": "C’est les impôts qui te tombent dessus dès que tu reviens de vacances… en supposant que tu aies encore les moyens de t’en payer, parce qu'il y en a beaucoup qui sont obligés de rester chez eux à bouffer des feuilletons télé, s’empinarder de vins au rabais, et se goinfrer de cochonneries pour oublier !."
                            },
                            {
                                "example_id": "1c401367-fc19-49e8-ba0a-f946e6f01b1f",
                                "sense_id": "2aa0a988-ed76-37ac-be81-c52fc38d8748",
                                "text": "C'est super sympa cette envie commune d'aller vous empinarder pour une juste et noble cause.."
                            },
                            {
                                "example_id": "c51b4422-f080-4a52-8e53-129a4278fe11",
                                "sense_id": "2aa0a988-ed76-37ac-be81-c52fc38d8748",
                                "text": "Le pays où l’on naît pour bosser, où l’on est payé pour bosser, où l’on grandit pour bosser, et où l’on ne meurt pas comme ça, n’importe où, parce qu’on a préféré s'empinarder dans une boîte de nuit plutôt que d'aller bosser.."
                            }
                        ]
                    }
                ],
