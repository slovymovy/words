                "senses": [
                    {
                        "sense_id": "092e2a28-7637-3816-9a6e-9b1419c91939",
                        "entry_id": "401831e4-162d-3c76-9851-add99f466467",
                        "glosses": [
                            "равномерно размазать тушь, карандаш, уголь, положенные в теневых местах рисунка; разрисовать, оттенить тушью"
                        ],
                        "tags": [],
