                                "example_id": "7c5b01cf-ff4a-4f68-8e8f-019ba96f4075",
                                "sense_id": "b62b0876-6126-333f-bd33-08d9fac45773",
                                "text": "Przesunąłem wajchę i nagle poczułem się jak maszynista w starym filmie."
                            },
                            {
                                "example_id": "079c4d78-20ee-462c-b99a-5692eda0bb7c",
                                "sense_id": "b62b0876-6126-333f-bd33-08d9fac45773",
                                "text": "Kiedy przestawisz tę wajchę, nic się nie stanie, ale przynajmniej będzie to wyglądało bardzo profesjonalnie."
                            }
                        ],
