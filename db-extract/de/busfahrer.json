                ],
                "senses": [
                    {
                        "sense_id": "a3111afd-0371-3419-9862-5c82a62cf38d",
                        "entry_id": "58edc521-33f1-33bf-accd-5df4227dd93a",
                        "glosses": [
                            "Fahrer eines Busses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15e1a7b-5907-44bc-91d5-c847e7e3c4e5",
                                "sense_id": "a3111afd-0371-3419-9862-5c82a62cf38d",
                                "text": "Der Busfahrer verkauft auch Fahrscheine."
                            },
                            {
                                "example_id": "ea5b8cb5-ecdf-469f-a3f7-05239310d017",
                                "sense_id": "a3111afd-0371-3419-9862-5c82a62cf38d",
                                "text": "„Fernbusbranche findet nicht genügend Busfahrer, um alle gewünschten Strecken zu bedienen.“"
                            },
                            {
                                "example_id": "595f0959-ddd7-4c37-973d-eff91c7f6b62",
                                "sense_id": "a3111afd-0371-3419-9862-5c82a62cf38d",
                                "text": "„Nach der mittleren Reife wird er Busfahrer bei einem Hamburger Verkehrsbetrieb.“"
                            },
                            {
                                "example_id": "3972820c-0771-405b-b115-555e332afe13",
                                "sense_id": "a3111afd-0371-3419-9862-5c82a62cf38d",
                                "text": "„Wir telfonieren mit dem Busfahrer, der uns die Stelle nennt, an der sich alle Kreuzfahrer sammeln, die ebenfalls nach Basel aufgebrochen sind.“"
                            },
                            {
                                "example_id": "875097a0-c68a-4d39-9c48-0af89b5ee41a",
                                "sense_id": "a3111afd-0371-3419-9862-5c82a62cf38d",
                                "text": "„Wegen bisheriger Unbescholtenheit des Busfahrers wurde das Verfahren gegen eine Bußgeldzahlung von 100.- DM eingestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
