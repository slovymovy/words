                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73350efc-2b42-4249-9ab5-c9eb7528f235",
                                                "sense_id": "2fb3071b-376e-3dc0-b57c-60656f2df16c",
                                                "text": "So as not to impede navigation the two principal spans of the bridge were designed to provide a clear headway of 157 ft. above high water for a distance of 500 ft.; [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be8abf5-b2cb-383d-b1f9-0c1115d3eb48",
                                        "entry_id": "a4c64de8-8442-3eee-b245-3d6b30e97774",
                                        "glosses": [
                                            "The state of the tide when the water is at its highest."
                                        ],
                                        "tags": [
