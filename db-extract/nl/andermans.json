                    {
                        "sense_id": "06f21e1b-5f48-3c91-8867-be479ffe9416",
                        "entry_id": "876bd52a-2d05-342b-bad7-13ba26b03f28",
                        "glosses": [
                            "genitief van een andere man, wordt gebruikt in bezittelijke zin dus: 'van iemand anders'"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb53ada3-4d1f-4061-b934-1d28c896fc1b",
                                "sense_id": "06f21e1b-5f48-3c91-8867-be479ffe9416",
                                "text": "Blijf van andermans bezit af."
                            },
                            {
                                "example_id": "98d03813-f0f0-4116-ae66-cac8777b8c76",
                                "sense_id": "06f21e1b-5f48-3c91-8867-be479ffe9416",
                                "text": "Hbib Lebyad was niet het type om zich met andermans zaken te bemoeien - voor hem bestond er maar één ding en dat was de snackbar, zijn restaurant, zoals hij die noemde."
                            },
                            {
                                "example_id": "bd6ba6fa-dddc-4678-958d-c5ac6c971740",
                                "sense_id": "06f21e1b-5f48-3c91-8867-be479ffe9416",
                                "text": "Ik deed meer mijn best om mee te gaan met andermans ideeën in plaats van drammerig mijn zin door te drukken."
                            }
                        ]
                    }
                ],
