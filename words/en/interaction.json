{
    "word_family": [
        "interact",
        "interactive",
        "interactivity",
        "interactively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f58e72c-ed60-329d-ba1e-41bda5232987",
                    "sense_definition": "A conversation or exchange between people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Social <w>interaction</w> is an essential part of a healthy and happy lifestyle.",
                            "target_lang_translations": {
                                "ru": "Социальное <w>взаимодействие</w> — неотъемлемая часть здорового и счастливого образа жизни.",
                                "zh": "社会<w>互动</w>是健康快乐生活方式的重要组成部分。"
                            }
                        },
                        {
                            "text": "The manager encouraged more <w>interaction</w> with the customers to improve service quality.",
                            "target_lang_translations": {
                                "ru": "Менеджер поощрял более активное <w>общение</w> с клиентами для улучшения качества обслуживания.",
                                "zh": "经理鼓励与客户进行更多<w>交流</w>，以提高服务质量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "communication",
                        "contact",
                        "exchange"
                    ],
                    "antonyms": [
                        "isolation"
                    ],
                    "common_phrases": [
                        "social interaction",
                        "customer interaction",
                        "interaction with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговор или обмен информацией между людьми.",
                        "zh": "人与人之间的交流或互动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общение",
                                "target_lang_sense_clarification": "коммуникация, связь между людьми"
                            },
                            {
                                "target_lang_word": "взаимодействие",
                                "target_lang_sense_clarification": "контакт, совместные действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交流",
                                "target_lang_sense_clarification": "指人与人之间通过语言或行为进行的沟通"
                            },
                            {
                                "target_lang_word": "互动",
                                "target_lang_sense_clarification": "指人与人之间相互作用、相互影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b15c8847-2cda-3077-8602-38827f5de896",
                    "sense_definition": "The situation where two or more things act upon one another to produce an effect.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex <w>interaction</w> between the brain and the nervous system is fascinating to study.",
                            "target_lang_translations": {
                                "ru": "Сложное <w>взаимодействие</w> между мозгом и нервной системой увлекательно изучать.",
                                "zh": "大脑与神经系统之间复杂的<w>相互作用</w>非常值得研究。"
                            }
                        },
                        {
                            "text": "You should be careful about the <w>interaction</w> between these two strong cleaning products.",
                            "target_lang_translations": {
                                "ru": "Вам следует быть осторожным с <w>взаимодействием</w> этих двух сильных чистящих средств.",
                                "zh": "你应该小心这两种强力清洁剂之间的<w>相互作用</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interplay"
                    ],
                    "common_phrases": [
                        "interaction between",
                        "drug interaction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, когда два или более объекта воздействуют друг на друга, вызывая определенный эффект.",
                        "zh": "两个或多个事物相互作用并产生影响的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взаимодействие",
                                "target_lang_sense_clarification": "взаимное влияние предметов или систем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相互作用",
                                "target_lang_sense_clarification": "指事物之间彼此产生的影响或作用"
                            },
                            {
                                "target_lang_word": "交互",
                                "target_lang_sense_clarification": "指系统或事物间的相互影响或交换"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}