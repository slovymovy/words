                                        "entry_id": "3843e9a0-b8c8-330b-9129-78fd257fb084",
                                        "glosses": [
                                            "aanhalingsteken in de vorm van een haakje in de vorm van een klein groter- of kleiner-dan-teken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e942d006-21d1-4102-97d4-4e541d3b98e8",
                                                "sense_id": "e0495de4-4119-3a5a-8c0f-c7a23ff3a821",
                                                "text": "In Romaanse talen worden teksten in de directe rede vaak tussen « twee dubbele guillemets » geplaatst."
                                            },
                                            {
                                                "example_id": "8129ef69-8ee9-4045-ae9e-84f571c25f4e",
                                                "sense_id": "e0495de4-4119-3a5a-8c0f-c7a23ff3a821",
                                                "text": "De guillemet zit wel in de lettertekens van NRC, maar de krant gebruikt voornamelijk de komma-aanhalingstekens. Hoe is dat dan te rijmen met de guillemet als teken voor NRC?"
                                            }
