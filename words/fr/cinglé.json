                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent glacial a <w>cinglé</w> le visage des promeneurs sur la plage.",
                            "target_lang_translations": {
                                "en": "The icy wind has <w>lashed</w> the faces of people walking on the beach.",
                                "ru": "Ледяной ветер <w>хлестнул</w> по лицам гуляющих на пляже.",
                                "de": "Der eisige Wind hat den Spaziergängern am Strand ins Gesicht <w>gepeitscht</w>.",
                                "es": "El viento helado ha <w>azotado</w> la cara de los paseantes en la playa.",
                                "zh": "刺骨的寒风<w>抽打</w>着海滩上散步的人们的脸。"
                            }
                        },
                        {
                            "text": "Le navire a <w>cinglé</w> vers le grand large dès les premières lueurs du jour.",
                            "target_lang_translations": {
                                "en": "The ship <w>sailed</w> toward the open sea at first light.",
                                "ru": "Корабль <w>поплыл</w> в открытое море на рассвете.",
                                "de": "Das Schiff <w>segelte</w> gleich bei Tagesanbruch aufs offene Meer <w>hinaus</w>.",
                                "es": "Al despuntar el día, el barco <w>navegó</w> rumbo a alta mar.",
                                "zh": "天刚蒙蒙亮，船就<w>驶向</w>了远海。"
                            }
                        }
