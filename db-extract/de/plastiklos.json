                        "form": "es ist plastiklos"
                    },
                    {
                        "form_id": "e93b972f-4def-44fe-884e-d897cf81cd2b",
                        "entry_id": "72919a85-c128-36cb-ba64-bd6f35fb3f7a",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind plastiklos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7548dbb8-3a17-34c2-85da-b9cfd0cf92be",
                        "entry_id": "72919a85-c128-36cb-ba64-bd6f35fb3f7a",
                        "glosses": [
                            "kein Plastik enthaltend, ohne Kunststoffe auskommend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2818dca-3f2e-417b-a00c-5f4b356a2abf",
                                "sense_id": "7548dbb8-3a17-34c2-85da-b9cfd0cf92be",
                                "text": "„Viele Produkte, die wir bislang nur mit Plastikzusätzen kennen, gibt es als plastiklose Alternative.“"
                            },
                            {
                                "example_id": "fa14972f-2485-4711-b794-51a188701e51",
                                "sense_id": "7548dbb8-3a17-34c2-85da-b9cfd0cf92be",
                                "text": "„Während also meine plastiklose Ausstattung immer mehr wuchs, sank gleichzeitig mein Plastikmüll ganz erheblich.“"
                            },
                            {
                                "example_id": "a116051b-ce10-4806-87ed-30986a3a25ce",
                                "sense_id": "7548dbb8-3a17-34c2-85da-b9cfd0cf92be",
                                "text": "„Auch in Bonn sieht die Stadt bei einem komplett plastiklosen Weihnachtsmarkt Hygieneprobleme.“"
                            },
                            {
                                "example_id": "70620e16-c039-4102-b415-8c6017208420",
                                "sense_id": "7548dbb8-3a17-34c2-85da-b9cfd0cf92be",
                                "text": "„Um dem entstehenden Schaden, der beim Wegwerfen der plastiklosen Gurken entsteht, entgegenzuwirken, führen einige Supermärkte Neuerungen für die Salatgurke ein.“"
                            },
                            {
                                "example_id": "ad12b851-ea8f-46d2-8078-2458ed34d6bc",
                                "sense_id": "7548dbb8-3a17-34c2-85da-b9cfd0cf92be",
                                "text": "„Nicht alles war besser, aber was wir Alten noch wissen: Es gab in plastikloser Zeit mehr Qualität.“"
                            }
