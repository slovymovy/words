                        "examples": [
                            {
                                "example_id": "ac02dfc7-62dd-42af-b3e1-249ad1f5c267",
                                "sense_id": "5813838c-fdbc-3041-afc9-cbe76d52a404",
                                "text": "De moslimpartij doet door het opstappen van El Bachiri in Zwijndrecht niet mee aan de komende gemeenteraadsverkiezingen. Eerder zijn andere kandidaat-raadsleden van de partij in Zwijndrecht al gestopt."
                            },
