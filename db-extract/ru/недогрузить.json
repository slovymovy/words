                        "glosses": [
                            "нагрузить, погрузить что-либо в меньшем количестве, чем требуется"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb6c0e9-a0fe-4624-999d-ca476d6458de",
                                "sense_id": "eb124cde-cad6-36d4-9904-1ecdb1be27c4",
                                "text": "Недогрузить стройматериалы. Недогрузить тонну угля. Недогрузить картофеля, пшеницы."
                            }
                        ]
                    },
