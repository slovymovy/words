{
    "word_family": [
        "muffle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33443e3f-f01f-317a-b2d1-9175cd89fb3a",
                    "sense_definition": "A warm scarf worn around the neck for protection against cold weather.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newcomer took off his cap and his big woollen <w>muffler</w>.",
                            "target_lang_translations": {
                                "ru": "Приезжий снял кепку и свой большой шерстяной <w>шарф</w>."
                            }
                        },
                        {
                            "text": "He was wearing a maroon cashmere <w>muffler</w> to protect his neck from the cold.",
                            "target_lang_translations": {
                                "ru": "На нем был бордовый кашемировый <w>шарф</w>, чтобы защитить шею от холода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "woollen muffler",
                        "warm muffler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Теплый шарф, который носят на шее для защиты от холода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шарф",
                                "target_lang_sense_clarification": "предмет одежды, обматываемый вокруг шеи"
                            },
                            {
                                "target_lang_word": "кашне",
                                "target_lang_sense_clarification": "небольшой шарф, обычно мужской"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33d8d94e-0cfa-3c97-a669-ab42f9c7ea51",
                    "sense_definition": "A component of a vehicle's exhaust system designed to reduce the noise produced by the engine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "automotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was very loud because the <w>muffler</w> was broken.",
                            "target_lang_translations": {
                                "ru": "Машина очень шумела, потому что <w>глушитель</w> был сломан."
                            }
                        },
                        {
                            "text": "The mechanic replaced the damaged <w>muffler</w> to quiet the engine.",
                            "target_lang_translations": {
                                "ru": "Механик заменил поврежденный <w>глушитель</w>, чтобы сделать работу двигателя тише."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broken muffler",
                        "replace muffler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компонент выхлопной системы автомобиля, предназначенный для снижения шума, производимого двигателем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глушитель",
                                "target_lang_sense_clarification": "техническое устройство для снижения шума выхлопа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92c56c2b-3cc6-3a87-8e96-702c30b9ba8a",
                    "sense_definition": "A device attached to the muzzle of a firearm to reduce the sound of the gunshot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agent attached a <w>muffler</w> to his pistol to remain undetected.",
                            "target_lang_translations": {
                                "ru": "Агент прикрепил <w>глушитель</w> к своему пистолету, чтобы остаться незамеченным."
                            }
                        },
                        {
                            "text": "Using a <w>muffler</w> significantly reduces the noise of the shot.",
                            "target_lang_translations": {
                                "ru": "Использование <w>глушителя</w> значительно снижает шум выстрела."
                            }
                        }
                    ],
                    "synonyms": [
                        "silencer",
                        "suppressor"
                    ],
                    "common_phrases": [
                        "attach muffler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, прикрепляемое к дулу огнестрельного оружия для уменьшения звука выстрела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глушитель",
                                "target_lang_sense_clarification": "специальная насадка на ствол оружия"
                            },
                            {
                                "target_lang_word": "прибор бесшумной стрельбы",
                                "target_lang_sense_clarification": "официальное техническое название устройства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b3b90e-2c25-39bd-b0ec-1d3fdea2f12c",
                    "sense_definition": "A protective mask worn over the face to filter out harmful gases or particles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protective_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers put on their <w>muffler</w> masks before entering the smoke-filled room.",
                            "target_lang_translations": {
                                "ru": "Солдаты надели свои <w>респираторы</w> перед тем, как войти в задымленное помещение."
                            }
                        },
                        {
                            "text": "He struggled to breathe while wearing the heavy <w>muffler</w>.",
                            "target_lang_translations": {
                                "ru": "Ему было трудно дышать в тяжелом <w>респираторе</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитная маска, надеваемая на лицо для фильтрации вредных газов или частиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "респиратор",
                                "target_lang_sense_clarification": "средство защиты органов дыхания"
                            },
                            {
                                "target_lang_word": "противогаз",
                                "target_lang_sense_clarification": "полная маска для защиты от газов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}