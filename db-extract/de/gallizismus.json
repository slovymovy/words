                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "галлицизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e2e8c8-c6d8-3d90-90b4-390ab67827b5",
                                        "entry_id": "db7022e2-cef3-3582-a3e5-0d5ca5cd8ae1",
                                        "glosses": [
                                            "лингв. слово или оборот речи, заимствованные из французского языка или построенные по французскому образцу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd148873-b518-4187-b8a6-24dce0adca68",
                                                "sense_id": "c1e2e8c8-c6d8-3d90-90b4-390ab67827b5",
                                                "text": "Не знаю, продаются ли в Цирихе карты; по крайней мере в них здесь никогда не играют и не знают сего прекрасного средства убивать время (простите мне этот галлицизм), средства, которое в других землях сделалось почти необходимым."
                                            },
                                            {
                                                "example_id": "ef0031c1-e8cf-4a94-91e4-58e6c510088c",
                                                "sense_id": "c1e2e8c8-c6d8-3d90-90b4-390ab67827b5",
                                                "text": "Что такое, собственно, значит: делать карьер? Это нестерпимый галлицизм, подобный галлицизмам: я его слышал говорить; делать зубы; она выглядит, и прочему, что слышим мы из уст хорошеньких девушек, которые сами — галлицизм в нашем быту."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
