                                                "sense_id": "fedd4f7e-131c-3cae-abb0-8c41ad71ff5f",
                                                "text": "The King himſelf the ſacred Unction made, / As King by Office, and as Prieſt by Trade: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d82da6-f0fe-3b7f-b05b-3c543dadfc57",
                                        "entry_id": "e66f78b6-48e3-3b50-bd5a-da3b3c88ecde",
                                        "glosses": [
                                            "A religious or ceremonial anointing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52272c63-b6ac-4b6f-a876-cbf660ca095f",
                                                "sense_id": "11d82da6-f0fe-3b7f-b05b-3c543dadfc57",
                                                "text": "To be heir, and to be king / By sacred unction, thy deserved right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68893349-961a-303b-845a-5d646a409eea",
                                        "entry_id": "e66f78b6-48e3-3b50-bd5a-da3b3c88ecde",
                                        "glosses": [
                                            "A balm or something that soothes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae2d116d-e6a3-328f-ad15-7ba7823ed9b4",
                                        "entry_id": "e66f78b6-48e3-3b50-bd5a-da3b3c88ecde",
                                        "glosses": [
                                            "A quality in language, address or delivery which expresses sober and fervent emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a31d13f2-c7ec-408f-8c8b-52364f4961f8",
                                                "sense_id": "ae2d116d-e6a3-328f-ad15-7ba7823ed9b4",
                                                "text": "Krook almost smacks his lips with the unction of a horrible interest."
                                            },
                                            {
                                                "example_id": "8a68a165-1c42-4100-97ec-c262553dd604",
                                                "sense_id": "ae2d116d-e6a3-328f-ad15-7ba7823ed9b4",
                                                "text": "\"Well, I'll say this for myself. If there's anything out of order where I'm about, I don't miss it.\" \"I believe you,\" said Bradly with unction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca9232a-1124-3c5d-afd0-9359e4c549ac",
                                        "entry_id": "e66f78b6-48e3-3b50-bd5a-da3b3c88ecde",
                                        "glosses": [
