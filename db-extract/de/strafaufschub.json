                                "target_senses": [
                                    {
                                        "sense_id": "6dce405b-830e-335a-8071-f9bb22a9be13",
                                        "entry_id": "4e1d613a-4f17-3d3a-8775-b5d87a49bb15",
                                        "glosses": [
                                            "To cancel or postpone the punishment of someone, especially an execution."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "764b535a-b08a-300d-9480-dcfed7704cc4",
                                        "entry_id": "4e1d613a-4f17-3d3a-8775-b5d87a49bb15",
                                        "glosses": [
                                            "To bring relief to someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e91b79-5ef9-4f39-b5a3-312f4505ce4a",
                                                "sense_id": "764b535a-b08a-300d-9480-dcfed7704cc4",
                                                "text": "Company […] may reprieve a man from his melancholy, yet it cannot secure him from his conscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51714150-f8cb-37bc-8c81-53ca6a32e2a5",
                                        "entry_id": "4e1d613a-4f17-3d3a-8775-b5d87a49bb15",
                                        "glosses": [
                                            "To take back to prison (in lieu of execution)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a9f1972-e9a1-385d-a21f-9b46eac59993",
                                        "entry_id": "4e1d613a-4f17-3d3a-8775-b5d87a49bb15",
                                        "glosses": [
                                            "To abandon or postpone plans to close, withdraw or abolish (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6127b04-b7ca-4844-9b78-01fbd9863c3f",
                                                "sense_id": "3a9f1972-e9a1-385d-a21f-9b46eac59993",
                                                "text": "At the time of writing the halts have been reprieved due to doubts as to the legality of the withdrawal of services. It is feared that this reprieve may not outlast the summer timetable which, on the section in question, provides only a skeleton of the former service."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reprieve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "366b0ebe-1574-3864-8797-f41b0621744d",
                                        "entry_id": "5bb49b82-33ca-3576-b073-348fee097e66",
                                        "glosses": [
                                            "The cancellation or postponement of a punishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e7905bf-7e94-4b16-aaa7-e03e27a32bbe",
                                                "sense_id": "366b0ebe-1574-3864-8797-f41b0621744d",
                                                "text": "The prisoner was saved from execution; the governor had requested a reprieve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529e4cd2-6f3c-3193-b070-95001c6bdbd6",
                                        "entry_id": "5bb49b82-33ca-3576-b073-348fee097e66",
                                        "glosses": [
                                            "A document authorizing such an action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c15fba6-631b-3548-819c-7dade5b69d7c",
                                        "entry_id": "5bb49b82-33ca-3576-b073-348fee097e66",
                                        "glosses": [
                                            "Relief from pain etc., especially temporary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9074cd7-ecec-43b4-8ca4-d19e08bf4d78",
                                                "sense_id": "7c15fba6-631b-3548-819c-7dade5b69d7c",
                                                "text": "Yet it was not easy, on the balance of play, to be convinced by Pellegrini and his defeated players that the reprieve might somehow be a defining moment over the two legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa4d794e-9cdd-34f0-a988-ec6259e1c9c7",
                                        "entry_id": "5bb49b82-33ca-3576-b073-348fee097e66",
                                        "glosses": [
                                            "A cancellation or postponement of a proposed event undesired by many."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ce5e46-4f8b-46a7-9ea8-2818f6d0475b",
                                                "sense_id": "aa4d794e-9cdd-34f0-a988-ec6259e1c9c7",
                                                "text": "At the time of writing the halts have been reprieved due to doubts as to the legality of the withdrawal of services. It is feared that this reprieve may not outlast the summer timetable which, on the section in question, provides only a skeleton of the former service."
                                            },
                                            {
                                                "example_id": "f40b7f09-4ae9-4a62-968a-9439c8b990d8",
                                                "sense_id": "aa4d794e-9cdd-34f0-a988-ec6259e1c9c7",
                                                "text": "And it said there was no reprieve for 435 stations already approved for closure before the report appeared."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
