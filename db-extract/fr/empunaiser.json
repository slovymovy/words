                "senses": [
                    {
                        "sense_id": "027e8ae3-586e-35a2-a217-13d778426a86",
                        "entry_id": "9129b1b2-f8e9-3d41-be2a-470aa1cef2be",
                        "glosses": [
                            "Empuantir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6f7985e0-3be6-40b7-990d-0a6804ec1a1a",
                                "sense_id": "027e8ae3-586e-35a2-a217-13d778426a86",
                                "text": "Aux chasseurs qui ne peuvent se donner le luxe de bâtir un vaste chenil et d’entretenir un nombreux équipage, il conseille de ne pas « négliger de mettre toujours près des chiens un vase plein d’eau qui ne soit fait ni d’airain ni de cuivre, parce que ces deux espèces de métaux sont vénéneuses de leur nature et font tourner et empunaiser soudainement l’eau qui leur serait grandement contraire. »"
                            },
                            {
                                "example_id": "89827c37-7bd9-4638-ac03-def407d419b7",
                                "sense_id": "027e8ae3-586e-35a2-a217-13d778426a86",
                                "text": "Elle devait empunaiser pire qu’un aquabouc et son entrefesson la brûlait."
                            }
                        ]
                    }
