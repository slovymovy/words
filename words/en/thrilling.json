{
    "word_family": [
        "thrill",
        "thriller"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d0d666e-ea4c-3343-934c-3517c5bd7ad7",
                    "sense_definition": "Causing a sudden feeling of excitement and pleasure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The roller coaster ride was a <w>thrilling</w> experience that left everyone screaming with joy.",
                            "target_lang_translations": {
                                "ru": "Поездка на американских горках была <w>захватывающим</w> приключением, заставившим всех кричать от радости."
                            }
                        },
                        {
                            "text": "We watched a <w>thrilling</w> adventure movie last night and couldn't take our eyes off the screen.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы смотрели <w>захватывающий</w> приключенческий фильм и не могли оторвать глаз от экрана."
                            }
                        }
                    ],
                    "synonyms": [
                        "exciting",
                        "exhilarating",
                        "electrifying"
                    ],
                    "antonyms": [
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "thrilling experience",
                        "thrilling adventure",
                        "thrilling ride"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий внезапное чувство волнения, восторга и удовольствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывающий",
                                "target_lang_sense_clarification": "вызывающий сильный интерес и волнение"
                            },
                            {
                                "target_lang_word": "волнующий",
                                "target_lang_sense_clarification": "приводящий в трепет или сильное волнение"
                            },
                            {
                                "target_lang_word": "упоительный",
                                "target_lang_sense_clarification": "доставляющий восторг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a27f90c-c9c6-34f0-ae45-3ee0a0a9e2c9",
                    "sense_definition": "Present participle and gerund of <w>thrill</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer was <w>thrilling</w> the audience with her powerful and emotional performance.",
                            "target_lang_translations": {
                                "ru": "Певица <w>приводила в восторг</w> публику своим мощным и эмоциональным выступлением."
                            }
                        },
                        {
                            "text": "He felt a sudden wave of excitement <w>thrilling</w> through his entire body.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал, как внезапная волна возбуждения <w>пробежала</w> по всему его телу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола thrill (волновать, возбуждать, трепетать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волнующий",
                                "target_lang_sense_clarification": "приводящий публику в восторг"
                            },
                            {
                                "target_lang_word": "пробегающий",
                                "target_lang_sense_clarification": "о чувстве, трепете в теле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bfe3609b-f846-30b9-bb62-077753d58781",
                    "sense_definition": "A sensation of excitement; a thrill.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt small <w>thrillings</w> of hope as she read the positive response.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала легкий <w>трепет</w> надежды, читая положительный ответ."
                            }
                        },
                        {
                            "text": "The quiet room was filled with the subtle <w>thrillings</w> of anticipation.",
                            "target_lang_translations": {
                                "ru": "Тихая комната была наполнена едва уловимым <w>трепетом</w> предвкушения."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrills",
                        "shivers",
                        "tingles"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущение волнения, трепета или восторга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "волнение или легкая дрожь от предвкушения"
                            },
                            {
                                "target_lang_word": "возбуждение",
                                "target_lang_sense_clarification": "прилив эмоций"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}