    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "457af040-4146-3849-b592-382f7318a145",
                "word": "jiff",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "792ed852-144f-447d-8414-9b3dbb0f4036",
                        "entry_id": "457af040-4146-3849-b592-382f7318a145",
                        "tags": [
                            "plural"
                        ],
                        "form": "jiffs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efc2f0e9-3b76-3891-8a66-23b7259a01d5",
                        "entry_id": "457af040-4146-3849-b592-382f7318a145",
                        "glosses": [
                            "A jiffy; a moment; a short time."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2f28290f-92e1-47ca-8397-e18a434eb988",
                                "sense_id": "efc2f0e9-3b76-3891-8a66-23b7259a01d5",
                                "text": "Oh, yerss. Come in. Half a jiff till I finished this bottom stair. Now then—whoa!—don't touch that banister; it's a bit loose."
                            },
                            {
                                "example_id": "238b20fc-1132-4dc5-b361-bf2171cbe38f",
                                "sense_id": "efc2f0e9-3b76-3891-8a66-23b7259a01d5",
                                "text": "You can keep Max company while I nip out for a jiff."
                            },
                            {
                                "example_id": "757f72e5-4df5-47f5-bfb9-7b11e047b725",
                                "sense_id": "efc2f0e9-3b76-3891-8a66-23b7259a01d5",
                                "text": "Tell my man, “The usual, plus a shot for the kid” / He did his bartender thizzle, got my order in a jif"
                            },
                            {
                                "example_id": "15dd7776-c315-4944-97f5-fc821f2fbe1b",
                                "sense_id": "efc2f0e9-3b76-3891-8a66-23b7259a01d5",
                                "text": "A lady's voice answered, “Be out in a jiff.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dec7b7dd-1c26-4e5e-9ea8-06c46f74738f",
                        "source_entry_id": "457af040-4146-3849-b592-382f7318a145",
                        "source_sense_id": "efc2f0e9-3b76-3891-8a66-23b7259a01d5",
                        "source_sense_description": "a moment; a short time",
                        "target_lang_word": "okamžik",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "okamžik",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd60e4a-971a-3008-9300-05a604d5ec71",
                                        "entry_id": "bd09a68d-f204-35ef-92b1-cf8ec9790f97",
                                        "glosses": [
                                            "krátký časový interval nebo bod na ose času"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e09982a-ec78-40cd-8112-a8c2cdb2c914",
                                                "sense_id": "3fd60e4a-971a-3008-9300-05a604d5ec71",
                                                "text": "Již za okamžik se na scéně objeví náš nejznámější herec."
                                            },
                                            {
                                                "example_id": "51714226-2bcf-408d-8fc4-fd33a30b1f93",
                                                "sense_id": "3fd60e4a-971a-3008-9300-05a604d5ec71",
                                                "text": "V okamžiku, kdy vítěz na koni proběhl cílem, byl jeho vzrušení konec."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
