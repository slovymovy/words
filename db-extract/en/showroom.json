                    },
                    {
                        "translation_id": "884ec31d-d2d7-4c91-bf2e-319bacac9ae2",
                        "source_entry_id": "c1228a39-f6e3-3746-aec7-7fa106240bac",
                        "source_sense_description": "room for display of products",
                        "target_lang_word": "Ausstellungsraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausstellungsraum",
                                "target_lang_code": "de",
