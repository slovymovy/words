                                "example_id": "13ddabbe-4459-4071-99fb-982d000741b8",
                                "sense_id": "da719d47-916b-3af8-9108-8b2021f170ea",
                                "text": "Op grond daarvan zult u aanstaande zondag bij zonsondergang gewichten om uw nek krijgen en verdronken worden in zee."
                            },
                            {
                                "example_id": "2f08d6ec-0892-4d51-b84a-1dd75225c505",
                                "sense_id": "da719d47-916b-3af8-9108-8b2021f170ea",
                                "text": "Bijna anderhalve dag waren deze zo geïsoleerde en schier verdronken eilanden, waarop tezamen 59."
                            }
                        ]
                    }
