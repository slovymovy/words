{
    "word_family": [
        "admission",
        "admittance",
        "admittedly",
        "admissible",
        "inadmissible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac041f9b-66e6-3ceb-8b8c-493ac34ba85e",
                    "sense_definition": "To concede as true; to acknowledge or assent to, as an allegation which it is impossible to deny.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "confession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finally decided to <w>admit</w> his guilt after the police showed him the evidence.",
                            "target_lang_translations": {
                                "ru": "Он наконец решил <w>признать</w> свою вину после того, как полиция предъявила ему улики."
                            }
                        },
                        {
                            "text": "She had to <w>admit</w> defeat when it became clear she could not win the race.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>признать</w> поражение, когда стало ясно, что она не сможет выиграть гонку."
                            }
                        }
                    ],
                    "synonyms": [
                        "confess",
                        "acknowledge",
                        "own",
                        "grant",
                        "own up"
                    ],
                    "antonyms": [
                        "deny",
                        "refute"
                    ],
                    "common_phrases": [
                        "admit defeat",
                        "admit guilt",
                        "admit a mistake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать что-либо истинным; подтверждать или соглашаться с утверждением, которое невозможно отрицать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "соглашаться с фактом"
                            },
                            {
                                "target_lang_word": "признать",
                                "target_lang_sense_clarification": "подтвердить истинность"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "соглашаться с возможностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fcecee8-9ba1-3eb3-b713-e67fe3e74e5e",
                    "sense_definition": "To allow to enter; to grant entrance to a place, or to allow a thought into consideration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "entrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard will <w>admit</w> guests only if they have a valid invitation.",
                            "target_lang_translations": {
                                "ru": "Охранник <w>впустит</w> гостей только при наличии действующего приглашения."
                            }
                        },
                        {
                            "text": "This ticket will <w>admit</w> one person to the theater for the evening performance.",
                            "target_lang_translations": {
                                "ru": "Этот билет дает право на <w>вход</w> одному человеку в театр на вечернее представление."
                            }
                        }
                    ],
                    "synonyms": [
                        "let in"
                    ],
                    "antonyms": [
                        "exclude",
                        "bar"
                    ],
                    "common_phrases": [
                        "admit one",
                        "admit entry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрешать войти; предоставлять право входа в помещение или позволять какой-либо мысли быть рассмотренной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впускать",
                                "target_lang_sense_clarification": "давать войти"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "давать доступ"
                            },
                            {
                                "target_lang_word": "пускать",
                                "target_lang_sense_clarification": "разрешать проход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3db43b97-b8ed-3d29-9530-c625a35208dc",
                    "sense_definition": "To allow to enter a hospital or similar facility for medical treatment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was <w>admitted</w> to the hospital late last night for emergency surgery.",
                            "target_lang_translations": {
                                "ru": "Пациент был <w>госпитализирован</w> в больницу поздно вечером для экстренной операции."
                            }
                        },
                        {
                            "text": "Doctors decided to <w>admit</w> her for observation after she complained of chest pains.",
                            "target_lang_translations": {
                                "ru": "Врачи решили <w>положить</w> её в больницу для наблюдения после того, как она пожаловалась на боли в груди."
                            }
                        }
                    ],
                    "synonyms": [
                        "let in"
                    ],
                    "antonyms": [
                        "discharge"
                    ],
                    "common_phrases": [
                        "admitted to hospital",
                        "admitted for observation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать в больницу или аналогичное учреждение для прохождения медицинского лечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "госпитализировать",
                                "target_lang_sense_clarification": "класть в больницу"
                            },
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "оформлять пациента"
                            },
                            {
                                "target_lang_word": "положить",
                                "target_lang_sense_clarification": "в стационар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7e356d8-5475-369c-8645-8fcf67eb367c",
                    "sense_definition": "To allow someone to enter a profession or to enjoy a specific privilege or franchise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>admitted</w> to the bar and can now practice law in this state.",
                            "target_lang_translations": {
                                "ru": "Он был <w>принят</w> в коллегию адвокатов и теперь может заниматься юридической практикой в этом штате."
                            }
                        },
                        {
                            "text": "The committee will <w>admit</w> new members to the society during the annual meeting.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>примет</w> новых членов в общество во время ежегодного собрания."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "disbar",
                        "expel"
                    ],
                    "common_phrases": [
                        "admitted to the bar",
                        "admitted to practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрешать кому-либо вступить в профессию или наделить определенной привилегией или правом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "в члены организации"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "к практике или деятельности"
                            },
                            {
                                "target_lang_word": "принять",
                                "target_lang_sense_clarification": "в сообщество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f06f4407-4367-32de-8bad-1c0dd9d9d327",
                    "sense_definition": "To be capable of or to permit; often used with 'of'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The current situation does not <w>admit</w> of any further delay in our decision.",
                            "target_lang_translations": {
                                "ru": "Текущая ситуация не <w>допускает</w> дальнейших задержек в принятии нашего решения."
                            }
                        },
                        {
                            "text": "The rules of the game <w>admit</w> no exceptions, regardless of the circumstances.",
                            "target_lang_translations": {
                                "ru": "Правила игры не <w>допускают</w> исключений, независимо от обстоятельств."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "preclude"
                    ],
                    "common_phrases": [
                        "admit of",
                        "admit no delay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть способным вместить или допускать что-либо; часто используется с предлогом 'of'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "делать возможным"
                            },
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "давать возможность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
