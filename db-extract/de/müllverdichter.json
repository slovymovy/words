                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ed2423-5422-4f42-808b-70b224b707ed",
                                "sense_id": "b043be24-e196-3c90-a1bd-2e593f30ad9f",
                                "text": "„Mit Einsatz Hand Müllverdichter Reduzierung des Volumens bis zu 50%*“"
                            },
                            {
                                "example_id": "479afd0e-b598-413a-b60d-fb2675bcd0b2",
                                "sense_id": "b043be24-e196-3c90-a1bd-2e593f30ad9f",
                                "text": "„Der Müllverdichter CP 1100 wird mit 220 V betrieben und lässt sich daher überall aufgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9848fe41-e587-3a40-997d-9ae9ba70aa17",
                        "entry_id": "4ba113be-647e-37f1-9912-c819fabbb397",
                        "glosses": [
                            "spezielles Fahrzeug, das durch sein Eigengewicht den überfahrenen Müll zerkleinert und verdichtet; Müllkompaktor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8951aaee-cb7d-4a69-8f27-f4aef93c7ae7",
                                "sense_id": "9848fe41-e587-3a40-997d-9ae9ba70aa17",
                                "text": "„Dennoch weiß man auch bei BOMAG, dass die neue Generation von Müllverdichtern mit einer Tagesleistung von annähernd 300 t verdichtetem Müll hauptsächlich auf kleineren bis mittleren Deponien zum Einsatz kommen wird.“"
                            },
                            {
                                "example_id": "fe36ecb3-1267-44c6-9392-97c3a5f99e6e",
                                "sense_id": "9848fe41-e587-3a40-997d-9ae9ba70aa17",
                                "text": "„Kategorien, in denen sich sowohl die schemelgelenkte 7t-Tandemwalze Bomag BW 154 AP als auch der Müllverdichter BC 472 RS eine exponierte Stellung sichern konnten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
