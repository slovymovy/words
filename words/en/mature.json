                {
                    "sense_id": "67501972-7195-39b0-b5c4-c1780c484a37",
                    "sense_definition": "Suitable for adults only, often due to sexual themes or violence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "content_rating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie contains <w>mature</w> themes and is not suitable for children.",
                            "target_lang_translations": {
                                "ru": "Фильм содержит темы <w>для взрослых</w> и не подходит для детей.",
                                "zh": "这部电影包含<w>成人</w>主题，不适合儿童观看。"
                            }
                        },
                        {
                            "text": "This video game is rated for a <w>mature</w> audience only.",
                            "target_lang_translations": {
                                "ru": "Эта видеоигра рассчитана только на <w>взрослую</w> аудиторию.",
                                "zh": "这款电子游戏仅限<w>成人</w>玩家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "for adults",
                        "adult"
                    ],
                    "common_phrases": [
                        "mature content",
                        "mature audience",
                        "rated mature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный только для взрослых (из-за откровенных тем или насилия).",
                        "zh": "仅适合成年人，通常是因为涉及性主题或暴力内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для взрослых",
                                "target_lang_sense_clarification": "категория контента"
                            },
                            {
                                "target_lang_word": "взрослый",
                                "target_lang_sense_clarification": "не для детей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成人",
                                "target_lang_sense_clarification": "指适合成年人的内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67b69f6a-df28-3d24-978f-e0cf9c76cd20",
                    "sense_definition": "Carefully considered, profound, and fully formed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_completion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After <w>mature</w> consideration, the committee decided to approve the proposal.",
                            "target_lang_translations": {
                                "ru": "После <w>тщательного</w> рассмотрения комитет решил одобрить предложение.",
                                "zh": "经过<w>深思熟虑</w>，委员会决定批准该提案。"
                            }
                        },
                        {
                            "text": "They developed a <w>mature</w> strategy to expand the business globally.",
                            "target_lang_translations": {
                                "ru": "Они разработали <w>продуманную</w> стратегию для глобального расширения бизнеса.",
                                "zh": "他们制定了一项<w>成熟</w>的全球业务扩张战略。"
                            }
                        }
                    ],
                    "antonyms": [
                        "superficial"
                    ],
                    "common_phrases": [
                        "mature consideration",
                        "mature judgment",
                        "mature plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно обдуманный, глубокий и сформированный.",
                        "zh": "经过仔细考虑、深刻且完全形成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продуманный",
                                "target_lang_sense_clarification": "о плане, стратегии"
                            },
                            {
                                "target_lang_word": "взвешенный",
                                "target_lang_sense_clarification": "о решении"
                            },
                            {
                                "target_lang_word": "зрелый",
                                "target_lang_sense_clarification": "о размышлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深思熟虑",
                                "target_lang_sense_clarification": "指经过充分考虑的"
                            },
                            {
                                "target_lang_word": "成熟",
                                "target_lang_sense_clarification": "指计划或想法完善"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "913256e5-18e7-382a-bd69-0fee922cbe75",
                    "sense_definition": "To become fully grown or developed physically or mentally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human_development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As children <w>mature</w>, they start to understand the world differently.",
                            "target_lang_translations": {
                                "ru": "По мере того как дети <w>взрослеют</w>, они начинают понимать мир по-другому.",
                                "zh": "随着孩子逐渐<w>成熟</w>，他们开始以不同的方式理解世界。"
                            }
                        },
                        {
                            "text": "He will <w>mature</w> into a responsible adult over time.",
                            "target_lang_translations": {
                                "ru": "Со временем он <w>повзрослеет</w> и станет ответственным взрослым.",
                                "zh": "随着时间的推移，他会<w>成熟</w>起来，成为一个有责任感的成年人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grow up",
                        "develop",
                        "age"
                    ],
                    "common_phrases": [
                        "mature quickly",
                        "mature into",
                        "start to mature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться взрослым, развиваться физически или умственно.",
                        "zh": "指在身体或心理上完全成长或发育。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрослеть",
                                "target_lang_sense_clarification": "становиться старше"
                            },
                            {
                                "target_lang_word": "созревать",
                                "target_lang_sense_clarification": "развиваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成熟",
                                "target_lang_sense_clarification": "指人或生物的成长过程"
                            },
                            {
                                "target_lang_word": "长大",
                                "target_lang_sense_clarification": "指人逐渐成年"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44cde552-547d-3732-91cc-c45a2951ae97",
                    "sense_definition": "To reach a state of full readiness or ripeness, such as fruit or wine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_ripeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wine needs to <w>mature</w> in oak barrels for several years.",
                            "target_lang_translations": {
                                "ru": "Вино должно <w>выдерживаться</w> в дубовых бочках несколько лет.",
                                "zh": "这种酒需要在橡木桶中<w>陈酿</w>几年。"
                            }
                        },
                        {
                            "text": "These tomatoes will <w>mature</w> faster if you keep them in the sun.",
                            "target_lang_translations": {
                                "ru": "Эти помидоры <w>созреют</w> быстрее, если держать их на солнце.",
                                "zh": "如果你把这些西红柿放在阳光下，它们会<w>成熟</w>得更快。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ripen",
                        "develop"
                    ],
                    "common_phrases": [
                        "allow to mature",
                        "mature in casks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигать состояния полной готовности или спелости (о фруктах, вине).",
                        "zh": "达到完全准备好或成熟的状态，如水果或葡萄酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "созревать",
                                "target_lang_sense_clarification": "о плодах"
                            },
                            {
                                "target_lang_word": "выдерживаться",
                                "target_lang_sense_clarification": "о вине"
                            },
                            {
                                "target_lang_word": "зреть",
                                "target_lang_sense_clarification": "процесс созревания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成熟",
                                "target_lang_sense_clarification": "指果实等发育完全"
                            },
                            {
                                "target_lang_word": "陈酿",
                                "target_lang_sense_clarification": "指酒类经过时间达到最佳状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20b55115-3bd2-314b-a57c-33552a08c92c",
                    "sense_definition": "To reach the date when a financial bond or investment becomes payable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financial_maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the savings bond <w>matures</w>, you can cash it in for the full value.",
                            "target_lang_translations": {
                                "ru": "Когда сберегательная облигация <w>погашается</w>, вы можете обналичить ее за полную стоимость.",
                                "zh": "当储蓄债券<w>到期</w>时，你可以按全额兑现。"
                            }
                        },
                        {
                            "text": "The insurance policy <w>matures</w> after twenty years of payments.",
                            "target_lang_translations": {
                                "ru": "Срок действия страхового полиса <w>истекает</w> после двадцати лет выплат.",
                                "zh": "这份保险单在缴费二十年后<w>到期</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bond matures",
                        "investment matures"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наступать (о сроке платежа по финансовым обязательствам).",
                        "zh": "指金融债券或投资达到应付日期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлежать погашению",
                                "target_lang_sense_clarification": "о ценных бумагах"
                            },
                            {
                                "target_lang_word": "истекать",
                                "target_lang_sense_clarification": "о сроке действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到期",
                                "target_lang_sense_clarification": "指金融产品期限届满"
                            }
                        ]
                    }
                }
            ]
        }
