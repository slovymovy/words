                    {
                        "form_id": "7cb6358c-55a4-4683-9dc0-e4114b0f15ad",
                        "entry_id": "a29e0365-0c01-39ef-a108-d8c2e3cedd1d",
                        "tags": [
                            "plural"
                        ],
                        "form": "spaghetti"
