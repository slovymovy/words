                "senses": [
                    {
                        "sense_id": "4e662fb1-37be-3458-b328-9520e1249197",
                        "entry_id": "b82faed2-07bb-3555-a968-76a29ac873d5",
                        "glosses": [
                            "ein indigenes Volk Nordjapans"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2a8c4d82-1bc3-4ff1-8d22-68cbe0ec91ec",
                                "sense_id": "4e662fb1-37be-3458-b328-9520e1249197",
                                "text": "„Heute nennen sich die Ainu selbst Ainu oder Utari.“"
                            },
                            {
                                "example_id": "38919186-1925-4fb2-919a-6fa7267f9982",
                                "sense_id": "4e662fb1-37be-3458-b328-9520e1249197",
                                "text": "„Die Ainu schenkten dem Bären besondere Verehrung, in ihrer Vorstellung wurde der Bär mit einem Dank der Menschen an alle Bären nach Hause gesandt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d31ee0d-a756-328e-8290-9704d0a5bc0a",
                        "entry_id": "b82faed2-07bb-3555-a968-76a29ac873d5",
                        "glosses": [
                            "Angehöriger des gleichnamigen Volkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d960c2d-c32d-430b-a5a3-a26ac97a51fc",
                                "sense_id": "9d31ee0d-a756-328e-8290-9704d0a5bc0a",
                                "text": "„Im Alltag sprechen fast alle Ainu Japanisch.“"
                            },
                            {
                                "example_id": "aaaaf395-181d-42f5-84fc-b4b2c51a6930",
                                "sense_id": "9d31ee0d-a756-328e-8290-9704d0a5bc0a",
                                "text": "„Trotz der Missstände schafften es einige Ainu, teils mit der Hilfe des englischen Missionärs und Ainu-Forschers, teils aus eigener Kraft, in den 20er Jahren des 20. Jahrhunderts eine Schicht von Intellektuellen zu bilden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
