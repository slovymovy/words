                        "entry_id": "22119c2a-9bf4-37b9-9fa8-2b6099245843",
                        "glosses": [
                            "an instance of relative success that garners respect (e.g. by exceeding expectations) despite the primary aim not being achieved"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "55518e1f-884a-4a3f-b543-9b4c313961a1",
                                "sense_id": "5d25fedd-b4c6-3ad4-b558-5d76fa987ddd",
                                "text": "Mit Raketenangriffen auf russische Ziele gelingt den Ukrainern über die Feiertage ein Achtungserfolg. Doch das darf nicht darüber hinwegtäuschen, dass die Lage an der Front für Kiew eigentlich bedrückend ist."
                            }
                        ]
                    }
