                "senses": [
                    {
                        "sense_id": "ca089781-1b5e-3e40-a596-69b12e64dfd4",
                        "entry_id": "fcd7fe68-2a4f-399c-a0bf-52019075afe5",
                        "glosses": [
                            "Person, die in einer Oase lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643362ba-b6fd-401b-8b7f-5f54754cdd65",
                                "sense_id": "ca089781-1b5e-3e40-a596-69b12e64dfd4",
                                "text": "„Nach dem Essen holen die Oasenbewohner Trommeln und eine Ud, ein arabisches Saiteninstrument.“"
                            },
                            {
                                "example_id": "40722efb-a320-4163-a68a-d27e4b0ef322",
                                "sense_id": "ca089781-1b5e-3e40-a596-69b12e64dfd4",
                                "text": "„1631 schworen die Oasenbewohner der Dynastie ihre Treue.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0d5aa6f-5e04-4c50-9566-687501f39ad1",
                        "source_entry_id": "fcd7fe68-2a4f-399c-a0bf-52019075afe5",
                        "source_sense_id": "ca089781-1b5e-3e40-a596-69b12e64dfd4",
                        "source_sense_description": "Person, die in einer Oase lebt",
                        "target_lang_word": "oasien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oasien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23a4ea7f-81d5-3591-a4e3-7aa1079b6eb2",
                                        "entry_id": "8b5d8469-1e07-3a0f-944e-ce8dd73676f6",
                                        "glosses": [
                                            "Relatif à une oasis."
                                        ],
                                        "tags": [
                                            "Ethnobiologie",
                                            "Hydrobiologie",
                                            "Mésologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca687cdd-2581-4d2b-b3e3-0b79a670b216",
                                                "sense_id": "23a4ea7f-81d5-3591-a4e3-7aa1079b6eb2",
                                                "text": "Une autre constante de la structure oasienne est le travail en planches de culture, une organisation de l’espace appropriée à l’irrigation par inondation."
                                            },
                                            {
                                                "example_id": "1ef2fcd9-7c8a-4a00-9a53-0b65737fd72b",
                                                "sense_id": "23a4ea7f-81d5-3591-a4e3-7aa1079b6eb2",
                                                "text": "«Les régions oasiennes ont connu, pendant le XXᵉ siècle, des mutations socio-économico-spatiales et des crises climatiques marquées par de grandes sécheresses qui se sont reflétées sur les écosystèmes oasiens»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oasien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a98dd22a-4df2-3208-93f3-cebba4faab36",
                                        "entry_id": "4f7e3b2e-7632-3e51-bb97-1568fdfa1c65",
                                        "glosses": [
                                            "Habitant d’une oasis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5c9c1d-baf7-484d-98da-110ede58079c",
                                                "sense_id": "a98dd22a-4df2-3208-93f3-cebba4faab36",
                                                "text": "Un pauvre oasien de l’Oudiane, dont j'avais remarqué le jardin desséché et les palmiers morts de soif, me raconta comment de onze gadouz par quinzaine laissées à sa petite palmeraie par son arrière-grand-père, il avait été successivement réduit à huit et à six, et, enfin, à quatre par mois."
                                            },
                                            {
                                                "example_id": "19d43536-ce9f-4d0c-934f-0d7058d88d17",
                                                "sense_id": "a98dd22a-4df2-3208-93f3-cebba4faab36",
                                                "text": "La gestion durable de l’écosystème oasien trouve son originalité dans la vie culturelle de l’oasien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
