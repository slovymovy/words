                    "sense_id": "23336cc6-ec01-3b6d-8388-e5076f0a1293",
                    "sense_definition": "A dangerous, difficult, or otherwise unfortunate situation.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary highlighted the desperate <w>plight</w> of refugees fleeing the war zone.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм осветил отчаянное <w>бедственное положение</w> беженцев, бегущих из зоны военных действий.",
                                "it": "Il documentario ha messo in luce la disperata <w>condizione</w> dei rifugiati in fuga dalla zona di guerra."
                            }
                        },
                        {
                            "text": "We must do something to improve the economic <w>plight</w> of the region's farmers.",
                            "target_lang_translations": {
                                "ru": "Мы должны сделать что-то, чтобы улучшить тяжёлое экономическое <w>положение</w> фермеров региона.",
                                "it": "Dobbiamo fare qualcosa per migliorare la difficile <w>situazione</w> economica degli agricoltori della regione."
                            }
                        }
                    ],
                    "synonyms": [
                        "predicament",
                        "quandary",
                        "difficulty",
                        "trouble"
                    ],
                    "antonyms": [
                        "blessing",
                        "advantage",
                        "benefit"
                    ],
                    "common_phrases": [
                        "desperate plight",
                        "sad plight",
                        "economic plight",
                        "sorry plight"
                    ],
                    "target_lang_definitions": {
