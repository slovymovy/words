                        ],
                        "form": "отступа́я"
                    },
                    {
                        "form_id": "0e711b04-6683-4045-9297-60b743a6f5f9",
                        "entry_id": "9b374e33-d59d-36cf-af6e-653d986f3feb",
                        "tags": [
                            "adverbial",
                            "participle",
