                "senses": [
                    {
                        "sense_id": "7ebda91a-776b-3480-a651-5fda2fa5aa3d",
                        "entry_id": "2c102643-6327-3beb-bee9-a49f9771481d",
                        "glosses": [
                            "Faire l'éloge publique de ; louanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0324305f-cea4-4178-a0ab-aa0abaf6a19a",
                                "sense_id": "7ebda91a-776b-3480-a651-5fda2fa5aa3d",
                                "text": "[…] ; semblables à ces Prédicateurs, qui éxagèrent éternellement la supériorité du Saint qu'ils panégyrisent."
                            },
                            {
                                "example_id": "b51d0068-fb1d-4077-9a07-d04cb0553191",
                                "sense_id": "7ebda91a-776b-3480-a651-5fda2fa5aa3d",
                                "text": "Elle panégyrise trop la liberté absolue pour ne pas la vouloir, elle sait comment les choses se sont passées autrefois, mais elle ne sait pas comment elles se passent aujourd’hui pour mieux nous affirmer comment elles se passeront dans un avenir inconnu."
                            },
                            {
                                "example_id": "c1698a42-3417-4967-914e-bb1eeb00636c",
                                "sense_id": "7ebda91a-776b-3480-a651-5fda2fa5aa3d",
                                "text": "Alexandre Bolesco, frère du précédent, a l'esprit mathématique, sentimental, dialecticien, surpris, troublé, enthousiasmé tout à la fois. Sans cesser de marcher, il discute des problèmes, panégyrise les grands hommes, harangue la belle nature, et intente des questions hors de portée aux pauvres habitants des campagnes."
                            }
                        ]
                    }
                ],
