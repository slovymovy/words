                    {
                        "sense_id": "6e50b2c5-c94a-32b9-bc0f-6ec080a490d5",
                        "entry_id": "189a37ed-8c14-37b3-a442-f9902063460d",
                        "glosses": [
                            "als Dienstwaffe dienende Pistole"
