                            {
                                "target_word": "denté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6adde56-7d1d-3389-93bc-45ace716e53b",
                                        "entry_id": "f8e3e5f1-eeb6-3394-ae01-3fd345645862",
                                        "glosses": [
                                            "Qui a des pointes en forme de dents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c21211c-3158-45ae-8750-c9f30eed4d15",
                                                "sense_id": "b6adde56-7d1d-3389-93bc-45ace716e53b",
                                                "text": "Roue dentée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                        "entry_id": "f8e3e5f1-eeb6-3394-ae01-3fd345645862",
                                        "glosses": [
                                            "Dont le bord est découpé en pointes serrées les unes contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8875d17-ec0f-449c-8609-2918be3c636d",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "Sibbaldie, […]. Ce genre , qui est figuré pl. 221 des Illustrations de Lamarck, renferme des herbes à feuilles ternées, à folioles simples, dentées et découpées; à fleurs axillaires et terminales, quelquefois décagynes."
                                            },
                                            {
                                                "example_id": "2aca0908-e348-4e75-9b37-b01ea55cc5ee",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "[…], et dans ce cas, elles offrent tellement toutes les particularités propres aux feuilles, qu'on peut dire qu'elles ne sont que de petites feuilles accessoires, tantôt pétiolées, plus souvent sessiles, tantôt entières, tantôt dentées ou lobées, à nervures pennées ou palmées, etc.; mais on n'en trouve aucune qui soit ni composée, ni peltinerve, ni pédalinerve."
                                            },
                                            {
                                                "example_id": "4e90bd53-9ee7-4ac1-9c15-02f80792aa2b",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "Feuille dentée en scie, Feuille dont les dents sont dirigées, inclinées vers le sommet."
                                            },
                                            {
                                                "example_id": "86a2729c-0836-4568-afb4-84be1d6bd681",
                                                "sense_id": "6b8d285d-761e-3fca-a1ef-99082b1e9e2b",
                                                "text": "Les feuilles du pêcher, de l’amandier sont dentées en scie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "denté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e89014c-d5ab-3d97-93fd-b54b3d13256d",
                                        "entry_id": "3286b7aa-bf85-3b60-a1b0-3bf92c164098",
                                        "glosses": [
                                            "Espèce de poisson osseux marin carnivore, un sparidé aux dents nombreuses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "736da122-1874-4f66-93f2-1b2eafb4f19e",
                        "source_entry_id": "f8ed6535-698b-3993-b0a4-7ec12a9d8d13",
                        "source_sense_description": "saw-like",
                        "target_lang_word": "dentelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3acf7c85-0d01-33d4-bfe2-728b1280dc35",
                                        "entry_id": "56c2fde5-c0a7-3ee1-b13f-ebffa360bc26",
                                        "glosses": [
                                            "Dont le bord est découpé en dents irrégulières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed70a7a3-f620-40ef-b589-8f8b92968cc2",
                                                "sense_id": "3acf7c85-0d01-33d4-bfe2-728b1280dc35",
                                                "text": "Partout des gazes blanches ou peintes comme les ailes des plus jolies libellules, des crêpes, des dentelles, des blondes, des tulles variés comme les fantaisies de la nature entomologique, découpés, ondés, dentelés, des fils d’aranéide en or, en argent, des brouillards de soie, des fleurs brodées par les fées ou fleuries par des génies emprisonnés, des plumes colorées par les feux du tropique, en saule pleureur autour des têtes orgueilleuses, des perles tordues en nattes, des étoffes laminées, côtelées, déchiquetées, comme si le génie des arabesques avait conseillé l’industrie française."
                                            },
                                            {
                                                "example_id": "ee80aa48-68b7-4589-a407-b071d7a15c51",
                                                "sense_id": "3acf7c85-0d01-33d4-bfe2-728b1280dc35",
                                                "text": "La feuille de l’orme est dentelée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                                        "entry_id": "56c2fde5-c0a7-3ee1-b13f-ebffa360bc26",
                                        "glosses": [
                                            "Dont le bord est découpé en petites dents fines et serrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8e7fe4-530c-4b2b-bd4b-ca891b0a309b",
                                                "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                                                "text": "Médaille dentelée."
                                            },
                                            {
                                                "example_id": "ac805c7e-7e16-4bef-b2f6-733f7d95025b",
                                                "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                                                "text": "Pièce de blason dentelée."
                                            },
                                            {
                                                "example_id": "cf9a3fe6-37a4-481c-b69a-0bc8fa0544ad",
                                                "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                                                "text": "Timbre dentelé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968730ca-80ce-311e-8e64-7c5e020ee4b4",
                                        "entry_id": "56c2fde5-c0a7-3ee1-b13f-ebffa360bc26",
                                        "glosses": [
                                            "Caractérisé par de petits pans alignés et serrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d92957c1-2131-4390-ac17-2b44ee8d40c4",
                                                "sense_id": "968730ca-80ce-311e-8e64-7c5e020ee4b4",
                                                "text": "La photo, ancienne, avec des bords dentelés, montrait un groupe d'ouvriers alignés sur trois rangs, regardant l'objectif, tous en casquette."
                                            }
                                        ]
                                    }
                                ]
                            },
