{
    "word_family": [
        "embarrassment",
        "embarrassing",
        "embarrassed",
        "unembarrassed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3d2f27f-56ab-33ae-85c1-aa0b1fff1bcf",
                    "sense_definition": "To cause someone to feel self-conscious, ashamed, or awkward, especially in front of others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd's laughter and jeers <w>embarrassed</w> him during his first public speech.",
                            "target_lang_translations": {
                                "ru": "Смех и насмешки толпы <w>смутили</w> его во время его первого публичного выступления."
                            }
                        },
                        {
                            "text": "Please do not <w>embarrass</w> yourself by making a scene in this quiet restaurant.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>позорься</w>, устраивая сцену в этом тихом ресторане."
                            }
                        }
                    ],
                    "synonyms": [
                        "abash",
                        "discomfit",
                        "disconcert",
                        "humiliate",
                        "shame"
                    ],
                    "antonyms": [
                        "comfort",
                        "encourage",
                        "reassure"
                    ],
                    "common_phrases": [
                        "embarrass yourself",
                        "deeply embarrass",
                        "embarrass someone publicly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать неловкость, стыд или замешательство, особенно в присутствии других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смущать",
                                "target_lang_sense_clarification": "вызывать чувство неловкости или робости"
                            },
                            {
                                "target_lang_word": "позорить",
                                "target_lang_sense_clarification": "вызывать чувство стыда, бесчестить"
                            },
                            {
                                "target_lang_word": "вводить в краску",
                                "target_lang_sense_clarification": "заставлять покраснеть от стыда или неловкости"
                            },
                            {
                                "target_lang_word": "конфузить",
                                "target_lang_sense_clarification": "приводить в замешательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70b6987f-1ed6-334c-8174-2bda25da5717",
                    "sense_definition": "To cause mental confusion or to make someone feel disconcerted or caught off guard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected question seemed to <w>embarrass</w> the witness, who struggled to find an answer.",
                            "target_lang_translations": {
                                "ru": "Неожиданный вопрос, казалось, <w>смутил</w> свидетеля, который с трудом пытался найти ответ."
                            }
                        },
                        {
                            "text": "Complex technical details can often <w>embarrass</w> the logic of a simple argument.",
                            "target_lang_translations": {
                                "ru": "Сложные технические детали часто могут <w>запутать</w> логику простого аргумента."
                            }
                        }
                    ],
                    "synonyms": [
                        "disconcert",
                        "discomfit",
                        "shame"
                    ],
                    "antonyms": [
                        "clarify",
                        "enlighten"
                    ],
                    "common_phrases": [
                        "embarrass the mind",
                        "mentally embarrass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать замешательство или приводить в растерянность, заставая врасплох."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смущать",
                                "target_lang_sense_clarification": "приводить в замешательство или недоумение"
                            },
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "запутывать, мешать ясно мыслить"
                            },
                            {
                                "target_lang_word": "озадачивать",
                                "target_lang_sense_clarification": "ставить в тупик сложным вопросом или ситуацией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcb990de-77ee-3dbf-af76-be342aa86aba",
                    "sense_definition": "To cause financial difficulties or to burden someone or a business with debt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A man or his business is <w>embarrassed</w> when he cannot meet his pecuniary engagements.",
                            "target_lang_translations": {
                                "ru": "Человек или его бизнес <w>оказываются в затруднительном положении</w>, когда он не может выполнить свои денежные обязательства."
                            }
                        },
                        {
                            "text": "The sudden drop in stock prices will <w>embarrass</w> the company's ability to pay its creditors.",
                            "target_lang_translations": {
                                "ru": "Внезапное падение цен на акции <w>затруднит</w> способность компании платить своим кредиторам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "financially embarrassed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in passive voice or as an adjective in financial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать финансовые трудности или обременять человека или бизнес долгами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затруднять",
                                "target_lang_sense_clarification": "создавать финансовые препятствия"
                            },
                            {
                                "target_lang_word": "обременять",
                                "target_lang_sense_clarification": "накладывать долговые обязательства"
                            },
                            {
                                "target_lang_word": "ставить в тяжелое положение",
                                "target_lang_sense_clarification": "о финансовом состоянии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6368119-ceda-3411-a757-24afdf466534",
                    "sense_definition": "To hinder, impede, or obstruct the progress or movement of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The motion was advanced in order to <w>embarrass</w> the progress of the bill in parliament.",
                            "target_lang_translations": {
                                "ru": "Предложение было выдвинуто для того, чтобы <w>замедлить</w> продвижение законопроекта в парламенте."
                            }
                        },
                        {
                            "text": "Heavy snow will <w>embarrass</w> the movement of troops across the mountain pass.",
                            "target_lang_translations": {
                                "ru": "Сильный снегопад <w>затруднит</w> передвижение войск через горный перевал."
                            }
                        }
                    ],
                    "synonyms": [
                        "humiliate"
                    ],
                    "antonyms": [
                        "facilitate",
                        "assist",
                        "expedite"
                    ],
                    "common_phrases": [
                        "embarrass the progress"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "this sense is less common in modern everyday English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствовать, мешать или затруднять прогресс или движение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать помехи движению или развитию"
                            },
                            {
                                "target_lang_word": "затруднять",
                                "target_lang_sense_clarification": "делать процесс более сложным"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "служить преградой"
                            }
                        ]
                    }
                }
            ]
        },
