                    {
                        "sense_id": "310d79ae-ac32-3a0c-a705-3cda8a9889a2",
                        "entry_id": "755e8dcd-eb5e-3585-b77c-5491a4e04eaa",
                        "glosses": [
                            "a glass container"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "09db61b8-e469-443a-bdbe-05008691741b",
                                "sense_id": "310d79ae-ac32-3a0c-a705-3cda8a9889a2",
                                "text": "Eine gläserne, grüne Burke von etwa 25 Pfd. Inhalt — Fig. 1"
                            },
                            {
                                "example_id": "dfc9dd71-48c9-42b0-abde-2285c58ca94e",
                                "sense_id": "310d79ae-ac32-3a0c-a705-3cda8a9889a2",
                                "text": "Man nimmt eine bestimmte Menge der Fermentlösung und ein bestimmtes Milchvolumen, füllt mit diesem Gemische ein gewöhnliches Reagenzglas, in welches ein Thermometer gestellt wird, und legt das Glas bei gewisser Temperatur in eine Burke mit Wasser."
                            },
                            {
                                "example_id": "e7f3078a-c03b-4374-8a05-4f8a09937cbd",
                                "sense_id": "310d79ae-ac32-3a0c-a705-3cda8a9889a2",
                                "text": "Trockene Aetzalkalien hebt man auf in einer Burke mit mit Vaseline eingeschmiertem [...]"
                            }
                        ]
                    }
                ],
