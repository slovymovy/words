                                    },
                                    {
                                        "sense_id": "51b99bfc-8a42-30a9-99fd-8c6e4f3f076e",
                                        "entry_id": "5ece8680-a3e3-3ad6-8365-30a9c8d3899e",
                                        "glosses": [
                                            "One of three equal parts of a whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "159d3120-0655-45f9-844d-69a67e798c76",
                                                "sense_id": "51b99bfc-8a42-30a9-99fd-8c6e4f3f076e",
                                                "text": "He ate a third of the pie. Divided by two-thirds."
                                            },
                                            {
                                                "example_id": "8c547e5d-0446-4edb-9eb7-197fd2e69f25",
                                                "sense_id": "51b99bfc-8a42-30a9-99fd-8c6e4f3f076e",
                                                "text": "Around a third of both Black and White respondents said they believed the opposition Labour Party to be institutionally racist."
                                            },
                                            {
                                                "example_id": "9a9bb91d-d5a1-4837-aa4f-d46ffe8748cb",
                                                "sense_id": "51b99bfc-8a42-30a9-99fd-8c6e4f3f076e",
                                                "text": "Despite these uncertainties, Clarke told MPs he was convinced of the need to order trains powered by batteries. He said: \"We're calling for a 'no regrets' order of battery trains because we see them always having a future. We see them being fundable, financeable, similar cost to diesel trains, and we know that however much electrification we would aspire to do, there's always going to be at least a third of the network that isn't electrified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29390703-744a-3e1a-9df3-e1409f23cefa",
                                        "entry_id": "5ece8680-a3e3-3ad6-8365-30a9c8d3899e",
                                        "glosses": [
                                            "The third gear of a gearbox."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
