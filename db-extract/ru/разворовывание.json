                                    {
                                        "sense_id": "8d03782b-6cce-32da-b035-9dd61b98626a",
                                        "entry_id": "676aac70-e351-3ce5-b8e8-3c10a5a25603",
                                        "glosses": [
                                            "The individual act or recurring practice of stealing items of low value, especially in small quantities, for which the legal term is petty theft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d969e70-7992-46c4-9984-055bf6d0b7d0",
                                                "sense_id": "8d03782b-6cce-32da-b035-9dd61b98626a",
                                                "text": "Sir Thomas Royden, Chairman of the L.M.S.R., and Mr. Robert Holland-Martin, Chairman of the Southern Railway, both deplored the wholesale robbery and petty pilferage which have increased until they have reached appalling dimensions."
                                            },
                                            {
                                                "example_id": "35066c4a-380a-4fe5-8894-5948e6ac9f6a",
                                                "sense_id": "8d03782b-6cce-32da-b035-9dd61b98626a",
                                                "text": "Still, there is pilferage, mysterious discrepancies eating into the percentages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1077d23f-f69b-4d26-8e8b-3f390821e13f",
                        "source_entry_id": "18b4a642-9bcc-3841-b0f9-fc953709cc31",
                        "source_sense_id": "b5aa7e13-ae7b-33f4-9fa9-6939983d924f",
                        "target_lang_word": "plundering",
                        "target_lang_code": "nl",
