                                        "glosses": [
                                            "das Kennzeichnen von etwas; das Markieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd0ceba7-34fc-4b83-9c28-85881b66d1f6",
                                                "sense_id": "f13ed0d2-8270-3207-b40c-3d5ac23f4a15",
                                                "text": "Die Lehrer übernehmen die Markierung der Wanderwege für die Schnitzeljagd der Schüler."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e1b6eb3-64a1-308e-b8df-36773fd725bb",
                                        "entry_id": "cc03d4ef-a451-3513-a629-6ee817287e66",
                                        "glosses": [
                                            "die Kennzeichnung von oder als etwas; das Zeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb26490-696f-454e-9228-b3b6575f1a02",
                                                "sense_id": "4e1b6eb3-64a1-308e-b8df-36773fd725bb",
                                                "text": "Das Stinktier verbreitet seinen unangenehmen Duft im Revier um seine Vorherrschaft anzuzeigen und setzt Markierungen an markanten Punkten."
                                            },
                                            {
                                                "example_id": "aa73e803-bc76-4b2a-ba75-dd40c01086dd",
                                                "sense_id": "4e1b6eb3-64a1-308e-b8df-36773fd725bb",
                                                "text": "Die Markierung der provisorischen Fahrspur im Baustellenbereich erfolgt mit gelblichem Schweißband auf der Fahrbahndecke."
                                            },
                                            {
                                                "example_id": "3a531978-efd1-4841-aecb-76d92748e6a4",
                                                "sense_id": "4e1b6eb3-64a1-308e-b8df-36773fd725bb",
                                                "text": "Eine Plombe ist die Versiegelung von etwas und gleichzeitig die Markierung der Umverpackung für den Empfänger, um sicherzustellen, dass der Inhalt unberührt empfangen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
