                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f07f9de-96ad-4bcf-aa32-437383060d04",
                        "source_entry_id": "d7e4ae6b-4758-3fb6-9320-20cfb253d119",
                        "source_sense_id": "2c452f22-2287-3237-b2a8-44a320259607",
                        "source_sense_description": "Chemie: Kalium",
                        "target_lang_word": "Kalium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a790b966-0910-3bde-9c91-9dfc9971be1b",
                                        "entry_id": "9fafbeb4-fec1-32b5-ac2d-a22612ae1809",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 19, das zur Gruppe der Alkalimetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce13ea3d-a35f-4328-81eb-215abdfbb9c7",
                                                "sense_id": "a790b966-0910-3bde-9c91-9dfc9971be1b",
                                                "text": "Kalium kommt in der Natur nur als Kation in Kaliumverbindungen vor."
                                            },
                                            {
                                                "example_id": "df23c320-c47e-45df-a88d-2a98bbb1ef40",
                                                "sense_id": "a790b966-0910-3bde-9c91-9dfc9971be1b",
                                                "text": "„Im Fokus steht außer dem im Orangensaft enthaltenen Kalium der pflanzliche Inhaltsstoff Hesperidin, dem eine Verbesserung der Funktionalität von Blutgefäßen zugeschrieben wird.“"
                                            },
                                            {
                                                "example_id": "57e57950-2ba3-49a7-a6f5-95da855de191",
                                                "sense_id": "a790b966-0910-3bde-9c91-9dfc9971be1b",
                                                "text": "„Zu den Mineralstoffen zählen Natrium, Calcium, Chlorid, Kalium, Magnesium, Phosphat und Schwefel.“"
                                            },
                                            {
                                                "example_id": "df5e7000-89cc-4397-a57d-1c291574ed1e",
                                                "sense_id": "a790b966-0910-3bde-9c91-9dfc9971be1b",
                                                "text": "„Das Erz gehört zu den sogenannten Glimmern und enthält neben Lithium noch Silizium, Eisen, Aluminium, Kalium und Fluor - ein komplexes Gemisch, das die Aufarbeitung erschwert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
