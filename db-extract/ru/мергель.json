                "senses": [
                    {
                        "sense_id": "eae48b26-31be-3df9-82fa-6be8f5d0e6e1",
                        "entry_id": "363d5100-a411-331f-a6d9-cc2176690fb5",
                        "glosses": [
                            "геол. осадочная горная порода смешанного глинисто-карбонатного состава"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0113ae12-2fe5-4c75-b2d4-db6804765898",
                                "sense_id": "eae48b26-31be-3df9-82fa-6be8f5d0e6e1",
                                "text": "Мергель поддавался плохо — он был не очень твёрдый, но острия ломов и мотыг увязали в нём…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c54b99f-284b-46db-bb01-2fe503ecfe66",
                        "source_entry_id": "363d5100-a411-331f-a6d9-cc2176690fb5",
                        "source_sense_id": "eae48b26-31be-3df9-82fa-6be8f5d0e6e1",
                        "target_lang_word": "marl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34e4db1a-c43a-3a31-b206-933423158e21",
                                        "entry_id": "bc963c85-b4a8-323d-b329-6d2e2ee3d998",
                                        "glosses": [
                                            "A mixed earthy substance, consisting of carbonate of lime, clay, and possibly sand, in very variable proportions, and accordingly designated as calcareous, clayey, or sandy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deb58607-16b7-47db-b4f8-056aca099e63",
                                                "sense_id": "34e4db1a-c43a-3a31-b206-933423158e21",
                                                "text": "... uneasie steps / Over the burning Marle, not like those steps / On Heavens Azure..."
                                            },
                                            {
                                                "example_id": "7dbf0b03-8b4c-4793-81de-49e5f5cd4402",
                                                "sense_id": "34e4db1a-c43a-3a31-b206-933423158e21",
                                                "text": "Mr. Greenshields was the contractor selected to build the embankment, and over a hundred thousand tons of marl and moss compacted with brushwood were used in its construction."
                                            },
                                            {
                                                "example_id": "30855a8a-a3a9-4337-8bee-086fd700932a",
                                                "sense_id": "34e4db1a-c43a-3a31-b206-933423158e21",
                                                "text": "Important marl and marine-shell deposits are worked in Michigan, Virginia, and Florida."
                                            },
                                            {
                                                "example_id": "039c33f1-9d0f-46a7-8c2d-70e736951278",
                                                "sense_id": "34e4db1a-c43a-3a31-b206-933423158e21",
                                                "text": "The surroundings were unearthly. It was not a fish setting—only bare rock, no trees, pungent sagebrush, and marl dust floating when a truck passed."
                                            },
                                            {
                                                "example_id": "72aa9d95-7686-48b9-b609-fdc5aefccc25",
                                                "sense_id": "34e4db1a-c43a-3a31-b206-933423158e21",
                                                "text": "Those loved unhappy shades whom Dante turned / To sticks and marl"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "787ff269-88e5-3ede-9827-07f41eb4a234",
