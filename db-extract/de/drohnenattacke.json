                        "glosses": [
                            "Angriff, bei dem (bewaffnete) Drohnen eingesetzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e72798-2cbe-4112-b0b1-c2a1e0d68757",
                                "sense_id": "94bb3648-26e1-3212-ac26-c69542ea9b64",
                                "text": "„Die britische Luftwaffe hat nach den Worten von Premierminister David Cameron bei einer Drohnenattacke in Syrien zwei Briten getötet, von denen einer ein mutmaßlicher Kämpfer der Terrormiliz Islamischer Staat (IS) war.“"
                            },
                            {
                                "example_id": "e01754da-186a-47b3-b898-5f956f494310",
                                "sense_id": "94bb3648-26e1-3212-ac26-c69542ea9b64",
                                "text": "„Das irakische Parlament forderte kurz nach der Drohnenattacke den Abzug aller amerikanischen Truppen sowie anderer ausländischer Streitkräfte aus dem Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
