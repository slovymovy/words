                "senses": [
                    {
                        "sense_id": "013ceb2c-8179-3085-8e22-2b7bbc1a4704",
                        "entry_id": "7959d00c-b244-3d0b-8714-50f852b0a39b",
                        "glosses": [
                            "als Club getarnter, illegaler Alkoholausschank während der Prohibitionszeit in den USA"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5e632fa5-4a8b-47f8-8cfa-1d1f0dc8ae32",
                                "sense_id": "013ceb2c-8179-3085-8e22-2b7bbc1a4704",
                                "text": "„Der Greenback war Gott, Pure Malt Whisky sein Prophet, und das Speakeasy der Tempel dieser neuen Religion.“"
                            },
                            {
                                "example_id": "e6110309-5f58-4c28-bb05-ec3c3ac6b96e",
                                "sense_id": "013ceb2c-8179-3085-8e22-2b7bbc1a4704",
                                "text": "„Eine Stahltür, rot gestrichen, damit es zum Backstein passte. Die Art Haus, die sich zur Zeit der Prohibition gut als Speakeasy geeignet hätte oder vielleicht auch tatsächlich eines gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
