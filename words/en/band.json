                    "target_lang_definitions": {
                        "ru": "Определенный диапазон частот, длин волн или значений, особенно в радио или физике.",
                        "zh": "特定的频率、波长或数值范围，常用于无线电或物理学。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диапазо́н",
                                "target_lang_sense_clarification": "область значений"
