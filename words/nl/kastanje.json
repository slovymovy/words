                    "sense_id": "af4f8398-a59e-316f-ba25-bcb292fe0a19",
                    "sense_definition": "De eetbare noot van de kastanjeboom, gehuld in een stekelige bolster.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het najaar zoeken we vaak een mooie <w>kastanje</w> in het bos.  ",
                            "target_lang_translations": {
                                "en": "In autumn we often look for a nice <w>chestnut</w> in the woods."
                            }
                        },
                        {
                            "text": "We hebben in de winter een <w>tamme kastanje</w> gegeten op de markt.",
                            "target_lang_translations": {
                                "en": "In the winter we ate a roasted <w>sweet chestnut</w> at the market."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tamme kastanje",
                        "wilde kastanje"
                    ],
                    "target_lang_definitions": {
                        "en": "The edible nut of the chestnut tree, encased in a spiky burr."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chestnut",
                                "target_lang_sense_clarification": "nut"
                            }
                        ]
