                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0a61c4e-0484-3a98-9438-c368828cfae6",
                        "entry_id": "f5c9f85c-c961-39b2-bb85-2531c06c59eb",
                        "glosses": [
                            "A district of Hong Kong."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6f5db5-87b5-452b-a02c-b5dc33d90215",
                                "sense_id": "b0a61c4e-0484-3a98-9438-c368828cfae6",
                                "text": "Islands District\nIn recent years, the outlying islands have taken on an increasingly important role in catering for the recreational needs of the people of Hong Kong. As part of the Islands District development programme, projects continued throughout the year in both planning and construction to upgrade the living environment and to improve general facilities for the increasing number of visitors to the islands."
                            },
                            {
                                "example_id": "e75312c0-e059-4381-a016-6a867baa225f",
                                "sense_id": "b0a61c4e-0484-3a98-9438-c368828cfae6",
                                "text": "The democrats now have majority control in almost all areas except the Islands District Council, where they won seven seats, and the pro-Beijing camp obtained 11 seats. Eight of the seats in the Islands District belong to ex-officio members, which were not included in Sunday’s election."
                            },
                            {
                                "example_id": "b145ba2e-5006-416d-8352-7898084bfa7b",
                                "sense_id": "b0a61c4e-0484-3a98-9438-c368828cfae6",
                                "text": "The Islands district saw a 28.5 per cent leap in transactions in the secondary housing market last year to 1,699, according to Midland Realty. That was the fourth largest increase among the 18 districts, up from 10th in 2019."
                            }
                        ]
                    }
