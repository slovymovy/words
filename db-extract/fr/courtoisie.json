                                        "entry_id": "e060793a-b3a8-3537-b722-519cc9998ff3",
                                        "glosses": [
                                            "Courtesy and considerate behaviour towards others; social harmony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51a16489-8885-4354-ae3f-ee86bf66f958",
                                                "sense_id": "ebf4874a-ae19-3676-875f-28bbb649c0a3",
                                                "text": "There, I saw not only flare-ups of ethnic animosity, but the comity that was also possible among men of different backgrounds."
                                            },
                                            {
                                                "example_id": "662a884b-9e0a-4285-b8bd-38a5632b4528",
                                                "sense_id": "ebf4874a-ae19-3676-875f-28bbb649c0a3",
                                                "text": "The app [OpenAI's Sora] will further erode truth, and comity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4456db92-f349-3852-9475-73ccda5feacf",
                                        "entry_id": "e060793a-b3a8-3537-b722-519cc9998ff3",
                                        "glosses": [
                                            "Friendly understanding and mutual recognition between two entities, especially nations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a5a49fb-ebd9-471d-880d-f82578e64f1b",
                                                "sense_id": "4456db92-f349-3852-9475-73ccda5feacf",
                                                "text": "Democrats took control of the House and Senate after 12 years of nearly unbroken Republican rule, with resolute calls for bipartisan comity and a pledge to move quickly on an agenda of health care, homeland security, education and energy proposals."
                                            }
                                        ]
                                    }
                                ]
