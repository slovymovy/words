                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93b9ccdb-030e-3f04-887e-aef966e9674d",
                                        "entry_id": "9b3bc08e-d649-3932-a1c1-02f373e2f99a",
                                        "glosses": [
                                            "considerare e comprendere le opportunità favorevoli di un progetto"
                                        ],
