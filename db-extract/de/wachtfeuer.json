                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0036c582-a7c5-4f4f-bd5b-3db4015d3168",
                                "sense_id": "ff091e19-c842-3ee3-a07c-fd1fc4aa60b3",
                                "text": "„Die Nacht war angebrochen, aus allen Städten und Dörfern schallten die Sturmglocken, und zahllose Wachtfeuer brannten ringsumher.“"
                            },
                            {
                                "example_id": "29339659-6b3f-4bef-a8e7-3e950c83f872",
                                "sense_id": "ff091e19-c842-3ee3-a07c-fd1fc4aa60b3",
                                "text": "„Allüberall in der Stadt tönte Lärm, Hornblasen, in den Friedhöfen brannten allerwärts Wachtfeuer.“"
                            }
                        ],
