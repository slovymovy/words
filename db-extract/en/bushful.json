                        "glosses": [
                            "As much as a bush holds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54822449-e5b1-4114-bf8b-797d1f537b25",
                                "sense_id": "bd997099-c4a6-3514-9985-96b30a6e3caa",
                                "text": "What caused the breaking of that twig? — what the low, alarmed twittering in that bushful of birds?"
                            },
                            {
                                "example_id": "b66c8dbb-6d59-4fe4-b02e-3e475062983f",
                                "sense_id": "bd997099-c4a6-3514-9985-96b30a6e3caa",
                                "text": "The best thing about Hayling Island (apart from its spanners) was its bounteous bushfuls of blackberries, from which I readily grazed."
                            },
                            {
                                "example_id": "8f4d47c5-a75e-40b8-93a5-746712a8fd20",
                                "sense_id": "bd997099-c4a6-3514-9985-96b30a6e3caa",
                                "text": "He rooted in the ground for pale grubs and tore at bee trees for honey and ate huckleberries by the bushful and was happy and strong."
                            }
                        ]
                    }
                ],
