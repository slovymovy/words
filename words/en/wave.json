                                "target_lang_word": "飘动",
                                "target_lang_sense_clarification": "旗帜等"
                            },
                            {
                                "target_lang_word": "摇曳",
                                "target_lang_sense_clarification": "草木等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edb4ca17-0974-3725-82df-9444d85abd2f",
                    "sense_definition": "To hold something and move it back and forth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The starter <w>waved</w> the flag to begin the race.",
                            "target_lang_translations": {
                                "ru": "Стартер <w>махнул</w> флагом, чтобы начать гонку.",
                                "zh": "发令员<w>挥舞</w>旗帜以开始比赛。"
                            }
                        },
                        {
                            "text": "He <w>waved</w> the papers in my face angrily.",
                            "target_lang_translations": {
                                "ru": "Он сердито <w>размахивал</w> бумагами перед моим лицом.",
                                "zh": "他愤怒地在我面前<w>挥舞</w>着文件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wave a flag",
                        "wave a gun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Держать предмет и двигать им из стороны в сторону.",
                        "zh": "拿着某物并来回摆动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махать",
                                "target_lang_sense_clarification": "предметом"
                            },
                            {
                                "target_lang_word": "размахивать",
                                "target_lang_sense_clarification": "интенсивно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥舞",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41a568c8-dc88-3655-b3d3-94ad7e05f225",
                    "sense_definition": "To style hair so that it is curly or curved.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>waved</w> her hair for the special occasion.",
                            "target_lang_translations": {
                                "ru": "Она <w>завила</w> волосы для особого случая.",
                                "zh": "为了这个特殊场合，她把头发<w>烫</w>成了波浪卷。"
                            }
                        },
                        {
                            "text": "Her hair was <w>waved</w> and styled perfectly.",
                            "target_lang_translations": {
                                "ru": "Её волосы были <w>завиты</w> и идеально уложены.",
                                "zh": "她的头发被<w>卷</w>好并完美地做了造型。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укладывать волосы так, чтобы они были волнистыми.",
                        "zh": "将头发做成卷曲或波浪状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завивать",
                                "target_lang_sense_clarification": "волосы"
                            },
                            {
                                "target_lang_word": "делать волны",
                                "target_lang_sense_clarification": "укладка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烫发",
                                "target_lang_sense_clarification": "美发"
                            },
                            {
                                "target_lang_word": "卷发",
                                "target_lang_sense_clarification": "造型"
                            }
                        ]
                    }
                }
