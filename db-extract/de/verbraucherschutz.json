                        "sense_id": "400f0ad3-8960-3989-a747-a86aed86ebe4",
                        "entry_id": "dce51c21-aeff-3890-90b7-97d516ca4b79",
                        "glosses": [
                            "Gesamtheit der Maßnahmen, die die Konsumenten vor jedwedem Schaden bewahren sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d000e496-2c87-4478-944c-363c96ef86c9",
                                "sense_id": "400f0ad3-8960-3989-a747-a86aed86ebe4",
                                "text": "Die Bedeutung des Verbraucherschutzes steigt mit der zunehmenden Entfernung zwischen Konsument und Produktion."
                            },
                            {
                                "example_id": "01b75352-02b1-41bf-b40b-359876dd34ce",
                                "sense_id": "400f0ad3-8960-3989-a747-a86aed86ebe4",
                                "text": "„Oder anders ausgedrückt: Die Targobank zeigt beispielhaft, in welche Fallen Kunden beim Bankbesuch immer noch tappen können, strenge Regulierung und Verbraucherschutz hin oder her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5926b49c-68d5-4ade-8d76-c9e567731f40",
                        "source_entry_id": "dce51c21-aeff-3890-90b7-97d516ca4b79",
                        "source_sense_id": "400f0ad3-8960-3989-a747-a86aed86ebe4",
                        "source_sense_description": "Gesamtheit der Maßnahmen, die die Konsumenten vor jedwedem Schaden bewahren sollen",
                        "target_lang_word": "consumer protection",
                        "target_lang_code": "en",
