                                "target_lang_sense_clarification": "een bewuste handeling"
                            },
                            {
                                "target_lang_word": "handeling",
                                "target_lang_sense_clarification": "een uitgevoerde actie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45398230-f82d-3547-95a0-775094962dce",
                    "sense_definition": "A legal document that is signed and delivered, especially one regarding the ownership of property or legal rights.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We signed the <w>deed</w> to our new house yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мы подписали <w>документ</w> на право собственности на наш новый дом.",
                                "nl": "We hebben gisteren de <w>akte</w> van ons nieuwe huis ondertekend."
                            }
                        },
                        {
                            "text": "The lawyer prepared the <w>deed</w> for the transfer of the land.",
                            "target_lang_translations": {
                                "ru": "Юрист подготовил <w>акт</w> передачи земли.",
                                "nl": "De advocaat bereidde de <w>akte</w> voor de overdracht van de grond voor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "title deed",
                        "deed of trust",
                        "warranty deed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический документ, подтверждающий право собственности или другие права.",
                        "nl": "Een juridisch document dat is ondertekend en afgeleverd, met name met betrekking tot eigendom of wettelijke rechten."
                    },
