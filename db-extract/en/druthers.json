                        "examples": [
                            {
                                "example_id": "ad270273-b3aa-494e-8ed6-c51c3019337a",
                                "sense_id": "c2913bf6-0f52-3104-ae93-a94a4d0ff2e9",
                                "text": "\"If I had my druthers, I would not be a king. I'd druther be just what I am than any other thing.\""
                            },
                            {
                                "example_id": "7d19c4f6-913e-473b-8e75-b1e8009a3d50",
                                "sense_id": "c2913bf6-0f52-3104-ae93-a94a4d0ff2e9",
                                "text": "\"If you had your druthers—\" Old Lew was always saying, \"If I had my druthers, gimme one of them there Shevrolics.\""
                            },
                            {
                                "example_id": "b6be7fb0-201d-40a0-a8a7-21091c5d7db3",
                                "sense_id": "c2913bf6-0f52-3104-ae93-a94a4d0ff2e9",
                                "text": "\"If I had my druthers,\" he informs us, \"I'druther be myself — not because I'm anythin' special, just because it's convenient.\""
                            },
                            {
                                "example_id": "1c889c6b-20fc-49c1-ae74-9944eb78380b",
                                "sense_id": "c2913bf6-0f52-3104-ae93-a94a4d0ff2e9",
                                "text": "If I'd had my \"druthers,\" our engagement would not have been two and one half years long. But schooling made our druthers invalid."
                            },
                            {
                                "example_id": "0db5160d-360a-4841-ac2f-b7a6780a0e1c",
                                "sense_id": "c2913bf6-0f52-3104-ae93-a94a4d0ff2e9",
                                "text": "If I had my \"druthers,\" I'd screw a chimpanzee. Call it, pointless."
                            }
                        ]
                    }
