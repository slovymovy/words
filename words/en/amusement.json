{
    "word_family": [
        "amuse",
        "amusing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                    "sense_definition": "The state of finding something funny or entertaining.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To my great <w>amusement</w>, the dog kept on chasing its tail.",
                            "target_lang_translations": {
                                "ru": "К моему большому <w>веселью</w>, собака продолжала гоняться за своим хвостом.",
                                "zh": "令我感到非常<w>好笑</w>的是，那只狗一直在追着自己的尾巴转。",
                                "it": "Con mio grande <w>divertimento</w>, il cane continuava a rincorrersi la coda."
                            }
                        },
                        {
                            "text": "She watched the show with clear <w>amusement</w> on her face.",
                            "target_lang_translations": {
                                "ru": "Она смотрела шоу с явным <w>весельем</w> на лице.",
                                "zh": "她脸上带着明显的<w>笑意</w>看着表演。",
                                "it": "Guardava lo spettacolo con un chiaro <w>divertimento</w> sul volto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "great amusement",
                        "to my amusement",
                        "in amusement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, когда что-то кажется смешным или забавным.",
                        "zh": "感到某事有趣或好笑的状态。",
                        "it": "Lo stato o la sensazione di trovare qualcosa divertente o spassoso."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веселье",
                                "target_lang_sense_clarification": "чувство радости и смеха"
                            },
                            {
                                "target_lang_word": "забава",
                                "target_lang_sense_clarification": "чувство, вызванное чем-то потешным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好笑",
                                "target_lang_sense_clarification": "指觉得某事滑稽或有趣的感觉"
                            },
                            {
                                "target_lang_word": "乐趣",
                                "target_lang_sense_clarification": "指从某事中获得的愉悦感"
                            },
                            {
                                "target_lang_word": "笑意",
                                "target_lang_sense_clarification": "脸上流露出的觉得好笑的神情"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "divertimento",
                                "target_lang_sense_clarification": "sensazione di piacere o allegria data da qualcosa di buffo"
                            },
                            {
                                "target_lang_word": "ilarità",
                                "target_lang_sense_clarification": "reazione di allegria o riso suscitata da qualcosa"
                            },
                            {
                                "target_lang_word": "spasso",
                                "target_lang_sense_clarification": "divertimento leggero e spensierato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                    "sense_definition": "An activity that provides enjoyment or entertainment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dancing was a popular <w>amusement</w> for young people in the past.",
                            "target_lang_translations": {
                                "ru": "Танцы были популярным <w>развлечением</w> для молодежи в прошлом.",
                                "zh": "跳舞在过去是年轻人的一种流行<w>娱乐</w>方式。",
                                "it": "Ballare era un <w>divertimento</w> molto diffuso tra i giovani in passato."
                            }
                        },
                        {
                            "text": "His favorite <w>amusement</w> is fishing by the lake on weekends.",
                            "target_lang_translations": {
                                "ru": "Его любимое <w>развлечение</w> — рыбалка на озере по выходным.",
                                "zh": "他周末最喜欢的<w>消遣</w>就是在湖边钓鱼。",
                                "it": "Il suo <w>passatempo</w> preferito è pescare al lago nei fine settimana."
                            }
                        }
                    ],
                    "synonyms": [
                        "pastime",
                        "hobby",
                        "sport",
                        "diversion"
                    ],
                    "common_phrases": [
                        "favorite amusement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занятие, которое доставляет удовольствие или развлекает.",
                        "zh": "提供享受或娱乐的活动。",
                        "it": "Un'attività o un passatempo che procura piacere o svago."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развлечение",
                                "target_lang_sense_clarification": "общее понятие для досуга"
                            },
                            {
                                "target_lang_word": "забава",
                                "target_lang_sense_clarification": "несерьезное, часто игровое занятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "娱乐",
                                "target_lang_sense_clarification": "指供人消遣的活动"
                            },
                            {
                                "target_lang_word": "消遣",
                                "target_lang_sense_clarification": "指为了打发时间而进行的轻松活动"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "divertimento",
                                "target_lang_sense_clarification": "attività piacevole o ricreativa"
                            },
                            {
                                "target_lang_word": "passatempo",
                                "target_lang_sense_clarification": "attività per occupare piacevolmente il tempo libero"
                            },
                            {
                                "target_lang_word": "intrattenimento",
                                "target_lang_sense_clarification": "svago o spettacolo organizzato per allietare"
                            },
                            {
                                "target_lang_word": "svago",
                                "target_lang_sense_clarification": "attività rilassante e ricreativa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}