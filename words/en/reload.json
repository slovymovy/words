{
    "word_family": [
        "load",
        "loader",
        "loading",
        "unloader",
        "payload",
        "overload",
        "upload",
        "download"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1acf827e-625e-3755-875d-5331a8f7319d",
                    "sense_definition": "To refresh a copy of a program in memory or a web page on a screen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the website does not display correctly, please try to <w>reload</w> the page.",
                            "target_lang_translations": {
                                "ru": "Если сайт отображается некорректно, пожалуйста, попробуйте <w>обновить</w> страницу."
                            }
                        },
                        {
                            "text": "You should <w>reload</w> the browser to see the latest updates on the news site.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>перезагрузить</w> браузер, чтобы увидеть последние обновления на новостном сайте."
                            }
                        }
                    ],
                    "synonyms": [
                        "refresh"
                    ],
                    "common_phrases": [
                        "reload the page",
                        "reload the browser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обновить копию программы в памяти или веб-страницу на экране."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезагрузить",
                                "target_lang_sense_clarification": "страницу или программу"
                            },
                            {
                                "target_lang_word": "обновить",
                                "target_lang_sense_clarification": "страницу в браузере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4e189c0-beea-3e93-8dd5-b206d385a3d2",
                    "sense_definition": "To put ammunition into a firearm again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "firearms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier had to <w>reload</w> his rifle quickly during the training exercise.",
                            "target_lang_translations": {
                                "ru": "Солдату пришлось быстро <w>перезарядить</w> винтовку во время учебного упражнения."
                            }
                        },
                        {
                            "text": "It is important to <w>reload</w> a gun carefully to ensure it functions properly.",
                            "target_lang_translations": {
                                "ru": "Важно <w>заряжать</w> оружие осторожно, чтобы обеспечить его правильную работу."
                            }
                        }
                    ],
                    "antonyms": [
                        "unload"
                    ],
                    "common_phrases": [
                        "reload a gun",
                        "reload a rifle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова вложить патроны в огнестрельное оружие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезарядить",
                                "target_lang_sense_clarification": "оружие"
                            },
                            {
                                "target_lang_word": "зарядить снова",
                                "target_lang_sense_clarification": "оружие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afd7e312-f51a-33c0-ad5e-f78a762ef247",
                    "sense_definition": "To <w>load</w> something, such as a vehicle or container, again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the inspection, the workers had to <w>reload</w> the truck with the heavy boxes.",
                            "target_lang_translations": {
                                "ru": "После осмотра рабочим пришлось заново <w>загрузить</w> грузовик тяжелыми ящиками."
                            }
                        },
                        {
                            "text": "The crew will <w>reload</w> the cargo onto the ship before it departs tomorrow.",
                            "target_lang_translations": {
                                "ru": "Экипаж снова <w>погрузит</w> груз на корабль перед его завтрашним отплытием."
                            }
                        }
                    ],
                    "antonyms": [
                        "unload"
                    ],
                    "common_phrases": [
                        "reload the truck",
                        "reload the cargo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова загрузить что-либо, например, транспортное средство или контейнер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегрузить",
                                "target_lang_sense_clarification": "товар или груз"
                            },
                            {
                                "target_lang_word": "загрузить заново",
                                "target_lang_sense_clarification": "транспорт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bf01a0a-71be-3b66-82ee-fa0c153627ad",
                    "sense_definition": "To replay a track from the beginning during a DJ set, often due to crowd reaction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd went wild, so the DJ decided to <w>reload</w> the track.",
                            "target_lang_translations": {
                                "ru": "Толпа неистовствовала, поэтому диджей решил <w>перезапустить</w> трек."
                            }
                        },
                        {
                            "text": "When you <w>reload</w> the music, the energy in the club reaches a peak.",
                            "target_lang_translations": {
                                "ru": "Когда ты <w>ставишь заново</w> музыку, энергия в клубе достигает пика."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reload the music",
                        "reload the track"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in DJ and sound system culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторно воспроизвести трек с начала во время диджейского сета, часто из-за реакции публики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезапустить",
                                "target_lang_sense_clarification": "трек"
                            },
                            {
                                "target_lang_word": "поставить заново",
                                "target_lang_sense_clarification": "музыку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "052d894e-384a-3aaf-8ed3-944927afe706",
                    "sense_definition": "The act or process of loading something again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quick <w>reload</w> of the weapon allowed the shooter to continue the drill.",
                            "target_lang_translations": {
                                "ru": "Быстрая <w>перезарядка</w> оружия позволила стрелку продолжить упражнение."
                            }
                        },
                        {
                            "text": "A scheduled four-hour <w>reload</w> was necessary before the train could return.",
                            "target_lang_translations": {
                                "ru": "Перед возвращением поезда потребовалась плановая четырехчасовая <w>перезагрузка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick reload",
                        "scheduled reload"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс повторной загрузки чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезарядка",
                                "target_lang_sense_clarification": "оружия"
                            },
                            {
                                "target_lang_word": "перезагрузка",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5332906f-0cd7-3aba-8289-54babc49bafa",
                    "sense_definition": "An ammunition cartridge that has been assembled using a previously fired casing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "firearms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He prefers using a <w>reload</w> because it is more cost-effective than buying new ammunition.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает использовать <w>переснаряженные патроны</w>, потому что это выгоднее, чем покупать новые боеприпасы."
                            }
                        },
                        {
                            "text": "The shooter checked each <w>reload</w> for defects before heading to the range.",
                            "target_lang_translations": {
                                "ru": "Стрелок проверил каждый <w>патрон</w> на наличие дефектов перед тем, как отправиться на стрельбище."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ammunition reload"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical term in ballistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Патрон, собранный с использованием ранее использованной гильзы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переснаряженный патрон",
                                "target_lang_sense_clarification": "боеприпас"
                            },
                            {
                                "target_lang_word": "релоад",
                                "target_lang_sense_clarification": "сленг стрелков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68cf191e-086e-3df4-ae45-58e308e9822b",
                    "sense_definition": "A track that is played again during a DJ performance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That song was such a hit that it earned a <w>reload</w> from the DJ.",
                            "target_lang_translations": {
                                "ru": "Эта песня была таким хитом, что диджей удостоил её <w>повтора</w>."
                            }
                        },
                        {
                            "text": "The audience shouted for a <w>reload</w> after the bass dropped.",
                            "target_lang_translations": {
                                "ru": "Публика кричала, требуя <w>релоад</w>, после того как дропнул бас."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a reload"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Specific to electronic and urban music scenes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трек, который проигрывается повторно во время выступления диджея."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повтор",
                                "target_lang_sense_clarification": "трека"
                            },
                            {
                                "target_lang_word": "релоад",
                                "target_lang_sense_clarification": "диджейский сленг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}