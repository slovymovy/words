                        "sense_id": "1338537a-6649-38a5-a579-7ab611473096",
                        "entry_id": "508b6539-5099-3f84-9f01-1cd314564e08",
                        "glosses": [
                            "eine Gruppe von fünf Musizierenden (Singstimmen oder Instrumente)"
