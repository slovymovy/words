                        "examples": [
                            {
                                "example_id": "5ce7dad7-b689-4fe2-9e91-697b82c62193",
                                "sense_id": "e57fe8b5-4643-3ec4-b2d1-3bab2ee49dd6",
                                "text": "1842, Laird of Logan, Chambers's Edinburgh Journal, issue 481, page 104.\nWe a' ken that there's tongues in heads, but I ne'er heard o' ony in hats or bauchles afore."
                            }
                        ]
                    },
                    {
                        "sense_id": "b312b053-be2b-3284-a147-da1fc307c6f3",
                        "entry_id": "a7f2df0e-1608-3b23-8ea3-6ad63b94928d",
                        "glosses": [
                            "A fool."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "5a09c28c-82d4-4570-8ff7-541d0582a419",
                                "sense_id": "b312b053-be2b-3284-a147-da1fc307c6f3",
                                "text": "He adds, probably his letter would be propaled and made a bauchle of, and assures them he was never loved at Court as a minister."
                            }
                        ]
                    },
                    {
                        "sense_id": "e899503e-e5ab-3549-a671-5256bc71438a",
                        "entry_id": "a7f2df0e-1608-3b23-8ea3-6ad63b94928d",
                        "glosses": [
                            "A bungled or muddled situation; a mess."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": []
                    }
