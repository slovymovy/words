            {
                "entry_id": "df778733-3053-30a6-93f9-b9d660b3fb55",
                "word": "timeworn",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "55d0d90b-a3ed-4b03-94c5-afd9675feb9d",
                        "entry_id": "df778733-3053-30a6-93f9-b9d660b3fb55",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more timeworn"
                    },
                    {
                        "form_id": "87654133-46ba-4e99-b0b6-e8da18e4dcea",
                        "entry_id": "df778733-3053-30a6-93f9-b9d660b3fb55",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most timeworn"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8822e6f2-b880-3ded-9324-c32e31eb7f68",
                        "entry_id": "df778733-3053-30a6-93f9-b9d660b3fb55",
                        "glosses": [
                            "Showing the effects of wear due to long use."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a5def3-e029-41f2-948b-d97544846e10",
                                "sense_id": "8822e6f2-b880-3ded-9324-c32e31eb7f68",
                                "text": "The roofs of these time-worn habitations are full of holes, and have been patched here and there with laths; […]"
                            },
                            {
                                "example_id": "fd86fb8b-c7b9-4242-8c8e-1e395a1b31d3",
                                "sense_id": "8822e6f2-b880-3ded-9324-c32e31eb7f68",
                                "text": "After walking the timeworn horizons out of Africa, I have entered a corrugated maze, a knotted crossroad of the world where landscape is read like sacrament, a labyrinth of echoing faiths called the Middle East."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4b14e30-694c-3c0f-a384-c3bb85415b2f",
                        "entry_id": "df778733-3053-30a6-93f9-b9d660b3fb55",
                        "glosses": [
                            "Banal or trite; hackneyed or overused."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ced5b009-526d-4bdb-aa24-66f256ac8c39",
                        "source_entry_id": "df778733-3053-30a6-93f9-b9d660b3fb55",
                        "source_sense_description": "showing the effects of wear",
                        "target_lang_word": "abgegriffen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abgegriffen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6742f2-a861-301a-91b2-c16436e3348a",
                                        "entry_id": "c93af99d-3995-386f-9709-013468d9344f",
                                        "glosses": [
                                            "durch Greifen/Berührung abgenutzt/verschlissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46043f61-4add-42f2-a7d0-63903e9c52ea",
                                                "sense_id": "fb6742f2-a861-301a-91b2-c16436e3348a",
                                                "text": "In der Dunkelheit ertastete ich einen abgegriffenen Handlauf im Treppenhaus."
                                            },
                                            {
                                                "example_id": "a567a635-ec37-4cf9-93b1-ef6c5b04849f",
                                                "sense_id": "fb6742f2-a861-301a-91b2-c16436e3348a",
                                                "text": "Der Automat gibt nur noch abgegriffene Banknoten heraus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f568c77-686e-33ae-ac45-7f7b59666814",
                                        "entry_id": "c93af99d-3995-386f-9709-013468d9344f",
                                        "glosses": [
                                            "stark/häufig benutzt und deshalb wenig aussagekräftig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c132dcd2-0843-4b38-886c-593629919ee0",
                                                "sense_id": "7f568c77-686e-33ae-ac45-7f7b59666814",
                                                "text": "Nichts als abgegriffene Beispiele, die Sie da bringen!"
                                            },
                                            {
                                                "example_id": "44f5d280-0dd4-4f1f-b67b-baacca8bc933",
                                                "sense_id": "7f568c77-686e-33ae-ac45-7f7b59666814",
                                                "text": "Das sind doch abgegriffene Phrasen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "abgegriffen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0970bd54-89bc-3f4d-ad26-f0713b57e33c",
                                        "entry_id": "45a637b8-707f-38ba-bf36-559793c9ffb7",
