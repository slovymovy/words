                        ]
                    },
                    {
                        "translation_id": "b8b434c5-778d-4db9-af79-16794f14f8f7",
                        "source_entry_id": "bc6eaf2a-094b-3d98-92f2-355195683cc0",
                        "source_sense_id": "33352c3d-eb66-302e-b4fa-28a788e674dd",
                        "source_sense_description": "kleines Geschwister",
                        "target_lang_word": "sibling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sibling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a801116-1fb5-3d24-9c1c-34c34206575b",
                                        "entry_id": "a2bfb1f1-2ce7-3ea4-ba7b-16bafe8c0eb0",
                                        "glosses": [
                                            "A person who shares a parent; one's brother or sister who one shares a parent with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2843238-f403-4d5b-9379-dd8cadb1ea42",
                                                "sense_id": "6a801116-1fb5-3d24-9c1c-34c34206575b",
                                                "text": "None of my siblings are married yet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f438d2e9-0642-3371-a0fe-5d763bca623f",
                                        "entry_id": "a2bfb1f1-2ce7-3ea4-ba7b-16bafe8c0eb0",
                                        "glosses": [
                                            "A node in a data structure that shares its parent with another node."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a744c67-180d-371e-8e39-9b7e970d6864",
                                        "entry_id": "a2bfb1f1-2ce7-3ea4-ba7b-16bafe8c0eb0",
                                        "glosses": [
                                            "The most closely related species, or one of several most closely related species when none can be determined to be more closely related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6618a304-2244-4da4-92ec-51cb5ee2992d",
                                                "sense_id": "4a744c67-180d-371e-8e39-9b7e970d6864",
                                                "text": "D. simulans, D. mauritiana and D. sechellia (which we will call “the siblings” when we do not need to distinguish among them) have homosequential polytene chromosome banding patterns differing from those of D. melanogaster by one long inversion on chromosome arm 3R and a few much smaller inversions."
                                            },
                                            {
                                                "example_id": "c7b9ede7-7d60-4080-b911-1703a1ac7849",
                                                "sense_id": "4a744c67-180d-371e-8e39-9b7e970d6864",
                                                "text": "Bush suggested that this difference might represent a case of chromosomal polymorphism or, more likely, sibling species."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a31a707-6cfd-4111-a0af-291a05e74765",
                        "source_entry_id": "bc6eaf2a-094b-3d98-92f2-355195683cc0",
                        "source_sense_id": "33352c3d-eb66-302e-b4fa-28a788e674dd",
                        "source_sense_description": "kleines Geschwister",
                        "target_lang_word": "frérot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frérot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "012b87be-c6f6-3c7a-a3ab-b3c448c67e57",
                                        "entry_id": "cb5e4290-3bb5-33b7-9cfc-77a0e7cf406e",
                                        "glosses": [
                                            "Petit frère, frangin."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41cedd41-77be-41c3-917c-1e34c57d1d28",
                                                "sense_id": "012b87be-c6f6-3c7a-a3ab-b3c448c67e57",
                                                "text": "Elle veut obliger Jacques à chanter la romance du Triste Chevalier. Mais le frérot résiste, se fâche. Déjà se lève en lui l’orgueil d’un petit homme […]"
                                            },
                                            {
                                                "example_id": "8f6b790d-c60c-4b95-9b13-8c71121d4d7d",
                                                "sense_id": "012b87be-c6f6-3c7a-a3ab-b3c448c67e57",
                                                "text": "Je l’ai quasiment vu grandir comme un frérot (jeune frère) ; il n’y avait pas de plus laid gars dans toute la paroisse ; mais aussi c’était la meilleure créature du bon Dieu."
                                            },
                                            {
                                                "example_id": "57dd39b2-427d-4fff-9896-677f0824a001",
                                                "sense_id": "012b87be-c6f6-3c7a-a3ab-b3c448c67e57",
                                                "text": "Ah bon d'accord, merci beaucoup mon frérot, tu es trop gentil. — (Pierre Delmond, Mon fantôme ou mon ombre ?, tome 1, 2021)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f5165a2-211d-3204-81a1-6a0658468ef9",
                                        "entry_id": "cb5e4290-3bb5-33b7-9cfc-77a0e7cf406e",
                                        "glosses": [
                                            "Religieux sans importance, moinillon."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a087e8d-26ce-3d3a-912f-f689fb5b9263",
                                        "entry_id": "cb5e4290-3bb5-33b7-9cfc-77a0e7cf406e",
                                        "glosses": [
                                            "Nom donné aux franciscains qui s’étaient émancipés des règles édictées par François d’Assise."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b5244d0-0465-3bc1-9d90-42fc1b1ed6bd",
                                        "entry_id": "cb5e4290-3bb5-33b7-9cfc-77a0e7cf406e",
                                        "glosses": [
                                            ", Membre ou partisan des Frères musulmans."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5267e9e2-af42-4b16-bbee-cd815e54b8dd",
                                                "sense_id": "3b5244d0-0465-3bc1-9d90-42fc1b1ed6bd",
                                                "text": "Ce refus de prendre parti de la part de la population s’explique aussi par le fait que la fracture passe à l’intérieur des familles : chacune d’elles a son « flic » et son « frérot »."
                                            },
                                            {
                                                "example_id": "d30338a7-f3e9-4cf2-beca-cbfbdd50ce7c",
                                                "sense_id": "3b5244d0-0465-3bc1-9d90-42fc1b1ed6bd",
                                                "text": "- Brahim Boudar a été l’un des principaux artisans d’octobre 1988. A incendié les Galeries algériennes à Kouba, les souks El-Fellah de Chéraga et Boufarik.\n- Il était frérot, à l’époque ?"
                                            },
                                            {
                                                "example_id": "f1ba5314-c248-43f2-a312-69540f31bf2b",
                                                "sense_id": "3b5244d0-0465-3bc1-9d90-42fc1b1ed6bd",
                                                "text": "L’ennemi juré du frérot, du barbu et donc de ces bombes ambulantes que sont les désespérados montés au maquis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
