                                        "entry_id": "1e24d367-6501-3928-8592-bbdbd59e3bf7",
                                        "glosses": [
                                            "A user of the photo-sharing and social networking service Instagram."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90527b5e-3561-4d72-9974-dd5f85fde541",
                                                "sense_id": "46850e0d-bd12-3380-98e1-8f5064b4840f",
                                                "text": "The more likes a photo has, the higher the probability it will make it to the Popular page, at which point, the more probable it is that thousands of other Instagrammers will find it and follow that user."
                                            },
                                            {
                                                "example_id": "f0c7e666-c932-452f-b8e2-140bbba35b40",
                                                "sense_id": "46850e0d-bd12-3380-98e1-8f5064b4840f",
                                                "text": "If the Photo Map feature is enabled, then Instagrammers can add their business locations to their image information as they are finalizing their pictures."
                                            },
                                            {
                                                "example_id": "f42fc338-e1c3-4bf9-b83f-865c59f6e64c",
                                                "sense_id": "46850e0d-bd12-3380-98e1-8f5064b4840f",
                                                "text": "At farmers' markets\nthe flower stalls draw big crowds\nof Instagrammers."
                                            }
