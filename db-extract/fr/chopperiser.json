                "senses": [
                    {
                        "sense_id": "e38ff93e-ab2c-3574-bd89-8dadf7a79868",
                        "entry_id": "f5e841d3-747b-384c-80c0-6ecc10e67ef6",
                        "glosses": [
                            "Donner à (une moto) un caractère de chopper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8608e0df-472e-49cb-9360-0ea987db3bef",
                                "sense_id": "e38ff93e-ab2c-3574-bd89-8dadf7a79868",
                                "text": "Si c'est pour \"interchanger\" tu peux mettre du 90/90.10 sur ton prim, et ceux-là passent aussi sur ton PX, ça va juste le \"chopperiser\" un peu."
                            },
                            {
                                "example_id": "d00f7084-7a13-4925-aba3-31a3318bed26",
                                "sense_id": "e38ff93e-ab2c-3574-bd89-8dadf7a79868",
                                "text": "J'ai une Honda CM 400 T de 80 que je suis en train de restaurer et de chopperiser, on peut déjà voir quelques modifs sur la photo."
                            },
                            {
                                "example_id": "5318694d-b086-469b-850b-05a3a4bc4bfc",
                                "sense_id": "e38ff93e-ab2c-3574-bd89-8dadf7a79868",
                                "text": "Il gara la Commando à côté d’un 500 monocylindre B.S.A. chopperisé jusqu’au ridicule et rentra dans le bar."
                            }
                        ]
                    }
