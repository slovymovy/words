                    },
                    {
                        "sense_id": "95a37f57-6dbb-31e9-a4ed-b0977084f64e",
                        "entry_id": "1fe10e84-c0f7-3da6-8e4d-f0e711ae5fa3",
                        "glosses": [
                            "груб. совокупление людей"
                        ],
                        "tags": [],
