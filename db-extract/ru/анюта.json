                "senses": [
                    {
                        "sense_id": "72addbb6-0bb2-3d00-8dc3-eae9bf38a559",
                        "entry_id": "23bfd541-0195-30f2-b36d-088b032181f2",
                        "glosses": [
                            "a diminutive, Anyuta, of the female given name А́ня (Ánja)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac9ee59-6319-4bcc-a5ae-feeeeb0628fa",
                                "sense_id": "72addbb6-0bb2-3d00-8dc3-eae9bf38a559",
                                "text": "У окна́, подёрнутого у краёв ледяны́ми узо́рами, сиде́ла на табуре́те его́ жили́ца, Аню́та, ма́ленькая, ху́денькая брюне́тка лет 25-ти́, о́чень бле́дная, с кро́ткими се́рыми глаза́ми.",
                                "translation": "In the window, covered by patterns of frost, sat on a stool the girl who shared his room--Anyuta, a thin little brunette of five-and-twenty, very pale with mild grey eyes.",
                                "english": "In the window, covered by patterns of frost, sat on a stool the girl who shared his room--Anyuta, a thin little brunette of five-and-twenty, very pale with mild grey eyes."
                            },
                            {
                                "example_id": "0e72beb7-ca6c-4a10-acbd-c0244d5924f5",
                                "sense_id": "72addbb6-0bb2-3d00-8dc3-eae9bf38a559",
                                "text": "Аню́та обе́ими рука́ми пригла́дила чёрные во́лосы, откры́ла дверь в се́ни[...]",
                                "translation": "With both hands Anyuta smoothed down her black hair, opened the door into the porch…",
                                "english": "With both hands Anyuta smoothed down her black hair, opened the door into the porch…"
                            }
                        ]
                    }
                ],
