                                        "sense_id": "99e3bcd2-7f21-3d57-9d93-ea0e6dd9b2a7",
                                        "entry_id": "d114395f-2f10-3b32-8cf1-670722d88932",
                                        "glosses": [
                                            "tendencja w polityce wewnętrznej polegająca na rozbudowywaniu potencjału militarnego państwa do rozmiarów przekraczających rzeczywiste potrzeby obronne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6fa94d-c393-41fd-8199-8fdd7cfff83d",
                                                "sense_id": "99e3bcd2-7f21-3d57-9d93-ea0e6dd9b2a7",
                                                "text": "Ekonomistka podkreślała, że militaryzm nie tylko odegrał kluczową rolę podczas kolonizacji Nowego Świata, ale – co ważniejsze – jego kluczową rolą i funkcją była akumulacja kapitału, w tym narzucenie handlu towarowego i proletaryzacji tubylców"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "812c3163-bbe1-3e27-8014-5862860592e1",
