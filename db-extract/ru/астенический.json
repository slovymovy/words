                                        "glosses": [
                                            "Personne atteinte d’asthénie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3e912dd-675c-44d8-b145-a6ebd83a5fb2",
                                                "sense_id": "0cf0af90-0416-32aa-86cb-ac60f265989d",
                                                "text": "Des asthéniques."
                                            },
                                            {
                                                "example_id": "0baffeda-0fc2-4d49-95e9-08ed54f4080b",
                                                "sense_id": "0cf0af90-0416-32aa-86cb-ac60f265989d",
                                                "text": "Le psychiatre qui examine un individu pendant cette période de latence qui suit le surmenage devrait savoir soupçonner l’épuisement réel sous la santé apparente et traiter le sujet comme un asthénique vrai."
