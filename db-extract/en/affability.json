        "de-extract.jsonl": [
            {
                "entry_id": "262c6625-3033-3833-8330-534617ef55d9",
                "word": "affability",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd860423-d941-3e7c-befd-cf5738236ea4",
                        "entry_id": "262c6625-3033-3833-8330-534617ef55d9",
                        "glosses": [
                            "Leutseligkeit, Freundlichkeit, Umgänglichkeit"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e231995d-703e-48fe-918c-9d2a46826116",
                        "source_entry_id": "262c6625-3033-3833-8330-534617ef55d9",
                        "source_sense_id": "bd860423-d941-3e7c-befd-cf5738236ea4",
                        "source_sense_description": "Leutseligkeit, Freundlichkeit, Umgänglichkeit",
                        "target_lang_word": "Leutseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leutseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a92b80b1-f84e-3434-97c0-c9e17ffb1d0d",
                                        "entry_id": "be147497-2042-3858-9f0f-379eb6bb2b11",
                                        "glosses": [
                                            "entgegenkommender, freundlicher Umgang mit anderen Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64754839-1f08-4bf6-96e0-48c3bb0eb895",
                                                "sense_id": "a92b80b1-f84e-3434-97c0-c9e17ffb1d0d",
                                                "text": "„Seine Leutseligkeit sollte Vertrauen einflößen.“"
                                            },
                                            {
                                                "example_id": "1931bc44-c05e-45a4-b9f1-12502886c055",
                                                "sense_id": "a92b80b1-f84e-3434-97c0-c9e17ffb1d0d",
                                                "text": "„Der dritte war den beiden Beschriebenen total unähnlich, und was jene an Wildheit und Lebensmut zuviel besaßen, schien dieser durch Sanftmut und Leutseligkeit wieder ausgleichen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b228a047-4faf-484d-b0c3-0d4a23092997",
                        "source_entry_id": "262c6625-3033-3833-8330-534617ef55d9",
                        "source_sense_id": "bd860423-d941-3e7c-befd-cf5738236ea4",
                        "source_sense_description": "Leutseligkeit, Freundlichkeit, Umgänglichkeit",
                        "target_lang_word": "Freundlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freundlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                        "entry_id": "77fb2f66-647b-35a6-b64b-2dda0ca7688f",
                                        "glosses": [
                                            "Liebenswürdigkeit, wohlwollende Geneigtheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65268c1-8194-4a89-8472-f8aab1271292",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "Ich möchte Ihnen danken, denn soviel Freundlichkeit bin ich von Fremden nicht gewohnt."
                                            },
                                            {
                                                "example_id": "d26908f9-5d09-404e-97d5-ef24db5cf62b",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Bald verwandelte sich die Freundlichkeit zu meinem Erstaunen in überschwängliche Vertraulichkeit.“"
                                            },
                                            {
                                                "example_id": "e81d5d6f-a334-4ead-92aa-9525d0fa3e3c",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Er bat schnell den Bekannten, der nicht sehr beglückt schien, um die Freundlichkeit, bei seinem Koffer einen Augenblick zu warten, überblickte noch die Situation, um sich bei der Rückkehr zurechtzufinden, und eilte davon.“"
                                            },
                                            {
                                                "example_id": "88fdef06-b88b-4898-82d9-a2739a8fcf21",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„In ihn hatte ich größeres Vertrauen, und ich beschloss, auf seine Freundlichkeit zu zählen.“"
                                            },
                                            {
                                                "example_id": "1ad64ea1-33cb-4abb-8743-cf531a58353f",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Der Rektor empfing mich mit überströmender Freundlichkeit.“"
                                            },
                                            {
                                                "example_id": "6dcbf7a5-259d-4c4c-9542-75dca622d6b0",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Freundlichkeit heißt, auf andere zuzugehen, ohne ihnen hinterher zu laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
