                        "glosses": [
                            "met veel aandacht arbeid verrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceab907e-201e-47ca-8150-3bb89e5bf979",
                                "sense_id": "85751c36-e86e-3631-b7c7-5b0d27ca9864",
                                "text": "Sanofi Pasteur en MSD richtten in 1994 een joint venture op waarin beide ondernemingen een belang van 50 procent hebben. Doel van de samenwerking was om vaccins waar de twee bedrijven aanwerkten, gezamenlijk verder te ontwikkelen en op de Europese markt te brengen. Dat leverde vorig jaar een omzet op van 824 miljoen euro."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aeeffe3-6f49-33bb-a69a-4a8207ecc5e5",
                        "entry_id": "d77dd228-4bbc-37b5-ad57-7cb7668b032c",
                        "glosses": [
                            "iets proberen te verwezenlijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b01c09-be18-46f9-bc65-527b32efbbea",
                                "sense_id": "7aeeffe3-6f49-33bb-a69a-4a8207ecc5e5",
                                "text": "Niet-confessionele partijen willen erop aanwerken de regels voor euthanasie te verruimen."
                            }
                        ]
                    }
