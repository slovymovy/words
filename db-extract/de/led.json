                "senses": [
                    {
                        "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                        "entry_id": "9decacc4-bd71-3337-ac77-19f3679fef42",
                        "glosses": [
                            "Light Emitting Diode oder deutsch: Licht emittierende Diode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "333b639a-4ed9-4cbe-96d1-272ec0c709f2",
                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                "text": "„Die Abkürzung LED steht für Licht emittierende Diode und bezeichnet ein elektronisches Halbleiter-Bauteil, das leuchtet, sobald Strom hindurchfließt.“"
                            },
                            {
                                "example_id": "c9957a3e-dc52-453c-99b4-f531cf50439b",
                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                "text": "„LEDs wird eine strahlende Zukunft vorausgesagt, denn die winzigen Leuchten sind extrem energiesparend und spenden über Jahre hinweg zuverlässig Licht.“"
                            },
                            {
                                "example_id": "77c468e0-a5d3-475b-b6ec-67720a43f1da",
                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                "text": "„Elektrisch wäre noch einiges zu sparen, aber als bekennender Warmduscher und Gegner der Kaltlichtenergiesparlampen rüste ich jetzt langsam auf LED um.“"
                            },
                            {
                                "example_id": "c2db7879-76f2-49f9-a85b-6f8103cfce66",
                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                "text": "„Tom zog seine Karte durch den kleinen Kartenleser neben dem Türrahmen, die grüne LED blinkte kurz, und die Tür sprang auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10337ebf-1169-4506-9714-b0b68a0c36cb",
                        "source_entry_id": "9decacc4-bd71-3337-ac77-19f3679fef42",
                        "source_sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                        "target_lang_word": "LED",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LED",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                                        "entry_id": "5ecebd0f-e97a-3ac2-8a9a-a8212920cb87",
                                        "glosses": [
                                            "Initialism of light-emitting diode."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a55e5b5-e092-4d13-a582-9d8360c87f87",
                                                "sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                                                "text": "The area already has plenty of loud billboards and klieg lights that have drawn complaints from some neighborhood groups, so the city is concerned about anything billboardesque. Mr. Astani’s application to build the LED panels is undergoing an environmental review by city planning officials."
                                            },
                                            {
                                                "example_id": "dc894e3d-5c21-439a-bfaa-c4ee5f2b5f4b",
                                                "sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                                                "text": "The light-emitting capacity of an LED is measured in megacandela [recte millicandelas] or mcd. Small commercial LEDs range from 10 to about 5000 mcd."
                                            },
                                            {
                                                "example_id": "73a18c6b-73da-4dda-a573-fa643e3654cb",
                                                "sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                                                "text": "In some projects, the fiber optic cable will be mounted on the LEDs (D1, D6, D8, and on U22) or the phototransistor (Q4). […] Light is transmitted from the color LED, through the fiber optic cable, to control the NPN transistor (Q2) and red LED (D1)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
