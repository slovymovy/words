                                "target_senses": [
                                    {
                                        "sense_id": "b0bbada4-cd94-3ede-870c-786736e64373",
                                        "entry_id": "7c978033-84ca-3893-9898-e2ade76057bb",
                                        "glosses": [
                                            "Alternative form of malthouse."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd5cddef-83ee-4998-8777-6ede52e2b8d9",
                                                "sense_id": "b0bbada4-cd94-3ede-870c-786736e64373",
                                                "text": "Population 5,430 (more like 40,000 today), Andover is \"a bustling agricultural town\" with \"many malt houses, and a factory for silk shag\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6925d236-eb02-40e3-b9f3-eff6c64161de",
                        "source_entry_id": "a016b5e1-b8f8-3f6b-8ff1-5542004a576c",
                        "source_sense_id": "35acc0ec-ae60-3442-b82f-076968c705c0",
                        "target_lang_word": "maltery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maltery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4abff95-4f21-38c6-9793-2448fdd02fea",
                                        "entry_id": "0205fb20-d31f-34bb-b51d-61e442a7d563",
                                        "glosses": [
                                            "A malthouse."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9dba25c-f4b5-487f-ab86-627ddf18187e",
                                                "sense_id": "f4abff95-4f21-38c6-9793-2448fdd02fea",
                                                "text": "The foregoing represents the malteries whose product is disposed of by sale to brewers having no malteries connected with their breweries."
                                            },
                                            {
                                                "example_id": "134e3e7a-3d79-493a-a5a1-6c390fb0d65c",
                                                "sense_id": "f4abff95-4f21-38c6-9793-2448fdd02fea",
                                                "text": "Before the Assela Maltery was completed in 1984, most of the malt used in the breweries had to be imported: in 1983/84 only 20 per cent of the malt used was supplied locally. After the Assela maltery began operations output increased rapidly during the mid-1980s, reaching 11,000 tonnes in FY1988, 110 per cent of nominal installed capacity."
                                            },
                                            {
                                                "example_id": "994bd052-0959-4492-97f6-2774902ded5f",
                                                "sense_id": "f4abff95-4f21-38c6-9793-2448fdd02fea",
                                                "text": "The fermentation industries comprise of distilleries, breweries and malteries."
                                            }
                                        ]
                                    }
