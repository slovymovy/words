        "fr-extract.jsonl": [
            {
                "entry_id": "8559a956-3b4e-3de3-a47d-c380d603cd02",
                "word": "aquafaba",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c576a0a1-ef58-3c5c-8b32-b48fb573b6ff",
                        "entry_id": "8559a956-3b4e-3de3-a47d-c380d603cd02",
                        "glosses": [
                            "Eau de cuisson des graines de légumineuses (pois chiche, haricots rouges, etc.) aux propriétés similaires à celles du blanc d’œuf."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "5ad53057-396b-427d-8afd-2e1c71a09dd9",
                                "sense_id": "c576a0a1-ef58-3c5c-8b32-b48fb573b6ff",
                                "text": "James Kenji López-Alt, directeur culinaire chez Serious Eat, a ainsi écrit que, «dans le monde de la cuisine végétalienne, rien n’a autant fait bouger les choses que l’aquafaba»."
                            },
                            {
                                "example_id": "d4970eb7-c33c-4893-8957-277e57285be1",
                                "sense_id": "c576a0a1-ef58-3c5c-8b32-b48fb573b6ff",
                                "text": "« Aquafaba ». C’est le joli nom (concaténation des mots latins aqua, eau et de faba, fèves), choisi pour désigner l’eau visqueuse dans laquelle des légumineuses comme les pois chiches ont été cuites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07b17efb-502b-40f3-ab73-ac23ea871543",
                        "source_entry_id": "8559a956-3b4e-3de3-a47d-c380d603cd02",
                        "source_sense_id": "c576a0a1-ef58-3c5c-8b32-b48fb573b6ff",
                        "target_lang_word": "aquafaba",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquafaba",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7af19fcb-70b1-317d-a86a-325ee237ee51",
                                        "entry_id": "87c21a21-e85a-3c34-808f-e10ec6075b24",
                                        "glosses": [
                                            "The liquid left over from boiling chickpeas or similar beans, or from a can of chickpeas."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c98bdc6-c992-4fd0-9527-442d9ee7f8e1",
                                                "sense_id": "7af19fcb-70b1-317d-a86a-325ee237ee51",
                                                "text": "Chefs, both vegan and omnivore, are using aquafaba in everything from pancakes to purées. This month, Sir Kensington’s, a New York condiment company, is introducing the first commercial product using aquafaba, a vegan mayonnaise called Fabanaise."
                                            },
                                            {
                                                "example_id": "7c4f2c8b-2a7d-4dc0-93b7-48522afb4e97",
                                                "sense_id": "7af19fcb-70b1-317d-a86a-325ee237ee51",
                                                "text": "To make the kiwi pistachio mousse: Put the aquafaba in the bowl of a stand mixer fitted with the whisk attachment and beat the liquid on medium speed until foamy. Raise the speed to high and beat until the mixture has expanded considerably and forms peaks, about 15 to 20 minutes."
                                            },
                                            {
                                                "example_id": "ce64737b-d480-40d3-8a51-b41c179c2767",
                                                "sense_id": "7af19fcb-70b1-317d-a86a-325ee237ee51",
                                                "text": "Aquafaba was recovered from 10 commercial canned chickpea products and correlations among aquafaba composition, density, viscosity and foaming properties were investigated. Proton NMR was used to characterize aquafaba composition before and after ultrafiltration through membranes with different molecular weight cut offs (MWCOs of 3, 10, or 50 kDa)."
                                            },
                                            {
                                                "example_id": "7391928b-5726-457e-987b-896a63b5a18e",
                                                "sense_id": "7af19fcb-70b1-317d-a86a-325ee237ee51",
                                                "text": "Soybean and chickpea aquafabas are particularly thick (think about the goo in canned chickpeas), but any bean water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
