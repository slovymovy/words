                "senses": [
                    {
                        "sense_id": "bdc87151-36af-349f-84fb-cdc445569cc9",
                        "entry_id": "23bf35b2-514e-3cde-9348-aa4ac28a1548",
                        "glosses": [
                            "Eiweiß (Protein), das in einem Virus vorkommt, von ihm produziert wird"
                        ],
                        "tags": [
                            "Mikrobiologie",
                            "oder auch"
                        ],
                        "examples": [
                            {
                                "example_id": "915ae8b7-f066-4888-b4db-20eb2aa237a6",
                                "sense_id": "bdc87151-36af-349f-84fb-cdc445569cc9",
                                "text": "„Eine Region kodiert für Virusproteine, die zu Beginn des Vermehrungszyklus gebildet werden (sog. frühe Proteine; E1-E7/8). Eine 2. Region umfasst Gene für spät im Vermehrungszyklus synthetisierte Strukturproteine (L1, L2).“"
                            },
                            {
                                "example_id": "e5c057c9-98b3-4579-ac1c-932e18f4f4e0",
                                "sense_id": "bdc87151-36af-349f-84fb-cdc445569cc9",
                                "text": "„Bei einigen Virusinfektionen werden die frühen Virusproteine rasch nach der Infektion gebildet, die sog. Spätproteine werden dagegen nur in einem späten Infektionsstadium nach der DNS-Synthese produziert.“"
                            },
                            {
                                "example_id": "3670e36e-1768-4189-b9cb-2e91cf2f5e96",
                                "sense_id": "bdc87151-36af-349f-84fb-cdc445569cc9",
                                "text": "„Die Ergebnisse der modernen Virologie gestatten eine Differenzierung der Virusproteine nach ihrer chemischen Zusammensetzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
