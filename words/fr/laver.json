    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24cd45a6-5d2c-3cc7-b173-e49b4054c1b2",
                    "sense_definition": "Nettoyer un objet ou une surface à l'aide d'eau ou d'un autre liquide, généralement avec du savon ou de la lessive.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "nettoyage_hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut toujours <w>laver</w> les légumes frais sous le robinet avant de les consommer."
                        },
                        {
                            "text": "Pendant le week-end, elle <w>lave</w> la vaisselle et nettoie toute la cuisine en profondeur."
                        }
                    ],
                    "synonyms": [
                        "nettoyer"
                    ],
                    "antonyms": [
                        "salir",
                        "souiller"
                    ],
                    "common_phrases": [
                        "laver le linge",
                        "laver la vaisselle",
                        "laver la voiture"
                    ]
                },
                {
                    "sense_id": "4bfa9b87-7c05-3c79-9ba8-01deb9783c4f",
                    "sense_definition": "Faire sa toilette, nettoyer son propre corps ou une partie de son corps.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "nettoyage_hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants doivent se <w>laver</w> soigneusement les mains avant de passer à table."
                        },
                        {
                            "text": "Chaque matin, je me <w>lave</w> à l'eau tiède pour bien commencer la journée."
                        }
                    ],
                    "synonyms": [
                        "se débarbouiller"
                    ],
                    "antonyms": [
                        "se salir"
                    ],
                    "common_phrases": [
                        "se laver les mains",
                        "se laver les dents"
                    ]
                },
                {
                    "sense_id": "74364109-2e67-347e-952f-7270cf47537d",
                    "sense_definition": "Faire disparaître ce qui porte atteinte à l'honneur, à la réputation ou à la conscience de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reputation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dirigeant a pris la parole publiquement afin de <w>laver</w> son honneur blessé."
                        },
                        {
                            "text": "L'accusé a présenté des documents officiels pour se <w>laver</w> de tout soupçon dans cette affaire."
                        }
                    ],
                    "synonyms": [
                        "blanchir",
                        "disculper",
                        "purifier"
                    ],
                    "antonyms": [
                        "flétrir",
                        "ternir"
                    ],
                    "common_phrases": [
                        "laver son honneur",
                        "laver un affront",
                        "se laver de tout soupçon"
                    ]
                },
                {
                    "sense_id": "3b1e0755-1a84-3351-805f-78c32a745af1",
                    "sense_definition": "Ombrer ou colorer un dessin au moyen d'un lavis, en étendant une teinte délayée dans de l'eau.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beaux_arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste préfère <w>laver</w> son croquis avec de l'encre diluée pour créer des nuances d'ombre."
                        },
                        {
                            "text": "Elle a appris la technique délicate pour <w>laver</w> une estampe sans altérer le papier."
                        }
                    ],
                    "common_phrases": [
                        "laver un dessin",
                        "laver un plan"
                    ]
                },
                {
                    "sense_id": "85c39650-d37a-338a-95d2-e0566249e618",
                    "sense_definition": "Vendre ou liquider à bas prix un bien dont on désire se défaire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne souhaitant plus conserver ces antiquités encombrantes, il est allé les <w>laver</w> à la brocante."
                        },
                        {
                            "text": "Le commerçant a fini par <w>laver</w> ses derniers articles invendus à prix dérisoire."
                        }
                    ],
                    "synonyms": [
                        "brader",
                        "liquider"
                    ],
                    "traits": [
                        {
