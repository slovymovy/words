                        "examples": []
                    },
                    {
                        "sense_id": "69beafc6-b8bf-3303-b530-57097c16e891",
                        "entry_id": "a22b0318-21ca-3523-a6dc-77035ef132a5",
                        "glosses": [
                            "To enclose, surround, or protect."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "44cb149e-2a01-4400-9bb9-152158e3b79d",
                                "sense_id": "69beafc6-b8bf-3303-b530-57097c16e891",
                                "text": "[S]uffice it to record, that blessed with a numerous progeny, Emily found herself completely embosomed in domestic bliss: […]"
                            },
                            {
                                "example_id": "d3ee53b0-f2b3-4166-9008-4d4a91beffb4",
                                "sense_id": "69beafc6-b8bf-3303-b530-57097c16e891",
                                "text": "[…] and thus mind is reconciled to its own momentary existence and limited vision by the sense of the infinite supplements that embosom it on every side."
                            }
                        ]
                    }
