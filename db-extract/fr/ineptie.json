                                "target_senses": [
                                    {
                                        "sense_id": "4694f07e-9bbb-36ed-b190-74d0fd0940f4",
                                        "entry_id": "20a4a53a-4571-34e0-9cad-fc09efdb42a0",
                                        "glosses": [
                                            "The quality or degree of being inept."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9748137f-5d30-477e-b6c5-846f21cbeaf9",
                                                "sense_id": "4694f07e-9bbb-36ed-b190-74d0fd0940f4",
                                                "text": "The ineptness of the novice jugglers was apparent as they frequently dropped their juggling pins."
                                            },
                                            {
                                                "example_id": "3490b3b0-27a3-4cc9-a358-ac929d97d8c6",
                                                "sense_id": "4694f07e-9bbb-36ed-b190-74d0fd0940f4",
                                                "text": "Today has been a day of folly, stupidity, and ineptness. The time is now eleven o'clock in the evening, and I am sitting in my room and thinking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
