                        ]
                    },
                    {
                        "translation_id": "a76d7169-8a9f-4a32-9bc8-d2094f20de2d",
                        "source_entry_id": "0a026af1-433a-36c0-a025-e9108113108c",
                        "source_sense_id": "3917c970-1250-3f20-ac44-8e958f5eeef8",
                        "source_sense_description": "compound of carbon and hydrogen",
                        "target_lang_word": "hydrocarbure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrocarbure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b1e3c01-b593-38b6-9228-28bfc2c56a95",
                                        "entry_id": "f89fc9af-d22b-32d5-9e53-800869a3aa28",
                                        "glosses": [
                                            "Molécules organiques formées de carbone et d’hydrogène seulement."
                                        ],
                                        "tags": [
                                            "Chimie organique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a099851-74fd-4b9f-aad5-0bfa0350e71a",
                                                "sense_id": "3b1e3c01-b593-38b6-9228-28bfc2c56a95",
                                                "text": "Les hydrocarbures ainsi que les glucosines déterminent indirectement cette réaction, car ils donnent naissance à des sucres lorsqu’on les traite à l’acide sulfurique."
                                            },
                                            {
                                                "example_id": "e2297513-5d29-48bc-80fa-55b87fb44ea4",
                                                "sense_id": "3b1e3c01-b593-38b6-9228-28bfc2c56a95",
                                                "text": "Les hydrocarbures imprègnent les sables généralement disposés en lentilles, les argiles et les marnes jouent le rôle d’isolants enfermant les masses à l’intérieur desquelles s’est effectuée la fermentation du sapropel."
                                            },
                                            {
                                                "example_id": "8aab7784-3812-4254-b4de-37b483eb2924",
                                                "sense_id": "3b1e3c01-b593-38b6-9228-28bfc2c56a95",
                                                "text": "— Tu ne trouves pas, l’Ingénieur, qu’il pue, son parfum ?\n— De fait, répondit le vieux, ces odeurs tirées des sous-produits de la distillation des hydrocarbures sont désagréables à plus d’un titre…"
                                            },
                                            {
                                                "example_id": "8842442c-5245-4580-84f6-f2851647f64c",
                                                "sense_id": "3b1e3c01-b593-38b6-9228-28bfc2c56a95",
                                                "text": "Shaw remarque que les schistes contenant des hydrocarbures ou du carbone libre contiennent en moyenne 1,23 ppm de Tl [thallium], deux fois plus que les sédiments argileux non carbonés."
                                            },
                                            {
                                                "example_id": "8943269c-a234-45f0-b369-bf7a762091cb",
                                                "sense_id": "3b1e3c01-b593-38b6-9228-28bfc2c56a95",
                                                "text": "Une autre méthode de déshydrogénation oxydante des hydrocarbures C4 en butadiène a pris de l’importance : ici, l’équilibre entre butènes et butadiène est déplacé vers celui-ci par introduction d’oxygène."
                                            },
                                            {
                                                "example_id": "c2c06851-2784-48c9-b803-c0518c8a3d9a",
                                                "sense_id": "3b1e3c01-b593-38b6-9228-28bfc2c56a95",
                                                "text": "Les chimistes organiciens, conscient de l’aspect ludique propre aux synthèses chimiques -[…]- se sont attelés par défi à la création d’hydrocarbures dont le squelette carboné correspond aux polyèdres régulier que sont les solides platoniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b6509a0-4a38-4dc7-957f-d1dd2b227e80",
                        "source_entry_id": "0a026af1-433a-36c0-a025-e9108113108c",
                        "source_sense_id": "3917c970-1250-3f20-ac44-8e958f5eeef8",
