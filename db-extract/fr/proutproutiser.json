                "senses": [
                    {
                        "sense_id": "8741907b-dfe5-36fa-b446-ff80f0d44434",
                        "entry_id": "e6a0bd7d-4a7e-3457-8c57-a300da5508c6",
                        "glosses": [
                            "Donner un caractère proutprout à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf5dda7-66dd-4bbc-8462-832abec7bec1",
                                "sense_id": "8741907b-dfe5-36fa-b446-ff80f0d44434",
                                "text": "Ce n'est pas demain la veille que je l'aurais mon portail coulissant proutproutisant ma propriété à la campure..."
                            },
                            {
                                "example_id": "f5d3b374-341b-4e01-bcd3-149aef470bc5",
                                "sense_id": "8741907b-dfe5-36fa-b446-ff80f0d44434",
                                "text": "Bonjour, Dans mon Insignia 2009, DVD800, le HP avant gauche \"proutproutise\" un peu."
                            },
                            {
                                "example_id": "41f84172-5213-4bbf-88e4-432c69253698",
                                "sense_id": "8741907b-dfe5-36fa-b446-ff80f0d44434",
                                "text": "Mes bêtes je ne les proutproutise pas, et oui des êtres humains à part entière parce qu'ils sont souvent moins \"C**\" que certains humains et ce n'est pas faute d'avoir un cerveau plus EVOLUE que les animaux!"
                            }
                        ]
                    }
