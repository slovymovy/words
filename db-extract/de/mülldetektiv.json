                "senses": [
                    {
                        "sense_id": "6e52b35b-3b22-381a-a8a7-2a73fbbbefa8",
                        "entry_id": "01414cab-95e0-33ce-95f7-43c97dd8abdf",
                        "glosses": [
                            "meist von Gemeinden beauftragte Personen der Abfallwirtschaftsbetriebe, die Personen aufspüren, die wild Müll entsorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c1b2d66-be7b-4007-b0ca-b4e664faca8f",
                                "sense_id": "6e52b35b-3b22-381a-a8a7-2a73fbbbefa8",
                                "text": "„Dort werde, ermittelte der grüne Mülldetektiv, derzeit über die Errichtung einer Hochtemperatur-Verbrennungsanlage verhandelt - ausgelegt auf 72000 Tonnen jährlich.“"
                            },
                            {
                                "example_id": "357fccae-a707-4052-bc93-5434d134ae13",
                                "sense_id": "6e52b35b-3b22-381a-a8a7-2a73fbbbefa8",
                                "text": "„Sollte er keine Stelle als Trainer bekommen, konnte es sich gleich als Erntehelfer nach Polen verdingen. Vielleicht, so überlegte er, wäre das Ruder durch eine Umschulung herumzureißen? Zum Mülldetektiv mit Uniform und einem Ärmelabzeichen vom städtischen Bauhof? Zum Einzelhandelsfachverkäufer? Zum Bierzeltkellner?“"
                            },
                            {
                                "example_id": "47d538f5-abbd-4f98-acd2-91e239b883e3",
                                "sense_id": "6e52b35b-3b22-381a-a8a7-2a73fbbbefa8",
                                "text": "Die Stadt Köln hat zwei Mülldetektive."
                            },
                            {
                                "example_id": "a6fc0d96-3b2b-4e2b-a28d-630c9964a228",
                                "sense_id": "6e52b35b-3b22-381a-a8a7-2a73fbbbefa8",
                                "text": "Die Aufklärungsquote der Mülldetektive liegt bei ca 30 Prozent."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
