                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3babfb18-c587-4781-9440-ed0764bad9b7",
                                "sense_id": "d4c5c142-1027-39ff-a0e4-76581f0aae97",
                                "text": "„Die Verfasser der uns bekannten Enzyklopädien der Antike und des Mittelalters strebten danach, das gesamte Wissen ihrer Zeit oder das Wissen über ein bestimmtes Sachgebiet zu sammeln, systematisch zu ordnen und dadurch dem Leser leichter zugänglich zu machen.“"
                            },
                            {
                                "example_id": "c5041b4a-2e8d-48ae-b13a-e27f7ee9b1c1",
                                "sense_id": "d4c5c142-1027-39ff-a0e4-76581f0aae97",
                                "text": "In vielen Bibliotheken sind die Medien nach Sachgebieten sortiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80ee5a55-79e0-32c6-89a3-690ce0f22f05",
