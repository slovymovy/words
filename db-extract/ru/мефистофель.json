                    },
                    {
                        "translation_id": "feca755f-a58f-44ad-ab9c-e92ca176ae8b",
                        "source_entry_id": "d102d551-d4f4-3084-83c2-3e8771430234",
                        "target_lang_word": "Mefistofeles",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mefistofeles",
