                                        "glosses": [
                                            "Gerüst, auf dem der Sarg bei der Trauerfeier steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0d5cd4-1178-4bda-8186-0438fcfcd9be",
                                                "sense_id": "a7f04d93-148b-30c5-a2cd-bdbeb50ff280",
                                                "text": "Müd und lustlos ihr feuchtes Auge; halb bewußtlos lehnt sie bei Vaters Katafalk."
                                            },
                                            {
                                                "example_id": "25c8b8c5-19fc-45c4-8ef4-0b2313929e08",
                                                "sense_id": "a7f04d93-148b-30c5-a2cd-bdbeb50ff280",
                                                "text": "Noch auf dem Katafalk ist es der Blick von dem gerührten Schalk."
                                            },
                                            {
                                                "example_id": "daebc0ec-cad8-493a-ac2c-c348f59f72de",
                                                "sense_id": "a7f04d93-148b-30c5-a2cd-bdbeb50ff280",
                                                "text": "„Er erinnert sich an ihr Lächeln, an die freundlichen Worte, mit denen sie ihn zum ersten Mal empfangen hat, er erinnert sich des gleichen Gesichts, wie es später auf dem Katafalk lag, und seines Zusammenstosses mit Subow, der es ihm verwehren wollte, der im Sarge liegenden Kaiserin die Hand zu küssen.“"
                                            },
                                            {
                                                "example_id": "b21c3eab-904f-43a0-83c8-19e3ef93b06a",
                                                "sense_id": "a7f04d93-148b-30c5-a2cd-bdbeb50ff280",
                                                "text": "„Die Straße nahm sie wieder auf, der kalte Geruch alter Brände umwehte sie aufs neue, und die abgeblendeten schwarzen Fenster begleiteten sie wie eine Prozession von Katafalken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
