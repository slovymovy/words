                    "sense_id": "98bad83c-d8f8-34fb-9ed3-b37675564fd3",
                    "sense_definition": "Degene die na alle anderen komt in een reeks; waar niets meer op volgt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is de <w>laatste</w> keer dat ik je waarschuw.",
                            "target_lang_translations": {
                                "ru": "Это <w>последний</w> раз, когда я тебя предупреждаю.",
                                "en": "This is the <w>last</w> time I warn you.",
                                "pl": "To jest <w>ostatni</w> raz, kiedy cię ostrzegam.",
                                "de": "Dies ist das <w>letzte</w> Mal, dass ich dich warne.",
                                "fr": "C'est la <w>dernière</w> fois que je t'avertis.",
                                "it": "Questa è l'<w>ultima</w> volta che ti avverto.",
                                "cs": "Tohle je <w>poslední</w> varování, které ti dávám.",
                                "tr": "Bu seni <w>son</w> uyarışım.",
                                "es": "Esta es la <w>última</w> vez que te advierto."
                            }
                        },
                        {
                            "text": "Hij kwam als <w>laatste</w> over de finishlijn.",
                            "target_lang_translations": {
                                "ru": "Он пересек финишную черту <w>последним</w>.",
                                "en": "He crossed the finish line <w>last</w>.",
                                "pl": "Przekroczył linię mety jako <w>ostatni</w>.",
                                "de": "Er ging als <w>Letzter</w> über die Ziellinie.",
                                "fr": "Il a franchi la ligne d'arrivée en <w>dernier</w>.",
                                "it": "Ha tagliato il traguardo per <w>ultimo</w>.",
                                "cs": "Cílovou čáru proťal jako <w>poslední</w>.",
                                "tr": "Bitiş çizgisini <w>sonuncu</w> olarak geçti.",
                                "es": "Él cruzó la línea de meta en <w>último</w> lugar."
                            }
                        }
                    ],
                    "antonyms": [
                        "eerst"
                    ],
                    "common_phrases": [
                        "de laatste keer",
                        "voor het laatst",
                        "op het laatst"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто идет после всех остальных в ряду; за которым больше ничего не следует.",
                        "en": "The one that comes after all others in a series; followed by nothing else.",
                        "pl": "Ten, który następuje po wszystkich innych w serii; po którym nic już nie następuje.",
                        "de": "Derjenige, der in einer Reihe nach allen anderen kommt; worauf nichts mehr folgt.",
                        "fr": "Celui qui vient après tous les autres dans une série ; qui n'est suivi de rien d'autre.",
                        "it": "Colui o ciò che viene dopo tutti gli altri in una serie; dopo il quale non segue nient'altro.",
                        "cs": "Ten, který přichází po všech ostatních v řadě; za kterým už nic nenásleduje.",
                        "tr": "Bir seride diğerlerinden sonra gelen; arkasından başka hiçbir şey gelmeyen, sonuncu.",
                        "es": "El que viene después de todos los demás en una serie; al que no le sigue nada más."
