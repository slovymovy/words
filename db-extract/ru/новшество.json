                    {
                        "form_id": "b39e3421-77b7-4efc-9096-189edc01c0fd",
                        "entry_id": "1423af02-987d-3850-9898-6dc29f592fc7",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "но́вшествах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85c5ee35-7f6c-3ec7-9407-2ed5d475fab9",
                        "entry_id": "1423af02-987d-3850-9898-6dc29f592fc7",
                        "glosses": [
                            "что-либо новое, вновь созданное, применённое и т. п.; нововведение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f395f102-924f-4e8a-98ef-bac7cad715e9",
                                "sense_id": "85c5ee35-7f6c-3ec7-9407-2ed5d475fab9",
                                "text": "Наш крестьянин противится техническому новшеству в земледелии, как всякий практик сопротивляется вооружению теорией в его деле."
                            },
                            {
                                "example_id": "4bd035f7-cfa0-4c39-8a47-34af3f9c6b61",
                                "sense_id": "85c5ee35-7f6c-3ec7-9407-2ed5d475fab9",
                                "text": "В танцах действительно были великие новшества: с 1844 года во всех домах затанцевали польку, новый танец, дотоле не виданный."
                            },
                            {
                                "example_id": "5d2df61a-220d-4115-b040-5d6aa48d5d45",
                                "sense_id": "85c5ee35-7f6c-3ec7-9407-2ed5d475fab9",
                                "text": "Допустить какое-нибудь новшество, хотя бы только переменить закопченную, потемневшую вывеску, хозяевам казалось делом опасным: как бы от того не произошла заминка в торговле и не сократились барыши."
                            },
                            {
                                "example_id": "017ffa19-516f-42c0-8eb5-84fcfec33065",
                                "sense_id": "85c5ee35-7f6c-3ec7-9407-2ed5d475fab9",
                                "text": "Подозрительная к новшествам и чурающаяся крайностей, английская натура склонна к выжиданию и неторопливым поискам компромисса между сомнением и верой, и это неустойчивое равновесие делает её одновременно скептической и доверчивой, неспособной к фантазии и склонной верить в чудеса."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14a5c0e2-323d-4b46-86cf-641a4bc74ef3",
                        "source_entry_id": "1423af02-987d-3850-9898-6dc29f592fc7",
                        "source_sense_id": "85c5ee35-7f6c-3ec7-9407-2ed5d475fab9",
                        "target_lang_word": "Neuerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8babc057-3118-31b1-b518-9ef8527aa9f0",
                                        "entry_id": "5e911e19-e506-3753-84e0-b81258962003",
                                        "glosses": [
                                            "neue Veränderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "589a9e7b-e5cb-49ce-9622-e5da0aefd9f7",
                                                "sense_id": "8babc057-3118-31b1-b518-9ef8527aa9f0",
                                                "text": "In der Version 3.4 gibt es einige Neuerungen."
                                            },
                                            {
                                                "example_id": "fa01243b-e921-4dbb-a594-eb57c37b6458",
                                                "sense_id": "8babc057-3118-31b1-b518-9ef8527aa9f0",
                                                "text": "„Eine besonders markante Neuerung ist die Entwicklung der polychromen Malerei.“"
                                            },
                                            {
                                                "example_id": "3d1bcd9c-c161-4206-a1b6-aaf23760b76f",
                                                "sense_id": "8babc057-3118-31b1-b518-9ef8527aa9f0",
                                                "text": "„Wenn Fürst Andrej in der letzten Zeit, seit er in Bogutscharowo seinen Wohnsitz genommen hatte, mancherlei Neuerungen eingeführt, Krankenhäuser und Schulen errichtet und ihnen Erleichterungen in den Pachtzahlungen gewährt hatte, so hatte all das ihre Sitten keineswegs gesänftigt, sondern im Gegenteil den vom alten Fürsten als Wildheit bezeichneten Zug in ihrem Charakter noch verstärkt.“"
                                            },
                                            {
                                                "example_id": "70ecf040-1489-4d3e-a5d2-1139aafbe0c4",
                                                "sense_id": "8babc057-3118-31b1-b518-9ef8527aa9f0",
                                                "text": "„Eine andere Frage ist es allerdings, wie viele dieser Neuerungen sich jeweils etablieren und in welcher Geschwindigkeit.“"
                                            },
                                            {
                                                "example_id": "61e317ec-55d9-44f4-afe5-14cf4676855d",
                                                "sense_id": "8babc057-3118-31b1-b518-9ef8527aa9f0",
                                                "text": "„Am 3. Mai 1775 meldet Alexander Cummings ein \"Water Closet\" zum Patent an, dessen wichtigste Neuerung in einem zweifach gekrümmten Abflussrohr besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
