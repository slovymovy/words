                                "zh": "九的平方<w>根</w>是三。"
                            }
                        },
                        {
                            "text": "Students learned how to calculate the cube <w>root</w> without a calculator.",
                            "target_lang_translations": {
                                "ru": "Студенты учились вычислять кубический <w>корень</w> без калькулятора.",
                                "zh": "学生们学习了如何不用计算器计算立方<w>根</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "square root",
                        "cube root"
                    ],
                    "target_lang_definitions": {
                        "ru": "Число, которое при возведении в определенную степень дает указанное число.",
                        "zh": "数学中，自乘若干次后得到某个指定数的那个数。"
                    },
                    "translations": {
