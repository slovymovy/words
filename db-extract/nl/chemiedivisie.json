                        "glosses": [
                            "onderdeel van een bedrijf dat chemische producten produceert en verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3437ec92-995a-4cc7-8de3-4bb30eb52c30",
                                "sense_id": "d940f8bd-6e04-3c16-8cbc-fbb62ec7563f",
                                "text": "PPG zegt dat het ineenschuiven van de twee bedrijven veel beter is dan het stand-alone-scenario dat AkzoNobel vorige week presenteerde, met een zelfstandige verf- en coatingsbedrijf en de verkoop van de chemiedivisie."
                            },
                            {
                                "example_id": "82a07e5a-fe29-4ce2-b036-cf4e6117bb89",
                                "sense_id": "d940f8bd-6e04-3c16-8cbc-fbb62ec7563f",
                                "text": "Zijn opvolger is ook al bekend. Dat wordt de Belg Thierry Vanlancker. Die werkt sinds vorig jaar bij Akzo en was tot voor kort verantwoordelijk voor de chemiedivisie van AkzoNobel. Vanlancker was daarvoor in dienst bij chemiebedrijf Chemours, het bedrijf dat in 2015 ontstond als spin-off van DuPont."
                            }
                        ]
                    }
