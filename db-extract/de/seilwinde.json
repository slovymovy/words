                "senses": [
                    {
                        "sense_id": "2ea14250-ac1f-318b-89f6-fc260b949021",
                        "entry_id": "9214dd38-28aa-3eb4-a296-c2ccb6efd615",
                        "glosses": [
                            "Vorrichtung, mit der man mit einem Seil Lasten heben, senken oder heranziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849cdacd-49ad-4f01-84f5-82c9316e28d6",
                                "sense_id": "2ea14250-ac1f-318b-89f6-fc260b949021",
                                "text": "„Diese können mittels einer Seilwinde auf eine Betonrampe gezogen werden – so sind sie vor den hohen Wellen sicher und können nicht gegen die Felswände geschleudert werden.“"
                            },
                            {
                                "example_id": "55a874a9-fe50-4faf-bf61-7fd28738fd9a",
                                "sense_id": "2ea14250-ac1f-318b-89f6-fc260b949021",
                                "text": "„Mit zwei Schneepflügen, einem Radlader und einer Seilwinde bahnten sich die Einsatzkräfte einen Weg zu dem auf rund 1.300 Meter Seehöhe gelegenen Kloster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
