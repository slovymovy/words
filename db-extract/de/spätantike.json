                "senses": [
                    {
                        "sense_id": "09124b87-3ebf-383d-b758-a3df96741976",
                        "entry_id": "80f75727-4db9-371a-94bc-b27cfa41ec0d",
                        "glosses": [
                            "die Zeit der ausgehenden Antike"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e61a629a-1925-47ad-bbb0-44f149ad5e01",
                                "sense_id": "09124b87-3ebf-383d-b758-a3df96741976",
                                "text": "„Die Küstenstadt, rund zehn Kilometer vom heutigen Tunis entfernt, war in der Spätantike neben Rom die bedeutendste Großansiedlung des Weströmischen Reiches.“"
                            },
                            {
                                "example_id": "f21e491e-1547-4afa-abcc-dfed8c87bb50",
                                "sense_id": "09124b87-3ebf-383d-b758-a3df96741976",
                                "text": "„Ihr Kult breitete sich von Zentralgallien aus, sie wurde, wie Weiheinschriften zeigen, bis in die Spätantike verehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d7a93ca-a131-346e-80ee-4c8de9928c1d",
                        "entry_id": "80f75727-4db9-371a-94bc-b27cfa41ec0d",
                        "glosses": [
                            "Kunstwerke aus der Spätantike"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f4ece2-c56a-4ca1-9876-4483a49ddcb6",
                        "source_entry_id": "80f75727-4db9-371a-94bc-b27cfa41ec0d",
                        "source_sense_id": "09124b87-3ebf-383d-b758-a3df96741976",
                        "source_sense_description": "Geschichte, kein Plural: die Zeit der ausgehenden Antike",
                        "target_lang_word": "Late Antiquity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Late Antiquity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f0db152-cb56-32bf-b0b2-76fdfbd4f8ce",
                                        "entry_id": "d0142c0a-2855-31fa-9f02-dd71be8f93b5",
                                        "glosses": [
                                            "The period of Mediterranean and Eurasian history from around the 3rd to the 7th centuries CE, marked especially by the transition from the Roman and Persian Empires to the Middle Ages and the Islamic and Byzantine civilizations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814ba4e1-e4dc-4f8e-86eb-ddae16192517",
                                                "sense_id": "1f0db152-cb56-32bf-b0b2-76fdfbd4f8ce",
                                                "text": "The production of coins for jewelry, on the other hand, was prosecuted as high treason or a crimen maiestatis: counterfeiting coin always constituted a major offense, and in Late Antiquity it became a sacrilege."
                                            },
                                            {
                                                "example_id": "da744d44-6d85-4fcd-9ca2-45db57a38227",
                                                "sense_id": "1f0db152-cb56-32bf-b0b2-76fdfbd4f8ce",
                                                "text": "Unlike Jews and Manichaeans, who could be found in most parts of the Roman empire during Late Antiquity, Zoroastrians were a geographically and numerically restricted religious group, confined to certain eastern provinces, especially in Asia Minor."
                                            },
                                            {
                                                "example_id": "83e2da28-75b7-4b74-9812-2fa0e9374f04",
                                                "sense_id": "1f0db152-cb56-32bf-b0b2-76fdfbd4f8ce",
                                                "text": "Yuhanna b. Mansur b. Sargun (ca. 655–ca. 749 C.E.), better known as John of Damascus, lived through the cultural transition from Late Antiquity to Early Islam and thus offers an important window into the practice of Late Antique Christian faith in a changing cultural milieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
