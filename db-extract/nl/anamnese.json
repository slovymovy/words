                    },
                    {
                        "sense_id": "5740e591-0991-38b6-826f-afed6637ee3a",
                        "entry_id": "083e150f-38dc-3466-a879-086fd055549b",
                        "glosses": [
                            "bij de socratische methode: het ‘zich herinneren’ van de vormen of ideeën der ideeënwereld in de werken van Plato"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf5027b-4ffe-4a37-89ad-020dc9988e82",
                                "sense_id": "5740e591-0991-38b6-826f-afed6637ee3a",
                                "text": "Dat is de theorie van de anamnese die we ook in de Phaedo zijn tegengekomen: leren is een zich herinneren."
                            }
                        ]
                    },
                    {
                        "sense_id": "f29facdf-2f37-3b49-a62c-5a999949aac6",
