{
    "word_family": [
        "forthcome"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae059744-e0a3-39e1-8942-1d8850b0f2d3",
                    "sense_definition": "About to happen or appear in the near future.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "future events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I shall vote in the <w>forthcoming</w> election.",
                            "target_lang_translations": {
                                "ru": "Я буду голосовать на <w>предстоящих</w> выборах."
                            }
                        },
                        {
                            "text": "The author discussed several interesting topics in her <w>forthcoming</w> book.",
                            "target_lang_translations": {
                                "ru": "Автор обсудила несколько интересных тем в своей <w>готовящейся к выходу</w> книге."
                            }
                        }
                    ],
                    "synonyms": [
                        "upcoming",
                        "impending",
                        "imminent",
                        "at hand"
                    ],
                    "common_phrases": [
                        "forthcoming election",
                        "forthcoming book",
                        "forthcoming events"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие, которое должно произойти или появиться в ближайшем будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предстоящий",
                                "target_lang_sense_clarification": "о событиях или публикациях"
                            },
                            {
                                "target_lang_word": "грядущий",
                                "target_lang_sense_clarification": "о важных будущих событиях"
                            },
                            {
                                "target_lang_word": "ближайший",
                                "target_lang_sense_clarification": "о времени или событиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e47899b-7e41-360b-af1e-02034882dc48",
                    "sense_definition": "Willing to provide information or be helpful and open.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality and behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once I explained why I needed to know, she was really <w>forthcoming</w>.",
                            "target_lang_translations": {
                                "ru": "Как только я объяснил, зачем мне это нужно знать, она стала очень <w>откровенной</w>."
                            }
                        },
                        {
                            "text": "The witness was not very <w>forthcoming</w> with details about the accident.",
                            "target_lang_translations": {
                                "ru": "Свидетель не очень охотно <w>делился</w> подробностями аварии."
                            }
                        }
                    ],
                    "antonyms": [
                        "unforthcoming"
                    ],
                    "common_phrases": [
                        "not very forthcoming",
                        "be forthcoming with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый предоставлять информацию, помогать или открыто общаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенный",
                                "target_lang_sense_clarification": "готовый делиться информацией"
                            },
                            {
                                "target_lang_word": "общительный",
                                "target_lang_sense_clarification": "расположенный к разговору"
                            },
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "честный и доступный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bc72270-e137-3785-b5c2-7fa5f60d8167",
                    "sense_definition": "Available or provided when needed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "availability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The money was not <w>forthcoming</w> despite our repeated requests.",
                            "target_lang_translations": {
                                "ru": "Деньги так и не были <w>предоставлены</w>, несмотря на наши неоднократные просьбы."
                            }
                        },
                        {
                            "text": "If sufficient support is <w>forthcoming</w>, the project will continue as planned.",
                            "target_lang_translations": {
                                "ru": "Если будет <w>оказана</w> достаточная поддержка, проект продолжится по плану."
                            }
                        }
                    ],
                    "common_phrases": [
                        "support was forthcoming",
                        "money was forthcoming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доступный или предоставленный в нужный момент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставленный",
                                "target_lang_sense_clarification": "о ресурсах или помощи"
                            },
                            {
                                "target_lang_word": "полученный",
                                "target_lang_sense_clarification": "о средствах или поддержке"
                            },
                            {
                                "target_lang_word": "имеющийся",
                                "target_lang_sense_clarification": "доступный в наличии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ceb572af-94ac-36cc-9b03-9990f3bc6921",
                    "sense_definition": "Present participle and gerund of <w>forthcome</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The truth is <w>forthcoming</w> from the shadows of the past.",
                            "target_lang_translations": {
                                "ru": "Истина <w>выходит</w> из теней прошлого."
                            }
                        },
                        {
                            "text": "He watched the light <w>forthcoming</w> from the horizon at dawn.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал за светом, <w>появляющимся</w> из-за горизонта на рассвете."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола «появляться» или «выходить»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появляющийся",
                                "target_lang_sense_clarification": "выходящий наружу"
                            },
                            {
                                "target_lang_word": "исходящий",
                                "target_lang_sense_clarification": "идущий от чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03855e0a-1fc8-36fc-b135-a97fbaf690ae",
                    "sense_definition": "Something that is yet to arrive or happen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "future things",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher spoke of the great <w>forthcomings</w> of the next century.",
                            "target_lang_translations": {
                                "ru": "Философ говорил о великих <w>грядущих событиях</w> следующего века."
                            }
                        },
                        {
                            "text": "We must prepare ourselves for the <w>forthcomings</w> of eternity.",
                            "target_lang_translations": {
                                "ru": "Мы должны подготовить себя к <w>пришествию</w> вечности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, чему еще предстоит прибыть или случиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грядущее",
                                "target_lang_sense_clarification": "будущие события"
                            },
                            {
                                "target_lang_word": "будущее",
                                "target_lang_sense_clarification": "то, что наступит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69280c04-d091-3942-88b5-626bc4f5f82b",
                    "sense_definition": "The act of emerging or coming out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emergence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>forthcoming</w> of the sun from behind the clouds surprised us.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>появление</w> солнца из-за туч удивило нас."
                            }
                        },
                        {
                            "text": "The <w>forthcoming</w> of new evidence changed the course of the trial.",
                            "target_lang_translations": {
                                "ru": "<w>Появление</w> новых улик изменило ход судебного процесса."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт появления или выхода наружу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появление",
                                "target_lang_sense_clarification": "выход на свет"
                            },
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "обнародование или появление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}