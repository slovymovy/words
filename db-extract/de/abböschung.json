                                            "UK",
                                            "colloquial",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ae310ac-9042-4694-80ac-4e35ee8be18b",
                                                "sense_id": "7098cdd9-b9fc-34b2-ad91-10da1619c99a",
                                                "text": "I sloped in through the back door, hoping my boss wouldn't see me."
                                            },
                                            {
                                                "example_id": "1d7ef00a-7150-4a87-9250-baf583159b6b",
                                                "sense_id": "7098cdd9-b9fc-34b2-ad91-10da1619c99a",
                                                "text": "She watched him disappear out of sight, before sloping back to her room."
                                            }
                                        ]
                                    },
