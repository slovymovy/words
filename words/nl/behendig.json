    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e721f8e3-d2fe-39bb-9dd8-831a935de310",
                    "sense_definition": "Met een goede lichaamscoördinatie; snel en soepel bewegend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_vaardigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge turner bewoog zich uiterst <w>behendig</w> over de evenwichtsbalk.",
                            "target_lang_translations": {
                                "en": "The young gymnast moved extremely <w>nimbly</w> across the balance beam."
                            }
                        },
                        {
                            "text": "Hij is een stuk <w>behendiger</w> geworden na maanden van intensieve training.",
                            "target_lang_translations": {
                                "en": "He has become a lot more <w>agile</w> after months of intensive training."
                            }
                        }
                    ],
                    "synonyms": [
                        "handig"
                    ],
                    "antonyms": [
                        "onbehendig"
                    ],
                    "common_phrases": [
                        "behendig bewegen"
                    ],
                    "target_lang_definitions": {
                        "en": "With good physical coordination; moving quickly and smoothly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "physically nimble and quick"
                            },
                            {
                                "target_lang_word": "nimble",
                                "target_lang_sense_clarification": "quick and light in movement"
                            },
                            {
                                "target_lang_word": "dexterous",
                                "target_lang_sense_clarification": "physically skillful and coordinated"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddedfd30-5f76-38fa-a8f0-0770bb4a59df",
                    "sense_definition": "Vaardig, slim en snel in het uitvoeren van bepaalde handelingen of taken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_vaardigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een <w>behendige</w> beweging wist de goochelaar de kaart te laten verdwijnen.",
                            "target_lang_translations": {
                                "en": "With a <w>deft</w> movement, the magician managed to make the card disappear."
                            }
                        },
                        {
                            "text": "Hij was een <w>behendig</w> toneelspeler die zijn publiek moeiteloos wist te bespelen.",
                            "target_lang_translations": {
                                "en": "He was a <w>skillful</w> actor who knew how to play his audience effortlessly."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedreven",
                        "bekwaam",
                        "handig"
                    ],
                    "antonyms": [
                        "onbehendig"
                    ],
                    "common_phrases": [
                        "behendige ontwijking"
                    ],
                    "target_lang_definitions": {
                        "en": "Skillful, clever, and quick in performing certain actions or tasks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deft",
                                "target_lang_sense_clarification": "neatly skillful and quick in one's movements"
                            },
                            {
                                "target_lang_word": "dexterous",
                                "target_lang_sense_clarification": "skillful with one's hands or actions"
                            },
                            {
                                "target_lang_word": "skillful",
                                "target_lang_sense_clarification": "possessing or showing skill"
                            },
                            {
                                "target_lang_word": "adroit",
                                "target_lang_sense_clarification": "clever or skillful in using the hands or mind"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f9c13b08-5c7b-345a-9304-2dac01c5477c",
                    "sense_definition": "Op een handige, snelle en vaardige manier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Behendig</w> wist de inbreker de gevel te beklimmen en zich door het openstaande raam te wurmen.",
                            "target_lang_translations": {
                                "en": "<w>Deftly</w>, the burglar managed to climb the facade and squeeze through the open window."
                            }
                        },
                        {
                            "text": "Zij ontweek <w>behendig</w> de moeilijke vragen van de nieuwsgierige journalisten.",
                            "target_lang_translations": {
                                "en": "She <w>adroitly</w> avoided the difficult questions of the curious journalists."
                            }
                        }
                    ],
                    "synonyms": [
                        "handig"
                    ],
                    "antonyms": [
                        "onbehendig"
                    ],
                    "common_phrases": [
                        "behendig ontwijken"
                    ],
                    "target_lang_definitions": {
