                ],
                "translations": [
                    {
                        "translation_id": "443c34e7-4f73-43e3-9453-ad138d2a46a7",
                        "source_entry_id": "49f8f1d1-4c5a-3991-b3c7-11bc1c3b1f0c",
                        "source_sense_id": "450d0747-22d9-3a62-b29f-a3eacac8c225",
                        "source_sense_description": "interior fabric covering the roof of a vehicle",
                        "target_lang_word": "Himmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Himmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14081ebd-b3ec-388c-bf79-8978de11d6d5",
                                        "entry_id": "d8dc613c-1f52-3e9a-8ede-95de23d86794",
                                        "glosses": [
                                            "Luftraum, Gewölbe über der Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ebaabe-8011-4373-b402-96f156f01ee9",
                                                "sense_id": "14081ebd-b3ec-388c-bf79-8978de11d6d5",
                                                "text": "\"Wohlgeruch des Himmels / auf den Gräsern, / früher Abendregen.\" (Original ital.: Odore buono del cielo / sull’erbe, // pioggia di prima sera)"
                                            },
                                            {
                                                "example_id": "b04910a2-1935-4e19-bd35-b50bc66c3866",
                                                "sense_id": "14081ebd-b3ec-388c-bf79-8978de11d6d5",
                                                "text": "Wir mussten die Nacht unter freiem Himmel verbringen."
                                            },
                                            {
                                                "example_id": "1606dea1-21cc-4c7d-ac16-9ab614a5a01d",
                                                "sense_id": "14081ebd-b3ec-388c-bf79-8978de11d6d5",
                                                "text": "„Es dämmerte schon, als wir am Ende unserer Dorferkundung waren und die Mondsichel am Himmel auftauchte.“"
                                            },
                                            {
                                                "example_id": "966e75e5-263b-469f-b5aa-95ef09c048ae",
                                                "sense_id": "14081ebd-b3ec-388c-bf79-8978de11d6d5",
                                                "text": "„Als Lee Jay darunter stand, meinte er, es ginge in alle Unendlichkeit des schwarzen Himmels über ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "880f5a62-d142-35a6-a9ee-c741a9fa56a0",
                                        "entry_id": "d8dc613c-1f52-3e9a-8ede-95de23d86794",
                                        "glosses": [
                                            "Aufenthaltsort im Jenseits mit Gott und den Engeln, in den die Seligen nach ihrem Tode aufgenommen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8ce77d-e791-459c-a543-db714fbb1ef2",
                                                "sense_id": "880f5a62-d142-35a6-a9ee-c741a9fa56a0",
                                                "text": "\"Wer den Himmel auf Erden sucht, hat im Erdkundeunterricht geschlafen.\""
                                            },
                                            {
                                                "example_id": "10b10213-324b-4e77-9175-972e3867507b",
                                                "sense_id": "880f5a62-d142-35a6-a9ee-c741a9fa56a0",
                                                "text": "„Die Antike kennt die Bergeshöhen als Sitz der Musen, die nahe am Himmel und bei den Göttern wohnen.“"
                                            },
                                            {
                                                "example_id": "b74ca618-19db-4a88-b555-d3bbc7f32bd2",
                                                "sense_id": "880f5a62-d142-35a6-a9ee-c741a9fa56a0",
                                                "text": "„Ein Handwerker stirbt mit 50, kommt in den Himmel und beschwert sich bei Petrus, dass er so früh hat sterben müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "01649bff-1820-3a89-9c9c-78816e2aff1f",
                                        "entry_id": "d8dc613c-1f52-3e9a-8ede-95de23d86794",
                                        "glosses": [
                                            "der Kosmos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e271473d-661d-499e-8359-515f9184c8e8",
                                                "sense_id": "01649bff-1820-3a89-9c9c-78816e2aff1f",
                                                "text": "Mit dem neuen Teleskop können sie weit in den Himmel sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d7a71a0e-dcef-304b-b207-177b10c61898",
                                        "entry_id": "d8dc613c-1f52-3e9a-8ede-95de23d86794",
                                        "glosses": [
                                            "Decke aus Stoff oder ähnlichem Material"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee4ffcb-fa55-484f-b7a7-0e0ad3cb7c46",
                                                "sense_id": "d7a71a0e-dcef-304b-b207-177b10c61898",
                                                "text": "Er wurde dabei von einem Himmel beschirmt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6ce67e37-772c-3087-b421-2e90c80372ee",
                                        "entry_id": "d8dc613c-1f52-3e9a-8ede-95de23d86794",
                                        "glosses": [
                                            "Innenverkleidung der Dachhaut in Kraftfahrzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2956c572-4e10-4ae5-9fba-61a236d21872",
                                                "sense_id": "6ce67e37-772c-3087-b421-2e90c80372ee",
                                                "text": "Der Himmel in unseren PKW hat sich gelöst und muss daher wieder angeklebt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
