                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915bed70-c301-4713-be8a-873e8d5a87f2",
                                                "sense_id": "98681567-0d06-346f-aedd-b88b3779d197",
                                                "text": "Il trouva dans le bois un renard pris au traquet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7fad2cf-ce55-3067-90e4-dd8eda612dd5",
