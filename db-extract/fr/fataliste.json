                    },
                    {
                        "translation_id": "79f02dea-7edd-4981-930a-570078a74110",
                        "source_entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                        "target_lang_word": "fatalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07c206db-0438-3b23-a5ac-d16aa3e7b901",
                                        "entry_id": "a45ec80e-4376-371c-95f6-438185b52ff2",
                                        "glosses": [
                                            "One who maintains that all things happen by inevitable necessity; a person who believes in fatalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de3ca73c-2e2a-47e3-b7cd-279580bae371",
                                                "sense_id": "07c206db-0438-3b23-a5ac-d16aa3e7b901",
                                                "text": "....it is that, with every day, my love for you increases—though that would seem to be almost an impossibility. Why should I not become a fatalist? Remember how, on the third day that we ascended the Shlangenberg, I was moved to whisper in your ear: 'Say but the word, and I will leap into the abyss.' Had you said it, I should have leapt. Do you not believe me?\""
                                            },
                                            {
                                                "example_id": "9e86723a-56ab-4c3e-8d40-fa6603f7cd7b",
                                                "sense_id": "07c206db-0438-3b23-a5ac-d16aa3e7b901",
                                                "text": "“Maybe the problem is that you’re a romantic,” says my former lover-slash-friend-slash-male-sensitivity-reader. “And maybe so are the other fatalists.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd904288-5966-40c9-bf8f-1f9d02f0c527",
                        "source_entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                        "target_lang_word": "fatalista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatalista",
