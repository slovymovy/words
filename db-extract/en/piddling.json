    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c0957f2f-de33-3644-80f6-3ee5f9bca5b7",
                "word": "piddling",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "45f8623d-a0d4-3019-beb6-b621b4cc6c30",
                        "entry_id": "c0957f2f-de33-3644-80f6-3ee5f9bca5b7",
                        "glosses": [
                            "Insignificant, negligible, paltry, trivial, useless."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ead791d1-018d-4367-bfde-3c638394dabe",
                                "sense_id": "45f8623d-a0d4-3019-beb6-b621b4cc6c30",
                                "text": "After all the work I'd done, he gave me a piddling amount of money."
                            },
                            {
                                "example_id": "fd84796a-827d-436e-b3a3-73ab9aa991e6",
                                "sense_id": "45f8623d-a0d4-3019-beb6-b621b4cc6c30",
                                "text": "the ignoble hucksterage of piddling tithes"
                            },
                            {
                                "example_id": "d5e27091-1c3f-4668-8bc7-1504856b6ae5",
                                "sense_id": "45f8623d-a0d4-3019-beb6-b621b4cc6c30",
                                "text": "Los Angeles would still be a piddling little town in a desert if it weren’t for Sierra snowmelt and city officials crafty enough to snooker eastern California farmers out of their water rights."
                            },
                            {
                                "example_id": "7b094a2e-cecb-4028-bad3-8e9d249ec197",
                                "sense_id": "45f8623d-a0d4-3019-beb6-b621b4cc6c30",
                                "text": "[…]last month the Pentagon spent $400mn to take a 15 per cent stake in MP Materials, a Nevada-based group that aims to be “a fully integrated rare earths producer”. That is a piddling sum."
                            }
                        ]
                    }
                ],
