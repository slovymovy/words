                "translations": [
                    {
                        "translation_id": "b92eeeb6-c467-4432-a8ce-89e97fe81ac5",
                        "source_entry_id": "29af9fb6-d40f-3006-8deb-f92a4e9f2a6a",
                        "source_sense_id": "ba87b35d-db36-3691-9cc8-528eb97a2de7",
                        "source_sense_description": "blaasinstrument met een rechte conische boring en een los dubbel riet dat de toon vormt",
                        "target_lang_word": "Schalmei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schalmei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bada90a9-ce37-3cbf-a95a-32e303007bdb",
                                        "entry_id": "e8eb08af-3f4d-324a-b737-5750b43537ba",
                                        "glosses": [
                                            "Oberbegriff für alle Blasinstrumente mit einfachem und doppeltem Rohrblatt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f5f9d57-4334-4645-acb7-101f46bede26",
                                                "sense_id": "bada90a9-ce37-3cbf-a95a-32e303007bdb",
                                                "text": "„Und in der Morgenfrühe des darauffolgenden Tages wurden die Trommeln gerührt, ward in Schalmeien, Hörner und Posaunen gestoßen, und man brach auf, um gegen den Feind zu kämpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e87d96e-1712-3300-bbc1-0063bcdaa171",
                                        "entry_id": "e8eb08af-3f4d-324a-b737-5750b43537ba",
                                        "glosses": [
                                            "mittelalterliches Blasinstrument mit doppeltem Rohrblatt und sechs bis sieben Grifflöchern"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "006bafd5-553d-407f-896d-0afa2ddd0bb5",
                                                "sense_id": "3e87d96e-1712-3300-bbc1-0063bcdaa171",
                                                "text": "„Die Schalmei war das Lieblingsinstrument der Hirten. Der pastorale Charakter haftet auch den den aus der Schalmei entwickelten Instrumenten - z.B. der Oboe - und den für sie geschriebenen Tonstücken an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9ba92b5f-c52e-3b72-9af8-546e8c8b6b20",
                                        "entry_id": "e8eb08af-3f4d-324a-b737-5750b43537ba",
                                        "glosses": [
                                            "ein Blechblasinstrument mit mehreren Schallröhren"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6068ba82-b912-38c2-b186-2cfe547b6249",
                                        "entry_id": "e8eb08af-3f4d-324a-b737-5750b43537ba",
                                        "glosses": [
                                            "Zungenregister einer Orgel"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d31cd085-c57e-455f-a341-c2d710552eb1",
                        "source_entry_id": "29af9fb6-d40f-3006-8deb-f92a4e9f2a6a",
                        "source_sense_id": "ba87b35d-db36-3691-9cc8-528eb97a2de7",
                        "source_sense_description": "blaasinstrument met een rechte conische boring en een los dubbel riet dat de toon vormt",
                        "target_lang_word": "shawm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shawm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5de3ffa9-0d15-3346-b0e1-57b3d1c83c5b",
                                        "entry_id": "543e848a-4147-3ff0-baaa-9416f112a88a",
                                        "glosses": [
                                            "A mediaeval double-reed wind instrument with a conical wooden body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7e9375-a4f1-438c-a2b9-cce890414c71",
                                                "sense_id": "5de3ffa9-0d15-3346-b0e1-57b3d1c83c5b",
                                                "text": "And all the field is thick with companies\nOf fair-clothed men that play on shawms and lutes\nAnd gather honey of the yellow fruits\nBetween the branches waxen soft and wide"
                                            },
                                            {
                                                "example_id": "b5d660a2-c8cb-46a2-a099-f03a34d46cb2",
                                                "sense_id": "5de3ffa9-0d15-3346-b0e1-57b3d1c83c5b",
                                                "text": "There are four flutes, a harp of twenty strings, a mournful shawm, and a number of drums of oxhide, some to be struck, others spanked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d26e2895-a7cc-464e-b43e-b8c993565a0e",
                        "source_entry_id": "29af9fb6-d40f-3006-8deb-f92a4e9f2a6a",
                        "source_sense_id": "ba87b35d-db36-3691-9cc8-528eb97a2de7",
                        "source_sense_description": "blaasinstrument met een rechte conische boring en een los dubbel riet dat de toon vormt",
                        "target_lang_word": "chalemie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
