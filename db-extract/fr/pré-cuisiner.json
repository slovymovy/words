                ],
                "senses": [
                    {
                        "sense_id": "e685b490-96e6-3a85-8eaa-a3ff5b7a7c65",
                        "entry_id": "97157e36-8bd5-3bbd-bb5e-48ed0fd39420",
                        "glosses": [
                            "Cuisiner à l’avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5400275-2c51-44e7-866d-2d6579570d31",
                                "sense_id": "e685b490-96e6-3a85-8eaa-a3ff5b7a7c65",
                                "text": "Ainsi la ménagère laisse à l’industrie le soin de conserver et de pré-cuisiner les fruits, les légumes ou la viande car elle ne cherche plus à passer de longues heures devant ses fourneaux."
                            },
                            {
                                "example_id": "1e45a77c-4853-4bbd-a731-0a3431c00c86",
                                "sense_id": "e685b490-96e6-3a85-8eaa-a3ff5b7a7c65",
                                "text": "À la manière d’une mise en place dans les cuisines professionnelles, l’idée est de pré-cuisiner à l’avance pour ne plus avoir qu’à assembler les plats (ou les réchauffer) au dernier moment."
                            },
                            {
                                "example_id": "494bc0ae-d64b-4b27-93ae-de7f2acc8647",
                                "sense_id": "e685b490-96e6-3a85-8eaa-a3ff5b7a7c65",
                                "text": "Il a eu l’audace de pré-cuisiner certains aliments."
                            }
                        ]
                    }
                ],
