                },
                {
                    "sense_id": "a78e64fb-7e08-3b61-b7b5-ea035007239c",
                    "sense_definition": "Gradually becoming weaker, smaller, or less healthy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weakening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener tried to save the <w>withering</w> plant by giving it more water.",
                            "target_lang_translations": {
                                "cs": "Zahradník se pokusil zachránit <w>vadnoucí</w> rostlinu tím, že jí dal více vody."
                            }
                        },
                        {
                            "text": "He watched his <w>withering</w> hopes of success fade away as the project failed.",
                            "target_lang_translations": {
                                "cs": "Sledoval, jak jeho <w>chřadnoucí</w> naděje na úspěch mizí, když projekt ztroskotal."
                            }
