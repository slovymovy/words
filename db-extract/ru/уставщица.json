                "senses": [
                    {
                        "sense_id": "65dcb93a-3753-3f4f-aabe-ac7a4bc54bcc",
                        "entry_id": "ffae76d9-b4cd-3e9e-80aa-9efcaa15cf65",
                        "glosses": [
                            "церк. женск. к уставщик; послушница, наблюдающая за исполнением церковного устава или за порядком чтения и пения в церкви"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f5f1fa2-3685-4b08-95c3-ae244077b7a2",
                                "sense_id": "65dcb93a-3753-3f4f-aabe-ac7a4bc54bcc",
                                "text": "В передней повозке тщедушный Василий Борисыч с толстой уставщицей Аркадией сел."
                            },
                            {
                                "example_id": "81af91ac-5240-41f5-a1c3-0e2687dbd23d",
                                "sense_id": "65dcb93a-3753-3f4f-aabe-ac7a4bc54bcc",
                                "text": "Тут в затвор вошла уставщица, инокиня, объясняющая, какие молитвы и по каким книгам затворнице читать дальше."
                            }
                        ]
                    }
