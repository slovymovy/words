                ],
                "senses": [
                    {
                        "sense_id": "29d05e67-29c6-3e7f-8afb-14b9342661e3",
                        "entry_id": "cabd3b0b-8565-3823-ab5b-574d3b8dddc7",
                        "glosses": [
                            "Qualifie une plante, ou l'aliment fabriqué à partir de celle-ci, qui contient une grande quantité de protides."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "7909d3c2-2659-46e5-b2ee-f298dc2e5f5a",
                                "sense_id": "29d05e67-29c6-3e7f-8afb-14b9342661e3",
                                "text": "Cet ouvrage présente les connaissances actuelles sur l’écophysiologie du pois protéagineux : développement végétatif et reproducteur, croissance en condition non limitante, nutrition azotée."
                            },
                            {
                                "example_id": "ab5d8436-6987-48e2-a23d-647a800cdd91",
                                "sense_id": "29d05e67-29c6-3e7f-8afb-14b9342661e3",
                                "text": "Il est difficile d'augmenter la teneur en énergie des graines protéagineuses qui se distinguent des graines oléoprotéagineuses par leur faible teneur en lipides. Seules, des améliorations portant sur la digestibilité paraissent possibles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "70df69fb-996d-34d5-89fc-52310a609f8f",
                "word": "protéagineux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4086b12b-dee0-3f77-a4c8-eafa2dbfe715",
                        "entry_id": "70df69fb-996d-34d5-89fc-52310a609f8f",
                        "glosses": [
                            "Une telle plante riche en protides."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "bbec3bd1-7a22-481a-8edd-2b13b191a329",
                                "sense_id": "4086b12b-dee0-3f77-a4c8-eafa2dbfe715",
                                "text": "L’azote est un facteur limitant en non labour. Rien que le fait d’introduire un protéagineux dans la rotation peut pallier cet inconvénient."
                            },
                            {
                                "example_id": "c022c796-61e9-4dff-8b7f-40dfde871fe3",
                                "sense_id": "4086b12b-dee0-3f77-a4c8-eafa2dbfe715",
                                "text": "Les pois protéagineux, la fèverole, le lupin font partie de la famille des protéagineux."
                            },
                            {
                                "example_id": "1220b5a9-5d18-4b85-98cf-b8a32feafda6",
                                "sense_id": "4086b12b-dee0-3f77-a4c8-eafa2dbfe715",
                                "text": "Non : ils veulent juste protéger leur propre filière française d’huile tirée du colza et leur groupe agro-industriel Avril, qui produit oléagineux et protéagineux, et ne se gêne pas pour importer 200 000 tonnes d’huile de palme par an."
                            }
                        ]
                    }
                ],
