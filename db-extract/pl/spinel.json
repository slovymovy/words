                "senses": [
                    {
                        "sense_id": "70994529-0c81-3579-9b69-2bd84e9e6ef5",
                        "entry_id": "6cf1cd7c-55de-3e5e-8e4c-c02dfc237d54",
                        "glosses": [
                            "minerał zawierający tlenki metali, występujący w wielu barwnych odmianach"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4380932a-ea4f-3a0b-9ee7-ca32c15bcc58",
                        "entry_id": "6cf1cd7c-55de-3e5e-8e4c-c02dfc237d54",
                        "glosses": [
                            "kamień szlachetny z oszlifowanego spinelu (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15e6fe97-74a5-4bd9-94b9-a1b47998f03e",
                                "sense_id": "4380932a-ea4f-3a0b-9ee7-ca32c15bcc58",
                                "text": "Spinel może mieć wiele różnych barw, lecz najbardziej popularny jest spinel czerwony, przez wiele lat uznawany za rubin."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c11e860a-0417-4ce4-96c2-dd9ac01041de",
                        "source_entry_id": "6cf1cd7c-55de-3e5e-8e4c-c02dfc237d54",
                        "source_sense_id": "70994529-0c81-3579-9b69-2bd84e9e6ef5",
                        "target_lang_word": "spinel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spinel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5cfb2bc-6f85-3384-8828-03be9235bcc0",
                                        "entry_id": "234b4882-7aba-33c0-bb05-2adf55cb3381",
                                        "glosses": [
                                            "Any of several hard minerals of cubic symmetry that are mixed oxides of magnesium and aluminium and are used as gemstones of various colours."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9009728-defb-47a7-aac5-4cb9760bba90",
                                                "sense_id": "c5cfb2bc-6f85-3384-8828-03be9235bcc0",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cd0b95f-8710-3fee-b128-73e20a540fed",
                                        "entry_id": "234b4882-7aba-33c0-bb05-2adf55cb3381",
                                        "glosses": [
                                            "Any crystalline material, not necessarily an oxide, that possesses the same crystal structure as this mineral."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spinel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91a061b7-fefe-3272-90cc-28ad2debf85a",
                                        "entry_id": "31457e6c-595b-3d09-a9fc-80a59d8595df",
                                        "glosses": [
                                            "Spindle; the amount of yarn that fits on a spindle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ad7e6c6-c31b-4e1f-b40b-b6a0dc5bb34c",
                                                "sense_id": "91a061b7-fefe-3272-90cc-28ad2debf85a",
                                                "text": "[…] raised the price of that staple of yarn (of one Spinel in the pound weight) from 23d. to 26d. per Spinel."
                                            },
                                            {
                                                "example_id": "42161bc7-fbb5-41ea-b807-3560bbe098c6",
                                                "sense_id": "91a061b7-fefe-3272-90cc-28ad2debf85a",
                                                "text": "339, 612 yards of dimities, muslinets, jaconets, and booked muslins, from rod. to 20s. per yard, and, 4000. spinels of thread and yarn, were bleached by him in 1791, and 45 people were employed in the work."
                                            },
                                            {
                                                "example_id": "d73cd9d4-55fa-4f5a-9437-e2381c8ebb41",
                                                "sense_id": "91a061b7-fefe-3272-90cc-28ad2debf85a",
                                                "text": "... that is fit for any hundred of the reed; and like- wise the number of right telled yarn in spinels, slips, and cuts, that will be sufficient to make any number of ells from 1 to 60, subject, and merely consisted of tables or ready[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
