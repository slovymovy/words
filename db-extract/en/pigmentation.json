                    },
                    {
                        "translation_id": "4861d3e6-95ed-4307-a7f3-dfb4891e25af",
                        "source_entry_id": "2caa4c59-0499-3fb9-bc1f-19896d8706f1",
                        "source_sense_id": "9ec45ba1-d846-354b-9ec6-4d9f4b8d558f",
                        "source_sense_description": "coloration of tissue",
                        "target_lang_word": "pigmentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pigmentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                        "entry_id": "4606d199-61ef-3c82-80cb-2d64f42df896",
                                        "glosses": [
                                            "Processus par lequel des pigments biologiques se déposent dans un tissu, ainsi que l’état de coloration qui en résulte, notamment pour la peau, les cheveux ou l’iris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1efce8a6-57f7-44d1-85c1-ca9feeb4d37b",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "L’exposition au soleil tend à foncer la pigmentation de l’iris"
                                            },
                                            {
                                                "example_id": "5d31faf1-e9c4-4ab0-8b10-a88d39d49c23",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "Bien des animaux sont pourvus de dispositifs qui associent des pigmentations et des structures à effets optiques pour agir selon le milieu : caméléon, divers crustacés et batraciens, nombreux poissons."
                                            },
                                            {
                                                "example_id": "b1eba8b3-d2e7-41ef-9c6d-55db3e6728bf",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "Or, si la pigmentation de l’épiderme est un fait biologique, les caractères qui y sont associés et les catégories raciales qui ont été élaborées à partir d’elle sont le résultat d’une construction historique."
                                            },
                                            {
                                                "example_id": "9f9fcb6a-e86d-4fb6-a8cf-17bbc74c231f",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "La coccinelle asiatique Harmonia axyridis montre un polymorphisme remarquable pour la pigmentation des élytres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a794be8a-9827-4a50-8763-aaf6c5ce4ff8",
                        "source_entry_id": "2caa4c59-0499-3fb9-bc1f-19896d8706f1",
                        "source_sense_id": "9ec45ba1-d846-354b-9ec6-4d9f4b8d558f",
                        "source_sense_description": "coloration of tissue",
                        "target_lang_word": "Pigmentierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pigmentierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "105af4f9-13f0-34a8-9ebe-3cf5341d0678",
                                        "entry_id": "f63b3d24-ddd1-315c-833d-a326b72eebfa",
                                        "glosses": [
                                            "Bildung, Produktion von Pigment (Farbstoff) im eigenen Körper"
                                        ],
                                        "tags": [
                                            "Biologie, Medizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bffa64f8-c879-489b-b38d-8cc61bc02367",
                                                "sense_id": "105af4f9-13f0-34a8-9ebe-3cf5341d0678",
                                                "text": "„Sehr häufig treffen wir in den Lymphknoten Pigmentierung an, die teils durch vom Körper selbstgebildete Stoffe, teils von auben in ihm eingedrungene, bewirktist.“"
                                            },
                                            {
                                                "example_id": "3e8b84f5-3237-4c9f-a34a-7b622c682709",
                                                "sense_id": "105af4f9-13f0-34a8-9ebe-3cf5341d0678",
                                                "text": "„Bei diesen traumatisch bedingten braunen Linien ist die Pigmentierung auf eine Mischung von Hämorrhagie und postinflammatorischer Hyperpigmentierung zurückzuführen.“"
                                            },
                                            {
                                                "example_id": "537c25d7-483c-467a-9a32-84c31c89d712",
                                                "sense_id": "105af4f9-13f0-34a8-9ebe-3cf5341d0678",
                                                "text": "„Da die Ablagerungen, wie die mikroskopische Untersuchung (s. später) zeigt, an der Spitze der Papillen erfolgen, so treten die Pigmentierungen häufig als kleine Punkte oder als feine schwärzliche Streifungen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba26e599-39f8-3bbc-8183-76fb5ccdfa9f",
                                        "entry_id": "f63b3d24-ddd1-315c-833d-a326b72eebfa",
                                        "glosses": [
                                            "Färbung durch ein Pigment"
                                        ],
                                        "tags": [
                                            "Biologie, Medizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0352ccf5-b2fc-4b99-9749-2048bc7a1f9d",
                                                "sense_id": "ba26e599-39f8-3bbc-8183-76fb5ccdfa9f",
                                                "text": "„Die Pigmentierung des Haares erfolgt während des Wachstums […].“"
                                            },
                                            {
                                                "example_id": "0eec0e07-9720-4faa-9e4d-8e78f87911b6",
                                                "sense_id": "ba26e599-39f8-3bbc-8183-76fb5ccdfa9f",
                                                "text": "„Generell kann davon ausgegangen werden, dass zumindest größere Teile der Pigmentierung lebenslang bestehen können.“"
                                            },
                                            {
                                                "example_id": "cbd99ff4-3752-4ab8-821d-f6a7827258c8",
                                                "sense_id": "ba26e599-39f8-3bbc-8183-76fb5ccdfa9f",
                                                "text": "„Bei uns Menschen wären solche funktionellen Anpassungen beispielsweise der Verlust der Körperbehaarung und die Pigmentierung der Haut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
