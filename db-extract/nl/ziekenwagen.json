                                "target_senses": [
                                    {
                                        "sense_id": "8ad7030f-c2d5-379b-b285-11c299e8e372",
                                        "entry_id": "16ab8ea0-dc0c-38ea-8204-e8a7b3fd9a01",
                                        "glosses": [
                                            "Véhicule spécialement adapté au transport sanitaire terrestre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93838009-236c-37e6-8146-d1c81a387077",
                                        "entry_id": "16ab8ea0-dc0c-38ea-8204-e8a7b3fd9a01",
                                        "glosses": [
                                            "Sorte d’hôpital militaire qui suit une armée, un corps d’armée ou une division pour en recueillir les malades et les blessés."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e221cd81-407f-4b78-8e3f-95c02412be5f",
                                                "sense_id": "93838009-236c-37e6-8146-d1c81a387077",
                                                "text": "Tantôt il battait la charge, et l’éclair de ses dents blanches passait dans un rire féroce ; ou bien ses yeux se mouillaient à quelque aubade musulmane, sa narine se gonflait, et dans l’odeur fade de l’ambulance, au milieu des fioles et des compresses, il revoyait les bois de Blidah chargés d’oranges et de petites Mauresques sortant du bain, masquées de blanc et parfumées de verveine."
                                            },
                                            {
                                                "example_id": "81b6c3ac-c87b-429f-a3cc-a44731970e88",
                                                "sense_id": "93838009-236c-37e6-8146-d1c81a387077",
                                                "text": "Plusieurs compagnies manquaient de capitaine. La mienne avait à sa tête un petit lieutenant de mobiles, jeune homme de vingt ans, frêle et pâle, et si peu robuste, qu’après quelques kilomètres, il s’essoufflait, tirait la jambe et terminait l’étape dans un fourgon d’ambulance."
                                            },
                                            {
                                                "example_id": "3146daa3-dfa2-45e9-96c0-19af2a2472c3",
                                                "sense_id": "93838009-236c-37e6-8146-d1c81a387077",
                                                "text": "— Oui... aux Champs-Élysées... on y a établi une ambulance admirable dans les salles d'exposition... Le grand salon carré contient trente lits... et on y est soigné par des belles dames..."
                                            },
                                            {
                                                "example_id": "6e801a6e-648f-415f-9cb9-e7a280f9b167",
                                                "sense_id": "93838009-236c-37e6-8146-d1c81a387077",
                                                "text": "Traînant les pieds, je me dirige vers le poste de secours du régiment qui m’expédiera vers l’ambulance divisionnaire."
                                            },
                                            {
                                                "example_id": "37d22006-aaf8-4c81-a33f-c39a0f62022a",
                                                "sense_id": "93838009-236c-37e6-8146-d1c81a387077",
                                                "text": "Dans toutes les batailles de la Grande Guerre, l’armée russe manqua de munitions, ses ambulances manquèrent de médicaments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7be93258-79bc-3b88-b6c3-ecff9d020f22",
                                        "entry_id": "16ab8ea0-dc0c-38ea-8204-e8a7b3fd9a01",
                                        "glosses": [
                                            "Établissement hospitalier temporaire, pour suppléer aux hôpitaux dans une épidémie, durant une guerre ou en cas d’accident."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92452a0f-0f7a-363c-9f55-73187680814b",
                                        "entry_id": "16ab8ea0-dc0c-38ea-8204-e8a7b3fd9a01",
                                        "glosses": [
                                            "Emploi d’un commis qui est obligé de se transporter sur des points divers."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8513a8-d150-4e9b-b01c-78ce36f48fad",
                                                "sense_id": "92452a0f-0f7a-363c-9f55-73187680814b",
                                                "text": "Il obtint une ambulance dans les Domaines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
