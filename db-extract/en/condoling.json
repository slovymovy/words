                    {
                        "sense_id": "233aaf10-32e9-3dfc-9ec5-3e231cf14c5c",
                        "entry_id": "046df21a-83bf-356f-8a7e-79f2f4a01179",
                        "glosses": [
                            "Expressing condolence; sympathetic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2dba996-2d4f-4d60-8026-43455a86cd0c",
                                "sense_id": "233aaf10-32e9-3dfc-9ec5-3e231cf14c5c",
                                "text": "This is Ercles’ vein, a tyrant’s vein; a lover is more condoling."
                            },
                            {
                                "example_id": "69908a1a-50bd-4d5d-bf56-bd51f4bb17b3",
                                "sense_id": "233aaf10-32e9-3dfc-9ec5-3e231cf14c5c",
                                "text": "[…] having put the Ashes in a Silver Urn, and on it a Crown of Gold, he sent it in great state, with a condoling Letter, to the young Marcellus […]"
                            },
                            {
                                "example_id": "d4a857ec-188a-455b-8fa7-67fba9d7533e",
                                "sense_id": "233aaf10-32e9-3dfc-9ec5-3e231cf14c5c",
                                "text": "Why then dost treat me with Rebukes, instead\nOf kind condoling Cares and friendly Sorrow?"
                            },
                            {
                                "example_id": "7bfac7ca-495c-4f1f-9ec2-7cf95fb06d15",
                                "sense_id": "233aaf10-32e9-3dfc-9ec5-3e231cf14c5c",
                                "text": "The Brandeis house was besieged by condoling callers."
                            },
                            {
                                "example_id": "207321c9-41c7-4b20-bca1-2b869ed8db76",
                                "sense_id": "233aaf10-32e9-3dfc-9ec5-3e231cf14c5c",
                                "text": "I was just about to say something nice to Celia, I forget what but something condoling, when she lifted her face to me."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
