                "senses": [
                    {
                        "sense_id": "386c7026-5ed5-3083-9667-52abb9f7557b",
                        "entry_id": "f76c80b5-1a60-36dd-b34d-2754a1040af0",
                        "glosses": [
                            "de laatste stopplaats van een bus- of tramlijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a330ca28-4f39-4530-8215-edadaa501f3e",
                                "sense_id": "386c7026-5ed5-3083-9667-52abb9f7557b",
                                "text": "De hulpdiensten rukten met spoed uit naar het incident aan de Prins Hendrikkade. Onder andere een traumahelikopter is voor het slachtoffer, volgens ooggetuigen een man, opgestegen. Hij werd gereanimeerd, maar hulp mocht niet meer baten. Het gebied is afgezet voor onderzoek. Dit heeft gevolgen voor het openaar vervoer in de stad, stadsbussen en lijndiensten kunnen begin- of eindhaltes niet bereiken."
                            }
                        ]
                    },
                    {
                        "sense_id": "f83ab27d-d082-34d2-b522-2bee3d689a0d",
                        "entry_id": "f76c80b5-1a60-36dd-b34d-2754a1040af0",
                        "glosses": [
                            "bestemming van een reis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048f3321-65f6-41b3-b196-429c352d01b5",
                                "sense_id": "f83ab27d-d082-34d2-b522-2bee3d689a0d",
                                "text": "Op sociale media zijn foto’s te zien van gefrustreerde reizigers, die zich in een menigte bevinden van lotgenoten die voorlopig hun geplande eindhalte niet zullen halen. In Londen wordt de reizigers gevraagd het station Saint Pancras te verlaten en een overnachtingsplek te zoeken."
                            }
                        ]
                    }
