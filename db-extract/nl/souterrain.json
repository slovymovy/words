                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa10566-7999-40b3-a747-3fc8ef6cb10b",
                                                "sense_id": "db3f6d09-67f6-3a62-92a1-0147ad9c25b2",
                                                "text": "Most of my tools and hardware are in the garage, but I keep some tools in the cellar, too, mainly for convenience."
                                            }
                                        ]
