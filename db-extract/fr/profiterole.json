                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0180e3fe-a090-4f73-93ad-d51b3f5a7eb9",
                                "sense_id": "25295c13-b4c4-33b3-b682-59f72eaaf11c",
                                "text": "Voici la recette traditionnelle des profiteroles, si vous manquez de temps ou si vous voulez les préparer à l'avance, il existe des variantes."
                            },
                            {
                                "example_id": "180ac55b-3ad4-4e4f-9ef2-38dd638709ef",
                                "sense_id": "25295c13-b4c4-33b3-b682-59f72eaaf11c",
                                "text": "Dessert : farandole de 4 desserts (pavé fondant au chocolat, crème brûlée, profiterole au chocolat (choux frais du jour) et crumble aux fruits de saison)"
                            }
                        ]
                    }
