                "senses": [
                    {
                        "sense_id": "d00f7339-2986-3b6a-aa72-567fa42a9b26",
                        "entry_id": "d19c0616-2509-3ef2-aff2-0f4a864dd983",
                        "glosses": [
                            "Gesamtheit der Verkehrsteilnehmer, die ihre Fahrtrichtung bogenartig ändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db563eed-48fa-4305-946d-c4382ce7af33",
                                "sense_id": "d00f7339-2986-3b6a-aa72-567fa42a9b26",
                                "text": "„Am südlichen Abschnitt endet die Straße vorerst abrupt unter einer Brücke; der gesamte Schnellstraßenverkehr muß über eine Abfahrtrampe, die später nur dem Abbiegeverkehr dienen soll, in den normalen Stadtverkehr eingefädelt werden.“"
                            },
                            {
                                "example_id": "d38ef95b-0440-4903-8492-5cde8b940019",
                                "sense_id": "d00f7339-2986-3b6a-aa72-567fa42a9b26",
                                "text": "„Das Grünlicht für die Fußgänger und Radfahrer wird so geschaltet, dass der Abbiegeverkehr weiter Rot hat.“"
                            },
                            {
                                "example_id": "2c7f209c-b98e-4ce6-94bb-2851b6cb9ddb",
                                "sense_id": "d00f7339-2986-3b6a-aa72-567fa42a9b26",
                                "text": "„So könnte beispielsweise der Abbiegeverkehr von der Hauptstraße in Richtung Tangstedt gleichzeitig mit dem gegenläufigen Verkehr von der Tangstedter Chaussee aus eine Extra-Grünphase bekommen.“"
                            },
                            {
                                "example_id": "2810af6d-925b-4c2d-84c2-02756f351a96",
                                "sense_id": "d00f7339-2986-3b6a-aa72-567fa42a9b26",
                                "text": "„Abbiegeverkehre in das Ostend und die Bördestraße sind weiterhin nicht möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
