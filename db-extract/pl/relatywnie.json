                                                "sense_id": "ad975020-47ca-319c-bb33-6430dd8d08b6",
                                                "text": "Die Beweisführung der Staatsanwaltschaft war relativ lückenhaft und führte daher nicht zur Verurteilung des Angeklagten."
                                            },
                                            {
                                                "example_id": "c441cc99-e373-4b98-8aae-55aa1ac83ebf",
                                                "sense_id": "ad975020-47ca-319c-bb33-6430dd8d08b6",
                                                "text": "Das ist mir relativ egal!"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "ab4cb594-5cd1-3327-8ca9-6ab522aa652b",
