    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e0f9407-b362-3f34-b631-717baa287b27",
                    "sense_definition": "To welcome someone in a friendly manner, either in person or through other means such as writing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "welcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the door to <w>greet</w> her guests with a warm smile.",
                            "target_lang_translations": {
                                "ru": "Она пошла к двери, чтобы <w>встретить</w> гостей теплой улыбкой.",
                                "tr": "Misafirlerini sıcak bir gülümsemeyle <w>karşılamak</w> için kapıya gitti.",
                                "zh": "她走到门口，带着温暖的微笑<w>迎接</w>客人。",
                                "es": "Fue a la puerta para <w>saludar</w> a sus invitados con una cálida sonrisa."
                            }
                        },
                        {
                            "text": "The host <w>greeted</w> us at the entrance and showed us to our table.",
                            "target_lang_translations": {
                                "ru": "Хозяин <w>поприветствовал</w> нас у входа и проводил к нашему столику.",
                                "tr": "Ev sahibi bizi girişte <w>karşıladı</w> ve masamıza kadar eşlik etti.",
                                "zh": "主人在入口处<w>问候</w>我们，并带我们入座。",
                                "es": "El anfitrión nos <w>saludó</w> en la entrada y nos acompañó a nuestra mesa."
                            }
                        }
                    ],
                    "synonyms": [
                        "welcome"
                    ],
                    "common_phrases": [
                        "greet a friend",
                        "greet with a smile",
                        "greet warmly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приветствовать кого-либо дружелюбно, лично или иным способом (например, письменно).",
                        "tr": "Birini bizzat veya yazı gibi diğer yollarla dostça karşılamak, selam vermek.",
                        "zh": "以友好的方式欢迎某人，无论是亲自见面还是通过书信等其他方式。",
                        "es": "Dar la bienvenida a alguien de manera amistosa, ya sea en persona o por otros medios como por escrito."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приветствовать",
                                "target_lang_sense_clarification": "обращаться с приветствием"
                            },
                            {
                                "target_lang_word": "здороваться",
                                "target_lang_sense_clarification": "говорить «здравствуйте» или жать руку"
                            },
                            {
                                "target_lang_word": "встречать",
                                "target_lang_sense_clarification": "принимать гостей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "selamlamak",
                                "target_lang_sense_clarification": "birine selam vermek veya nezaket göstermek"
                            },
                            {
                                "target_lang_word": "karşılamak",
                                "target_lang_sense_clarification": "gelen birini hoş karşılamak"
                            },
                            {
                                "target_lang_word": "selam vermek",
                                "target_lang_sense_clarification": "sözle veya işaretle selamlaşmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问候",
                                "target_lang_sense_clarification": "打招呼或致意"
                            },
                            {
                                "target_lang_word": "迎接",
                                "target_lang_sense_clarification": "在某人到达时接待"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "saludar",
                                "target_lang_sense_clarification": "dirigir palabras o gestos de cortesía al encontrarse con alguien"
                            },
                            {
                                "target_lang_word": "dar la bienvenida",
                                "target_lang_sense_clarification": "recibir a alguien con amabilidad al llegar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bfde528-8682-33ea-8f9b-93e1a75a6913",
                    "sense_definition": "To be noticed by or present itself to someone's sight, hearing, or other senses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perceive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A spectacular view of the ocean <w>greeted</w> us when we reached the summit.",
                            "target_lang_translations": {
                                "ru": "Захватывающий вид на океан <w>встретил</w> нас, когда мы достигли вершины.",
                                "tr": "Zirveye ulaştığımızda muhteşem bir okyanus manzarası bizi <w>karşıladı</w>.",
                                "zh": "当我们到达山顶时，壮观的海洋景色<w>映入眼帘</w>。",
                                "es": "Una vista espectacular del océano nos <w>recibió</w> cuando llegamos a la cima."
                            }
                        },
                        {
                            "text": "The smell of fresh coffee <w>greeted</w> him as he walked into the kitchen.",
                            "target_lang_translations": {
                                "ru": "Запах свежего кофе <w>встретил</w> его, когда он вошел в кухню.",
                                "tr": "Mutfağa girdiğinde taze kahve kokusu onu <w>karşıladı</w>.",
                                "zh": "他走进厨房时，新鲜咖啡的香气<w>扑面而来</w>。",
                                "es": "El olor a café recién hecho lo <w>recibió</w> al entrar en la cocina."
                            }
                        }
                    ],
                    "common_phrases": [
                        "greet the eye",
                        "greet the ear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представать перед чьим-либо взором, слухом или другими чувствами; быть замеченным.",
                        "tr": "Birinin gözüne, kulağına veya diğer duyularına çarpmak, karşısına çıkmak.",
                        "zh": "指某种景象、声音或气味映入眼帘、传入耳中或被感官察觉。",
                        "es": "Ser percibido por la vista, el oído u otros sentidos de alguien; presentarse ante alguien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встречать",
                                "target_lang_sense_clarification": "попадаться на глаза или навстречу"
                            },
                            {
                                "target_lang_word": "приветствовать",
                                "target_lang_sense_clarification": "метафорически: о звуках, запахах или видах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşılamak",
                                "target_lang_sense_clarification": "görüşe veya duyulara çarpmak, çıkmak"
                            },
                            {
                                "target_lang_word": "karşılaşmak",
                                "target_lang_sense_clarification": "bir manzara veya koku ile yüz yüze gelmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "映入眼帘",
                                "target_lang_sense_clarification": "指景象出现在眼前"
                            },
                            {
                                "target_lang_word": "扑面而来",
                                "target_lang_sense_clarification": "指气味或感觉迎面而来"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "recibir",
                                "target_lang_sense_clarification": "encontrarse con algo al llegar a un lugar (ej. una vista o un olor)"
                            },
                            {
                                "target_lang_word": "presentarse",
                                "target_lang_sense_clarification": "aparecer ante la vista o los sentidos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffde621f-c250-377d-9f05-cb6f764d29eb",
                    "sense_definition": "To weep or cry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little child started to <w>greet</w> when he lost his favorite toy.",
                            "target_lang_translations": {
                                "ru": "Маленький ребенок начал <w>плакать</w>, когда потерял свою любимую игрушку.",
                                "tr": "Küçük çocuk en sevdiği oyuncağını kaybedince <w>ağlamaya</w> başladı.",
                                "zh": "那个小孩子弄丢了他最喜欢的玩具后就开始<w>哭泣</w>。",
                                "es": "El niño pequeño empezó a <w>llorar</w> cuando perdió su juguete favorito."
                            }
                        },
                        {
                            "text": "She sat in the corner and <w>greeted</w> quietly to herself.",
                            "target_lang_translations": {
                                "ru": "Она сидела в углу и тихо <w>плакала</w> про себя.",
                                "tr": "Köşede oturdu ve kendi kendine sessizce <w>ağladı</w>.",
                                "zh": "她坐在角落里，独自一人静静地<w>哭泣</w>。",
                                "es": "Se sentó en el rincón y <w>lloró</w> en silencio para sí misma."
                            }
                        }
                    ],
                    "synonyms": [
                        "cry",
                        "weep",
                        "wail"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scottish and Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плакать или рыдать (диалектное значение).",
                        "tr": "Ağlamak veya feryat etmek (İskoç ve Kuzey İngiltere diyalekti).",
                        "zh": "哭泣或流泪（方言用法）。",
                        "es": "Llorar o sollozar (término dialectal)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плакать",
                                "target_lang_sense_clarification": "проливать слезы"
                            },
                            {
                                "target_lang_word": "рыдать",
                                "target_lang_sense_clarification": "громко плакать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ağlamak",
                                "target_lang_sense_clarification": "gözyaşı dökmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哭泣",
                                "target_lang_sense_clarification": "流泪或发出哭声"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "llorar",
                                "target_lang_sense_clarification": "derramar lágrimas"
                            },
                            {
                                "target_lang_word": "sollozar",
                                "target_lang_sense_clarification": "llorar con espasmos"
                            }
                        ]
                    }
                }
            ]
