                        "examples": [
                            {
                                "example_id": "dbc3d405-2c15-4eb1-a0a8-14adf7c8ea43",
                                "sense_id": "8abd47ce-056f-30ee-a73d-178e1a673515",
                                "text": "Вот наше последнее строение ― курник, одни стены, без крыши."
                            }
                        ]
                    },
                    {
                        "sense_id": "9efac84e-6072-3b5e-8022-c520cff24068",
                        "entry_id": "7576b73c-ca18-3d5e-a691-bc0a56ef2683",
                        "glosses": [
                            "пирог с куриным мясом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38eeaecb-b92f-4f1e-a305-087d6bb43867",
                                "sense_id": "9efac84e-6072-3b5e-8022-c520cff24068",
                                "text": "За павлинами следовали кулебяки, курники, пироги с мясом и с сыром, блины всех возможных родов, кривые пирожки и оладьи."
                            }
                        ]
                    }
