                        "source_entry_id": "788a52a7-c30d-3711-a59f-67394d81c93f",
                        "source_sense_id": "72bdbc9a-4c98-359b-80f3-712111634fe5",
                        "source_sense_description": "relating to the Presbyterian Church",
                        "target_lang_word": "presbytérien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presbytérien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc748250-a4b4-399b-85ce-e6357e8e3591",
                                        "entry_id": "34dd9f87-806f-3101-a03b-dbc796a1906c",
                                        "glosses": [
                                            "Nom donné en Angleterre aux protestants qui ne reconnaissent pas l’autorité épiscopale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d793f1f6-7d8e-46ba-b8ed-6a5c079dfa32",
                                                "sense_id": "dc748250-a4b4-399b-85ce-e6357e8e3591",
                                                "text": "Il est vrai que Robert Baillie, un presbytérien écossais, tenta, en 1644, de se procurer le livre, ainsi que sa réfutation par Chandieu."
                                            },
                                            {
                                                "example_id": "0a72db49-388b-4804-a1ba-2388e95988f7",
                                                "sense_id": "dc748250-a4b4-399b-85ce-e6357e8e3591",
                                                "text": "Les presbytériens sont opposés aux épiscopaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "presbytérien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "199280d3-ec11-3e44-b22f-575be7a9e918",
                                        "entry_id": "46226721-037e-3120-b594-79a29f60b51f",
                                        "glosses": [
                                            "Qualifie ces protestants, leurs doctrines, leurs rites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58456504-2b7b-44ab-92f0-1b0db7abbe39",
                                                "sense_id": "199280d3-ec11-3e44-b22f-575be7a9e918",
                                                "text": "La vue, de ma fenêtre, était obscurcie par l’église presbytérienne dont notre maison n’était séparée que par une cour et une ruelle."
                                            },
                                            {
                                                "example_id": "4fe3629e-0add-4b1f-b650-8e72ebcac445",
                                                "sense_id": "199280d3-ec11-3e44-b22f-575be7a9e918",
                                                "text": "On comprend bien des choses si l’on sait que chacun de ces hommes devait être enterré selon les rites de sa bande, avec tout ce qu’il peut y avoir de prières : catholiques, juives, puritaines, presbytériennes, méthodistes, parsies, jaines, musulmanes."
                                            },
                                            {
                                                "example_id": "6183cbee-dc7a-45f6-9fbf-09262491ca8b",
                                                "sense_id": "199280d3-ec11-3e44-b22f-575be7a9e918",
                                                "text": "Â ^([sic]) l’âge de 10 ans, la famille s’installe à Téhéran (Iran) et le jeune Lotfi suit des études dans une école de missionnaires presbytériens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e06aa8-73ea-3f88-89a7-00cf8baadc1f",
                                        "entry_id": "46226721-037e-3120-b594-79a29f60b51f",
                                        "glosses": [
                                            "Relatif au presbytère."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dcc37f9-3a47-4791-9873-1b97eb0596ae",
                                                "sense_id": "02e06aa8-73ea-3f88-89a7-00cf8baadc1f",
                                                "text": "La petite maison presbytérienne qu’on m’avait donnée n’était que mon pied-à-terre, j’y mangeais et j’y couchais, voilà tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
