{
    "word_family": [
        "roost",
        "roosting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d3ebdc7-d3d0-313a-a42c-33fc06072796",
                    "sense_definition": "An adult male domestic chicken or other gallinaceous bird.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rooster</w> began to crow loudly at the first sign of dawn.",
                            "target_lang_translations": {
                                "ru": "<w>Петух</w> начал громко кукарекать при первых признаках рассвета.",
                                "zh": "天刚露出曙光，那只<w>公鸡</w>就开始大声打鸣了。"
                            }
                        },
                        {
                            "text": "We could hear a <w>rooster</w> crowing from the neighboring farm every morning.",
                            "target_lang_translations": {
                                "ru": "Каждое утро мы слышали, как на соседней ферме кукарекает <w>петух</w>.",
                                "zh": "每天早晨，我们都能听见邻近农场里的<w>公鸡</w>打鸣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cock"
                    ],
                    "common_phrases": [
                        "rooster crowing",
                        "morning rooster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослый самец домашней курицы или других птиц отряда курообразных.",
                        "zh": "成年雄性家鸡，或其他鸡形目鸟类的雄鸟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петух",
                                "target_lang_sense_clarification": "самец курицы"
                            },
                            {
                                "target_lang_word": "кочет",
                                "target_lang_sense_clarification": "диалектное название петуха"
                            },
                            {
                                "target_lang_word": "певень",
                                "target_lang_sense_clarification": "региональное название петуха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公鸡",
                                "target_lang_sense_clarification": "家养鸡的成年雄性"
                            },
                            {
                                "target_lang_word": "雄鸡",
                                "target_lang_sense_clarification": "较书面或泛指雄性鸡类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48ac717b-8df1-35ee-8913-fd42a56e421a",
                    "sense_definition": "A person who is powerful, prideful, or behaves in a pompous manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He strutted around the office like a <w>rooster</w> after getting the promotion.",
                            "target_lang_translations": {
                                "ru": "После повышения он расхаживал по офису, как важный <w>петух</w>.",
                                "zh": "升职以后，他在办公室里走来走去，活像个<w>神气活现的人</w>。"
                            }
                        },
                        {
                            "text": "The young executive acted like a <w>rooster</w> of the walk during the meeting.",
                            "target_lang_translations": {
                                "ru": "Молодой руководитель вел себя на собрании как <w>хозяин положения</w>.",
                                "zh": "开会时，那位年轻主管表现得像个<w>趾高气扬的人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cock of the walk",
                        "cock of the roost",
                        "important person"
                    ],
                    "common_phrases": [
                        "rooster of the walk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Властный, горделивый человек или тот, кто ведет себя напыщенно.",
                        "zh": "指有权势、傲慢自负或举止十分摆架子的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петух",
                                "target_lang_sense_clarification": "переносно о задиристом или важном человеке"
                            },
                            {
                                "target_lang_word": "задира",
                                "target_lang_sense_clarification": "человек, стремящийся к конфликту"
                            },
                            {
                                "target_lang_word": "важная птица",
                                "target_lang_sense_clarification": "иронично о человеке, считающем себя значимым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "趾高气扬的人",
                                "target_lang_sense_clarification": "形容人骄傲自大、爱摆架子"
                            },
                            {
                                "target_lang_word": "神气活现的人",
                                "target_lang_sense_clarification": "形容人得意洋洋、爱显摆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "893c8ad2-61e8-38b2-a070-0ee6a4249c6f",
                    "sense_definition": "A bird or bat that is currently resting or sleeping in a specific place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist observed the <w>roosters</w> as they settled into the trees for the night.",
                            "target_lang_translations": {
                                "ru": "Биолог наблюдал за <w>птицами на насесте</w>, когда они устраивались на деревьях на ночлег.",
                                "zh": "生物学家观察着这些<w>夜栖的鸟</w>飞到树上过夜。"
                            }
                        },
                        {
                            "text": "Ground <w>roosters</w> are often more vulnerable to predators during the night.",
                            "target_lang_translations": {
                                "ru": "Птицы, <w>ночующие на земле</w>, часто более уязвимы для хищников в ночное время.",
                                "zh": "夜间，在地面栖息的<w>栖息中的鸟</w>往往更容易受到捕食者攻击。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ground roosters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Птица или летучая мышь, отдыхающая или спящая в определенном месте.",
                        "zh": "指正在某个地方休息或睡觉的鸟或蝙蝠。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "птица на насесте",
                                "target_lang_sense_clarification": "о птице в месте отдыха"
                            },
                            {
                                "target_lang_word": "ночующая птица",
                                "target_lang_sense_clarification": "о птице во время сна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夜栖的鸟",
                                "target_lang_sense_clarification": "指正在某处栖息或睡觉的鸟"
                            },
                            {
                                "target_lang_word": "栖息中的鸟",
                                "target_lang_sense_clarification": "泛指正在停栖休息的鸟或蝙蝠"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bfddd09-24be-3986-94bc-534a6b9a0611",
                    "sense_definition": "A slang or informal term for a man.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a tough old <w>rooster</w> who has seen many changes in this town.",
                            "target_lang_translations": {
                                "ru": "Он крепкий старый <w>малый</w>, который повидал немало перемен в этом городе.",
                                "zh": "他是个硬朗的老<w>家伙</w>，见证了这座镇上许多变化。"
                            }
                        },
                        {
                            "text": "The old <w>rooster</w> spent his afternoons sitting on the porch.",
                            "target_lang_translations": {
                                "ru": "Старый <w>дед</w> проводил послеобеденное время, сидя на крыльце.",
                                "zh": "那个老<w>汉子</w>整个下午都坐在门廊上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "man"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage for a man"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое или неформальное обозначение мужчины.",
                        "zh": "俚语或非正式用法，指男人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старик",
                                "target_lang_sense_clarification": "неформальное обращение или описание мужчины"
                            },
                            {
                                "target_lang_word": "малый",
                                "target_lang_sense_clarification": "разговорное обозначение мужчины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老家伙",
                                "target_lang_sense_clarification": "口语，指上了年纪的男人"
                            },
                            {
                                "target_lang_word": "汉子",
                                "target_lang_sense_clarification": "口语，泛指男人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9663852-c438-3d5d-8c30-7cfefc26396c",
                    "sense_definition": "A person who is prone to violence or creates disorder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bar was known for attracting every <w>rooster</w> looking for a fight.",
                            "target_lang_translations": {
                                "ru": "Бар был известен тем, что привлекал каждого <w>забияку</w>, ищущего драки.",
                                "zh": "这家酒吧出了名，总会吸引各种来找架打的<w>好斗的人</w>。"
                            }
                        },
                        {
                            "text": "The police had to remove the <w>rooster</w> from the crowd before things got worse.",
                            "target_lang_translations": {
                                "ru": "Полиции пришлось вывести <w>скандалиста</w> из толпы, пока ситуация не ухудшилась.",
                                "zh": "情况恶化之前，警察不得不把那个<w>闹事者</w>从人群中带走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brawler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, склонный к насилию или создающий беспорядки.",
                        "zh": "指容易诉诸暴力或制造混乱的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забияка",
                                "target_lang_sense_clarification": "человек, провоцирующий драки"
                            },
                            {
                                "target_lang_word": "драчун",
                                "target_lang_sense_clarification": "человек, любящий драться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好斗的人",
                                "target_lang_sense_clarification": "指喜欢打架、容易动武的人"
                            },
                            {
                                "target_lang_word": "闹事者",
                                "target_lang_sense_clarification": "指制造骚乱或挑事的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71c86968-ee77-3acf-8456-cd928c9eca89",
                    "sense_definition": "A person who provides information to the authorities; an informant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang suspected there was a <w>rooster</w> among them talking to the police.",
                            "target_lang_translations": {
                                "ru": "Банда подозревала, что среди них есть <w>стукач</w>, говорящий с полицией.",
                                "zh": "那帮人怀疑他们中间有个向警方通风报信的<w>线人</w>。"
                            }
                        },
                        {
                            "text": "He acted as a <w>rooster</w> for the detectives to reduce his own sentence.",
                            "target_lang_translations": {
                                "ru": "Он работал <w>информатором</w> на детективов, чтобы сократить себе срок.",
                                "zh": "为了减轻自己的刑期，他给警探当了<w>告密者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "informant"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предоставляющий информацию властям; осведомитель.",
                        "zh": "向当局提供信息的人；告密者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стукач",
                                "target_lang_sense_clarification": "презрительное обозначение осведомителя"
                            },
                            {
                                "target_lang_word": "информатор",
                                "target_lang_sense_clarification": "лицо, сообщающее сведения полиции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "线人",
                                "target_lang_sense_clarification": "向警方等当局提供消息的人"
                            },
                            {
                                "target_lang_word": "告密者",
                                "target_lang_sense_clarification": "带贬义，向当局秘密告发他人的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b0c5925-d03b-3bfc-9c75-327005aade71",
                    "sense_definition": "Legislation specifically designed to provide financial benefit to the legislators who proposed it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics labeled the new bill a <w>rooster</w> intended to line the pockets of politicians.",
                            "target_lang_translations": {
                                "ru": "Критики назвали новый законопроект <w>кормушкой</w>, призванной набить карманы политиков.",
                                "zh": "批评者把这项新法案称作一项让政客中饱私囊的<w>自肥法案</w>。"
                            }
                        },
                        {
                            "text": "The newspaper exposed the <w>rooster</w> hidden within the complex tax legislation.",
                            "target_lang_translations": {
                                "ru": "Газета разоблачила <w>личную выгоду</w>, скрытую в сложном налоговом законодательстве.",
                                "zh": "报纸揭露了复杂税法中暗藏的<w>自肥条款</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American political slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законодательство, разработанное для обеспечения финансовой выгоды предложивших его законодателей.",
                        "zh": "专门设计来让提出该法案的立法者获得经济利益的立法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коррупционный закон",
                                "target_lang_sense_clarification": "закон в интересах политиков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自肥法案",
                                "target_lang_sense_clarification": "为提案者谋取私利的法案"
                            },
                            {
                                "target_lang_word": "自肥条款",
                                "target_lang_sense_clarification": "藏在法律中的牟利性规定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d353ba-afd9-33b7-ab6f-a5d70f3c4992",
                    "sense_definition": "A wild violet used in a specific children's game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children spent the afternoon playing hens and <w>roosters</w> with the flowers.",
                            "target_lang_translations": {
                                "ru": "Дети провели вторую половину дня, играя в «курочек и <w>петушков</w>» с цветами.",
                                "zh": "孩子们整个下午都在用花玩“母鸡和<w>野紫罗兰</w>”的游戏。"
                            }
                        },
                        {
                            "text": "She picked a blue violet to use as her <w>rooster</w> in the game.",
                            "target_lang_translations": {
                                "ru": "Она сорвала синюю фиалку, чтобы использовать её в качестве своего <w>петушка</w> в игре.",
                                "zh": "她摘了一朵蓝色紫罗兰，在游戏里当作自己的<w>野紫罗兰</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used in children's games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дикая фиалка, используемая в определенной детской игре.",
                        "zh": "一种用于特定儿童游戏的野生紫罗兰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиалка",
                                "target_lang_sense_clarification": "цветок, используемый в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "野紫罗兰",
                                "target_lang_sense_clarification": "用于某种儿童游戏中的野生紫罗兰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d5716c0a-21d4-30b2-9c5b-2c96cc05a5dc",
                    "sense_definition": "The tenth animal in the 12-year cycle of the Chinese zodiac.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zodiac",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "According to the Chinese calendar, 2017 was the Year of the <w>Rooster</w>.",
                            "target_lang_translations": {
                                "ru": "Согласно китайскому календарю, 2017 год был годом <w>Петуха</w>.",
                                "zh": "按照中国农历，2017年是<w>鸡</w>年。"
                            }
                        },
                        {
                            "text": "People born under the sign of the <w>Rooster</w> are said to be hardworking and observant.",
                            "target_lang_translations": {
                                "ru": "Говорят, что люди, рожденные под знаком <w>Петуха</w>, трудолюбивы и наблюдательны.",
                                "zh": "据说属<w>鸡</w>的人勤奋又善于观察。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "year of the rooster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Десятое животное в 12-летнем цикле китайского зодиака.",
                        "zh": "中国十二生肖中排第十的动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Петух",
                                "target_lang_sense_clarification": "знак китайского гороскопа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸡",
                                "target_lang_sense_clarification": "中国十二生肖中的第十个属相"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}