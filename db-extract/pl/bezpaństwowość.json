                        "cross_references": [
                            {
                                "target_word": "apatridie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a66cc87f-72d2-3837-b41a-04ff7f0fca44",
                                        "entry_id": "ac7f9c5a-09a6-3f4a-8ce3-0005fb5f50c1",
                                        "glosses": [
                                            "État, condition d’une personne apatride : qui n’a pas de patrie ni de nationalité."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5e84df9-2c4e-4117-b0e7-3b609cd235ef",
                                                "sense_id": "a66cc87f-72d2-3837-b41a-04ff7f0fca44",
                                                "text": "L’apatridie touche aujourd’hui (2014) plus de 12 millions de personnes dans le monde, et près de 600 000 personnes en Europe."
                                            },
                                            {
                                                "example_id": "4d7fa737-e2f8-47d2-9a51-c86550a33283",
                                                "sense_id": "a66cc87f-72d2-3837-b41a-04ff7f0fca44",
                                                "text": "Il est nécessaire qu’un individu ait une nationalité; l’apatridie est une situation difficilement tolérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad797ef7-89d7-415d-9121-c9a37947b1a1",
                        "source_entry_id": "c287c661-4910-378c-8fc4-3070bfc1d87a",
