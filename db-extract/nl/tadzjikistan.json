                                                "sense_id": "f6e16ed5-8d3e-3025-b162-3387cbd67536",
                                                "text": "Über zwei Drittel der Fläche Tadschikistans sind Hochgebirge."
                                            },
                                            {
                                                "example_id": "8326d3fb-761e-46f6-84c5-dbf535326b6b",
                                                "sense_id": "f6e16ed5-8d3e-3025-b162-3387cbd67536",
                                                "text": "Das Tadschikistan der 90er Jahre war vom Bürgerkrieg geprägt."
                                            },
