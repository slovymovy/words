                                        "examples": [
                                            {
                                                "example_id": "43cb7493-416d-44cb-8e1b-85cc22ddf461",
                                                "sense_id": "dbf1a1b7-f680-3ea8-9114-0b69d15914c8",
                                                "text": "Il est la seule personne restante de cette famille."
                                            },
                                            {
                                                "example_id": "0f6c022f-314e-4c98-8fa8-0699add49102",
                                                "sense_id": "dbf1a1b7-f680-3ea8-9114-0b69d15914c8",
                                                "text": "C’est le seul héritier restant de quatre qu’ils étaient."
                                            },
                                            {
                                                "example_id": "bc19897d-8525-4fc1-8920-ed398e81af68",
                                                "sense_id": "dbf1a1b7-f680-3ea8-9114-0b69d15914c8",
                                                "text": "La somme restante."
                                            },
                                            {
                                                "example_id": "9d361d41-4485-4bb7-8643-40f3739629c4",
                                                "sense_id": "dbf1a1b7-f680-3ea8-9114-0b69d15914c8",
                                                "text": "Les cent francs restants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "restant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0d8e0c-d0ea-3343-b9e0-0ea5c5d4f544",
                                        "entry_id": "d3be25ca-c000-3dee-ac2d-a8a2b6e6bde4",
                                        "glosses": [
                                            "Ce qui reste d’une plus grande somme, d’une plus grande quantité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2eb37b0-c1af-4a96-be42-6e5c047dd121",
                                                "sense_id": "ab0d8e0c-d0ea-3343-b9e0-0ea5c5d4f544",
                                                "text": "Je vous paierai le restant avec les intérêts."
                                            },
                                            {
                                                "example_id": "6ca771a0-04b0-4acf-908e-e47a5962ee86",
                                                "sense_id": "ab0d8e0c-d0ea-3343-b9e0-0ea5c5d4f544",
                                                "text": "C’est là tout le restant de ma fortune."
                                            },
                                            {
                                                "example_id": "a0964212-d5ff-4e4b-a422-9f1b75dee38d",
                                                "sense_id": "ab0d8e0c-d0ea-3343-b9e0-0ea5c5d4f544",
                                                "text": "Seigneur, combien l’on est fatigué de Rostand !\nCar Rostand a toujours dans son stock un restant."
                                            },
                                            {
                                                "example_id": "047fdc80-7f48-493b-9ad6-fc9a796a07b6",
                                                "sense_id": "ab0d8e0c-d0ea-3343-b9e0-0ea5c5d4f544",
                                                "text": "— Pour ce soir, tu devrais juste faire chauffer un restant de soupe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "restant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f83603be-d5be-37bb-9929-557e570ec591",
                                        "entry_id": "e5ee9400-77ab-39d3-9ee5-04ff1b84b1be",
                                        "glosses": [
                                            "Participe présent de rester."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745413eb-1a0b-4b67-9351-0a2d59f719e8",
                                                "sense_id": "f83603be-d5be-37bb-9929-557e570ec591",
                                                "text": "Elle re-sensorialise dans l’œuvre d’art, bien que par des voies détournées et tout en restant libre, les invisibles objets de la pensée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
