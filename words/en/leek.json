                    "common_phrases": [
                        "broadleaf wild leek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой вид дикорастущих растений, внешне похожий на обычный окультуренный овощ."
                    },
                    "translations": {
                        "ru": [
                            {
