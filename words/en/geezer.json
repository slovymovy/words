{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d9a054f-a4f3-32de-9638-49ea16755278",
                    "sense_definition": "An old person, usually a male, who is often perceived as cranky or eccentric.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "old_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two old <w>geezers</w> sat on the porch and complained about the noisy neighborhood kids.",
                            "target_lang_translations": {
                                "ru": "Два старых <w>старика́шки</w> сидели на крыльце и жаловались на шумных соседских детей.",
                                "pl": "Dwóch starych <w>dziadów</w> siedziało na ganku i narzekało na hałaśliwe dzieci z sąsiedztwa."
                            }
                        },
                        {
                            "text": "He is just a grumpy old <w>geezer</w> who refuses to learn how to use a smartphone.",
                            "target_lang_translations": {
                                "ru": "Он просто ворчливый старый <w>старика́шка</w>, который отказывается учиться пользоваться смартфоном.",
                                "pl": "To po prostu zrzędliwy <w>staruszek</w>, który nie chce nauczyć się obsługi smartfona."
                            }
                        }
                    ],
                    "synonyms": [
                        "codger",
                        "gaffer"
                    ],
                    "common_phrases": [
                        "old geezer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term often used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пожилой человек, обычно мужчина, часто воспринимаемый как ворчливый или эксцентричный.",
                        "pl": "Starsza osoba, zazwyczaj mężczyzna, często postrzegana jako zrzędliwa lub ekscentryczna."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старика́шка",
                                "target_lang_sense_clarification": "разговорное, часто пренебрежительное обозначение пожилого человека"
                            },
                            {
                                "target_lang_word": "стари́к",
                                "target_lang_sense_clarification": "общее обозначение пожилого мужчины"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "staruszek",
                                "target_lang_sense_clarification": "potoczne, często lekko lekceważące określenie starszego mężczyzny"
                            },
                            {
                                "target_lang_word": "dziad",
                                "target_lang_sense_clarification": "potoczne, często pejoratywne określenie starszego, zrzędliwego mężczyzny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f0d7749-7f40-3851-9175-6333575ee0f3",
                    "sense_definition": "A man or a guy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "man",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That young <w>geezer</w> thinks he knows everything about cars.",
                            "target_lang_translations": {
                                "ru": "Этот молодой <w>па́рень</w> думает, что знает всё об автомобилях.",
                                "pl": "Ten młody <w>facet</w> myśli, że wie wszystko o samochodach."
                            }
                        },
                        {
                            "text": "I saw a <w>geezer</w> walking his dog in the park this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром я видел, как какой-то <w>мужи́к</w> гулял в парке с собакой.",
                                "pl": "Widziałem dziś rano jakiegoś <w>gościa</w> spacerującego z psem w parku."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloke",
                        "guy",
                        "fella"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term, particularly common in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина или парень.",
                        "pl": "Mężczyzna lub facet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужи́к",
                                "target_lang_sense_clarification": "разговорное обозначение мужчины"
                            },
                            {
                                "target_lang_word": "па́рень",
                                "target_lang_sense_clarification": "молодой мужчина"
                            },
                            {
                                "target_lang_word": "чува́к",
                                "target_lang_sense_clarification": "сленговое обозначение мужчины"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "facet",
                                "target_lang_sense_clarification": "potoczne określenie mężczyzny"
                            },
                            {
                                "target_lang_word": "gość",
                                "target_lang_sense_clarification": "nieformalne określenie mężczyzny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28425607-d973-3258-923b-6988b5729a1f",
                    "sense_definition": "A man who is streetwise, confident, and sometimes involved in questionable activities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "man",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acts like a proper <w>geezer</w> whenever he is out with his friends at the pub.",
                            "target_lang_translations": {
                                "ru": "Он ведет себя как настоящий <w>мужи́к</w>, когда отдыхает с друзьями в пабе.",
                                "pl": "Zachowuje się jak prawdziwy <w>cwaniak</w>, kiedy wychodzi z kumplami do pubu."
                            }
                        },
                        {
                            "text": "The local <w>geezer</w> always has a new business scheme to tell you about.",
                            "target_lang_translations": {
                                "ru": "У местного <w>мужика́</w> всегда есть новая бизнес-схема, о которой он хочет рассказать.",
                                "pl": "Miejscowy <w>cwaniak</w> zawsze ma jakiś nowy biznesowy plan, o którym chce ci opowiedzieć."
                            }
                        }
                    ],
                    "synonyms": [
                        "wide boy"
                    ],
                    "common_phrases": [
                        "proper geezer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly informal, associated with British working-class culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, который уверен в себе, знает жизнь и иногда вовлечен в сомнительные дела.",
                        "pl": "Mężczyzna pewny siebie, obeznany w życiu, czasem zaangażowany w podejrzane interesy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужи́к",
                                "target_lang_sense_clarification": "в значении уверенного в себе, бывалого человека"
                            },
                            {
                                "target_lang_word": "кент",
                                "target_lang_sense_clarification": "сленговое, часто с криминальным или уличным оттенком"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "cwaniak",
                                "target_lang_sense_clarification": "osoba przebiegła, znająca życie"
                            },
                            {
                                "target_lang_word": "twardziel",
                                "target_lang_sense_clarification": "mężczyzna pewny siebie, nieustępliwy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79230a0-c900-3b35-91ec-15af91e738f8",
                    "sense_definition": "A casual way to address a man.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "man",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>geezer</w>, how are you doing today?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>стари́к</w>, как дела сегодня?",
                                "pl": "Hej <w>stary</w>, jak się dzisiaj masz?"
                            }
                        },
                        {
                            "text": "Listen here <w>geezer</w>, I need a bit of help with this heavy box.",
                            "target_lang_translations": {
                                "ru": "Слушай, <w>мужи́к</w>, мне нужна небольшая помощь с этой тяжелой коробкой.",
                                "pl": "Słuchaj <w>koleś</w>, potrzebuję pomocy z tym ciężkim pudłem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a direct form of address among men."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальный способ обращения к мужчине.",
                        "pl": "Nieformalny sposób zwracania się do mężczyzny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужи́к",
                                "target_lang_sense_clarification": "разговорное обращение мужчин друг к другу"
                            },
                            {
                                "target_lang_word": "стари́к",
                                "target_lang_sense_clarification": "дружеское, фамильярное обращение к приятелю"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "stary",
                                "target_lang_sense_clarification": "potoczne, przyjacielskie zwracanie się do kolegi"
                            },
                            {
                                "target_lang_word": "koleś",
                                "target_lang_sense_clarification": "nieformalne zwracanie się do mężczyzny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c10bb995-d804-3fd6-b7cc-3549353b812d",
                    "sense_definition": "An old woman or a wife.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "old_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>geezer</w> sat by the window watching the street all day.",
                            "target_lang_translations": {
                                "ru": "Старая <w>старуше́нция</w> весь день сидела у окна, наблюдая за улицей.",
                                "pl": "Stara <w>staruszka</w> siedziała przy oknie, obserwując ulicę przez cały dzień."
                            }
                        },
                        {
                            "text": "He always talks fondly about his old <w>geezer</w> back home.",
                            "target_lang_translations": {
                                "ru": "Он всегда с теплотой говорит о своей <w>старушке</w>, оставшейся дома.",
                                "pl": "Zawsze z czułością mówi o swojej <w>staruszce</w> w domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "old woman"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Rare and non-standard usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пожилая женщина или жена.",
                        "pl": "Starsza kobieta lub żona."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старуше́нция",
                                "target_lang_sense_clarification": "разговорное, фамильярное обозначение пожилой женщины"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "staruszka",
                                "target_lang_sense_clarification": "potoczne określenie starszej kobiety"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0fcf5c5d-0fe6-312c-a4dd-6ab48c4a3033",
                    "sense_definition": "A domestic water heater.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>geezer</w> in the kitchen is leaking and needs to be replaced.",
                            "target_lang_translations": {
                                "ru": "<w>Водонагреватель</w> на кухне протекает, и его нужно заменить.",
                                "pl": "<w>Podgrzewacz wody</w> w kuchni przecieka i wymaga wymiany."
                            }
                        },
                        {
                            "text": "We have no hot water because the old <w>geezer</w> stopped working.",
                            "target_lang_translations": {
                                "ru": "У нас нет горячей воды, потому что старый <w>водонагреватель</w> перестал работать.",
                                "pl": "Nie mamy ciepłej wody, bo stary <w>podgrzewacz</w> przestał działać."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional variant of geyser."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бытовой водонагреватель.",
                        "pl": "Domowy podgrzewacz wody."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водонагреватель",
                                "target_lang_sense_clarification": "бытовой прибор для нагрева воды"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podgrzewacz wody",
                                "target_lang_sense_clarification": "domowy bojler"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}