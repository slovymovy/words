                        "glosses": [
                            "A familiar salutation or welcome offered by a host before a meal or drinks are served."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6be2dbeb-31fb-412c-a5dc-d383c7152272",
                                "sense_id": "c4650c84-baf9-3a08-b932-a372893cdd46",
                                "text": "Sweet sir, sit; I’ll be with you anon; most sweet sir, Master Page, good Master Page, sit. Proface! What you want in meat, we’ll have in drink."
                            },
                            {
                                "example_id": "e4798045-0851-4941-af17-31b852bfc589",
                                "sense_id": "c4650c84-baf9-3a08-b932-a372893cdd46",
                                "text": "Gloria deo, sirs proface,\nAttend me now whilst I say grace."
                            },
                            {
                                "example_id": "ae48eb25-96be-41cb-b026-fb3e7a964dfa",
                                "sense_id": "c4650c84-baf9-3a08-b932-a372893cdd46",
                                "text": "Thankes be giuen for flesh and fishes,\nWith this choice of tempting dishes:\nTo which proface: with blythe lookes sit yee,\nRush bids this Couent, much good do’t yee."
                            }
                        ]
                    }
