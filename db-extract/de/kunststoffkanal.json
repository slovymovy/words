                "senses": [
                    {
                        "sense_id": "8dc8025b-cd5d-3a7a-afec-0ed069fd8e20",
                        "entry_id": "a5b90367-3672-3466-a93e-731ee2eaab3c",
                        "glosses": [
                            "ein aus Kunststoff hergestellter Kanal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8e45d0-1a5b-44a0-bc96-a7a0aca429b6",
                                "sense_id": "8dc8025b-cd5d-3a7a-afec-0ed069fd8e20",
                                "text": "Es gibt ihn in Kunststoff-, Aluminium- und in Stahlblechausführung, wobei der Kunststoffkanal in der Praxis überwiegt."
                            },
                            {
                                "example_id": "80d51e97-149d-4e1a-b411-12d7714ea2dd",
                                "sense_id": "8dc8025b-cd5d-3a7a-afec-0ed069fd8e20",
                                "text": "Ausführung D zeigt ein hydraulisch dämpfendes Achsträgerlager mit einem eingelegten Kunststoffkanal."
                            },
                            {
                                "example_id": "228771cf-4322-4717-846f-6006595fd4cc",
                                "sense_id": "8dc8025b-cd5d-3a7a-afec-0ed069fd8e20",
                                "text": "Er leitet die Königin mittels Aluminiumblenden durch einen glasklaren Kunststoffkanal in ein Schwarmfanggerät beziehungsweise in einen Ablegerkasten."
                            },
                            {
                                "example_id": "73e80e44-ed1d-4cda-b827-4e386f996611",
                                "sense_id": "8dc8025b-cd5d-3a7a-afec-0ed069fd8e20",
                                "text": "In jedem Raum wird die von je einem Axialventilator umgewälzte Luft durch Kunststoffkanäle und Doppelwände gleichmässig verteilt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
