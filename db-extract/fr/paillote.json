                "senses": [
                    {
                        "sense_id": "e7435e4e-136e-3a8f-876b-a0deb1ed12e2",
                        "entry_id": "907e74cf-63a7-3347-877f-7a4d33807f60",
                        "glosses": [
                            "Hutte faite de paille, propre aux pays tropicaux et équatoriaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b0e23f-ed81-41bc-957e-2819d538c79a",
                                "sense_id": "e7435e4e-136e-3a8f-876b-a0deb1ed12e2",
                                "text": "Le problème des maisons transportables est chose résolue par ici. Huit solides gaillards indigènes nous ont apporté, l'une après l'autre, sur leurs épaules, trois grandes paillotes où nous allons nous loger extérieurement au village."
                            }
                        ]
                    },
                    {
                        "sense_id": "07cf411c-3064-34e4-8a37-ce801444a2a4",
                        "entry_id": "907e74cf-63a7-3347-877f-7a4d33807f60",
                        "glosses": [
                            "Habitation précaire, chez des peuples civilisés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "78321574-7b32-3397-bdb8-2457aa6f9695",
                        "entry_id": "907e74cf-63a7-3347-877f-7a4d33807f60",
                        "glosses": [
                            "Commerce établi dans une telle construction, généralement un bar ou un restaurant sur une plage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c552d1f8-01cb-44c2-854e-89a38534321c",
                                "sense_id": "78321574-7b32-3397-bdb8-2457aa6f9695",
                                "text": "Les paillotes aperçues dans la perspective des rues, avec leurs silhouettes de purgatoire, se perdaient au fond de la nuit calme et presque solennelle, dans l’odeur de poisson et des graisses brûlées : […]."
                            },
                            {
                                "example_id": "4f9c3922-c44d-421c-8621-6df43fc787b0",
                                "sense_id": "78321574-7b32-3397-bdb8-2457aa6f9695",
                                "text": "On va prendre un verre à la paillote ?"
                            }
                        ]
                    }
                ],
