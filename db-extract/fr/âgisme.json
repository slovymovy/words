                "senses": [
                    {
                        "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                        "entry_id": "58068799-fe63-3107-bdce-e9d0e4103dd9",
                        "glosses": [
                            "Discrimination basée sur l’âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06b9e196-7766-46d5-806a-80a24ccbdbc7",
                                "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                                "text": "« On a décidé de se rebeller contre l’âgisme », déclare d’emblée Natacha Dzikowski. Un combat aussi mené par Caroline Ida Ours et Nicole Tonnelle."
                            },
                            {
                                "example_id": "8bd254f2-6e15-4135-bcd0-d7a9e51bbf0e",
                                "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                                "text": "Pour l’écrivaine et psychanalyste Marie de Hennezel, les situations de maltraitance dans les Ehpad sont à mettre en corrélation avec l’âgisme de nos sociétés occidentales, où la vieillesse est présentée sous ses aspects négatifs."
                            },
                            {
                                "example_id": "533f9db0-17a7-4970-83d4-9657f1d0b4e1",
                                "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                                "text": "Je m’oppose à l’adultisme et à l’âgisme, ces formes de domination qui considèrent les enfants comme des sous humains, avant leurs 18 ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4302335-c296-45a4-98fb-ba46d6b25d01",
                        "source_entry_id": "58068799-fe63-3107-bdce-e9d0e4103dd9",
                        "source_sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                        "target_lang_word": "ageism",
