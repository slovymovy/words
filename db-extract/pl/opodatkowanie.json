                    {
                        "translation_id": "2fc5642e-2572-4bd3-8920-e131bf51dfc5",
                        "source_entry_id": "ba776137-afe8-34a3-beef-19851b55c1b6",
                        "source_sense_id": "3bfac5ff-9ac6-3424-9f65-43a2c25cf58b",
                        "target_lang_word": "Besteuerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besteuerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                        "entry_id": "2fcc90e8-7d45-33b4-8e27-7c4d52142a0f",
                                        "glosses": [
                                            "das Erheben von Steuern für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e0fd3c-26b7-4bbe-8a91-62e10b74d268",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Betrugsanfällig bleibt der Handel mit den CO₂-Verschmutzungsrechten trotzdem — weil die Besteuerung EU-weit nach wie vor nicht einheitlich geregelt ist.“"
                                            },
                                            {
                                                "example_id": "bc531dea-666f-4db7-91fc-f31a563aa73a",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Für Ricardo besteht die einzige logisch und politisch befriedigende Lösung in einer immer höheren Besteuerung der Bodenrente.“"
                                            },
                                            {
                                                "example_id": "ef64baed-14c2-4d5e-a400-cd8c3d9ee7e5",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Sie forderten deshalb eine höhere Besteuerung und eine Verstaatlichung des Abbaus.“"
                                            },
                                            {
                                                "example_id": "498cd2d4-d50e-4a02-ba41-2b31d937e50b",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Die Münzverrufung brachte dem Münzherren einen Gewinn, dem Münzbesitzer aber einen realen Verlust und stellte gleichsam eine Form indirekter Besteuerung dar.“"
                                            },
                                            {
                                                "example_id": "13ba2880-a87f-42c8-b20a-421a4515ecce",
                                                "sense_id": "4ac2e90e-2f6d-31a5-813c-f939c2963555",
                                                "text": "„Das erschwerte ihre Besteuerung, so dass man einen Judenpfennig erhob, und zwar abweichend von der üblichen Praxis auf jedes einzelne Mitglied der Familie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa7ce532-4cb1-4181-be6f-4d10e0249ad0",
                        "source_entry_id": "ba776137-afe8-34a3-beef-19851b55c1b6",
                        "source_sense_id": "3bfac5ff-9ac6-3424-9f65-43a2c25cf58b",
