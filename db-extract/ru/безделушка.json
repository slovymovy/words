                "senses": [
                    {
                        "sense_id": "33639828-794b-3740-bca9-8ea7c2b9756f",
                        "entry_id": "ad14932e-dcb0-3b68-93ca-a0ad8b424b68",
                        "glosses": [
                            "knick-knack, trifle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328f66dd-f412-4d07-b165-70e908481a00",
                                "sense_id": "33639828-794b-3740-bca9-8ea7c2b9756f",
                                "text": "Она́ провела́ офице́ра че́рез две ко́мнаты, похо́жие на гости́ную, че́рез за́лу и останови́лась в своём кабине́те, где стоя́л же́нский пи́сьменный сто́лик, весь уста́вленный безделу́шками.",
                                "translation": "She led the officer through two rooms similar to the drawing-room, through a large reception hall, and came to a stop in her study, where there was a lady's writing-table covered with little knick-knacks.",
                                "english": "She led the officer through two rooms similar to the drawing-room, through a large reception hall, and came to a stop in her study, where there was a lady's writing-table covered with little knick-knacks."
                            }
                        ]
                    }
