                "senses": [
                    {
                        "sense_id": "f27976c0-0349-3d72-b7ca-7b35c7c5190e",
                        "entry_id": "d6470164-95eb-3eea-9195-7f3e8bd869a3",
                        "glosses": [
                            "Bissverletzung, verursacht durch einen Hund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f507d13-bde8-420e-9e3e-844999054465",
                                "sense_id": "f27976c0-0349-3d72-b7ca-7b35c7c5190e",
                                "text": "Er wurde wegen eines Hundebisses in ein Krankenhaus eingeliefert."
                            },
                            {
                                "example_id": "0ef41503-fdb1-4295-97bc-f20a578f0c22",
                                "sense_id": "f27976c0-0349-3d72-b7ca-7b35c7c5190e",
                                "text": "„Die Bissverletzung war zwar nicht weiter schlimm, aber nach einem Tag, der mit einem großen Kater begonnen und mit einem schmerzhaften Hundebiss geendet hatte, wollte ich mich nur noch auf ein Zimmer verziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
