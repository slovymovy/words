                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The data set is <w>normally</w> distributed across the population.",
                            "target_lang_translations": {
                                "ru": "Набор данных <w>нормально</w> распределён по совокупности.",
