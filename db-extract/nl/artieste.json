                "translations": [
                    {
                        "translation_id": "51544106-e5e6-4dd7-b06f-c653ce30fefd",
                        "source_entry_id": "fac8d0bc-b6da-3089-8bdc-3590bae70a7d",
                        "source_sense_id": "0e82a04c-e6b4-30d8-b422-1c7b5957cefb",
                        "target_lang_word": "Künstlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Künstlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32b964fc-b636-3bef-878a-d500368b11b5",
                                        "entry_id": "1fb044b9-73ff-35ad-98d1-fc26060184ac",
                                        "glosses": [
                                            "weibliche Person, die oft, vielleicht beruflich, Kunstwerke erschafft oder kreativen Tätigkeiten nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ca112d-2945-41ca-baae-e2406112fffb",
                                                "sense_id": "32b964fc-b636-3bef-878a-d500368b11b5",
                                                "text": "Sie ist eine große Künstlerin."
                                            },
                                            {
                                                "example_id": "998a78b4-eebf-48ee-838f-44392afc8977",
                                                "sense_id": "32b964fc-b636-3bef-878a-d500368b11b5",
                                                "text": "„Während sie in der Zeit vor und während des Nationalsozialismus große Erfolge als Künstlerin feierte und mit vielen Auszeichnungen geehrt wurde, kehrte sich dies in der Nachkriegszeit um.“"
                                            },
                                            {
                                                "example_id": "773e01a9-e73f-4676-809c-9aa5e830f6f7",
                                                "sense_id": "32b964fc-b636-3bef-878a-d500368b11b5",
                                                "text": "„Charlotte wollte Künstlerin werden.“"
                                            },
                                            {
                                                "example_id": "953f0553-0968-4f72-aa32-6c7d0fe6e456",
                                                "sense_id": "32b964fc-b636-3bef-878a-d500368b11b5",
                                                "text": "„Um Dupré für die Verwirklichung meines Planes zu gewinnen und ihm die Gewißheit zu geben, daß er viel dabei verdiente, und daß man die Eintrittskarten nicht zu teuer fand, sagte ich ihm, ich würde alle Kosten für das Buffet und die üblichen Erfrischungen übernehmen, darüber hinaus auch für die Wagen oder Sänften, die er für alle am Ball teilnehmenden Künstlerinnen bereitstellen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cfaacb8-29c7-3b45-bffd-d5144a022a98",
                                        "entry_id": "1fb044b9-73ff-35ad-98d1-fc26060184ac",
                                        "glosses": [
                                            "eine Frau mit einer besonderen Begabung in einem bestimmten Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
