                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24970120-13f4-4236-9fa8-74525f6b507c",
                                "sense_id": "1ccb77e3-0d79-3a10-9415-f9beedc0018a",
                                "text": "Почему́ ты не угости́л его́ мали́новым то́ртом?",
                                "translation": "Dlaczego nie poczęstowałeś go tortem malinowym?"
                            },
                            {
                                "example_id": "bc00b588-242d-416c-81c2-0b7409b45c50",
                                "sense_id": "1ccb77e3-0d79-3a10-9415-f9beedc0018a",
                                "text": "Угости́шь сигаре́той, брат?",
                                "translation": "Poczęstujesz papierosem, bracie?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5682bb24-43f4-379f-9a08-a8f78b575502",
                        "entry_id": "f274b82c-dca5-34ba-9b4f-763b22fd8d64",
                        "glosses": [
                            "poczęstować (zrobić komuś coś złego)"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "5035631a-8aa7-42aa-8a08-4bb3f0496ee9",
                                "sense_id": "5682bb24-43f4-379f-9a08-a8f78b575502",
                                "text": "Ну́жно бу́дет угости́ть его́ кулако́м, а то не успоко́ится",
                                "translation": "Trzeba będzie go poczęstować pięścią, bo inaczej się nie uspokoi."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
