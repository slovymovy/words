                    {
                        "form_id": "fe1011d8-c5d3-437e-a00d-f013ebc0e60a",
                        "entry_id": "13876a8c-1460-3190-945f-25f21d4e85f3",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "турча́нках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "362b2962-ba94-3676-9f6e-7cec781a6ea7",
                        "entry_id": "13876a8c-1460-3190-945f-25f21d4e85f3",
                        "glosses": [
                            "женск. к турок; женщина, проживающая в Турции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067c253e-7512-4054-8491-5e905d24b3e0",
                                "sense_id": "362b2962-ba94-3676-9f6e-7cec781a6ea7",
                                "text": "Яков, прозванный Турком, потому что действительно происходил от пленной турчанки, был по душе — художник во всех смыслах этого слова, а по званию — черпальщик на бумажной фабрике у купца."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5df04fa7-1033-4f91-9e4a-484245e6c26a",
                        "source_entry_id": "13876a8c-1460-3190-945f-25f21d4e85f3",
                        "source_sense_id": "362b2962-ba94-3676-9f6e-7cec781a6ea7",
                        "target_lang_word": "Türkin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Türkin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5795e6c9-5e07-32ce-ab0a-d068113dfcf1",
                                        "entry_id": "a25f836a-4b51-345e-be53-92e288abcb9a",
                                        "glosses": [
                                            "Staatsbürgerin der Türkei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f9bc54c-86e9-4ab7-9d08-36fdee8da175",
                                                "sense_id": "5795e6c9-5e07-32ce-ab0a-d068113dfcf1",
                                                "text": "„In erster Linie sehe ich mich als Kurdin, in zweiter Linie aber auch als Türkin, denn schließlich habe ich einen türkischen Paß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fc2dbf9-af4c-3c36-9e8a-82f5a212c0cc",
                                        "entry_id": "a25f836a-4b51-345e-be53-92e288abcb9a",
                                        "glosses": [
                                            "Angehörige des türkischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85605d68-b108-4c36-8263-d34eb1392027",
                                                "sense_id": "4fc2dbf9-af4c-3c36-9e8a-82f5a212c0cc",
                                                "text": "„Die Kinderfrau war Tscherkessin, die Zofe Negerin, das Dienstmädchen Griechin, das Pflegekind Türkin, die Amme Halbblut, die Beschließerin stammte vom Balkan, der Portier war Armenier, der Koch aus Bolu in Anatolien, der Bootsmann Türke oder Grieche, der Haremsvorsteher Abessinier, der Gärtner Albaner.“"
                                            },
                                            {
                                                "example_id": "f44b3ef5-473a-44ea-ab28-2d3bc1098fe2",
                                                "sense_id": "4fc2dbf9-af4c-3c36-9e8a-82f5a212c0cc",
                                                "text": "„Er lebte jahrelang mit einer Türkin zusammen.“"
                                            },
                                            {
                                                "example_id": "889dceb4-c978-4d44-9a67-829bd05721cf",
                                                "sense_id": "4fc2dbf9-af4c-3c36-9e8a-82f5a212c0cc",
                                                "text": "„Es ist schon auffällig, wie sehr sich junge Türken und Türkinnen mit ihrem Aussehen beschäftigen."
                                            },
                                            {
                                                "example_id": "2c38db5f-7ea2-495f-9969-81fde59e11f2",
                                                "sense_id": "4fc2dbf9-af4c-3c36-9e8a-82f5a212c0cc",
                                                "text": "„Aber das Betrübende dabei ist diese Schüchternheit der Türkinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28332057-462d-4c29-9a33-137ba58a9321",
                        "source_entry_id": "13876a8c-1460-3190-945f-25f21d4e85f3",
                        "source_sense_id": "362b2962-ba94-3676-9f6e-7cec781a6ea7",
                        "target_lang_word": "Turczynka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Turczynka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "23556ad6-7713-38ef-9c66-4020d20107e0",
                                        "entry_id": "9ec9d779-59b5-3c9d-867c-b3d865649925",
                                        "glosses": [
                                            "kobieta narodowości tureckiej, obywatelka Turcji, mieszkanka Turcji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27555cf4-543d-4bc0-9690-8b5a21580c8b",
                                                "sense_id": "23556ad6-7713-38ef-9c66-4020d20107e0",
                                                "text": "W latach 90. cudzoziemskie prostytutki były to głównie Bułgarki lub Turczynki bułgarskiego pochodzenia. Teraz w polskim seksbiznesie dominują Ukrainki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
