                    },
                    {
                        "form_id": "3337d937-0e9d-4caa-a93e-d2bc8a5dadeb",
                        "entry_id": "81dc752b-d95f-3cd8-aae4-386519ae5f7e",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unentfremdbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                        "entry_id": "81dc752b-d95f-3cd8-aae4-386519ae5f7e",
                        "glosses": [
                            "so, dass es nicht entfremdet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d8098c8-b96d-463d-be83-99a8d3c2af94",
                                "sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                                "text": "„Nun ist Person ein Seiendes, dessen Ek-sistenz nur ihm eigen ist, individuell und »incommunicabilis«, unmitteilbar (dem Sinn nach vielleicht besser: unentfremdbar).“"
                            },
                            {
                                "example_id": "92a2931b-48f7-483d-adb5-1079029a25c1",
                                "sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                                "text": "„1794 gewährt im aufgeklärten Preußen ein und derselbe Code, das »Allgemeine Landrecht«, Büchern ein Verlagsrecht, das die Tat ihrer Autoren unentfremdbar macht ….“"
                            },
                            {
                                "example_id": "14d47108-69fa-47d4-89d3-74ba360f9d52",
                                "sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                                "text": "„Die in den Leib eingeschriebene Erfahrung ist unleugbar, aber auch unentfremdbar – die Wunden bezeugen den Kampf besser als Worte.“"
                            },
                            {
                                "example_id": "d9af1191-4895-4c39-8026-175b3daa1c5a",
                                "sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                                "text": "„Aber auch die Termini »alienabel« und »inalienabel« betrachte ich nicht unbedingt als deskriptive, sondern eher als etikettierende Bezeichnungen, dies deshalb, weil nicht jede Relation, die syntaktisch unter dem Begriff »alienabel« oder »inalienabel« geführt wird, in Wirklichkeit ausschließlich »entfremdbar« bzw. »unentfremdbar« ist, sondern unter bestimmten sachlichen Umständen Übergänge möglich sind, die sich im Wechseln der sprachlichen Konstruktion äußern.“"
                            },
                            {
                                "example_id": "336ddb41-6e5d-459e-a3a9-e7f4a5f6ef15",
                                "sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                                "text": "„Der Mensch auf der Suche nach sich ist im Grunde auf der Suche nach mehr als nur sich, nach jenem Geheimnis, das ihn selbst versiegelt, schützt, rettet. Er sucht das Heiligtum, in dem seine eigene Würde unentreißbar und unentfremdbar geborgen ist.“"
                            },
                            {
                                "example_id": "08847155-d902-405f-be60-252dfa0cdaee",
                                "sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                                "text": "„Nur jemand, der die Würde und Exzellenz einer bewussten Persönlichkeit schätzen konnte, nur so jemand konnte mir eine persönliche Identität gegeben haben, unentfremdbar von mir selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06584ecb-7215-477b-9005-685c2163aea4",
                        "source_entry_id": "81dc752b-d95f-3cd8-aae4-386519ae5f7e",
                        "source_sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
                        "source_sense_description": "so, dass es nicht entfremdet werden kann",
                        "target_lang_word": "inalienable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inalienable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a718089-81cd-3ca6-b391-e1d1ba0db9a2",
                                        "entry_id": "42bb4c8d-45fa-3aa2-8dc9-e74cf90bf568",
                                        "glosses": [
                                            "Not subject to being alienated, that is, surrendered, taken away, or transferred to another."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de95f79e-6982-4a1c-90a2-c65d788d9dba",
                                                "sense_id": "9a718089-81cd-3ca6-b391-e1d1ba0db9a2",
                                                "text": "Near-synonyms: indelible, unsurrenderable, permanent"
                                            },
                                            {
                                                "example_id": "eca73788-38df-49ef-9b2f-d895e1360458",
                                                "sense_id": "9a718089-81cd-3ca6-b391-e1d1ba0db9a2",
                                                "text": "An inalienable right is a right that cannot be given away nor taken away."
                                            },
                                            {
                                                "example_id": "4ddf8bf3-7bf2-46d0-81bf-06abf71ebd84",
                                                "sense_id": "9a718089-81cd-3ca6-b391-e1d1ba0db9a2",
                                                "text": "\"Know thy own worth, and reverence the lyre,\" is a line that should be as a fillet bound round the brow—a philactory embroidered on the garments of every son and daughter of Adam distinguished by the possession of that sacred gift, which, whether used or abused, applauded in itself or derided in its possessor, is the highest and the most inalienable distinction humanity ever has or ever can be gifted with, whether bestowed on the highest or the humblest being, in the great mass to which we all belong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "424de0e2-c471-3641-ad14-6ec29efabd89",
                                        "entry_id": "42bb4c8d-45fa-3aa2-8dc9-e74cf90bf568",
                                        "glosses": [
                                            "Of or pertaining to a noun belonging to a special class in which the possessive construction differs from the norm, especially for particular familial relationships and body parts, regarding permanence."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50c9793e-7dbf-4d0b-a585-510bb2226367",
                                                "sense_id": "424de0e2-c471-3641-ad14-6ec29efabd89",
                                                "text": "Just as some languages have a \"be\" for permanent states (which are essential) and a different \"be\" for temporary states (which are incidental), some languages have a \"have\" for unchangeable possession (which is inalienable) and a different \"have\" for changeable possession (which is alienable)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fff836a-a9fb-4810-a5ac-2cb907b28eda",
                        "source_entry_id": "81dc752b-d95f-3cd8-aae4-386519ae5f7e",
                        "source_sense_id": "e6ea5ee0-2093-3327-abdb-b3805e0c434c",
