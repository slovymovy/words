                                    {
                                        "sense_id": "37f89774-c76b-37de-9ed3-2f32f494eb27",
                                        "entry_id": "ccb3fcc4-e0da-3dce-8788-863142704f50",
                                        "glosses": [
                                            "A large, garish ring; a sovereign ring."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "100f5eb1-533c-4071-941c-604c26b7ee5e",
                                                "sense_id": "37f89774-c76b-37de-9ed3-2f32f494eb27",
                                                "text": "No, someone who wears loads of sovereigns as well loads of gold and has uh a curly perm and peroxide blonde hair, orange, orange sunbed skin and a fringe like this blow-dried to death, that’s a ‘scally’."
