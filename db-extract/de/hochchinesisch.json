                "senses": [
                    {
                        "sense_id": "bd206746-efc3-31b6-99c7-cb3df6dca284",
                        "entry_id": "5dac0036-beaf-332a-a8fb-4429becd7a26",
                        "glosses": [
                            "am weitesten verbreitete Sprache Chinas; offizielle Sprache in der Volksrepublik China, Taiwan und Singapur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51eeb159-a3ac-415b-a6b7-ba1cc18255f1",
                                "sense_id": "bd206746-efc3-31b6-99c7-cb3df6dca284",
                                "text": "„Neben dem Hochchinesischen gibt es noch weitere chinesische Sprachen, die oft auch als Dialekte des Chinesischen bezeichnet werden.“"
                            },
                            {
                                "example_id": "1b317a4d-4aab-49d0-a743-186ab678d973",
                                "sense_id": "bd206746-efc3-31b6-99c7-cb3df6dca284",
                                "text": "Über 880 Millionen Menschen sprechen Hochchinesisch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d13bb02-9695-4c13-8555-fbc668d60cfa",
                        "source_entry_id": "5dac0036-beaf-332a-a8fb-4429becd7a26",
                        "source_sense_id": "bd206746-efc3-31b6-99c7-cb3df6dca284",
                        "source_sense_description": "offizielle Sprache in der Volksrepublik China, Taiwan und Singapur",
                        "target_lang_word": "Mandarin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mandarin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d9b975f-7f00-3c7a-9772-53dbb02bdbf5",
                                        "entry_id": "a756aae4-fc2d-3872-b79a-5b64f1c14128",
                                        "glosses": [
                                            "Standard Mandarin, an official language of China and Taiwan, and one of four official languages in Singapore; Putonghua, Guoyu or Huayu."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d98d61f-3c08-4581-ba2f-fab1c99a0e84",
                                                "sense_id": "7d9b975f-7f00-3c7a-9772-53dbb02bdbf5",
                                                "text": "[...]and though the ſame word hath one ſignification in the Mandorines Language, and a contrary in Japan and other places, yet knowing one Speech and their Character, you may Travel not only through the Empire of China, but the adjacent Kingdoms."
                                            },
                                            {
                                                "example_id": "7be53686-c008-4665-9efa-3ac422c6cc94",
                                                "sense_id": "7d9b975f-7f00-3c7a-9772-53dbb02bdbf5",
                                                "text": "Far fewer people understood Mandarin in Hotan than anywhere else I'd been in Xinjiang. It made getting around difficult, as not only did the taxi drivers fail to understand what I was saying, but they couldn't read an address either. Most ignored or didn't know the Chinese names given to the streets anyway."
                                            },
                                            {
                                                "example_id": "4288b844-f2ab-46c1-80b6-33e166b5256d",
                                                "sense_id": "7d9b975f-7f00-3c7a-9772-53dbb02bdbf5",
                                                "text": "Owner David Yeh says his Little-One bar -- a homophone to Lithuania's Mandarin name \"Litaowan\" -- started getting more attention last year after Vilnius became the first EU government to donate vaccines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc477c5-f2df-3d90-8811-22e5ce3aadcd",
                                        "entry_id": "a756aae4-fc2d-3872-b79a-5b64f1c14128",
                                        "glosses": [
                                            "A branch of the Chinese languages, consisting of many dialects; Guanhua or Beifanghua."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "549fffc4-d468-4318-b616-92e2a4dce5e9",
                                                "sense_id": "7bc477c5-f2df-3d90-8811-22e5ce3aadcd",
                                                "text": "\"Two, three, four, five, south! Six, seven, eight, nine, north!\" Strange as it may sound, this is the way the people on the Chinese mainland complain about the lack of clothes, food and other necessities.\nAbsent from the phrases are \"one\" and \"ten\"—\"i\" and \"shih\" in Chinese Mandarin. The words for \"clothes\" and \"food\" sound alike. Also missing are \"east\" and \"west.\" Their Chinese equivalents when put together as \"tung-hsi,\" stand for \"things,\" \"objects\" or \"matters.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
