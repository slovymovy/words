                        "source_sense_id": "3fa1baf0-7aa5-301d-b0ad-e2cd91224c61",
                        "target_lang_word": "haploïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haploïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dad68254-390b-39d3-9a81-d32a75e6f02c",
                                        "entry_id": "bc3e6c5d-108c-3425-9e5b-ea12914a5873",
                                        "glosses": [
                                            "Qui ne possède qu’un exemplaire de chaque chromosome."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75034695-c561-47cc-bf73-a0edbfd794db",
                                                "sense_id": "dad68254-390b-39d3-9a81-d32a75e6f02c",
                                                "text": "Elle établissait, pour la première fois sur la base d'arguments thermodynamiques irréfutables, que la séparation chromosomique intervenant au moment de la méiose pour donner naissance à des gamètes haploïdes était en elle-même une source d'instabilité structurelle ; en d'autres termes toute espèce sexuée était nécessairement mortelle."
                                            },
                                            {
                                                "example_id": "41c2465d-b3ec-4de3-8230-42f16f968696",
                                                "sense_id": "dad68254-390b-39d3-9a81-d32a75e6f02c",
                                                "text": "Les Mousses que nous observons dans la nature sont donc des gamétophytes. Ces individus haploïdes possèdent des organes sexuels mâles (anthéridies) qui produisent des gamètes flagellés appelés anthérozoïdes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haploïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "085432fd-c53d-307a-8568-16c37632e623",
                                        "entry_id": "9eff1388-ca66-3fda-b20d-b640e4f65ae3",
                                        "glosses": [
                                            "Organisme vivant ne possédant qu’un exemplaire de chaque chromosome."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e8398c-0841-456d-b284-8f6a55fc4cbe",
                                                "sense_id": "085432fd-c53d-307a-8568-16c37632e623",
                                                "text": "Le premier doublement d’un haploïde a été réalisé chez cette espèce par Blakeslee et Belling en 1924."
                                            },
                                            {
                                                "example_id": "8b5262a3-5671-495e-ac89-f11a21f77ec9",
                                                "sense_id": "085432fd-c53d-307a-8568-16c37632e623",
                                                "text": "Nous allons étudier l’évolution d’une population d’haploïdes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
