{
    "word_family": [
        "lime"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "513e27a2-d8d3-382b-8930-2ed68a3454d0",
                    "sense_definition": "A sweet citrus drink made from water, sugar, and lime juice.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On a hot summer day, nothing is more refreshing than a glass of cold <w>limeade</w>.",
                            "target_lang_translations": {
                                "ru": "В жаркий летний день нет ничего освежающее, чем стакан холодного <w>лаймового лимонада</w>."
                            }
                        },
                        {
                            "text": "She mixed fresh lime juice with sugar and water to make homemade <w>limeade</w> for the party.",
                            "target_lang_translations": {
                                "ru": "Она смешала свежий сок лайма с сахаром и водой, чтобы приготовить домашний <w>лаймовый лимонад</w> для вечеринки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh limeade",
                        "cold limeade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкий цитрусовый напиток, приготовленный из воды, сахара и сока лайма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаймовый лимонад",
                                "target_lang_sense_clarification": "напиток из лайма, аналогичный лимонаду"
                            },
                            {
                                "target_lang_word": "напиток из лайма",
                                "target_lang_sense_clarification": "описательное название напитка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ef065a7-9225-3599-bbb5-8ce258c34ada",
                    "sense_definition": "A single serving or glass of limeade.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter brought two <w>limeades</w> to our table.",
                            "target_lang_translations": {
                                "ru": "Официант принес к нашему столику две <w>порции лаймового лимонада</w>."
                            }
                        },
                        {
                            "text": "I ordered a <w>limeade</w> to go with my lunch.",
                            "target_lang_translations": {
                                "ru": "Я заказал <w>стакан лаймового лимонада</w> к обеду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "order a limeade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порция или стакан лаймового лимонада."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порция лаймового лимонада",
                                "target_lang_sense_clarification": "указание на количество напитка"
                            },
                            {
                                "target_lang_word": "стакан лаймового лимонада",
                                "target_lang_sense_clarification": "указание на емкость с напитком"
                            }
                        ]
                    }
                }
            ]
        }
    ]
