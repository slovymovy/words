                        "onderverdelen",
                        "splitsen"
                    ],
                    "antonyms": [
                        "samenvoegen",
                        "verenigen"
                    ],
                    "common_phrases": [
                        "in groepen opdelen",
                        "in stukken opdelen",
                        "een taak opdelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to divide a whole into smaller pieces or groups"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "divide up",
                                "target_lang_sense_clarification": "to split into parts or groups"
                            },
                            {
                                "target_lang_word": "split up",
                                "target_lang_sense_clarification": "to separate into smaller units"
                            },
                            {
                                "target_lang_word": "partition",
                                "target_lang_sense_clarification": "to divide a territory or space"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "520bec44-8efa-3067-99fb-08e5504553b6",
                    "sense_definition": "iets verdelen in nog kleinere eenheden of categorieën",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De projectmanager van elke grote touroperator <w>deelt</w> zijn bestemmingen <w>op</w> in zones.",
                            "target_lang_translations": {
                                "en": "The project manager of every large tour operator <w>subdivides</w> their destinations into zones."
                            }
                        },
                        {
                            "text": "Je kunt dit grote bestand het beste in hoofdstukken <w>opdelen</w> om het overzichtelijk te houden.",
                            "target_lang_translations": {
                                "en": "It is best to <w>break down</w> this large file into chapters to keep it organized."
                            }
                        }
                    ],
                    "synonyms": [
                        "subdiviseren",
                        "indelen"
                    ],
                    "common_phrases": [
                        "in zones opdelen",
                        "in categorieën opdelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to divide something into even smaller units or categories"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subdivide",
                                "target_lang_sense_clarification": "to divide something that is already divided"
                            },
                            {
                                "target_lang_word": "break down",
                                "target_lang_sense_clarification": "to separate into smaller components or categories"
                            },
                            {
                                "target_lang_word": "categorize",
                                "target_lang_sense_clarification": "to divide into specific classes"
                            }
                        ]
                    }
                }
