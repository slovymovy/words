                                        "examples": [
                                            {
                                                "example_id": "f5f42c1c-445f-4b09-9b36-3ec1eb4ec152",
                                                "sense_id": "35ce3845-e710-3389-b391-a1a858271c54",
                                                "text": "Hij loopt dagelijks hard om fit te zijn voor de wedstrijd."
                                            },
                                            {
                                                "example_id": "b39cc95d-8182-4122-b5ce-ec90dd400de6",
                                                "sense_id": "35ce3845-e710-3389-b391-a1a858271c54",
                                                "text": "Na haar genezing voelde ze zich weer fit."
                                            },
                                            {
                                                "example_id": "f310d6d6-b202-451f-bfcb-524db130796a",
                                                "sense_id": "35ce3845-e710-3389-b391-a1a858271c54",
                                                "text": "De trail had mij in ieder geval fit gemaakt en dit wou ik thuis graag volhouden."
                                            }
                                        ]
                                    }
                                ]
                            },
