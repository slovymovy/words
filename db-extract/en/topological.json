                "senses": [
                    {
                        "sense_id": "40467f72-5e4e-3b5b-bc18-3d7fc2c3450e",
                        "entry_id": "2647b4d9-be21-3919-843b-b8b069288249",
                        "glosses": [
                            "Of or relating to topology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f529aaf8-5270-4788-b38c-b847519912ab",
                                "sense_id": "40467f72-5e4e-3b5b-bc18-3d7fc2c3450e",
                                "text": "2013, Johnston, Adrian, \"Jacques Lacan\", The Stanford Encyclopedia of Philosophy (Summer 2013 Edition), Edward N. Zalta (ed.) Jacques Lacan in Stanford Encyclopedia of Philosophy\nBy the 1970s, with his meditations on the topological figure of the Borromean knot—this knotting of three rings, pictured on the coat of arms of the Borromeo family, is arranged such that if one ring is broken, all three are set free in disconnection—Lacan emphasizes the mutual dependence of the registers on one another. Hence, loosely speaking, the Imaginary, the Symbolic, and the Real can be thought of as the three fundamental dimensions of psychical subjectivity à la Lacan."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2c0fbe0-a7bf-3e22-b9ae-fe1beb4854f5",
                        "entry_id": "2647b4d9-be21-3919-843b-b8b069288249",
                        "glosses": [
                            "Equipped with a topology that is typically required to be compatible with the underlying structure in some way."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
