                        "examples": [
                            {
                                "example_id": "ca7d4c83-dda3-4c8e-a8ff-51cdf4d7d6df",
                                "sense_id": "3425289d-8494-3ff4-bd99-da89ce14964e",
                                "text": "… car une enceinte en terre, ou d’une escarpe très-basse et très-facilement escaladable sur tout son pourtour, n’exige presque pas plus de monde pour cette surveillance qu’une autre enceinte d’un égal pourtour, dont l’escarpe aurait dix à douze mètres de hauteur;"
                            },
                            {
                                "example_id": "eab92635-a97b-4d7f-8cb0-1fb6f0a47abd",
                                "sense_id": "3425289d-8494-3ff4-bd99-da89ce14964e",
                                "text": "Me voilà au pied de ce rocher qui m’apparaît comme « non escaladable »."
                            },
                            {
                                "example_id": "32481831-43db-4ace-90a7-61d213a71989",
                                "sense_id": "3425289d-8494-3ff4-bd99-da89ce14964e",
                                "text": "Les habitants de la rue Delperée peuvent donc se rassurer, le mur ne devrait plus être aussi facilement escaladable qu’auparavant."
                            }
                        ]
                    }
