                                    {
                                        "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                        "entry_id": "83d9a2ae-50a3-3833-a6b3-091aa4fb6d36",
                                        "glosses": [
                                            "Nommer souvent et avec éloge, entourer de renom."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e90483a-0d84-47d2-949e-9abfa4f429ca",
                                                "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                                "text": "Le prince s’est fait renommer partout."
                                            },
                                            {
                                                "example_id": "dee025a2-2e7d-43a2-afbe-44a98597c877",
                                                "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                                "text": "Ses belles actions l’ont fait renommer par toute la terre."
                                            },
                                            {
                                                "example_id": "d0cf8937-aa0d-4190-a20c-ded834959c0e",
                                                "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                                "text": "Ce héros qu’on renomme en tous lieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
