                                    },
                                    {
                                        "sense_id": "4a14e1c9-4d93-3a4f-942f-e8c055fb8a9f",
                                        "entry_id": "a9746b45-e64d-30be-8796-138b01b7864c",
                                        "glosses": [
                                            "Junto con algunos adjetivos o participios, sentir o tener actualmente la calidad que ellos significan, y muchas veces a modo de burla o ironía."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e624289-2d46-4d7f-baf0-a3b9103ab22b",
                                                "sense_id": "4a14e1c9-4d93-3a4f-942f-e8c055fb8a9f",
                                                "text": "«Tampoco está justificado por el supuesto predominio de alteraciones de los impulsos y del estado de ánimo, pues estas mismas son correlatos, también, del síndrome orgánico, cualquiera que sea su categoría, y, por ejemplo, las suele ostentar la esclerosis múltiple en ocasiones y durante la etapa inicial»."
                                            },
                                            {
                                                "example_id": "7fb81008-952c-452e-bb90-0ee776b10c4f",
                                                "sense_id": "4a14e1c9-4d93-3a4f-942f-e8c055fb8a9f",
                                                "text": "«La patogenia de este síndrome no está dilucidada. Si se tratara de la acción directa del alcohol, la alteración de la conciencia debería estar presente»."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
