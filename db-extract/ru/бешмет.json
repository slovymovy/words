                "senses": [
                    {
                        "sense_id": "69891cea-96be-32de-b7f3-32cc4b450518",
                        "entry_id": "44c761c4-d66b-305f-aef5-8570cf0ce935",
                        "glosses": [
                            "beshmet (a tightly fitting knee-length outer garment with a short stand-up collar, traditionally worn by Turkic and Caucasian people and adopted by Cossacks)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bea6cbb-8bec-4f98-851e-a25f9605b4f4",
                                "sense_id": "69891cea-96be-32de-b7f3-32cc4b450518",
                                "text": "Я встал, наки́нул бешме́т, опоя́сал кинжа́л и ти́хо-ти́хо вы́шел из ха́ты.",
                                "translation": "I stood up, pulled on my beshmet, fastened my dagger belt, and very quietly left the hut.",
                                "english": "I stood up, pulled on my beshmet, fastened my dagger belt, and very quietly left the hut."
                            }
                        ]
                    }
